		Parent = refs.KillBanner,
	})
	refs.KillSub = UI.label({
		Position = UDim2.fromOffset(70, 36),
		Size = UDim2.fromOffset(370, 24),
		Text = "",
		TextSize = 20,
		TextColor3 = Color3.fromRGB(255, 225, 100),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = refs.KillBanner,
	})

	-- Medallas de la baja (Primera sangre, Venganza...): en fila bajo el aviso de baja (en móvil,
	-- encima: debajo están los botones de habilidades)
	local medalsAbove = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled and not phone
	refs.Medals = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, medalsAbove and 1 or 0),
		-- (teléfono: justo debajo del aviso de baja, que está por encima de la mira)
		Position = phone and UDim2.new(0.5, 0, 0.33, 24) or UDim2.new(0.5, 0, 0.7, medalsAbove and -38 or 38),
		Size = UDim2.fromOffset(640, 34),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	if phone then
		UI.new("UIScale", { Scale = 0.75, Parent = refs.Medals })
	end

	-- Fin de ronda
	refs.RoundEnd = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(560, 220),
		BackgroundColor3 = Color3.fromRGB(20, 22, 35),
		BackgroundTransparency = 0.15,
		ZIndex = 10, -- (por encima de la vida y la racha: en el móvil el panel llega hasta abajo)
		Visible = false,
		Parent = gui,
	}, { UI.corner(16), UI.stroke(Color3.new(1, 1, 1), 3, 0.6) })
	refs.RoundTitle = UI.label({
		Position = UDim2.fromOffset(0, 20),
		Size = UDim2.new(1, 0, 0, 56),
		Text = "",
		TextSize = 44,
		Parent = refs.RoundEnd,
	})
	refs.RoundScore = UI.label({
		Position = UDim2.fromOffset(0, 86),
		Size = UDim2.new(1, 0, 0, 50),
		Text = "",
		TextSize = 40,
		RichText = true,
		Parent = refs.RoundEnd,
	})
	refs.RoundMVP = UI.label({
		Position = UDim2.fromOffset(0, 140),
		Size = UDim2.new(1, 0, 0, 34),
		Text = "",
		TextSize = 24,
		TextColor3 = Color3.fromRGB(255, 210, 80),
		Parent = refs.RoundEnd,
	})
	-- Podio: los 3 mejores de la partida (bots incluidos), con bajas/muertes
	refs.RoundTop = UI.label({
		Position = UDim2.fromOffset(10, 174),
		Size = UDim2.new(1, -20, 0, 22),
		Text = "",
		TextScaled = true, -- (con nombres largos se encoge en vez de salirse)
		RichText = true,
		TextColor3 = Color3.fromRGB(225, 228, 240),
		Parent = refs.RoundEnd,
	}, { UI.new("UITextSizeConstraint", { MaxTextSize = 17 }) })

	-- En pantallas bajas (móvil en horizontal) el panel se encoge para caber entero
	local roundScale = UI.new("UIScale", { Parent = refs.RoundEnd })
	local function fitRoundEnd()
		local viewport = workspace.CurrentCamera.ViewportSize
		roundScale.Scale = math.clamp(math.min((viewport.Y - 40) / refs.RoundEnd.Size.Y.Offset, (viewport.X - 20) / 560), 0.45, 1)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitRoundEnd)
	refs.RoundEnd:GetPropertyChangedSignal("Size"):Connect(fitRoundEnd)
	fitRoundEnd()

	-- Resumen de tu partida (llega con MatchSummary): estadísticas, barra de nivel y monedas
	refs.Summary = UI.new("Frame", {
		Position = UDim2.fromOffset(20, 200),
		Size = UDim2.new(1, -40, 0, 170),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = refs.RoundEnd,
	})
	refs.SummaryStats = UI.label({
		Size = UDim2.new(1, 0, 0, 30),
		Text = "",
		TextSize = 22,
		RichText = true,
		Parent = refs.Summary,
	})
	refs.SummaryLevel = UI.label({
		Position = UDim2.fromOffset(0, 44),
		Size = UDim2.new(0.5, 0, 0, 28),
		Text = "",
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = refs.Summary,
	})
	refs.SummaryXP = UI.label({
		Position = UDim2.new(0.5, 0, 0, 44),
		Size = UDim2.new(0.5, 0, 0, 28),
		Text = "",
		TextSize = 24,
		TextColor3 = Color3.fromRGB(120, 220, 255),
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = refs.Summary,
	})
	local bar = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 78),
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundColor3 = Color3.fromRGB(40, 44, 70),
		Parent = refs.Summary,
	}, { UI.corner(10), UI.stroke(Color3.new(1, 1, 1), 2, 0.5) })
	refs.SummaryFill = UI.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.fromRGB(80, 200, 255),
		Parent = bar,
	}, { UI.corner(10) })
	refs.SummaryLevelUp = UI.label({
		Position = UDim2.fromOffset(0, 102),
		Size = UDim2.new(1, 0, 0, 30),
		Text = "⬆ ¡SUBES DE NIVEL!",
		TextSize = 26,
		TextScaled = true, -- (el aviso de "te faltan X XP" es largo: se encoge en vez de salirse)
		TextColor3 = Color3.fromRGB(255, 220, 70),
		Visible = false,
		Parent = refs.Summary,
	}, { UI.new("UITextSizeConstraint", { MaxTextSize = 26 }) })
	refs.SummaryCoins = UI.label({
		Position = UDim2.fromOffset(0, 134),
		Size = UDim2.new(0.45, 0, 0, 32),
		Text = "",
		TextSize = 28,
		TextColor3 = Color3.fromRGB(255, 210, 60),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = refs.Summary,
	})
	-- Rango competitivo: icono, nombre y puntos ganados o perdidos
	refs.SummaryRank = UI.label({
		Position = UDim2.new(0.45, 0, 0, 134),
		Size = UDim2.new(0.55, 0, 0, 32),
		Text = "",
		TextSize = 24,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = refs.Summary,
	})
end

---------------------------------------------------------------------------
-- Mensajes
---------------------------------------------------------------------------

-- Orden creciente para los avisos y el registro de bajas (no se reinicia nunca a mitad de partida)
local orderCounter = 0
local function nextOrder()
	orderCounter += 1
	return orderCounter
end

-- Medalla: una placa que aparece con rebote y se va sola (máximo 3 a la vez)
local function showMedal(text)
	local list = {}
	for _, child in refs.Medals:GetChildren() do
		if child:IsA("TextLabel") then
			table.insert(list, child)
		end
	end
	if #list >= 3 then
		list[1]:Destroy()
	end
	local badge = UI.label({
		LayoutOrder = nextOrder(),
		Size = UDim2.fromOffset(0, 34),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "  " .. tostring(text) .. "  ",
		TextSize = 22,
		TextColor3 = Color3.fromRGB(255, 225, 110),
		BackgroundColor3 = Color3.fromRGB(25, 22, 12),
		BackgroundTransparency = 0.2,
		Parent = refs.Medals,
	}, { UI.corner(8), UI.stroke(Color3.fromRGB(255, 200, 60), 2, 0.1) })
	local scale = UI.new("UIScale", { Scale = 1.6, Parent = badge })
	tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	-- Un brillo cruza la medalla y suena un "cling" (más alto cuantas más medallas juntas)
	badge.ClipsDescendants = true
	local shine = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Parent = badge,
	})
	local gradient = UI.new("UIGradient", {
		Rotation = 20,
		Offset = Vector2.new(-1, 0),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.45, 1),
			NumberSequenceKeypoint.new(0.5, 0),
			NumberSequenceKeypoint.new(0.55, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = shine,
	})
	task.delay(0.15, function()
		tween(gradient, 0.45, { Offset = Vector2.new(1, 0) })
	end)
	Debris:AddItem(shine, 0.7)
	Sounds.Play("Kill", nil, 1.6 + 0.15 * #list, 0.35)
	task.delay(2.6, function()
		if badge.Parent then
			tween(badge, 0.3, { TextTransparency = 1, BackgroundTransparency = 1 })
			task.wait(0.3)
			badge:Destroy()
		end
	end)
end

local function popup(text, color)
	-- En el teléfono, más pequeños y solo 2 a la vez (debajo están los botones de habilidades)
	if phone then
		local list = {}
		for _, child in refs.Popups:GetChildren() do
			if child:IsA("TextLabel") then
				table.insert(list, child)
			end
		end
		table.sort(list, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		for i = 1, #list - 1 do
			list[i]:Destroy()
		end
	end
	local label = UI.label({
		Size = UDim2.fromOffset(phone and 260 or 400, phone and 20 or 26),
		Text = text,
		TextXAlignment = phone and Enum.TextXAlignment.Right or Enum.TextXAlignment.Center,
		TextSize = 22,
		TextScaled = true, -- (los avisos largos se encogen en vez de salirse)
		TextColor3 = color or Color3.fromRGB(255, 230, 120),
		LayoutOrder = nextOrder(),
		Parent = refs.Popups,
	}, { UI.new("UITextSizeConstraint", { MaxTextSize = phone and 17 or 22 }) })
	-- (entra con un pequeño rebote)
	local scale = UI.new("UIScale", { Scale = 1.4, Parent = label })
	tween(scale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(1.4, function()
		tween(label, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	Debris:AddItem(label, 2)
end

local bigToken
-- Celebración: a pantalla completa en plena partida; con el resumen de fin de partida en pantalla,
-- solo confeti, fanfarria y destello (el texto ya sale en el panel y así no lo tapa, sobre todo en
-- el móvil)
local function celebrate(title, subtitle, color, big, priority)
	if refs.RoundEnd and refs.RoundEnd.Visible then
		RewardFX.Confetti(big and 45 or 30)
		RewardFX.Fanfare(big)
		RewardFX.EdgeFlash(color or Color3.fromRGB(255, 210, 60), 0.5)
		return true
	end
	return RewardFX.Celebrate(title, subtitle, color, big, priority)
end

local function bigMessage(text, color)
	local label = refs.BigText
	label.Text = text
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextTransparency = 0
	label.TextStrokeTransparency = 0
	-- (entra grande y se asienta: se anima el tamaño máximo del texto, que se encoge si no cabe)
	local maxSize = phone and 38 or 54
	refs.BigFit.MaxTextSize = math.floor(maxSize * 1.3)
	label.Visible = true
	tween(refs.BigFit, 0.25, { MaxTextSize = maxSize }, Enum.EasingStyle.Back)
	local token = {}
	bigToken = token
	task.delay(2.5, function()
		if bigToken == token then
			tween(label, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
	end)
end

local function timedLabel(label, text, duration)
	label.Text = text
	label.Visible = true
	local token = {}
	label:SetAttribute("Token", tostring(token))
	task.delay(duration, function()
		if label:GetAttribute("Token") == tostring(token) then
			label.Visible = false
		end
	end)
end

-- Texto corto de un premio del pase
local function describeReward(reward)
	if not reward then
		return nil
	elseif reward.Type == "Coins" then
		return "🪙 +" .. tostring(reward.Amount)
	elseif reward.Type == "Skin" then
		return "🎨 Skin " .. Skins.Get(reward.Id).Name
	elseif reward.Type == "Crate" then
		return "🎁 Caja"
	elseif reward.Type == "Outfit" then
		return "👕 Traje nuevo"
	elseif reward.Type == "KillEffect" then
		return "💥 Efecto de eliminación"
	end
	return reward.Type
end

local function onNotify(kind, text)
	if kind == "XP" then
		popup(text)
		RewardFX.AddScore(RewardFX.ParseXP(text))
	elseif kind == "Medal" then
		showMedal(text)
	elseif kind == "Big" then
		bigMessage(text)
	elseif kind == "Challenge" then
		bigMessage("✅ " .. text, Color3.fromRGB(90, 255, 140))
		RewardFX.EdgeFlash(Color3.fromRGB(90, 255, 140), 0.5)
		Sounds.Play("Kill")
	elseif kind == "Mastery" then
		bigMessage("🏆 " .. text, Color3.fromRGB(255, 200, 50))
		RewardFX.EdgeFlash(Color3.fromRGB(255, 200, 50), 0.5)
		Sounds.Play("Kill")
	elseif kind == "LevelUp" then
		-- Subir de nivel: celebración a pantalla completa (rayos, confeti y fanfarria)
		if not celebrate("⬆ ¡NIVEL " .. tostring(text) .. "!", "¡Sigue así!", Color3.fromRGB(255, 210, 60), type(text) == "number" and text % 10 == 0, true) then
			bigMessage("⬆ ¡NIVEL " .. tostring(text) .. "!", Color3.fromRGB(255, 210, 60))
			Sounds.Play("Kill")
		end
		-- Qué da este nivel del pase (y qué daría el premium, si no lo tiene)
		local tier = type(text) == "number" and GameConfig.BattlePass[text]
		if tier then
			local describe = describeReward
			local data = ClientState.Data
			local free, premium = describe(tier.Free), describe(tier.Premium)
			local line = free and ("Recompensa: " .. free) or ""
			if premium and (GameConfig.PremiumPassId ~= 0 or (data and data.Premium)) then
				if data and data.Premium then
					line ..= (line ~= "" and "   ·   " or "") .. "👑 " .. premium
				else
					line ..= (line ~= "" and "   ·   " or "") .. "👑 Con el pase premium: " .. premium
				end
			end
			if line ~= "" then
				-- En el aviso inferior (el banner superior lo usan las rachas y banderas)
				task.delay(0.6, function()
					timedLabel(refs.Toast, line, 4)
				end)
			end
		end
	elseif kind == "LootDrop" then
		-- Tu baja ha soltado botín: el rayo de luz marca dónde está
		local color = Skins.RarityColors[text] or Color3.new(1, 1, 1)
		popup("📦 ¡Botín " .. tostring(text) .. "! Pasa por encima para cogerlo", color)
		Sounds.Play("Kill", nil, 1.9, 0.4)
	elseif kind == "Loot" and type(text) == "table" then
		local color = typeof(text.Color) == "Color3" and text.Color or Color3.new(1, 1, 1)
		local reward = "+" .. tostring(text.Coins or 0) .. " 🪙" .. ((text.XP or 0) > 0 and ("  +" .. text.XP .. " XP") or "")
		popup("📦 Botín " .. tostring(text.Rarity) .. "  " .. reward, color)
		if text.Rarity == "Legendario" then
			if not RewardFX.Celebrate("📦 ¡BOTÍN LEGENDARIO!", reward, color, true) then
				RewardFX.EdgeFlash(color, 0.6)
			end
		elseif text.Rarity == "Épico" then
			RewardFX.EdgeFlash(color, 0.55)
			RewardFX.Fanfare(false)
		else
			RewardFX.EdgeFlash(color, 0.3)
			Sounds.Play("Kill", nil, 1.5, 0.5)
		end
	elseif kind == "Flag" then
		timedLabel(refs.Banner, "🚩 " .. text, 3)
		Sounds.Play("Flag")
	elseif kind == "Streak" then
		timedLabel(refs.Banner, "🔥 " .. text, 3)
	elseif kind == "Pumpkin" then
		-- Calabaza recogida (modo Calabazas): confirmada suena a baja, recuperada más suave
		Sounds.Play(text == true and "Kill" or "Flag", nil, text == true and 1.2 or 1.5)
	elseif kind == "Assist" then
		popup("🤝 ASISTENCIA  " .. tostring(text), Color3.fromRGB(120, 220, 255))
	elseif kind == "Bounty" then
		timedLabel(refs.Banner, "💰 " .. text, 3.5)
	elseif kind == "Wanted" then
		-- Te has convertido en el buscado: todos ven tu cartel
		bigMessage("💰 ¡TE BUSCAN! " .. tostring(text) .. " 🪙 por tu cabeza", Color3.fromRGB(255, 120, 80))
		Sounds.Play("Flag")
	elseif kind == "BountyClaimed" then
		bigMessage("💰 ¡RECOMPENSA COBRADA! +" .. tostring(text) .. " 🪙", Color3.fromRGB(255, 210, 60))
		Sounds.Play("Kill")
	else
		timedLabel(refs.Toast, text, 3)
		Sounds.Play("Click")
	end
end

local multiCount, lastKillTime, killToken = 0, 0, nil
local MULTI_NAMES = { [2] = "¡DOBLE BAJA!", [3] = "¡TRIPLE BAJA!", [4] = "¡CUÁDRUPLE!" }
-- Color del aviso según cuántas bajas seguidas: naranja, rosa, morado y dorado
local MULTI_COLORS = {
	[2] = Color3.fromRGB(255, 180, 30),
	[3] = Color3.fromRGB(255, 80, 160),
	[4] = Color3.fromRGB(180, 90, 255),
}

local function showKillBanner(victim, headshot)
	local now = os.clock()
	multiCount = (now - lastKillTime < 4) and multiCount + 1 or 1
	lastKillTime = now
	local multi = MULTI_NAMES[multiCount] or (multiCount >= 5 and "¡IMPARABLE!" or nil)
	refs.KillTitle.Text = multi or "ELIMINADO"
	refs.KillTitle.TextColor3 = MULTI_COLORS[multiCount] or (multi and Color3.fromRGB(255, 215, 60)) or Color3.fromRGB(255, 70, 70)
	refs.KillSub.Text = tostring(victim) .. (headshot and "  ·  DISPARO A LA CABEZA" or "")
	refs.KillIcon.Text = headshot and "🎯" or "💀"
	refs.KillBanner.Visible = true
	-- (cuantas más bajas seguidas, más grande entra y más se sacude)
	refs.KillScale.Scale = killBaseScale * (1.5 + 0.25 * math.min(multiCount - 1, 4))
	tween(refs.KillScale, 0.3, { Scale = killBaseScale }, Enum.EasingStyle.Back)
	if multi then
		refs.KillBanner.Rotation = multiCount % 2 == 0 and -6 or 6
		tween(refs.KillBanner, 0.35, { Rotation = 0 }, Enum.EasingStyle.Elastic)
	end
	RewardFX.KillPulse(headshot, multiCount)
	local token = {}
	killToken = token
	task.delay(2.2, function()
		if killToken == token then
			refs.KillBanner.Visible = false
		end
	end)
end

local function onKillFeed(info)
	if type(info) ~= "table" then
		return
	end
	if info.Killer == player.Name and info.Victim ~= player.Name then
		showKillBanner(info.Victim, info.Headshot)
	end
	local killer = info.Killer
	local text
	local weapon = info.Weapon ~= "" and (" [" .. info.Weapon .. "] ") or " ✖ "
	if info.Headshot then
		weapon ..= "🎯 "
	end
	local victim = string.format('<font color="%s">%s</font>', UI.hex(info.VictimColor), info.Victim or "?")
	if killer then
		text = string.format('<font color="%s">%s</font>%s%s', UI.hex(info.KillerColor), killer, weapon, victim)
	else
		text = victim .. " se eliminó"
	end
	local entry = UI.new("Frame", {
		Size = UDim2.fromOffset(380, 26),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		LayoutOrder = nextOrder(),
		Parent = refs.KillFeed,
	}, { UI.corner(6) })
	if killer == player.Name or info.Victim == player.Name then
		UI.stroke(Color3.fromRGB(255, 210, 80), 2, 0.2).Parent = entry
	end
	-- Como en los shooters: "Asesino [silueta del arma] Víctima" (si el arma tiene modelo; si no, texto)
	local weaponDef = killer and type(info.WeaponId) == "string" and Weapons.Get(info.WeaponId)
	local iconHolder
	-- (en calidad Baja, texto: cada silueta es una vista 3D y en móviles modestos se nota)
	if weaponDef and (weaponDef.Type == "Gun" or weaponDef.Type == "Melee") and ClientState.EffectiveQuality ~= "Baja" then
		iconHolder = UI.new("Frame", { Size = UDim2.fromOffset(62, 22), BackgroundTransparency = 1, LayoutOrder = 2 })
		local ok = pcall(WeaponIcon.Create, info.WeaponId, "Default", { Size = UDim2.fromScale(1, 1), Parent = iconHolder }, "side", 62 / 22)
		if not ok then
			iconHolder:Destroy()
			iconHolder = nil
		end
	end
	if iconHolder then
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = entry,
		})
		UI.new("UIPadding", { PaddingRight = UDim.new(0, 6), Parent = entry })
		local function name(order, value, color)
			UI.label({
				LayoutOrder = order,
				Size = UDim2.new(0, 0, 1, 0),
				AutomaticSize = Enum.AutomaticSize.X,
				Text = string.format('<font color="%s">%s</font>', UI.hex(color), tostring(value)),
				RichText = true,
				TextSize = 17,
				Parent = entry,
			})
		end
		name(1, killer, info.KillerColor)
		iconHolder.Parent = entry
		if info.Headshot then
			UI.label({ LayoutOrder = 3, Size = UDim2.fromOffset(18, 22), Text = "🎯", TextSize = 15, Parent = entry })
		end
		name(4, info.Victim or "?", info.VictimColor)
	else
		UI.label({
			Size = UDim2.new(1, -12, 1, 0),
			Position = UDim2.fromOffset(6, 0),
			Text = text,
			RichText = true,
			TextSize = 17,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = entry,
		})
	end
	local entries = {}
	for _, child in refs.KillFeed:GetChildren() do
		if child:IsA("Frame") then
			table.insert(entries, child)
		end
	end
	if #entries > (phone and 3 or 6) then
		table.sort(entries, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		entries[1]:Destroy()
	end
	Debris:AddItem(entry, 7)
end

local hitToken
local checkClutch
local hitFlash, hitFlashTween, hitFlashToken -- destello del enemigo al impactar
local dmgCombo -- número de daño que se va sumando sobre el enemigo al que das
local function onHitConfirm(damage, headshot, killed, serverPosition)
	local color = Color3.new(1, 1, 1)
	if killed then
		color = Color3.fromRGB(255, 40, 40)
	elseif headshot then
		color = Color3.fromRGB(255, 210, 40)
	end
	for _, line in refs.HitLines do
		line.BackgroundColor3 = color
		line.Size = killed and UDim2.fromOffset(14, 4) or UDim2.fromOffset(10, 3)
	end
	refs.Hitmarker.Visible = true
	-- (cada impacto "golpea": la X entra grande y se encoge; más en bajas)
	refs.HitScale.Scale = killed and 1.8 or (headshot and 1.45 or 1.25)
	tween(refs.HitScale, 0.12, { Scale = 1 })
	-- (en la baja, la X entra girando)
	refs.Hitmarker.Rotation = killed and -90 or 0
	if killed then
		tween(refs.Hitmarker, 0.25, { Rotation = 0 }, Enum.EasingStyle.Back)
	end
	local token = {}
	hitToken = token
	task.delay(killed and 0.35 or 0.15, function()
		if hitToken == token then
			refs.Hitmarker.Visible = false
		end
	end)
	Sounds.Play(killed and "Kill" or (headshot and "Headshot" or "Hit"))

	-- El enemigo al que das destella un instante (blanco; rojo en la baja). Un solo Highlight que se
	-- reutiliza, y sin verse a través de las paredes
	-- (solo si el último disparo propio fue hace muy poco: una granada no hace destellar a otro)
	-- (con la posición del impacto que manda el servidor se comprueba que es ese enemigo; sin ella,
	-- solo si el disparo fue hace muy poco)
	local target = ClientState.LastHitModel
	if target and target.Parent then
		if typeof(serverPosition) == "Vector3" then
			local ok, pivot = pcall(target.GetPivot, target)
			if not ok or (pivot.Position - serverPosition).Magnitude > 8 or os.clock() - ClientState.LastHitTime > 1.5 then
				target = nil
			end
		elseif os.clock() - ClientState.LastHitTime > 0.35 then
			target = nil
		end
	end
	if target and target.Parent then
		if not hitFlash or not hitFlash.Parent then
			hitFlash = Instance.new("Highlight")
			hitFlash.Name = "HitFlash"
			hitFlash.DepthMode = Enum.HighlightDepthMode.Occluded
			hitFlash.OutlineTransparency = 1
			hitFlash.Parent = workspace.CurrentCamera
		end
		hitFlash.Adornee = target
		hitFlash.FillColor = killed and Color3.fromRGB(255, 60, 60) or Color3.new(1, 1, 1)
		hitFlash.FillTransparency = killed and 0.25 or 0.45
		hitFlash.Enabled = true
		if hitFlashTween then
			hitFlashTween:Cancel()
		end
		local duration = killed and 0.35 or 0.12
		hitFlashTween = tween(hitFlash, duration, { FillTransparency = 1 })
		-- (y se suelta al acabar: si no, taparía otros resaltados del enemigo, como el del radar)
		local flashToken = {}
		hitFlashToken = flashToken
		task.delay(duration + 0.05, function()
			if hitFlashToken == flashToken and hitFlash then
				hitFlash.Enabled = false
				hitFlash.Adornee = nil
			end
		end)
	end

	-- Número de daño en el mundo, encima de donde le diste (si lo sabemos), con un rebote
	-- El servidor dice dónde fue el daño; si no, el último impacto del propio cliente
	local hitPosition = typeof(serverPosition) == "Vector3" and serverPosition
		or (os.clock() - ClientState.LastHitTime < 0.6 and ClientState.LastHitPosition)
	if type(damage) == "number" and hitPosition then
		-- Como en los shooters de móvil: mientras sigues dando al mismo enemigo, el número se va
		-- sumando (37 → 74 → 111) y crece, en vez de salir un número suelto por bala
		local now = os.clock()
		local combo = dmgCombo
		if not (combo and combo.board.Parent and now - combo.time < 0.8 and (hitPosition - combo.pos).Magnitude < 10) then
			local anchor = Instance.new("Attachment")
			anchor.Parent = workspace.Terrain
			local board = Instance.new("BillboardGui")
			board.Size = UDim2.fromOffset(140, 56)
			board.AlwaysOnTop = true
			board.LightInfluence = 0
			board.Adornee = anchor
			board.Parent = gui.Parent -- (un BillboardGui dentro de un ScreenGui no se dibuja)
			local label = UI.label({ Size = UDim2.fromScale(1, 1), Text = "", Parent = board })
			combo = {
				anchor = anchor,
				board = board,
				label = label,
				scale = UI.new("UIScale", { Parent = label }),
				offset = Vector3.new(math.random(-10, 10) / 10, 1.2, math.random(-10, 10) / 10),
				total = 0,
			}
			dmgCombo = combo
		end
		combo.total += damage
		combo.time = now
		combo.pos = hitPosition
		combo.anchor.WorldPosition = hitPosition + combo.offset
		for _, running in combo.fades or {} do
			running:Cancel()
		end
		combo.fades = nil
		local label = combo.label
		label.Text = (killed and "💀 " or "") .. tostring(combo.total) .. (headshot and "!" or "")
		label.TextSize = (killed and 34 or (headshot and 32 or 26)) + math.min(math.floor(combo.total / 40), 10)
		label.TextColor3 = color
		label.TextTransparency = 0
		label.TextStrokeTransparency = 0.4
		combo.board.StudsOffsetWorldSpace = Vector3.zero
		combo.scale.Scale = 1.6
		tween(combo.scale, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
		local token = {}
		combo.token = token
		if killed then
			dmgCombo = nil -- (el siguiente enemigo empieza de cero)
		end
		task.delay(killed and 0.6 or 0.45, function()
			if combo.token ~= token then
				return
			end
			combo.fades = {
				tween(label, 0.5, { TextTransparency = 1, TextStrokeTransparency = 1 }),
				tween(combo.board, 0.5, { StudsOffsetWorldSpace = Vector3.new(0, 2, 0) }),
			}
			task.wait(0.55)
			if combo.token == token then
				combo.board:Destroy()
				combo.anchor:Destroy()
				if dmgCombo == combo then
					dmgCombo = nil
				end
			end
		end)
		-- Baja: estallido de chispas doradas donde cayó (solo lo ves tú)
		if killed and ClientState.EffectiveQuality ~= "Baja" then
			local burst = Instance.new("Attachment")
			burst.WorldPosition = hitPosition
			burst.Parent = workspace.Terrain
			local sparks = Instance.new("ParticleEmitter")
			sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			sparks.Color = ColorSequence.new(headshot and Color3.fromRGB(255, 220, 80) or Color3.fromRGB(255, 120, 70), Color3.fromRGB(255, 255, 220))
			sparks.LightEmission = 1
			sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
			sparks.Lifetime = NumberRange.new(0.3, 0.55)
			sparks.Speed = NumberRange.new(14, 26)
			sparks.SpreadAngle = Vector2.new(180, 180)
			sparks.Drag = 4
			sparks.Rate = 0
			sparks.Parent = burst
			sparks:Emit(headshot and 28 or 18)
			Debris:AddItem(burst, 1)
		end
	elseif type(damage) == "number" then
		local label = UI.label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.random(30, 60), 0.5, math.random(-40, -20)),
			Size = UDim2.fromOffset(80, 30),
			Text = tostring(damage),
			TextSize = headshot and 28 or 22,
			TextColor3 = color,
			Parent = gui,
		})
		tween(label, 0.6, {
			Position = label.Position + UDim2.fromOffset(0, -30),
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		})
		Debris:AddItem(label, 0.7)
	end
end

local summaryToken = 0

-- Anima el resumen: estadísticas, la barra de nivel se llena (y se vacía al subir de nivel) y las
-- monedas cuentan hacia arriba
local function onMatchSummary(summary)
	if type(summary) ~= "table" or type(summary.XP) ~= "number" then
		return
	end
	summaryToken += 1
	local token = summaryToken
	refs.RoundEnd.Size = UDim2.fromOffset(560, 390)
	refs.Summary.Visible = true
	refs.SummaryLevelUp.Visible = false
	local stats = string.format("🎯 %d bajas   💀 %d muertes   🔥 racha %d", summary.Kills or 0, summary.Deaths or 0, summary.BestStreak or 0)
	if (summary.Captures or 0) > 0 then
		stats ..= "   🚩 " .. summary.Captures
	end
	if (summary.WinStreak or 0) >= 2 then
		stats ..= "   🏆 x" .. summary.WinStreak
	end
	refs.SummaryStats.Text = stats
	refs.SummaryStats.TextColor3 = Color3.new(1, 1, 1)
	local perLevel = math.max(1, summary.XPPerLevel or 1)
	local level = summary.StartLevel or summary.Level or 1
	refs.SummaryLevel.Text = "NIVEL " .. level
	refs.SummaryFill.Size = UDim2.fromScale(math.clamp((summary.StartXP or 0) / perLevel, 0, 1), 1)
	refs.SummaryXP.Text = "+0 XP"
	refs.SummaryCoins.Text = "+0 🪙"
	local levelsUp = math.max(0, (summary.Level or level) - level)
	local startRank = summary.StartRank or summary.RankPoints or 0
	local endRank = summary.RankPoints or startRank
	local rankDelta = endRank - startRank
	local function rankText(points, delta)
		local tier = Ranks.Get(points)
		local deltaText = ""
		if delta > 0 then
			deltaText = '  <font color="#6EE06E">+' .. delta .. " RP</font>"
		elseif delta < 0 then
			deltaText = '  <font color="#FF6E6E">' .. delta .. " RP</font>"
		end
		return string.format('%s <font color="%s"><b>%s</b></font>%s', tier.Icon, UI.hex(tier.Color), UI.upper(tier.Name), deltaText)
	end
	refs.SummaryRank.Text = rankText(startRank, 0)
	task.spawn(function()
		task.wait(0.4)
		-- Barra de XP: un tramo por cada nivel subido
		local levels = math.max(0, (summary.Level or level) - level)
		for i = 0, levels do
			if token ~= summaryToken then
				return
			end
			local target = i < levels and 1 or math.clamp((summary.LevelXP or 0) / perLevel, 0, 1)
			tween(refs.SummaryFill, 0.7, { Size = UDim2.fromScale(target, 1) })
			task.wait(0.75)
			if i < levels then
				level += 1
				refs.SummaryLevel.Text = "NIVEL " .. level
				refs.SummaryLevelUp.Text = "⬆ ¡SUBES DE NIVEL!"
				refs.SummaryLevelUp.TextColor3 = Color3.fromRGB(255, 220, 70)
				refs.SummaryLevelUp.Visible = true
				Sounds.Play("Flag")
				refs.SummaryFill.Size = UDim2.fromScale(0, 1)
			end
		end
		-- Sin subir de nivel: cuánto falta y qué premio espera (ganas de jugar "solo una más")
		if levels == 0 and token == summaryToken and not refs.SummaryLevelUp.Visible then
			local missing = perLevel - (summary.LevelXP or 0)
			local nextTier = GameConfig.BattlePass[level + 1]
			local owned = ClientState.Data and ClientState.Data.Premium == true
			local premiumShown = GameConfig.PremiumPassId ~= 0 or owned
			local prize = nextTier and (describeReward(nextTier.Free) or (premiumShown and nextTier.Premium and "👑 " .. describeReward(nextTier.Premium)) or nil)
			if missing > 0 then
				refs.SummaryLevelUp.Text = "Solo te faltan " .. missing .. " XP para el nivel " .. (level + 1) .. (prize and ("  ·  " .. prize) or "")
				refs.SummaryLevelUp.TextColor3 = Color3.fromRGB(150, 220, 255)
				refs.SummaryLevelUp.Visible = true
			end
		end
	end)
	task.spawn(function()
		-- Contadores de XP y monedas (con monedas volando hasta el contador)
		if (summary.Coins or 0) > 0 then
			RewardFX.FlyCoins(refs.SummaryCoins, math.ceil((summary.Coins or 0) / 15))
		end
		local steps = 24
		for i = 1, steps do
			if token ~= summaryToken then
				return
			end
			local t = i / steps
			refs.SummaryXP.Text = "+" .. math.floor(summary.XP * t) .. " XP"
			refs.SummaryCoins.Text = "+" .. math.floor((summary.Coins or 0) * t) .. " 🪙"
			-- (tic-tic mientras cuenta, cada vez más agudo)
			if i % 3 == 0 then
				Sounds.Play("Click", nil, 1 + t * 0.6, 0.4)
			end
			task.wait(0.05)
		end
		Sounds.Play("Kill")
		-- ¡Récord personal de bajas!
		if type(summary.NewRecord) == "number" and token == summaryToken then
			local before = (summary.PrevRecord or 0) > 0 and ("  (antes " .. summary.PrevRecord .. ")") or ""
			-- (el récord también queda escrito en el panel, encima de las estadísticas)
			refs.SummaryStats.Text = "🏆 ¡NUEVO RÉCORD! " .. summary.NewRecord .. " bajas" .. before
			refs.SummaryStats.TextColor3 = Color3.fromRGB(255, 210, 60)
			celebrate("🏆 ¡NUEVO RÉCORD!", summary.NewRecord .. " bajas en una partida" .. before, Color3.fromRGB(255, 200, 40), true)
		end
		if rankDelta ~= 0 and token == summaryToken then
			refs.SummaryRank.Text = rankText(endRank, rankDelta)
			-- ¡Subes de rango!
			if Ranks.Index(endRank) > Ranks.Index(startRank) then
				-- (después de la animación de subir de nivel, que usa el mismo cartel)
				task.wait(math.max(0.3, 0.4 + 0.75 * (levelsUp + 1) - 1.2))
				if token ~= summaryToken then
					return
				end
				local tier = Ranks.Get(endRank)
				refs.SummaryLevelUp.Text = tier.Icon .. " ¡ASCIENDES A " .. UI.upper(tier.Name) .. "!"
				refs.SummaryLevelUp.TextColor3 = tier.Color
				refs.SummaryLevelUp.Visible = true
				Sounds.Play("Flag")
				celebrate(tier.Icon .. " ¡" .. UI.upper(tier.Name) .. "!", "Has subido de rango", tier.Color, true, true)
			end
		end
	end)
end

-- "🥇 Nombre 25/8   🥈 ...": tú en amarillo
local function podiumText(top)
	if type(top) ~= "table" then
		return ""
	end
	local medals = { "🥇", "🥈", "🥉" }
	local parts = {}
	for i, entry in top do
		if type(entry) == "table" and medals[i] then
			local name = tostring(entry.Name or "?")
			local me = not entry.Bot and name == player.DisplayName
			local text = string.format("%s %s %d/%d", medals[i], name, tonumber(entry.Kills) or 0, tonumber(entry.Deaths) or 0)
			if me then
				text = '<font color="#FFE150">' .. text .. "</font>"
			end
			table.insert(parts, text)
		end
	end
	return table.concat(parts, "    ")
end

-- El título del resultado entra de golpe; si ganas, confeti y fanfarria; si pierdes, un golpe grave
local function resultFX(won)
	local scale = refs.RoundTitle:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = refs.RoundTitle })
	scale.Scale = won and 2 or 1.4
	tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	if won then
		RewardFX.Confetti(50)
		RewardFX.Fanfare(true)
		RewardFX.EdgeFlash(Color3.fromRGB(255, 210, 60), 0.5)
	else
		Sounds.Play("Boom", nil, 0.9, 0.3)
	end
end

local function onRoundEnd(info)
	if type(info) ~= "table" then
		return
	end
	refs.RoundTop.Text = podiumText(info.Top)
	summaryToken += 1
	refs.RoundEnd.Size = UDim2.fromOffset(560, 220)
	refs.Summary.Visible = false
	local teamA = ReplicatedStorage:GetAttribute("TeamA") or "Rojo"
	local teamB = ReplicatedStorage:GetAttribute("TeamB") or "Azul"
	if info.TeamMode == false then
		local won = info.Winner == player.Name
		refs.RoundTitle.Text = won and "¡VICTORIA!" or (info.Winner and (info.Winner .. " GANA") or "FIN")
		refs.RoundTitle.TextColor3 = won and Color3.fromRGB(255, 210, 60) or Color3.fromRGB(255, 120, 80)
		resultFX(won)
		refs.RoundScore.Text = "👑 " .. tostring(info.Winner or "-") .. " · " .. tostring(info.LeaderScore or 0)
		refs.RoundMVP.Text = info.MVP and ("⭐ MVP: " .. info.MVP .. " (" .. info.MVPKills .. " bajas)") or ""
		refs.RoundEnd.Visible = true
		task.delay(7, function()
			refs.RoundEnd.Visible = false
		end)
		return
	elseif info.Winner then
		local won = player.Team and player.Team.Name == info.Winner
		refs.RoundTitle.Text = won and "¡VICTORIA!" or "DERROTA"
		refs.RoundTitle.TextColor3 = won and Color3.fromRGB(255, 210, 60) or Color3.fromRGB(255, 80, 80)
		resultFX(won)
	else
		refs.RoundTitle.Text = "EMPATE"
		refs.RoundTitle.TextColor3 = Color3.new(1, 1, 1)
	end
	local colorA = refs.ScoreABox.BackgroundColor3
	local colorB = refs.ScoreBBox.BackgroundColor3
	refs.RoundScore.Text = string.format(
		'<font color="%s">%s %d</font>  -  <font color="%s">%d %s</font>',
		UI.hex(colorA),
		teamA,
		info.ScoreA or 0,
		UI.hex(colorB),
		info.ScoreB or 0,
		teamB
	)
	local mvpText = ""
	if info.MVP then
		local captures = info.MVPCaptures or 0
		mvpText = "⭐ MVP: " .. info.MVP .. " (" .. info.MVPKills .. " bajas"
		if captures > 0 then
			mvpText ..= ", " .. captures .. (captures == 1 and " captura" or " capturas")
		end
		mvpText ..= ")"
	end
	refs.RoundMVP.Text = mvpText
	-- ¡Eres el MVP! (la línea del MVP salta y brilla; no ocupa turno de celebración: esas quedan
	-- para subir de nivel, de rango o batir tu récord)
	if info.MVP == player.Name then
		refs.RoundMVP.Text = "⭐ ¡ERES EL MVP! (" .. tostring(info.MVPKills or 0) .. " bajas)"
		local mvpScale = refs.RoundMVP:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = refs.RoundMVP })
		mvpScale.Scale = 1.5
		task.delay(0.8, function()
			tween(mvpScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
			Sounds.Play("Kill", nil, 1.5, 0.5)
		end)
	end
	refs.RoundEnd.Visible = true
	task.delay(7, function()
		refs.RoundEnd.Visible = false
	end)
end

---------------------------------------------------------------------------
-- Actualización
---------------------------------------------------------------------------

local function getThumbnail(userId)
	if thumbnails[userId] ~= nil then
		return thumbnails[userId]
	end
	thumbnails[userId] = ""
	task.spawn(function()
		local ok, image = pcall(function()
			return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
		end)
		thumbnails[userId] = ok and image or ""
	end)
	return ""
end

local lastRowSignature = ""

local function updatePlayerRow()
	local list = Players:GetPlayers()
	local function kills(p)
		local stats = p:FindFirstChild("leaderstats")
		local value = stats and stats:FindFirstChild("Bajas")
		return value and value.Value or 0
	end
	table.sort(list, function(a, b)
		return kills(a) > kills(b)
	end)
	-- Solo se reconstruye si algo ha cambiado (orden, bajas, equipos o fotos ya cargadas)
	local parts = {}
	for rank = 1, math.min(10, #list) do
		local p = list[rank]
		table.insert(parts, p.UserId .. ":" .. kills(p) .. ":" .. tostring(p.Team) .. ":" .. tostring(getThumbnail(p.UserId) ~= ""))
	end
	local signature = table.concat(parts, "|")
	if signature == lastRowSignature then
		return
	end
	lastRowSignature = signature
	for _, child in refs.PlayerRow:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	for rank = 1, math.min(10, #list) do
		local p = list[rank]
		local teamColor = p.Team and p.TeamColor.Color or Color3.new(1, 1, 1)
		local card = UI.new("Frame", {
			LayoutOrder = rank,
			Size = UDim2.fromOffset(40, 54),
			BackgroundTransparency = 1,
			Parent = refs.PlayerRow,
		})
		UI.new("ImageLabel", {
			Size = UDim2.fromOffset(40, 40),
			BackgroundColor3 = Color3.fromRGB(40, 40, 45),
			Image = getThumbnail(p.UserId),
			Parent = card,
		}, { UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0) }), UI.stroke(teamColor, 3, 0) })
		UI.label({
			Position = UDim2.fromOffset(-6, -6),
			Size = UDim2.fromOffset(24, 14),
			Text = "#" .. rank,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		UI.label({
			Position = UDim2.fromOffset(0, 38),
			Size = UDim2.fromOffset(40, 16),
			Text = tostring(kills(p)),
			TextSize = 15,
			TextColor3 = p == player and Color3.fromRGB(255, 210, 60) or Color3.new(1, 1, 1),
			Parent = card,
		})
	end
end

-- Últimos valores escritos en el HUD (para no reescribir textos iguales cada fotograma)
local hudCache: { [string]: any } = {}

local function updateScoreboard()
	local teamA = ReplicatedStorage:GetAttribute("TeamA")
	local teamB = ReplicatedStorage:GetAttribute("TeamB")
	if teamA then
		refs.ScoreA.Text = tostring(ReplicatedStorage:GetAttribute("Score_" .. teamA) or 0)
		local team = game:GetService("Teams"):FindFirstChild(teamA)
		if team then
			refs.ScoreABox.BackgroundColor3 = team.TeamColor.Color
		end
	end
	if teamB then
		refs.ScoreB.Text = tostring(ReplicatedStorage:GetAttribute("Score_" .. teamB) or 0)
		local team = game:GetService("Teams"):FindFirstChild(teamB)
		if team then
			refs.ScoreBBox.BackgroundColor3 = team.TeamColor.Color
		end
	end
	local state = ReplicatedStorage:GetAttribute("State")
	local timeLeft = ReplicatedStorage:GetAttribute("TimeLeft") or 0
	local modeName = ReplicatedStorage:GetAttribute("ModeName") or "Duelo por equipos"
	local mapName = ReplicatedStorage:GetAttribute("MapName") or ""
	local teamMode = ReplicatedStorage:GetAttribute("TeamMode") ~= false
	refs.Timer.Text = UI.formatTime(timeLeft)
	if state == "Intermission" then
		refs.Mode.Text = "Calentamiento · " .. mapName .. " · vota el siguiente mapa (" .. timeLeft .. ")"
	elseif state == "Ended" then
		refs.Mode.Text = "Fin de la ronda"
	else
		refs.Mode.Text = mapName .. " · " .. modeName .. " · Primero a " .. tostring(ReplicatedStorage:GetAttribute("ScoreToWin") or "?")
		-- Eliminación: cuántos quedan en pie de cada equipo
		local aliveA, aliveB = ReplicatedStorage:GetAttribute("AliveA"), ReplicatedStorage:GetAttribute("AliveB")
		if aliveA and aliveB and teamA and teamB then
			refs.Mode.Text = modeName .. " · En pie: " .. teamA .. " " .. aliveA .. " – " .. aliveB .. " " .. teamB
			checkClutch(aliveA, aliveB, teamA)
		end
	end

	-- Modos sin equipos: tu puntuación contra la del líder
	if not teamMode then
		refs.ScoreA.Text = tostring(player:GetAttribute("Score") or 0)
		refs.ScoreB.Text = tostring(ReplicatedStorage:GetAttribute("LeaderScore") or 0)
		refs.ScoreABox.BackgroundColor3 = Color3.fromRGB(60, 170, 90)
		refs.ScoreBBox.BackgroundColor3 = Color3.fromRGB(230, 160, 30)
		refs.FlagA.Text, refs.FlagA.TextColor3 = "TÚ", Color3.fromRGB(150, 255, 150)
		local leader = ReplicatedStorage:GetAttribute("LeaderName") or ""
		refs.FlagB.Text = leader ~= "" and ("👑 " .. leader) or "LÍDER"
		refs.FlagB.TextColor3 = Color3.fromRGB(255, 210, 80)
		return
	end

	-- Banderas
	local function flagStatus(teamName)
		local flagState = teamName and ReplicatedStorage:GetAttribute("FlagState_" .. teamName)
		if flagState == "Home" then
			return "🚩 En base", Color3.fromRGB(150, 255, 150)
		elseif flagState == "Carried" then
			local carrier = ReplicatedStorage:GetAttribute("FlagCarrier_" .. teamName) or ""
			return "⚠ " .. carrier, Color3.fromRGB(255, 90, 90)
		elseif flagState == "Dropped" then
			return "⬇ Caída", Color3.fromRGB(255, 210, 80)
		end
		return "", Color3.new(1, 1, 1)
	end
	refs.FlagA.Text, refs.FlagA.TextColor3 = flagStatus(teamA)
	refs.FlagB.Text, refs.FlagB.TextColor3 = flagStatus(teamB)

	-- Zona de control
	local zoneOwner = ReplicatedStorage:GetAttribute("ZoneOwner")
	if zoneOwner ~= nil then
		if zoneOwner == "" then
			refs.FlagA.Text, refs.FlagA.TextColor3 = "◆ Zona libre", Color3.new(1, 1, 1)
		elseif zoneOwner == "Contested" then
			refs.FlagA.Text, refs.FlagA.TextColor3 = "◆ ¡DISPUTADA!", Color3.fromRGB(255, 200, 40)
		else
			local team = game:GetService("Teams"):FindFirstChild(zoneOwner)
			refs.FlagA.Text = "◆ Zona: " .. zoneOwner
			refs.FlagA.TextColor3 = team and team.TeamColor.Color or Color3.new(1, 1, 1)
		end
		refs.FlagB.Text = "Se mueve en " .. tostring(ReplicatedStorage:GetAttribute("ZoneMoveIn") or 0) .. "s"
		refs.FlagB.TextColor3 = Color3.fromRGB(200, 210, 230)
	end

	-- Infección: supervivientes contra zombis (en vez de los puntos)
	local infection = ReplicatedStorage:GetAttribute("Infection")
	if infection and state == "Playing" then
		local survivors = ReplicatedStorage:GetAttribute("AliveA") or 0
		local zombies = ReplicatedStorage:GetAttribute("AliveB") or 0
		refs.ScoreA.Text = tostring(survivors)
		refs.ScoreB.Text = tostring(zombies)
		refs.ScoreBBox.BackgroundColor3 = Color3.fromRGB(90, 160, 60)
		refs.FlagA.Text, refs.FlagA.TextColor3 = "🧑 Supervivientes", Color3.fromRGB(200, 230, 255)
		refs.FlagB.Text, refs.FlagB.TextColor3 = "🧟 Zombis", Color3.fromRGB(150, 255, 120)
		local zombie = player.Team and player.Team.Name == teamB and infection == "On"
		if infection == "Prep" then
			refs.Mode.Text = modeName .. " · ¡Escóndete! La infección va a empezar"
		elseif zombie then
			refs.Mode.Text = modeName .. " · 🧟 Eres un zombi: ¡atrapa a los supervivientes!"
		else
			refs.Mode.Text = modeName .. " · ¡Sobrevive hasta que acabe el tiempo!"
		end
	end

	-- La bandera que llevamos a la espalda no nos tapa la vista
	-- (solo se repasa cuando cambia qué banderas llevamos: este aviso llega con cada atributo)
	local flagsFolder = workspace:FindFirstChild("Flags")
	local carrying = ""
	if flagsFolder then
		for _, model in flagsFolder:GetChildren() do
			local teamName = string.gsub(model.Name, "^Flag_", "")
			if ReplicatedStorage:GetAttribute("FlagCarrier_" .. teamName) == player.Name then
				carrying ..= teamName
			end
		end
		carrying ..= "#" .. #flagsFolder:GetChildren()
	end
	if flagsFolder and carrying ~= hudCache.Carrying then
		hudCache.Carrying = carrying
		for _, model in flagsFolder:GetChildren() do
			local teamName = string.gsub(model.Name, "^Flag_", "")
			local mine = ReplicatedStorage:GetAttribute("FlagCarrier_" .. teamName) == player.Name
			for _, part in model:GetDescendants() do
				if part:IsA("BasePart") then
					part.LocalTransparencyModifier = mine and 1 or 0
				elseif part:IsA("BillboardGui") then
					part.Enabled = not mine
				end
			end
		end
	end
end

local lastXP = { Level = nil, XP = nil }
local readyAchievements = nil -- logros listos para reclamar en la última actualización (nil = aún no)

-- Al completar un logro en plena partida: aviso grande (se reclama en el Perfil)
local function checkAchievements(data)
	local ready = {}
	for _, achievement in GameConfig.Achievements do
		if not (data.Achievements or {})[achievement.Id] and (tonumber(data[achievement.Stat]) or 0) >= achievement.Goal then
			ready[achievement.Id] = achievement
		end
	end
	-- (fuera de la partida se espera: no se pisa con el fin de partida ni se gasta en el menú)
	if readyAchievements and (ReplicatedStorage:GetAttribute("State") ~= "Playing" or ClientState.InMainMenu) then
		return
	end
	if readyAchievements then
		for id, achievement in ready do
			if not readyAchievements[id] then
				bigMessage("🏅 ¡LOGRO! " .. achievement.Icon .. " " .. achievement.Text, Color3.fromRGB(120, 255, 160))
				timedLabel(refs.Toast, "Recógelo en el menú → Perfil: +" .. tostring(achievement.Coins) .. " 🪙", 4)
				RewardFX.EdgeFlash(Color3.fromRGB(120, 255, 160), 0.5)
				RewardFX.Fanfare(false)
				break -- (uno por actualización: si saltan varios a la vez, el resto sale en el Perfil)
			end
		end
	end
	readyAchievements = ready
end
local XP_BLUE = Color3.fromRGB(80, 170, 255)

local function updateData(data)
	if not data then
		return
	end
	local per = data.XPPerLevel or 1000
	-- Con el próximo premio del pase a la vista: siempre hay algo "a punto" de caer
	local nextTier = GameConfig.BattlePass[(data.Level or 1) + 1]
	-- (el premio premium solo si el pase se puede comprar o ya lo tiene)
	local premiumShown = GameConfig.PremiumPassId ~= 0 or data.Premium == true
	local nextText = nextTier and (describeReward(nextTier.Free) or (premiumShown and nextTier.Premium and "👑 " .. describeReward(nextTier.Premium)) or nil)
	refs.LevelText.Text = "Nivel " .. data.Level .. "  ·  " .. data.XP .. "/" .. per .. " XP" .. (nextText and ("  ·  Próximo: " .. nextText) or "")
	tween(refs.XPFill, 0.3, { Size = UDim2.fromScale(math.clamp(data.XP / per, 0, 1), 1) })
	-- Al ganar XP la barra destella y da un saltito
	if lastXP.Level == data.Level and lastXP.XP and data.XP > lastXP.XP then
		refs.XPFill.BackgroundColor3 = Color3.new(1, 1, 1)
		tween(refs.XPFill, 0.4, { BackgroundColor3 = XP_BLUE })
		refs.XPScale.Scale = 1.08
		tween(refs.XPScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	lastXP.Level, lastXP.XP = data.Level, data.XP
	checkAchievements(data)
	-- La chuleta de teclas solo para los que empiezan (luego estorba al killfeed y a las armas)
	if refs.KeyHints then
		refs.KeyHints.Visible = (data.Level or 1) < 5
	end
end

local lastHealth = 100
local lastDamageTime = 0
local lowHealthCC: ColorCorrectionEffect? = nil
local chipRatio = 1
local renderCrosshair

-- "Clutch" (Eliminación y Buscar y destruir): si eres el último de tu equipo en pie, aviso de
-- «1 CONTRA N»; si acabas con todos, celebración
local clutch = nil -- { Enemies = N } mientras dura
checkClutch = function(aliveA, aliveB, teamA)
	local mode = ReplicatedStorage:GetAttribute("Mode")
	-- (solo quien juega de verdad esta ronda: no desde la pantalla de inicio)
	if (mode ~= "ELIM" and mode ~= "SND") or ReplicatedStorage:GetAttribute("Infection") == "On" or not player.Team
		or ClientState.InMainMenu or player:GetAttribute("InMenu") or not player:GetAttribute("ElimIn") then
		clutch = nil
		return
	end
	local mine, theirs = aliveA, aliveB
	if player.Team.Name ~= teamA then
		mine, theirs = aliveB, aliveA
	end
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local alive = humanoid ~= nil and humanoid.Health > 0
	if not clutch then
		if alive and mine == 1 and theirs >= 2 then
			clutch = { Enemies = theirs }
			bigMessage("⚔ 1 CONTRA " .. theirs, Color3.fromRGB(255, 90, 70))
			RewardFX.EdgeFlash(Color3.fromRGB(255, 60, 40), 0.5)
			Sounds.Play("Boom", nil, 1.1, 0.3)
		end
	elseif theirs == 0 and alive and ReplicatedStorage:GetAttribute("Bomb_State") ~= "Planted" then
		-- (con la bomba plantada aún hay que desactivarla: entonces no es victoria todavía)
		celebrate("🔥 ¡CLUTCH!", "Ganaste la ronda tú solo contra " .. clutch.Enemies, Color3.fromRGB(255, 140, 40), true)
		clutch = nil
	elseif not alive or mine > 1 then
		clutch = nil -- (caíste, o empezó otra ronda con el equipo entero)
	end
end

local function render(dt)
	gui.Enabled = not ClientState.InMainMenu
	if ClientState.InMainMenu then
		return -- en la pantalla de inicio no se dibuja el HUD
	end
	-- Durante la killcam, su propio rótulo dice quién te eliminó y con qué (no se pisan)
	local showDeath = not ClientState.KillcamActive
	if refs.DeathText.Visible ~= showDeath then
		refs.DeathText.Visible = showDeath
		refs.DeathIcon.Visible = showDeath
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	-- Vida
	if humanoid then
		local health = math.max(0, humanoid.Health)
		local ratio = health / math.max(humanoid.MaxHealth, 1)
		local shown = math.ceil(health)
		local healthChanged = ratio ~= hudCache.HealthRatio or shown ~= hudCache.HealthShown or not (lowHealthCC and lowHealthCC.Parent)
		hudCache.HealthRatio, hudCache.HealthShown = ratio, shown
		if healthChanged then
			refs.HealthFill.Size = UDim2.fromScale(ratio, 1)
			refs.HealthFill.BackgroundColor3 = Color3.fromRGB(230, 60, 60):Lerp(Color3.fromRGB(70, 220, 90), ratio)
			refs.HealthText.Text = tostring(shown)
		end
		-- La parte blanca baja despacio y deja ver el daño recibido
		local newChip = ratio > chipRatio and ratio or math.max(ratio, chipRatio - dt * 0.5)
		if newChip ~= chipRatio or healthChanged then
			chipRatio = newChip
			refs.HealthChip.Size = UDim2.fromScale(chipRatio, 1)
		end
		if health < lastHealth - 0.5 then
			lastDamageTime = os.clock()
			refs.DamageStroke.Transparency = 0.35
			tween(refs.DamageStroke, 0.6, { Transparency = 1 })
		elseif ratio < 0.35 and ratio > 0 and os.clock() - lastDamageTime > 0.6 then
			-- Vida baja: la viñeta roja late
			refs.DamageStroke.Transparency = 0.7 + 0.15 * math.sin(os.clock() * 5)
		end
		lastHealth = health
		-- Vida baja: el mundo pierde color poco a poco (corrección de color solo en este cliente)
		local lowCC = lowHealthCC
		if healthChanged then
			if not lowCC or not lowCC.Parent then
				lowCC = Instance.new("ColorCorrectionEffect")
				lowCC.Name = "LowHealthCC"
				lowCC.Parent = game:GetService("Lighting")
				lowHealthCC = lowCC
			end
			local danger = (health > 0 and ratio < 0.4) and (1 - ratio / 0.4) or 0
			lowCC.Saturation = -0.7 * danger
			lowCC.TintColor = Color3.new(1, 1, 1):Lerp(Color3.fromRGB(255, 200, 200), danger)
			lowCC.Contrast = 0.1 * danger
		end
	end

	-- Racha (los textos solo se reescriben cuando cambia el valor: cada escritura recoloca la interfaz)
	local streak = player:GetAttribute("Streak") or 0
	local rewards = ReplicatedStorage:GetAttribute("Mode") ~= "GUN" and not (player.Character and player.Character:GetAttribute("Zombie"))
	if streak ~= hudCache.Streak or rewards ~= hudCache.StreakRewards then
		-- Cada baja de la racha: el texto da un salto y se va "calentando" (blanco → naranja → rojo);
		-- con 10, 15, 20... bajas sin morir, aviso grande
		if type(hudCache.Streak) == "number" and streak > hudCache.Streak then
			refs.StreakScale.Scale = 1.35
			tween(refs.StreakScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
			-- (también si una granada la hace saltar de 9 a 11)
			local milestone = math.floor(streak / 5) * 5
			if milestone >= 10 and milestone > hudCache.Streak then
				bigMessage("🔥 ¡RACHA DE " .. milestone .. "!", Color3.fromRGB(255, 120, 40))
				RewardFX.EdgeFlash(Color3.fromRGB(255, 120, 40), 0.55)
				RewardFX.Fanfare(false)
			end
		end
		local heat = math.clamp(streak / 10, 0, 1)
		refs.StreakText.TextColor3 = Color3.fromRGB(255, 210, 80):Lerp(Color3.fromRGB(255, 70, 40), heat)
		hudCache.Streak, hudCache.StreakRewards = streak, rewards
		-- Cuánto falta para la siguiente recompensa (Radar con 3, Ataque aéreo con 5)
		local nextText = ""
		if rewards and streak < 3 then
			nextText = "  ·  📡 en " .. (3 - streak)
		elseif rewards and streak < 5 then
			nextText = "  ·  ✈ en " .. (5 - streak)
		end
		refs.StreakText.Text = "Racha x" .. streak .. nextText
		refs.StreakFill.Size = UDim2.fromScale(1, math.clamp(streak / 10, 0, 1))
	end

	-- Arma
	local def = ClientState.CurrentDef
	local tool = ClientState.CurrentTool
	if def and tool then
		refs.WeaponName.Text = def.DisplayName
		if def.Type == "Gun" then
			local reserve = tool:GetAttribute("Reserve") or 0
			local low = ClientState.Ammo <= math.ceil(def.MagSize * 0.25)
			if ClientState.Ammo ~= hudCache.Ammo or reserve ~= hudCache.Reserve or low ~= hudCache.Low then
				hudCache.Ammo, hudCache.Reserve, hudCache.Low = ClientState.Ammo, reserve, low
				refs.Ammo.Text = string.format(
					'<font color="%s">%d</font><font size="%d" color="#C8C8C8"> | %d</font>',
					low and "#FF5050" or "#FFFFFF",
					ClientState.Ammo,
					phone and 15 or 28, -- (la reserva, más pequeña; en el teléfono todo es más pequeño)
					reserve
				)
			end
			refs.AmmoBar.Visible = true
			local fill = ClientState.Reloading and ClientState.ReloadProgress or ClientState.Ammo / def.MagSize
			refs.AmmoFill.Size = UDim2.fromScale(math.clamp(fill, 0, 1), 1)
			refs.AmmoFill.BackgroundColor3 = ClientState.Reloading and Color3.fromRGB(120, 200, 255)
				or (ClientState.Ammo <= math.ceil(def.MagSize * 0.25) and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(255, 210, 80))
			local percent = ClientState.Reloading and math.floor(ClientState.ReloadProgress * 100) or -1
			if ClientState.Reloading then
				if percent ~= hudCache.ReloadPercent then
					refs.ReloadHint.Text = "RECARGANDO " .. percent .. "%"
				end
			elseif ClientState.Ammo == 0 and reserve == 0 then
				refs.ReloadHint.Text = "SIN MUNICIÓN"
			elseif ClientState.Ammo <= math.ceil(def.MagSize * 0.25) then
				refs.ReloadHint.Text = UserInputService.KeyboardEnabled and "[R] Recargar" or "🔄 Recargar"
			else
				refs.ReloadHint.Text = ""
			end
			hudCache.ReloadPercent = percent
		else
			hudCache.Ammo = nil
			refs.Ammo.Text = "∞"
			refs.ReloadHint.Text = ""
			refs.AmmoBar.Visible = false
		end
	else
		hudCache.Ammo = nil
		refs.WeaponName.Text = ""
		refs.Ammo.Text = ""
		refs.ReloadHint.Text = ""
		refs.AmmoBar.Visible = false
	end

	-- Ranuras: se revisan al cambiar de arma y, si no, unas 4 veces por segundo
	local now = os.clock()
	if tool == hudCache.SlotTool and now - (hudCache.SlotsAt or 0) < 0.25 then
		renderCrosshair(def)
		return
	end
	hudCache.SlotTool, hudCache.SlotsAt = tool, now
	local tools = WeaponController.GetTools()
	for slot, row in refs.Slots do
		local slotTool = tools[slot]
		local weaponName = slotTool and slotTool:GetAttribute("Weapon")
		local slotDef = weaponName and Weapons.Get(weaponName)
		row.Row.Visible = slotDef ~= nil
		row.Name.Text = slotDef and slotDef.DisplayName or ""
		local active = slotTool ~= nil and slotTool == tool
		row.Name.TextColor3 = active and Color3.fromRGB(255, 210, 60) or Color3.fromRGB(220, 220, 220)
		row.Key.BackgroundColor3 = active and Color3.fromRGB(255, 170, 30) or Color3.fromRGB(20, 20, 25)
		row.Stroke.Transparency = active and 0 or 1
		row.Row.BackgroundTransparency = active and 0.45 or 0.7
		-- Icono 3D (solo se reconstruye si cambia el arma o la skin)
		local skinId = slotTool and slotTool:GetAttribute("Skin")
		local iconKey = slotDef and (weaponName .. "|" .. tostring(skinId)) or nil
		if iconKey ~= row.IconKey then
			row.IconKey = iconKey
			row.Icon:ClearAllChildren()
			if iconKey then
				WeaponIcon.Create(weaponName, skinId, { Size = UDim2.fromScale(1, 1), Parent = row.Icon }, "side", 170 / 44)
			end
		end
	end

	renderCrosshair(def)
end

-- Mira (color y tamaño elegidos en Ajustes)
function renderCrosshair(def)
	local settings = Settings.Get()
	local colorIndex = math.clamp(math.floor(settings.CrossColor or 1), 1, #GameConfig.CrosshairColors)
	local size = settings.CrossSize or 1
	if colorIndex ~= hudCache.CrossColor or size ~= hudCache.CrossSize then
		hudCache.CrossColor, hudCache.CrossSize = colorIndex, size
		local color = GameConfig.CrosshairColors[colorIndex]
		for _, line in refs.CrossLines do
			local vertical = line.Dir.X == 0
			line.Frame.BackgroundColor3 = color
			line.Frame.Size = vertical and UDim2.fromOffset(2, math.floor(9 * size + 0.5)) or UDim2.fromOffset(math.floor(9 * size + 0.5), 2)
		end
		refs.CrossDot.BackgroundColor3 = color
	end
	local aim = ClientState.AimAlpha
	local isGun = def and def.Type == "Gun"
	local gap = (6 + ClientState.Spread * 6) * size
	for _, line in refs.CrossLines do
		line.Frame.Position = UDim2.fromOffset(line.Dir.X * (gap + 4 * size), line.Dir.Y * (gap + 4 * size))
		line.Frame.Visible = isGun and aim < 0.5
	end
	refs.CrossDot.Visible = aim < 0.5
	refs.Crosshair.Visible = not ClientState.IsBlocked()
	refs.Scope.Visible = def ~= nil and def.Scope == true and aim > 0.85
	if refs.Scope.Visible then
		local hint = ""
		if not (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled) then
			hint = ScopeSway.Holding and "Aguantando la respiración…"
				or ScopeSway.OutOfBreath() and "Sin aire…"
				or "MAYÚS · aguantar la respiración"
		end
		if refs.ScopeHint.Text ~= hint then
			refs.ScopeHint.Text = hint
		end
	end
end

---------------------------------------------------------------------------

function HUD.Init()
	task.spawn(disableCoreGui)
	UI.WaitViewport()
	phone = UI.IsPhone()
	killBaseScale = phone and 0.7 or 1

	gui = UI.new("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	buildTopBar()
	buildCrosshair()
	buildWeaponPanel()
	buildPlayerPanel()
	buildFeedsAndOverlays()

	Remotes.Notify.OnClientEvent:Connect(onNotify)
	Remotes.KillFeed.OnClientEvent:Connect(onKillFeed)
	Remotes.HitConfirm.OnClientEvent:Connect(onHitConfirm)
	Remotes.RoundEnd.OnClientEvent:Connect(onRoundEnd)
	Remotes.MatchSummary.OnClientEvent:Connect(onMatchSummary)
	Remotes.Died.OnClientEvent:Connect(function(killerName, weaponName, killerHealth)
		local weapon = weaponName and Weapons.Get(weaponName)
		if killerName then
			-- Rango y título de quien te eliminó (si es un jugador)
			local killer = Players:FindFirstChild(killerName)
			local extra = ""
			if killer and killer:IsA("Player") then
				local rank = Ranks.Tiers[killer:GetAttribute("Rank") or 0]
				local title = killer:GetAttribute("Title")
				local titleColor = killer:GetAttribute("TitleColor")
				if type(title) == "string" and title ~= "" then
					extra ..= string.format(' <font color="#%s">«%s»</font>', typeof(titleColor) == "Color3" and titleColor:ToHex() or "C8C8D2", title)
				end
				if rank then
					extra = " " .. rank.Icon .. extra
				end
			end
			refs.DeathText.Text = "ELIMINADO POR <b>"
				.. killerName
				.. "</b>"
				.. extra
				.. (weapon and (" · " .. weapon.DisplayName) or "")
				.. (type(killerHealth) == "number" and killerHealth > 0 and killerName ~= player.Name and string.format('  <font color="#7CFF8A">❤ %d</font>', killerHealth) or "")
		else
			refs.DeathText.Text = "HAS MUERTO"
		end
		refs.DeathIcon:ClearAllChildren()
		if weapon and weapon.Parts then
			WeaponIcon.Create(weaponName, "Default", { Size = UDim2.fromScale(1, 1), Parent = refs.DeathIcon }, "angled", 280 / 110)
		elseif weapon then
			-- Armas sin modelo (granada): un emoji grande
			local icon = Instance.new("TextLabel")
			icon.Size = UDim2.fromScale(1, 1)
			icon.BackgroundTransparency = 1
			icon.Text = "💣"
			icon.TextScaled = true
			icon.Parent = refs.DeathIcon
		end
		refs.DeathScreen.Visible = true
	end)
	player.CharacterAdded:Connect(function()
		refs.DeathScreen.Visible = false
		lastHealth = 100
		refs.DamageStroke.Transparency = 1
	end)

	ClientState.DataChanged.Event:Connect(updateData)
	updateData(ClientState.Data)

	ReplicatedStorage.AttributeChanged:Connect(updateScoreboard)
	player:GetAttributeChangedSignal("Score"):Connect(updateScoreboard)
	updateScoreboard()

	local function updateCarrier()
		refs.CarrierBanner.Visible = player:GetAttribute("CarryingFlag") == true
	end
	player:GetAttributeChangedSignal("CarryingFlag"):Connect(updateCarrier)
	updateCarrier()

	task.spawn(function()
		while true do
			if not ClientState.InMainMenu then
				updatePlayerRow()
			end
			task.wait(1)
		end
	end)

	RunService.RenderStepped:Connect(render)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="110">
            <Properties>
              <string name="Name">InfectionFX</string>
              <string name="Source"><![CDATA[-- Ambiente del modo Infección: la pantalla se vuelve más apagada para los supervivientes y verdosa
-- para los zombis, y suena un golpe grave cuando llegan los zombis. Fuera de la Infección, nada.
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Sounds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Sounds"))

local player = Players.LocalPlayer

local InfectionFX = {}

local LOOKS = {
	None = { TintColor = Color3.new(1, 1, 1), Saturation = 0, Contrast = 0 },
	Prep = { TintColor = Color3.fromRGB(235, 235, 245), Saturation = -0.1, Contrast = 0.05 },
	Survivor = { TintColor = Color3.fromRGB(225, 235, 230), Saturation = -0.25, Contrast = 0.1 },
	Zombie = { TintColor = Color3.fromRGB(190, 255, 170), Saturation = -0.1, Contrast = 0.15 },
}

-- Cambios de ambiente que llevan el golpe grave (llegan los zombis o te conviertes)
local SOUND_ON = { ["Prep>Survivor"] = true, ["Prep>Zombie"] = true, ["Survivor>Zombie"] = true }

function InfectionFX.Init()
	local effect = Instance.new("ColorCorrectionEffect")
	effect.Name = "InfectionTint"
	effect.Enabled = false
	effect.Parent = Lighting
	local current: string = "None"
	local function update()
		local infection = ReplicatedStorage:GetAttribute("Infection")
		local look: string = "None"
		if infection and ReplicatedStorage:GetAttribute("State") == "Playing" then
			if infection == "Prep" then
				look = "Prep"
			elseif player.Team and player.Team.Name == ReplicatedStorage:GetAttribute("TeamB") then
				look = "Zombie"
			else
				look = "Survivor"
			end
		end
		if look == current then
			return
		end
		if SOUND_ON[current .. ">" .. look] then
			Sounds.Play("Infected")
		end
		current = look
		effect.Enabled = true
		local tween = TweenService:Create(effect, TweenInfo.new(1.2), LOOKS[look])
		tween:Play()
		if look == "None" then
			tween.Completed:Once(function()
				if current == "None" then
					effect.Enabled = false
				end
			end)
		end
	end
	ReplicatedStorage:GetAttributeChangedSignal("Infection"):Connect(update)
	ReplicatedStorage:GetAttributeChangedSignal("State"):Connect(update)
	player:GetPropertyChangedSignal("Team"):Connect(update)
	update()
end

return InfectionFX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="111">
            <Properties>
              <string name="Name">JumpPads</string>
              <string name="Source"><![CDATA[-- Plataformas de salto del mapa (piezas con el atributo JumpPad = velocidad vertical, ver
-- Kit.jumpPad): al pisar una sales disparado hacia arriba y puedes dirigirte en el aire.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Sounds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Sounds"))

local ClientState = require(script.Parent.ClientState)

local player = Players.LocalPlayer

local JumpPads = {}

local COOLDOWN = 0.6
local lastLaunch = 0
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude
local filteredCharacter = nil -- el filtro se cambia solo cuando cambia el personaje

function JumpPads.Init()
	RunService.Heartbeat:Connect(function()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not humanoid or not root or humanoid.Health <= 0 or ClientState.Frozen() then
			return
		end
		if os.clock() - lastLaunch < COOLDOWN then
			return
		end
		if filteredCharacter ~= character then
			filteredCharacter = character
			params.FilterDescendantsInstances = { character }
		end
		local hit = workspace:Raycast(root.Position, Vector3.new(0, -4, 0), params)
		local power = hit and hit.Instance:GetAttribute("JumpPad")
		if type(power) ~= "number" then
			return
		end
		lastLaunch = os.clock()
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(v.X, power, v.Z)
		-- Otra vez en el siguiente paso de física: el salto del Humanoid podría pisar la velocidad
		task.defer(function()
			local dt = RunService.Heartbeat:Wait()
			local now = root.AssemblyLinearVelocity
			-- (lo esperado tras un paso es power - gravedad·dt; solo se corrige si quedó muy por debajo)
			if root.Parent and humanoid.Health > 0 and now.Y < power - workspace.Gravity * dt - 8 then
				root.AssemblyLinearVelocity = Vector3.new(now.X, power, now.Z)
			end
		end)
		ClientState.FovKick = 8
		Sounds.Play("Swing")
	end)
end

return JumpPads
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="112">
            <Properties>
              <string name="Name">KillstreakController</string>
              <string name="Source"><![CDATA[-- Recompensas por racha en el cliente:
--  * Radar: resalta en rojo a los enemigos a través de las paredes mientras dure (RadarUntil)
--  * Ataque aéreo: tecla T (cruceta derecha en mando) lanza el ataque al punto al que apuntas
--  * Marcas rojas en el suelo antes de que caigan las bombas
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)

local TouchLayout = require(script.Parent.TouchLayout)
local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local KillstreakController = {}

local strikeWidget, strikeLabel, radarLabel

local function radarActive()
	return workspace:GetServerTimeNow() < (player:GetAttribute("RadarUntil") or 0)
end

local function isEnemy(other)
	if other == player then
		return false
	end
	if ReplicatedStorage:GetAttribute("TeamMode") ~= false and player.Team ~= nil and other.Team == player.Team then
		return false
	end
	return true
end

-- Pone o quita el contorno rojo del radar en los enemigos.
-- Roblox dibuja como mucho 31 Highlights: con el radar activo se apagan los de los compañeros.
local function updateRadar()
	local active = radarActive()
	for _, other in Players:GetPlayers() do
		local teamHighlight = other.Character and other.Character:FindFirstChild("TeamHighlight")
		if teamHighlight and teamHighlight:IsA("Highlight") then
			teamHighlight.Enabled = not active
		end
	end
	-- Jugadores y bots (los bots llevan el nombre de su equipo en el atributo Team)
	local marks = {}
	for _, other in Players:GetPlayers() do
		if other.Character then
			table.insert(marks, { other.Character, isEnemy(other) })
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			local teamName = model:GetAttribute("Team")
			local sameTeam = ReplicatedStorage:GetAttribute("TeamMode") ~= false and player.Team ~= nil and teamName == player.Team.Name
			local teamHighlight = model:FindFirstChild("TeamHighlight")
			if teamHighlight and teamHighlight:IsA("Highlight") then
				teamHighlight.Enabled = not active
			end
			table.insert(marks, { model, not sameTeam })
		end
	end
	for _, mark in marks do
		local character, enemy = mark[1], mark[2]
		local highlight = character:FindFirstChild("RadarHighlight")
		if active and enemy then
			if not highlight then
				highlight = Instance.new("Highlight")
				highlight.Name = "RadarHighlight"
				highlight.FillColor = Color3.fromRGB(255, 40, 40)
				highlight.FillTransparency = 0.55
				highlight.OutlineColor = Color3.fromRGB(255, 120, 120)
				highlight.OutlineTransparency = 0
				highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				highlight.Parent = character
			end
		elseif highlight then
			highlight:Destroy()
		end
	end
	local left = (player:GetAttribute("RadarUntil") or 0) - workspace:GetServerTimeNow()
	radarLabel.Visible = active and not ClientState.InMainMenu
	radarLabel.Text = "📡 RADAR " .. math.max(0, math.ceil(left)) .. "s"
end

local function updateWidget()
	local charges = player:GetAttribute("Airstrikes") or 0
	-- (con pantalla táctil, el botón ✈ de Roblox ya lo dice; el cartel quedaba encima de los botones)
	strikeWidget.Visible = charges > 0 and not ClientState.InMainMenu
		and not (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled)
	strikeLabel.Text = "✈ T" .. (charges > 1 and (" ×" .. charges) or "")
	-- (en el botón táctil, cuántos hay si son varios)
	TouchLayout.SetTitle("Airstrike", charges > 1 and ("✈" .. charges) or "✈")
end

-- Punto al que apunta la cámara (o lejos al frente si apunta al cielo)
local function aimPoint()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = { camera }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	local fx = workspace:FindFirstChild("ClientFX")
	if fx then
		table.insert(ignore, fx)
	end
	params.FilterDescendantsInstances = ignore
	local origin = camera.CFrame.Position
	local direction = camera.CFrame.LookVector * 500
	local result = workspace:Raycast(origin, direction, params)
	return result and result.Position or origin + camera.CFrame.LookVector * 150
end

local function callAirstrike()
	if ClientState.IsBlocked() or (player:GetAttribute("Airstrikes") or 0) <= 0 then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	Remotes.CallAirstrike:FireServer(aimPoint())
	Sounds.Play("Flag", nil, 1.3, 1)
end

-- Columna roja y anillo donde va a caer cada bomba
local function markPoints(points, delay)
	local folder = workspace:FindFirstChild("ClientFX") or workspace
	for _, point in points do
		if typeof(point) == "Vector3" then
			local beam = Instance.new("Part")
			beam.Anchored = true
			beam.CanCollide = false
			beam.CanQuery = false
			beam.CanTouch = false
			beam.CastShadow = false
			beam.Material = Enum.Material.Neon
			beam.Color = Color3.fromRGB(255, 40, 40)
			beam.Transparency = 0.5
			beam.Size = Vector3.new(0.8, 70, 0.8)
			beam.CFrame = CFrame.new(point + Vector3.new(0, 35, 0))
			beam.Parent = folder
			local ring = Instance.new("Part")
			ring.Anchored = true
			ring.CanCollide = false
			ring.CanQuery = false
			ring.CanTouch = false
			ring.CastShadow = false
			ring.Material = Enum.Material.Neon
			ring.Color = Color3.fromRGB(255, 60, 40)
			ring.Shape = Enum.PartType.Cylinder
			ring.Transparency = 0.3
			ring.Size = Vector3.new(0.2, 2, 2)
			ring.CFrame = CFrame.new(point) * CFrame.Angles(0, 0, math.pi / 2)
			ring.Parent = folder
			TweenService:Create(ring, TweenInfo.new(delay, Enum.EasingStyle.Linear), { Size = Vector3.new(0.2, 22, 22), Transparency = 0.8 }):Play()
			TweenService:Create(beam, TweenInfo.new(delay, Enum.EasingStyle.Linear), { Size = Vector3.new(2.2, 70, 2.2) }):Play()
			Debris:AddItem(beam, delay + 0.2)
			Debris:AddItem(ring, delay + 0.2)
		end
	end
	Sounds.Play("Flag", nil, 0.6, 1.2)
end

function KillstreakController.Init()
	local gui = UI.new("ScreenGui", {
		Name = "Killstreaks",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 2,
		Parent = player:WaitForChild("PlayerGui"),
	})
	strikeWidget = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -116, 1, -150),
		Size = UDim2.fromOffset(84, 34),
		BackgroundColor3 = Color3.fromRGB(150, 30, 30),
		Visible = false,
		Parent = gui,
	}, { UI.corner(10), UI.stroke(Color3.fromRGB(255, 200, 60), 2, 0), UI.gloss() })
	strikeLabel = UI.label({ Size = UDim2.fromScale(1, 1), Text = "✈ T", TextSize = 20, Parent = strikeWidget })
	radarLabel = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 92),
		Size = UDim2.fromOffset(220, 28),
		Text = "",
		TextSize = 22,
		TextColor3 = Color3.fromRGB(255, 110, 110),
		Visible = false,
		Parent = gui,
	})

	TouchLayout.BindAction("Airstrike", function(_, state)
		if state == Enum.UserInputState.Begin then
			callAirstrike()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.T, Enum.KeyCode.DPadRight)
	TouchLayout.SetTitle("Airstrike", "✈")
	TouchLayout.Set("Airstrike", UDim2.new(1, -280, 1, -310))
	player:GetAttributeChangedSignal("Airstrikes"):Connect(ClientState.UpdateMouse)
	ClientState.UpdateMouse()

	Remotes.AirstrikeMark.OnClientEvent:Connect(function(points, delay)
		if type(points) == "table" then
			markPoints(points, type(delay) == "number" and delay or 1.5)
		end
	end)

	task.spawn(function()
		while true do
			updateRadar()
			updateWidget()
			task.wait(0.25)
		end
	end)
end

return KillstreakController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="113">
            <Properties>
              <string name="Name">LoadingScreen</string>
              <string name="Source"><![CDATA[-- Pantalla de carga entre partidas (como en los shooters): mientras el servidor construye el mapa
-- nuevo (atributo LoadingMap de ReplicatedStorage) se tapa todo con el nombre del mapa y un consejo
-- de juego, y luego se va con un fundido.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent.UI)
local ClientState = require(script.Parent.ClientState)

local LoadingScreen = {}

local TIPS = {
	"Agáchate (C o el botón Agachar): apuntas más estable y eres más difícil de acertar.",
	"Si una granada enemiga cae cerca, verás un 💣 rojo alrededor de la mira: ¡aléjate!",
	"Con 3 bajas seguidas consigues el Radar; con 5, el Ataque aéreo.",
	"En Buscar y destruir solo el portador puede plantar: si cae, recoge la bomba.",
	"Un destello en una ventana es un tirador enemigo apuntándote.",
	"Los pasos del enemigo se oyen: escucha antes de girar la esquina.",
	"La vida se recupera sola si dejas de recibir daño unos segundos.",
	"Disparar sin silenciador te marca en rojo en el minimapa del rival.",
	"Las vallas y barandillas se pueden atravesar a tiros.",
	"Elige tu ventaja en Ajustes: Ligero, Persistente o Fantasma.",
}

local player = Players.LocalPlayer
local gui, panel, title, tip
local shown = false

local function show(mapName)
	title.Text = UI.upper(tostring(mapName))
	tip.Text = "💡 " .. TIPS[math.random(1, #TIPS)]
	gui.Enabled = true
	if not shown then
		shown = true
		panel.GroupTransparency = 1
		TweenService:Create(panel, TweenInfo.new(0.25), { GroupTransparency = 0 }):Play()
	end
end

local function hide()
	if not shown then
		return
	end
	shown = false
	local fade = TweenService:Create(panel, TweenInfo.new(0.6), { GroupTransparency = 1 })
	fade.Completed:Once(function()
		if not shown then
			gui.Enabled = false
		end
	end)
	fade:Play()
end

local function refresh()
	local mapName = ReplicatedStorage:GetAttribute("LoadingMap")
	-- (en la pantalla de inicio no: taparía el menú, la tienda y las noticias)
	if mapName and not ClientState.InMainMenu then
		show(mapName)
	else
		hide()
	end
end

function LoadingScreen.Init()
	gui = UI.new("ScreenGui", {
		Name = "LoadingScreen",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 7, -- (por debajo de la presentación de la partida)
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	panel = UI.new("CanvasGroup", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(10, 12, 16),
		GroupTransparency = 1,
		Parent = gui,
	})
	UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.38),
		Size = UDim2.new(0.9, 0, 0, 26),
		Text = "CARGANDO MAPA…",
		TextSize = 22,
		TextColor3 = Color3.fromRGB(255, 210, 90),
		Parent = panel,
	})
	title = UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.9, 0, 0, 56),
		Text = "",
		TextSize = 48,
		Parent = panel,
	})
	tip = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.66, 0),
		Size = UDim2.new(0.8, 0, 0, 48),
		Text = "",
		TextSize = 18,
		TextWrapped = true,
		TextColor3 = Color3.fromRGB(200, 205, 220),
		Parent = panel,
	})
	ReplicatedStorage:GetAttributeChangedSignal("LoadingMap"):Connect(refresh)
	refresh()
end

LoadingScreen.Refresh = refresh
return LoadingScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="114">
            <Properties>
              <string name="Name">MainMenu</string>
              <string name="Source"><![CDATA[-- Pantalla de inicio: título del juego, cámara girando alrededor del mapa y botones.
-- Mientras está abierta el personaje no se mueve y es invulnerable (escudo del servidor).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")
local SocialService = game:GetService("SocialService")
local GroupService = game:GetService("GroupService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)
local Ranks = require(Shared.Ranks)
local Weapons = require(Shared.Weapons)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local Menu = require(script.Parent.Menu)
local WeaponIcon = require(script.Parent.WeaponIcon)
local Wheel = require(script.Parent.Wheel)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local MainMenu = {}

local gui, root, infoLabel, showcase, dailyButton, starterButton, wheelButton, groupButton
local rankCard -- { Title, Fill, Next }: progreso hacia el siguiente rango
local blur
local titleScale
local orbitAngle = 0
local controls

local ORBIT_CENTER = Vector3.new(0, 8, 0)
local ORBIT_RADIUS = 150
local ORBIT_HEIGHT = 65

local function getControls()
	if controls then
		return controls
	end
	local ok, result = pcall(function()
		local playerModule = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
		return playerModule:GetControls()
	end)
	if ok then
		controls = result
	end
	return controls
end

local function orbit(dt)
	orbitAngle += dt * 0.06
	local position = ORBIT_CENTER + Vector3.new(math.cos(orbitAngle) * ORBIT_RADIUS, ORBIT_HEIGHT, math.sin(orbitAngle) * ORBIT_RADIUS)
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.lookAt(position, ORBIT_CENTER)
	camera.FieldOfView = 60
end

local function bigButton(text, color, order, parent)
	local button = UI.button({
		LayoutOrder = order,
		Size = UDim2.fromOffset(300, 58),
		Text = text,
		TextSize = 28,
		BackgroundColor3 = color,
		Parent = parent,
	}, { UI.stroke(Color3.new(0, 0, 0), 3, 0), UI.gloss() })
	button.TextStrokeTransparency = 0.5
	-- Textos largos ("RECOMPENSA DIARIA") se encogen para caber en el botón
	button.TextScaled = true
	-- (tamaño máximo = el TextSize pedido; si quien crea el botón lo cambia después, se respeta)
	local constraint = UI.new("UITextSizeConstraint", { MaxTextSize = button.TextSize, Parent = button })
	button:GetPropertyChangedSignal("TextSize"):Connect(function()
		constraint.MaxTextSize = button.TextSize
	end)
	UI.new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), Parent = button })
	local scale = UI.new("UIScale", { Parent = button })
	button.MouseEnter:Connect(function()
		if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
			return -- en móvil MouseLeave casi nunca llega y el botón se quedaría grande
		end
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1.06 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1 }):Play()
	end)
	return button
end

local shownWeapon = nil

-- Armas que se pueden usar (sin las ocultas, como las garras de zombi)
local function weaponCount()
	local count = 0
	for _, def in Weapons.List do
		if not def.Hidden and (def.Type == "Gun" or def.Type == "Melee") then
			count += 1
		end
	end
	return count
end

local function refreshInfo()
	local data = ClientState.Data
	if dailyButton then
		dailyButton.Visible = data ~= nil and data.DailyAvailable == true
	end
	if wheelButton then
		wheelButton.Text = (data and data.WheelFree) and "🎡  RULETA ¡GRATIS!" or "🎡  RULETA"
	end
	if starterButton then
		starterButton.Visible = data ~= nil and data.StarterPackAvailable == true
	end
	if groupButton then
		groupButton.Visible = data ~= nil and GameConfig.Group.Id ~= 0 and not data.GroupReward
	end
	if infoLabel then
		infoLabel.Text = data and string.format("Nivel %d   ·   🪙 %d   ·   %d bajas", data.Level, data.Coins, data.TotalKills or 0)
			or "Cargando..."
	end
	if rankCard and data then
		local points = data.RankPoints or 0
		local tier = Ranks.Get(points)
		local fraction, nextTier = Ranks.Progress(points)
		rankCard.Title.Text = string.format('%s <font color="%s"><b>%s</b></font>  ·  %d RP', tier.Icon, UI.hex(tier.Color), UI.upper(tier.Name), points)
		rankCard.Fill.Size = UDim2.fromScale(fraction, 1)
		rankCard.Fill.BackgroundColor3 = tier.Color
		if nextTier then
			local reward = nextTier.Reward or {}
			local prize = (reward.Coins and ("+" .. reward.Coins .. " 🪙") or "") .. (reward.Crates and ("  +" .. reward.Crates .. " 📦") or "")
			rankCard.Next.Text = string.format("Faltan %d RP para %s %s   %s", nextTier.Min - points, nextTier.Icon, nextTier.Name, prize)
		else
			rankCard.Next.Text = "¡Rango máximo!"
		end
	end
	-- Arma principal con la skin equipada, a la derecha (solo se rehace si cambia)
	if showcase and data and ClientState.InMainMenu then
		local primary = data.Primary or "ARX27"
		local key = primary .. "/" .. tostring(Menu.SkinFor(data, primary))
		if key ~= shownWeapon then
			shownWeapon = key
			showcase:ClearAllChildren()
			WeaponIcon.Create(primary, Menu.SkinFor(data, primary), { Size = UDim2.fromScale(1, 1), Parent = showcase }, "angled", 1.6)
		end
	end
end

-- Clasificación global (la publica el servidor en atributos como JSON)
-- Escala un bloque de la pantalla de inicio según el tamaño de la pantalla (móviles)
local function fitToScreen(frame)
	local uiScale = UI.new("UIScale", { Parent = frame })
	local function rescale()
		local viewport = camera.ViewportSize
		uiScale.Scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.45, 1)
	end
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()
end

local function buildLeaderboard(parent)
	local panel = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -20, 0, 20),
		Size = UDim2.fromOffset(330, 282),
		BackgroundColor3 = Color3.fromRGB(16, 18, 32),
		BackgroundTransparency = 0.2,
		Parent = parent,
	}, { UI.corner(14), UI.stroke(Color3.fromRGB(255, 200, 60), 2, 0.2) })
	-- Invitar amigos, justo debajo de la clasificación (cada amigo en el servidor da +10% de XP y
	-- monedas, ver Friends; y si entra por primera vez con tu invitación, monedas para los dos, ver
	-- GameConfig.Referral: la invitación lleva tu UserId)
	local inviteText = "👥  INVITA: +" .. ((GameConfig.Referral and GameConfig.Referral.InviterCoins) or 0) .. " 🪙 y +10%"
	local invite = bigButton(inviteText, Color3.fromRGB(40, 170, 200), 0, panel)
	invite.Position = UDim2.new(0, 0, 1, 10)
	invite.Size = UDim2.new(1, 0, 0, 44)
	invite.TextSize = 22
	invite.Activated:Connect(function()
		Sounds.Play("Click")
		local ok, canInvite = pcall(SocialService.CanSendGameInviteAsync, SocialService, player)
		if ok and canInvite then
			local prompted = pcall(function()
				local options = Instance.new("ExperienceInviteOptions")
				options.LaunchData = "ref:" .. player.UserId
				options.PromptMessage = "¡Juega conmigo a SHOOTER NEW y nos llevamos monedas los dos!"
				SocialService:PromptGameInvite(player, options)
			end)
			if not prompted then
				pcall(SocialService.PromptGameInvite, SocialService, player)
			end
		else
			invite.Text = "No puedes invitar desde aquí"
			task.delay(2, function()
				invite.Text = inviteText
			end)
		end
	end)
	-- Unirse al grupo del juego: premio de monedas una vez (GameConfig.Group)
	local groupText = "⭐  ÚNETE AL GRUPO  +" .. GameConfig.Group.Coins .. " 🪙"
	groupButton = bigButton(groupText, Color3.fromRGB(230, 140, 30), 0, panel)
	groupButton.Position = UDim2.new(0, 0, 1, 62)
	groupButton.Size = UDim2.new(1, 0, 0, 44)
	groupButton.TextSize = 22
	groupButton.Visible = false
	local claiming = false
	local function flash(text)
		groupButton.Text = text
		task.delay(3, function()
			if groupButton then
				groupButton.Text = groupText
			end
		end)
	end
	groupButton.Activated:Connect(function()
		if claiming then
			return
		end
		claiming = true
		Sounds.Play("Click")
		local function claim()
			local ok, success, result = pcall(function()
				return Remotes.ClaimGroup:InvokeServer()
			end)
			return ok and success, result
		end
		local done, result = claim()
		if not done and result == "NotMember" then
			-- Ventana de Roblox para unirse sin salir del juego (si no está disponible, se explica)
			local prompted = pcall(function()
				(GroupService :: any):PromptJoinAsync(GameConfig.Group.Id)
			end)
			if prompted then
				task.wait(3.2)
				done, result = claim()
			end
			if not done and result == "NotMember" then
				result = "Únete al grupo (página del juego) y pulsa otra vez"
			end
		end
		if done then
			Sounds.Play("Kill")
			flash("✅ ¡+" .. tostring(result) .. " 🪙! Gracias")
		else
			flash(tostring(result or "No se pudo"))
		end
		claiming = false
	end)
	fitToScreen(panel)
	UI.label({
		Position = UDim2.fromOffset(14, 6),
		Size = UDim2.new(1, -28, 0, 30),
		Text = "🏆 TOP",
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(255, 210, 60),
		Parent = panel,
	})
	local list = UI.new("Frame", {
		Position = UDim2.fromOffset(12, 44),
		Size = UDim2.new(1, -24, 1, -52),
		BackgroundTransparency = 1,
		Parent = panel,
	}, { UI.new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }) })

	local board = "Kills"
	local tabButtons = {}
	local function render()
		for _, child in list:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		for id, button in tabButtons do
			button.BackgroundColor3 = id == board and Color3.fromRGB(50, 130, 255) or Color3.fromRGB(45, 48, 70)
		end
		local raw = ReplicatedStorage:GetAttribute("Leaderboard_" .. board)
		local ok, rows = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		if type(raw) ~= "string" or not ok or type(rows) ~= "table" or #rows == 0 then
			UI.label({ Size = UDim2.new(1, 0, 0, 60), Text = "Aún no hay datos.\n¡Sé el primero!", TextSize = 18, TextWrapped = true, Parent = list })
			return
		end
		local medals = { "🥇", "🥈", "🥉" }
		for i, row in rows do
			local me = row.UserId == player.UserId
			local line = UI.new("Frame", {
				LayoutOrder = i,
				Size = UDim2.new(1, 0, 0, 21),
				BackgroundColor3 = me and Color3.fromRGB(120, 90, 20) or Color3.fromRGB(30, 32, 50),
				BackgroundTransparency = me and 0.1 or 0.5,
				Parent = list,
			}, { UI.corner(6) })
			UI.label({
				Position = UDim2.fromOffset(6, 0),
				Size = UDim2.fromOffset(34, 21),
				Text = medals[i] or ("#" .. tostring(row.Rank or i)),
				TextSize = 16,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = line,
			})
			UI.label({
				Position = UDim2.fromOffset(42, 0),
				Size = UDim2.new(1, -120, 1, 0),
				Text = tostring(row.Name or "?"),
				TextSize = 16,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextColor3 = me and Color3.fromRGB(255, 230, 120) or Color3.new(1, 1, 1),
				Parent = line,
			})
			UI.label({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -8, 0, 0),
				Size = UDim2.fromOffset(80, 21),
				Text = board == "Rank" and (Ranks.Get(tonumber(row.Value) or 0).Icon .. " " .. tostring(row.Value or 0))
					or tostring(row.Value or 0),
				TextSize = 16,
				TextXAlignment = Enum.TextXAlignment.Right,
				TextColor3 = Color3.fromRGB(255, 210, 60),
				Parent = line,
			})
		end
	end
	for i, info in { { "Kills", "Bajas" }, { "Wins", "Victorias" }, { "Rank", "Rango" } } do
		local button = UI.button({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12 - (3 - i) * 74, 0, 9),
			Size = UDim2.fromOffset(70, 26),
			Text = info[2],
			TextSize = 14,
			Parent = panel,
		})
		button.Activated:Connect(function()
			Sounds.Play("Click")
			board = info[1]
			render()
		end)
		tabButtons[info[1]] = button
	end
	render()
	ReplicatedStorage.AttributeChanged:Connect(function(name)
		if name == "Leaderboard_" .. board then
			render()
		end
	end)
end

-- Abre la pantalla de inicio: desenfoque, cámara girando, título que respira y controles bloqueados
local function openMenu()
	blur = blur or Instance.new("BlurEffect")
	blur.Name = "MainMenuBlur"
	blur.Size = 10
	blur.Parent = Lighting

	ClientState.InMainMenu = true
	UserInputService.MouseIconEnabled = true
	ClientState.UpdateMouse() -- oculta los botones táctiles del juego mientras está la pantalla de inicio
	RunService:BindToRenderStep("MainMenuOrbit", Enum.RenderPriority.Camera.Value + 2, orbit)

	-- El título "respira"
	task.spawn(function()
		while ClientState.InMainMenu do
			TweenService:Create(titleScale, TweenInfo.new(1.2, Enum.EasingStyle.Sine), { Scale = 1.04 }):Play()
			task.wait(1.2)
			TweenService:Create(titleScale, TweenInfo.new(1.2, Enum.EasingStyle.Sine), { Scale = 1 }):Play()
			task.wait(1.2)
		end
	end)

	-- Bloquea el movimiento del personaje mientras tanto
	task.spawn(function()
		local ctrl = getControls()
		if ctrl and ClientState.InMainMenu then
			ctrl:Disable()
		end
	end)
end

local function play()
	if not ClientState.InMainMenu then
		return
	end
	Sounds.Play("Click")
	Remotes.LeaveMenu:FireServer()
	TweenService:Create(root, TweenInfo.new(0.35), { GroupTransparency = 1 }):Play()
	showcase.Visible = false
	if blur then
		TweenService:Create(blur, TweenInfo.new(0.35), { Size = 0 }):Play()
	end
	task.delay(0.35, function()
		RunService:UnbindFromRenderStep("MainMenuOrbit")
		ClientState.InMainMenu = false
		gui.Enabled = false
		if blur then
			blur:Destroy()
			blur = nil
		end
		camera.CameraType = Enum.CameraType.Custom
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		-- (si ya estás en la pantalla de muerte, la cámara es suya: observando a un compañero)
		if humanoid and not ClientState.Dead then
			camera.CameraSubject = humanoid
		end
		local ctrl = getControls()
		if ctrl then
			ctrl:Enable()
		end
		ClientState.UpdateMouse()
	end)
end

-- "Volver al menú" (por ejemplo desde la pantalla de muerte)
function MainMenu.Show()
	if ClientState.InMainMenu or not gui then
		return
	end
	Remotes.EnterMenu:FireServer()
	gui.Enabled = true
	root.GroupTransparency = 0
	showcase.Visible = true
	openMenu()
	refreshInfo()
	ClientState.UpdateMouse()
end

function MainMenu.Init()
	gui = UI.new("ScreenGui", {
		Name = "MainMenu",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 4,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	root = UI.new("CanvasGroup", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	})

	-- Oscurecido a la izquierda para que se lea el texto
	UI.new("Frame", {
		Size = UDim2.fromScale(0.65, 1),
		BackgroundColor3 = Color3.fromRGB(10, 10, 25),
		BorderSizePixel = 0,
		Parent = root,
	}, {
		UI.new("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.15),
				NumberSequenceKeypoint.new(0.6, 0.5),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})

	-- Botón invisible "Modal": libera el ratón aunque la cámara sea en primera persona
	UI.new("TextButton", {
		Size = UDim2.fromOffset(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		Modal = true,
		Parent = root,
	})

	local left = UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 40, 0.5, 0),
		Size = UDim2.fromOffset(560, 520),
		BackgroundTransparency = 1,
		Parent = root,
	})
	fitToScreen(left)

	-- Título con degradado y borde grueso
	local title = UI.label({
		Size = UDim2.new(1, 0, 0, 110),
		Text = GameConfig.GameTitle,
		TextSize = 96,
		TextScaled = true,
		TextStrokeTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = left,
	}, {
		UI.new("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 230, 60)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 140, 30)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 70, 170)),
			}),
			Rotation = 90,
		}),
		UI.new("UIStroke", { Thickness = 6, Color = Color3.fromRGB(30, 10, 40) }),
	})
	titleScale = UI.new("UIScale", { Parent = title })

	UI.label({
		Position = UDim2.fromOffset(4, 112),
		Size = UDim2.new(1, 0, 0, 30),
		Text = string.format("5 VS 5  ·  %d MAPAS  ·  %d MODOS  ·  %d ARMAS", ReplicatedStorage:GetAttribute("MapCount") or 20, #GameConfig.Modes, weaponCount()),
		TextSize = 24,
		TextColor3 = Color3.fromRGB(200, 230, 255),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = left,
	})
	-- Novedades (late para llamar la atención)
	local news = UI.label({
		Position = UDim2.fromOffset(4, 142),
		Size = UDim2.new(1, 0, 0, 26),
		-- (empieza por el evento de temporada si hay uno en marcha)
		Text = (GameConfig.CurrentEvent() and (GameConfig.CurrentEvent().Icon .. " " .. UI.upper(GameConfig.CurrentEvent().Name) .. " · ") or "")
			.. "🧟 Infección · 🎃 Modo Calabazas · 🤠 Pueblo Vaquero · 🏴‍☠️ Bahía Pirata",
		TextSize = 19,
		TextColor3 = Color3.fromRGB(255, 225, 90),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = left,
	})
	task.spawn(function()
		while news.Parent do
			TweenService:Create(news, TweenInfo.new(0.9, Enum.EasingStyle.Sine), { TextTransparency = 0.35 }):Play()
			task.wait(0.9)
			TweenService:Create(news, TweenInfo.new(0.9, Enum.EasingStyle.Sine), { TextTransparency = 0 }):Play()
			task.wait(0.9)
		end
	end)

	local buttons = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 182),
		Size = UDim2.fromOffset(300, 440),
		BackgroundTransparency = 1,
		Parent = left,
	}, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local playButton = bigButton("▶  JUGAR", Color3.fromRGB(60, 200, 90), 1, buttons)
	playButton.Size = UDim2.fromOffset(300, 70)
	playButton.TextSize = 36
	playButton.Activated:Connect(play)
	bigButton("⭐  PASE DE BATALLA", Color3.fromRGB(255, 130, 30), 2, buttons).Activated:Connect(function()
		Sounds.Play("Click")
		Menu.Open("Pase")
	end)
	bigButton("🔫  ARMAS Y TRAJES", Color3.fromRGB(50, 130, 255), 3, buttons).Activated:Connect(function()
		Sounds.Play("Click")
		Menu.Open("Armas")
	end)
	bigButton("🛒  TIENDA", Color3.fromRGB(190, 70, 255), 4, buttons).Activated:Connect(function()
		Sounds.Play("Click")
		Menu.Open("Tienda")
	end)

	-- Recompensa diaria (late mientras está disponible)
	dailyButton = bigButton("🎁  RECOMPENSA DIARIA", Color3.fromRGB(60, 200, 90), 5, buttons)
	dailyButton.Visible = false
	dailyButton.Activated:Connect(function()
		if Menu.ClaimDaily() then
			dailyButton.Visible = false
		end
	end)
	-- Pack de inicio para jugadores nuevos
	starterButton = bigButton("🔥  PACK DE INICIO", Color3.fromRGB(230, 70, 60), 6, buttons)
	starterButton.Visible = false
	starterButton.Activated:Connect(function()
		Sounds.Play("Click")
		Menu.Open("Tienda")
	end)
	-- Ruleta diaria (late mientras hay giro gratis)
	-- (debajo de la tarjeta de rango, para no alargar la columna de botones)
	wheelButton = bigButton("🎡  RULETA", Color3.fromRGB(255, 120, 40), 7, left)
	wheelButton.Position = UDim2.fromOffset(330, 298)
	wheelButton.Size = UDim2.fromOffset(230, 50)
	wheelButton.TextSize = 24
	wheelButton.Activated:Connect(function()
		Sounds.Play("Click")
		Wheel.Open()
	end)
		-- Los botones de regalo y oferta laten mientras están disponibles
	task.spawn(function()
		local scales = { dailyButton:FindFirstChildOfClass("UIScale"), starterButton:FindFirstChildOfClass("UIScale"), wheelButton:FindFirstChildOfClass("UIScale") }
		local buttonsList = { dailyButton, starterButton, wheelButton }
		-- (sigue vivo toda la sesión: al volver a la pantalla de inicio vuelven a latir)
		while gui.Parent do
			if not ClientState.InMainMenu then
				task.wait(0.5)
				continue
			end
			for i, button in buttonsList do
				-- (la ruleta solo late con giro gratis)
				local wheelReady = button ~= wheelButton or (ClientState.Data and ClientState.Data.WheelFree)
				if button.Visible and scales[i] and wheelReady then
					TweenService:Create(scales[i], TweenInfo.new(0.5, Enum.EasingStyle.Sine), { Scale = 1.06 }):Play()
				end
			end
			task.wait(0.5)
			for i in buttonsList do
				if scales[i] then
					TweenService:Create(scales[i], TweenInfo.new(0.5, Enum.EasingStyle.Sine), { Scale = 1 }):Play()
				end
			end
			task.wait(0.5)
		end
	end)

	infoLabel = UI.label({
		Position = UDim2.fromOffset(330, 175),
		Size = UDim2.new(1, 0, 0, 26),
		Text = "Cargando...",
		TextSize = 22,
		TextColor3 = Color3.fromRGB(255, 220, 120),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = left,
	})
	-- Rango competitivo: nombre, puntos y barra hasta el siguiente (con su premio)
	local card = UI.new("Frame", {
		Position = UDim2.fromOffset(330, 210),
		Size = UDim2.fromOffset(230, 78),
		BackgroundColor3 = Color3.fromRGB(16, 18, 32),
		BackgroundTransparency = 0.25,
		Parent = left,
	}, { UI.corner(12), UI.stroke(Color3.fromRGB(255, 255, 255), 1, 0.7) })
	local rankBar = UI.new("Frame", {
		Position = UDim2.fromOffset(10, 36),
		Size = UDim2.new(1, -20, 0, 10),
		BackgroundColor3 = Color3.fromRGB(40, 44, 70),
		Parent = card,
	}, { UI.corner(5) })
	rankCard = {
		Title = UI.label({
			Position = UDim2.fromOffset(10, 4),
			Size = UDim2.new(1, -20, 0, 28),
			Text = "",
			TextSize = 20,
			RichText = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		}),
		Fill = UI.new("Frame", { Size = UDim2.fromScale(0, 1), Parent = rankBar }, { UI.corner(5) }),
		Next = UI.label({
			Position = UDim2.fromOffset(10, 50),
			Size = UDim2.new(1, -20, 0, 22),
			Text = "",
			TextSize = 14,
			TextScaled = true,
			TextColor3 = Color3.fromRGB(200, 205, 225),
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		}),
	}
	-- XP doble (GameConfig.XPBoost): aviso debajo de la ruleta mientras está activo
	local boostLabel = UI.label({
		Position = UDim2.fromOffset(330, 356),
		Size = UDim2.fromOffset(230, 26),
		Text = GameConfig.XPBoost and GameConfig.XPBoost.Text or "",
		TextSize = 16,
		TextScaled = true,
		TextColor3 = Color3.fromRGB(120, 230, 255),
		Visible = false,
		Parent = left,
	})
	local function refreshBoost()
		boostLabel.Visible = (ReplicatedStorage:GetAttribute("XPBoost") or 1) > 1
	end
	ReplicatedStorage:GetAttributeChangedSignal("XPBoost"):Connect(refreshBoost)
	refreshBoost()
	-- Primera victoria del día (GameConfig.FirstWinOfDay): recordatorio mientras no la tengas hoy
	local firstWinConfig = GameConfig.FirstWinOfDay
	local firstWinLabel = UI.label({
		Position = UDim2.fromOffset(330, 384),
		Size = UDim2.fromOffset(230, 22),
		Text = firstWinConfig and ("🏆 1.ª victoria de hoy: +" .. firstWinConfig.Coins .. " 🪙") or "",
		TextSize = 16,
		TextScaled = true,
		TextColor3 = Color3.fromRGB(255, 210, 60),
		TextXAlignment = Enum.TextXAlignment.Left,
		Visible = false,
		Parent = left,
	})
	local function refreshFirstWin()
		local data = ClientState.Data
		firstWinLabel.Visible = firstWinConfig ~= nil and data ~= nil and data.FirstWinAvailable == true
	end
	ClientState.DataChanged.Event:Connect(refreshFirstWin)
	refreshFirstWin()
	-- Mapa destacado del día (GameConfig.FeaturedMap)
	local featuredLabel = UI.label({
		Position = UDim2.fromOffset(330, 408),
		Size = UDim2.fromOffset(230, 22),
		Text = "",
		TextSize = 16,
		TextScaled = true,
		TextColor3 = Color3.fromRGB(255, 235, 140),
		TextXAlignment = Enum.TextXAlignment.Left,
		Visible = false,
		Parent = left,
	})
	local function refreshFeatured()
		local featured = ReplicatedStorage:GetAttribute("FeaturedMap")
		local config = GameConfig.FeaturedMap
		featuredLabel.Visible = featured ~= nil and config ~= nil
		if featured and config then
			featuredLabel.Text = "⭐ Hoy: " .. featured .. " +" .. math.floor((config.XPBonus - 1) * 100 + 0.5) .. "% XP"
		end
	end
	ReplicatedStorage:GetAttributeChangedSignal("FeaturedMap"):Connect(refreshFeatured)
	refreshFeatured()

	-- Escaparate del arma a la derecha (fuera del CanvasGroup para que el 3D se dibuje siempre)
	showcase = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -30, 1, -20),
		Size = UDim2.fromOffset(440, 260),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	fitToScreen(showcase)

	buildLeaderboard(root)

	openMenu()

	ClientState.DataChanged.Event:Connect(refreshInfo)
	refreshInfo()

	-- También se puede empezar con Enter / botón A del mando
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not ClientState.InMainMenu or Menu.IsOpen() or ClientState.WheelOpen or ClientState.NewsOpen then
			return
		end
		if input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.ButtonA then
			play()
		end
	end)
end

return MainMenu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="115">
            <Properties>
              <string name="Name">MatchIntro</string>
              <string name="Source"><![CDATA[-- Presentación de la partida (como en los shooters de móvil): al empezar cada ronda, unos segundos
-- con el mapa y el modo arriba y los dos equipos enfrentados (jugadores y bots; tú en amarillo).
-- En todos contra todos, la lista de participantes. Se va sola y no bloquea nada.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Teams = game:GetService("Teams")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent.UI)
local ClientState = require(script.Parent.ClientState)
local RewardFX = require(script.Parent.RewardFX)

local player = Players.LocalPlayer

local MatchIntro = {}

local SHOW_TIME = 4.5
local MAX_ROWS = 6

local gui, panel, title, subtitle, columns
local showToken = 0

-- Miembros de cada equipo: { [nombreEquipo] = { { Name, Me, Bot } } }
local function rosters()
	local byTeam = {}
	local function add(teamName, entry)
		byTeam[teamName] = byTeam[teamName] or {}
		table.insert(byTeam[teamName], entry)
	end
	for _, other in Players:GetPlayers() do
		if not other:GetAttribute("InMenu") or other == player then
			add(other.Team and other.Team.Name or "", { Name = other.DisplayName, Me = other == player })
		end
	end
	local stats = ReplicatedStorage:FindFirstChild("BotStats")
	if stats then
		for _, entry in stats:GetChildren() do
			add(entry:GetAttribute("Team") or "", { Name = entry.Name, Bot = true })
		end
	end
	for _, list in byTeam do
		table.sort(list, function(a, b)
			if a.Me ~= b.Me then
				return a.Me == true
			end
			if (a.Bot == true) ~= (b.Bot == true) then
				return not a.Bot
			end
			return a.Name < b.Name
		end)
	end
	return byTeam
end

local function fillColumn(column, list, color)
	for _, child in column:GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	for i, entry in list do
		if i > MAX_ROWS then
			break
		end
		UI.label({
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 30),
			Text = (entry.Bot and "🤖 " or "") .. entry.Name,
			TextSize = 22,
			TextColor3 = entry.Me and Color3.fromRGB(255, 225, 80) or Color3.new(1, 1, 1),
			BackgroundTransparency = 0.15,
			BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.62),
			Parent = column,
		}, { UI.corner(6) })
	end
end

local function refresh()
	local byTeam = rosters()
	local teamMode = ReplicatedStorage:GetAttribute("TeamMode") == true
	if teamMode then
		local nameA = ReplicatedStorage:GetAttribute("TeamA") or ""
		local nameB = ReplicatedStorage:GetAttribute("TeamB") or ""
		local teamA, teamB = Teams:FindFirstChild(nameA), Teams:FindFirstChild(nameB)
		local colorA = teamA and teamA:IsA("Team") and teamA.TeamColor.Color or Color3.fromRGB(220, 50, 50)
		local colorB = teamB and teamB:IsA("Team") and teamB.TeamColor.Color or Color3.fromRGB(50, 110, 230)
		columns.Left.Header.Text = "EQUIPO " .. UI.upper(nameA)
		columns.Left.Bar.BackgroundColor3 = colorA
		columns.Right.Header.Text = "EQUIPO " .. UI.upper(nameB)
		columns.Right.Bar.BackgroundColor3 = colorB
		fillColumn(columns.Left.List, byTeam[nameA] or {}, colorA)
		fillColumn(columns.Right.List, byTeam[nameB] or {}, colorB)
		columns.Versus.Text = string.format("%d  VS  %d", #(byTeam[nameA] or {}), #(byTeam[nameB] or {}))
		columns.Right.Frame.Visible = true
	else
		local everyone = {}
		for _, list in byTeam do
			for _, entry in list do
				table.insert(everyone, entry)
			end
		end
		columns.Left.Header.Text = "TODOS CONTRA TODOS"
		columns.Left.Bar.BackgroundColor3 = Color3.fromRGB(255, 210, 90)
		fillColumn(columns.Left.List, everyone, Color3.fromRGB(90, 90, 100))
		columns.Versus.Text = #everyone .. " EN PARTIDA"
		columns.Right.Frame.Visible = false
	end
end

function MatchIntro.Show()
	if ClientState.InMainMenu then
		return
	end
	showToken += 1
	local token = showToken
	title.Text = UI.upper(ReplicatedStorage:GetAttribute("MapName") or "")
	-- (con la versión de luz del mapa si ha tocado una: "Atardecer", "Niebla"...)
	local map = workspace:FindFirstChild("Map")
	local variant = map and map:GetAttribute("Variant")
	local icons = { Atardecer = "🌅 ", Noche = "🌙 ", Niebla = "🌫 ", Tormenta = "⛈ ", ["Mediodía"] = "☀ ", Ventisca = "❄ " }
	subtitle.Text = (ReplicatedStorage:GetAttribute("ModeName") or "") .. (variant and ("  ·  " .. (icons[variant] or "") .. tostring(variant)) or "")
	refresh()
	gui.Enabled = true
	panel.GroupTransparency = 1
	TweenService:Create(panel, TweenInfo.new(0.35), { GroupTransparency = 0 }):Play()
	-- (los bots van entrando en el primer segundo: la lista se actualiza mientras se ve)
	task.spawn(function()
		local finish = os.clock() + SHOW_TIME
		while os.clock() < finish and token == showToken do
			task.wait(0.4)
			refresh()
		end
		if token ~= showToken then
			return
		end
		TweenService:Create(panel, TweenInfo.new(0.5), { GroupTransparency = 1 }):Play()
		task.wait(0.5)
		if token == showToken then
			gui.Enabled = false
			-- ¡A por ellos! (solo si la partida sigue en marcha)
			-- (no en Eliminación, Buscar y destruir ni Infección: ahí el servidor ya anuncia «¡YA!»,
			-- «ATACAS/DEFIENDES» o la fase de esconderse)
			local mode = ReplicatedStorage:GetAttribute("Mode")
			if ReplicatedStorage:GetAttribute("State") == "Playing" and not ClientState.InMainMenu
				and mode ~= "ELIM" and mode ~= "SND" and mode ~= "INF" and not ReplicatedStorage:GetAttribute("Frozen") then
				RewardFX.Punch("¡A LUCHAR!", Color3.fromRGB(255, 220, 90))
			end
		end
	end)
end

local function column(name, anchorX)
	local frame = UI.new("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(anchorX, 0),
		Position = UDim2.new(anchorX == 0 and 0.08 or 0.92, 0, 0, 120),
		Size = UDim2.new(0.34, 0, 0, 260),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	local header = UI.label({
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 36),
		Text = "",
		TextSize = 28,
		Parent = frame,
	})
	local bar = UI.new("Frame", {
		Name = "Bar",
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 0, 4),
		BorderSizePixel = 0,
		Parent = frame,
	})
	local list = UI.new("Frame", {
		Name = "List",
		Position = UDim2.fromOffset(0, 42),
		Size = UDim2.new(1, 0, 1, -42),
		BackgroundTransparency = 1,
		Parent = frame,
	}, { UI.new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }) })
	return { Frame = frame, Header = header, Bar = bar, List = list }
end

function MatchIntro.Init()
	gui = UI.new("ScreenGui", {
		Name = "MatchIntro",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 8,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	panel = UI.new("CanvasGroup", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(10, 12, 16),
		BackgroundTransparency = 0.12,
		GroupTransparency = 1,
		Parent = gui,
	})
	title = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 30),
		Size = UDim2.new(0.8, 0, 0, 50),
		Text = "",
		TextSize = 44,
		Parent = panel,
	})
	subtitle = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 80),
		Size = UDim2.new(0.8, 0, 0, 30),
		Text = "",
		TextSize = 24,
		TextColor3 = Color3.fromRGB(255, 210, 90),
		Parent = panel,
	})
	columns = {
		Left = column("Left", 0),
		Right = column("Right", 1),
		Versus = UI.label({
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 200),
			Size = UDim2.fromOffset(200, 50),
			Text = "VS",
			TextSize = 36,
			TextColor3 = Color3.fromRGB(255, 255, 255),
			Parent = panel,
		}),
	}
	local lastState = ReplicatedStorage:GetAttribute("State")
	ReplicatedStorage:GetAttributeChangedSignal("State"):Connect(function()
		local state = ReplicatedStorage:GetAttribute("State")
		if state == "Playing" and lastState ~= "Playing" then
			task.delay(0.8, MatchIntro.Show)
		elseif state ~= "Playing" then
			showToken += 1
			gui.Enabled = false
		end
		lastState = state
	end)
end

return MatchIntro
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="116">
            <Properties>
              <string name="Name">Menu</string>
              <string name="Source"><![CDATA[-- Menú principal del jugador (tecla B): perfil, pase de batalla, retos, armas, skins, trajes, efectos y tienda.
local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local MarketplaceService = game:GetService("MarketplaceService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Skins = require(Shared.Skins)
local Weapons = require(Shared.Weapons)
local Outfits = require(Shared.Outfits)
local Shop = require(Shared.Shop)
local Mastery = require(Shared.Mastery)
local KillEffects = require(Shared.KillEffects)
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)
local Ranks = require(Shared.Ranks)
local Charms = require(Shared.Charms)
local Sprays = require(Shared.Sprays)
local Titles = require(Shared.Titles)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local WeaponIcon = require(script.Parent.WeaponIcon)
local Effects = require(script.Parent.Effects)
local Settings = require(script.Parent.Settings)
local RewardFX = require(script.Parent.RewardFX)

local player = Players.LocalPlayer

local Menu = {}

local gui, panel, content, headerInfo, toast
local tabButtons = {}
local currentTab = "Pase"
local busy = false
local refresh -- reconstruye la pestaña actual (definida más abajo)
local scrollToCoins = false -- al abrir la Tienda, bajar hasta los packs de monedas
local coinsSection -- título de la sección de monedas de la Tienda (para bajar hasta él)
local panelScale -- UIScale del panel (las posiciones en pantalla vienen escaladas)

local GOLD = Color3.fromRGB(255, 190, 40)
local PANEL_BG = Color3.fromRGB(22, 24, 38)
local CARD_BG = Color3.fromRGB(38, 42, 64)
local GREEN = Color3.fromRGB(60, 170, 90)
local BLUE = Color3.fromRGB(40, 120, 255)
local GREY = Color3.fromRGB(70, 70, 82)

local TABS = { "Perfil", "Pase", "Retos", "Armas", "Skins", "Trajes", "Efectos", "Tienda", "Ajustes" }

local function rarityColor(rarity)
	return Skins.RarityColors[rarity] or Color3.new(1, 1, 1)
end

local function showToast(text, color)
	if not toast then
		return
	end
	toast.Text = text
	toast.TextColor3 = color or Color3.new(1, 1, 1)
	toast.Visible = true
	local token = {}
	toast:SetAttribute("T", tostring(token))
	task.delay(2.5, function()
		if toast:GetAttribute("T") == tostring(token) then
			toast.Visible = false
		end
	end)
end

local function coinsText(n)
	return "🪙 " .. tostring(n)
end

-- Skin con la que se ve un arma (camuflaje de maestría elegido o skin general)
local function skinFor(data, weaponName)
	local camo = data.WeaponCamos and data.WeaponCamos[weaponName]
	if camo and Mastery.HasCamo(data.WeaponKills and data.WeaponKills[weaponName] or 0, camo) then
		return camo
	end
	return data.EquippedSkin
end
Menu.SkinFor = skinFor

-- Barra de progreso sencilla
local function progressBar(parent, position, size, fraction, color)
	local bar = UI.new("Frame", {
		Position = position,
		Size = size,
		BackgroundColor3 = Color3.fromRGB(20, 22, 34),
		Parent = parent,
	}, { UI.corner(6) })
	UI.new("Frame", {
		Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1),
		BackgroundColor3 = color,
		Parent = bar,
	}, { UI.corner(6), UI.gloss() })
	return bar
end

local function scroller(layout)
	return UI.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		Parent = content,
	}, { layout })
end

local function buy(kind, id)
	if busy then
		return
	end
	busy = true
	Sounds.Play("Click")
	local ok, result, message = pcall(function()
		return Remotes.BuyItem:InvokeServer(kind, id)
	end)
	busy = false
	if ok and result then
		Sounds.Play("Kill")
		showToast(message or "¡Comprado!", GOLD)
	else
		showToast(ok and (message or "No se pudo comprar") or "Error de conexión", Color3.fromRGB(255, 90, 90))
		-- Le faltan monedas: se le lleva a los packs de monedas de la Tienda (si ya se pueden comprar)
		local canBuyCoins = false
		for _, pack in Shop.CoinPacks do
			canBuyCoins = canBuyCoins or pack.ProductId ~= 0
		end
		if ok and canBuyCoins and type(message) == "string" and string.find(message, "^Te faltan") then
			local fromTab = currentTab
			task.delay(1.2, function()
				if ClientState.MenuOpen and currentTab == fromTab and currentTab ~= "Tienda" then
					currentTab = "Tienda"
					scrollToCoins = true
					refresh()
				end
			end)
		end
	end
end

-- Maniquí R15 sencillo para previsualizar trajes
local function mannequin(outfitId)
	local model = Instance.new("Model")
	local skin = Color3.fromRGB(255, 204, 153)
	local legs = Color3.fromRGB(60, 60, 70)
	local torso = Color3.fromRGB(90, 120, 200)
	local parts = {
		{ "Head", Vector3.new(1.2, 1.2, 1.2), 0, 5.2, skin },
		{ "UpperTorso", Vector3.new(2, 1.6, 1), 0, 3.8, torso },
		{ "LowerTorso", Vector3.new(2, 0.4, 1), 0, 2.8, torso },
		{ "LeftUpperArm", Vector3.new(1, 1.2, 1), -1.5, 4.0, skin },
		{ "RightUpperArm", Vector3.new(1, 1.2, 1), 1.5, 4.0, skin },
		{ "LeftLowerArm", Vector3.new(1, 1.1, 1), -1.5, 2.85, skin },
		{ "RightLowerArm", Vector3.new(1, 1.1, 1), 1.5, 2.85, skin },
		{ "LeftHand", Vector3.new(1, 0.3, 1), -1.5, 2.15, skin },
		{ "RightHand", Vector3.new(1, 0.3, 1), 1.5, 2.15, skin },
		{ "LeftUpperLeg", Vector3.new(1, 1.2, 1), -0.5, 2.0, legs },
		{ "RightUpperLeg", Vector3.new(1, 1.2, 1), 0.5, 2.0, legs },
		{ "LeftLowerLeg", Vector3.new(1, 1.1, 1), -0.5, 0.85, legs },
		{ "RightLowerLeg", Vector3.new(1, 1.1, 1), 0.5, 0.85, legs },
		{ "LeftFoot", Vector3.new(1, 0.3, 1), -0.5, 0.15, legs },
		{ "RightFoot", Vector3.new(1, 0.3, 1), 0.5, 0.15, legs },
	}
	for _, spec in parts do
		local p = Instance.new("Part")
		p.Name = spec[1]
		p.Size = spec[2]
		p.CFrame = CFrame.new(spec[3], spec[4], 0)
		p.Color = spec[5]
		p.Anchored = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
	end
	local face = Instance.new("Part")
	face.Size = Vector3.new(0.6, 0.12, 0.05)
	face.CFrame = CFrame.new(0, 5.35, -0.62)
	face.Color = Color3.fromRGB(25, 25, 25)
	face.Anchored = true
	face.Parent = model
	Outfits.Apply(model, outfitId)
	return model
end

local function outfitViewport(outfitId, props)
	local viewport = UI.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(170, 170, 185),
		LightColor = Color3.new(1, 1, 1),
		LightDirection = Vector3.new(-1, -1.5, 1),
	})
	for k, v in props do
		viewport[k] = v
	end
	local model = mannequin(outfitId)
	model.Parent = viewport
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	camera.CFrame = CFrame.lookAt(Vector3.new(5, 4.6, -12), Vector3.new(0, 3, 0))
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	return viewport
end

---------------------------------------------------------------------------
-- Pestaña: Pase de batalla
---------------------------------------------------------------------------

local function rewardCard(reward, unlocked, premium, parent, order)
	local card = UI.new("Frame", {
		LayoutOrder = order,
		Size = UDim2.fromOffset(120, 116),
		BackgroundColor3 = CARD_BG,
		Parent = parent,
	}, { UI.corner(10), UI.stroke(premium and GOLD or Color3.fromRGB(90, 100, 140), 2, 0) })

	if not reward then
		UI.label({ Size = UDim2.fromScale(1, 1), Text = "—", TextSize = 30, TextTransparency = 0.5, Parent = card })
	elseif reward.Type == "Skin" then
		local skin = Skins.Get(reward.Id)
		WeaponIcon.Create(
			ClientState.Data and ClientState.Data.Primary or "ARX27",
			reward.Id,
			{ Position = UDim2.fromOffset(4, 4), Size = UDim2.fromOffset(112, 52), Parent = card },
			"angled",
			112 / 52
		)
		UI.label({ Position = UDim2.fromOffset(0, 58), Size = UDim2.new(1, 0, 0, 22), Text = skin.Name, TextSize = 17, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 80),
			Size = UDim2.new(1, 0, 0, 18),
			Text = skin.Rarity,
			TextSize = 14,
			TextColor3 = rarityColor(skin.Rarity),
			Parent = card,
		})
	elseif reward.Type == "Outfit" then
		local outfit = Outfits.Get(reward.Id)
		outfitViewport(reward.Id, { Position = UDim2.fromOffset(20, 2), Size = UDim2.fromOffset(80, 70), Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 74), Size = UDim2.new(1, 0, 0, 20), Text = outfit.Name, TextSize = 15, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 94),
			Size = UDim2.new(1, 0, 0, 16),
			Text = outfit.Rarity,
			TextSize = 13,
			TextColor3 = rarityColor(outfit.Rarity),
			Parent = card,
		})
	elseif reward.Type == "KillEffect" then
		local effect = KillEffects.Get(reward.Id)
		UI.label({ Position = UDim2.fromOffset(0, 14), Size = UDim2.new(1, 0, 0, 44), Text = effect.Icon, TextSize = 38, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 62), Size = UDim2.new(1, 0, 0, 22), Text = effect.Name, TextSize = 16, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 84),
			Size = UDim2.new(1, 0, 0, 16),
			Text = "Efecto · " .. effect.Rarity,
			TextSize = 13,
			TextColor3 = rarityColor(effect.Rarity),
			Parent = card,
		})
	elseif reward.Type == "Crate" then
		UI.label({ Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 40), Text = "🎁", TextSize = 36, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 66), Size = UDim2.new(1, 0, 0, 24), Text = "Caja", TextSize = 18, Parent = card })
	else
		UI.label({ Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 40), Text = "🪙", TextSize = 34, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 62),
			Size = UDim2.new(1, 0, 0, 24),
			Text = tostring(reward.Amount),
			TextSize = 20,
			TextColor3 = GOLD,
			Parent = card,
		})
	end

	if reward then
		UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -4, 0, 2),
			Size = UDim2.fromOffset(24, 24),
			Text = unlocked and "✔" or "🔒",
			TextSize = 18,
			TextColor3 = unlocked and Color3.fromRGB(90, 230, 110) or Color3.new(1, 1, 1),
			ZIndex = 3,
			Parent = card,
		})
		if not unlocked then
			UI.new("Frame", {
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Color3.new(0, 0, 0),
				BackgroundTransparency = 0.5,
				ZIndex = 2,
				Parent = card,
			}, { UI.corner(10) })
		end
	end
	return card
end

local function buildPassPage(data)
	local page = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = content })
	local per = data.XPPerLevel or GameConfig.XPPerLevel
	UI.label({
		Size = UDim2.fromOffset(420, 26),
		Text = "Nivel " .. data.Level .. "  ·  " .. data.XP .. " / " .. per .. " XP",
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = page,
	})
	local bar = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.fromOffset(420, 12),
		BackgroundColor3 = Color3.fromRGB(10, 10, 15),
		Parent = page,
	}, { UI.corner(6) })
	UI.new("Frame", {
		Size = UDim2.fromScale(math.clamp(data.XP / per, 0, 1), 1),
		BackgroundColor3 = Color3.fromRGB(80, 170, 255),
		Parent = bar,
	}, { UI.corner(6), UI.gloss() })

	if data.Premium then
		UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 4),
			Size = UDim2.fromOffset(260, 34),
			Text = "👑 PREMIUM ACTIVO",
			TextSize = 22,
			TextColor3 = GOLD,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = page,
		})
	else
		local buyPass = UI.button({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 2),
			Size = UDim2.fromOffset(260, 40),
			Text = "👑 Obtener Premium",
			BackgroundColor3 = GOLD,
			TextColor3 = Color3.fromRGB(40, 25, 0),
			Parent = page,
		}, { UI.gloss() })
		buyPass.Activated:Connect(function()
			if GameConfig.PremiumPassId == 0 then
				showToast("Próximamente")
				return
			end
			MarketplaceService:PromptGamePassPurchase(player, GameConfig.PremiumPassId)
		end)
	end

	UI.label({ Position = UDim2.fromOffset(0, 98), Size = UDim2.fromOffset(70, 116), Text = "GRATIS", TextSize = 16, Parent = page })
	UI.label({
		Position = UDim2.fromOffset(0, 222),
		Size = UDim2.fromOffset(70, 116),
		Text = "PREMIUM",
		TextSize = 16,
		TextColor3 = GOLD,
		Parent = page,
	})

	local scroll = UI.new("ScrollingFrame", {
		Position = UDim2.fromOffset(74, 56),
		Size = UDim2.new(1, -74, 1, -56),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		Parent = page,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	-- Solo se dibujan los niveles cercanos al tuyo (cada premio lleva un modelo 3D: con 50 a la vez el
	-- menú iría lento)
	-- (al final del pase la ventana se queda en los últimos niveles: si no, quedaría vacía)
	local first = math.max(1, math.min(data.Level - 2, #GameConfig.BattlePass - 14))
	local last = math.min(#GameConfig.BattlePass, first + 14)
	for tier = first, last do
		local rewards = GameConfig.BattlePass[tier]
		local reached = data.Level >= tier
		local column = UI.new("Frame", {
			LayoutOrder = tier,
			Size = UDim2.fromOffset(120, 280),
			BackgroundTransparency = 1,
			Parent = scroll,
		}, {
			UI.new("UIListLayout", {
				Padding = UDim.new(0, 8),
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		UI.label({
			LayoutOrder = 0,
			Size = UDim2.fromOffset(120, 26),
			Text = "NIVEL " .. tier,
			TextSize = 18,
			TextColor3 = reached and Color3.fromRGB(90, 230, 110) or Color3.fromRGB(180, 180, 190),
			Parent = column,
		})
		rewardCard(rewards.Free, reached, false, column, 1)
		rewardCard(rewards.Premium, reached and data.Premium, true, column, 2)
	end
	if last < #GameConfig.BattlePass then
		UI.label({
			LayoutOrder = last + 1,
			Size = UDim2.fromOffset(120, 280),
			Text = "… y " .. (#GameConfig.BattlePass - last) .. " niveles más\n(hasta el " .. #GameConfig.BattlePass .. ")",
			TextSize = 16,
			TextWrapped = true,
			TextColor3 = Color3.fromRGB(190, 195, 220),
			Parent = scroll,
		})
	end
	-- Después del pase
	local bonus = GameConfig.PostPassRewards
	if bonus then
		UI.label({
			LayoutOrder = last + 2,
			Size = UDim2.fromOffset(150, 280),
			Text = "⭐ Después del nivel " .. #GameConfig.BattlePass .. ":\ncada " .. bonus.Every .. " niveles\n+" .. bonus.Coins .. " 🪙\ny " .. bonus.Crates .. " 📦",
			TextSize = 16,
			TextWrapped = true,
			TextColor3 = GOLD,
			Parent = scroll,
		})
	end
end

---------------------------------------------------------------------------
-- Pestaña: Retos diarios
---------------------------------------------------------------------------

-- Logros: para cada estadística, el siguiente sin reclamar (o nil si ya están todos)
local function nextAchievements(data)
	local list, seen = {}, {}
	for _, achievement in GameConfig.Achievements do
		if not seen[achievement.Stat] and not (data.Achievements or {})[achievement.Id] then
			seen[achievement.Stat] = true
			table.insert(list, achievement)
		end
	end
	return list
end

-- ¿Cuántos logros se pueden reclamar ya? (aviso en la pestaña Perfil)
local function claimableAchievements(data)
	local count = 0
	for _, achievement in GameConfig.Achievements do
		if not (data.Achievements or {})[achievement.Id] and (tonumber(data[achievement.Stat]) or 0) >= achievement.Goal then
			count += 1
		end
	end
	return count
end

-- Perfil: rango, nivel, estadísticas de siempre, arma favorita y colección
local function buildProfilePage(data)
	local scroll = scroller(UI.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }))
	-- Rango y nivel
	local points = data.RankPoints or 0
	local tier = Ranks.Get(points)
	local fraction, nextTier = Ranks.Progress(points)
	local top = UI.new("Frame", { LayoutOrder = 1, Size = UDim2.new(1, -12, 0, 120), BackgroundColor3 = CARD_BG, Parent = scroll }, {
		UI.corner(12),
		UI.stroke(tier.Color, 2, 0.2),
	})
	UI.label({ Position = UDim2.fromOffset(12, 10), Size = UDim2.fromOffset(100, 100), Text = tier.Icon, TextSize = 72, Parent = top })
	UI.label({
		Position = UDim2.fromOffset(120, 12),
		Size = UDim2.new(1, -140, 0, 34),
		Text = UI.upper(tier.Name) .. "   ·   " .. points .. " RP",
		TextSize = 30,
		TextColor3 = tier.Color,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = top,
	})
	progressBar(top, UDim2.fromOffset(120, 54), UDim2.new(1, -140, 0, 16), fraction, tier.Color)
	-- Temporada de rango (al acabar: premio por el mejor rango y los RP a la mitad)
	if data.RankSeasonName and data.RankSeasonEndsAt then
		local daysLeft = math.max(0, math.ceil((data.RankSeasonEndsAt - os.time()) / 86400))
		UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -16, 0, 16),
			Size = UDim2.fromOffset(300, 24),
			Text = "🏁 " .. data.RankSeasonName .. " · quedan " .. daysLeft .. " días",
			TextSize = 17,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = Color3.fromRGB(200, 205, 225),
			Parent = top,
		})
	end
	local nextText = "¡Rango máximo!"
	if nextTier then
		nextText = string.format("Faltan %d RP para %s %s", nextTier.Min - points, nextTier.Icon, nextTier.Name)
	end
	UI.label({
		Position = UDim2.fromOffset(120, 78),
		Size = UDim2.new(1, -140, 0, 26),
		Text = nextText .. "     ·     Nivel " .. data.Level .. (data.VIP and "  👑 VIP" or ""),
		TextSize = 18,
		TextColor3 = Color3.fromRGB(200, 205, 225),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = top,
	})

	-- Estadísticas
	local kills, deaths = data.TotalKills or 0, data.TotalDeaths or 0
	local matches, wins = data.Matches or 0, data.Wins or 0
	local stats = {
		{ "🎯", "Bajas", tostring(kills) },
		{ "💀", "Muertes", tostring(deaths) },
		{ "⚖", "K/D", string.format("%.2f", kills / math.max(1, deaths)) },
		{ "🏆", "Victorias", tostring(wins) },
		{ "🎮", "Partidas", tostring(matches) },
		{ "📈", "% victorias", matches > 0 and (math.floor(wins / matches * 100 + 0.5) .. "%") or "-" },
		{ "🔥", "Mejor racha", tostring(data.BestStreak or 0) },
		{ "🧠", "A la cabeza", tostring(data.Headshots or 0) },
		{ "🤝", "Asistencias", tostring(data.Assists or 0) },
		(function()
			-- (del evento en marcha; fuera de temporada, genérico)
			local event = GameConfig.CurrentEvent()
			local items = event and event.Items or "evento"
			return { event and event.ItemIcon or "🎉", string.upper(string.sub(items, 1, 1)) .. string.sub(items, 2), tostring(data.EventCandy or 0) }
		end)(),
	}
	local grid = UI.new("Frame", { LayoutOrder = 2, Size = UDim2.new(1, -12, 0, 170), BackgroundTransparency = 1, Parent = scroll }, {
		UI.new("UIGridLayout", { CellSize = UDim2.new(0.2, -10, 0, 80), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i, stat in stats do
		local cell = UI.new("Frame", { LayoutOrder = i, BackgroundColor3 = CARD_BG, Parent = grid }, { UI.corner(10) })
		UI.label({ Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 36), Text = stat[1] .. " " .. stat[3], TextSize = 28, Parent = cell })
		UI.label({ Position = UDim2.fromOffset(0, 48), Size = UDim2.new(1, 0, 0, 22), Text = stat[2], TextSize = 16, TextColor3 = Color3.fromRGB(170, 180, 215), Parent = cell })
	end

	-- Arma favorita (la de más bajas) y colección
	local favorite, favoriteKills = nil, 0
	for name, count in data.WeaponKills or {} do
		local def = Weapons.Get(name)
		if def and not def.Hidden and type(count) == "number" and count > favoriteKills then
			favorite, favoriteKills = name, count
		end
	end
	local bottom = UI.new("Frame", { LayoutOrder = 3, Size = UDim2.new(1, -12, 0, 130), BackgroundTransparency = 1, Parent = scroll })
	local favCard = UI.new("Frame", { Size = UDim2.new(0.5, -5, 1, 0), BackgroundColor3 = CARD_BG, Parent = bottom }, { UI.corner(12) })
	UI.label({ Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 24), Text = "⭐ ARMA FAVORITA", TextSize = 18, TextColor3 = GOLD, TextXAlignment = Enum.TextXAlignment.Left, Parent = favCard })
	if favorite then
		WeaponIcon.Create(favorite, skinFor(data, favorite), { Position = UDim2.fromOffset(10, 34), Size = UDim2.new(0.55, 0, 0, 86), Parent = favCard }, "angled", 2.2)
		UI.label({
			Position = UDim2.new(0.58, 0, 0, 44),
			Size = UDim2.new(0.42, -12, 0, 60),
			Text = Weapons.Get(favorite).DisplayName .. "\n" .. favoriteKills .. " bajas",
			TextSize = 20,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = favCard,
		})
	else
		UI.label({ Position = UDim2.fromOffset(14, 50), Size = UDim2.new(1, -28, 0, 40), Text = "¡Haz alguna baja para descubrirla!", TextSize = 18, Parent = favCard })
	end
	local function count(owned, list, skip)
		local have, total = 0, 0
		for id, item in list do
			if id ~= "Default" and not (skip and skip(item)) then
				total += 1
				if owned and owned[id] then
					have += 1
				end
			end
		end
		return have, total
	end
	local skinsHave, skinsTotal = count(data.Skins, Skins.List, function(skin)
		return skin.Mastery == true
	end)
	local outfitsHave, outfitsTotal = count(data.Outfits, Outfits.List)
	local effectsHave, effectsTotal = count(data.KillEffects, KillEffects.List)
	local collection = UI.new("Frame", { Position = UDim2.new(0.5, 5, 0, 0), Size = UDim2.new(0.5, -5, 1, 0), BackgroundColor3 = CARD_BG, Parent = bottom }, { UI.corner(12) })
	UI.label({ Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 24), Text = "🎒 COLECCIÓN", TextSize = 18, TextColor3 = GOLD, TextXAlignment = Enum.TextXAlignment.Left, Parent = collection })
	for i, row in { { "🎨 Skins", skinsHave, skinsTotal }, { "🦺 Trajes", outfitsHave, outfitsTotal }, { "💥 Efectos", effectsHave, effectsTotal } } do
		local y = 36 + (i - 1) * 30
		UI.label({ Position = UDim2.fromOffset(14, y), Size = UDim2.fromOffset(110, 22), Text = row[1], TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, Parent = collection })
		progressBar(collection, UDim2.fromOffset(124, y + 5), UDim2.new(1, -210, 0, 12), row[2] / math.max(1, row[3]), BLUE)
		UI.label({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, y), Size = UDim2.fromOffset(70, 22), Text = row[2] .. "/" .. row[3], TextSize = 16, TextXAlignment = Enum.TextXAlignment.Right, Parent = collection })
	end

	-- Logros (el siguiente de cada tipo)
	local claimedCount = 0
	for _ in data.Achievements or {} do
		claimedCount += 1
	end
	UI.label({
		LayoutOrder = 4,
		Size = UDim2.new(1, -12, 0, 30),
		Text = "🏅 LOGROS  ·  " .. claimedCount .. "/" .. #GameConfig.Achievements,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = GOLD,
		Parent = scroll,
	})
	local pending = nextAchievements(data)
	if #pending == 0 then
		UI.label({ LayoutOrder = 5, Size = UDim2.new(1, -12, 0, 40), Text = "¡Los tienes todos! 👑", TextSize = 20, Parent = scroll })
	end
	for i, achievement in pending do
		local value = tonumber(data[achievement.Stat]) or 0
		local ready = value >= achievement.Goal
		local card = UI.new("Frame", {
			LayoutOrder = 4 + i,
			Size = UDim2.new(1, -12, 0, 58),
			BackgroundColor3 = ready and Color3.fromRGB(40, 80, 50) or CARD_BG,
			Parent = scroll,
		}, { UI.corner(10), UI.stroke(ready and GREEN or Color3.fromRGB(90, 100, 140), 2, 0.2) })
		UI.label({ Position = UDim2.fromOffset(10, 0), Size = UDim2.fromOffset(40, 58), Text = achievement.Icon, TextSize = 28, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(54, 6),
			Size = UDim2.new(1, -250, 0, 24),
			Text = achievement.Text,
			TextSize = 18,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		progressBar(card, UDim2.fromOffset(54, 36), UDim2.new(1, -330, 0, 10), math.min(value, achievement.Goal) / achievement.Goal, ready and GREEN or BLUE)
		UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -196, 0, 30),
			Size = UDim2.fromOffset(70, 22),
			Text = math.min(value, achievement.Goal) .. "/" .. achievement.Goal,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = card,
		})
		local button = UI.button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(170, 38),
			Text = ready and ("🎁 Reclamar " .. coinsText(achievement.Coins)) or coinsText(achievement.Coins),
			TextSize = 16,
			BackgroundColor3 = ready and GREEN or GREY,
			AutoButtonColor = ready,
			Parent = card,
		}, { UI.gloss() })
		if ready then
			button.Activated:Connect(function()
				if busy then
					return
				end
				busy = true
				local ok, success, result = pcall(function()
					return Remotes.ClaimAchievement:InvokeServer(achievement.Id)
				end)
				busy = false
				if ok and success then
					Sounds.Play("Kill")
					showToast("🏅 ¡Logro conseguido! +" .. tostring(result) .. " 🪙", GREEN)
					RewardFX.FlyCoins(headerInfo, 8)
					RewardFX.EdgeFlash(GREEN, 0.4)
				else
					showToast(ok and tostring(result) or "No se pudo reclamar", Color3.fromRGB(255, 90, 90))
				end
			end)
		end
	end

	-- Títulos: salen junto a tu nombre en el marcador y el chat
	local equippedTitle = data.EquippedTitle or "Novato"
	if not Titles.Owns(data, equippedTitle, data.VIP == true) then
		equippedTitle = "Novato"
	end
	UI.label({
		LayoutOrder = 40,
		Size = UDim2.new(1, -12, 0, 30),
		Text = "🏷 TÍTULO  ·  " .. Titles.Get(equippedTitle).Name .. "  (sale junto a tu nombre en el marcador y el chat)",
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = GOLD,
		Parent = scroll,
	})
	local grid = UI.new("Frame", {
		LayoutOrder = 41,
		Size = UDim2.new(1, -12, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = scroll,
	}, {
		UI.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(196, 62),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for i, id in Titles.Sorted() do
		local title = Titles.List[id]
		local owned = Titles.Owns(data, id, data.VIP == true)
		local equipped = id == equippedTitle
		local chip = UI.button({
			LayoutOrder = i,
			Text = "",
			BackgroundColor3 = equipped and Color3.fromRGB(60, 55, 25) or CARD_BG,
			AutoButtonColor = not equipped,
			Parent = grid,
		}, { UI.corner(10), UI.stroke(equipped and GOLD or (owned and title.Color or Color3.fromRGB(70, 75, 100)), 2, owned and 0.1 or 0.5) })
		UI.label({
			Position = UDim2.fromOffset(6, 6),
			Size = UDim2.new(1, -12, 0, 26),
			Text = (owned and "" or "🔒 ") .. title.Name,
			TextSize = 19,
			TextColor3 = owned and title.Color or Color3.fromRGB(140, 145, 165),
			TextScaled = true,
			Parent = chip,
		})
		local status
		if equipped then
			status = "✔ Elegido"
		elseif owned then
			status = "Elegir"
		elseif title.Price then
			status = coinsText(Shop.GetPrice("Title", id) or title.Price)
		else
			status = Titles.Requirement(id)
		end
		UI.label({
			Position = UDim2.fromOffset(6, 34),
			Size = UDim2.new(1, -12, 0, 20),
			Text = status,
			TextSize = 15,
			TextColor3 = equipped and GREEN or (title.Price and not owned and GOLD or Color3.fromRGB(190, 195, 220)),
			Parent = chip,
		})
		chip.Activated:Connect(function()
			if equipped then
				return
			end
			if owned then
				Sounds.Play("Click")
				Remotes.EquipTitle:FireServer(id)
			elseif title.Price then
				buy("Title", id)
			else
				showToast("🔒 Para conseguirlo: " .. Titles.Requirement(id), Color3.fromRGB(255, 200, 90))
			end
		end)
	end
end

local function buildChallengesPage(data)
	local info = data.Challenges
	local scroll = scroller(UI.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }))
	local secondsLeft = 86400 - os.time() % 86400
	UI.label({
		LayoutOrder = 0,
		Size = UDim2.new(1, -12, 0, 30),
		Text = string.format("RETOS DE HOY  ·  nuevos en %dh %02dm", secondsLeft // 3600, (secondsLeft % 3600) // 60),
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = GOLD,
		Parent = scroll,
	})
	if not info then
		return
	end
	for i, challenge in info.List do
		local card = UI.new("Frame", {
			LayoutOrder = i,
			Size = UDim2.new(1, -12, 0, 96),
			BackgroundColor3 = challenge.Done and Color3.fromRGB(34, 70, 50) or CARD_BG,
			Parent = scroll,
		}, { UI.corner(12), UI.stroke(challenge.Done and GREEN or Color3.fromRGB(90, 100, 140), 2, 0) })
		UI.label({
			Position = UDim2.fromOffset(16, 10),
			Size = UDim2.new(1, -260, 0, 28),
			Text = (challenge.Done and "✅ " or "🎯 ") .. challenge.Text,
			TextSize = 22,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		progressBar(card, UDim2.fromOffset(16, 50), UDim2.new(1, -300, 0, 14), challenge.Progress / challenge.Goal, challenge.Done and GREEN or BLUE)
		UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -270, 0, 66),
			Size = UDim2.fromOffset(140, 20),
			Text = challenge.Progress .. " / " .. challenge.Goal,
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = card,
		})
		UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -16, 0, 12),
			Size = UDim2.fromOffset(230, 26),
			Text = coinsText(challenge.Coins) .. "   +" .. challenge.XP .. " XP",
			TextSize = 20,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = GOLD,
			Parent = card,
		})
		if not challenge.Done and info.RerollsLeft > 0 then
			local reroll = UI.button({
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -16, 1, -10),
				Size = UDim2.fromOffset(150, 32),
				Text = "🔄 Cambiar reto",
				TextSize = 16,
				BackgroundColor3 = Color3.fromRGB(110, 80, 200),
				Parent = card,
			}, { UI.gloss() })
			reroll.Activated:Connect(function()
				if busy then
					return
				end
				busy = true
				Sounds.Play("Click")
				local ok, result = pcall(function()
					return Remotes.RerollChallenge:InvokeServer(i)
				end)
				busy = false
				if not (ok and result) then
					showToast("No se pudo cambiar el reto", Color3.fromRGB(255, 90, 90))
				end
			end)
		end
	end
	local done = 0
	for _, challenge in info.List do
		if challenge.Done then
			done += 1
		end
	end
	local bonus = UI.new("Frame", {
		LayoutOrder = 10,
		Size = UDim2.new(1, -12, 0, 70),
		BackgroundColor3 = info.Bonus and Color3.fromRGB(70, 60, 20) or Color3.fromRGB(50, 40, 70),
		Parent = scroll,
	}, { UI.corner(12), UI.stroke(GOLD, 2, info.Bonus and 0 or 0.5) })
	UI.label({
		Position = UDim2.fromOffset(16, 0),
		Size = UDim2.new(1, -32, 1, 0),
		Text = info.Bonus and "🎁 ¡Premio de hoy conseguido! Tienes una caja gratis en la Tienda"
			or ("🎁 Completa los " .. #info.List .. " retos (" .. done .. "/" .. #info.List .. ") y gana " .. info.BonusCrates .. " caja gratis"),
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = GOLD,
		Parent = bonus,
	})
	-- Retos semanales: más largos y con más premio (sin cambio de reto)
	local weekly = info.Weekly
	if weekly and #weekly.List > 0 then
		local left = math.max(0, (weekly.EndsAt or 0) - os.time())
		UI.label({
			LayoutOrder = 11,
			Size = UDim2.new(1, -12, 0, 34),
			Text = "📅 RETOS DE LA SEMANA  ·  nuevos en " .. (left >= 86400 and string.format("%dd %dh", left // 86400, (left % 86400) // 3600)
				or string.format("%dh %02dm", left // 3600, (left % 3600) // 60)),
			TextSize = 22,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.fromRGB(120, 200, 255),
			Parent = scroll,
		})
		local weeklyDone = 0
		for i, challenge in weekly.List do
			if challenge.Done then
				weeklyDone += 1
			end
			local card = UI.new("Frame", {
				LayoutOrder = 11 + i,
				Size = UDim2.new(1, -12, 0, 76),
				BackgroundColor3 = challenge.Done and Color3.fromRGB(34, 70, 50) or Color3.fromRGB(28, 40, 66),
				Parent = scroll,
			}, { UI.corner(12), UI.stroke(challenge.Done and GREEN or Color3.fromRGB(80, 150, 230), 2, 0) })
			UI.label({
				Position = UDim2.fromOffset(16, 8),
				Size = UDim2.new(1, -260, 0, 28),
				Text = (challenge.Done and "✅ " or "📅 ") .. challenge.Text,
				TextSize = 21,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = card,
			})
			progressBar(card, UDim2.fromOffset(16, 46), UDim2.new(1, -300, 0, 14), challenge.Progress / challenge.Goal, challenge.Done and GREEN or Color3.fromRGB(80, 150, 230))
			UI.label({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -270, 0, 42),
				Size = UDim2.fromOffset(140, 20),
				Text = challenge.Progress .. " / " .. challenge.Goal,
				TextSize = 16,
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = card,
			})
			UI.label({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -16, 0, 10),
				Size = UDim2.fromOffset(230, 26),
				Text = coinsText(challenge.Coins) .. "   +" .. challenge.XP .. " XP",
				TextSize = 20,
				TextXAlignment = Enum.TextXAlignment.Right,
				TextColor3 = GOLD,
				Parent = card,
			})
		end
		local weeklyBonus = UI.new("Frame", {
			LayoutOrder = 20,
			Size = UDim2.new(1, -12, 0, 56),
			BackgroundColor3 = weekly.Bonus and Color3.fromRGB(70, 60, 20) or Color3.fromRGB(30, 45, 80),
			Parent = scroll,
		}, { UI.corner(12), UI.stroke(Color3.fromRGB(120, 200, 255), 2, weekly.Bonus and 0 or 0.5) })
		UI.label({
			Position = UDim2.fromOffset(16, 0),
			Size = UDim2.new(1, -32, 1, 0),
			Text = weekly.Bonus and "🎁 ¡Premio de la semana conseguido! Tus cajas están en la Tienda"
				or ("🎁 Completa los " .. #weekly.List .. " retos semanales (" .. weeklyDone .. "/" .. #weekly.List .. ") y gana " .. weekly.BonusCrates .. " cajas gratis"),
			TextSize = 19,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.fromRGB(150, 215, 255),
			Parent = weeklyBonus,
		})
	end
	-- Evento de temporada: premios por caramelos (GameConfig.Event) con su vista previa
	local event = GameConfig.CurrentEvent()
	if event and ReplicatedStorage:GetAttribute("EventName") then
		local icon, itemIcon, items = event.Icon or "🎉", event.ItemIcon or "⭐", event.Items or "objetos"
		local candy = data.EventCandy or 0
		local card = UI.new("Frame", {
			LayoutOrder = 30,
			Size = UDim2.new(1, -12, 0, 214),
			BackgroundColor3 = Color3.fromRGB(50, 26, 66),
			Parent = scroll,
		}, { UI.corner(12), UI.stroke(Color3.fromRGB(255, 140, 30), 2, 0.1) })
		UI.label({
			Position = UDim2.fromOffset(16, 8),
			Size = UDim2.new(1, -32, 0, 28),
			Text = icon .. " EVENTO DE " .. UI.upper(event.Name) .. "  ·  " .. itemIcon .. " " .. math.min(candy, event.Goal) .. " / " .. event.Goal .. " " .. items,
			TextSize = 22,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.fromRGB(255, 170, 60),
			Parent = card,
		})
		UI.label({
			Position = UDim2.fromOffset(16, 34),
			Size = UDim2.new(1, -32, 0, 20),
			Text = "Recoge los " .. items .. " que aparecen por el mapa durante las partidas",
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.fromRGB(210, 195, 230),
			Font = UI.FontBody,
			TextStrokeTransparency = 1,
			Parent = card,
		})
		progressBar(card, UDim2.fromOffset(16, 60), UDim2.new(1, -32, 0, 12), candy / event.Goal, Color3.fromRGB(255, 140, 30))
		-- Premios: los de por el camino y la skin final
		local prizes = {}
		for _, milestone in event.Milestones or {} do
			if milestone.Count < event.Goal then
				table.insert(prizes, milestone)
			end
		end
		table.insert(prizes, { Count = event.Goal, Skin = event.RewardSkin })
		local width = 1 / #prizes
		for i, prize in prizes do
			local got = candy >= prize.Count
			if prize.Weapon then
				got = (data.OwnedWeapons or {})[prize.Weapon] == true -- (se da al recoger el siguiente caramelo)
			end
			local cell = UI.new("Frame", {
				Position = UDim2.new(width * (i - 1), i == 1 and 16 or 6, 0, 82),
				Size = UDim2.new(width, i == 1 and -22 or -12, 0, 122),
				BackgroundColor3 = got and Color3.fromRGB(40, 80, 50) or CARD_BG,
				Parent = card,
			}, { UI.corner(10), UI.stroke(got and GREEN or Color3.fromRGB(110, 90, 140), 2, 0.2) })
			local preview = { Position = UDim2.fromOffset(4, 2), Size = UDim2.new(1, -8, 0, 78), Parent = cell }
			local title
			if prize.Outfit and Outfits.List[prize.Outfit] then
				outfitViewport(prize.Outfit, preview)
				title = "Traje " .. Outfits.List[prize.Outfit].Name
			elseif prize.Weapon and Weapons.Get(prize.Weapon) then
				WeaponIcon.Create(prize.Weapon, "Default", preview, "angled", 2.2)
				title = Weapons.Get(prize.Weapon).DisplayName
			elseif prize.Skin and Skins.List[prize.Skin] then
				WeaponIcon.Create(data.Primary or "ARX27", prize.Skin, preview, "angled", 2.2)
				title = "Skin " .. Skins.List[prize.Skin].Name
			else
				UI.label({ Position = UDim2.fromOffset(0, 14), Size = UDim2.new(1, 0, 0, 50), Text = "🪙", TextSize = 44, Parent = cell })
				title = coinsText(prize.Coins or 0)
			end
			UI.label({
				Position = UDim2.new(0, 4, 1, -42),
				Size = UDim2.new(1, -8, 0, 20),
				Text = title,
				TextSize = 15,
				TextScaled = true,
				Parent = cell,
			})
			UI.label({
				Position = UDim2.new(0, 4, 1, -22),
				Size = UDim2.new(1, -8, 0, 18),
				Text = got and "✅ Conseguido" or (itemIcon .. " " .. prize.Count),
				TextSize = 15,
				TextColor3 = got and Color3.fromRGB(150, 255, 150) or Color3.fromRGB(255, 190, 90),
				Parent = cell,
			})
		end
	end
	UI.label({
		LayoutOrder = 31,
		Size = UDim2.new(1, -12, 0, 40),
		Text = "Consejo: cada arma tiene MAESTRÍA. Consigue bajas con ella para ganar camuflajes Carbono, Oro, Diamante y Materia oscura (pestaña Armas).",
		TextSize = 15,
		TextWrapped = true,
		TextColor3 = Color3.fromRGB(190, 195, 220),
		Font = UI.FontBody,
		TextStrokeTransparency = 1,
		Parent = scroll,
	})
end

