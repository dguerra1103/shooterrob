GameConfig.PremiumPassId = 0

-- Insignias de Roblox (Creator Hub → Insignias). Pega el ID de cada una; con 0 no se da.
GameConfig.Badges = {
	Welcome = 0, -- entrar por primera vez
	FirstKill = 0, -- primera baja
	Kills100 = 0, -- 100 bajas
	FirstWin = 0, -- primera victoria
	Level10 = 0, -- nivel 10
	RankGold = 0, -- llegar a rango Oro
	RankDiamond = 0, -- llegar a rango Diamante
	RankChampion = 0, -- llegar a rango Campeón
}

-- Después del último nivel del pase: cada Every niveles, Coins monedas y Crates cajas gratis.
GameConfig.PostPassRewards = { Every = 5, Coins = 300, Crates = 1 }

-- Recompensas por nivel. Free = pase gratis, Premium = pase de pago.
-- Tipos: { Type = "Skin", Id = "<id de Skins>" } o { Type = "Coins", Amount = n }
GameConfig.BattlePass = {
	{ Free = { Type = "Coins", Amount = 50 }, Premium = { Type = "Skin", Id = "Sakura" } },
	{ Free = { Type = "Skin", Id = "Toxico" }, Premium = { Type = "Coins", Amount = 150 } },
	{ Free = { Type = "Coins", Amount = 75 }, Premium = { Type = "Skin", Id = "Hielo" } },
	{ Free = nil, Premium = { Type = "Coins", Amount = 200 } },
	{ Free = { Type = "Skin", Id = "Selva" }, Premium = { Type = "Skin", Id = "Calabaza" } },
	{ Free = { Type = "Coins", Amount = 100 }, Premium = { Type = "Coins", Amount = 250 } },
	{ Free = nil, Premium = { Type = "Skin", Id = "Vacio" } },
	{ Free = { Type = "Coins", Amount = 125 }, Premium = { Type = "Coins", Amount = 300 } },
	{ Free = { Type = "Skin", Id = "Oceano" }, Premium = { Type = "Skin", Id = "Dorado" } },
	{ Free = { Type = "Coins", Amount = 150 }, Premium = { Type = "Coins", Amount = 400 } },
	{ Free = nil, Premium = { Type = "Skin", Id = "Galaxia" } },
	{ Free = { Type = "Coins", Amount = 200 }, Premium = { Type = "Coins", Amount = 500 } },
	{ Free = { Type = "Skin", Id = "Atardecer" }, Premium = { Type = "Skin", Id = "Dragon" } },
	{ Free = { Type = "Coins", Amount = 250 }, Premium = { Type = "Coins", Amount = 750 } },
	{ Free = { Type = "Coins", Amount = 500 }, Premium = { Type = "Skin", Id = "Magma" } },
}

-- Niveles 16 a 50 del pase (para que dure: unas 40 partidas). Cada 5 niveles, caja gratis y un
-- traje o un efecto en la vía premium; el resto, monedas y camuflajes.
do
	local premiumBig = {
		[20] = { Type = "Outfit", Id = "NeonRecon" },
		[25] = { Type = "Outfit", Id = "VoltBruiser" },
		[30] = { Type = "Outfit", Id = "FrostByte" },
		[35] = { Type = "Outfit", Id = "ToxicRogue" },
		[40] = { Type = "KillEffect", Id = "Rayo" },
		[45] = { Type = "KillEffect", Id = "AgujeroNegro" },
		[50] = { Type = "Outfit", Id = "GoldenAce" },
	}
	local premiumSkins = { "CamoBosque", "CamoDesierto", "CamoDigital", "CamoArtico", "CamoTigre", "CamoNebulosa", "Prisma" }
	local skinIndex = 0
	for tier = 16, 50 do
		local entry
		if tier % 5 == 0 then
			entry = { Free = { Type = "Crate", Amount = tier == 50 and 3 or 1 }, Premium = premiumBig[tier] }
		elseif tier % 5 == 3 then
			skinIndex += 1
			entry = { Free = { Type = "Coins", Amount = 100 + tier * 5 }, Premium = { Type = "Skin", Id = premiumSkins[(skinIndex - 1) % #premiumSkins + 1] } }
		else
			entry = { Free = tier % 2 == 0 and { Type = "Coins", Amount = 100 + tier * 5 } or nil, Premium = { Type = "Coins", Amount = 250 + tier * 10 } }
		end
		table.insert(GameConfig.BattlePass, entry)
	end
end

return GameConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">KillEffects</string>
          <string name="Source"><![CDATA[-- Efectos de eliminación: lo que ven todos cuando eliminas a alguien (como en Arsenal).
-- Se compran con monedas en el menú (pestaña Efectos) y se dibujan en Effects.KillEffect (cliente).
local KillEffects = {}

KillEffects.List = {
	Default = { Name = "Estallido", Rarity = "Común", Icon = "💥", Description = "El de siempre, del color de su equipo." },
	Confeti = { Name = "Confeti", Rarity = "Raro", Icon = "🎉", Price = 500, Description = "¡Fiesta! Una lluvia de papelitos de colores." },
	Amor = { Name = "Amor", Rarity = "Raro", Icon = "💖", Price = 600, Description = "Corazones que suben flotando." },
	Fuego = { Name = "Llamarada", Rarity = "Épico", Icon = "🔥", Price = 800, Description = "Una columna de fuego." },
	Hielo = { Name = "Congelado", Rarity = "Épico", Icon = "❄️", Price = 800, Description = "Estalla en cristales de hielo." },
	Fantasma = { Name = "Fantasma", Rarity = "Épico", Icon = "👻", Price = 900, Description = "Su fantasma sale volando." },
	Calavera = { Name = "Calavera", Rarity = "Legendario", Icon = "💀", Price = 1200, Description = "Calavera gigante y humo rojo." },
	Rayo = { Name = "Rayo", Rarity = "Legendario", Icon = "⚡", Price = 1500, Description = "Un rayo cae del cielo." },
	Monedas = { Name = "Lluvia de monedas", Rarity = "Legendario", Icon = "🪙", Price = 1500, Description = "Revienta en monedas de oro." },
	AgujeroNegro = { Name = "Agujero negro", Rarity = "Mítico", Icon = "🌀", Price = 3000, Description = "Se lo traga un agujero negro." },
	Pintura = { Name = "Pintura", Rarity = "Épico", Icon = "🎨", Price = 900, Description = "Revienta en bolas de pintura y lo deja todo manchado." },
	Arcoiris = { Name = "Arcoíris", Rarity = "Legendario", Icon = "🌈", Price = 1800, Description = "Un arcoíris sale disparado de tu rival." },
	-- Halloween
	Murcielagos = { Name = "Murciélagos", Rarity = "Épico", Icon = "🦇", Price = 1000, Description = "Una bandada de murciélagos sale volando entre humo morado." },
	Calabazas = { Name = "Calabazas", Rarity = "Legendario", Icon = "🎃", Price = 1600, Description = "Revienta en calabazas que saltan, con una calabaza gigante y un diablillo." },
	-- Navidad
	Fuegos = { Name = "Fuegos artificiales", Rarity = "Legendario", Icon = "🎆", Price = 1700, Description = "Tres cohetes de colores estallan encima de tu rival." },
	Rodadora = { Name = "Rodadora", Rarity = "Épico", Icon = "🤠", Price = 900, Description = "Polvareda del desierto, matojos que salen rodando y un sombrero de vaquero volando." },
	Nieve = { Name = "Ventisca", Rarity = "Legendario", Icon = "☃️", Price = 1600, Description = "Revienta en copos de nieve y aparece un muñeco de nieve." },
}

function KillEffects.Get(id)
	return KillEffects.List[id] or KillEffects.List.Default
end

return KillEffects
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Mastery</string>
          <string name="Source"><![CDATA[-- Maestría de armas: las bajas con cada arma desbloquean camuflajes exclusivos para ESA arma
-- (y monedas). Los camuflajes son skins con Mastery = true (ver Skins.luau): no se venden ni salen en cajas.
local Mastery = {}

Mastery.Tiers = {
	{ Kills = 25, Camo = "MaestriaCarbono", Name = "Carbono", Coins = 100 },
	{ Kills = 75, Camo = "MaestriaOro", Name = "Oro", Coins = 250 },
	{ Kills = 150, Camo = "MaestriaDiamante", Name = "Diamante", Coins = 500 },
	{ Kills = 300, Camo = "MaestriaOscura", Name = "Materia oscura", Coins = 1000 },
}

-- Nivel de maestría alcanzado (0 = ninguno)
function Mastery.Level(kills)
	local level = 0
	for i, tier in Mastery.Tiers do
		if (kills or 0) >= tier.Kills then
			level = i
		end
	end
	return level
end

-- Siguiente nivel por conseguir (nil si ya tiene todos)
function Mastery.Next(kills)
	return Mastery.Tiers[Mastery.Level(kills) + 1]
end

-- ¿Tiene desbloqueado este camuflaje con esas bajas?
function Mastery.HasCamo(kills, camoId)
	for i, tier in Mastery.Tiers do
		if tier.Camo == camoId then
			return Mastery.Level(kills) >= i
		end
	end
	return false
end

return Mastery
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Outfits</string>
          <string name="Source"><![CDATA[-- Trajes de operador: armadura hecha con piezas que se sueldan al personaje R15.
-- Las piezas se escalan con el tamaño de cada parte del cuerpo, así funcionan con cualquier avatar.
local Outfits = {}

local RGB = Color3.fromRGB

Outfits.List = {
	Default = {
		Name = "Tu avatar",
		Rarity = "Común",
		Class = "Sin traje",
	},
	BlazeRunner = {
		Name = "Blaze Runner",
		Rarity = "Legendario",
		Class = "Clase asalto",
		Body = RGB(28, 26, 28),
		Cloth = RGB(200, 30, 30),
		Glow = RGB(255, 120, 20),
		Plate = RGB(70, 70, 76),
		Pieces = { Vest = true, Pouches = true, Backpack = true, Shoulders = true, Belt = true, Knees = true, Boots = true, Gloves = true, Headset = true, Mask = true, Scarf = true },
	},
	NeonRecon = {
		Name = "Neon Recon",
		Rarity = "Legendario",
		Class = "Clase francotirador",
		Body = RGB(22, 22, 28),
		Cloth = RGB(20, 20, 26),
		Glow = RGB(0, 200, 255),
		Plate = RGB(235, 238, 245),
		Pieces = { Vest = true, Pouches = true, Backpack = true, Belt = true, Knees = true, Boots = true, Gloves = true, Headset = true, Visor = true, Scarf = true },
	},
	VoltBruiser = {
		Name = "Volt Bruiser",
		Rarity = "Mítico",
		Class = "Clase pesada",
		Body = RGB(30, 30, 32),
		Cloth = RGB(40, 40, 44),
		Glow = RGB(255, 200, 30),
		Plate = RGB(225, 225, 230),
		Heavy = true,
		Pieces = { Vest = true, Pouches = true, Backpack = true, Shoulders = true, Belt = true, Knees = true, Boots = true, Gloves = true, Headset = true, Gauntlets = true },
	},
	FrostByte = {
		Name = "Frost Byte",
		Rarity = "Épico",
		Class = "Clase reconocimiento",
		Body = RGB(220, 235, 250),
		Cloth = RGB(150, 200, 240),
		Glow = RGB(120, 230, 255),
		Plate = RGB(255, 255, 255),
		Pieces = { Vest = true, Belt = true, Knees = true, Boots = true, Gloves = true, Visor = true, Scarf = true },
	},
	ToxicRogue = {
		Name = "Toxic Rogue",
		Rarity = "Épico",
		Class = "Clase infiltración",
		Body = RGB(30, 40, 30),
		Cloth = RGB(60, 90, 40),
		Glow = RGB(130, 255, 60),
		Plate = RGB(50, 60, 50),
		Pieces = { Vest = true, Pouches = true, Belt = true, Boots = true, Gloves = true, Mask = true, Headset = true },
	},
	GoldenAce = {
		Name = "Golden Ace",
		Rarity = "Mítico",
		Class = "Edición de lujo",
		Body = RGB(25, 22, 18),
		Cloth = RGB(30, 26, 22),
		Glow = RGB(255, 220, 120),
		Plate = RGB(240, 180, 50),
		PlateMaterial = Enum.Material.Foil,
		Pieces = { Vest = true, Pouches = true, Backpack = true, Shoulders = true, Belt = true, Knees = true, Boots = true, Gloves = true, Visor = true, Gauntlets = true },
	},
	-- Halloween: cabeza de calabaza con cara iluminada y capa (premio del evento, ver GameConfig.Event)
	Calabaza = {
		Name = "Cabeza de Calabaza",
		Rarity = "Legendario",
		Class = "Evento Halloween",
		Event = "🎃 50 caramelos", -- solo se consigue en el evento (no se vende ni sale en cajas)
		Body = RGB(25, 20, 30),
		Cloth = RGB(60, 30, 80),
		Glow = RGB(255, 170, 40),
		Plate = RGB(255, 130, 20),
		Pieces = { Pumpkin = true, Cape = true, Belt = true, Boots = true, Gloves = true },
	},
	-- Navidad: premio del evento (50 regalos)
	PapaNoel = {
		Name = "Papá Noel",
		Rarity = "Legendario",
		Class = "Evento Navidad",
		Event = "🎄 50 regalos (diciembre)",
		Body = RGB(30, 25, 25),
		Cloth = RGB(205, 30, 40),
		Glow = RGB(255, 215, 70),
		Plate = RGB(250, 250, 252),
		Sleeves = true,
		Pieces = { SantaHat = true, Beard = true, Belt = true, Boots = true, Gloves = true, FurTrim = true },
	},
	-- Halloween (en la tienda con monedas)
	Vampiro = {
		Name = "Conde Vampiro",
		Rarity = "Legendario",
		Class = "Halloween",
		Body = RGB(20, 18, 24),
		Cloth = RGB(35, 30, 40),
		Glow = RGB(230, 30, 50),
		Plate = RGB(240, 235, 240),
		Sleeves = true, -- brazos con la tela del traje (si no, se quedan con el color del avatar)
		Skin = RGB(225, 225, 235), -- piel pálida (cambia el color de la cabeza)
		Pieces = { Cape = true, VampireCollar = true, Medallion = true, Fangs = true, Belt = true, Boots = true, Gloves = true },
	},
	Momia = {
		Name = "Momia",
		Rarity = "Épico",
		Class = "Halloween",
		Body = RGB(215, 205, 180),
		Cloth = RGB(200, 190, 165),
		Glow = RGB(120, 255, 90),
		Plate = RGB(235, 228, 205),
		Sleeves = true,
		Pieces = { Bandages = true, MummyHead = true },
	},
	-- Oeste (en la tienda con monedas, a juego con el mapa Pueblo Vaquero)
	Vaquero = {
		Name = "Sheriff Vaquero",
		Rarity = "Legendario",
		Class = "Oeste",
		Body = RGB(95, 62, 38),
		Cloth = RGB(200, 70, 55),
		Glow = RGB(255, 205, 70),
		Plate = RGB(170, 115, 60),
		Sleeves = true,
		Pieces = { CowboyHat = true, Bandana = true, LeatherVest = true, SheriffStar = true, Belt = true, Holster = true, Boots = true, Gloves = true },
	},
	-- Piratas (en la tienda con monedas, a juego con el mapa Bahía Pirata)
	Pirata = {
		Name = "Capitán Pirata",
		Rarity = "Legendario",
		Class = "Piratas",
		Body = RGB(35, 30, 30),
		Cloth = RGB(150, 30, 40),
		Glow = RGB(255, 205, 70),
		Plate = RGB(30, 28, 32),
		Sleeves = true,
		Pieces = { Tricorn = true, EyePatch = true, PirateBeard = true, CoatTails = true, Sash = true, Boots = true, Gloves = true },
	},
	-- Medieval (en la tienda con monedas, a juego con el Castillo del Rey)
	Caballero = {
		Name = "Caballero Real",
		Rarity = "Legendario",
		Class = "Medieval",
		Body = RGB(120, 125, 135),
		Cloth = RGB(60, 70, 160),
		Glow = RGB(255, 205, 70),
		Plate = RGB(200, 205, 215),
		PlateMaterial = Enum.Material.Metal,
		Sleeves = true,
		Pieces = { KnightHelm = true, Tabard = true, Shoulders = true, Gauntlets = true, Belt = true, Boots = true, Cape = true },
	},
}

function Outfits.Get(id)
	return Outfits.List[id] or Outfits.List.Default
end

-- Colores de los brazos en primera persona (manga, guante y puño)
function Outfits.ArmColors(id)
	local o = Outfits.List[id]
	if not o or not o.Body then
		return nil
	end
	return { Sleeve = o.Cloth, Glove = o.Body, Cuff = o.Glow, Plate = o.Plate }
end

---------------------------------------------------------------------------
-- Construcción sobre el personaje
---------------------------------------------------------------------------

local function newPiece(folder, bodyPart, name, offsetScale, offsetAdd, sizeScale, sizeAdd, color, material, rotation)
	local s = bodyPart.Size
	local part = Instance.new("Part")
	part.Name = name
	part.Size = Vector3.new(s.X * sizeScale.X + sizeAdd.X, s.Y * sizeScale.Y + sizeAdd.Y, s.Z * sizeScale.Z + sizeAdd.Z)
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	local offset = Vector3.new(s.X * offsetScale.X + offsetAdd.X, s.Y * offsetScale.Y + offsetAdd.Y, s.Z * offsetScale.Z + offsetAdd.Z)
	part.CFrame = bodyPart.CFrame * CFrame.new(offset) * (rotation or CFrame.new())
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = bodyPart
	weld.Part1 = part
	weld.Parent = part
	part.Parent = folder
	return part
end

local V = Vector3.new
local Z = Vector3.zero

-- Colores originales del avatar: se guardan (atributo OrigColor) la primera vez que un traje los
-- cambia y se devuelven al quitarlo o cambiar de traje (si no, la cabeza pálida del vampiro o las
-- mangas se quedarían con el traje siguiente)
local BODY_PARTS = {
	"Head", "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm",
	"RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot",
}
local BODY_COLOR_FIELDS = { "HeadColor3", "TorsoColor3", "LeftArmColor3", "RightArmColor3", "LeftLegColor3", "RightLegColor3" }

local function rememberColors(character)
	for _, name in BODY_PARTS do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") and part:GetAttribute("OrigColor") == nil then
			part:SetAttribute("OrigColor", part.Color)
		end
	end
	local bodyColors = character:FindFirstChildOfClass("BodyColors")
	if bodyColors then
		for _, field in BODY_COLOR_FIELDS do
			if bodyColors:GetAttribute(field) == nil then
				bodyColors:SetAttribute(field, bodyColors[field])
			end
		end
	end
end

local function restoreColors(character)
	for _, name in BODY_PARTS do
		local part = character:FindFirstChild(name)
		local color = part and part:GetAttribute("OrigColor")
		if typeof(color) == "Color3" then
			part.Color = color
		end
	end
	local bodyColors = character:FindFirstChildOfClass("BodyColors")
	if bodyColors then
		for _, field in BODY_COLOR_FIELDS do
			local color = bodyColors:GetAttribute(field)
			if typeof(color) == "Color3" then
				bodyColors[field] = color
			end
		end
	end
end

-- Quita el traje actual del personaje (y le devuelve sus colores)
function Outfits.Remove(character)
	local old = character:FindFirstChild("Outfit")
	if old then
		old:Destroy()
	end
	restoreColors(character)
end

-- Pone el traje `id` en el personaje (R15). Devuelve true si se aplicó.
-- Uniforme de soldado para los bots de los mapas realistas (no se vende ni sale en el armario):
-- verde oliva con casco, chaleco, cinturón, rodilleras, botas y guantes; el color del equipo en el
-- brazalete y en los detalles del chaleco para distinguirlos
function Outfits.Soldier(teamColor)
	return {
		Id = "Soldier",
		Name = "Soldado",
		Body = RGB(66, 70, 54),
		Cloth = RGB(98, 102, 76),
		Glow = teamColor or RGB(200, 200, 200),
		Plate = RGB(78, 82, 62),
		PlateMaterial = Enum.Material.Fabric,
		Sleeves = true, -- (manga larga, como un uniforme de verdad)
		Realistic = true,
		Pieces = { Vest = true, Pouches = true, Belt = true, Knees = true, Boots = true, Gloves = true, CombatHelmet = true, Armband = true, Backpack = true },
	}
end

-- id: un traje de Outfits.List o una tabla con un traje hecho al momento (Outfits.Soldier)
function Outfits.Apply(character, id)
	Outfits.Remove(character)
	local o = type(id) == "table" and id or Outfits.List[id]
	if not o or not o.Pieces then
		return false
	end
	local function get(name)
		return character:FindFirstChild(name)
	end
	local upper, lower, head = get("UpperTorso"), get("LowerTorso"), get("Head")
	if not upper or not lower or not head then
		return false -- solo R15
	end

	rememberColors(character)
	-- La ropa clásica taparía los colores del traje
	for _, child in character:GetChildren() do
		if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") then
			child:Destroy()
		end
	end
	local bodyColors = character:FindFirstChildOfClass("BodyColors")
	if bodyColors then
		bodyColors.TorsoColor3 = o.Cloth
		bodyColors.LeftLegColor3 = o.Body
		bodyColors.RightLegColor3 = o.Body
	end
	for _, name in { "UpperTorso", "LowerTorso" } do
		get(name).Color = o.Cloth
	end
	if o.Skin then
		if bodyColors then
			bodyColors.HeadColor3 = o.Skin
		end
		head.Color = o.Skin
	end
	if o.Sleeves then
		if bodyColors then
			bodyColors.LeftArmColor3 = o.Cloth
			bodyColors.RightArmColor3 = o.Cloth
		end
		for _, name in { "LeftUpperArm", "LeftLowerArm", "RightUpperArm", "RightLowerArm" } do
			local p = get(name)
			if p then
				p.Color = o.Cloth
			end
		end
	end
	for _, name in { "LeftUpperLeg", "LeftLowerLeg", "RightUpperLeg", "RightLowerLeg" } do
		local p = get(name)
		if p then
			p.Color = o.Body
		end
	end

	local folder = Instance.new("Folder")
	folder.Name = "Outfit"
	folder:SetAttribute("Id", type(id) == "string" and id or (o.Id or "Custom"))
	folder.Parent = character

	local P = o.Pieces
	local plateMat = o.PlateMaterial or Enum.Material.SmoothPlastic
	local glow = Enum.Material.Neon
	local heavy = o.Heavy and 1.15 or 1

	-- Chaleco (cubre el torso) con placa delantera
	if P.Vest then
		newPiece(folder, upper, "Vest", V(0, -0.02, 0), Z, V(1.06 * heavy, 0.86, 1.18 * heavy), Z, o.Body)
		newPiece(folder, upper, "ChestPlate", V(0, 0.12, -0.6 * heavy), Z, V(0.7, 0.4, 0.12), Z, o.Plate, plateMat)
		newPiece(folder, upper, "ChestGlow", V(0, 0.12, -0.67 * heavy), Z, V(0.4, 0.05, 0.05), Z, o.Glow, glow)
	end
	if P.Pouches then
		for i, x in { -0.3, 0, 0.3 } do
			newPiece(folder, upper, "Pouch" .. i, V(x, -0.25, -0.66 * heavy), Z, V(0.24, 0.32, 0.18), Z, o.Body:Lerp(Color3.new(0, 0, 0), 0.25))
			newPiece(folder, upper, "PouchGlow" .. i, V(x, -0.25, -0.76 * heavy), Z, V(0.04, 0.2, 0.02), Z, o.Glow, glow)
		end
	end
	if P.Backpack then
		newPiece(folder, upper, "Backpack", V(0, -0.05, 0.85 * heavy), Z, V(0.72, 0.78, 0.55), Z, o.Body)
		newPiece(folder, upper, "BackpackPlate", V(0, 0.05, 1.13 * heavy), Z, V(0.42, 0.38, 0.05), Z, o.Plate, plateMat)
		newPiece(folder, upper, "BackpackEmblem", V(0, 0.05, 1.17 * heavy), Z, V(0.14, 0.14, 0.03), Z, o.Glow, glow, CFrame.Angles(0, 0, math.rad(45)))
	end
	-- Cinturón
	if P.Belt then
		newPiece(folder, lower, "Belt", V(0, 0.32, 0), Z, V(1.08, 0.3, 1.12), Z, o.Body:Lerp(Color3.new(0, 0, 0), 0.3))
		newPiece(folder, lower, "Buckle", V(0, 0.32, -0.58), Z, V(0.22, 0.22, 0.06), Z, o.Glow, glow)
	end

	-- Brazos y piernas (izquierda y derecha)
	for _, side in { "Left", "Right" } do
		local upperArm, lowerArm, hand = get(side .. "UpperArm"), get(side .. "LowerArm"), get(side .. "Hand")
		local upperLeg, lowerLeg, foot = get(side .. "UpperLeg"), get(side .. "LowerLeg"), get(side .. "Foot")
		local sx = side == "Left" and -1 or 1
		if P.Shoulders and upperArm then
			newPiece(folder, upperArm, "Shoulder", V(0.05 * sx, 0.3, 0), Z, V(1.35 * heavy, 0.42, 1.3 * heavy), Z, o.Plate, plateMat)
			newPiece(folder, upperArm, "ShoulderGlow", V(0.05 * sx, 0.3, -0.66 * heavy), Z, V(0.8, 0.07, 0.03), Z, o.Glow, glow)
		end
		if P.Gauntlets and lowerArm then
			newPiece(folder, lowerArm, "Gauntlet", V(0, -0.05, 0), Z, V(1.3, 0.7, 1.3), Z, o.Plate, plateMat)
			newPiece(folder, lowerArm, "GauntletGlow", V(0, -0.05, -0.66), Z, V(0.5, 0.08, 0.03), Z, o.Glow, glow)
		end
		if P.Gloves and hand then
			newPiece(folder, hand, "Glove", Z, Z, V(1.15, 1.1, 1.15), Z, o.Body)
		end
		if P.Knees and lowerLeg then
			newPiece(folder, lowerLeg, "KneePad", V(0, 0.32, -0.55), Z, V(0.95, 0.32, 0.3), Z, o.Plate, plateMat)
			newPiece(folder, lowerLeg, "KneeGlow", V(0, 0.32, -0.72), Z, V(0.3, 0.1, 0.02), Z, o.Glow, glow)
		end
		if P.Boots and foot then
			newPiece(folder, foot, "Boot", V(0, 0.08, 0), Z, V(1.14, 1.15, 1.12), Z, o.Body)
			newPiece(folder, foot, "Sole", V(0, -0.42, 0), Z, V(1.17, 0.32, 1.15), Z, Color3.fromRGB(245, 245, 248))
			newPiece(folder, foot, "BootGlow", V(0, -0.2, 0), Z, V(1.18, 0.1, 1.16), Z, o.Glow, glow)
		end
		_ = upperLeg
	end

	-- Cabeza
	if P.Headset then
		for _, sx in { -1, 1 } do
			newPiece(folder, head, "EarCup", V(0.55 * sx, 0, 0), Z, V(0.18, 0.45, 0.45), Z, o.Body)
			newPiece(folder, head, "EarGlow", V(0.65 * sx, 0, 0), Z, V(0.03, 0.25, 0.25), Z, o.Glow, glow)
		end
		newPiece(folder, head, "Headband", V(0, 0.55, 0), Z, V(1.15, 0.1, 0.18), Z, o.Body)
		newPiece(folder, head, "Mic", V(-0.42, -0.25, -0.35), Z, V(0.06, 0.06, 0.45), Z, o.Body, nil, CFrame.Angles(0, math.rad(-30), 0))
	end
	if P.Visor then
		local visor = newPiece(folder, head, "Visor", V(0, 0.1, -0.52), Z, V(0.98, 0.24, 0.08), Z, o.Glow, glow)
		visor.Transparency = 0.15
		newPiece(folder, head, "VisorFrame", V(0, 0.1, -0.5), Z, V(1.04, 0.3, 0.06), Z, o.Body)
	end
	if P.Mask then
		newPiece(folder, head, "Mask", V(0, -0.22, -0.5), Z, V(0.92, 0.36, 0.1), Z, o.Body)
		for i, x in { -0.18, 0, 0.18 } do
			newPiece(folder, head, "MaskGlow" .. i, V(x, -0.2, -0.56), Z, V(0.08, 0.05, 0.02), Z, o.Glow, glow)
		end
	end
	if P.Pumpkin then
		-- Calabaza que envuelve la cabeza (malla de esfera: una Ball no se puede achatar)
		local pumpkin = newPiece(folder, head, "PumpkinHead", V(0, 0.05, 0), Z, V(1.55, 1.35, 1.55), Z, o.Plate)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = pumpkin
		newPiece(folder, head, "PumpkinStem", V(0, 0.75, 0), Z, V(0.14, 0.3, 0.14), Z, RGB(80, 120, 40))
		for _, sx in { -1, 1 } do
			newPiece(folder, head, "PumpkinEye", V(0.24 * sx, 0.15, -0.74), Z, V(0.2, 0.18, 0.06), Z, o.Glow, glow, CFrame.Angles(0, 0, math.rad(20 * sx)))
		end
		newPiece(folder, head, "PumpkinMouth", V(0, -0.2, -0.74), Z, V(0.55, 0.12, 0.06), Z, o.Glow, glow)
	end
	if P.Cape then
		newPiece(folder, upper, "Cape", V(0, -0.35, 0.62), Z, V(1.1, 1.7, 0.06), Z, o.Cloth, Enum.Material.Fabric, CFrame.Angles(math.rad(-8), 0, 0))
		newPiece(folder, upper, "CapeCollar", V(0, 0.48, 0.45), Z, V(1.0, 0.18, 0.25), Z, RGB(150, 30, 40), Enum.Material.Fabric)
	end
	if P.SantaHat then
		newPiece(folder, head, "SantaHatBrim", V(0, 0.45, 0), Z, V(1.18, 0.22, 1.18), Z, o.Plate, Enum.Material.Fabric)
		newPiece(folder, head, "SantaHat", V(0, 0.75, 0.05), Z, V(1.0, 0.5, 1.0), Z, o.Cloth, Enum.Material.Fabric)
		newPiece(folder, head, "SantaHatTip", V(0.25, 1.0, 0.25), Z, V(0.55, 0.4, 0.55), Z, o.Cloth, Enum.Material.Fabric, CFrame.Angles(math.rad(25), 0, math.rad(-30)))
		local pompom = newPiece(folder, head, "SantaPompom", V(0.5, 1.12, 0.45), Z, V(0.28, 0.28, 0.28), Z, o.Plate, Enum.Material.Fabric)
		pompom.Shape = Enum.PartType.Ball
	end
	if P.Beard then
		newPiece(folder, head, "Beard", V(0, -0.38, -0.42), Z, V(0.95, 0.55, 0.3), Z, o.Plate, Enum.Material.Fabric)
		newPiece(folder, head, "Moustache", V(0, -0.12, -0.55), Z, V(0.6, 0.12, 0.08), Z, o.Plate, Enum.Material.Fabric)
	end
	if P.FurTrim then
		-- Ribete blanco en el abrigo y en los puños
		newPiece(folder, upper, "CoatTrim", V(0, 0, -0.52), Z, V(0.18, 1.0, 0.08), Z, o.Plate, Enum.Material.Fabric)
		newPiece(folder, lower, "CoatHem", V(0, -0.3, 0), Z, V(1.1, 0.35, 1.14), Z, o.Plate, Enum.Material.Fabric)
		for _, side in { "Left", "Right" } do
			local lowerArm = get(side .. "LowerArm")
			if lowerArm then
				newPiece(folder, lowerArm, "Cuff", V(0, -0.38, 0), Z, V(1.15, 0.22, 1.15), Z, o.Plate, Enum.Material.Fabric)
			end
		end
	end
	if P.VampireCollar then
		-- Cuello alto de la capa, detrás de la cabeza (rojo por dentro)
		newPiece(folder, upper, "VampireCollarBack", V(0, 0.75, 0.5), Z, V(1.25, 0.75, 0.08), Z, o.Cloth, Enum.Material.Fabric, CFrame.Angles(math.rad(-15), 0, 0))
		newPiece(folder, upper, "VampireCollarLining", V(0, 0.75, 0.46), Z, V(1.15, 0.65, 0.04), Z, o.Glow, Enum.Material.Fabric, CFrame.Angles(math.rad(-15), 0, 0))
		for _, sx in { -1, 1 } do
			newPiece(folder, upper, "VampireCollarSide", V(0.55 * sx, 0.7, 0.15), Z, V(0.08, 0.6, 0.55), Z, o.Cloth, Enum.Material.Fabric, CFrame.Angles(0, math.rad(-20 * sx), 0))
		end
	end
	if P.Medallion then
		newPiece(folder, upper, "MedallionChain", V(0, 0.3, -0.55), Z, V(0.5, 0.05, 0.05), Z, RGB(230, 190, 70), Enum.Material.Metal)
		newPiece(folder, upper, "Medallion", V(0, 0.12, -0.58), Z, V(0.2, 0.2, 0.05), Z, o.Glow, glow, CFrame.Angles(0, 0, math.rad(45)))
	end
	if P.Fangs then
		for _, sx in { -1, 1 } do
			newPiece(folder, head, "Fang", V(0.1 * sx, -0.32, -0.5), Z, V(0.05, 0.12, 0.04), Z, Color3.new(1, 1, 1))
		end
		-- Ojos rojos
		for _, sx in { -1, 1 } do
			newPiece(folder, head, "VampireEye", V(0.17 * sx, 0.1, -0.51), Z, V(0.1, 0.06, 0.02), Z, o.Glow, glow)
		end
	end
	if P.Bandages then
		-- Vendas: tiras finas un poco inclinadas alrededor del torso, brazos y piernas
		local wrapped = { { upper, 4 }, { lower, 2 } }
		for _, side in { "Left", "Right" } do
			for _, name in { "UpperArm", "LowerArm", "UpperLeg", "LowerLeg" } do
				local limb = get(side .. name)
				if limb then
					table.insert(wrapped, { limb, 3 })
				end
			end
		end
		for w, entry in wrapped do
			local part, count = entry[1], entry[2]
			for i = 1, count do
				local y = -0.5 + (i - 0.5) / count
				local tilt = ((i + w) % 2 == 0 and 1 or -1) * 8
				newPiece(folder, part, "Bandage", V(0, y * 0.9, 0), Z, V(1.08, 0.12, 1.08), Z, i % 2 == 0 and o.Plate or o.Cloth, Enum.Material.Fabric, CFrame.Angles(0, 0, math.rad(tilt)))
			end
		end
	end
	if P.MummyHead then
		newPiece(folder, head, "MummyWrap", Z, Z, V(1.08, 1.04, 1.08), Z, o.Cloth, Enum.Material.Fabric)
		for i, y in { 0.35, 0.05, -0.3 } do
			newPiece(folder, head, "MummyStrip" .. i, V(0, y, 0), Z, V(1.12, 0.1, 1.12), Z, o.Plate, Enum.Material.Fabric, CFrame.Angles(0, 0, math.rad(i % 2 == 0 and 7 or -7)))
		end
		for _, sx in { -1, 1 } do
			newPiece(folder, head, "MummyEye", V(0.18 * sx, 0.18, -0.56), Z, V(0.14, 0.07, 0.03), Z, o.Glow, glow)
		end
	end
	if P.CombatHelmet then
		-- Casco de combate con funda de tela y gafas sobre el casco
		newPiece(folder, head, "Helmet", V(0, 0.36, 0.02), Z, V(1.12, 0.5, 1.16), Z, o.Plate, Enum.Material.Fabric)
		newPiece(folder, head, "HelmetRim", V(0, 0.14, 0.02), Z, V(1.18, 0.08, 1.24), Z, o.Plate:Lerp(Color3.new(0, 0, 0), 0.2), Enum.Material.Fabric)
		newPiece(folder, head, "HelmetGoggles", V(0, 0.44, -0.55), Z, V(0.7, 0.14, 0.08), Z, RGB(30, 32, 34), Enum.Material.Glass)
	end
	if P.Armband then
		local arm = get("LeftUpperArm")
		if arm then
			newPiece(folder, arm, "Armband", V(0, 0.15, 0), Z, V(1.12, 0.22, 1.12), Z, o.Glow, Enum.Material.Neon)
		end
	end
	if P.CowboyHat then
		-- Ala ancha (cilindro aplanado), copa y cinta dorada
		local function disc(name, offset, height, width, color)
			local part = newPiece(folder, head, name, offset, Z, V(height, width, width), Z, color, Enum.Material.Fabric, CFrame.Angles(0, 0, math.rad(90)))
			part.Shape = Enum.PartType.Cylinder
			return part
		end
		disc("HatBrim", V(0, 0.5, 0), 0.07, 2.1, o.Plate)
		-- (los lados del ala, un poco levantados)
		for _, sx in { -1, 1 } do
			newPiece(folder, head, "HatBrimCurl", V(0.86 * sx, 0.54, 0), Z, V(0.34, 0.06, 1.5), Z, o.Plate, Enum.Material.Fabric, CFrame.Angles(0, 0, math.rad(16 * sx)))
		end
		disc("HatCrown", V(0, 0.72, 0), 0.42, 1.05, o.Plate)
		disc("HatBand", V(0, 0.58, 0), 0.1, 1.09, o.Glow)
		newPiece(folder, head, "HatDent", V(0, 0.93, 0), Z, V(0.18, 0.05, 0.75), Z, o.Plate:Lerp(Color3.new(0, 0, 0), 0.25), Enum.Material.Fabric)
	end
	if P.KnightHelm then
		-- Yelmo cerrado con visera de rendija y penacho
		newPiece(folder, head, "Helm", V(0, 0.04, 0), Z, V(1.12, 1.1, 1.12), Z, o.Plate, Enum.Material.Metal)
		newPiece(folder, head, "HelmSlit", V(0, 0.12, -0.57), Z, V(0.75, 0.07, 0.03), Z, RGB(20, 20, 25), Enum.Material.SmoothPlastic)
		newPiece(folder, head, "HelmRidge", V(0, 0.2, 0), Z, V(0.12, 1.2, 1.18), Z, o.Glow, Enum.Material.Metal)
		newPiece(folder, head, "Plume", V(0, 0.75, 0.15), Z, V(0.14, 0.45, 0.8), Z, o.Cloth, Enum.Material.Fabric, CFrame.Angles(math.rad(-20), 0, 0))
	end
	if P.Tabard then
		-- Sobreveste con el emblema dorado
		newPiece(folder, upper, "Tabard", V(0, -0.05, -0.53), Z, V(0.8, 1.0, 0.05), Z, o.Cloth, Enum.Material.Fabric)
		newPiece(folder, upper, "TabardBack", V(0, -0.05, 0.53), Z, V(0.8, 1.0, 0.05), Z, o.Cloth, Enum.Material.Fabric)
		newPiece(folder, lower, "TabardSkirt", V(0, -0.9, -0.53), Z, V(0.8, 1.6, 0.05), Z, o.Cloth, Enum.Material.Fabric)
		newPiece(folder, upper, "TabardCrest", V(0, 0.05, -0.57), Z, V(0.3, 0.3, 0.03), Z, o.Glow, Enum.Material.SmoothPlastic, CFrame.Angles(0, 0, math.rad(45)))
	end
	if P.Tricorn then
		-- Sombrero de tres picos: copa, tres alas levantadas y calavera dorada delante
		newPiece(folder, head, "TricornCrown", V(0, 0.68, 0), Z, V(1.05, 0.4, 1.05), Z, o.Plate, Enum.Material.Fabric)
		for i = 0, 2 do
			local angle = math.rad(i * 120)
			newPiece(folder, head, "TricornBrim", V(math.sin(angle) * 0.45, 0.6, -math.cos(angle) * 0.45), Z, V(1.2, 0.35, 0.1), Z, o.Plate, Enum.Material.Fabric, CFrame.Angles(0, -angle, 0) * CFrame.Angles(math.rad(-25), 0, 0))
		end
		newPiece(folder, head, "TricornTrim", V(0, 0.52, 0), Z, V(1.12, 0.06, 1.12), Z, o.Glow, Enum.Material.Fabric)
		newPiece(folder, head, "TricornSkull", V(0, 0.7, -0.58), Z, V(0.22, 0.22, 0.04), Z, Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
	end
	if P.EyePatch then
		newPiece(folder, head, "EyePatch", V(0.17, 0.12, -0.52), Z, V(0.24, 0.2, 0.04), Z, RGB(15, 15, 18), Enum.Material.Fabric)
		newPiece(folder, head, "PatchStrap", V(0, 0.2, 0), Z, V(1.04, 0.05, 1.04), Z, RGB(15, 15, 18), Enum.Material.Fabric, CFrame.Angles(0, 0, math.rad(-12)))
	end
	if P.PirateBeard then
		newPiece(folder, head, "Beard", V(0, -0.36, -0.42), Z, V(0.85, 0.45, 0.28), Z, RGB(40, 25, 20), Enum.Material.Fabric)
		newPiece(folder, head, "Moustache", V(0, -0.12, -0.54), Z, V(0.55, 0.1, 0.06), Z, RGB(40, 25, 20), Enum.Material.Fabric)
	end
	if P.CoatTails then
		-- Casaca larga: faldones detrás y a los lados, con botones dorados delante
		newPiece(folder, lower, "CoatTail", V(0, -0.9, 0.42), Z, V(1.05, 1.6, 0.12), Z, o.Cloth, Enum.Material.Fabric, CFrame.Angles(math.rad(8), 0, 0))
		for _, sx in { -1, 1 } do
			newPiece(folder, lower, "CoatSide", V(0.5 * sx, -0.75, 0.1), Z, V(0.08, 1.3, 0.8), Z, o.Cloth, Enum.Material.Fabric)
			newPiece(folder, upper, "CoatLapel", V(0.28 * sx, 0.05, -0.52), Z, V(0.2, 0.85, 0.05), Z, o.Cloth:Lerp(Color3.new(0, 0, 0), 0.25), Enum.Material.Fabric)
		end
		for i = 0, 2 do
			newPiece(folder, upper, "CoatButton", V(-0.12, 0.25 - i * 0.25, -0.56), Z, V(0.07, 0.07, 0.03), Z, o.Glow, Enum.Material.SmoothPlastic)
		end
	end
	if P.Sash then
		newPiece(folder, lower, "Sash", V(0, 0.3, 0), Z, V(1.1, 0.35, 1.14), Z, o.Glow:Lerp(Color3.fromRGB(200, 40, 40), 0.7), Enum.Material.Fabric)
		newPiece(folder, lower, "SashKnot", V(0.42, 0.05, -0.5), Z, V(0.15, 0.5, 0.06), Z, o.Glow:Lerp(Color3.fromRGB(200, 40, 40), 0.7), Enum.Material.Fabric, CFrame.Angles(0, 0, math.rad(15)))
	end
	if P.Bandana then
		-- Pañuelo al cuello con el pico hacia abajo
		newPiece(folder, upper, "Bandana", V(0, 0.45, -0.05), Z, V(0.85, 0.15, 1.1), Z, o.Cloth:Lerp(Color3.new(1, 1, 1), 0.15), Enum.Material.Fabric)
		newPiece(folder, upper, "BandanaTip", V(0, 0.3, -0.55), Z, V(0.3, 0.3, 0.05), Z, o.Cloth:Lerp(Color3.new(1, 1, 1), 0.15), Enum.Material.Fabric, CFrame.Angles(0, 0, math.rad(45)))
	end
	if P.LeatherVest then
		-- Chaleco abierto: dos paneles delante y uno detrás
		for _, sx in { -1, 1 } do
			newPiece(folder, upper, "VestPanel", V(0.3 * sx, -0.05, -0.52), Z, V(0.36, 0.88, 0.06), Z, o.Plate, Enum.Material.Leather)
			newPiece(folder, upper, "VestSide", V(0.52 * sx, -0.05, 0), Z, V(0.05, 0.88, 1.02), Z, o.Plate, Enum.Material.Leather)
		end
		newPiece(folder, upper, "VestBack", V(0, -0.05, 0.52), Z, V(1.02, 0.88, 0.06), Z, o.Plate, Enum.Material.Leather)
	end
	if P.SheriffStar then
		for i = 0, 1 do
			newPiece(folder, upper, "SheriffStar", V(-0.3, 0.12, -0.57), Z, V(0.17, 0.17, 0.03), Z, o.Glow, Enum.Material.SmoothPlastic, CFrame.Angles(0, 0, math.rad(i * 36 + 9)))
		end
	end
	if P.Holster then
		local leg = get("RightUpperLeg")
		if leg then
			newPiece(folder, leg, "Holster", V(0.55, 0.1, 0), Z, V(0.25, 0.6, 0.55), Z, o.Body:Lerp(Color3.new(0, 0, 0), 0.25), Enum.Material.Leather)
			newPiece(folder, leg, "HolsterGrip", V(0.58, 0.45, 0.05), Z, V(0.18, 0.3, 0.3), Z, RGB(60, 40, 30), Enum.Material.Wood)
		end
	end
	if P.Scarf then
		local scarfColor = o.Cloth == o.Body and o.Glow or o.Cloth
		newPiece(folder, upper, "ScarfRing", V(0, 0.46, 0), Z, V(0.78, 0.2, 1.28), Z, scarfColor, Enum.Material.Fabric)
		newPiece(folder, upper, "ScarfTail", V(0.25, 0.25, 0.75), Z, V(0.18, 0.08, 1.1), Z, scarfColor, Enum.Material.Fabric, CFrame.Angles(math.rad(-25), math.rad(20), 0))
	end
	-- Uniforme realista (soldados de los mapas tipo shooter militar): sin tiras de neón ni suelas
	-- blancas; el color del equipo queda solo en el brazalete
	if o.Realistic then
		for _, piece in folder:GetChildren() do
			if piece:IsA("BasePart") then
				if string.find(piece.Name, "Glow", 1, true) or piece.Name == "Buckle" or piece.Name == "BackpackEmblem" then
					piece:Destroy()
				elseif piece.Name == "Sole" then
					piece.Color = RGB(38, 34, 30)
					piece.Material = Enum.Material.Rubber
				end
			end
		end
	end
	return true
end

return Outfits
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Ranks</string>
          <string name="Source"><![CDATA[-- Rangos competitivos: puntos de rango (RP) que suben al ganar partidas y bajan un poco al perder.
-- Nunca se baja de rango (al perder, como mínimo te quedas en el inicio del tuyo).
-- Se ven en el marcador, en el chat, en el menú y en el resumen de cada partida.
-- Llegar a un rango por primera vez da su premio (Reward: monedas y cajas gratis).
local Ranks = {}

local RGB = Color3.fromRGB

Ranks.Tiers = {
	{ Name = "Bronce", Min = 0, Icon = "🥉", Color = RGB(215, 140, 70) },
	{ Name = "Plata", Min = 100, Icon = "🥈", Color = RGB(205, 210, 225), Reward = { Coins = 200 } },
	{ Name = "Oro", Min = 250, Icon = "🥇", Color = RGB(255, 200, 60), Reward = { Coins = 300, Crates = 1 } },
	{ Name = "Platino", Min = 450, Icon = "💠", Color = RGB(90, 225, 210), Reward = { Coins = 500 } },
	{ Name = "Diamante", Min = 700, Icon = "💎", Color = RGB(110, 170, 255), Reward = { Coins = 750, Crates = 2 } },
	{ Name = "Campeón", Min = 1000, Icon = "👑", Color = RGB(255, 90, 200), Reward = { Coins = 1500, Crates = 3 } },
}

-- Puntos por partida
Ranks.Points = {
	Win = 25,
	Loss = -12, -- por equipos
	FFALoss = -5, -- todos contra todos (solo gana uno)
	MVP = 5, -- extra para el MVP, gane o pierda
	BotWin = 8, -- partida solo contra bots (menos de 2 jugadores de verdad): sube poco y no baja
}

-- Temporadas (fechas de fin en hora UTC): al acabar una, cada jugador recibe SeasonRewards según el
-- mejor rango que alcanzó en ella, y sus RP bajan a SeasonCarry (la mitad) para la siguiente. Los
-- premios de llegar a un rango por primera vez (Reward) son de una vez para siempre.
Ranks.Seasons = {
	{ Id = "T1", Name = "Temporada 1", EndsAt = 1798761600 }, -- 1 ene 2027
	{ Id = "T2", Name = "Temporada 2", EndsAt = 1806537600 }, -- 1 abr 2027
	{ Id = "T3", Name = "Temporada 3", EndsAt = 1814400000 }, -- 1 jul 2027
	{ Id = "T4", Name = "Temporada 4", EndsAt = 1822348800 }, -- 1 oct 2027
	{ Id = "T5", Name = "Temporada 5", EndsAt = 1830297600 }, -- 1 ene 2028
	{ Id = "T6", Name = "Temporada 6", EndsAt = 1838160000 }, -- 1 abr 2028
	{ Id = "T7", Name = "Temporada 7", EndsAt = 1846022400 }, -- 1 jul 2028
	{ Id = "T8", Name = "Temporada 8", EndsAt = 1853971200 }, -- 1 oct 2028
	-- (añade más antes de que acabe la última; después de ella ya no cambia de temporada)
}
Ranks.SeasonRewards = { 100, 250, 500, 800, 1200, 2000 } -- monedas por el mejor rango (Bronce..Campeón)
Ranks.SeasonCarry = 0.5

-- La temporada en curso (si ya pasaron todas, la última)
function Ranks.CurrentSeason(now)
	now = now or os.time()
	for _, season in ipairs(Ranks.Seasons) do
		if now < season.EndsAt then
			return season
		end
	end
	return Ranks.Seasons[#Ranks.Seasons]
end

function Ranks.SeasonName(id)
	for _, season in Ranks.Seasons do
		if season.Id == id then
			return season.Name
		end
	end
	return "Temporada"
end

-- Índice del rango (1 = Bronce)
function Ranks.Index(points)
	local index = 1
	for i, tier in Ranks.Tiers do
		if (points or 0) >= tier.Min then
			index = i
		end
	end
	return index
end

function Ranks.Get(points)
	return Ranks.Tiers[Ranks.Index(points)]
end

-- Progreso hacia el siguiente rango: fracción 0..1 y el siguiente rango (nil si ya es el máximo)
function Ranks.Progress(points)
	points = points or 0
	local index = Ranks.Index(points)
	local tier, nextTier = Ranks.Tiers[index], Ranks.Tiers[index + 1]
	if not nextTier then
		return 1, nil
	end
	return math.clamp((points - tier.Min) / (nextTier.Min - tier.Min), 0, 1), nextTier
end

-- Cambio de puntos de una partida. result: "Win", "Loss" o "Draw"
function Ranks.Delta(result, ffa, botsOnly, mvp)
	local points = Ranks.Points
	if botsOnly then
		return result == "Win" and points.BotWin or 0
	end
	local delta = 0
	if result == "Win" then
		delta = points.Win
	elseif result == "Loss" then
		delta = ffa and points.FFALoss or points.Loss
	end
	if mvp then
		delta += points.MVP
	end
	return delta
end

-- Aplica el cambio sin bajar nunca del inicio del rango actual
function Ranks.Apply(points, delta)
	points = points or 0
	local floor = Ranks.Get(points).Min
	return math.max(floor, points + delta)
end

return Ranks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Crea (servidor) o espera (cliente) todos los RemoteEvents/RemoteFunctions del juego.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EVENTS = {
	"Fire", -- cliente -> servidor: disparo
	"Reload", -- cliente -> servidor: recargar
	"Melee", -- cliente -> servidor: cuchillazo
	"EquipSkin", -- cliente -> servidor: equipar skin
	"SetPrimary", -- cliente -> servidor: elegir arma principal
	"LeaveMenu", -- cliente -> servidor: ha salido de la pantalla de inicio
	"EnterMenu", -- cliente -> servidor: vuelve a la pantalla de inicio (escudo y fuera de juego)
	"RespawnNow", -- cliente -> servidor: "Regenerar ahora" tras morir
	"SetSecondary", -- cliente -> servidor: elegir arma secundaria
	"SetMelee", -- cliente -> servidor: elegir arma cuerpo a cuerpo (cuchillo, martillo, katana)
	"TutorialDone", -- cliente -> servidor: ya ha visto la tarjeta de controles
	"NewsSeen", -- cliente -> servidor: ya ha visto las novedades (GameConfig.News)
	"EquipOutfit", -- cliente -> servidor: equipar traje de operador
	"VoteMap", -- cliente -> servidor: voto de mapa/modo
	"SetCamo", -- cliente -> servidor: camuflaje de maestría para un arma
	"EquipKillEffect", -- cliente -> servidor: equipar efecto de eliminación
	"EquipCharm", -- cliente -> servidor: equipar colgante de arma (Charms)
	"EquipSpray", -- cliente -> servidor: equipar grafiti (Sprays)
	"EquipTitle", -- cliente -> servidor: elegir título (Titles)
	"Spray", -- cliente -> servidor: pintar el grafiti en un punto (el servidor lo comprueba)
	"SaveSettings", -- cliente -> servidor: ajustes (calidad gráfica, FOV, sensibilidad)
	"KillFX", -- servidor -> clientes: efecto de eliminación (posición, efecto, color)
	"ThrowGrenade", -- cliente -> servidor: lanzar granada (dirección)
	"ExplosionFX", -- servidor -> clientes: explosión de granada (posición, radio)
	"CallAirstrike", -- cliente -> servidor: pedir el ataque aéreo (punto objetivo)
	"AirstrikeMark", -- servidor -> clientes: marcas rojas donde va a caer el ataque aéreo
	"ShotFX", -- servidor -> clientes: efectos de disparo de otros jugadores
	"HitConfirm", -- servidor -> cliente: confirmación de impacto (hitmarker)
	"KillFeed", -- servidor -> clientes: registro de bajas
	"Notify", -- servidor -> cliente(s): mensajes en pantalla
	"DataUpdate", -- servidor -> cliente: datos de progreso
	"Died", -- servidor -> cliente: quién te eliminó
	"RoundEnd", -- servidor -> clientes: resultado de la ronda
	"MatchSummary", -- servidor -> cliente: resumen de tu partida (XP, monedas, bajas, mejor racha)
}
local FUNCTIONS = {
	"GetData",
	"BuyItem", -- comprar arma/skin/traje con monedas
	"ClaimDaily", -- recoger la recompensa diaria
	"OpenCrate", -- abrir una caja
	"RerollChallenge", -- cambiar un reto diario
	"InstantRevive", -- revivir donde moriste (gasta un revivir)
	"UsePotion", -- habilidad Poción: cura con el tiempo (el servidor controla la recarga)
	"ClaimGift", -- recoger el siguiente regalo por tiempo jugado
	"SpinWheel", -- girar la ruleta diaria (gratis o gastando un giro comprado)
	"ClaimAchievement", -- reclamar el premio de un logro (GameConfig.Achievements)
	"ClaimGroup", -- reclamar el premio por unirse al grupo (GameConfig.Group)
}

local Remotes = {}

if RunService:IsServer() then
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in EVENTS do
		local remote = folder:FindFirstChild(name) or Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		Remotes[name] = remote
	end
	for _, name in FUNCTIONS do
		local remote = folder:FindFirstChild(name) or Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
		Remotes[name] = remote
	end
else
	local folder = ReplicatedStorage:WaitForChild("Remotes")
	for _, name in EVENTS do
		Remotes[name] = folder:WaitForChild(name)
	end
	for _, name in FUNCTIONS do
		Remotes[name] = folder:WaitForChild(name)
	end
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Shop</string>
          <string name="Source"><![CDATA[-- Catálogo de la tienda: precios en monedas, packs de Robux, VIP, recompensas diarias y cajas.
--
-- IMPORTANTE (Robux): crea los productos en el Creator Hub (Monetización) y pega sus IDs aquí.
--   Developer Products -> CoinPacks[i].ProductId, RevivePacks[i].ProductId y Boosters[i].ProductId
--   Game Pass VIP      -> VIPPassId
-- Con ID 0 el botón aparece desactivado ("Próximamente").
local Shop = {}

-- Packs de monedas (Developer Products, se pueden comprar varias veces)
Shop.CoinPacks = {
	{ Name = "Puñado", Coins = 500, Robux = 49, ProductId = 0 },
	{ Name = "Bolsa", Coins = 1200, Robux = 99, ProductId = 0, Tag = "+20%" },
	{ Name = "Cofre", Coins = 3000, Robux = 199, ProductId = 0, Tag = "MÁS VENDIDO" },
	{ Name = "Bóveda", Coins = 8000, Robux = 449, ProductId = 0, Tag = "MEJOR VALOR" },
}

-- Packs de "Revivir instantáneo" (Developer Products): vuelves a la acción justo donde caíste
Shop.RevivePacks = {
	{ Name = "5 revivir", Revives = 5, Robux = 25, ProductId = 0 },
	{ Name = "15 revivir", Revives = 15, Robux = 59, ProductId = 0, Tag = "MEJOR VALOR" },
}

-- Pack de inicio (Developer Product de compra única): solo se ofrece a jugadores nuevos.
-- Vale mucho más que su precio en Robux para que sea la primera compra fácil.
Shop.StarterPack = {
	ProductId = 0, -- pega aquí el ID del Developer Product
	Robux = 99,
	MaxLevel = 15, -- se deja de ofrecer a partir de este nivel
	Coins = 1500,
	Outfit = "BlazeRunner",
	Skin = "Sakura",
	KillEffect = "Confeti",
}

-- Packs de temporada (Developer Product de compra única cada uno): cosas de la tienda por mucho
-- menos que su precio, solo entre StartsAt y EndsAt (hora UTC). Value = lo que vale todo en monedas.
local RGB = Color3.fromRGB
Shop.Bundles = {
	{
		Id = "Halloween",
		Name = "PACK DE HALLOWEEN",
		Icon = "🎃",
		ProductId = 0, -- pega aquí el ID del Developer Product
		Robux = 199,
		EndsAt = 1793750400, -- 4 nov 2026
		Coins = 2500,
		KillEffect = "Calabazas",
		Charm = "Calabaza",
		Spray = "Calabaza",
		Value = 5000,
		Colors = { RGB(255, 120, 20), RGB(90, 30, 140) },
	},
	{
		Id = "Navidad",
		Name = "PACK DE NAVIDAD",
		Icon = "🎄",
		ProductId = 0, -- pega aquí el ID del Developer Product
		Robux = 199,
		StartsAt = 1796083200, -- 1 dic 2026
		EndsAt = 1799366400, -- 8 ene 2027
		Coins = 2500,
		KillEffect = "Nieve",
		Charm = "Baston",
		Spray = "Navidad",
		Value = 5000,
		Colors = { RGB(210, 30, 40), RGB(30, 120, 60) },
	},
	-- Pack permanente (sin fechas): los tres trajes de aventura y sus extras
	{
		Id = "Aventurero",
		Name = "PACK AVENTURERO",
		Icon = "🏴‍☠️",
		ProductId = 0, -- pega aquí el ID del Developer Product
		Robux = 299,
		Coins = 1500,
		Outfits = { "Vaquero", "Pirata", "Caballero" },
		KillEffect = "Rodadora",
		Charm = "Calavera",
		Spray = "Pirata",
		Value = 10500,
		Colors = { RGB(170, 100, 50), RGB(25, 60, 110) },
	},
}
Shop.HalloweenBundle = Shop.Bundles[1] -- (nombre antiguo)

-- ¿Se puede comprar este pack ahora?
function Shop.BundleOnSale(bundle, now)
	now = now or os.time()
	return bundle.ProductId ~= 0 and (bundle.StartsAt == nil or now >= bundle.StartsAt) and (bundle.EndsAt == nil or now < bundle.EndsAt)
end


-- Ruleta diaria: un giro gratis al día y giros extra con Robux (Developer Product SpinProductId,
-- da SpinsPerPurchase giros). Los premios salen según su peso (Weight); las probabilidades se ven en
-- la propia ruleta. En los países donde los premios al azar de pago no están permitidos solo hay
-- giro gratis.
Shop.Wheel = {
	SpinProductId = 0, -- pega aquí el ID del Developer Product
	SpinRobux = 25,
	SpinsPerPurchase = 3,
	Prizes = {
		{ Kind = "Coins", Amount = 50, Weight = 28, Color = Color3.fromRGB(90, 160, 255) },
		{ Kind = "Coins", Amount = 100, Weight = 24, Color = Color3.fromRGB(255, 200, 60) },
		{ Kind = "Revives", Amount = 1, Weight = 12, Color = Color3.fromRGB(80, 210, 120) },
		{ Kind = "Coins", Amount = 250, Weight = 12, Color = Color3.fromRGB(255, 120, 60) },
		{ Kind = "Boost", Field = "BoostXP", Amount = 15, Weight = 10, Color = Color3.fromRGB(120, 220, 255) }, -- 15 min de XP doble
		{ Kind = "Crate", Amount = 1, Weight = 8, Color = Color3.fromRGB(180, 100, 255) },
		{ Kind = "Coins", Amount = 600, Weight = 5, Color = Color3.fromRGB(255, 80, 140) },
		{ Kind = "Coins", Amount = 2000, Weight = 1, Color = Color3.fromRGB(255, 230, 90), Jackpot = true },
	},
}

-- Texto corto de un premio de la ruleta
function Shop.WheelPrizeText(prize)
	if prize.Kind == "Coins" then
		return prize.Amount .. " 🪙"
	elseif prize.Kind == "Revives" then
		return prize.Amount .. " ❤️"
	elseif prize.Kind == "XP" then
		return prize.Amount .. " XP"
	elseif prize.Kind == "Crate" then
		return prize.Amount .. " 📦"
	elseif prize.Kind == "Boost" then
		return "⚡x2 " .. prize.Amount .. "m"
	end
	return "?"
end

-- Potenciadores (Developer Products, se pueden comprar varias veces y se acumulan): multiplican la
-- XP o las monedas ganadas jugando. Su tiempo solo corre mientras juegas (no en la portada ni
-- desconectado). Field = campo del guardado con los segundos que quedan.
Shop.Boosters = {
	{ Id = "XP2", Name = "XP doble", Icon = "⚡", Kind = "XP", Multiplier = 2, Minutes = 30, Robux = 49, ProductId = 0, Field = "BoostXP" },
	{ Id = "Coins2", Name = "Monedas dobles", Icon = "🪙", Kind = "Coins", Multiplier = 2, Minutes = 30, Robux = 69, ProductId = 0, Field = "BoostCoins" },
}

-- Pase VIP (Game Pass): x2 XP y x2 monedas, nombre dorado y caja diaria extra
Shop.VIPPassId = 0
Shop.VIPRobux = 299
Shop.VIPMultiplier = 2

-- Precio en monedas de cada skin de arma
Shop.SkinPrices = {
	Toxico = 400,
	Selva = 300,
	Oceano = 600,
	Atardecer = 600,
	Sakura = 800,
	Hielo = 800,
	Calabaza = 1200,
	Vacio = 1500,
	Dorado = 2000,
	Galaxia = 2500,
	Dragon = 3000,
	Magma = 3000,
	CamoBosque = 700,
	CamoDesierto = 700,
	CamoDigital = 1200,
	CamoArtico = 1200,
	CamoTigre = 2200,
	CamoNebulosa = 3200,
	Prisma = 2800,
	Caramelo = 450,
	Juguete = 450,
	Tiki = 900,
	Pintura = 2200,
	Arcoiris = 4500,
	Vaquera = 1000,
	Tesoro = 2400,
}

-- Lo recién añadido: lleva la etiqueta "¡NUEVO!" en la tienda mientras no lo tengas. Cámbialo en cada
-- actualización ([tipo][id] = true; tipos: Skin, Outfit, KillEffect, Charm, Spray, Title).
Shop.NewItems = {
	Outfit = { Vaquero = true, Pirata = true, Caballero = true },
	Skin = { Vaquera = true, Tesoro = true },
	KillEffect = { Rodadora = true, Fuegos = true },
	Spray = { Vaquero = true, Cactus = true, Pirata = true, Espada = true },
	Title = { Forajido = true, Sheriff = true },
}

function Shop.IsNew(kind, id)
	return Shop.NewItems[kind] ~= nil and Shop.NewItems[kind][id] == true
end

-- Precio en monedas de cada traje de operador (ver Outfits)
Shop.OutfitPrices = {
	BlazeRunner = 1500,
	NeonRecon = 1500,
	VoltBruiser = 2000,
	FrostByte = 1200,
	ToxicRogue = 1200,
	GoldenAce = 4000,
	Vampiro = 2500,
	Momia = 1800,
	Vaquero = 2200,
	Pirata = 2400,
	Caballero = 2600,
}

-- Recompensa diaria: un día por entrada (al 7.º día se vuelve a empezar)
Shop.DailyRewards = { 100, 150, 200, 250, 300, 400, 800 }
Shop.DailyCrateDay = 7 -- ese día también regala una caja

-- Cajas (solo con monedas). Las probabilidades se muestran en la tienda.
-- Si te toca algo repetido te devolvemos parte de las monedas.
Shop.Crates = {
	Neon = {
		Name = "Caja Neón",
		Price = 600,
		Odds = {
			{ Rarity = "Raro", Weight = 55 },
			{ Rarity = "Épico", Weight = 30 },
			{ Rarity = "Legendario", Weight = 12 },
			{ Rarity = "Mítico", Weight = 3 },
		},
		DuplicateRefund = 0.4,
	},
}

-- Ofertas del día: 3 objetos con descuento, iguales para todos y distintos cada día
Shop.OfferDiscount = 0.3

local function dayNumber(time)
	return math.floor((time or os.time()) / 86400)
end
Shop.DayNumber = dayNumber

local KillEffects = require(script.Parent.KillEffects)
local Charms = require(script.Parent.Charms)
local Sprays = require(script.Parent.Sprays)
local Titles = require(script.Parent.Titles)

function Shop.GetDailyOffers(day)
	day = day or dayNumber()
	local pool = {}
	for id in Shop.SkinPrices do
		table.insert(pool, { Kind = "Skin", Id = id })
	end
	for id in Shop.OutfitPrices do
		table.insert(pool, { Kind = "Outfit", Id = id })
	end
	for id, effect in KillEffects.List do
		if effect.Price then
			table.insert(pool, { Kind = "KillEffect", Id = id })
		end
	end
	table.sort(pool, function(a, b)
		return a.Kind .. a.Id < b.Kind .. b.Id
	end)
	local rng = Random.new(day * 7919)
	local offers = {}
	for _ = 1, math.min(3, #pool) do
		local item = table.remove(pool, rng:NextInteger(1, #pool))
		table.insert(offers, item)
	end
	return offers
end

-- Precio actual (con descuento si está en oferta hoy)
function Shop.GetPrice(kind, id, day)
	local base
	if kind == "Skin" then
		base = Shop.SkinPrices[id]
	elseif kind == "Outfit" then
		base = Shop.OutfitPrices[id]
	elseif kind == "KillEffect" then
		local effect = KillEffects.List[id]
		base = effect and effect.Price
	elseif kind == "Charm" then
		local charm = Charms.List[id]
		base = charm and charm.Price
	elseif kind == "Spray" then
		local spray = Sprays.List[id]
		base = spray and spray.Price
	elseif kind == "Title" then
		local title = Titles.List[id]
		base = title and title.Price
	end
	if not base then
		return nil, false
	end
	for _, offer in Shop.GetDailyOffers(day) do
		if offer.Kind == kind and offer.Id == id then
			return math.floor(base * (1 - Shop.OfferDiscount) / 10 + 0.5) * 10, true
		end
	end
	return base, false
end

return Shop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Skins</string>
          <string name="Source"><![CDATA[-- Skins de armas. Cada skin pinta las piezas del arma según su "Role":
--   Body   = cuerpo principal
--   Accent = detalles brillantes (neón)
--   Dark   = cañón, cargador, mira
--   Accent2 = detalles secundarios (paneles, rayas)
-- Opcional:
--   Effect = "Sparkle" (destellos) o "Flame" (llamas) alrededor del arma
--   Pulse  = true: los detalles de neón laten entre Accent y Accent2
--   Rainbow = { Accent = true, Body = true, ... }: esas piezas cambian de color sin parar (arcoíris);
--             RainbowSat / RainbowVal = saturación y brillo de los colores (0-1)
local Skins = {}

Skins.List = {
	Default = {
		Name = "Estándar",
		Rarity = "Común",
		Body = Color3.fromRGB(70, 74, 82),
		BodyMaterial = Enum.Material.Metal,
		Accent = Color3.fromRGB(0, 200, 255),
		AccentMaterial = Enum.Material.Neon,
		Dark = Color3.fromRGB(30, 30, 34),
		Accent2 = Color3.fromRGB(110, 115, 125),
	},
	Toxico = {
		Name = "Tóxico",
		Rarity = "Raro",
		Body = Color3.fromRGB(40, 48, 40),
		BodyMaterial = Enum.Material.SmoothPlastic,
		Accent = Color3.fromRGB(110, 255, 60),
		AccentMaterial = Enum.Material.Neon,
		Dark = Color3.fromRGB(20, 26, 20),
		Accent2 = Color3.fromRGB(255, 230, 0),
	},
	Selva = {
		Name = "Selva",
		Rarity = "Raro",
		Body = Color3.fromRGB(86, 110, 60),
		BodyMaterial = Enum.Material.Fabric,
		Accent = Color3.fromRGB(196, 160, 90),
		AccentMaterial = Enum.Material.SmoothPlastic,
		Dark = Color3.fromRGB(50, 40, 30),
		Accent2 = Color3.fromRGB(60, 80, 40),
	},
	Oceano = {
		Name = "Océano",
		Rarity = "Épico",
		Body = Color3.fromRGB(20, 60, 120),
		BodyMaterial = Enum.Material.Glass,
		Accent = Color3.fromRGB(80, 220, 255),
		AccentMaterial = Enum.Material.Neon,
		Dark = Color3.fromRGB(10, 25, 50),
		Accent2 = Color3.fromRGB(255, 255, 255),
	},
	Atardecer = {
		Name = "Atardecer",
		Rarity = "Épico",
		Body = Color3.fromRGB(255, 140, 80),
		BodyMaterial = Enum.Material.SmoothPlastic,
		Accent = Color3.fromRGB(255, 60, 140),
		AccentMaterial = Enum.Material.Neon,
		Dark = Color3.fromRGB(70, 20, 60),
		Accent2 = Color3.fromRGB(255, 200, 60),
	},
	Sakura = {
		Name = "Sakura",
		Rarity = "Épico",
		Body = Color3.fromRGB(255, 170, 215),
		BodyMaterial = Enum.Material.SmoothPlastic,
		Accent = Color3.fromRGB(255, 80, 200),
		AccentMaterial = Enum.Material.Neon,
		Dark = Color3.fromRGB(120, 40, 110),
