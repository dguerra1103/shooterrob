  <Item class="ServerScriptService" referent="9">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="10">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="11">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Punto de entrada del servidor: inicia todos los sistemas en orden.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

require(ReplicatedStorage.Shared.Remotes) -- crea los RemoteEvents antes que nada

local Modules = script.Parent.Modules
local MapBuilder = require(Modules.MapBuilder)
local PlayerData = require(Modules.PlayerData)
local Loadout = require(Modules.Loadout)
local Combat = require(Modules.Combat)
local Round = require(Modules.Round)
local Dummies = require(Modules.Dummies)

MapBuilder.Build()
PlayerData.Init()
Loadout.Init()
Combat.Init()
Combat.OnKill = Round.RegisterKill
Round.Init()
Dummies.Init()
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="12">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Combat</string>
            <string name="Source"><![CDATA[-- Validación de disparos y daño en el servidor (anti-trampas básico).
-- El cliente calcula el impacto; el servidor comprueba cadencia, munición, distancia y línea de visión.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Weapons = require(Shared.Weapons)
local Remotes = require(Shared.Remotes)

local Combat = {}

-- Asignado desde Main: function(killer: Player?, victim: Player?, victimName, weaponName, headshot)
Combat.OnKill = nil

local lastShot = setmetatable({}, { __mode = "k" })
local reloadTokens = setmetatable({}, { __mode = "k" })
local lastMelee = {}

local function getCharacterFromPart(part)
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid then
			return model, humanoid
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil, nil
end

local function isEnemy(attacker, targetPlayer)
	if not targetPlayer then
		return true -- muñecos de práctica / NPCs
	end
	if attacker == targetPlayer then
		return false
	end
	if attacker.Neutral or targetPlayer.Neutral or not attacker.Team then
		return true
	end
	return attacker.Team ~= targetPlayer.Team
end

local function isHeadshot(part, character, position)
	if part.Name == "Head" then
		return true
	end
	if part.Parent and part.Parent:IsA("Accessory") then
		local head = character:FindFirstChild("Head")
		return head ~= nil and (head.Position - position).Magnitude < 1.6
	end
	return false
end

local function hasLineOfSight(origin, target, ignore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	local offset = target - origin
	local distance = offset.Magnitude - 1.5
	if distance <= 0 then
		return true
	end
	return workspace:Raycast(origin, offset.Unit * distance, params) == nil
end

local function damageAtDistance(def, distance)
	if distance <= def.FalloffStart then
		return def.Damage
	end
	if distance >= def.FalloffEnd then
		return def.MinDamage
	end
	local alpha = (distance - def.FalloffStart) / (def.FalloffEnd - def.FalloffStart)
	return def.Damage + (def.MinDamage - def.Damage) * alpha
end

local function removeSpawnShield(character)
	local shield = character:FindFirstChildOfClass("ForceField")
	if shield then
		shield:Destroy()
	end
end

-- Aplica daño y deja la "etiqueta" del atacante. Devuelve daño real y si murió.
local function applyDamage(attacker, humanoid, damage, weaponName, headshot)
	if humanoid.Health <= 0 then
		return 0, false
	end
	humanoid:SetAttribute("LastAttacker", attacker.UserId)
	humanoid:SetAttribute("LastWeapon", weaponName)
	humanoid:SetAttribute("LastHeadshot", headshot)
	humanoid:SetAttribute("LastHitTime", os.clock())
	local before = humanoid.Health
	humanoid:TakeDamage(damage) -- respeta el ForceField de spawn
	local dealt = before - humanoid.Health
	return dealt, humanoid.Health <= 0
end

-- Detecta la muerte de un Humanoid y avisa a quien corresponda
function Combat.WatchHumanoid(humanoid, victimPlayer, victimName)
	humanoid.Died:Connect(function()
		local killer
		local attackerId = humanoid:GetAttribute("LastAttacker")
		local hitTime = humanoid:GetAttribute("LastHitTime")
		if attackerId and hitTime and os.clock() - hitTime < 10 then
			killer = Players:GetPlayerByUserId(attackerId)
		end
		local weaponName = humanoid:GetAttribute("LastWeapon")
		local headshot = humanoid:GetAttribute("LastHeadshot") == true
		if victimPlayer then
			Remotes.Died:FireClient(victimPlayer, killer and killer.Name, weaponName)
		end
		if Combat.OnKill then
			Combat.OnKill(killer, victimPlayer, victimName, weaponName, headshot)
		end
	end)
end

local function onFire(player, tool, origin, rays)
	if typeof(tool) ~= "Instance" or not tool:IsA("Tool") or typeof(origin) ~= "Vector3" or type(rays) ~= "table" then
		return
	end
	local character = player.Character
	if not character or tool.Parent ~= character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local head = character:FindFirstChild("Head")
	if not humanoid or humanoid.Health <= 0 or not head then
		return
	end
	local weaponName = tool:GetAttribute("Weapon")
	local def = Weapons.Get(weaponName)
	if not def or def.Type ~= "Gun" or tool:GetAttribute("Reloading") then
		return
	end
	local ammo = tool:GetAttribute("Ammo") or 0
	if ammo <= 0 then
		return
	end
	local now = os.clock()
	if now - (lastShot[tool] or 0) < (1 / def.FireRate) * 0.75 then
		return
	end
	if (head.Position - origin).Magnitude > 12 then
		return
	end
	lastShot[tool] = now
	tool:SetAttribute("Ammo", ammo - 1)
	removeSpawnShield(character)

	local endpoints = {}
	local perTarget = {}
	for i = 1, math.min(#rays, def.Pellets) do
		local ray = rays[i]
		if type(ray) == "table" and typeof(ray.Position) == "Vector3" then
			local position = ray.Position
			local distance = (position - origin).Magnitude
			if distance <= def.Range + 5 then
				table.insert(endpoints, position)
				local part = ray.Part
				if typeof(part) == "Instance" and part:IsA("BasePart") and part:IsDescendantOf(workspace) then
					local targetChar, targetHum = getCharacterFromPart(part)
					if targetChar and targetChar ~= character and targetHum.Health > 0 then
						local targetPlayer = Players:GetPlayerFromCharacter(targetChar)
						local closeEnough = (part.Position - position).Magnitude <= part.Size.Magnitude / 2 + 8
						if
							isEnemy(player, targetPlayer)
							and closeEnough
							and hasLineOfSight(origin, position, { character, targetChar })
						then
							local headshot = isHeadshot(part, targetChar, position)
							local damage = damageAtDistance(def, distance)
								* (headshot and def.HeadshotMultiplier or 1)
							local entry = perTarget[targetHum]
							if not entry then
								entry = { Damage = 0, Headshot = false }
								perTarget[targetHum] = entry
							end
							entry.Damage += damage
							entry.Headshot = entry.Headshot or headshot
						end
					end
				end
			end
		end
	end

	local totalDealt, anyHeadshot, anyKill = 0, false, false
	for targetHum, entry in perTarget do
		local dealt, killed = applyDamage(player, targetHum, entry.Damage, weaponName, entry.Headshot)
		if dealt > 0 then
			totalDealt += dealt
			anyHeadshot = anyHeadshot or entry.Headshot
			anyKill = anyKill or killed
		end
	end
	if totalDealt > 0 then
		Remotes.HitConfirm:FireClient(player, math.floor(totalDealt + 0.5), anyHeadshot, anyKill)
	end

	for _, other in Players:GetPlayers() do
		if other ~= player then
			Remotes.ShotFX:FireClient(other, tool, endpoints)
		end
	end
end

local function onReload(player, tool)
	if typeof(tool) ~= "Instance" or not tool:IsA("Tool") then
		return
	end
	local character = player.Character
	if not character or tool.Parent ~= character then
		return
	end
	local def = Weapons.Get(tool:GetAttribute("Weapon"))
	if not def or def.Type ~= "Gun" or tool:GetAttribute("Reloading") then
		return
	end
	local ammo = tool:GetAttribute("Ammo") or 0
	local reserve = tool:GetAttribute("Reserve") or 0
	if ammo >= def.MagSize or reserve <= 0 then
		return
	end
	tool:SetAttribute("Reloading", true)
	local token = {}
	reloadTokens[tool] = token
	task.delay(def.ReloadTime, function()
		if reloadTokens[tool] ~= token then
			return
		end
		reloadTokens[tool] = nil
		-- Si cambió de arma la recarga ya se canceló (Reloading = false)
		if not tool:GetAttribute("Reloading") or tool.Parent ~= player.Character then
			tool:SetAttribute("Reloading", false)
			return
		end
		local currentAmmo = tool:GetAttribute("Ammo") or 0
		local currentReserve = tool:GetAttribute("Reserve") or 0
		local take = math.min(def.MagSize - currentAmmo, currentReserve)
		tool:SetAttribute("Ammo", currentAmmo + take)
		tool:SetAttribute("Reserve", currentReserve - take)
		tool:SetAttribute("Reloading", false)
	end)
end

local function findKnife(player)
	for _, container in { player.Character, player:FindFirstChild("Backpack") } do
		if container then
			for _, tool in container:GetChildren() do
				if tool:IsA("Tool") and tool:GetAttribute("Weapon") == Weapons.Melee then
					return tool
				end
			end
		end
	end
	return nil
end

local function onMelee(player, part)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not findKnife(player) then
		return
	end
	local def = Weapons.Get(Weapons.Melee)
	local now = os.clock()
	if now - (lastMelee[player] or 0) < def.Cooldown * 0.8 then
		return
	end
	lastMelee[player] = now
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") or not part:IsDescendantOf(workspace) then
		return
	end
	local targetChar, targetHum = getCharacterFromPart(part)
	if not targetChar or targetChar == character or targetHum.Health <= 0 then
		return
	end
	local targetRoot = targetChar:FindFirstChild("HumanoidRootPart") or part
	if (targetRoot.Position - root.Position).Magnitude > def.Range + 4 then
		return
	end
	if not isEnemy(player, Players:GetPlayerFromCharacter(targetChar)) then
		return
	end
	removeSpawnShield(character)
	local dealt, killed = applyDamage(player, targetHum, def.Damage, Weapons.Melee, false)
	if dealt > 0 then
		Remotes.HitConfirm:FireClient(player, math.floor(dealt + 0.5), false, killed)
	end
end

function Combat.Init()
	Remotes.Fire.OnServerEvent:Connect(onFire)
	Remotes.Reload.OnServerEvent:Connect(onReload)
	Remotes.Melee.OnServerEvent:Connect(onMelee)

	local function onPlayer(player)
		player.CharacterAdded:Connect(function(character)
			local humanoid = character:WaitForChild("Humanoid")
			Combat.WatchHumanoid(humanoid, player, player.Name)
		end)
		if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
			Combat.WatchHumanoid(player.Character:FindFirstChildOfClass("Humanoid"), player, player.Name)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastMelee[player] = nil
	end)
end

return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Dummies</string>
            <string name="Source"><![CDATA[-- Muñecos de práctica para probar las armas en Studio (desactívalos en GameConfig.TrainingDummies).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Combat = require(script.Parent.Combat)

local Dummies = {}

local SPOTS = {
	Vector3.new(-20, 4, -60),
	Vector3.new(20, 4, 60),
	Vector3.new(-50, 4, 30),
	Vector3.new(50, 4, -30),
	Vector3.new(0, 11, 0),
}

local folder

local function spawnDummy(position)
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = Color3.fromRGB(255, 200, 80)
	description.TorsoColor = Color3.fromRGB(80, 80, 90)
	description.LeftArmColor = Color3.fromRGB(255, 200, 80)
	description.RightArmColor = Color3.fromRGB(255, 200, 80)
	description.LeftLegColor = Color3.fromRGB(60, 60, 70)
	description.RightLegColor = Color3.fromRGB(60, 60, 70)

	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescriptionAsync(description, Enum.HumanoidRigType.R15)
	end)
	if not ok then
		ok, model = pcall(function()
			return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
		end)
	end
	if not ok then
		warn("[Dummies] No se pudo crear el muñeco:", model)
		return
	end
	model.Name = "Muñeco"
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayName = "Muñeco"
	humanoid.MaxHealth = 100
	humanoid.Health = 100
	model:PivotTo(CFrame.new(position) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	model.Parent = folder

	Combat.WatchHumanoid(humanoid, nil, "Muñeco")
	humanoid.Died:Connect(function()
		task.wait(4)
		model:Destroy()
		spawnDummy(position)
	end)
end

function Dummies.Init()
	if not GameConfig.TrainingDummies then
		return
	end
	folder = Instance.new("Folder")
	folder.Name = "Dummies"
	folder.Parent = workspace
	for _, position in SPOTS do
		spawnDummy(position)
	end
end

return Dummies
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Loadout</string>
            <string name="Source"><![CDATA[-- Entrega las armas (Tools) a cada jugador cuando aparece.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Weapons = require(Shared.Weapons)
local WeaponModels = require(Shared.WeaponModels)

local PlayerData = require(script.Parent.PlayerData)

local Loadout = {}

function Loadout.MakeTool(weaponName, skinId)
	local def = Weapons.Get(weaponName)
	local tool = Instance.new("Tool")
	tool.Name = def.DisplayName
	tool.ToolTip = def.DisplayName
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	-- La mano derecha agarra la empuñadura del arma
	tool.Grip = CFrame.new(def.RightHand or Vector3.zero)
	tool:SetAttribute("Weapon", weaponName)
	tool:SetAttribute("Skin", skinId)
	tool:SetAttribute("Slot", def.Slot)
	if def.Type == "Gun" then
		tool:SetAttribute("Ammo", def.MagSize)
		tool:SetAttribute("Reserve", def.ReserveAmmo)
		tool:SetAttribute("Reloading", false)
		tool.Unequipped:Connect(function()
			tool:SetAttribute("Reloading", false) -- cambiar de arma cancela la recarga
		end)
	end

	local model = WeaponModels.Build(weaponName, skinId)
	for _, child in model:GetChildren() do
		child.Parent = tool
	end
	model:Destroy()
	return tool
end

local function giveLoadout(player, character)
	local data = PlayerData.WaitFor(player, 15)
	if player.Character ~= character then
		return
	end
	local skin = data and data.EquippedSkin or "Default"
	local primary = data and data.Primary or "Rifle"

	local backpack = player:WaitForChild("Backpack")
	backpack:ClearAllChildren()

	local first
	for _, weaponName in { primary, Weapons.Secondary, Weapons.Melee } do
		local tool = Loadout.MakeTool(weaponName, skin)
		tool.Parent = backpack
		first = first or tool
	end

	local humanoid = character:WaitForChild("Humanoid")
	if humanoid.Health > 0 then
		humanoid:EquipTool(first)
	end
end

local function onSkinChanged(player, skinId)
	local containers = { player:FindFirstChild("Backpack"), player.Character }
	for _, container in containers do
		if container then
			for _, tool in container:GetChildren() do
				if tool:IsA("Tool") and tool:GetAttribute("Weapon") then
					WeaponModels.ApplySkin(tool, skinId)
					tool:SetAttribute("Skin", skinId)
				end
			end
		end
	end
end

local function onPlayer(player)
	player.CharacterAdded:Connect(function(character)
		giveLoadout(player, character)
	end)
	if player.Character then
		task.spawn(giveLoadout, player, player.Character)
	end
end

function Loadout.Init()
	PlayerData.OnSkinChanged = onSkinChanged
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
end

return Loadout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[-- Genera un mapa urbano simétrico (estilo arena) con contenedores, edificios y rampas.
-- Si ya existe workspace.Map (por ejemplo uno que construyas tú en Studio) no genera nada.
-- Tu mapa propio debe tener SpawnLocations con TeamColor = Really red / Really blue.
local Lighting = game:GetService("Lighting")

local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)

local MapBuilder = {}

local LENGTH = 320 -- eje X (de spawn a spawn)
local WIDTH = 220 -- eje Z
local WALL_HEIGHT = 34

local mapFolder

local function block(name, size, cf, color, material, parent)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent or mapFolder
	return part
end

-- Rampa inclinada desde "bottom" hasta "top" (posiciones de la superficie)
local function ramp(bottom, top, width, color)
	local mid = (bottom + top) / 2
	local length = (top - bottom).Magnitude
	local cf = CFrame.lookAt(mid, top) * CFrame.new(0, -0.5, 0)
	return block("Ramp", Vector3.new(width, 1, length + 1), cf, color, Enum.Material.DiamondPlate)
end

-- Rotación de 180° alrededor del centro: la mitad del equipo Azul es espejo de la del Rojo
local MIRROR = CFrame.Angles(0, math.pi, 0)

local function symmetric(fn)
	fn(CFrame.new(), "A")
	fn(MIRROR, "B")
end

local function container(cf, color)
	local model = Instance.new("Model")
	model.Name = "Container"
	model.Parent = mapFolder
	local size = Vector3.new(20, 8.5, 8)
	block("Body", size, cf * CFrame.new(0, size.Y / 2, 0), color, Enum.Material.CorrodedMetal, model)
	local dark = color:Lerp(Color3.new(0, 0, 0), 0.35)
	for i = -4, 4 do
		block("Rib", Vector3.new(0.4, 8.2, 8.3), cf * CFrame.new(i * 2.2, 4.25, 0), dark, Enum.Material.Metal, model)
	end
	block("Roof", Vector3.new(20.2, 0.3, 8.2), cf * CFrame.new(0, 8.6, 0), dark, Enum.Material.Metal, model)
	return model
end

local function crate(cf, size)
	size = size or 4
	return block(
		"Crate",
		Vector3.new(size, size, size),
		cf * CFrame.new(0, size / 2, 0),
		Color3.fromRGB(176, 124, 70),
		Enum.Material.WoodPlanks
	)
end

local function building(cf, size, color)
	local model = Instance.new("Model")
	model.Name = "Building"
	model.Parent = mapFolder
	block("Block", size, cf * CFrame.new(0, size.Y / 2, 0), color, Enum.Material.Concrete, model)
	-- franja decorativa y ventanas
	block(
		"Stripe",
		Vector3.new(size.X + 0.2, 1, size.Z + 0.2),
		cf * CFrame.new(0, size.Y - 1.5, 0),
		Color3.fromRGB(255, 196, 0),
		Enum.Material.SmoothPlastic,
		model
	)
	for i = -1, 1 do
		block(
			"Window",
			Vector3.new(size.X * 0.2, size.Y * 0.35, size.Z + 0.3),
			cf * CFrame.new(i * size.X * 0.3, size.Y * 0.45, 0),
			Color3.fromRGB(120, 190, 255),
			Enum.Material.Glass,
			model
		).Transparency = 0.3
	end
	-- murito de cobertura en la azotea
	local h = 3
	local top = size.Y
	block("Rail", Vector3.new(size.X, h, 1), cf * CFrame.new(0, top + h / 2, -size.Z / 2 + 0.5), color, Enum.Material.Concrete, model)
	block("Rail", Vector3.new(size.X, h, 1), cf * CFrame.new(0, top + h / 2, size.Z / 2 - 0.5), color, Enum.Material.Concrete, model)
	return model
end

local function spawnArea(team, cf)
	-- Zona de spawn con techo y muretes
	local base = block(
		"SpawnFloor",
		Vector3.new(30, 0.4, 70),
		cf * CFrame.new(0, 0.2, 0),
		team.Color.Color:Lerp(Color3.new(1, 1, 1), 0.55),
		Enum.Material.SmoothPlastic
	)
	base.Name = team.Name .. "SpawnFloor"
	block("Roof", Vector3.new(30, 1, 70), cf * CFrame.new(0, 16, 0), Color3.fromRGB(235, 235, 240), Enum.Material.Concrete)
	for _, z in { -34, 34 } do
		block("Pillar", Vector3.new(2, 16, 2), cf * CFrame.new(14, 8, z), Color3.fromRGB(235, 235, 240), Enum.Material.Concrete)
	end
	for _, z in { -24, 0, 24 } do
		block("Cover", Vector3.new(2, 4, 10), cf * CFrame.new(14, 2, z), team.Color.Color, Enum.Material.SmoothPlastic)
	end

	for i, z in { -24, -8, 8, 24 } do
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = team.Name .. "Spawn" .. i
		spawn.Anchored = true
		spawn.Size = Vector3.new(6, 1, 6)
		spawn.CFrame = cf * CFrame.new(-4, 0.5, z) * CFrame.Angles(0, -math.pi / 2, 0)
		spawn.TeamColor = team.Color
		spawn.BrickColor = team.Color
		spawn.Material = Enum.Material.Neon
		spawn.Neutral = false
		spawn.AllowTeamChangeOnTouch = false
		spawn.Duration = GameConfig.SpawnProtection
		spawn.Parent = mapFolder
		local decal = spawn:FindFirstChildOfClass("Decal")
		if decal then
			decal:Destroy()
		end
	end
end

local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 3
	Lighting.Ambient = Color3.fromRGB(110, 110, 130)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 170)
	Lighting.GlobalShadows = true

	local function ensure(className)
		local inst = Lighting:FindFirstChildOfClass(className)
		if not inst then
			inst = Instance.new(className)
			inst.Parent = Lighting
		end
		return inst
	end
	local atmosphere = ensure("Atmosphere")
	atmosphere.Density = 0.25
	atmosphere.Haze = 1
	atmosphere.Color = Color3.fromRGB(200, 225, 255)
	local cc = ensure("ColorCorrectionEffect")
	cc.Saturation = 0.2
	cc.Contrast = 0.08
	local bloom = ensure("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 20
	bloom.Threshold = 1.4
	ensure("Sky")
end

function MapBuilder.Build()
	setupLighting()
	if workspace:FindFirstChild("Map") then
		return workspace.Map
	end

	-- Quita el Baseplate por defecto de las plantillas
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end

	mapFolder = Instance.new("Folder")
	mapFolder.Name = "Map"
	mapFolder.Parent = workspace

	-- Suelo
	block("Floor", Vector3.new(LENGTH + 40, 2, WIDTH + 40), CFrame.new(0, -1, 0), Color3.fromRGB(196, 200, 210), Enum.Material.Concrete)
	-- Carriles de color
	for _, z in { -70, 0, 70 } do
		block("Lane", Vector3.new(LENGTH - 60, 0.05, 3), CFrame.new(0, 0.03, z), Color3.fromRGB(240, 240, 245), Enum.Material.SmoothPlastic)
	end

	-- Muros exteriores
	local wallColor = Color3.fromRGB(163, 196, 230)
	block("Wall", Vector3.new(LENGTH, WALL_HEIGHT, 4), CFrame.new(0, WALL_HEIGHT / 2, WIDTH / 2 + 2), wallColor, Enum.Material.Concrete)
	block("Wall", Vector3.new(LENGTH, WALL_HEIGHT, 4), CFrame.new(0, WALL_HEIGHT / 2, -WIDTH / 2 - 2), wallColor, Enum.Material.Concrete)
	block("Wall", Vector3.new(4, WALL_HEIGHT, WIDTH), CFrame.new(LENGTH / 2 + 2, WALL_HEIGHT / 2, 0), wallColor, Enum.Material.Concrete)
	block("Wall", Vector3.new(4, WALL_HEIGHT, WIDTH), CFrame.new(-LENGTH / 2 - 2, WALL_HEIGHT / 2, 0), wallColor, Enum.Material.Concrete)
	-- Techo invisible para que nadie salga del mapa
	local ceiling = block("Ceiling", Vector3.new(LENGTH, 1, WIDTH), CFrame.new(0, WALL_HEIGHT + 12, 0), Color3.new(1, 1, 1))
	ceiling.Transparency = 1
	ceiling.CanQuery = false

	-- Spawns
	local teams = GameConfig.Teams
	spawnArea(teams[1], CFrame.new(-LENGTH / 2 + 15, 0, 0))
	spawnArea(teams[2], MIRROR * CFrame.new(-LENGTH / 2 + 15, 0, 0))

	-- Mitad simétrica del mapa
	symmetric(function(m)
		-- Contenedores
		container(m * CFrame.new(-95, 0, -62), Color3.fromRGB(220, 60, 50))
		container(m * CFrame.new(-95, 0, -62 + 8.4), Color3.fromRGB(40, 120, 220))
		container(m * CFrame.new(-95, 8.9, -58), Color3.fromRGB(240, 150, 30))
		container(m * CFrame.new(-60, 0, 10) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(60, 170, 90))
		container(m * CFrame.new(-35, 0, -85), Color3.fromRGB(240, 150, 30))
		container(m * CFrame.new(-120, 0, 75), Color3.fromRGB(40, 120, 220))

		-- Edificio con azotea accesible por rampa
		building(m * CFrame.new(-75, 0, 68), Vector3.new(26, 12, 22), Color3.fromRGB(245, 245, 250))
		ramp(
			(m * CFrame.new(-38, 0, 74)).Position,
			(m * CFrame.new(-62, 12, 74)).Position,
			7,
			Color3.fromRGB(150, 150, 160)
		)

		-- Pasarela elevada sobre los contenedores
		block("Catwalk", Vector3.new(30, 1, 6), m * CFrame.new(-95, 17.9, -45), Color3.fromRGB(90, 90, 100), Enum.Material.DiamondPlate)
		ramp(
			(m * CFrame.new(-120, 0, -5)).Position,
			(m * CFrame.new(-110, 17.4, -45)).Position,
			6,
			Color3.fromRGB(150, 150, 160)
		)

		-- Cajas de cobertura
		crate(m * CFrame.new(-110, 0, 20))
		crate(m * CFrame.new(-110, 0, 25))
		crate(m * CFrame.new(-110, 4, 22.5))
		crate(m * CFrame.new(-45, 0, 45), 5)
		crate(m * CFrame.new(-80, 0, -20))
		crate(m * CFrame.new(-25, 0, -40), 5)
		crate(m * CFrame.new(-25, 0, -35))

		-- Muros bajos de cobertura
		block("LowWall", Vector3.new(2, 4.5, 16), m * CFrame.new(-40, 2.25, -15), Color3.fromRGB(250, 210, 80), Enum.Material.Concrete)
		block("LowWall", Vector3.new(14, 4.5, 2), m * CFrame.new(-18, 2.25, 40), Color3.fromRGB(250, 210, 80), Enum.Material.Concrete)

		-- Rampa a la plataforma central
		ramp((m * CFrame.new(-34, 0, 0)).Position, (m * CFrame.new(-12, 7, 0)).Position, 8, Color3.fromRGB(150, 150, 160))
	end)

	-- Plataforma central
	block("CenterPlatform", Vector3.new(24, 1, 24), CFrame.new(0, 6.5, 0), Color3.fromRGB(80, 80, 95), Enum.Material.DiamondPlate)
	for _, x in { -10, 10 } do
		for _, z in { -10, 10 } do
			block("Pillar", Vector3.new(2, 6, 2), CFrame.new(x, 3, z), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
		end
	end
	block("CenterCover", Vector3.new(2, 4, 10), CFrame.new(0, 9, 7), Color3.fromRGB(255, 80, 160), Enum.Material.SmoothPlastic)
	block("CenterCover", Vector3.new(2, 4, 10), CFrame.new(0, 9, -7), Color3.fromRGB(255, 80, 160), Enum.Material.SmoothPlastic)

	-- Rascacielos de fondo (decoración fuera de los muros)
	local rng = Random.new(42)
	local skyline = Instance.new("Folder")
	skyline.Name = "Skyline"
	skyline.Parent = mapFolder
	local palette = {
		Color3.fromRGB(120, 170, 230),
		Color3.fromRGB(90, 140, 210),
		Color3.fromRGB(200, 220, 245),
		Color3.fromRGB(70, 110, 180),
	}
	for x = -220, 220, 36 do
		for _, side in { -1, 1 } do
			local h = rng:NextNumber(60, 160)
			local w = rng:NextNumber(24, 34)
			local z = side * (WIDTH / 2 + 40 + rng:NextNumber(0, 30))
			local tower = block(
				"Tower",
				Vector3.new(w, h, w),
				CFrame.new(x, h / 2, z),
				palette[rng:NextInteger(1, #palette)],
				Enum.Material.Glass,
				skyline
			)
			tower.CanCollide = false
			tower.CanQuery = false
			tower.CastShadow = false
			for y = 10, h - 10, 14 do
				local strip = block(
					"Window",
					Vector3.new(w + 0.4, 1, w + 0.4),
					CFrame.new(x, y, z),
					Color3.fromRGB(255, 255, 255),
					Enum.Material.SmoothPlastic,
					skyline
				)
				strip.CanCollide = false
				strip.CanQuery = false
			end
		end
	end
	for _, x in { -1, 1 } do
		for z = -140, 140, 40 do
			local h = rng:NextNumber(50, 130)
			local tower = block(
				"Tower",
				Vector3.new(30, h, 30),
				CFrame.new(x * (LENGTH / 2 + 50), h / 2, z),
				palette[rng:NextInteger(1, #palette)],
				Enum.Material.Glass,
				skyline
			)
			tower.CanCollide = false
			tower.CanQuery = false
			tower.CastShadow = false
		end
	end

	return mapFolder
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">PlayerData</string>
            <string name="Source"><![CDATA[-- Datos persistentes del jugador (nivel, XP, monedas, skins) guardados con DataStore.
-- En Studio activa: Game Settings > Security > "Enable Studio Access to API Services".
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.GameConfig)
local Skins = require(Shared.Skins)
local Weapons = require(Shared.Weapons)
local Remotes = require(Shared.Remotes)

local PlayerData = {}

-- Callbacks que otros módulos pueden asignar
PlayerData.OnSkinChanged = nil -- function(player, skinId)

local store
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("ShooterRobData_v1")
	end)
	if ok then
		store = result
	else
		warn("[PlayerData] DataStore no disponible, el progreso no se guardará:", result)
	end
end

local profiles = {}
local noSave = {} -- jugadores cuya carga falló: no sobrescribimos sus datos

local function defaults()
	return {
		Level = 1,
		XP = 0,
		Coins = 0,
		Skins = { Default = true },
		EquippedSkin = "Default",
		Primary = "Rifle",
		ClaimedFree = {},
		ClaimedPremium = {},
		TotalKills = 0,
		Wins = 0,
		Premium = false,
	}
end

local function key(player)
	return "u_" .. player.UserId
end

local function publicView(data)
	return {
		Level = data.Level,
		XP = data.XP,
		XPPerLevel = GameConfig.XPPerLevel,
		Coins = data.Coins,
		Skins = data.Skins,
		EquippedSkin = data.EquippedSkin,
		Primary = data.Primary,
		TotalKills = data.TotalKills,
		Wins = data.Wins,
		Premium = data.Premium,
	}
end

local function sendUpdate(player)
	local data = profiles[player]
	if data then
		Remotes.DataUpdate:FireClient(player, publicView(data))
	end
end
PlayerData.SendUpdate = sendUpdate

function PlayerData.GetLeaderstats(player)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		for _, name in { "Bajas", "Muertes", "Nivel" } do
			local value = Instance.new("IntValue")
			value.Name = name
			value.Parent = stats
		end
		stats.Parent = player
	end
	return stats
end

local function grant(player, data, reward)
	if not reward then
		return
	end
	if reward.Type == "Skin" then
		data.Skins[reward.Id] = true
		Remotes.Notify:FireClient(player, "Unlock", "¡Skin desbloqueada: " .. Skins.Get(reward.Id).Name .. "!")
	elseif reward.Type == "Coins" then
		data.Coins += reward.Amount
	end
end

-- Entrega todas las recompensas del pase hasta el nivel actual que aún no se hayan reclamado
local function grantTierRewards(player)
	local data = profiles[player]
	if not data then
		return
	end
	local maxTier = math.min(data.Level, #GameConfig.BattlePass)
	for tier = 1, maxTier do
		local t = GameConfig.BattlePass[tier]
		local k = tostring(tier)
		if not data.ClaimedFree[k] then
			data.ClaimedFree[k] = true
			grant(player, data, t.Free)
		end
		if data.Premium and not data.ClaimedPremium[k] then
			data.ClaimedPremium[k] = true
			grant(player, data, t.Premium)
		end
	end
end

local function ownsPremium(player)
	if GameConfig.PremiumPassId == 0 then
		return false
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, GameConfig.PremiumPassId)
	end)
	return ok and owns
end

local function load(player)
	local data
	if store then
		local loaded, result = false, nil
		for attempt = 1, 3 do
			loaded, result = pcall(function()
				return store:GetAsync(key(player))
			end)
			if loaded then
				break
			end
			task.wait(attempt)
		end
		if loaded then
			data = result
		else
			warn("[PlayerData] No se pudieron cargar los datos de", player.Name, result)
			noSave[player] = true
		end
	end

	local merged = defaults()
	if type(data) == "table" then
		for k, v in data do
			merged[k] = v
		end
	end
	if not Skins.List[merged.EquippedSkin] or not merged.Skins[merged.EquippedSkin] then
		merged.EquippedSkin = "Default"
	end
	if not table.find(Weapons.Primaries, merged.Primary) then
		merged.Primary = "Rifle"
	end
	merged.Premium = merged.Premium or ownsPremium(player)

	if not player.Parent then
		return
	end
	profiles[player] = merged
	PlayerData.GetLeaderstats(player).Nivel.Value = merged.Level
	grantTierRewards(player)
	sendUpdate(player)
end

local function save(player)
	local data = profiles[player]
	if not data or not store or noSave[player] then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync(key(player), data)
	end)
	if not ok then
		warn("[PlayerData] Error al guardar", player.Name, err)
	end
end

function PlayerData.Get(player)
	return profiles[player]
end

-- Espera a que los datos del jugador estén cargados (máx. timeout segundos)
function PlayerData.WaitFor(player, timeout)
	local start = os.clock()
	while not profiles[player] and player.Parent and os.clock() - start < (timeout or 15) do
		task.wait(0.1)
	end
	return profiles[player]
end

function PlayerData.AddXP(player, amount, reason)
	local data = profiles[player]
	if not data or amount <= 0 then
		return
	end
	data.XP += amount
	Remotes.Notify:FireClient(player, "XP", "+" .. amount .. " XP  " .. (reason or ""))
	local leveled = false
	while data.XP >= GameConfig.XPPerLevel do
		data.XP -= GameConfig.XPPerLevel
		data.Level += 1
		leveled = true
	end
	if leveled then
		PlayerData.GetLeaderstats(player).Nivel.Value = data.Level
		Remotes.Notify:FireClient(player, "Big", "¡NIVEL " .. data.Level .. "!")
		grantTierRewards(player)
	end
	sendUpdate(player)
end

function PlayerData.AddCoins(player, amount)
	local data = profiles[player]
	if data then
		data.Coins += amount
		sendUpdate(player)
	end
end

function PlayerData.Increment(player, field, amount)
	local data = profiles[player]
	if data and type(data[field]) == "number" then
		data[field] += amount or 1
	end
end

function PlayerData.Init()
	Players.PlayerAdded:Connect(function(player)
		PlayerData.GetLeaderstats(player)
		load(player)
	end)
	for _, player in Players:GetPlayers() do
		PlayerData.GetLeaderstats(player)
		task.spawn(load, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		save(player)
		profiles[player] = nil
		noSave[player] = nil
	end)

	game:BindToClose(function()
		for _, player in Players:GetPlayers() do
			task.spawn(save, player)
		end
		task.wait(3)
	end)

	-- Autoguardado
	task.spawn(function()
		while true do
			task.wait(120)
			for _, player in Players:GetPlayers() do
				task.spawn(save, player)
			end
		end
	end)

	Remotes.GetData.OnServerInvoke = function(player)
		local data = PlayerData.WaitFor(player, 20)
		return data and publicView(data)
	end

	Remotes.EquipSkin.OnServerEvent:Connect(function(player, skinId)
		local data = profiles[player]
		if not data or type(skinId) ~= "string" or not Skins.List[skinId] or not data.Skins[skinId] then
			return
		end
		data.EquippedSkin = skinId
		if PlayerData.OnSkinChanged then
			PlayerData.OnSkinChanged(player, skinId)
		end
		sendUpdate(player)
	end)

	Remotes.SetPrimary.OnServerEvent:Connect(function(player, weaponName)
		local data = profiles[player]
		if not data or type(weaponName) ~= "string" or not table.find(Weapons.Primaries, weaponName) then
			return
		end
		data.Primary = weaponName
		Remotes.Notify:FireClient(
			player,
			"Info",
			Weapons.Get(weaponName).DisplayName .. " equipada (al reaparecer)"
		)
		sendUpdate(player)
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased and passId == GameConfig.PremiumPassId then
			local data = profiles[player]
			if data then
				data.Premium = true
				Remotes.Notify:FireClient(player, "Big", "¡PASE PREMIUM ACTIVADO!")
				grantTierRewards(player)
				sendUpdate(player)
				save(player)
			end
		end
	end)
end

return PlayerData
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Round</string>
            <string name="Source"><![CDATA[-- Equipos, rondas (Team Deathmatch), marcador, rachas y recompensas.
-- El estado se publica como atributos de ReplicatedStorage para que la interfaz lo lea:
--   State ("Intermission" | "Playing" | "Ended"), TimeLeft, ScoreToWin, Score_<Equipo>
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.GameConfig)
local Weapons = require(Shared.Weapons)
local Remotes = require(Shared.Remotes)

local PlayerData = require(script.Parent.PlayerData)

local Round = {}

local teams = {}
local roundOver = false

local STREAK_ANNOUNCE = { [3] = true, [5] = true, [7] = true, [10] = true, [15] = true, [20] = true }

local function setState(state)
	ReplicatedStorage:SetAttribute("State", state)
end

local function getScore(teamName)
	return ReplicatedStorage:GetAttribute("Score_" .. teamName) or 0
end

local function setupTeams()
	for _, cfg in GameConfig.Teams do
		local team = Teams:FindFirstChild(cfg.Name)
		if not team then
			team = Instance.new("Team")
			team.Name = cfg.Name
			team.TeamColor = cfg.Color
			team.AutoAssignable = false
			team.Parent = Teams
		end
		table.insert(teams, team)
		ReplicatedStorage:SetAttribute("Score_" .. cfg.Name, 0)
	end
	ReplicatedStorage:SetAttribute("ScoreToWin", GameConfig.ScoreToWin)
	ReplicatedStorage:SetAttribute("TeamA", teams[1].Name)
	ReplicatedStorage:SetAttribute("TeamB", teams[2].Name)
end

local function smallestTeam(exclude)
	local best, bestCount = nil, math.huge
	for _, team in teams do
		local count = 0
		for _, p in team:GetPlayers() do
			if p ~= exclude then
				count += 1
			end
		end
		if count < bestCount or (count == bestCount and math.random() < 0.5) then
			best, bestCount = team, count
		end
	end
	return best
end

local function assignTeam(player)
	player.Neutral = false
	player.Team = smallestTeam(player)
end

local function balanceTeams()
	-- Mueve jugadores del equipo grande al pequeño si la diferencia es > 1
	local a, b = teams[1], teams[2]
	while math.abs(#a:GetPlayers() - #b:GetPlayers()) > 1 do
		local big = #a:GetPlayers() > #b:GetPlayers() and a or b
		local small = big == a and b or a
		local list = big:GetPlayers()
		list[math.random(1, #list)].Team = small
	end
end

local function resetStats()
	for _, player in Players:GetPlayers() do
		local stats = PlayerData.GetLeaderstats(player)
		stats.Bajas.Value = 0
		stats.Muertes.Value = 0
		player:SetAttribute("Streak", 0)
	end
	for _, team in teams do
		ReplicatedStorage:SetAttribute("Score_" .. team.Name, 0)
	end
end

function Round.RegisterKill(killer, victim, victimName, weaponName, headshot)
	if victim then
		PlayerData.GetLeaderstats(victim).Muertes.Value += 1
		victim:SetAttribute("Streak", 0)
	end

	local killerColor, victimColor = Color3.new(1, 1, 1), Color3.new(1, 1, 1)
	if victim and victim.Team then
		victimColor = victim.TeamColor.Color
	end

	if killer and killer ~= victim then
		if killer.Team then
			killerColor = killer.TeamColor.Color
		end
		if victim then
			PlayerData.GetLeaderstats(killer).Bajas.Value += 1
			local streak = (killer:GetAttribute("Streak") or 0) + 1
			killer:SetAttribute("Streak", streak)

			if ReplicatedStorage:GetAttribute("State") == "Playing" and killer.Team then
				local teamName = killer.Team.Name
				local score = getScore(teamName) + 1
				ReplicatedStorage:SetAttribute("Score_" .. teamName, score)
				if score >= GameConfig.ScoreToWin then
					roundOver = true
				end
			end

			local xp = GameConfig.XP.Kill + GameConfig.XP.StreakBonus * (streak - 1)
			if headshot then
				xp += GameConfig.XP.Headshot
			end
			PlayerData.AddXP(killer, xp, headshot and "Disparo a la cabeza" or "Eliminación")
			PlayerData.AddCoins(killer, GameConfig.Coins.Kill)
			PlayerData.Increment(killer, "TotalKills", 1)

			if STREAK_ANNOUNCE[streak] then
				Remotes.Notify:FireAllClients("Streak", killer.Name .. " tiene una racha de " .. streak .. " bajas")
			end
		end
	end

	local weapon = weaponName and Weapons.Get(weaponName)
	Remotes.KillFeed:FireAllClients({
		Killer = killer and killer.Name or nil,
		KillerColor = killerColor,
		Victim = victimName,
		VictimColor = victimColor,
		Weapon = weapon and weapon.DisplayName or "",
		Headshot = headshot,
	})
end

local function countdown(seconds, stopWhen)
	for t = seconds, 0, -1 do
		ReplicatedStorage:SetAttribute("TimeLeft", t)
		if stopWhen and stopWhen() then
			return
		end
		task.wait(1)
	end
end

local function respawnAll()
	for _, player in Players:GetPlayers() do
		task.spawn(function()
			player:LoadCharacter()
		end)
	end
end

local function endRound()
	setState("Ended")
	local a, b = teams[1], teams[2]
	local scoreA, scoreB = getScore(a.Name), getScore(b.Name)
	local winner = nil
	if scoreA > scoreB then
		winner = a
	elseif scoreB > scoreA then
		winner = b
	end

	-- MVP = más bajas
	local mvp, mvpKills = nil, -1
	for _, player in Players:GetPlayers() do
		local kills = PlayerData.GetLeaderstats(player).Bajas.Value
		if kills > mvpKills then
			mvp, mvpKills = player, kills
		end
	end

	for _, player in Players:GetPlayers() do
		if winner and player.Team == winner then
			PlayerData.AddXP(player, GameConfig.XP.Win, "Victoria")
			PlayerData.AddCoins(player, GameConfig.Coins.Win)
			PlayerData.Increment(player, "Wins", 1)
		else
			PlayerData.AddXP(player, GameConfig.XP.Loss, "Partida completada")
		end
	end

	Remotes.RoundEnd:FireAllClients({
		Winner = winner and winner.Name or nil,
		WinnerColor = winner and winner.TeamColor.Color or Color3.new(1, 1, 1),
		ScoreA = scoreA,
		ScoreB = scoreB,
		MVP = mvp and mvp.Name or nil,
		MVPKills = math.max(mvpKills, 0),
	})
	task.wait(GameConfig.EndScreenTime)
end

local function gameLoop()
	while true do
		setState("Intermission")
		countdown(GameConfig.IntermissionTime)
		while #Players:GetPlayers() < GameConfig.MinPlayers do
			ReplicatedStorage:SetAttribute("TimeLeft", 0)
			task.wait(1)
		end

		roundOver = false
		balanceTeams()
		resetStats()
		setState("Playing")
		respawnAll()
		Remotes.Notify:FireAllClients("Big", "¡A LUCHAR! Primero en llegar a " .. GameConfig.ScoreToWin)
		countdown(GameConfig.RoundTime, function()
			return roundOver
		end)
		endRound()
	end
end

function Round.Init()
	Players.RespawnTime = GameConfig.RespawnTime
	setupTeams()
	setState("Intermission")
	ReplicatedStorage:SetAttribute("TimeLeft", GameConfig.IntermissionTime)

	Players.PlayerAdded:Connect(assignTeam)
	for _, player in Players:GetPlayers() do
		if not player.Team then
			assignTeam(player)
			player:LoadCharacter()
		end
	end

	task.spawn(gameLoop)
end

return Round
]]></string>
          </Properties>
        </Item>
