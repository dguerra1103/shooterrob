		B("GripGlow", 0, 0, 0.17, 0.27, 0.42, 0.03, "Panel"),
	}))
	return p
end

---------------------------------------------------------------------------
-- SPECTER-9 (subfusil)
---------------------------------------------------------------------------
function Designs.Specter9()
	local p = {
		B("Handle", 0, 0, 0, 0.34, 0.46, 1.2, "Body"),
		B("UpperPanel", 0, 0.12, 0.3, 0.36, 0.2, 0.5, "Panel"),
