          <Item class="ModuleScript" referent="26">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[-- Interfaz en partida: marcador, mira, munición, vida, racha, killfeed, avisos y pantallas de ronda.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weapons = require(Shared.Weapons)
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local WeaponController = require(script.Parent.WeaponController)

local player = Players.LocalPlayer

local HUD = {}

local gui
local refs = {}
local thumbnails = {}

local function tween(inst, time, props, style)
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad), props)
	t:Play()
	return t
end

local function disableCoreGui()
	for _ = 1, 20 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
		end)
		if ok then
			return
		end
		task.wait(0.5)
	end
end

---------------------------------------------------------------------------
-- Construcción
---------------------------------------------------------------------------

local function buildTopBar()
	local top = UI.new("Frame", {
		Name = "TopBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(330, 44),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local function scoreBox(x, name)
		local box = UI.new("Frame", {
			Name = name,
			Position = UDim2.fromOffset(x, 0),
			Size = UDim2.fromOffset(90, 44),
			BackgroundColor3 = Color3.fromRGB(80, 80, 80),
			Parent = top,
		}, { UI.corner(8), UI.stroke(Color3.new(0, 0, 0), 2, 0.3) })
		return UI.label({
			Size = UDim2.fromScale(1, 1),
			Text = "0",
			TextSize = 30,
			Parent = box,
		})
	end
	refs.ScoreA = scoreBox(0, "TeamA")
	refs.ScoreB = scoreBox(240, "TeamB")
	refs.ScoreABox = refs.ScoreA.Parent
	refs.ScoreBBox = refs.ScoreB.Parent

	local timerBox = UI.new("Frame", {
		Position = UDim2.fromOffset(95, 0),
		Size = UDim2.fromOffset(140, 44),
		BackgroundColor3 = Color3.fromRGB(25, 30, 60),
		Parent = top,
	}, { UI.corner(8), UI.stroke(Color3.new(0, 0, 0), 2, 0.3) })
	refs.Timer = UI.label({ Size = UDim2.fromScale(1, 1), Text = "00:00", TextSize = 30, Parent = timerBox })

	refs.Mode = UI.label({
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 0, 20),
		Text = "",
		TextSize = 16,
		Parent = top,
	})

	refs.PlayerRow = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.fromOffset(500, 54),
		BackgroundTransparency = 1,
		Parent = top,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
end

local function buildCrosshair()
	local holder = UI.new("Frame", {
		Name = "Crosshair",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	refs.Crosshair = holder
	refs.CrossLines = {}
	for i, dir in { Vector2.new(0, -1), Vector2.new(0, 1), Vector2.new(-1, 0), Vector2.new(1, 0) } do
		local vertical = dir.X == 0
		refs.CrossLines[i] = {
			Dir = dir,
			Frame = UI.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = vertical and UDim2.fromOffset(2, 9) or UDim2.fromOffset(9, 2),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				Parent = holder,
			}, { UI.stroke(Color3.new(0, 0, 0), 1, 0.4) }),
		}
	end
	refs.CrossDot = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(3, 3),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = holder,
	}, { UI.corner(2) })

	-- Hitmarker (4 líneas diagonales)
	refs.Hitmarker = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(34, 34),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	refs.HitLines = {}
	for i, pos in { Vector2.new(-1, -1), Vector2.new(1, -1), Vector2.new(-1, 1), Vector2.new(1, 1) } do
		refs.HitLines[i] = UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, pos.X * 10, 0.5, pos.Y * 10),
			Size = UDim2.fromOffset(10, 3),
			Rotation = pos.X * pos.Y * 45,
			BorderSizePixel = 0,
			BackgroundColor3 = Color3.new(1, 1, 1),
			Parent = refs.Hitmarker,
		})
	end

	-- Mira telescópica (círculo con borde negro enorme)
	refs.Scope = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.8, 0.8),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 0,
		Parent = gui,
	}, {
		UI.new("UIAspectRatioConstraint", { AspectRatio = 1 }),
		UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
		UI.new("UIStroke", { Thickness = 3000, Color = Color3.new(0, 0, 0) }),
		-- Bandas negras a los lados (por si el borde no cubre toda la pantalla)
		UI.new("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.new(0, 4000, 3, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
		}),
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.new(0, 4000, 3, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
		}),
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, 0, 0, 2),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
		}),
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 2, 1, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
		}),
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(5, 5),
			BackgroundColor3 = Color3.fromRGB(255, 40, 40),
			BorderSizePixel = 0,
		}, { UI.corner(3) }),
	})
end

local function buildWeaponPanel()
	-- Munición (abajo a la derecha)
	local panel = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -20),
		Size = UDim2.fromOffset(260, 90),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	refs.WeaponName = UI.label({
		Size = UDim2.new(1, 0, 0, 24),
		Text = "",
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = panel,
	})
	refs.Ammo = UI.label({
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 0, 50),
		Text = "",
		TextSize = 46,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = panel,
	})
	refs.ReloadHint = UI.label({
		Position = UDim2.fromOffset(0, 72),
		Size = UDim2.new(1, 0, 0, 18),
		Text = "",
		TextSize = 16,
		TextColor3 = Color3.fromRGB(255, 210, 80),
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = panel,
	})

	-- Ranuras de armas (derecha)
	local slots = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -20, 0.62, 0),
		Size = UDim2.fromOffset(200, 150),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			Padding = UDim.new(0, 8),
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	refs.Slots = {}
	for slot = 1, 3 do
		local row = UI.new("Frame", {
			LayoutOrder = slot,
			Size = UDim2.fromOffset(200, 40),
			BackgroundTransparency = 1,
			Parent = slots,
		})
		local name = UI.label({
			Size = UDim2.new(1, -40, 1, 0),
			Text = "",
			TextSize = 18,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = row,
		})
		local key = UI.new("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.fromOffset(30, 30),
			BackgroundColor3 = Color3.fromRGB(20, 20, 25),
			Parent = row,
		}, { UI.corner(6) })
		UI.label({ Size = UDim2.fromScale(1, 1), Text = tostring(slot), TextSize = 18, Parent = key })
		refs.Slots[slot] = { Name = name, Key = key, Row = row }
	end

	-- Controles (estilo de la captura)
	if not UserInputService.TouchEnabled or UserInputService.KeyboardEnabled then
		local hints = UI.new("Frame", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -20, 0.22, 0),
			Size = UDim2.fromOffset(220, 150),
			BackgroundTransparency = 1,
			Parent = gui,
		}, {
			UI.new("UIListLayout", {
				Padding = UDim.new(0, 4),
				HorizontalAlignment = Enum.HorizontalAlignment.Right,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		for i, pair in {
			{ "Pase de batalla", "B" },
			{ "Deslizar", "C" },
			{ "Cuchillo rápido", "F" },
			{ "Recargar", "R" },
			{ "Correr", "Shift" },
		} do
			local row = UI.new("Frame", {
				LayoutOrder = i,
				Size = UDim2.fromOffset(220, 24),
				BackgroundTransparency = 1,
				Parent = hints,
			})
			UI.label({
				Size = UDim2.new(1, -56, 1, 0),
				Text = pair[1],
				TextSize = 17,
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = row,
			})
			local key = UI.new("Frame", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(50, 22),
				BackgroundColor3 = Color3.fromRGB(20, 20, 25),
				Parent = row,
			}, { UI.corner(5) })
			UI.label({ Size = UDim2.fromScale(1, 1), Text = pair[2], TextSize = 14, Parent = key })
		end
	end
end

local function buildPlayerPanel()
	-- Vida (abajo a la izquierda)
	local health = UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 24, 1, -24),
		Size = UDim2.fromOffset(240, 22),
		BackgroundColor3 = Color3.fromRGB(20, 20, 25),
		Parent = gui,
	}, { UI.corner(11), UI.stroke(Color3.new(0, 0, 0), 2, 0.2) })
	refs.HealthFill = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(70, 220, 90),
		Parent = health,
	}, { UI.corner(11) })
	refs.HealthText = UI.label({ Size = UDim2.fromScale(1, 1), Text = "100", TextSize = 16, Parent = health })

	-- Racha (barra vertical a la izquierda, como en la captura)
	local streakBar = UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 40, 0.55, 0),
		Size = UDim2.fromOffset(10, 240),
		BackgroundColor3 = Color3.fromRGB(30, 30, 35),
		Parent = gui,
	}, { UI.corner(5), UI.stroke(Color3.new(0, 0, 0), 2, 0.3) })
	refs.StreakFill = UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0),
		BackgroundColor3 = Color3.fromRGB(255, 180, 30),
		Parent = streakBar,
	}, { UI.corner(5) })
	refs.StreakText = UI.label({
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.new(0, 14, 0.55, 126),
		Size = UDim2.fromOffset(120, 22),
		Text = "Racha x0",
		TextSize = 18,
		TextColor3 = Color3.fromRGB(255, 210, 80),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = gui,
	})

	-- Nivel / XP (abajo al centro)
	local level = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.fromOffset(320, 10),
		BackgroundColor3 = Color3.fromRGB(20, 20, 25),
		Parent = gui,
	}, { UI.corner(5) })
	refs.XPFill = UI.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.fromRGB(80, 170, 255),
		Parent = level,
	}, { UI.corner(5) })
	refs.LevelText = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, -2),
		Size = UDim2.fromOffset(320, 18),
		Text = "Nivel 1",
		TextSize = 15,
		Parent = level,
	})
end

local function buildFeedsAndOverlays()
	refs.KillFeed = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 60),
		Size = UDim2.fromOffset(380, 220),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			Padding = UDim.new(0, 4),
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	refs.Popups = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.58, 0),
		Size = UDim2.fromOffset(400, 140),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			Padding = UDim.new(0, 2),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	refs.BigText = UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(800, 70),
		Text = "",
		TextSize = 54,
		TextStrokeTransparency = 0,
		Visible = false,
		Parent = gui,
	})

	refs.Banner = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 135),
		Size = UDim2.fromOffset(600, 30),
		Text = "",
		TextSize = 24,
		TextColor3 = Color3.fromRGB(255, 200, 60),
		Visible = false,
		Parent = gui,
	})

	refs.Toast = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -50),
		Size = UDim2.fromOffset(600, 30),
		Text = "",
		TextSize = 22,
		Visible = false,
		Parent = gui,
	})

	-- Viñeta roja de daño
	refs.Damage = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -120, 1, -120),
		BackgroundTransparency = 1,
		ZIndex = 0,
		Parent = gui,
	}, { UI.new("UICorner", { CornerRadius = UDim.new(0, 60) }) })
	refs.DamageStroke = UI.new("UIStroke", {
		Thickness = 90,
		Color = Color3.fromRGB(200, 0, 0),
		Transparency = 1,
		Parent = refs.Damage,
	})

	-- Pantalla de muerte
	refs.DeathScreen = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.6,
		Visible = false,
		Parent = gui,
	})
	refs.DeathText = UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(800, 60),
		Text = "",
		TextSize = 40,
		TextColor3 = Color3.fromRGB(255, 80, 80),
		RichText = true,
		Parent = refs.DeathScreen,
	})
	UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.53),
		Size = UDim2.fromOffset(600, 30),
		Text = "Reapareciendo...",
		TextSize = 22,
		Parent = refs.DeathScreen,
	})

	-- Fin de ronda
	refs.RoundEnd = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(560, 220),
		BackgroundColor3 = Color3.fromRGB(20, 22, 35),
		BackgroundTransparency = 0.15,
		Visible = false,
		Parent = gui,
	}, { UI.corner(16), UI.stroke(Color3.new(1, 1, 1), 3, 0.6) })
	refs.RoundTitle = UI.label({
		Position = UDim2.fromOffset(0, 20),
		Size = UDim2.new(1, 0, 0, 56),
		Text = "",
		TextSize = 44,
		Parent = refs.RoundEnd,
	})
	refs.RoundScore = UI.label({
		Position = UDim2.fromOffset(0, 86),
		Size = UDim2.new(1, 0, 0, 50),
		Text = "",
		TextSize = 40,
		RichText = true,
		Parent = refs.RoundEnd,
	})
	refs.RoundMVP = UI.label({
		Position = UDim2.fromOffset(0, 150),
		Size = UDim2.new(1, 0, 0, 40),
		Text = "",
		TextSize = 24,
		TextColor3 = Color3.fromRGB(255, 210, 80),
		Parent = refs.RoundEnd,
	})
end

---------------------------------------------------------------------------
-- Mensajes
---------------------------------------------------------------------------

local function popup(text, color)
	local label = UI.label({
		Size = UDim2.fromOffset(400, 26),
		Text = text,
		TextSize = 22,
		TextColor3 = color or Color3.fromRGB(255, 230, 120),
		LayoutOrder = math.floor(os.clock() * 100) % 100000,
		Parent = refs.Popups,
	})
	task.delay(1.4, function()
		tween(label, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	Debris:AddItem(label, 2)
end

local bigToken
local function bigMessage(text, color)
	local label = refs.BigText
	label.Text = text
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextTransparency = 0
	label.TextStrokeTransparency = 0
	label.Size = UDim2.fromOffset(800, 70)
	label.TextSize = 70
	label.Visible = true
	tween(label, 0.25, { TextSize = 54 }, Enum.EasingStyle.Back)
	local token = {}
	bigToken = token
	task.delay(2.5, function()
		if bigToken == token then
			tween(label, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
	end)
end

local function timedLabel(label, text, duration)
	label.Text = text
	label.Visible = true
	local token = {}
	label:SetAttribute("Token", tostring(token))
	task.delay(duration, function()
		if label:GetAttribute("Token") == tostring(token) then
			label.Visible = false
		end
	end)
end

local function onNotify(kind, text)
	if kind == "XP" then
		popup(text)
	elseif kind == "Big" then
		bigMessage(text)
	elseif kind == "Streak" then
		timedLabel(refs.Banner, "🔥 " .. text, 3)
	else
		timedLabel(refs.Toast, text, 3)
		Sounds.Play("Click")
	end
end

local function onKillFeed(info)
	if type(info) ~= "table" then
		return
	end
	local killer = info.Killer
	local text
	local weapon = info.Weapon ~= "" and (" [" .. info.Weapon .. "] ") or " ✖ "
	if info.Headshot then
		weapon ..= "🎯 "
	end
	local victim = string.format('<font color="%s">%s</font>', UI.hex(info.VictimColor), info.Victim or "?")
	if killer then
		text = string.format('<font color="%s">%s</font>%s%s', UI.hex(info.KillerColor), killer, weapon, victim)
	else
		text = victim .. " se eliminó"
	end
	local entry = UI.new("Frame", {
		Size = UDim2.fromOffset(380, 26),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		LayoutOrder = math.floor(os.clock() * 100) % 1000000,
		Parent = refs.KillFeed,
	}, { UI.corner(6) })
	if killer == player.Name or info.Victim == player.Name then
		UI.stroke(Color3.fromRGB(255, 210, 80), 2, 0.2).Parent = entry
	end
	UI.label({
		Size = UDim2.new(1, -12, 1, 0),
		Position = UDim2.fromOffset(6, 0),
		Text = text,
		RichText = true,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = entry,
	})
	local entries = {}
	for _, child in refs.KillFeed:GetChildren() do
		if child:IsA("Frame") then
			table.insert(entries, child)
		end
	end
	if #entries > 6 then
		table.sort(entries, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		entries[1]:Destroy()
	end
	Debris:AddItem(entry, 7)
end

local hitToken
local function onHitConfirm(damage, headshot, killed)
	local color = Color3.new(1, 1, 1)
	if killed then
		color = Color3.fromRGB(255, 40, 40)
	elseif headshot then
		color = Color3.fromRGB(255, 210, 40)
	end
	for _, line in refs.HitLines do
		line.BackgroundColor3 = color
		line.Size = killed and UDim2.fromOffset(14, 4) or UDim2.fromOffset(10, 3)
	end
	refs.Hitmarker.Visible = true
	local token = {}
	hitToken = token
	task.delay(killed and 0.35 or 0.15, function()
		if hitToken == token then
			refs.Hitmarker.Visible = false
		end
	end)
	Sounds.Play(killed and "Kill" or (headshot and "Headshot" or "Hit"))

	-- Número de daño
	if type(damage) == "number" then
		local label = UI.label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.random(30, 60), 0.5, math.random(-40, -20)),
			Size = UDim2.fromOffset(80, 30),
			Text = tostring(damage),
			TextSize = headshot and 28 or 22,
			TextColor3 = color,
			Parent = gui,
		})
		tween(label, 0.6, {
			Position = label.Position + UDim2.fromOffset(0, -30),
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		})
		Debris:AddItem(label, 0.7)
	end
end

local function onRoundEnd(info)
	if type(info) ~= "table" then
		return
	end
	local teamA = ReplicatedStorage:GetAttribute("TeamA") or "Rojo"
	local teamB = ReplicatedStorage:GetAttribute("TeamB") or "Azul"
	if info.Winner then
		local won = player.Team and player.Team.Name == info.Winner
		refs.RoundTitle.Text = won and "¡VICTORIA!" or "DERROTA"
		refs.RoundTitle.TextColor3 = won and Color3.fromRGB(255, 210, 60) or Color3.fromRGB(255, 80, 80)
	else
		refs.RoundTitle.Text = "EMPATE"
		refs.RoundTitle.TextColor3 = Color3.new(1, 1, 1)
	end
	local colorA = refs.ScoreABox.BackgroundColor3
	local colorB = refs.ScoreBBox.BackgroundColor3
	refs.RoundScore.Text = string.format(
		'<font color="%s">%s %d</font>  -  <font color="%s">%d %s</font>',
		UI.hex(colorA),
		teamA,
		info.ScoreA or 0,
		UI.hex(colorB),
		info.ScoreB or 0,
		teamB
	)
	refs.RoundMVP.Text = info.MVP and ("⭐ MVP: " .. info.MVP .. " (" .. info.MVPKills .. " bajas)") or ""
	refs.RoundEnd.Visible = true
	task.delay(7, function()
		refs.RoundEnd.Visible = false
	end)
end

---------------------------------------------------------------------------
-- Actualización
---------------------------------------------------------------------------

local function getThumbnail(userId)
	if thumbnails[userId] ~= nil then
		return thumbnails[userId]
	end
	thumbnails[userId] = ""
	task.spawn(function()
		local ok, image = pcall(function()
			return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
		end)
		thumbnails[userId] = ok and image or ""
	end)
	return ""
end

local function updatePlayerRow()
	local list = Players:GetPlayers()
	local function kills(p)
		local stats = p:FindFirstChild("leaderstats")
		local value = stats and stats:FindFirstChild("Bajas")
		return value and value.Value or 0
	end
	table.sort(list, function(a, b)
		return kills(a) > kills(b)
	end)
	for _, child in refs.PlayerRow:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	for rank = 1, math.min(10, #list) do
		local p = list[rank]
		local teamColor = p.Team and p.TeamColor.Color or Color3.new(1, 1, 1)
		local card = UI.new("Frame", {
			LayoutOrder = rank,
			Size = UDim2.fromOffset(40, 54),
			BackgroundTransparency = 1,
			Parent = refs.PlayerRow,
		})
		UI.new("ImageLabel", {
			Size = UDim2.fromOffset(40, 40),
			BackgroundColor3 = Color3.fromRGB(40, 40, 45),
			Image = getThumbnail(p.UserId),
			Parent = card,
		}, { UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0) }), UI.stroke(teamColor, 3, 0) })
		UI.label({
			Position = UDim2.fromOffset(-6, -6),
			Size = UDim2.fromOffset(24, 14),
			Text = "#" .. rank,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		UI.label({
			Position = UDim2.fromOffset(0, 38),
			Size = UDim2.fromOffset(40, 16),
			Text = tostring(kills(p)),
			TextSize = 15,
			TextColor3 = p == player and Color3.fromRGB(255, 210, 60) or Color3.new(1, 1, 1),
			Parent = card,
		})
	end
end

local function updateScoreboard()
	local teamA = ReplicatedStorage:GetAttribute("TeamA")
	local teamB = ReplicatedStorage:GetAttribute("TeamB")
	if teamA then
		refs.ScoreA.Text = tostring(ReplicatedStorage:GetAttribute("Score_" .. teamA) or 0)
		local team = game:GetService("Teams"):FindFirstChild(teamA)
		if team then
			refs.ScoreABox.BackgroundColor3 = team.TeamColor.Color
		end
	end
	if teamB then
		refs.ScoreB.Text = tostring(ReplicatedStorage:GetAttribute("Score_" .. teamB) or 0)
		local team = game:GetService("Teams"):FindFirstChild(teamB)
		if team then
			refs.ScoreBBox.BackgroundColor3 = team.TeamColor.Color
		end
	end
	local state = ReplicatedStorage:GetAttribute("State")
	local timeLeft = ReplicatedStorage:GetAttribute("TimeLeft") or 0
	refs.Timer.Text = UI.formatTime(timeLeft)
	if state == "Intermission" then
		refs.Mode.Text = "Calentamiento · la partida empieza en " .. timeLeft
	elseif state == "Ended" then
		refs.Mode.Text = "Fin de la ronda"
	else
		refs.Mode.Text = "Duelo por equipos · Primero a " .. tostring(ReplicatedStorage:GetAttribute("ScoreToWin") or "?")
	end
end

local function updateData(data)
	if not data then
		return
	end
	local per = data.XPPerLevel or 1000
	refs.LevelText.Text = "Nivel " .. data.Level .. "  ·  " .. data.XP .. "/" .. per .. " XP"
	tween(refs.XPFill, 0.3, { Size = UDim2.fromScale(math.clamp(data.XP / per, 0, 1), 1) })
end

local lastHealth = 100
local function render()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	-- Vida
	if humanoid then
		local health = math.max(0, humanoid.Health)
		local ratio = health / math.max(humanoid.MaxHealth, 1)
		refs.HealthFill.Size = UDim2.fromScale(ratio, 1)
		refs.HealthFill.BackgroundColor3 = Color3.fromRGB(230, 60, 60):Lerp(Color3.fromRGB(70, 220, 90), ratio)
		refs.HealthText.Text = tostring(math.ceil(health))
		if health < lastHealth - 0.5 then
			refs.DamageStroke.Transparency = 0.35
			tween(refs.DamageStroke, 0.6, { Transparency = ratio < 0.35 and 0.75 or 1 })
		end
		lastHealth = health
	end

	-- Racha
	local streak = player:GetAttribute("Streak") or 0
	refs.StreakText.Text = "Racha x" .. streak
	refs.StreakFill.Size = UDim2.fromScale(1, math.clamp(streak / 10, 0, 1))

	-- Arma
	local def = ClientState.CurrentDef
	local tool = ClientState.CurrentTool
	if def and tool then
		refs.WeaponName.Text = def.DisplayName
		if def.Type == "Gun" then
			local reserve = tool:GetAttribute("Reserve") or 0
			local ammoColor = ClientState.Ammo <= math.ceil(def.MagSize * 0.25) and "#FF5050" or "#FFFFFF"
			refs.Ammo.Text = string.format(
				'<font color="%s">%d</font><font size="28" color="#C8C8C8"> | %d</font>',
				ammoColor,
				ClientState.Ammo,
				reserve
			)
			if ClientState.Reloading then
				refs.ReloadHint.Text = "RECARGANDO " .. math.floor(ClientState.ReloadProgress * 100) .. "%"
			elseif ClientState.Ammo == 0 and reserve == 0 then
				refs.ReloadHint.Text = "SIN MUNICIÓN"
			elseif ClientState.Ammo <= math.ceil(def.MagSize * 0.25) then
				refs.ReloadHint.Text = "[R] Recargar"
			else
				refs.ReloadHint.Text = ""
			end
		else
			refs.Ammo.Text = "∞"
			refs.ReloadHint.Text = ""
		end
	else
		refs.WeaponName.Text = ""
		refs.Ammo.Text = ""
		refs.ReloadHint.Text = ""
	end

	-- Ranuras
	local tools = WeaponController.GetTools()
	for slot, row in refs.Slots do
		local slotTool = tools[slot]
		local slotDef = slotTool and Weapons.Get(slotTool:GetAttribute("Weapon"))
		row.Name.Text = slotDef and slotDef.DisplayName or ""
		local active = slotTool ~= nil and slotTool == tool
		row.Name.TextColor3 = active and Color3.fromRGB(255, 210, 60) or Color3.fromRGB(220, 220, 220)
		row.Key.BackgroundColor3 = active and Color3.fromRGB(255, 170, 30) or Color3.fromRGB(20, 20, 25)
	end

	-- Mira
	local aim = ClientState.AimAlpha
	local isGun = def and def.Type == "Gun"
	local gap = 6 + ClientState.Spread * 6
	for _, line in refs.CrossLines do
		line.Frame.Position = UDim2.fromOffset(line.Dir.X * (gap + 4), line.Dir.Y * (gap + 4))
		line.Frame.Visible = isGun and aim < 0.5
	end
	refs.CrossDot.Visible = aim < 0.5
	refs.Crosshair.Visible = not ClientState.MenuOpen
	refs.Scope.Visible = def ~= nil and def.Scope == true and aim > 0.85
end

---------------------------------------------------------------------------

function HUD.Init()
	task.spawn(disableCoreGui)

	gui = UI.new("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	buildTopBar()
	buildCrosshair()
	buildWeaponPanel()
	buildPlayerPanel()
	buildFeedsAndOverlays()

	Remotes.Notify.OnClientEvent:Connect(onNotify)
	Remotes.KillFeed.OnClientEvent:Connect(onKillFeed)
	Remotes.HitConfirm.OnClientEvent:Connect(onHitConfirm)
	Remotes.RoundEnd.OnClientEvent:Connect(onRoundEnd)
	Remotes.Died.OnClientEvent:Connect(function(killerName, weaponName)
		local weapon = weaponName and Weapons.Get(weaponName)
		if killerName then
			refs.DeathText.Text = "ELIMINADO POR <b>"
				.. killerName
				.. "</b>"
				.. (weapon and (" · " .. weapon.DisplayName) or "")
		else
			refs.DeathText.Text = "HAS MUERTO"
		end
		refs.DeathScreen.Visible = true
	end)
	player.CharacterAdded:Connect(function()
		refs.DeathScreen.Visible = false
		lastHealth = 100
		refs.DamageStroke.Transparency = 1
	end)

	ClientState.DataChanged.Event:Connect(updateData)
	updateData(ClientState.Data)

	ReplicatedStorage.AttributeChanged:Connect(updateScoreboard)
	updateScoreboard()

	task.spawn(function()
		while true do
			updatePlayerRow()
			task.wait(1)
		end
	end)

	RunService.RenderStepped:Connect(render)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="27">
            <Properties>
              <string name="Name">Menu</string>
              <string name="Source"><![CDATA[-- Menú del pase de batalla, skins y elección de arma principal (tecla B).
local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Skins = require(Shared.Skins)
local Weapons = require(Shared.Weapons)
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local Menu = {}

local gui, panel, content, headerInfo
local tabButtons = {}
local currentTab = "Pase"

local GOLD = Color3.fromRGB(255, 190, 40)
local PANEL_BG = Color3.fromRGB(22, 24, 38)
local CARD_BG = Color3.fromRGB(38, 42, 64)

---------------------------------------------------------------------------
-- Tarjetas de recompensa
---------------------------------------------------------------------------

local function skinSwatch(skinId, parent, size)
	local skin = Skins.Get(skinId)
	local swatch = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = size or UDim2.fromOffset(80, 40),
		BackgroundColor3 = skin.Body,
		Parent = parent,
	}, { UI.corner(6), UI.stroke(Color3.new(0, 0, 0), 2, 0.3) })
	UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.45),
		Size = UDim2.new(1, 0, 0.22, 0),
		BackgroundColor3 = skin.Accent,
		BorderSizePixel = 0,
		Parent = swatch,
	})
	UI.new("Frame", {
		Position = UDim2.fromScale(0.15, 0.62),
		Size = UDim2.fromScale(0.18, 0.5),
		BackgroundColor3 = skin.Dark,
		BorderSizePixel = 0,
		Parent = swatch,
	})
	return swatch
end

local function rewardCard(reward, unlocked, premium, parent, order)
	local card = UI.new("Frame", {
		LayoutOrder = order,
		Size = UDim2.fromOffset(110, 110),
		BackgroundColor3 = CARD_BG,
		Parent = parent,
	}, { UI.corner(10), UI.stroke(premium and GOLD or Color3.fromRGB(90, 100, 140), 2, 0) })

	if not reward then
		UI.label({ Size = UDim2.fromScale(1, 1), Text = "—", TextSize = 30, TextTransparency = 0.5, Parent = card })
	elseif reward.Type == "Skin" then
		local skin = Skins.Get(reward.Id)
		skinSwatch(reward.Id, card)
		UI.label({
			Position = UDim2.fromOffset(0, 52),
			Size = UDim2.new(1, 0, 0, 22),
			Text = skin.Name,
			TextSize = 17,
			Parent = card,
		})
		UI.label({
			Position = UDim2.fromOffset(0, 74),
			Size = UDim2.new(1, 0, 0, 18),
			Text = skin.Rarity,
			TextSize = 14,
			TextColor3 = Skins.RarityColors[skin.Rarity] or Color3.new(1, 1, 1),
			Parent = card,
		})
	else
		UI.label({
			Position = UDim2.fromOffset(0, 18),
			Size = UDim2.new(1, 0, 0, 40),
			Text = "🪙",
			TextSize = 34,
			Parent = card,
		})
		UI.label({
			Position = UDim2.fromOffset(0, 62),
			Size = UDim2.new(1, 0, 0, 24),
			Text = tostring(reward.Amount),
			TextSize = 20,
			TextColor3 = GOLD,
			Parent = card,
		})
	end

	if reward then
		local status = UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -4, 0, 2),
			Size = UDim2.fromOffset(24, 24),
			Text = unlocked and "✔" or "🔒",
			TextSize = 18,
			TextColor3 = unlocked and Color3.fromRGB(90, 230, 110) or Color3.new(1, 1, 1),
			ZIndex = 3,
			Parent = card,
		})
		if not unlocked then
			UI.new("Frame", {
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Color3.new(0, 0, 0),
				BackgroundTransparency = 0.5,
				ZIndex = 2,
				Parent = card,
			}, { UI.corner(10) })
		end
		return card, status
	end
	return card
end

---------------------------------------------------------------------------
-- Páginas
---------------------------------------------------------------------------

local function buildPassPage(data)
	local page = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = content })

	-- Progreso
	local per = data.XPPerLevel or GameConfig.XPPerLevel
	UI.label({
		Size = UDim2.fromOffset(400, 26),
		Text = "Nivel " .. data.Level .. "  ·  " .. data.XP .. " / " .. per .. " XP",
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = page,
	})
	local bar = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.fromOffset(400, 12),
		BackgroundColor3 = Color3.fromRGB(10, 10, 15),
		Parent = page,
	}, { UI.corner(6) })
	UI.new("Frame", {
		Size = UDim2.fromScale(math.clamp(data.XP / per, 0, 1), 1),
		BackgroundColor3 = Color3.fromRGB(80, 170, 255),
		Parent = bar,
	}, { UI.corner(6) })

	-- Premium
	if data.Premium then
		UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 4),
			Size = UDim2.fromOffset(240, 34),
			Text = "👑 PREMIUM ACTIVO",
			TextSize = 22,
			TextColor3 = GOLD,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = page,
		})
	else
		local buy = UI.button({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 2),
			Size = UDim2.fromOffset(240, 40),
			Text = "👑 Obtener Premium",
			BackgroundColor3 = GOLD,
			TextColor3 = Color3.fromRGB(40, 25, 0),
			Parent = page,
		})
		buy.Activated:Connect(function()
			if GameConfig.PremiumPassId == 0 then
				buy.Text = "Configura PremiumPassId"
				return
			end
			MarketplaceService:PromptGamePassPurchase(player, GameConfig.PremiumPassId)
		end)
	end

	-- Filas de etiquetas
	UI.label({
		Position = UDim2.fromOffset(0, 92),
		Size = UDim2.fromOffset(70, 110),
		Text = "GRATIS",
		TextSize = 16,
		Parent = page,
	})
	UI.label({
		Position = UDim2.fromOffset(0, 210),
		Size = UDim2.fromOffset(70, 110),
		Text = "PREMIUM",
		TextSize = 16,
		TextColor3 = GOLD,
		Parent = page,
	})

	local scroll = UI.new("ScrollingFrame", {
		Position = UDim2.fromOffset(74, 56),
		Size = UDim2.new(1, -74, 1, -56),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		Parent = page,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	for tier, rewards in GameConfig.BattlePass do
		local reached = data.Level >= tier
		local column = UI.new("Frame", {
			LayoutOrder = tier,
			Size = UDim2.fromOffset(110, 270),
			BackgroundTransparency = 1,
			Parent = scroll,
		}, {
			UI.new("UIListLayout", {
				Padding = UDim.new(0, 8),
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		UI.label({
			LayoutOrder = 0,
			Size = UDim2.fromOffset(110, 26),
			Text = "NIVEL " .. tier,
			TextSize = 18,
			TextColor3 = reached and Color3.fromRGB(90, 230, 110) or Color3.fromRGB(180, 180, 190),
			Parent = column,
		})
		rewardCard(rewards.Free, reached, false, column, 1)
		rewardCard(rewards.Premium, reached and data.Premium, true, column, 2)
	end
end

local function buildSkinsPage(data)
	local scroll = UI.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		Parent = content,
	}, {
		UI.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(165, 150),
			CellPadding = UDim2.fromOffset(10, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local order = { "Común", "Raro", "Épico", "Legendario", "Mítico" }
	local ids = {}
	for id in Skins.List do
		table.insert(ids, id)
	end
	table.sort(ids, function(a, b)
		local ra = table.find(order, Skins.List[a].Rarity) or 0
		local rb = table.find(order, Skins.List[b].Rarity) or 0
		if ra == rb then
			return Skins.List[a].Name < Skins.List[b].Name
		end
		return ra < rb
	end)

	for i, id in ids do
		local skin = Skins.List[id]
		local owned = data.Skins[id] == true
		local equipped = data.EquippedSkin == id
		local card = UI.new("Frame", {
			LayoutOrder = i,
			BackgroundColor3 = CARD_BG,
			Parent = scroll,
		}, {
			UI.corner(10),
			UI.stroke(equipped and GOLD or (Skins.RarityColors[skin.Rarity] or Color3.new(1, 1, 1)), 2, equipped and 0 or 0.4),
		})
		skinSwatch(id, card, UDim2.fromOffset(120, 46))
		UI.label({
			Position = UDim2.fromOffset(0, 58),
			Size = UDim2.new(1, 0, 0, 22),
			Text = skin.Name,
			TextSize = 19,
			Parent = card,
		})
		UI.label({
			Position = UDim2.fromOffset(0, 80),
			Size = UDim2.new(1, 0, 0, 16),
			Text = skin.Rarity,
			TextSize = 14,
			TextColor3 = Skins.RarityColors[skin.Rarity] or Color3.new(1, 1, 1),
			Parent = card,
		})
		local button = UI.button({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.new(1, -20, 0, 30),
			TextSize = 16,
			Text = equipped and "Equipada" or (owned and "Equipar" or "🔒 Pase de batalla"),
			BackgroundColor3 = equipped and Color3.fromRGB(60, 160, 80)
				or (owned and Color3.fromRGB(40, 120, 255) or Color3.fromRGB(70, 70, 80)),
			AutoButtonColor = owned and not equipped,
			Parent = card,
		})
		if owned and not equipped then
			button.Activated:Connect(function()
				Sounds.Play("Click")
				Remotes.EquipSkin:FireServer(id)
			end)
		end
	end
end

local function buildWeaponsPage(data)
	local holder = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = content,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 14),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for i, weaponName in Weapons.Primaries do
		local def = Weapons.Get(weaponName)
		local selected = data.Primary == weaponName
		local card = UI.new("Frame", {
			LayoutOrder = i,
			Size = UDim2.fromOffset(220, 300),
			BackgroundColor3 = CARD_BG,
			Parent = holder,
		}, { UI.corner(12), UI.stroke(selected and GOLD or Color3.fromRGB(90, 100, 140), 2, 0) })
		UI.label({
			Position = UDim2.fromOffset(0, 12),
			Size = UDim2.new(1, 0, 0, 30),
			Text = def.DisplayName,
			TextSize = 26,
			Parent = card,
		})
		local stats = {
			{ "Daño", def.Pellets > 1 and (def.Damage .. " x" .. def.Pellets) or tostring(def.Damage) },
			{ "Cadencia", string.format("%.1f/s", def.FireRate) },
			{ "Cargador", tostring(def.MagSize) },
			{ "Recarga", string.format("%.1fs", def.ReloadTime) },
			{ "Alcance", tostring(def.Range) },
		}
		for j, stat in stats do
			UI.label({
				Position = UDim2.fromOffset(18, 52 + (j - 1) * 30),
				Size = UDim2.new(1, -36, 0, 26),
				Text = stat[1],
				TextSize = 18,
				TextColor3 = Color3.fromRGB(180, 185, 210),
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = card,
			})
			UI.label({
				Position = UDim2.fromOffset(18, 52 + (j - 1) * 30),
				Size = UDim2.new(1, -36, 0, 26),
				Text = stat[2],
				TextSize = 18,
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = card,
			})
		end
		local button = UI.button({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -14),
			Size = UDim2.new(1, -30, 0, 40),
			Text = selected and "Elegida" or "Elegir",
			BackgroundColor3 = selected and Color3.fromRGB(60, 160, 80) or Color3.fromRGB(40, 120, 255),
			Parent = card,
		})
		if not selected then
			button.Activated:Connect(function()
				Sounds.Play("Click")
				Remotes.SetPrimary:FireServer(weaponName)
			end)
		end
	end
	UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 20),
		Text = "Secundaria: " .. Weapons.Get(Weapons.Secondary).DisplayName .. "  ·  Cuerpo a cuerpo: " .. Weapons.Get(
			Weapons.Melee
		).DisplayName,
		TextSize = 15,
		TextColor3 = Color3.fromRGB(180, 185, 210),
		Parent = holder.Parent,
	})
end

---------------------------------------------------------------------------

local function refresh()
	if not content then
		return
	end
	for _, child in content:GetChildren() do
		child:Destroy()
	end
	local data = ClientState.Data
	if headerInfo then
		headerInfo.Text = data and ("Nivel " .. data.Level .. "   🪙 " .. data.Coins) or "Cargando..."
	end
	for name, button in tabButtons do
		button.BackgroundColor3 = name == currentTab and Color3.fromRGB(40, 120, 255) or CARD_BG
	end
	if not data then
		UI.label({ Size = UDim2.fromScale(1, 1), Text = "Cargando datos...", TextSize = 24, Parent = content })
		return
	end
	if currentTab == "Pase" then
		buildPassPage(data)
	elseif currentTab == "Skins" then
		buildSkinsPage(data)
	else
		buildWeaponsPage(data)
	end
end

local function setOpen(open)
	ClientState.MenuOpen = open
	panel.Visible = open
	UserInputService.MouseIconEnabled = open
	if open then
		refresh()
	end
end

function Menu.Toggle()
	setOpen(not panel.Visible)
end

function Menu.Init()
	gui = UI.new("ScreenGui", {
		Name = "Menu",
		ResetOnSpawn = false,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})

	-- Botón superior (útil en móvil)
	local open = UI.button({
		Position = UDim2.fromOffset(16, 16),
		Size = UDim2.fromOffset(210, 38),
		Text = "⭐ PASE DE BATALLA",
		BackgroundColor3 = Color3.fromRGB(255, 120, 30),
		TextSize = 18,
		Parent = gui,
	}, { UI.stroke(Color3.new(0, 0, 0), 2, 0.3) })
	open.Activated:Connect(Menu.Toggle)

	panel = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(800, 480),
		BackgroundColor3 = PANEL_BG,
		Visible = false,
		Parent = gui,
	}, { UI.corner(16), UI.stroke(Color3.fromRGB(255, 140, 40), 3, 0), UI.padding(16) })
	UI.new("UISizeConstraint", { MaxSize = Vector2.new(800, 480) }).Parent = panel

	-- Un botón "Modal" libera el ratón en primera persona mientras el menú está abierto
	UI.new("TextButton", {
		Size = UDim2.fromOffset(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		Modal = true,
		Parent = panel,
	})

	UI.label({
		Size = UDim2.fromOffset(400, 36),
		Text = "🎃 PASE DE BATALLA",
		TextSize = 32,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(255, 160, 50),
		Parent = panel,
	})
	headerInfo = UI.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -50, 0, 0),
		Size = UDim2.fromOffset(300, 36),
		Text = "",
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = panel,
	})
	local close = UI.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(36, 36),
		Text = "✕",
		BackgroundColor3 = Color3.fromRGB(220, 60, 60),
		Parent = panel,
	})
	close.Activated:Connect(function()
		setOpen(false)
	end)

	local tabs = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 1,
		Parent = panel,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for i, name in { "Pase", "Skins", "Armas" } do
		local button = UI.button({
			LayoutOrder = i,
			Size = UDim2.fromOffset(130, 36),
			Text = name,
			BackgroundColor3 = CARD_BG,
			Parent = tabs,
		})
		button.Activated:Connect(function()
			currentTab = name
			Sounds.Play("Click")
			refresh()
		end)
		tabButtons[name] = button
	end

	content = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 94),
		Size = UDim2.new(1, 0, 1, -94),
		BackgroundTransparency = 1,
		Parent = panel,
	})

	ContextActionService:BindAction("Menu", function(_, state)
		if state == Enum.UserInputState.Begin then
			Menu.Toggle()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.B, Enum.KeyCode.ButtonSelect)

	ClientState.DataChanged.Event:Connect(function()
		if panel.Visible then
			refresh()
		end
	end)
end

return Menu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="28">
            <Properties>
              <string name="Name">Movement</string>
              <string name="Source"><![CDATA[-- Movimiento: correr (Shift) y deslizarse (C).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Sounds = require(Shared.Sounds)

local ClientState = require(script.Parent.ClientState)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Movement = {}

local humanoid, rootPart
local sprintHeld = false
local lastSlide = -10
local stopSlide

local function tweenCameraOffset(offset, time)
	if humanoid then
		TweenService:Create(humanoid, TweenInfo.new(time, Enum.EasingStyle.Quad), { CameraOffset = offset }):Play()
	end
end

local function slide()
	if ClientState.Sliding or ClientState.MenuOpen or not humanoid or humanoid.Health <= 0 or not rootPart then
		return
	end
	if os.clock() - lastSlide < GameConfig.SlideCooldown or humanoid.FloorMaterial == Enum.Material.Air then
		return
	end
	local direction = humanoid.MoveDirection
	if direction.Magnitude < 0.1 then
		direction = camera.CFrame.LookVector
	end
	direction = Vector3.new(direction.X, 0, direction.Z)
	if direction.Magnitude < 0.01 then
		return
	end
	direction = direction.Unit

	lastSlide = os.clock()
	ClientState.Sliding = true
	Sounds.Play("Slide")

	local attachment = Instance.new("Attachment")
	attachment.Name = "SlideAttachment"
	attachment.Parent = rootPart
	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	-- Modo plano: solo empuja en X/Z, la gravedad sigue actuando
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	velocity.PrimaryTangentAxis = Vector3.xAxis
	velocity.SecondaryTangentAxis = Vector3.zAxis
	velocity.MaxForce = 80000
	velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z) * GameConfig.SlideSpeed
	velocity.Parent = rootPart

	tweenCameraOffset(Vector3.new(0, -1.8, 0), 0.12)

	local start = os.clock()
	local connection
	local stopped = false
	stopSlide = function()
		if stopped then
			return
		end
		stopped = true
		connection:Disconnect()
		velocity:Destroy()
		attachment:Destroy()
		ClientState.Sliding = false
		tweenCameraOffset(Vector3.zero, 0.2)
	end
	connection = RunService.Heartbeat:Connect(function()
		local alpha = (os.clock() - start) / GameConfig.SlideDuration
		local state = humanoid:GetState()
		if alpha >= 1 or humanoid.Health <= 0 or humanoid.Jump or state == Enum.HumanoidStateType.Jumping then
			stopSlide()
			return
		end
		local speed = GameConfig.SlideSpeed + (GameConfig.WalkSpeed - GameConfig.SlideSpeed) * alpha * alpha
		velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z) * speed
	end)
end

local function update()
	if not humanoid or humanoid.Health <= 0 then
		ClientState.Sprinting = false
		return
	end
	local moving = humanoid.MoveDirection.Magnitude > 0.1
	local recentlyShot = os.clock() - ClientState.LastShotTime < 0.35
	ClientState.Sprinting = sprintHeld
		and moving
		and not ClientState.Aiming
		and not recentlyShot
		and not ClientState.Sliding
		and not ClientState.MenuOpen

	if ClientState.Sprinting then
		humanoid.WalkSpeed = GameConfig.SprintSpeed
	elseif ClientState.Aiming then
		humanoid.WalkSpeed = GameConfig.AimWalkSpeed
	else
		humanoid.WalkSpeed = GameConfig.WalkSpeed
	end
end

local function onCharacter(newCharacter)
	if stopSlide then
		stopSlide()
		stopSlide = nil
	end
	ClientState.Sliding = false
	humanoid = newCharacter:WaitForChild("Humanoid")
	rootPart = newCharacter:WaitForChild("HumanoidRootPart")
	humanoid.CameraOffset = Vector3.zero
end

function Movement.Init()
	ContextActionService:BindAction("Sprint", function(_, state, input)
		if input.UserInputType == Enum.UserInputType.Touch then
			if state == Enum.UserInputState.Begin then
				sprintHeld = not sprintHeld
			end
		elseif state == Enum.UserInputState.Begin then
			sprintHeld = true
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			sprintHeld = false
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
	ContextActionService:SetTitle("Sprint", "Correr")
	ContextActionService:SetPosition("Sprint", UDim2.new(1, -260, 1, -160))

	ContextActionService:BindAction("Slide", function(_, state)
		if state == Enum.UserInputState.Begin then
			slide()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.C, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonR3)
	ContextActionService:SetTitle("Slide", "Deslizar")
	ContextActionService:SetPosition("Slide", UDim2.new(1, -270, 1, -240))

	-- Si la ventana pierde el foco dejamos de correr
	UserInputService.WindowFocusReleased:Connect(function()
		sprintHeld = false
	end)

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	RunService.Heartbeat:Connect(update)
end

return Movement
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="29">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[-- Pequeña utilidad para crear interfaces desde código.
local UI = {}

UI.Font = Enum.Font.FredokaOne
UI.FontBody = Enum.Font.GothamBold

function UI.new(className, props, children)
	local inst = Instance.new(className)
	local parent
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			inst[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.corner(radius)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

function UI.stroke(color, thickness, transparency)
	return UI.new("UIStroke", {
		Color = color or Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.padding(px)
	return UI.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
	})
end

-- Texto con borde negro estilo "cartoon"
function UI.label(props, children)
	local defaults = {
		BackgroundTransparency = 1,
		Font = UI.Font,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0.4,
		TextSize = 18,
	}
	for key, value in props or {} do
		defaults[key] = value
	end
	return UI.new("TextLabel", defaults, children)
end

function UI.button(props, children)
	local defaults = {
		Font = UI.Font,
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 18,
		AutoButtonColor = true,
		BackgroundColor3 = Color3.fromRGB(40, 120, 255),
	}
	for key, value in props or {} do
		defaults[key] = value
	end
	local button = UI.new("TextButton", defaults, children)
	UI.corner(8).Parent = button
	return button
end

function UI.formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d", seconds // 60, seconds % 60)
end

function UI.hex(color)
	return "#" .. color:ToHex()
end

return UI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="30">
            <Properties>
              <string name="Name">WeaponController</string>
              <string name="Source"><![CDATA[-- Control de armas en primera persona: viewmodel, disparo, recarga, apuntado, cuchillo y cambio de arma.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weapons = require(Shared.Weapons)
local WeaponModels = require(Shared.WeaponModels)
local Skins = require(Shared.Skins)
local Sounds = require(Shared.Sounds)
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)
local Effects = require(script.Parent.Effects)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local WeaponController = {}

-- Hombros del viewmodel (espacio de cámara, fuera de pantalla)
local RIGHT_SHOULDER = Vector3.new(1.1, -1.5, 0.4)
local LEFT_SHOULDER = Vector3.new(-0.7, -1.5, 0.2)

local character, humanoid, rootPart
local equippedTool, def
local viewmodel
local attrConnection

local triggerHeld = false
local aimHeld = false
local lastShot = 0
local localAmmo = 0
local reloadStart = nil
local equipTime = 0
local meleeTime = -10
local meleeWithKnife = false

local recoilKick, recoilRot = 0, 0
local camKick, camYaw = 0, 0
local swayX, swayY = 0, 0
local bobTime = 0
local aimAlpha, sprintAlpha = 0, 0
local viewmodelHidden = false

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function lerp(a, b, t)
	return a + (b - a) * t
end

local function updateRayFilter()
	local ignore = { camera }
	if character then
		table.insert(ignore, character)
	end
	local fx = workspace:FindFirstChild("ClientFX")
	if fx then
		table.insert(ignore, fx)
	end
	rayParams.FilterDescendantsInstances = ignore
end

---------------------------------------------------------------------------
-- Viewmodel
---------------------------------------------------------------------------

local function skinTone()
	local hand = character and (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm"))
	return hand and hand.Color or Color3.fromRGB(255, 204, 153)
end

local function addArm(model, handPos, shoulderCam, weaponDef)
	local shoulder = weaponDef.ViewOffset:PointToObjectSpace(shoulderCam)
	local length = (shoulder - handPos).Magnitude
	local sleeveColor = player.Team and player.TeamColor.Color or Color3.fromRGB(60, 60, 70)

	local arm = Instance.new("Part")
	arm.Name = "Arm"
	arm.Size = Vector3.new(0.4, 0.4, length)
	arm.CFrame = CFrame.lookAt((handPos + shoulder) / 2, handPos)
	arm.Color = skinTone()
	arm.Material = Enum.Material.SmoothPlastic
	arm.Parent = model

	local sleeve = Instance.new("Part")
	sleeve.Name = "Sleeve"
	sleeve.Size = Vector3.new(0.46, 0.46, length * 0.55)
	sleeve.CFrame = CFrame.lookAt(shoulder:Lerp(handPos, 0.27), handPos)
	sleeve.Color = sleeveColor
	sleeve.Material = Enum.Material.Fabric
	sleeve.Parent = model

	local glove = Instance.new("Part")
	glove.Name = "Glove"
	glove.Size = Vector3.new(0.48, 0.48, 0.55)
	glove.CFrame = CFrame.lookAt(handPos + (shoulder - handPos).Unit * 0.15, handPos)
	glove.Color = Color3.fromRGB(25, 25, 28)
	glove.Material = Enum.Material.Fabric
	glove.Parent = model
end

local function destroyViewmodel()
	if viewmodel then
		viewmodel:Destroy()
		viewmodel = nil
	end
	viewmodelHidden = false
end

local function createViewmodel(tool)
	destroyViewmodel()
	local weaponName = tool:GetAttribute("Weapon")
	local weaponDef = Weapons.Get(weaponName)
	local model = WeaponModels.Build(weaponName, tool:GetAttribute("Skin"))
	if weaponDef.RightHand then
		addArm(model, weaponDef.RightHand, RIGHT_SHOULDER, weaponDef)
	end
	if weaponDef.LeftHand then
		addArm(model, weaponDef.LeftHand, LEFT_SHOULDER, weaponDef)
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.CastShadow = false
		end
	end
	model.Name = "Viewmodel"
	model.Parent = camera
	viewmodel = model
end

local function setViewmodelHidden(hidden)
	if not viewmodel or viewmodelHidden == hidden then
		return
	end
	viewmodelHidden = hidden
	for _, part in viewmodel:GetDescendants() do
		if part:IsA("BasePart") then
			part.LocalTransparencyModifier = hidden and 1 or 0
		end
	end
end

---------------------------------------------------------------------------
-- Equipar
---------------------------------------------------------------------------

local function onUnequipped()
	if attrConnection then
		attrConnection:Disconnect()
		attrConnection = nil
	end
	destroyViewmodel()
	equippedTool, def = nil, nil
	triggerHeld = false
	reloadStart = nil
	ClientState.CurrentTool = nil
	ClientState.CurrentDef = nil
	ClientState.Reloading = false
	ClientState.WeaponChanged:Fire()
end

local function onEquipped(tool)
	if equippedTool then
		onUnequipped()
	end
	local weaponDef = Weapons.Get(tool:GetAttribute("Weapon"))
	if not weaponDef then
		return
	end
	equippedTool, def = tool, weaponDef
	equipTime = os.clock()
	reloadStart = nil
	localAmmo = tool:GetAttribute("Ammo") or 0

	-- Ocultamos el Tool real en nuestra pantalla (los demás sí lo ven)
	for _, part in tool:GetDescendants() do
		if part:IsA("BasePart") then
			part.LocalTransparencyModifier = 1
		end
	end
	createViewmodel(tool)

	attrConnection = tool.AttributeChanged:Connect(function(attribute)
		if attribute == "Ammo" then
			local serverAmmo = tool:GetAttribute("Ammo") or 0
			-- Subida = recarga; bajada = confirmación de disparos que ya predijimos
			if serverAmmo > localAmmo then
				localAmmo = serverAmmo
			else
				localAmmo = math.min(localAmmo, serverAmmo)
			end
		elseif attribute == "Skin" then
			createViewmodel(tool)
			for _, part in tool:GetDescendants() do
				if part:IsA("BasePart") then
					part.LocalTransparencyModifier = 1
				end
			end
		elseif attribute == "Reloading" and not tool:GetAttribute("Reloading") then
			reloadStart = nil
		end
	end)

	ClientState.CurrentTool = tool
	ClientState.CurrentDef = weaponDef
	ClientState.WeaponChanged:Fire()
end

local function getTools()
	local list = {}
	local containers = { player:FindFirstChildOfClass("Backpack"), character }
	for _, container in containers do
		if container then
			for _, tool in container:GetChildren() do
				if tool:IsA("Tool") and tool:GetAttribute("Slot") then
					list[tool:GetAttribute("Slot")] = tool
				end
			end
		end
	end
	return list
end
WeaponController.GetTools = getTools

local function equipSlot(slot)
	if not humanoid or humanoid.Health <= 0 or ClientState.MenuOpen then
		return
	end
	local tool = getTools()[slot]
	if tool and tool ~= equippedTool then
		humanoid:EquipTool(tool)
	end
end

local function cycleSlot(direction)
	local current = equippedTool and equippedTool:GetAttribute("Slot") or 1
	local tools = getTools()
	for i = 1, 3 do
		local slot = (current - 1 + direction * i) % 3 + 1
		if tools[slot] then
			equipSlot(slot)
			return
		end
	end
end

---------------------------------------------------------------------------
-- Disparo
---------------------------------------------------------------------------

local function randomInCone(direction, degrees)
	if degrees <= 0 then
		return direction
	end
	local angle = math.rad(degrees) * math.sqrt(math.random())
	local spin = math.random() * math.pi * 2
	return (CFrame.lookAt(Vector3.zero, direction) * CFrame.Angles(0, 0, spin) * CFrame.Angles(angle, 0, 0)).LookVector
end

local function currentSpread()
	if not def or def.Type ~= "Gun" then
		return 0
	end
	local spread = lerp(def.Spread, def.AimSpread, aimAlpha)
	if rootPart then
		local velocity = rootPart.AssemblyLinearVelocity
		if Vector3.new(velocity.X, 0, velocity.Z).Magnitude > 2 then
			spread *= 1.5
		end
	end
	if humanoid and humanoid.FloorMaterial == Enum.Material.Air then
		spread *= 2
	end
	return spread + ClientState.Bloom * (1 - aimAlpha * 0.7)
end

local function requestReload()
	if not equippedTool or not def or def.Type ~= "Gun" or reloadStart then
		return
	end
	local reserve = equippedTool:GetAttribute("Reserve") or 0
	if localAmmo >= def.MagSize or reserve <= 0 then
		return
	end
	reloadStart = os.clock()
	Remotes.Reload:FireServer(equippedTool)
	Sounds.Play("Reload")
end

local function fire()
	local now = os.clock()
	if not equippedTool or not def or def.Type ~= "Gun" or ClientState.MenuOpen then
		return
	end
	if now - lastShot < 1 / def.FireRate or reloadStart or now - equipTime < 0.25 then
		return
	end
	if localAmmo <= 0 then
		lastShot = now
		Sounds.Play("Empty")
		requestReload()
		return
	end

	lastShot = now
	localAmmo -= 1
	ClientState.LastShotTime = now
	ClientState.Sprinting = false

	updateRayFilter()
	local origin = camera.CFrame.Position
	local look = camera.CFrame.LookVector
	local muzzle = viewmodel and viewmodel.PrimaryPart and viewmodel.PrimaryPart:FindFirstChild("Muzzle")
	local muzzlePos = muzzle and muzzle.WorldPosition or origin
	local tracerColor = Skins.Get(equippedTool:GetAttribute("Skin")).Accent
	local spread = currentSpread()

	local rays = {}
	for _ = 1, def.Pellets do
		local direction = randomInCone(look, spread)
		local result = workspace:Raycast(origin, direction * def.Range, rayParams)
		local hitPosition = result and result.Position or origin + direction * def.Range
		table.insert(rays, { Part = result and result.Instance or nil, Position = hitPosition })
		Effects.Tracer(muzzlePos, hitPosition, tracerColor)
		if result then
			Effects.Impact(result.Position, result.Normal, result.Instance)
		end
	end
	Remotes.Fire:FireServer(equippedTool, origin, rays)

	Effects.MuzzleFlash(muzzle)
	Sounds.Play((def.Pellets > 1 or def.Damage >= 80) and "ShotHeavy" or "Shot")

	-- Retroceso
	local recoil = math.rad(def.Recoil)
	recoilKick += 0.08 + def.Recoil * 0.03
	recoilRot += recoil * 0.6
	camKick += recoil * (1 - aimAlpha * 0.35)
	camYaw += (math.random() - 0.5) * recoil * 0.5
	ClientState.Bloom = math.min(ClientState.Bloom + def.Recoil * 0.4, 6)
	ClientState.ShotFired:Fire()

	if localAmmo <= 0 then
		task.delay(0.2, requestReload)
	end
end

local function melee()
	local knife = Weapons.Get(Weapons.Melee)
	local now = os.clock()
	if now - meleeTime < knife.Cooldown or ClientState.MenuOpen or not humanoid or humanoid.Health <= 0 then
		return
	end
	if not getTools()[knife.Slot] then
		return
	end
	meleeTime = now
	meleeWithKnife = def ~= nil and def.Type == "Melee"
	reloadStart = nil
	Sounds.Play("Swing")

	updateRayFilter()
	local origin = camera.CFrame.Position
	local direction = camera.CFrame.LookVector * knife.Range
	local result = workspace:Spherecast(origin, 1.2, direction, rayParams) or workspace:Raycast(origin, direction, rayParams)
	if result and result.Instance then
		Remotes.Melee:FireServer(result.Instance)
	end
end

---------------------------------------------------------------------------
-- Animación procedural del viewmodel (cada frame)
---------------------------------------------------------------------------

local function renderStep(dt)
	if not character or not humanoid then
		return
	end

	-- Disparo automático
	if triggerHeld and def and def.Type == "Gun" and def.Automatic then
		fire()
	end

	ClientState.Bloom = math.max(0, ClientState.Bloom - dt * 8)
	ClientState.Spread = currentSpread()

	-- Recarga: tiempo límite por si el servidor la rechazó
	if reloadStart and def and os.clock() - reloadStart > def.ReloadTime + 1 then
		reloadStart = nil
	end
	ClientState.Reloading = reloadStart ~= nil
	ClientState.ReloadProgress = (reloadStart and def) and math.clamp((os.clock() - reloadStart) / def.ReloadTime, 0, 1)
		or 0
	ClientState.Ammo = localAmmo

	-- Apuntar
	local canAim = def ~= nil and def.Type == "Gun" and aimHeld and not reloadStart and not ClientState.MenuOpen
	ClientState.Aiming = canAim
	aimAlpha = lerp(aimAlpha, canAim and 1 or 0, math.min(1, dt * 14))
	if aimAlpha < 0.001 then
		aimAlpha = 0
	end
	ClientState.AimAlpha = aimAlpha
	sprintAlpha = lerp(sprintAlpha, (ClientState.Sprinting and not reloadStart) and 1 or 0, math.min(1, dt * 10))

	-- Retroceso de cámara
	local applyPitch = camKick * math.min(1, dt * 22)
	local applyYaw = camYaw * math.min(1, dt * 22)
	camKick -= applyPitch
	camYaw -= applyYaw
	if applyPitch ~= 0 or applyYaw ~= 0 then
		camera.CFrame = camera.CFrame * CFrame.Angles(applyPitch, applyYaw, 0)
	end

	-- Campo de visión
	local targetFov = GameConfig.FieldOfView
	if def and def.AimFOV then
		targetFov = lerp(GameConfig.FieldOfView, def.AimFOV, aimAlpha)
	end
	camera.FieldOfView = targetFov + sprintAlpha * 6

	if not viewmodel or not def then
		return
	end

	local now = os.clock()

	-- Balanceo al caminar
	local speed = 0
	if rootPart then
		local velocity = rootPart.AssemblyLinearVelocity
		speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	end
	local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
	if grounded and not ClientState.Sliding then
		bobTime += dt * math.min(speed, 30) * 0.45
	end
	local bobAmount = math.clamp(speed / 18, 0, 1.5) * (1 - aimAlpha * 0.9)
	if not grounded or ClientState.Sliding then
		bobAmount = 0
	end
	local bob = CFrame.new(math.cos(bobTime) * 0.05 * bobAmount, -math.abs(math.sin(bobTime)) * 0.06 * bobAmount, 0)

	-- Inercia al mover el ratón
	local delta = UserInputService:GetMouseDelta()
	swayX = lerp(swayX, math.clamp(-delta.X * 0.004, -0.12, 0.12), math.min(1, dt * 10))
	swayY = lerp(swayY, math.clamp(-delta.Y * 0.004, -0.12, 0.12), math.min(1, dt * 10))
	local swayScale = 1 - aimAlpha * 0.75
	local sway = CFrame.Angles(swayY * swayScale, swayX * swayScale, swayX * 0.6 * swayScale)

	-- Retroceso del arma
	recoilKick = lerp(recoilKick, 0, math.min(1, dt * 16))
	recoilRot = lerp(recoilRot, 0, math.min(1, dt * 14))
	local recoilCF = CFrame.new(0, 0, recoilKick) * CFrame.Angles(recoilRot, 0, 0)

	-- Cadera -> mira
	local base = def.ViewOffset
	if def.AimPoint then
		local a = def.AimPoint
		local aimCF = CFrame.new(-a.X, -a.Y, -def.AimDistance - a.Z)
		base = def.ViewOffset:Lerp(aimCF, aimAlpha)
	end

	-- Correr
	local s = sprintAlpha
	local sprintCF = CFrame.new(-0.25 * s, -0.2 * s, 0.1 * s) * CFrame.Angles(math.rad(-12) * s, math.rad(35) * s, math.rad(18) * s)

	-- Recarga
	local reloadCF = CFrame.new()
	if reloadStart then
		local r = math.sin(ClientState.ReloadProgress * math.pi)
		reloadCF = CFrame.new(0, -0.35 * r, 0) * CFrame.Angles(math.rad(-20) * r, 0, math.rad(35) * r)
	end

	-- Sacar arma
	local e = 1 - math.clamp((now - equipTime) / 0.3, 0, 1)
	local equipCF = CFrame.new(0, -0.8 * e * e, 0) * CFrame.Angles(math.rad(-40) * e, 0, 0)

	-- Cuchillazo / golpe rápido
	local meleeCF = CFrame.new()
	local m = (now - meleeTime) / 0.35
	if m < 1 then
		local k = math.sin(m * math.pi)
		if meleeWithKnife then
			meleeCF = CFrame.new(-0.6 * k, 0.2 * k, -0.6 * k)
				* CFrame.Angles(math.rad(-20) * k, math.rad(70) * k, math.rad(-30) * k)
		else
			meleeCF = CFrame.new(-0.3 * k, 0, -0.5 * k) * CFrame.Angles(0, math.rad(30) * k, math.rad(20) * k)
		end
	end

	viewmodel:PivotTo(camera.CFrame * bob * sway * base * sprintCF * reloadCF * equipCF * meleeCF * recoilCF)

	-- Mira telescópica: ocultar el arma
	setViewmodelHidden(def.Scope == true and aimAlpha > 0.85)
end

---------------------------------------------------------------------------
-- Entrada
---------------------------------------------------------------------------

local function bindActions()
	ContextActionService:BindAction("Fire", function(_, state)
		if ClientState.MenuOpen then
			triggerHeld = false
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin then
			triggerHeld = true
			if def and def.Type == "Melee" then
				melee()
			else
				fire()
			end
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			triggerHeld = false
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)
	ContextActionService:SetTitle("Fire", "Disparar")
	ContextActionService:SetPosition("Fire", UDim2.new(1, -110, 1, -160))

	ContextActionService:BindAction("Aim", function(_, state, input)
		if ClientState.MenuOpen then
			aimHeld = false
			return Enum.ContextActionResult.Pass
		end
		if input.UserInputType == Enum.UserInputType.Touch then
			if state == Enum.UserInputState.Begin then
				aimHeld = not aimHeld -- en móvil es un interruptor
			end
		elseif state == Enum.UserInputState.Begin then
			aimHeld = true
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			aimHeld = false
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL2)
	ContextActionService:SetTitle("Aim", "Apuntar")
	ContextActionService:SetPosition("Aim", UDim2.new(1, -190, 1, -110))

	ContextActionService:BindAction("Reload", function(_, state)
		if state == Enum.UserInputState.Begin and not ClientState.MenuOpen then
			requestReload()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.R, Enum.KeyCode.ButtonX)
	ContextActionService:SetTitle("Reload", "R")
	ContextActionService:SetPosition("Reload", UDim2.new(1, -200, 1, -190))

	ContextActionService:BindAction("Melee", function(_, state)
		if state == Enum.UserInputState.Begin and not ClientState.MenuOpen then
			melee()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.F, Enum.KeyCode.ButtonB)
	ContextActionService:SetTitle("Melee", "F")
	ContextActionService:SetPosition("Melee", UDim2.new(1, -120, 1, -240))

	ContextActionService:BindAction("Slots", function(_, state, input)
		if state ~= Enum.UserInputState.Begin then
			return Enum.ContextActionResult.Pass
		end
		if input.KeyCode == Enum.KeyCode.One then
			equipSlot(1)
		elseif input.KeyCode == Enum.KeyCode.Two then
			equipSlot(2)
		elseif input.KeyCode == Enum.KeyCode.Three then
			equipSlot(3)
		elseif input.KeyCode == Enum.KeyCode.ButtonY then
			cycleSlot(1)
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.ButtonY)

	UserInputService.InputChanged:Connect(function(input, processed)
		if processed or ClientState.MenuOpen then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			cycleSlot(input.Position.Z > 0 and -1 or 1)
		end
	end)
end

---------------------------------------------------------------------------
-- Personaje
---------------------------------------------------------------------------

local function onCharacter(newCharacter)
	onUnequipped()
	character = newCharacter
	humanoid = newCharacter:WaitForChild("Humanoid")
	rootPart = newCharacter:WaitForChild("HumanoidRootPart")
	aimHeld = false
	camKick, camYaw = 0, 0
	updateRayFilter()

	newCharacter.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and child:GetAttribute("Weapon") then
			onEquipped(child)
		end
	end)
	newCharacter.ChildRemoved:Connect(function(child)
		if child == equippedTool then
			onUnequipped()
		end
	end)
	local existing = newCharacter:FindFirstChildOfClass("Tool")
	if existing and existing:GetAttribute("Weapon") then
		onEquipped(existing)
	end

	humanoid.Died:Connect(function()
		onUnequipped()
		triggerHeld = false
	end)
end

-- Efectos de los disparos de otros jugadores
local function onShotFX(tool, endpoints)
	if typeof(tool) ~= "Instance" or not tool.Parent or type(endpoints) ~= "table" then
		return
	end
	local handle = tool:FindFirstChild("Handle")
	local muzzle = handle and handle:FindFirstChild("Muzzle")
	if not muzzle then
		return
	end
	local color = Skins.Get(tool:GetAttribute("Skin")).Accent
	for _, position in endpoints do
		if typeof(position) == "Vector3" then
			Effects.Tracer(muzzle.WorldPosition, position, color)
		end
	end
	Effects.MuzzleFlash(muzzle)
	local weaponDef = Weapons.Get(tool:GetAttribute("Weapon"))
	local heavy = weaponDef and (weaponDef.Pellets > 1 or weaponDef.Damage >= 80)
	Sounds.Play(heavy and "ShotHeavy" or "Shot", handle)
end

function WeaponController.Init()
	UserInputService.MouseIconEnabled = false
	bindActions()
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	Remotes.ShotFX.OnClientEvent:Connect(onShotFX)
	RunService:BindToRenderStep("WeaponViewmodel", Enum.RenderPriority.Camera.Value + 1, renderStep)
end

return WeaponController
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Teams" referent="31">
    <Properties>
      <string name="Name">Teams</string>
    </Properties>
  </Item>
</roblox>