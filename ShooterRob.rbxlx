end

-- Baja normal en un mapa realista: sin estallido de colores, solo el polvo que levanta el cuerpo al
-- caer (y, con GameConfig.RealisticBlood, una nube rojo oscuro que se desvanece). El cuerpo cae como
-- un muñeco de trapo (ver Ragdoll)
function Effects.DeathPuff(position)
	local anchor = emitterAnchor(position - Vector3.new(0, 1.5, 0), Vector3.yAxis, 2)
	emit(anchor, {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(Color3.fromRGB(150, 140, 125)),
		LightInfluence = 1,
		Size = seq(0.8, 3.2),
		Transparency = seq(0.45, 1),
		Lifetime = NumberRange.new(0.7, 1.1),
		Speed = NumberRange.new(3, 6),
		SpreadAngle = Vector2.new(80, 15),
		Drag = 3,
		Acceleration = Vector3.new(0, 1, 0),
	}, 7)
	if not GameConfig.RealisticBlood then
		return
	end
	local mist = emitterAnchor(position, Vector3.yAxis, 1)
	emit(mist, {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(Color3.fromRGB(110, 10, 12)),
		LightInfluence = 0.8,
		Size = seq(0.5, 1.8),
		Transparency = seq(0.35, 1),
		Lifetime = NumberRange.new(0.3, 0.5),
		Speed = NumberRange.new(2, 4),
		SpreadAngle = Vector2.new(60, 60),
		Drag = 5,
	}, 3)
end

-- Premium: cortos (menos de 1,5 s) y sin tapar la pantalla
KILL_FX.Pixel = function(position)
	debrisBurst(position, 18, function()
		return fxPart({
			Size = Vector3.one * (0.35 + math.random() * 0.25),
			Color = CONFETTI_COLORS[math.random(1, #CONFETTI_COLORS)],
			Material = Enum.Material.Neon,
		})
	end, 14, 1.2)
	flashBall(position, Color3.fromRGB(200, 120, 255), 5, 0.25)
end

KILL_FX.OroFlash = function(position)
	flashBall(position, Color3.fromRGB(255, 210, 80), 8, 0.35)
	local anchor = emitterAnchor(position, Vector3.yAxis, 1.6)
	emit(anchor, {
		Texture = TEX.Sparkle,
		Color = ColorSequence.new(Color3.fromRGB(255, 240, 170), Color3.fromRGB(255, 180, 40)),
		LightEmission = 1,
		Size = seq(0.7, 0),
		Lifetime = NumberRange.new(0.5, 1),
		Speed = NumberRange.new(5, 11),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 3,
	}, 26)
end

KILL_FX.ChoqueRojo = function(position)
	-- Anillo rojo que se abre a ras de suelo y un destello
	local ring = fxPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 1, 1),
		Color = Color3.fromRGB(255, 40, 50),
		Material = Enum.Material.Neon,
		Transparency = 0.1,
		CFrame = CFrame.new(position - Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90)),
	})
	TweenService:Create(ring, TweenInfo.new(0.45, Enum.EasingStyle.Quad), { Size = Vector3.new(0.2, 11, 11), Transparency = 1 }):Play()
	Debris:AddItem(ring, 0.5)
	flashBall(position, Color3.fromRGB(255, 60, 60), 5, 0.3)
end

function Effects.KillEffect(effectId, position, color)
	local fn = KILL_FX[effectId]
	if fn then
		fn(position)
	elseif realisticMap() then
		-- (los efectos comprados se ven igual; el normal, realista)
		Effects.DeathPuff(position)
	else
		Effects.DeathBurst(position, color)
	end
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="154">
            <Properties>
              <string name="Name">Emotes</string>
              <string name="Source"><![CDATA[-- Emotes (tecla N): menú con los bailes y gestos que trae Roblox (script Animate). Mientras dura el
-- emote la cámara pasa a tercera persona para verte; vuelve a primera persona al moverte o al acabar.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Sounds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Sounds"))

local TouchLayout = require(script.Parent.TouchLayout)
local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local Emotes = {}

local EMOTES = {
	{ Id = "wave", Name = "Saludar", Icon = "👋" },
	{ Id = "dance", Name = "Baile 1", Icon = "🕺" },
	{ Id = "dance2", Name = "Baile 2", Icon = "💃" },
	{ Id = "dance3", Name = "Baile 3", Icon = "🎶" },
	{ Id = "cheer", Name = "Celebrar", Icon = "🙌" },
	{ Id = "laugh", Name = "Reír", Icon = "😂" },
	{ Id = "point", Name = "Señalar", Icon = "👉" },
}
local EMOTE_TIME = 4

local gui, wheel
local emoteUntil = 0
local zoom = { 0.5, 400 }

local function setThirdPerson(on)
	if on then
		-- Solo se guarda el zoom de primera persona (no el de un emote anterior)
		if not ClientState.Emoting then
			zoom = { player.CameraMinZoomDistance, player.CameraMaxZoomDistance }
		end
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMinZoomDistance = 9
		player.CameraMaxZoomDistance = 12
	else
		player.CameraMinZoomDistance = zoom[1]
		player.CameraMaxZoomDistance = zoom[2]
		player.CameraMode = Enum.CameraMode.LockFirstPerson
	end
end

local function stopEmote()
	if not ClientState.Emoting then
		return
	end
	ClientState.Emoting = false
	emoteUntil = 0
	if not ClientState.Dead then
		setThirdPerson(false)
	end
end

local function play(id)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local animate = character and character:FindFirstChild("Animate")
	local playEmote = animate and animate:FindFirstChild("PlayEmote")
	if not humanoid or humanoid.Health <= 0 or not playEmote or not playEmote:IsA("BindableFunction") then
		return
	end
	local ok, played = pcall(function()
		return playEmote:Invoke(id)
	end)
	-- PlayEmote devuelve true solo si de verdad empieza (nil si estás saltando, sentado, etc.)
	if ok and played == true then
		setThirdPerson(true)
		ClientState.Emoting = true
		emoteUntil = os.clock() + EMOTE_TIME
	end
end

local function setWheel(open)
	wheel.Visible = open
	ClientState.EmoteMenuOpen = open
	ClientState.UpdateMouse()
end

-- Otros motivos para cerrar el menú (no cuenta el propio menú de emotes)
local function otherBlock()
	return ClientState.MenuOpen or ClientState.VoteOpen or ClientState.InMainMenu or ClientState.Dead
end

local function build()
	gui = UI.new("ScreenGui", {
		Name = "Emotes",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 2,
		Parent = player:WaitForChild("PlayerGui"),
	})
	wheel = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(360, 360),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	-- Libera el ratón mientras el menú está abierto
	UI.new("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true, Parent = wheel })
	UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(120, 40),
		Text = "EMOTES",
		TextSize = 24,
		Parent = wheel,
	})
	for i, emote in EMOTES do
		local angle = (i - 1) / #EMOTES * math.pi * 2 - math.pi / 2
		local button = UI.button({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.cos(angle) * 130, 0.5, math.sin(angle) * 130),
			Size = UDim2.fromOffset(92, 92),
			Text = "",
			BackgroundColor3 = Color3.fromRGB(40, 44, 70),
			BackgroundTransparency = 0.15,
			Parent = wheel,
		}, { UI.stroke(Color3.new(1, 1, 1), 3, 0), UI.corner(46) })
		UI.label({ Size = UDim2.new(1, 0, 0.7, 0), Text = emote.Icon, TextSize = 40, Parent = button })
		UI.label({ Position = UDim2.fromScale(0, 0.62), Size = UDim2.new(1, 0, 0.3, 0), Text = emote.Name, TextSize = 15, Parent = button })
		button.Activated:Connect(function()
			Sounds.Play("Click")
			setWheel(false)
			play(emote.Id)
		end)
	end
end

function Emotes.Init()
	build()
	TouchLayout.BindAction("Emotes", function(_, state)
		if state == Enum.UserInputState.Begin then
			if wheel.Visible then
				setWheel(false)
			elseif not ClientState.IsBlocked() then
				setWheel(true)
			end
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.N)
	-- Botón táctil en móvil
	TouchLayout.Set("Emotes", UDim2.new(1, -120, 1, -320))
	RunService.Heartbeat:Connect(function()
		if wheel.Visible and otherBlock() then
			setWheel(false)
		end
		if not ClientState.Emoting then
			return
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		-- Se acaba al pasar el tiempo, al moverse, al morir o al disparar
		local moved = humanoid and humanoid.MoveDirection.Magnitude > 0.1
		if os.clock() > emoteUntil or moved or not humanoid or humanoid.Health <= 0 or ClientState.Aiming then
			stopEmote()
		end
	end)
	ClientState.ShotFired.Event:Connect(stopEmote)
	player.CharacterAdded:Connect(stopEmote)
end

return Emotes
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="155">
            <Properties>
              <string name="Name">EnemyName</string>
              <string name="Source"><![CDATA[-- Nombre del enemigo al que apuntas (como en los shooters): normalmente los enemigos no llevan nombre
-- (ver WorldFX), pero si tienes la mira encima de uno, sale su nombre en rojo sobre la cabeza un
-- momento. Un solo cartel reutilizado y un rayo cada 0,1 s.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local ClientState = require(script.Parent.ClientState)

local EnemyName = {}

local RANGE = 300
local CHECK_INTERVAL = 0.1
local LINGER = 0.4

local player = Players.LocalPlayer
local billboard, label
local lastSeen = 0
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude

-- ¿Es un enemigo vivo? Devuelve su nombre
local function enemyName(model)
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or model == player.Character then
		return nil
	end
	local owner = Players:GetPlayerFromCharacter(model)
	local teamMode = ReplicatedStorage:GetAttribute("TeamMode") ~= false
	if owner then
		if teamMode and player.Team ~= nil and owner.Team == player.Team then
			return nil
		end
		return owner.DisplayName
	end
	if model:GetAttribute("Bot") then
		local team = model:GetAttribute("Team")
		if teamMode and player.Team ~= nil and team == player.Team.Name then
			return nil
		end
		return model.Name
	end
	return nil
end

local function update()
	local camera = workspace.CurrentCamera
	if not camera or ClientState.InMainMenu then
		billboard.Enabled = false
		return
	end
	local ignore = { camera }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * RANGE, params)
	local model = hit and hit.Instance:FindFirstAncestorOfClass("Model")
	local name = model and enemyName(model)
	local head = model and model:FindFirstChild("Head")
	if name and head then
		lastSeen = os.clock()
		label.Text = name
		billboard.Adornee = head
		billboard.Enabled = true
	elseif os.clock() - lastSeen > LINGER or not (billboard.Adornee and billboard.Adornee.Parent) then
		billboard.Enabled = false
	end
end

function EnemyName.Init()
	billboard = Instance.new("BillboardGui")
	billboard.Name = "EnemyName"
	billboard.ResetOnSpawn = false -- (si no, Roblox lo borraría al aparecer)
	billboard.Size = UDim2.fromOffset(160, 24)
	billboard.StudsOffset = Vector3.new(0, 2.4, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.Enabled = false
	billboard.Parent = player:WaitForChild("PlayerGui")
	label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 16
	label.TextColor3 = Color3.fromRGB(255, 70, 60)
	label.TextStrokeTransparency = 0.3
	label.Text = ""
	label.Parent = billboard
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < CHECK_INTERVAL then
			return
		end
		elapsed = 0
		update()
	end)
end

EnemyName.Update = update
return EnemyName
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="156">
            <Properties>
              <string name="Name">EnemySounds</string>
              <string name="Source"><![CDATA[-- Sonidos de los demás que dan información, como en los shooters: si alguien recarga cerca (jugador o
-- bot), se oye su cargador saliendo y entrando en su posición. Solo de cerca (unos 70 studs): así se
-- sabe que es buen momento para asomarse. Solo en este cliente.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Sounds = require(Shared.Sounds)
local Weapons = require(Shared.Weapons)

local ClientState = require(script.Parent.ClientState)

local EnemySounds = {}

EnemySounds.Range = 70 -- hasta dónde se oye una recarga
EnemySounds.Interval = 0.15 -- cada cuánto se mira quién está recargando

local player = Players.LocalPlayer
local reloading = setmetatable({}, { __mode = "k" }) -- [Tool] = true mientras recarga
local clock = 0

local function heldTools()
	local list = {}
	local function add(model)
		if model then
			local tool = model:FindFirstChildOfClass("Tool")
			if tool and tool:GetAttribute("Weapon") then
				table.insert(list, tool)
			end
		end
	end
	for _, p in Players:GetPlayers() do
		if p ~= player then
			add(p.Character)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			add(model)
		end
	end
	return list
end

local function play(name, handle, pitch, volume)
	local sound = Sounds.Play(name, handle, pitch, volume)
	if sound then
		sound.RollOffMode = Enum.RollOffMode.InverseTapered
		sound.RollOffMinDistance = 6
		sound.RollOffMaxDistance = EnemySounds.Range
	end
	return sound
end

-- Empieza la recarga de alguien: cargador fuera y, un poco después, dentro
function EnemySounds.OnReload(tool)
	local handle = tool:FindFirstChild("Handle")
	local camera = workspace.CurrentCamera
	if not handle or not handle:IsA("BasePart") or not camera then
		return false
	end
	if (handle.Position - camera.CFrame.Position).Magnitude > EnemySounds.Range then
		return false
	end
	local def = Weapons.Get(tool:GetAttribute("Weapon"))
	local duration = def and def.ReloadTime or 2
	play("MagOut", handle, 1, 0.8)
	task.delay(duration * 0.5, function()
		if tool.Parent and tool:GetAttribute("Reloading") and handle.Parent then
			play("MagIn", handle, 1, 0.9)
		end
	end)
	return true
end

function EnemySounds.Update(dt)
	clock += dt
	if clock < EnemySounds.Interval then
		return
	end
	clock = 0
	if ClientState.InMainMenu then
		return
	end
	for _, tool in heldTools() do
		local now = tool:GetAttribute("Reloading") == true
		if now and not reloading[tool] then
			EnemySounds.OnReload(tool)
		end
		reloading[tool] = now or nil
	end
end

function EnemySounds.Init()
	RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(EnemySounds.Update, dt)
		if not ok then
			warn("[EnemySounds]", err)
		end
	end)
end

return EnemySounds
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="157">
            <Properties>
              <string name="Name">EventHUD</string>
              <string name="Source"><![CDATA[-- Contador del evento de temporada (debajo del botón de regalos): caramelos recogidos hacia el
-- siguiente premio (GameConfig.Event.Milestones y la skin final), con marcas en la barra.
-- Solo aparece si el servidor tiene un evento activo (atributo EventName).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local HUDZones = require(script.Parent.HUDZones)

local player = Players.LocalPlayer

local EventHUD = {}

function EventHUD.Init()
	local compact = InputMode.TouchUI()
	local gui = UI.new("ScreenGui", {
		Name = "EventHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	UI.WaitViewport()
	local phone = UI.IsPhone()
	local frame = UI.new("Frame", {
		-- En móvil: estrecho, debajo del regalo (teléfono: los dos a la derecha del minimapa)
		Position = compact and UDim2.fromOffset(14 + (phone and 96 or 160) + 6, UI.TopbarBottom() + (phone and 60 or 70))
			or UDim2.new(0, 66, 0.38, 176),
		Size = phone and UDim2.fromOffset(44, 34) or (compact and UDim2.fromOffset(52, 40) or UDim2.fromOffset(230, 34)),
		BackgroundColor3 = Color3.fromRGB(60, 25, 80),
		BackgroundTransparency = 0.15,
		Parent = gui,
	}, { UI.corner(10), UI.stroke(Color3.fromRGB(255, 140, 30), 2, 0.2) })
	local label = UI.label({
		Position = UDim2.fromOffset(2, 0),
		Size = UDim2.new(1, -4, 1, -4),
		Text = "",
		TextSize = 18,
		TextScaled = compact,
		TextWrapped = compact,
		Parent = frame,
	})
	local fill = UI.new("Frame", {
		Position = UDim2.new(0, 4, 1, -5),
		Size = UDim2.new(0, 0, 0, 3),
		BackgroundColor3 = Color3.fromRGB(255, 140, 30),
		BorderSizePixel = 0,
		Parent = frame,
	})
	-- (el evento lo dice el servidor: atributo EventId; se mira cada vez por si cambia)
	local milestones, icon, itemIcon = {}, "🎉", "⭐"
	local function syncEvent()
		local event = GameConfig.CurrentEvent()
		milestones = (event and event.Milestones) or {}
		icon = event and event.Icon or "🎉"
		itemIcon = event and event.ItemIcon or "⭐"
	end
	syncEvent()
	local ticks = {}
	for _ = 1, 4 do -- (marcas de los premios por el camino; las que sobran se ocultan)
		table.insert(ticks, UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Size = UDim2.fromOffset(2, 5),
			Position = UDim2.new(0, 0, 1, -6),
			BackgroundColor3 = Color3.fromRGB(255, 230, 150),
			BorderSizePixel = 0,
			Visible = not compact,
			Parent = frame,
		}))
	end
	-- Siguiente premio: caramelos que hacen falta y texto corto (si ya tienes el traje, son monedas)
	local function nextPrize(count, goal, data)
		for _, milestone in milestones do
			if count < milestone.Count and milestone.Count < goal then
				local outfit = milestone.Outfit and not (data.Outfits or {})[milestone.Outfit]
				local weapon = milestone.Weapon and not (data.OwnedWeapons or {})[milestone.Weapon]
				return milestone.Count, (outfit and "Traje") or (weapon and "Arma") or ((milestone.Coins or milestone.Compensate or 0) .. " 💰")
			end
		end
		return goal, "Skin"
	end
	-- (mientras se juega solo sale un rato: al aparecer y cuando sumas; HUD de combate limpio)
	local shownUntil, lastCount = 0, nil
	Players.LocalPlayer.CharacterAdded:Connect(function()
		shownUntil = os.clock() + 6
	end)
	task.spawn(function()
		while true do
			syncEvent()
			local name = ReplicatedStorage:GetAttribute("EventName")
			local goal = ReplicatedStorage:GetAttribute("EventGoal") or 100
			local data = ClientState.Data
			local candy = data and data.EventCandy or 0
			-- (solo con los datos ya cargados: al cargar no cuenta como «has sumado»)
			if data and candy ~= lastCount then
				if lastCount ~= nil then
					shownUntil = os.clock() + 5
				end
				lastCount = candy
			end
			gui.Enabled = name ~= nil and data ~= nil and not ClientState.InMainMenu
				and (ReplicatedStorage:GetAttribute("State") ~= "Playing" or os.clock() < shownUntil)
				-- (táctil, Fase 16: en plena pelea no; junto al minimapa pisaba el aviso de baja)
				and not (compact and HUDZones.Fighting())
			if gui.Enabled then
				local count = data.EventCandy or 0
				if count >= goal then
					label.Text = compact and (icon .. "\n✔") or (icon .. " ¡Skin del evento conseguida!")
				else
					local target, prize = nextPrize(count, goal, data)
					label.Text = compact and (itemIcon .. "\n" .. count .. "/" .. target)
						or (icon .. " " .. itemIcon .. " " .. count .. "/" .. target .. "  → " .. prize)
				end
				fill.Size = UDim2.new(math.clamp(count / goal, 0, 1), -8, 0, 3)
				for i, tick in ticks do
					local milestone = milestones[i]
					if not milestone then
						tick.Visible = false
						continue
					end
					local at = milestone.Count / goal
					tick.Visible = not compact and at < 1
					tick.Position = UDim2.new(at, 4 - 8 * at, 1, -6)
					tick.BackgroundColor3 = count >= milestones[i].Count and Color3.fromRGB(255, 140, 30)
						or Color3.fromRGB(255, 230, 150)
				end
			end
			task.wait(0.5)
		end
	end)
end

return EventHUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="158">
            <Properties>
              <string name="Name">Flashlights</string>
              <string name="Source"><![CDATA[-- Linternas de noche (mapas nocturnos y versiones de noche): el arma de fuego lleva una linterna, como
-- en los shooters militares. La tuya (tecla L para apagarla o encenderla) sale de donde va el arma y
-- proyecta sombras; las de los demás (jugadores con la suya encendida y bots) se ven desde lejos...
-- y también delatan dónde está cada uno. Solo en este cliente: tu elección se manda al servidor
-- (atributo Flashlight del personaje) para que los demás vean la tuya.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Remotes)
local ClientState = require(script.Parent.ClientState)

local Flashlights = {}

Flashlights.On = true -- tu linterna (de noche)
Flashlights.MaxRemote = 6 -- linternas de los demás encendidas a la vez (las más cercanas)
Flashlights.RemoteRange = 160
local COLOR = Color3.fromRGB(255, 244, 226)
local OFFSET = CFrame.new(0.45, -0.45, -1.2) -- (de donde va el arma)

local player = Players.LocalPlayer
local holder, light, fill
local remoteLights = setmetatable({}, { __mode = "k" }) -- [Tool] = SpotLight
local remoteClock = 0

-- ¿Es de noche? (antes del amanecer o después del anochecer)
function Flashlights.IsNight()
	local t = Lighting.ClockTime
	return t < 6.3 or t > 18.2
end

local function ensureLocal()
	if holder and holder.Parent then
		return
	end
	holder = Instance.new("Part")
	holder.Name = "MyFlashlight"
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.CastShadow = false
	holder.Transparency = 1
	holder.Size = Vector3.one * 0.2
	light = Instance.new("SpotLight")
	light.Face = Enum.NormalId.Front
	light.Angle = 50
	light.Range = 48
	light.Brightness = 1.8
	light.Color = COLOR
	light.Enabled = false
	light.Parent = holder
	-- Luz de relleno muy suave y de poco alcance sobre el arma en primera persona: de noche el arma se
	-- veía negra (no ilumina el mundo: 3 studs)
	fill = Instance.new("PointLight")
	fill.Name = "ViewmodelFill"
	fill.Range = 3
	fill.Brightness = 0.5
	fill.Color = Color3.fromRGB(255, 236, 214)
	fill.Shadows = false
	fill.Enabled = false
	fill.Parent = holder
	holder.Parent = workspace.CurrentCamera
end

local function holdsGun(model)
	local tool = model and model:FindFirstChildOfClass("Tool")
	if tool and tool:GetAttribute("Weapon") then
		return tool
	end
	return nil
end

-- Linternas de los demás: las más cercanas con el arma en la mano (y la linterna encendida)
local function updateRemote(active)
	local camera = workspace.CurrentCamera
	local wanted = {}
	if active and camera and ClientState.EffectiveQuality ~= "Baja" then
		local list = {}
		local function consider(model, on)
			local tool = holdsGun(model)
			local handle = tool and tool:FindFirstChild("Handle")
			local humanoid = model and model:FindFirstChildOfClass("Humanoid")
			if on and handle and handle:IsA("BasePart") and humanoid and humanoid.Health > 0 then
				local distance = (handle.Position - camera.CFrame.Position).Magnitude
				if distance <= Flashlights.RemoteRange then
					table.insert(list, { Tool = tool, Handle = handle, Distance = distance })
				end
			end
		end
		for _, p in Players:GetPlayers() do
			if p ~= player and p.Character then
				consider(p.Character, p.Character:GetAttribute("Flashlight") ~= false)
			end
		end
		local bots = workspace:FindFirstChild("Bots")
		if bots then
			for _, model in bots:GetChildren() do
				consider(model, not model:GetAttribute("Zombie"))
			end
		end
		table.sort(list, function(a, b)
			return a.Distance < b.Distance
		end)
		for i = 1, math.min(#list, Flashlights.MaxRemote) do
			wanted[list[i].Tool] = list[i].Handle
		end
	end
	for tool, handle in wanted do
		local spot = remoteLights[tool]
		if not spot or not spot.Parent then
			spot = Instance.new("SpotLight")
			spot.Name = "Flashlight"
			spot.Face = Enum.NormalId.Front
			spot.Angle = 45
			spot.Range = 40
			spot.Brightness = 1.5
			spot.Color = COLOR
			spot.Shadows = false
			spot.Parent = handle
			remoteLights[tool] = spot
		end
		spot.Enabled = true
	end
	for tool, spot in remoteLights do
		if not wanted[tool] and spot.Parent then
			spot.Enabled = false
		end
	end
end

function Flashlights.Update(dt)
	local camera = workspace.CurrentCamera
	local active = Flashlights.IsNight() and not ClientState.InMainMenu
	-- La tuya
	ensureLocal()
	local def = ClientState.CurrentDef
	local mine = active and Flashlights.On and def ~= nil and def.Type == "Gun"
		and not ClientState.Dead and not ClientState.KillcamActive and camera ~= nil
	light.Enabled = mine
	local wantFill = Flashlights.IsNight() and not ClientState.InMainMenu and def ~= nil and not ClientState.Dead
		and not ClientState.KillcamActive and camera ~= nil
	if fill then
		fill.Enabled = wantFill
	end
	if (mine or wantFill) and camera then
		holder.CFrame = camera.CFrame * OFFSET
		light.Shadows = ClientState.EffectiveQuality ~= "Baja"
	end
	-- Las de los demás (unas 4 veces por segundo)
	remoteClock += dt or 0
	if remoteClock >= 0.25 then
		remoteClock = 0
		updateRemote(active)
	end
end

-- Encender o apagar la tuya (y avisar al servidor: los demás ven si la llevas encendida)
function Flashlights.Toggle()
	Flashlights.On = not Flashlights.On
	Remotes.Flashlight:FireServer(Flashlights.On)
	return Flashlights.On
end

function Flashlights.Init()
	RunService:BindToRenderStep("Flashlight", Enum.RenderPriority.Camera.Value + 3, function(dt)
		local ok, err = pcall(Flashlights.Update, dt)
		if not ok then
			warn("[Flashlights]", err)
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or input.KeyCode ~= Enum.KeyCode.L or ClientState.InMainMenu then
			return
		end
		if UserInputService:GetFocusedTextBox() then
			return
		end
		Flashlights.Toggle()
	end)
	-- (personaje nuevo: el servidor vuelve a saber cómo la llevas)
	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		Remotes.Flashlight:FireServer(Flashlights.On)
	end)
end

return Flashlights
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="159">
            <Properties>
              <string name="Name">Flow</string>
            </Properties>
            <Item class="ModuleScript" referent="160">
              <Properties>
                <string name="Name">Components</string>
                <string name="Source"><![CDATA[-- Componentes del flujo (lobby, party, matchmaking, presentaciones, loadout): raíz con escala
-- según la pantalla, textos con la jerarquía del tema, paneles oscuros con borde fino, botones con
-- respuesta al pasar y al pulsar, barras de estadística animadas, tarjetas de jugador.
local GuiService = game:GetService("GuiService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))

local Theme = require(script.Parent.Theme)
local UISound = require(script.Parent.UISound)
local PlayerCards = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("PlayerCards"))
local Icons = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Icons"))

local C = {}
local Colors = Theme.Colors

-- Mayúsculas que respetan las tildes
local ACCENTS = { ["á"] = "Á", ["é"] = "É", ["í"] = "Í", ["ó"] = "Ó", ["ú"] = "Ú", ["ñ"] = "Ñ", ["ü"] = "Ü" }
local function upper(text)
	local result = string.upper(tostring(text))
	return (string.gsub(result, "\195[\161\169\173\179\186\177\188]", ACCENTS))
end
C.upper = upper

-- Corta un texto largo con "…" (por caracteres UTF-8: no rompe tildes ni emojis)
function C.short(text, max)
	text = tostring(text)
	local length = utf8.len(text)
	if not length or length <= max then
		return text
	end
	local cut = utf8.offset(text, max) or (#text + 1)
	return string.sub(text, 1, cut - 1) .. "…"
end

local function new(className, props, children)
	local inst = Instance.new(className)
	local parent
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			inst[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end
C.new = new

local function tween(inst, time, props, style)
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	t:Play()
	return t
end
C.tween = tween

function C.corner(radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 4) })
end

function C.stroke(color, thickness, transparency)
	return new("UIStroke", {
		Color = color or Colors.Line,
		Thickness = thickness or 1,
		Transparency = transparency or Theme.LineAlpha,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function C.padding(top, right, bottom, left)
	right = right or top
	bottom = bottom or top
	left = left or right
	return new("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, right),
		PaddingBottom = UDim.new(0, bottom),
		PaddingLeft = UDim.new(0, left),
	})
end

function C.list(padding, direction, align)
	return new("UIListLayout", {
		Padding = UDim.new(0, padding or 8),
		FillDirection = direction or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Top,
	})
end

---------------------------------------------------------------------------
-- Pantalla: tipo de dispositivo y raíz escalada
---------------------------------------------------------------------------

-- PHONE (pantalla baja y táctil), TABLET (táctil grande) o DESKTOP
function C.Breakpoint()
	local camera = workspace.CurrentCamera
	local size = camera and camera.ViewportSize or Vector2.new(1280, 720)
	local touch = InputMode.TouchUI()
	-- (pantalla baja: teléfono apaisado o ventana pequeña; se compacta igual)
	if size.Y < 520 then
		return "PHONE"
	elseif touch then
		return "TABLET"
	end
	return "DESKTOP"
end

-- Alto de diseño por tipo de pantalla: en el teléfono todo se ve más grande (menos "píxeles
-- virtuales" en la misma altura), así ningún texto queda diminuto
local DESIGN_HEIGHT = { PHONE = 460, TABLET = 680, DESKTOP = 720 }

-- Raíz de una pantalla: un Frame del tamaño de la pantalla en píxeles virtuales con su UIScale.
-- Los hijos se colocan con Scale y AnchorPoint (izquierda/centro/derecha) y medidas en píxeles
-- virtuales; la raíz se reajusta sola al girar o cambiar el tamaño de la ventana.
function C.root(parent, name)
	local frame = new("Frame", {
		Name = name or "Root",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = parent,
	})
	local scale = new("UIScale", { Parent = frame })
	local function refresh()
		local camera = workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
		if viewport.Y < 2 then
			viewport = Vector2.new(1280, 720)
		end
		-- (la ScreenGui va con su zona segura, CoreUISafeInsets: muesca y barra de Roblox. La raíz mide
		-- lo que mide la ScreenGui, no la pantalla entera: si no, en un teléfono con muesca o barra lo
		-- de abajo y lo de la derecha se salía de la pantalla. Sin zona segura, son iguales)
		if parent and parent:IsA("ScreenGui") then
			local area = parent.AbsoluteSize
			if typeof(area) == "Vector2" and area.X > 50 and area.Y > 50 then
				viewport = area
			end
		end
		-- (zona segura: muesca y barra de Roblox; la ScreenGui ya usa ScreenInsets si existe)
		local insetTop = 0
		local ok, inset = pcall(function()
			return GuiService.TopbarInset
		end)
		if ok and typeof(inset) == "Rect" and parent and parent:IsA("ScreenGui") and parent.IgnoreGuiInset then
			insetTop = 0
		end
		local design = DESIGN_HEIGHT[C.Breakpoint()]
		local s = math.clamp(viewport.Y / design, 0.45, 2)
		scale.Scale = s
		frame.Size = UDim2.fromOffset(viewport.X / s, (viewport.Y - insetTop) / s)
		frame:SetAttribute("Breakpoint", C.Breakpoint())
		frame:SetAttribute("VirtualWidth", viewport.X / s)
	end
	refresh()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(refresh)
	end
	if parent and parent:IsA("ScreenGui") then
		parent:GetPropertyChangedSignal("AbsoluteSize"):Connect(refresh)
	end
	return frame, refresh
end

---------------------------------------------------------------------------
-- Texto
---------------------------------------------------------------------------

-- role: "Title" | "TitleItalic" | "Number" | "Body" | "BodyBold"
function C.text(props)
	-- (un icono propio en un hueco de texto: se dibuja la imagen, ajustada al mismo hueco)
	if Icons.IsImage(props.Text) then
		local size = props.Size or UDim2.fromOffset((props.TextSize or Theme.Size.Body) + 12, (props.TextSize or Theme.Size.Body) + 12)
		local holder = new("Frame", {
			BackgroundTransparency = 1,
			Size = size,
			Position = props.Position or UDim2.new(),
			AnchorPoint = props.Anchor or props.AnchorPoint or Vector2.new(),
			LayoutOrder = props.Order or 0,
			ZIndex = props.ZIndex or 1,
			Name = props.Name or "Icon",
			Parent = props.Parent,
		})
		new("ImageLabel", {
			Name = "Image",
			BackgroundTransparency = 1,
			Image = props.Text,
			ScaleType = Enum.ScaleType.Fit,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.9, 0.9),
			ZIndex = props.ZIndex or 1,
			Parent = holder,
		})
		return holder
	end
	local role = props.Role or "Body"
	local label = new("TextLabel", {
		BackgroundTransparency = 1,
		TextColor3 = props.Color or Colors.Text,
		TextSize = props.TextSize or Theme.Size.Body,
		Text = props.Text or "",
		TextXAlignment = props.AlignX or Enum.TextXAlignment.Left,
		TextYAlignment = props.AlignY or Enum.TextYAlignment.Center,
		TextWrapped = props.Wrap == true,
		TextTruncate = props.Wrap and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd,
		RichText = props.Rich == true,
		Font = Theme.FontEnums[role] or Enum.Font.Gotham,
		Size = props.Size or UDim2.new(1, 0, 0, (props.TextSize or Theme.Size.Body) + 6),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.Anchor or props.AnchorPoint or Vector2.new(),
		LayoutOrder = props.Order or 0,
		ZIndex = props.ZIndex or 1,
		Name = props.Name or "Text",
		Parent = props.Parent,
	})
	if Theme.Fonts[role] then
		label.FontFace = Theme.Fonts[role]
	end
	if props.Scaled then
		label.TextScaled = true
		new("UITextSizeConstraint", { MaxTextSize = props.TextSize or Theme.Size.Body, MinTextSize = props.MinTextSize or 11, Parent = label })
	end
	if props.Stroke then
		new("UIStroke", { Thickness = props.Stroke, Color = Colors.Black, Transparency = 0.35, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual, Parent = label })
	end
	return label
end

---------------------------------------------------------------------------
-- Paneles
---------------------------------------------------------------------------

-- Panel oscuro semitransparente con borde fino y un brillo arriba (profundidad sin ser plano).
-- opts.Accent = color de una franja a la izquierda; opts.Alpha = transparencia del fondo
function C.panel(props, opts)
	opts = opts or {}
	local frame = new("Frame", {
		Name = props.Name or "Panel",
		BackgroundColor3 = opts.Color or Colors.Panel,
		BackgroundTransparency = opts.Alpha or Theme.PanelAlpha,
		BorderSizePixel = 0,
		Size = props.Size or UDim2.fromOffset(200, 100),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.Anchor or props.AnchorPoint or Vector2.new(),
		LayoutOrder = props.Order or 0,
		ClipsDescendants = props.Clip == true,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	}, {
		C.corner(opts.Radius or 4),
		C.stroke(opts.StrokeColor or Colors.Line, opts.StrokeThickness or 1, opts.StrokeAlpha or Theme.LineAlpha),
		new("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 0.12),
			}),
			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(190, 192, 200)),
		}),
	})
	if opts.Accent then
		new("Frame", {
			Name = "Accent",
			Size = UDim2.new(0, 3, 1, -8),
			Position = UDim2.fromOffset(0, 4),
			BackgroundColor3 = opts.Accent,
			BorderSizePixel = 0,
			ZIndex = (props.ZIndex or 1) + 1,
			Parent = frame,
		})
	end
	return frame
end

-- Cabecera de panel: título corto en mayúsculas (amarillo) y, opcional, un texto a la derecha
function C.header(parent, text, right, order)
	local row = new("Frame", {
		Name = "Header",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 26),
		LayoutOrder = order or 0,
		Parent = parent,
	})
	C.text({ Text = text, Role = "Title", TextSize = 18, Color = Colors.YellowText, Size = UDim2.new(0.7, 0, 1, 0), Parent = row })
	if right then
		C.text({ Name = "Right", Text = right, Role = "Number", TextSize = 15, Color = Colors.TextDim, AlignX = Enum.TextXAlignment.Right, Size = UDim2.new(0.3, 0, 1, 0), Position = UDim2.fromScale(0.7, 0), Parent = row })
	end
	return row
end

---------------------------------------------------------------------------
-- Botones
---------------------------------------------------------------------------

-- Respuesta al ratón y al dedo: crece un poco al pasar (1,03), se hunde al pulsar (0,97) y vuelve;
-- el borde se ilumina. Rápido (0,08-0,16 s) y con sonido central (UISound).
function C.feel(button, opts)
	opts = opts or {}
	local scale = new("UIScale", { Name = "FeelScale", Parent = button })
	local stroke = button:FindFirstChildOfClass("UIStroke")
	local baseStroke = stroke and stroke.Transparency or 1
	local hovering, pressed = false, false
	local function apply(info)
		local target = pressed and 0.97 or (hovering and (opts.HoverScale or 1.03) or 1)
		TweenService:Create(scale, info, { Scale = target }):Play()
		if stroke then
			TweenService:Create(stroke, info, { Transparency = hovering and math.max(0, baseStroke - 0.45) or baseStroke }):Play()
		end
	end
	local hoverInfo = TweenInfo.new(Theme.Time.Hover, Enum.EasingStyle.Quad)
	local pressInfo = TweenInfo.new(Theme.Time.Press, Enum.EasingStyle.Quad)
	local releaseInfo = TweenInfo.new(Theme.Time.Release, Enum.EasingStyle.Back)
	button.MouseEnter:Connect(function()
		if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
			return
		end
		hovering = true
		apply(hoverInfo)
		if not opts.Silent then
			UISound.Play("Hover")
		end
	end)
	button.MouseLeave:Connect(function()
		hovering, pressed = false, false
		apply(hoverInfo)
	end)
	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			pressed = true
			apply(pressInfo)
		end
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			pressed = false
			if input.UserInputType == Enum.UserInputType.Touch then
				hovering = false
			end
			apply(releaseInfo)
		end
	end)
	return scale
end

-- Icono: una imagen propia (Shared/Icons, "rbxassetid://...") o, si no, un emoji o texto como siempre.
-- props: Icon, Size, Position, TextSize (tamaño del emoji; la imagen se ajusta a ese alto), Color,
-- Role, Name, ZIndex, Parent
function C.icon(props)
	if Icons.IsImage(props.Icon) then
		local side = (props.TextSize or 18) + 12
		local holder = new("Frame", {
			Name = props.Name or "Icon",
			BackgroundTransparency = 1,
			Size = props.Size or UDim2.fromOffset(side, side),
			Position = props.Position,
			ZIndex = props.ZIndex,
			Parent = props.Parent,
		})
		new("ImageLabel", {
			Name = "Image",
			BackgroundTransparency = 1,
			Image = props.Icon,
			ScaleType = Enum.ScaleType.Fit,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(side, side),
			ZIndex = props.ZIndex,
			Parent = holder,
		})
		return holder
	end
	return C.text({
		Name = props.Name,
		Text = props.Icon or "",
		Role = props.Role or "Title",
		TextSize = props.TextSize or 18,
		Color = props.Color,
		AlignX = Enum.TextXAlignment.Center,
		Size = props.Size,
		Position = props.Position,
		ZIndex = props.ZIndex,
		Parent = props.Parent,
	})
end

-- Botón del flujo. opts: Text, Icon, Style ("Primary" amarillo | "Menu" lateral | "Ghost" | "Danger"),
-- Size, Position, Anchor, Order, Parent, OnClick, TextSize, Sub (texto pequeño debajo), Sound
function C.button(opts)
	local style = opts.Style or "Ghost"
	local bg, fg, alpha, strokeColor, strokeAlpha
	if style == "Primary" then
		bg, fg, alpha, strokeColor, strokeAlpha = Colors.Yellow, Color3.fromRGB(16, 14, 8), 0, Colors.White, 0.55
	elseif style == "Danger" then
		bg, fg, alpha, strokeColor, strokeAlpha = Colors.Red, Colors.White, 0, Colors.White, 0.6
	elseif style == "Menu" then
		bg, fg, alpha, strokeColor, strokeAlpha = Colors.Panel, Colors.Text, 0.12, Colors.Line, 0.86
	else
		bg, fg, alpha, strokeColor, strokeAlpha = Colors.PanelLight, Colors.Text, 0.25, Colors.Line, 0.8
	end
	local button = new("TextButton", {
		Name = opts.Name or ("Button_" .. tostring(opts.Text)),
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = bg,
		BackgroundTransparency = alpha,
		BorderSizePixel = 0,
		Size = opts.Size or UDim2.fromOffset(220, 48),
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.Anchor or Vector2.new(),
		LayoutOrder = opts.Order or 0,
		ZIndex = opts.ZIndex or 2,
		Parent = opts.Parent,
	}, {
		C.corner(opts.Radius or 4),
		C.stroke(strokeColor, style == "Primary" and 2 or 1, strokeAlpha),
	})
	button:SetAttribute("BaseColor", bg)
	button:SetAttribute("BaseTextColor", fg)
	button:SetAttribute("BaseAlpha", alpha)
	if style == "Primary" then
		-- Brillo de arriba y sombra de abajo: el botón amarillo tiene volumen
		new("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 236, 120)),
				ColorSequenceKeypoint.new(0.5, Colors.Yellow),
				ColorSequenceKeypoint.new(1, Colors.YellowDark),
			}),
			Parent = button,
		})
	end
	local textSize = opts.TextSize or (style == "Primary" and 30 or 18)
	local hasIcon = opts.Icon ~= nil and opts.Icon ~= ""
	local inner = new("Frame", {
		Name = "Inner",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = button.ZIndex + 1,
		Parent = button,
	}, { C.padding(0, 14, 0, style == "Menu" and 16 or 14) })
	if hasIcon then
		C.icon({
			Name = "Icon",
			Icon = opts.Icon,
			Role = "TitleItalic",
			TextSize = textSize,
			Color = fg,
			Size = UDim2.new(0, textSize + 8, 1, 0),
			ZIndex = button.ZIndex + 1,
			Parent = inner,
		})
	end
	local label = C.text({
		Name = "Label",
		Text = opts.Text or "",
		Role = style == "Primary" and "TitleItalic" or "Title",
		TextSize = textSize,
		Color = fg,
		Scaled = true,
		AlignX = opts.AlignX or (style == "Menu" and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center),
		Size = UDim2.new(1, hasIcon and -(textSize + 14) or 0, opts.Sub and 0.62 or 1, 0),
		Position = UDim2.fromOffset(hasIcon and textSize + 14 or 0, 0),
		ZIndex = button.ZIndex + 1,
		Parent = inner,
	})
	if opts.Sub then
		C.text({
			Name = "Sub",
			Text = opts.Sub,
			Role = "BodyBold",
			TextSize = 12,
			Color = style == "Primary" and Color3.fromRGB(80, 60, 10) or Colors.TextDim,
			AlignX = label.TextXAlignment,
			Size = UDim2.new(1, hasIcon and -(textSize + 14) or 0, 0.38, 0),
			Position = UDim2.new(0, hasIcon and textSize + 14 or 0, 0.6, 0),
			ZIndex = button.ZIndex + 1,
			Parent = inner,
		})
	end
	C.feel(button, { HoverScale = opts.HoverScale })
	if opts.OnClick then
		button.Activated:Connect(function()
			UISound.Play(opts.Sound or (style == "Primary" and "Play" or "Click"))
			opts.OnClick(button)
		end)
	end
	return button
end

-- Marca de "selección" en un botón de menú: fondo amarillo y texto oscuro (o vuelve a normal)
function C.setSelected(button, selected)
	local label = button:FindFirstChild("Label", true)
	local icon = button:FindFirstChild("Icon", true)
	-- (sin seleccionar vuelve a su estilo de origen, guardado al crearlo)
	local baseBg = button:GetAttribute("BaseColor")
	local baseFg = button:GetAttribute("BaseTextColor")
	local baseAlpha = button:GetAttribute("BaseAlpha")
	local bg = selected and Colors.Yellow or (typeof(baseBg) == "Color3" and baseBg or Colors.Panel)
	local fg = selected and Color3.fromRGB(16, 14, 8) or (typeof(baseFg) == "Color3" and baseFg or Colors.Text)
	tween(button, Theme.Time.Fast, { BackgroundColor3 = bg, BackgroundTransparency = selected and 0 or (tonumber(baseAlpha) or 0.12) })
	if label then
		tween(label, Theme.Time.Fast, { TextColor3 = fg })
	end
	if icon and icon:IsA("TextLabel") then
		tween(icon, Theme.Time.Fast, { TextColor3 = fg })
	end
end

-- Punto rojo de aviso (algo nuevo) en la esquina de un botón
function C.dot(parent, visible)
	local dot = parent:FindFirstChild("Dot") or new("Frame", {
		Name = "Dot",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -10, 0, 10),
		Size = UDim2.fromOffset(10, 10),
		BackgroundColor3 = Colors.Red,
		BorderSizePixel = 0,
		ZIndex = 10,
		Parent = parent,
	}, { C.corner(5), C.stroke(Colors.White, 1, 0.3) })
	dot.Visible = visible ~= false
	return dot
end

---------------------------------------------------------------------------
-- Barras
---------------------------------------------------------------------------

-- Barra de progreso (fraction 0..1) que se anima al cambiar
function C.progress(props)
	local back = new("Frame", {
		Name = props.Name or "Progress",
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.88,
		BorderSizePixel = 0,
		Size = props.Size or UDim2.new(1, 0, 0, 6),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.Anchor or props.AnchorPoint or Vector2.new(),
		LayoutOrder = props.Order or 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	}, { C.corner(2) })
	local fill = new("Frame", {
		Name = "Fill",
		BackgroundColor3 = props.Color or Colors.Yellow,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(math.clamp(props.Value or 0, 0, 1), 1),
		ZIndex = (props.ZIndex or 1) + 1,
		Parent = back,
	}, { C.corner(2) })
	local bar = { Frame = back, Fill = fill }
	function bar.Set(_, fraction, animate)
		fraction = math.clamp(fraction or 0, 0, 1)
		if animate == false then
			fill.Size = UDim2.fromScale(fraction, 1)
		else
			tween(fill, Theme.Time.Stat, { Size = UDim2.fromScale(fraction, 1) }, Enum.EasingStyle.Quint)
		end
	end
	return bar
end

-- Fila de estadística: icono, nombre, barra animada y número (0..100)
function C.statRow(parent, name, icon, order)
	local row = new("Frame", {
		Name = "Stat_" .. name,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = order or 0,
		Parent = parent,
	})
	C.text({ Text = icon or "", Role = "Title", TextSize = 18, AlignX = Enum.TextXAlignment.Center, Size = UDim2.new(0, 24, 1, 0), Color = Colors.White, Parent = row })
	C.text({ Text = name, Role = "Title", TextSize = Theme.Size.Stat - 2, Scaled = true, Size = UDim2.new(0.38, -28, 1, 0), Position = UDim2.fromOffset(30, 0), Parent = row })
	local bar = C.progress({ Size = UDim2.new(0.5, -44, 0, 8), Position = UDim2.new(0.38, 6, 0.5, 0), Anchor = Vector2.new(0, 0.5), Parent = row })
	local number = C.text({ Text = "0", Role = "Number", TextSize = Theme.Size.Stat, AlignX = Enum.TextXAlignment.Right, Size = UDim2.new(0.12, 0, 1, 0), Position = UDim2.new(0.88, 0, 0, 0), Parent = row })
	local current = 0
	local stat = { Frame = row }
	function stat.Set(_, value, animate)
		value = math.clamp(math.floor((value or 0) + 0.5), 0, 100)
		bar:Set(value / 100, animate)
		if animate == false then
			current = value
			number.Text = tostring(value)
			return
		end
		-- El número cuenta hasta el valor nuevo a la vez que la barra (~0,25 s)
		local from = current
		current = value
		task.spawn(function()
			local start = os.clock()
			while os.clock() - start < Theme.Time.Stat do
				local a = (os.clock() - start) / Theme.Time.Stat
				number.Text = tostring(math.floor(from + (value - from) * a + 0.5))
				task.wait()
			end
			number.Text = tostring(value)
		end)
	end
	return stat
end

---------------------------------------------------------------------------
-- Tarjetas
---------------------------------------------------------------------------

-- Moneda/divisa de la barra superior: icono, cantidad y botón "+" amarillo
function C.currency(parent, icon, order, onPlus)
	local box = C.panel({ Size = UDim2.fromOffset(150, 40), Order = order, Parent = parent })
	C.icon({ Icon = icon, Role = "Title", TextSize = 22, Size = UDim2.new(0, 36, 1, 0), Parent = box })
	local amount = C.text({ Name = "Amount", Text = "0", Role = "Number", TextSize = 22, Size = UDim2.new(1, -78, 1, 0), Position = UDim2.fromOffset(36, 0), Parent = box })
	if onPlus then
		local plus = new("TextButton", {
			Name = "Plus",
			AutoButtonColor = false,
			Text = "+",
			TextSize = 24,
			Font = Enum.Font.GothamBold,
			TextColor3 = Color3.fromRGB(16, 14, 8),
			BackgroundColor3 = Colors.Yellow,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -6, 0.5, 0),
			Size = UDim2.fromOffset(28, 28),
			Parent = box,
		}, { C.corner(3) })
		C.feel(plus)
		plus.Activated:Connect(function()
			UISound.Play("Click")
			onPlus()
		end)
	end
	return box, amount
end

-- Estados de un jugador en el party / la presentación
C.Status = {
	Ready = { Text = "LISTO", Color = Colors.Green, Icon = "✔" },
	NotReady = { Text = "NO LISTO", Color = Colors.TextDim, Icon = "•" },
	Loading = { Text = "CARGANDO", Color = Colors.YellowText, Icon = "◌" },
	InMatch = { Text = "EN PARTIDA", Color = Colors.Red, Icon = "⚔" },
	Bot = { Text = "BOT", Color = Colors.TextDim, Icon = "🤖" },
	Offline = { Text = "DESCONECTADO", Color = Colors.TextFaint, Icon = "✕" },
}

-- Tarjeta de jugador (nombre, nivel, estado, líder): se usa en el party y en la presentación de
-- equipos. info = { Name, Level, Status, Leader, Me, TeamColor, Card (tarjeta de jugador elegida) }
function C.playerCard(props, info)
	local card = C.panel({ Name = "PlayerCard", Size = props.Size or UDim2.fromOffset(170, 58), Position = props.Position, Anchor = props.Anchor, Order = props.Order, Parent = props.Parent, ZIndex = props.ZIndex }, {
		Accent = info.TeamColor or (info.Me and Colors.Yellow or nil),
		StrokeColor = info.Me and Colors.Yellow or Colors.Line,
		StrokeAlpha = info.Me and 0.3 or Theme.LineAlpha,
	})
	-- Fondo con su tarjeta de jugador (lo primero: queda detrás del nombre)
	local cardSlot = new("Frame", { Name = "CardSlot", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = props.ZIndex or 1, Parent = card }, { C.corner(4) })
	local cardGradient = new("UIGradient", { Rotation = 90, Parent = cardSlot })
	local z = (props.ZIndex or 1) + 1
	local name = C.text({ Name = "PlayerName", Text = upper(info.Name or ""), Role = "Title", TextSize = 18, Color = info.Me and Colors.YellowText or Colors.White, Scaled = true, Size = UDim2.new(1, -16, 0, 24), Position = UDim2.fromOffset(10, 5), ZIndex = z, Parent = card })
	local level = C.text({ Name = "Level", Text = info.Level and ("NV. " .. tostring(info.Level)) or "", Role = "Number", TextSize = 14, Color = Colors.TextDim, Size = UDim2.new(0.5, -10, 0, 18), Position = UDim2.new(0, 10, 1, -22), ZIndex = z, Parent = card })
	local status = C.text({ Name = "Status", Text = "", Role = "Title", TextSize = 14, Scaled = true, AlignX = Enum.TextXAlignment.Right, Size = UDim2.new(0.6, -10, 0, 18), Position = UDim2.new(0.4, 0, 1, -22), ZIndex = z, Parent = card })
	local leader = C.text({ Name = "Leader", Text = "👑", TextSize = 14, AlignX = Enum.TextXAlignment.Right, Size = UDim2.fromOffset(20, 20), Position = UDim2.new(1, -24, 0, 4), ZIndex = z, Parent = card })
	local api = { Frame = card }
	function api.Update(_, newInfo)
		local def = newInfo.Card and newInfo.Card ~= "Default" and PlayerCards.List[newInfo.Card]
		cardSlot.BackgroundTransparency = def and 0.3 or 1
		if def then
			cardSlot.BackgroundColor3 = def.Top
			cardGradient.Color = ColorSequence.new(def.Top, def.Bottom)
		end
		name.Text = upper(newInfo.Name or "")
		-- (quién eres tú también se actualiza: la tarjeta puede crearse vacía y llenarse después)
		name.TextColor3 = newInfo.Me and Colors.YellowText or Colors.White
		local stroke = card:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = newInfo.Me and Colors.Yellow or Colors.Line
			stroke.Transparency = newInfo.Me and 0.3 or Theme.LineAlpha
		end
		level.Text = newInfo.Level and ("NV. " .. tostring(newInfo.Level)) or ""
		local st = C.Status[newInfo.Status or "NotReady"] or C.Status.NotReady
		status.Text = st.Icon .. " " .. st.Text
		status.TextColor3 = st.Color
		leader.Visible = newInfo.Leader == true
	end
	api:Update(info)
	return api
end

return C
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="161">
              <Properties>
                <string name="Name">FlowController</string>
                <string name="Source"><![CDATA[-- UIFlowController: un solo sitio decide qué pantalla del flujo se ve, en vez de muchos scripts
-- encendiendo y apagando cosas. Estados:
--   Home, Squad, Armory, Operator      (lobby: cámara sobre el mapa, desenfoque, controles quietos)
--   Matchmaking → MatchFound → MapIntro → TeamIntro → Loadout → Deploy (3-2-1) → Gameplay
-- La secuencia se apoya en el ciclo de rondas real del servidor (atributos State, LoadingMap,
-- Deploy, CountdownAt y DeployEndsAt de ReplicatedStorage): las presentaciones se ven MIENTRAS el
-- servidor construye el mapa o mantiene a todos quietos en el despliegue, no se suman a la espera.
-- Quien entra con una partida ya empezada hace la misma secuencia, más corta y a su ritmo.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.Parent.ClientState)
local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)
local Transition = require(script.Parent.Transition)
local UISound = require(script.Parent.UISound)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Flow = {}
Flow.State = "Boot"
Flow.Changed = Instance.new("BindableEvent")
Flow.Screens = {}

local LOBBY = { Home = true, Squad = true, Armory = true, Operator = true, Store = true, Pass = true }
local SEQUENCE = { Matchmaking = true, MatchFound = true, MapIntro = true, TeamIntro = true, Loadout = true, Deploy = true }
Flow.Lobby = LOBBY
Flow.Sequence = SEQUENCE

-- Tiempos de la secuencia (segundos). Los del despliegue los manda el servidor; estos son los
-- mínimos para que cada momento se lea y los de quien entra con la partida empezada
Flow.Times = {
	SearchMin = 0.9, -- (con partida en marcha: lo justo para que se vea que busca)
	MatchFound = 1.4,
	MapIntroMin = 1.8,
	TeamIntro = 3.2,
	LateLoadout = 5,
	LateCountdown = 3,
}

local guis: { [string]: any } = {}

---------------------------------------------------------------------------
-- Cámara y controles del lobby (lo que antes hacía la pantalla de inicio)
---------------------------------------------------------------------------

local controls
local function getControls()
	if controls then
		return controls
	end
	local ok, result = pcall(function()
		local playerModule = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
		return playerModule:GetControls()
	end)
	if ok then
		controls = result
	end
	return controls
end

local orbitAngle = 0
local cameraMode = nil -- "Orbit" | "Flyover" | "Deploy" | "Scripted" | nil (cámara del juego)
local cameraDriver = nil -- ("Scripted": la pantalla mueve la cámara, p. ej. la pantalla final)
local deployFrom, deployStart, deployTime

-- (GetBoundingBox recorre todas las piezas del mapa: se calcula como mucho cada 2 s o al cambiar de
-- mapa, no en cada fotograma; las piezas aún pueden estar llegando, por eso se refresca)
local centerCache = { Map = nil, At = -math.huge, Center = Vector3.new(0, 8, 0), Radius = 150 }
local function mapCenter()
	local map = workspace:FindFirstChild("Map")
	local now = os.clock()
	if map == centerCache.Map and now - centerCache.At < 2 then
		return centerCache.Center, centerCache.Radius
	end
	centerCache.Map, centerCache.At = map, now
	centerCache.Center, centerCache.Radius = Vector3.new(0, 8, 0), 150
	if map and map:IsA("Model") then
		local ok, cf, size = pcall(map.GetBoundingBox, map)
		if ok and cf then
			centerCache.Center = Vector3.new(cf.Position.X, 8, cf.Position.Z)
			centerCache.Radius = math.clamp(math.max(size.X, size.Z) * 0.5, 90, 200)
		end
	end
	return centerCache.Center, centerCache.Radius
end

local function cameraStep(dt)
	if not cameraMode then
		return
	end
	camera.CameraType = Enum.CameraType.Scriptable
	local center, radius = mapCenter()
	if cameraMode == "Orbit" then
		orbitAngle += dt * 0.05
		local position = center + Vector3.new(math.cos(orbitAngle) * radius, 60, math.sin(orbitAngle) * radius)
		camera.CFrame = CFrame.lookAt(position, center)
		camera.FieldOfView = 60
	elseif cameraMode == "Flyover" then
		-- Presentación del mapa: pasada lenta y más baja
		orbitAngle += dt * 0.09
		local position = center + Vector3.new(math.cos(orbitAngle) * radius * 0.75, 42, math.sin(orbitAngle) * radius * 0.75)
		camera.CFrame = CFrame.lookAt(position, center + Vector3.new(0, -6, 0))
		camera.FieldOfView = 55
	elseif cameraMode == "Scripted" then
		if cameraDriver then
			cameraDriver(camera, dt)
		end
	elseif cameraMode == "Deploy" then
		-- De la vista del mapa a la espalda de tu personaje, a tiempo con la cuenta atrás
		local character = player.Character
		local head = character and character:FindFirstChild("Head")
		if head and deployFrom then
			local a = math.clamp((os.clock() - deployStart) / deployTime, 0, 1)
			a = 1 - (1 - a) ^ 3
			local root = character:FindFirstChild("HumanoidRootPart") or head
			local target = CFrame.lookAt(head.Position - root.CFrame.LookVector * 0.2 + Vector3.new(0, 0.2, 0), head.Position + root.CFrame.LookVector * 10)
			camera.CFrame = deployFrom:Lerp(target, a)
			camera.FieldOfView = 70 + (1 - a) * -10
		end
	end
end

-- duration: solo para "Deploy" (lo que tarda en llegar a tu espalda; por defecto, lo que queda de
-- despliegue)
function Flow.SetCamera(mode, duration)
	cameraDriver = mode == "Scripted" and duration or nil
	if mode == "Deploy" then
		deployFrom = camera.CFrame
		deployStart = os.clock()
		deployTime = math.max(0.5, (duration or Flow.DeployRemaining() or 3) - 0.15)
	end
	cameraMode = mode
	if not mode then
		camera.CameraType = Enum.CameraType.Custom
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid and not ClientState.Dead then
			camera.CameraSubject = humanoid
		end
	end
end

local function lockControls(locked)
	task.spawn(function()
		local ctrl = getControls()
		if ctrl then
			if locked then
				ctrl:Disable()
			else
				ctrl:Enable()
			end
		end
	end)
end

---------------------------------------------------------------------------
-- Tiempos del servidor
---------------------------------------------------------------------------

local function serverNow()
	return workspace:GetServerTimeNow()
end

-- Segundos que faltan para que acabe el despliegue (nil si no hay despliegue en marcha)
function Flow.DeployRemaining()
	local endsAt = ReplicatedStorage:GetAttribute("DeployEndsAt")
	if ReplicatedStorage:GetAttribute("Deploy") == nil or not endsAt then
		return nil
	end
	return math.max(0, endsAt - serverNow())
end

function Flow.CountdownIn()
	local at = ReplicatedStorage:GetAttribute("CountdownAt")
	if ReplicatedStorage:GetAttribute("Deploy") == nil or not at then
		return nil
	end
	return at - serverNow()
end

---------------------------------------------------------------------------
-- Estados
---------------------------------------------------------------------------

function Flow.Register(name, screen)
	Flow.Screens[name] = screen
end

-- Cambia de pantalla. ctx: datos para la pantalla nueva (p. ej. { Late = true })
function Flow.SetState(state, ctx)
	local previous = Flow.State
	if previous == state then
		local screen = Flow.Screens[state]
		if screen and screen.Refresh then
			screen.Refresh(ctx)
		end
		return
	end
	Flow.State = state
	local old = Flow.Screens[previous]
	if old and old.Hide then
		old.Hide(state)
	end
	-- Lobby y secuencia: interfaz del juego oculta y personaje quieto; en Gameplay, todo vuelve
	local inFlow = state ~= "Gameplay"
	ClientState.InMainMenu = inFlow
	ClientState.UpdateMouse()
	UserInputService.MouseIconEnabled = inFlow or UserInputService.MouseIconEnabled
	lockControls(inFlow)
	if guis.Content then
		guis.Content.Enabled = inFlow
		guis.Backdrop.Enabled = inFlow
	end
	local screen = Flow.Screens[state]
	if screen and screen.Show then
		screen.Show(ctx or {}, previous)
	end
	Flow.Changed:Fire(state, previous)
end

-- Fondo oscuro detrás de las pantallas (opacidad 0..1) con fundido
function Flow.SetBackdrop(alpha, time)
	if guis.Dim then
		Transition.Tween(guis.Dim, time or Theme.Time.Normal, { BackgroundTransparency = 1 - alpha })
	end
end

---------------------------------------------------------------------------
-- Acciones
---------------------------------------------------------------------------

-- JUGAR: buscar partida (desde el lobby)
function Flow.Play()
	if not LOBBY[Flow.State] then
		return
	end
	Transition.Flash(Theme.Colors.Yellow, 0.4, 0.3)
	pcall(function()
		Remotes.SetReady:FireServer(true)
	end)
	Flow.SetState("Matchmaking")
end

function Flow.CancelSearch()
	if Flow.State ~= "Matchmaking" then
		return
	end
	UISound.Play("Back")
	pcall(function()
		Remotes.SetReady:FireServer(false)
	end)
	-- (venía de una partida: de vuelta al lobby también en el servidor)
	if not player:GetAttribute("InMenu") then
		pcall(function()
			Remotes.EnterMenu:FireServer()
		end)
	end
	Flow.SetState("Home")
end

-- JUGAR DE NUEVO desde la pantalla final: a buscar la siguiente partida (el servidor ya te cuenta
-- en ella; la búsqueda enseña la votación y el tiempo que falta)
function Flow.Requeue()
	if Flow.State == "Matchmaking" then
		return
	end
	Transition.Flash(Theme.Colors.Yellow, 0.35, 0.3)
	Flow.SetState("Matchmaking", { Requeue = true })
end

-- Entrar a jugar (al acabar la cuenta atrás): fuera el escudo del menú, cámara del juego
function Flow.EnterGameplay()
	if Flow.State == "Gameplay" then
		return
	end
	if player:GetAttribute("InMenu") then
		Remotes.LeaveMenu:FireServer()
	end
	Transition.Blur(0, 0.2)
	Flow.SetCamera(nil)
	-- (un revelado de compra abierto no pasa a la partida)
	local ok, Reveal = pcall(require, script.Parent.Store.Reveal)
	if ok and Reveal.CloseAll then
		Reveal.CloseAll()
	end
	Flow.SetState("Gameplay")
end

-- Volver al lobby (desde la pantalla de muerte): solo lo acepta el servidor si estás muerto o
-- recién aparecido
function Flow.ReturnToLobby()
	if LOBBY[Flow.State] then
		return
	end
	Remotes.EnterMenu:FireServer()
	Flow.SetState("Home")
end

-- La siguiente pantalla de la secuencia según lo que esté haciendo el servidor
function Flow.Advance(from)
	local state = ReplicatedStorage:GetAttribute("State")
	local deploying = ReplicatedStorage:GetAttribute("Deploy") ~= nil
	if from == "MatchFound" then
		Flow.SetState("MapIntro", { Late = not deploying })
	elseif from == "MapIntro" then
		if deploying or state == "Playing" then
			Flow.SetState("TeamIntro", { Late = not deploying })
		end
	elseif from == "TeamIntro" then
		Flow.SetState("Loadout", { Late = not deploying })
	elseif from == "Loadout" then
		Flow.SetState("Deploy", { Late = not deploying })
	elseif from == "Deploy" then
		Flow.EnterGameplay()
	end
end

---------------------------------------------------------------------------
-- Reacción al ciclo de rondas (para quien está en la secuencia o jugando)
---------------------------------------------------------------------------

local function onRoundChanged()
	local state = ReplicatedStorage:GetAttribute("State")
	local loading = ReplicatedStorage:GetAttribute("LoadingMap")
	local deploy = ReplicatedStorage:GetAttribute("Deploy")
	local current = Flow.State
	if LOBBY[current] or current == "Boot" then
		return -- (en el lobby no se interrumpe nada)
	end
	if current == "Matchmaking" then
		-- Partida lista: el mapa nuevo se está construyendo o empieza el despliegue
		if loading or (state == "Playing" and deploy) then
			Flow.SetState("MatchFound")
		end
		return
	end
	if current == "Gameplay" and state == "Ended" then
		-- Fin de partida: la pantalla final llega con el resultado; mientras, que el HUD no celebre
		Flow.EndedAt = os.clock()
		ClientState.ResultsActive = true
		task.delay(4, function()
			if Flow.State == "Gameplay" then
				ClientState.ResultsActive = false
			end
		end)
		return
	end
	if current == "Results" then
		-- Acaba la pantalla final: a buscar la siguiente (salvo que se haya cancelado); si la partida
		-- siguiente ya empieza, su presentación
		if loading then
			Flow.SetState("MapIntro", { Server = true })
		elseif state == "Playing" and deploy == "Lineup" then
			Flow.SetState("TeamIntro", { Server = true })
		elseif state == "Intermission" then
			local screen = Flow.Screens.Results
			if not (screen and screen.AutoAdvance) or screen.AutoAdvance() then
				Flow.Requeue()
			end
		end
		return
	end
	if current == "Gameplay" then
		-- Ronda nueva para quien ya estaba jugando: presentación del mapa y despliegue
		if loading then
			Flow.SetState("MapIntro", { Server = true })
		elseif state == "Playing" and deploy == "Lineup" then
			Flow.SetState("TeamIntro", { Server = true })
		end
		return
	end
	if current == "MapIntro" and state == "Playing" and deploy then
		local screen = Flow.Screens.MapIntro
		if screen and screen.ReadyToLeave and screen.ReadyToLeave() then
			Flow.Advance("MapIntro")
		end
	end
	if (current == "TeamIntro" or current == "Loadout") and state == "Playing" and (deploy == "Countdown" or deploy == nil) then
		-- Cuenta atrás del servidor (o, en Eliminación y Buscar y destruir, la preparación de la
		-- primera ronda justo después de la presentación)
		Flow.SetState("Deploy")
	end
	if SEQUENCE[current] and state ~= "Playing" and not loading and current ~= "MatchFound" then
		-- (la partida se cortó en plena secuencia: a esperar la siguiente)
		if state == "Intermission" and (current == "TeamIntro" or current == "Loadout" or current == "Deploy") then
			Flow.SetState("Matchmaking")
		end
	end
end
Flow.OnRoundChanged = onRoundChanged

---------------------------------------------------------------------------
-- Arranque
---------------------------------------------------------------------------

function Flow.Init(screens)
	local playerGui = player:WaitForChild("PlayerGui")
	-- Fondo a pantalla completa (oscurece el mundo detrás de los paneles)
	guis.Backdrop = C.new("ScreenGui", {
		Name = "FlowBackdrop",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 3,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})
	guis.Dim = C.new("Frame", {
		Name = "Dim",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Bg,
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		Parent = guis.Backdrop,
	})
	-- Viñeta: más oscuro a los lados (se leen los paneles; el centro queda para el personaje)
	C.new("Frame", {
		Name = "Vignette",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Parent = guis.Backdrop,
	}, {
		C.new("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.25),
				NumberSequenceKeypoint.new(0.28, 0.85),
				NumberSequenceKeypoint.new(0.72, 0.85),
				NumberSequenceKeypoint.new(1, 0.25),
			}),
		}),
	})
	-- Contenido (zona segura: muesca y barra de Roblox)
	guis.Content = C.new("ScreenGui", {
		Name = "MainMenu",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 4,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})
	pcall(function()
		guis.Content.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	end)
	-- Botón invisible "Modal": libera el ratón aunque la cámara sea en primera persona
	C.new("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true, Parent = guis.Content })
	local root = C.root(guis.Content, "FlowRoot")
	guis.Root = root
	-- Efectos (destellos y barridos) por encima de todo, también en partida
	guis.FX = C.new("ScreenGui", {
		Name = "FlowFX",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 30,
		Parent = playerGui,
	})
	Transition.SetLayer(C.new("Frame", { Name = "Layer", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = guis.FX }))

	Flow.Guis = guis
	Flow.Root = root
	for name, screen in screens do
		local ok, err = xpcall(screen.Build, debug.traceback, Flow, root)
		if ok then
			Flow.Register(name, screen)
		else
			warn("[Flow] " .. name .. " no se pudo crear: " .. tostring(err))
		end
	end

	RunService:BindToRenderStep("FlowCamera", Enum.RenderPriority.Camera.Value + 2, cameraStep)
	for _, attr in { "State", "LoadingMap", "Deploy" } do
		ReplicatedStorage:GetAttributeChangedSignal(attr):Connect(onRoundChanged)
	end
	-- Esc / B del mando: de una pantalla del lobby (escuadra, armamento, operador) a la principal
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not LOBBY[Flow.State] or Flow.State == "Home" or ClientState.MenuOpen then
			return
		end
		-- (con la vista previa, la confirmación o la escena de compra abiertas, Esc cierra solo eso)
		if ClientState.StoreModal or ClientState.ConfirmOpen or ClientState.RevealOpen then
			return
		end
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB or input.KeyCode == Enum.KeyCode.Backspace then
			UISound.Play("Back")
			Flow.SetState("Home")
		end
	end)
	guis.Content:SetAttribute("Ready", true)
end

return Flow
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="162">
              <Properties>
                <string name="Name">Preview</string>
                <string name="Source"><![CDATA[-- PreviewController: personajes 3D reales (tu avatar, tus compañeros, los rivales y los bots) dentro de
-- un ViewportFrame con WorldModel, para el lobby, la escuadra, la presentación de equipos, el
-- armamento y el operador. Nunca toca los personajes del juego: hace una copia sin scripts del
-- personaje vivo (con su traje y su arma), la congela en una pose de "arma lista" y la ilumina aparte.
-- Uso:
--   local p = Preview.new(parent, { Size = ..., Position = ... })
--   p:SetCharacter("me", player)      -- (o un modelo de bot)
--   p:SetWeapon("me", "ARX27", skin)  -- cambia el arma en las manos
--   p:SetPose("me", "Ready")          -- "Ready" (arma lista) | "Relaxed" (brazos abajo)
--   p:SetAnimation("me", "MenuIdle")  -- animación con nombre (GameConfig.UIAnimations) o su pose
--                                        equivalente si aún no hay animación subida
--   p:SetCameraPreset("Hero")         -- "Hero" | "Squad" | "Lineup" | "Bust"
--   p:SetActive(true/false)           -- anima (respiración) solo mientras se ve
--   p:Clear()
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weapons = require(Shared.Weapons)
local WeaponModels = require(Shared.WeaponModels)
local GameConfig = require(Shared.GameConfig)

local RiflePose = require(script.Parent.Parent.RiflePose)

local Preview = {}
Preview.__index = Preview

-- Dónde se coloca cada hueco de la escena (X a la derecha, mirando a la cámara en -Z → +Z)
Preview.Slots = {
	me = CFrame.new(0, 0, 0),
	s2 = CFrame.new(-3.4, 0, 1.6) * CFrame.Angles(0, math.rad(12), 0),
	s3 = CFrame.new(3.4, 0, 1.6) * CFrame.Angles(0, math.rad(-12), 0),
	s4 = CFrame.new(-6.6, 0, 3.4) * CFrame.Angles(0, math.rad(18), 0),
	s5 = CFrame.new(6.6, 0, 3.4) * CFrame.Angles(0, math.rad(-18), 0),
}
for i = 1, 5 do
	-- (fila de presentación de equipos: cinco en línea)
	Preview.Slots["line" .. i] = CFrame.new((i - 3) * 3.3, 0, math.abs(i - 3) * 0.9)
end

local CAMERAS = {
	Hero = { Pos = Vector3.new(1.2, 3.1, -11.4), Look = Vector3.new(0.4, 2.75, 0), FOV = 34 },
	Bust = { Pos = Vector3.new(0.6, 3.9, -5.2), Look = Vector3.new(0.2, 3.4, 0), FOV = 34 },
	Squad = { Pos = Vector3.new(0, 3.6, -15.5), Look = Vector3.new(0, 2.8, 1.5), FOV = 42 },
	Lineup = { Pos = Vector3.new(0, 3.6, -19), Look = Vector3.new(0, 2.8, 1), FOV = 40 },
}

-- Quita de la copia todo lo que haga algo (scripts, sonidos, interfaces, efectos de partículas)
local function strip(model)
	for _, d in model:GetDescendants() do
		if d:IsA("BaseScript") or d:IsA("Sound") or d:IsA("BillboardGui") or d:IsA("SurfaceGui")
			or d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") or d:IsA("ForceField")
			or d:IsA("Light") or d:IsA("IKControl") or d:IsA("Fire") or d:IsA("Smoke") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
			d.Anchored = false
		end
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		pcall(function()
			humanoid.EvaluateStateMachine = false
		end)
	end
end

-- Copia de un personaje vivo (jugador o bot). Devuelve nil si no hay personaje
local function cloneCharacter(source)
	local character = source
	if typeof(source) == "Instance" and source:IsA("Player") then
		character = source.Character
	end
	if not character or not character:FindFirstChild("HumanoidRootPart") then
		return nil
	end
	local archivable = character.Archivable
	character.Archivable = true
	local ok, copy = pcall(function()
		return character:Clone()
	end)
	character.Archivable = archivable
	if not ok or not copy then
		return nil
	end
	-- (solo el arma que lleva en la mano: las de la mochila no están en el personaje)
	strip(copy)
	return copy
end

-- Postura "arma lista" con cinemática inversa de dos huesos calculada aquí (sin IKControl): pone
-- los C0 de hombro, codo y muñeca para que la mano derecha quede en la empuñadura y la izquierda en
-- el guardamanos, con los mismos objetivos que usa RiflePose para los personajes del juego
local function rigAttachment(part, name)
	local a = part and part:FindFirstChild(name)
	return a and a:IsA("Attachment") and a or nil
end

local function solveArm(model, side, targetGrip, targetPos, pole)
	local torso = model:FindFirstChild("UpperTorso")
	local upper = model:FindFirstChild(side .. "UpperArm")
	local lower = model:FindFirstChild(side .. "LowerArm")
	local hand = model:FindFirstChild(side .. "Hand")
	if not (torso and upper and lower and hand) then
		return false
	end
	local shoulderJoint = upper:FindFirstChild(side .. "Shoulder")
	local elbowJoint = lower:FindFirstChild(side .. "Elbow")
	local wristJoint = hand:FindFirstChild(side .. "Wrist")
	local aShoulderU = rigAttachment(upper, side .. "ShoulderRigAttachment")
	local aElbowU = rigAttachment(upper, side .. "ElbowRigAttachment")
	local aElbowL = rigAttachment(lower, side .. "ElbowRigAttachment")
	local aWristL = rigAttachment(lower, side .. "WristRigAttachment")
	local aWristH = rigAttachment(hand, side .. "WristRigAttachment")
	local aGrip = rigAttachment(hand, side .. "GripAttachment")
	if not (shoulderJoint and elbowJoint and wristJoint and aShoulderU and aElbowU and aElbowL and aWristL and aWristH) then
		return false
	end
	-- Largos de los huesos
	local upperLen = (aElbowU.Position - aShoulderU.Position).Magnitude
	local gripOffset = aGrip and (aGrip.Position - aWristH.Position) or Vector3.new(0, -0.15, 0)
	local lowerLen = (aWristL.Position - aElbowL.Position).Magnitude + gripOffset.Magnitude * 0.9
	local shoulder = (torso.CFrame * shoulderJoint.C0).Position
	local target = targetGrip and targetGrip.Position or targetPos
	local toTarget = target - shoulder
	local dist = math.clamp(toTarget.Magnitude, 0.05, upperLen + lowerLen - 0.01)
	local dir = toTarget.Unit
	-- Codo: ley del coseno en el plano que forman hombro, objetivo y polo
	local cosA = (upperLen * upperLen + dist * dist - lowerLen * lowerLen) / (2 * upperLen * dist)
	local angle = math.acos(math.clamp(cosA, -1, 1))
	local poleDir = (pole - shoulder)
	poleDir = (poleDir - dir * poleDir:Dot(dir))
	if poleDir.Magnitude < 1e-3 then
		poleDir = Vector3.new(0, -1, 0)
	end
	poleDir = poleDir.Unit
	local elbow = shoulder + (dir * math.cos(angle) + poleDir * math.sin(angle)) * upperLen
	-- Orienta un hueso: su eje "hacia abajo" (-Y del brazo) apunta de un punto al otro
	local function boneCFrame(from, to)
		local down = (to - from).Unit
		local right = down:Cross(poleDir)
		if right.Magnitude < 1e-3 then
			right = Vector3.new(1, 0, 0)
		end
		right = right.Unit
		local back = right:Cross(-down).Unit
		return CFrame.fromMatrix(from, right, -down, back)
	end
	local upperCF = boneCFrame(shoulder, elbow) * CFrame.new(-aShoulderU.Position)
	-- (la mano se coloca para que su GripAttachment ENTERO, con su giro, coincida con el objetivo: es lo
	-- mismo que hace el IKControl del juego, que usa ese Attachment como extremo. En los R15 de verdad
	-- el GripAttachment viene girado; ignorar su giro deja el arma apuntando al suelo)
	local gripHand = targetGrip and (targetGrip * (aGrip and aGrip.CFrame or CFrame.new()):Inverse()) or nil
	local wristPos = gripHand and (gripHand * aWristH.CFrame).Position or (target - Vector3.new(0, -0.1, 0))
	local lowerCF = boneCFrame((upperCF * aElbowU.CFrame).Position, wristPos) * CFrame.new(-aElbowL.Position)
	local handCF
	if targetGrip then
		handCF = gripHand
	else
		handCF = lowerCF * aWristL.CFrame * aWristH.CFrame:Inverse()
	end
	-- Part1 = Part0 · C0 · Transform · C1⁻¹ → Transform = C0⁻¹ · Part0⁻¹ · Part1 · C1. Se escribe en
	-- Transform y no en C0 porque los personajes de Roblox con las uniones nuevas (AnimationConstraint
	-- en vez de Motor6D) tienen C0 de solo lectura; Transform vale para las dos
	shoulderJoint.Transform = shoulderJoint.C0:Inverse() * torso.CFrame:Inverse() * upperCF * shoulderJoint.C1
	elbowJoint.Transform = elbowJoint.C0:Inverse() * upperCF:Inverse() * lowerCF * elbowJoint.C1
	wristJoint.Transform = wristJoint.C0:Inverse() * lowerCF:Inverse() * handCF * wristJoint.C1
	return true
end

local function weaponOf(model)
	for _, child in model:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute("Weapon") then
			return child
		end
	end
	return nil
end

-- pitch (opcional, radianes): gira el arma alrededor del hombro (negativo = apuntando al suelo,
-- positivo = al cielo); lo usan las poses de victoria (PoseRig)
local function poseReady(model, pitch)
	local torso = model:FindFirstChild("UpperTorso")
	local tool = weaponOf(model)
	if not (torso and tool) then
		return false
	end
	local grip, left = RiflePose.Targets(tool:GetAttribute("Weapon"), tool:GetAttribute("WorldScale") or 1, -0.18, RiflePose.Reach)
	if not grip then
		return false
	end
	if pitch and pitch ~= 0 then
		local pivot = CFrame.new(0.9, 0.45, 0)
		local turn = pivot * CFrame.Angles(pitch, 0, 0) * pivot:Inverse()
		grip = turn * grip
		left = turn * left
	end
	local worldGrip = torso.CFrame * grip
	local worldLeft = torso.CFrame * left
	local ok1 = solveArm(model, "Right", worldGrip, nil, (torso.CFrame * CFrame.new(2.2, -1.6, 0.6)).Position)
	local ok2 = solveArm(model, "Left", nil, worldLeft, (torso.CFrame * CFrame.new(-1.6, -1.8, -0.4)).Position)
	return ok1 and ok2
end

-- Arma nueva en la mano derecha (como la Tool del juego: mismo agarre y escala)
local function giveWeapon(model, weaponName, skin, charm)
	local old = weaponOf(model)
	if old then
		old:Destroy()
	end
	local hand = model:FindFirstChild("RightHand")
	local def = weaponName and Weapons.Get(weaponName)
	if not hand or not def or def.Type ~= "Gun" then
		return nil
	end
	local scale = GameConfig.WorldWeaponScale or 1
	local ok, weapon = pcall(WeaponModels.Build, weaponName, skin, false, charm ~= "Default" and charm or nil, scale)
	if not ok or not weapon then
		return nil
	end
	local tool = Instance.new("Tool")
	tool.Name = "PreviewWeapon"
	tool:SetAttribute("Weapon", weaponName)
	tool:SetAttribute("WorldScale", scale)
	tool.Parent = model
	weapon.Parent = tool
	local handle = weapon.PrimaryPart
	if handle then
		local gripAtt = hand:FindFirstChild("RightGripAttachment")
		local grip = CFrame.new((def.RightHand or Vector3.zero) * scale)
		local weld = Instance.new("Weld")
		weld.Name = "PreviewGrip"
		weld.Part0 = hand
		weld.Part1 = handle
		weld.C0 = gripAtt and gripAtt.CFrame or CFrame.new(0, -0.15, 0)
		weld.C1 = grip
		weld.Parent = hand
	end
	return tool
end

-- Animación con nombre (GameConfig.UIAnimations) en un modelo cualquiera; nil si no hay id configurado
local function playNamed(model, name)
	local id = GameConfig.UIAnimations and GameConfig.UIAnimations[name]
	if type(id) ~= "string" or id == "" then
		return nil
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local ok, track = pcall(function()
		local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator")
		animator.Parent = humanoid
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local loaded = animator:LoadAnimation(animation)
		loaded.Looped = name ~= "WeaponInspect"
		loaded:Play(0.2)
		return loaded
	end)
	return ok and track or nil
end

-- Piezas sueltas para otras escenas (la pantalla final usa las mismas copias, armas y poses)
Preview.Strip = strip
Preview.CloneCharacter = cloneCharacter
Preview.GiveWeapon = giveWeapon
Preview.PoseReady = poseReady
Preview.WeaponOf = weaponOf
Preview.PlayNamed = playNamed
Preview.SolveArm = solveArm

---------------------------------------------------------------------------
-- Escena
---------------------------------------------------------------------------

function Preview.new(parent, props)
	local self = setmetatable({}, Preview)
	local viewport = Instance.new("ViewportFrame")
	viewport.Name = props and props.Name or "Preview"
	viewport.BackgroundTransparency = 1
	viewport.Size = props and props.Size or UDim2.fromScale(1, 1)
	viewport.Position = props and props.Position or UDim2.new()
	viewport.AnchorPoint = props and props.Anchor or Vector2.new()
	viewport.ZIndex = props and props.ZIndex or 1
	-- Luz de escenario: ambiente frío y luz principal cálida desde arriba a la derecha (dramática)
	viewport.Ambient = Color3.fromRGB(120, 122, 138)
	viewport.LightColor = Color3.fromRGB(255, 236, 214)
	viewport.LightDirection = Vector3.new(-0.6, -1, 0.7)
	viewport.Parent = parent
	local world = Instance.new("WorldModel")
	world.Parent = viewport
	local camera = Instance.new("Camera")
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	self.Viewport = viewport
	self.World = world
	self.Camera = camera
	self.Rigs = {}
	self.Phase = math.random() * 10
	self:SetCameraPreset(props and props.Camera or "Hero")
	return self
end

function Preview:SetCameraPreset(name)
	local preset = CAMERAS[name] or CAMERAS.Hero
	self.CameraName = name
	self.Camera.FieldOfView = preset.FOV
	self.Camera.CFrame = CFrame.lookAt(preset.Pos, preset.Look)
end

-- Coloca un personaje en un hueco. source = Player o modelo de personaje (bot)
function Preview:SetCharacter(slot, source)
	local old = self.Rigs[slot]
	if old then
		old.Model:Destroy()
		self.Rigs[slot] = nil
	end
	if not source then
		return nil
	end
	local model = cloneCharacter(source)
	if not model then
		return nil
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	model.Parent = self.World
	-- (de cara a la cámara: la cámara mira hacia +Z, así que el personaje mira hacia -Z)
	local base = (Preview.Slots[slot] or CFrame.new()) * CFrame.Angles(0, math.pi, 0)
	local hip = 3
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		hip = (tonumber(humanoid.HipHeight) or 2) + root.Size.Y / 2
	end
	root.Anchored = true
	root.CFrame = base * CFrame.new(0, hip, 0)
	local rig = { Model = model, Root = root, Base = root.CFrame, Slot = slot }
	self.Rigs[slot] = rig
	self:SetPose(slot, weaponOf(model) and "Ready" or "Relaxed")
	return model
end

function Preview:SetWeapon(slot, weaponName, skin, charm)
	local rig = self.Rigs[slot]
	if not rig then
		return
	end
	giveWeapon(rig.Model, weaponName, skin, charm)
	self:SetPose(slot, "Ready")
end

function Preview:SetPose(slot, pose)
	local rig = self.Rigs[slot]
	if not rig then
		return
	end
	rig.Pose = pose
	if pose == "Ready" then
		pcall(poseReady, rig.Model)
	end
end

-- Animaciones con nombre: si GameConfig.UIAnimations tiene un id para ese nombre se reproduce en
-- bucle (encima de la pose con el arma); si no, se usa la pose por código que le corresponde
Preview.AnimationPoses = {
	MenuIdle = "Ready",
	OperatorIdle = "Ready",
	WeaponInspect = "Ready",
	SquadIdle = "Ready",
	VictoryIdle = "Ready",
	SquadVictoryIdle = "Ready",
	VictoryPose = "Relaxed",
}

function Preview:SetAnimation(slot, name)
	local rig = self.Rigs[slot]
	if not rig then
		return false
	end
	rig.AnimationName = name
	if rig.Track then
		pcall(function()
			rig.Track:Stop(0.2)
		end)
		rig.Track = nil
	end
	local track = playNamed(rig.Model, name)
	if track then
		rig.Track = track
		return true
	end
	local pose = Preview.AnimationPoses[name] or "Ready"
	if pose == "Ready" and not weaponOf(rig.Model) then
		pose = "Relaxed"
	end
	self:SetPose(slot, pose)
	return false
end

-- Animación de reposo (respiración y un vaivén mínimo): solo mientras la vista está activa
function Preview:SetActive(active)
	if active and not self.Connection then
		self.Connection = RunService.RenderStepped:Connect(function()
			if not self.Viewport.Parent or not self.Viewport.Visible then
				return
			end
			local t = os.clock() + self.Phase
			for _, rig in self.Rigs do
				local k = (rig.Slot == "me") and 1 or 0.7
				rig.Root.CFrame = rig.Base * CFrame.new(0, math.sin(t * 1.6) * 0.03 * k, 0) * CFrame.Angles(0, math.sin(t * 0.5) * 0.05 * k, 0)
			end
		end)
	elseif not active and self.Connection then
		self.Connection:Disconnect()
		self.Connection = nil
	end
end

-- Gira al personaje principal (arrastrar en el lobby o el armamento)
function Preview:Turn(slot, radians)
	local rig = self.Rigs[slot]
	if rig then
		rig.Base = rig.Base * CFrame.Angles(0, radians, 0)
	end
end

function Preview:Clear()
	for slot, rig in self.Rigs do
		rig.Model:Destroy()
		self.Rigs[slot] = nil
	end
end

function Preview:Destroy()
	self:SetActive(false)
	self:Clear()
	self.Viewport:Destroy()
end

return Preview
]]></string>
              </Properties>
            </Item>
            <Item class="Folder" referent="163">
              <Properties>
                <string name="Name">Results</string>
              </Properties>
              <Item class="ModuleScript" referent="164">
                <Properties>
                  <string name="Name">Anim</string>
                  <string name="Source"><![CDATA[-- Microanimaciones de la pantalla final: contadores que suben, entradas con salto y destellos sobre
-- un panel. Todo con un token: si la pantalla se cierra, lo que estaba en marcha se para solo.
local TweenService = game:GetService("TweenService")

local Flow = script.Parent.Parent
local Theme = require(Flow.Theme)
local Transition = require(Flow.Transition)
local UISound = require(Flow.UISound)

local Anim = {}

Anim.Token = 0
function Anim.Alive(token)
	return token == Anim.Token
end

-- Cuenta de from a to en `time` segundos (texto con `format`, p. ej. "+%d XP"). Con números
-- pequeños (rondas de Buscar y destruir) va de uno en uno con su tic; si no, suave y con tics espaciados
function Anim.Count(label, from, to, time, format, token, sound)
	format = format or "%d"
	from, to = math.floor(from or 0), math.floor(to or 0)
	if to == from then
		label.Text = string.format(format, to)
		return
	end
	local small = math.abs(to - from) <= 12
	task.spawn(function()
		if small then
			local stepTime = math.min(0.12, time / math.abs(to - from))
			local dir = to > from and 1 or -1
			for value = from + dir, to, dir do
				if token and not Anim.Alive(token) then
					return
				end
				label.Text = string.format(format, value)
				if sound then
					UISound.Play(sound, 1 + (value - from) / math.max(1, math.abs(to - from)) * 0.3)
				end
				task.wait(stepTime)
			end
			return
		end
		local start = os.clock()
		local lastTick = 0
		while os.clock() - start < time do
			if token and not Anim.Alive(token) then
				return
			end
			local a = (os.clock() - start) / time
			a = 1 - (1 - a) ^ 3
			label.Text = string.format(format, math.floor(from + (to - from) * a + 0.5))
			if sound and os.clock() - lastTick > 0.07 then
				lastTick = os.clock()
				UISound.Play(sound, 0.9 + a * 0.5)
			end
			task.wait()
		end
		label.Text = string.format(format, to)
	end)
end

-- Entra con un salto pequeño (escala)
function Anim.Pop(frame, from, time, delayTime)
	frame.Visible = true
	return Transition.Pop(frame, from or 0.7, time or 0.22, delayTime)
end

-- Destello dentro de un panel (sin tapar la pantalla): un rectángulo del color que se desvanece
function Anim.Glow(frame, color, strength, time)
	local glow = Instance.new("Frame")
	glow.Name = "Glow"
	glow.BackgroundColor3 = color or Theme.Colors.Yellow
	glow.BackgroundTransparency = 1 - (strength or 0.45)
	glow.BorderSizePixel = 0
	glow.Size = UDim2.fromScale(1, 1)
	glow.ZIndex = (tonumber(frame.ZIndex) or 1) + 20
	local corner = frame:FindFirstChildOfClass("UICorner")
	if corner then
		corner:Clone().Parent = glow
	end
	glow.Parent = frame
	local t = TweenService:Create(glow, TweenInfo.new(time or 0.5, Enum.EasingStyle.Quad), { BackgroundTransparency = 1 })
	t.Completed:Once(function()
		glow:Destroy()
	end)
	t:Play()
end

-- Brillo que cruza un panel de izquierda a derecha (una vez: MVP, desbloqueo)
function Anim.Sheen(frame, time)
	local sheen = Instance.new("Frame")
	sheen.Name = "Sheen"
	sheen.BackgroundColor3 = Color3.new(1, 1, 1)
	sheen.BackgroundTransparency = 0.6
	sheen.BorderSizePixel = 0
	sheen.AnchorPoint = Vector2.new(0.5, 0.5)
	sheen.Position = UDim2.fromScale(-0.2, 0.5)
	sheen.Size = UDim2.new(0, 26, 1.6, 0)
	sheen.Rotation = 18
	sheen.ZIndex = (tonumber(frame.ZIndex) or 1) + 21
	local gradient = Instance.new("UIGradient")
	gradient.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.3), NumberSequenceKeypoint.new(1, 1) })
	gradient.Parent = sheen
	-- (en un marco propio que recorta: lo que sobresale del panel, como la corona del MVP, no se corta)
	local clip = Instance.new("Frame")
	clip.Name = "SheenClip"
	clip.BackgroundTransparency = 1
	clip.Size = UDim2.fromScale(1, 1)
	clip.ClipsDescendants = true
	clip.ZIndex = sheen.ZIndex
	clip.Parent = frame
	sheen.Parent = clip
	local t = TweenService:Create(sheen, TweenInfo.new(time or 0.6, Enum.EasingStyle.Quad), { Position = UDim2.fromScale(1.2, 0.5) })
	t.Completed:Once(function()
		clip:Destroy()
	end)
	t:Play()
end

return Anim
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="165">
                <Properties>
                  <string name="Name">Camera</string>
                  <string name="Source"><![CDATA[-- ResultsCameraController: cámara de la pantalla final. Tres planos y movimiento muy lento:
--   "Wide"  plano general del equipo (entra un poco más lejos y se acerca despacio)
--   "MVP"   se acerca al MVP sin perder al resto
--   "Drift" deriva lateral lentísima (lo que queda mientras se mira la pantalla)
-- Profundidad de campo ligera (los personajes nítidos, el fondo un poco borroso) solo mientras dura;
-- es una instancia propia que se borra al salir: la iluminación del juego no se toca.
local Lighting = game:GetService("Lighting")

local Camera = {}

local targets
local preset = "Wide"
local presetAt = 0
local fromCF
local dof
local FOV = 46

local function shot(name, t)
	local center, mvp, forward = targets.Center, targets.MVP, targets.Forward
	local right = forward:Cross(Vector3.yAxis).Unit
	if name == "Wide" then
		-- (de 17 a 14,5 studs en los primeros segundos)
		local d = 14.5 + 2.5 * math.exp(-t * 0.9)
		return CFrame.lookAt(center + forward * d + Vector3.new(0, 1.6, 0), center + Vector3.new(0, 0.2, 0))
	elseif name == "MVP" then
		local d = 11 + 1.5 * math.exp(-t * 0.8)
		return CFrame.lookAt(mvp + forward * d + Vector3.new(0, 1.0, 0) + right * 0.4, mvp - Vector3.new(0, 0.5, 0))
	end
	-- Drift: muy despacio de un lado a otro
	local sway = math.sin(t * 0.12) * 1.6
	return CFrame.lookAt(center + forward * 13 + right * sway + Vector3.new(0, 1.4, 0), center + Vector3.new(0, 0.3, 0))
end

function Camera.Start(stageTargets, camera)
	targets = stageTargets
	fromCF = camera and camera.CFrame or nil
	preset = "Wide"
	presetAt = os.clock()
	if not dof or not dof.Parent then
		dof = Instance.new("DepthOfFieldEffect")
		dof.Name = "ResultsDepth"
		dof.FarIntensity = 0.22
		dof.NearIntensity = 0
		dof.FocusDistance = 14
		dof.InFocusRadius = 9
		dof.Parent = Lighting
	end
end

function Camera.SetPreset(name)
	if not targets or name == preset then
		return
	end
	-- (el plano nuevo arranca desde donde está la cámara: sin cortes)
	fromCF = workspace.CurrentCamera and workspace.CurrentCamera.CFrame or fromCF
	preset = name
	presetAt = os.clock()
end

-- Lo llama el FlowController en cada fotograma (modo de cámara "Scripted") mientras se ve
function Camera.Step(camera)
	if not targets then
		return
	end
	local t = os.clock() - presetAt
	local goal = shot(preset, t)
	-- Mezcla suave desde el plano anterior (1,2 s)
	local a = math.clamp(t / 1.2, 0, 1)
	a = 1 - (1 - a) ^ 3
	camera.CFrame = fromCF and fromCF:Lerp(goal, a) or goal
	camera.FieldOfView = FOV
	if dof then
		dof.FocusDistance = (camera.CFrame.Position - (preset == "MVP" and targets.MVP or targets.Center)).Magnitude
	end
end

function Camera.Stop()
	targets = nil
	if dof then
		dof:Destroy()
		dof = nil
	end
end

return Camera
]]></string>
                </Properties>
              </Item>
              <Item class="Folder" referent="166">
                <Properties>
                  <string name="Name">Components</string>
                </Properties>
                <Item class="ModuleScript" referent="167">
                  <Properties>
                    <string name="Name">ChallengeProgress</string>
                    <string name="Source"><![CDATA[-- DESAFÍOS COMPLETADOS en esta partida (diarios y semanales), con su ✓ animado uno tras otro.
-- Sin desafíos completados no ocupa sitio (el panel no sale).
local Flow = script.Parent.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Transition = require(Flow.Transition)
local UISound = require(Flow.UISound)
local Anim = require(script.Parent.Parent.Anim)

local Colors = Theme.Colors

local ChallengeProgress = {}

function ChallengeProgress.new(parent)
	local root = C.panel({ Name = "ChallengeProgress", Size = UDim2.fromOffset(380, 96), Parent = parent }, { Alpha = 0.16 })
	C.text({ Name = "Head", Text = "DESAFÍOS COMPLETADOS", Role = "TitleItalic", TextSize = 16, Position = UDim2.fromOffset(14, 6), Size = UDim2.fromOffset(300, 20), Parent = root })
	local list = C.new("Frame", { Name = "List", BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 30), Size = UDim2.new(1, -24, 1, -34), Parent = root }, { C.list(2) })
	local rows = {}
	local api = { Frame = root }
	function api.Set(challenges)
		for _, row in rows do
			row.Frame:Destroy()
		end
		table.clear(rows)
		root.Visible = challenges ~= nil and #challenges > 0
		for i, challenge in challenges or {} do
			if i > 3 then
				break
			end
			local row = C.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = i, Parent = list })
			local box = C.new("Frame", { BackgroundColor3 = Colors.Green, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 2), Size = UDim2.fromOffset(16, 16), Parent = row }, { C.corner(3) })
			local check = C.text({ Text = "✓", Role = "Title", TextSize = 13, Color = Colors.White, AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = box })
			C.text({ Text = (challenge.Weekly and "SEMANAL · " or "") .. tostring(challenge.Text or ""), Role = "BodyBold", TextSize = 13, Position = UDim2.fromOffset(24, 0), Size = UDim2.new(1, -90, 1, 0), Parent = row })
			C.text({ Text = string.format("%d/%d", challenge.Goal or 1, challenge.Goal or 1), Role = "Number", TextSize = 14, Color = Colors.Green, AlignX = Enum.TextXAlignment.Right, Anchor = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(60, 20), Parent = row })
			check.TextTransparency = 1
			box.BackgroundTransparency = 1
			table.insert(rows, { Frame = row, Box = box, Check = check })
		end
	end
	function api.Play(token)
		for i, row in rows do
			task.delay((i - 1) * 0.25, function()
				if not Anim.Alive(token) then
					return
				end
				Transition.Tween(row.Box, 0.15, { BackgroundTransparency = 0 })
				Transition.Tween(row.Check, 0.15, { TextTransparency = 0 })
				Transition.Pop(row.Box, 1.6, 0.25)
				UISound.Play("Tick", 1.4 + i * 0.1)
			end)
		end
	end
	function api.Final()
		for _, row in rows do
			row.Box.BackgroundTransparency = 0
			row.Check.TextTransparency = 0
		end
	end
	return api
end

return ChallengeProgress
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="168">
                  <Properties>
                    <string name="Name">MVPCard</string>
                    <string name="Source"><![CDATA[-- Tarjeta del MVP (o de tu jugador destacado si el MVP es rival): corona y placa amarilla "MVP",
-- nombre y tres cifras grandes (ELIMINACIONES · ASISTENCIAS · PUNTOS). Al destacarlo: destello dorado,
-- brillo que cruza, salto y su sonido.
local Flow = script.Parent.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local ItemArt = require(Flow.Store.ItemArt)
local Transition = require(Flow.Transition)
local UISound = require(Flow.UISound)
local Anim = require(script.Parent.Parent.Anim)

local Colors = Theme.Colors
local DARK = Color3.fromRGB(16, 14, 8)

local MVPCard = {}

function MVPCard.new(parent, opts)
	local card = C.new("Frame", {
		Name = "MVPCard",
		BackgroundColor3 = Color3.fromRGB(22, 19, 8),
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		Position = UDim2.new(),
		Size = UDim2.fromOffset(250, 112),
		LayoutOrder = opts.Order or 0,
		Parent = parent,
	}, {
		C.corner(5),
		C.new("UIStroke", { Color = Colors.Yellow, Thickness = 2, Transparency = 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
		C.new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(255, 236, 170), Color3.fromRGB(150, 120, 40)) }),
	})
	-- Su tarjeta de jugador de fondo, suave (el dorado del MVP manda)
	if opts.Entry and opts.Entry.Card and opts.Entry.Card ~= "Default" then
		local art = ItemArt.Card(card, opts.Entry.Card, { Name = "CardArt", Size = UDim2.fromScale(1, 1), ZIndex = 0, BackgroundTransparency = 0.55 })
		local emblem = art:FindFirstChild("Emblem")
		if emblem then
			emblem.TextTransparency = 0.5
		end
	end
	-- Placa con corona arriba, sobresaliendo
	local plate = C.new("Frame", { Name = "Plate", BackgroundColor3 = Colors.Yellow, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(110, 30), ZIndex = 3, Parent = card }, {
		C.corner(3),
		C.new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(255, 236, 120), Colors.YellowDark) }),
	})
	local plateText = C.text({ Name = "PlateText", Text = opts.IsMVP and "MVP" or "DESTACADO", Role = "TitleItalic", TextSize = opts.IsMVP and 24 or 17, Color = DARK, AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = plate })
	local crown = C.text({ Name = "Crown", Text = "👑", TextSize = 30, AlignX = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, -16), Size = UDim2.fromOffset(40, 34), ZIndex = 4, Parent = card })
	crown.Visible = opts.IsMVP == true
	local entry = opts.Entry
	C.text({ Name = "PlayerName", Text = (entry.Bot and "🤖 " or "") .. C.short(entry.Name, 18), Role = "TitleItalic", TextSize = 24, Color = opts.Me and Colors.YellowText or Colors.White, AlignX = Enum.TextXAlignment.Center, Scaled = true, Position = UDim2.fromOffset(10, 14), Size = UDim2.new(1, -20, 0, 28), Stroke = 1, Parent = card })
	local values = {}
	for i, spec in { { "ELIMINACIONES", entry.Kills }, { "ASISTENCIAS", entry.Assists }, { "PUNTOS", entry.Points } } do
		local x = (i - 1) / 3
		values[i] = C.text({ Name = spec[1] .. "Value", Text = "0", Role = "TitleItalic", TextSize = 30, AlignX = Enum.TextXAlignment.Center, Position = UDim2.new(x, 0, 0, 46), Size = UDim2.new(1 / 3, 0, 0, 34), Stroke = 1, Parent = card })
		C.text({ Name = spec[1], Text = spec[1], Role = "Title", TextSize = 13, Color = Color3.fromRGB(255, 226, 150), AlignX = Enum.TextXAlignment.Center, Position = UDim2.new(x, 0, 0, 82), Size = UDim2.new(1 / 3, 0, 0, 14), Parent = card })
		if i > 1 then
			C.new("Frame", { BackgroundColor3 = Colors.White, BackgroundTransparency = 0.75, BorderSizePixel = 0, Position = UDim2.new(x, 0, 0, 52), Size = UDim2.fromOffset(1, 40), Parent = card })
		end
	end
	local api = { Frame = card, Plate = plate, Crown = crown }
	-- El momento MVP: salto, destello dorado, brillo, corona y sonido; las cifras cuentan
	function api.Highlight(token)
		Transition.Pop(card, 1.25, 0.28)
		Transition.Pop(plate, 0.4, 0.25, 0.08)
		if crown.Visible then
			Transition.Pop(crown, 0.2, 0.3, 0.12)
		end
		Anim.Glow(card, Colors.Yellow, 0.55, 0.5)
		task.delay(0.15, function()
			Anim.Sheen(card, 0.6)
		end)
		UISound.Play(opts.IsMVP and "MVP" or "Reward")
		Anim.Count(values[1], 0, entry.Kills or 0, 0.6, "%d", token)
		Anim.Count(values[2], 0, entry.Assists or 0, 0.6, "%d", token)
		Anim.Count(values[3], 0, entry.Points or 0, 0.8, "%d", token)
	end
	-- (sin animación: cifras finales)
	function api.Final()
		values[1].Text = tostring(entry.Kills or 0)
		values[2].Text = tostring(entry.Assists or 0)
		values[3].Text = tostring(entry.Points or 0)
	end
	local _ = plateText
	return api
end

return MVPCard
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="169">
                  <Properties>
                    <string name="Name">OfferCard</string>
                    <string name="Source"><![CDATA[-- Oferta pequeña de después de la partida: "DOMINASTE CON PHANTOM-X · 9 BAJAS" y una skin que no
-- tienes para esa arma, con VER (la previsualización 3D) y ✕. Sale de vez en cuando (ver
-- MonetizationConfig.PostMatchOffer), entra suave por la derecha y se quita con un toque. Nada de
-- relojes ni de "última oportunidad".
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Weapons = require(ReplicatedStorage:WaitForChild("Shared").Weapons)

local Flow = script.Parent.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Icons = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Icons"))
local Transition = require(Flow.Transition)
local ItemArt = require(Flow.Store.ItemArt)
local ItemCard = require(Flow.Store.ItemCard)

local Colors = Theme.Colors

local OfferCard = {}
OfferCard.Current = nil :: any -- (la oferta que se ve)

-- callbacks = { OnView(offer), OnClose() }
function OfferCard.new(parent, callbacks)
	local root = C.panel({ Name = "OfferCard", Size = UDim2.fromOffset(330, 84), Parent = parent }, { Alpha = 0.12, StrokeColor = Colors.Yellow, StrokeAlpha = 0.6 })
	root.Visible = false
	local holder = C.new("Frame", { Name = "Thumb", BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 8), Size = UDim2.fromOffset(96, 68), Parent = root })
	local title = C.text({ Name = "OfferTitle", Text = "", Role = "TitleItalic", TextSize = 16, Color = Colors.YellowText, Scaled = true, Position = UDim2.fromOffset(112, 8), Size = UDim2.new(1, -150, 0, 20), Parent = root })
	local sub = C.text({ Name = "OfferSub", Text = "", Role = "Body", TextSize = 12, Color = Colors.Text, Scaled = true, Position = UDim2.fromOffset(112, 30), Size = UDim2.new(1, -150, 0, 16), Parent = root })
	local view = C.button({ Name = "View", Text = "VER", Icon = Icons.Eye, Style = "Ghost", TextSize = 14, Position = UDim2.fromOffset(112, 50), Size = UDim2.fromOffset(110, 28), Parent = root, OnClick = function()
		if root:GetAttribute("Shown") then
			callbacks.OnView(OfferCard.Current)
		end
	end })
	local _ = view
	C.button({ Name = "Close", Text = "✕", Style = "Ghost", TextSize = 16, Anchor = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 6), Size = UDim2.fromOffset(32, 32), Parent = root, Sound = "Back", OnClick = function()
		root.Visible = false
		if callbacks.OnClose then
			callbacks.OnClose()
		end
	end })
	local api = { Frame = root }
	function api.Show(offer)
		OfferCard.Current = offer
		for _, child in holder:GetChildren() do
			child:Destroy()
		end
		if not offer then
			root.Visible = false
			root:SetAttribute("Shown", nil)
			return
		end
		local weapon = Weapons.Get(offer.Weapon)
		local weaponName = weapon and weapon.DisplayName or tostring(offer.Weapon)
		ItemArt.Backdrop(holder, offer.Item.Rarity, { Size = UDim2.fromScale(1, 1) })
		ItemArt.Weapon(holder, offer.Weapon, offer.Item.Id, { Size = UDim2.fromScale(0.94, 0.9), Position = UDim2.fromScale(0.03, 0.05), ZIndex = 2 })
		title.Text = "DOMINASTE CON " .. C.upper(weaponName)
		sub.Text = offer.Kills .. " bajas · " .. offer.Item.Name .. " · " .. ItemCard.PriceText(offer.Item)
		root.Visible = true
		root:SetAttribute("Shown", true)
		Transition.SlideIn(root, Vector2.new(60, 0), 0.3)
	end
	function api.Layout(phone)
		root.Size = UDim2.fromOffset(phone and 300 or 330, phone and 76 or 84)
	end
	return api
end

return OfferCard
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="170">
                  <Properties>
                    <string name="Name">PlayerResultCard</string>
                    <string name="Source"><![CDATA[-- Tarjeta pequeña debajo de cada personaje: puesto, nombre, bajas, asistencias y puntos. Marco azul
-- (tu equipo) o rojo (rival); la tuya con el nombre en amarillo. El 👍 de reconocimiento solo sale si
-- existe el sistema (GameConfig.ResultsHonor): hoy no lo hay, así que no se enseña.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))

local Flow = script.Parent.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local UISound = require(Flow.UISound)
local ItemArt = require(Flow.Store.ItemArt)

local Colors = Theme.Colors
local ALLY = Color3.fromRGB(70, 160, 255)
local ENEMY = Color3.fromRGB(240, 70, 70)

local PlayerResultCard = {}

-- Una cifra con su nombre debajo ("18" / "KILLS")
local function stat(parent, name, x, width)
	local value = C.text({ Name = name .. "Value", Text = "0", Role = "Number", TextSize = 19, AlignX = Enum.TextXAlignment.Center, Position = UDim2.new(x, 0, 0, 34), Size = UDim2.new(width, 0, 0, 22), Parent = parent })
	C.text({ Name = name, Text = name, Role = "Title", TextSize = 13, Color = Colors.TextDim, AlignX = Enum.TextXAlignment.Center, Position = UDim2.new(x, 0, 0, 56), Size = UDim2.new(width, 0, 0, 14), Parent = parent })
	return value
end

-- opts = { Rank, Entry, Enemy, Me, OnHonor }
function PlayerResultCard.new(parent, opts)
	local color = opts.Enemy and ENEMY or ALLY
	local card = C.new("Frame", {
		Name = "PlayerCard",
		BackgroundColor3 = Colors.Bg,
		BackgroundTransparency = 0.18,
		BorderSizePixel = 0,
		Position = UDim2.new(),
		Size = UDim2.fromOffset(176, 80),
		LayoutOrder = opts.Order or 0,
		Parent = parent,
	}, {
		C.corner(4),
		C.stroke(color, 1.5, 0.25),
		-- (raya de color abajo)
		C.new("Frame", { Name = "Bottom", BackgroundColor3 = color, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 3) }),
	})
	-- Su tarjeta de jugador de fondo (si lleva una)
	if opts.Entry and opts.Entry.Card and opts.Entry.Card ~= "Default" then
		local art = ItemArt.Card(card, opts.Entry.Card, { Name = "CardArt", Size = UDim2.fromScale(1, 1), ZIndex = 0, BackgroundTransparency = 0.25 })
		local emblem = art:FindFirstChild("Emblem")
		if emblem then
			emblem.TextTransparency = 0.6
		end
	end
	local badge = C.new("Frame", { Name = "Rank", BackgroundColor3 = color, BorderSizePixel = 0, Position = UDim2.fromOffset(6, 6), Size = UDim2.fromOffset(24, 24), Parent = card }, { C.corner(3) })
	C.text({ Text = tostring(opts.Rank or ""), Role = "TitleItalic", TextSize = 17, Color = Colors.White, AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = badge })
	local entry = opts.Entry
	local name = C.text({ Name = "PlayerName", Text = (entry.Bot and "🤖 " or "") .. C.short(entry.Name, 14), Role = "Title", TextSize = 17, Color = opts.Me and Colors.YellowText or Colors.White, Scaled = true, Position = UDim2.fromOffset(36, 6), Size = UDim2.new(1, -44, 0, 24), Parent = card })
	local kills = stat(card, "KILLS", 0, 0.3)
	local assists = stat(card, "ASIST.", 0.3, 0.3)
	local points = stat(card, "PUNTOS", 0.6, 0.4)
	kills.Text = tostring(entry.Kills or 0)
	assists.Text = tostring(entry.Assists or 0)
	points.Text = tostring(entry.Points or 0)
	-- Reconocimiento (preparado; oculto si no hay sistema detrás)
	if GameConfig.ResultsHonor == true and opts.OnHonor and not opts.Me and not entry.Bot then
		local honor = C.new("TextButton", { Name = "Honor", Text = "👍", TextSize = 15, Font = Enum.Font.GothamBold, TextColor3 = Colors.White, BackgroundColor3 = Colors.PanelLight, AutoButtonColor = false, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 6), Size = UDim2.fromOffset(24, 24), Parent = card }, { C.corner(3) })
		name.Size = UDim2.new(1, -72, 0, 24)
		honor.Activated:Connect(function()
			UISound.Play("Click")
			honor.BackgroundColor3 = Colors.Yellow
			honor.Active = false
			opts.OnHonor(entry)
		end)
	end
	return { Frame = card, Name = name }
end

return PlayerResultCard
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="171">
                  <Properties>
                    <string name="Name">ResultActions</string>
                    <string name="Source"><![CDATA[-- Acciones de abajo: VER MARCADOR (secundaria), ⌂ VOLVER AL LOBBY (grafito) y ▶ JUGAR DE NUEVO
-- (amarillo, la dominante). Como el servidor ya te mete en la siguiente partida, JUGAR DE NUEVO te
-- lleva a buscarla al momento (con la votación del mapa) y, si no tocas nada, se hace solo al acabar
-- la pantalla final: "SIGUIENTE PARTIDA EN 8 s", con CANCELAR para quedarte mirando.
local Flow = script.Parent.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Icons = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Icons"))
local Transition = require(Flow.Transition)

local Colors = Theme.Colors

local ResultActions = {}

-- callbacks = { OnScoreboard, OnLobby, OnPlay, OnCancelAuto }
function ResultActions.new(parent, callbacks)
	local root = C.new("Frame", { Name = "ResultActions", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 64), Parent = parent })
	local board = C.button({ Name = "Scoreboard", Text = "VER MARCADOR", Icon = Icons.Clipboard, Style = "Ghost", TextSize = 18, Position = UDim2.fromOffset(0, 8), Size = UDim2.fromOffset(230, 52), Parent = root, OnClick = function()
		callbacks.OnScoreboard()
	end })
	local play = C.button({ Name = "PlayAgain", Text = "JUGAR DE NUEVO", Icon = "▶", Sub = "", Style = "Primary", TextSize = 28, Anchor = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(340, 64), Parent = root, OnClick = function()
		callbacks.OnPlay()
	end })
	local lobby = C.button({ Name = "Lobby", Text = "VOLVER AL LOBBY", Icon = Icons.Home, Style = "Ghost", TextSize = 17, Anchor = Vector2.new(1, 0), Position = UDim2.new(1, -352, 0, 8), Size = UDim2.fromOffset(240, 52), Parent = root, Sound = "Back", OnClick = function()
		callbacks.OnLobby()
	end })
	lobby.BackgroundColor3 = Colors.Panel
	local cancel = C.button({ Name = "CancelAuto", Text = "CANCELAR", Icon = "✕", Style = "Ghost", TextSize = 14, Anchor = Vector2.new(1, 0), Position = UDim2.new(1, -352, 0, 8), Size = UDim2.fromOffset(120, 52), Parent = root, Sound = "Back", OnClick = function()
		callbacks.OnCancelAuto()
	end })
	local sub = play:FindFirstChild("Sub", true)
	local compact = false
	local api = { Frame = root, Play = play, Lobby = lobby, Board = board, Cancel = cancel }
	-- Cuenta atrás hasta la siguiente partida (nil: sin automático)
	function api.SetCountdown(seconds)
		if sub then
			local left = seconds and math.max(0, math.ceil(seconds))
			sub.Text = left and string.format(compact and "SIGUIENTE EN %d s" or "SIGUIENTE PARTIDA EN %d s", left) or "BUSCAR LA SIGUIENTE PARTIDA"
		end
		cancel.Visible = seconds ~= nil
		-- (sin CANCELAR, VOLVER AL LOBBY se arrima a JUGAR DE NUEVO)
		lobby.Position = UDim2.new(1, cancel.Visible and (compact and -352 or -484) or (compact and -262 or -352), 0, compact and 6 or 8)
	end
	function api.Show()
		root.Visible = true
		Transition.SlideIn(root, Vector2.new(0, 40), 0.3)
		Transition.Pulse(play, 1.08, 0.3)
	end
	function api.Layout(phone)
		board.Size = UDim2.fromOffset(phone and 150 or 230, phone and 44 or 52)
		lobby.Size = UDim2.fromOffset(phone and 170 or 240, phone and 44 or 52)
		play.Size = UDim2.fromOffset(phone and 250 or 340, phone and 56 or 64)
		compact = phone
		cancel.Size = UDim2.fromOffset(phone and 84 or 120, phone and 44 or 52)
		cancel.Position = UDim2.new(1, phone and -262 or -352, 0, phone and 6 or 8)
		lobby.Position = UDim2.new(1, cancel.Visible and (phone and -352 or -484) or (phone and -262 or -352), 0, phone and 6 or 8)
		local cancelLabel = cancel:FindFirstChild("Label", true)
		if cancelLabel then
			cancelLabel.Text = phone and "" or "CANCELAR" -- (en el teléfono basta la ✕)
		end
		root.Size = UDim2.new(1, 0, 0, phone and 56 or 64)
		local label = board:FindFirstChild("Label", true)
		if label then
			label.Text = phone and "MARCADOR" or "VER MARCADOR"
		end
	end
	return api
end

return ResultActions
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="172">
                  <Properties>
                    <string name="Name">ResultHeader</string>
                    <string name="Source"><![CDATA[-- Cabecera de la pantalla final: "5V5 · DUELO POR EQUIPOS / MAPA: X", el VICTORIA / DERROTA enorme
-- (blanco con brillo azul si ganas; gris con un toque rojo si pierdes: sin dramatismo) y el motivo
-- del final que manda el servidor (LÍMITE DE PUNTOS ALCANZADO, BOMBA DESACTIVADA...).
local Flow = script.Parent.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Transition = require(Flow.Transition)

local Colors = Theme.Colors

local ResultHeader = {}

local TITLES = { Victory = "VICTORIA", Defeat = "DERROTA", Draw = "EMPATE" }

-- "LÍMITE DE PUNTOS" → "L Í M I T E   D E   P U N T O S" (por caracteres UTF-8: las tildes enteras)
function ResultHeader.Spaced(text)
	local chars = {}
	for _, code in utf8.codes(text) do
		table.insert(chars, utf8.char(code))
	end
	return table.concat(chars, " ")
end

function ResultHeader.new(parent)
	local root = C.new("Frame", { Name = "ResultHeader", BackgroundTransparency = 1, Size = UDim2.fromOffset(640, 190), Parent = parent })
	-- Etiqueta de modo y mapa (barra amarilla a la izquierda)
	local tag = C.new("Frame", { Name = "ModeTag", BackgroundColor3 = Colors.Bg, BackgroundTransparency = 0.35, BorderSizePixel = 0, Position = UDim2.new(), Size = UDim2.fromOffset(330, 44), Parent = root }, {
		C.new("Frame", { BackgroundColor3 = Colors.Yellow, BorderSizePixel = 0, Size = UDim2.new(0, 3, 1, 0) }),
	})
	local modeLabel = C.text({ Name = "Mode", Text = "", Role = "TitleItalic", TextSize = 17, Position = UDim2.fromOffset(12, 3), Size = UDim2.new(1, -18, 0, 20), Parent = tag })
	local mapLabel = C.text({ Name = "Map", Text = "", Role = "Title", TextSize = 13, Color = Colors.TextDim, Position = UDim2.fromOffset(12, 23), Size = UDim2.new(1, -18, 0, 17), Parent = tag })
	-- Título enorme
	local title = C.text({ Name = "Title", Text = "", Role = "TitleItalic", TextSize = 118, Color = Colors.White, Position = UDim2.fromOffset(-4, 42), Size = UDim2.new(1, 0, 0, 116), Parent = root })
	title.TextScaled = true
	C.new("UITextSizeConstraint", { MaxTextSize = 118, MinTextSize = 40, Parent = title })
	local stroke = C.new("UIStroke", { Thickness = 3, Color = Color3.fromRGB(4, 12, 30), Transparency = 0.15, Parent = title })
	local gradient = C.new("UIGradient", { Rotation = 90, Parent = title })
	-- Raya de acento y motivo
	local bar = C.new("Frame", { Name = "Accent", BorderSizePixel = 0, Position = UDim2.fromOffset(2, 160), Size = UDim2.fromOffset(420, 3), Parent = root }, {
		C.new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.7, 0.3), NumberSequenceKeypoint.new(1, 1) }) }),
	})
	local reason = C.text({ Name = "Reason", Text = "", Role = "TitleItalic", TextSize = 21, Color = Colors.Text, Position = UDim2.fromOffset(4, 165), Size = UDim2.new(1, 0, 0, 24), Stroke = 1, Parent = root })

	local api = { Frame = root, Title = title, Reason = reason, Tag = tag }
	function api.Set(view)
		modeLabel.Text = (view.TeamMode and "5V5  ·  " or "") .. C.upper(view.ModeName)
		mapLabel.Text = "MAPA: " .. C.upper(view.Map)
		title.Text = TITLES[view.Outcome] or "FIN"
		-- (letras separadas: se lee como un rótulo)
		reason.Text = ResultHeader.Spaced(view.Reason or "")
		if view.Outcome == "Victory" then
			gradient.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
				ColorSequenceKeypoint.new(0.55, Color3.fromRGB(226, 238, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 175, 255)),
			})
			stroke.Color = Color3.fromRGB(6, 22, 60)
			bar.BackgroundColor3 = Colors.Blue
		elseif view.Outcome == "Defeat" then
			gradient.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(232, 232, 236)),
				ColorSequenceKeypoint.new(0.6, Color3.fromRGB(196, 196, 204)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(205, 110, 110)),
			})
			stroke.Color = Color3.fromRGB(34, 10, 12)
			bar.BackgroundColor3 = Color3.fromRGB(190, 60, 60)
		else
			gradient.Color = ColorSequence.new(Color3.fromRGB(240, 240, 244), Color3.fromRGB(190, 192, 200))
			stroke.Color = Colors.Black
			bar.BackgroundColor3 = Colors.TextDim
		end
	end
	-- Entrada: el título cae grande y se asienta; luego el motivo
	function api.Play()
		root.Visible = true
		Transition.SlideIn(tag, Vector2.new(-40, 0), 0.3)
		Transition.Pop(title, 1.7, 0.32)
		bar.Size = UDim2.fromOffset(0, 3)
		Transition.Tween(bar, 0.45, { Size = UDim2.fromOffset(420, 3) })
		reason.TextTransparency = 1
		task.delay(0.22, function()
			Transition.Tween(reason, 0.3, { TextTransparency = 0 })
		end)
	end
	function api.Layout(phone)
		root.Size = UDim2.fromOffset(phone and 460 or 640, phone and 132 or 190)
		title.Position = UDim2.fromOffset(-3, phone and 36 or 42)
		title.Size = UDim2.new(1, 0, 0, phone and 74 or 116)
		bar.Position = UDim2.fromOffset(2, phone and 110 or 160)
		reason.Position = UDim2.fromOffset(4, phone and 113 or 165)
		reason.TextSize = phone and 15 or 21
		tag.Size = UDim2.fromOffset(phone and 260 or 330, phone and 34 or 44)
		modeLabel.TextSize = phone and 14 or 17
		mapLabel.Position = UDim2.fromOffset(12, phone and 18 or 23)
		mapLabel.TextSize = phone and 11 or 13
	end
	return api
end

return ResultHeader
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="173">
                  <Properties>
                    <string name="Name">RewardsPanel</string>
                    <string name="Source"><![CDATA[-- RECOMPENSAS: lo que el servidor ha dado de verdad en esta partida (MatchSummary): XP, monedas (las
-- de jugar más retos, pase y maestría) y cajas; y el rango (+RP / −RP) porque todas las partidas
-- cuentan para el rango. Cada premio entra con un salto, su contador y su sonido. Sin premios: no sale.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Ranks = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Ranks"))

local Flow = script.Parent.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local UISound = require(Flow.UISound)
local Anim = require(script.Parent.Parent.Anim)

local Colors = Theme.Colors
local DARK = Color3.fromRGB(16, 14, 8)

local RewardsPanel = {}

-- Icono hecho con piezas (sin imágenes): rombo amarillo "XP", moneda redonda, caja
local function icon(parent, kind)
	local holder = C.new("Frame", { Name = "Icon", BackgroundTransparency = 1, Size = UDim2.fromOffset(40, 40), Parent = parent })
	if kind == "XP" then
		local diamond = C.new("Frame", { BackgroundColor3 = Colors.Yellow, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(28, 28), Rotation = 45, Parent = holder }, {
			C.corner(5),
			C.new("UIGradient", { Rotation = 45, Color = ColorSequence.new(Color3.fromRGB(255, 236, 120), Colors.YellowDark) }),
			C.stroke(Color3.fromRGB(120, 80, 0), 1.5, 0.2),
		})
		local _ = diamond
		C.text({ Text = "XP", Role = "TitleItalic", TextSize = 15, Color = DARK, AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = holder })
	elseif kind == "Coins" then
		C.new("Frame", { BackgroundColor3 = Colors.Yellow, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(34, 34), Parent = holder }, {
			C.corner(17),
			C.new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(255, 232, 110), Color3.fromRGB(214, 140, 0)) }),
			C.stroke(Color3.fromRGB(140, 90, 0), 2, 0.1),
		})
		C.text({ Text = "💰", TextSize = 18, AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = holder })
	elseif kind == "Pass" then
		-- Medalla del pase: escudo dorado
		C.new("Frame", { BackgroundColor3 = Color3.fromRGB(255, 200, 60), BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(30, 34), Parent = holder }, {
			C.corner(6),
			C.new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(255, 230, 120), Color3.fromRGB(200, 120, 0)) }),
			C.stroke(Color3.fromRGB(120, 70, 0), 1.5, 0.2),
		})
		C.text({ Text = "★", Role = "Title", TextSize = 18, Color = DARK, AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = holder })
	else
		C.new("Frame", { BackgroundColor3 = Color3.fromRGB(110, 70, 40), BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.55), Size = UDim2.fromOffset(34, 26), Parent = holder }, {
			C.corner(3),
			C.stroke(Colors.Yellow, 1.5, 0.3),
			C.new("Frame", { BackgroundColor3 = Colors.Yellow, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.new(0, 6, 1, 0) }),
		})
	end
	return holder
end

function RewardsPanel.new(parent)
	local root = C.panel({ Name = "RewardsPanel", Size = UDim2.fromOffset(460, 112), Parent = parent }, { Alpha = 0.16, StrokeColor = Colors.Yellow, StrokeAlpha = 0.45 })
	C.text({ Name = "Title", Text = "RECOMPENSAS", Role = "TitleItalic", TextSize = 17, Position = UDim2.fromOffset(14, 6), Size = UDim2.fromOffset(200, 22), Parent = root })
	local rankLabel = C.text({ Name = "Rank", Text = "", Role = "Title", TextSize = 14, Rich = true, AlignX = Enum.TextXAlignment.Right, Anchor = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 8), Size = UDim2.fromOffset(220, 20), Parent = root })
	local row = C.new("Frame", { Name = "Items", BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 34), Size = UDim2.new(1, -20, 0, 70), Parent = root }, {
		C.list(8, Enum.FillDirection.Horizontal),
	})
	local items = {}
	local api = { Frame = root }

	function api.Set(rewards, summary)
		for _, item in items do
			item.Frame:Destroy()
		end
		table.clear(items)
		for i, reward in rewards or {} do
			local cell = C.new("Frame", { Name = "Reward_" .. reward.Kind, BackgroundColor3 = Colors.PanelLight, BackgroundTransparency = 0.35, BorderSizePixel = 0, Size = UDim2.new(1 / math.max(3, #(rewards or {})), -6, 1, 0), LayoutOrder = i, Visible = false, Parent = row }, { C.corner(4) })
			local ic = icon(cell, reward.Kind)
			ic.Position = UDim2.fromOffset(8, 15)
			local amount = C.text({ Name = "Amount", Text = "+0", Role = "TitleItalic", TextSize = 24, Color = Colors.White, Position = UDim2.fromOffset(52, 8), Size = UDim2.new(1, -56, 0, 30), Scaled = true, Parent = cell })
			C.text({ Name = "Label", Text = reward.Label, Role = "Title", TextSize = 11, Color = Colors.TextDim, Position = UDim2.fromOffset(52, 38), Size = UDim2.new(1, -56, 0, 16), Scaled = true, Parent = cell })
			table.insert(items, { Frame = cell, Amount = amount, Reward = reward })
		end
		local startRank = summary and tonumber(summary.StartRank)
		local endRank = summary and tonumber(summary.RankPoints)
		rankLabel.Text = ""
		-- (solo si la partida ha movido el rango: +RP al ganar, −RP al perder)
		if startRank and endRank and endRank ~= startRank then
			local tier = Ranks.Get(endRank)
			local delta = endRank - startRank
			local deltaText = delta > 0 and ('<font color="#6EE06E">+' .. delta .. " RP</font>") or (delta < 0 and ('<font color="#FF7A7A">' .. delta .. " RP</font>") or "")
			rankLabel.Text = string.format('%s <font color="#%s">%s</font>  %s', tier.Icon, tier.Color:ToHex(), C.upper(tier.Name), deltaText)
		end
		root.Visible = #items > 0 or rankLabel.Text ~= ""
	end

	-- Uno tras otro: salto, contador y sonido
	function api.Play(token)
		for i, item in items do
			task.delay((i - 1) * 0.22, function()
				if not Anim.Alive(token) then
					return
				end
				Anim.Pop(item.Frame, 0.6, 0.22)
				UISound.Play("RewardPop", 1 + i * 0.08)
				Anim.Glow(item.Frame, Colors.Yellow, 0.35, 0.4)
				local format = item.Reward.Kind == "Crate" and "+%d" or "+%d"
				Anim.Count(item.Amount, 0, item.Reward.Amount, 0.6, format, token, "Tick")
			end)
		end
	end
	function api.Final()
		for _, item in items do
			item.Frame.Visible = true
			item.Amount.Text = "+" .. tostring(item.Reward.Amount)
		end
	end
	function api.Layout(phone)
		root.Size = UDim2.fromOffset(phone and 360 or 460, phone and 92 or 112)
		row.Size = UDim2.new(1, -20, 0, phone and 52 or 70)
	end
	return api
end

return RewardsPanel
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="174">
                  <Properties>
                    <string name="Name">ScoreDisplay</string>
                    <string name="Source"><![CDATA[-- Marcador principal: "100 TU EQUIPO | 72 EQUIPO ENEMIGO" (azul y rojo) con los números contando
-- desde 0. En los modos de pocas rondas (Buscar y destruir: 4-2) van de uno en uno. En todos contra
-- todos: tus bajas y las del líder (o del segundo, si el líder eres tú).
local Flow = script.Parent.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Transition = require(Flow.Transition)
local Anim = require(script.Parent.Parent.Anim)

local Colors = Theme.Colors
local ALLY = Color3.fromRGB(70, 160, 255)
local ENEMY = Color3.fromRGB(240, 70, 70)

local ScoreDisplay = {}

function ScoreDisplay.new(parent)
	local root = C.new("Frame", {
		Name = "ScoreDisplay",
		BackgroundColor3 = Colors.Bg,
		BackgroundTransparency = 0.22,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(420, 118),
		Parent = parent,
	}, { C.corner(6), C.stroke(Colors.Line, 1, 0.85) })
	-- Mitades con un degradado de su color
	local function half(xScale, color)
		local frame = C.new("Frame", { BackgroundColor3 = color, BackgroundTransparency = 0.78, BorderSizePixel = 0, Position = UDim2.fromScale(xScale, 0), Size = UDim2.fromScale(0.5, 1), Parent = root }, {
			C.corner(6),
			C.new("UIGradient", { Rotation = xScale == 0 and 0 or 180, Transparency = NumberSequence.new(0, 1) }),
		})
		return frame
	end
	half(0, ALLY)
	half(0.5, ENEMY)
	local mine = C.text({ Name = "MyScore", Text = "0", Role = "TitleItalic", TextSize = 72, Color = Color3.fromRGB(150, 205, 255), AlignX = Enum.TextXAlignment.Center, Position = UDim2.fromScale(0, 0.04), Size = UDim2.new(0.5, 0, 0, 76), Stroke = 2, Parent = root })
	local enemy = C.text({ Name = "EnemyScore", Text = "0", Role = "TitleItalic", TextSize = 72, Color = Color3.fromRGB(255, 120, 120), AlignX = Enum.TextXAlignment.Center, Position = UDim2.fromScale(0.5, 0.04), Size = UDim2.new(0.5, 0, 0, 76), Stroke = 2, Parent = root })
	local myLabel = C.text({ Name = "MyLabel", Text = "TU EQUIPO", Role = "Title", TextSize = 17, Color = ALLY, AlignX = Enum.TextXAlignment.Center, Position = UDim2.new(0, 0, 1, -32), Size = UDim2.new(0.5, 0, 0, 22), Parent = root })
	local enemyLabel = C.text({ Name = "EnemyLabel", Text = "EQUIPO ENEMIGO", Role = "Title", TextSize = 17, Color = ENEMY, AlignX = Enum.TextXAlignment.Center, Position = UDim2.new(0.5, 0, 1, -32), Size = UDim2.new(0.5, 0, 0, 22), Parent = root })
	C.new("Frame", { Name = "Divider", BackgroundColor3 = Colors.White, BackgroundTransparency = 0.7, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 2, 0.62, 0), Parent = root })
	local vs = C.text({ Name = "VS", Text = "VS", Role = "TitleItalic", TextSize = 18, Color = Colors.TextDim, AlignX = Enum.TextXAlignment.Center, Anchor = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(40, 24), Parent = root })
	vs.BackgroundColor3 = Colors.Bg
	vs.BackgroundTransparency = 0

	local view
	local api = { Frame = root }
	function api.Set(v)
		view = v
		mine.Text = "0"
		enemy.Text = "0"
		if v.TeamMode then
			myLabel.Text = "TU EQUIPO"
			enemyLabel.Text = "EQUIPO ENEMIGO"
		else
			myLabel.Text = "TUS BAJAS"
			enemyLabel.Text = (v.Allies[1] and v.Allies[1].Id == v.Me.Id) and "2.º PUESTO" or "LÍDER"
		end
	end
	function api.Play(token)
		Transition.SlideIn(root, Vector2.new(60, 0), 0.3)
		local time = view.SmallScore and 0.6 or 0.9
		Anim.Count(mine, 0, view.MyScore or 0, time, "%d", token, "Tick")
		Anim.Count(enemy, 0, view.EnemyScore or 0, time, "%d", token, nil)
		-- El ganador late al acabar de contar
		task.delay(time + 0.05, function()
			if not Anim.Alive(token) then
				return
			end
			if view.Outcome == "Victory" then
				Transition.Pulse(mine, 1.18, 0.25)
			elseif view.Outcome == "Defeat" then
				Transition.Pulse(enemy, 1.12, 0.25)
			end
		end)
	end
	function api.Layout(phone)
		root.Size = UDim2.fromOffset(phone and 300 or 420, phone and 84 or 118)
		for _, label in { mine, enemy } do
			label.TextSize = phone and 48 or 72
			label.Size = UDim2.new(0.5, 0, 0, phone and 52 or 76)
		end
		for _, label in { myLabel, enemyLabel } do
			label.TextSize = phone and 13 or 17
			label.Position = UDim2.new(label.Position.X.Scale, 0, 1, phone and -24 or -32)
		end
	end
	return api
end

return ScoreDisplay
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="175">
                  <Properties>
                    <string name="Name">ScoreboardPanel</string>
                    <string name="Source"><![CDATA[-- VER MARCADOR: la tabla completa en una ventana encima (lo detallado no compite con el momento de la
-- victoria). TU EQUIPO en azul y EQUIPO ENEMIGO en rojo, cada uno ordenado por puntos: puesto,
-- nombre, PUNTOS, KILLS, ASIST., MUERTES; el MVP con su placa y tu fila resaltada. Sin equipos, una
-- sola tabla con todos.
local Flow = script.Parent.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Transition = require(Flow.Transition)

local Colors = Theme.Colors
local ALLY = Color3.fromRGB(70, 160, 255)
local ENEMY = Color3.fromRGB(240, 70, 70)
local DARK = Color3.fromRGB(16, 14, 8)

local ScoreboardPanel = {}

local COLUMNS = { { "PUNTOS", "Points", 0.16 }, { "KILLS", "Kills", 0.12 }, { "ASIST.", "Assists", 0.12 }, { "MUERTES", "Deaths", 0.14 } }

local function table_(parent, title, color, entries, view, order)
	local panel = C.new("Frame", { Name = "Table_" .. title, BackgroundColor3 = Colors.Bg, BackgroundTransparency = 0.12, BorderSizePixel = 0, Size = UDim2.new(0.5, -6, 1, 0), LayoutOrder = order, Parent = parent }, {
		C.corner(5),
		C.stroke(color, 1.5, 0.3),
	})
	local head = C.new("Frame", { Name = "Head", BackgroundColor3 = color, BackgroundTransparency = 0.25, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 40), Parent = panel }, {
		C.corner(5),
		C.new("UIGradient", { Transparency = NumberSequence.new(0, 0.7) }),
	})
	C.text({ Text = title, Role = "TitleItalic", TextSize = 20, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(0.44, -14, 1, 0), Parent = head })
	local x = 0.46
	for _, col in COLUMNS do
		C.text({ Text = col[1], Role = "Title", TextSize = 12, Color = Colors.Text, AlignX = Enum.TextXAlignment.Center, Position = UDim2.new(x, 0, 0, 0), Size = UDim2.new(col[3], 0, 1, 0), Parent = head })
		x += col[3]
	end
	local list = C.new("Frame", { Name = "Rows", BackgroundTransparency = 1, Position = UDim2.fromOffset(4, 44), Size = UDim2.new(1, -8, 1, -48), Parent = panel }, { C.list(2) })
	for i, entry in entries do
		if i > 10 then
			break
		end
		local me = entry.Id == view.Me.Id
		local row = C.new("Frame", { Name = "Row", BackgroundColor3 = me and color or Colors.PanelLight, BackgroundTransparency = me and 0.55 or (i % 2 == 0 and 0.75 or 0.6), BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = i, Parent = list }, { C.corner(3) })
		C.text({ Text = tostring(i), Role = "TitleItalic", TextSize = 18, Color = Colors.TextDim, AlignX = Enum.TextXAlignment.Center, Size = UDim2.new(0, 34, 1, 0), Parent = row })
		local nameLabel = C.text({ Text = (entry.Bot and "🤖 " or "") .. C.short(entry.Name, 22), Role = "Title", TextSize = 16, Color = me and Colors.YellowText or Colors.White, Position = UDim2.fromOffset(36, 0), Size = UDim2.new(0.46, -40, 1, 0), Parent = row })
		if entry.Id == view.MVP then
			nameLabel.Size = UDim2.new(0.46, -86, 1, 0)
			local mvp = C.new("Frame", { BackgroundColor3 = Colors.Yellow, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(0.46, -4, 0.5, 0), Size = UDim2.fromOffset(40, 20), Parent = row }, { C.corner(3) })
			C.text({ Text = "MVP", Role = "TitleItalic", TextSize = 13, Color = DARK, AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = mvp })
		end
		local cx = 0.46
		for _, col in COLUMNS do
			C.text({ Text = tostring(entry[col[2]] or 0), Role = "Number", TextSize = 16, Color = col[2] == "Points" and Colors.White or Colors.Text, AlignX = Enum.TextXAlignment.Center, Position = UDim2.new(cx, 0, 0, 0), Size = UDim2.new(col[3], 0, 1, 0), Parent = row })
			cx += col[3]
		end
	end
	return panel
end

function ScoreboardPanel.new(parent)
	local overlay = C.new("Frame", { Name = "Scoreboard", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.15, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 1, Parent = parent })
	-- (clic fuera: cerrar)
	local blocker = C.new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = overlay })
	local window = C.new("Frame", { Name = "Window", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -60, 0, 470), Parent = overlay })
	local title = C.text({ Name = "Title", Text = "MARCADOR", Role = "TitleItalic", TextSize = 34, Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, -150, 0, 40), Parent = window })
	local close = C.button({ Name = "Close", Text = "CERRAR", Icon = "✕", Style = "Ghost", TextSize = 15, Anchor = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(130, 38), Parent = window, Sound = "Back" })
	local tables = C.new("Frame", { Name = "Tables", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 1, -50), Parent = window }, {
		C.list(12, Enum.FillDirection.Horizontal),
	})
	local api = { Frame = overlay }
	function api.Set(view)
		for _, child in tables:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		title.Text = "MARCADOR  ·  " .. C.upper(view.ModeName) .. "  ·  " .. C.upper(view.Map)
		if view.TeamMode then
			table_(tables, "TU EQUIPO", ALLY, view.Allies, view, 1)
			table_(tables, "EQUIPO ENEMIGO", ENEMY, view.Enemies, view, 2)
		else
			local t = table_(tables, "CLASIFICACIÓN", ALLY, view.Allies, view, 1)
			t.Size = UDim2.fromScale(1, 1)
		end
	end
	function api.Open()
		overlay.Visible = true
		Transition.Pop(window, 0.94, 0.2)
	end
	function api.Close()
		overlay.Visible = false
	end
	function api.Layout(phone)
		window.Size = UDim2.new(1, phone and -24 or -60, 0, phone and 410 or 470)
	end
	blocker.Activated:Connect(api.Close)
	close.Activated:Connect(api.Close)
	return api
end

return ScoreboardPanel
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="176">
                  <Properties>
                    <string name="Name">UnlockCard</string>
                    <string name="Source"><![CDATA[-- DESBLOQUEO: solo si en esta partida se ha conseguido algo (arma por nivel, camuflaje de maestría,
-- skin/traje/efecto del pase). El arma o el camuflaje se ven en 3D; lo demás, con su icono. Entra
-- con un brillo que cruza y su sonido.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = script.Parent.Parent.Parent.Parent
local WeaponIcon = require(Modules.WeaponIcon)

local Flow = script.Parent.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local UISound = require(Flow.UISound)
local Anim = require(script.Parent.Parent.Anim)

local Colors = Theme.Colors

local UnlockCard = {}

local ICONS = { Skin = "🎨", Outfit = "🧥", KillEffect = "✨", Crate = "📦" }

function UnlockCard.new(parent)
	local root = C.panel({ Name = "UnlockCard", Size = UDim2.fromOffset(380, 96), Parent = parent }, { Alpha = 0.16, StrokeColor = Colors.Yellow, StrokeAlpha = 0.55 })
	local head = C.text({ Name = "Head", Text = "DESBLOQUEO", Role = "TitleItalic", TextSize = 16, Color = Colors.YellowText, Position = UDim2.fromOffset(14, 6), Size = UDim2.fromOffset(200, 20), Parent = root })
	local more = C.text({ Name = "More", Text = "", Role = "Title", TextSize = 12, Color = Colors.TextDim, AlignX = Enum.TextXAlignment.Right, Anchor = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 8), Size = UDim2.fromOffset(120, 18), Parent = root })
	local art = C.new("Frame", { Name = "Art", BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 26), Size = UDim2.new(0.48, -8, 1, -30), Parent = root })
	local name = C.text({ Name = "UnlockName", Text = "", Role = "TitleItalic", TextSize = 24, Scaled = true, Position = UDim2.new(0.5, 0, 0, 30), Size = UDim2.new(0.5, -12, 0, 30), Parent = root })
	local sub = C.text({ Name = "Sub", Text = "", Role = "Title", TextSize = 12, Color = Colors.TextDim, Wrap = true, Position = UDim2.new(0.5, 0, 0, 60), Size = UDim2.new(0.5, -12, 0, 30), Parent = root })
	local api = { Frame = root }
	function api.Set(unlocks)
		local first = unlocks and unlocks[1]
		root.Visible = first ~= nil
		if not first then
			return
		end
		art:ClearAllChildren()
		name.Text = C.upper(tostring(first.Name or ""))
		sub.Text = tostring(first.Sub or "")
		more.Text = #unlocks > 1 and ("+" .. (#unlocks - 1) .. " MÁS") or ""
		head.Text = #unlocks > 1 and "DESBLOQUEOS" or "DESBLOQUEO"
		if (first.Kind == "Weapon" or first.Kind == "Camo") and first.Id then
			pcall(WeaponIcon.Create, first.Id, first.Skin, { Name = "Weapon3D", Size = UDim2.fromScale(1, 1), Parent = art }, "angled", 2.2)
		else
			C.text({ Text = ICONS[first.Kind] or "🔓", TextSize = 40, AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = art })
		end
	end
	function api.Play(token)
		if not root.Visible then
			return
		end
		Anim.Pop(root, 0.85, 0.25)
		UISound.Play("Unlock")
		task.delay(0.1, function()
			if Anim.Alive(token) then
				Anim.Sheen(root, 0.7)
			end
		end)
	end
	local _ = ReplicatedStorage
	return api
end

return UnlockCard
]]></string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="177">
                  <Properties>
                    <string name="Name">XPProgress</string>
                    <string name="Source"><![CDATA[-- PROGRESO DE NIVEL: "NIVEL 42 · 350 / 1000 XP" y la barra que avanza con lo ganado. Si subes de
-- nivel: la barra se llena, destello dorado, "NIVEL 43" con su sonido (~1 s, sin bloquear nada) y
-- sigue con lo que sobra.
local Flow = script.Parent.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Transition = require(Flow.Transition)
local UISound = require(Flow.UISound)
local Anim = require(script.Parent.Parent.Anim)

local Colors = Theme.Colors
local DARK = Color3.fromRGB(16, 14, 8)

local XPProgress = {}

function XPProgress.new(parent)
	local root = C.panel({ Name = "XPProgress", Size = UDim2.fromOffset(380, 96), Parent = parent }, { Alpha = 0.16 })
	-- Insignia con el número de nivel (rombo amarillo)
	local badge = C.new("Frame", { Name = "Badge", BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 14), Size = UDim2.fromOffset(68, 68), Parent = root })
	C.new("Frame", { BackgroundColor3 = Color3.fromRGB(30, 26, 12), BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(46, 46), Rotation = 45, Parent = badge }, {
		C.corner(6),
		C.new("UIStroke", { Color = Colors.Yellow, Thickness = 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
	})
	local levelNumber = C.text({ Name = "LevelNumber", Text = "1", Role = "TitleItalic", TextSize = 26, Color = Colors.YellowText, AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = badge })
	local title = C.text({ Name = "Level", Text = "NIVEL 1", Role = "TitleItalic", TextSize = 22, Position = UDim2.fromOffset(92, 12), Size = UDim2.fromOffset(160, 26), Parent = root })
	local gained = C.text({ Name = "Gained", Text = "", Role = "TitleItalic", TextSize = 18, Color = Colors.YellowText, AlignX = Enum.TextXAlignment.Right, Anchor = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 14), Size = UDim2.fromOffset(120, 22), Parent = root })
	local bar = C.progress({ Name = "Bar", Position = UDim2.fromOffset(92, 46), Size = UDim2.new(1, -106, 0, 10), Parent = root })
	bar.Fill.BackgroundColor3 = Colors.Yellow
	local amount = C.text({ Name = "Amount", Text = "", Role = "Number", TextSize = 15, Color = Colors.TextDim, Position = UDim2.fromOffset(92, 62), Size = UDim2.new(1, -106, 0, 20), Parent = root })
	-- Aviso de subida de nivel (encima del panel)
	local levelUp = C.text({ Name = "LevelUp", Text = "", Role = "TitleItalic", TextSize = 30, Color = Colors.Yellow, AlignX = Enum.TextXAlignment.Center, Anchor = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, -4), Size = UDim2.fromOffset(300, 36), Stroke = 2, Visible = false, Parent = root })

	local info
	local api = { Frame = root }
	function api.Set(levelInfo)
		info = levelInfo
		root.Visible = info ~= nil
		-- (si saliste antes de que se desvaneciera, no aparece de entrada en la siguiente partida)
		levelUp.Visible = false
		levelUp.TextTransparency = 1
		if not info then
			return
		end
		levelNumber.Text = tostring(info.StartLevel)
		title.Text = "NIVEL " .. info.StartLevel
		gained.Text = info.Gained > 0 and ("+" .. info.Gained .. " XP") or ""
		bar:Set(info.Steps[1] and info.Steps[1].From or 0, false)
		amount.Text = string.format("%d / %d XP", info.StartXP, info.PerLevel)
	end

	function api.Play(token)
		if not info then
			return
		end
		task.spawn(function()
			for i, step in info.Steps do
				if not Anim.Alive(token) then
					return
				end
				local fromXP = math.floor(step.From * info.PerLevel)
				local toXP = math.floor(step.To * info.PerLevel)
				local time = math.clamp((step.To - step.From) * 1.1, 0.25, 0.9)
				bar:Set(step.From, false)
				Transition.Tween(bar.Fill, time, { Size = UDim2.fromScale(step.To, 1) })
				Anim.Count(amount, fromXP, toXP, time, "%d / " .. info.PerLevel .. " XP", token, nil)
				UISound.Play("Tick", 1.1)
				task.wait(time + 0.05)
				if step.LevelUp and Anim.Alive(token) then
					-- ¡Nivel nuevo! (breve)
					local newLevel = step.Level + 1
					UISound.Play("LevelUp")
					Anim.Glow(root, Colors.Yellow, 0.55, 0.6)
					levelNumber.Text = tostring(newLevel)
					title.Text = "NIVEL " .. newLevel
					Transition.Pulse(badge, 1.35, 0.35)
					levelUp.Text = "¡NIVEL " .. newLevel .. "!"
					levelUp.Visible = true
					levelUp.TextTransparency = 0
					Transition.Pop(levelUp, 1.6, 0.25)
					task.delay(1.1, function()
						if Anim.Alive(token) then
							Transition.Tween(levelUp, 0.3, { TextTransparency = 1 })
						end
					end)
					task.wait(0.45)
				end
				local _ = i
			end
		end)
	end
	function api.Final()
		if info then
			levelNumber.Text = tostring(info.EndLevel)
			title.Text = "NIVEL " .. info.EndLevel
			bar:Set(info.Steps[#info.Steps].To, false)
			amount.Text = string.format("%d / %d XP", info.EndXP, info.PerLevel)
		end
	end
	function api.Layout(phone)
		root.Size = UDim2.fromOffset(phone and 300 or 380, phone and 78 or 96)
		badge.Size = UDim2.fromOffset(phone and 54 or 68, phone and 54 or 68)
		badge.Position = UDim2.fromOffset(phone and 8 or 12, phone and 12 or 14)
	end
	local _ = DARK
	return api
end

return XPProgress
]]></string>
                  </Properties>
                </Item>
              </Item>
              <Item class="ModuleScript" referent="178">
                <Properties>
                  <string name="Name">Data</string>
                  <string name="Source"><![CDATA[-- Datos de la pantalla final a partir del MatchResult del servidor (Round.endRound → RoundEnd.Result)
-- y del resumen personal (MatchSummary). Aquí solo se ordena y se decide qué enseñar; nada se inventa:
-- si un dato no llega, su panel no sale.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MatchResults = require(Shared.MatchResults)

local player = Players.LocalPlayer

local Data = {}

Data.MyId = "u" .. tostring(player.UserId)

local function sorted(list)
	local copy = table.clone(list)
	table.sort(copy, MatchResults.Better)
	return copy
end

-- Prepara lo que pinta la pantalla. Devuelve nil si este jugador no jugó la partida
-- (p. ej. entró y siguió en el lobby): a él no se le enseña.
function Data.Build(result)
	if type(result) ~= "table" or type(result.Players) ~= "table" then
		return nil
	end
	local me
	for _, entry in result.Players do
		if entry.Id == Data.MyId then
			me = entry
		end
	end
	if not me then
		return nil
	end
	local view = {
		Raw = result,
		Me = me,
		Mode = result.Mode,
		ModeName = tostring(result.ModeName or ""),
		Map = tostring(result.Map or ""),
		TeamMode = result.TeamMode ~= false,
		Reason = MatchResults.ReasonText(result.Reason),
		ReasonCode = result.Reason,
		MVP = result.MVP,
	}
	if view.TeamMode then
		local myTeam = me.Team
		local enemyTeam = myTeam == result.TeamA and result.TeamB or result.TeamA
		view.MyTeam = myTeam
		view.EnemyTeam = enemyTeam
		view.MyScore = myTeam == result.TeamA and result.ScoreA or result.ScoreB
		view.EnemyScore = myTeam == result.TeamA and result.ScoreB or result.ScoreA
		view.Outcome = result.Winner == nil and "Draw" or (result.Winner == myTeam and "Victory" or "Defeat")
		local mine, enemies = {}, {}
		for _, entry in result.Players do
			if entry.Team == myTeam then
				table.insert(mine, entry)
			else
				table.insert(enemies, entry)
			end
		end
		view.Allies = sorted(mine)
		view.Enemies = sorted(enemies)
	else
		-- Todos contra todos: "tu equipo" es la clasificación entera; el marcador, tus puntos y los del líder
		local all = sorted(result.Players)
		view.Allies = all
		view.Enemies = {}
		local leader = all[1]
		local won = result.Winner ~= nil and (result.Winner == player.Name or (leader and leader.Id == Data.MyId))
		view.Outcome = result.Winner == nil and "Draw" or (won and "Victory" or "Defeat")
		view.MyScore = me.Kills
		view.EnemyScore = leader and leader.Id ~= Data.MyId and leader.Kills or (all[2] and all[2].Kills or 0)
	end
	-- En escena: los 5 primeros de tu equipo (el mejor en el centro: MVP o tu jugador destacado)
	view.Lineup = {}
	for i = 1, math.min(5, #view.Allies) do
		view.Lineup[i] = view.Allies[i]
	end
	view.Featured = view.Lineup[1]
	view.FeaturedIsMVP = view.Featured ~= nil and view.Featured.Id == result.MVP
	-- Marcador pequeño (S&D, Eliminación): sin contador largo
	view.SmallScore = math.max(tonumber(view.MyScore) or 0, tonumber(view.EnemyScore) or 0) <= 12
	return view
end

-- Recompensas que de verdad ha dado el servidor (MatchSummary): solo las que existen
function Data.Rewards(summary)
	if type(summary) ~= "table" then
		return nil
	end
	local list = {}
	local xp = tonumber(summary.XP) or 0
	if xp > 0 then
		table.insert(list, { Kind = "XP", Amount = xp, Label = "EXPERIENCIA" })
	end
	local coins = (tonumber(summary.Coins) or 0) + (tonumber(summary.BonusCoins) or 0)
	if coins > 0 then
		table.insert(list, { Kind = "Coins", Amount = coins, Label = "MONEDAS" })
	end
	local crates = tonumber(summary.Crates) or 0
	if crates > 0 then
		table.insert(list, { Kind = "Crate", Amount = crates, Label = crates == 1 and "CAJA GRATIS" or "CAJAS GRATIS" })
	end
	-- XP del pase de batalla (y si ha subido de nivel del pase)
	local passXP = tonumber(summary.PassXP) or 0
	if passXP > 0 then
		local per = math.max(1, tonumber(summary.PassXPPerTier) or 3000)
		local tiers = tonumber(summary.PassTiers) or 50
		local before = math.min(tiers, math.floor((tonumber(summary.PassStartXP) or 0) / per) + 1)
		local after = math.min(tiers, math.floor((tonumber(summary.PassNowXP) or 0) / per) + 1)
		table.insert(list, { Kind = "Pass", Amount = passXP, Label = after > before and ("PASE · ¡NIVEL " .. after .. "!") or ("PASE · NIVEL " .. after), TierUp = after > before })
	end
	return list
end

-- Oferta pequeña de después de la partida (MonetizationConfig.PostMatchOffer): solo según lo que
-- hiciste en la partida (el arma con la que más bajas hiciste) y como mucho una de cada pocas
-- partidas. Devuelve { Weapon, Kills, Item } o nil. owns(kind, id) dice si ya lo tienes.
function Data.PostMatchOffer(summary, config, items, owns)
	if type(summary) ~= "table" or not config or not config.Enabled then
		return nil
	end
	local matches = tonumber(summary.Matches) or 0
	local kills = tonumber(summary.TopWeaponKills) or 0
	if not summary.TopWeapon or matches < (config.MinMatches or 3) or kills < (config.MinWeaponKills or 6) then
		return nil
	end
	if matches % math.max(1, config.EveryMatches or 4) ~= 0 then
		return nil
	end
	-- Una skin que no tienes, para verla en esa arma (va cambiando de una oferta a la siguiente)
	local candidates = {}
	for _, item in items do
		if item.Kind == "Skin" and not owns(item.Kind, item.Id) then
			table.insert(candidates, item)
		end
	end
	if #candidates == 0 then
		return nil
	end
	local pick = candidates[(matches // math.max(1, config.EveryMatches or 4)) % #candidates + 1]
	return { Weapon = summary.TopWeapon, Kills = kills, Item = pick }
end

-- Progreso de nivel: tramos de la barra (uno por nivel subido) para animarla de verdad
function Data.LevelSteps(summary)
	if type(summary) ~= "table" then
		return nil
	end
	local per = math.max(1, tonumber(summary.XPPerLevel) or 1000)
	local startLevel = tonumber(summary.StartLevel) or tonumber(summary.Level) or 1
	local endLevel = tonumber(summary.Level) or startLevel
	local steps = {}
	local level = startLevel
	local from = (tonumber(summary.StartXP) or 0) / per
	while level < endLevel do
		table.insert(steps, { Level = level, From = from, To = 1, LevelUp = true })
		level += 1
		from = 0
	end
	table.insert(steps, { Level = level, From = from, To = math.clamp((tonumber(summary.LevelXP) or 0) / per, 0, 1) })
	return {
		Steps = steps,
		StartLevel = startLevel,
		EndLevel = endLevel,
		PerLevel = per,
		StartXP = tonumber(summary.StartXP) or 0,
		EndXP = tonumber(summary.LevelXP) or 0,
		Gained = tonumber(summary.XP) or 0,
	}
end

return Data
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="179">
                <Properties>
                  <string name="Name">PoseRig</string>
                  <string name="Source"><![CDATA[-- Poses de victoria e intros de MVP (Shared/Poses) sobre una copia de personaje (pantalla final,
-- vista previa de la tienda). Las poses se hacen por código con la misma cinemática inversa que la
-- pose de "arma lista" del lobby (Preview), así no hace falta subir animaciones; las intros de MVP son
-- piezas propias (sin partículas, para que también se vean dentro de un ViewportFrame) que se borran
-- solas. Solo estética.
--   PoseRig.Apply(model, poseId)                    -- pone la pose (con o sin arma)
--   local stop = PoseRig.PlayIntro(parent, model, introId)   -- intro de MVP (≈1 s)
local TweenService = game:GetService("TweenService")

local Preview = require(script.Parent.Parent.Preview)

local PoseRig = {}

local function hideWeapon(model)
	local tool = Preview.WeaponOf(model)
	if tool then
		tool:Destroy()
	end
end

local function torsoPoint(model, offset)
	local torso = model:FindFirstChild("UpperTorso")
	return torso and (torso.CFrame * offset).Position or nil
end

local RIGHT_POLE = CFrame.new(2.2, -1.6, 0.6)
local LEFT_POLE = CFrame.new(-1.6, -1.8, -0.4)

local function arm(model, side, offset, pole)
	local target = torsoPoint(model, offset)
	local torso = model:FindFirstChild("UpperTorso")
	if target and torso then
		pcall(Preview.SolveArm, model, side, nil, target, (torso.CFrame * pole).Position)
	end
end

-- Cada pose: qué hace con el arma y con los brazos (el personaje mira a su -Z)
PoseRig.Poses = {
	Ready = function(model)
		pcall(Preview.PoseReady, model)
	end,
	Bajada = function(model)
		if not Preview.WeaponOf(model) or not pcall(Preview.PoseReady, model, math.rad(-55)) then
			arm(model, "Right", CFrame.new(0.9, -1.4, -0.3), RIGHT_POLE)
		end
	end,
	AlCielo = function(model)
		if not Preview.WeaponOf(model) or not pcall(Preview.PoseReady, model, math.rad(70)) then
			arm(model, "Right", CFrame.new(0.8, 1.8, -0.2), RIGHT_POLE)
		end
	end,
	Saludo = function(model)
		hideWeapon(model)
		arm(model, "Right", CFrame.new(0.32, 1.25, -0.42), CFrame.new(2.4, 0.6, 0.2))
	end,
	Brazos = function(model)
		hideWeapon(model)
		arm(model, "Right", CFrame.new(-0.42, -0.2, -0.62), RIGHT_POLE)
		arm(model, "Left", CFrame.new(0.42, -0.05, -0.66), LEFT_POLE)
	end,
	Senala = function(model)
		hideWeapon(model)
		arm(model, "Right", CFrame.new(0.55, 0.55, -2.3), CFrame.new(2.2, -0.6, 0.2))
	end,
}

function PoseRig.Apply(model, poseId)
	local pose = PoseRig.Poses[poseId or "Ready"] or PoseRig.Poses.Ready
	local ok = pcall(pose, model)
	return ok
end

---------------------------------------------------------------------------
-- Intros de MVP
---------------------------------------------------------------------------

local function spark(parent, position, color, size)
	local p = Instance.new("Part")
	p.Name = "IntroFX"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Shape = Enum.PartType.Ball
	p.Color = color
	p.Size = Vector3.one * (size or 0.25)
	p.Position = position
	p.Parent = parent
	return p
end

local function fadeAway(part, time, props)
	props = props or {}
	props.Transparency = 1
	local t = TweenService:Create(part, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	t:Play()
	task.delay(time + 0.05, function()
		part:Destroy()
	end)
end

local INTROS = {}

-- Destello dorado: chispas que salen hacia fuera desde el pecho
INTROS.Destello = function(parent, model, root)
	local center = root.Position + Vector3.new(0, 1.2, 0)
	for i = 1, 14 do
		local angle = i / 14 * math.pi * 2
		local dir = Vector3.new(math.cos(angle), 0.4 + (i % 3) * 0.25, math.sin(angle))
		local p = spark(parent, center, Color3.fromRGB(255, 214, 90), 0.22)
		fadeAway(p, 0.7, { Position = center + dir * 3, Size = Vector3.one * 0.05 })
	end
end

-- Media vuelta: el MVP gira sobre sí mismo y vuelve a mirar a la cámara
INTROS.Giro = function(parent, model, root)
	local base = root.CFrame
	model:SetAttribute("IntroSpinning", true) -- (la escena no le mueve mientras gira)
	task.spawn(function()
		local start = os.clock()
		while model.Parent and os.clock() - start < 0.6 do
			local a = (os.clock() - start) / 0.6
			a = 1 - (1 - a) ^ 3
			root.CFrame = base * CFrame.Angles(0, a * math.pi * 2, 0)
			task.wait()
		end
		if model.Parent then
			root.CFrame = base
		end
		model:SetAttribute("IntroSpinning", nil)
	end)
	INTROS.Destello(parent, model, root)
end

-- Lluvia de ascuas: chispas naranjas que suben alrededor
INTROS.Ascuas = function(parent, _, root)
	local feet = root.Position - Vector3.new(0, 2.6, 0)
	for i = 1, 22 do
		task.delay(i * 0.04, function()
			if not parent.Parent then
				return
			end
			local offset = Vector3.new(math.cos(i * 2.4) * 1.6, 0, math.sin(i * 2.4) * 1.6)
			local p = spark(parent, feet + offset, i % 2 == 0 and Color3.fromRGB(255, 120, 30) or Color3.fromRGB(255, 200, 70), 0.16)
			fadeAway(p, 0.9, { Position = feet + offset + Vector3.new(0, 4 + (i % 4), 0) })
		end)
	end
end

-- Columna de luz: un haz cae sobre el MVP y se cierra
INTROS.Columna = function(parent, _, root)
	local beam = Instance.new("Part")
	beam.Name = "IntroFX"
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.CanTouch = false
	beam.CastShadow = false
	beam.Material = Enum.Material.Neon
	beam.Shape = Enum.PartType.Cylinder
	beam.Color = Color3.fromRGB(255, 236, 160)
	beam.Transparency = 0.25
	beam.Size = Vector3.new(30, 3.2, 3.2)
	beam.CFrame = CFrame.new(root.Position + Vector3.new(0, 12, 0)) * CFrame.Angles(0, 0, math.rad(90))
	beam.Parent = parent
	fadeAway(beam, 1, { Size = Vector3.new(30, 0.2, 0.2) })
	INTROS.Destello(parent, nil, root)
end

function PoseRig.PlayIntro(parent, model, introId)
	local root = model and model:FindFirstChild("HumanoidRootPart")
	if not root or not parent then
		return
	end
	local intro = INTROS[introId or "Destello"] or INTROS.Destello
	pcall(intro, parent, model, root)
end

return PoseRig
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="180">
                <Properties>
                  <string name="Name">Stage</string>
                  <string name="Source"><![CDATA[-- ResultsPresentation: la escena 3D de la pantalla final, dentro del mapa donde acabó la partida.
-- Busca un sitio despejado en la base del equipo que se enseña (entre sus apariciones y el centro del
-- mapa), coloca a los cinco con su avatar real (copias de ReplicatedStorage.ResultsCast, sin scripts
-- ni colisiones; si una no llega, la del personaje vivo), su arma con su skin y la pose de arma lista,
-- el MVP en el centro un paso por delante, con un foco encima, una corona y unas chispas muy suaves.
-- Solo existe mientras se ve la pantalla: :Destroy() lo quita todo (y no toca la iluminación global:
-- los efectos son instancias propias que se borran).
--   local stage = Stage.new()
--   stage:SetMap(mapName)            stage:SetResult(view)       (Data.Build)
--   stage:SetPlayers(lineup)         stage:SetMVP(id)            stage:SetScore(a, b)
--   stage:Build() → true/false       stage:CameraTargets()       stage:HighlightMVP()
--   stage:Destroy()
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local Teams = game:GetService("Teams")

local Preview = require(script.Parent.Parent.Preview)
local PoseRig = require(script.Parent.PoseRig)

local player = Players.LocalPlayer

local Stage = {}
Stage.__index = Stage

-- Formación (X a la derecha de la cámara, Z hacia la cámara): MVP centro y delante, luego 2 y 3 a
-- los lados, 4 y 5 en los extremos un poco atrás, todos girados hacia el centro
Stage.Formation = {
	{ X = 0, Z = 1.4, Turn = 0 },
	{ X = -3.5, Z = 0, Turn = 10 },
	{ X = 3.5, Z = 0, Turn = -10 },
	{ X = -6.8, Z = -1.1, Turn = 18 },
	{ X = 6.8, Z = -1.1, Turn = -18 },
}
-- Animaciones (GameConfig.UIAnimations) o la pose equivalente si aún no hay
Stage.MVPAnimation = "VictoryPose"
Stage.SquadAnimation = "SquadVictoryIdle"

local CAST_WAIT = 2.5 -- segundos que se esperan las copias que llegan tarde (avatar desde descripción)

function Stage.new()
	local self = setmetatable({}, Stage)
	self.Players = {}
	self.Models = {}
	self.Effects = {}
	self.Alive = true
	return self
end

function Stage:SetMap(mapName)
	self.Map = mapName
end

function Stage:SetResult(view)
	self.View = view
end

function Stage:SetPlayers(lineup)
	self.Players = lineup or {}
end

function Stage:SetMVP(id)
	self.MVP = id
end

function Stage:SetScore(a, b)
	self.Score = { a, b }
end

---------------------------------------------------------------------------
-- Dónde: un hueco despejado en la base del equipo
---------------------------------------------------------------------------

local function teamSpawns(teamName)
	local map = workspace:FindFirstChild("Map")
	local team = teamName and Teams:FindFirstChild(teamName)
	local list, any = {}, {}
	if not map then
		return list
	end
	for _, d in map:GetDescendants() do
		if d:IsA("SpawnLocation") then
			table.insert(any, d.Position)
			if team and d.TeamColor == team.TeamColor then
				table.insert(list, d.Position)
			end
		end
	end
	return #list > 0 and list or any
end

local function average(points)
	local sum = Vector3.zero
	for _, p in points do
		sum += p
	end
	return #points > 0 and sum / #points or nil
end

local function mapCenter()
	local map = workspace:FindFirstChild("Map")
	if map and map:IsA("Model") then
		local ok, cf = pcall(map.GetBoundingBox, map)
		if ok and cf then
			return cf.Position
		end
	end
	return Vector3.zero
end

-- Rayo que solo choca con el mapa (ni personajes, ni bots, ni la propia escena)
local function mapRay(origin, direction)
	local params = RaycastParams.new()
	local map = workspace:FindFirstChild("Map")
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { map, terrain }
	local ok, hit = pcall(workspace.Raycast, workspace, origin, direction, params)
	return ok and hit or nil
end

-- Suelo bajo un punto, buscando desde poco más arriba de él (si se busca desde muy alto, se
-- encuentra el tejado de la caseta de aparición en vez del suelo donde se está de pie)
local function groundAt(position)
	local hit = mapRay(position + Vector3.new(0, 3, 0), Vector3.new(0, -12, 0))
	return hit and hit.Position or nil
end

-- ¿Cabe la escena? Suelo plano bajo cada hueco y nada entre la fila y la cámara
local function fits(origin, forward, right)
	local floorY = origin.Y
	for _, slot in Stage.Formation do
		local p = origin + right * slot.X + forward * slot.Z + Vector3.new(0, 0.2, 0)
		local g = groundAt(p)
		if not g or math.abs(g.Y - floorY) > 1.2 then
			return false
		end
		-- (pared a la altura del pecho en el hueco)
		if mapRay(p + Vector3.new(0, 3, 0) - forward * 1.5, forward * 3) then
			return false
		end
	end
	-- La cámara ve la fila sin nada delante
	local eye = origin + Vector3.new(0, 3.5, 0)
	if mapRay(eye, forward * 15 + Vector3.new(0, 1, 0)) then
		return false
	end
	return true
end

-- Elige origen y orientación. Devuelve el CFrame de la escena: su +Z local apunta hacia la cámara
-- (la fila mira hacia el centro del mapa y la cámara se pone delante)
function Stage:FindSpot(teamName)
	local spawns = teamSpawns(teamName)
	local base = average(spawns) or mapCenter()
	local center = mapCenter()
	local toCenter = Vector3.new(center.X - base.X, 0, center.Z - base.Z)
	if toCenter.Magnitude < 1 then
		toCenter = Vector3.new(0, 0, 1)
	end
	local distance = toCenter.Magnitude
	local dir = toCenter.Unit
	local best
	-- Candidatos: del centro de la base hacia el del mapa, y un poco a los lados
	for _, t in { 0.08, 0.15, 0.22, 0.3, 0.4, 0.5 } do
		for _, side in { 0, 10, -10, 20, -20 } do
			local p = base + dir * (distance * t) + dir:Cross(Vector3.yAxis) * side
			local g = groundAt(p)
			if g then
				-- (la fila mira hacia el centro del mapa; la cámara se pone delante, en esa dirección)
				for _, yaw in { 0, 25, -25, 50, -50 } do
					local forward = (CFrame.Angles(0, math.rad(yaw), 0) * dir).Unit
					local right = forward:Cross(Vector3.yAxis).Unit * -1
					if fits(g, forward, right) then
						self.SpotQuality = "Fit"
						return CFrame.lookAt(g, g - forward)
					end
				end
				best = best or g
			end
		end
	end
	-- Sin hueco perfecto: el primero con suelo (o el centro de la base)
	self.SpotQuality = best and "Ground" or "None"
	local origin = best or base
	return CFrame.lookAt(origin, origin - dir)
end

---------------------------------------------------------------------------
-- Quién: copias de los avatares
---------------------------------------------------------------------------

local function castTemplate(id)
	local folder = ReplicatedStorage:FindFirstChild("ResultsCast")
	return folder and folder:FindFirstChild(id) or nil
end

local function makeModel(entry)
	local template = castTemplate(entry.Id)
	local model
	if template then
		local ok, clone = pcall(function()
			template.Archivable = true
			return template:Clone()
		end)
		if ok and clone then
			Preview.Strip(clone)
			model = clone
		end
	end
	if not model and entry.Id == "u" .. tostring(player.UserId) then
		-- (tu copia no llegó: la de tu personaje)
		model = Preview.CloneCharacter(player)
	end
	return model
end

-- Coloca un modelo de pie en su sitio, con su arma y su pose
function Stage:Place(index, entry, model)
	local slot = Stage.Formation[index]
	local root = model:FindFirstChild("HumanoidRootPart")
	if not slot or not root then
		model:Destroy()
		return
	end
	model.Name = "Result_" .. tostring(entry.Id)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local hip = humanoid and ((tonumber(humanoid.HipHeight) or 2) + root.Size.Y / 2) or 3
	-- El MVP un poco más grande (se lee primero) y delante
	if index == 1 then
		pcall(function()
			model:ScaleTo(1.06)
		end)
		hip *= 1.06
	end
	-- (de cara a la cámara: los personajes miran a su -Z, así que media vuelta y el giro hacia el centro)
	local cf = self.Origin * CFrame.new(slot.X, hip, slot.Z) * CFrame.Angles(0, math.pi + math.rad(slot.Turn), 0)
	model.Parent = self.Folder
	root.Anchored = true
	root.CFrame = cf
	if entry.Weapon then
		Preview.GiveWeapon(model, entry.Weapon, entry.Skin, entry.Charm)
	end
	-- Victoria: cada uno con su pose de victoria (PoseRig); si no, arma lista
	local victory = self.View and self.View.Outcome == "Victory"
	if victory and entry.Pose and entry.Pose ~= "Ready" then
		PoseRig.Apply(model, entry.Pose)
	else
		local animation = index == 1 and Stage.MVPAnimation or Stage.SquadAnimation
		if not Preview.PlayNamed(model, animation) then
			pcall(Preview.PoseReady, model)
		end
	end
	self.Models[index] = model
	-- Respiración mínima (la mueve el controlador mientras se ve)
	self.Base = self.Base or {}
	self.Base[index] = cf
end

---------------------------------------------------------------------------
-- Montaje
---------------------------------------------------------------------------

function Stage:Build()
	local view = self.View
	local teamName = view and view.MyTeam
	self.Folder = Instance.new("Folder")
	self.Folder.Name = "ResultsStage"
	local scenes = workspace:FindFirstChild("PresentationScenes") or Instance.new("Folder")
	scenes.Name = "PresentationScenes"
	scenes.Parent = workspace
	self.Folder.Parent = scenes
	self.Origin = self:FindSpot(teamName)
	-- Personajes: los que ya están, y los que llegan tarde en cuanto llegan
	local pending = {}
	for i, entry in self.Players do
		if i > #Stage.Formation then
			break
		end
		local model = makeModel(entry)
		if model then
			self:Place(i, entry, model)
		else
			pending[i] = entry
		end
	end
	if next(pending) then
		task.spawn(function()
			local started = os.clock()
			while self.Alive and next(pending) and os.clock() - started < CAST_WAIT do
				task.wait(0.25)
				for i, entry in pending do
					if castTemplate(entry.Id) then
						local model = makeModel(entry)
						if model and self.Alive then
							self:Place(i, entry, model)
						end
						pending[i] = nil
					end
				end
			end
		end)
	end
	self:BuildLights()
	return true
end

-- Luz de escena (local, se borra al salir): foco cálido sobre el MVP, relleno frío lateral y un
-- suelo de luz; partículas muy sutiles (chispas en victoria, polvo en derrota)
function Stage:BuildLights()
	local victory = self.View and self.View.Outcome == "Victory"
	local function anchorPart(name, cf)
		local part = Instance.new("Part")
		part.Name = name
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Transparency = 1
		part.Size = Vector3.new(1, 1, 1)
		part.CFrame = cf
		part.Parent = self.Folder
		return part
	end
	local key = anchorPart("KeyLight", self.Origin * CFrame.new(0, 11, 4) * CFrame.Angles(math.rad(-70), 0, 0))
	local spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Front
	spot.Angle = 50
	spot.Range = 18
	spot.Brightness = 0
	spot.Color = Color3.fromRGB(255, 226, 170)
	spot.Shadows = true
	spot.Parent = key
	self.KeyLight = spot
	local fill = anchorPart("FillLight", self.Origin * CFrame.new(-6, 5, 8))
	local point = Instance.new("PointLight")
	point.Range = 16
	point.Brightness = 0.7
	point.Color = victory and Color3.fromRGB(150, 190, 255) or Color3.fromRGB(200, 205, 215)
	point.Parent = fill
	-- Partículas: pocas y lentas, detrás de la fila
	local emitterPart = anchorPart("Embers", self.Origin * CFrame.new(0, 1.5, -4))
	emitterPart.Size = Vector3.new(18, 1, 4)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = victory and 6 or 3
	emitter.Lifetime = NumberRange.new(2.5, 4)
	emitter.Speed = NumberRange.new(0.6, 1.6)
	emitter.SpreadAngle = Vector2.new(25, 25)
	emitter.Acceleration = Vector3.new(0, victory and 0.8 or 0.2, 0)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, victory and 0.12 or 0.25), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, victory and 0.2 or 0.6), NumberSequenceKeypoint.new(1, 1) })
	emitter.Color = victory and ColorSequence.new(Color3.fromRGB(255, 200, 90), Color3.fromRGB(255, 120, 40)) or ColorSequence.new(Color3.fromRGB(170, 170, 175))
	emitter.LightEmission = victory and 1 or 0
	emitter.Parent = emitterPart
	-- Corrección de color y desenfoque de fondo (propios: se borran al salir, no se toca Lighting)
	local grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "ResultsGrade"
	grade.Contrast = 0.08
	grade.Saturation = victory and 0.1 or -0.15
	grade.TintColor = victory and Color3.fromRGB(255, 250, 242) or Color3.fromRGB(236, 238, 244)
	grade.Parent = Lighting
	table.insert(self.Effects, grade)
end

-- Destaca al MVP: el foco sube, corona encima de la cabeza y un destello dorado de chispas
function Stage:HighlightMVP()
	local model = self.Models[1]
	if self.KeyLight then
		local TweenService = game:GetService("TweenService")
		TweenService:Create(self.KeyLight, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { Brightness = 3 }):Play()
	end
	local head = model and model:FindFirstChild("Head")
	if not head then
		return
	end
	-- Su intro de MVP (si eligió una; la de siempre son estas chispas)
	local entry = self.Players and self.Players[1]
	if entry and entry.MVPIntro and entry.MVPIntro ~= "Destello" and self.Folder then
		PoseRig.PlayIntro(self.Folder, model, entry.MVPIntro)
	end
	local burst = Instance.new("ParticleEmitter")
	burst.Rate = 0
	burst.Lifetime = NumberRange.new(0.6, 1)
	burst.Speed = NumberRange.new(3, 6)
	burst.SpreadAngle = Vector2.new(180, 180)
	burst.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.18), NumberSequenceKeypoint.new(1, 0) })
	burst.Color = ColorSequence.new(Color3.fromRGB(255, 220, 90))
	burst.LightEmission = 1
	burst.Drag = 4
	burst.Parent = head
	pcall(function()
		burst:Emit(28)
	end)
end

-- Puntos para la cámara: plano general del equipo y plano del MVP
function Stage:CameraTargets()
	local origin = self.Origin
	if not origin then
		return nil
	end
	return {
		Center = (origin * CFrame.new(0, 3, 0)).Position,
		MVP = (origin * CFrame.new(0, 3.6, Stage.Formation[1].Z)).Position,
		Forward = origin.LookVector * -1,
		Origin = origin,
	}
end

-- Vaivén mínimo (respiración) mientras se ve
function Stage:Step(t)
	for i, model in self.Models do
		local base = self.Base and self.Base[i]
		local root = model and model.Parent and model:FindFirstChild("HumanoidRootPart")
		if base and root and not model:GetAttribute("IntroSpinning") then
			root.CFrame = base * CFrame.new(0, math.sin(t * 1.5 + i) * 0.025, 0)
		end
	end
end

function Stage:Destroy()
	self.Alive = false
	for _, effect in self.Effects do
		effect:Destroy()
	end
	table.clear(self.Effects)
	if self.Folder then
		self.Folder:Destroy()
		self.Folder = nil
	end
	table.clear(self.Models)
end

return Stage
]]></string>
                </Properties>
              </Item>
            </Item>
            <Item class="Folder" referent="181">
              <Properties>
                <string name="Name">Screens</string>
              </Properties>
              <Item class="ModuleScript" referent="182">
                <Properties>
                  <string name="Name">Armory</string>
                  <string name="Source"><![CDATA[-- ARMAMENTO: categorías arriba, la lista de armas de la categoría a la izquierda, el arma en grande
-- en el centro (3D, con tu skin, moviéndose despacio), sus estadísticas a la derecha (DAÑO,
-- PRECISIÓN, CADENCIA, MOVILIDAD y CONTROL, barras que se animan al cambiar de arma) y abajo tus
-- 5 clases: eliges la clase que editas y EQUIPAR pone el arma en ella (si es la que usas, se cambia
-- ya en el lobby). Las armas bloqueadas dicen a qué nivel salen o se compran con monedas.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Icons = require(Shared.Icons)
local Remotes = require(Shared.Remotes)
local Weapons = require(Shared.Weapons)
-- (las armas se desbloquean solo por nivel, igual para todos: no se compran)
local WEAPONS_FOR_COINS = require(Shared.Economy.MonetizationConfig).Rules.WeaponsForCoins
local Mastery = require(Shared.Mastery)

local Modules = script.Parent.Parent.Parent
local ClientState = require(Modules.ClientState)
local WeaponIcon = require(Modules.WeaponIcon)
local Menu = require(Modules.Menu)

local Flow = script.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Transition = require(Flow.Transition)
local UISound = require(Flow.UISound)

local Colors = Theme.Colors
local DARK = Color3.fromRGB(16, 14, 8)

local Armory = {}

-- Categorías del juego agrupadas como en un shooter (las de la lista de armas, en castellano)
local CATEGORIES = {
	{ Id = "AR", Text = "FUSILES", Match = { ["Fusil de asalto"] = true, ["Fusil de energía"] = true } },
	{ Id = "SMG", Text = "SUBFUSILES", Match = { Subfusil = true } },
	{ Id = "SG", Text = "ESCOPETAS", Match = { Escopeta = true, ["Escopeta pesada"] = true } },
	{ Id = "MR", Text = "TIRADOR", Match = { ["Fusil de tirador"] = true, Francotirador = true, Ballesta = true } },
	{ Id = "HV", Text = "PESADAS", Match = { ["Ametralladora pesada"] = true, Lanzacohetes = true, Paintball = true } },
	{ Id = "SEC", Text = "SECUNDARIAS", Secondary = true },
}

local flow, screen, tabsRow, listFrame, center, statsPanel, classRow
local nameLabel, categoryLabel, descLabel, iconHolder, actionButton, actionLabel, infoLabel, masteryLabel, masteryBar, useButton
local titleLabel, editLabel
local rowHeight = 44
local stats = {}
local tabs = {}
local classCards = {}
local category = "AR"
local selectedWeapon
local editClass = 1
local iconKey
local swayConnection
local busy = false

---------------------------------------------------------------------------
-- Estadísticas (0..100 comparadas con las demás armas de fuego)
---------------------------------------------------------------------------

local maxes
local function computeMaxes()
	maxes = { Damage = 1, Rate = 1, Recoil = 0.01, Spread = 0.01, WalkMin = 1, WalkMax = 1 }
	for _, def in Weapons.List do
		if def.Type == "Gun" and not def.Explosive and not def.Hidden then
			maxes.Damage = math.max(maxes.Damage, (def.Damage or 0) * (def.Pellets or 1))
			maxes.Rate = math.max(maxes.Rate, def.FireRate or 0)
			maxes.Recoil = math.max(maxes.Recoil, def.Recoil or 0)
			maxes.Spread = math.max(maxes.Spread, (def.Spread or 0) + 2 * (def.AimSpread or 0))
			local walk = def.WalkSpeedMultiplier or 1
			maxes.WalkMin = math.min(maxes.WalkMin, walk)
			maxes.WalkMax = math.max(maxes.WalkMax, walk)
		end
	end
end

function Armory.Stats(def)
	if not maxes then
		computeMaxes()
	end
	local walk = def.WalkSpeedMultiplier or 1
	local walkRange = math.max(0.01, maxes.WalkMax - maxes.WalkMin)
	return {
		-- (raíz: las escopetas, con todos los perdigones, no dejan a los fusiles en nada)
		Damage = 100 * math.sqrt(math.min(1, (def.Damage or 0) * (def.Pellets or 1) / maxes.Damage)),
		Accuracy = 100 * (1 - 0.85 * math.min(1, ((def.Spread or 0) + 2 * (def.AimSpread or 0)) / maxes.Spread)),
		Rate = 100 * math.min(1, (def.FireRate or 0) / maxes.Rate),
		Mobility = 30 + 70 * math.clamp((walk - maxes.WalkMin) / walkRange, 0, 1),
		Control = 100 * (1 - 0.85 * math.min(1, (def.Recoil or 0) / maxes.Recoil)),
	}
end

local STAT_ROWS = {
	{ Key = "Damage", Text = "DAÑO", Icon = Icons.Bullets },
	{ Key = "Accuracy", Text = "PRECISIÓN", Icon = Icons.Crosshair },
	{ Key = "Rate", Text = "CADENCIA", Icon = Icons.Bolt },
	{ Key = "Mobility", Text = "MOVILIDAD", Icon = Icons.Dash },
	{ Key = "Control", Text = "CONTROL", Icon = Icons.Shield },
}

---------------------------------------------------------------------------
-- Datos
---------------------------------------------------------------------------

local function categoryOf(id)
	for _, cat in CATEGORIES do
		if cat.Id == id then
			return cat
		end
	end
	return CATEGORIES[1]
end

local function weaponsIn(cat)
	local list = {}
	local source = cat.Secondary and Weapons.Secondaries or Weapons.Primaries
	for _, name in source do
		local def = Weapons.Get(name)
		if def and not def.Hidden and (cat.Secondary or (cat.Match and cat.Match[def.Category])) then
			table.insert(list, name)
		end
	end
	table.sort(list, function(a, b)
		return (Weapons.Get(a).UnlockLevel or 1) < (Weapons.Get(b).UnlockLevel or 1)
	end)
	return list
end

local function categoryFor(name)
	if table.find(Weapons.Secondaries, name) then
		return "SEC"
	end
	local def = Weapons.Get(name)
	for _, cat in CATEGORIES do
		if def and cat.Match and cat.Match[def.Category] then
			return cat.Id
		end
	end
	return "AR"
end

local function classes(data)
	return data and data.Classes or GameConfig.DefaultClasses
end

local function slotField()
	return categoryOf(category).Secondary and "Secondary" or "Primary"
end

---------------------------------------------------------------------------
-- Pintar
---------------------------------------------------------------------------

local function renderClasses()
	local data = ClientState.Data
	local list = classes(data)
	for i, card in classCards do
		local class = list[i] or GameConfig.DefaultClasses[i]
		card.Name.Text = tostring(class.Name or ("CLASE " .. i))
		local primary = Weapons.Get(class.Primary)
		card.Weapon.Text = primary and C.upper(primary.DisplayName) or "—"
		local active = data and data.ActiveClass == i
		card.Active.Visible = active
		C.setSelected(card.Frame, i == editClass)
		local dim = i == editClass and Color3.fromRGB(60, 46, 6) or Colors.TextDim
		card.Head.TextColor3 = dim
		card.Weapon.TextColor3 = dim
	end
	local active = data and data.ActiveClass
	useButton.Visible = active ~= editClass
end

local function renderList()
	local data = ClientState.Data
	for _, child in listFrame:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local equipped = classes(data)[editClass] and classes(data)[editClass][slotField()]
	for i, name in weaponsIn(categoryOf(category)) do
		local def = Weapons.Get(name)
		local unlocked = Weapons.IsUnlocked(name, data)
		local button = C.button({
			Name = "W_" .. name,
			Text = C.upper(def.DisplayName),
			Style = "Menu",
			TextSize = 17,
			Size = UDim2.new(1, 0, 0, rowHeight),
			Order = i,
			Parent = listFrame,
			OnClick = function()
				Armory.SelectWeapon(name)
			end,
		})
		local right = C.text({
			Name = "State",
			Text = name == equipped and "✔" or (unlocked and "" or ("🔒 " .. tostring(def.UnlockLevel))),
			Role = "Number",
			TextSize = 14,
			Color = name == equipped and Colors.Green or Colors.TextFaint,
			AlignX = Enum.TextXAlignment.Right,
			Anchor = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(60, 20),
			ZIndex = 5,
			Parent = button,
		})
		C.setSelected(button, name == selectedWeapon)
		if name == selectedWeapon then
			right.TextColor3 = DARK
		end
	end
end

local function renderWeapon(animate)
	local data = ClientState.Data
	local name = selectedWeapon
	local def = name and Weapons.Get(name)
	if not def then
		return
	end
	nameLabel.Text = C.upper(def.DisplayName)
	categoryLabel.Text = C.upper(def.Category or "")
	descLabel.Text = tostring(def.Description or "")
	-- Arma en 3D (solo se rehace si cambia el arma o la skin)
	local skin = Menu.SkinFor and Menu.SkinFor(data, name) or nil
	local key = name .. "/" .. tostring(skin)
	if key ~= iconKey then
		iconKey = key
		iconHolder:ClearAllChildren()
		pcall(WeaponIcon.Create, name, skin, { Name = "Weapon3D", Size = UDim2.fromScale(1, 1), ZIndex = 3, Parent = iconHolder }, "angled", 3.1)
		if animate ~= false then
			Transition.Pop(iconHolder, 0.9, 0.25)
		end
	end
	-- Estadísticas
	local values = Armory.Stats(def)
	for _, row in STAT_ROWS do
		stats[row.Key]:Set(values[row.Key], animate ~= false)
	end
	local damage = (def.Pellets or 1) > 1 and (tostring(def.Damage) .. "×" .. tostring(def.Pellets)) or tostring(def.Damage or 0)
	infoLabel.Text = string.format("Daño %s  ·  %d disparos/s  ·  Cargador %d  ·  Recarga %.1f s", damage, math.floor((def.FireRate or 0) + 0.5), def.MagSize or 0, def.ReloadTime or 0)
	-- Maestría
	local kills = data and data.WeaponKills and data.WeaponKills[name] or 0
	local level = Mastery.Level(kills)
	local nextTier = Mastery.Next(kills)
	local current = Mastery.Tiers[level]
	masteryLabel.Text = (current and ("MAESTRÍA · " .. C.upper(current.Name)) or "MAESTRÍA") .. (nextTier and string.format("   %d/%d bajas", kills, nextTier.Kills) or "   ¡COMPLETA!")
	local previous = current and current.Kills or 0
	masteryBar:Set(nextTier and (kills - previous) / math.max(1, nextTier.Kills - previous) or 1, animate ~= false)
	-- Acción: equipar en la clase, comprar o ver a qué nivel sale
	local unlocked = Weapons.IsUnlocked(name, data)
	local equipped = classes(data)[editClass] and classes(data)[editClass][slotField()] == name
	actionButton.Active = true
	if equipped then
		actionLabel.Text = "EQUIPADA EN CLASE " .. editClass
		actionButton.BackgroundColor3 = Colors.PanelLight
		actionLabel.TextColor3 = Colors.Green
	elseif unlocked then
		actionLabel.Text = "EQUIPAR EN CLASE " .. editClass
		actionButton.BackgroundColor3 = Colors.Yellow
		actionLabel.TextColor3 = DARK
	elseif def.Price and WEAPONS_FOR_COINS then
		actionLabel.Text = string.format("COMPRAR  💰 %d", def.Price)
		actionButton.BackgroundColor3 = (data and (data.Coins or 0) >= def.Price) and Colors.Yellow or Colors.PanelLight
		actionLabel.TextColor3 = (data and (data.Coins or 0) >= def.Price) and DARK or Colors.TextDim
	else
		actionLabel.Text = def.EventText and C.upper(def.EventText) or ("🔒 NIVEL " .. tostring(def.UnlockLevel))
		actionButton.BackgroundColor3 = Colors.PanelLight
		actionLabel.TextColor3 = Colors.TextDim
	end
	local gradient = actionButton:FindFirstChildOfClass("UIGradient")
	if gradient then
		gradient.Enabled = actionButton.BackgroundColor3 == Colors.Yellow
	end
end

function Armory.Render(animate)
	if not screen then
		return
	end
	for id, button in tabs do
		C.setSelected(button, id == category)
	end
	renderClasses()
	renderList()
	renderWeapon(animate)
end

---------------------------------------------------------------------------
-- Acciones
---------------------------------------------------------------------------

function Armory.SelectCategory(id)
	if category == id then
		return
	end
	category = id
	local data = ClientState.Data
	local class = classes(data)[editClass]
	local list = weaponsIn(categoryOf(id))
	local equipped = class and class[slotField()]
	selectedWeapon = (equipped and table.find(list, equipped)) and equipped or list[1]
	Transition.SlideIn(listFrame, Vector2.new(-24, 0), 0.2)
	Armory.Render(true)
end

function Armory.SelectWeapon(name)
	if selectedWeapon == name then
		return
	end
	selectedWeapon = name
	Armory.Render(true)
end

function Armory.SelectClass(i)
	editClass = i
	local class = classes(ClientState.Data)[i]
	if class then
		local name = class[slotField()]
		if name then
			selectedWeapon = name
		end
	end
	Armory.Render(true)
end

local function act()
	local data = ClientState.Data
	local name = selectedWeapon
	local def = name and Weapons.Get(name)
	if not def or busy then
		return
	end
	local unlocked = Weapons.IsUnlocked(name, data)
	local equipped = classes(data)[editClass] and classes(data)[editClass][slotField()] == name
	if equipped then
		return
	end
	if unlocked then
		UISound.Play("Equip")
		pcall(function()
			Remotes.EditClass:FireServer(editClass, slotField(), name)
		end)
		Transition.Pulse(iconHolder, 1.08, 0.2)
	elseif def.Price and WEAPONS_FOR_COINS then
		busy = true
		local ok, result, message = pcall(function()
			return Remotes.BuyItem:InvokeServer("Weapon", name)
		end)
		busy = false
		if ok and result then
			UISound.Play("Reward")
			Transition.Flash(Colors.Yellow, 0.25, 0.3)
		else
			UISound.Play("Error")
			actionLabel.Text = C.upper(tostring(ok and (message or "No se pudo comprar") or "Error de conexión"))
		end
	else
		UISound.Play("Error")
	end
end

---------------------------------------------------------------------------
-- Pantalla
---------------------------------------------------------------------------

local function buildClassCard(i)
	local card = C.button({ Name = "Class" .. i, Text = "", Style = "Menu", Size = UDim2.new(0.2, -8, 1, 0), Order = i, Parent = classRow, OnClick = function()
		Armory.SelectClass(i)
	end })
	local head = C.text({ Name = "Head", Text = "CLASE " .. i, Role = "Title", TextSize = 13, Color = Colors.TextDim, Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 16), ZIndex = 5, Parent = card })
	local name = C.text({ Name = "ClassName", Text = "", Role = "TitleItalic", TextSize = 20, Position = UDim2.fromOffset(12, 21), Size = UDim2.new(1, -24, 0, 24), ZIndex = 5, Parent = card })
	local weapon = C.text({ Name = "Weapon", Text = "", Role = "BodyBold", TextSize = 12, Color = Colors.TextDim, Position = UDim2.fromOffset(12, 46), Size = UDim2.new(1, -24, 0, 16), ZIndex = 5, Parent = card })
	local active = C.new("Frame", { Name = "Active", BackgroundColor3 = Colors.Green, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 8), Size = UDim2.fromOffset(8, 8), ZIndex = 6, Parent = card }, { C.corner(4) })
	classCards[i] = { Frame = card, Head = head, Name = name, Weapon = weapon, Active = active }
end

function Armory.Build(flowController, root)
	flow = flowController
	screen = C.new("Frame", { Name = "Armory", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })
	-- Cabecera
	C.button({ Name = "Back", Text = "VOLVER", Icon = "◀", Style = "Ghost", TextSize = 16, Position = UDim2.fromOffset(24, 22), Size = UDim2.fromOffset(130, 40), Parent = screen, Sound = "Back", OnClick = function()
		flow.SetState("Home")
	end })
	titleLabel = C.text({ Text = "ARMAMENTO", Role = "TitleItalic", TextSize = 46, Position = UDim2.fromOffset(170, 14), Size = UDim2.fromOffset(420, 54), Stroke = 2, Parent = screen })
	tabsRow = C.new("Frame", { Name = "Tabs", BackgroundTransparency = 1, Position = UDim2.fromOffset(24, 76), Size = UDim2.new(1, -48, 0, 40), Parent = screen }, {
		C.list(6, Enum.FillDirection.Horizontal),
	})
	for i, cat in CATEGORIES do
		tabs[cat.Id] = C.button({ Name = "Tab_" .. cat.Id, Text = cat.Text, Style = "Menu", TextSize = 15, Size = UDim2.fromOffset(cat.Id == "SEC" and 150 or 124, 40), Order = i, Parent = tabsRow, OnClick = function()
			Armory.SelectCategory(cat.Id)
		end })
	end
	-- Lista de armas (izquierda)
	listFrame = C.new("Frame", { Name = "List", BackgroundTransparency = 1, Position = UDim2.fromOffset(24, 128), Size = UDim2.new(0, 250, 1, -262), Parent = screen }, { C.list(6) })
	-- Arma en grande (centro)
	center = C.new("Frame", { Name = "Center", BackgroundTransparency = 1, Position = UDim2.fromOffset(290, 120), Size = UDim2.new(1, -290 - 380, 1, -250), Parent = screen })
	categoryLabel = C.text({ Text = "", Role = "Title", TextSize = 16, Color = Colors.YellowText, Position = UDim2.fromOffset(8, 4), Size = UDim2.new(1, -16, 0, 20), Parent = center })
	nameLabel = C.text({ Text = "", Role = "TitleItalic", TextSize = 48, Position = UDim2.fromOffset(6, 22), Size = UDim2.new(1, -12, 0, 54), Scaled = true, Stroke = 2, Parent = center })
	-- Suelo de luz detrás del arma (sin imágenes: un degradado)
	C.new("Frame", { Name = "Glow", BackgroundColor3 = Colors.Yellow, BackgroundTransparency = 0.88, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.58), Size = UDim2.new(0.9, 0, 0.5, 0), Parent = center }, {
		C.corner(200),
		C.new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(1, 1) }) }),
	})
	iconHolder = C.new("Frame", { Name = "Icon", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.56), Size = UDim2.new(1, 0, 0.62, 0), ZIndex = 3, Parent = center })
	descLabel = C.text({ Text = "", Role = "Body", TextSize = 14, Color = Colors.TextDim, Wrap = true, AlignX = Enum.TextXAlignment.Center, Anchor = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -2), Size = UDim2.new(0.9, 0, 0, 36), Parent = center })
	-- Estadísticas (derecha)
	statsPanel = C.panel({ Name = "Stats", Anchor = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 128), Size = UDim2.fromOffset(350, 300), Parent = screen }, {})
	local inner = C.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = statsPanel }, { C.padding(12, 14, 12, 14), C.list(6) })
	C.header(inner, "ESTADÍSTICAS", "", 0)
	for i, row in STAT_ROWS do
		stats[row.Key] = C.statRow(inner, row.Text, row.Icon, i)
	end
	infoLabel = C.text({ Text = "", Role = "BodyBold", TextSize = 12, Color = Colors.TextDim, Wrap = true, Size = UDim2.new(1, 0, 0, 30), Order = 10, Parent = inner })
	masteryLabel = C.text({ Text = "", Role = "Title", TextSize = 14, Color = Colors.YellowText, Size = UDim2.new(1, 0, 0, 18), Order = 11, Parent = inner })
	masteryBar = C.progress({ Size = UDim2.new(1, 0, 0, 5), Order = 12, Parent = inner })
	actionButton = C.button({ Name = "Action", Text = "", Style = "Primary", TextSize = 20, Anchor = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 440), Size = UDim2.fromOffset(350, 54), Parent = screen, Sound = "Click", OnClick = act })
	actionLabel = actionButton:FindFirstChild("Label", true)
	-- Clases (abajo)
	editLabel = C.text({ Text = "CLASE QUE EDITAS", Role = "Title", TextSize = 13, Color = Colors.TextDim, Anchor = Vector2.new(0, 1), Position = UDim2.new(0, 24, 1, -100), Size = UDim2.fromOffset(300, 16), Parent = screen })
	classRow = C.new("Frame", { Name = "Classes", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 24, 1, -24), Size = UDim2.new(1, -48 - 220, 0, 70), Parent = screen }, {
		C.list(8, Enum.FillDirection.Horizontal),
	})
	for i = 1, GameConfig.ClassCount or 5 do
		buildClassCard(i)
	end
	useButton = C.button({ Name = "UseClass", Text = "USAR ESTA CLASE", Style = "Ghost", TextSize = 15, Anchor = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -24), Size = UDim2.fromOffset(208, 70), Parent = screen, Sound = "Equip", OnClick = function()
		pcall(function()
			Remotes.SelectClass:FireServer(editClass)
		end)
	end })
	ClientState.DataChanged.Event:Connect(function()
		if screen.Visible then
			Armory.Render(false)
		end
	end)
	Armory.Screen = screen
end

-- Responsive: en pantallas estrechas la lista y las estadísticas se estrechan; en el teléfono
-- (pantalla baja) todo se compacta y se quitan los detalles (datos en texto y maestría)
local function applyLayout()
	local width = flow.Root and flow.Root:GetAttribute("VirtualWidth") or 1280
	local phone = C.Breakpoint() == "PHONE"
	local narrow = phone or width < 1100
	local listW = phone and 190 or (narrow and 200 or 250)
	local statsW = phone and 280 or (narrow and 300 or 350)
	local top = phone and 100 or 128
	rowHeight = phone and 36 or 44
	titleLabel.TextSize = phone and 34 or 46
	titleLabel.Position = UDim2.fromOffset(170, phone and 8 or 14)
	tabsRow.Position = UDim2.fromOffset(24, phone and 56 or 76)
	for id, tab in tabs do
		tab.Size = UDim2.fromOffset(id == "SEC" and (phone and 120 or 150) or (phone and 104 or 124), phone and 34 or 40)
	end
	listFrame.Position = UDim2.fromOffset(24, top)
	listFrame.Size = UDim2.new(0, listW, 1, -(top + 130))
	statsPanel.Position = UDim2.new(1, -24, 0, top)
	statsPanel.Size = UDim2.fromOffset(statsW, phone and 214 or 300)
	infoLabel.Visible = not phone
	masteryLabel.Visible = not phone
	masteryBar.Frame.Visible = not phone
	actionButton.Position = UDim2.new(1, -24, 0, top + (phone and 222 or 312))
	actionButton.Size = UDim2.fromOffset(statsW, phone and 44 or 54)
	classRow.Size = UDim2.new(1, -48 - (phone and 200 or 220), 0, phone and 58 or 70)
	classRow.Position = UDim2.new(0, 24, 1, phone and -12 or -24)
	editLabel.Position = UDim2.new(0, 24, 1, phone and -74 or -100)
	useButton.Size = UDim2.fromOffset(phone and 190 or 208, phone and 58 or 70)
	useButton.Position = UDim2.new(1, -24, 1, phone and -12 or -24)
	local left = listW + 40
	local right = statsW + 34
	center.Position = UDim2.fromOffset(left, top - 8)
	center.Size = UDim2.new(1, -left - right, 1, -(top + 130))
end

function Armory.Show()
	local data = ClientState.Data
	editClass = data and data.ActiveClass or 1
	local class = classes(data)[editClass]
	selectedWeapon = class and class.Primary or Weapons.Primaries[1]
	category = categoryFor(selectedWeapon)
	iconKey = nil
	applyLayout()
	flow.SetCamera("Orbit")
	flow.SetBackdrop(0.62, 0.25)
	Transition.Blur(14, 0.25)
	screen.Visible = true
	Armory.Render(true)
	Transition.SlideIn(listFrame, Vector2.new(-50, 0), 0.3)
	Transition.SlideIn(statsPanel, Vector2.new(50, 0), 0.3, 0.04)
	-- El arma se mueve despacio (solo mientras se ve esta pantalla)
	if swayConnection then
		swayConnection:Disconnect()
	end
	local base, pivot
	swayConnection = RunService.RenderStepped:Connect(function()
		local viewport = iconHolder:FindFirstChild("Weapon3D")
		local camera = viewport and viewport.CurrentCamera
		local model = viewport and viewport:FindFirstChildWhichIsA("Model")
		if not camera or not model then
			return
		end
		if camera:GetAttribute("Base") == nil then
			local ok, cf = pcall(model.GetPivot, model)
			if not ok then
				return
			end
			camera:SetAttribute("Base", true)
			pivot = cf
			base = cf:ToObjectSpace(camera.CFrame)
		end
		if pivot and base then
			camera.CFrame = pivot * CFrame.Angles(0, math.sin(os.clock() * 0.6) * 0.22, 0) * base
		end
	end)
end

function Armory.Hide()
	if swayConnection then
		swayConnection:Disconnect()
		swayConnection = nil
	end
	screen.Visible = false
end

return Armory
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="183">
                <Properties>
                  <string name="Name">Deploy</string>
                  <string name="Source"><![CDATA[-- DESPLIEGUE: PREPÁRATE · 3 · 2 · 1 · ¡YA! mientras la cámara baja del mapa a la espalda de tu
-- personaje. La cuenta atrás es la del servidor (DeployEndsAt), así todos salen a la vez; en
-- Eliminación y Buscar y destruir es la preparación de la primera ronda (Frozen + TimeLeft); quien
-- entra con la partida empezada la hace a su ritmo (3 s). Si tu personaje aún no existe, en vez del
-- número se ve "SINCRONIZANDO PARTIDA…" y se entra en cuanto llega.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)

local Flow = script.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Transition = require(Flow.Transition)
local UISound = require(Flow.UISound)

local player = Players.LocalPlayer
local Colors = Theme.Colors

local Deploy = {}

local flow, screen, block, top, number, sub, ring, sync
local token = 0
local connection
local mode -- "Server" | "Prep" | "Late"
local lateEndsAt, shownAt, lastShown, finished
local prepMax

local function characterReady()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return character ~= nil and character:FindFirstChild("HumanoidRootPart") ~= nil and humanoid ~= nil and humanoid.Health > 0
end

-- Segundos que faltan para salir (nil = aún no se sabe)
local function remaining()
	if mode == "Late" then
		return math.max(0, lateEndsAt - os.clock())
	elseif mode == "Prep" then
		-- (aún en la presentación: la preparación empieza cuando el servidor quita el despliegue)
		if ReplicatedStorage:GetAttribute("Deploy") ~= nil then
			return nil
		end
		-- Preparación de la ronda: el servidor cuenta TimeLeft mientras todos están quietos
		if ReplicatedStorage:GetAttribute("Frozen") then
			local left = tonumber(ReplicatedStorage:GetAttribute("TimeLeft"))
			if left and left <= prepMax then
				return left
			end
			return nil
		end
		-- (ya no están quietos: solo vale si se vio la cuenta llegar al final o tras un margen;
		-- entre el despliegue y la primera ronda hay un instante sin "Frozen")
		if (lastShown and lastShown <= 1) or os.clock() - shownAt > prepMax + 2 then
			return 0
		end
		return nil
	end
	return flow.DeployRemaining() or 0
end

-- Lo que tarda la cámara en bajar hasta tu personaje (lo que dura la cuenta atrás)
function Deploy.CameraTime()
	if mode == "Late" then
		return math.max(0.5, lateEndsAt - os.clock())
	elseif mode == "Prep" then
		local left = tonumber(ReplicatedStorage:GetAttribute("TimeLeft"))
		return (left and left <= prepMax) and left or prepMax
	end
	return flow.DeployRemaining() or 3
end

local function show(value)
	if value == lastShown then
		return
	end
	lastShown = value
	if value >= 1 then
		number.Text = tostring(value)
		number.TextColor3 = value == 1 and Colors.YellowText or Colors.White
		top.Text = "PREPÁRATE"
		UISound.Play("Countdown", 1 + (3 - math.min(value, 3)) * 0.12)
		Transition.Pulse(number, 1.45, 0.3)
		Transition.Pulse(ring, 1.25, 0.45)
	end
end

local function finish(my)
	if finished then
		return
	end
	finished = true
	number.Text = "¡YA!"
	number.TextColor3 = Colors.Yellow
	top.Text = ""
	sub.Text = "¡A LUCHAR!"
	UISound.Play("Go")
	Transition.Flash(Colors.Yellow, 0.35, 0.3)
	Transition.Pulse(number, 1.6, 0.25)
	task.delay(0.12, function()
		if token == my then
			flow.Advance("Deploy")
		end
	end)
end

local function step()
	local my = token
	if finished then
		return
	end
	local ready = characterReady()
	local left = remaining()
	sync.Visible = not ready
	number.Visible = ready and left ~= nil
	if not ready then
		-- (sin personaje no se entra: se espera a que llegue; el servidor lo está creando)
		if os.clock() - shownAt > 12 then
			finish(my) -- (algo raro: mejor entrar y que el juego normal se encargue)
		end
		return
	end
	if left == nil then
		return
	end
	local whole = math.ceil(left - 0.05)
	if whole <= 0 then
		finish(my)
	else
		show(whole)
	end
end

function Deploy.Build(flowController, root)
	flow = flowController
	screen = C.new("Frame", { Name = "Deploy", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })
	block = C.new("Frame", { Name = "Block", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromOffset(520, 300), Parent = screen })
	-- Anillo fino detrás del número (late con cada segundo)
	ring = C.new("Frame", {
		Name = "Ring",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 10),
		Size = UDim2.fromOffset(190, 190),
		BackgroundTransparency = 1,
		Parent = block,
	}, { C.corner(95), C.stroke(Colors.Yellow, 3, 0.35) })
	top = C.text({ Name = "Top", Text = "PREPÁRATE", Role = "TitleItalic", TextSize = 34, Color = Colors.YellowText, AlignX = Enum.TextXAlignment.Center, Anchor = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.new(1, 0, 0, 40), Stroke = 2, Parent = block })
	number = C.text({ Name = "Number", Text = "", Role = "TitleItalic", TextSize = 150, Color = Colors.White, AlignX = Enum.TextXAlignment.Center, Anchor = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 10), Size = UDim2.new(1, 0, 0, 160), Stroke = 3, Parent = block })
	sub = C.text({ Name = "Sub", Text = "", Role = "Title", TextSize = 22, Color = Colors.Text, AlignX = Enum.TextXAlignment.Center, Anchor = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 1), Size = UDim2.new(1, 0, 0, 28), Stroke = 1, Parent = block })
	sync = C.text({ Name = "Sync", Text = "SINCRONIZANDO PARTIDA…", Role = "Title", TextSize = 26, Color = Colors.Text, AlignX = Enum.TextXAlignment.Center, Anchor = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 10), Size = UDim2.new(1, 0, 0, 34), Stroke = 2, Visible = false, Parent = block })
end

function Deploy.Show(ctx)
	token += 1
	finished = false
	lastShown = nil
	shownAt = os.clock()
	local deploy = ReplicatedStorage:GetAttribute("Deploy")
	local modeCode = ReplicatedStorage:GetAttribute("Mode")
	local settings = GameConfig.ModeSettings[modeCode or ""] or {}
	prepMax = settings.PrepTime or 5
	local endsAt = ReplicatedStorage:GetAttribute("DeployEndsAt")
	local justDeployed = endsAt ~= nil and math.abs(workspace:GetServerTimeNow() - endsAt) < 3
	local elimLike = modeCode == "ELIM" or modeCode == "SND"
	if elimLike and (deploy ~= nil or ReplicatedStorage:GetAttribute("Frozen") or justDeployed) then
		-- (en estos modos la cuenta atrás es la preparación de la ronda, no el final del despliegue)
		mode = "Prep"
	elseif deploy ~= nil then
		mode = "Server"
	else
		mode = "Late"
		lateEndsAt = os.clock() + flow.Times.LateCountdown
	end
	-- Lo que hay que hacer, debajo del número
	local objective = {
		TDM = "Elimina al equipo rival",
		DOM = "Captura y defiende las banderas",
		KOTH = "Controla la zona",
		CTF = "Roba la bandera rival",
		FFA = "Todos contra todos",
		GUN = "Una baja = arma nueva",
		ELIM = "Una sola vida por ronda",
		SND = "Planta o desactiva la bomba",
		INF = "Sobrevive a la infección",
		CAL = "Recoge las calabazas",
	}
	sub.Text = C.upper(objective[modeCode or ""] or tostring(ReplicatedStorage:GetAttribute("ModeName") or ""))
	number.Text = ""
	top.Text = "PREPÁRATE"
	-- Sin paneles ni desenfoque: se ve el mapa y la cámara bajando hacia ti
	flow.SetBackdrop(0, 0.3)
	Transition.Blur(0, 0.3)
	-- (sin personaje todavía: la cámara sigue sobre el mapa hasta que llegue)
	flow.SetCamera(characterReady() and "Deploy" or "Flyover", Deploy.CameraTime())
	screen.Visible = true
	Transition.Pop(top, 1.3, 0.25)
	Transition.Pop(sub, 0.8, 0.3, 0.1)
	if connection then
		connection:Disconnect()
	end
	local my = token
	local cameraSet = characterReady()
	connection = RunService.RenderStepped:Connect(function()
		if token ~= my then
			return
		end
		-- (si el personaje llega tarde, la cámara baja hacia él en cuanto existe)
		if not cameraSet and characterReady() then
			cameraSet = true
			if mode == "Late" then
				lateEndsAt = os.clock() + flow.Times.LateCountdown
			end
			flow.SetCamera("Deploy", Deploy.CameraTime())
		end
		step()
	end)
end

function Deploy.Hide()
	token += 1
	if connection then
		connection:Disconnect()
		connection = nil
	end
	screen.Visible = false
end

return Deploy
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="184">
                <Properties>
                  <string name="Name">Home</string>
                  <string name="Source"><![CDATA[-- HOME / LOBBY: tu personaje real (copia 3D con tu traje y tu arma) en el centro, el menú a la
-- izquierda con JUGAR como acción dominante, perfil y monedas arriba, misiones diarias, evento y
-- arma destacada a la derecha, modo y rango abajo. Recoge todo lo que tenía la pantalla de inicio
-- (recompensa diaria, ruleta, pack de inicio, grupo, invitar, clasificación, mapa destacado).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local SocialService = game:GetService("SocialService")
local GroupService = game:GetService("GroupService")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Ranks = require(Shared.Ranks)
local Weapons = require(Shared.Weapons)
local MonetizationConfig = require(Shared.Economy.MonetizationConfig)
local Icons = require(Shared.Icons)

local Modules = script.Parent.Parent.Parent
local ClientState = require(Modules.ClientState)
local Menu = require(Modules.Menu)
local Wheel = require(Modules.Wheel)
local WeaponIcon = require(Modules.WeaponIcon)

local Flow = script.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Transition = require(Flow.Transition)
local UISound = require(Flow.UISound)
local Preview = require(Flow.Preview)
local StoreData = require(Flow.Store.StoreData)
local ItemArt = require(Flow.Store.ItemArt)

local player = Players.LocalPlayer
local Colors = Theme.Colors

local Home = {}

local flow, root, screen, preview
local refs: { [string]: any } = {}

local function isPhone()
	return C.Breakpoint() == "PHONE"
end

---------------------------------------------------------------------------
-- Piezas
---------------------------------------------------------------------------

local function buildLogo(parent)
	local logo = C.new("Frame", { Name = "Logo", BackgroundTransparency = 1, Position = UDim2.fromOffset(24, 14), Size = UDim2.fromOffset(380, 84), Parent = parent })
	local title = tostring(GameConfig.GameTitle or "SHOOTER")
	local first, rest = string.match(title, "^(%S+)%s*(.*)$")
	refs.LogoTitle = C.text({
		Text = string.format('%s <font color="%s">%s</font>', C.upper(first or title), "#" .. Colors.Yellow:ToHex(), rest ~= "" and C.upper(rest) or ""),
		Rich = true,
		Role = "TitleItalic",
		TextSize = 54,
		Color = Colors.White,
		Size = UDim2.new(1, 0, 0, 58),
		Stroke = 2,
		Parent = logo,
	})
	local tag = C.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(4, 58), Size = UDim2.new(1, 0, 0, 22), Parent = logo })
	refs.LogoTag = tag
	C.new("Frame", { BackgroundColor3 = Colors.Red, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 10), Size = UDim2.fromOffset(60, 3), Parent = tag })
	C.text({ Text = "5 V 5", Role = "TitleItalic", TextSize = 20, AlignX = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(64, 0), Size = UDim2.fromOffset(60, 22), Parent = tag })
	C.new("Frame", { BackgroundColor3 = Colors.Red, BorderSizePixel = 0, Position = UDim2.fromOffset(128, 10), Size = UDim2.fromOffset(60, 3), Parent = tag })
	return logo
end

local function iconButton(parent, icon, order, onClick)
	local image = Icons.IsImage(icon)
	local button = C.new("TextButton", {
		Name = "Icon_" .. (image and tostring(order) or icon),
		AutoButtonColor = false,
		Text = image and "" or icon,
		TextSize = 20,
		Font = Enum.Font.GothamBold,
		TextColor3 = Colors.White,
		BackgroundColor3 = Colors.Panel,
		BackgroundTransparency = Theme.PanelAlpha,
		Size = UDim2.fromOffset(44, 44),
		LayoutOrder = order,
		Parent = parent,
	}, { C.corner(4), C.stroke() })
	if image then
		C.new("ImageLabel", {
			Name = "Image",
			BackgroundTransparency = 1,
			Image = icon,
			ScaleType = Enum.ScaleType.Fit,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(30, 30),
			Parent = button,
		})
	end
	C.feel(button)
	button.Activated:Connect(function()
		UISound.Play("Click")
		onClick(button)
	end)
	return button
end

local function buildTopBar(parent)
	local bar = C.new("Frame", {
		Name = "TopBar",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -24, 0, 18),
		Size = UDim2.fromOffset(720, 52),
		Parent = parent,
	}, { C.list(10, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right) })
	-- Perfil: foto, nombre, nivel y XP
	local profile = C.panel({ Name = "Profile", Size = UDim2.fromOffset(260, 52), Order = 1, Parent = bar })
	refs.Profile = profile
	-- (hueco de la tarjeta de jugador: el primero, para quedar detrás de la foto y el nombre)
	refs.CardSlot = C.new("Frame", { Name = "CardSlot", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ClipsDescendants = true, Parent = profile }, { C.corner(4) })
	local thumb = C.new("ImageLabel", {
		Name = "Avatar",
		BackgroundColor3 = Colors.PanelLight,
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.fromOffset(44, 44),
		Image = "",
		Parent = profile,
	}, { C.corner(3), C.stroke(Colors.Yellow, 1, 0.4) })
	task.spawn(function()
		local ok, image = pcall(function()
			return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
		if ok and image then
			thumb.Image = image
		end
	end)
	C.text({ Text = player.DisplayName, Role = "Title", TextSize = 18, Size = UDim2.new(1, -62, 0, 22), Position = UDim2.fromOffset(56, 4), Parent = profile })
	refs.Level = C.text({ Name = "Level", Text = "NIVEL 1", Role = "Number", TextSize = 14, Color = Colors.YellowText, Size = UDim2.new(0, 70, 0, 16), Position = UDim2.fromOffset(56, 28), Parent = profile })
	refs.XP = C.progress({ Size = UDim2.new(1, -136, 0, 6), Position = UDim2.fromOffset(126, 34), Parent = profile })
	-- Monedas (con "+" a la tienda)
	local _, coins = C.currency(bar, Icons.Coin, 2, function()
		flow.SetState("Store", { Tab = "COINS" })
	end)
	refs.Coins = coins
	-- Amigos (invitar), novedades, retos y ajustes
	local friends = iconButton(bar, Icons.Friends, 3, function()
		Home.OpenClan()
	end)
	refs.FriendsDot = C.dot(friends, false)
	local news = iconButton(bar, Icons.Mail, 4, function()
		local ok, News = pcall(require, Modules.News)
		if ok and News.Open then
			News.Open()
		end
	end)
	refs.NewsDot = C.dot(news, false)
	iconButton(bar, Icons.Bell, 5, function()
		Menu.Open("Retos")
	end)
	iconButton(bar, Icons.Gear, 6, function()
		Menu.Open("Ajustes")
	end)
	return bar
end

local MENU = {
	{ Id = "Armory", Text = "ARMAMENTO", Icon = Icons.Rifle },
	{ Id = "Operator", Text = "OPERADOR", Icon = Icons.Helmet },
	{ Id = "Squad", Text = "ESCUADRA", Icon = Icons.Squad },
	{ Id = "Shop", Text = "TIENDA", Icon = Icons.Cart },
	{ Id = "Pass", Text = "PASE DE BATALLA", Icon = Icons.Medal },
	{ Id = "Events", Text = "EVENTOS", Icon = Icons.Calendar, Desktop = true },
	{ Id = "Clan", Text = "CLAN", Icon = Icons.Shield, Desktop = true },
	{ Id = "Settings", Text = "AJUSTES", Icon = Icons.Gear, Desktop = true },
}

local function onMenu(id)
	if id == "Armory" then
		flow.SetState("Armory")
	elseif id == "Operator" then
		flow.SetState("Operator")
	elseif id == "Squad" then
		flow.SetState("Squad")
	elseif id == "Shop" then
		flow.SetState("Store")
	elseif id == "Pass" then
		flow.SetState("Pass")
	elseif id == "Events" then
		-- (la tienda del evento está en DESTACADO; la ruleta ya no existe: estética de casino)
		if MonetizationConfig.Rules.Wheel then
			Wheel.Open()
		else
			flow.SetState("Store", { Tab = "FEATURED" })
		end
	elseif id == "Clan" then
		Home.OpenClan()
	elseif id == "Settings" then
		Menu.Open("Ajustes")
	end
end

local function buildLeft(parent)
	local column = C.new("Frame", {
		Name = "Left",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(24, 110),
		Size = UDim2.fromOffset(300, 560),
		Parent = parent,
	}, { C.list(8) })
	refs.Play = C.button({
		Name = "Play",
		Text = "JUGAR",
		Icon = "▶",
		Sub = "PARTIDA 5 VS 5",
		Style = "Primary",
		TextSize = 34,
		Size = UDim2.fromOffset(300, 72),
		Order = 0,
		Parent = column,
		OnClick = function()
			flow.Play()
		end,
	})
	refs.Menu = {}
	for i, item in MENU do
		local button = C.button({
			Name = "Menu_" .. item.Id,
			Text = item.Text,
			Icon = item.Icon,
			Style = "Menu",
			TextSize = 20,
			Size = UDim2.fromOffset(300, 46),
			Order = i,
			Parent = column,
			OnClick = function()
				onMenu(item.Id)
			end,
		})
		button:SetAttribute("DesktopOnly", item.Desktop == true)
		refs.Menu[item.Id] = button
	end
	return column
end

local function missionRow(parent, order)
	local row = C.new("Frame", { Name = "Mission", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = order, Parent = parent })
	C.new("Frame", { Name = "Mark", BackgroundColor3 = Colors.Yellow, BorderSizePixel = 0, Size = UDim2.new(0, 3, 1, -6), Position = UDim2.fromOffset(0, 3), Parent = row })
	-- (el contador va en la línea de la barra: el título usa todo el ancho hasta el premio y, si aun así
	-- no cabe, se reduce un poco antes de cortarse; en el teléfono se cortaba a media palabra)
	local text = C.text({ Name = "MissionText", Text = "", Role = "BodyBold", TextSize = 14, Scaled = true, MinTextSize = 11, Size = UDim2.new(1, -72, 0, 20), Position = UDim2.fromOffset(10, 2), Parent = row })
	local count = C.text({ Name = "Count", Text = "", Role = "Number", TextSize = 13, AlignX = Enum.TextXAlignment.Right, Size = UDim2.fromOffset(44, 16), Position = UDim2.new(1, -116, 0, 24), Parent = row })
	local reward = C.new("Frame", { Name = "Reward", BackgroundColor3 = Colors.Yellow, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(56, 26), Parent = row }, { C.corner(3) })
	local rewardText = C.text({ Text = "", Role = "Number", TextSize = 14, Color = Color3.fromRGB(16, 14, 8), AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = reward })
	local bar = C.progress({ Size = UDim2.new(1, -130, 0, 5), Position = UDim2.fromOffset(10, 30), Parent = row })
	return function(challenge)
		row.Visible = challenge ~= nil
		if not challenge then
			return
		end
		text.Text = tostring(challenge.Text or "")
		local progress = math.min(challenge.Progress or 0, challenge.Goal or 1)
		count.Text = string.format("%d/%d", progress, challenge.Goal or 1)
		bar:Set(challenge.Done and 1 or progress / math.max(1, challenge.Goal or 1))
		rewardText.Text = challenge.XP and (tostring(challenge.XP) .. " XP") or (tostring(challenge.Coins or 0) .. " 💰")
		reward.BackgroundColor3 = challenge.Done and Colors.Green or Colors.Yellow
	end
end

local function buildRight(parent)
	local column = C.new("Frame", {
		Name = "Right",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -24, 0, 84),
		Size = UDim2.fromOffset(350, 520),
		Parent = parent,
	}, { C.list(10) })
	-- Recompensa diaria (solo cuando está disponible)
	refs.Daily = C.button({
		Name = "Daily",
		Text = "RECOMPENSA DIARIA",
		Icon = Icons.Gift,
		Sub = "TOCA PARA RECOGER",
		Style = "Primary",
		TextSize = 22,
		Size = UDim2.new(1, 0, 0, 56),
		Order = 0,
		Parent = column,
		Sound = "Reward",
		OnClick = function()
			if Menu.ClaimDaily() then
				refs.Daily.Visible = false
				Transition.Flash(Colors.Yellow, 0.25, 0.3)
			end
		end,
	})
	refs.Daily.Visible = false
	-- Avisos cortos: pack de inicio, ruleta gratis, XP doble, primera victoria del día
	local chips = C.new("Frame", { Name = "Chips", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 0, Parent = column }, {
		C.list(6, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right),
	})
	local function chip(name, text, color, order, onClick)
		local button = C.button({ Name = name, Text = text, Style = "Ghost", TextSize = 13, Size = UDim2.fromOffset(0, 30), Order = order, Parent = chips, OnClick = onClick })
		button.AutomaticSize = Enum.AutomaticSize.X
		button.BackgroundColor3 = color
		button.BackgroundTransparency = 0.15
		local label = button:FindFirstChild("Label", true)
		if label then
			label.AutomaticSize = Enum.AutomaticSize.X
			label.TextColor3 = color == Colors.Yellow and Color3.fromRGB(16, 14, 8) or Colors.White
		end
		C.padding(0, 10, 0, 10).Parent = button
		return button
	end
	refs.ChipStarter = chip("Starter", "🎁 PACK DE INICIO", Colors.Yellow, 1, function()
		flow.SetState("Store", { Tab = "FEATURED" })
	end)
	refs.ChipWheel = chip("Wheel", "🎡 RULETA GRATIS", Colors.RedDark, 2, function()
		Wheel.Open()
	end)
	refs.ChipBoost = chip("Boost", "⚡ XP DOBLE", Colors.Blue, 3, function() end)
	refs.ChipFirstWin = chip("FirstWin", "🏆 1.ª VICTORIA +" .. tostring(GameConfig.FirstWinOfDay and GameConfig.FirstWinOfDay.Coins or 0) .. " 💰", Colors.PanelLight, 4, function()
		flow.Play()
	end)
	refs.Chips = chips
	-- Misiones diarias
	local missions = C.panel({ Name = "Missions", Size = UDim2.new(1, 0, 0, 190), Order = 1, Parent = column })
	local inner = C.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = missions }, { C.padding(10, 12, 10, 12), C.list(6) })
	refs.MissionsHeader = C.header(inner, "MISIONES DIARIAS", "0/3", 0)
	refs.Missions = {}
	for i = 1, 3 do
		refs.Missions[i] = missionRow(inner, i)
	end
	-- Evento activo o mapa destacado (rojo: eventos)
	local event = C.button({ Name = "Event", Text = "", Style = "Ghost", Size = UDim2.new(1, 0, 0, 92), Order = 2, Parent = column, OnClick = function()
		Menu.Open("Retos")
	end })
	event.BackgroundColor3 = Colors.RedDark
	event.BackgroundTransparency = 0.15
	refs.EventTag = C.text({ Text = "EVENTO ACTIVO", Role = "Title", TextSize = 15, Color = Colors.White, Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 20), ZIndex = 5, Parent = event })
	refs.EventName = C.text({ Text = "", Role = "TitleItalic", TextSize = 30, Color = Colors.White, Scaled = true, Position = UDim2.fromOffset(12, 28), Size = UDim2.new(1, -24, 0, 34), ZIndex = 5, Parent = event })
	refs.EventSub = C.text({ Text = "", Role = "BodyBold", TextSize = 13, Color = Color3.fromRGB(255, 210, 200), Position = UDim2.fromOffset(12, 64), Size = UDim2.new(1, -24, 0, 20), ZIndex = 5, Parent = event })
	refs.Event = event
	-- Arma destacada (la siguiente que se desbloquea o una de la tienda)
	local promo = C.button({ Name = "Promo", Text = "", Style = "Ghost", Size = UDim2.new(1, 0, 0, 110), Order = 3, Parent = column, OnClick = function()
		flow.SetState("Armory")
	end })
	promo.BackgroundColor3 = Color3.fromRGB(20, 40, 90)
	promo.BackgroundTransparency = 0.1
	local tag = C.new("Frame", { BackgroundColor3 = Colors.Yellow, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(110, 22), ZIndex = 5, Parent = promo }, { C.corner(3) })
	C.text({ Text = "NUEVA ARMA", Role = "Title", TextSize = 14, Color = Color3.fromRGB(16, 14, 8), AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 6, Parent = tag })
	refs.PromoName = C.text({ Text = "", Role = "TitleItalic", TextSize = 28, Scaled = true, Position = UDim2.fromOffset(12, 30), Size = UDim2.new(0.55, 0, 0, 32), ZIndex = 5, Parent = promo })
	refs.PromoSub = C.text({ Text = "", Role = "BodyBold", TextSize = 13, Color = Colors.TextDim, Position = UDim2.fromOffset(12, 66), Size = UDim2.new(0.55, 0, 0, 34), Wrap = true, ZIndex = 5, Parent = promo })
	refs.PromoIcon = C.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.new(0.48, 0, 1, -10), ZIndex = 5, Parent = promo })
	refs.Promo = promo
	return column
end

