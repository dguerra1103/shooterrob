KILL_FX.Rayo = function(position)
	-- Zigzag de neón desde el cielo
	local top = position + Vector3.new((math.random() - 0.5) * 6, 60, (math.random() - 0.5) * 6)
	local points = { top }
	for i = 1, 7 do
		local p = top:Lerp(position, i / 8) + Vector3.new((math.random() - 0.5) * 5, 0, (math.random() - 0.5) * 5)
		table.insert(points, p)
	end
	table.insert(points, position)
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local seg = fxPart({
			Size = Vector3.new(0.5, 0.5, (b - a).Magnitude),
			CFrame = safeLookAt((a + b) / 2, b - a),
			Color = Color3.fromRGB(190, 230, 255),
		})
		TweenService:Create(seg, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.1), { Transparency = 1, Size = Vector3.new(0.1, 0.1, seg.Size.Z) }):Play()
		Debris:AddItem(seg, 0.7)
	end
	local flash = flashBall(position, Color3.fromRGB(200, 240, 255), 12, 0.45)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(180, 220, 255)
	light.Range = 40
	light.Brightness = 8
	light.Parent = flash
	local anchor = emitterAnchor(position, Vector3.yAxis, 2)
	emit(anchor, {
		Texture = TEX.Sparkle,
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(80, 180, 255)),
		LightEmission = 1,
		Size = seq(1, 0),
		Lifetime = NumberRange.new(0.3, 0.7),
		Speed = NumberRange.new(20, 35),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 5,
	}, 30)
end

KILL_FX.Monedas = function(position)
	debrisBurst(position, 22, function()
		local coin = fxPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.15, 0.8, 0.8),
			Color = Color3.fromRGB(255, 200, 50),
			Material = Enum.Material.Foil,
		})
		return coin
	end, 24, 1.6)
	floatingText(position + Vector3.new(0, 2, 0), "+🪙", 80, Vector3.new(0, 4, 0), 1.4, Color3.fromRGB(255, 220, 80))
	local anchor = emitterAnchor(position, Vector3.yAxis, 2)
	emit(anchor, {
		Texture = TEX.Sparkle,
		Color = ColorSequence.new(Color3.fromRGB(255, 240, 150), Color3.fromRGB(255, 180, 30)),
		LightEmission = 1,
		Size = seq(0.8, 0),
		Lifetime = NumberRange.new(0.5, 1),
		Speed = NumberRange.new(10, 18),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 3,
	}, 24)
end

KILL_FX.AgujeroNegro = function(position)
	local hole = fxPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.5, 0.5, 0.5),
		CFrame = CFrame.new(position),
		Color = Color3.fromRGB(5, 0, 10),
		Material = Enum.Material.SmoothPlastic,
	})
	local ring = fxPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 1, 1),
		CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(170, 60, 255),
	})
	TweenService:Create(hole, TweenInfo.new(0.5, Enum.EasingStyle.Back), { Size = Vector3.one * 6 }):Play()
	TweenService:Create(ring, TweenInfo.new(0.5, Enum.EasingStyle.Back), { Size = Vector3.new(0.2, 11, 11) }):Play()
	-- Partículas que nacen en una esfera grande y caen hacia el centro
	local anchor = fxPart({ Size = Vector3.new(12, 12, 12), Transparency = 1, CFrame = CFrame.new(position) })
	Debris:AddItem(anchor, 2.5)
	emit(anchor, {
		Texture = TEX.Sparkle,
		Color = ColorSequence.new(Color3.fromRGB(200, 120, 255), Color3.fromRGB(255, 80, 200)),
		LightEmission = 1,
		Size = seq(0.7, 0),
		Lifetime = NumberRange.new(0.5, 0.6),
		Speed = NumberRange.new(10, 12),
		Shape = Enum.ParticleEmitterShape.Sphere,
		ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
	}, 50)
	task.delay(1.1, function()
		TweenService:Create(hole, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Size = Vector3.one * 0.1 }):Play()
		TweenService:Create(ring, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Size = Vector3.new(0.2, 0.1, 0.1), Transparency = 1 }):Play()
	end)
	Debris:AddItem(hole, 1.6)
	Debris:AddItem(ring, 1.6)
end

-- Dibuja el efecto de eliminación indicado (color = color del equipo de la víctima, para el normal)
-- Pintura: bolas de pintura de colores que saltan y manchas en el suelo alrededor
KILL_FX.Pintura = function(position)
	debrisBurst(position, 18, function()
		local ball = fxPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.6, 0.6, 0.6),
			Color = PAINT_COLORS[math.random(1, #PAINT_COLORS)],
			Material = Enum.Material.SmoothPlastic,
		})
		return ball
	end, 20, 1.4)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { folder }
	for i = 1, 6 do
		local angle = i / 6 * math.pi * 2
		local origin = position + Vector3.new(math.cos(angle) * 2.5, 1, math.sin(angle) * 2.5)
		local hit = workspace:Raycast(origin, Vector3.new(0, -8, 0), params)
		if hit and not hit.Instance.Parent:FindFirstChildOfClass("Humanoid") then
			local anchor = emitterAnchor(hit.Position, hit.Normal, 1)
			paintSplat(anchor, hit.Position, hit.Normal, false)
		end
	end
	floatingText(position + Vector3.new(0, 2, 0), "🎨", 80, Vector3.new(0, 4, 0), 1.3)
end

-- Arcoíris: un arco de bolas de colores que sale del enemigo y se desvanece
KILL_FX.Arcoiris = function(position)
	for i = 0, 13 do
		task.delay(i * 0.035, function()
			local t = i / 13
			local offset = Vector3.new((t - 0.5) * 9, math.sin(t * math.pi) * 6 + 1, 0)
			local ball = fxPart({
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(1.1, 1.1, 1.1),
				Color = Color3.fromHSV(t * 0.85, 0.8, 1),
				CFrame = CFrame.new(position + offset),
			})
			TweenService:Create(ball, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2) }):Play()
			Debris:AddItem(ball, 1.3)
		end)
	end
	flashBall(position, Color3.fromRGB(255, 255, 255), 5, 0.3)
	floatingText(position + Vector3.new(0, 3, 0), "🌈", 90, Vector3.new(0, 3, 0), 1.5)
end

function Effects.KillEffect(effectId, position, color)
	local fn = KILL_FX[effectId]
	if fn then
		fn(position)
	else
		Effects.DeathBurst(position, color)
	end
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">Emotes</string>
              <string name="Source"><![CDATA[-- Emotes (tecla N): menú con los bailes y gestos que trae Roblox (script Animate). Mientras dura el
-- emote la cámara pasa a tercera persona para verte; vuelve a primera persona al moverte o al acabar.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Sounds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Sounds"))

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local Emotes = {}

local EMOTES = {
	{ Id = "wave", Name = "Saludar", Icon = "👋" },
	{ Id = "dance", Name = "Baile 1", Icon = "🕺" },
	{ Id = "dance2", Name = "Baile 2", Icon = "💃" },
	{ Id = "dance3", Name = "Baile 3", Icon = "🎶" },
	{ Id = "cheer", Name = "Celebrar", Icon = "🙌" },
	{ Id = "laugh", Name = "Reír", Icon = "😂" },
	{ Id = "point", Name = "Señalar", Icon = "👉" },
}
local EMOTE_TIME = 4

local gui, wheel
local emoteUntil = 0
local zoom = { 0.5, 400 }

local function setThirdPerson(on)
	if on then
		-- Solo se guarda el zoom de primera persona (no el de un emote anterior)
		if not ClientState.Emoting then
			zoom = { player.CameraMinZoomDistance, player.CameraMaxZoomDistance }
		end
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMinZoomDistance = 9
		player.CameraMaxZoomDistance = 12
	else
		player.CameraMinZoomDistance = zoom[1]
		player.CameraMaxZoomDistance = zoom[2]
		player.CameraMode = Enum.CameraMode.LockFirstPerson
	end
end

local function stopEmote()
	if not ClientState.Emoting then
		return
	end
	ClientState.Emoting = false
	emoteUntil = 0
	if not ClientState.Dead then
		setThirdPerson(false)
	end
end

local function play(id)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local animate = character and character:FindFirstChild("Animate")
	local playEmote = animate and animate:FindFirstChild("PlayEmote")
	if not humanoid or humanoid.Health <= 0 or not playEmote or not playEmote:IsA("BindableFunction") then
		return
	end
	local ok, played = pcall(function()
		return playEmote:Invoke(id)
	end)
	-- PlayEmote devuelve true solo si de verdad empieza (nil si estás saltando, sentado, etc.)
	if ok and played == true then
		setThirdPerson(true)
		ClientState.Emoting = true
		emoteUntil = os.clock() + EMOTE_TIME
	end
end

local function setWheel(open)
	wheel.Visible = open
	ClientState.EmoteMenuOpen = open
	ClientState.UpdateMouse()
end

-- Otros motivos para cerrar el menú (no cuenta el propio menú de emotes)
local function otherBlock()
	return ClientState.MenuOpen or ClientState.VoteOpen or ClientState.InMainMenu or ClientState.Dead
end

local function build()
	gui = UI.new("ScreenGui", {
		Name = "Emotes",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 2,
		Parent = player:WaitForChild("PlayerGui"),
	})
	wheel = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(360, 360),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	-- Libera el ratón mientras el menú está abierto
	UI.new("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true, Parent = wheel })
	UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(120, 40),
		Text = "EMOTES",
		TextSize = 24,
		Parent = wheel,
	})
	for i, emote in EMOTES do
		local angle = (i - 1) / #EMOTES * math.pi * 2 - math.pi / 2
		local button = UI.button({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.cos(angle) * 130, 0.5, math.sin(angle) * 130),
			Size = UDim2.fromOffset(92, 92),
			Text = "",
			BackgroundColor3 = Color3.fromRGB(40, 44, 70),
			BackgroundTransparency = 0.15,
			Parent = wheel,
		}, { UI.stroke(Color3.new(1, 1, 1), 3, 0), UI.corner(46) })
		UI.label({ Size = UDim2.new(1, 0, 0.7, 0), Text = emote.Icon, TextSize = 40, Parent = button })
		UI.label({ Position = UDim2.fromScale(0, 0.62), Size = UDim2.new(1, 0, 0.3, 0), Text = emote.Name, TextSize = 15, Parent = button })
		button.Activated:Connect(function()
			Sounds.Play("Click")
			setWheel(false)
			play(emote.Id)
		end)
	end
end

function Emotes.Init()
	build()
	ContextActionService:BindAction("Emotes", function(_, state)
		if state == Enum.UserInputState.Begin then
			if wheel.Visible then
				setWheel(false)
			elseif not ClientState.IsBlocked() then
				setWheel(true)
			end
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.N)
	-- Botón táctil en móvil
	ContextActionService:SetTitle("Emotes", "😀")
	ContextActionService:SetPosition("Emotes", UDim2.new(1, -120, 1, -320))
	RunService.Heartbeat:Connect(function()
		if wheel.Visible and otherBlock() then
			setWheel(false)
		end
		if not ClientState.Emoting then
			return
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		-- Se acaba al pasar el tiempo, al moverse, al morir o al disparar
		local moved = humanoid and humanoid.MoveDirection.Magnitude > 0.1
		if os.clock() > emoteUntil or moved or not humanoid or humanoid.Health <= 0 or ClientState.Aiming then
			stopEmote()
		end
	end)
	ClientState.ShotFired.Event:Connect(stopEmote)
	player.CharacterAdded:Connect(stopEmote)
end

return Emotes
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">EventHUD</string>
              <string name="Source"><![CDATA[-- Contador del evento de temporada (debajo del botón de regalos): caramelos recogidos hacia el
-- siguiente premio (GameConfig.Event.Milestones y la skin final), con marcas en la barra.
-- Solo aparece si el servidor tiene un evento activo (atributo EventName).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local EventHUD = {}

function EventHUD.Init()
	local compact = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local gui = UI.new("ScreenGui", {
		Name = "EventHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local frame = UI.new("Frame", {
		-- En móvil: estrecho, debajo del regalo (a su derecha están los retos)
		Position = compact and UDim2.fromOffset(10, 174) or UDim2.new(0, 66, 0.38, 176),
		Size = compact and UDim2.fromOffset(52, 40) or UDim2.fromOffset(230, 34),
		BackgroundColor3 = Color3.fromRGB(60, 25, 80),
		BackgroundTransparency = 0.15,
		Parent = gui,
	}, { UI.corner(10), UI.stroke(Color3.fromRGB(255, 140, 30), 2, 0.2) })
	local label = UI.label({
		Position = UDim2.fromOffset(2, 0),
		Size = UDim2.new(1, -4, 1, -4),
		Text = "",
		TextSize = 18,
		TextScaled = compact,
		TextWrapped = compact,
		Parent = frame,
	})
	local fill = UI.new("Frame", {
		Position = UDim2.new(0, 4, 1, -5),
		Size = UDim2.new(0, 0, 0, 3),
		BackgroundColor3 = Color3.fromRGB(255, 140, 30),
		BorderSizePixel = 0,
		Parent = frame,
	})
	local milestones = (GameConfig.Event and GameConfig.Event.Milestones) or {}
	local ticks = {}
	for _, milestone in milestones do
		table.insert(ticks, UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Size = UDim2.fromOffset(2, 5),
			Position = UDim2.new(0, 0, 1, -6),
			BackgroundColor3 = Color3.fromRGB(255, 230, 150),
			BorderSizePixel = 0,
			Visible = not compact,
			Parent = frame,
		}))
	end
	-- Siguiente premio: caramelos que hacen falta y texto corto (si ya tienes el traje, son monedas)
	local function nextPrize(count, goal, data)
		for _, milestone in milestones do
			if count < milestone.Count and milestone.Count < goal then
				local outfit = milestone.Outfit and not (data.Outfits or {})[milestone.Outfit]
				return milestone.Count, outfit and "Traje" or ((milestone.Coins or milestone.Compensate or 0) .. " 🪙")
			end
		end
		return goal, "Skin"
	end
	task.spawn(function()
		while true do
			local name = ReplicatedStorage:GetAttribute("EventName")
			local goal = ReplicatedStorage:GetAttribute("EventGoal") or 100
			local data = ClientState.Data
			gui.Enabled = name ~= nil and data ~= nil and not ClientState.InMainMenu
			if gui.Enabled then
				local count = data.EventCandy or 0
				if count >= goal then
					label.Text = compact and "🎃\n✔" or "🎃 ¡Skin del evento conseguida!"
				else
					local target, prize = nextPrize(count, goal, data)
					label.Text = compact and ("🍬\n" .. count .. "/" .. target)
						or ("🎃 🍬 " .. count .. "/" .. target .. "  → " .. prize)
				end
				fill.Size = UDim2.new(math.clamp(count / goal, 0, 1), -8, 0, 3)
				for i, tick in ticks do
					local at = milestones[i].Count / goal
					tick.Visible = not compact and at < 1
					tick.Position = UDim2.new(at, 4 - 8 * at, 1, -6)
					tick.BackgroundColor3 = count >= milestones[i].Count and Color3.fromRGB(255, 140, 30)
						or Color3.fromRGB(255, 230, 150)
				end
			end
			task.wait(0.5)
		end
	end)
end

return EventHUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">Footprints</string>
              <string name="Source"><![CDATA[-- Huellas en superficies blandas (nieve, arena, barro, tierra): solo en el cliente, para los
-- personajes cercanos. Se desvanecen solas y hay un máximo para no gastar memoria. En calidad Baja
-- no se crean.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local ClientState = require(script.Parent.ClientState)

local Footprints = {}

-- Color de la huella según el material que pisa (algo más oscuro que la superficie)
local SOFT = {
	[Enum.Material.Snow] = Color3.fromRGB(184, 194, 214),
	[Enum.Material.Sand] = Color3.fromRGB(140, 120, 88),
	[Enum.Material.Mud] = Color3.fromRGB(58, 44, 30),
	[Enum.Material.Ground] = Color3.fromRGB(80, 66, 46),
}
local STEP_DISTANCE = 2.6 -- studs entre pisadas
local MAX_PRINTS = 70
local LIFETIME = 9
local MAX_DISTANCE = 90 -- solo personajes cerca de la cámara
local CHECK_INTERVAL = 0.08

local folder
local prints = {}
local tracked = {} -- [character] = { Last = Vector3, Left = boolean }

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function removePrint(part)
	local index = table.find(prints, part)
	if index then
		table.remove(prints, index)
	end
	part:Destroy()
end

local function addPrint(cf, color)
	if #prints >= MAX_PRINTS then
		removePrint(prints[1])
	end
	local part = Instance.new("Part")
	part.Name = "Footprint"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.SmoothPlastic
	part.Color = color
	part.Size = Vector3.new(0.65, 0.04, 1.1)
	part.Transparency = 0.35
	part.CFrame = cf
	part.Parent = folder
	table.insert(prints, part)
	-- Se mantiene un rato y luego se borra poco a poco (como la nieve que cae encima)
	local fade = TweenInfo.new(LIFETIME * 0.6, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, LIFETIME * 0.4)
	TweenService:Create(part, fade, { Transparency = 1 }):Play()
	task.delay(LIFETIME, function()
		if part.Parent then
			removePrint(part)
		end
	end)
end

local function step(character, humanoid, root, state)
	local flat = Vector3.new(1, 0, 1)
	local moved = (root.Position - state.Last) * flat
	if moved.Magnitude < STEP_DISTANCE then
		return
	end
	state.Last = root.Position
	-- El material sale del rayo hacia el suelo (FloorMaterial solo se calcula para tu personaje);
	-- si no hay suelo cerca (saltando) no hay huella
	rayParams.FilterDescendantsInstances = { folder, character }
	local result = workspace:Raycast(root.Position, Vector3.new(0, -(humanoid.HipHeight + root.Size.Y / 2 + 1), 0), rayParams)
	local color = result and SOFT[result.Material]
	if not color then
		return
	end
	local normal = result.Normal
	local forward = moved.Unit
	forward = (forward - normal * forward:Dot(normal))
	if forward.Magnitude < 0.01 then
		return
	end
	forward = forward.Unit
	local right = forward:Cross(normal)
	state.Left = not state.Left
	local position = result.Position + normal * 0.02 + right * (state.Left and -0.45 or 0.45)
	addPrint(CFrame.fromMatrix(position, right, normal, -forward), color)
end

function Footprints.Init()
	folder = Instance.new("Folder")
	folder.Name = "Footprints"
	folder.Parent = workspace

	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < CHECK_INTERVAL then
			return
		end
		elapsed = 0
		if ClientState.EffectiveQuality == "Baja" then
			return
		end
		local camera = workspace.CurrentCamera
		local seen = {}
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if humanoid and root and humanoid.Health > 0 and camera and (root.Position - camera.CFrame.Position).Magnitude < MAX_DISTANCE then
				seen[character] = true
				local state = tracked[character]
				if not state then
					state = { Last = root.Position, Left = false }
					tracked[character] = state
				end
				step(character, humanoid, root, state)
			end
		end
		for character in tracked do
			if not seen[character] then
				tracked[character] = nil
			end
		end
	end)
end

return Footprints
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">GrenadeController</string>
              <string name="Source"><![CDATA[-- Granada en el cliente: tecla G (L1 en mando, botón en móvil), indicador de recarga y explosiones.
local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weapons = require(Shared.Weapons)
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)
local Effects = require(script.Parent.Effects)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local GrenadeController = {}

local DEF = Weapons.Grenade

local widget, label, fill

local function readyAt()
	return player:GetAttribute("GrenadeReadyAt") or 0
end

local function canThrow()
	if ClientState.IsBlocked() or ClientState.Frozen() or ReplicatedStorage:GetAttribute("Mode") == "GUN" then
		return false
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0 and workspace:GetServerTimeNow() >= readyAt()
end

local function throw()
	if not canThrow() then
		return
	end
	-- Un poco hacia arriba para que la parábola llegue más lejos
	local direction = (camera.CFrame.LookVector + Vector3.new(0, 0.12, 0)).Unit
	Remotes.ThrowGrenade:FireServer(direction)
	Sounds.Play("Swing", nil, 0.8, 1)
end

local function updateWidget()
	local gunGame = ReplicatedStorage:GetAttribute("Mode") == "GUN"
	widget.Visible = not ClientState.InMainMenu and not gunGame
	if not widget.Visible then
		return
	end
	local left = readyAt() - workspace:GetServerTimeNow()
	if left <= 0 then
		label.Text = "💣 G"
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		fill.Size = UDim2.fromScale(1, 1)
		fill.BackgroundColor3 = Color3.fromRGB(255, 90, 40)
	else
		label.Text = "💣 " .. math.ceil(left)
		label.TextColor3 = Color3.fromRGB(190, 190, 200)
		fill.Size = UDim2.fromScale(1 - left / DEF.Cooldown, 1)
		fill.BackgroundColor3 = Color3.fromRGB(90, 90, 110)
	end
end

function GrenadeController.Init()
	local gui = UI.new("ScreenGui", {
		Name = "Grenade",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 2,
		Parent = player:WaitForChild("PlayerGui"),
	})
	widget = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -150),
		Size = UDim2.fromOffset(84, 34),
		BackgroundColor3 = Color3.fromRGB(20, 22, 34),
		BackgroundTransparency = 0.25,
		Parent = gui,
	}, { UI.corner(10), UI.stroke(Color3.fromRGB(255, 120, 60), 2, 0.3) })
	fill = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 0.55,
		Parent = widget,
	}, { UI.corner(10) })
	label = UI.label({ Size = UDim2.fromScale(1, 1), Text = "💣 G", TextSize = 20, ZIndex = 2, Parent = widget })

	ContextActionService:BindAction("Grenade", function(_, state)
		if state == Enum.UserInputState.Begin then
			throw()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.G, Enum.KeyCode.ButtonL1)
	ContextActionService:SetTitle("Grenade", "💣")
	ContextActionService:SetPosition("Grenade", UDim2.new(1, -200, 1, -270))

	Remotes.ExplosionFX.OnClientEvent:Connect(function(position, radius)
		if typeof(position) == "Vector3" then
			Effects.Explosion(position, type(radius) == "number" and radius or 14)
			-- Sonido en el punto de la explosión (se oye más fuerte cuanto más cerca)
			local spot = Instance.new("Attachment")
			spot.WorldPosition = position
			spot.Parent = workspace.Terrain
			Sounds.Play("ShotHeavy", spot, 0.45, 1.6)
			Debris:AddItem(spot, 5)
		end
	end)

	RunService.Heartbeat:Connect(updateWidget)
end

return GrenadeController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[-- Interfaz en partida: marcador, mira, munición, vida, racha, killfeed, avisos y pantallas de ronda.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weapons = require(Shared.Weapons)
local GameConfig = require(Shared.GameConfig)
local Skins = require(Shared.Skins)
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)
local Ranks = require(Shared.Ranks)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local WeaponController = require(script.Parent.WeaponController)
local WeaponIcon = require(script.Parent.WeaponIcon)

local player = Players.LocalPlayer

local HUD = {}

local gui
local refs = {}
local thumbnails = {}

local function tween(inst, time, props, style)
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad), props)
	t:Play()
	return t
end

local function disableCoreGui()
	for _ = 1, 20 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
		end)
		if ok then
			return
		end
		task.wait(0.5)
	end
end

---------------------------------------------------------------------------
-- Construcción
---------------------------------------------------------------------------

local function buildTopBar()
	local top = UI.new("Frame", {
		Name = "TopBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(330, 44),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local function scoreBox(x, name)
		local box = UI.new("Frame", {
			Name = name,
			Position = UDim2.fromOffset(x, 0),
			Size = UDim2.fromOffset(90, 44),
			BackgroundColor3 = Color3.fromRGB(80, 80, 80),
			Parent = top,
		}, { UI.corner(10), UI.stroke(Color3.new(0, 0, 0), 3, 0), UI.gloss() })
		return UI.label({
			Size = UDim2.fromScale(1, 1),
			Text = "0",
			TextSize = 30,
			Parent = box,
		})
	end
	refs.ScoreA = scoreBox(0, "TeamA")
	refs.ScoreB = scoreBox(240, "TeamB")
	refs.ScoreABox = refs.ScoreA.Parent
	refs.ScoreBBox = refs.ScoreB.Parent

	-- Estado de las banderas (solo en Captura la bandera), a los lados del marcador
	refs.FlagA = UI.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromOffset(-8, 0),
		Size = UDim2.fromOffset(150, 44),
		Text = "",
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = top,
	})
	refs.FlagB = UI.label({
		Position = UDim2.fromOffset(338, 0),
		Size = UDim2.fromOffset(150, 44),
		Text = "",
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = top,
	})

	local timerBox = UI.new("Frame", {
		Position = UDim2.fromOffset(95, 0),
		Size = UDim2.fromOffset(140, 44),
		BackgroundColor3 = Color3.fromRGB(35, 45, 95),
		Parent = top,
	}, { UI.corner(10), UI.stroke(Color3.new(0, 0, 0), 3, 0), UI.gloss(Color3.fromRGB(120, 120, 150)) })
	refs.Timer = UI.label({ Size = UDim2.fromScale(1, 1), Text = "00:00", TextSize = 30, Parent = timerBox })

	refs.Mode = UI.label({
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 0, 20),
		Text = "",
		TextSize = 16,
		Parent = top,
	})

	refs.PlayerRow = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.fromOffset(500, 54),
		BackgroundTransparency = 1,
		Parent = top,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
end

local function buildCrosshair()
	local holder = UI.new("Frame", {
		Name = "Crosshair",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	refs.Crosshair = holder
	refs.CrossLines = {}
	for i, dir in { Vector2.new(0, -1), Vector2.new(0, 1), Vector2.new(-1, 0), Vector2.new(1, 0) } do
		local vertical = dir.X == 0
		refs.CrossLines[i] = {
			Dir = dir,
			Frame = UI.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = vertical and UDim2.fromOffset(2, 9) or UDim2.fromOffset(9, 2),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				Parent = holder,
			}, { UI.stroke(Color3.new(0, 0, 0), 1, 0.4) }),
		}
	end
	refs.CrossDot = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(3, 3),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = holder,
	}, { UI.corner(2) })

	-- Hitmarker (4 líneas diagonales)
	refs.Hitmarker = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(34, 34),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	refs.HitLines = {}
	for i, pos in { Vector2.new(-1, -1), Vector2.new(1, -1), Vector2.new(-1, 1), Vector2.new(1, 1) } do
		refs.HitLines[i] = UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, pos.X * 10, 0.5, pos.Y * 10),
			Size = UDim2.fromOffset(10, 3),
			Rotation = pos.X * pos.Y * 45,
			BorderSizePixel = 0,
			BackgroundColor3 = Color3.new(1, 1, 1),
			Parent = refs.Hitmarker,
		})
	end

	-- Mira telescópica (círculo con borde negro enorme)
	refs.Scope = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.8, 0.8),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 0,
		Parent = gui,
	}, {
		UI.new("UIAspectRatioConstraint", { AspectRatio = 1 }),
		UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
		UI.new("UIStroke", { Thickness = 3000, Color = Color3.new(0, 0, 0) }),
		-- Bandas negras a los lados (por si el borde no cubre toda la pantalla)
		UI.new("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.new(0, 4000, 3, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
		}),
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.new(0, 4000, 3, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
		}),
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, 0, 0, 2),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
		}),
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 2, 1, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
		}),
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(5, 5),
			BackgroundColor3 = Color3.fromRGB(255, 40, 40),
			BorderSizePixel = 0,
		}, { UI.corner(3) }),
	})
end

local function buildWeaponPanel()
	-- Munición (abajo a la derecha)
	local panel = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -20),
		Size = UDim2.fromOffset(260, 104),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	refs.WeaponName = UI.label({
		Size = UDim2.new(1, 0, 0, 24),
		Text = "",
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = panel,
	})
	refs.Ammo = UI.label({
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 0, 50),
		Text = "",
		TextSize = 46,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = panel,
	})
	-- Barra del cargador
	local ammoBar = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 76),
		Size = UDim2.fromOffset(170, 6),
		BackgroundColor3 = Color3.fromRGB(20, 20, 25),
		BackgroundTransparency = 0.3,
		Parent = panel,
	}, { UI.corner(3) })
	refs.AmmoFill = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(255, 210, 80),
		Parent = ammoBar,
	}, { UI.corner(3) })
	refs.AmmoBar = ammoBar
	refs.ReloadHint = UI.label({
		Position = UDim2.fromOffset(0, 85),
		Size = UDim2.new(1, 0, 0, 18),
		Text = "",
		TextSize = 16,
		TextColor3 = Color3.fromRGB(255, 210, 80),
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = panel,
	})

	-- Ranuras de armas (derecha) con icono 3D del arma
	local slots = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -20, 0.6, 0),
		Size = UDim2.fromOffset(230, 196),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			Padding = UDim.new(0, 6),
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	refs.Slots = {}
	for slot = 1, 3 do
		local row = UI.new("Frame", {
			LayoutOrder = slot,
			Size = UDim2.fromOffset(230, 60),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.7,
			Parent = slots,
		}, { UI.corner(10) })
		local stroke = UI.stroke(Color3.fromRGB(255, 200, 60), 2, 1)
		stroke.Parent = row
		local icon = UI.new("Frame", {
			Position = UDim2.fromOffset(6, 2),
			Size = UDim2.fromOffset(170, 44),
			BackgroundTransparency = 1,
			Parent = row,
		})
		local name = UI.label({
			Position = UDim2.fromOffset(10, 42),
			Size = UDim2.fromOffset(170, 16),
			Text = "",
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		local key = UI.new("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.fromOffset(30, 30),
			BackgroundColor3 = Color3.fromRGB(20, 20, 25),
			Parent = row,
		}, { UI.corner(6), UI.stroke(Color3.new(0, 0, 0), 2, 0) })
		UI.label({ Size = UDim2.fromScale(1, 1), Text = tostring(slot), TextSize = 18, Parent = key })
		refs.Slots[slot] = { Name = name, Key = key, Row = row, Stroke = stroke, Icon = icon, IconKey = nil }
	end

	-- Controles (estilo de la captura)
	if not UserInputService.TouchEnabled or UserInputService.KeyboardEnabled then
		local hints = UI.new("Frame", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -20, 0.18, 0),
			Size = UDim2.fromOffset(220, 253),
			BackgroundTransparency = 1,
			Parent = gui,
		}, {
			UI.new("UIListLayout", {
				Padding = UDim.new(0, 3),
				HorizontalAlignment = Enum.HorizontalAlignment.Right,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		for i, pair in {
			{ "Menú y tienda", "B" },
			{ "Granada", "G" },
			{ "Ataque aéreo (racha 5)", "T" },
			{ "Deslizar", "C" },
			{ "Cuchillo rápido", "F" },
			{ "Recargar", "R" },
			{ "Inspeccionar", "V" },
			{ "Habilidades", "E Z X" },
			{ "Emotes", "N" },
			{ "Marcador", "Tab" },
			{ "Regalo", "H" },
		} do
			local row = UI.new("Frame", {
				LayoutOrder = i,
				Size = UDim2.fromOffset(220, 20),
				BackgroundTransparency = 1,
				Parent = hints,
			})
			UI.label({
				Size = UDim2.new(1, -56, 1, 0),
				Text = pair[1],
				TextSize = 15,
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = row,
			})
			local key = UI.new("Frame", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(46, 19),
				BackgroundColor3 = Color3.fromRGB(20, 20, 25),
				Parent = row,
			}, { UI.corner(5) })
			UI.label({ Size = UDim2.fromScale(1, 1), Text = pair[2], TextSize = 14, Parent = key })
		end
	end
end

