      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Challenges</string>
          <string name="Source"><![CDATA[-- Retos diarios: cada jugador recibe 3 al día (distintos para cada uno). Se completan solos al jugar
-- y dan monedas + XP al momento. Completar los 3 regala una caja. Se puede cambiar 1 reto al día.
--
-- Stat: "Kill" (con Weapons opcional para limitar a ciertas armas), "Headshot", "Win", "Match",
-- "Capture", "ZoneTime" (segundos en la zona), "Streak" (mejor racha, no se suma), "Survive" (ganar una
-- Infección como superviviente).
local Challenges = {}

Challenges.PerDay = 3
Challenges.RerollsPerDay = 1
Challenges.BonusCrates = 1 -- por completar todos los del día

Challenges.Pool = {
	{ Id = "Kills", Stat = "Kill", Goal = 15, Text = "Consigue 15 bajas", Coins = 150, XP = 300 },
	{ Id = "Headshots", Stat = "Headshot", Goal = 5, Text = "Haz 5 bajas a la cabeza", Coins = 200, XP = 300 },
	{ Id = "Wins", Stat = "Win", Goal = 2, Text = "Gana 2 partidas", Coins = 250, XP = 400 },
	{ Id = "Matches", Stat = "Match", Goal = 3, Text = "Termina 3 partidas", Coins = 150, XP = 300 },
	{ Id = "Captures", Stat = "Capture", Goal = 2, Text = "Captura 2 banderas", Coins = 250, XP = 400 },
	{ Id = "Zone", Stat = "ZoneTime", Goal = 60, Text = "Controla la zona 60 segundos", Coins = 200, XP = 300 },
	{ Id = "Streak", Stat = "Streak", Goal = 5, Text = "Consigue una racha de 5 bajas", Coins = 300, XP = 400 },
	{ Id = "Rifles", Stat = "Kill", Weapons = { "ARX27", "VortexBR", "TitanLMG", "SplatX" }, Goal = 12, Text = "12 bajas con fusil, ametralladora o paintball", Coins = 200, XP = 300 },
	{ Id = "SMGs", Stat = "Kill", Weapons = { "Specter9", "NovaDrift" }, Goal = 10, Text = "10 bajas con subfusil", Coins = 200, XP = 300 },
	{ Id = "Shotguns", Stat = "Kill", Weapons = { "HavocPump", "BreachHammer" }, Goal = 6, Text = "6 bajas con escopeta", Coins = 200, XP = 300 },
	{ Id = "Snipers", Stat = "Kill", Weapons = { "Signal7", "GhostlineXR", "RaptorDMR" }, Goal = 4, Text = "4 bajas con francotirador o DMR", Coins = 250, XP = 350, MinLevel = 3 },
	{ Id = "Pistols", Stat = "Kill", Weapons = { "Viper", "HandCannon", "PhantomSidewind" }, Goal = 4, Text = "4 bajas con pistola", Coins = 200, XP = 300 },
	{ Id = "Knife", Stat = "Kill", Weapons = { "Knife", "ToyHammer", "Katana" }, Goal = 2, Text = "2 bajas cuerpo a cuerpo", Coins = 300, XP = 400 },
	{ Id = "Grenades", Stat = "Kill", Weapons = { "Grenade" }, Goal = 3, Text = "3 bajas con granada", Coins = 250, XP = 350 },
	{ Id = "Rockets", Stat = "Kill", Weapons = { "NovaLauncher" }, Goal = 3, Text = "3 bajas con el Tempest Core", Coins = 250, XP = 350, MinLevel = 14 },
	-- Modo Infección (Halloween)
	{ Id = "Infect", Stat = "Kill", Weapons = { "Claws" }, Goal = 3, Text = "Infecta a 3 supervivientes (Infección)", Coins = 250, XP = 350 },
	{ Id = "Survive", Stat = "Survive", Goal = 1, Text = "Sobrevive hasta el final de una Infección", Coins = 300, XP = 400 },
}

local byId = {}
for _, c in Challenges.Pool do
	byId[c.Id] = c
end

function Challenges.Get(id)
	return byId[id]
end

-- ¿Cuenta este evento para el reto?
function Challenges.Matches(challenge, stat, weaponName)
	if challenge.Stat ~= stat then
		return false
	end
	if challenge.Weapons then
		return weaponName ~= nil and table.find(challenge.Weapons, weaponName) ~= nil
	end
	return true
end

-- Elige `count` retos distintos (sin repetir los de `exclude`). Determinista por día y jugador.
function Challenges.Pick(day, userId, level, count, exclude, salt)
	local rng = Random.new(day * 7919 + userId * 31 + (salt or 0))
	local pool = {}
	for _, c in Challenges.Pool do
		if (c.MinLevel or 1) <= (level or 1) and not (exclude and exclude[c.Id]) then
			table.insert(pool, c.Id)
		end
	end
	local picked = {}
	for _ = 1, math.min(count, #pool) do
		local i = rng:NextInteger(1, #pool)
		table.insert(picked, table.remove(pool, i))
	end
	return picked
end

return Challenges
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">GameConfig</string>
          <string name="Source"><![CDATA[-- Configuración general del juego. Cambia aquí los valores para ajustar el balance.
local GameConfig = {}

-- Nombre que aparece en la pantalla de inicio y en los carteles del mapa
GameConfig.GameTitle = "SHOOTER NEW"
-- Estilo de los mapas: "Cartoon" (colores vivos, plástico liso, sombras suaves, como los shooters más
-- jugados de Roblox) o "Realista" (piedra, yeso, ladrillo y luz más dura)
GameConfig.VisualStyle = "Cartoon"

-- Equipos
GameConfig.Teams = {
	{ Name = "Rojo", Color = BrickColor.new("Really red") },
	{ Name = "Azul", Color = BrickColor.new("Really blue") },
}

-- Rondas
GameConfig.MinPlayers = 1 -- súbelo a 2+ cuando publiques el juego
GameConfig.IntermissionTime = 20

-- Modos de juego. En cada descanso se votan 3 combinaciones de mapa + modo entre estos.
-- Quita alguno de la lista si no lo quieres.
GameConfig.Modes = { "TDM", "CTF", "KOTH", "FFA", "GUN", "ELIM", "INF" }
GameConfig.ModeSettings = {
	TDM = { Name = "Duelo por equipos", ScoreToWin = 40, RoundTime = 8 * 60, Teams = true }, -- puntos = bajas
	CTF = { Name = "Captura la bandera", ScoreToWin = 3, RoundTime = 10 * 60, Teams = true }, -- puntos = capturas
	KOTH = { Name = "Zona de control", ScoreToWin = 150, RoundTime = 10 * 60, Teams = true }, -- 1 punto/seg en la zona
	FFA = { Name = "Todos contra todos", ScoreToWin = 25, RoundTime = 8 * 60, Teams = false }, -- bajas individuales
	GUN = { Name = "Escalada de armas", ScoreToWin = 0, RoundTime = 10 * 60, Teams = false }, -- 0 = una baja por arma
	-- Eliminación: rondas cortas de UNA vida; gana la ronda el equipo que deje al otro sin nadie en pie
	ELIM = { Name = "Eliminación", ScoreToWin = 5, RoundTime = 10 * 60, Teams = true, SubRoundTime = 75, PrepTime = 4 },
	-- Infección (Halloween): todos empiezan como supervivientes (equipo A) y tras PrepTime uno de cada
	-- ZombieRatio se convierte en zombi (equipo B: garras, más vida y algo más rápidos). Quien cae ante
	-- los zombis se convierte en zombi. Ganan los supervivientes si queda alguno al acabar el tiempo.
	INF = { Name = "Infección", ScoreToWin = 1, RoundTime = 150, Teams = true, PrepTime = 12, ZombieHealth = 200, ZombieRatio = 5 },
}
GameConfig.VoteTime = 15 -- segundos de votación (dentro del descanso)

-- Captura la bandera
GameConfig.Flag = {
	PickupRadius = 5, -- distancia para coger/devolver la bandera
	CaptureRadius = 7, -- distancia a tu base para capturar
	AutoReturnTime = 20, -- segundos que tarda en volver sola si nadie la toca
	CarrierSpeedMultiplier = 0.9, -- el portador va un poco más lento
}
GameConfig.EndScreenTime = 8
GameConfig.RespawnTime = 3
GameConfig.RespawnNowDelay = 1 -- "Regenerar ahora" se puede pulsar a partir de este segundo
GameConfig.StartingRevives = 3 -- revivir instantáneos con los que empieza un jugador nuevo
GameConfig.ReviveShieldTime = 2 -- segundos de escudo al revivir

-- Habilidades (iconos abajo en el centro): Impulso (E), Supersalto (Z) y Poción (X)
GameConfig.Abilities = {
	Dash = { Cooldown = 6, Speed = 78, Duration = 0.2 },
	Jump = { Cooldown = 10, Power = 82, Forward = 22 },
	Potion = { Cooldown = 25, Heal = 50, Duration = 2.5 },
}
-- Bots: rellenan la partida cuando hay pocos jugadores (se quitan solos al entrar gente)
GameConfig.Bots = {
	Enabled = true,
	FillTo = 6, -- jugadores + bots hasta este número
	Weapons = { "ARX27", "Specter9", "VortexBR", "NovaDrift", "SplatX" },
	Range = 140,
	Accuracy = 0.55, -- probabilidad de acertar a corta distancia
	AccuracyFalloff = 0.004, -- se resta por cada stud de distancia
	DamageScale = 0.55, -- los bots hacen menos daño que un jugador
	Reaction = 0.5, -- segundos antes de empezar a disparar a un objetivo nuevo
	MaxFireRate = 6, -- disparos por segundo como máximo
	WalkSpeed = 16,
	JumpChance = 0.2, -- probabilidad de saltar en cada cambio de dirección mientras pelea
	RewardScale = 0.5, -- XP y monedas por matar un bot (respecto a un jugador)
	-- Puntería y daño contra cada jugador según su rango (Bronce, Plata, Oro, Platino, Diamante,
	-- Campeón): con los novatos son más blandos y con los mejores aprietan más
	SkillByRank = { 0.75, 0.85, 1, 1.1, 1.2, 1.3 },
}
-- Evento de temporada (Halloween): durante las rondas aparecen caramelos por el mapa; cada uno da
-- monedas y suma al contador del evento; al llegar a Goal se gana la skin exclusiva RewardSkin.
-- Pon Enabled = false cuando acabe el evento (el progreso queda guardado por si vuelve).
GameConfig.Event = {
	Enabled = true,
	Id = "Halloween2026", -- cambia el Id para empezar de cero en otro evento
	Name = "Halloween",
	CandyCoins = 5, -- monedas por caramelo
	Goal = 100, -- caramelos para la skin
	RewardSkin = "Embrujada",
	-- Premios por el camino (el último premio es la skin al llegar a Goal). Si ya tenías el traje,
	-- se cambia por Compensate monedas.
	Milestones = {
		{ Count = 25, Coins = 150 },
		{ Count = 50, Outfit = "Calabaza", Compensate = 400 },
		{ Count = 75, Coins = 300 },
	},
	SpawnEvery = 12, -- segundos entre caramelos
	MaxCandies = 6, -- a la vez en el mapa
	Pumpkins = true, -- calabazas de decoración en los mapas
	EndsAt = 1793750400, -- se apaga solo a partir de esta fecha (4 nov 2026, 00:00 UTC); nil = nunca
}

-- Regalos por tiempo jugado en la sesión (minutos desde que entras; se recogen en orden, botón 🎁)
GameConfig.PlaytimeGifts = {
	{ Minutes = 2, Coins = 40 },
	{ Minutes = 5, Coins = 75 },
	{ Minutes = 10, Revives = 1 },
	{ Minutes = 15, Coins = 150 },
	{ Minutes = 20, Coins = 100, XP = 250 },
	{ Minutes = 30, Revives = 2 },
	{ Minutes = 45, Coins = 300 },
}
GameConfig.SpawnProtection = 2 -- segundos de escudo al reaparecer
GameConfig.TrainingDummies = false -- muñecos de práctica quietos (ya no hacen falta: los bots sirven para practicar)

-- Movimiento
GameConfig.WalkSpeed = 18
GameConfig.SprintSpeed = 26
GameConfig.AimWalkSpeed = 11
GameConfig.SlideSpeed = 58
GameConfig.SlideDuration = 0.75
GameConfig.SlideCooldown = 1.1
GameConfig.FieldOfView = 80

-- Ajustes del jugador (menú Ajustes). Se guardan con su progreso.
-- "Auto": Baja en móviles y Media en PC (lo decide el cliente)
GameConfig.QualityLevels = { "Auto", "Baja", "Media", "Alta", "Ultra" }
GameConfig.DefaultSettings = { Quality = "Auto", QualityVersion = 2, FOV = 80, Sensitivity = 1, AimSensitivity = 0.8 }
GameConfig.SettingsLimits = {
	FOV = { 70, 100 },
	Sensitivity = { 0.2, 3 },
	AimSensitivity = { 0.2, 1.5 },
}

-- Progresión (pase de batalla)
GameConfig.XPPerLevel = 1000
GameConfig.XP = {
	Kill = 100,
	Headshot = 25,
	StreakBonus = 20, -- extra por cada baja de racha
	Win = 500,
	Loss = 150,
	Capture = 300, -- capturar la bandera
	FlagReturn = 75, -- devolver tu bandera caída
	CarrierKill = 75, -- eliminar al portador de tu bandera
}
GameConfig.Coins = {
	Kill = 5,
	Win = 50,
	Capture = 20,
	WinStreak = 10, -- extra por cada victoria seguida (2.ª victoria +10, 3.ª +20...)
	WinStreakMax = 5, -- tope de victorias seguidas que suman extra
}

-- ID del GamePass del pase premium. Créalo en el Creator Hub y pon el número aquí.
-- Con 0 el botón de compra queda desactivado.
GameConfig.PremiumPassId = 0

-- Insignias de Roblox (Creator Hub → Insignias). Pega el ID de cada una; con 0 no se da.
GameConfig.Badges = {
	Welcome = 0, -- entrar por primera vez
	FirstKill = 0, -- primera baja
	Kills100 = 0, -- 100 bajas
	FirstWin = 0, -- primera victoria
	Level10 = 0, -- nivel 10
	RankGold = 0, -- llegar a rango Oro
	RankDiamond = 0, -- llegar a rango Diamante
	RankChampion = 0, -- llegar a rango Campeón
}

-- Recompensas por nivel. Free = pase gratis, Premium = pase de pago.
-- Tipos: { Type = "Skin", Id = "<id de Skins>" } o { Type = "Coins", Amount = n }
GameConfig.BattlePass = {
	{ Free = { Type = "Coins", Amount = 50 }, Premium = { Type = "Skin", Id = "Sakura" } },
	{ Free = { Type = "Skin", Id = "Toxico" }, Premium = { Type = "Coins", Amount = 150 } },
	{ Free = { Type = "Coins", Amount = 75 }, Premium = { Type = "Skin", Id = "Hielo" } },
	{ Free = nil, Premium = { Type = "Coins", Amount = 200 } },
	{ Free = { Type = "Skin", Id = "Selva" }, Premium = { Type = "Skin", Id = "Calabaza" } },
	{ Free = { Type = "Coins", Amount = 100 }, Premium = { Type = "Coins", Amount = 250 } },
	{ Free = nil, Premium = { Type = "Skin", Id = "Vacio" } },
	{ Free = { Type = "Coins", Amount = 125 }, Premium = { Type = "Coins", Amount = 300 } },
	{ Free = { Type = "Skin", Id = "Oceano" }, Premium = { Type = "Skin", Id = "Dorado" } },
	{ Free = { Type = "Coins", Amount = 150 }, Premium = { Type = "Coins", Amount = 400 } },
	{ Free = nil, Premium = { Type = "Skin", Id = "Galaxia" } },
	{ Free = { Type = "Coins", Amount = 200 }, Premium = { Type = "Coins", Amount = 500 } },
	{ Free = { Type = "Skin", Id = "Atardecer" }, Premium = { Type = "Skin", Id = "Dragon" } },
	{ Free = { Type = "Coins", Amount = 250 }, Premium = { Type = "Coins", Amount = 750 } },
	{ Free = { Type = "Coins", Amount = 500 }, Premium = { Type = "Skin", Id = "Magma" } },
}

return GameConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">KillEffects</string>
          <string name="Source"><![CDATA[-- Efectos de eliminación: lo que ven todos cuando eliminas a alguien (como en Arsenal).
-- Se compran con monedas en el menú (pestaña Efectos) y se dibujan en Effects.KillEffect (cliente).
local KillEffects = {}

KillEffects.List = {
	Default = { Name = "Estallido", Rarity = "Común", Icon = "💥", Description = "El de siempre, del color de su equipo." },
	Confeti = { Name = "Confeti", Rarity = "Raro", Icon = "🎉", Price = 500, Description = "¡Fiesta! Una lluvia de papelitos de colores." },
	Amor = { Name = "Amor", Rarity = "Raro", Icon = "💖", Price = 600, Description = "Corazones que suben flotando." },
	Fuego = { Name = "Llamarada", Rarity = "Épico", Icon = "🔥", Price = 800, Description = "Una columna de fuego." },
	Hielo = { Name = "Congelado", Rarity = "Épico", Icon = "❄️", Price = 800, Description = "Estalla en cristales de hielo." },
	Fantasma = { Name = "Fantasma", Rarity = "Épico", Icon = "👻", Price = 900, Description = "Su fantasma sale volando." },
	Calavera = { Name = "Calavera", Rarity = "Legendario", Icon = "💀", Price = 1200, Description = "Calavera gigante y humo rojo." },
	Rayo = { Name = "Rayo", Rarity = "Legendario", Icon = "⚡", Price = 1500, Description = "Un rayo cae del cielo." },
	Monedas = { Name = "Lluvia de monedas", Rarity = "Legendario", Icon = "🪙", Price = 1500, Description = "Revienta en monedas de oro." },
	AgujeroNegro = { Name = "Agujero negro", Rarity = "Mítico", Icon = "🌀", Price = 3000, Description = "Se lo traga un agujero negro." },
	Pintura = { Name = "Pintura", Rarity = "Épico", Icon = "🎨", Price = 900, Description = "Revienta en bolas de pintura y lo deja todo manchado." },
	Arcoiris = { Name = "Arcoíris", Rarity = "Legendario", Icon = "🌈", Price = 1800, Description = "Un arcoíris sale disparado de tu rival." },
}

function KillEffects.Get(id)
	return KillEffects.List[id] or KillEffects.List.Default
end

return KillEffects
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Mastery</string>
          <string name="Source"><![CDATA[-- Maestría de armas: las bajas con cada arma desbloquean camuflajes exclusivos para ESA arma
-- (y monedas). Los camuflajes son skins con Mastery = true (ver Skins.luau): no se venden ni salen en cajas.
local Mastery = {}

Mastery.Tiers = {
	{ Kills = 25, Camo = "MaestriaCarbono", Name = "Carbono", Coins = 100 },
	{ Kills = 75, Camo = "MaestriaOro", Name = "Oro", Coins = 250 },
	{ Kills = 150, Camo = "MaestriaDiamante", Name = "Diamante", Coins = 500 },
	{ Kills = 300, Camo = "MaestriaOscura", Name = "Materia oscura", Coins = 1000 },
}

-- Nivel de maestría alcanzado (0 = ninguno)
function Mastery.Level(kills)
	local level = 0
	for i, tier in Mastery.Tiers do
		if (kills or 0) >= tier.Kills then
			level = i
		end
	end
	return level
end

-- Siguiente nivel por conseguir (nil si ya tiene todos)
function Mastery.Next(kills)
	return Mastery.Tiers[Mastery.Level(kills) + 1]
end

-- ¿Tiene desbloqueado este camuflaje con esas bajas?
function Mastery.HasCamo(kills, camoId)
	for i, tier in Mastery.Tiers do
		if tier.Camo == camoId then
			return Mastery.Level(kills) >= i
		end
	end
	return false
end

return Mastery
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Outfits</string>
          <string name="Source"><![CDATA[-- Trajes de operador: armadura hecha con piezas que se sueldan al personaje R15.
-- Las piezas se escalan con el tamaño de cada parte del cuerpo, así funcionan con cualquier avatar.
local Outfits = {}

local RGB = Color3.fromRGB

Outfits.List = {
	Default = {
		Name = "Tu avatar",
		Rarity = "Común",
		Class = "Sin traje",
	},
	BlazeRunner = {
		Name = "Blaze Runner",
		Rarity = "Legendario",
		Class = "Clase asalto",
		Body = RGB(28, 26, 28),
		Cloth = RGB(200, 30, 30),
		Glow = RGB(255, 120, 20),
		Plate = RGB(70, 70, 76),
		Pieces = { Vest = true, Pouches = true, Backpack = true, Shoulders = true, Belt = true, Knees = true, Boots = true, Gloves = true, Headset = true, Mask = true, Scarf = true },
	},
	NeonRecon = {
		Name = "Neon Recon",
		Rarity = "Legendario",
		Class = "Clase francotirador",
		Body = RGB(22, 22, 28),
		Cloth = RGB(20, 20, 26),
		Glow = RGB(0, 200, 255),
		Plate = RGB(235, 238, 245),
		Pieces = { Vest = true, Pouches = true, Backpack = true, Belt = true, Knees = true, Boots = true, Gloves = true, Headset = true, Visor = true, Scarf = true },
	},
	VoltBruiser = {
		Name = "Volt Bruiser",
		Rarity = "Mítico",
		Class = "Clase pesada",
		Body = RGB(30, 30, 32),
		Cloth = RGB(40, 40, 44),
		Glow = RGB(255, 200, 30),
		Plate = RGB(225, 225, 230),
		Heavy = true,
		Pieces = { Vest = true, Pouches = true, Backpack = true, Shoulders = true, Belt = true, Knees = true, Boots = true, Gloves = true, Headset = true, Gauntlets = true },
	},
	FrostByte = {
		Name = "Frost Byte",
		Rarity = "Épico",
		Class = "Clase reconocimiento",
		Body = RGB(220, 235, 250),
		Cloth = RGB(150, 200, 240),
		Glow = RGB(120, 230, 255),
		Plate = RGB(255, 255, 255),
		Pieces = { Vest = true, Belt = true, Knees = true, Boots = true, Gloves = true, Visor = true, Scarf = true },
	},
	ToxicRogue = {
		Name = "Toxic Rogue",
		Rarity = "Épico",
		Class = "Clase infiltración",
		Body = RGB(30, 40, 30),
		Cloth = RGB(60, 90, 40),
		Glow = RGB(130, 255, 60),
		Plate = RGB(50, 60, 50),
		Pieces = { Vest = true, Pouches = true, Belt = true, Boots = true, Gloves = true, Mask = true, Headset = true },
	},
	GoldenAce = {
		Name = "Golden Ace",
		Rarity = "Mítico",
		Class = "Edición de lujo",
		Body = RGB(25, 22, 18),
		Cloth = RGB(30, 26, 22),
		Glow = RGB(255, 220, 120),
		Plate = RGB(240, 180, 50),
		PlateMaterial = Enum.Material.Foil,
		Pieces = { Vest = true, Pouches = true, Backpack = true, Shoulders = true, Belt = true, Knees = true, Boots = true, Gloves = true, Visor = true, Gauntlets = true },
	},
	-- Halloween: cabeza de calabaza con cara iluminada y capa (premio del evento, ver GameConfig.Event)
	Calabaza = {
		Name = "Cabeza de Calabaza",
		Rarity = "Legendario",
		Class = "Evento Halloween",
		Event = "🎃 50 caramelos", -- solo se consigue en el evento (no se vende ni sale en cajas)
		Body = RGB(25, 20, 30),
		Cloth = RGB(60, 30, 80),
		Glow = RGB(255, 170, 40),
		Plate = RGB(255, 130, 20),
		Pieces = { Pumpkin = true, Cape = true, Belt = true, Boots = true, Gloves = true },
	},
}

function Outfits.Get(id)
	return Outfits.List[id] or Outfits.List.Default
end

-- Colores de los brazos en primera persona (manga, guante y puño)
function Outfits.ArmColors(id)
	local o = Outfits.List[id]
	if not o or not o.Body then
		return nil
	end
	return { Sleeve = o.Cloth, Glove = o.Body, Cuff = o.Glow, Plate = o.Plate }
end

---------------------------------------------------------------------------
-- Construcción sobre el personaje
---------------------------------------------------------------------------

local function newPiece(folder, bodyPart, name, offsetScale, offsetAdd, sizeScale, sizeAdd, color, material, rotation)
	local s = bodyPart.Size
	local part = Instance.new("Part")
	part.Name = name
	part.Size = Vector3.new(s.X * sizeScale.X + sizeAdd.X, s.Y * sizeScale.Y + sizeAdd.Y, s.Z * sizeScale.Z + sizeAdd.Z)
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	local offset = Vector3.new(s.X * offsetScale.X + offsetAdd.X, s.Y * offsetScale.Y + offsetAdd.Y, s.Z * offsetScale.Z + offsetAdd.Z)
	part.CFrame = bodyPart.CFrame * CFrame.new(offset) * (rotation or CFrame.new())
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = bodyPart
	weld.Part1 = part
	weld.Parent = part
	part.Parent = folder
	return part
end

local V = Vector3.new
local Z = Vector3.zero

-- Quita el traje actual del personaje
function Outfits.Remove(character)
	local old = character:FindFirstChild("Outfit")
	if old then
		old:Destroy()
	end
end

-- Pone el traje `id` en el personaje (R15). Devuelve true si se aplicó.
function Outfits.Apply(character, id)
	Outfits.Remove(character)
	local o = Outfits.List[id]
	if not o or not o.Pieces then
		return false
	end
	local function get(name)
		return character:FindFirstChild(name)
	end
	local upper, lower, head = get("UpperTorso"), get("LowerTorso"), get("Head")
	if not upper or not lower or not head then
		return false -- solo R15
	end

	-- La ropa clásica taparía los colores del traje
	for _, child in character:GetChildren() do
		if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") then
			child:Destroy()
		end
	end
	local bodyColors = character:FindFirstChildOfClass("BodyColors")
	if bodyColors then
		bodyColors.TorsoColor3 = o.Cloth
		bodyColors.LeftLegColor3 = o.Body
		bodyColors.RightLegColor3 = o.Body
	end
	for _, name in { "UpperTorso", "LowerTorso" } do
		get(name).Color = o.Cloth
	end
	for _, name in { "LeftUpperLeg", "LeftLowerLeg", "RightUpperLeg", "RightLowerLeg" } do
		local p = get(name)
		if p then
			p.Color = o.Body
		end
	end

	local folder = Instance.new("Folder")
	folder.Name = "Outfit"
	folder:SetAttribute("Id", id)
	folder.Parent = character

	local P = o.Pieces
	local plateMat = o.PlateMaterial or Enum.Material.SmoothPlastic
	local glow = Enum.Material.Neon
	local heavy = o.Heavy and 1.15 or 1

	-- Chaleco (cubre el torso) con placa delantera
	if P.Vest then
		newPiece(folder, upper, "Vest", V(0, -0.02, 0), Z, V(1.06 * heavy, 0.86, 1.18 * heavy), Z, o.Body)
		newPiece(folder, upper, "ChestPlate", V(0, 0.12, -0.6 * heavy), Z, V(0.7, 0.4, 0.12), Z, o.Plate, plateMat)
		newPiece(folder, upper, "ChestGlow", V(0, 0.12, -0.67 * heavy), Z, V(0.4, 0.05, 0.05), Z, o.Glow, glow)
	end
	if P.Pouches then
		for i, x in { -0.3, 0, 0.3 } do
			newPiece(folder, upper, "Pouch" .. i, V(x, -0.25, -0.66 * heavy), Z, V(0.24, 0.32, 0.18), Z, o.Body:Lerp(Color3.new(0, 0, 0), 0.25))
			newPiece(folder, upper, "PouchGlow" .. i, V(x, -0.25, -0.76 * heavy), Z, V(0.04, 0.2, 0.02), Z, o.Glow, glow)
		end
	end
	if P.Backpack then
		newPiece(folder, upper, "Backpack", V(0, -0.05, 0.85 * heavy), Z, V(0.72, 0.78, 0.55), Z, o.Body)
		newPiece(folder, upper, "BackpackPlate", V(0, 0.05, 1.13 * heavy), Z, V(0.42, 0.38, 0.05), Z, o.Plate, plateMat)
		newPiece(folder, upper, "BackpackEmblem", V(0, 0.05, 1.17 * heavy), Z, V(0.14, 0.14, 0.03), Z, o.Glow, glow, CFrame.Angles(0, 0, math.rad(45)))
	end
	-- Cinturón
	if P.Belt then
		newPiece(folder, lower, "Belt", V(0, 0.32, 0), Z, V(1.08, 0.3, 1.12), Z, o.Body:Lerp(Color3.new(0, 0, 0), 0.3))
		newPiece(folder, lower, "Buckle", V(0, 0.32, -0.58), Z, V(0.22, 0.22, 0.06), Z, o.Glow, glow)
	end

	-- Brazos y piernas (izquierda y derecha)
	for _, side in { "Left", "Right" } do
		local upperArm, lowerArm, hand = get(side .. "UpperArm"), get(side .. "LowerArm"), get(side .. "Hand")
		local upperLeg, lowerLeg, foot = get(side .. "UpperLeg"), get(side .. "LowerLeg"), get(side .. "Foot")
		local sx = side == "Left" and -1 or 1
		if P.Shoulders and upperArm then
			newPiece(folder, upperArm, "Shoulder", V(0.05 * sx, 0.3, 0), Z, V(1.35 * heavy, 0.42, 1.3 * heavy), Z, o.Plate, plateMat)
			newPiece(folder, upperArm, "ShoulderGlow", V(0.05 * sx, 0.3, -0.66 * heavy), Z, V(0.8, 0.07, 0.03), Z, o.Glow, glow)
		end
		if P.Gauntlets and lowerArm then
			newPiece(folder, lowerArm, "Gauntlet", V(0, -0.05, 0), Z, V(1.3, 0.7, 1.3), Z, o.Plate, plateMat)
			newPiece(folder, lowerArm, "GauntletGlow", V(0, -0.05, -0.66), Z, V(0.5, 0.08, 0.03), Z, o.Glow, glow)
		end
		if P.Gloves and hand then
			newPiece(folder, hand, "Glove", Z, Z, V(1.15, 1.1, 1.15), Z, o.Body)
		end
		if P.Knees and lowerLeg then
			newPiece(folder, lowerLeg, "KneePad", V(0, 0.32, -0.55), Z, V(0.95, 0.32, 0.3), Z, o.Plate, plateMat)
			newPiece(folder, lowerLeg, "KneeGlow", V(0, 0.32, -0.72), Z, V(0.3, 0.1, 0.02), Z, o.Glow, glow)
		end
		if P.Boots and foot then
			newPiece(folder, foot, "Boot", V(0, 0.08, 0), Z, V(1.14, 1.15, 1.12), Z, o.Body)
			newPiece(folder, foot, "Sole", V(0, -0.42, 0), Z, V(1.17, 0.32, 1.15), Z, Color3.fromRGB(245, 245, 248))
			newPiece(folder, foot, "BootGlow", V(0, -0.2, 0), Z, V(1.18, 0.1, 1.16), Z, o.Glow, glow)
		end
		_ = upperLeg
	end

	-- Cabeza
	if P.Headset then
		for _, sx in { -1, 1 } do
			newPiece(folder, head, "EarCup", V(0.55 * sx, 0, 0), Z, V(0.18, 0.45, 0.45), Z, o.Body)
			newPiece(folder, head, "EarGlow", V(0.65 * sx, 0, 0), Z, V(0.03, 0.25, 0.25), Z, o.Glow, glow)
		end
		newPiece(folder, head, "Headband", V(0, 0.55, 0), Z, V(1.15, 0.1, 0.18), Z, o.Body)
		newPiece(folder, head, "Mic", V(-0.42, -0.25, -0.35), Z, V(0.06, 0.06, 0.45), Z, o.Body, nil, CFrame.Angles(0, math.rad(-30), 0))
	end
	if P.Visor then
		local visor = newPiece(folder, head, "Visor", V(0, 0.1, -0.52), Z, V(0.98, 0.24, 0.08), Z, o.Glow, glow)
		visor.Transparency = 0.15
		newPiece(folder, head, "VisorFrame", V(0, 0.1, -0.5), Z, V(1.04, 0.3, 0.06), Z, o.Body)
	end
	if P.Mask then
		newPiece(folder, head, "Mask", V(0, -0.22, -0.5), Z, V(0.92, 0.36, 0.1), Z, o.Body)
		for i, x in { -0.18, 0, 0.18 } do
			newPiece(folder, head, "MaskGlow" .. i, V(x, -0.2, -0.56), Z, V(0.08, 0.05, 0.02), Z, o.Glow, glow)
		end
	end
	if P.Pumpkin then
		-- Calabaza que envuelve la cabeza (malla de esfera: una Ball no se puede achatar)
		local pumpkin = newPiece(folder, head, "PumpkinHead", V(0, 0.05, 0), Z, V(1.55, 1.35, 1.55), Z, o.Plate)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = pumpkin
		newPiece(folder, head, "PumpkinStem", V(0, 0.75, 0), Z, V(0.14, 0.3, 0.14), Z, RGB(80, 120, 40))
		for _, sx in { -1, 1 } do
			newPiece(folder, head, "PumpkinEye", V(0.24 * sx, 0.15, -0.74), Z, V(0.2, 0.18, 0.06), Z, o.Glow, glow, CFrame.Angles(0, 0, math.rad(20 * sx)))
		end
		newPiece(folder, head, "PumpkinMouth", V(0, -0.2, -0.74), Z, V(0.55, 0.12, 0.06), Z, o.Glow, glow)
	end
	if P.Cape then
		newPiece(folder, upper, "Cape", V(0, -0.35, 0.62), Z, V(1.1, 1.7, 0.06), Z, o.Cloth, Enum.Material.Fabric, CFrame.Angles(math.rad(-8), 0, 0))
		newPiece(folder, upper, "CapeCollar", V(0, 0.48, 0.45), Z, V(1.0, 0.18, 0.25), Z, RGB(150, 30, 40), Enum.Material.Fabric)
	end
	if P.Scarf then
		local scarfColor = o.Cloth == o.Body and o.Glow or o.Cloth
		newPiece(folder, upper, "ScarfRing", V(0, 0.46, 0), Z, V(0.78, 0.2, 1.28), Z, scarfColor, Enum.Material.Fabric)
		newPiece(folder, upper, "ScarfTail", V(0.25, 0.25, 0.75), Z, V(0.18, 0.08, 1.1), Z, scarfColor, Enum.Material.Fabric, CFrame.Angles(math.rad(-25), math.rad(20), 0))
	end
	return true
end

return Outfits
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Ranks</string>
          <string name="Source"><![CDATA[-- Rangos competitivos: puntos de rango (RP) que suben al ganar partidas y bajan un poco al perder.
-- Nunca se baja de rango (al perder, como mínimo te quedas en el inicio del tuyo).
-- Se ven en el marcador, en el chat, en el menú y en el resumen de cada partida.
-- Llegar a un rango por primera vez da su premio (Reward: monedas y cajas gratis).
local Ranks = {}

local RGB = Color3.fromRGB

Ranks.Tiers = {
	{ Name = "Bronce", Min = 0, Icon = "🥉", Color = RGB(215, 140, 70) },
	{ Name = "Plata", Min = 100, Icon = "🥈", Color = RGB(205, 210, 225), Reward = { Coins = 200 } },
	{ Name = "Oro", Min = 250, Icon = "🥇", Color = RGB(255, 200, 60), Reward = { Coins = 300, Crates = 1 } },
	{ Name = "Platino", Min = 450, Icon = "💠", Color = RGB(90, 225, 210), Reward = { Coins = 500 } },
	{ Name = "Diamante", Min = 700, Icon = "💎", Color = RGB(110, 170, 255), Reward = { Coins = 750, Crates = 2 } },
	{ Name = "Campeón", Min = 1000, Icon = "👑", Color = RGB(255, 90, 200), Reward = { Coins = 1500, Crates = 3 } },
}

-- Puntos por partida
Ranks.Points = {
	Win = 25,
	Loss = -12, -- por equipos
	FFALoss = -5, -- todos contra todos (solo gana uno)
	MVP = 5, -- extra para el MVP, gane o pierda
	BotWin = 8, -- partida solo contra bots (menos de 2 jugadores de verdad): sube poco y no baja
}

-- Índice del rango (1 = Bronce)
function Ranks.Index(points)
	local index = 1
	for i, tier in Ranks.Tiers do
		if (points or 0) >= tier.Min then
			index = i
		end
	end
	return index
end

function Ranks.Get(points)
	return Ranks.Tiers[Ranks.Index(points)]
end

-- Progreso hacia el siguiente rango: fracción 0..1 y el siguiente rango (nil si ya es el máximo)
function Ranks.Progress(points)
	points = points or 0
	local index = Ranks.Index(points)
	local tier, nextTier = Ranks.Tiers[index], Ranks.Tiers[index + 1]
	if not nextTier then
		return 1, nil
	end
	return math.clamp((points - tier.Min) / (nextTier.Min - tier.Min), 0, 1), nextTier
end

-- Cambio de puntos de una partida. result: "Win", "Loss" o "Draw"
function Ranks.Delta(result, ffa, botsOnly, mvp)
	local points = Ranks.Points
	if botsOnly then
		return result == "Win" and points.BotWin or 0
	end
	local delta = 0
	if result == "Win" then
		delta = points.Win
	elseif result == "Loss" then
		delta = ffa and points.FFALoss or points.Loss
	end
	if mvp then
		delta += points.MVP
	end
	return delta
end

-- Aplica el cambio sin bajar nunca del inicio del rango actual
function Ranks.Apply(points, delta)
	points = points or 0
	local floor = Ranks.Get(points).Min
	return math.max(floor, points + delta)
end

return Ranks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Crea (servidor) o espera (cliente) todos los RemoteEvents/RemoteFunctions del juego.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EVENTS = {
	"Fire", -- cliente -> servidor: disparo
	"Reload", -- cliente -> servidor: recargar
	"Melee", -- cliente -> servidor: cuchillazo
	"EquipSkin", -- cliente -> servidor: equipar skin
	"SetPrimary", -- cliente -> servidor: elegir arma principal
	"LeaveMenu", -- cliente -> servidor: ha salido de la pantalla de inicio
	"EnterMenu", -- cliente -> servidor: vuelve a la pantalla de inicio (escudo y fuera de juego)
	"RespawnNow", -- cliente -> servidor: "Regenerar ahora" tras morir
	"SetSecondary", -- cliente -> servidor: elegir arma secundaria
	"SetMelee", -- cliente -> servidor: elegir arma cuerpo a cuerpo (cuchillo, martillo, katana)
	"TutorialDone", -- cliente -> servidor: ya ha visto la tarjeta de controles
	"EquipOutfit", -- cliente -> servidor: equipar traje de operador
	"VoteMap", -- cliente -> servidor: voto de mapa/modo
	"SetCamo", -- cliente -> servidor: camuflaje de maestría para un arma
	"EquipKillEffect", -- cliente -> servidor: equipar efecto de eliminación
	"SaveSettings", -- cliente -> servidor: ajustes (calidad gráfica, FOV, sensibilidad)
	"KillFX", -- servidor -> clientes: efecto de eliminación (posición, efecto, color)
	"ThrowGrenade", -- cliente -> servidor: lanzar granada (dirección)
	"ExplosionFX", -- servidor -> clientes: explosión de granada (posición, radio)
	"CallAirstrike", -- cliente -> servidor: pedir el ataque aéreo (punto objetivo)
	"AirstrikeMark", -- servidor -> clientes: marcas rojas donde va a caer el ataque aéreo
	"ShotFX", -- servidor -> clientes: efectos de disparo de otros jugadores
	"HitConfirm", -- servidor -> cliente: confirmación de impacto (hitmarker)
	"KillFeed", -- servidor -> clientes: registro de bajas
	"Notify", -- servidor -> cliente(s): mensajes en pantalla
	"DataUpdate", -- servidor -> cliente: datos de progreso
	"Died", -- servidor -> cliente: quién te eliminó
	"RoundEnd", -- servidor -> clientes: resultado de la ronda
	"MatchSummary", -- servidor -> cliente: resumen de tu partida (XP, monedas, bajas, mejor racha)
}
local FUNCTIONS = {
	"GetData",
	"BuyItem", -- comprar arma/skin/traje con monedas
	"ClaimDaily", -- recoger la recompensa diaria
	"OpenCrate", -- abrir una caja
	"RerollChallenge", -- cambiar un reto diario
	"InstantRevive", -- revivir donde moriste (gasta un revivir)
	"UsePotion", -- habilidad Poción: cura con el tiempo (el servidor controla la recarga)
	"ClaimGift", -- recoger el siguiente regalo por tiempo jugado
	"SpinWheel", -- girar la ruleta diaria (gratis o gastando un giro comprado)
}

local Remotes = {}

if RunService:IsServer() then
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in EVENTS do
		local remote = folder:FindFirstChild(name) or Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		Remotes[name] = remote
	end
	for _, name in FUNCTIONS do
		local remote = folder:FindFirstChild(name) or Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
		Remotes[name] = remote
	end
else
	local folder = ReplicatedStorage:WaitForChild("Remotes")
	for _, name in EVENTS do
		Remotes[name] = folder:WaitForChild(name)
	end
	for _, name in FUNCTIONS do
		Remotes[name] = folder:WaitForChild(name)
	end
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Shop</string>
          <string name="Source"><![CDATA[-- Catálogo de la tienda: precios en monedas, packs de Robux, VIP, recompensas diarias y cajas.
--
-- IMPORTANTE (Robux): crea los productos en el Creator Hub (Monetización) y pega sus IDs aquí.
--   Developer Products -> CoinPacks[i].ProductId y RevivePacks[i].ProductId
--   Game Pass VIP      -> VIPPassId
-- Con ID 0 el botón aparece desactivado ("Próximamente").
local Shop = {}

-- Packs de monedas (Developer Products, se pueden comprar varias veces)
Shop.CoinPacks = {
	{ Name = "Puñado", Coins = 500, Robux = 49, ProductId = 0 },
	{ Name = "Bolsa", Coins = 1200, Robux = 99, ProductId = 0, Tag = "+20%" },
	{ Name = "Cofre", Coins = 3000, Robux = 199, ProductId = 0, Tag = "MÁS VENDIDO" },
	{ Name = "Bóveda", Coins = 8000, Robux = 449, ProductId = 0, Tag = "MEJOR VALOR" },
}

-- Packs de "Revivir instantáneo" (Developer Products): vuelves a la acción justo donde caíste
Shop.RevivePacks = {
	{ Name = "5 revivir", Revives = 5, Robux = 25, ProductId = 0 },
	{ Name = "15 revivir", Revives = 15, Robux = 59, ProductId = 0, Tag = "MEJOR VALOR" },
}

-- Pack de inicio (Developer Product de compra única): solo se ofrece a jugadores nuevos.
-- Vale mucho más que su precio en Robux para que sea la primera compra fácil.
Shop.StarterPack = {
	ProductId = 0, -- pega aquí el ID del Developer Product
	Robux = 99,
	MaxLevel = 15, -- se deja de ofrecer a partir de este nivel
	Coins = 1500,
	Outfit = "BlazeRunner",
	Skin = "Sakura",
	KillEffect = "Confeti",
}

-- Ruleta diaria: un giro gratis al día y giros extra con Robux (Developer Product SpinProductId,
-- da SpinsPerPurchase giros). Los premios salen según su peso (Weight); las probabilidades se ven en
-- la propia ruleta. En los países donde los premios al azar de pago no están permitidos solo hay
-- giro gratis.
Shop.Wheel = {
	SpinProductId = 0, -- pega aquí el ID del Developer Product
	SpinRobux = 25,
	SpinsPerPurchase = 3,
	Prizes = {
		{ Kind = "Coins", Amount = 50, Weight = 28, Color = Color3.fromRGB(90, 160, 255) },
		{ Kind = "Coins", Amount = 100, Weight = 24, Color = Color3.fromRGB(255, 200, 60) },
		{ Kind = "Revives", Amount = 1, Weight = 12, Color = Color3.fromRGB(80, 210, 120) },
		{ Kind = "Coins", Amount = 250, Weight = 12, Color = Color3.fromRGB(255, 120, 60) },
		{ Kind = "XP", Amount = 400, Weight = 10, Color = Color3.fromRGB(120, 220, 255) },
		{ Kind = "Crate", Amount = 1, Weight = 8, Color = Color3.fromRGB(180, 100, 255) },
		{ Kind = "Coins", Amount = 600, Weight = 5, Color = Color3.fromRGB(255, 80, 140) },
		{ Kind = "Coins", Amount = 2000, Weight = 1, Color = Color3.fromRGB(255, 230, 90), Jackpot = true },
	},
}

-- Texto corto de un premio de la ruleta
function Shop.WheelPrizeText(prize)
	if prize.Kind == "Coins" then
		return prize.Amount .. " 🪙"
	elseif prize.Kind == "Revives" then
		return prize.Amount .. " ❤️"
	elseif prize.Kind == "XP" then
		return prize.Amount .. " XP"
	elseif prize.Kind == "Crate" then
		return prize.Amount .. " 📦"
	end
	return "?"
end

-- Pase VIP (Game Pass): x2 XP y x2 monedas, nombre dorado y caja diaria extra
Shop.VIPPassId = 0
Shop.VIPRobux = 299
Shop.VIPMultiplier = 2

-- Precio en monedas de cada skin de arma
Shop.SkinPrices = {
	Toxico = 400,
	Selva = 300,
	Oceano = 600,
	Atardecer = 600,
	Sakura = 800,
	Hielo = 800,
	Calabaza = 1200,
	Vacio = 1500,
	Dorado = 2000,
	Galaxia = 2500,
	Dragon = 3000,
	Magma = 3000,
	CamoBosque = 700,
	CamoDesierto = 700,
	CamoDigital = 1200,
	CamoArtico = 1200,
	CamoTigre = 2200,
	CamoNebulosa = 3200,
	Prisma = 2800,
	Caramelo = 450,
	Juguete = 450,
	Tiki = 900,
	Pintura = 2200,
	Arcoiris = 4500,
}

-- Precio en monedas de cada traje de operador (ver Outfits)
Shop.OutfitPrices = {
	BlazeRunner = 1500,
	NeonRecon = 1500,
	VoltBruiser = 2000,
	FrostByte = 1200,
	ToxicRogue = 1200,
	GoldenAce = 4000,
}

-- Recompensa diaria: un día por entrada (al 7.º día se vuelve a empezar)
Shop.DailyRewards = { 100, 150, 200, 250, 300, 400, 800 }
Shop.DailyCrateDay = 7 -- ese día también regala una caja

-- Cajas (solo con monedas). Las probabilidades se muestran en la tienda.
-- Si te toca algo repetido te devolvemos parte de las monedas.
Shop.Crates = {
	Neon = {
		Name = "Caja Neón",
		Price = 600,
		Odds = {
			{ Rarity = "Raro", Weight = 55 },
			{ Rarity = "Épico", Weight = 30 },
			{ Rarity = "Legendario", Weight = 12 },
			{ Rarity = "Mítico", Weight = 3 },
		},
		DuplicateRefund = 0.4,
	},
}

-- Ofertas del día: 3 objetos con descuento, iguales para todos y distintos cada día
Shop.OfferDiscount = 0.3

local function dayNumber(time)
	return math.floor((time or os.time()) / 86400)
end
Shop.DayNumber = dayNumber

local KillEffects = require(script.Parent.KillEffects)

function Shop.GetDailyOffers(day)
	day = day or dayNumber()
	local pool = {}
	for id in Shop.SkinPrices do
		table.insert(pool, { Kind = "Skin", Id = id })
	end
	for id in Shop.OutfitPrices do
		table.insert(pool, { Kind = "Outfit", Id = id })
	end
	for id, effect in KillEffects.List do
		if effect.Price then
			table.insert(pool, { Kind = "KillEffect", Id = id })
		end
	end
	table.sort(pool, function(a, b)
		return a.Kind .. a.Id < b.Kind .. b.Id
	end)
	local rng = Random.new(day * 7919)
	local offers = {}
	for _ = 1, math.min(3, #pool) do
		local item = table.remove(pool, rng:NextInteger(1, #pool))
		table.insert(offers, item)
	end
	return offers
end

-- Precio actual (con descuento si está en oferta hoy)
function Shop.GetPrice(kind, id, day)
	local base
	if kind == "Skin" then
		base = Shop.SkinPrices[id]
	elseif kind == "Outfit" then
		base = Shop.OutfitPrices[id]
	elseif kind == "KillEffect" then
		local effect = KillEffects.List[id]
		base = effect and effect.Price
	end
	if not base then
		return nil, false
	end
	for _, offer in Shop.GetDailyOffers(day) do
		if offer.Kind == kind and offer.Id == id then
			return math.floor(base * (1 - Shop.OfferDiscount) / 10 + 0.5) * 10, true
		end
	end
	return base, false
end

return Shop
]]></string>
        </Properties>
      </Item>
