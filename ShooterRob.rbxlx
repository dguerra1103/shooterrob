  <Item class="ReplicatedFirst" referent="3">
    <Properties>
      <string name="Name">ReplicatedFirst</string>
    </Properties>
    <Item class="LocalScript" referent="4">
      <Properties>
        <string name="Name">Loading</string>
        <string name="Source"><![CDATA[-- Pantalla de carga propia (sustituye a la de Roblox): título, consejos y un indicador que gira hasta
-- que el juego está listo. Vive en ReplicatedFirst para salir lo antes posible, así que no puede usar
-- los módulos del juego (aún no han llegado): el título se escribe aquí también.
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local TITLE = "SHOOTER NEW" -- (el mismo que GameConfig.GameTitle)
local TIPS = {
	"🎯 Los disparos a la cabeza hacen mucho más daño",
	"🧟 En Infección, si te atrapan, te conviertes en zombi",
	"🎡 Tienes un giro gratis de la ruleta cada día",
	"🏆 Gana partidas para subir de rango: de Bronce a Campeón",
	"⚡ E impulso · Z supersalto · X poción",
	"🍬 Recoge caramelos durante las partidas de Halloween",
	"🎁 Cada pocos minutos jugando hay un regalo (tecla H)",
	"💰 Con 5 bajas seguidas te buscan: quien te elimine cobra la recompensa",
	"🎨 Pulsa J para pintar tu grafiti en la pared",
	"📅 Los retos semanales dan hasta 1000 monedas cada uno",
}

local player = Players.LocalPlayer
pcall(function()
	ReplicatedFirst:RemoveDefaultLoadingScreen()
end)

local gui = Instance.new("ScreenGui")
gui.Name = "Loading"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 100

local background = Instance.new("Frame")
background.Size = UDim2.fromScale(1, 1)
background.BackgroundColor3 = Color3.fromRGB(24, 16, 40)
background.BorderSizePixel = 0
background.Parent = gui
local backGradient = Instance.new("UIGradient")
backGradient.Color = ColorSequence.new(Color3.fromRGB(60, 25, 90), Color3.fromRGB(15, 12, 30))
backGradient.Rotation = 90
backGradient.Parent = background

local title = Instance.new("TextLabel")
title.AnchorPoint = Vector2.new(0.5, 0.5)
title.Position = UDim2.fromScale(0.5, 0.4)
title.Size = UDim2.fromScale(0.8, 0.18)
title.BackgroundTransparency = 1
title.Font = Enum.Font.FredokaOne
title.Text = TITLE
title.TextScaled = true
title.TextColor3 = Color3.new(1, 1, 1)
title.Parent = background
local titleGradient = Instance.new("UIGradient")
titleGradient.Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 230, 60)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 140, 30)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 70, 170)),
})
titleGradient.Rotation = 90
titleGradient.Parent = title
local stroke = Instance.new("UIStroke")
stroke.Thickness = 6
stroke.Color = Color3.fromRGB(30, 10, 40)
stroke.Parent = title

local spinner = Instance.new("TextLabel")
spinner.AnchorPoint = Vector2.new(0.5, 0.5)
spinner.Position = UDim2.fromScale(0.5, 0.62)
spinner.Size = UDim2.fromOffset(60, 60)
spinner.BackgroundTransparency = 1
spinner.Font = Enum.Font.FredokaOne
spinner.Text = "🎃"
spinner.TextScaled = true
spinner.Parent = background

local status = Instance.new("TextLabel")
status.AnchorPoint = Vector2.new(0.5, 0)
status.Position = UDim2.fromScale(0.5, 0.68)
status.Size = UDim2.new(0.8, 0, 0, 30)
status.BackgroundTransparency = 1
status.Font = Enum.Font.FredokaOne
status.Text = "Cargando..."
status.TextSize = 24
status.TextColor3 = Color3.fromRGB(255, 220, 120)
status.Parent = background

local tip = Instance.new("TextLabel")
tip.AnchorPoint = Vector2.new(0.5, 1)
tip.Position = UDim2.new(0.5, 0, 1, -40)
tip.Size = UDim2.new(0.9, 0, 0, 30)
tip.BackgroundTransparency = 1
tip.Font = Enum.Font.FredokaOne
tip.Text = TIPS[math.random(1, #TIPS)]
tip.TextSize = 22
tip.TextColor3 = Color3.fromRGB(210, 210, 235)
tip.Parent = background

gui.Parent = player:WaitForChild("PlayerGui")

-- La calabaza gira y bota
local spin = RunService.RenderStepped:Connect(function()
	local t = os.clock()
	spinner.Rotation = math.sin(t * 3) * 20
	spinner.Position = UDim2.new(0.5, 0, 0.62, -math.abs(math.sin(t * 4)) * 14)
end)
task.spawn(function()
	while gui.Parent do
		task.wait(3.5)
		tip.Text = TIPS[math.random(1, #TIPS)]
	end
end)

-- Listo cuando el juego ha cargado y el servidor ya ha preparado la partida (como mucho 25 s)
local started = os.clock()
if not game:IsLoaded() then
	game.Loaded:Wait()
end
status.Text = "Preparando la partida..."
while os.clock() - started < 25 do
	local ready = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage:GetAttribute("State") ~= nil
	if ready and os.clock() - started > 1.5 then
		break
	end
	task.wait(0.2)
end
status.Text = "¡Listo!"
local fade = TweenInfo.new(0.6)
TweenService:Create(background, fade, { BackgroundTransparency = 1 }):Play()
for _, label in { title, spinner, status, tip } do
	TweenService:Create(label, fade, { TextTransparency = 1 }):Play()
end
TweenService:Create(stroke, fade, { Transparency = 1 }):Play()
task.wait(0.7)
spin:Disconnect()
gui:Destroy()
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ReplicatedStorage" referent="5">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="6">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Challenges</string>
          <string name="Source"><![CDATA[-- Retos diarios: cada jugador recibe 3 al día (distintos para cada uno). Se completan solos al jugar
-- y dan monedas + XP al momento. Completar los 3 regala una caja. Se puede cambiar 1 reto al día.
-- Retos semanales (WeeklyPool): 3 más largos por semana (de lunes a domingo, hora UTC) con premios
-- grandes; completar los 3 regala WeeklyBonusCrates cajas.
--
-- Stat: "Kill" (con Weapons opcional para limitar a ciertas armas), "Headshot", "Win", "Match",
-- "Capture", "ZoneTime" (segundos en la zona), "Streak" (mejor racha, no se suma), "Survive" (ganar una
-- Infección como superviviente), "Pumpkin" (recoger una calabaza enemiga en el modo Calabazas).
local Challenges = {}

Challenges.PerDay = 3
Challenges.RerollsPerDay = 1
Challenges.BonusCrates = 1 -- por completar todos los del día

Challenges.Pool = {
	{ Id = "Kills", Stat = "Kill", Goal = 15, Text = "Consigue 15 bajas", Coins = 150, XP = 300 },
	{ Id = "Headshots", Stat = "Headshot", Goal = 5, Text = "Haz 5 bajas a la cabeza", Coins = 200, XP = 300 },
	{ Id = "Wins", Stat = "Win", Goal = 2, Text = "Gana 2 partidas", Coins = 250, XP = 400 },
	{ Id = "Matches", Stat = "Match", Goal = 3, Text = "Termina 3 partidas", Coins = 150, XP = 300 },
	{ Id = "Captures", Stat = "Capture", Goal = 2, Text = "Captura 2 banderas", Coins = 250, XP = 400 },
	{ Id = "Zone", Stat = "ZoneTime", Goal = 60, Text = "Controla la zona 60 segundos", Coins = 200, XP = 300 },
	{ Id = "Streak", Stat = "Streak", Goal = 5, Text = "Consigue una racha de 5 bajas", Coins = 300, XP = 400 },
	{ Id = "Rifles", Stat = "Kill", Weapons = { "ARX27", "VortexBR", "TitanLMG", "SplatX" }, Goal = 12, Text = "12 bajas con fusil, ametralladora o paintball", Coins = 200, XP = 300 },
	{ Id = "SMGs", Stat = "Kill", Weapons = { "Specter9", "NovaDrift" }, Goal = 10, Text = "10 bajas con subfusil", Coins = 200, XP = 300 },
	{ Id = "Shotguns", Stat = "Kill", Weapons = { "HavocPump", "BreachHammer" }, Goal = 6, Text = "6 bajas con escopeta", Coins = 200, XP = 300 },
	{ Id = "Snipers", Stat = "Kill", Weapons = { "Signal7", "GhostlineXR", "RaptorDMR" }, Goal = 4, Text = "4 bajas con francotirador o DMR", Coins = 250, XP = 350, MinLevel = 3 },
	{ Id = "Pistols", Stat = "Kill", Weapons = { "Viper", "HandCannon", "PhantomSidewind" }, Goal = 4, Text = "4 bajas con pistola", Coins = 200, XP = 300 },
	{ Id = "Knife", Stat = "Kill", Weapons = { "Knife", "ToyHammer", "Katana", "Scythe" }, Goal = 2, Text = "2 bajas cuerpo a cuerpo", Coins = 300, XP = 400 },
	{ Id = "Grenades", Stat = "Kill", Weapons = { "Grenade" }, Goal = 3, Text = "3 bajas con granada", Coins = 250, XP = 350 },
	{ Id = "Rockets", Stat = "Kill", Weapons = { "NovaLauncher", "Calabazooka" }, Goal = 3, Text = "3 bajas con lanzacohetes", Coins = 250, XP = 350, MinLevel = 14 },
	-- Modo Infección (Halloween)
	{ Id = "Infect", Stat = "Kill", Weapons = { "Claws" }, Goal = 3, Text = "Infecta a 3 supervivientes (Infección)", Coins = 250, XP = 350 },
	{ Id = "Survive", Stat = "Survive", Goal = 1, Text = "Sobrevive hasta el final de una Infección", Coins = 300, XP = 400 },
	{ Id = "Pumpkins", Stat = "Pumpkin", Goal = 8, Text = "Recoge 8 calabazas enemigas (modo Calabazas)", Coins = 250, XP = 350 },
}

Challenges.WeeklyCount = 3
Challenges.WeeklyBonusCrates = 2
Challenges.WeeklyPool = {
	{ Id = "W_Kills", Stat = "Kill", Goal = 100, Text = "Consigue 100 bajas", Coins = 800, XP = 1500 },
	{ Id = "W_Wins", Stat = "Win", Goal = 10, Text = "Gana 10 partidas", Coins = 1000, XP = 2000 },
	{ Id = "W_Headshots", Stat = "Headshot", Goal = 30, Text = "Haz 30 bajas a la cabeza", Coins = 900, XP = 1500 },
	{ Id = "W_Matches", Stat = "Match", Goal = 15, Text = "Termina 15 partidas", Coins = 700, XP = 1500 },
	{ Id = "W_Captures", Stat = "Capture", Goal = 8, Text = "Captura 8 banderas", Coins = 900, XP = 1500 },
	{ Id = "W_Zone", Stat = "ZoneTime", Goal = 400, Text = "Controla la zona 400 segundos", Coins = 800, XP = 1500 },
	{ Id = "W_Streak", Stat = "Streak", Goal = 10, Text = "Consigue una racha de 10 bajas", Coins = 1000, XP = 2000 },
	{ Id = "W_Melee", Stat = "Kill", Weapons = { "Knife", "ToyHammer", "Katana", "Scythe" }, Goal = 10, Text = "10 bajas cuerpo a cuerpo", Coins = 900, XP = 1500 },
	{ Id = "W_Snipers", Stat = "Kill", Weapons = { "Signal7", "GhostlineXR", "RaptorDMR" }, Goal = 25, Text = "25 bajas con francotirador o DMR", Coins = 900, XP = 1500, MinLevel = 3 },
	{ Id = "W_Grenades", Stat = "Kill", Weapons = { "Grenade" }, Goal = 12, Text = "12 bajas con granada", Coins = 900, XP = 1500 },
	{ Id = "W_Featured", Stat = "FeaturedWin", Goal = 3, Text = "Gana 3 partidas en el mapa del día ⭐", Coins = 900, XP = 1800 },
}

local byId = {}
for _, c in Challenges.Pool do
	byId[c.Id] = c
end
for _, c in Challenges.WeeklyPool do
	byId[c.Id] = c
end

-- Semana (empieza el lunes a las 00:00 UTC) de un número de día (Shop.DayNumber) y cuándo acaba
function Challenges.WeekNumber(day)
	return (day + 3) // 7
end
function Challenges.WeekEndsAt(week)
	return ((week + 1) * 7 - 3) * 86400
end

function Challenges.Get(id)
	return byId[id]
end

-- ¿Cuenta este evento para el reto?
function Challenges.Matches(challenge, stat, weaponName)
	if challenge.Stat ~= stat then
		return false
	end
	if challenge.Weapons then
		return weaponName ~= nil and table.find(challenge.Weapons, weaponName) ~= nil
	end
	return true
end

-- Elige `count` retos distintos (sin repetir los de `exclude`). Determinista por día y jugador.
-- `source` es la lista de la que se eligen (por defecto los diarios).
function Challenges.Pick(day, userId, level, count, exclude, salt, source)
	local rng = Random.new(day * 7919 + userId * 31 + (salt or 0))
	local pool = {}
	for _, c in source or Challenges.Pool do
		if (c.MinLevel or 1) <= (level or 1) and not (exclude and exclude[c.Id]) then
			table.insert(pool, c.Id)
		end
	end
	local picked = {}
	for _ = 1, math.min(count, #pool) do
		local i = rng:NextInteger(1, #pool)
		table.insert(picked, table.remove(pool, i))
	end
	return picked
end

return Challenges
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Charms</string>
          <string name="Source"><![CDATA[-- Colgantes para el arma: un adorno pequeño que cuelga del lateral del arma y se balancea al
-- moverte (se ve en primera persona y en las armas de los demás). Se compran con monedas en la
-- pestaña Skins y valen para todas las armas de fuego (no para las de cuerpo a cuerpo).
local Charms = {}

local V = Vector3.new
local RGB = Color3.fromRGB

-- Piezas: { Name, Size, Offset (desde el punto del que cuelga), Color, Material, Shape }
local function part(name, size, offset, color, material, shape)
	return { Name = name, Size = size, Offset = offset, Color = color, Material = material or Enum.Material.SmoothPlastic, Shape = shape }
end

Charms.List = {
	Default = { Name = "Sin colgante", Rarity = "Común", Icon = "➖" },
	Dado = {
		Name = "Dado",
		Rarity = "Raro",
		Icon = "🎲",
		Price = 300,
		Parts = {
			part("Body", V(0.16, 0.16, 0.16), V(0, -0.2, 0), RGB(245, 245, 250)),
			part("Dot", V(0.04, 0.04, 0.17), V(0, -0.2, 0), RGB(220, 40, 50), nil, "Ball"),
		},
	},
	Corazon = {
		Name = "Corazón",
		Rarity = "Raro",
		Icon = "💖",
		Price = 300,
		Parts = {
			part("LobeL", V(0.11, 0.11, 0.08), V(-0.045, -0.17, 0), RGB(255, 70, 130), nil, "Ball"),
			part("LobeR", V(0.11, 0.11, 0.08), V(0.045, -0.17, 0), RGB(255, 70, 130), nil, "Ball"),
			part("Tip", V(0.1, 0.1, 0.07), V(0, -0.225, 0), RGB(255, 70, 130)),
		},
	},
	Calabaza = {
		Name = "Calabacita",
		Rarity = "Épico",
		Icon = "🎃",
		Price = 500,
		Parts = {
			part("Body", V(0.2, 0.17, 0.2), V(0, -0.21, 0), RGB(255, 130, 20), nil, "Ball"),
			part("Stem", V(0.03, 0.06, 0.03), V(0, -0.11, 0), RGB(80, 140, 50)),
			part("Face", V(0.1, 0.03, 0.01), V(0, -0.22, -0.1), RGB(255, 220, 60), Enum.Material.Neon),
		},
	},
	Estrella = {
		Name = "Estrella",
		Rarity = "Épico",
		Icon = "⭐",
		Price = 500,
		Parts = {
			part("Core", V(0.12, 0.12, 0.05), V(0, -0.2, 0), RGB(255, 210, 50), Enum.Material.Neon),
			part("ArmA", V(0.22, 0.05, 0.04), V(0, -0.2, 0), RGB(255, 210, 50), Enum.Material.Neon),
			part("ArmB", V(0.05, 0.22, 0.04), V(0, -0.2, 0), RGB(255, 210, 50), Enum.Material.Neon),
		},
	},
	Calavera = {
		Name = "Calavera",
		Rarity = "Épico",
		Icon = "💀",
		Price = 700,
		Parts = {
			part("Skull", V(0.17, 0.15, 0.15), V(0, -0.2, 0), RGB(235, 230, 215), nil, "Ball"),
			part("Jaw", V(0.1, 0.05, 0.1), V(0, -0.28, -0.01), RGB(235, 230, 215)),
			part("EyeL", V(0.04, 0.04, 0.02), V(-0.035, -0.19, -0.075), RGB(20, 20, 25)),
			part("EyeR", V(0.04, 0.04, 0.02), V(0.035, -0.19, -0.075), RGB(20, 20, 25)),
		},
	},
	Patito = {
		Name = "Patito de goma",
		Rarity = "Legendario",
		Icon = "🦆",
		Price = 900,
		Parts = {
			part("Body", V(0.18, 0.13, 0.2), V(0, -0.24, 0), RGB(255, 220, 40), nil, "Ball"),
			part("Head", V(0.11, 0.11, 0.11), V(0, -0.15, -0.06), RGB(255, 220, 40), nil, "Ball"),
			part("Beak", V(0.06, 0.03, 0.06), V(0, -0.16, -0.12), RGB(255, 130, 30)),
		},
	},
	Baston = {
		Name = "Bastón de caramelo",
		Rarity = "Épico",
		Icon = "🍭",
		Price = 500,
		Parts = {
			part("Stick1", V(0.05, 0.07, 0.05), V(0, -0.12, 0), RGB(230, 40, 50)),
			part("Stick2", V(0.05, 0.07, 0.05), V(0, -0.19, 0), RGB(250, 250, 250)),
			part("Stick3", V(0.05, 0.07, 0.05), V(0, -0.26, 0), RGB(230, 40, 50)),
			part("Stick4", V(0.05, 0.07, 0.05), V(0, -0.33, 0), RGB(250, 250, 250)),
			part("Hook", V(0.1, 0.05, 0.05), V(0.03, -0.09, 0), RGB(250, 250, 250)),
			part("HookEnd", V(0.05, 0.06, 0.05), V(0.07, -0.13, 0), RGB(230, 40, 50)),
		},
	},
	Diamante = {
		Name = "Diamante",
		Rarity = "Legendario",
		Icon = "💎",
		Price = 1200,
		Parts = {
			part("Gem", V(0.15, 0.15, 0.15), V(0, -0.21, 0), RGB(110, 220, 255), Enum.Material.Neon),
			part("Facet", V(0.12, 0.12, 0.12), V(0, -0.21, 0), RGB(200, 245, 255), Enum.Material.Glass),
		},
		Spin = true, -- (las piezas van giradas 45° para parecer un rombo)
	},
}

function Charms.Get(id)
	return Charms.List[id] or Charms.List.Default
end

-- Construye el colgante: cadenita + adorno. Devuelve una tabla de piezas sin anclar ni soldar,
-- colocadas respecto a `hang` (CFrame del punto del que cuelga).
function Charms.Build(id, hang)
	local charm = Charms.List[id]
	if not charm or not charm.Parts then
		return {}
	end
	local parts = {}
	local function make(name, size, cf, color, material, shape)
		local p = Instance.new("Part")
		p.Name = "Charm" .. name
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = material
		if shape == "Ball" then
			p.Shape = Enum.PartType.Ball
		end
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		table.insert(parts, p)
		return p
	end
	-- Anilla y cadena
	make("Ring", V(0.05, 0.05, 0.05), hang, RGB(200, 200, 210), Enum.Material.Metal, "Ball")
	make("Chain", V(0.02, 0.1, 0.02), hang * CFrame.new(0, -0.06, 0), RGB(190, 190, 200), Enum.Material.Metal)
	local spin = charm.Spin and CFrame.Angles(0, math.rad(45), math.rad(45)) or CFrame.identity
	for _, spec in charm.Parts do
		make(spec.Name, spec.Size, hang * CFrame.new(spec.Offset) * spin, spec.Color, spec.Material, spec.Shape)
	end
	return parts
end

return Charms
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">GameConfig</string>
          <string name="Source"><![CDATA[-- Configuración general del juego. Cambia aquí los valores para ajustar el balance.
local GameConfig = {}

-- Nombre que aparece en la pantalla de inicio y en los carteles del mapa
GameConfig.GameTitle = "SHOOTER NEW"
-- Estilo de los mapas: "Realista" (piedra, yeso, ladrillo, metal y madera de verdad, colores naturales y
-- luz con sombras marcadas, como los shooters militares) o "Cartoon" (colores vivos, plástico liso y
-- sombras suaves). En Realista, los mapas pensados para Cartoon se "realizan" solos (MapKit.realize).
GameConfig.VisualStyle = "Realista"

-- Equipos
GameConfig.Teams = {
	{ Name = "Rojo", Color = BrickColor.new("Really red") },
	{ Name = "Azul", Color = BrickColor.new("Really blue") },
}

-- Rondas
GameConfig.MinPlayers = 1 -- súbelo a 2+ cuando publiques el juego
GameConfig.IntermissionTime = 20

-- Modos de juego. En cada descanso se votan 3 combinaciones de mapa + modo entre estos.
-- Quita alguno de la lista si no lo quieres.
GameConfig.Modes = { "TDM", "DOM", "SND", "CTF", "KOTH", "FFA", "GUN", "ELIM", "INF", "CAL" }
GameConfig.ModeSettings = {
	TDM = { Name = "Duelo por equipos", ScoreToWin = 50, RoundTime = 10 * 60, Teams = true }, -- puntos = bajas (50 en 10 min, como en los shooters de móvil)
	CTF = { Name = "Captura la bandera", ScoreToWin = 3, RoundTime = 10 * 60, Teams = true }, -- puntos = capturas
	-- Dominio: tres banderas (A, B, C); cada una tuya suma 1 punto cada 3 s
	DOM = { Name = "Dominio", ScoreToWin = 150, RoundTime = 10 * 60, Teams = true },
	KOTH = { Name = "Zona de control", ScoreToWin = 150, RoundTime = 10 * 60, Teams = true }, -- 1 punto/seg en la zona
	FFA = { Name = "Todos contra todos", ScoreToWin = 25, RoundTime = 8 * 60, Teams = false }, -- bajas individuales
	GUN = { Name = "Escalada de armas", ScoreToWin = 0, RoundTime = 10 * 60, Teams = false }, -- 0 = una baja por arma
	-- Eliminación: rondas cortas de UNA vida; gana la ronda el equipo que deje al otro sin nadie en pie
	-- Buscar y destruir: rondas de una vida; atacan y defienden por turnos. Los atacantes plantan la
	-- bomba en A o B (PlantTime s dentro del sitio) y explota a los BombTime s; los defensores la
	-- desactivan (DefuseTime s junto a ella). Solo en mapas con sitios (si no, es Eliminación).
	SND = { Name = "Buscar y destruir", ScoreToWin = 4, RoundTime = 12 * 60, Teams = true, SubRoundTime = 100, PrepTime = 5, PlantTime = 4, DefuseTime = 6, BombTime = 35 },
	ELIM = { Name = "Eliminación", ScoreToWin = 5, RoundTime = 10 * 60, Teams = true, SubRoundTime = 75, PrepTime = 4 },
	-- Infección (Halloween): todos empiezan como supervivientes (equipo A) y tras PrepTime uno de cada
	-- ZombieRatio se convierte en zombi (equipo B: garras, más vida y algo más rápidos). Quien cae ante
	-- los zombis se convierte en zombi. Ganan los supervivientes si queda alguno al acabar el tiempo.
	INF = { Name = "Infección", ScoreToWin = 1, RoundTime = 150, Teams = true, PrepTime = 12, ZombieHealth = 200, ZombieRatio = 5 },
	-- Calabazas (como "Kill Confirmed"): quien cae suelta una calabaza; un punto si la recoge el equipo
	-- contrario, y si la recoge un compañero del caído la baja no cuenta
	CAL = { Name = "Calabazas", ScoreToWin = 30, RoundTime = 8 * 60, Teams = true },
}
