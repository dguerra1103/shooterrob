		Text = "",
		TextSize = 46,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = panel,
	})
	-- Barra del cargador
	local ammoBar = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 76),
		Size = UDim2.fromOffset(170, 6),
		BackgroundColor3 = Color3.fromRGB(20, 20, 25),
