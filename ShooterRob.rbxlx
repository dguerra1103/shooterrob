      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">WeaponModels</string>
          <string name="Source"><![CDATA[-- Construye los modelos de las armas a partir de las piezas de WeaponDesigns.
-- Lo usan el servidor (Tool que ven los demás) y el cliente (viewmodel e iconos 3D).
--
-- Colores: con la skin "Default" cada arma usa su propia paleta de fábrica (def.Palette);
-- con cualquier otra skin, todas las armas usan los colores de esa skin.
local Weapons = require(script.Parent.Weapons)
local Skins = require(script.Parent.Skins)

local WeaponModels = {}

-- Texturas de partículas que vienen incluidas con Roblox
local SPARKLE_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE_TEXTURE = "rbxasset://textures/particles/fire_main.dds"

local WHITE = Color3.new(1, 1, 1)

-- Paleta efectiva para un arma y una skin
function WeaponModels.GetPalette(weaponName, skinId)
	local def = Weapons.Get(weaponName)
	if (skinId == nil or skinId == "Default") and def and def.Palette then
		return def.Palette
	end
	return Skins.Get(skinId)
end

local function paint(part, role, pal)
	part.Transparency = 0
	part.Reflectance = 0
	if role == "Accent" then
		part.Color = pal.Accent
		part.Material = pal.AccentMaterial or Enum.Material.Neon
	elseif role == "Accent2" then
		part.Color = pal.Accent2 or pal.Accent
		part.Material = pal.Accent2Material or Enum.Material.Neon
	elseif role == "Panel" then
		part.Color = pal.Panel or (pal.Accent2 or pal.Body:Lerp(WHITE, 0.6))
		part.Material = pal.PanelMaterial or Enum.Material.SmoothPlastic
	elseif role == "Dark" then
		part.Color = pal.Dark
		part.Material = Enum.Material.Metal
	elseif role == "Metal" then
		part.Color = Color3.fromRGB(200, 202, 210)
		part.Material = Enum.Material.Metal
		part.Reflectance = 0.15
	elseif role == "Rubber" then
		part.Color = pal.Rubber or Color3.fromRGB(28, 28, 32)
		part.Material = Enum.Material.Fabric
	elseif role == "Gold" then
		part.Color = Color3.fromRGB(240, 180, 60)
		part.Material = Enum.Material.Foil
	elseif role == "Shell" then
		part.Color = Color3.fromRGB(200, 30, 35)
		part.Material = Enum.Material.SmoothPlastic
	elseif role == "Lens" then
		part.Color = pal.Accent:Lerp(WHITE, 0.35)
		part.Material = Enum.Material.Glass
		part.Transparency = 0.45
		part.Reflectance = 0.3
	else
		part.Color = pal.Body
		part.Material = pal.BodyMaterial or Enum.Material.SmoothPlastic
	end
end

-- Partículas de la skin (destellos o llamas) alrededor del arma
local function applyEffects(container, pal)
	for _, inst in container:GetDescendants() do
		if inst:IsA("ParticleEmitter") and inst.Name == "SkinFX" then
			inst:Destroy()
		end
	end
	local handle = container:FindFirstChild("Handle")
	if not handle or not pal.Effect then
		return
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "SkinFX"
	emitter.LockedToPart = true
	emitter.LightEmission = 1
	emitter.SpreadAngle = Vector2.new(180, 180)
	if pal.Effect == "Flame" then
		emitter.Texture = FIRE_TEXTURE
		emitter.Color = ColorSequence.new(pal.Accent, pal.Accent2 or pal.Accent)
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0) })
		emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
		emitter.Lifetime = NumberRange.new(0.25, 0.45)
		emitter.Speed = NumberRange.new(0.3, 0.8)
		emitter.Acceleration = Vector3.new(0, 2.5, 0)
		emitter.Rate = 14
	else
		emitter.Texture = SPARKLE_TEXTURE
		emitter.Color = ColorSequence.new(pal.Accent, pal.Accent2 or WHITE)
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.3, 0.16),
			NumberSequenceKeypoint.new(1, 0),
		})
		emitter.Lifetime = NumberRange.new(0.4, 0.8)
		emitter.Speed = NumberRange.new(0.1, 0.4)
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.RotSpeed = NumberRange.new(-90, 90)
		emitter.Rate = 7
	end
	emitter.Parent = handle
end

-- Texto (nombre del arma) en los dos costados de una pieza
local function addLabel(part, text, pal)
	for _, face in { Enum.NormalId.Right, Enum.NormalId.Left } do
		local gui = Instance.new("SurfaceGui")
		gui.Name = "Label"
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 300
		gui.LightInfluence = 0.3
		gui.Parent = part
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.Text = text
		label.TextColor3 = Color3.fromRGB(240, 240, 245)
		label.TextStrokeTransparency = 0.6
		label.Parent = gui
	end
end

-- Pinta todas las piezas de un arma (Model o Tool) con la skin indicada.
function WeaponModels.ApplySkin(container, skinId, weaponName)
	weaponName = weaponName or container:GetAttribute("Weapon") or container.Name
	local pal = WeaponModels.GetPalette(weaponName, skinId)
	for _, part in container:GetDescendants() do
		if part:IsA("BasePart") then
			local role = part:GetAttribute("Role")
			if role then
				paint(part, role, pal)
			end
		end
	end
	applyEffects(container, pal)
end

-- Devuelve un Model con PrimaryPart = Handle. Las piezas van soldadas al Handle.
-- withEffects = false para no añadir partículas (por ejemplo en iconos).
function WeaponModels.Build(weaponName, skinId, withEffects)
	local def = Weapons.Get(weaponName)
	assert(def, "Arma desconocida: " .. tostring(weaponName))
	local pal = WeaponModels.GetPalette(weaponName, skinId)

	local model = Instance.new("Model")
	model.Name = weaponName

	local handle
	local created = {}
	for _, spec in def.Parts do
		local part = Instance.new("Part")
		part.Name = spec.Name
		part.Size = spec.Size
		if spec.Shape == "Cylinder" then
			part.Shape = Enum.PartType.Cylinder
		elseif spec.Shape == "Ball" then
			part.Shape = Enum.PartType.Ball
		end
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.Massless = true
		part.CastShadow = false
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part:SetAttribute("Role", spec.Role)
		paint(part, spec.Role, pal)
		if spec.Text then
			addLabel(part, spec.Text, pal)
		end
		if spec.Name == "Handle" then
			handle = part
		end
		part.Parent = model
		table.insert(created, { Part = part, Spec = spec })
	end

	-- Coloca y suelda cada pieza al Handle (que está en el origen del diseño)
	for _, entry in created do
		entry.Part.CFrame = entry.Spec.CFrame
		if entry.Part ~= handle then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = entry.Part
			weld.Parent = entry.Part
		end
	end
	local function attach(name, position)
		local a = Instance.new("Attachment")
		a.Name = name
		a.Position = position
		a.Parent = handle
		return a
	end
	if def.Muzzle then
		attach("Muzzle", def.Muzzle)
	end
	if def.AimPoint then
		attach("AimPoint", def.AimPoint)
	end
	attach("Eject", def.Eject or Vector3.new(0.22, 0.08, 0))

	model:SetAttribute("Weapon", weaponName)
	model.PrimaryPart = handle
	if withEffects ~= false then
		applyEffects(model, pal)
	end
	return model
end

return WeaponModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Weapons</string>
          <string name="Source"><![CDATA[-- Arsenal: estadísticas, paleta de fábrica, desbloqueo y posiciones (manos, mira, cañón) de cada arma.
-- El modelo 3D de cada arma está en WeaponDesigns.
local Designs = require(script.Parent.WeaponDesigns)

local Weapons = {}

local rad = math.rad
local V = Vector3.new
local RGB = Color3.fromRGB

-- Paletas de fábrica (el aspecto "Default" de cada arma, como en el arte conceptual)
local Palettes = {
	Pulse = { Body = RGB(34, 36, 42), Panel = RGB(226, 229, 236), Accent = RGB(0, 140, 255), Accent2 = RGB(90, 210, 255), Dark = RGB(18, 18, 22) },
	Havoc = { Body = RGB(36, 32, 32), Panel = RGB(235, 50, 25), Accent = RGB(255, 85, 0), Accent2 = RGB(255, 150, 20), Dark = RGB(20, 18, 18) },
	Specter = { Body = RGB(28, 28, 34), Panel = RGB(236, 236, 242), Accent = RGB(255, 40, 200), Accent2 = RGB(0, 220, 255), Dark = RGB(16, 16, 20) },
	Signal = { Body = RGB(24, 26, 30), Panel = RGB(232, 234, 240), Accent = RGB(0, 170, 255), Accent2 = RGB(120, 220, 255), Dark = RGB(14, 14, 18) },
	Volt = { Body = RGB(30, 30, 32), Panel = RGB(255, 190, 30), Accent = RGB(255, 210, 40), Accent2 = RGB(0, 220, 255), Dark = RGB(18, 18, 20) },
	Vortex = { Body = RGB(30, 28, 40), Panel = RGB(120, 75, 240), Accent = RGB(180, 100, 255), Accent2 = RGB(0, 255, 200), Dark = RGB(16, 14, 22) },
	Raptor = { Body = RGB(38, 42, 34), Panel = RGB(105, 135, 70), Accent = RGB(140, 255, 80), Accent2 = RGB(255, 255, 255), Dark = RGB(20, 22, 18) },
	Nova = { Body = RGB(40, 40, 46), Panel = RGB(255, 125, 20), Accent = RGB(255, 220, 0), Accent2 = RGB(0, 220, 255), Dark = RGB(18, 18, 22) },
	Viper = { Body = RGB(30, 30, 34), Panel = RGB(220, 40, 45), Accent = RGB(255, 60, 60), Accent2 = RGB(255, 255, 255), Dark = RGB(16, 16, 18) },
	Gold = { Body = RGB(30, 26, 24), Panel = RGB(235, 175, 50), Accent = RGB(255, 200, 60), Accent2 = RGB(255, 255, 255), Dark = RGB(20, 18, 16), PanelMaterial = Enum.Material.Foil },
	Fang = { Body = RGB(30, 30, 36), Panel = RGB(230, 232, 238), Accent = RGB(0, 220, 255), Accent2 = RGB(255, 255, 255), Dark = RGB(60, 64, 72) },
}
Weapons.Palettes = Palettes

Weapons.List = {
	ARX27 = {
		DisplayName = "ARX-27 Pulse",
		Category = "Fusil de asalto",
		Description = "Fiable a cualquier distancia. El arma de todo operador.",
		Slot = 1,
		Type = "Gun",
		Palette = Palettes.Pulse,
		Parts = Designs.ARX27(),
		UnlockLevel = 1,
		Damage = 24,
		MinDamage = 16,
		FalloffStart = 120,
		FalloffEnd = 350,
		HeadshotMultiplier = 1.6,
		FireRate = 10,
		Automatic = true,
		MagSize = 30,
		ReserveAmmo = 150,
		ReloadTime = 1.9,
		Range = 600,
		Spread = 1.6,
		AimSpread = 0.25,
		Pellets = 1,
		Recoil = 0.8,
		AimFOV = 60,
		ViewOffset = CFrame.new(0.8, -0.85, -2.0),
		AimDistance = 1.0,
		RightHand = V(0, -0.48, 0.44),
		LeftHand = V(0, -0.26, -1.0),
		AimPoint = V(0, 0.62, 0.35),
		Muzzle = V(0, 0.06, -2.5),
	},

	HavocPump = {
		DisplayName = "Havoc Pump",
		Category = "Escopeta",
		Description = "Arrasa a corta distancia. Un disparo, una baja.",
		Slot = 1,
		Type = "Gun",
		Palette = Palettes.Havoc,
		Parts = Designs.HavocPump(),
		UnlockLevel = 1,
		Damage = 12,
		MinDamage = 3,
		FalloffStart = 25,
		FalloffEnd = 70,
		HeadshotMultiplier = 1.3,
		FireRate = 1.4,
		Automatic = false,
		MagSize = 6,
		ReserveAmmo = 36,
		ReloadTime = 2.4,
		Range = 160,
		Spread = 6,
		AimSpread = 4.5,
		Pellets = 8,
		Recoil = 4,
		AimFOV = 65,
		ViewOffset = CFrame.new(0.8, -0.85, -1.9),
		AimDistance = 1.0,
		RightHand = V(0, -0.48, 0.55),
		LeftHand = V(0, -0.38, -1.15),
		AimPoint = V(0, 0.43, 0.75),
		Muzzle = V(0, 0.12, -2.38),
	},

	Specter9 = {
		DisplayName = "Specter-9",
		Category = "Subfusil",
		Description = "Muévete rápido, golpea fuerte, desaparece.",
		Slot = 1,
		Type = "Gun",
		Palette = Palettes.Specter,
		Parts = Designs.Specter9(),
		UnlockLevel = 1,
		Damage = 18,
		MinDamage = 11,
		FalloffStart = 50,
		FalloffEnd = 160,
		HeadshotMultiplier = 1.4,
		FireRate = 14,
