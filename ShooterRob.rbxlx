	},
	Magma = {
		Name = "Magma",
		Rarity = "Mítico",
		Body = Color3.fromRGB(40, 20, 15),
		BodyMaterial = Enum.Material.Basalt,
		Accent = Color3.fromRGB(255, 90, 0),
