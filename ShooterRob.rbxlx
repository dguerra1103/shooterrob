KILL_FX.AgujeroNegro = function(position)
	local hole = fxPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.5, 0.5, 0.5),
		CFrame = CFrame.new(position),
		Color = Color3.fromRGB(5, 0, 10),
		Material = Enum.Material.SmoothPlastic,
	})
	local ring = fxPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 1, 1),
		CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(170, 60, 255),
	})
	TweenService:Create(hole, TweenInfo.new(0.5, Enum.EasingStyle.Back), { Size = Vector3.one * 6 }):Play()
	TweenService:Create(ring, TweenInfo.new(0.5, Enum.EasingStyle.Back), { Size = Vector3.new(0.2, 11, 11) }):Play()
	-- Partículas que nacen en una esfera grande y caen hacia el centro
	local anchor = fxPart({ Size = Vector3.new(12, 12, 12), Transparency = 1, CFrame = CFrame.new(position) })
	Debris:AddItem(anchor, 2.5)
	emit(anchor, {
		Texture = TEX.Sparkle,
		Color = ColorSequence.new(Color3.fromRGB(200, 120, 255), Color3.fromRGB(255, 80, 200)),
		LightEmission = 1,
		Size = seq(0.7, 0),
		Lifetime = NumberRange.new(0.5, 0.6),
		Speed = NumberRange.new(10, 12),
		Shape = Enum.ParticleEmitterShape.Sphere,
		ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
	}, 50)
	task.delay(1.1, function()
		TweenService:Create(hole, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Size = Vector3.one * 0.1 }):Play()
		TweenService:Create(ring, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Size = Vector3.new(0.2, 0.1, 0.1), Transparency = 1 }):Play()
	end)
	Debris:AddItem(hole, 1.6)
	Debris:AddItem(ring, 1.6)
end

-- Dibuja el efecto de eliminación indicado (color = color del equipo de la víctima, para el normal)
-- Pintura: bolas de pintura de colores que saltan y manchas en el suelo alrededor
KILL_FX.Pintura = function(position)
	debrisBurst(position, 18, function()
		local ball = fxPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.6, 0.6, 0.6),
			Color = PAINT_COLORS[math.random(1, #PAINT_COLORS)],
			Material = Enum.Material.SmoothPlastic,
		})
		return ball
	end, 20, 1.4)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { folder }
	for i = 1, 6 do
		local angle = i / 6 * math.pi * 2
		local origin = position + Vector3.new(math.cos(angle) * 2.5, 1, math.sin(angle) * 2.5)
		local hit = workspace:Raycast(origin, Vector3.new(0, -8, 0), params)
		if hit and not hit.Instance.Parent:FindFirstChildOfClass("Humanoid") then
			local anchor = emitterAnchor(hit.Position, hit.Normal, 1)
			paintSplat(anchor, hit.Position, hit.Normal, false)
		end
	end
	floatingText(position + Vector3.new(0, 2, 0), "🎨", 80, Vector3.new(0, 4, 0), 1.3)
end

-- Arcoíris: un arco de bolas de colores que sale del enemigo y se desvanece
KILL_FX.Arcoiris = function(position)
	for i = 0, 13 do
		task.delay(i * 0.035, function()
			local t = i / 13
			local offset = Vector3.new((t - 0.5) * 9, math.sin(t * math.pi) * 6 + 1, 0)
			local ball = fxPart({
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(1.1, 1.1, 1.1),
				Color = Color3.fromHSV(t * 0.85, 0.8, 1),
				CFrame = CFrame.new(position + offset),
			})
			TweenService:Create(ball, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2) }):Play()
			Debris:AddItem(ball, 1.3)
		end)
	end
	flashBall(position, Color3.fromRGB(255, 255, 255), 5, 0.3)
	floatingText(position + Vector3.new(0, 3, 0), "🌈", 90, Vector3.new(0, 3, 0), 1.5)
end

-- Murciélagos: salen volando hacia arriba en todas direcciones, con humo morado
KILL_FX.Murcielagos = function(position)
	for i = 1, 9 do
		task.delay(i * 0.04, function()
			local angle = math.random() * math.pi * 2
			local velocity = Vector3.new(math.cos(angle) * (4 + math.random() * 4), 6 + math.random() * 5, math.sin(angle) * (4 + math.random() * 4))
			floatingText(position + Vector3.new(0, 1, 0), "🦇", 40 + math.random(0, 25), velocity, 1.4)
		end)
	end
	local anchor = emitterAnchor(position, Vector3.yAxis, 2.5)
	emit(anchor, {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(Color3.fromRGB(140, 60, 200), Color3.fromRGB(40, 20, 60)),
		Size = seq(1.5, 4),
		Transparency = seq(0.3, 1),
		Lifetime = NumberRange.new(0.8, 1.3),
		Speed = NumberRange.new(2, 5),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, 2, 0),
	}, 12)
	flashBall(position, Color3.fromRGB(170, 80, 255), 4, 0.25)
end

-- Calabazas: calabacitas naranjas que saltan y una gran 🎃 que sube
KILL_FX.Calabazas = function(position)
	debrisBurst(position, 10, function()
		return fxPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.9, 0.75, 0.9),
			Color = Color3.fromRGB(255, 130, 20),
			Material = Enum.Material.SmoothPlastic,
		})
	end, 18, 1.5)
	flashBall(position, Color3.fromRGB(255, 160, 40), 5, 0.3)
	floatingText(position + Vector3.new(0, 2, 0), "🎃", 110, Vector3.new(0, 3.5, 0), 1.6)
	task.delay(0.25, function()
		floatingText(position + Vector3.new(1.5, 3, 0), "😈", 60, Vector3.new(0, 2.5, 0), 1.2)
	end)
end

-- Ventisca (Navidad): bolas de nieve que saltan, copos y un muñeco de nieve que sube
KILL_FX.Nieve = function(position)
	debrisBurst(position, 12, function()
		return fxPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.6, 0.6, 0.6),
			Color = Color3.fromRGB(245, 250, 255),
			Material = Enum.Material.SmoothPlastic,
		})
	end, 16, 1.4)
	flashBall(position, Color3.fromRGB(200, 235, 255), 5, 0.3)
	floatingText(position + Vector3.new(0, 2, 0), "☃️", 110, Vector3.new(0, 3.5, 0), 1.6)
	task.delay(0.2, function()
		floatingText(position + Vector3.new(-1.5, 2.5, 0), "❄️", 60, Vector3.new(0, 2.5, 0), 1.2)
		floatingText(position + Vector3.new(1.5, 3, 0), "❄️", 50, Vector3.new(0, 2.5, 0), 1.2)
	end)
end

KILL_FX.Fuegos = function(position)
	-- Tres cohetes de colores que estallan uno detrás de otro encima del rival
	local colors = { Color3.fromRGB(255, 80, 80), Color3.fromRGB(80, 200, 255), Color3.fromRGB(255, 215, 60) }
	for i, color in colors do
		task.delay((i - 1) * 0.18, function()
			local burstAt = position + Vector3.new((i - 2) * 2.5, 6 + i, 0)
			flashBall(burstAt, color, 5, 0.3)
			debrisBurst(burstAt, 10, function()
				return fxPart({
					Shape = Enum.PartType.Ball,
					Size = Vector3.new(0.35, 0.35, 0.35),
					Color = color,
					Material = Enum.Material.Neon,
				})
			end, 18, 1)
		end)
	end
	floatingText(position + Vector3.new(0, 2, 0), "🎆", 100, Vector3.new(0, 4, 0), 1.4)
end

KILL_FX.Rodadora = function(position)
	-- Polvareda del desierto, una bola de matojos que sale rodando y un sombrero volando
	local anchor = emitterAnchor(position, Vector3.yAxis, 1)
	emit(anchor, {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(Color3.fromRGB(230, 190, 130), Color3.fromRGB(180, 140, 90)),
		Size = seq(2, 6),
		Transparency = seq(0.25, 1),
		Lifetime = NumberRange.new(0.9, 1.4),
		Speed = NumberRange.new(5, 10),
		SpreadAngle = Vector2.new(80, 80),
	}, 16)
	debrisBurst(position, 6, function()
		return fxPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1.6, 1.6, 1.6),
			Color = Color3.fromRGB(170, 130, 70),
			Material = Enum.Material.Grass,
		})
	end, 14, 1.4)
	floatingText(position + Vector3.new(0, 2, 0), "🤠", 110, Vector3.new(0, 5, 0), 1.6)
	task.delay(0.15, function()
		floatingText(position + Vector3.new(1.5, 1.5, 0), "🌵", 60, Vector3.new(0, 2.5, 0), 1.2)
	end)
end

-- Baja normal en un mapa realista: sin estallido de colores, solo el polvo que levanta el cuerpo al
-- caer (y, con GameConfig.RealisticBlood, una nube rojo oscuro que se desvanece). El cuerpo cae como
-- un muñeco de trapo (ver Ragdoll)
function Effects.DeathPuff(position)
	local anchor = emitterAnchor(position - Vector3.new(0, 1.5, 0), Vector3.yAxis, 2)
	emit(anchor, {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(Color3.fromRGB(150, 140, 125)),
		LightInfluence = 1,
		Size = seq(0.8, 3.2),
		Transparency = seq(0.45, 1),
		Lifetime = NumberRange.new(0.7, 1.1),
		Speed = NumberRange.new(3, 6),
		SpreadAngle = Vector2.new(80, 15),
		Drag = 3,
		Acceleration = Vector3.new(0, 1, 0),
	}, 7)
	if not GameConfig.RealisticBlood then
		return
	end
	local mist = emitterAnchor(position, Vector3.yAxis, 1)
	emit(mist, {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(Color3.fromRGB(110, 10, 12)),
		LightInfluence = 0.8,
		Size = seq(0.5, 1.8),
		Transparency = seq(0.35, 1),
		Lifetime = NumberRange.new(0.3, 0.5),
		Speed = NumberRange.new(2, 4),
		SpreadAngle = Vector2.new(60, 60),
		Drag = 5,
	}, 3)
end

function Effects.KillEffect(effectId, position, color)
	local fn = KILL_FX[effectId]
	if fn then
		fn(position)
	elseif realisticMap() then
		-- (los efectos comprados se ven igual; el normal, realista)
		Effects.DeathPuff(position)
	else
		Effects.DeathBurst(position, color)
	end
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="102">
            <Properties>
              <string name="Name">Emotes</string>
              <string name="Source"><![CDATA[-- Emotes (tecla N): menú con los bailes y gestos que trae Roblox (script Animate). Mientras dura el
-- emote la cámara pasa a tercera persona para verte; vuelve a primera persona al moverte o al acabar.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Sounds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Sounds"))

local TouchLayout = require(script.Parent.TouchLayout)
local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local Emotes = {}

local EMOTES = {
	{ Id = "wave", Name = "Saludar", Icon = "👋" },
	{ Id = "dance", Name = "Baile 1", Icon = "🕺" },
	{ Id = "dance2", Name = "Baile 2", Icon = "💃" },
	{ Id = "dance3", Name = "Baile 3", Icon = "🎶" },
	{ Id = "cheer", Name = "Celebrar", Icon = "🙌" },
	{ Id = "laugh", Name = "Reír", Icon = "😂" },
	{ Id = "point", Name = "Señalar", Icon = "👉" },
}
local EMOTE_TIME = 4

local gui, wheel
local emoteUntil = 0
local zoom = { 0.5, 400 }

local function setThirdPerson(on)
	if on then
		-- Solo se guarda el zoom de primera persona (no el de un emote anterior)
		if not ClientState.Emoting then
			zoom = { player.CameraMinZoomDistance, player.CameraMaxZoomDistance }
		end
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMinZoomDistance = 9
		player.CameraMaxZoomDistance = 12
	else
		player.CameraMinZoomDistance = zoom[1]
		player.CameraMaxZoomDistance = zoom[2]
		player.CameraMode = Enum.CameraMode.LockFirstPerson
	end
end

local function stopEmote()
	if not ClientState.Emoting then
		return
	end
	ClientState.Emoting = false
	emoteUntil = 0
	if not ClientState.Dead then
		setThirdPerson(false)
	end
end

local function play(id)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local animate = character and character:FindFirstChild("Animate")
	local playEmote = animate and animate:FindFirstChild("PlayEmote")
	if not humanoid or humanoid.Health <= 0 or not playEmote or not playEmote:IsA("BindableFunction") then
		return
	end
	local ok, played = pcall(function()
		return playEmote:Invoke(id)
	end)
	-- PlayEmote devuelve true solo si de verdad empieza (nil si estás saltando, sentado, etc.)
	if ok and played == true then
		setThirdPerson(true)
		ClientState.Emoting = true
		emoteUntil = os.clock() + EMOTE_TIME
	end
end

local function setWheel(open)
	wheel.Visible = open
	ClientState.EmoteMenuOpen = open
	ClientState.UpdateMouse()
end

-- Otros motivos para cerrar el menú (no cuenta el propio menú de emotes)
local function otherBlock()
	return ClientState.MenuOpen or ClientState.VoteOpen or ClientState.InMainMenu or ClientState.Dead
end

local function build()
	gui = UI.new("ScreenGui", {
		Name = "Emotes",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 2,
		Parent = player:WaitForChild("PlayerGui"),
	})
	wheel = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(360, 360),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	-- Libera el ratón mientras el menú está abierto
	UI.new("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true, Parent = wheel })
	UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(120, 40),
		Text = "EMOTES",
		TextSize = 24,
		Parent = wheel,
	})
	for i, emote in EMOTES do
		local angle = (i - 1) / #EMOTES * math.pi * 2 - math.pi / 2
		local button = UI.button({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.cos(angle) * 130, 0.5, math.sin(angle) * 130),
			Size = UDim2.fromOffset(92, 92),
			Text = "",
			BackgroundColor3 = Color3.fromRGB(40, 44, 70),
			BackgroundTransparency = 0.15,
			Parent = wheel,
		}, { UI.stroke(Color3.new(1, 1, 1), 3, 0), UI.corner(46) })
		UI.label({ Size = UDim2.new(1, 0, 0.7, 0), Text = emote.Icon, TextSize = 40, Parent = button })
		UI.label({ Position = UDim2.fromScale(0, 0.62), Size = UDim2.new(1, 0, 0.3, 0), Text = emote.Name, TextSize = 15, Parent = button })
		button.Activated:Connect(function()
			Sounds.Play("Click")
			setWheel(false)
			play(emote.Id)
		end)
	end
end

function Emotes.Init()
	build()
	TouchLayout.BindAction("Emotes", function(_, state)
		if state == Enum.UserInputState.Begin then
			if wheel.Visible then
				setWheel(false)
			elseif not ClientState.IsBlocked() then
				setWheel(true)
			end
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.N)
	-- Botón táctil en móvil
	TouchLayout.SetTitle("Emotes", "😀")
	TouchLayout.Set("Emotes", UDim2.new(1, -120, 1, -320))
	RunService.Heartbeat:Connect(function()
		if wheel.Visible and otherBlock() then
			setWheel(false)
		end
		if not ClientState.Emoting then
			return
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		-- Se acaba al pasar el tiempo, al moverse, al morir o al disparar
		local moved = humanoid and humanoid.MoveDirection.Magnitude > 0.1
		if os.clock() > emoteUntil or moved or not humanoid or humanoid.Health <= 0 or ClientState.Aiming then
			stopEmote()
		end
	end)
	ClientState.ShotFired.Event:Connect(stopEmote)
	player.CharacterAdded:Connect(stopEmote)
end

return Emotes
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="103">
            <Properties>
              <string name="Name">EnemyName</string>
              <string name="Source"><![CDATA[-- Nombre del enemigo al que apuntas (como en los shooters): normalmente los enemigos no llevan nombre
-- (ver WorldFX), pero si tienes la mira encima de uno, sale su nombre en rojo sobre la cabeza un
-- momento. Un solo cartel reutilizado y un rayo cada 0,1 s.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local ClientState = require(script.Parent.ClientState)

local EnemyName = {}

local RANGE = 300
local CHECK_INTERVAL = 0.1
local LINGER = 0.4

local player = Players.LocalPlayer
local billboard, label
local lastSeen = 0
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude

-- ¿Es un enemigo vivo? Devuelve su nombre
local function enemyName(model)
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or model == player.Character then
		return nil
	end
	local owner = Players:GetPlayerFromCharacter(model)
	local teamMode = ReplicatedStorage:GetAttribute("TeamMode") ~= false
	if owner then
		if teamMode and player.Team ~= nil and owner.Team == player.Team then
			return nil
		end
		return owner.DisplayName
	end
	if model:GetAttribute("Bot") then
		local team = model:GetAttribute("Team")
		if teamMode and player.Team ~= nil and team == player.Team.Name then
			return nil
		end
		return model.Name
	end
	return nil
end

local function update()
	local camera = workspace.CurrentCamera
	if not camera or ClientState.InMainMenu then
		billboard.Enabled = false
		return
	end
	local ignore = { camera }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * RANGE, params)
	local model = hit and hit.Instance:FindFirstAncestorOfClass("Model")
	local name = model and enemyName(model)
	local head = model and model:FindFirstChild("Head")
	if name and head then
		lastSeen = os.clock()
		label.Text = name
		billboard.Adornee = head
		billboard.Enabled = true
	elseif os.clock() - lastSeen > LINGER or not (billboard.Adornee and billboard.Adornee.Parent) then
		billboard.Enabled = false
	end
end

function EnemyName.Init()
	billboard = Instance.new("BillboardGui")
	billboard.Name = "EnemyName"
	billboard.ResetOnSpawn = false -- (si no, Roblox lo borraría al aparecer)
	billboard.Size = UDim2.fromOffset(160, 24)
	billboard.StudsOffset = Vector3.new(0, 2.4, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.Enabled = false
	billboard.Parent = player:WaitForChild("PlayerGui")
	label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 16
	label.TextColor3 = Color3.fromRGB(255, 70, 60)
	label.TextStrokeTransparency = 0.3
	label.Text = ""
	label.Parent = billboard
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < CHECK_INTERVAL then
			return
		end
		elapsed = 0
		update()
	end)
end

EnemyName.Update = update
return EnemyName
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="104">
            <Properties>
              <string name="Name">EventHUD</string>
              <string name="Source"><![CDATA[-- Contador del evento de temporada (debajo del botón de regalos): caramelos recogidos hacia el
-- siguiente premio (GameConfig.Event.Milestones y la skin final), con marcas en la barra.
-- Solo aparece si el servidor tiene un evento activo (atributo EventName).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local EventHUD = {}

function EventHUD.Init()
	local compact = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local gui = UI.new("ScreenGui", {
		Name = "EventHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	UI.WaitViewport()
	local phone = UI.IsPhone()
	local frame = UI.new("Frame", {
		-- En móvil: estrecho, debajo del regalo (teléfono: los dos a la derecha del minimapa)
		Position = compact and UDim2.fromOffset(14 + (phone and 96 or 160) + 6, UI.TopbarBottom() + (phone and 60 or 70))
			or UDim2.new(0, 66, 0.38, 176),
		Size = phone and UDim2.fromOffset(44, 34) or (compact and UDim2.fromOffset(52, 40) or UDim2.fromOffset(230, 34)),
		BackgroundColor3 = Color3.fromRGB(60, 25, 80),
		BackgroundTransparency = 0.15,
		Parent = gui,
	}, { UI.corner(10), UI.stroke(Color3.fromRGB(255, 140, 30), 2, 0.2) })
	local label = UI.label({
		Position = UDim2.fromOffset(2, 0),
		Size = UDim2.new(1, -4, 1, -4),
		Text = "",
		TextSize = 18,
		TextScaled = compact,
		TextWrapped = compact,
		Parent = frame,
	})
	local fill = UI.new("Frame", {
		Position = UDim2.new(0, 4, 1, -5),
		Size = UDim2.new(0, 0, 0, 3),
		BackgroundColor3 = Color3.fromRGB(255, 140, 30),
		BorderSizePixel = 0,
		Parent = frame,
	})
	-- (el evento lo dice el servidor: atributo EventId; se mira cada vez por si cambia)
	local milestones, icon, itemIcon = {}, "🎉", "⭐"
	local function syncEvent()
		local event = GameConfig.CurrentEvent()
		milestones = (event and event.Milestones) or {}
		icon = event and event.Icon or "🎉"
		itemIcon = event and event.ItemIcon or "⭐"
	end
	syncEvent()
	local ticks = {}
	for _ = 1, 4 do -- (marcas de los premios por el camino; las que sobran se ocultan)
		table.insert(ticks, UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Size = UDim2.fromOffset(2, 5),
			Position = UDim2.new(0, 0, 1, -6),
			BackgroundColor3 = Color3.fromRGB(255, 230, 150),
			BorderSizePixel = 0,
			Visible = not compact,
			Parent = frame,
		}))
	end
	-- Siguiente premio: caramelos que hacen falta y texto corto (si ya tienes el traje, son monedas)
	local function nextPrize(count, goal, data)
		for _, milestone in milestones do
			if count < milestone.Count and milestone.Count < goal then
				local outfit = milestone.Outfit and not (data.Outfits or {})[milestone.Outfit]
				local weapon = milestone.Weapon and not (data.OwnedWeapons or {})[milestone.Weapon]
				return milestone.Count, (outfit and "Traje") or (weapon and "Arma") or ((milestone.Coins or milestone.Compensate or 0) .. " 🪙")
			end
		end
		return goal, "Skin"
	end
	task.spawn(function()
		while true do
			syncEvent()
			local name = ReplicatedStorage:GetAttribute("EventName")
			local goal = ReplicatedStorage:GetAttribute("EventGoal") or 100
			local data = ClientState.Data
			gui.Enabled = name ~= nil and data ~= nil and not ClientState.InMainMenu
			if gui.Enabled then
				local count = data.EventCandy or 0
				if count >= goal then
					label.Text = compact and (icon .. "\n✔") or (icon .. " ¡Skin del evento conseguida!")
				else
					local target, prize = nextPrize(count, goal, data)
					label.Text = compact and (itemIcon .. "\n" .. count .. "/" .. target)
						or (icon .. " " .. itemIcon .. " " .. count .. "/" .. target .. "  → " .. prize)
				end
				fill.Size = UDim2.new(math.clamp(count / goal, 0, 1), -8, 0, 3)
				for i, tick in ticks do
					local milestone = milestones[i]
					if not milestone then
						tick.Visible = false
						continue
					end
					local at = milestone.Count / goal
					tick.Visible = not compact and at < 1
					tick.Position = UDim2.new(at, 4 - 8 * at, 1, -6)
					tick.BackgroundColor3 = count >= milestones[i].Count and Color3.fromRGB(255, 140, 30)
						or Color3.fromRGB(255, 230, 150)
				end
			end
			task.wait(0.5)
		end
	end)
end

return EventHUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="105">
            <Properties>
              <string name="Name">Footprints</string>
              <string name="Source"><![CDATA[-- Huellas en superficies blandas (nieve, arena, barro, tierra): solo en el cliente, para los
-- personajes cercanos (jugadores y bots). Se desvanecen solas y hay un máximo para no gastar memoria. En calidad Baja
-- no se crean.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local ClientState = require(script.Parent.ClientState)

local Footprints = {}

-- Color de la huella según el material que pisa (algo más oscuro que la superficie)
local SOFT = {
	[Enum.Material.Snow] = Color3.fromRGB(184, 194, 214),
	[Enum.Material.Sand] = Color3.fromRGB(140, 120, 88),
	[Enum.Material.Mud] = Color3.fromRGB(58, 44, 30),
	[Enum.Material.Ground] = Color3.fromRGB(80, 66, 46),
}
local STEP_DISTANCE = 2.6 -- studs entre pisadas
local MAX_PRINTS = 70
local LIFETIME = 9
local MAX_DISTANCE = 90 -- solo personajes cerca de la cámara
local CHECK_INTERVAL = 0.08

local folder
local prints = {}
local tracked = {} -- [character] = { Last = Vector3, Left = boolean }

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function removePrint(part)
	local index = table.find(prints, part)
	if index then
		table.remove(prints, index)
	end
	part:Destroy()
end

local function addPrint(cf, color)
	if #prints >= MAX_PRINTS then
		removePrint(prints[1])
	end
	local part = Instance.new("Part")
	part.Name = "Footprint"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.SmoothPlastic
	part.Color = color
	part.Size = Vector3.new(0.65, 0.04, 1.1)
	part.Transparency = 0.35
	part.CFrame = cf
	part.Parent = folder
	table.insert(prints, part)
	-- Se mantiene un rato y luego se borra poco a poco (como la nieve que cae encima)
	local fade = TweenInfo.new(LIFETIME * 0.6, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, LIFETIME * 0.4)
	TweenService:Create(part, fade, { Transparency = 1 }):Play()
	task.delay(LIFETIME, function()
		if part.Parent then
			removePrint(part)
		end
	end)
end

local function step(character, humanoid, root, state)
	local flat = Vector3.new(1, 0, 1)
	local moved = (root.Position - state.Last) * flat
	if moved.Magnitude < STEP_DISTANCE then
		return
	end
	state.Last = root.Position
	-- El material sale del rayo hacia el suelo (FloorMaterial solo se calcula para tu personaje);
	-- si no hay suelo cerca (saltando) no hay huella
	rayParams.FilterDescendantsInstances = { folder, character }
	local result = workspace:Raycast(root.Position, Vector3.new(0, -(humanoid.HipHeight + root.Size.Y / 2 + 1), 0), rayParams)
	local color = result and SOFT[result.Material]
	if not color then
		return
	end
	local normal = result.Normal
	local forward = moved.Unit
	forward = (forward - normal * forward:Dot(normal))
	if forward.Magnitude < 0.01 then
		return
	end
	forward = forward.Unit
	local right = forward:Cross(normal)
	state.Left = not state.Left
	local position = result.Position + normal * 0.02 + right * (state.Left and -0.45 or 0.45)
	addPrint(CFrame.fromMatrix(position, right, normal, -forward), color)
end

function Footprints.Init()
	folder = Instance.new("Folder")
	folder.Name = "Footprints"
	folder.Parent = workspace

	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < CHECK_INTERVAL then
			return
		end
		elapsed = 0
		if ClientState.EffectiveQuality == "Baja" then
			return
		end
		local camera = workspace.CurrentCamera
		local seen = {}
		local characters = {}
		for _, player in Players:GetPlayers() do
			if player.Character then
				table.insert(characters, player.Character)
			end
		end
		-- (los bots también dejan huellas)
		local bots = workspace:FindFirstChild("Bots")
		if bots then
			for _, model in bots:GetChildren() do
				table.insert(characters, model)
			end
		end
		for _, character in characters do
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if humanoid and root and humanoid.Health > 0 and camera and (root.Position - camera.CFrame.Position).Magnitude < MAX_DISTANCE then
				seen[character] = true
				local state = tracked[character]
				if not state then
					state = { Last = root.Position, Left = false }
					tracked[character] = state
				end
				step(character, humanoid, root, state)
			end
		end
		for character in tracked do
			if not seen[character] then
				tracked[character] = nil
			end
		end
	end)
end

return Footprints
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="106">
            <Properties>
              <string name="Name">Graffiti</string>
              <string name="Source"><![CDATA[-- Grafitis (tecla J, o el botón 🎨 en móvil): pinta tu grafiti equipado en la pared o el suelo que
-- tienes delante. El servidor (Graffiti) comprueba el punto y lo pinta para todos.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Sprays = require(Shared.Sprays)
local Sounds = require(Shared.Sounds)

local TouchLayout = require(script.Parent.TouchLayout)
local ClientState = require(script.Parent.ClientState)

local player = Players.LocalPlayer

local Graffiti = {}

local lastSpray = -math.huge
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function spray()
	if ClientState.IsBlocked() then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	if os.clock() - lastSpray < Sprays.Cooldown then
		return
	end
	local camera = workspace.CurrentCamera
	local ignore = { character }
	for _, other in Players:GetPlayers() do
		if other.Character then
			table.insert(ignore, other.Character)
		end
	end
	rayParams.FilterDescendantsInstances = ignore
	local origin = camera.CFrame.Position
	local hit = workspace:Raycast(origin, camera.CFrame.LookVector * (Sprays.Range + 4), rayParams)
	local head = character:FindFirstChild("Head")
	-- (el servidor solo pinta en cosas fijas: si no, ni sonido ni recarga)
	if not hit or not head or (hit.Position - head.Position).Magnitude > Sprays.Range or not hit.Instance.Anchored then
		return
	end
	lastSpray = os.clock()
	Remotes.Spray:FireServer(hit.Position)
	Sounds.Play("Slide", nil, 1.6, 0.5) -- "pssst" del bote
end

function Graffiti.Init()
	TouchLayout.BindAction("Spray", function(_, state)
		if state == Enum.UserInputState.Begin then
			spray()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.J, Enum.KeyCode.ButtonR1) -- (R1 en el mando)
	TouchLayout.SetTitle("Spray", "🎨")
	TouchLayout.Set("Spray", UDim2.new(1, -200, 1, -340))
end

return Graffiti
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="107">
            <Properties>
              <string name="Name">GrenadeController</string>
              <string name="Source"><![CDATA[-- Granada en el cliente: tecla G (L1 en mando, botón en móvil), indicador de recarga y explosiones.
-- Como en los shooters realistas, se puede "cocinar": un toque la lanza enseguida; manteniendo la
-- tecla se le quita la anilla y la mecha corre (pitidos cada vez más rápidos y cuenta atrás) y al
-- soltar sale con menos tiempo para que el enemigo no pueda escapar. Si se acaba, sale sola.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weapons = require(Shared.Weapons)
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)

local TouchLayout = require(script.Parent.TouchLayout)
local ClientState = require(script.Parent.ClientState)
local Effects = require(script.Parent.Effects)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local GrenadeController = {}

local DEF = Weapons.Grenade

local widget, label, fill
local touchOnly = false
local cookStart = nil -- os.clock() al quitar la anilla (cocinando)
local nextBeep = 0
local AUTO_THROW = 0.25 -- (si queda tan poca mecha, sale sola)

local function readyAt()
	return player:GetAttribute("GrenadeReadyAt") or 0
end

local function canThrow()
	if ClientState.IsBlocked() or ClientState.Frozen() or ReplicatedStorage:GetAttribute("Mode") == "GUN" then
		return false
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0 and workspace:GetServerTimeNow() >= readyAt()
end

local function throw(cook)
	if not canThrow() then
		return
	end
	-- Un poco hacia arriba para que la parábola llegue más lejos
	local direction = (camera.CFrame.LookVector + Vector3.new(0, 0.12, 0)).Unit
	Remotes.ThrowGrenade:FireServer(direction, cook or 0)
	Sounds.Play("Swing", nil, 0.8, 1)
end

-- Quitar la anilla (empieza a cocinarse)
local function startCook()
	if cookStart or not canThrow() then
		return
	end
	cookStart = os.clock()
	nextBeep = cookStart + 0.5
	Sounds.Play("Click", nil, 1.7, 0.7)
end

-- Soltar: sale con el tiempo que lleva cocinándose
local function release()
	if not cookStart then
		return
	end
	local cook = math.clamp(os.clock() - cookStart, 0, DEF.Fuse - AUTO_THROW)
	cookStart = nil
	throw(cook)
end

-- Segundos de mecha que le quedan a la granada que se está cocinando (nil si no hay)
function GrenadeController.CookLeft()
	return cookStart and math.max(0, DEF.Fuse - (os.clock() - cookStart)) or nil
end

local lastKey
local function updateWidget()
	local gunGame = ReplicatedStorage:GetAttribute("Mode") == "GUN"
	local active = not ClientState.InMainMenu and not gunGame
	-- (con pantalla táctil el cartel no sale: está el botón 💣, que tampoco sale en la Escalada)
	widget.Visible = active and not touchOnly
	local touchButton = TouchLayout.GetButton("Grenade")
	if touchButton then
		touchButton.Visible = active and not ClientState.IsBlocked()
	end
	if not active then
		cookStart = nil
		return
	end
	-- Cocinando: pitidos cada vez más rápidos y, si se acaba la mecha, sale sola
	if cookStart then
		if not canThrow() then
			cookStart = nil -- (muerto, bloqueado...)
		else
			local fuseLeft = DEF.Fuse - (os.clock() - cookStart)
			if fuseLeft <= AUTO_THROW then
				release()
			else
				if os.clock() >= nextBeep then
					Sounds.Play("Click", nil, 2.2, 0.5)
					nextBeep = os.clock() + math.clamp(fuseLeft * 0.25, 0.12, 0.5)
				end
				local key = -1000 - math.floor(fuseLeft * 10)
				if key ~= lastKey then
					lastKey = key
					label.Text = string.format("💣 %.1f", fuseLeft)
					label.TextColor3 = Color3.fromRGB(255, 220, 120)
					fill.Size = UDim2.fromScale(fuseLeft / DEF.Fuse, 1)
					fill.BackgroundColor3 = Color3.fromRGB(230, 40, 30)
					if touchOnly then
						pcall(function()
							TouchLayout.SetTitle("Grenade", string.format("%.1f", fuseLeft))
						end)
					end
				end
				return
			end
		end
	end
	local left = readyAt() - workspace:GetServerTimeNow()
	-- (solo se escribe cuando cambia el segundo o la barra en pasos de 1/40)
	local key = left <= 0 and -1 or math.ceil(left) * 100 + math.floor((1 - left / DEF.Cooldown) * 40)
	if key == lastKey then
		return
	end
	lastKey = key
	-- (en pantallas táctiles el botón 💣 es el de Roblox: la cuenta atrás va en su texto)
	if touchOnly then
		pcall(function()
			TouchLayout.SetTitle("Grenade", left <= 0 and "💣" or tostring(math.ceil(left)))
		end)
	end
	if left <= 0 then
		label.Text = "💣 G"
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		fill.Size = UDim2.fromScale(1, 1)
		fill.BackgroundColor3 = Color3.fromRGB(255, 90, 40)
	else
		label.Text = "💣 " .. math.ceil(left)
		label.TextColor3 = Color3.fromRGB(190, 190, 200)
		fill.Size = UDim2.fromScale(1 - left / DEF.Cooldown, 1)
		fill.BackgroundColor3 = Color3.fromRGB(90, 90, 110)
	end
end

function GrenadeController.Init()
	local gui = UI.new("ScreenGui", {
		Name = "Grenade",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 2,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- (con pantalla táctil no se ve: quedaba encima de los botones; ahí está el botón 💣)
	touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	widget = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -150),
		Size = UDim2.fromOffset(84, 34),
		Visible = not touchOnly,
		BackgroundColor3 = Color3.fromRGB(20, 22, 34),
		BackgroundTransparency = 0.25,
		Parent = gui,
	}, { UI.corner(10), UI.stroke(Color3.fromRGB(255, 120, 60), 2, 0.3) })
	fill = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 0.55,
		Parent = widget,
	}, { UI.corner(10) })
	label = UI.label({ Size = UDim2.fromScale(1, 1), Text = "💣 G", TextSize = 20, ZIndex = 2, Parent = widget })

	TouchLayout.BindAction("Grenade", function(_, state)
		if state == Enum.UserInputState.Begin then
			startCook()
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			release()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.G, Enum.KeyCode.ButtonL1)
	TouchLayout.SetTitle("Grenade", "💣")
	TouchLayout.Set("Grenade", UDim2.new(1, -200, 1, -270))

	Remotes.ExplosionFX.OnClientEvent:Connect(function(position, radius)
		if typeof(position) == "Vector3" then
			Effects.Explosion(position, type(radius) == "number" and radius or 14)
			-- Sonido en el punto de la explosión (se oye más fuerte cuanto más cerca)
			local spot = Instance.new("Attachment")
			spot.WorldPosition = position
			spot.Parent = workspace.Terrain
			Sounds.Play("ShotHeavy", spot, 0.45, 1.6)
			Debris:AddItem(spot, 5)
		end
	end)

	RunService.Heartbeat:Connect(updateWidget)
end

return GrenadeController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="108">
            <Properties>
              <string name="Name">GrenadeWarning</string>
              <string name="Source"><![CDATA[-- Aviso de granada cercana (como en los shooters): cuando una granada enemiga cae cerca, sale un
-- icono 💣 alrededor de la mira, en la dirección en la que está, más rojo cuanto más cerca.
-- No avisa de las tuyas ni de las de tu equipo (no te hacen daño).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weapons = require(Shared.Weapons)

local UI = require(script.Parent.UI)
local ClientState = require(script.Parent.ClientState)

local GrenadeWarning = {}

local MAX_ICONS = 3
local RING = 110 -- píxeles desde el centro de la pantalla

local player = Players.LocalPlayer
local gui
local icons = {}

local function warnRadius()
	local def = Weapons.Grenade
	return ((def and def.Explosive and def.Explosive.Radius) or 16) + 4
end

local function isThreat(grenade)
	if grenade:GetAttribute("Thrower") == player.Name then
		return false
	end
	if ReplicatedStorage:GetAttribute("TeamMode") == false then
		return true
	end
	local team = grenade:GetAttribute("Team")
	return team == nil or team == "" or player.Team == nil or team ~= player.Team.Name
end

local function makeIcon()
	local icon = UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(44, 44),
		Text = "💣",
		TextSize = 26,
		BackgroundColor3 = Color3.fromRGB(200, 30, 30),
		BackgroundTransparency = 0.25,
		Visible = false,
		Parent = gui,
	}, { UI.corner(22), UI.stroke(Color3.fromRGB(255, 230, 200), 2, 0.1) })
	return icon
end

local function update()
	local folder = workspace:FindFirstChild("Grenades")
	local camera = workspace.CurrentCamera
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local used = 0
	if folder and camera and root and humanoid and humanoid.Health > 0 and not ClientState.InMainMenu then
		local radius = warnRadius()
		local viewport = camera.ViewportSize
		local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
		for _, grenade in folder:GetChildren() do
			if used >= MAX_ICONS then
				break
			end
			if grenade:IsA("BasePart") and isThreat(grenade) then
				local distance = (grenade.Position - root.Position).Magnitude
				if distance < radius then
					used += 1
					local icon = icons[used]
					-- Dirección de la granada vista desde la cámara (en el plano: delante = arriba)
					local relative = camera.CFrame:PointToObjectSpace(grenade.Position)
					local flat = Vector2.new(relative.X, relative.Z)
					local angle = flat.Magnitude > 0.01 and math.atan2(flat.X, -flat.Y) or 0
					local position = center + Vector2.new(math.sin(angle), -math.cos(angle)) * RING
					icon.Position = UDim2.fromOffset(position.X, position.Y)
					local danger = 1 - distance / radius
					icon.BackgroundTransparency = 0.6 - 0.45 * danger
					icon.Size = UDim2.fromOffset(38 + 14 * danger, 38 + 14 * danger)
					icon.Visible = true
				end
			end
		end
	end
	for i = used + 1, MAX_ICONS do
		icons[i].Visible = false
	end
end

function GrenadeWarning.Init()
	gui = UI.new("ScreenGui", {
		Name = "GrenadeWarning",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 3,
		Parent = player:WaitForChild("PlayerGui"),
	})
	for i = 1, MAX_ICONS do
		icons[i] = makeIcon()
	end
	RunService.Heartbeat:Connect(update)
end

GrenadeWarning.Update = update
return GrenadeWarning
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="109">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[-- Interfaz en partida: marcador, mira, munición, vida, racha, killfeed, avisos y pantallas de ronda.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weapons = require(Shared.Weapons)
local GameConfig = require(Shared.GameConfig)
local Skins = require(Shared.Skins)
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)
local Ranks = require(Shared.Ranks)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local WeaponController = require(script.Parent.WeaponController)
local WeaponIcon = require(script.Parent.WeaponIcon)
local Settings = require(script.Parent.Settings)
local RewardFX = require(script.Parent.RewardFX)
local ScopeSway = require(script.Parent.ScopeSway)

local player = Players.LocalPlayer

local HUD = {}

local gui
local refs = {}
-- Teléfono (táctil y pantalla baja, ver UI.IsPhone): disposición propia para que nada pise los
-- botones táctiles, el joystick ni la mira (en tablet y ordenador, como siempre). Se decide en Init.
local phone = false
local killBaseScale = 1
local thumbnails = {}

local function tween(inst, time, props, style)
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad), props)
	t:Play()
	return t
end

local function disableCoreGui()
	for _ = 1, 20 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
		end)
		if ok then
			return
		end
		task.wait(0.5)
	end
end

---------------------------------------------------------------------------
-- Construcción
---------------------------------------------------------------------------

local function buildTopBar()
	local top = UI.new("Frame", {
		Name = "TopBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(330, 44),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local function scoreBox(x, name)
		local box = UI.new("Frame", {
			Name = name,
			Position = UDim2.fromOffset(x, 0),
			Size = UDim2.fromOffset(90, 44),
			BackgroundColor3 = Color3.fromRGB(80, 80, 80),
			Parent = top,
		}, { UI.corner(10), UI.stroke(Color3.new(0, 0, 0), 3, 0), UI.gloss() })
		return UI.label({
			Size = UDim2.fromScale(1, 1),
			Text = "0",
			TextSize = 30,
			Parent = box,
		})
	end
	refs.ScoreA = scoreBox(0, "TeamA")
	refs.ScoreB = scoreBox(240, "TeamB")
	refs.ScoreABox = refs.ScoreA.Parent
	refs.ScoreBBox = refs.ScoreB.Parent

	-- Estado de las banderas (solo en Captura la bandera), a los lados del marcador
	refs.FlagA = UI.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromOffset(-8, 0),
		Size = UDim2.fromOffset(150, 44),
		Text = "",
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = top,
	})
	refs.FlagB = UI.label({
		Position = UDim2.fromOffset(338, 0),
		Size = UDim2.fromOffset(150, 44),
		Text = "",
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = top,
	})

	local timerBox = UI.new("Frame", {
		Position = UDim2.fromOffset(95, 0),
		Size = UDim2.fromOffset(140, 44),
		BackgroundColor3 = Color3.fromRGB(35, 45, 95),
		Parent = top,
	}, { UI.corner(10), UI.stroke(Color3.new(0, 0, 0), 3, 0), UI.gloss(Color3.fromRGB(120, 120, 150)) })
	refs.Timer = UI.label({ Size = UDim2.fromScale(1, 1), Text = "00:00", TextSize = 30, Parent = timerBox })

	refs.Mode = UI.label({
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 0, 20),
		Text = "",
		TextSize = 16,
		Parent = top,
	})

	refs.PlayerRow = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.fromOffset(500, 54),
		BackgroundTransparency = 1,
		Parent = top,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
end

local function buildCrosshair()
	local holder = UI.new("Frame", {
		Name = "Crosshair",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	refs.Crosshair = holder
	refs.CrossLines = {}
	for i, dir in { Vector2.new(0, -1), Vector2.new(0, 1), Vector2.new(-1, 0), Vector2.new(1, 0) } do
		local vertical = dir.X == 0
		refs.CrossLines[i] = {
			Dir = dir,
			Frame = UI.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = vertical and UDim2.fromOffset(2, 9) or UDim2.fromOffset(9, 2),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				Parent = holder,
			}, { UI.stroke(Color3.new(0, 0, 0), 1, 0.4) }),
		}
	end
	refs.CrossDot = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(3, 3),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = holder,
	}, { UI.corner(2) })

	-- Hitmarker (4 líneas diagonales)
	refs.Hitmarker = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(34, 34),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	refs.HitScale = UI.new("UIScale", { Parent = refs.Hitmarker })
	refs.HitLines = {}
	for i, pos in { Vector2.new(-1, -1), Vector2.new(1, -1), Vector2.new(-1, 1), Vector2.new(1, 1) } do
		refs.HitLines[i] = UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, pos.X * 10, 0.5, pos.Y * 10),
			Size = UDim2.fromOffset(10, 3),
			Rotation = pos.X * pos.Y * 45,
			BorderSizePixel = 0,
			BackgroundColor3 = Color3.new(1, 1, 1),
			Parent = refs.Hitmarker,
		})
	end

	-- Mira telescópica (círculo con borde negro enorme)
	refs.Scope = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.8, 0.8),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 0,
		Parent = gui,
	}, {
		UI.new("UIAspectRatioConstraint", { AspectRatio = 1 }),
		UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
		UI.new("UIStroke", { Thickness = 3000, Color = Color3.new(0, 0, 0) }),
		-- Bandas negras a los lados (por si el borde no cubre toda la pantalla)
		UI.new("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.new(0, 4000, 3, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
		}),
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.new(0, 4000, 3, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
		}),
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, 0, 0, 2),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
		}),
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 2, 1, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
		}),
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(5, 5),
			BackgroundColor3 = Color3.fromRGB(255, 40, 40),
			BorderSizePixel = 0,
		}, { UI.corner(3) }),
	})
	-- Aguantar la respiración (con teclado o mando; en el móvil la mira apenas se mueve)
	refs.ScopeHint = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 0.97),
		Size = UDim2.new(0.8, 0, 0, 22),
		Text = "",
		TextSize = 16,
		TextColor3 = Color3.fromRGB(230, 230, 230),
		TextStrokeTransparency = 0.4,
		ZIndex = 2,
		Parent = refs.Scope,
	})
end

local function buildWeaponPanel()
	-- Munición (abajo a la derecha)
	-- (en el teléfono, compacta y en el centro, encima de las habilidades: a la derecha están los
	-- botones táctiles)
	local align = phone and Enum.TextXAlignment.Center or Enum.TextXAlignment.Right
	local panel = UI.new("Frame", {
		AnchorPoint = phone and Vector2.new(0.5, 1) or Vector2.new(1, 1),
		Position = phone and UDim2.new(0.5, 0, 1, -122) or UDim2.new(1, -24, 1, -20),
		Size = phone and UDim2.fromOffset(160, 46) or UDim2.fromOffset(260, 104),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	refs.WeaponName = UI.label({
		Size = UDim2.new(1, 0, 0, phone and 14 or 24),
		Text = "",
		TextSize = phone and 13 or 20,
		TextXAlignment = align,
		Parent = panel,
	})
	refs.Ammo = UI.label({
		Position = UDim2.fromOffset(0, phone and 13 or 24),
		Size = UDim2.new(1, 0, 0, phone and 26 or 50),
		Text = "",
		TextSize = phone and 24 or 46,
		RichText = true,
		TextXAlignment = align,
		Parent = panel,
	})
	-- Barra del cargador
	local ammoBar = UI.new("Frame", {
		AnchorPoint = phone and Vector2.new(0.5, 0) or Vector2.new(1, 0),
		Position = phone and UDim2.new(0.5, 0, 0, 41) or UDim2.new(1, 0, 0, 76),
		Size = UDim2.fromOffset(phone and 110 or 170, phone and 4 or 6),
		BackgroundColor3 = Color3.fromRGB(20, 20, 25),
		BackgroundTransparency = 0.3,
		Parent = panel,
	}, { UI.corner(3) })
	refs.AmmoFill = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(255, 210, 80),
		Parent = ammoBar,
	}, { UI.corner(3) })
	refs.AmmoBar = ammoBar
	refs.ReloadHint = UI.label({
		Position = phone and UDim2.fromOffset(0, -14) or UDim2.fromOffset(0, 85),
		Size = UDim2.new(1, 0, 0, phone and 14 or 18),
		Text = "",
		TextSize = phone and 13 or 16,
		TextColor3 = Color3.fromRGB(255, 210, 80),
		TextXAlignment = align,
		Parent = panel,
	})

	-- Ranuras de armas (derecha) con icono 3D del arma
	-- (en el teléfono no se ven: ahí están los botones táctiles; se cambia de arma con ⇄)
	local slots = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -20, 0.6, 0),
		Size = UDim2.fromOffset(230, 196),
		BackgroundTransparency = 1,
		Visible = not phone,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			Padding = UDim.new(0, 6),
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	refs.Slots = {}
	for slot = 1, 3 do
		local row = UI.new("Frame", {
			LayoutOrder = slot,
			Size = UDim2.fromOffset(230, 60),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.7,
			Parent = slots,
		}, { UI.corner(10) })
		local stroke = UI.stroke(Color3.fromRGB(255, 200, 60), 2, 1)
		stroke.Parent = row
		local icon = UI.new("Frame", {
			Position = UDim2.fromOffset(6, 2),
			Size = UDim2.fromOffset(170, 44),
			BackgroundTransparency = 1,
			Parent = row,
		})
		local name = UI.label({
			Position = UDim2.fromOffset(10, 42),
			Size = UDim2.fromOffset(170, 16),
			Text = "",
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		local key = UI.new("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.fromOffset(30, 30),
			BackgroundColor3 = Color3.fromRGB(20, 20, 25),
			Parent = row,
		}, { UI.corner(6), UI.stroke(Color3.new(0, 0, 0), 2, 0) })
		UI.label({ Size = UDim2.fromScale(1, 1), Text = tostring(slot), TextSize = 18, Parent = key })
		refs.Slots[slot] = { Name = name, Key = key, Row = row, Stroke = stroke, Icon = icon, IconKey = nil }
	end

	-- Controles (estilo de la captura)
	if not UserInputService.TouchEnabled or UserInputService.KeyboardEnabled then
		-- (compacta para no pisar las ranuras de armas; solo para jugadores nuevos, ver updateData)
		local hints = UI.new("Frame", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -20, 0.42, 0), -- (debajo del registro de bajas)
			Size = UDim2.fromOffset(220, 228),
			BackgroundTransparency = 1,
			Parent = gui,
		}, {
			UI.new("UIListLayout", {
				Padding = UDim.new(0, 1),
				HorizontalAlignment = Enum.HorizontalAlignment.Right,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		for i, pair in {
			{ "Menú y tienda", "B" },
			{ "Granada", "G" },
			{ "Ataque aéreo (racha 5)", "T" },
			{ "Agacharse / deslizar", "C" },
			{ "Cuchillo rápido", "F" },
			{ "Recargar", "R" },
			{ "Inspeccionar", "V" },
			{ "Habilidades", "E Z X" },
			{ "Emotes", "N" },
			{ "Grafiti", "J" },
			{ "Marcador", "Tab" },
			{ "Regalo", "H" },
		} do
			local row = UI.new("Frame", {
				LayoutOrder = i,
				Size = UDim2.fromOffset(220, 18),
				BackgroundTransparency = 1,
				Parent = hints,
			})
			UI.label({
				Size = UDim2.new(1, -56, 1, 0),
				Text = pair[1],
				TextSize = 15,
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = row,
			})
			local key = UI.new("Frame", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(46, 17),
				BackgroundColor3 = Color3.fromRGB(20, 20, 25),
				Parent = row,
			}, { UI.corner(5) })
			UI.label({ Size = UDim2.fromScale(1, 1), Text = pair[2], TextSize = 14, Parent = key })
		end
		refs.KeyHints = hints
	end
end

local function buildPlayerPanel()
	-- Vida (abajo a la izquierda)
	-- (en el teléfono, abajo en el centro, bajo las habilidades: a la izquierda está el joystick)
	local health = UI.new("Frame", {
		AnchorPoint = phone and Vector2.new(0.5, 1) or Vector2.new(0, 1),
		Position = phone and UDim2.new(0.5, 10, 1, -14) or UDim2.new(0, 56, 1, -24),
		Size = phone and UDim2.fromOffset(190, 18) or UDim2.fromOffset(250, 26),
		BackgroundColor3 = Color3.fromRGB(20, 20, 25),
		Parent = gui,
	}, { UI.corner(13), UI.stroke(Color3.new(0, 0, 0), 3, 0) })
	refs.HealthChip = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.25,
		Parent = health,
	}, { UI.corner(13) })
	refs.HealthFill = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(70, 220, 90),
		Parent = health,
	}, { UI.corner(13), UI.gloss() })
	refs.HealthText = UI.label({ Size = UDim2.fromScale(1, 1), Text = "100", TextSize = phone and 14 or 18, Parent = health })
	UI.label({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(0, -6, 0.5, 0),
		Size = UDim2.fromOffset(phone and 20 or 28, phone and 20 or 28),
		Text = "✚",
		TextSize = phone and 20 or 28,
		TextColor3 = Color3.fromRGB(90, 230, 110),
		TextStrokeTransparency = 0,
		Parent = health,
	})

	-- Racha (barra vertical a la izquierda, como en la captura)
	local streakBar = UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 40, 0.55, 0),
		Size = UDim2.fromOffset(10, 240),
		BackgroundColor3 = Color3.fromRGB(30, 30, 35),
		Parent = gui,
	}, { UI.corner(5), UI.stroke(Color3.new(0, 0, 0), 2, 0.3) })
	refs.StreakFill = UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0),
		BackgroundColor3 = Color3.fromRGB(255, 180, 30),
		Parent = streakBar,
	}, { UI.corner(5) })
	-- Móvil (pantalla baja): sin la barra vertical (pisaría la tienda, el regalo y el contador del
	-- evento) y el texto de la racha encima de la barra de vida
	local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	streakBar.Visible = not touchOnly
	refs.StreakText = UI.label({
		AnchorPoint = phone and Vector2.new(0.5, 1) or Vector2.new(0, touchOnly and 1 or 0),
		-- (teléfono: entre las habilidades y la vida, centrado)
		Position = phone and UDim2.new(0.5, 0, 1, -34) or (touchOnly and UDim2.new(0, 56, 1, -54) or UDim2.new(0, 14, 0.55, 126)),
		Size = UDim2.fromOffset(200, phone and 16 or 22),
		Text = "Racha x0",
		TextSize = phone and 14 or 18,
		TextXAlignment = phone and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(255, 210, 80),
		Parent = gui,
	})
	refs.StreakScale = UI.new("UIScale", { Parent = refs.StreakText })

	-- Nivel / XP (abajo al centro)
	-- (teléfono: una línea fina abajo del todo, sin el texto del nivel, que ya sale en el menú)
	local level = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = phone and UDim2.new(0.5, 0, 1, -3) or UDim2.new(0.5, 0, 1, -10),
		Size = phone and UDim2.fromOffset(230, 5) or UDim2.fromOffset(320, 10),
		BackgroundColor3 = Color3.fromRGB(20, 20, 25),
		Parent = gui,
	}, { UI.corner(5) })
	refs.XPFill = UI.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.fromRGB(80, 170, 255),
		Parent = level,
	}, { UI.corner(5) })
	refs.XPScale = UI.new("UIScale", { Parent = level })
	refs.LevelText = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, -2),
		Size = UDim2.fromOffset(520, 18),
		Text = "Nivel 1",
		TextSize = 15,
		Visible = not phone,
		Parent = level,
	})
end

local function buildFeedsAndOverlays()
	refs.KillFeed = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		-- (teléfono: más pequeño y a la izquierda del botón del marcador)
		Position = phone and UDim2.new(1, -80, 0, 54) or UDim2.new(1, -16, 0, 60),
		Size = UDim2.fromOffset(380, 220),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			Padding = UDim.new(0, 4),
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	if phone then
		UI.new("UIScale", { Scale = 0.6, Parent = refs.KillFeed })
	end

	-- (teléfono: a la izquierda de la mira, por debajo; en el centro están la munición y las habilidades)
	refs.Popups = UI.new("Frame", {
		AnchorPoint = phone and Vector2.new(1, 0) or Vector2.new(0.5, 0),
		Position = phone and UDim2.new(0.5, -90, 0.5, 24) or UDim2.new(0.5, 0, 0.58, 0),
		Size = UDim2.fromOffset(phone and 260 or 400, 140),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			Padding = UDim.new(0, 2),
			HorizontalAlignment = phone and Enum.HorizontalAlignment.Right or Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	-- (ancho relativo y texto que se encoge: los avisos largos caben en el móvil)
	refs.BigText = UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, phone and 0.2 or 0.3),
		Size = UDim2.new(0.92, 0, 0, phone and 48 or 70),
		Text = "",
		TextSize = 54,
		TextScaled = true,
		TextStrokeTransparency = 0,
		Visible = false,
		Parent = gui,
	})
	refs.BigFit = UI.new("UITextSizeConstraint", { MaxTextSize = 54, Parent = refs.BigText })

	refs.Banner = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 135),
		Size = UDim2.fromOffset(600, 30),
		Text = "",
		TextSize = 24,
		TextColor3 = Color3.fromRGB(255, 200, 60),
		Visible = false,
		Parent = gui,
	})

	-- (teléfono: arriba, encima del aviso de baja; abajo estaba sobre la mira y la munición)
	refs.CarrierBanner = UI.label({
		AnchorPoint = phone and Vector2.new(0.5, 0) or Vector2.new(0.5, 1),
		Position = phone and UDim2.new(0.5, 0, 0, 82) or UDim2.new(0.5, 0, 1, -158),
		Size = phone and UDim2.new(0.55, 0, 0, 22) or UDim2.fromOffset(700, 34),
		TextScaled = phone,
		Text = "🚩 ¡TIENES LA BANDERA! Llévala a tu base",
		TextSize = 28,
		TextColor3 = Color3.fromRGB(255, 220, 70),
		TextStrokeTransparency = 0,
		Visible = false,
		Parent = gui,
	})

	-- (teléfono: a la izquierda, bajo los avisos de XP; en el centro de abajo está la munición)
	refs.Toast = UI.label({
		AnchorPoint = phone and Vector2.new(1, 0) or Vector2.new(0.5, 1),
		Position = phone and UDim2.new(0.5, -90, 0.5, 70) or UDim2.new(0.5, 0, 1, -122),
		Size = phone and UDim2.fromOffset(300, 20) or UDim2.fromOffset(600, 30),
		Text = "",
		TextSize = 22,
		TextScaled = phone,
		TextXAlignment = phone and Enum.TextXAlignment.Right or Enum.TextXAlignment.Center,
		Visible = false,
		Parent = gui,
	})
	if phone then
		UI.new("UITextSizeConstraint", { MaxTextSize = 16, Parent = refs.Toast })
	end

	-- Viñeta roja de daño
	refs.Damage = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -120, 1, -120),
		BackgroundTransparency = 1,
		ZIndex = 0,
		Parent = gui,
	}, { UI.new("UICorner", { CornerRadius = UDim.new(0, 60) }) })
	refs.DamageStroke = UI.new("UIStroke", {
		Thickness = 90,
		Color = Color3.fromRGB(200, 0, 0),
		Transparency = 1,
		Parent = refs.Damage,
	})

	-- Quién te eliminó (arriba); los botones y la cámara de espectador están en DeathScreen
	refs.DeathScreen = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	refs.DeathText = UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.17),
		Size = UDim2.fromOffset(800, 60),
		Text = "",
		TextSize = 40,
		TextColor3 = Color3.fromRGB(255, 80, 80),
		RichText = true,
		Parent = refs.DeathScreen,
	})
	refs.RespawnText = UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.53),
		Size = UDim2.fromOffset(600, 30),
		Text = "",
		Visible = false,
		TextSize = 22,
		Parent = refs.DeathScreen,
	})
	refs.DeathIcon = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.27),
		Size = UDim2.fromOffset(220, 86),
		BackgroundTransparency = 1,
		Parent = refs.DeathScreen,
	})

	-- Aviso de baja propia ("ELIMINADO", doble baja...)
	refs.KillBanner = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		-- (en el teléfono, por encima de la mira: abajo están los botones de habilidades)
		Position = UDim2.fromScale(0.5, phone and 0.33 or 0.7),
		Size = UDim2.fromOffset(440, 64),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	refs.KillScale = UI.new("UIScale", { Scale = killBaseScale, Parent = refs.KillBanner })
	refs.KillIcon = UI.label({
		Size = UDim2.fromOffset(64, 64),
		Text = "💀",
		TextSize = 46,
		Parent = refs.KillBanner,
