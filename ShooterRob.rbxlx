  <Item class="ReplicatedFirst" referent="3">
    <Properties>
      <string name="Name">ReplicatedFirst</string>
    </Properties>
    <Item class="ModuleScript" referent="4">
      <Properties>
        <string name="Name">BootTips</string>
        <string name="Source"><![CDATA[-- Textos de la pantalla de arranque (en ReplicatedFirst: tienen que estar antes que nada). Por idioma:
-- se usa el del jugador si existe y, si no, español. Para añadir uno, copia la tabla "es".
return {
	es = {
		Phases = {
			Interface = "CARGANDO INTERFAZ",
			Weapons = "CARGANDO ARMAS",
			Maps = "CARGANDO MAPAS",
			Match = "PREPARANDO PARTIDA",
			Building = "CONSTRUYENDO %s",
			Ready = "LISTO",
		},
		Tips = {
			"Los disparos a la cabeza hacen mucho más daño",
			"Apuntar (clic derecho) reduce la dispersión: dispara apuntando a media distancia",
			"Cambia de clase antes de desplegar: la última que usaste viene marcada",
			"Los flancos ganan partidas: no corras siempre por el centro",
			"Gana partidas para subir de rango: de Bronce a Campeón",
			"Con 3 bajas seguidas tienes Radar; con 5, Ataque aéreo",
			"Tus amigos juegan en tu equipo y ganáis más XP y monedas",
			"En Buscar y destruir solo hay una vida por ronda: juega con tu equipo",
			"Recarga a cubierto: el enemigo escucha el cargador",
			"Las misiones diarias dan XP y monedas: míralas en el lobby",
		},
	},
	en = {
		Phases = {
			Interface = "LOADING INTERFACE",
			Weapons = "LOADING WEAPONS",
			Maps = "LOADING MAPS",
			Match = "PREPARING MATCH",
			Building = "BUILDING %s",
			Ready = "READY",
		},
		Tips = {
			"Headshots deal much more damage",
			"Aiming (right click) tightens your spread: aim at mid range",
			"Change class before deploying: your last one is preselected",
			"Flanks win matches: don't always run through the middle",
			"Win matches to rank up: from Bronze to Champion",
			"3 kills in a row gives Radar; 5 gives an Airstrike",
			"Friends play on your team and you all earn more XP and coins",
			"Search and Destroy has one life per round: stick with your team",
			"Reload behind cover: enemies hear the magazine",
			"Daily missions give XP and coins: check them in the lobby",
		},
	},
}
]]></string>
      </Properties>
    </Item>
    <Item class="LocalScript" referent="5">
      <Properties>
        <string name="Name">Loading</string>
        <string name="Source"><![CDATA[-- Pantalla de arranque (sustituye a la de Roblox). Vive en ReplicatedFirst para salir lo antes
-- posible, así que no usa los módulos del juego hasta que llegan. El progreso es real, por fases:
--   CARGANDO INTERFAZ   el juego descarga (cola de ContentProvider) y precarga los sonidos de la interfaz
--   CARGANDO ARMAS      módulos compartidos, tus datos (clases, armas) y los sonidos de las armas
--   CARGANDO MAPAS      el mapa existe y no se está construyendo (si se construye, lo dice)
--   PREPARANDO PARTIDA  el lobby está montado (PlayerGui.MainMenu con el atributo Ready)
-- Sin esperas inventadas: en cuanto todo está, se va con un fundido corto. Detrás, cuando el mapa
-- existe, se ve desenfocado; delante, unas partículas sutiles, el logo y un consejo.
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ContentProvider = game:GetService("ContentProvider")
local Lighting = game:GetService("Lighting")
local LocalizationService = game:GetService("LocalizationService")

local TITLE = "SHOOTER NEW" -- (el mismo que GameConfig.GameTitle)
local LIMITS = { Loaded = 30, Data = 12, Map = 25, Lobby = 15 } -- (máximo por fase si algo falla)

local player = Players.LocalPlayer
pcall(function()
	ReplicatedFirst:RemoveDefaultLoadingScreen()
end)

-- Textos en el idioma del jugador (español si no hay)
local strings = require(script.Parent:WaitForChild("BootTips"))
local lang = "es"
pcall(function()
	local locale = string.lower(LocalizationService.RobloxLocaleId or "")
	local code = string.sub(locale, 1, 2)
	if strings[code] then
		lang = code
	end
end)
local TEXT = strings[lang] or strings.es

local YELLOW = Color3.fromRGB(255, 198, 26)
local BG = Color3.fromRGB(10, 11, 14)
local function font(weight, style)
	local ok, f = pcall(function()
		return Font.new("rbxasset://fonts/families/Oswald.json", weight, style or Enum.FontStyle.Normal)
	end)
	return ok and f or nil
end
local TITLE_FONT = font(Enum.FontWeight.Bold, Enum.FontStyle.Italic)
local LABEL_FONT = font(Enum.FontWeight.SemiBold)

local function new(className, props, children)
	local inst = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	inst.Parent = props.Parent
	return inst
end
local function label(props)
	local l = new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextColor3 = props.Color or Color3.new(1, 1, 1),
		TextSize = props.TextSize or 16,
		Text = props.Text or "",
		TextXAlignment = props.AlignX or Enum.TextXAlignment.Left,
		RichText = props.Rich == true,
		AnchorPoint = props.Anchor or Vector2.new(),
		Position = props.Position,
		Size = props.Size,
		ZIndex = props.ZIndex or 3,
		Parent = props.Parent,
	})
	if props.FontFace then
		l.FontFace = props.FontFace
	end
	return l
end

local gui = new("ScreenGui", { Name = "Loading", IgnoreGuiInset = true, ResetOnSpawn = false, DisplayOrder = 100 })
local background = new("Frame", { Name = "Background", Size = UDim2.fromScale(1, 1), BackgroundColor3 = BG, BorderSizePixel = 0, Parent = gui }, {
	new("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.fromRGB(26, 28, 34), Color3.fromRGB(6, 7, 9)),
	}),
})
-- Viñeta (bordes más oscuros) por encima del fondo: se queda aunque el fondo se aclare
new("Frame", { Name = "Vignette", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 1, Parent = gui }, {
	new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(0.3, 0.9),
			NumberSequenceKeypoint.new(0.7, 0.9),
			NumberSequenceKeypoint.new(1, 0.2),
		}),
	}),
})

-- Contenido (logo, partículas, progreso)
local content = new("Frame", { Name = "Content", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = gui })

-- Partículas: motas pequeñas que suben despacio (pocas, sin texturas)
local motes = {}
for i = 1, 18 do
	local size = math.random(2, 4)
	local mote = new("Frame", {
		Name = "Mote",
		BorderSizePixel = 0,
		BackgroundColor3 = i % 4 == 0 and YELLOW or Color3.new(1, 1, 1),
		BackgroundTransparency = 0.55 + math.random() * 0.35,
		Size = UDim2.fromOffset(size, size),
		Position = UDim2.fromScale(math.random(), math.random()),
		ZIndex = 2,
		Parent = content,
	})
	motes[i] = { Frame = mote, X = math.random(), Y = math.random(), Speed = 0.012 + math.random() * 0.025, Sway = math.random() * 6 }
end

-- Logo
local logo = new("Frame", { Name = "Logo", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromScale(0.7, 0.22), ZIndex = 3, Parent = content })
local first, rest = string.match(TITLE, "^(%S+)%s*(.*)$")
local title = label({
	Text = string.format('%s <font color="#FFC61A">%s</font>', first or TITLE, rest or ""),
	Rich = true,
	FontFace = TITLE_FONT,
	AlignX = Enum.TextXAlignment.Center,
	Anchor = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.45),
	Size = UDim2.fromScale(1, 0.8),
	Parent = logo,
})
title.TextScaled = true
new("UIStroke", { Thickness = 2, Color = Color3.new(0, 0, 0), Transparency = 0.4, Parent = title })
local underline = new("Frame", { BackgroundColor3 = YELLOW, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.92), Size = UDim2.new(0, 0, 0, 4), ZIndex = 3, Parent = logo })
local tag = label({ Text = "5 V 5  ·  TACTICAL", FontFace = LABEL_FONT, TextSize = 16, Color = Color3.fromRGB(160, 166, 178), AlignX = Enum.TextXAlignment.Center, Anchor = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 10), Size = UDim2.new(1, 0, 0, 20), Parent = logo })

-- Progreso
local bottom = new("Frame", { Name = "Progress", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -64), Size = UDim2.new(0.62, 0, 0, 60), ZIndex = 3, Parent = content })
local phaseLabel = label({ Text = TEXT.Phases.Interface, FontFace = LABEL_FONT, TextSize = 18, Position = UDim2.fromOffset(0, 0), Size = UDim2.new(0.75, 0, 0, 24), Parent = bottom })
local percentLabel = label({ Text = "0%", FontFace = LABEL_FONT, TextSize = 18, Color = YELLOW, AlignX = Enum.TextXAlignment.Right, Anchor = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0.25, 0, 0, 24), Parent = bottom })
local track = new("Frame", { BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 0.88, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 4), ZIndex = 3, Parent = bottom })
local fill = new("Frame", { BackgroundColor3 = YELLOW, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), ZIndex = 4, Parent = track })
-- Brillo en la punta de la barra
new("Frame", { BackgroundColor3 = Color3.fromRGB(255, 240, 170), BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.new(0, 14, 2.4, 0), ZIndex = 5, Parent = fill }, {
	new("UIGradient", { Transparency = NumberSequence.new(1, 0) }),
})
local tipLabel = label({ Text = "", TextSize = 15, Color = Color3.fromRGB(200, 204, 214), AlignX = Enum.TextXAlignment.Center, Anchor = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 44), Size = UDim2.new(1, 0, 0, 20), Parent = bottom })
tipLabel.TextWrapped = true

-- Tamaños según la pantalla (móvil: todo un poco más grande en proporción)
local function fit()
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
	local scale = math.clamp(viewport.Y / 720, 0.5, 2)
	local phone = math.min(viewport.X, viewport.Y) < 500
	bottom.Size = UDim2.new(phone and 0.86 or 0.62, 0, 0, 60 * scale)
	bottom.Position = UDim2.new(0.5, 0, 1, -(phone and 30 or 64) * scale)
	logo.Size = UDim2.fromScale(phone and 0.86 or 0.7, phone and 0.26 or 0.22)
	for _, l in { phaseLabel, percentLabel } do
		l.TextSize = math.floor(18 * scale)
	end
	tipLabel.TextSize = math.floor(15 * scale)
	tag.TextSize = math.floor(16 * scale)
end
fit()
if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
end

gui.Parent = player:WaitForChild("PlayerGui")

-- Consejos (uno cada pocos segundos, sin repetir el anterior)
local tipIndex = math.random(1, #TEXT.Tips)
local function showTip()
	tipLabel.Text = '<font color="#FFC61A">' .. (lang == "es" and "CONSEJO" or "TIP") .. "</font>   " .. TEXT.Tips[tipIndex]
	tipLabel.RichText = true
end
showTip()

-- Animación: logo, partículas, barra suave hacia el progreso real
local shown = 0 -- (lo que se dibuja; persigue a "progress")
local progress = 0
local alive = true
TweenService:Create(underline, TweenInfo.new(0.6, Enum.EasingStyle.Quint), { Size = UDim2.new(0.34, 0, 0, 4) }):Play()
local animation = RunService.RenderStepped:Connect(function(dt)
	shown += (progress - shown) * math.min(1, dt * 8)
	fill.Size = UDim2.fromScale(math.clamp(shown, 0, 1), 1)
	percentLabel.Text = string.format("%d%%", math.floor(math.clamp(shown, 0, 1) * 100 + 0.5))
	local t = os.clock()
	for _, m in motes do
		m.Y -= m.Speed * dt
		if m.Y < -0.02 then
			m.Y, m.X = 1.02, math.random()
		end
		m.Frame.Position = UDim2.new(m.X, math.sin(t * 0.6 + m.Sway) * 8, m.Y, 0)
	end
end)
task.spawn(function()
	while alive do
		task.wait(4.5)
		tipIndex = tipIndex % #TEXT.Tips + 1
		showTip()
	end
end)

-- Fases: cada una ocupa un tramo de la barra; dentro, avanza con lo que de verdad ha terminado
local function setPhase(text)
	phaseLabel.Text = text
end
local function segment(from, to, fraction)
	progress = math.max(progress, from + (to - from) * math.clamp(fraction, 0, 1))
end
local function preload(list, from, to)
	if #list == 0 then
		segment(from, to, 1)
		return
	end
	local done = 0
	pcall(function()
		ContentProvider:PreloadAsync(list, function()
			done += 1
			segment(from, to, done / #list)
		end)
	end)
	segment(from, to, 1)
end
local function soundIds(defs)
	local ids, seen = {}, {}
	for _, def in defs or {} do
		if type(def) == "table" and type(def.Id) == "string" and not seen[def.Id] then
			seen[def.Id] = true
			table.insert(ids, def.Id)
		end
	end
	return ids
end
-- Espera a que se cumpla algo (con un máximo); tick(fracciónDelTiempo) por si hay algo que mostrar
local function waitFor(condition, limit, tick)
	local started = os.clock()
	while not condition() and os.clock() - started < limit do
		if tick then
			tick((os.clock() - started) / limit)
		end
		task.wait(0.05)
	end
end

-- 1. Interfaz: descarga del juego y sonidos de la interfaz
setPhase(TEXT.Phases.Interface)
local queueStart = math.max(1, ContentProvider.RequestQueueSize)
waitFor(function()
	return game:IsLoaded()
end, LIMITS.Loaded, function()
	segment(0, 0.22, 1 - ContentProvider.RequestQueueSize / queueStart)
end)
local modules
pcall(function()
	local scripts = player:WaitForChild("PlayerScripts", 5)
	local client = scripts and scripts:WaitForChild("Client", 5)
	modules = client and client:WaitForChild("Modules", 5)
end)
local uiSounds = {}
pcall(function()
	local flow = modules and modules:WaitForChild("Flow", 3)
	local module = flow and flow:WaitForChild("UISound", 3)
	uiSounds = module and require(module).Defs or {}
end)
preload(soundIds(uiSounds), 0.22, 0.32)

-- 2. Armas: módulos compartidos, tus datos y los sonidos de las armas
setPhase(TEXT.Phases.Weapons)
local shared = ReplicatedStorage:WaitForChild("Shared", LIMITS.Data)
segment(0.32, 0.5, 0.25)
local clientState
pcall(function()
	local module = modules and modules:WaitForChild("ClientState", 3)
	clientState = module and require(module)
end)
waitFor(function()
	return clientState == nil or clientState.Data ~= nil
end, LIMITS.Data, function(f)
	segment(0.32, 0.5, 0.25 + f * 0.5)
end)
segment(0.32, 0.5, 1)
local weaponSounds = {}
pcall(function()
	local module = shared and shared:WaitForChild("Sounds", 3)
	weaponSounds = module and require(module) or {}
end)
preload(soundIds(weaponSounds), 0.5, 0.6)

-- 3. Mapas: el mapa existe (si el servidor lo está construyendo, se dice cuál)
setPhase(TEXT.Phases.Maps)
local blur
local function mapReady()
	local map = workspace:FindFirstChild("Map")
	return map ~= nil and ReplicatedStorage:GetAttribute("LoadingMap") == nil
end
waitFor(mapReady, LIMITS.Map, function(f)
	local building = ReplicatedStorage:GetAttribute("LoadingMap")
	if building then
		setPhase(string.format(TEXT.Phases.Building, string.upper(tostring(building))))
	end
	segment(0.6, 0.8, f)
end)
segment(0.6, 0.8, 1)
-- Con el mapa ya hecho se ve detrás, desenfocado (el lobby seguirá con el mismo desenfoque)
if mapReady() then
	blur = Lighting:FindFirstChild("FlowBlur") or new("BlurEffect", { Name = "FlowBlur", Size = 0, Parent = Lighting })
	TweenService:Create(blur, TweenInfo.new(0.5), { Size = 18 }):Play()
	TweenService:Create(background, TweenInfo.new(0.5), { BackgroundTransparency = 0.3 }):Play()
end

-- 4. Partida: el lobby (la interfaz nueva) está montado
setPhase(TEXT.Phases.Match)
local playerGui = player:WaitForChild("PlayerGui")
-- (mientras tanto, el lobby no se ve por detrás de la pantalla de arranque)
local hidden = {}
local function hideLobby()
	for _, name in { "MainMenu", "FlowBackdrop" } do
		local other = playerGui:FindFirstChild(name)
		if other and other:IsA("ScreenGui") and not hidden[other] then
			hidden[other] = other.Enabled
			other.Enabled = false
		end
	end
end
waitFor(function()
	hideLobby()
	local menu = playerGui:FindFirstChild("MainMenu")
	return menu ~= nil and menu:GetAttribute("Ready") == true
end, LIMITS.Lobby, function(f)
	segment(0.8, 1, f * 0.8)
end)
hideLobby()
progress = 1
setPhase(TEXT.Phases.Ready)

-- Fuera: fundido corto y el lobby aparece
task.wait(0.15)
for other, enabled in hidden do
	if other.Parent then
		-- (el lobby decide qué se ve: si ya no está en el menú, que siga oculto)
		other.Enabled = enabled
	end
end
local fade = TweenInfo.new(0.4, Enum.EasingStyle.Quad)
TweenService:Create(background, fade, { BackgroundTransparency = 1 }):Play()
for _, d in gui:GetDescendants() do
	if d:IsA("TextLabel") then
		TweenService:Create(d, fade, { TextTransparency = 1 }):Play()
	elseif d:IsA("UIStroke") then
		TweenService:Create(d, fade, { Transparency = 1 }):Play()
	elseif d:IsA("Frame") and d ~= background then
		TweenService:Create(d, fade, { BackgroundTransparency = 1 }):Play()
	end
end
task.wait(0.42)
alive = false
animation:Disconnect()
gui:Destroy()
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ReplicatedStorage" referent="6">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="7">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Challenges</string>
          <string name="Source"><![CDATA[-- Retos diarios: cada jugador recibe 3 al día (distintos para cada uno). Se completan solos al jugar
-- y dan monedas + XP al momento. Completar los 3 regala una caja. Se puede cambiar 1 reto al día.
-- Retos semanales (WeeklyPool): 3 más largos por semana (de lunes a domingo, hora UTC) con premios
-- grandes; completar los 3 regala WeeklyBonusCrates cajas.
--
-- Stat: "Kill" (con Weapons opcional para limitar a ciertas armas), "Headshot", "Win", "Match",
-- "Capture", "ZoneTime" (segundos en la zona), "Streak" (mejor racha, no se suma), "Survive" (ganar una
-- Infección como superviviente), "Pumpkin" (recoger una calabaza enemiga en el modo Calabazas).
local Challenges = {}

Challenges.PerDay = 3
Challenges.RerollsPerDay = 1
Challenges.BonusCrates = 1 -- por completar todos los del día

Challenges.Pool = {
	{ Id = "Kills", Stat = "Kill", Goal = 15, Text = "Consigue 15 bajas", Coins = 150, XP = 300 },
	{ Id = "Headshots", Stat = "Headshot", Goal = 5, Text = "Haz 5 bajas a la cabeza", Coins = 200, XP = 300 },
	{ Id = "Wins", Stat = "Win", Goal = 2, Text = "Gana 2 partidas", Coins = 250, XP = 400 },
	{ Id = "Matches", Stat = "Match", Goal = 3, Text = "Termina 3 partidas", Coins = 150, XP = 300 },
	{ Id = "Captures", Stat = "Capture", Goal = 2, Text = "Captura 2 banderas", Coins = 250, XP = 400 },
	{ Id = "Zone", Stat = "ZoneTime", Goal = 60, Text = "Controla la zona 60 segundos", Coins = 200, XP = 300 },
	{ Id = "Streak", Stat = "Streak", Goal = 5, Text = "Consigue una racha de 5 bajas", Coins = 300, XP = 400 },
	{ Id = "Rifles", Stat = "Kill", Weapons = { "ARX27", "VortexBR", "TitanLMG", "SplatX" }, Goal = 12, Text = "12 bajas con fusil, ametralladora o paintball", Coins = 200, XP = 300 },
	{ Id = "SMGs", Stat = "Kill", Weapons = { "Specter9", "NovaDrift" }, Goal = 10, Text = "10 bajas con subfusil", Coins = 200, XP = 300 },
	{ Id = "Shotguns", Stat = "Kill", Weapons = { "HavocPump", "BreachHammer" }, Goal = 6, Text = "6 bajas con escopeta", Coins = 200, XP = 300 },
	{ Id = "Snipers", Stat = "Kill", Weapons = { "Signal7", "GhostlineXR", "RaptorDMR" }, Goal = 4, Text = "4 bajas con francotirador o DMR", Coins = 250, XP = 350, MinLevel = 3 },
	{ Id = "Pistols", Stat = "Kill", Weapons = { "Viper", "HandCannon", "PhantomSidewind" }, Goal = 4, Text = "4 bajas con pistola", Coins = 200, XP = 300 },
	{ Id = "Knife", Stat = "Kill", Weapons = { "Knife", "ToyHammer", "Katana", "Scythe" }, Goal = 2, Text = "2 bajas cuerpo a cuerpo", Coins = 300, XP = 400 },
	{ Id = "Grenades", Stat = "Kill", Weapons = { "Grenade" }, Goal = 3, Text = "3 bajas con granada", Coins = 250, XP = 350 },
	{ Id = "Rockets", Stat = "Kill", Weapons = { "NovaLauncher", "Calabazooka" }, Goal = 3, Text = "3 bajas con lanzacohetes", Coins = 250, XP = 350, MinLevel = 14 },
	-- Modo Infección (Halloween)
	{ Id = "Infect", Stat = "Kill", Weapons = { "Claws" }, Goal = 3, Text = "Infecta a 3 supervivientes (Infección)", Coins = 250, XP = 350 },
	{ Id = "Survive", Stat = "Survive", Goal = 1, Text = "Sobrevive hasta el final de una Infección", Coins = 300, XP = 400 },
	{ Id = "Pumpkins", Stat = "Pumpkin", Goal = 8, Text = "Recoge 8 calabazas enemigas (modo Calabazas)", Coins = 250, XP = 350 },
}

Challenges.WeeklyCount = 3
Challenges.WeeklyBonusCrates = 2
Challenges.WeeklyPool = {
	{ Id = "W_Kills", Stat = "Kill", Goal = 100, Text = "Consigue 100 bajas", Coins = 800, XP = 1500 },
	{ Id = "W_Wins", Stat = "Win", Goal = 10, Text = "Gana 10 partidas", Coins = 1000, XP = 2000 },
	{ Id = "W_Headshots", Stat = "Headshot", Goal = 30, Text = "Haz 30 bajas a la cabeza", Coins = 900, XP = 1500 },
	{ Id = "W_Matches", Stat = "Match", Goal = 15, Text = "Termina 15 partidas", Coins = 700, XP = 1500 },
	{ Id = "W_Captures", Stat = "Capture", Goal = 8, Text = "Captura 8 banderas", Coins = 900, XP = 1500 },
	{ Id = "W_Zone", Stat = "ZoneTime", Goal = 400, Text = "Controla la zona 400 segundos", Coins = 800, XP = 1500 },
	{ Id = "W_Streak", Stat = "Streak", Goal = 10, Text = "Consigue una racha de 10 bajas", Coins = 1000, XP = 2000 },
	{ Id = "W_Melee", Stat = "Kill", Weapons = { "Knife", "ToyHammer", "Katana", "Scythe" }, Goal = 10, Text = "10 bajas cuerpo a cuerpo", Coins = 900, XP = 1500 },
	{ Id = "W_Snipers", Stat = "Kill", Weapons = { "Signal7", "GhostlineXR", "RaptorDMR" }, Goal = 25, Text = "25 bajas con francotirador o DMR", Coins = 900, XP = 1500, MinLevel = 3 },
	{ Id = "W_Grenades", Stat = "Kill", Weapons = { "Grenade" }, Goal = 12, Text = "12 bajas con granada", Coins = 900, XP = 1500 },
	{ Id = "W_Featured", Stat = "FeaturedWin", Goal = 3, Text = "Gana 3 partidas en el mapa del día ⭐", Coins = 900, XP = 1800 },
}

local byId = {}
for _, c in Challenges.Pool do
	byId[c.Id] = c
end
for _, c in Challenges.WeeklyPool do
	byId[c.Id] = c
end

-- Semana (empieza el lunes a las 00:00 UTC) de un número de día (Shop.DayNumber) y cuándo acaba
function Challenges.WeekNumber(day)
	return (day + 3) // 7
end
function Challenges.WeekEndsAt(week)
	return ((week + 1) * 7 - 3) * 86400
end

function Challenges.Get(id)
	return byId[id]
end

-- ¿Cuenta este evento para el reto?
function Challenges.Matches(challenge, stat, weaponName)
	if challenge.Stat ~= stat then
		return false
	end
	if challenge.Weapons then
		return weaponName ~= nil and table.find(challenge.Weapons, weaponName) ~= nil
	end
	return true
end

-- Elige `count` retos distintos (sin repetir los de `exclude`). Determinista por día y jugador.
-- `source` es la lista de la que se eligen (por defecto los diarios).
function Challenges.Pick(day, userId, level, count, exclude, salt, source)
	local rng = Random.new(day * 7919 + userId * 31 + (salt or 0))
	local pool = {}
	for _, c in source or Challenges.Pool do
		if (c.MinLevel or 1) <= (level or 1) and not (exclude and exclude[c.Id]) then
			table.insert(pool, c.Id)
		end
	end
	local picked = {}
	for _ = 1, math.min(count, #pool) do
		local i = rng:NextInteger(1, #pool)
		table.insert(picked, table.remove(pool, i))
	end
	return picked
end

return Challenges
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Charms</string>
          <string name="Source"><![CDATA[-- Colgantes para el arma: un adorno pequeño que cuelga del lateral del arma y se balancea al
-- moverte (se ve en primera persona y en las armas de los demás). Se compran con monedas en la
-- pestaña Skins y valen para todas las armas de fuego (no para las de cuerpo a cuerpo).
local Charms = {}

local V = Vector3.new
local RGB = Color3.fromRGB

-- Piezas: { Name, Size, Offset (desde el punto del que cuelga), Color, Material, Shape }
local function part(name, size, offset, color, material, shape)
	return { Name = name, Size = size, Offset = offset, Color = color, Material = material or Enum.Material.SmoothPlastic, Shape = shape }
end

Charms.List = {
	Default = { Name = "Sin colgante", Rarity = "Común", Icon = "➖" },
	Dado = {
		Name = "Dado",
		Rarity = "Raro",
		Icon = "🎲",
		Price = 300,
		Parts = {
			part("Body", V(0.16, 0.16, 0.16), V(0, -0.2, 0), RGB(245, 245, 250)),
			part("Dot", V(0.04, 0.04, 0.17), V(0, -0.2, 0), RGB(220, 40, 50), nil, "Ball"),
		},
	},
	Corazon = {
		Name = "Corazón",
		Rarity = "Raro",
		Icon = "💖",
		Price = 300,
		Parts = {
			part("LobeL", V(0.11, 0.11, 0.08), V(-0.045, -0.17, 0), RGB(255, 70, 130), nil, "Ball"),
			part("LobeR", V(0.11, 0.11, 0.08), V(0.045, -0.17, 0), RGB(255, 70, 130), nil, "Ball"),
			part("Tip", V(0.1, 0.1, 0.07), V(0, -0.225, 0), RGB(255, 70, 130)),
		},
	},
	Calabaza = {
		Name = "Calabacita",
		Rarity = "Épico",
		Icon = "🎃",
		Price = 500,
		Parts = {
			part("Body", V(0.2, 0.17, 0.2), V(0, -0.21, 0), RGB(255, 130, 20), nil, "Ball"),
			part("Stem", V(0.03, 0.06, 0.03), V(0, -0.11, 0), RGB(80, 140, 50)),
			part("Face", V(0.1, 0.03, 0.01), V(0, -0.22, -0.1), RGB(255, 220, 60), Enum.Material.Neon),
		},
	},
	Estrella = {
		Name = "Estrella",
		Rarity = "Épico",
		Icon = "⭐",
		Price = 500,
		Parts = {
			part("Core", V(0.12, 0.12, 0.05), V(0, -0.2, 0), RGB(255, 210, 50), Enum.Material.Neon),
			part("ArmA", V(0.22, 0.05, 0.04), V(0, -0.2, 0), RGB(255, 210, 50), Enum.Material.Neon),
			part("ArmB", V(0.05, 0.22, 0.04), V(0, -0.2, 0), RGB(255, 210, 50), Enum.Material.Neon),
		},
	},
	Calavera = {
		Name = "Calavera",
		Rarity = "Épico",
		Icon = "💀",
		Price = 700,
		Parts = {
			part("Skull", V(0.17, 0.15, 0.15), V(0, -0.2, 0), RGB(235, 230, 215), nil, "Ball"),
			part("Jaw", V(0.1, 0.05, 0.1), V(0, -0.28, -0.01), RGB(235, 230, 215)),
			part("EyeL", V(0.04, 0.04, 0.02), V(-0.035, -0.19, -0.075), RGB(20, 20, 25)),
			part("EyeR", V(0.04, 0.04, 0.02), V(0.035, -0.19, -0.075), RGB(20, 20, 25)),
		},
	},
	Patito = {
		Name = "Patito de goma",
		Rarity = "Legendario",
		Icon = "🦆",
		Price = 900,
		Parts = {
			part("Body", V(0.18, 0.13, 0.2), V(0, -0.24, 0), RGB(255, 220, 40), nil, "Ball"),
			part("Head", V(0.11, 0.11, 0.11), V(0, -0.15, -0.06), RGB(255, 220, 40), nil, "Ball"),
			part("Beak", V(0.06, 0.03, 0.06), V(0, -0.16, -0.12), RGB(255, 130, 30)),
		},
	},
	Baston = {
		Name = "Bastón de caramelo",
		Rarity = "Épico",
		Icon = "🍭",
		Price = 500,
		Parts = {
			part("Stick1", V(0.05, 0.07, 0.05), V(0, -0.12, 0), RGB(230, 40, 50)),
			part("Stick2", V(0.05, 0.07, 0.05), V(0, -0.19, 0), RGB(250, 250, 250)),
			part("Stick3", V(0.05, 0.07, 0.05), V(0, -0.26, 0), RGB(230, 40, 50)),
			part("Stick4", V(0.05, 0.07, 0.05), V(0, -0.33, 0), RGB(250, 250, 250)),
			part("Hook", V(0.1, 0.05, 0.05), V(0.03, -0.09, 0), RGB(250, 250, 250)),
			part("HookEnd", V(0.05, 0.06, 0.05), V(0.07, -0.13, 0), RGB(230, 40, 50)),
		},
	},
	-- Colgantes premium (Robux: ver Economy/Products)
	Chapa = {
		Name = "Chapa militar",
		Rarity = "Raro",
		Icon = "🏷️",
		Parts = {
			part("Tag", V(0.12, 0.17, 0.02), V(0, -0.2, 0), RGB(200, 205, 215), Enum.Material.Metal),
			part("Hole", V(0.03, 0.03, 0.03), V(0, -0.13, 0), RGB(40, 40, 44)),
		},
	},
	Bala = {
		Name = "Bala dorada",
		Rarity = "Raro",
		Icon = "🔸",
		Parts = {
			part("Case", V(0.07, 0.15, 0.07), V(0, -0.21, 0), RGB(230, 180, 60), Enum.Material.Foil),
			part("Tip", V(0.06, 0.07, 0.06), V(0, -0.11, 0), RGB(200, 120, 60), Enum.Material.Metal, "Ball"),
		},
	},
	Calaverita = {
		Name = "Calavera roja",
		Rarity = "Épico",
		Icon = "☠️",
		Parts = {
			part("Skull", V(0.15, 0.14, 0.13), V(0, -0.2, 0), RGB(230, 40, 50), Enum.Material.Neon, "Ball"),
			part("EyeL", V(0.04, 0.04, 0.02), V(-0.035, -0.19, -0.065), RGB(20, 20, 25)),
			part("EyeR", V(0.04, 0.04, 0.02), V(0.035, -0.19, -0.065), RGB(20, 20, 25)),
		},
	},
	Diamante = {
		Name = "Diamante",
		Rarity = "Legendario",
		Icon = "💎",
		Price = 1200,
		Parts = {
			part("Gem", V(0.15, 0.15, 0.15), V(0, -0.21, 0), RGB(110, 220, 255), Enum.Material.Neon),
			part("Facet", V(0.12, 0.12, 0.12), V(0, -0.21, 0), RGB(200, 245, 255), Enum.Material.Glass),
		},
		Spin = true, -- (las piezas van giradas 45° para parecer un rombo)
	},
}

function Charms.Get(id)
	return Charms.List[id] or Charms.List.Default
end

-- Construye el colgante: cadenita + adorno. Devuelve una tabla de piezas sin anclar ni soldar,
-- colocadas respecto a `hang` (CFrame del punto del que cuelga).
function Charms.Build(id, hang)
	local charm = Charms.List[id]
	if not charm or not charm.Parts then
		return {}
	end
	local parts = {}
	local function make(name, size, cf, color, material, shape)
		local p = Instance.new("Part")
		p.Name = "Charm" .. name
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = material
		if shape == "Ball" then
			p.Shape = Enum.PartType.Ball
		end
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		table.insert(parts, p)
		return p
	end
	-- Anilla y cadena
	make("Ring", V(0.05, 0.05, 0.05), hang, RGB(200, 200, 210), Enum.Material.Metal, "Ball")
	make("Chain", V(0.02, 0.1, 0.02), hang * CFrame.new(0, -0.06, 0), RGB(190, 190, 200), Enum.Material.Metal)
	local spin = charm.Spin and CFrame.Angles(0, math.rad(45), math.rad(45)) or CFrame.identity
	for _, spec in charm.Parts do
		make(spec.Name, spec.Size, hang * CFrame.new(spec.Offset) * spin, spec.Color, spec.Material, spec.Shape)
	end
	return parts
end

return Charms
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="10">
        <Properties>
          <string name="Name">Economy</string>
        </Properties>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">BattlePassConfig</string>
            <string name="Source"><![CDATA[-- Pase de batalla por temporadas: vía GRATIS y vía PREMIUM, 50 niveles. Se sube con XP del pase,
-- que sale de jugar (la XP de cada partida, sin multiplicadores de pago), de las misiones diarias y
-- semanales y de las misiones de temporada. Las recompensas se RECLAMAN en la pantalla del pase
-- (punto rojo solo si hay algo por reclamar de verdad). Todo es estética o monedas: el pase no da
-- cajas (el azar no se puede comprar subiendo niveles) ni nada que dé ventaja.
--
-- Temporada nueva: añade otra entrada a Seasons con fechas que no se pisen. Al cambiar de
-- temporada lo que quedó sin reclamar de la anterior se entrega solo (nadie pierde lo que ganó).
local Shared = script.Parent.Parent
local GameConfig = require(Shared.GameConfig)

local BattlePassConfig = {}

BattlePassConfig.Tiers = 50
BattlePassConfig.XPPerTier = 3000
-- Parte de la XP de cada partida que va al pase. Con 0,5 y 3000 por nivel: jugando mucho (6 partidas
-- al día y todas las misiones) se acaba en unas 3 semanas; jugando poco (2 partidas y una misión), en
-- unos 2 meses. La temporada dura 3: se puede acabar sin jugar cada día. Ver ECONOMY.md.
BattlePassConfig.MatchXPRate = 0.5
-- XP del pase extra por completar misiones (además de la XP que ya dan)
BattlePassConfig.DailyMissionXP = 600
BattlePassConfig.WeeklyMissionXP = 2500

-- Temporada 1 = el pase que ya había (las recompensas por nivel de siempre), ahora con su propia XP.
-- Las cajas de la vía gratis pasan a ser objetos y monedas.
local function seasonOneTiers()
	local replaced = {
		[20] = { Type = "Coins", Amount = 300 },
		[25] = { Type = "Card", Id = "ZonaRoja" },
		[30] = { Type = "Coins", Amount = 400 },
		[35] = { Type = "Pose", Id = "AlCielo" },
		[40] = { Type = "Coins", Amount = 500 },
		[45] = { Type = "MVPIntro", Id = "Giro" },
		[50] = { Type = "Coins", Amount = 1500 },
	}
	local tiers = {}
	for tier = 1, BattlePassConfig.Tiers do
		local old = GameConfig.BattlePass[tier] or {}
		local free = old.Free
		if replaced[tier] or (free and free.Type == "Crate") then
			free = replaced[tier] or { Type = "Coins", Amount = 200 }
		end
		local premium = old.Premium
		if premium and premium.Type == "Crate" then
			premium = { Type = "Coins", Amount = 300 }
		end
		tiers[tier] = { Free = free, Premium = premium }
	end
	return tiers
end

BattlePassConfig.Seasons = {
	{
		Id = "S1",
		Name = "TEMPORADA 1",
		Title = "ZONA ROJA",
		StartsAt = 1790812800, -- 1 oct 2026 00:00 UTC
		EndsAt = 1798761600, -- 1 ene 2027 00:00 UTC
		Premium = { ProductId = 0, Robux = 399 }, -- TODO: SET IN CREATOR DASHBOARD
		-- Quien compró el pase premium antiguo (Game Pass GameConfig.PremiumPassId) lo tiene en esta temporada
		LegacyPremium = true,
		-- Los que ya jugaban empiezan con la XP de su nivel (el pase de antes iba por nivel)
		MigrateFromLevel = true,
		Tiers = seasonOneTiers(),
		Missions = {
			{ Id = "S1Kills", Text = "Consigue 300 bajas", Stat = "Kill", Goal = 300, XP = 5000 },
			{ Id = "S1Wins", Text = "Gana 25 partidas", Stat = "Win", Goal = 25, XP = 5000 },
			{ Id = "S1Heads", Text = "Haz 100 disparos a la cabeza", Stat = "Headshot", Goal = 100, XP = 4000 },
			{ Id = "S1Matches", Text = "Juega 50 partidas", Stat = "Match", Goal = 50, XP = 4000 },
			{ Id = "S1Caps", Text = "Captura 30 objetivos", Stat = "Capture", Goal = 30, XP = 3000 },
			{ Id = "S1Streak", Text = "Consigue una racha de 10 bajas", Stat = "Streak", Goal = 10, XP = 3000 },
		},
	},
}

-- Temporada en curso (nil entre temporadas)
function BattlePassConfig.Current(now)
	now = now or os.time()
	for _, season in BattlePassConfig.Seasons do
		if now >= season.StartsAt and now < season.EndsAt then
			return season
		end
	end
	return nil
end

function BattlePassConfig.Get(id)
	for _, season in BattlePassConfig.Seasons do
		if season.Id == id then
			return season
		end
	end
	return nil
end

-- Nivel alcanzado con esa XP (el 1 desde el principio)
function BattlePassConfig.TierFor(xp)
	return math.clamp(math.floor((tonumber(xp) or 0) / BattlePassConfig.XPPerTier) + 1, 1, BattlePassConfig.Tiers)
end

-- XP total que hace falta para llegar a un nivel
function BattlePassConfig.XPFor(tier)
	return (math.clamp(tier, 1, BattlePassConfig.Tiers) - 1) * BattlePassConfig.XPPerTier
end

function BattlePassConfig.MaxXP()
	return BattlePassConfig.XPFor(BattlePassConfig.Tiers)
end

return BattlePassConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">CosmeticCatalog</string>
            <string name="Source"><![CDATA[-- Catálogo único de cosméticos: una sola forma de preguntar por cualquier objeto (skin de arma,
-- traje, colgante, tarjeta, título, efecto de baja, intro de MVP, pose, grafiti) sin repetir la
-- lógica de cada lista. Las definiciones siguen en sus módulos de siempre (Skins, Outfits,
-- Charms...); aquí se juntan con su precio (monedas en Shop, Robux en Economy/Products), de dónde se
-- consigue, si lo tienes y si lo llevas puesto. Las rarezas son las de siempre y NUNCA cambian
-- estadísticas.
local Shared = script.Parent.Parent
local Skins = require(Shared.Skins)
local Icons = require(Shared.Icons)
local Outfits = require(Shared.Outfits)
local Charms = require(Shared.Charms)
local KillEffects = require(Shared.KillEffects)
local Sprays = require(Shared.Sprays)
local Titles = require(Shared.Titles)
local Poses = require(Shared.Poses)
local PlayerCards = require(Shared.PlayerCards)
local Shop = require(Shared.Shop)
local Products = require(script.Parent.Products)
local BattlePassConfig = require(script.Parent.BattlePassConfig)
local MonetizationConfig = require(script.Parent.MonetizationConfig)

local Catalog = {}

-- Tipo → su lista, dónde se guarda lo que tienes y lo que llevas, y su sección de la tienda
Catalog.Kinds = {
	Skin = { List = Skins.List, Owned = "Skins", Equipped = "EquippedSkin", Default = "Default", Label = "SKIN DE ARMA", Category = "ARMAS", Icon = Icons.Rifle },
	Outfit = { List = Outfits.List, Owned = "Outfits", Equipped = "EquippedOutfit", Default = "Default", Label = "TRAJE DE OPERADOR", Category = "OPERADORES", Icon = Icons.Helmet },
	Charm = { List = Charms.List, Owned = "Charms", Equipped = "EquippedCharm", Default = "Default", Label = "COLGANTE", Category = "CHARMS", Icon = Icons.Keychain },
	Card = { List = PlayerCards.List, Owned = "Cards", Equipped = "EquippedCard", Default = "Default", Label = "TARJETA DE JUGADOR", Category = "CHARMS", Icon = Icons.IdCard },
	Title = { List = Titles.List, Owned = "Titles", Equipped = "EquippedTitle", Default = "Novato", Label = "TÍTULO", Category = "CHARMS", Icon = Icons.Ribbon },
	KillEffect = { List = KillEffects.List, Owned = "KillEffects", Equipped = "EquippedKillEffect", Default = "Default", Label = "EFECTO DE BAJA", Category = "EFECTOS", Icon = Icons.Explosion },
	MVPIntro = { List = Poses.Intros, Owned = "MVPIntros", Equipped = "EquippedMVPIntro", Default = Poses.DefaultIntro, Label = "INTRO DE MVP", Category = "EFECTOS", Icon = Icons.Spotlight },
	Pose = { List = Poses.List, Owned = "Poses", Equipped = "EquippedPose", Default = Poses.Default, Label = "POSE DE VICTORIA", Category = "EMOTES", Icon = Icons.Pose },
	Spray = { List = Sprays.List, Owned = "Sprays", Equipped = "EquippedSpray", Default = "Default", Label = "GRAFITI", Category = "EMOTES", Icon = Icons.Spray },
}
Catalog.KindOrder = { "Skin", "Outfit", "Charm", "Card", "Title", "KillEffect", "MVPIntro", "Pose", "Spray" }

-- Secciones de la tienda
Catalog.Categories = {
	{ Id = "FEATURED", Text = "DESTACADO", Icon = "⭐" },
	{ Id = "ARMAS", Text = "ARMAS", Icon = "🔫", Kinds = { "Skin" } },
	{ Id = "OPERADORES", Text = "OPERADORES", Icon = "🎖", Kinds = { "Outfit" } },
	{ Id = "CHARMS", Text = "CHARMS", Icon = "🔑", Kinds = { "Charm", "Card", "Title" } },
	{ Id = "EFECTOS", Text = "EFECTOS", Icon = "💥", Kinds = { "KillEffect", "MVPIntro" } },
	{ Id = "EMOTES", Text = "POSES", Icon = "🙌", Kinds = { "Pose", "Spray" } },
	{ Id = "BUNDLES", Text = "PACKS", Icon = "📦" },
	{ Id = "PASS", Text = "PASE", Icon = "🎖️" },
	{ Id = "COINS", Text = "MONEDAS", Icon = "💰" },
}

Catalog.RarityOrder = { "Común", "Raro", "Épico", "Legendario", "Mítico" }
Catalog.RarityColors = Skins.RarityColors

function Catalog.RarityRank(rarity)
	return table.find(Catalog.RarityOrder, rarity) or 1
end

-- Legendario o más: presentación algo mejor (escena de compra con desenfoque y giro)
function Catalog.IsPremiumRarity(rarity)
	return Catalog.RarityRank(rarity) >= 4
end

function Catalog.Key(kind, id)
	return tostring(kind) .. ":" .. tostring(id)
end

function Catalog.ParseKey(key)
	if type(key) ~= "string" then
		return nil, nil
	end
	return string.match(key, "^(%w+):(.+)$")
end

function Catalog.Def(kind, id)
	local spec = Catalog.Kinds[kind]
	return spec and type(id) == "string" and spec.List[id] or nil
end

function Catalog.Exists(kind, id)
	return Catalog.Def(kind, id) ~= nil
end

-- Objetos que salen en el pase (de cualquier temporada): no se venden en la tienda
local passItems = {}
for _, season in BattlePassConfig.Seasons do
	for _, tier in season.Tiers do
		for _, reward in { tier.Free, tier.Premium } do
			if reward and reward.Id then
				passItems[Catalog.Key(reward.Type, reward.Id)] = season.Id
			end
		end
	end
end

-- De dónde se consigue: "Robux", "Coins", "Pass", "Event", "Mastery", "Bonus", "Default", "Stat",
-- "VIP" o "None"
function Catalog.Source(kind, id)
	local def = Catalog.Def(kind, id)
	if not def then
		return "None"
	end
	local spec = Catalog.Kinds[kind]
	if id == spec.Default then
		return "Default"
	end
	if Products.Item(kind, id) then
		return "Robux"
	end
	if def.Mastery then
		return "Mastery"
	end
	if def.Event then
		return "Event"
	end
	if def.Bonus then
		return "Bonus"
	end
	if def.VIPOnly then
		return "VIP"
	end
	if Shop.BasePrice(kind, id) then
		return "Coins"
	end
	if def.Stat then
		return "Stat"
	end
	if def.Pass or passItems[Catalog.Key(kind, id)] then
		return "Pass"
	end
	return "None"
end

-- ¿Lo tiene? data = datos del jugador (servidor) o su vista (cliente)
function Catalog.Owns(data, kind, id, isVIP)
	local spec = Catalog.Kinds[kind]
	if not spec or not data or not Catalog.Exists(kind, id) then
		return false
	end
	if kind == "Title" then
		return Titles.Owns(data, id, isVIP)
	end
	if kind == "Spray" and Sprays.List[id].VIPOnly then
		return isVIP == true
	end
	if id == spec.Default then
		return true
	end
	local owned = data[spec.Owned]
	return type(owned) == "table" and owned[id] == true
end

function Catalog.Equipped(data, kind)
	local spec = Catalog.Kinds[kind]
	if not spec or not data then
		return nil
	end
	return data[spec.Equipped] or spec.Default
end

function Catalog.IsEquipped(data, kind, id)
	return Catalog.Equipped(data, kind) == id
end

-- ¿Se puede llevar puesto? (los camuflajes de maestría van por arma, no aquí)
function Catalog.Equippable(kind, id)
	local def = Catalog.Def(kind, id)
	return def ~= nil and not def.Mastery
end

-- Precio en monedas (con la oferta del día si la hay) y precio en Robux (si se vende con Robux)
function Catalog.CoinPrice(kind, id, day)
	if Products.Item(kind, id) then
		return nil, false -- (lo de Robux no se vende con monedas)
	end
	return Shop.GetPrice(kind, id, day)
end

function Catalog.BaseCoinPrice(kind, id)
	if Products.Item(kind, id) then
		return nil
	end
	return Shop.BasePrice(kind, id)
end

function Catalog.Robux(kind, id)
	return Products.Item(kind, id)
end

-- Ficha completa para la tienda y la escena de compra
function Catalog.Item(kind, id, day)
	local def = Catalog.Def(kind, id)
	if not def then
		return nil
	end
	local spec = Catalog.Kinds[kind]
	local coins, onSale = Catalog.CoinPrice(kind, id, day)
	local robux = Products.Item(kind, id)
	return {
		Kind = kind,
		Id = id,
		Key = Catalog.Key(kind, id),
		Name = def.Name or id,
		Rarity = def.Rarity or "Común",
		Icon = def.Icon or spec.Icon,
		Description = def.Description,
		Collection = def.Collection,
		Label = spec.Label,
		Category = spec.Category,
		Coins = coins,
		BaseCoins = Catalog.BaseCoinPrice(kind, id),
		OnSale = onSale,
		Robux = robux and robux.Robux or nil,
		ProductId = robux and robux.ProductId or nil,
		Source = Catalog.Source(kind, id),
	}
end

-- Lo que se vende (con monedas o Robux) de unos tipos, de más a menos raro
function Catalog.StoreItems(kinds, day)
	local list = {}
	for _, kind in kinds or Catalog.KindOrder do
		for id in Catalog.Kinds[kind].List do
			local source = Catalog.Source(kind, id)
			if source == "Coins" or source == "Robux" then
				table.insert(list, Catalog.Item(kind, id, day))
			end
		end
	end
	table.sort(list, function(a, b)
		local ra, rb = Catalog.RarityRank(a.Rarity), Catalog.RarityRank(b.Rarity)
		if ra ~= rb then
			return ra > rb
		end
		if (a.Robux ~= nil) ~= (b.Robux ~= nil) then
			return a.Robux ~= nil
		end
		return a.Key < b.Key
	end)
	return list
end

-- Da un objeto (devuelve true si es nuevo). Solo lo llama el servidor.
function Catalog.Grant(data, kind, id)
	local spec = Catalog.Kinds[kind]
	if not spec or not Catalog.Exists(kind, id) then
		return false
	end
	if Catalog.Owns(data, kind, id) then
		return false
	end
	if type(data[spec.Owned]) ~= "table" then
		data[spec.Owned] = {}
	end
	data[spec.Owned][id] = true
	return true
end

-- Quita un objeto (para deshacer una compra que no se pudo guardar)
function Catalog.Revoke(data, kind, id)
	local spec = Catalog.Kinds[kind]
	if spec and type(data[spec.Owned]) == "table" then
		data[spec.Owned][id] = nil
		if data[spec.Equipped] == id then
			data[spec.Equipped] = spec.Default
		end
	end
end

-- NUEVO: está en la lista de novedades y aún no lo has visto en la tienda
local newSet = {}
for _, key in MonetizationConfig.NewItems do
	newSet[key] = true
end
function Catalog.IsNewItem(key)
	return newSet[key] == true
end
function Catalog.IsNew(data, kind, id)
	local key = Catalog.Key(kind, id)
	if not newSet[key] then
		return false
	end
	local seen = data and data.SeenItems
	return not (type(seen) == "table" and seen[key] == true)
end

-- Monedas que se devuelven por un objeto que ya tenías al comprar un pack con Robux
function Catalog.Compensation(kind, id)
	local coins = Shop.BasePrice(kind, id)
	if coins and not Products.Item(kind, id) then
		return coins
	end
	local robux = Products.Item(kind, id)
	return math.floor((robux and robux.Robux or 0) * MonetizationConfig.Bundles.CoinsPerRobux)
end

-- Lo que vale por separado un pack (precios reales)
function Catalog.BundleValue(bundle)
	return Products.BundleValue(bundle, function(kind, id)
		return Catalog.BaseCoinPrice(kind, id)
	end)
end

-- Qué tienes ya de un pack: { Owned = n, Total = n, Missing = {items}, Compensation = monedas }
function Catalog.BundleStatus(data, bundle, isVIP)
	local status = { Owned = 0, Total = 0, Missing = {}, Compensation = 0 }
	for _, item in Products.BundleItems(bundle) do
		status.Total += 1
		if Catalog.Owns(data, item.Kind, item.Id, isVIP) then
			status.Owned += 1
			status.Compensation += Catalog.Compensation(item.Kind, item.Id)
		else
			table.insert(status.Missing, item)
		end
	end
	return status
end

return Catalog
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">MonetizationConfig</string>
            <string name="Source"><![CDATA[-- Reglas de la monetización (sin pay-to-win). Todo lo que se vende con Robux es estética,
-- colección o presentación: nada cambia daño, vida, retroceso, velocidad ni estadísticas. Un jugador
-- que no paga puede jugarlo todo, progresar y ganar.
--
-- Este módulo solo tiene interruptores y números; los productos con su ProductId y su precio están
-- en Economy/Products, los objetos en Economy/CosmeticCatalog, la rotación en Economy/StoreRotation
-- y el pase en Economy/BattlePassConfig. Ver ECONOMY.md.
local MonetizationConfig = {}

-- La moneda gratis del juego (se gana jugando). No hay otra moneda premium: se paga en Robux.
MonetizationConfig.Currency = { Name = "monedas", Icon = "💰" }

-- Cosas que existían y daban ventaja o azar de pago. Apagadas; los recibos de compras antiguas se
-- siguen entregando (Roblox puede reintentarlos), pero no se vuelven a vender.
MonetizationConfig.Rules = {
	SellRevives = false, -- "Revivir instantáneo" con Robux: volver donde caíste es ventaja en combate
	PaidWheelSpins = false, -- giros de ruleta con Robux: azar de pago
	Wheel = false, -- la ruleta entera (estética de casino: premios "jackpot"); el premio diario la sustituye
	CoinCrates = false, -- abrir cajas con monedas (las monedas se venden con Robux: azar de pago indirecto)
	VIPCrates = false, -- el VIP ya no da cajas extra (azar ligado a un pase de pago): da monedas
	VIPDailyCoins = 100, -- (lo que da el VIP al recoger el premio diario en vez de la caja)
	WeaponsForCoins = false, -- las armas se desbloquean solo por nivel, igual para todos
	PassXPFromPaidBoosts = false, -- el VIP y los potenciadores de pago no aceleran el pase
}

-- Pack de inicio: solo para jugadores nuevos (hasta MaxLevel), una vez. En la portada sale como un
-- aviso pequeño; la tarjeta grande se ve UNA vez (StarterSeen) y luego solo en la tienda.
MonetizationConfig.StarterPack = { MaxLevel = 15, MinMatches = 1 }

-- Bonus de la primera compra con Robux: una tarjeta de jugador exclusiva (no da ventaja). Se dice en
-- la tienda en una línea, sin ventanas.
MonetizationConfig.FirstPurchaseBonus = { Kind = "Card", Id = "PrimerGolpe", Text = "Tu primera compra incluye la tarjeta PRIMER GOLPE" }

-- Packs con Robux de los que ya tienes algo: el precio en Robux no puede cambiar (lo fija el
-- producto), así que lo que ya tenías se devuelve en monedas: su precio en monedas si lo tiene, o
-- sus Robux x CoinsPerRobux. Se dice antes de comprar. Si ya lo tienes TODO no se vende.
MonetizationConfig.Bundles = { CoinsPerRobux = 10 }

-- Oferta pequeña después de la partida ("DOMINASTE CON PHANTOM-X"): solo según lo que hiciste en la
-- partida (el arma con la que más bajas hiciste). Como mucho una de cada EveryMatches partidas, a
-- partir de MinMatches partidas jugadas, y nunca de algo que ya tienes. Se cierra con un toque.
MonetizationConfig.PostMatchOffer = { Enabled = true, MinMatches = 3, EveryMatches = 4, MinWeaponKills = 6 }

-- Tienda diaria: Size objetos al día (iguales para todos, cambian a las 00:00 UTC); el destacado
-- cambia cada semana (lunes 00:00 UTC). Los relojes cuentan hasta esas horas de verdad.
MonetizationConfig.DailyStore = { Size = 6 }

-- Venta de niveles del pase: solo dentro de la pantalla del pase, un nivel por compra.
MonetizationConfig.TierSkip = { Enabled = true }

-- Etiqueta NUEVO: los objetos que entran en el catálogo llevan NUEVO hasta que los ves en la tienda.
MonetizationConfig.NewItems = {
	"Skin:Inferno", "Skin:Ciber", "Skin:ArticoTactico", "Skin:Callejero", "Skin:GrietaVacio", "Skin:OperacionRoja",
	"Outfit:OperacionRoja", "Outfit:ArticoTactico",
	"Charm:Chapa", "Charm:Bala", "Charm:Calaverita",
	"KillEffect:Pixel", "KillEffect:OroFlash", "KillEffect:ChoqueRojo",
	"Pose:Bajada", "Pose:AlCielo", "Pose:Saludo", "Pose:Brazos", "Pose:Senala",
	"MVPIntro:Giro", "MVPIntro:Ascuas", "MVPIntro:Columna",
	"Card:Tactico", "Card:Carbono", "Card:Neon", "Card:Glaciar", "Card:Infierno", "Card:Oro", "Card:Vacio",
}

-- Analítica: solo nombres de evento y datos del juego (ids de objetos, precios, pestañas). Nada
-- personal. El cliente solo puede mandar estos eventos y como mucho ClientPerMinute por minuto.
MonetizationConfig.Analytics = {
	Enabled = true,
	ClientPerMinute = 30,
	ClientEvents = {
		store_open = true,
		item_preview = true,
		purchase_prompt = true,
		purchase_cancel = true,
		bundle_view = true,
		battlepass_open = true,
		starter_pack_view = true,
	},
	-- (los que solo manda el servidor, cuando algo pasa de verdad)
	ServerEvents = {
		purchase_success = true,
		battlepass_purchase = true,
		starter_pack_purchase = true,
		coin_purchase = true,
		battlepass_claim = true,
	},
}

return MonetizationConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Products</string>
            <string name="Source"><![CDATA[-- Productos con Robux (Developer Products y Game Passes): un solo registro con su ProductId y su
-- precio. La interfaz NUNCA lleva ids escritos: los pide aquí.
--
-- IMPORTANTE: los ids se crean en el Creator Dashboard (Monetización → Developer Products / Passes)
-- y se pegan aquí. Con ProductId = 0 el producto sale como "PRÓXIMAMENTE" y no se puede comprar.
-- Los precios de abajo son orientativos (los de verdad son los del Dashboard; la tienda los pide a
-- MarketplaceService:GetProductInfo cuando el id existe).
--
-- Ya existían (y se siguen configurando donde estaban, en Shared/Shop): packs de monedas
-- (Shop.CoinPacks), potenciadores (Shop.Boosters), pack de inicio (Shop.StarterPack), packs
-- (Shop.Bundles) y el VIP (Shop.VIPPassId). Aquí se juntan todos para buscarlos por id.
local Shared = script.Parent.Parent
local Shop = require(Shared.Shop)
local BattlePassConfig = require(script.Parent.BattlePassConfig)
local MonetizationConfig = require(script.Parent.MonetizationConfig)

local Products = {}

-- Objetos sueltos con Robux. Clave "Tipo:Id" (ver CosmeticCatalog). Tramos de precio:
--   29-49   colgantes, grafitis, tarjetas
--   59-99   efectos de baja, poses, intros de MVP
--   129-199 skins de arma y trajes de operador
Products.Items = {
	-- Skins de arma
	["Skin:Inferno"] = { ProductId = 0, Robux = 179 }, -- TODO: SET IN CREATOR DASHBOARD
	["Skin:Ciber"] = { ProductId = 0, Robux = 149 }, -- TODO: SET IN CREATOR DASHBOARD
	["Skin:ArticoTactico"] = { ProductId = 0, Robux = 129 }, -- TODO: SET IN CREATOR DASHBOARD
	["Skin:Callejero"] = { ProductId = 0, Robux = 129 }, -- TODO: SET IN CREATOR DASHBOARD
	["Skin:GrietaVacio"] = { ProductId = 0, Robux = 199 }, -- TODO: SET IN CREATOR DASHBOARD
	["Skin:OperacionRoja"] = { ProductId = 0, Robux = 179 }, -- TODO: SET IN CREATOR DASHBOARD
	-- Trajes de operador
	["Outfit:OperacionRoja"] = { ProductId = 0, Robux = 199 }, -- TODO: SET IN CREATOR DASHBOARD
	["Outfit:ArticoTactico"] = { ProductId = 0, Robux = 149 }, -- TODO: SET IN CREATOR DASHBOARD
	-- Colgantes
	["Charm:Chapa"] = { ProductId = 0, Robux = 29 }, -- TODO: SET IN CREATOR DASHBOARD
	["Charm:Bala"] = { ProductId = 0, Robux = 39 }, -- TODO: SET IN CREATOR DASHBOARD
	["Charm:Calaverita"] = { ProductId = 0, Robux = 49 }, -- TODO: SET IN CREATOR DASHBOARD
	-- Efectos de baja
	["KillEffect:Pixel"] = { ProductId = 0, Robux = 79 }, -- TODO: SET IN CREATOR DASHBOARD
	["KillEffect:OroFlash"] = { ProductId = 0, Robux = 99 }, -- TODO: SET IN CREATOR DASHBOARD
	["KillEffect:ChoqueRojo"] = { ProductId = 0, Robux = 99 }, -- TODO: SET IN CREATOR DASHBOARD
	-- Poses de victoria
	["Pose:Saludo"] = { ProductId = 0, Robux = 79 }, -- TODO: SET IN CREATOR DASHBOARD
	["Pose:Brazos"] = { ProductId = 0, Robux = 79 }, -- TODO: SET IN CREATOR DASHBOARD
	["Pose:Senala"] = { ProductId = 0, Robux = 99 }, -- TODO: SET IN CREATOR DASHBOARD
	-- Intros de MVP
	["MVPIntro:Ascuas"] = { ProductId = 0, Robux = 89 }, -- TODO: SET IN CREATOR DASHBOARD
	["MVPIntro:Columna"] = { ProductId = 0, Robux = 99 }, -- TODO: SET IN CREATOR DASHBOARD
	-- Tarjetas de jugador
	["Card:Glaciar"] = { ProductId = 0, Robux = 39 }, -- TODO: SET IN CREATOR DASHBOARD
	["Card:Infierno"] = { ProductId = 0, Robux = 49 }, -- TODO: SET IN CREATOR DASHBOARD
	["Card:Oro"] = { ProductId = 0, Robux = 49 }, -- TODO: SET IN CREATOR DASHBOARD
	["Card:Vacio"] = { ProductId = 0, Robux = 49 }, -- TODO: SET IN CREATOR DASHBOARD
}

-- Un nivel del pase (solo se ofrece dentro de la pantalla del pase)
Products.TierSkip = { ProductId = 0, Robux = 49, Tiers = 1 } -- TODO: SET IN CREATOR DASHBOARD

function Products.Key(kind, id)
	return tostring(kind) .. ":" .. tostring(id)
end

function Products.Item(kind, id)
	return Products.Items[Products.Key(kind, id)]
end

-- ¿Se puede comprar ya? (id puesto)
function Products.Enabled(entry)
	return type(entry) == "table" and type(entry.ProductId) == "number" and entry.ProductId ~= 0
end

-- Lo que trae un pack, como lista de { Kind, Id } (los packs antiguos lo tienen en campos sueltos)
function Products.BundleItems(bundle)
	local list = {}
	local function add(kind, id)
		if id then
			table.insert(list, { Kind = kind, Id = id })
		end
	end
	for _, key in bundle.Items or {} do
		local kind, id = string.match(key, "^(%w+):(.+)$")
		add(kind, id)
	end
	for _, outfitId in bundle.Outfits or {} do
		add("Outfit", outfitId)
	end
	add("Outfit", bundle.Outfit)
	add("Skin", bundle.Skin)
	add("KillEffect", bundle.KillEffect)
	add("Charm", bundle.Charm)
	add("Spray", bundle.Spray)
	add("Card", bundle.Card)
	add("Pose", bundle.Pose)
	add("MVPIntro", bundle.MVPIntro)
	return list
end

-- Lo que vale por separado lo de un pack (solo precios que existen de verdad): Robux de los objetos
-- que se venden con Robux y monedas de los que se venden con monedas. coinPrice(kind, id) da el
-- precio en monedas (sin ofertas); lo pasa CosmeticCatalog para no depender de él aquí.
function Products.BundleValue(bundle, coinPrice)
	local robux, coins, priced, total = 0, bundle.Coins or 0, 0, 0
	for _, item in Products.BundleItems(bundle) do
		total += 1
		local entry = Products.Item(item.Kind, item.Id)
		local price = coinPrice and coinPrice(item.Kind, item.Id)
		if entry then
			robux += entry.Robux
			priced += 1
		elseif price then
			coins += price
			priced += 1
		end
	end
	-- (Complete = todo tiene precio: solo entonces se puede enseñar "por separado: X")
	return { Robux = robux, Coins = coins, Complete = priced == total }
end

-- Todos los productos con id (para buscarlos al llegar un recibo)
local function each(callback)
	for _, pack in Shop.CoinPacks do
		callback("Coins", pack, pack.Name)
	end
	for _, booster in Shop.Boosters do
		callback("Booster", booster, booster.Id)
	end
	callback("Starter", Shop.StarterPack, "Starter")
	for _, bundle in Shop.Bundles do
		callback("Bundle", bundle, bundle.Id)
	end
	for key, entry in Products.Items do
		callback("Item", entry, key)
	end
	for _, season in BattlePassConfig.Seasons do
		callback("PassPremium", season.Premium, season.Id)
	end
	callback("TierSkip", Products.TierSkip, "TierSkip")
	-- (ya no se venden, pero un recibo pendiente se sigue entregando)
	for _, pack in Shop.RevivePacks do
		callback("Revives", pack, pack.Name)
	end
	callback("WheelSpins", { ProductId = Shop.Wheel.SpinProductId }, "Wheel")
end

-- Qué es un ProductId: { Type, Def, Key } o nil
function Products.Resolve(productId)
	if type(productId) ~= "number" or productId == 0 then
		return nil
	end
	local found
	each(function(kind, def, key)
		if not found and def and def.ProductId == productId then
			found = { Type = kind, Def = def, Key = key }
		end
	end)
	return found
end

-- Lista de todos (para comprobar que no hay ids repetidos)
function Products.All()
	local list = {}
	each(function(kind, def, key)
		table.insert(list, { Type = kind, Def = def, Key = key })
	end)
	return list
end

-- ¿Se vende ahora? (los apagados en MonetizationConfig.Rules no se ofrecen)
function Products.ForSale(kind)
	local rules = MonetizationConfig.Rules
	if kind == "Revives" then
		return rules.SellRevives
	elseif kind == "WheelSpins" then
		return rules.PaidWheelSpins
	end
	return true
end

return Products
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">StoreRotation</string>
            <string name="Source"><![CDATA[-- Rotación de la tienda: lo mismo para todos y calculado con la hora (sin servidor que guardar):
--   · Tienda diaria: MonetizationConfig.DailyStore.Size objetos; cambia a las 00:00 UTC. Las 3
--     primeras son las "ofertas del día" de siempre (Shop.GetDailyOffers, con su descuento real).
--   · Destacado: un pack por semana (cambia el lunes 00:00 UTC).
--   · Tienda de evento: objetos y pack de un evento entre dos fechas.
-- Los relojes cuentan hasta esas horas de verdad: no hay reinicios falsos ni "última oportunidad".
-- Lo que sale de la rotación vuelve a salir otro día (no hay escasez falsa).
local Shared = script.Parent.Parent
local Shop = require(Shared.Shop)
local Challenges = require(Shared.Challenges)
local Catalog = require(script.Parent.CosmeticCatalog)
local MonetizationConfig = require(script.Parent.MonetizationConfig)

local StoreRotation = {}

-- Packs que van rotando en el destacado (Shop.Bundles, por Id)
StoreRotation.FeaturedBundles = { "RedOps", "Artico", "Vacio" }

-- Eventos de la tienda (hora UTC). Mientras duran, su sección sale en DESTACADO y en EVENTOS.
StoreRotation.Events = {
	{
		Id = "RedZone",
		Name = "OPERACIÓN ZONA ROJA",
		Text = "Colección Operación Roja: skin, traje, efecto, tarjeta y pose.",
		StartsAt = 1791244800, -- 6 oct 2026 00:00 UTC
		EndsAt = 1793664000, -- 3 nov 2026 00:00 UTC
		Bundle = "RedOps",
		Items = { "Skin:OperacionRoja", "Outfit:OperacionRoja", "KillEffect:ChoqueRojo", "Card:Infierno", "Pose:Senala", "Skin:Inferno" },
		Colors = { Color3.fromRGB(200, 20, 30), Color3.fromRGB(20, 8, 10) },
	},
}

function StoreRotation.DayNumber(now)
	return Shop.DayNumber(now)
end

-- Cuándo cambia la tienda diaria (segundos UTC)
function StoreRotation.DayEndsAt(now)
	return (Shop.DayNumber(now) + 1) * 86400
end

function StoreRotation.WeekEndsAt(now)
	return Challenges.WeekEndsAt(Challenges.WeekNumber(Shop.DayNumber(now)))
end

-- Los objetos de la tienda diaria: { Kind, Id, Offer = true/false }
function StoreRotation.Daily(day)
	day = day or Shop.DayNumber()
	local size = MonetizationConfig.DailyStore.Size
	local list, used = {}, {}
	for _, offer in Shop.GetDailyOffers(day) do
		if #list < size then
			table.insert(list, { Kind = offer.Kind, Id = offer.Id, Offer = true })
			used[Catalog.Key(offer.Kind, offer.Id)] = true
		end
	end
	-- El resto: primero objetos de Robux y luego de monedas, al azar del día (igual para todos)
	local robuxPool, coinPool = {}, {}
	for _, item in Catalog.StoreItems() do
		if not used[item.Key] then
			table.insert(item.Robux and robuxPool or coinPool, item)
		end
	end
	local rng = Random.new(day * 104729 + 17)
	local function take(pool)
		if #pool > 0 and #list < size then
			local item = table.remove(pool, rng:NextInteger(1, #pool))
			table.insert(list, { Kind = item.Kind, Id = item.Id, Offer = false })
		end
	end
	local robuxSlots = math.max(0, size - #list - 1)
	for _ = 1, robuxSlots do
		take(robuxPool)
	end
	while #list < size and (#coinPool > 0 or #robuxPool > 0) do
		take(#coinPool > 0 and coinPool or robuxPool)
	end
	return list
end

-- Pack destacado de la semana (puede no estar a la venta aún: ProductId 0)
function StoreRotation.FeaturedBundle(now)
	local ids = StoreRotation.FeaturedBundles
	if #ids == 0 then
		return nil
	end
	local week = Challenges.WeekNumber(Shop.DayNumber(now))
	local id = ids[week % #ids + 1]
	for _, bundle in Shop.Bundles do
		if bundle.Id == id then
			return bundle
		end
	end
	return nil
end

-- Evento de la tienda en marcha (o nil)
function StoreRotation.ActiveEvent(now)
	now = now or os.time()
	for _, event in StoreRotation.Events do
		if now >= event.StartsAt and now < event.EndsAt then
			return event
		end
	end
	return nil
end

function StoreRotation.BundleById(id)
	for _, bundle in Shop.Bundles do
		if bundle.Id == id then
			return bundle
		end
	end
	return nil
end

return StoreRotation
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">GameConfig</string>
          <string name="Source"><![CDATA[-- Configuración general del juego. Cambia aquí los valores para ajustar el balance.
local GameConfig = {}

-- Nombre que aparece en la pantalla de inicio y en los carteles del mapa
GameConfig.GameTitle = "SHOOTER NEW"
-- Estilo de los mapas: "Tactico" (el de ahora: materiales de verdad con luz limpia y legible, color un
-- poco vivo y brillo contenido: un shooter de Roblox moderno, MapKit.tacticalize), "Realista" (piedra, yeso, ladrillo, metal y madera de verdad, colores naturales y
-- luz con sombras marcadas, como los shooters militares) o "Cartoon" (colores vivos, plástico liso y
-- sombras suaves). En Realista, los mapas pensados para Cartoon se "realizan" solos (MapKit.realize).
GameConfig.VisualStyle = "Tactico"

-- Equipos
GameConfig.Teams = {
	{ Name = "Rojo", Color = BrickColor.new("Really red") },
	{ Name = "Azul", Color = BrickColor.new("Really blue") },
}

-- Rondas
GameConfig.MinPlayers = 1 -- súbelo a 2+ cuando publiques el juego
GameConfig.IntermissionTime = 20

-- Modos de juego. En cada descanso se votan 3 combinaciones de mapa + modo entre estos.
-- Quita alguno de la lista si no lo quieres.
GameConfig.Modes = { "TDM", "DOM", "SND", "CTF", "KOTH", "FFA", "GUN", "ELIM", "INF", "CAL" }
GameConfig.ModeSettings = {
	TDM = { Name = "Duelo por equipos", ScoreToWin = 50, RoundTime = 10 * 60, Teams = true }, -- puntos = bajas (50 en 10 min, como en los shooters de móvil)
	CTF = { Name = "Captura la bandera", ScoreToWin = 3, RoundTime = 10 * 60, Teams = true }, -- puntos = capturas
	-- Dominio: tres banderas (A, B, C); cada una tuya suma 1 punto cada 3 s
	DOM = { Name = "Dominio", ScoreToWin = 150, RoundTime = 10 * 60, Teams = true },
	KOTH = { Name = "Zona de control", ScoreToWin = 150, RoundTime = 10 * 60, Teams = true }, -- 1 punto/seg en la zona
	FFA = { Name = "Todos contra todos", ScoreToWin = 25, RoundTime = 8 * 60, Teams = false }, -- bajas individuales
	GUN = { Name = "Escalada de armas", ScoreToWin = 0, RoundTime = 10 * 60, Teams = false }, -- 0 = una baja por arma
	-- Eliminación: rondas cortas de UNA vida; gana la ronda el equipo que deje al otro sin nadie en pie
	-- Buscar y destruir: rondas de una vida; atacan y defienden por turnos. Los atacantes plantan la
	-- bomba en A o B (PlantTime s dentro del sitio) y explota a los BombTime s; los defensores la
	-- desactivan (DefuseTime s junto a ella). Solo en mapas con sitios (si no, es Eliminación).
	SND = { Name = "Buscar y destruir", ScoreToWin = 4, RoundTime = 12 * 60, Teams = true, SubRoundTime = 100, PrepTime = 5, PlantTime = 4, DefuseTime = 6, BombTime = 35, DefenderHeadStart = 3 }, -- (los atacantes salen 3 s después: los sitios están a la misma distancia de las dos bases)
	ELIM = { Name = "Eliminación", ScoreToWin = 5, RoundTime = 10 * 60, Teams = true, SubRoundTime = 75, PrepTime = 4 },
	-- Infección (Halloween): todos empiezan como supervivientes (equipo A) y tras PrepTime uno de cada
	-- ZombieRatio se convierte en zombi (equipo B: garras, más vida y algo más rápidos). Quien cae ante
	-- los zombis se convierte en zombi. Ganan los supervivientes si queda alguno al acabar el tiempo.
	INF = { Name = "Infección", ScoreToWin = 1, RoundTime = 150, Teams = true, PrepTime = 12, ZombieHealth = 200, ZombieRatio = 5 },
	-- Calabazas (como "Kill Confirmed"): quien cae suelta una calabaza; un punto si la recoge el equipo
	-- contrario, y si la recoge un compañero del caído la baja no cuenta
	CAL = { Name = "Calabazas", ScoreToWin = 30, RoundTime = 8 * 60, Teams = true },
}
-- Uniforme militar para quien no lleva traje en los mapas realistas (cada jugador puede quitarlo en Ajustes)
GameConfig.SoldierUniform = true
-- Sangre en los impactos y bajas (mapas realistas). false (por defecto): impactos realistas sin sangre
-- (polvo y fibras de la ropa). true: una nube rojo oscuro y gotitas. OJO: en el cuestionario de
-- madurez de Roblox, la sangre realista cuenta como «Moderado» (13+): actualízalo antes de activarla.
GameConfig.RealisticBlood = false
-- Tamaño del arma que lleva el personaje en el mundo (la que ven los demás). 1 = como la de primera
-- persona (enorme al lado del cuerpo); 0,65 = a escala de una persona, como en los shooters realistas
GameConfig.WorldWeaponScale = 0.65
-- Los personajes (bots y demás jugadores) sujetan el arma de fuego con las dos manos: culata al hombro
-- y la otra mano en el guardamanos (IKControl, solo en cada cliente). false = la pose de Roblox
GameConfig.TwoHandedPose = true
-- Contorno rojo fino en los enemigos (solo donde ya se les ve: no atraviesa paredes), para leerlos al
-- momento contra cualquier fondo, como en los shooters competitivos de Roblox. false = sin contorno
GameConfig.EnemyOutline = true
-- Colores que puede elegir el jugador para ese contorno (Ajustes): rojo, amarillo (daltonismo
-- rojo-verde) y magenta (se distingue de casi todos los fondos)
GameConfig.EnemyColors = {
	{ Name = "Rojo", Color = Color3.fromRGB(255, 64, 52) },
	{ Name = "Amarillo", Color = Color3.fromRGB(255, 220, 40) },
	{ Name = "Magenta", Color = Color3.fromRGB(255, 60, 220) },
}
-- En cada votación sale siempre un mapa de 5 contra 5 estilo shooter militar (los de Realistic = true:
-- los nueve 5v5: Construction, Coastal, Terminal...) con Duelo por equipos, Dominio o Buscar y destruir. false = votación al azar
GameConfig.VoteRealisticMap = true
GameConfig.VoteTime = 15 -- segundos de votación (dentro del descanso)

-- Captura la bandera
GameConfig.Flag = {
	PickupRadius = 5, -- distancia para coger/devolver la bandera
	CaptureRadius = 7, -- distancia a tu base para capturar
	AutoReturnTime = 20, -- segundos que tarda en volver sola si nadie la toca
	CarrierSpeedMultiplier = 0.9, -- el portador va un poco más lento
}
GameConfig.EndScreenTime = 8

-- Despliegue al empezar cada partida (todos quietos y sin daño mientras tanto): presentación de los
-- equipos y elección rápida de clase (LineupTime) y cuenta atrás 3-2-1 (CountdownTime). En
-- Eliminación y Buscar y destruir la cuenta atrás es la preparación de la primera ronda.
-- Animaciones de los personajes de los menús (vista 3D del lobby, operador, escuadra, armamento y
-- victoria). Sube la animación (R15) a Roblox y pega aquí "rbxassetid://<id>"; vacío = pose por
-- código con el arma lista (ver Flow/Preview)
GameConfig.UIAnimations = {
	MenuIdle = "",
	OperatorIdle = "",
	WeaponInspect = "",
	SquadIdle = "",
	VictoryPose = "", -- (MVP en la pantalla final)
	VictoryIdle = "",
	SquadVictoryIdle = "", -- (compañeros del MVP en la pantalla final)
}

-- Pantalla final: botón 👍 de reconocimiento a compañeros. Apagado: aún no hay sistema que lo guarde
-- (al encenderlo hay que conectar PlayerResultCard.OnHonor a un remoto real)
GameConfig.ResultsHonor = false

GameConfig.Deploy = {
	Enabled = true,
	LineupTime = 7,
	CountdownTime = 3,
}

-- Clases (5 huecos): arma principal, secundaria y ventaja. Las de partida se guardan con el progreso
-- y se cambian en Armamento o en la elección rápida antes de desplegar.
GameConfig.ClassCount = 5
GameConfig.DefaultClasses = {
	{ Name = "ASALTO", Primary = "ARX27", Secondary = "Viper", Perk = 1 },
	{ Name = "CQB", Primary = "Specter9", Secondary = "Viper", Perk = 1 },
	{ Name = "ESCOPETA", Primary = "HavocPump", Secondary = "Viper", Perk = 2 },
	{ Name = "TIRADOR", Primary = "Signal7", Secondary = "Viper", Perk = 3 },
	{ Name = "PESADO", Primary = "TitanLMG", Secondary = "Viper", Perk = 2 },
}
-- Killcam final: si una baja cierra la partida o una ronda de Eliminación / Buscar y destruir, todos ven
-- su repetición desde los ojos de quien la hizo (con todo congelado este rato). false = sin ella
-- Instrumentación de impactos (Fase 2, solo diagnóstico; NO cambia qué impactos valen). Con Enabled, el
-- servidor mide cuánto se separa el punto de impacto que dice el cliente de la pieza que dice haber
-- tocado y lo resume en la consola cada ReportEvery impactos. Sirve para ajustar la tolerancia
-- (~8 studs) y la validación del tiro a la cabeza con latencia real en Studio. Apagado en producción.
GameConfig.HitTelemetry = { Enabled = false, ReportEvery = 200 }
-- Modo QA (Fase 8): panel de pruebas para Roblox Studio (mapa y modo, terminar partida, bots, arma,
-- rendimiento, telemetría de impactos, ayudas visuales). Funciona SOLO si Enabled = true Y el juego
-- corre dentro de Roblox Studio (RunService:IsStudio()). En un servidor publicado no existe: ni panel,
-- ni RemoteEvent, ni comandos (ver Shared/QA.luau y FASE_08_VALIDACION_STUDIO.md). Dejar en false al
-- hacer commit.
GameConfig.QA = { Enabled = false }
-- Desenfoque al apuntar (AimFX). Apagado: en combate nada sale borroso (Fase 3). La viñeta sí sigue.
GameConfig.AimDepthOfField = false
GameConfig.FinalKillcam = true
GameConfig.FinalKillcamTime = 3.4
GameConfig.RespawnTime = 3
GameConfig.RespawnNowDelay = 1 -- "Regenerar ahora" se puede pulsar a partir de este segundo
GameConfig.StartingRevives = 3 -- revivir instantáneos con los que empieza un jugador nuevo
GameConfig.ReviveShieldTime = 2 -- segundos de escudo al revivir

-- Habilidades (iconos abajo en el centro): Impulso (E), Supersalto (Z) y Poción (X)
GameConfig.Abilities = {
	Dash = { Cooldown = 6, Speed = 78, Duration = 0.2 },
	Jump = { Cooldown = 10, Power = 82, Forward = 22 },
	Potion = { Cooldown = 25, Heal = 50, Duration = 2.5 },
}
-- Bots: rellenan la partida cuando hay pocos jugadores (se quitan solos al entrar gente). Con
-- FillTo = 10 las partidas por equipos son siempre 5 contra 5 (como en los shooters de móvil).
GameConfig.Bots = {
	Enabled = true,
	FillTo = 10, -- jugadores + bots hasta este número (10 = 5 contra 5)
	-- Roles: cada bot sale con uno (y sus armas). Max = como mucho tantos por equipo.
	Roles = {
		{ Name = "Asalto", Weight = 4, Weapons = { "ARX27", "VortexBR" } }, -- fusil: equilibrado
		{ Name = "Subfusil", Weight = 2.5, Weapons = { "Specter9", "NovaDrift" } }, -- corre y entra a por ti
		{ Name = "Tirador", Weight = 1.5, Max = 1, Weapons = { "RaptorDMR", "Signal7" } }, -- se aposta lejos (ventanas, alturas)
		{ Name = "Escopeta", Weight = 1, Max = 1, Weapons = { "HavocPump" } }, -- distancia corta, muy agresivo
		{ Name = "Ametralladora", Weight = 1, Max = 1, Weapons = { "TitanLMG" } }, -- aguanta una línea
	},
	Weapons = { "ARX27", "Specter9", "VortexBR", "NovaDrift" }, -- (si no hay Roles)
	Range = 160,
	Accuracy = 0.55, -- probabilidad de acertar a corta distancia (con la puntería ya asentada)
	AccuracyFalloff = 0.004, -- se resta por cada stud de distancia (menos con fusiles de precisión)
	DamageScale = 0.55, -- los bots hacen menos daño que un jugador
	Reaction = 0.45, -- segundos antes de empezar a disparar a un objetivo nuevo (varía con cada bot)
	MaxFireRate = 8, -- disparos por segundo como máximo
	WalkSpeed = 18, -- peleando (como un jugador andando)
	SprintSpeed = 25, -- de camino, sin enemigos cerca (como un jugador corriendo)
	JumpChance = 0.06, -- probabilidad de saltar en cada cambio de dirección mientras pelea
	Hearing = 1, -- multiplica la distancia a la que oyen los disparos (110 studs; con silenciador 25)
	GrenadeCooldown = 18, -- segundos entre granadas de cada bot
	RewardScale = 0.5, -- XP y monedas por matar un bot (respecto a un jugador)
	-- Puntería y daño contra cada jugador según su rango (Bronce, Plata, Oro, Platino, Diamante,
	-- Campeón): con los novatos son más blandos y con los mejores aprietan más
	SkillByRank = { 0.75, 0.85, 1, 1.1, 1.2, 1.3 },
	OutfitChance = 0.6, -- probabilidad de que un bot lleve uno de los trajes de la tienda (y la mitad, skin de arma)
}
-- Eventos de temporada: durante las rondas aparecen objetos del evento por el mapa (caramelos en
-- Halloween, regalos en Navidad); cada uno da monedas y suma al contador del evento; hay premios
-- por el camino (Milestones; si ya tenías el traje, se cambia por Compensate monedas) y al llegar a
-- Goal se gana la skin exclusiva RewardSkin.
-- Se elige solo el evento cuyas fechas (StartsAt/EndsAt, hora UTC) incluyen el día de hoy; fuera de
-- fechas no hay evento. Para otro año cambia el Id (empieza de cero) y las fechas.
GameConfig.Events = {
	{
		Enabled = true,
		Id = "Halloween2026",
		Name = "Halloween",
		Icon = "🎃",
		Item = "caramelo",
		Items = "caramelos",
		ItemIcon = "🍬",
		ItemShape = "Ball",
		ItemColors = { Color3.fromRGB(255, 130, 20), Color3.fromRGB(170, 80, 255), Color3.fromRGB(120, 230, 60), Color3.fromRGB(255, 70, 120) },
		Decoration = "Pumpkin", -- calabazas en los mapas
		CandyCoins = 5, -- monedas por objeto
		Goal = 100,
		RewardSkin = "Embrujada",
		Milestones = {
			{ Count = 25, Coins = 150 },
			{ Count = 50, Outfit = "Calabaza", Compensate = 400 },
			{ Count = 75, Weapon = "Calabazooka", Compensate = 300 },
		},
		SpawnEvery = 12, -- segundos entre objetos
		MaxCandies = 6, -- a la vez en el mapa
		EndsAt = 1793750400, -- 4 nov 2026, 00:00 UTC
	},
	{
		Enabled = true,
		Id = "Navidad2026",
		Name = "Navidad",
		Icon = "🎄",
		Item = "regalo",
		Items = "regalos",
		ItemIcon = "🎁",
		ItemShape = "Block",
		ItemColors = { Color3.fromRGB(230, 40, 50), Color3.fromRGB(40, 170, 80), Color3.fromRGB(255, 200, 60), Color3.fromRGB(80, 160, 255) },
		Decoration = "Snowman", -- muñecos de nieve en los mapas
		CandyCoins = 5,
		Goal = 100,
		RewardSkin = "Navidena",
		Milestones = {
			{ Count = 25, Coins = 150 },
			{ Count = 50, Outfit = "PapaNoel", Compensate = 400 },
			{ Count = 75, Coins = 500 },
		},
		SpawnEvery = 12,
		MaxCandies = 6,
		StartsAt = 1796083200, -- 1 dic 2026, 00:00 UTC
		EndsAt = 1799366400, -- 8 ene 2027, 00:00 UTC
		-- Novedades propias del evento (salen solas al empezar; Version mayor que la de GameConfig.News)
		News = {
			Version = 3,
			Title = "🎄 ¡LLEGA LA NAVIDAD!",
			Items = {
				{ "🎁", "Evento de Navidad: recoge los regalos que aparecen por el mapa" },
				{ "🎅", "Traje de Papá Noel a los 50 regalos y skin Navideña a los 100" },
				{ "🏘", "Mapa de temporada: Villa Navideña, con su árbol gigante y pista de patinaje" },
				{ "☃️", "En la tienda: efecto Ventisca, bastón de caramelo y grafiti HO HO HO" },
				{ "🛍", "Pack de Navidad por tiempo limitado" },
			},
		},
	},
}

-- ¿Está en marcha este evento a esta hora?
function GameConfig.EventActive(event, now)
	now = now or os.time()
	return event ~= nil and event.Enabled == true and (event.StartsAt == nil or now >= event.StartsAt) and (event.EndsAt == nil or now < event.EndsAt)
end

-- El evento de ahora; si no hay ninguno, el próximo que va a empezar (para tener siempre uno a mano;
-- fuera de fechas EventActive dice que no y no sale nada)
function GameConfig.PickEvent(now)
	now = now or os.time()
	local upcoming
	for _, event in GameConfig.Events do
		if GameConfig.EventActive(event, now) then
			return event
		end
		if event.StartsAt and now < event.StartsAt and (not upcoming or event.StartsAt < upcoming.StartsAt) then
			upcoming = event
		end
	end
	return upcoming or GameConfig.Events[#GameConfig.Events]
end
GameConfig.Event = GameConfig.PickEvent()

-- Novedades que tocan ahora: las del evento en marcha si trae las suyas (y son más nuevas), si no
-- GameConfig.News
function GameConfig.ActiveNews()
	local event = GameConfig.CurrentEvent and GameConfig.CurrentEvent()
	if event and event.News and event.News.Version > GameConfig.News.Version then
		return event.News
	end
	return GameConfig.News
end

-- El evento en marcha AHORA según el servidor (atributo EventId que publica Event): en el cliente
-- no se usa su reloj (puede ir mal o estar cambiado). nil si no hay evento.
function GameConfig.CurrentEvent()
	local id = game:GetService("ReplicatedStorage"):GetAttribute("EventId")
	if not id then
		return nil
	end
	for _, event in GameConfig.Events do
		if event.Id == id then
			return event
		end
	end
	return nil
end

-- Logros: metas a largo plazo que se reclaman en la pestaña Perfil (monedas al reclamar).
-- Stat es un campo de los datos del jugador (TotalKills, Wins, Headshots, Matches, BestStreak, Level,
-- RankBest = rango más alto alcanzado, 1 = Bronce ... 6 = Campeón).
GameConfig.Achievements = {}
do
	local tiers = {
		{ "TotalKills", "🎯", "Consigue %d bajas", { 10, 100, 500, 1000, 5000 }, { 100, 300, 800, 1500, 5000 } },
		{ "Wins", "🏆", "Gana %d partidas", { 1, 10, 50, 200 }, { 100, 300, 1000, 3000 } },
		{ "Headshots", "🧠", "Haz %d bajas a la cabeza", { 10, 100, 500 }, { 150, 600, 2000 } },
		{ "Matches", "🎮", "Juega %d partidas", { 10, 50, 200 }, { 150, 500, 1500 } },
		{ "BestStreak", "🔥", "Consigue una racha de %d bajas", { 5, 10, 20 }, { 150, 500, 1500 } },
		{ "Level", "⭐", "Llega al nivel %d", { 10, 25, 50, 100 }, { 300, 800, 2000, 5000 } },
		{ "Assists", "🤝", "Consigue %d asistencias", { 10, 100, 500 }, { 100, 500, 1500 } },
		{ "RankBest", "👑", "Llega al rango %s", { 3, 5, 6 }, { 500, 1500, 4000 } },
	}
	local rankNames = { [3] = "Oro", [5] = "Diamante", [6] = "Campeón" }
	for _, tier in tiers do
		local stat, icon, text, goals, coins = tier[1], tier[2], tier[3], tier[4], tier[5]
		for i, goal in goals do
			table.insert(GameConfig.Achievements, {
				Id = stat .. goal,
				Stat = stat,
				Goal = goal,
				Icon = icon,
				Text = (stat == "RankBest" and string.format(text, rankNames[goal]))
					or (stat == "Wins" and goal == 1 and "Gana tu primera partida")
					or string.format(text, goal),
				Coins = coins[i],
			})
		end
	end
end

-- XP extra por días de la semana (hora UTC): Days usa os.date("!*t").wday (1 = domingo ... 7 = sábado).
-- Multiplica solo la XP (no las monedas). Pon Enabled = false para quitarlo.
GameConfig.XPBoost = { Enabled = true, Multiplier = 2, Days = { 1, 7 }, Text = "⚡ ¡FIN DE SEMANA DE XP DOBLE!" }

-- Novedades: tarjeta que ven una vez (en la pantalla de inicio) los jugadores que ya habían jugado.
-- Para anunciar otra actualización, cambia los textos y sube Version.
GameConfig.News = {
	Version = 2, -- (súbelo en cada actualización; la de Navidad tiene que quedar por encima)
	Title = "🎃 ¡NOVEDADES DE OCTUBRE!",
	Items = {
		{ "🤠", "Mapas nuevos: Pueblo Vaquero, Bahía Pirata y Castillo del Rey" },
		{ "🧟", "Modos de Halloween: Infección (zombis) y Calabazas (recoge las de tus enemigos)" },
		{ "🏁", "Temporadas de rango: al acabar, premio según el mejor rango que logres" },
		{ "🏆", "Primera victoria del día: +150 monedas extra cada día" },
		{ "🎁", "Caja sorpresa al acabar las partidas (segura cada 15)" },
		{ "⚡", "Potenciadores de XP doble y monedas dobles en la Tienda" },
		{ "🍬", "Caramelos del evento: Cabeza de Calabaza, Calabazooka y skin Embrujada" },
		{ "🏹", "Ballesta nueva, trajes de Vampiro y Momia y efectos de Halloween" },
		{ "💰", "SE BUSCA, retos semanales, títulos y grafitis (tecla J)" },
	},
}

-- Regalos por tiempo jugado en la sesión (minutos desde que entras; se recogen en orden, botón 🎁)
GameConfig.PlaytimeGifts = {
	{ Minutes = 2, Coins = 40 },
	{ Minutes = 5, Coins = 75 },
	{ Minutes = 10, Revives = 1 },
	{ Minutes = 15, Coins = 150 },
	{ Minutes = 20, Coins = 100, XP = 250 },
	{ Minutes = 30, Revives = 2 },
	{ Minutes = 45, Coins = 300 },
}
-- Vida que se recupera sola (como en los shooters de móvil): tras Delay segundos sin daño sube
-- PerSecond puntos por segundo hasta llenarse
GameConfig.HealthRegen = { Enabled = true, Delay = 4, PerSecond = 35 }
-- Apariciones dinámicas (Duelo por equipos, Zona y Calabazas): al reaparecer, en el punto del mapa
-- más seguro (lejos de los enemigos, cerca de tu equipo) en vez de en la base. false = siempre en la base
GameConfig.DynamicSpawns = true
GameConfig.SpawnProtection = 2 -- segundos de escudo al reaparecer
GameConfig.TrainingDummies = false -- muñecos de práctica quietos (ya no hacen falta: los bots sirven para practicar)

-- Movimiento
GameConfig.WalkSpeed = 18
GameConfig.SprintSpeed = 26
GameConfig.AimWalkSpeed = 11
GameConfig.CrouchSpeed = 10 -- agachado (C sin correr; corriendo, C desliza)
GameConfig.CrouchDrop = 1.3 -- cuánto se baja el cuerpo al agacharse
GameConfig.SlideSpeed = 58
GameConfig.SlideDuration = 0.75
GameConfig.SlideCooldown = 1.1
GameConfig.FieldOfView = 80
-- Movimiento realista: aceleración, estamina al correr, aterrizajes y balanceo de cámara
GameConfig.Movement = {
	Acceleration = 30, -- studs/s que gana la velocidad por segundo al arrancar o al pasar a correr
	Deceleration = 70, -- y que pierde al frenar o dejar de correr
	StartFactor = 0.55, -- al empezar a andar, se arranca con esta parte de la velocidad
	SprintAngle = 0.55, -- solo se corre hacia delante (coseno entre hacia dónde vas y hacia dónde miras)
	StaminaSeconds = 6, -- segundos corriendo sin parar con la estamina llena
	RegenSeconds = 4, -- segundos para llenarla otra vez desde cero
	RegenDelay = 0.8, -- espera tras correr o saltar antes de recuperarse
	MinToSprint = 0.3, -- si se agota, hace falta esta parte para volver a correr
	JumpCost = 0.12, -- estamina que gasta cada salto
	TiredJump = 0.7, -- sin estamina se salta menos
	HardLanding = 38, -- velocidad de caída a partir de la que el aterrizaje se nota
	HeavyLanding = 62, -- y a partir de la que frena un momento
	CameraBob = 1, -- balanceo de cámara al andar (0 = nada)
}

-- Ajustes del jugador (menú Ajustes). Se guardan con su progreso.
-- "Auto": Baja en móviles y Media en PC (lo decide el cliente)
GameConfig.QualityLevels = { "Auto", "Baja", "Media", "Alta", "Ultra" }
-- AutoFire: disparo automático con la mira sobre un enemigo (0 = no, 1 = siempre, 2 = solo en pantallas táctiles)
-- Perk: ventaja elegida (GameConfig.Perks; 0 = ninguna)
-- ScreenFX: efectos de pantalla (1 = normales; 0 = reducidos: sin desenfoques, destellos ni temblores,
-- para quien se marea; ver CombatFX, AimFX y WeaponController)
-- Controles táctiles (Fase 12): AutoSprint 1 = corre solo con el joystick a tope hacia delante (0 =
-- botón), LeftFire 1 = segundo botón de disparar a la izquierda, FireDrag 1 = el dedo de DISPARAR
-- también gira la cámara, HudLayout = posición, tamaño y opacidad de cada control (MobileHUD.Validate),
-- HudLayoutVersion = versión de la disposición por defecto con la que se guardó (MobileHUD.LayoutVersion;
-- la pone el servidor al migrar, el cliente no la cambia)
GameConfig.DefaultSettings = { Quality = "Auto", QualityVersion = 2, FOV = 80, Sensitivity = 1, AimSensitivity = 0.8, CrossColor = 1, CrossSize = 1, AutoFire = 2, AimAssist = 2, Uniform = 1, ScreenFX = 1, EnemyColor = 1, Perk = 0, AutoSprint = 1, LeftFire = 0, FireDrag = 1, HudLayout = {}, HudLayoutVersion = 2 }
GameConfig.SettingsLimits = {
	FOV = { 70, 100 },
	Sensitivity = { 0.2, 3 },
	AimSensitivity = { 0.2, 1.5 },
	CrossColor = { 1, 6 }, -- índice de GameConfig.CrosshairColors
	CrossSize = { 0.6, 2 },
	AutoFire = { 0, 2 },
	AimAssist = { 0, 2 }, -- asistencia de apuntado con dedo o mando: 2 normal, 1 suave, 0 no
	Uniform = { 0, 1 }, -- 1 = uniforme militar en los mapas realistas si no llevas traje; 0 = tu avatar
	ScreenFX = { 0, 1 }, -- 1 = efectos de pantalla normales; 0 = reducidos
	EnemyColor = { 1, 3 }, -- color del contorno de los enemigos (GameConfig.EnemyColors): accesibilidad
	Perk = { 0, 3 },
	AutoSprint = { 0, 1 },
	LeftFire = { 0, 1 },
	FireDrag = { 0, 1 },
}
-- Modo de depuración de los controles táctiles (zona segura, zonas táctiles, centro libre, zona de
-- cámara, resolución). Solo funciona en Studio y está apagado: nunca lo ve un jugador.
GameConfig.MobileHUDDebug = false
-- Ventajas (como en los shooters de móvil): cada jugador elige una en Ajustes, gratis. El número es
-- el valor guardado (Settings.Perk) y el atributo "Perk" del jugador.
GameConfig.Perks = {
	{ Id = 1, Name = "Ligero", Icon = "🏃", Text = "Corres y andas un 8 % más rápido", SpeedMultiplier = 1.08 },
	{ Id = 2, Name = "Persistente", Icon = "❤️", Text = "La vida empieza a recuperarse antes (2,5 s) y más deprisa", RegenDelay = 2.5, RegenMultiplier = 1.3 },
	{ Id = 3, Name = "Fantasma", Icon = "👻", Text = "Al disparar no sales en el minimapa enemigo y los bots te oyen la mitad de lejos" },
}

-- Colores de la mira que se pueden elegir en Ajustes
GameConfig.CrosshairColors = {
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(90, 255, 110),
	Color3.fromRGB(70, 230, 255),
	Color3.fromRGB(255, 230, 60),
	Color3.fromRGB(255, 90, 200),
	Color3.fromRGB(255, 70, 70),
}

-- Progresión (pase de batalla)
GameConfig.XPPerLevel = 1000
GameConfig.XP = {
	Kill = 100,
	Headshot = 25,
	StreakBonus = 20, -- extra por cada baja de racha
	Win = 500,
	Loss = 150,
	Capture = 300, -- capturar la bandera
	FlagReturn = 75, -- devolver tu bandera caída
	CarrierKill = 75, -- eliminar al portador de tu bandera
	PumpkinConfirm = 60, -- Calabazas: recoger la calabaza de un enemigo caído
	PumpkinDeny = 40, -- Calabazas: recoger la de un compañero (la baja no cuenta)
	Assist = 40, -- asistencia: le quitaste vida a alguien que remató otro (en los últimos 10 s)
	Ace = 250, -- Eliminación/Buscar y destruir: eliminar tú solo a todo el equipo rival en una ronda
}
-- Medallas de baja (como en los shooters de móvil): aviso en pantalla y XP extra (contra bots,
-- reducida como el resto del XP). LongShot: distancia mínima en studs (sin explosivos ni cuerpo a cuerpo)
GameConfig.Medals = {
	FirstBlood = { Text = "💥 PRIMERA SANGRE", Name = "Primera sangre", XP = 40 },
	Revenge = { Text = "😤 VENGANZA", Name = "Venganza", XP = 30 },
	LongShot = { Text = "🔭 LARGA DISTANCIA", Name = "Larga distancia", XP = 30, Distance = 90 },
	StreakEnder = { Text = "🛑 CAZARRACHAS", Name = "Cazarrachas", XP = 50, Streak = 3 },
	Afterlife = { Text = "👻 DESDE LA TUMBA", Name = "Desde la tumba", XP = 40 },
}
GameConfig.Coins = {
	Kill = 5,
	Win = 50,
	Capture = 20,
	Assist = 2,
	Pumpkin = 2, -- recoger una calabaza enemiga (modo Calabazas)
	WinStreak = 10, -- extra por cada victoria seguida (2.ª victoria +10, 3.ª +20...)
	WinStreakMax = 5, -- tope de victorias seguidas que suman extra
}

-- Grupo de Roblox: quien se une al grupo del juego puede reclamar Coins una vez (botón en la
-- pantalla de inicio). Crea el grupo en roblox.com/communities/create y pega aquí su ID (con 0 no sale).
GameConfig.Group = {
	Id = 0,
	Coins = 500,
}

-- Roblox Premium: quien lo tiene gana un poco más de monedas y XP (se multiplica con el VIP). Roblox
-- además paga al juego por el tiempo que juegan los Premium; en la Tienda hay un botón para hacerse Premium.
GameConfig.RobloxPremium = { Multiplier = 1.2 }

-- Premio de regreso: quien vuelve tras Days días o más sin jugar recibe Coins monedas, Crates cajas
-- gratis y BoostXPMinutes minutos de XP doble (de muestra de los potenciadores de la Tienda).
GameConfig.Comeback = { Days = 3, Coins = 400, Crates = 1, BoostXPMinutes = 30 }

-- Mientras hay un evento, la recompensa diaria regala también estos objetos del evento (caramelos...)
GameConfig.EventDailyBonus = 5

-- Mapa destacado: cada día (hora UTC) uno de los mapas de siempre da XPBonus de XP al jugarlo
-- (se marca con ⭐ en la votación)
GameConfig.FeaturedMap = { XPBonus = 1.25 }

-- Primera victoria del día: la primera partida que ganas cada día (hora UTC) da esto de más.
GameConfig.FirstWinOfDay = { Coins = 150, XP = 300 }

-- Caja sorpresa: al acabar cada partida jugada hay Chance de llevarte una caja gratis (el VIP, el
-- doble); tras Pity partidas sin ninguna, sale seguro.
GameConfig.SurpriseCrate = { Chance = 0.06, VIPMultiplier = 2, Pity = 15 }

-- Invitaciones: quien entra por primera vez con la invitación de un amigo (botón INVITAR de la
-- portada) recibe NewPlayerCoins, y el que invitó InviterCoins si está en el mismo servidor (como
-- mucho MaxRewards veces, para que no se pueda abusar con cuentas nuevas).
GameConfig.Referral = {
	NewPlayerCoins = 500,
	InviterCoins = 500,
	MaxRewards = 10,
	MinAccountAge = 3, -- días que debe tener la cuenta del nuevo para que el que invita cobre
}

-- "SE BUSCA": quien llega a una racha de Streak bajas lleva una recompensa encima (todos lo ven
-- marcado). Quien lo elimine cobra Base monedas, + PerKill por cada baja más de la racha (hasta Max).
GameConfig.Bounty = {
	Enabled = true,
	Streak = 5,
	Base = 25,
	PerKill = 5,
	Max = 100,
	XP = 50,
}

-- ID del GamePass del pase premium. Créalo en el Creator Hub y pon el número aquí.
-- Con 0 el botón de compra queda desactivado.
GameConfig.PremiumPassId = 0

-- Insignias de Roblox (Creator Hub → Insignias). Pega el ID de cada una; con 0 no se da.
GameConfig.Badges = {
	Welcome = 0, -- entrar por primera vez
	FirstKill = 0, -- primera baja
	Kills100 = 0, -- 100 bajas
	FirstWin = 0, -- primera victoria
	Level10 = 0, -- nivel 10
	RankGold = 0, -- llegar a rango Oro
	RankDiamond = 0, -- llegar a rango Diamante
	RankChampion = 0, -- llegar a rango Campeón
}

-- Después del último nivel del pase: cada Every niveles, Coins monedas y Crates cajas gratis.
GameConfig.PostPassRewards = { Every = 5, Coins = 300, Crates = 1 }

-- Recompensas por nivel. Free = pase gratis, Premium = pase de pago.
-- Tipos: { Type = "Skin", Id = "<id de Skins>" } o { Type = "Coins", Amount = n }
GameConfig.BattlePass = {
	{ Free = { Type = "Coins", Amount = 50 }, Premium = { Type = "Skin", Id = "Sakura" } },
	{ Free = { Type = "Skin", Id = "Toxico" }, Premium = { Type = "Coins", Amount = 150 } },
	{ Free = { Type = "Coins", Amount = 75 }, Premium = { Type = "Skin", Id = "Hielo" } },
	{ Free = nil, Premium = { Type = "Coins", Amount = 200 } },
	{ Free = { Type = "Skin", Id = "Selva" }, Premium = { Type = "Skin", Id = "Calabaza" } },
	{ Free = { Type = "Coins", Amount = 100 }, Premium = { Type = "Coins", Amount = 250 } },
	{ Free = nil, Premium = { Type = "Skin", Id = "Vacio" } },
	{ Free = { Type = "Coins", Amount = 125 }, Premium = { Type = "Coins", Amount = 300 } },
	{ Free = { Type = "Skin", Id = "Oceano" }, Premium = { Type = "Skin", Id = "Dorado" } },
	{ Free = { Type = "Coins", Amount = 150 }, Premium = { Type = "Coins", Amount = 400 } },
	{ Free = nil, Premium = { Type = "Skin", Id = "Galaxia" } },
	{ Free = { Type = "Coins", Amount = 200 }, Premium = { Type = "Coins", Amount = 500 } },
	{ Free = { Type = "Skin", Id = "Atardecer" }, Premium = { Type = "Skin", Id = "Dragon" } },
	{ Free = { Type = "Coins", Amount = 250 }, Premium = { Type = "Coins", Amount = 750 } },
	{ Free = { Type = "Coins", Amount = 500 }, Premium = { Type = "Skin", Id = "Magma" } },
}

-- Niveles 16 a 50 del pase (para que dure: unas 40 partidas). Cada 5 niveles, caja gratis y un
-- traje o un efecto en la vía premium; el resto, monedas y camuflajes.
do
	local premiumBig = {
		[20] = { Type = "Outfit", Id = "NeonRecon" },
		[25] = { Type = "Outfit", Id = "VoltBruiser" },
		[30] = { Type = "Outfit", Id = "FrostByte" },
		[35] = { Type = "Outfit", Id = "ToxicRogue" },
		[40] = { Type = "KillEffect", Id = "Rayo" },
		[45] = { Type = "KillEffect", Id = "AgujeroNegro" },
		[50] = { Type = "Outfit", Id = "GoldenAce" },
	}
	local premiumSkins = { "CamoBosque", "CamoDesierto", "CamoDigital", "CamoArtico", "CamoTigre", "CamoNebulosa", "Prisma" }
	local skinIndex = 0
	for tier = 16, 50 do
		local entry
		if tier % 5 == 0 then
			entry = { Free = { Type = "Crate", Amount = tier == 50 and 3 or 1 }, Premium = premiumBig[tier] }
		elseif tier % 5 == 3 then
			skinIndex += 1
			entry = { Free = { Type = "Coins", Amount = 100 + tier * 5 }, Premium = { Type = "Skin", Id = premiumSkins[(skinIndex - 1) % #premiumSkins + 1] } }
		else
			entry = { Free = tier % 2 == 0 and { Type = "Coins", Amount = 100 + tier * 5 } or nil, Premium = { Type = "Coins", Amount = 250 + tier * 10 } }
		end
		table.insert(GameConfig.BattlePass, entry)
	end
end

return GameConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Icons</string>
          <string name="Source"><![CDATA[-- Iconos propios de la interfaz (imágenes subidas a Roblox; los originales están en assets/icons).
-- Donde la interfaz acepta un icono de texto (un emoji) también acepta uno de estos: los componentes
-- del flujo (Components.button, Components.currency, Components.icon) dibujan un ImageLabel cuando el
-- icono empieza por "rbxassetid://". Para cambiar uno, sube la imagen nueva y pega aquí su id.
local Icons = {
	Coin = "rbxassetid://119564566034796",
	Helmet = "rbxassetid://101272569347741",
	Rifle = "rbxassetid://82217394839802",
	Squad = "rbxassetid://109026370206098",
	Cart = "rbxassetid://79728480968299",
	Medal = "rbxassetid://73354953246078",
	Calendar = "rbxassetid://127894742929981",
	Shield = "rbxassetid://120507823383353",
	Gear = "rbxassetid://90191286557913",
	Gift = "rbxassetid://101827535048849",
	Trophy = "rbxassetid://73936573100041",
	Crate = "rbxassetid://122885373307903",
	Star = "rbxassetid://112808557727271",
	Skull = "rbxassetid://137046389059018",
	Crosshair = "rbxassetid://90429847289049",
	Grenade = "rbxassetid://121473914856405",
	-- Rangos (Ranks.Tiers[i].Image), lobby y HUD
	RankBronze = "rbxassetid://111133030764679",
	RankSilver = "rbxassetid://80235852211142",
	RankGold = "rbxassetid://89762985457065",
	RankPlatinum = "rbxassetid://86826419667773",
	RankDiamond = "rbxassetid://80612095791723",
	RankChampion = "rbxassetid://112524468920637",
	Backpack = "rbxassetid://107910389989875",
	Jet = "rbxassetid://93943534209400",
	Shirt = "rbxassetid://125962631327421",
	Friends = "rbxassetid://110106803010338",
	Mail = "rbxassetid://115540682321529",
	Bell = "rbxassetid://125243510330351",
	Bolt = "rbxassetid://90887498032073",
	Medkit = "rbxassetid://97208428540779",
	Knife = "rbxassetid://131311788666550",
	Pistol = "rbxassetid://101149045962121",
	Shotgun = "rbxassetid://128712200332460",
	Sniper = "rbxassetid://74277160950595",
	Launcher = "rbxassetid://119107720365802",
	Flag = "rbxassetid://85023924351801",
	Bomb = "rbxassetid://87820073027783",
	Radar = "rbxassetid://86511689190033",
	Heart = "rbxassetid://140223376194172",
	Stopwatch = "rbxassetid://97752590251406",
	Padlock = "rbxassetid://118587925358341",
	Flame = "rbxassetid://103007412304744",
	Crown = "rbxassetid://97115850135424",
	Bullets = "rbxassetid://104942070526619",
	Boost = "rbxassetid://134117658265151",
	-- Tipos de artículo de la tienda, habilidades y botones varios
	Explosion = "rbxassetid://84569966919105",
	Spotlight = "rbxassetid://133382733218413",
	Pose = "rbxassetid://138476081269399",
	Spray = "rbxassetid://88600923084782",
	Keychain = "rbxassetid://107953755269434",
	IdCard = "rbxassetid://96587274900224",
	Ribbon = "rbxassetid://130136594105134",
	XpBadge = "rbxassetid://132630117672880",
	Dash = "rbxassetid://122083851330282",
	Jump = "rbxassetid://75838984281035",
	Potion = "rbxassetid://78069869686009",
	Smiley = "rbxassetid://88579404361902",
	Clipboard = "rbxassetid://127904163748431",
	Eye = "rbxassetid://113407659056087",
	Home = "rbxassetid://106988332256311",
}

-- ¿Es una imagen (y no un emoji o un texto)?
function Icons.IsImage(icon)
	return type(icon) == "string" and string.sub(icon, 1, 13) == "rbxassetid://"
end

return Icons
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">InputMode</string>
          <string name="Source"><![CDATA[-- Cómo se juega en este dispositivo (Fase 15, tras la captura del Galaxy S26 Ultra): UN solo criterio
-- para todo el cliente. Antes cada módulo decidía «móvil» con `TouchEnabled and not KeyboardEnabled`,
-- y algunos Android (el S26 Ultra entre ellos) dicen KeyboardEnabled = true aunque se juegue con los
-- dedos: el juego ponía el HUD de ordenador (ranuras de armas, «PASE · TIENDA», vida grande...).
--
-- Criterio: con pantalla táctil, manda UserInputService.PreferredInput (la API del motor que dice con
-- qué se está jugando: Touch en un teléfono aunque declare teclado). Si el motor no la tiene, se juega
-- con los dedos cuando no hay teclado o no hay ratón (un teléfono no tiene ratón; un portátil táctil
-- sí, y ahí sigue la interfaz de ordenador).
local UserInputService = game:GetService("UserInputService")

local InputMode = {}

function InputMode.TouchUI(): boolean
	-- (comparaciones estrictas con true: solo cuentan los valores que da el motor)
	if UserInputService.TouchEnabled ~= true then
		return false
	end
	local ok, preferred = pcall(function()
		return (UserInputService :: any).PreferredInput
	end)
	if ok and typeof(preferred) == "EnumItem" then
		local okTouch, touch = pcall(function()
			return (Enum :: any).PreferredInput.Touch
		end)
		if okTouch and touch ~= nil then
			return preferred == touch
		end
	end
	return UserInputService.KeyboardEnabled ~= true or UserInputService.MouseEnabled ~= true
end

return InputMode
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">KillEffects</string>
          <string name="Source"><![CDATA[-- Efectos de eliminación: lo que ven todos cuando eliminas a alguien (como en Arsenal).
-- Se compran con monedas en el menú (pestaña Efectos) y se dibujan en Effects.KillEffect (cliente).
local KillEffects = {}

KillEffects.List = {
	Default = { Name = "Estallido", Rarity = "Común", Icon = "💥", Description = "El de siempre, del color de su equipo." },
	Confeti = { Name = "Confeti", Rarity = "Raro", Icon = "🎉", Price = 500, Description = "¡Fiesta! Una lluvia de papelitos de colores." },
	Amor = { Name = "Amor", Rarity = "Raro", Icon = "💖", Price = 600, Description = "Corazones que suben flotando." },
	Fuego = { Name = "Llamarada", Rarity = "Épico", Icon = "🔥", Price = 800, Description = "Una columna de fuego." },
	Hielo = { Name = "Congelado", Rarity = "Épico", Icon = "❄️", Price = 800, Description = "Estalla en cristales de hielo." },
	Fantasma = { Name = "Fantasma", Rarity = "Épico", Icon = "👻", Price = 900, Description = "Su fantasma sale volando." },
	Calavera = { Name = "Calavera", Rarity = "Legendario", Icon = "💀", Price = 1200, Description = "Calavera gigante y humo rojo." },
	Rayo = { Name = "Rayo", Rarity = "Legendario", Icon = "⚡", Price = 1500, Description = "Un rayo cae del cielo." },
	Monedas = { Name = "Lluvia de monedas", Rarity = "Legendario", Icon = "💰", Price = 1500, Description = "Revienta en monedas de oro." },
	AgujeroNegro = { Name = "Agujero negro", Rarity = "Mítico", Icon = "🌀", Price = 3000, Description = "Se lo traga un agujero negro." },
	Pintura = { Name = "Pintura", Rarity = "Épico", Icon = "🎨", Price = 900, Description = "Revienta en bolas de pintura y lo deja todo manchado." },
	Arcoiris = { Name = "Arcoíris", Rarity = "Legendario", Icon = "🌈", Price = 1800, Description = "Un arcoíris sale disparado de tu rival." },
	-- Premium (Robux: ver Economy/Products). Cortos y sin tapar la pantalla
	Pixel = { Name = "Estallido píxel", Rarity = "Épico", Icon = "🟪", Description = "Revienta en cubitos de colores que caen." },
	OroFlash = { Name = "Destello dorado", Rarity = "Legendario", Icon = "🌟", Description = "Un destello de oro y chispas." },
	ChoqueRojo = { Name = "Choque rojo", Rarity = "Legendario", Icon = "🟥", Description = "Onda roja que se abre en anillo." },
	-- Halloween
	Murcielagos = { Name = "Murciélagos", Rarity = "Épico", Icon = "🦇", Price = 1000, Description = "Una bandada de murciélagos sale volando entre humo morado." },
	Calabazas = { Name = "Calabazas", Rarity = "Legendario", Icon = "🎃", Price = 1600, Description = "Revienta en calabazas que saltan, con una calabaza gigante y un diablillo." },
	-- Navidad
	Fuegos = { Name = "Fuegos artificiales", Rarity = "Legendario", Icon = "🎆", Price = 1700, Description = "Tres cohetes de colores estallan encima de tu rival." },
	Rodadora = { Name = "Rodadora", Rarity = "Épico", Icon = "🤠", Price = 900, Description = "Polvareda del desierto, matojos que salen rodando y un sombrero de vaquero volando." },
	Nieve = { Name = "Ventisca", Rarity = "Legendario", Icon = "☃️", Price = 1600, Description = "Revienta en copos de nieve y aparece un muñeco de nieve." },
}

function KillEffects.Get(id)
	return KillEffects.List[id] or KillEffects.List.Default
end

return KillEffects
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Mastery</string>
          <string name="Source"><![CDATA[-- Maestría de armas: las bajas con cada arma desbloquean camuflajes exclusivos para ESA arma
-- (y monedas). Los camuflajes son skins con Mastery = true (ver Skins.luau): no se venden ni salen en cajas.
local Mastery = {}

Mastery.Tiers = {
	{ Kills = 25, Camo = "MaestriaCarbono", Name = "Carbono", Coins = 100 },
	{ Kills = 75, Camo = "MaestriaOro", Name = "Oro", Coins = 250 },
	{ Kills = 150, Camo = "MaestriaDiamante", Name = "Diamante", Coins = 500 },
	{ Kills = 300, Camo = "MaestriaOscura", Name = "Materia oscura", Coins = 1000 },
}

-- Nivel de maestría alcanzado (0 = ninguno)
function Mastery.Level(kills)
	local level = 0
	for i, tier in Mastery.Tiers do
		if (kills or 0) >= tier.Kills then
			level = i
		end
	end
	return level
end

-- Siguiente nivel por conseguir (nil si ya tiene todos)
function Mastery.Next(kills)
	return Mastery.Tiers[Mastery.Level(kills) + 1]
end

-- ¿Tiene desbloqueado este camuflaje con esas bajas?
function Mastery.HasCamo(kills, camoId)
	for i, tier in Mastery.Tiers do
		if tier.Camo == camoId then
			return Mastery.Level(kills) >= i
		end
	end
	return false
end

return Mastery
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">MatchResults</string>
          <string name="Source"><![CDATA[-- Resultado de una partida: puntos de cada jugador (los mismos en el servidor y en la pantalla final),
-- motivo del final y sus textos. El servidor rellena el MatchResult (ver Round.endRound) y lo manda en
-- RoundEnd; la pantalla de resultados (Flow/Results) solo lo pinta.
--
-- MatchResult = {
--   Mode = "TDM", ModeName = "Duelo por equipos", Map = "Construction", TeamMode = true,
--   TeamA = "Rojo", TeamB = "Azul", ScoreA = 50, ScoreB = 38, Winner = "Rojo" | nil (empate),
--   Reason = "ScoreLimit" (ver Reasons), MVP = "<Id>",
--   Players = { { Id, Name, UserId?, Bot?, Team, Kills, Deaths, Assists, Captures, Points, Weapon, Skin, Level? } },
-- }
-- Id: "u<UserId>" para los jugadores, "b<Nombre>" para los bots
local MatchResults = {}

-- Puntos de la partida: bajas, asistencias y objetivos (capturas de bandera, zonas, bombas)
MatchResults.PointValues = { Kill = 100, Assist = 50, Capture = 250 }

function MatchResults.Points(kills, assists, captures)
	local v = MatchResults.PointValues
	return (tonumber(kills) or 0) * v.Kill + (tonumber(assists) or 0) * v.Assist + (tonumber(captures) or 0) * v.Capture
end

-- Orden del marcador y del MVP: más puntos; a igualdad, más bajas y menos muertes
function MatchResults.Better(a, b)
	if (a.Points or 0) ~= (b.Points or 0) then
		return (a.Points or 0) > (b.Points or 0)
	end
	if (a.Kills or 0) ~= (b.Kills or 0) then
		return (a.Kills or 0) > (b.Kills or 0)
	end
	if (a.Deaths or 0) ~= (b.Deaths or 0) then
		return (a.Deaths or 0) < (b.Deaths or 0)
	end
	return tostring(a.Name) < tostring(b.Name)
end

-- Motivos del final (el texto que va debajo de VICTORIA / DERROTA)
MatchResults.Reasons = {
	ScoreLimit = "LÍMITE DE PUNTOS ALCANZADO",
	Objectives = "OBJETIVOS ASEGURADOS",
	ZoneControl = "ZONA BAJO CONTROL",
	Captures = "BANDERAS CAPTURADAS",
	Eliminated = "EQUIPO ENEMIGO ELIMINADO",
	DecisiveRound = "RONDA DECISIVA GANADA",
	BombDefused = "BOMBA DESACTIVADA",
	BombExploded = "OBJETIVO COMPLETADO",
	Tags = "CALABAZAS RECOGIDAS",
	Survivors = "SUPERVIVIENTES EN PIE",
	Infected = "TODOS INFECTADOS",
	GunGame = "ÚLTIMA ARMA COMPLETADA",
	FFAScore = "LÍMITE DE BAJAS ALCANZADO",
	TimeLimit = "TIEMPO AGOTADO",
	Draw = "EMPATE",
}

-- Motivo según el modo, quién ganó y cómo acabó la última ronda (Eliminación / Buscar y destruir)
-- reachedGoal: el ganador llegó a la meta (si no, se acabó el tiempo)
function MatchResults.ReasonFor(mode, hasWinner, reachedGoal, lastRound)
	if not hasWinner then
		return "Draw"
	end
	if mode == "INF" then
		return reachedGoal and "Infected" or "Survivors"
	end
	if not reachedGoal then
		return "TimeLimit"
	end
	if mode == "SND" then
		if lastRound == "BombDefused" or lastRound == "BombExploded" then
			return lastRound
		end
		return "DecisiveRound"
	elseif mode == "ELIM" then
		return lastRound == "Eliminated" and "Eliminated" or "DecisiveRound"
	elseif mode == "DOM" then
		return "Objectives"
	elseif mode == "KOTH" then
		return "ZoneControl"
	elseif mode == "CTF" then
		return "Captures"
	elseif mode == "CAL" then
		return "Tags"
	elseif mode == "GUN" then
		return "GunGame"
	elseif mode == "FFA" then
		return "FFAScore"
	end
	return "ScoreLimit"
end

function MatchResults.ReasonText(reason)
	return MatchResults.Reasons[reason or ""] or ""
end

return MatchResults
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">MobileHUD</string>
          <string name="Source"><![CDATA[-- Disposición de los controles táctiles (Fase 12; rehecha en la Fase 15 para pantallas alargadas como
-- el Galaxy S26 Ultra). Lógica pura y compartida: el cliente la usa para colocar los botones y el
-- servidor para validar la disposición que guarda cada jugador.
--
-- Idea (Fase 15): nada se mide desde el botón de saltar de Roblox (ahora el salto es nuestro, va en el
-- grupo de combate). Cada pantalla se clasifica por su FORMA (proporción y lado corto de la pantalla
-- real, nunca por el modelo del dispositivo) y la disposición se calcula sobre la ZONA SEGURA:
--   * escala lógica = lado corto de la pantalla / 390 (un teléfono de referencia de 844×390), con
--     topes por clase: los botones miden lo mismo para el pulgar en cualquier teléfono;
--   * GRUPO DE COMBATE del pulgar derecho: DISPARAR es el centro y el resto se coloca alrededor
--     (apuntar arriba a la izquierda, salto a la derecha, agacharse debajo, recargar junto a la
--     munición...). En pantallas alargadas se mete hacia dentro (no se pega al borde físico);
--   * pulgar izquierdo: granada y habilidades sobre el joystick;
--   * poco uso (menú, marcador, emotes, grafiti): una tira pequeña arriba a la derecha.
-- Jerarquía: DISPARAR > APUNTAR > salto y agacharse > recargar > granada y cuerpo a cuerpo > poco uso.
-- El centro (mira) y una zona grande de la derecha (girar la cámara) quedan libres (Zones).
local MobileHUD = {}

-- Versión de la disposición por defecto. Las disposiciones propias guardadas son fracciones de la
-- zona segura y siguen valiendo; ver MigrateLayout.
MobileHUD.LayoutVersion = 2

-- Clases de pantalla (pocas, a propósito). DESKTOP no usa botones táctiles.
MobileHUD.Breakpoints = { "COMPACT_PHONE", "STANDARD_PHONE", "ULTRAWIDE_PHONE", "TABLET", "DESKTOP" }

-- Pantalla de referencia de la escala lógica (lado corto) y topes de la escala por clase
local BASE_SHORT = 390
local SCALE_LIMITS = {
	COMPACT_PHONE = { 0.78, 0.9 },
	STANDARD_PHONE = { 0.88, 1 },
	ULTRAWIDE_PHONE = { 0.95, 1.12 },
	TABLET = { 1.1, 1.25 },
	DESKTOP = { 1, 1 },
}
-- Proporción a partir de la que un teléfono es alargado (19,5:9 = 2,17; 20:9 = 2,22; 16:9 = 1,78)
MobileHUD.UltrawideAspect = 1.95

-- Clasifica una pantalla. `size`: zona segura; `screen`: pantalla entera (ViewportSize), opcional.
-- La forma se mide en la pantalla entera (la muesca o la barra de Roblox no la cambian).
function MobileHUD.Classify(size: Vector2, touch: boolean, screen: Vector2?): string
	if not touch then
		return "DESKTOP"
	end
	local full = screen or size
	local short = math.min(full.X, full.Y)
	local aspect = math.max(full.X, full.Y) / math.max(1, short)
	if short >= 560 then
		return "TABLET"
	elseif short < 350 then
		return "COMPACT_PHONE"
	elseif aspect >= MobileHUD.UltrawideAspect then
		return "ULTRAWIDE_PHONE"
	end
	return "STANDARD_PHONE"
end
-- (nombre de la Fase 12)
MobileHUD.Breakpoint = MobileHUD.Classify

-- Escala lógica: lado corto de la pantalla entera / 390, con los topes de su clase
function MobileHUD.Scale(class: string, screen: Vector2): number
	local limits = SCALE_LIMITS[class] or SCALE_LIMITS.STANDARD_PHONE
	return math.clamp(math.min(screen.X, screen.Y) / BASE_SHORT, limits[1], limits[2])
end

-- (compatibilidad con la Fase 12: escala típica de una clase)
function MobileHUD.Unit(class: string): number
	local limits = SCALE_LIMITS[class] or SCALE_LIMITS.STANDARD_PHONE
	return (limits[1] + limits[2]) / 2
end

-- Centro del grupo de combate (donde va DISPARAR) en la zona segura. Margen ergonómico desde el
-- borde derecho de la zona segura; en pantallas alargadas, más hacia dentro (el pulgar no llega
-- cómodo a la esquina de un teléfono largo).
MobileHUD.ClusterReach = Vector2.new(125, 91) -- (lo que sobresalen las zonas táctiles a la derecha y abajo de DISPARAR)
function MobileHUD.ClusterAnchor(class: string, size: Vector2, scale: number, screen: Vector2?): Vector2
	local full = screen or size
	local aspect = math.max(full.X, full.Y) / math.max(1, math.min(full.X, full.Y))
	-- RIGHT_THUMB_INSET: en pantallas alargadas el grupo entra más (el pulgar no llega cómodo a la
	-- esquina de un teléfono largo)
	local inward = 0
	if class == "ULTRAWIDE_PHONE" then
		inward = math.clamp((aspect - 1.9) * math.min(full.X, full.Y) * 0.2, 0, 40)
	end
	local right = MobileHUD.ClusterReach.X * scale + 20 * scale + inward
	local bottom = MobileHUD.ClusterReach.Y * scale + 14 * scale
	return Vector2.new(size.X - right, size.Y - bottom)
end

-- Controles. Anchor: "Cluster" (desde DISPARAR), "BottomLeft" (x desde la izquierda, y desde abajo)
-- o "TopRight" (x desde la derecha, y desde arriba). Size: diámetro (o Vector2 si es una tarjeta).
-- Shape: Round (círculo), Square (tarjeta cuadrada: habilidades y tira de poco uso) o Card (tarjeta
-- del arma). Hit: la ZONA TÁCTIL (una caja, como la del botón de Roblox) es algo mayor que el dibujo;
-- la disposición por defecto deja al menos MinTouchGap entre las cajas de dos controles (Fase 16:
-- antes se medían solo los dibujos y las cajas táctiles se pisaban). Role: Primary, Action, Utility.
-- Fade: se ve menos al apuntar (no se esconde). Critical: control de combate (el editor avisa si dos
-- se pisan y no deja guardar uno encima de otro).
MobileHUD.Controls = {
	-- Grupo de combate (pulgar derecho). Cajas táctiles con 6 px de aire a escala 1.
	{ Id = "Fire", Name = "Disparar", Icon = "Fire", Role = "Primary", Shape = "Round", Anchor = "Cluster", Offset = Vector2.new(0, 0), Size = 92, Hit = 1.13, Critical = true },
	{ Id = "Aim", Name = "Apuntar", Icon = "Aim", Role = "Primary", Shape = "Round", Anchor = "Cluster", Offset = Vector2.new(-96, -44), Size = 62, Hit = 1.13, Critical = true },
	{ Id = "Jump", Name = "Saltar", Icon = "Jump", Role = "Action", Shape = "Round", Anchor = "Cluster", Offset = Vector2.new(92, -10), Size = 58, Hit = 1.14, Critical = true },
	{ Id = "Slide", Name = "Agacharse", Icon = "Crouch", Role = "Action", Shape = "Round", Anchor = "Cluster", Offset = Vector2.new(88, 62), Size = 50, Hit = 1.16, Critical = true },
	{ Id = "Reload", Name = "Recargar", Icon = "Reload", Role = "Action", Shape = "Round", Anchor = "Cluster", Offset = Vector2.new(-92, 34), Size = 46, Hit = 1.17, Critical = true },
	{ Id = "Melee", Name = "Cuerpo a cuerpo", Icon = "Melee", Role = "Action", Shape = "Round", Anchor = "Cluster", Offset = Vector2.new(0, -84), Size = 40, Hit = 1.2, Fade = true, Critical = true },
	{ Id = "Airstrike", Name = "Ataque aéreo", Icon = "Airstrike", Role = "Action", Shape = "Round", Anchor = "Cluster", Offset = Vector2.new(64, -84), Size = 40, Hit = 1.15, Fade = true },
	{ Id = "SwapWeapon", Name = "Cambiar arma", Icon = "Card", Role = "Action", Shape = "Card", Anchor = "Cluster", Offset = Vector2.new(-210, 76), Size = Vector2.new(120, 32), Hit = 1.1 },
	-- Pulgar izquierdo (sobre el joystick de Roblox): una fila de habilidades y la granada
	{ Id = "Grenade", Name = "Granada", Icon = "Grenade", Role = "Action", Shape = "Round", Anchor = "BottomLeft", Offset = Vector2.new(198, -170), Size = 46, Hit = 1.17, Fade = true, Critical = true },
	{ Id = "AbilityDash", Name = "Impulso", Icon = "Dash", Role = "Action", Shape = "Square", Anchor = "BottomLeft", Offset = Vector2.new(38, -170), Size = 40, Hit = 1.15, Fade = true },
	{ Id = "AbilityJump", Name = "Supersalto", Icon = "SuperJump", Role = "Action", Shape = "Square", Anchor = "BottomLeft", Offset = Vector2.new(90, -170), Size = 40, Hit = 1.15, Fade = true },
	{ Id = "AbilityPotion", Name = "Poción", Icon = "Potion", Role = "Action", Shape = "Square", Anchor = "BottomLeft", Offset = Vector2.new(142, -170), Size = 40, Hit = 1.15, Fade = true },
	-- (opcionales: solo con su ajuste; si están apagados no se ven ni reservan sitio)
	{ Id = "Sprint", Name = "Correr", Icon = "Sprint", Role = "Action", Shape = "Square", Anchor = "BottomLeft", Offset = Vector2.new(90, -224), Size = 40, Hit = 1.15 },
	{ Id = "LeftFire", Name = "Disparo izquierdo", Icon = "Fire", Role = "Primary", Shape = "Round", Anchor = "BottomLeft", Offset = Vector2.new(244, -258), Size = 64, Hit = 1.2 },
	-- Tira de poco uso (arriba a la derecha)
	{ Id = "Menu", Name = "Menú y tienda", Icon = "Menu", Role = "Utility", Shape = "Square", Anchor = "TopRight", Offset = Vector2.new(-24, 22), Size = 32, Hit = 1.2, Fade = true },
	{ Id = "Scoreboard", Name = "Marcador", Icon = "Scoreboard", Role = "Utility", Shape = "Square", Anchor = "TopRight", Offset = Vector2.new(-70, 22), Size = 32, Hit = 1.2, Fade = true },
	{ Id = "Emotes", Name = "Emotes", Icon = "Emotes", Role = "Utility", Shape = "Square", Anchor = "TopRight", Offset = Vector2.new(-116, 22), Size = 32, Hit = 1.2, Fade = true },
	{ Id = "Spray", Name = "Grafiti", Icon = "Spray", Role = "Utility", Shape = "Square", Anchor = "TopRight", Offset = Vector2.new(-162, 22), Size = 32, Hit = 1.2, Fade = true },
}
MobileHUD.ById = {}
for _, control in MobileHUD.Controls do
	MobileHUD.ById[control.Id] = control
end

-- Aire mínimo entre las zonas táctiles de dos controles en la disposición por defecto (px)
MobileHUD.MinTouchGap = 4

-- Opacidad de cada papel (multiplica la del fondo, el borde y el icono)
MobileHUD.RoleOpacity = { Primary = 1, Action = 0.9, Utility = 0.75 }
-- Al apuntar, los controles marcados con Fade bajan un poco (siguen funcionando)
MobileHUD.AimFade = 0.6

-- Límites de lo que el jugador puede cambiar en el editor (y lo que acepta el servidor)
MobileHUD.Limits = {
	X = { 0, 1 }, -- centro, como fracción del ancho de la zona segura
	Y = { 0, 1 },
	S = { 0.6, 1.6 }, -- tamaño (× el de por defecto)
	O = { 0.25, 1 }, -- opacidad (× la de su papel)
}

-- Radio del centro de la pantalla que se deja libre (la mira, el hitmarker y los avisos de daño)
function MobileHUD.CenterClear(size: Vector2): number
	return math.min(size.X, size.Y) * 0.17
end

local function sizeVector(size: any, scale: number): Vector2
	if typeof(size) == "Vector2" then
		return size * scale
	end
	return Vector2.new(size, size) * scale
end

-- Posición por defecto (centro) y tamaño de un control en una zona segura de `size`
function MobileHUD.Default(control, size: Vector2, scale: number, anchor: Vector2): (Vector2, Vector2)
	local offset = control.Offset * scale
	local center
	if control.Anchor == "Cluster" then
		center = anchor + offset
	elseif control.Anchor == "BottomLeft" then
		center = Vector2.new(offset.X, size.Y + offset.Y)
	else
		center = Vector2.new(size.X + offset.X, offset.Y)
	end
	return center, sizeVector(control.Size, scale)
end

local function clamp(value: any, limits: { number }): number?
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return nil
	end
	return math.floor(math.clamp(value, limits[1], limits[2]) * 1000 + 0.5) / 1000
end

-- Limpia una disposición guardada: solo controles conocidos y números dentro de sus límites. Lo usa
-- el servidor antes de guardar (nunca se fía de lo que manda el cliente) y el cliente al cargarla.
function MobileHUD.Validate(raw: any): { [string]: { X: number?, Y: number?, S: number?, O: number? } }
	local clean = {}
	if type(raw) ~= "table" then
		return clean
	end
	for id, entry in raw do
		if type(id) == "string" and MobileHUD.ById[id] and type(entry) == "table" then
			local item = {}
			for key, limits in MobileHUD.Limits do
				item[key] = clamp(entry[key], limits)
			end
			-- (la posición va por parejas: o las dos o ninguna)
			if item.X == nil or item.Y == nil then
				item.X, item.Y = nil, nil
			end
			if next(item) then
				clean[id] = item
			end
		end
	end
	return clean
end

-- Migración de una disposición guardada con una versión anterior. Nunca borra lo del jugador:
--   * sin personalizar (vacía): se queda vacía → usa la disposición nueva;
--   * personalizada (versión 1, Fase 12): sus posiciones son fracciones de la zona segura y sus
--     tamaños y opacidades multiplicadores, así que siguen valiendo tal cual; los controles que no
--     tocó usan la disposición nueva. Solo se limpia (Validate).
-- Devuelve la disposición y la versión nueva.
function MobileHUD.MigrateLayout(layout: any, version: any): ({ [string]: any }, number)
	local clean = MobileHUD.Validate(layout)
	local _ = version
	return clean, MobileHUD.LayoutVersion
end

-- Disposición final: { [id] = { Center, Size, Hit, Opacity, Shape } } en píxeles de la zona segura.
-- opts: { Breakpoint (clase), Screen = tamaño de la pantalla entera (ViewportSize), Custom =
-- disposición guardada }
function MobileHUD.Resolve(size: Vector2, options: { [string]: any }?)
	local opts: { [string]: any } = options or {}
	local screen = typeof(opts.Screen) == "Vector2" and opts.Screen or size
	local class = opts.Breakpoint or MobileHUD.Classify(size, true, screen)
	if class == "DESKTOP" then
		class = "STANDARD_PHONE" -- (táctil con teclado: como un teléfono normal)
	end
	local scale = MobileHUD.Scale(class, screen)
	local anchor = MobileHUD.ClusterAnchor(class, size, scale, screen)
	local custom = MobileHUD.Validate(opts.Custom)
	local out = {}
	for _, control in MobileHUD.Controls do
		local center, dims = MobileHUD.Default(control, size, scale, anchor)
		local opacity = MobileHUD.RoleOpacity[control.Role] or 1
		local own = custom[control.Id]
		if own then
			if own.X and own.Y then
				center = Vector2.new(own.X * size.X, own.Y * size.Y)
			end
			dims *= own.S or 1
			opacity *= own.O or 1
		end
		-- (que nunca se salga de la zona segura)
		local half = dims / 2
		center = Vector2.new(math.clamp(center.X, half.X, math.max(half.X, size.X - half.X)), math.clamp(center.Y, half.Y, math.max(half.Y, size.Y - half.Y)))
		out[control.Id] = { Center = center, Size = dims, Hit = dims * (control.Hit or 1), Opacity = math.clamp(opacity, 0.05, 1), Shape = control.Shape }
	end
	return out
end

-- Pares de controles que se pisan (para las pruebas y el modo de depuración). `ids`: solo esos.
function MobileHUD.Overlaps(resolved, ids: { string }?, margin: number?): { { string } }
	local list = ids or {}
	if not ids then
		for _, control in MobileHUD.Controls do
			table.insert(list, control.Id)
		end
	end
	local pairs_ = {}
	local m: number = margin or 0
	for i = 1, #list do
		for j = i + 1, #list do
			local a, b = resolved[list[i]], resolved[list[j]]
			if a and b then
				local d = a.Center - b.Center
				local reach = (a.Size + b.Size) / 2 + Vector2.new(m, m)
				-- (círculos inscritos en su caja: se comparan como cajas recortadas)
				if math.abs(d.X) < reach.X * 0.86 and math.abs(d.Y) < reach.Y * 0.86 and d.Magnitude < (math.max(a.Size.X, a.Size.Y) + math.max(b.Size.X, b.Size.Y)) / 2 + m then
					table.insert(pairs_, { list[i], list[j] })
				end
			end
		end
	end
	return pairs_
end

-- Zonas de la pantalla (para la depuración y las pruebas), en píxeles de la zona segura:
--   Center: centro libre (mira) { Center, Radius };
--   Swipe: zona de cámara del pulgar derecho, un rectángulo SIN botones (Min, Max);
--   LeftThumb / RightThumb: dónde viven los controles de cada pulgar (Min, Max).
-- `ids`: los controles visibles (por defecto, todos menos los opcionales).
MobileHUD.Optional = { LeftFire = true, Sprint = true, Airstrike = true }
function MobileHUD.Zones(size: Vector2, resolved, ids: { string }?)
	local list = ids
	if not list then
		list = {}
		for _, control in MobileHUD.Controls do
			if not MobileHUD.Optional[control.Id] then
				table.insert(list, control.Id)
			end
		end
	end
	local clear = MobileHUD.CenterClear(size)
	local function bounds(filter)
		local mn, mx
		for _, id in list do
			local info = resolved[id]
			if info and filter(info) then
				local a, b = info.Center - info.Hit / 2, info.Center + info.Hit / 2
				mn = mn and mn:Min(a) or a
				mx = mx and mx:Max(b) or b
			end
		end
		return mn, mx
	end
	local rightMin, rightMax = bounds(function(info)
		return info.Center.X > size.X / 2 and info.Center.Y > size.Y * 0.35
	end)
	local leftMin, leftMax = bounds(function(info)
		return info.Center.X < size.X / 2 and info.Center.Y > size.Y * 0.35
	end)
	-- Zona de cámara: a la derecha del centro libre y por encima del grupo de combate, sin ningún
	-- botón dentro. Dos candidatas (todo el ancho por debajo de la tira de poco uso, o desde arriba
	-- del todo hasta la tira) y se queda la mayor.
	local top, stripLeft = 0, size.X
	for _, id in list do
		local info = resolved[id]
		if info and info.Center.Y < size.Y * 0.35 and info.Center.X > size.X / 2 then
			top = math.max(top, info.Center.Y + info.Hit.Y / 2 + 4)
			stripLeft = math.min(stripLeft, info.Center.X - info.Hit.X / 2 - 4)
		end
	end
	local function fit(mn: Vector2, mx: Vector2): (Vector2, Vector2)
		for _, id in list do
			local info = resolved[id]
			if info then
				local a, b = info.Center - info.Hit / 2, info.Center + info.Hit / 2
				if a.X < mx.X and b.X > mn.X and a.Y < mx.Y and b.Y > mn.Y then
					mx = Vector2.new(mx.X, math.max(mn.Y, a.Y - 4))
				end
			end
		end
		return mn, mx
	end
	local left = size.X / 2 + clear * 0.6
	local bottom = (rightMin and rightMin.Y or size.Y) - 4
	local aMin, aMax = fit(Vector2.new(left, top), Vector2.new(size.X - 4, bottom))
	local bMin, bMax = fit(Vector2.new(left, 0), Vector2.new(math.max(left, stripLeft), bottom))
	local function area(mn, mx)
		return math.max(0, mx.X - mn.X) * math.max(0, mx.Y - mn.Y)
	end
	local swipeMin, swipeMax = aMin, aMax
	if area(bMin, bMax) > area(aMin, aMax) then
		swipeMin, swipeMax = bMin, bMax
	end
	return {
		Center = { Center = size / 2, Radius = clear },
		Swipe = { Min = swipeMin, Max = swipeMax },
		RightThumb = rightMin and { Min = rightMin, Max = rightMax } or nil,
		LeftThumb = leftMin and { Min = leftMin, Max = leftMax } or nil,
	}
end

-- Métricas de ayuda para revisar una disposición (no son la verdad: ayudan a comparar)
--   Coverage: fracción de la zona segura que tapan los dibujos de los controles;
--   RightHalf: controles en la mitad derecha; SwipeArea: fracción de la pantalla para la cámara;
--   MinGap: menor distancia entre dos dibujos (px); Overlaps: pares que se pisan.
function MobileHUD.Metrics(size: Vector2, resolved, ids: { string }?)
	local list = ids or {}
	if not ids then
		for _, control in MobileHUD.Controls do
			if not MobileHUD.Optional[control.Id] then
				table.insert(list, control.Id)
			end
		end
	end
	local covered, right, minGap = 0, 0, math.huge
	for i, id in list do
		local a = resolved[id]
		if a then
			local control = MobileHUD.ById[id]
			local area = a.Size.X * a.Size.Y
			if control and control.Shape == "Round" then
				area *= math.pi / 4
			end
			covered += area
			if a.Center.X > size.X / 2 then
				right += 1
			end
			for j = i + 1, #list do
				local b = resolved[list[j]]
				if b then
					local gap = (a.Center - b.Center).Magnitude - (math.max(a.Size.X, a.Size.Y) + math.max(b.Size.X, b.Size.Y)) / 2
					minGap = math.min(minGap, gap)
				end
			end
		end
	end
	local zones = MobileHUD.Zones(size, resolved, list)
	local swipe = zones.Swipe.Max - zones.Swipe.Min
	return {
		Coverage = covered / (size.X * size.Y),
		RightHalf = right,
		SwipeArea = math.max(0, swipe.X) * math.max(0, swipe.Y) / (size.X * size.Y),
		MinGap = minGap,
		Overlaps = #MobileHUD.Overlaps(resolved, list, 0),
	}
end

---------------------------------------------------------------------------
-- Detector de solapes (Fase 16). Cada control tiene dos rectángulos:
--   VISUAL: lo que se dibuja (Center ± Size/2);
--   TOUCH: la caja que recoge los toques (Center ± Hit/2, como el botón).
-- Dos controles chocan si sus cajas se cortan (con `gap` de aire). Lo usan las pruebas, la capa de
-- depuración (en rojo) y el editor de HUD.
---------------------------------------------------------------------------

function MobileHUD.Rect(info, kind: string?): (Vector2, Vector2)
	local dims = kind == "Visual" and info.Size or info.Hit
	return info.Center - dims / 2, info.Center + dims / 2
end

local function cut(aMin: Vector2, aMax: Vector2, bMin: Vector2, bMax: Vector2, gap: number): boolean
	return aMin.X < bMax.X + gap and bMin.X < aMax.X + gap and aMin.Y < bMax.Y + gap and bMin.Y < aMax.Y + gap
end
MobileHUD.RectsCut = cut

-- Área (px²) en la que se cortan dos rectángulos
local function overlapArea(aMin: Vector2, aMax: Vector2, bMin: Vector2, bMax: Vector2): number
	local w = math.min(aMax.X, bMax.X) - math.max(aMin.X, bMin.X)
	local h = math.min(aMax.Y, bMax.Y) - math.max(aMin.Y, bMin.Y)
	return (w > 0 and h > 0) and w * h or 0
end
MobileHUD.OverlapArea = overlapArea

-- Choques entre los controles `ids` (por defecto, todos menos los opcionales):
-- { { A, B, Kind = "Visual" | "Touch", Area } }. Visual: los dibujos se cortan; Touch: las cajas
-- táctiles se cortan o quedan a menos de `gap` px.
function MobileHUD.Collisions(resolved, ids: { string }?, gap: number?)
	local list = ids
	if not list then
		list = {}
		for _, control in MobileHUD.Controls do
			if not MobileHUD.Optional[control.Id] then
				table.insert(list, control.Id)
			end
		end
	end
	local g = gap or 0
	local out = {}
	for i = 1, #list do
		for j = i + 1, #list do
			local a, b = resolved[list[i]], resolved[list[j]]
			if a and b then
				local avMin, avMax = MobileHUD.Rect(a, "Visual")
				local bvMin, bvMax = MobileHUD.Rect(b, "Visual")
				local atMin, atMax = MobileHUD.Rect(a, "Touch")
				local btMin, btMax = MobileHUD.Rect(b, "Touch")
				if cut(avMin, avMax, bvMin, bvMax, 0) then
					table.insert(out, { list[i], list[j], Kind = "Visual", Area = overlapArea(avMin, avMax, bvMin, bvMax) })
				elseif cut(atMin, atMax, btMin, btMax, g) then
					table.insert(out, { list[i], list[j], Kind = "Touch", Area = overlapArea(atMin, atMax, btMin, btMax) })
				end
			end
		end
	end
	return out
end

-- Revisión de una disposición propia (editor de HUD). Solo bloquea lo que está roto de verdad:
--   Blocking: dos controles de combate (Critical) uno encima del otro (sus cajas se tapan en más de
--   la mitad de la más pequeña): un dedo no puede elegir entre los dos;
--   Warnings: dos controles de combate cuyas cajas se tocan, o un control dentro del centro libre.
-- (fuera de la pantalla no puede quedar nada: Resolve lo mete siempre dentro)
function MobileHUD.CheckLayout(size: Vector2, resolved, ids: { string }?)
	local list = ids
	if not list then
		list = {}
		for _, control in MobileHUD.Controls do
			table.insert(list, control.Id)
		end
	end
	local blocking, warnings = {}, {}
	for i = 1, #list do
		for j = i + 1, #list do
			local a, b = resolved[list[i]], resolved[list[j]]
			local ca, cb = MobileHUD.ById[list[i]], MobileHUD.ById[list[j]]
			if a and b and ca and cb and ca.Critical and cb.Critical then
				local aMin, aMax = MobileHUD.Rect(a, "Touch")
				local bMin, bMax = MobileHUD.Rect(b, "Touch")
				local area = overlapArea(aMin, aMax, bMin, bMax)
				local smaller = math.min(a.Hit.X * a.Hit.Y, b.Hit.X * b.Hit.Y)
				if area > smaller * 0.5 then
					table.insert(blocking, { list[i], list[j] })
				elseif area > 0 then
					table.insert(warnings, { list[i], list[j] })
				end
			end
		end
	end
	local clear = MobileHUD.CenterClear(size)
	for _, id in list do
		local info = resolved[id]
		if info and (info.Center - size / 2).Magnitude < clear then
			table.insert(warnings, { id, "Center" })
		end
	end
	return { Blocking = blocking, Warnings = warnings }
end

-- Mayor tramo horizontal libre entre xMin y xMax en la franja [y0, y1], esquivando `rects`
-- ({ Min, Max }). Devuelve (x0, x1) o nil. Para colocar avisos de una línea entre los botones.
function MobileHUD.FreeSpan(rects, y0: number, y1: number, xMin: number, xMax: number): (number?, number?)
	local blocked = {}
	for _, r in rects do
		if r.Min.Y < y1 and r.Max.Y > y0 and r.Max.X > xMin and r.Min.X < xMax then
			table.insert(blocked, { math.max(xMin, r.Min.X), math.min(xMax, r.Max.X) })
		end
	end
	table.sort(blocked, function(p, q)
		return p[1] < q[1]
	end)
	local bestA, bestB, cursor = nil, nil, xMin
	local function consider(a, b)
		if b - a > 0 and (not bestA or b - a > bestB - bestA) then
			bestA, bestB = a, b
		end
	end
	for _, seg in blocked do
		consider(cursor, seg[1])
		cursor = math.max(cursor, seg[2])
	end
	consider(cursor, xMax)
	return bestA, bestB
end

return MobileHUD
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
