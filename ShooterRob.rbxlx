	TwoTone = { Body = RGB(176, 152, 112), Panel = RGB(48, 50, 54), Dark = RGB(30, 30, 33), Accent = RGB(255, 140, 40), Accent2 = RGB(120, 84, 50), Lens = RGB(70, 120, 175), PanelMaterial = MAT.Metal, AccentMaterial = MAT.SmoothPlastic },
	-- Cuchillo: hoja de acero, mango negro
	Knife = { Body = RGB(40, 40, 44), Panel = RGB(150, 152, 158), Dark = RGB(170, 172, 178), Accent = RGB(120, 122, 128), Accent2 = RGB(200, 200, 205), Lens = RGB(70, 120, 175), PanelMaterial = MAT.Metal, AccentMaterial = MAT.Metal },
}
Weapons.ClassicPalettes = CLASSIC_PALETTES
local CLASSIC_LOOK = {
	ARX27 = "Black", HavocPump = "Wood", Specter9 = "Black", Signal7 = "Wood", VortexBR = "Tan",
	NovaDrift = "Olive", RaptorDMR = "Wood", BreachHammer = "Black", TitanLMG = "Olive", GhostlineXR = "Tan",
	NovaLauncher = "Olive", Viper = "Black", HandCannon = "Steel", PhantomSidewind = "TwoTone", Knife = "Knife",
}
if Weapons.Style == "Clasico" then
	for name, def in Weapons.List do
		for key, value in Classic.Points[name] or {} do
			def[key] = value
		end
		local build = Classic[name]
		if build then
			def.Parts = build(def)
			-- Nombres únicos (las piezas repetidas del bisel se numeran: Edge, Edge2, Edge3...)
			local seen = {}
			for _, part in def.Parts do
				local count = (seen[part.Name] or 0) + 1
				seen[part.Name] = count
				if count > 1 then
					part.Name ..= count
				end
			end
		end
		local look = CLASSIC_LOOK[name]
		if look then
			def.Palette = CLASSIC_PALETTES[look]
		end
	end
end

function Weapons.Get(name)
	if name == "Grenade" then
		return Weapons.Grenade
	elseif name == "Airstrike" then
		return Weapons.Airstrike
	end
	return Weapons.List[name] or Weapons.List[Weapons.Legacy[name] or ""]
end

-- Recarga táctica (como en los shooters realistas): si aún quedan balas en el cargador no hay que
-- montar el arma, así que es más rápida; con el cargador vacío dura el ReloadTime completo
Weapons.TacticalReload = 0.8
function Weapons.ReloadDuration(def, empty)
	local base = def.ReloadTime or 2
	return empty and base or base * Weapons.TacticalReload
end

-- ¿Puede el jugador usar esta arma? (nivel alcanzado o comprada con monedas)
function Weapons.IsUnlocked(name, data)
	local def = Weapons.List[name]
	if not def then
		return false
	end
	if (def.UnlockLevel or 1) <= 1 then
		return true
	end
	if not data then
		return false
	end
	return (data.Level or 1) >= def.UnlockLevel or (data.OwnedWeapons ~= nil and data.OwnedWeapons[name] == true)
end

return Weapons
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="24">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="25">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="26">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Punto de entrada del servidor: inicia todos los sistemas en orden.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

require(ReplicatedStorage.Shared.Remotes) -- crea los RemoteEvents antes que nada

local Modules = script.Parent.Modules
local MapBuilder = require(Modules.MapBuilder)
local PlayerData = require(Modules.PlayerData)
local Loadout = require(Modules.Loadout)
local Combat = require(Modules.Combat)
local Round = require(Modules.Round)
local Dummies = require(Modules.Dummies)
local Hazards = require(Modules.Hazards)
local Grenades = require(Modules.Grenades)
local Leaderboard = require(Modules.Leaderboard)
local Killstreaks = require(Modules.Killstreaks)
local Respawn = require(Modules.Respawn)
local Abilities = require(Modules.Abilities)
local Bots = require(Modules.Bots)
local Gifts = require(Modules.Gifts)
local Friends = require(Modules.Friends)
local Event = require(Modules.Event)
local Graffiti = require(Modules.Graffiti)
local HealthRegen = require(Modules.HealthRegen)


-- Arranca cada sistema por separado: si uno falla, se avisa en Output y los demás siguen
local function start(name, fn, ...)
	local ok, err = xpcall(fn, debug.traceback, ...)
	if not ok then
		warn("[Arranque] " .. name .. " falló: " .. tostring(err))
	end
end

start("MapBuilder", MapBuilder.Build) -- primer mapa de la rotación (o tu mapa propio si existe workspace.Map)
start("PlayerData", PlayerData.Init)
start("Loadout", Loadout.Init)
start("Combat", Combat.Init)
Combat.OnKill = Round.RegisterKill
Combat.OnAssist = Round.RegisterAssist
start("Round", Round.Init)
start("Respawn", Respawn.Init) -- reaparición propia (CharacterAutoLoads desactivado): después de Round
start("Dummies", Dummies.Init)
start("Hazards", Hazards.Init)
start("Grenades", Grenades.Init)
start("Leaderboard", Leaderboard.Init)
start("Killstreaks", Killstreaks.Init)
start("Abilities", Abilities.Init)
start("Bots", Bots.Init)
start("Gifts", Gifts.Init)
start("Friends", Friends.Init)
start("Event", Event.Init)
start("Graffiti", Graffiti.Init)
start("HealthRegen", HealthRegen.Init)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="27">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Abilities</string>
            <string name="Source"><![CDATA[-- Habilidades: Impulso (E) y Supersalto (Z) se mueven en el cliente (el personaje es suyo en la
-- física); el servidor solo valida la Poción (X), que cura con el tiempo, y avisa a los demás para
-- que vean el efecto.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)

local Abilities = {}

local lastPotion = {} -- [player] = os.clock()

local function healEffect(character)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "PotionFX"
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(90, 255, 120), Color3.fromRGB(200, 255, 140))
	emitter.LightEmission = 0.8
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	emitter.Lifetime = NumberRange.new(0.8, 1.2)
	emitter.Speed = NumberRange.new(2, 4)
	emitter.SpreadAngle = Vector2.new(40, 40)
	emitter.Acceleration = Vector3.new(0, 4, 0)
	emitter.Rate = 30
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Parent = root
	task.delay(GameConfig.Abilities.Potion.Duration, function()
		emitter.Enabled = false
		task.wait(1.2)
		emitter:Destroy()
	end)
end

-- Cura poco a poco; se corta si el jugador muere
local function usePotion(player)
	local config = GameConfig.Abilities.Potion
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or player:GetAttribute("InMenu") then
		return false
	end
	local now = os.clock()
	if lastPotion[player] and now - lastPotion[player] < config.Cooldown - 0.25 then
		return false
	end
	lastPotion[player] = now
	healEffect(character)
	local steps = 10
	task.spawn(function()
		for _ = 1, steps do
			task.wait(config.Duration / steps)
			if humanoid.Parent == nil or humanoid.Health <= 0 then
				return
			end
			humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + config.Heal / steps)
		end
	end)
	return true
end
Abilities.UsePotion = usePotion

function Abilities.Init()
	Remotes.UsePotion.OnServerInvoke = usePotion
	Players.PlayerRemoving:Connect(function(player)
		lastPotion[player] = nil
	end)
end

return Abilities
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Badges</string>
            <string name="Source"><![CDATA[-- Insignias de Roblox (BadgeService). Se dan solas al cumplir cada logro. Con ID 0 no se da
-- (créalas en el Creator Hub → tu experiencia → Insignias y pega los ID en GameConfig.Badges).
local BadgeService = game:GetService("BadgeService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local Ranks = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Ranks"))

local Badges = {}

local awarded = {} -- [player] = { [nombre] = true } (para no repetir llamadas en la sesión)

-- Logros: nombre en GameConfig.Badges -> condición sobre los datos del jugador
local RULES = {
	{ Name = "Welcome", Check = function(_data)
		return true
	end },
	{ Name = "FirstKill", Check = function(data)
		return (data.TotalKills or 0) >= 1
	end },
	{ Name = "Kills100", Check = function(data)
		return (data.TotalKills or 0) >= 100
	end },
	{ Name = "FirstWin", Check = function(data)
		return (data.Wins or 0) >= 1
	end },
	{ Name = "Level10", Check = function(data)
		return (data.Level or 1) >= 10
	end },
	{ Name = "RankGold", Check = function(data)
		return math.max(data.RankBest or 1, Ranks.Index(data.RankPoints)) >= 3
	end },
	{ Name = "RankDiamond", Check = function(data)
		return math.max(data.RankBest or 1, Ranks.Index(data.RankPoints)) >= 5
	end },
	{ Name = "RankChampion", Check = function(data)
		return math.max(data.RankBest or 1, Ranks.Index(data.RankPoints)) >= 6
	end },
}

local function award(player, name)
	local id = GameConfig.Badges and GameConfig.Badges[name]
	if type(id) ~= "number" or id == 0 then
		return
	end
	awarded[player] = awarded[player] or {}
	if awarded[player][name] then
		return
	end
	awarded[player][name] = "pending"
	task.spawn(function()
		local ok, has = pcall(BadgeService.UserHasBadgeAsync, BadgeService, player.UserId, id)
		local done = ok and has
		if ok and not has and player.Parent then
			done = pcall(BadgeService.AwardBadge, BadgeService, player.UserId, id)
		end
		-- Si falló (p. ej. demasiadas peticiones), se reintenta la próxima vez que se compruebe
		if awarded[player] then
			awarded[player][name] = done and true or nil
		end
	end)
end

-- Revisa los logros con los datos actuales (lo llama PlayerData al cargar y cuando cambian)
function Badges.Check(player, data)
	if not data then
		return
	end
	for _, rule in RULES do
		if rule.Check(data) then
			award(player, rule.Name)
		end
	end
end

function Badges.Forget(player)
	awarded[player] = nil
end

return Badges
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Bomb</string>
            <string name="Source"><![CDATA[-- Buscar y destruir: la bomba de cada ronda. Los atacantes la plantan quedándose dentro de un sitio
-- (A o B, en la mitad de los defensores) PLANT_TIME segundos; los defensores la desactivan quedándose
-- junto a ella DEFUSE_TIME segundos antes de que explote (BOMB_TIME). Round decide la ronda con
-- Bomb.Result ("Exploded" / "Defused") y Bomb.Planted.
--
-- Estado para la interfaz (atributos de ReplicatedStorage):
--   Bomb_Attackers / Bomb_Defenders (nombres de equipo), Bomb_A_Position / Bomb_B_Position,
--   Bomb_State ("Idle" | "Planted" | "Exploded" | "Defused"), Bomb_Site (letra), Bomb_Timer (s),
--   Bomb_Action ("Planting" | "Defusing" | ""), Bomb_Progress (0..1),
--   Bomb_Carrier (nombre de quien lleva la bomba), Bomb_Dropped (Vector3 si está en el suelo)
-- Como en los shooters: solo un atacante lleva la bomba y solo él puede plantarla. Si cae, la bomba
-- se queda en el suelo y cualquier atacante la recoge pasando por encima.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Remotes = require(Shared.Remotes)
local GameConfig = require(Shared.GameConfig)

local PlayerData = require(script.Parent.PlayerData)

local Bomb = {}

local STEP = 0.25

local active = false
local sites = {} -- { Letter, Position, Radius, Visual }
local PICKUP_RADIUS = 5
local carrier -- { Model, Player, Name, LastPosition }
local droppedAt -- Vector3: la bomba está en el suelo
local droppedTime = 0
local RETURN_TIME = 20 -- si nadie la recoge en este tiempo (p. ej. cayó al agua), vuelve a un atacante
local droppedVisual
local thread
local visuals = {}

Bomb.Result = nil
Bomb.Planted = false
Bomb.Site = nil

local function settings()
	return GameConfig.ModeSettings.SND or {}
end

local function findSites(defenderIndex)
	local list = {}
	local map = workspace:FindFirstChild("Map")
	if map then
		for _, d in map:GetDescendants() do
			if d:IsA("BasePart") and d.Name == "BombSite" and (defenderIndex == nil or d:GetAttribute("Defender") == defenderIndex) then
				table.insert(list, d)
			end
		end
	end
	table.sort(list, function(a, b)
		return (a:GetAttribute("Letter") or "") < (b:GetAttribute("Letter") or "")
	end)
	return list
end

-- ¿Tiene el mapa sitios para los dos equipos?
function Bomb.IsAvailable()
	return #findSites(1) >= 1 and #findSites(2) >= 1
end

local function makeVisual(site, color)
	local model = Instance.new("Model")
	model.Name = "BombSite_" .. site.Letter
	local ring = Instance.new("Part")
	ring.Name = "Ring"
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.3, site.Radius * 2, site.Radius * 2)
	ring.CFrame = CFrame.new(site.Position + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	ring.Material = Enum.Material.ForceField
	ring.Color = color
	ring.Transparency = 0.2
	ring.Parent = model
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(60, 60)
	billboard.StudsOffset = Vector3.new(0, 6, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = 1500
	billboard.Parent = ring
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextStrokeTransparency = 0.2
	label.Text = "💣" .. site.Letter
	label.TextColor3 = color
	label.Parent = billboard
	model.Parent = workspace
	table.insert(visuals, model)
	return model
end

-- Vivos de un equipo dentro de un radio: { jugadores } y cuántos (los bots cuentan, sin lista)
local function inside(team, position, radius)
	local players, count = {}, 0
	local function check(root)
		local offset = root.Position - position
		return Vector3.new(offset.X, 0, offset.Z).Magnitude <= radius and math.abs(offset.Y) < 8
	end
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if player.Team == team and humanoid and humanoid.Health > 0 and root and not player:GetAttribute("InMenu") and check(root) then
			table.insert(players, player)
			count += 1
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart")
			if model:GetAttribute("Team") == team.Name and humanoid and humanoid.Health > 0 and root and check(root) then
				count += 1
			end
		end
	end
	return players, count
end

local function explode(site)
	local position = site.Position + Vector3.new(0, 1, 0)
	Remotes.ExplosionFX:FireAllClients(position, 26)
	-- La explosión elimina a quien esté muy cerca (sin baja para nadie)
	local victims = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(victims, player.Character)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			table.insert(victims, model)
		end
	end
	for _, model in victims do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local root = model:FindFirstChild("HumanoidRootPart")
		if humanoid and root and humanoid.Health > 0 and (root.Position - position).Magnitude < 22 then
			humanoid:SetAttribute("LastAttacker", nil)
			humanoid:SetAttribute("LastBot", nil)
			humanoid:TakeDamage(500)
		end
	end
end

local function setAttr(name, value)
	ReplicatedStorage:SetAttribute("Bomb_" .. name, value)
end

-- Miembros vivos de un equipo (jugadores y bots): { Model, Player, Name, Root }
local function aliveMembers(team)
	local list = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if player.Team == team and humanoid and humanoid.Health > 0 and root and not player:GetAttribute("InMenu") then
			table.insert(list, { Model = character, Player = player, Name = player.Name, Root = root })
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart")
			if model:GetAttribute("Team") == team.Name and humanoid and humanoid.Health > 0 and root then
				table.insert(list, { Model = model, Name = model.Name, Root = root })
			end
		end
	end
	return list
end

-- Raíz del portador si sigue vivo (si murió o reapareció con otro cuerpo, nil)
local function carrierRoot()
	if not carrier then
		return nil
	end
	local model = carrier.Model
	if not model or not model.Parent or (carrier.Player and carrier.Player.Character ~= model) then
		return nil
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and root then
		return root
	end
	return nil
end

local function clearDropped()
	droppedAt = nil
	if droppedVisual then
		droppedVisual:Destroy()
		droppedVisual = nil
	end
	setAttr("Dropped", nil)
end

local function setCarrier(member)
	clearDropped()
	carrier = member and { Model = member.Model, Player = member.Player, Name = member.Name, LastPosition = member.Root.Position } or nil
	setAttr("Carrier", member and member.Name or nil)
	if member and member.Player then
		Remotes.Notify:FireClient(member.Player, "Big", "💣 ¡LLEVAS LA BOMBA! Plántala en A o B")
	end
end

-- Suelo bajo el punto donde cayó el portador (ignorando personajes): nil si no hay suelo o si es
-- agua o lava (ahí no se podría recoger)
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
local function groundBelow(position)
	local ignore = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(ignore, player.Character)
		end
	end
	for _, name in { "Bots", "Grenades", "ClientFX" } do
		local folder = workspace:FindFirstChild(name)
		if folder then
			table.insert(ignore, folder)
		end
	end
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	groundParams.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(position + Vector3.new(0, 1, 0), Vector3.new(0, -60, 0), groundParams)
	if not hit then
		return nil
	end
	local bad = hit.Material == Enum.Material.Water or hit.Material == Enum.Material.CrackedLava
		or hit.Instance:GetAttribute("Hazard") ~= nil
	return not bad and hit.Position or nil
end

-- El portador cae: la bomba se queda en el suelo (a la vista de todos, pero el aviso en pantalla y en
-- el minimapa es solo para los atacantes). Si cae donde no se puede recoger, pasa a otro atacante.
local function dropBomb(position, attackers)
	carrier = nil
	setAttr("Carrier", nil)
	local ground = groundBelow(position)
	if not ground then
		local members = aliveMembers(attackers)
		if #members > 0 then
			setCarrier(members[math.random(1, #members)])
		end
		return
	end
	droppedAt = ground + Vector3.new(0, 3, 0) -- (a la altura de la cadera de quien la recoge)
	droppedTime = os.clock()
	setAttr("Dropped", droppedAt)
	local part = Instance.new("Part")
	part.Name = "DroppedBomb"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Size = Vector3.new(1.4, 0.8, 1)
	part.Color = Color3.fromRGB(60, 60, 55)
	part.Material = Enum.Material.Metal
	part.CFrame = CFrame.new(ground + Vector3.new(0, 0.4, 0))
	part.Parent = workspace
	droppedVisual = part
	for _, player in Players:GetPlayers() do
		if player.Team == attackers then
			Remotes.Notify:FireClient(player, "Info", "💣 ¡La bomba está en el suelo! Recógela")
		end
	end
end

-- Cada paso sin plantar: quién lleva la bomba (si su portador cae, se queda en el suelo)
-- Devuelve true si cambia de manos (el progreso de plantar no pasa al nuevo portador)
local function updateCarrier(attackers)
	if carrier then
		local root = carrierRoot()
		if root then
			carrier.LastPosition = root.Position
			return false
		end
		dropBomb(carrier.LastPosition, attackers)
		if carrier then
			return true -- (cayó donde no se podía recoger: ya la lleva otro)
		end
	end
	local members = aliveMembers(attackers)
	if droppedAt then
		for _, member in members do
			local offset = member.Root.Position - droppedAt
			if Vector3.new(offset.X, 0, offset.Z).Magnitude <= PICKUP_RADIUS and math.abs(offset.Y) < 6 then
				setCarrier(member)
				return true
			end
		end
		if os.clock() - droppedTime > RETURN_TIME and #members > 0 then
			setCarrier(members[math.random(1, #members)])
			return true
		end
	elseif #members > 0 then
		setCarrier(members[math.random(1, #members)])
		return true
	end
	return false
end

-- ¿Está el portador dentro del sitio?
local function carrierIn(site)
	local root = carrierRoot()
	if not root then
		return false
	end
	local offset = root.Position - site.Position
	return Vector3.new(offset.X, 0, offset.Z).Magnitude <= site.Radius and math.abs(offset.Y) < 8
end

-- La bomba plantada en el suelo (caja con panel y una luz roja; el cliente la hace parpadear y pitar,
-- ver BombHUD). Va en visuals: se quita con Stop
local plantedModel
local function placeBomb(site)
	local ground = groundBelow(site.Position + Vector3.new(0, 3, 0)) or site.Position
	local model = Instance.new("Model")
	model.Name = "PlantedBomb"
	local function piece(name, size, offset, color, material)
		local part = Instance.new("Part")
		part.Name = name
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Size = size
		part.CFrame = CFrame.new(ground + offset)
		part.Color = color
		part.Material = material
		part.Parent = model
		return part
	end
	piece("Case", Vector3.new(1.8, 0.7, 1.2), Vector3.new(0, 0.35, 0), Color3.fromRGB(58, 60, 52), Enum.Material.Metal)
	piece("Panel", Vector3.new(0.9, 0.08, 0.6), Vector3.new(-0.3, 0.74, 0), Color3.fromRGB(30, 34, 30), Enum.Material.SmoothPlastic)
	piece("Wires", Vector3.new(0.15, 0.1, 0.9), Vector3.new(0.55, 0.74, 0), Color3.fromRGB(170, 40, 30), Enum.Material.SmoothPlastic)
	local light = piece("BombLight", Vector3.new(0.22, 0.22, 0.22), Vector3.new(0.4, 0.82, 0.3), Color3.fromRGB(255, 40, 30), Enum.Material.Neon)
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 50, 40)
	glow.Range = 6
	glow.Brightness = 2
	glow.Parent = light
	model.Parent = workspace
	table.insert(visuals, model)
	plantedModel = model
end

-- Empieza una ronda: attackers plantan en los sitios de la mitad de defenders
function Bomb.Start(attackers, defenders)
	Bomb.Stop()
	local defenderIndex = 1
	for i, cfg in GameConfig.Teams do
		if cfg.Name == defenders.Name then
			defenderIndex = i
		end
	end
	sites = {}
	for _, part in findSites(defenderIndex) do
		local site = { Letter = part:GetAttribute("Letter") or "A", Position = part.Position, Radius = part:GetAttribute("Radius") or 7 }
		site.Visual = makeVisual(site, Color3.fromRGB(255, 200, 60))
		setAttr(site.Letter .. "_Position", site.Position)
		table.insert(sites, site)
	end
	if #sites == 0 then
		return false
	end
	local s = settings()
	local plantTime, defuseTime, bombTime = s.PlantTime or 4, s.DefuseTime or 6, s.BombTime or 35
	Bomb.Result, Bomb.Planted, Bomb.Site = nil, false, nil
	carrier = nil
	clearDropped()
	setAttr("Carrier", nil)
	setAttr("Attackers", attackers.Name)
	setAttr("Defenders", defenders.Name)
	setAttr("State", "Idle")
	setAttr("Action", "")
	setAttr("Progress", 0)
	setAttr("Site", nil)
	setAttr("Timer", nil)
	active = true
	thread = task.spawn(function()
		local progress, site, explodeAt = 0, nil, nil
		while active do
			-- (el progreso con el tiempo de verdad: con el servidor cargado la espera dura más)
			local dt = task.wait(STEP)
			if not Bomb.Planted then
				-- Plantar: el portador de la bomba, vivo dentro de un sitio y sin salir de él
				if updateCarrier(attackers) then
					progress, site = 0, nil
				end
				local here, players = nil, {}
				if site and carrierIn(site) then
					here = site
				end
				for _, candidate in sites do
					if here then
						break
					end
					if carrierIn(candidate) then
						here = candidate
					end
				end
				if here and carrier and carrier.Player then
					players = { carrier.Player }
				end
				if here and (site == nil or site == here) then
					site = here
					progress += dt / plantTime
					setAttr("Action", "Planting")
					setAttr("Site", site.Letter)
					if progress >= 1 then
						Bomb.Planted, Bomb.Site = true, site.Letter
						local placed, placeError = pcall(placeBomb, site)
						if not placed then
							warn("[Bomba] no se pudo colocar la bomba:", placeError)
						end
						carrier = nil
						setAttr("Carrier", nil)
						explodeAt = os.clock() + bombTime
						progress = 0
						setAttr("State", "Planted")
						setAttr("Action", "")
						Remotes.Notify:FireAllClients("Big", "💣 ¡BOMBA PLANTADA EN " .. site.Letter .. "!")
						for _, player in players do
							task.spawn(PlayerData.AddXP, player, 50, "💣 Bomba plantada")
						end
						for _, visual in visuals do
							if visual.Name ~= "BombSite_" .. site.Letter and visual.Name ~= "PlantedBomb" then
								visual:Destroy()
							end
						end
						local ring = site.Visual and site.Visual:FindFirstChild("Ring")
						if ring then
							ring.Color = Color3.fromRGB(255, 50, 40)
						end
					end
				else
					progress, site = 0, nil
					setAttr("Action", "")
					setAttr("Site", nil)
				end
				setAttr("Progress", math.floor(progress * 100 + 0.5) / 100)
			else
				local remaining = explodeAt - os.clock()
				setAttr("Timer", math.max(0, math.ceil(remaining)))
				-- Desactivar: algún defensor vivo junto a la bomba
				local players, count = inside(defenders, site.Position, site.Radius)
				if count > 0 then
					progress += dt / defuseTime
					setAttr("Action", "Defusing")
					if progress >= 1 then
						Bomb.Result = "Defused"
						setAttr("State", "Defused")
						setAttr("Action", "")
						Remotes.Notify:FireAllClients("Big", "✅ ¡BOMBA DESACTIVADA!")
						for _, player in players do
							task.spawn(PlayerData.AddXP, player, 60, "✅ Bomba desactivada")
						end
						active = false
					end
				else
					progress = 0
					setAttr("Action", "")
				end
				setAttr("Progress", math.floor(progress * 100 + 0.5) / 100)
				if active and remaining <= 0 then
					Bomb.Result = "Exploded"
					setAttr("State", "Exploded")
					setAttr("Action", "")
					explode(site)
					if plantedModel then
						plantedModel:Destroy() -- (ha volado)
						plantedModel = nil
					end
					Remotes.Notify:FireAllClients("Big", "💥 ¡LA BOMBA HA EXPLOTADO!")
					active = false
				end
			end
		end
	end)
	return true
end

-- Para los bots: los sitios de esta ronda
function Bomb.Sites()
	return sites
end

function Bomb.Stop()
	active = false
	if thread and coroutine.status(thread) ~= "dead" and thread ~= coroutine.running() then
		pcall(task.cancel, thread)
	end
	thread = nil
	for _, visual in visuals do
		visual:Destroy()
	end
	visuals = {}
	sites = {}
	plantedModel = nil
	carrier = nil
	clearDropped()
	for _, name in { "Attackers", "Defenders", "A_Position", "B_Position", "State", "Site", "Timer", "Action", "Progress", "Carrier" } do
		setAttr(name, nil)
	end
end

return Bomb
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Bots</string>
            <string name="Source"><![CDATA[-- Bots: rellenan la partida cuando hay pocos jugadores (GameConfig.Bots). Llevan un arma de verdad
-- (los demás ven trazadoras, fogonazo y sonido como con un jugador), recorren el mapa con
-- PathfindingService, buscan enemigos con línea de visión y fallan más cuanto más lejos disparan.
-- Cuentan para el marcador por equipos y dan algo de XP y monedas, pero no para la clasificación global.
-- Solo durante la ronda; en "Escalada de armas" no hay bots. En Eliminación (NoRespawn) no reaparecen
-- hasta la ronda siguiente (Round llama a Bots.RespawnAll).
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Weapons = require(Shared.Weapons)
local Remotes = require(Shared.Remotes)

local Combat = require(script.Parent.Combat)
local Pumpkins = require(script.Parent.Pumpkins)
local Loadout = require(script.Parent.Loadout)
local Zombie = require(script.Parent.Zombie)
local Grenades = require(script.Parent.Grenades)
local SpawnPicker = require(script.Parent.SpawnPicker)
local Domination = require(script.Parent.Domination)
local Bomb = require(script.Parent.Bomb)
local Outfits = require(Shared.Outfits)
local Shop = require(Shared.Shop)

-- Trajes que pueden llevar los bots (los de la tienda: así se ven en partida)
local BOT_OUTFITS = {}
for id in Shop.OutfitPrices do
	if Outfits.List[id] and not Outfits.List[id].Event then
		table.insert(BOT_OUTFITS, id)
	end
end
table.sort(BOT_OUTFITS)
-- Skins de arma que pueden llevar (las de la tienda)
local BOT_SKINS = {}
for id in Shop.SkinPrices do
	table.insert(BOT_SKINS, id)
end
table.sort(BOT_SKINS)
-- Colgantes de arma que pueden llevar
local Charms = require(Shared.Charms)
local BOT_CHARMS = {}
for id, charm in Charms.List do
	if charm.Price then
		table.insert(BOT_CHARMS, id)
	end
end
table.sort(BOT_CHARMS)

local Bots = {}

local CONFIG = GameConfig.Bots
local NAMES = { "Tito", "Luna", "Max", "Kira", "Rocco", "Nova", "Pipo", "Zara", "Dante", "Mia", "Toby", "Vega", "Bruno", "Sofi", "Leo", "Iris", "Hugo", "Nala", "Thor", "Cleo" }

local folder
local statsFolder -- ReplicatedStorage.BotStats: una carpeta por bot con Team, Kills, Deaths y Score (marcador)
local agents = {} -- lista de bots activos
local nameIndex = 0

local function state()
	return ReplicatedStorage:GetAttribute("State")
end

local function noRespawn()
	return ReplicatedStorage:GetAttribute("NoRespawn") == true
end

-- Cuenta atrás de Eliminación: todos quietos y sin disparar
local function frozen()
	return ReplicatedStorage:GetAttribute("Frozen") == true
end

local function teamMode()
	return ReplicatedStorage:GetAttribute("TeamMode") == true
end

-- ¿Cuántos bots hacen falta ahora mismo?
local function desiredCount()
	-- (en la Escalada de armas también: son rivales para subir de arma, aunque ellos no suben)
	if not CONFIG.Enabled or state() ~= "Playing" then
		return 0
	end
	return math.max(0, CONFIG.FillTo - #Players:GetPlayers())
end

-- Equipo con menos miembros (jugadores + bots)
local function pickTeam()
	if not teamMode() then
		return nil
	end
	-- Infección: antes de la infección, superviviente (equipo A); después, zombi (equipo B)
	local infection = ReplicatedStorage:GetAttribute("Infection")
	if infection then
		return Teams:FindFirstChild(ReplicatedStorage:GetAttribute(infection == "On" and "TeamB" or "TeamA") or "")
	end
	local best, bestCount = nil, math.huge
	for _, team in Teams:GetTeams() do
		local count = #team:GetPlayers()
		for _, agent in agents do
			if agent.Team == team then
				count += 1
			end
		end
		if count < bestCount then
			best, bestCount = team, count
		end
	end
	return best
end

-- Puntos del mapa (se guardan hasta que cambia el mapa: recorrer todas las piezas es caro)
local cachedMap, spawnsByColor, ffaPoints, botSpots = nil, {}, {}, {}
local function refreshPoints()
	local map = workspace:FindFirstChild("Map")
	if map == cachedMap and map ~= nil and map.Parent ~= nil then
		return
	end
	cachedMap, spawnsByColor, ffaPoints, botSpots = map, {}, {}, {}
	if not map then
		return
	end
	for _, d in map:GetDescendants() do
		if d:IsA("SpawnLocation") then
			local key = d.TeamColor.Name
			spawnsByColor[key] = spawnsByColor[key] or {}
			table.insert(spawnsByColor[key], d.Position)
		elseif d:IsA("BasePart") and d.Name == "FFASpawn" then
			table.insert(ffaPoints, d.Position)
		elseif d:IsA("BasePart") and d.Name == "BotSpot" then
			table.insert(botSpots, { Position = d.Position, Look = d:GetAttribute("Look") })
		end
	end
end

local function spawnPoint(team)
	refreshPoints()
	local points = team and spawnsByColor[team.TeamColor.Name] or {}
	if #points == 0 then
		points = ffaPoints
	end
	if #points == 0 then
		return Vector3.new(0, 10, 0)
	end
	return points[math.random(1, #points)] + Vector3.new(0, 4, 0)
end

-- Pinta al bot con los colores de su equipo (o de color aleatorio en todos contra todos)
local function makeDescription(team, zombie)
	local description = Instance.new("HumanoidDescription")
	local shirt = team and team.TeamColor.Color or Color3.fromHSV(math.random(), 0.6, 0.85)
	local skin = ({ Color3.fromRGB(255, 205, 160), Color3.fromRGB(200, 150, 110), Color3.fromRGB(140, 95, 65), Color3.fromRGB(255, 220, 190) })[math.random(1, 4)]
	if zombie then
		skin = Zombie.Skin
	end
	description.HeadColor = skin
	description.LeftArmColor = skin
	description.RightArmColor = skin
	description.TorsoColor = shirt
	description.LeftLegColor = Color3.fromRGB(45, 48, 60)
	description.RightLegColor = Color3.fromRGB(45, 48, 60)
	return description
end

local function isEnemyOf(agent, otherTeam)
	if not teamMode() then
		return true
	end
	return agent.Team ~= otherTeam
end

-- Objetivos posibles: jugadores vivos fuera del menú y sin escudo, y bots enemigos
local function candidates(agent)
	local list = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local head = character and character:FindFirstChild("Head")
		if humanoid and head and humanoid.Health > 0 and not player:GetAttribute("InMenu")
			and not character:FindFirstChildOfClass("ForceField") and isEnemyOf(agent, player.Team) then
			table.insert(list, { Model = character, Humanoid = humanoid, Head = head, Wanted = (player:GetAttribute("Bounty") or 0) > 0 })
		end
	end
	for _, other in agents do
		if other ~= agent and other.Humanoid and other.Humanoid.Health > 0 and isEnemyOf(agent, other.Team) then
			local head = other.Model:FindFirstChild("Head")
			if head then
				table.insert(list, { Model = other.Model, Humanoid = other.Humanoid, Head = head })
			end
		end
	end
	return list
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

-- ¿Se puede pisar ahí? (no agua ni lava). Sin nada debajo cuenta como sí (como antes): solo evita
-- que se tiren al agua del canal o a la lava persiguiendo o esquivando.
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
local function safeGround(position)
	local map = workspace:FindFirstChild("Map")
	if not map then
		return true
	end
	groundParams.FilterDescendantsInstances = { map, workspace.Terrain }
	local hit = workspace:Raycast(position + Vector3.new(0, 3, 0), Vector3.new(0, -9, 0), groundParams)
	return not hit or (hit.Material ~= Enum.Material.Water and hit.Material ~= Enum.Material.CrackedLava)
end

local function canSee(agent, target)
	local head = agent.Model:FindFirstChild("Head")
	if not head then
		return false
	end
	local ignore = { agent.Model }
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	rayParams.FilterDescendantsInstances = ignore
	local direction = target.Head.Position - head.Position
	local hit = workspace:Raycast(head.Position, direction, rayParams)
	return hit == nil or hit.Instance:IsDescendantOf(target.Model)
end

-- Visión: los bots no ven por la espalda. Se fijan en lo que tienen delante (cono de VISION_ANGLE
-- grados), en quien está muy cerca, en quien les acaba de disparar y en con quien ya peleaban.
-- Así flanquear y atacar por detrás funciona, como contra una persona.
local VISION_DOT = math.cos(math.rad(70)) -- 140° en total
local NOTICE_DISTANCE = 14

-- ¿Le ha disparado este objetivo hace poco?
local function hitBy(agent, target)
	local humanoid = agent.Humanoid
	local hitTime = humanoid and humanoid:GetAttribute("LastHitTime")
	if not hitTime or os.clock() - hitTime > 3 then
		return false
	end
	local attackerId = humanoid:GetAttribute("LastAttacker")
	if attackerId then
		local player = Players:GetPlayerFromCharacter(target.Model)
		return player ~= nil and player.UserId == attackerId
	end
	return humanoid:GetAttribute("LastBot") == target.Model.Name
end

local function notices(agent, target)
	if agent.Target == target.Model or target.Distance < NOTICE_DISTANCE then
		return true
	end
	local offset = target.Head.Position - agent.Root.Position
	if offset.Magnitude > 0 and agent.Root.CFrame.LookVector:Dot(offset.Unit) > VISION_DOT then
		return true
	end
	return hitBy(agent, target)
end

-- El enemigo visible más cercano: se ordenan por distancia y solo se lanzan rayos hasta encontrar
-- uno a la vista (antes se comprobaban todos)
local function findTarget(agent)
	local root = agent.Root
	local inRange = {}
	for _, target in candidates(agent) do
		local distance = (target.Head.Position - root.Position).Magnitude
		if distance < CONFIG.Range then
			target.Distance = distance
			table.insert(inRange, target)
		end
	end
	-- (el buscado, "SE BUSCA", atrae a los bots: cuenta como si estuviera más cerca)
	table.sort(inRange, function(x, y)
		return x.Distance * (x.Wanted and 0.6 or 1) < y.Distance * (y.Wanted and 0.6 or 1)
	end)
	for _, target in inRange do
		if notices(agent, target) and canSee(agent, target) then
			return target, target.Distance
		end
	end
	return nil, CONFIG.Range
end

-- Le han disparado y no ve a nadie: se gira hacia el disparo y va a ver qué pasa
local function checkAlert(agent, now)
	local humanoid, root = agent.Humanoid, agent.Root
	local hitTime = humanoid:GetAttribute("LastHitTime")
	if not hitTime or hitTime == agent.LastAlert or now - hitTime > 2 then
		return
	end
	agent.LastAlert = hitTime
	local source
	local attackerId = humanoid:GetAttribute("LastAttacker")
	if attackerId then
		local attacker = Players:GetPlayerByUserId(attackerId)
		source = attacker and attacker.Character and attacker.Character:FindFirstChild("HumanoidRootPart")
	else
		local other = Combat.BotsByName[humanoid:GetAttribute("LastBot") or ""]
		source = other and other.Root
	end
	if source and source.Parent then
		local look = Vector3.new(source.Position.X, root.Position.Y, source.Position.Z)
		if (look - root.Position).Magnitude > 0.5 then
			root.CFrame = CFrame.lookAt(root.Position, look)
		end
		agent.AlertPosition = source.Position
		agent.AlertTime = now
		agent.GoalDeadline = 0 -- (busca camino nuevo ya)
		agent.Waypoints = nil
		humanoid:MoveTo(root.Position) -- (se para a mirar)
	end
end

-- Captura la bandera: si lleva la bandera, a casa; si no, a devolver la suya caída, a perseguir a
-- quien se la lleva o a por la enemiga (ver Flags: FlagPos_/FlagHome_/FlagState_)
local function flagGoal(agent)
	if ReplicatedStorage:GetAttribute("Mode") ~= "CTF" or not agent.Team then
		return nil
	end
	local own = agent.Team.Name
	local enemy
	for _, team in Teams:GetTeams() do
		if team ~= agent.Team then
			enemy = team.Name
		end
	end
	if agent.CarryingFlag then
		return ReplicatedStorage:GetAttribute("FlagHome_" .. own)
	end
	local ownState = ReplicatedStorage:GetAttribute("FlagState_" .. own)
	if (ownState == "Dropped" or ownState == "Carried") and math.random() < 0.6 then
		return ReplicatedStorage:GetAttribute("FlagPos_" .. own)
	end
	if enemy and math.random() < 0.65 then
		return ReplicatedStorage:GetAttribute("FlagPos_" .. enemy)
	end
	return nil
end

local laneGoal, bestIntel, chooseRole -- (más abajo)
local sndPick = { Sites = nil, Index = 1 } -- sitio que atacan los bots en esta ronda de Buscar y destruir

-- Adónde ir: objetivo del modo, alerta, pista del equipo o su carril
local function pickGoal(agent)
	agent.SpotLook = nil -- (solo vale si el objetivo nuevo es un puesto de vigilancia)
	local flagTarget = flagGoal(agent)
	if typeof(flagTarget) == "Vector3" then
		return flagTarget, true
	end
	-- Le dispararon desde donde no veía: va hacia allí
	if agent.AlertPosition then
		local alert, fresh = agent.AlertPosition, os.clock() - (agent.AlertTime or 0) < 5
		agent.AlertPosition = nil
		if fresh then
			return alert, true
		end
	end
	-- Calabazas: casi siempre van a por la calabaza más cercana que haya
	if ReplicatedStorage:GetAttribute("Mode") == "CAL" and agent.Root and math.random() < 0.8 then
		local pumpkin = Pumpkins.Nearest(agent.Root.Position)
		if pumpkin then
			return pumpkin, true
		end
	end
	-- Dominio: defienden su bandera si se la están quitando; si no, a por las que no son suyas (casi
	-- siempre la más cercana; los agresivos, a veces la del fondo). El tirador a veces guarda su línea.
	if ReplicatedStorage:GetAttribute("Mode") == "DOM" and agent.Root and agent.Team then
		local flags = Domination.Points()
		local defend, targets = nil, {}
		for _, flag in flags do
			if flag.Owner == agent.Team and flag.Capturing and flag.Capturing ~= agent.Team then
				defend = flag
			elseif flag.Owner ~= agent.Team then
				table.insert(targets, flag)
			end
		end
		local chosen
		if defend and math.random() < 0.7 then
			chosen = defend
		elseif #targets > 0 and not (agent.Role == "Tirador" and math.random() < 0.5) then
			table.sort(targets, function(x, y)
				return (x.Position - agent.Root.Position).Magnitude < (y.Position - agent.Root.Position).Magnitude
			end)
			local aggressive = agent.Role == "Subfusil" or agent.Role == "Escopeta"
			chosen = (aggressive and math.random() < 0.35) and targets[#targets] or targets[1]
		end
		if chosen then
			local spread = chosen.Radius * 0.5
			return chosen.Position + Vector3.new((math.random() - 0.5) * spread, 0, (math.random() - 0.5) * spread), true
		end
	end
	-- Buscar y destruir: los atacantes van juntos al sitio elegido para la ronda y plantan; los
	-- defensores se reparten entre A y B. Con la bomba plantada, los defensores corren a
	-- desactivarla y los atacantes (casi todos) se quedan a protegerla.
	if ReplicatedStorage:GetAttribute("Mode") == "SND" and agent.Team then
		local sites = Bomb.Sites()
		if #sites > 0 then
			local attacking = ReplicatedStorage:GetAttribute("Bomb_Attackers") == agent.Team.Name
			local planted = ReplicatedStorage:GetAttribute("Bomb_State") == "Planted" and ReplicatedStorage:GetAttribute("Bomb_Site")
			if sndPick.Sites ~= sites then
				sndPick.Sites, sndPick.Index = sites, math.random(1, #sites)
			end
			local chosen
			if planted then
				for _, site in sites do
					if site.Letter == planted then
						chosen = site
					end
				end
				if attacking and math.random() < 0.3 then
					chosen = nil -- (alguno sale a cazar)
				end
			elseif attacking then
				-- La bomba en el suelo: van a recogerla (solo la puede plantar quien la lleve)
				local dropped = ReplicatedStorage:GetAttribute("Bomb_Dropped")
				if typeof(dropped) == "Vector3" then
					return dropped + Vector3.new((math.random() - 0.5) * 2, 0, (math.random() - 0.5) * 2), true
				end
				chosen = sites[sndPick.Index]
			elseif not (agent.Role == "Subfusil" and math.random() < 0.4) then
				chosen = sites[(agent.Lane or 0) >= 0 and 1 or math.min(2, #sites)]
			end
			if chosen then
				local spread = chosen.Radius * 0.6
				return chosen.Position + Vector3.new((math.random() - 0.5) * spread, 0, (math.random() - 0.5) * spread), true
			end
		end
	end
	-- En Zona de control, la mitad de las veces van a la zona activa
	local zone = ReplicatedStorage:GetAttribute("ZonePosition")
	if typeof(zone) == "Vector3" and math.random() < 0.75 then
		return zone + Vector3.new(math.random(-5, 5), 0, math.random(-5, 5))
	end
	-- Pista del equipo: va a donde se ha visto u oído al enemigo (los agresivos casi siempre)
	local clue = bestIntel(agent, 10, 150)
	local chase = ({ Subfusil = 0.85, Escopeta = 0.85, Asalto = 0.55, Ametralladora = 0.35, Tirador = 0 })[agent.Role or "Asalto"] or 0.5
	if clue and math.random() < chase then
		return clue.Position + Vector3.new(math.random(-6, 6), 0, math.random(-6, 6)), true
	end
	-- Si no, patrulla su carril hasta donde le toca según su rol
	return laneGoal(agent)
end

local function computePath(agent, goal)
	agent.Waypoints = nil
	agent.WaypointIndex = 0
	local path = PathfindingService:CreatePath({
		AgentRadius = 2,
		AgentHeight = 5,
		AgentCanJump = true,
		WaypointSpacing = 6,
		Costs = { CrackedLava = math.huge, Water = math.huge }, -- nunca por la lava ni por el agua
	})
	local ok = pcall(function()
		path:ComputeAsync(agent.Root.Position, goal)
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		agent.Waypoints = path:GetWaypoints()
		agent.WaypointIndex = 1
	end
end

---------------------------------------------------------------------------
-- Comportamiento "de jugador": roles, carriles, información del equipo, oído y coberturas
---------------------------------------------------------------------------

-- Lo que sabe cada equipo de dónde está el enemigo (lo que ve u oye cualquier compañero).
-- En todos contra todos cada bot tiene lo suyo.
local intel = {} -- [clave] = { { Position, Time } }
local INTEL_TIME = 12

local function intelKey(agent)
	return (teamMode() and agent.Team) and agent.Team.Name or agent.Name
end

local function reportEnemy(agent, position)
	local key = intelKey(agent)
	local list = intel[key]
	if not list then
		list = {}
		intel[key] = list
	end
	local now = os.clock()
	for _, entry in list do
		if (entry.Position - position).Magnitude < 18 then
			entry.Position, entry.Time = position, now
			return
		end
	end
	table.insert(list, { Position = position, Time = now })
	if #list > 8 then
		table.remove(list, 1)
	end
end

-- La pista más reciente (y cercana) que tiene su equipo
bestIntel = function(agent, maxAge, maxDistance)
	local list = intel[intelKey(agent)]
	if not list or not agent.Root then
		return nil
	end
	local now = os.clock()
	local best, bestScore = nil, math.huge
	for _, entry in list do
		local age = now - entry.Time
		local distance = (entry.Position - agent.Root.Position).Magnitude
		if age < maxAge and distance < maxDistance then
			local score = distance + age * 12
			if score < bestScore then
				best, bestScore = entry, score
			end
		end
	end
	return best
end

-- Radar (racha de 3 de un bot o de un jugador de su equipo): mientras dure, el equipo sabe en
-- todo momento dónde está cada enemigo, como el radar de los jugadores
local radarUntil = {} -- [clave de intel] = os.clock() en que se acaba

function Bots.Radar(key, seconds)
	radarUntil[key] = os.clock() + seconds
end

function Bots.RadarKey(agent)
	return intelKey(agent)
end

local function radarSweep()
	local now = os.clock()
	for key, untilTime in radarUntil do
		if now > untilTime then
			radarUntil[key] = nil
			continue
		end
		for _, agent in agents do
			if agent.Humanoid and agent.Humanoid.Health > 0 and agent.Root and intelKey(agent) == key then
				for _, target in candidates(agent) do
					reportEnemy(agent, target.Head.Position)
				end
				break
			end
		end
	end
end

-- Oído: disparos recientes de enemigos a su alcance
local function hear(agent, now)
	local noise = Combat.Noise
	for i = #noise, 1, -1 do
		local n = noise[i]
		if now - n.Time > 1.2 then
			break -- (van en orden: los más nuevos al final)
		end
		local enemy = n.Model ~= agent.Model and (not teamMode() or n.Team ~= agent.Team)
		if enemy and n.Model and n.Model.Parent then
			local distance = (n.Position - agent.Root.Position).Magnitude
			if distance < n.Range * (CONFIG.Hearing or 1) then
				reportEnemy(agent, n.Position)
				return n.Position
			end
		end
	end
	return nil
end

-- Eje del mapa: de la base propia a la enemiga (para repartir carriles y saber hacia dónde avanzar)
local function mapAxis(agent)
	refreshPoints()
	local own, enemy
	if teamMode() and agent.Team then
		for _, team in Teams:GetTeams() do
			local points = spawnsByColor[team.TeamColor.Name]
			if points and #points > 0 then
				local sum = Vector3.zero
				for _, p in points do
					sum += p
				end
				if team == agent.Team then
					own = sum / #points
				else
					enemy = sum / #points
				end
			end
		end
	end
	if not own or not enemy or (enemy - own).Magnitude < 20 then
		return nil
	end
	return own, enemy
end

-- Punto de patrulla según su rol y su carril: los de subfusil y escopeta se meten hasta el fondo,
-- los de fusil por la mitad y el tirador se queda en su mitad, a ser posible en alto (ventanas).
local ROLE_DEPTH = {
	Asalto = { 0.3, 0.75 },
	Subfusil = { 0.45, 0.98 },
	Escopeta = { 0.45, 0.98 },
	Ametralladora = { 0.25, 0.6 },
	Tirador = { 0.12, 0.5 },
}

laneGoal = function(agent)
	refreshPoints()
	if #ffaPoints == 0 then
		return nil
	end
	local own, enemy = mapAxis(agent)
	if not own then
		return ffaPoints[math.random(1, #ffaPoints)]
	end
	local axis = Vector3.new(enemy.X - own.X, 0, enemy.Z - own.Z)
	local length = axis.Magnitude
	axis = axis.Unit
	local side = Vector3.new(-axis.Z, 0, axis.X)
	local middle = (own + enemy) / 2
	local maxSide = 1
	for _, p in ffaPoints do
		maxSide = math.max(maxSide, math.abs((p - middle):Dot(side)))
	end
	-- El tirador va a un puesto de vigilancia de su mitad (ventana, torre...) si el mapa los tiene
	if agent.Role == "Tirador" and #botSpots > 0 then
		local mine = {}
		for _, spot in botSpots do
			if (spot.Position - own):Dot(axis) / length < 0.55 then
				table.insert(mine, spot)
			end
		end
		if #mine > 0 then
			local spot = mine[math.random(1, #mine)]
			agent.SpotLook = typeof(spot.Look) == "Vector3" and spot.Look or nil
			return spot.Position
		end
	end
	local depth = ROLE_DEPTH[agent.Role or "Asalto"] or ROLE_DEPTH.Asalto
	local anyLane = math.random() < 0.2
	local good, high = {}, {}
	for _, p in ffaPoints do
		local progress = (p - own):Dot(axis) / length
		local lateral = (p - middle):Dot(side) / maxSide
		local lane = lateral < -0.33 and -1 or (lateral > 0.33 and 1 or 0)
		if progress >= depth[1] and progress <= depth[2] and (anyLane or lane == agent.Lane) then
			table.insert(good, p)
			if p.Y > own.Y + 4 then
				table.insert(high, p)
			end
		end
	end
	if agent.Role == "Tirador" and #high > 0 then
		return high[math.random(1, #high)]
	end
	if #good == 0 then
		return ffaPoints[math.random(1, #ffaPoints)]
	end
	return good[math.random(1, #good)]
end

-- Hacia dónde mira mientras espera en un sitio: hacia el lado enemigo (o la pista más reciente)
local function watchPoint(agent)
	local clue = bestIntel(agent, INTEL_TIME, 200)
	if clue then
		return clue.Position
	end
	local own, enemy = mapAxis(agent)
	if own then
		return agent.Root.Position + Vector3.new(enemy.X - own.X, 0, enemy.Z - own.Z).Unit * 50
	end
	return agent.Root.Position + agent.Root.CFrame.LookVector * 50
end

-- Cobertura: un punto cercano desde el que el enemigo no le ve (para retirarse con poca vida)
local function findCover(agent, target)
	local root = agent.Root
	local enemyHead = target.Head.Position
	local away = Vector3.new(root.Position.X - enemyHead.X, 0, root.Position.Z - enemyHead.Z)
	away = away.Magnitude > 0.1 and away.Unit or root.CFrame.LookVector * -1
	local ignore = { agent.Model, target.Model }
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	rayParams.FilterDescendantsInstances = ignore
	local best
	for _, angle in { 70, -70, 110, -110, 40, -40, 150, -150 } do
		local direction = CFrame.Angles(0, math.rad(angle), 0) * away
		for _, distance in { 9, 15 } do
			local point = root.Position + direction * distance
			-- Que se pueda llegar en línea recta y que desde el enemigo no se vea
			local path = workspace:Raycast(root.Position, direction * distance, rayParams)
			if not path and safeGround(point) then
				local seen = workspace:Raycast(enemyHead, (point + Vector3.new(0, 1.5, 0)) - enemyHead, rayParams)
				if seen then
					best = point
					break
				end
			end
		end
		if best then
			break
		end
	end
	return best
end

-- Daño de un arma a una distancia (cae entre FalloffStart y FalloffEnd)
local function damageAt(def, distance)
	local start, finish = def.FalloffStart or 100, def.FalloffEnd or 300
	if distance <= start then
		return def.Damage
	end
	local alpha = math.clamp((distance - start) / math.max(1, finish - start), 0, 1)
	return def.Damage + ((def.MinDamage or def.Damage) - def.Damage) * alpha
end

-- Recarga (los demás ven el arma recargando: atributo Reloading del Tool)
local function startReload(agent, def, now)
	local tool = agent.Tool
	local empty = (agent.Mag or 0) <= 0
	agent.Mag = def.MagSize
	-- (como los jugadores: con balas aún en el cargador, recarga táctica más rápida)
	agent.ReloadUntil = now + Weapons.ReloadDuration(def, empty) * (1.05 + math.random() * 0.2)
	if tool then
		tool:SetAttribute("Reloading", true)
		task.delay(agent.ReloadUntil - now, function()
			if tool.Parent then
				tool:SetAttribute("Reloading", false)
			end
		end)
	end
end

local function shoot(agent, target, distance, now)
	local tool = agent.Tool
	local def = Weapons.Get(agent.Weapon)
	if not tool or not tool.Parent or not def then
		return
	end
	-- Cargador de verdad: al vaciarlo recarga (y mientras tanto no dispara)
	if agent.Mag <= 0 then
		startReload(agent, def, now)
		return
	end
	agent.Mag -= 1
	-- Dificultad según el rango del jugador al que disparan (contra otros bots, normal)
	local targetPlayer = Players:GetPlayerFromCharacter(target.Model)
	local rankSkill = targetPlayer and CONFIG.SkillByRank and CONFIG.SkillByRank[targetPlayer:GetAttribute("Rank") or 1] or 1
	local skill = rankSkill * (agent.Skill or 1)
	-- La puntería se asienta: los primeros tiros sobre un objetivo nuevo fallan más
	local settle = math.clamp((now - (agent.AimStart or now)) / 0.9 + 0.35, 0.35, 1)
	local accuracy = math.min(0.95, CONFIG.Accuracy * skill) * settle
	-- (los fusiles de precisión apenas pierden puntería de lejos; las escopetas, mucha)
	local falloff = CONFIG.AccuracyFalloff * math.clamp((def.Spread or 1.6) / 1.6, 0.25, 3)
	local chance = math.clamp(accuracy - distance * falloff, 0.04, accuracy)
	if agent.Root.AssemblyLinearVelocity.Magnitude > 8 then
		chance *= 0.8 -- disparar andando
	end
	if agent.Crouched then
		chance = math.min(0.95, chance * 1.15) -- agachado apunta más estable
	end
	local targetRoot = target.Model:FindFirstChild("HumanoidRootPart")
	if targetRoot and targetRoot.AssemblyLinearVelocity.Magnitude > 12 then
		chance *= 0.7 -- cuesta más acertar a quien se mueve rápido
	end
	local pellets = math.max(1, def.Pellets or 1)
	local hits = 0
	for _ = 1, pellets do
		if math.random() < chance then
			hits += 1
		end
	end
	local endpoints = {}
	if hits > 0 then
		local headshot = math.random() < 0.12 * skill
		local damage = damageAt(def, distance) * hits * CONFIG.DamageScale * rankSkill
		if headshot then
			damage *= def.HeadshotMultiplier or 1.5
			table.insert(endpoints, target.Head.Position)
		else
			table.insert(endpoints, target.Head.Position + Vector3.new(math.random() - 0.5, -0.8 - math.random() * 1.2, math.random() - 0.5))
		end
		Combat.BotDamage(agent, target.Humanoid, damage, agent.Weapon)
	end
	while #endpoints < math.min(3, pellets) or #endpoints == 0 do
		local miss = Vector3.new(math.random() - 0.5, math.random() - 0.3, math.random() - 0.5).Unit * (2 + math.random() * 3)
		table.insert(endpoints, target.Head.Position + miss)
	end
	Remotes.ShotFX:FireAllClients(tool, endpoints)
	local head = agent.Model:FindFirstChild("Head")
	if head then
		Combat.ReportNoise(head.Position, agent.Team, agent.Model, agent.Weapon)
	end
end

-- Granada al último sitio donde vio al enemigo (si se ha escondido detrás de algo)
local function throwGrenade(agent, position)
	local head = agent.Model:FindFirstChild("Head")
	if not head then
		return false
	end
	local grenadeDef = Weapons.Grenade
	return Grenades.BotThrow(agent.Model, head.Position + agent.Root.CFrame.LookVector * 2, position, function(blast)
		local info = grenadeDef.Explosive
		local ignore = { agent.Model }
		local map = workspace:FindFirstChild("Map")
		local boundary = map and map:FindFirstChild("Boundary")
		if boundary then
			table.insert(ignore, boundary)
		end
		for _, target in candidates(agent) do
			local root = target.Model:FindFirstChild("HumanoidRootPart")
			local distance = root and (root.Position - blast).Magnitude
			if distance and distance <= info.Radius then
				rayParams.FilterDescendantsInstances = ignore
				local hit = workspace:Raycast(blast, root.Position - blast, rayParams)
				if not hit or hit.Instance:IsDescendantOf(target.Model) then
					local damage = info.Damage + (info.MinDamage - info.Damage) * (distance / info.Radius)
					Combat.BotDamage(agent, target.Humanoid, damage * CONFIG.DamageScale, "Grenade")
				end
			end
		end
	end)
end

-- Zombi (Infección): persigue al superviviente más cercano (aunque no lo vea, con el buscador de
-- caminos) y le araña cuando lo tiene al alcance
local function zombieThink(agent, humanoid, root, now)
	local def = Weapons.Get("Claws")
	local best, bestDistance = nil, math.huge
	for _, target in candidates(agent) do
		local distance = (target.Head.Position - root.Position).Magnitude
		if distance < bestDistance then
			best, bestDistance = target, distance
		end
	end
	if not best then
		humanoid:MoveTo(root.Position)
		return
	end
	local targetRoot = best.Model:FindFirstChild("HumanoidRootPart") or best.Head
	if bestDistance <= def.Range + 1 and math.abs(targetRoot.Position.Y - root.Position.Y) < 4 and canSee(agent, best) then
		humanoid:MoveTo(targetRoot.Position)
		if now >= agent.NextShot then
			agent.NextShot = now + def.Cooldown + math.random() * 0.3
			local targetPlayer = Players:GetPlayerFromCharacter(best.Model)
			local skill = targetPlayer and CONFIG.SkillByRank and CONFIG.SkillByRank[targetPlayer:GetAttribute("Rank") or 1] or 1
			Combat.BotDamage(agent, best.Humanoid, def.Damage * CONFIG.DamageScale * 1.4 * skill, "Claws")
		end
		return
	end
	-- Cerca y a la vista: directo; si no, por el camino (se recalcula cada poco)
	if bestDistance < 30 and canSee(agent, best) then
		local flat = Vector3.new(targetRoot.Position.X - root.Position.X, 0, targetRoot.Position.Z - root.Position.Z)
		if flat.Magnitude < 0.1 or safeGround(root.Position + flat.Unit * 4) then
			agent.Waypoints = nil
			humanoid:MoveTo(targetRoot.Position)
			return
		end
		-- (hay agua o lava en medio: por el camino)
	end
	if not agent.Computing and (not agent.Waypoints or now > agent.GoalDeadline or agent.WaypointIndex > #agent.Waypoints) then
		agent.Computing = true
		agent.GoalDeadline = now + 2.5
		local goal = targetRoot.Position
		task.spawn(function()
			computePath(agent, goal)
			agent.Computing = false
			if not agent.Waypoints and agent.Humanoid then
				agent.Humanoid:MoveTo(goal)
			end
		end)
		return
	end
	local waypoints = agent.Waypoints
	if waypoints and waypoints[agent.WaypointIndex] then
		local waypoint = waypoints[agent.WaypointIndex]
		if (Vector3.new(waypoint.Position.X, root.Position.Y, waypoint.Position.Z) - root.Position).Magnitude < 3 then
			agent.WaypointIndex += 1
		else
			if waypoint.Action == Enum.PathWaypointAction.Jump then
				humanoid.Jump = true
			end
			humanoid:MoveTo(waypoint.Position)
		end
	end
end

local function lookAt(root, position)
	local look = Vector3.new(position.X, root.Position.Y, position.Z)
	if (look - root.Position).Magnitude > 0.5 then
		root.CFrame = CFrame.lookAt(root.Position, look)
	end
end

-- Pelea con un enemigo a la vista: se mueve según su rol, se cubre si le queda poca vida y dispara
-- en ráfagas (a quemarropa, a todo lo que da el arma)
-- Agacharse (como los jugadores: baja la cadera, se ve y se le da peor). Se levanta solo al
-- pasar CrouchUntil (ver think)
local function setCrouch(agent, humanoid, on)
	if agent.BaseHip == nil then
		agent.BaseHip = humanoid.HipHeight
	end
	agent.Crouched = on
	local target = agent.BaseHip - (on and (GameConfig.CrouchDrop or 1.3) or 0)
	if math.abs(humanoid.HipHeight - target) > 0.01 then
		humanoid.HipHeight = target
	end
end

local function fight(agent, humanoid, root, target, distance, now)
	if agent.Target ~= target.Model then
		agent.Target = target.Model
		agent.AimStart = now + (agent.Reaction or CONFIG.Reaction)
		agent.NextShot = math.max(agent.NextShot, agent.AimStart)
		agent.BurstLeft = 0
	end
	agent.LastSeenPosition, agent.LastSeenTime = target.Head.Position, now
	agent.HoldUntil = 0
	reportEnemy(agent, target.Head.Position)
	humanoid.WalkSpeed = CONFIG.WalkSpeed
	humanoid.AutoRotate = false
	lookAt(root, target.Head.Position)

	-- Con poca vida se retira a cubierto (la vida se recupera sola) y luego vuelve
	if humanoid.Health < humanoid.MaxHealth * 0.35 and agent.Role ~= "Escopeta" and now > (agent.NextRetreat or 0) then
		agent.NextRetreat = now + 9
		local cover = findCover(agent, target)
		if cover then
			agent.RetreatUntil = now + 2.2
			setCrouch(agent, humanoid, false)
			humanoid.WalkSpeed = CONFIG.SprintSpeed or CONFIG.WalkSpeed
			humanoid.AutoRotate = true
			humanoid:MoveTo(cover)
			return
		end
	end

	-- Movimiento: cada rol pelea a su manera
	if now >= agent.NextStrafe then
		local role = agent.Role
		local dest
		local crouch = false
		if role == "Tirador" then
			-- Quieto para apuntar; de vez en cuando un paso al lado
			agent.NextStrafe = now + 2.5 + math.random() * 2
			if math.random() < 0.35 then
				dest = root.Position + root.CFrame.RightVector * (math.random() < 0.5 and -4 or 4)
			else
				dest = root.Position
				crouch = math.random() < 0.65 -- (quieto, casi siempre agachado)
			end
		elseif (role == "Asalto" or role == "Ametralladora") and distance > 45 and math.random() < 0.35 then
			-- De lejos, a veces se agacha y aguanta la posición
			agent.NextStrafe = now + 1.2 + math.random() * 1.3
			dest = root.Position
			crouch = true
		else
			agent.NextStrafe = now + 0.45 + math.random() * 0.7
			local strafe = (math.random() < 0.5 and -1 or 1) * (role == "Ametralladora" and 3 or 6)
			dest = root.Position + root.CFrame.RightVector * strafe
			-- Los de corta distancia se echan encima; todos se acercan si está muy lejos
			local close = (role == "Subfusil" and 18) or (role == "Escopeta" and 9) or 75
			if distance > close then
				dest += root.CFrame.LookVector * math.min(10, distance - close)
			end
		end
		if not safeGround(dest) then
			dest = root.Position - (dest - root.Position) -- (al otro lado, si no hay agua)
		end
		if safeGround(dest) then
			humanoid:MoveTo(dest)
		end
		setCrouch(agent, humanoid, crouch)
		agent.CrouchUntil = crouch and agent.NextStrafe + 0.2 or 0
		if not crouch and math.random() < CONFIG.JumpChance and role ~= "Tirador" then
			humanoid.Jump = true
		end
	end
	if agent.Crouched then
		humanoid.WalkSpeed = GameConfig.CrouchSpeed or 10
	end

	-- Disparo: ráfagas controladas de lejos con armas automáticas, a todo trapo de cerca
	if now < (agent.ReloadUntil or 0) then
		return
	end
	local def = Weapons.Get(agent.Weapon)
	local interval = 1 / math.min(def and def.FireRate or 6, CONFIG.MaxFireRate)
	local shots = 0
	while now >= agent.NextShot and shots < 2 do
		shots += 1
		if def and def.Automatic and distance > 35 then
			if agent.BurstLeft <= 0 then
				agent.BurstLeft = math.random(3, 6)
				agent.NextShot = now + 0.22 + math.random() * 0.3
				break
			end
			agent.BurstLeft -= 1
		end
		shoot(agent, target, distance, now)
		agent.NextShot = math.max(agent.NextShot + interval, now - interval) + math.random() * 0.04
		if now < (agent.ReloadUntil or 0) then
			break
		end
	end
end

-- Atascado contra algo: salta y, si sigue, busca otro camino
local function checkStuck(agent, humanoid, root, now)
	local moved = agent.StuckPosition and (root.Position - agent.StuckPosition).Magnitude or math.huge
	if moved > 1.5 then
		agent.StuckPosition, agent.StuckTime = root.Position, now
		return
	end
	local stuck = now - (agent.StuckTime or now)
	if stuck > 1.4 then
		humanoid.Jump = true
	end
	if stuck > 3 then
		agent.Waypoints, agent.GoalDeadline = nil, 0
		agent.StuckPosition, agent.StuckTime = root.Position, now
	end
end

-- Buscar y destruir: ¿está dentro de un sitio en el que tiene que plantar o desactivar? (entonces no
-- sale corriendo detrás de un ruido ni de alguien que ha perdido de vista)
local function sndBusy(agent, root)
	if ReplicatedStorage:GetAttribute("Mode") ~= "SND" or not agent.Team then
		return false
	end
	local attacking = ReplicatedStorage:GetAttribute("Bomb_Attackers") == agent.Team.Name
	local planted = ReplicatedStorage:GetAttribute("Bomb_State") == "Planted"
	for _, site in Bomb.Sites() do
		local offset = site.Position - root.Position
		if Vector3.new(offset.X, 0, offset.Z).Magnitude <= site.Radius then
			local carrying = agent.Model and ReplicatedStorage:GetAttribute("Bomb_Carrier") == agent.Model.Name
			if (attacking and not planted and carrying) or (not attacking and planted and ReplicatedStorage:GetAttribute("Bomb_Site") == site.Letter) then
				return true
			end
		end
	end
	return false
end

local function think(agent)
	local humanoid, root = agent.Humanoid, agent.Root
	if not humanoid or humanoid.Health <= 0 or not root or not root.Parent then
		return
	end
	if frozen() then
		humanoid:MoveTo(root.Position)
		return
	end
	local now = os.clock()
	if agent.Zombie then
		zombieThink(agent, humanoid, root, now)
		return
	end
	local target, distance = findTarget(agent)
	-- (se levanta al acabar su rato agachado o si deja de ver al enemigo)
	if agent.Crouched and (now > (agent.CrouchUntil or 0) or (not target and not agent.HoldCrouch)) then
		setCrouch(agent, humanoid, false)
	end
	local heard = hear(agent, now)
	if not target then
		checkAlert(agent, now)
	end
	-- Con la bandera a cuestas no se para a pelear: dispara mientras sigue su camino a casa
	if target and agent.CarryingFlag then
		if agent.Target ~= target.Model then
			agent.Target = target.Model
			agent.AimStart = now + (agent.Reaction or CONFIG.Reaction)
			agent.NextShot = math.max(agent.NextShot, agent.AimStart)
		end
		reportEnemy(agent, target.Head.Position)
		if now >= agent.NextShot and now >= (agent.ReloadUntil or 0) then
			local def = Weapons.Get(agent.Weapon)
			agent.NextShot = now + 1 / math.min(def and def.FireRate or 6, CONFIG.MaxFireRate) + math.random() * 0.12
			shoot(agent, target, distance, now)
		end
		target = nil
	end
	-- Retirándose a cubierto: sigue hasta llegar (sin pararse a pelear)
	if now < (agent.RetreatUntil or 0) and not agent.CarryingFlag then
		return
	end
	if target then
		fight(agent, humanoid, root, target, distance, now)
		return
	end
	-- (el portador de la bandera conserva su objetivo: si no, el retraso de reacción no acabaría nunca)
	if not agent.CarryingFlag then
		agent.Target = nil
	end
	humanoid.AutoRotate = true

	-- Recarga táctica cuando no hay nadie delante
	local def = Weapons.Get(agent.Weapon)
	if def and agent.Mag < def.MagSize * 0.4 and now >= (agent.ReloadUntil or 0) then
		startReload(agent, def, now)
	end

	-- Acaba de perder de vista al enemigo: granada si se ha escondido cerca; si no, mira hacia allí
	-- un momento (pre-apuntar) antes de ir a buscarle
	local busy = sndBusy(agent, root)
	if busy and (agent.HoldUntil or 0) <= now then
		agent.HoldUntil = now + 1 -- (sigue plantando o desactivando)
	end
	-- Plantando o desactivando: agachado y quieto, como un jugador
	agent.HoldCrouch = busy
	if busy and not target then
		setCrouch(agent, humanoid, true)
		agent.CrouchUntil = now + 0.5
		humanoid:MoveTo(root.Position)
	end
	local lostFor = agent.LastSeenTime and now - agent.LastSeenTime or math.huge
	if lostFor < 3 and agent.LastSeenPosition and not busy then
		local away = (agent.LastSeenPosition - root.Position).Magnitude
		if lostFor > 0.6 and away > 14 and away < 48 and now >= (agent.NextGrenade or 0) and math.random() < 0.3 then
			agent.NextGrenade = now + (CONFIG.GrenadeCooldown or 18) * (0.8 + math.random() * 0.4)
			lookAt(root, agent.LastSeenPosition)
			throwGrenade(agent, agent.LastSeenPosition)
		end
		if agent.Role ~= "Subfusil" and agent.Role ~= "Escopeta" and lostFor < 1.5 then
			humanoid.AutoRotate = false
			lookAt(root, agent.LastSeenPosition)
			humanoid:MoveTo(root.Position)
			return
		end
		if not agent.ChasedSeen then
			agent.ChasedSeen = true
			agent.AlertPosition, agent.AlertTime = agent.LastSeenPosition, now
			agent.Waypoints, agent.GoalDeadline, agent.HoldUntil = nil, 0, 0
		end
	else
		agent.ChasedSeen = false
	end
	-- Ha oído disparos cerca: deja lo que esté haciendo y va (el tirador solo se gira)
	if heard and not agent.CarryingFlag and not busy and now > (agent.NextHeard or 0) then
		agent.NextHeard = now + 4
		if agent.Role == "Tirador" and (agent.HoldUntil or 0) > now then
			agent.HoldLook = heard
		elseif (heard - root.Position).Magnitude > 12 then
			agent.AlertPosition, agent.AlertTime = heard, now
			agent.Waypoints, agent.GoalDeadline, agent.HoldUntil = nil, 0, 0
		end
	end

	-- Esperando en un sitio (el tirador vigila su línea; los demás echan un vistazo)
	if (agent.HoldUntil or 0) > now then
		humanoid:MoveTo(root.Position)
		humanoid.AutoRotate = false
		local look = agent.HoldLook or watchPoint(agent)
		local scan = math.sin(now * 0.7 + (agent.Seed or 0)) * math.rad(agent.Role == "Tirador" and 25 or 50)
		local direction = Vector3.new(look.X - root.Position.X, 0, look.Z - root.Position.Z)
		if direction.Magnitude > 0.5 then
			lookAt(root, root.Position + CFrame.Angles(0, scan, 0) * direction.Unit * 10)
		end
		return
	end

	-- Sin enemigos a la vista: seguir el camino o buscar uno nuevo
	local waypoints = agent.Waypoints
	if agent.Computing then
		return
	end
	if not waypoints or agent.WaypointIndex > #waypoints or now > agent.GoalDeadline then
		if now < agent.GoalDeadline and not waypoints then
			return -- sin camino: va en línea recta un rato antes de volver a intentarlo
		end
		-- Ha llegado: se para un momento a mirar (el tirador se aposta un buen rato)
		if waypoints and agent.WaypointIndex > #waypoints and not agent.Arrived then
			agent.Arrived = true
			-- (en un puesto de vigilancia, mira hacia donde manda el puesto)
			agent.HoldLook = (agent.SpotLook and agent.GoalPosition and (agent.GoalPosition - root.Position).Magnitude < 6) and agent.SpotLook or nil
			agent.HoldUntil = now + (agent.Role == "Tirador" and (12 + math.random() * 14) or (0.6 + math.random() * 1.6))
			-- (en Buscar y destruir, se queda a plantar o a desactivar)
			if ReplicatedStorage:GetAttribute("Mode") == "SND" then
				local attacking = ReplicatedStorage:GetAttribute("Bomb_Attackers") == (agent.Team and agent.Team.Name)
				local planted = ReplicatedStorage:GetAttribute("Bomb_State") == "Planted"
				for _, site in Bomb.Sites() do
					local offset = site.Position - root.Position
					if Vector3.new(offset.X, 0, offset.Z).Magnitude <= site.Radius then
						if attacking and not planted then
							agent.HoldUntil = now + 4.6
						elseif planted and ReplicatedStorage:GetAttribute("Bomb_Site") == site.Letter then
							agent.HoldUntil = now + (attacking and 6 or 6.6)
						end
					end
				end
			end
			-- (en una bandera de Dominio que no es suya, se queda a capturarla)
			if ReplicatedStorage:GetAttribute("Mode") == "DOM" then
				for _, flag in Domination.Points() do
					local offset = flag.Position - root.Position
					if flag.Owner ~= agent.Team and Vector3.new(offset.X, 0, offset.Z).Magnitude <= flag.Radius then
						agent.HoldUntil = now + 3
					end
				end
			end
			return
		end
		agent.Arrived = false
		local goal, objective = pickGoal(agent)
		-- (las banderas se mueven: el camino hacia ellas se recalcula antes)
		agent.GoalDeadline = now + (objective and 5 or 14)
		agent.GoalPosition = goal
		agent.Urgent = objective
		if goal then
			agent.Computing = true
			task.spawn(function()
				computePath(agent, goal)
				agent.Computing = false
				-- (si mientras tanto le dispararon, no se pisa la alerta: el siguiente turno va hacia allí)
				if not agent.Waypoints and agent.Humanoid and not agent.AlertPosition then
					agent.Humanoid:MoveTo(goal)
					agent.GoalDeadline = os.clock() + 3
				end
			end)
		else
			agent.GoalDeadline = now + 3
		end
		return
	end
	-- De camino: corre si no espera encontrarse a nadie; anda (y atento) cerca de donde hay enemigos
	local clue = bestIntel(agent, 6, 45)
	humanoid.WalkSpeed = (clue or agent.Role == "Tirador" and agent.Urgent) and CONFIG.WalkSpeed or (CONFIG.SprintSpeed or CONFIG.WalkSpeed)
	checkStuck(agent, humanoid, root, now)
	local waypoint = waypoints[agent.WaypointIndex]
	if (Vector3.new(waypoint.Position.X, root.Position.Y, waypoint.Position.Z) - root.Position).Magnitude < 3 then
		agent.WaypointIndex += 1
		return
	end
	if waypoint.Action == Enum.PathWaypointAction.Jump then
		humanoid.Jump = true
	end
	humanoid:MoveTo(waypoint.Position)
end

local spawnAgent, safeSpawn

-- Rol del bot (GameConfig.Bots.Roles): al azar según su peso, sin pasar del máximo por equipo, y el
-- carril con menos compañeros. Cada bot tiene además su puntería y sus reflejos.
chooseRole = function(agent)
	local roles = CONFIG.Roles
	agent.Skill = 0.85 + math.random() * 0.3
	agent.Reaction = CONFIG.Reaction * (0.75 + math.random() * 0.5) / agent.Skill
	agent.Seed = math.random() * 10
	local laneCount = { [-1] = 0, [0] = 0, [1] = 0 }
	local roleCount = {}
	for _, other in agents do
		if other ~= agent and other.Team == agent.Team then
			if other.Lane then
				laneCount[other.Lane] += 1
			end
			if other.Role then
				roleCount[other.Role] = (roleCount[other.Role] or 0) + 1
			end
		end
	end
	local lane, fewest = 0, math.huge
	for _, l in { 0, -1, 1 } do
		if laneCount[l] < fewest then
			lane, fewest = l, laneCount[l]
		end
	end
	agent.Lane = lane
	if not roles or #roles == 0 then
		agent.Role = "Asalto"
		return
	end
	local pool, total = {}, 0
	for _, role in roles do
		if not role.Max or (roleCount[role.Name] or 0) < role.Max then
			table.insert(pool, role)
			total += role.Weight or 1
		end
	end
	local pick = math.random() * total
	local chosen = pool[1] or roles[1]
	for _, role in pool do
		pick -= role.Weight or 1
		if pick <= 0 then
			chosen = role
			break
		end
	end
	agent.Role = chosen.Name
	local options = {}
	for _, name in chosen.Weapons do
		if Weapons.Get(name) then
			table.insert(options, name)
		end
	end
	agent.RoleWeapon = #options > 0 and options[math.random(1, #options)] or nil
end

-- Estadísticas del bot para el marcador (Tab) de los clientes
local function statsOf(agent)
	if not statsFolder or not table.find(agents, agent) then
		return nil
	end
	local entry = statsFolder:FindFirstChild(agent.Name)
	if not entry then
		entry = Instance.new("Folder")
		entry.Name = agent.Name
		entry:SetAttribute("Kills", 0)
		entry:SetAttribute("Deaths", 0)
		entry:SetAttribute("Score", 0)
		entry.Parent = statsFolder
	end
	entry:SetAttribute("Team", agent.Team and agent.Team.Name or "")
	return entry
end

-- Suma a una estadística del bot (Kills, Deaths o Score); lo llama Round al registrar bajas
function Bots.AddStat(agent, field, amount)
	local entry = agent and statsOf(agent)
	if entry then
		entry:SetAttribute(field, (entry:GetAttribute(field) or 0) + amount)
	end
end


-- Nombre que no lleve ya otro bot activo
local function nextName()
	for _ = 1, #NAMES do
		nameIndex = nameIndex % #NAMES + 1
		local name = "Bot " .. NAMES[nameIndex]
		if not Combat.BotsByName[name] then
			return name
		end
	end
	return "Bot " .. math.random(100, 999)
end

-- Animaciones R15 estándar de Roblox. El script Animate de los personajes es local y no corre en un
-- NPC, así que el servidor las reproduce (se replican a todos).
local ANIMS = {
	Idle = "rbxassetid://507766388",
	Run = "rbxassetid://507767714",
	Jump = "rbxassetid://507765000",
	Fall = "rbxassetid://507767968",
	Hold = "rbxassetid://507768375", -- brazo estirado sujetando el arma
}

local function animate(humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local tracks = {}
	for key, id in ANIMS do
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(animation)
		end)
		if ok and track then
			tracks[key] = track
		end
	end
	local current
	local function play(key, fade)
		local track = tracks[key]
		if track and current ~= track then
			if current then
				current:Stop(fade or 0.2)
			end
			current = track
			track.Looped = key ~= "Jump"
			track:Play(fade or 0.2)
		end
	end
	if tracks.Hold then
		tracks.Hold.Priority = Enum.AnimationPriority.Action
		tracks.Hold.Looped = true
		tracks.Hold:Play()
	end
	play("Idle")
	humanoid.Running:Connect(function(speed)
		play(speed > 0.5 and "Run" or "Idle")
		if tracks.Run then
			tracks.Run:AdjustSpeed(math.max(speed / 16, 0.5))
		end
	end)
	humanoid.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Jumping then
			play("Jump", 0.1)
		elseif new == Enum.HumanoidStateType.Freefall then
			play("Fall", 0.2)
		elseif new == Enum.HumanoidStateType.Landed then
			play("Idle", 0.1)
		end
	end)
end

spawnAgent = function(agent)
	if agent.Spawning then
		return false
	end
	agent.Team = agent.Team or pickTeam()
	if ReplicatedStorage:GetAttribute("Infection") == "On" and agent.Team and agent.Team.Name == ReplicatedStorage:GetAttribute("TeamB") then
		agent.Zombie = true
	end
	agent.Spawning = true
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescriptionAsync(makeDescription(agent.Team, agent.Zombie), Enum.HumanoidRigType.R15)
	end)
	if not ok then
		ok, model = pcall(function()
			return Players:CreateHumanoidModelFromDescription(makeDescription(agent.Team, agent.Zombie), Enum.HumanoidRigType.R15)
		end)
	end
	agent.Spawning = false
	if not ok or not model then
		warn("[Bots] No se pudo crear el bot:", model)
		return false
	end
	-- Lo quitaron (fin de ronda) mientras se creaba
	if not table.find(agents, agent) or not folder then
		model:Destroy()
		return false
	end
	local localAnimate = model:FindFirstChild("Animate")
	if localAnimate then
		localAnimate:Destroy()
	end
	model.Name = agent.Name
	model:SetAttribute("Bot", true)
	model:SetAttribute("Team", agent.Team and agent.Team.Name or "")
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	humanoid.DisplayName = agent.Name
	humanoid.MaxHealth = 100
	humanoid.Health = 100
	humanoid.WalkSpeed = CONFIG.WalkSpeed
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	-- Primera vez en la base; al reaparecer, en el punto más seguro (como los jugadores: SpawnPicker)
	local spawnAt = spawnPoint(agent.Team)
	if agent.HasSpawned and SpawnPicker.Enabled() then
		local picked = SpawnPicker.Pick(agent.Team, nil)
		if picked then
			spawnAt = picked + Vector3.new(0, 4, 0)
		end
	end
	agent.HasSpawned = true
	model:PivotTo(CFrame.new(spawnAt) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	model.Parent = folder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	agent.Model, agent.Humanoid, agent.Root = model, humanoid, root
	agent.BaseHip, agent.Crouched, agent.CrouchUntil = nil, false, 0
	statsOf(agent)
	animate(humanoid)
	if agent.Zombie then
		agent.Weapon = "Claws"
	else
		-- Rol y arma (los conserva al reaparecer), carril, puntería y reflejos propios
		if not agent.Role then
			chooseRole(agent)
		end
		agent.Weapon = agent.RoleWeapon or CONFIG.Weapons[math.random(1, #CONFIG.Weapons)]
	end
	model:SetAttribute("Role", not agent.Zombie and agent.Role or nil) -- (para el destello de la mira del tirador)
	-- Traje de operador al azar (cada bot conserva el suyo al reaparecer)
	if agent.Outfit == nil then
		agent.Outfit = (#BOT_OUTFITS > 0 and math.random() < (CONFIG.OutfitChance or 0)) and BOT_OUTFITS[math.random(1, #BOT_OUTFITS)] or false
	end
	-- En los mapas realistas (tipo shooter militar) van de soldado, con el color de su equipo
	local map = workspace:FindFirstChild("Map")
	local soldier = map ~= nil and map:GetAttribute("Realistic") == true and not agent.Zombie
	if soldier then
		pcall(Outfits.Apply, model, Outfits.Soldier(agent.Team and agent.Team.TeamColor.Color))
	elseif agent.Outfit and not agent.Zombie then
		pcall(Outfits.Apply, model, agent.Outfit)
	end
	if agent.Zombie then
		local claws = Weapons.Get("Claws")
		Zombie.Apply(model, GameConfig.ModeSettings.INF.ZombieHealth)
		humanoid.WalkSpeed = CONFIG.WalkSpeed * (claws.WalkSpeedMultiplier or 1)
	end
	if agent.Skin == nil then
		agent.Skin = (#BOT_SKINS > 0 and math.random() < 0.5) and BOT_SKINS[math.random(1, #BOT_SKINS)] or "Default"
	end
	if agent.Charm == nil then
		agent.Charm = (#BOT_CHARMS > 0 and math.random() < 0.3) and BOT_CHARMS[math.random(1, #BOT_CHARMS)] or false
	end
	agent.Tool = Loadout.MakeTool(agent.Weapon, (agent.Zombie or soldier) and "Default" or agent.Skin, (not soldier and agent.Charm) or nil)
	agent.Tool.Parent = model
	humanoid:EquipTool(agent.Tool)
	agent.Shots, agent.NextShot, agent.NextStrafe, agent.GoalDeadline = 0, 0, 0, 0
	agent.AlertPosition, agent.AlertTime = nil, nil
	agent.Waypoints, agent.Target = nil, nil
	local weaponDef = Weapons.Get(agent.Weapon)
	agent.Mag = weaponDef and weaponDef.MagSize or 30
	agent.ReloadUntil, agent.BurstLeft, agent.RetreatUntil, agent.HoldUntil = 0, 0, 0, 0
	agent.LastSeenPosition, agent.LastSeenTime, agent.Arrived = nil, nil, false
	agent.NextGrenade = os.clock() + 8 + math.random() * 10
	agent.StuckPosition, agent.StuckTime = nil, nil
	humanoid.WalkSpeed = agent.Zombie and humanoid.WalkSpeed or (CONFIG.SprintSpeed or CONFIG.WalkSpeed)

	Combat.WatchHumanoid(humanoid, nil, agent.Name, agent)
	humanoid.Died:Connect(function()
		agent.Humanoid = nil
		-- (el cuerpo queda unos segundos en el suelo como muñeco de trapo; ver Ragdoll)
		task.delay(4.5, function()
			model:Destroy()
		end)
		task.delay(GameConfig.RespawnTime + 1, function()
			if table.find(agents, agent) and not agent.Humanoid and desiredCount() >= #agents and not noRespawn() then
				safeSpawn(agent)
			end
		end)
	end)
	return true
end

local function removeAgent(agent)
	local index = table.find(agents, agent)
	if index then
		table.remove(agents, index)
	end
	if statsFolder then
		local entry = statsFolder:FindFirstChild(agent.Name)
		if entry then
			entry:Destroy()
		end
	end
	Combat.BotsByName[agent.Name] = nil
	if agent.Model then
		agent.Model:Destroy()
	end
end

-- Crea el bot sin que un error deje un hueco fantasma: si falla, el bot se quita de la lista
safeSpawn = function(agent)
	if agent.Spawning then
		return true -- ya se está creando
	end
	local ok, spawned = pcall(spawnAgent, agent)
	if not ok then
		warn("[Bots] spawn:", spawned)
		agent.Spawning = false
	end
	if not (ok and spawned) then
		if agent.Model and agent.Model.Parent and not agent.Humanoid then
			agent.Model:Destroy()
		end
		removeAgent(agent)
		return false
	end
	return true
end

-- Bot a quitar: del equipo con más miembros (jugadores + bots) para no desequilibrar
local function botToRemove()
	if not teamMode() then
		return agents[#agents]
	end
	local best, bestCount = nil, -1
	for _, team in Teams:GetTeams() do
		local count = #team:GetPlayers()
		local candidate
		for _, agent in agents do
			if agent.Team == team then
				count += 1
				candidate = agent
			end
		end
		if candidate and count > bestCount then
			best, bestCount = candidate, count
		end
	end
	return best or agents[#agents]
end

-- Ajusta el número de bots. En plena ronda de Eliminación no entran bots nuevos.
local function balance()
	local desired = desiredCount()
	while #agents < desired and not noRespawn() and state() == "Playing" do
		local agent = { Name = nextName() }
		table.insert(agents, agent)
		Combat.BotsByName[agent.Name] = agent
		if not safeSpawn(agent) then
			break
		end
		desired = desiredCount()
	end
	if #agents > desired then
		if not noRespawn() then
			removeAgent(botToRemove())
		else
			-- En plena ronda de Eliminación solo se quita un bot ya eliminado (no se le quita un luchador
			-- a un equipo a mitad de ronda); el resto se ajusta en la preparación de la siguiente
			for i = #agents, 1, -1 do
				if not agents[i].Humanoid and not agents[i].Spawning then
					removeAgent(agents[i])
					break
				end
			end
		end
	end
end

-- Nueva ronda de Eliminación: los muertos reaparecen y los vivos vuelven a su base con la vida llena
function Bots.RespawnAll()
	table.clear(intel)
	table.clear(radarUntil)
	for _, agent in table.clone(agents) do
		if agent.Humanoid and agent.Humanoid.Health > 0 and agent.Model then
			agent.Humanoid.Health = agent.Humanoid.MaxHealth
			agent.Model:PivotTo(CFrame.new(spawnPoint(agent.Team)) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
			agent.Waypoints, agent.Target, agent.Shots, agent.GoalDeadline = nil, nil, 0, 0
			agent.AlertPosition, agent.AlertTime = nil, nil
			-- (nada de la ronda anterior: cargador lleno y sin esperas ni pistas viejas)
			local weaponDef = Weapons.Get(agent.Weapon)
			agent.Mag = weaponDef and weaponDef.MagSize or agent.Mag
			agent.ReloadUntil, agent.RetreatUntil, agent.HoldUntil, agent.BurstLeft = 0, 0, 0, 0
			agent.HoldLook, agent.SpotLook, agent.Arrived = nil, nil, false
			agent.LastSeenPosition, agent.LastSeenTime = nil, nil
			agent.Streak = 0
		elseif not agent.Spawning then
			task.spawn(safeSpawn, agent)
		end
	end
end

-- Fin de la preparación de Eliminación: reaparece cualquier bot que siga muerto
function Bots.RespawnDead()
	for _, agent in table.clone(agents) do
		if not agent.Humanoid and not agent.Spawning then
			task.spawn(safeSpawn, agent)
		end
	end
end

-- Infección: el bot pasa a ser zombi (si está vivo, reaparece ya como zombi; si no, al reaparecer)
function Bots.Infect(agent, zombieTeam)
	if agent.Zombie then
		return
	end
	agent.Team = zombieTeam
	agent.Zombie = true
	local entry = statsOf(agent)
	if entry then
		entry:SetAttribute("Team", zombieTeam.Name)
	end
	if agent.Humanoid and agent.Humanoid.Health > 0 and agent.Model then
		-- Paciente cero: se cambia el cuerpo por uno de zombi (sin contar como muerte)
		local model = agent.Model
		agent.Humanoid = nil
		model:Destroy()
		task.spawn(safeSpawn, agent)
	end
end

-- Al cambiar de modo o de equipos, los bots vuelven a elegir equipo
function Bots.Reset()
	for i = #agents, 1, -1 do
		removeAgent(agents[i])
	end
	table.clear(intel) -- (lo que sabían del enemigo era de la ronda anterior)
	table.clear(radarUntil)
end

function Bots.Init()
	if not CONFIG.Enabled then
		return
	end
	folder = Instance.new("Folder")
	folder.Name = "Bots"
	folder.Parent = workspace
	statsFolder = Instance.new("Folder")
	statsFolder.Name = "BotStats"
	statsFolder.Parent = ReplicatedStorage
	ReplicatedStorage:GetAttributeChangedSignal("State"):Connect(function()
		if state() ~= "Playing" then
			Bots.Reset()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(balance)
			if not ok then
				warn("[Bots] balance:", err)
			end
			ok, err = pcall(radarSweep)
			if not ok then
				warn("[Bots] radar:", err)
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.15)
			for _, agent in table.clone(agents) do
				local ok, err = pcall(think, agent)
				if not ok then
					warn("[Bots] think:", err)
				end
			end
		end
	end)
end

Bots.Agents = agents
return Bots
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Bounty</string>
            <string name="Source"><![CDATA[-- "SE BUSCA" (GameConfig.Bounty): el jugador en racha lleva una recompensa por su cabeza. Se marca
-- con un cartel sobre la cabeza (los demás lo ven; él no) y quien lo elimine cobra las monedas.
-- El valor queda en el atributo "Bounty" del jugador (los bots lo usan para ir a por él).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)

local Bounty = {}

local TAG = "BountyTag"
local watched = {} -- jugadores a los que se les vuelve a poner el cartel al cambiar de personaje

local function config()
	return GameConfig.Bounty or {}
end

-- Monedas que vale una racha (0 si aún no llega)
function Bounty.Value(streak)
	local c = config()
	if not c.Enabled or streak < (c.Streak or math.huge) then
		return 0
	end
	return math.min((c.Base or 0) + (c.PerKill or 0) * (streak - c.Streak), c.Max or math.huge)
end

local function removeTag(player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local tag = head and head:FindFirstChild(TAG)
	if tag then
		tag:Destroy()
	end
end

-- Cartel sobre la cabeza (lo crea o actualiza el número)
local function showTag(player, value)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not head then
		return
	end
	local tag = head:FindFirstChild(TAG)
	if not tag then
		tag = Instance.new("BillboardGui")
		tag.Name = TAG
		tag.Size = UDim2.fromOffset(150, 44)
		tag.StudsOffset = Vector3.new(0, 2.8, 0)
		tag.MaxDistance = 140
		tag.LightInfluence = 0
		tag.PlayerToHideFrom = player
		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundColor3 = Color3.fromRGB(120, 20, 20)
		frame.BackgroundTransparency = 0.15
		frame.Parent = tag
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = frame
		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(255, 210, 60)
		stroke.Thickness = 2
		stroke.Parent = frame
		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(255, 225, 90)
		label.TextStrokeTransparency = 0.3
		label.Parent = frame
		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0, 6)
		padding.PaddingRight = UDim.new(0, 6)
		padding.PaddingTop = UDim.new(0, 3)
		padding.PaddingBottom = UDim.new(0, 3)
		padding.Parent = label
		tag.Parent = head
	end
	local label = tag:FindFirstChild("Text", true)
	if label then
		label.Text = "💰 SE BUSCA · " .. value .. " 🪙"
	end
end

-- Si recibe un personaje nuevo sin haber muerto (rondas de Eliminación, paciente cero de la
-- Infección), sigue buscado: el cartel pasa al personaje nuevo
local function watch(player)
	if watched[player] then
		return
	end
	watched[player] = player.CharacterAdded:Connect(function(character)
		local head = character:WaitForChild("Head", 5)
		local value = player:GetAttribute("Bounty") or 0
		if head and value > 0 and player.Character == character then
			showTag(player, value)
		end
	end)
	player.AncestryChanged:Connect(function()
		if not player.Parent and watched[player] then
			watched[player]:Disconnect()
			watched[player] = nil
		end
	end)
end

-- Tras una baja de `player` con racha `streak`: sube (o pone) su recompensa
function Bounty.OnStreak(player, streak)
	local value = Bounty.Value(streak)
	if value <= 0 then
		return
	end
	watch(player)
	local before = player:GetAttribute("Bounty") or 0
	player:SetAttribute("Bounty", value)
	showTag(player, value)
	if before == 0 then
		Remotes.Notify:FireAllClients("Bounty", "SE BUSCA: " .. player.Name .. " · " .. value .. " 🪙 por su cabeza")
		Remotes.Notify:FireClient(player, "Wanted", value)
	end
end

-- Muere `victim`: devuelve las monedas que valía su cabeza (0 si nada) y le quita la marca
function Bounty.Clear(victim)
	local value = victim:GetAttribute("Bounty") or 0
	victim:SetAttribute("Bounty", nil)
	removeTag(victim)
	return value
end

-- Anuncia quién cobró (o que se perdió) la recompensa
function Bounty.Announce(victimName, value, claimerName)
	if claimerName then
		Remotes.Notify:FireAllClients("Bounty", claimerName .. " cobró la recompensa de " .. victimName .. " (" .. value .. " 🪙)")
	else
		Remotes.Notify:FireAllClients("Bounty", "La recompensa de " .. victimName .. " se ha perdido")
	end
end

-- Nueva ronda: nadie es buscado
function Bounty.Reset(player)
	player:SetAttribute("Bounty", nil)
	removeTag(player)
end

return Bounty
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Combat</string>
            <string name="Source"><![CDATA[-- Validación de disparos y daño en el servidor (anti-trampas básico).
-- El cliente calcula el impacto; el servidor comprueba cadencia, munición, distancia y línea de visión.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Weapons = require(Shared.Weapons)
local Remotes = require(Shared.Remotes)

local Ragdoll = require(script.Parent.Ragdoll)

local Combat = {}

-- Asignado desde Main: function(killer: Player?, victim: Player?, victimName, weaponName, headshot, position: Vector3?)
Combat.OnKill = nil
Combat.OnAssist = nil -- (jugadores que ayudaron, nombre de la víctima, bot víctima, jugador víctima)

-- Quién le ha quitado vida a cada Humanoid y cuándo (para las asistencias)
local ASSIST_WINDOW = 10
local ASSIST_MIN_DAMAGE = 20
local damageLog = setmetatable({}, { __mode = "k" }) -- [humanoid] = { [userId] = { Time, Damage } }

-- Cadencia: "cubo" de disparos por arma. Se rellena a FireRate por segundo y guarda hasta 3, así los
-- disparos legítimos que llegan juntos (lag) no se pierden, pero no se puede disparar más rápido.
local fireBudget = setmetatable({}, { __mode = "k" })
local FIRE_BURST_ALLOWANCE = 3
local reloadTokens = setmetatable({}, { __mode = "k" })
local lastMelee = {}

local function getCharacterFromPart(part)
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid then
			return model, humanoid
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil, nil
end

-- Bots activos por nombre (los registra Bots): para saber quién hizo una baja
Combat.BotsByName = {}

local function isEnemy(attacker, targetPlayer, targetChar)
	if not targetPlayer then
		-- Bots del mismo equipo no se dañan; muñecos de práctica y bots enemigos sí
		if targetChar and targetChar:GetAttribute("Bot") and ReplicatedStorage:GetAttribute("TeamMode") and attacker.Team then
			return targetChar:GetAttribute("Team") ~= attacker.Team.Name
		end
		return true
	end
	if attacker == targetPlayer then
		return false
	end
	if attacker.Neutral or targetPlayer.Neutral or not attacker.Team then
		return true
	end
	return attacker.Team ~= targetPlayer.Team
end

local function isHeadshot(part, character, position)
	if part.Name == "Head" then
		return true
	end
	return false
end

-- Los accesorios del avatar (sombreros, alas, mochilas) no reciben disparos: ni escudo ni cabeza gigante
local function ignoreAccessories(character)
	local function apply(inst)
		if inst:IsA("BasePart") and inst:FindFirstAncestorOfClass("Accessory") then
			inst.CanQuery = false
		end
	end
	for _, inst in character:GetDescendants() do
		apply(inst)
	end
	character.DescendantAdded:Connect(apply)
end

local function hasLineOfSight(origin, target, ignore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	ignore = table.clone(ignore)
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary) -- muros invisibles del borde del mapa
	end
	params.FilterDescendantsInstances = ignore
	local offset = target - origin
	local distance = offset.Magnitude - 1.5
	if distance <= 0 then
		return true
	end
	return workspace:Raycast(origin, offset.Unit * distance, params) == nil
end

local function damageAtDistance(def, distance)
	if distance <= def.FalloffStart then
		return def.Damage
	end
	if distance >= def.FalloffEnd then
		return def.MinDamage
	end
	local alpha = (distance - def.FalloffStart) / (def.FalloffEnd - def.FalloffStart)
	return def.Damage + (def.MinDamage - def.Damage) * alpha
end

-- Al atacar se pierde cualquier escudo (el de reaparición y el de la pantalla de inicio)
local function removeSpawnShield(character)
	for _, child in character:GetChildren() do
		if child:IsA("ForceField") then
			child:Destroy()
		end
	end
	local player = Players:GetPlayerFromCharacter(character)
	if player then
		player:SetAttribute("InMenu", false)
	end
end

-- Aplica daño y deja la "etiqueta" del atacante. Devuelve daño real y si murió.
local function applyDamage(attacker, humanoid, damage, weaponName, headshot)
	if humanoid.Health <= 0 then
		return 0, false
	end
	humanoid:SetAttribute("LastAttacker", attacker.UserId)
	humanoid:SetAttribute("LastBot", nil)
	humanoid:SetAttribute("LastWeapon", weaponName)
	humanoid:SetAttribute("LastHeadshot", headshot)
	humanoid:SetAttribute("LastHitTime", os.clock())
	local before = humanoid.Health
	humanoid:TakeDamage(damage) -- respeta el ForceField de spawn
	local dealt = before - humanoid.Health
	if dealt > 0 then
		local log = damageLog[humanoid] or {}
		damageLog[humanoid] = log
		local entry = log[attacker.UserId]
		if entry and os.clock() - entry.Time < ASSIST_WINDOW then
			entry.Damage += dealt
		else
			entry = { Damage = dealt }
			log[attacker.UserId] = entry
		end
		entry.Time = os.clock()
	end
	return dealt, humanoid.Health <= 0
end

-- Daño de un bot (ver Bots): deja su nombre como atacante
-- Ruido de los disparos: los bots oyen los tiros cercanos (como el punto rojo del minimapa en los
-- shooters de móvil) y van a ver. Las armas con silenciador apenas se oyen.
Combat.Noise = {} -- { Position, Time, Team, Model, Range }
local NOISE_KEEP = 24
function Combat.ReportNoise(position, team, model, weaponName)
	local def = Weapons.Get(weaponName or "")
	local range = (def and def.Suppressed) and 25 or 110
	-- Ventaja "Fantasma": los bots le oyen la mitad de lejos
	local owner = model and Players:GetPlayerFromCharacter(model)
	if owner and owner:GetAttribute("Perk") == 3 then
		range *= 0.5
	end
	table.insert(Combat.Noise, { Position = position, Time = os.clock(), Team = team, Model = model, Range = range })
	if #Combat.Noise > NOISE_KEEP then
		table.remove(Combat.Noise, 1)
	end
end

function Combat.BotDamage(bot, humanoid, damage, weaponName)
	if humanoid.Health <= 0 then
		return 0, false
	end
	humanoid:SetAttribute("LastAttacker", nil)
	humanoid:SetAttribute("LastBot", bot.Name)
	humanoid:SetAttribute("LastWeapon", weaponName)
	humanoid:SetAttribute("LastHeadshot", false)
	humanoid:SetAttribute("LastHitTime", os.clock())
	local before = humanoid.Health
	humanoid:TakeDamage(damage)
	return before - humanoid.Health, humanoid.Health <= 0
end

-- Daño en área (cohetes). Afecta a enemigos y muñecos con línea de visión desde la explosión.
function Combat.Explode(attacker, position, def, weaponName)
	local info = def.Explosive
	local candidates = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(candidates, p.Character)
		end
	end
	for _, folderName in { "Dummies", "Bots" } do
		local npcs = workspace:FindFirstChild(folderName)
		if npcs then
			for _, d in npcs:GetChildren() do
				table.insert(candidates, d)
			end
		end
	end
	local totalDealt, anyKill, hitPosition, best = 0, false, nil, 0
	local attackerChar = attacker.Character
	for _, targetChar in candidates do
		local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
		local root = targetChar:FindFirstChild("HumanoidRootPart")
		if humanoid and root and humanoid.Health > 0 and targetChar ~= attackerChar then
			local targetPlayer = Players:GetPlayerFromCharacter(targetChar)
			local distance = (root.Position - position).Magnitude
			if distance <= info.Radius and isEnemy(attacker, targetPlayer, targetChar) then
				if hasLineOfSight(position, root.Position, { targetChar, attackerChar }) then
					local alpha = distance / info.Radius
					local damage = info.Damage + (info.MinDamage - info.Damage) * alpha
					local dealt, killed = applyDamage(attacker, humanoid, damage, weaponName, false)
					totalDealt += dealt
					anyKill = anyKill or killed
					if dealt > best then
						best, hitPosition = dealt, root.Position
					end
				end
			end
		end
	end
	if totalDealt > 0 then
		Remotes.HitConfirm:FireClient(attacker, math.floor(totalDealt + 0.5), false, anyKill, hitPosition)
	end
end

-- Detecta la muerte de un Humanoid y avisa a quien corresponda
-- victimBot: el bot (ver Bots) si el que muere es un bot
function Combat.WatchHumanoid(humanoid, victimPlayer, victimName, victimBot)
	Ragdoll.Prepare(humanoid) -- (que Roblox no rompa el cuerpo en piezas al morir)
	humanoid.Died:Connect(function()
		-- El cuerpo cae como un muñeco de trapo, con un empujón alejándose de quien le dio
		-- (mucho más fuerte con explosivos)
		pcall(function()
			local character = humanoid.Parent
			local victimRoot = character and character:FindFirstChild("HumanoidRootPart")
			local push
			local attackerId = humanoid:GetAttribute("LastAttacker")
			local attacker = attackerId and Players:GetPlayerByUserId(attackerId)
			local attackerModel = (attacker and attacker.Character)
				or (humanoid:GetAttribute("LastBot") and Combat.BotsByName[humanoid:GetAttribute("LastBot")] and Combat.BotsByName[humanoid:GetAttribute("LastBot")].Model)
			local attackerRoot = attackerModel and attackerModel:FindFirstChild("HumanoidRootPart")
			if victimRoot and attackerRoot then
				local away = victimRoot.Position - attackerRoot.Position
				away = Vector3.new(away.X, 0, away.Z)
				if away.Magnitude > 0.1 then
					local def = Weapons.Get(humanoid:GetAttribute("LastWeapon") or "")
					local strength = def and def.Explosive and 38 or 9
					push = away.Unit * strength + Vector3.new(0, def and def.Explosive and 22 or 3, 0)
				end
			end
			Ragdoll.Apply(character, push)
		end)
		local killer, killerBot
		local hitTime = humanoid:GetAttribute("LastHitTime")
		local recent = hitTime and os.clock() - hitTime < 10
		local attackerId = humanoid:GetAttribute("LastAttacker")
		if attackerId and recent then
			killer = Players:GetPlayerByUserId(attackerId)
		end
		local botName = humanoid:GetAttribute("LastBot")
		if botName and recent and not killer then
			killerBot = Combat.BotsByName[botName]
		end
		local weaponName = humanoid:GetAttribute("LastWeapon")
		local headshot = humanoid:GetAttribute("LastHeadshot") == true
		local character = humanoid.Parent
		local root = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head"))
		local position = root and root.Position
		if victimPlayer then
			-- Vida que le quedaba al que te eliminó (se enseña en la pantalla de muerte)
			local killerHumanoid = killer and killer.Character and killer.Character:FindFirstChildOfClass("Humanoid")
				or (killerBot and killerBot.Humanoid)
			local killerHealth = killerHumanoid and math.ceil(math.max(0, killerHumanoid.Health)) or nil
			local killerName = (killer and killer.Name) or (killerBot and killerBot.Name) or nil
			Remotes.Died:FireClient(victimPlayer, killerName, weaponName, killerHealth)
		end
		-- Espectador de Eliminación (entró a mitad de ronda): pantalla de muerte, pero sin baja ni muerte
		-- (el equipo del caído antes de que OnKill lo cambie: en Infección pasa a zombi)
		local victimTeamBefore = (victimPlayer and victimPlayer.Team) or (victimBot and victimBot.Team) or nil
		if Combat.OnKill and not humanoid:GetAttribute("Spectator") then
			Combat.OnKill(killer, victimPlayer, victimName, weaponName, headshot, position, killerBot, victimBot)
		end
		-- Asistencias: quien le quitó bastante vida hace poco y no es quien lo remató
		local log = damageLog[humanoid]
		damageLog[humanoid] = nil
		-- (solo contra jugadores y bots, no muñecos; y no si ahora es del mismo equipo, p. ej. en Infección)
		if log and Combat.OnAssist and (victimPlayer or victimBot) and not humanoid:GetAttribute("Spectator") then
			local victimTeam = victimTeamBefore
			local helpers = {}
			for userId, entry in log do
				local helper = Players:GetPlayerByUserId(userId)
				if helper and helper ~= killer and helper ~= victimPlayer and entry.Damage >= ASSIST_MIN_DAMAGE
					and os.clock() - entry.Time < ASSIST_WINDOW and not (victimTeam and helper.Team == victimTeam) then
					table.insert(helpers, helper)
				end
			end
			if #helpers > 0 then
				Combat.OnAssist(helpers, victimName, victimBot, victimPlayer)
			end
		end
	end)
end

local function frozen()
	return ReplicatedStorage:GetAttribute("Frozen") == true -- cuenta atrás de Eliminación
end

local function onFire(player, tool, origin, rays)
	if frozen() then
		return
	end
	if typeof(tool) ~= "Instance" or not tool:IsA("Tool") or typeof(origin) ~= "Vector3" or type(rays) ~= "table" then
		return
	end
	local character = player.Character
	if not character or tool.Parent ~= character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local head = character:FindFirstChild("Head")
	if not humanoid or humanoid.Health <= 0 or not head then
		return
	end
	local weaponName = tool:GetAttribute("Weapon")
	local def = Weapons.Get(weaponName)
	if not def or def.Type ~= "Gun" or tool:GetAttribute("Reloading") then
		return
	end
	local ammo = tool:GetAttribute("Ammo") or 0
	if ammo <= 0 then
		return
	end
	local now = os.clock()
	-- Armas lentas (escopetas, francotiradores) no acumulan: 1 disparo; las rápidas hasta 3
	local cap = math.clamp(def.FireRate * 0.2, 1, FIRE_BURST_ALLOWANCE)
	local budget = fireBudget[tool]
	if not budget then
		budget = { Time = now, Shots = cap }
		fireBudget[tool] = budget
	end
	budget.Shots = math.min(cap, budget.Shots + (now - budget.Time) * def.FireRate * 1.15)
	budget.Time = now
	if budget.Shots < 1 then
		return
	end
	-- El origen del disparo tiene que estar cerca de la cabeza y SIN pared en medio
	if (head.Position - origin).Magnitude > 12 or not hasLineOfSight(head.Position, origin, { character }) then
		return
	end
	budget.Shots -= 1
	tool:SetAttribute("Ammo", ammo - 1)
	removeSpawnShield(character)
	Combat.ReportNoise(head.Position, player.Team, character, weaponName)

	if def.Explosive then
		local ray = rays[1]
		if type(ray) ~= "table" or typeof(ray.Position) ~= "Vector3" then
			return
		end
		local position = ray.Position
		if (position - origin).Magnitude > def.Range + 5 then
			return
		end
		-- El cohete no puede atravesar paredes hasta el punto de impacto
		local back = (origin - position).Unit * 1.5
		if not hasLineOfSight(origin, position + back, { character }) then
			return
		end
		Combat.Explode(player, position + back * 0.5, def, tool:GetAttribute("Weapon"))
		for _, other in Players:GetPlayers() do
			if other ~= player then
				Remotes.ShotFX:FireClient(other, tool, { position })
			end
		end
		return
	end

	local endpoints = {}
	local perTarget = {}
	for i = 1, math.min(#rays, def.Pellets) do
		local ray = rays[i]
		if type(ray) == "table" and typeof(ray.Position) == "Vector3" then
			local position = ray.Position
			local distance = (position - origin).Magnitude
			if distance <= def.Range + 5 then
				table.insert(endpoints, position)
				local part = ray.Part
				if typeof(part) == "Instance" and part:IsA("BasePart") and part:IsDescendantOf(workspace) then
					local targetChar, targetHum = getCharacterFromPart(part)
					if targetChar and targetChar ~= character and targetHum.Health > 0 then
						local targetPlayer = Players:GetPlayerFromCharacter(targetChar)
						local closeEnough = (part.Position - position).Magnitude <= part.Size.Magnitude / 2 + 8
						if
							isEnemy(player, targetPlayer, targetChar)
							and closeEnough
							and hasLineOfSight(origin, position, { character, targetChar })
						then
							local headshot = isHeadshot(part, targetChar, position)
							local damage = damageAtDistance(def, distance)
								* (headshot and def.HeadshotMultiplier or 1)
							local entry = perTarget[targetHum]
							if not entry then
								entry = { Damage = 0, Headshot = false }
								perTarget[targetHum] = entry
							end
							entry.Damage += damage
							entry.Position = position
							entry.Headshot = entry.Headshot or headshot
						end
					end
				end
			end
		end
	end

	-- hitPosition: dónde se hizo más daño (el cliente pone ahí el número de daño)
	local totalDealt, anyHeadshot, anyKill, hitPosition, best = 0, false, false, nil, 0
	for targetHum, entry in perTarget do
		local dealt, killed = applyDamage(player, targetHum, entry.Damage, weaponName, entry.Headshot)
		if dealt > 0 then
			totalDealt += dealt
			anyHeadshot = anyHeadshot or entry.Headshot
			anyKill = anyKill or killed
			if dealt > best then
				best, hitPosition = dealt, entry.Position
			end
		end
	end
	if totalDealt > 0 then
		Remotes.HitConfirm:FireClient(player, math.floor(totalDealt + 0.5), anyHeadshot, anyKill, hitPosition)
	end

	for _, other in Players:GetPlayers() do
		if other ~= player then
			Remotes.ShotFX:FireClient(other, tool, endpoints)
		end
	end
end

local function onReload(player, tool)
	if typeof(tool) ~= "Instance" or not tool:IsA("Tool") then
		return
	end
	local character = player.Character
	if not character or tool.Parent ~= character then
		return
	end
	local def = Weapons.Get(tool:GetAttribute("Weapon"))
	if not def or def.Type ~= "Gun" or tool:GetAttribute("Reloading") then
		return
	end
	local ammo = tool:GetAttribute("Ammo") or 0
	local reserve = tool:GetAttribute("Reserve") or 0
	if ammo >= def.MagSize or reserve <= 0 then
		return
	end
	tool:SetAttribute("Reloading", true)
	local token = {}
	reloadTokens[tool] = token
	-- (con balas aún en el cargador, recarga táctica: más rápida)
	task.delay(Weapons.ReloadDuration(def, ammo <= 0), function()
		if reloadTokens[tool] ~= token then
			return
		end
		reloadTokens[tool] = nil
		-- Si cambió de arma la recarga ya se canceló (Reloading = false)
		if not tool:GetAttribute("Reloading") or tool.Parent ~= player.Character then
			tool:SetAttribute("Reloading", false)
			return
		end
		local currentAmmo = tool:GetAttribute("Ammo") or 0
		local currentReserve = tool:GetAttribute("Reserve") or 0
		local take = math.min(def.MagSize - currentAmmo, currentReserve)
		tool:SetAttribute("Ammo", currentAmmo + take)
		tool:SetAttribute("Reserve", currentReserve - take)
		tool:SetAttribute("Reloading", false)
	end)
end

-- Arma cuerpo a cuerpo que lleva el jugador (cuchillo, martillo o katana): su nombre
local function findMelee(player)
	for _, container in { player.Character, player:FindFirstChild("Backpack") } do
		if container then
			for _, tool in container:GetChildren() do
				local name = tool:IsA("Tool") and tool:GetAttribute("Weapon")
				local def = name and Weapons.Get(name)
				if def and def.Type == "Melee" then
					return name
				end
			end
		end
	end
	return nil
end

local function onMelee(player, part)
	if frozen() then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local meleeName = findMelee(player)
	if not humanoid or humanoid.Health <= 0 or not root or not meleeName then
		return
	end
	local def = Weapons.Get(meleeName)
	local now = os.clock()
	if now - (lastMelee[player] or 0) < def.Cooldown * 0.8 then
		return
	end
	lastMelee[player] = now
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") or not part:IsDescendantOf(workspace) then
		return
	end
	local targetChar, targetHum = getCharacterFromPart(part)
	if not targetChar or targetChar == character or targetHum.Health <= 0 then
		return
	end
	local targetRoot = targetChar:FindFirstChild("HumanoidRootPart") or part
	if (targetRoot.Position - root.Position).Magnitude > def.Range + 4 then
		return
	end
	if not isEnemy(player, Players:GetPlayerFromCharacter(targetChar), targetChar) then
		return
	end
	-- Nada de cuchillazos a través de paredes
	if not hasLineOfSight(root.Position, targetRoot.Position, { character, targetChar }) then
		return
	end
	removeSpawnShield(character)
	local dealt, killed = applyDamage(player, targetHum, def.Damage, meleeName, false)
	if dealt > 0 then
		Remotes.HitConfirm:FireClient(player, math.floor(dealt + 0.5), false, killed, targetRoot.Position)
	end
end

function Combat.Init()
	Remotes.Fire.OnServerEvent:Connect(onFire)
	Remotes.Reload.OnServerEvent:Connect(onReload)
	Remotes.Melee.OnServerEvent:Connect(onMelee)

	local function onPlayer(player)
		player.CharacterAdded:Connect(function(character)
			ignoreAccessories(character)
			local humanoid = character:WaitForChild("Humanoid")
			Combat.WatchHumanoid(humanoid, player, player.Name)
		end)
		if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
			ignoreAccessories(player.Character)
			Combat.WatchHumanoid(player.Character:FindFirstChildOfClass("Humanoid"), player, player.Name)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastMelee[player] = nil
	end)
end

return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Domination</string>
            <string name="Source"><![CDATA[-- Modo "Dominio" (el clásico de los shooters de móvil): tres banderas A, B y C. A queda cerca de la
-- base del primer equipo, B en el centro y C cerca de la base del segundo. Se captura quedándose
-- dentro (~5 s; más rápido con más compañeros) sin enemigos; si hay de los dos equipos, la captura
-- se para. Cada bandera tuya suma 1 punto cada SCORE_EVERY segundos.
--
-- Estado para la interfaz (atributos de ReplicatedStorage), para cada letra L en A, B, C:
--   Dom_L_Position (Vector3), Dom_L_Owner ("" o equipo), Dom_L_Capturing ("" o equipo),
--   Dom_L_Progress (0..1, de la captura en curso), Dom_L_Contested (bool)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Teams = game:GetService("Teams")

local Shared = ReplicatedStorage.Shared
local Remotes = require(Shared.Remotes)

local PlayerData = require(script.Parent.PlayerData)

local Domination = {}

Domination.OnScore = nil -- function(team, amount)

local LETTERS = { "A", "B", "C" }
local CAPTURE_TIME = 5 -- segundos con una persona
local SCORE_EVERY = 3 -- segundos entre puntos de cada bandera
local STEP = 0.25

local active = false
local points = {} -- { Letter, Position, Radius, Owner (Team?), Capturing (Team?), Progress, Visual }
local thread

local function findZones()
	local list = {}
	local map = workspace:FindFirstChild("Map")
	if map then
		for _, d in map:GetDescendants() do
			if d:IsA("BasePart") and d.Name == "HardpointZone" then
				table.insert(list, d)
			end
		end
	end
	return list
end

local function teamSpawnCenter(team)
	local map = workspace:FindFirstChild("Map")
	local sum, count = Vector3.zero, 0
	if map then
		for _, d in map:GetDescendants() do
			if d:IsA("SpawnLocation") and d.TeamColor == team.TeamColor then
				sum += d.Position
				count += 1
			end
		end
	end
	return count > 0 and sum / count or nil
end

function Domination.IsAvailable()
	return #findZones() >= 3
end

-- A: la zona más cerca de la base del primer equipo; C: la más cerca de la del segundo; B: la más
-- centrada entre las dos (de las que quedan)
local function choosePoints()
	local zones = findZones()
	local teams = Teams:GetTeams()
	if #zones < 3 or #teams < 2 then
		return nil
	end
	local baseA, baseB = teamSpawnCenter(teams[1]), teamSpawnCenter(teams[2])
	if not baseA or not baseB then
		return { zones[1], zones[2], zones[3] }
	end
	local function closest(list, target, exclude)
		local best, bestDistance = nil, math.huge
		for _, zone in list do
			if not exclude[zone] then
				local distance = (zone.Position - target).Magnitude
				if distance < bestDistance then
					best, bestDistance = zone, distance
				end
			end
		end
		return best
	end
	local used = {}
	local middle = (baseA + baseB) / 2
	local b = closest(zones, middle, used)
	used[b] = true
	local a = closest(zones, baseA, used)
	used[a] = true
	local c = closest(zones, baseB, used)
	return { a, b, c }
end

local function makeVisual(point)
	local radius = point.Radius
	local model = Instance.new("Model")
	model.Name = "DomFlag_" .. point.Letter
	local function part(name, size, cf, material, transparency)
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Size = size
		p.CFrame = cf
		p.Material = material
		p.Transparency = transparency or 0
		p.Color = Color3.new(1, 1, 1)
		p.Parent = model
		return p
	end
	local base = point.Position
	local ring = part("Ring", Vector3.new(0.3, radius * 2 + 1, radius * 2 + 1), CFrame.new(base + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.pi / 2), Enum.Material.Neon)
	ring.Shape = Enum.PartType.Cylinder
	local fill = part("Fill", Vector3.new(0.32, radius * 2 - 1, radius * 2 - 1), CFrame.new(base + Vector3.new(0, 0.21, 0)) * CFrame.Angles(0, 0, math.pi / 2), Enum.Material.ForceField, 0.35)
	fill.Shape = Enum.PartType.Cylinder
	-- Mástil: en el centro si hay sitio; si hay algo justo encima (un monumento), hacia el borde de
	-- la zona; bajo techo (dentro de un edificio), más bajo
	local poleBase, poleHeight = base, 9
	local bestRoom = -1
	for _, offset in { Vector3.zero, Vector3.new(radius * 0.6, 0, 0), Vector3.new(0, 0, radius * 0.6), Vector3.new(-radius * 0.6, 0, 0), Vector3.new(0, 0, -radius * 0.6) } do
		local hit = workspace:Raycast(base + offset + Vector3.new(0, 1, 0), Vector3.new(0, 10, 0))
		local room = hit and hit.Distance or 10
		if room > bestRoom then
			bestRoom, poleBase = room, base + offset
		end
		if room >= 9 then
			break
		end
	end
	poleHeight = math.clamp(bestRoom + 1 - 0.6, 3, 9)
	local pole = part("Pole", Vector3.new(0.4, poleHeight, 0.4), CFrame.new(poleBase + Vector3.new(0, poleHeight / 2, 0)), Enum.Material.Metal)
	pole.Color = Color3.fromRGB(60, 60, 64)
	part("Flag", Vector3.new(0.15, math.min(2.4, poleHeight * 0.3), 3.6), CFrame.new(poleBase + Vector3.new(0, poleHeight - 1.4, 1.8)), Enum.Material.Fabric)
	local light = Instance.new("PointLight")
	light.Range = radius * 2
	light.Brightness = 1.5
	light.Parent = ring
	-- Letra visible a través de las paredes
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(60, 60)
	billboard.StudsOffset = Vector3.new(0, 11, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = 1500
	billboard.Parent = pole
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextStrokeTransparency = 0.2
	label.Text = point.Letter
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Parent = billboard
	model.Parent = workspace
	point.Visual = model
end

local function paint(point)
	local color = point.Owner and point.Owner.TeamColor.Color or Color3.new(1, 1, 1)
	if point.Contested then
		color = Color3.fromRGB(255, 200, 40)
	end
	if point.Painted == color or not point.Visual then
		return
	end
	point.Painted = color
	for _, p in point.Visual:GetDescendants() do
		if p:IsA("BasePart") and p.Name ~= "Pole" then
			p.Color = color
		elseif p:IsA("PointLight") then
			p.Color = color
		elseif p:IsA("TextLabel") then
			p.TextColor3 = color
		end
	end
end

-- Quién está dentro: { [Team] = { jugadores } } (los bots cuentan, sin lista de jugadores)
local function occupants(point)
	local byTeam, counts = {}, {}
	local function add(team, player, root)
		local offset = root.Position - point.Position
		if Vector3.new(offset.X, 0, offset.Z).Magnitude <= point.Radius and offset.Y > -3 and offset.Y < 10 then
			byTeam[team] = byTeam[team] or {}
			counts[team] = (counts[team] or 0) + 1
			if player then
				table.insert(byTeam[team], player)
			end
		end
	end
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if player.Team and humanoid and humanoid.Health > 0 and root and not player:GetAttribute("InMenu") then
			add(player.Team, player, root)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart")
			local team = Teams:FindFirstChild(model:GetAttribute("Team") or "")
			if team and team:IsA("Team") and humanoid and humanoid.Health > 0 and root then
				add(team, nil, root)
			end
		end
	end
	return byTeam, counts
end

local function publish(point)
	local prefix = "Dom_" .. point.Letter .. "_"
	ReplicatedStorage:SetAttribute(prefix .. "Owner", point.Owner and point.Owner.Name or "")
	ReplicatedStorage:SetAttribute(prefix .. "Capturing", point.Capturing and point.Capturing.Name or "")
	ReplicatedStorage:SetAttribute(prefix .. "Progress", math.floor(point.Progress * 100 + 0.5) / 100)
	ReplicatedStorage:SetAttribute(prefix .. "Contested", point.Contested == true)
end

local function update(point, dt)
	local byTeam, counts = occupants(point)
	local present = {}
	for team in byTeam do
		table.insert(present, team)
	end
	point.Contested = #present > 1
	if #present == 1 and present[1] ~= point.Owner then
		-- Capturando (si había otro equipo a medias, empieza de cero)
		local team = present[1]
		if point.Capturing ~= team then
			point.Capturing, point.Progress = team, 0
		end
		local speed = math.min(2, 1 + (counts[team] - 1) * 0.5) -- (más gente, más rápido)
		point.Progress = math.min(1, point.Progress + dt * speed / CAPTURE_TIME)
		if point.Progress >= 1 then
			local previous = point.Owner
			point.Owner, point.Capturing, point.Progress = team, nil, 0
			Remotes.Notify:FireAllClients("Flag", "🚩 " .. team.Name .. " captura " .. point.Letter .. (previous and " (era de " .. previous.Name .. ")" or ""))
			for _, player in byTeam[team] do
				PlayerData.AddXP(player, 50, "Captura " .. point.Letter)
				PlayerData.Track(player, "ZoneTime", 5)
			end
		end
	elseif #present == 1 and present[1] == point.Owner and point.Capturing then
		-- Los dueños vuelven a su bandera: deshacen la captura enemiga a medias
		point.Progress = math.max(0, point.Progress - dt * 2 / CAPTURE_TIME)
		if point.Progress <= 0 then
			point.Capturing = nil
		end
	elseif #present == 0 and point.Capturing then
		-- Nadie dentro: la captura a medias se va perdiendo
		point.Progress = math.max(0, point.Progress - dt / CAPTURE_TIME)
		if point.Progress <= 0 then
			point.Capturing = nil
		end
	end
	paint(point)
	publish(point)
end

function Domination.Start()
	Domination.Stop()
	local zones = choosePoints()
	if not zones then
		return false
	end
	points = {}
	for i, zone in zones do
		local point = {
			Letter = LETTERS[i],
			Position = zone.Position,
			Radius = math.max(8, zone:GetAttribute("Radius") or 10),
			Owner = nil,
			Capturing = nil,
			Progress = 0,
		}
		ReplicatedStorage:SetAttribute("Dom_" .. point.Letter .. "_Position", point.Position)
		makeVisual(point)
		publish(point)
		table.insert(points, point)
	end
	active = true
	thread = task.spawn(function()
		local scoreClock = 0
		while active do
			task.wait(STEP)
			scoreClock += STEP
			for _, point in points do
				update(point, STEP)
			end
			if scoreClock >= SCORE_EVERY then
				scoreClock = 0
				for _, point in points do
					if point.Owner and Domination.OnScore then
						Domination.OnScore(point.Owner, 1)
					end
				end
			end
		end
	end)
	return true
end

-- Para los bots: las banderas con su estado
function Domination.Points()
	return points
end

function Domination.Stop()
	active = false
	if thread then
		pcall(task.cancel, thread)
		thread = nil
	end
	for _, point in points do
		if point.Visual then
			point.Visual:Destroy()
		end
	end
	points = {}
	for _, letter in LETTERS do
		for _, field in { "Position", "Owner", "Capturing", "Progress", "Contested" } do
			ReplicatedStorage:SetAttribute("Dom_" .. letter .. "_" .. field, nil)
		end
	end
end

return Domination
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Dummies</string>
            <string name="Source"><![CDATA[-- Muñecos de práctica para probar las armas en Studio (desactívalos en GameConfig.TrainingDummies).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Combat = require(script.Parent.Combat)

local Dummies = {}

local SPOTS = {
	Vector3.new(-20, 4, -60),
	Vector3.new(20, 4, 60),
	Vector3.new(-50, 4, 30),
	Vector3.new(50, 4, -30),
	Vector3.new(0, 11, 0),
}

local folder

-- Un punto libre del mapa actual (puntos FFASpawn) o uno de los fijos si no hay
local function randomSpot(fallback)
	local map = workspace:FindFirstChild("Map")
	local points = {}
	if map then
		for _, d in map:GetDescendants() do
			if d:IsA("BasePart") and d.Name == "FFASpawn" then
				table.insert(points, d.Position + Vector3.new(0, 3, 0))
			end
		end
	end
	if #points > 0 then
		return points[math.random(1, #points)]
	end
	return fallback
end

local function spawnDummy(position)
	position = randomSpot(position)
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = Color3.fromRGB(255, 200, 80)
	description.TorsoColor = Color3.fromRGB(80, 80, 90)
	description.LeftArmColor = Color3.fromRGB(255, 200, 80)
	description.RightArmColor = Color3.fromRGB(255, 200, 80)
	description.LeftLegColor = Color3.fromRGB(60, 60, 70)
	description.RightLegColor = Color3.fromRGB(60, 60, 70)

	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescriptionAsync(description, Enum.HumanoidRigType.R15)
	end)
	if not ok then
		ok, model = pcall(function()
			return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
		end)
	end
	if not ok then
		warn("[Dummies] No se pudo crear el muñeco:", model)
		return
	end
	model.Name = "Muñeco"
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayName = "Muñeco"
	humanoid.MaxHealth = 100
	humanoid.Health = 100
	model:PivotTo(CFrame.new(position) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	model.Parent = folder

	Combat.WatchHumanoid(humanoid, nil, "Muñeco")
	humanoid.Died:Connect(function()
		task.wait(4)
		model:Destroy()
		spawnDummy(position)
	end)
end

function Dummies.Init()
	if not GameConfig.TrainingDummies then
		return
	end
	folder = Instance.new("Folder")
	folder.Name = "Dummies"
	folder.Parent = workspace
	-- (cada uno en su hilo: crear el modelo espera a la red y no debe frenar el arranque del servidor)
	for _, position in SPOTS do
		task.spawn(spawnDummy, position)
	end
end

return Dummies
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Event</string>
            <string name="Source"><![CDATA[-- Evento de temporada (GameConfig.Event: el de las fechas de hoy, ver GameConfig.Events): durante
-- las rondas van apareciendo objetos del evento por el mapa (caramelos en Halloween, regalos en
-- Navidad) en los puntos de aparición libres. Al tocar uno: monedas y +1 al contador del evento (se
-- guarda); hay premios por el camino (Milestones) y al llegar a Goal se gana la skin exclusiva.
-- También decora los mapas (calabazas o muñecos de nieve; Event.Decorate lo llama MapBuilder).
-- Los bots no recogen objetos.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Skins = require(Shared.Skins)
local Outfits = require(Shared.Outfits)
local Weapons = require(Shared.Weapons)

local PlayerData = require(script.Parent.PlayerData)
local Kit = require(script.Parent.MapKit)

local Event = {}

-- El evento que toca (GameConfig.Event); con el servidor encendido mucho tiempo se cambia solo al
-- siguiente cuando acaba uno (ver useEvent en el bucle de Init)
local CONFIG, CANDY_COLORS, ICON, ITEM_ICON, ITEMS
local function useEvent(event)
	CONFIG = event
	GameConfig.Event = event
	CANDY_COLORS = event and event.ItemColors or { Color3.fromRGB(255, 130, 20) }
	ICON = event and event.Icon or "🎉"
	ITEM_ICON = event and event.ItemIcon or "⭐"
	ITEMS = event and event.Items or "objetos"
end
useEvent(GameConfig.Event)

local folder
local candies = {}
local lastPickup = {} -- [player] = os.clock() (límite de recogida)
local LIFETIME = 60 -- segundos que dura un caramelo sin recoger
local PICKUP_RANGE = 9 -- distancia máxima real al caramelo (contra trampas de "toque" a distancia)

local function enabled()
	return GameConfig.EventActive(CONFIG)
end

-- Puntos libres del mapa actual (FFASpawn); se guardan mientras no cambie el mapa
local cachedMap, cachedPoints = nil, {}
local function spawnPoints()
	local map = workspace:FindFirstChild("Map")
	if map ~= cachedMap then
		cachedMap, cachedPoints = map, {}
		if map then
			for _, d in map:GetDescendants() do
				if d:IsA("BasePart") and d.Name == "FFASpawn" then
					table.insert(cachedPoints, d.Position)
				end
			end
		end
	end
	return cachedPoints
end

local function clear()
	for _, candy in candies do
		candy:Destroy()
	end
	table.clear(candies)
end

-- Clave de un premio por el camino en la lista de reclamados. Los de arma llevan una clave propia:
-- ese premio antes eran monedas, y quien ya las cobró también debe recibir el arma.
local function milestoneKey(milestone)
	return "m" .. milestone.Count .. (milestone.Weapon and "w" or "")
end

local addProgress -- (definida justo después)

local function collect(player, candy)
	if not candy.Parent or candy:GetAttribute("Taken") then
		return
	end
	-- Comprobaciones del servidor: de verdad cerca y no demasiado seguido
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - candy.Position).Magnitude > PICKUP_RANGE then
		return
	end
	if os.clock() - (lastPickup[player] or 0) < 0.25 then
		return
	end
	lastPickup[player] = os.clock()
	candy:SetAttribute("Taken", true)
	local index = table.find(candies, candy)
	if index then
		table.remove(candies, index)
	end
	candy:Destroy()
	addProgress(player, 1, true)
end

-- Suma objetos del evento al contador del jugador y da los premios por el camino.
-- pickup = true: recogido en el mapa (da monedas y avisa con el contador)
addProgress = function(player, amount, pickup)
	local data = PlayerData.Get(player)
	if not data then
		return
	end
	if type(data.EventProgress) ~= "table" or data.EventProgress.Id ~= CONFIG.Id then
		data.EventProgress = { Id = CONFIG.Id, Count = 0 }
	end
	if type(data.EventProgress.Claimed) ~= "table" then
		-- Premios por el camino ya dados ("m25" = true). Los que ya se pasaron antes de existir esta
		-- lista se dieron al llegar justo a su número: se marcan como dados para no pagarlos dos veces
		local claimed = {}
		for _, milestone in CONFIG.Milestones or {} do
			if data.EventProgress.Count >= milestone.Count and not milestone.Weapon then
				claimed[milestoneKey(milestone)] = true
			end
		end
		data.EventProgress.Claimed = claimed
	end
	data.EventProgress.Count += amount
	local count = data.EventProgress.Count
	PlayerData.MarkDirty(player)
	if pickup then
		local coins = PlayerData.AddCoins(player, CONFIG.CandyCoins) -- (envía los datos al cliente, contador incluido)
		local itemName = CONFIG.Item or "objeto"
		Remotes.Notify:FireClient(player, "XP", ITEM_ICON .. " " .. string.upper(string.sub(itemName, 1, 1)) .. string.sub(itemName, 2) .. "  +" .. coins .. " 🪙  (" .. math.min(count, CONFIG.Goal) .. "/" .. CONFIG.Goal .. ")")
	else
		PlayerData.SendUpdate(player)
		Remotes.Notify:FireClient(player, "Challenge", ITEM_ICON .. " +" .. amount .. " " .. ITEMS .. " de regalo  (" .. math.min(count, CONFIG.Goal) .. "/" .. CONFIG.Goal .. ")")
	end
	-- Premios por el camino (también los que quedaron atrás si el premio se añadió con el evento empezado)
	local claimed = data.EventProgress.Claimed
	for _, milestone in CONFIG.Milestones or {} do
		local key = milestoneKey(milestone)
		if count >= milestone.Count and milestone.Count < CONFIG.Goal and not claimed[key] then
			claimed[key] = true
			if milestone.Outfit and PlayerData.GiveOutfit(player, milestone.Outfit) then
				local outfit = Outfits.Get(milestone.Outfit)
				Remotes.Notify:FireClient(player, "Challenge", ICON .. " ¡" .. milestone.Count .. " " .. ITEMS .. "! Traje " .. outfit.Name .. " desbloqueado")
			elseif milestone.Weapon and PlayerData.GiveWeapon(player, milestone.Weapon) then
				Remotes.Notify:FireClient(player, "Challenge", ICON .. " ¡" .. milestone.Count .. " " .. ITEMS .. "! Arma " .. Weapons.Get(milestone.Weapon).DisplayName .. " desbloqueada")
			else
				local amount = milestone.Coins or milestone.Compensate or 0
				if amount > 0 then
					PlayerData.AddCoins(player, amount, false) -- premio fijo (no lo dobla el VIP)
					Remotes.Notify:FireClient(player, "Challenge", ICON .. " ¡" .. milestone.Count .. " " .. ITEMS .. "! +" .. amount .. " 🪙")
				end
			end
		end
	end
	if count >= CONFIG.Goal and PlayerData.GiveSkin(player, CONFIG.RewardSkin) then
		local skin = Skins.Get(CONFIG.RewardSkin)
		Remotes.Notify:FireClient(player, "Challenge", ICON .. " ¡Skin " .. skin.Name .. " desbloqueada!")
	end
end

-- Raycast solo contra el mapa (ni jugadores ni bots)
local mapParams = RaycastParams.new()
mapParams.FilterType = Enum.RaycastFilterType.Include

local function groundAt(position, up, down)
	local map = workspace:FindFirstChild("Map")
	if not map then
		return nil
	end
	mapParams.FilterDescendantsInstances = { map, workspace.Terrain }
	local hit = workspace:Raycast(position + Vector3.new(0, up, 0), Vector3.new(0, -(up + down), 0), mapParams)
	return hit and hit.Instance.CanCollide and hit.Position or nil
end

local function spawnCandy()
	local points = spawnPoints()
	if #points == 0 then
		return
	end
	local base = points[math.random(1, #points)]
	-- Cerca del punto, sobre el suelo y sin meterse en paredes (si no, en el propio punto)
	local position = base + Vector3.new(0, 2.2, 0)
	for _ = 1, 4 do
		local candidate = base + Vector3.new(math.random(-40, 40) / 10, 0, math.random(-40, 40) / 10)
		local floor = groundAt(candidate, 2, 4)
		if floor and math.abs(floor.Y - base.Y) < 1.5 then
			local mapFolder = workspace:FindFirstChild("Map")
			local overlap = OverlapParams.new()
			overlap.FilterType = Enum.RaycastFilterType.Include
			overlap.FilterDescendantsInstances = { mapFolder }
			local blocking = false
			for _, part in workspace:GetPartBoundsInRadius(floor + Vector3.new(0, 2.2, 0), 0.9, overlap) do
				if part.CanCollide then
					blocking = true
					break
				end
			end
			if not blocking then
				position = floor + Vector3.new(0, 2.2, 0)
				break
			end
		end
	end
	local candy = Instance.new("Part")
	candy.Name = "Candy"
	-- (bola en Halloween; caja de regalo en Navidad)
	candy.Shape = CONFIG.ItemShape == "Block" and Enum.PartType.Block or Enum.PartType.Ball
	candy.Size = CONFIG.ItemShape == "Block" and Vector3.new(1.4, 1.4, 1.4) or Vector3.new(1.6, 1.6, 1.6)
	candy.Color = CANDY_COLORS[math.random(1, #CANDY_COLORS)]
	candy.Material = Enum.Material.SmoothPlastic
	candy.Anchored = true
	candy.CanCollide = false
	candy.CanQuery = false
	candy.CanTouch = true
	candy.CastShadow = false
	candy.CFrame = CFrame.new(position)
	candy:SetAttribute("Bob", 0.5) -- flota (lo anima WorldFX en el cliente)
	local light = Instance.new("PointLight")
	light.Color = candy.Color
	light.Range = 8
	light.Brightness = 1
	light.Parent = candy
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(candy.Color)
	sparkle.LightEmission = 1
	sparkle.Size = NumberSequence.new(0.4, 0)
	sparkle.Lifetime = NumberRange.new(0.5, 0.8)
	sparkle.Rate = 5
	sparkle.Speed = NumberRange.new(1, 2)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.Parent = candy
	candy.Touched:Connect(function(hit)
		local character = hit.Parent
		local player = character and Players:GetPlayerFromCharacter(character)
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if player and humanoid and humanoid.Health > 0 and not player:GetAttribute("InMenu") then
			collect(player, candy)
		end
	end)
	candy.Parent = folder
	table.insert(candies, candy)
	-- Si nadie lo coge, desaparece (y deja sitio a otro)
	task.delay(LIFETIME, function()
		if candy.Parent then
			local index = table.find(candies, candy)
			if index then
				table.remove(candies, index)
			end
			candy:Destroy()
		end
	end)
end

-- Decoración junto a algunos puntos libres del mapa (determinista: siempre en los mismos sitios):
-- calabazas (Decoration = "Pumpkin") o muñecos de nieve ("Snowman")
function Event.Decorate()
	if not enabled() or not CONFIG.Decoration then
		return
	end
	local points = spawnPoints()
	local rng = Random.new(#points * 7 + 3)
	for i, point in points do
		if i % 3 == 1 then
			local offset = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1))
			if offset.Magnitude < 0.1 then
				offset = Vector3.xAxis
			end
			-- Sobre el suelo que haya debajo (si el punto está en una plataforma, que no flote en el aire)
			local ground = groundAt(point + offset.Unit * 5, 3, 4)
			if ground then
				local cf = CFrame.new(ground) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
				if CONFIG.Decoration == "Snowman" then
					Kit.snowman(cf, rng:NextNumber(0.8, 1.2))
				else
					Kit.pumpkin(cf, rng:NextNumber(0.8, 1.3))
				end
			end
		end
	end
end

-- Enciende o apaga el evento (al empezar el servidor o cuando llega su fecha con el servidor en marcha)
local active = false
local function setActive(on)
	if on == active then
		return
	end
	active = on
	if on then
		folder = folder or Instance.new("Folder")
		folder.Name = "EventCandies"
		folder.Parent = workspace
		ReplicatedStorage:SetAttribute("EventId", CONFIG.Id)
		ReplicatedStorage:SetAttribute("EventName", CONFIG.Name)
		ReplicatedStorage:SetAttribute("EventGoal", CONFIG.Goal)
	else
		clear()
		ReplicatedStorage:SetAttribute("EventId", nil)
		ReplicatedStorage:SetAttribute("EventName", nil)
	end
end

-- Mientras haya evento, la recompensa diaria regala también unos cuantos objetos del evento
Event.DailyBonus = GameConfig.EventDailyBonus or 0

function Event.Init()
	PlayerData.OnDailyClaimed = function(player)
		if active and CONFIG and (Event.DailyBonus or 0) > 0 then
			addProgress(player, Event.DailyBonus, false)
		end
	end
	if not CONFIG or not GameConfig.Events then
		return
	end
	setActive(enabled())
	Players.PlayerRemoving:Connect(function(player)
		lastPickup[player] = nil
	end)
	ReplicatedStorage:GetAttributeChangedSignal("State"):Connect(function()
		if ReplicatedStorage:GetAttribute("State") ~= "Playing" then
			clear()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(CONFIG.SpawnEvery or 12)
			-- Llega o se acaba la fecha del evento con el servidor encendido (y si se acabó, se pasa al
			-- siguiente que toque: Halloween → Navidad)
			if not active then
				local upcoming = GameConfig.PickEvent()
				if upcoming ~= CONFIG then
					useEvent(upcoming)
				end
			end
			setActive(enabled())
			local playing = ReplicatedStorage:GetAttribute("State") == "Playing" and not ReplicatedStorage:GetAttribute("Frozen")
			if active and playing and #candies < CONFIG.MaxCandies then
				local ok, err = pcall(spawnCandy)
				if not ok then
					warn("[Event] objeto del evento:", err)
				end
			end
		end
	end)
end

Event.Collect = collect -- (para las pruebas)
return Event
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Flags</string>
            <string name="Source"><![CDATA[-- Modo Captura la bandera.
-- Cada equipo tiene una bandera en su base. Coge la enemiga (acércate a ella) y llévala a tu base
-- mientras tu bandera siga allí para puntuar. Si matan al portador la bandera cae al suelo:
-- sus dueños la devuelven tocándola y si nadie la toca vuelve sola.
--
-- Estado publicado en ReplicatedStorage para la interfaz:
--   FlagState_<Equipo>   = "Home" | "Carried" | "Dropped"
--   FlagCarrier_<Equipo> = nombre del portador ("" si nadie)
--   FlagPos_<Equipo>     = dónde está la bandera ahora (los bots van a por ella)
--   FlagHome_<Equipo>    = su base
-- y en el jugador: atributo CarryingFlag = true/false.
-- Los bots también cogen, llevan, capturan y devuelven banderas (el portador puede ser un jugador o
-- un bot: tabla de Bots con Name, Team, Model, Root y Humanoid).
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)

local PlayerData = require(script.Parent.PlayerData)
local Bots = require(script.Parent.Bots)

local Flags = {}

-- Asignado por Round: function(player, team) que suma el punto
Flags.OnCapture = nil

local SETTINGS = GameConfig.Flag
local POLE_HEIGHT = 8

local folder
local flags = {} -- [teamName] = flag
local active = false
local heartbeat

local function findBases()
	local bases = {}
	for _, inst in workspace:GetDescendants() do
		if inst:IsA("BasePart") and inst.Name == "FlagBase" then
			local team = inst:GetAttribute("Team")
			if type(team) == "string" then
				bases[team] = inst
			end
		end
	end
	return bases
end

-- ¿El mapa tiene una base para cada equipo?
function Flags.IsAvailable()
	local bases = findBases()
	for _, cfg in GameConfig.Teams do
		if not bases[cfg.Name] then
			return false
		end
	end
	return true
end

local function publish(flag)
	ReplicatedStorage:SetAttribute("FlagState_" .. flag.Team.Name, flag.State)
	ReplicatedStorage:SetAttribute("FlagPos_" .. flag.Team.Name, flag.Position)
	ReplicatedStorage:SetAttribute("FlagCarrier_" .. flag.Team.Name, flag.Carrier and flag.Carrier.Name or "")
	local text = "BANDERA " .. string.upper(flag.Team.Name)
	if flag.State == "Carried" then
		text ..= "\n¡ROBADA!"
	elseif flag.State == "Dropped" then
		text ..= "\nCAÍDA"
	end
	flag.Label.Text = text
end

local function buildFlag(team)
	local model = Instance.new("Model")
	model.Name = "Flag_" .. team.Name

	local function part(name, size, color, material, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.Material = material
		p.Shape = shape or Enum.PartType.Block
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false -- no bloquea disparos
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = false
		p.Parent = model
		return p
	end

	local pole = part("Pole", Vector3.new(0.3, POLE_HEIGHT, 0.3), Color3.fromRGB(220, 220, 225), Enum.Material.Metal)
	local cloth = part("Cloth", Vector3.new(0.15, 2.4, 3.6), team.TeamColor.Color, Enum.Material.Neon)
	cloth.CFrame = pole.CFrame * CFrame.new(0, POLE_HEIGHT / 2 - 1.4, 1.8)
	local tip = part("Tip", Vector3.new(0.6, 0.6, 0.6), Color3.fromRGB(255, 200, 40), Enum.Material.Neon, Enum.PartType.Ball)
	tip.CFrame = pole.CFrame * CFrame.new(0, POLE_HEIGHT / 2 + 0.3, 0)
	for _, p in { cloth, tip } do
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = pole
		weld.Part1 = p
		weld.Parent = p
	end
	model.PrimaryPart = pole

	local light = Instance.new("PointLight")
	light.Color = team.TeamColor.Color
	light.Range = 14
	light.Brightness = 2
	light.Parent = cloth

	-- Destellos del color del equipo
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkles.Color = ColorSequence.new(team.TeamColor.Color, Color3.new(1, 1, 1))
	sparkles.LightEmission = 1
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
	sparkles.Lifetime = NumberRange.new(0.6, 1.2)
	sparkles.Speed = NumberRange.new(0.5, 1.5)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Rate = 8
	sparkles.Parent = cloth

	-- Marcador visible a través de las paredes
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Marker"
	billboard.Size = UDim2.fromOffset(160, 56)
	billboard.StudsOffset = Vector3.new(0, POLE_HEIGHT / 2 + 2.5, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = 1000
	billboard.Parent = pole
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextSize = 18
	label.TextColor3 = team.TeamColor.Color:Lerp(Color3.new(1, 1, 1), 0.25)
	label.TextStrokeTransparency = 0.2
	label.Text = ""
	label.Parent = billboard

	model.Parent = folder
	return model, label
end

local function setAnchored(flag, anchored)
	for _, p in flag.Model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = anchored
		end
	end
end

-- Coloca la bandera de pie en una posición del suelo
local function placeAt(flag, groundPosition)
	if flag.Weld then
		flag.Weld:Destroy()
		flag.Weld = nil
	end
	setAnchored(flag, true)
	flag.Model:PivotTo(CFrame.new(groundPosition + Vector3.new(0, POLE_HEIGHT / 2, 0)))
	flag.Position = groundPosition
end

local function homePosition(flag)
	-- Superficie de la base (sirve para piezas giradas o cilindros)
	return flag.Base.Position + Vector3.new(0, flag.Base.ExtentsSize.Y / 2, 0)
end

-- ¿El personaje (su HumanoidRootPart) está junto a un punto del suelo?
local function isNear(rootPosition, groundPosition, radius)
	local offset = rootPosition - groundPosition
	return Vector3.new(offset.X, 0, offset.Z).Magnitude <= radius and offset.Y > -2 and offset.Y < 8
end

local function isPlayer(entity)
	return typeof(entity) == "Instance"
end

local function setCarrying(entity, value)
	if isPlayer(entity) then
		entity:SetAttribute("CarryingFlag", value)
	elseif entity then
		entity.CarryingFlag = value
		-- Los bots con la bandera van algo más lentos, como los jugadores
		if entity.Humanoid then
			entity.Humanoid.WalkSpeed = GameConfig.Bots.WalkSpeed * (value and SETTINGS.CarrierSpeedMultiplier or 1)
		end
	end
end

local function setCarrier(flag, player)
	if flag.Carrier then
		setCarrying(flag.Carrier, false)
	end
	flag.Carrier = player
	if player then
		setCarrying(player, true)
	end
end

local function returnHome(flag, returner, silent)
	setCarrier(flag, nil)
	flag.State = "Home"
	flag.CarrierHumanoid = nil
	placeAt(flag, homePosition(flag))
	publish(flag)
	if silent then
		return
	elseif returner then
		Remotes.Notify:FireAllClients("Flag", returner.Name .. " devolvió la bandera " .. flag.Team.Name)
		if isPlayer(returner) then
			PlayerData.AddXP(returner, GameConfig.XP.FlagReturn, "Bandera devuelta")
		end
	else
		Remotes.Notify:FireAllClients("Flag", "La bandera " .. flag.Team.Name .. " volvió a su base")
	end
end

local function groundBelow(position, ignore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	ignore = table.clone(ignore)
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	params.FilterDescendantsInstances = ignore
	local result = workspace:Raycast(position + Vector3.new(0, 2, 0), Vector3.new(0, -60, 0), params)
	return result and result.Position or position - Vector3.new(0, 3, 0)
end

local function drop(flag)
	local carrier = flag.Carrier
	local humanoid = flag.CarrierHumanoid
	local root = flag.Model.PrimaryPart
	local ignore = { folder }
	local carrierModel = carrier and (isPlayer(carrier) and carrier.Character or carrier.Model)
	if carrierModel then
		table.insert(ignore, carrierModel)
	end
	local position = groundBelow(flag.LastCarrierPosition or root.Position, ignore)

	-- Recompensa a quien eliminó al portador
	if humanoid then
		local attackerId = humanoid:GetAttribute("LastAttacker")
		local hitTime = humanoid:GetAttribute("LastHitTime")
		local killer = attackerId and Players:GetPlayerByUserId(attackerId)
		if killer and hitTime and os.clock() - hitTime < 10 and humanoid.Health <= 0 then
			PlayerData.AddXP(killer, GameConfig.XP.CarrierKill, "Portador eliminado")
		end
	end

	setCarrier(flag, nil)
	flag.CarrierHumanoid = nil
	flag.State = "Dropped"
	flag.DroppedAt = os.clock()
	placeAt(flag, position)
	publish(flag)
	Remotes.Notify:FireAllClients("Flag", "¡La bandera " .. flag.Team.Name .. " ha caído!")
end

local function pickup(flag, player, character)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	setCarrier(flag, player)
	flag.CarrierHumanoid = character:FindFirstChildOfClass("Humanoid")
	flag.State = "Carried"
	flag.LastCarrierPosition = root.Position

	-- Soldada a la espalda del portador
	setAnchored(flag, false)
	flag.Model:PivotTo(root.CFrame * CFrame.new(0, 1.2, 1) * CFrame.Angles(math.rad(-15), 0, 0))
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = flag.Model.PrimaryPart
	weld.Parent = flag.Model.PrimaryPart
	flag.Weld = weld

	publish(flag)
	Remotes.Notify:FireAllClients("Flag", player.Name .. " tiene la bandera " .. flag.Team.Name .. "!")
end

local function capture(flag, player)
	local team = player.Team
	returnHome(flag, nil, true)
	Remotes.Notify:FireAllClients("Big", "¡" .. string.upper(player.Name) .. " CAPTURÓ LA BANDERA!")
	if isPlayer(player) then
		PlayerData.AddXP(player, GameConfig.XP.Capture, "Captura")
		PlayerData.AddCoins(player, GameConfig.Coins.Capture)
		PlayerData.Track(player, "Capture", 1)
		player:SetAttribute("Captures", (player:GetAttribute("Captures") or 0) + 1)
	end
	if Flags.OnCapture then
		Flags.OnCapture(player, team)
	end
end

local function aliveCharacter(player)
	if not isPlayer(player) then
		-- Bot
		if player.Humanoid and player.Humanoid.Health > 0 and player.Model and player.Root then
			return player.Model, player.Root
		end
		return nil, nil
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then
		return character, root
	end
	return nil, nil
end

local function isCarrying(player)
	for _, flag in flags do
		if flag.Carrier == player then
			return true
		end
	end
	return false
end

local lastTick = 0
local function step()
	if not active or os.clock() - lastTick < 0.1 then
		return
	end
	lastTick = os.clock()

	for _, flag in flags do
		if flag.State == "Carried" then
			local carrier = flag.Carrier
			local character, root = nil, nil
			if carrier and (not isPlayer(carrier) or carrier.Parent) then
				character, root = aliveCharacter(carrier)
			end
			if
				not character
				or flag.CarrierHumanoid == nil
				or character:FindFirstChildOfClass("Humanoid") ~= flag.CarrierHumanoid
				or carrier.Team == flag.Team
			then
				drop(flag)
			else
				flag.LastCarrierPosition = root.Position
				ReplicatedStorage:SetAttribute("FlagPos_" .. flag.Team.Name, root.Position)
				-- ¿Ha llegado a su base con su propia bandera en casa?
				local ownFlag = carrier.Team and flags[carrier.Team.Name]
				if
					ownFlag
					and ownFlag.State == "Home"
					and isNear(root.Position, homePosition(ownFlag), SETTINGS.CaptureRadius)
				then
					capture(flag, carrier)
				end
			end
		else
			if flag.State == "Dropped" and os.clock() - flag.DroppedAt >= SETTINGS.AutoReturnTime then
				returnHome(flag, nil)
			end
			-- Jugadores y bots que tocan la bandera
			local touchers = Players:GetPlayers()
			for _, agent in Bots.Agents do
				table.insert(touchers, agent)
			end
			for _, player in touchers do
				-- Quien sigue en la pantalla de inicio (invulnerable) no puede coger ni devolver banderas
				local inMenu = isPlayer(player) and player:GetAttribute("InMenu")
				-- ni quien acaba de revivir donde cayó (si no, recuperaría al instante la bandera que soltó)
				local revived = isPlayer(player) and os.clock() - (player:GetAttribute("RevivedAt") or -math.huge) < 5
				if player.Team and flag.State ~= "Carried" and not inMenu and not revived then
					local character, root = aliveCharacter(player)
					if character and isNear(root.Position, flag.Position, SETTINGS.PickupRadius) then
						if player.Team == flag.Team then
							if flag.State == "Dropped" then
								returnHome(flag, player)
							end
						elseif not isCarrying(player) then
							pickup(flag, player, character)
						end
					end
				end
			end
		end
	end
end

-- Crea las banderas en sus bases (inicio de una ronda de CTF)
function Flags.Start()
	Flags.Stop()
	local bases = findBases()
	folder = Instance.new("Folder")
	folder.Name = "Flags"
	folder.Parent = workspace
	for _, team in Teams:GetTeams() do
		local base = bases[team.Name]
		if base then
			local flag = { Team = team, Base = base, State = "Home" }
			flag.Model, flag.Label = buildFlag(team)
			placeAt(flag, homePosition(flag))
			ReplicatedStorage:SetAttribute("FlagHome_" .. team.Name, homePosition(flag))
			flags[team.Name] = flag
			publish(flag)
		end
	end
	active = true
	heartbeat = RunService.Heartbeat:Connect(step)
end

-- Quita las banderas (fin de la ronda)
function Flags.Stop()
	active = false
	if heartbeat then
		heartbeat:Disconnect()
		heartbeat = nil
	end
	for teamName, flag in flags do
		setCarrier(flag, nil)
		ReplicatedStorage:SetAttribute("FlagState_" .. teamName, nil)
		ReplicatedStorage:SetAttribute("FlagCarrier_" .. teamName, nil)
		ReplicatedStorage:SetAttribute("FlagPos_" .. teamName, nil)
		ReplicatedStorage:SetAttribute("FlagHome_" .. teamName, nil)
	end
	table.clear(flags)
	if folder then
		folder:Destroy()
		folder = nil
	end
	for _, player in Players:GetPlayers() do
		player:SetAttribute("CarryingFlag", false)
	end
end

return Flags
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Friends</string>
            <string name="Source"><![CDATA[-- Bonus de amigos: +10% de XP y monedas por cada amigo de Roblox que esté en el mismo servidor
-- (hasta +30%). Anima a invitar a amigos. Atributo del jugador: FriendsHere (cuántos hay).
-- PlayerData lo aplica en su multiplicador de premios.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local Friends = {}

Friends.BonusPerFriend = 0.1
Friends.MaxFriends = 3

local friendsOf = {} -- [player] = { [otherPlayer] = true }

-- Lo llama Round para juntar a los amigos en el mismo equipo (nuevo jugador, su amigo)
Friends.OnFriendship = nil :: ((Player, Player) -> ())?

local function publish(player)
	local count = 0
	for other in friendsOf[player] or {} do
		if other.Parent then
			count += 1
		end
	end
	player:SetAttribute("FriendsHere", count)
end

-- ¿Son amigos de Roblox (y están los dos en este servidor)? Round lo usa para ponerlos en el mismo equipo
function Friends.AreFriends(a, b)
	return friendsOf[a] ~= nil and friendsOf[a][b] == true
end

-- Multiplicador por amigos (1 = sin bonus)
function Friends.Multiplier(player)
	return 1 + Friends.BonusPerFriend * math.min(Friends.MaxFriends, player:GetAttribute("FriendsHere") or 0)
end

local function onPlayer(player)
	friendsOf[player] = friendsOf[player] or {}
	publish(player)
	for _, other in Players:GetPlayers() do
		if other ~= player then
			task.spawn(function()
				local ok, isFriend = pcall(player.IsFriendsWith, player, other.UserId)
				if ok and isFriend and player.Parent and other.Parent then
					if friendsOf[player][other] then
						return -- ya contados (y avisados)
					end
					friendsOf[player][other] = true
					friendsOf[other] = friendsOf[other] or {}
					friendsOf[other][player] = true
					publish(player)
					publish(other)
					-- (Round pone juntos a los amigos si el reparto lo permite)
					if Friends.OnFriendship then
						task.spawn(Friends.OnFriendship, player, other)
					end
					local bonus = math.floor(Friends.BonusPerFriend * 100)
					Remotes.Notify:FireClient(other, "Info", "👥 Tu amigo " .. player.DisplayName .. " ha entrado: +" .. bonus .. "% XP y monedas")
					Remotes.Notify:FireClient(player, "Info", "👥 Juegas con tu amigo " .. other.DisplayName .. ": +" .. bonus .. "% XP y monedas")
				end
			end)
		end
	end
end

function Friends.Init()
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayer, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		for other in friendsOf[player] or {} do
			if friendsOf[other] then
				friendsOf[other][player] = nil
				if other.Parent then
					publish(other)
				end
			end
		end
		friendsOf[player] = nil
	end)
end

return Friends
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Gifts</string>
            <string name="Source"><![CDATA[-- Regalos por tiempo jugado (GameConfig.PlaytimeGifts): cada pocos minutos de sesión hay un regalo
-- que se recoge con el botón 🎁 (monedas, XP o revivir instantáneos). El servidor cuenta el tiempo.
-- El progreso del día (regalos recogidos y tiempo jugado) se guarda con el resto de datos, así que
-- salir y volver a entrar no reinicia la cuenta: al día siguiente empieza de cero.
-- Atributos del jugador para la interfaz: GiftStart (hora del servidor equivalente al inicio de la
-- cuenta) y GiftsClaimed.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Shop = require(Shared.Shop)

local PlayerData = require(script.Parent.PlayerData)

local Gifts = {}

local started = {} -- [player] = os.clock() equivalente al inicio de la cuenta de hoy
local claimed = {} -- [player] = regalos recogidos hoy
local days = {} -- [player] = día (Shop.DayNumber) al que corresponde la cuenta
local restored = {} -- [player] = true cuando ya se ha leído el progreso guardado (antes no se guarda ni se reclama)

local function publish(player)
	player:SetAttribute("GiftStart", workspace:GetServerTimeNow() - (os.clock() - started[player]))
	player:SetAttribute("GiftsClaimed", claimed[player] or 0)
end

-- Si ha cambiado el día (la sesión cruzó la medianoche UTC), la cuenta empieza de cero
local function checkDay(player)
	local today = Shop.DayNumber()
	if started[player] and days[player] ~= today then
		days[player] = today
		started[player] = os.clock()
		claimed[player] = 0
		publish(player)
	end
end

-- Copia el progreso a los datos guardados
local function persist(player)
	local data = PlayerData.Get(player)
	if data and started[player] and restored[player] then
		checkDay(player)
		data.Gifts = { Day = days[player], Claimed = claimed[player] or 0, Seconds = math.floor(os.clock() - started[player]) }
		PlayerData.MarkDirty(player)
	end
end

local function describe(gift)
	local parts = {}
	if gift.Coins then
		table.insert(parts, "+" .. gift.Coins .. " 🪙")
	end
	if gift.XP then
		table.insert(parts, "+" .. gift.XP .. " XP")
	end
	if gift.Revives then
		table.insert(parts, "+" .. gift.Revives .. " 💖 revivir")
	end
	return table.concat(parts, "  ")
end
Gifts.Describe = describe

local function claim(player)
	checkDay(player)
	local index = (claimed[player] or 0) + 1
	local gift = GameConfig.PlaytimeGifts[index]
	if not gift or not started[player] then
		return false, "No hay más regalos hoy"
	end
	if os.clock() - started[player] < gift.Minutes * 60 - 1 then
		return false, "Todavía no"
	end
	if not PlayerData.Get(player) or not restored[player] then
		return false, "Cargando tus datos"
	end
	claimed[player] = index
	player:SetAttribute("GiftsClaimed", index)
	persist(player)
	if gift.Coins then
		PlayerData.AddCoins(player, gift.Coins, false)
	end
	if gift.XP then
		PlayerData.AddXP(player, gift.XP, "Regalo")
	end
	if gift.Revives then
		PlayerData.AddRevives(player, gift.Revives)
	end
	Remotes.Notify:FireClient(player, "Challenge", "🎁 Regalo: " .. describe(gift))
	return true, index
end

function Gifts.Init()
	Remotes.ClaimGift.OnServerInvoke = claim
	local function onPlayer(player)
		started[player] = os.clock()
		claimed[player] = 0
		days[player] = Shop.DayNumber()
		publish(player)
		-- Recupera el progreso de hoy (si ya jugó hoy en otro servidor o antes de salir). Espera lo que
		-- haga falta: hasta entonces no se guarda nada (si no, se borraría el progreso guardado)
		task.spawn(function()
			local data
			while player.Parent and started[player] and not data do
				data = PlayerData.WaitFor(player, 5)
			end
			if not data or not player.Parent or not started[player] then
				return
			end
			local saved = data.Gifts
			if type(saved) == "table" and saved.Day == days[player] then
				claimed[player] = math.max(claimed[player], saved.Claimed or 0)
				started[player] = math.min(started[player], os.clock() - (saved.Seconds or 0))
				publish(player)
			end
			restored[player] = true
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	-- Antes del guardado final (al salir o al cerrar el servidor); después se olvida al jugador
	PlayerData.OnLeaving = function(player)
		persist(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		-- Se limpia un poco después para que el guardado final lo encuentre (el orden de los
		-- eventos de salida no está garantizado)
		task.delay(5, function()
			started[player] = nil
			claimed[player] = nil
			days[player] = nil
			restored[player] = nil
		end)
	end)
	-- Guarda el tiempo jugado de vez en cuando (por si el servidor se cierra de golpe)
	task.spawn(function()
		while true do
			task.wait(30)
			for player in started do
				if player.Parent then
					persist(player)
				end
			end
		end
	end)
end

return Gifts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Graffiti</string>
            <string name="Source"><![CDATA[-- Grafitis (Sprays): el cliente dice dónde quiere pintar y el servidor lo comprueba (que esté vivo y
-- jugando, que el punto esté a su alcance y a la vista, recarga) y pinta el grafiti equipado. Uno por
-- jugador: el nuevo borra el anterior. Van dentro del mapa, así que se borran al cambiar de mapa.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Sprays = require(Shared.Sprays)

local PlayerData = require(script.Parent.PlayerData)

local Graffiti = {}

local lastSpray = {}
local lastTry = {} -- (freno a peticiones seguidas, aunque fallen)
local current = {}

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function finite(v)
	return typeof(v) == "Vector3" and v.X == v.X and v.Y == v.Y and v.Z == v.Z
		and math.abs(v.X) < 1e5 and math.abs(v.Y) < 1e5 and math.abs(v.Z) < 1e5
end

-- Personajes (jugadores y bots) para que el rayo no pinte encima de nadie
local function characters()
	local list = {}
	for _, other in Players:GetPlayers() do
		if other.Character then
			table.insert(list, other.Character)
		end
	end
	for _, model in workspace:GetChildren() do
		if model:IsA("Model") and model:FindFirstChildOfClass("Humanoid") then
			table.insert(list, model)
		end
	end
	return list
end

function Graffiti.Paint(player, position)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local head = character and character:FindFirstChild("Head")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not (humanoid and head and root) or humanoid.Health <= 0 or player:GetAttribute("InMenu") then
		return false
	end
	if not finite(position) then
		return false
	end
	local now = os.clock()
	if lastSpray[player] and now - lastSpray[player] < Sprays.Cooldown then
		return false
	end
	if lastTry[player] and now - lastTry[player] < 0.25 then
		return false
	end
	lastTry[player] = now
	local offset = position - head.Position
	if offset.Magnitude > Sprays.Range + 3 or offset.Magnitude < 0.5 then
		return false
	end
	-- El servidor mira lo que hay de verdad en ese punto (y usa su superficie)
	rayParams.FilterDescendantsInstances = characters()
	local hit = workspace:Raycast(head.Position, offset.Unit * (offset.Magnitude + 1), rayParams)
	if not hit or (hit.Position - position).Magnitude > 2 or not hit.Instance.Anchored or hit.Instance.Transparency > 0.6 then
		return false
	end
	lastSpray[player] = now

	local normal = hit.Normal
	local up = math.abs(normal.Y) > 0.9 and root.CFrame.LookVector or Vector3.yAxis
	local origin = hit.Position + normal * 0.04
	local part = Instance.new("Part")
	part.Name = "Spray_" .. player.UserId
	part.Size = Vector3.new(Sprays.Size, Sprays.Size, 0.05)
	part.CFrame = CFrame.lookAt(origin, origin + normal, up)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0.6
	gui.MaxDistance = 200
	gui.Parent = part
	local data = PlayerData.Get(player)
	local sprayId = data and data.EquippedSpray or "Default"
	if not Sprays.Owns(data and data.Sprays, sprayId, player:GetAttribute("VIP") == true) then
		sprayId = "Default" -- (p. ej. el de VIP si ya no lo es)
	end
	Sprays.Draw(sprayId, gui)

	if current[player] then
		current[player]:Destroy()
	end
	current[player] = part
	part.Parent = workspace:FindFirstChild("Map") or workspace
	return true
end

function Graffiti.Init()
	Remotes.Spray.OnServerEvent:Connect(Graffiti.Paint)
	Players.PlayerRemoving:Connect(function(player)
		if current[player] then
			current[player]:Destroy()
		end
		current[player] = nil
		lastSpray[player] = nil
		lastTry[player] = nil
	end)
end

return Graffiti
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Grenades</string>
            <string name="Source"><![CDATA[-- Granadas: el servidor crea la granada con física, la deja rebotar y la hace explotar.
-- Cada jugador tiene una, que se recarga sola (atributo GrenadeReadyAt = hora del servidor).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Weapons = require(Shared.Weapons)
local Remotes = require(Shared.Remotes)

local Combat = require(script.Parent.Combat)

local Grenades = {}

local DEF = Weapons.Grenade

local folder

local function now()
	return workspace:GetServerTimeNow()
end

local function makeGrenade(cf)
	local ball = Instance.new("Part")
	ball.Name = "Grenade"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(0.9, 0.9, 0.9)
	ball.Color = Color3.fromRGB(60, 70, 50)
	ball.Material = Enum.Material.Metal
	ball.CFrame = cf
	ball.CanCollide = true
	ball.CanQuery = false
	ball.CanTouch = false
	ball.CustomPhysicalProperties = PhysicalProperties.new(2, 0.7, 0.35, 1, 1)
	local band = Instance.new("Part")
	band.Name = "Band"
	band.Shape = Enum.PartType.Cylinder
	band.Size = Vector3.new(0.2, 0.95, 0.95)
	band.Color = Color3.fromRGB(255, 50, 40)
	band.Material = Enum.Material.Neon
	band.CanCollide = false
	band.CanQuery = false
	band.CanTouch = false
	band.Massless = true
	band.CFrame = cf
	band.Parent = ball
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = ball
	weld.Part1 = band
	weld.Parent = band
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 60, 40)
	light.Range = 8
	light.Brightness = 2
	light.Parent = band
	return ball, light
end

-- cook: segundos que el jugador la tuvo cocinándose en la mano (sale con menos mecha)
local function throw(player, direction, cook)
	if typeof(direction) ~= "Vector3" then
		return
	end
	-- (como mucho hasta que le quede un pelín de mecha; también descarta NaN)
	cook = (type(cook) == "number" and cook == cook) and math.clamp(cook, 0, DEF.Fuse - 0.2) or 0
	local length = direction.Magnitude
	if not (length >= 0.5 and length <= 1.5) then -- también descarta NaN
		return
	end
	if player:GetAttribute("InMenu") or ReplicatedStorage:GetAttribute("Mode") == "GUN" or ReplicatedStorage:GetAttribute("Frozen") then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local head = character and character:FindFirstChild("Head")
	-- (los zombis de la Infección solo arañan)
	if not humanoid or humanoid.Health <= 0 or not head or character:GetAttribute("Zombie") then
		return
	end
	if now() < (player:GetAttribute("GrenadeReadyAt") or 0) then
		return
	end
	player:SetAttribute("GrenadeReadyAt", now() + DEF.Cooldown)
	-- Lanzar quita la protección de aparición, como disparar
	for _, child in character:GetChildren() do
		if child:IsA("ForceField") then
			child:Destroy()
		end
	end

	direction = direction.Unit
	-- Nunca aparece al otro lado de una pared: si hay algo delante, se queda de este lado
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, folder }
	local hit = workspace:Raycast(head.Position, direction * 2.5, params)
	local start = hit and (hit.Position - direction * 0.6) or (head.Position + direction * 2)
	local grenade, light = makeGrenade(CFrame.new(start))
	-- (para el aviso de granada cercana del cliente: no avisa de las propias ni de las del equipo)
	grenade:SetAttribute("Thrower", player.Name)
	grenade:SetAttribute("Team", player.Team and player.Team.Name or "")
	-- No choca con quien la lanza (si mira hacia abajo no sale rebotada de su cuerpo)
	for _, part in character:GetDescendants() do
		if part:IsA("BasePart") then
			local noCollide = Instance.new("NoCollisionConstraint")
			noCollide.Part0 = grenade
			noCollide.Part1 = part
			noCollide.Parent = grenade
		end
	end
	grenade.Parent = folder
	grenade:SetNetworkOwner(nil)
	grenade.AssemblyLinearVelocity = direction * DEF.ThrowSpeed + Vector3.new(0, 14, 0)
	grenade.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 20

	task.spawn(function()
		-- Parpadeo cada vez más rápido (con la mecha que le quede si se cocinó)
		local fuseEnd = os.clock() + DEF.Fuse - cook
		while os.clock() < fuseEnd and grenade.Parent do
			light.Enabled = not light.Enabled
			task.wait(math.max(0.06, (fuseEnd - os.clock()) * 0.15))
		end
		if not grenade.Parent then
			return
		end
		local position = grenade.Position + Vector3.new(0, 0.6, 0)
		grenade:Destroy()
		Remotes.ExplosionFX:FireAllClients(position, DEF.Explosive.Radius)
		if player.Parent then
			Combat.Explode(player, position, DEF, "Grenade")
		end
	end)
end

-- Granada lanzada por un bot hacia un punto (tiro parabólico). onExplode(position) se encarga del
-- daño (los bots no son jugadores: ver Bots).
function Grenades.BotThrow(model, from, target, onExplode)
	if not folder or ReplicatedStorage:GetAttribute("Frozen") then
		return false
	end
	-- Nunca al otro lado de una pared: si hay algo entre la cabeza y el punto de salida, se queda de este lado
	local head = model:FindFirstChild("Head")
	if head then
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { model, folder }
		local offset = from - head.Position
		local hit = offset.Magnitude > 0.05 and workspace:Raycast(head.Position, offset, params)
		if hit then
			from = hit.Position - offset.Unit * 0.6
		end
	end
	local flight = math.clamp((target - from).Magnitude / 45, 0.6, 1.3)
	local gravity = Vector3.new(0, -workspace.Gravity, 0)
	local velocity = (target - from) / flight - gravity * flight / 2
	local grenade, light = makeGrenade(CFrame.new(from))
	grenade:SetAttribute("Thrower", model.Name)
	grenade:SetAttribute("Team", model:GetAttribute("Team") or "")
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			local noCollide = Instance.new("NoCollisionConstraint")
			noCollide.Part0 = grenade
			noCollide.Part1 = part
			noCollide.Parent = grenade
		end
	end
	grenade.Parent = folder
	pcall(function()
		grenade:SetNetworkOwner(nil)
	end)
	grenade.AssemblyLinearVelocity = velocity
	task.spawn(function()
		local fuseEnd = os.clock() + DEF.Fuse
		while os.clock() < fuseEnd and grenade.Parent do
			light.Enabled = not light.Enabled
			task.wait(math.max(0.06, (fuseEnd - os.clock()) * 0.15))
		end
		if not grenade.Parent then
			return
		end
		local position = grenade.Position + Vector3.new(0, 0.6, 0)
		grenade:Destroy()
		Remotes.ExplosionFX:FireAllClients(position, DEF.Explosive.Radius)
		onExplode(position)
	end)
	return true
end

function Grenades.Init()
	folder = Instance.new("Folder")
	folder.Name = "Grenades"
	folder.Parent = workspace
	Remotes.ThrowGrenade.OnServerEvent:Connect(throw)
end

-- Al empezar una ronda todos tienen la granada lista (reaparecer no la recarga: evita abusar)
function Grenades.Reset()
	for _, player in Players:GetPlayers() do
		player:SetAttribute("GrenadeReadyAt", 0)
	end
end

return Grenades
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Hardpoint</string>
            <string name="Source"><![CDATA[-- Modo "Zona de control": una zona activa que cambia de sitio cada minuto. El equipo que la ocupa
-- (sin enemigos dentro) suma 1 punto por segundo. Si hay jugadores de los dos equipos, está disputada.
--
-- Estado para la interfaz (atributos de ReplicatedStorage):
--   ZoneOwner = "" | nombre del equipo | "Contested",  ZoneMoveIn = segundos hasta que cambie,
--   ZonePosition = Vector3
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Teams = game:GetService("Teams")

local Shared = ReplicatedStorage.Shared
local Remotes = require(Shared.Remotes)

local PlayerData = require(script.Parent.PlayerData)

local Hardpoint = {}

Hardpoint.OnScore = nil -- function(team, amount)

local ROTATE_TIME = 60
local XP_INTERVAL = 5

local active = false
local zones = {}
local index = 0
local visual
local thread

local function findZones()
	local list = {}
	local map = workspace:FindFirstChild("Map")
	if map then
		for _, d in map:GetDescendants() do
			if d:IsA("BasePart") and d.Name == "HardpointZone" then
				table.insert(list, d)
			end
		end
	end
	table.sort(list, function(a, b)
		return (a:GetAttribute("Order") or 0) < (b:GetAttribute("Order") or 0)
	end)
	return list
end

function Hardpoint.IsAvailable()
	return #findZones() > 0
end

local function makeVisual(zone)
	if visual then
		visual:Destroy()
	end
	local radius = zone:GetAttribute("Radius") or 10
	local model = Instance.new("Model")
	model.Name = "ActiveZone"
	local function part(name, size, cf, material, transparency)
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Size = size
		p.CFrame = cf
		p.Material = material
		p.Transparency = transparency or 0
		p.Color = Color3.new(1, 1, 1)
		p.Parent = model
		return p
	end
	local base = zone.Position
	local ring = part("Ring", Vector3.new(0.3, radius * 2 + 1, radius * 2 + 1), CFrame.new(base + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.pi / 2), Enum.Material.Neon)
	ring.Shape = Enum.PartType.Cylinder
	local inner = part("Fill", Vector3.new(0.32, radius * 2 - 1, radius * 2 - 1), CFrame.new(base + Vector3.new(0, 0.21, 0)) * CFrame.Angles(0, 0, math.pi / 2), Enum.Material.ForceField, 0.3)
	inner.Shape = Enum.PartType.Cylinder
	local beam = part("Beam", Vector3.new(80, radius * 0.6, radius * 0.6), CFrame.new(base + Vector3.new(0, 40, 0)) * CFrame.Angles(0, 0, math.pi / 2), Enum.Material.Neon, 0.8)
	beam.Shape = Enum.PartType.Cylinder
	local light = Instance.new("PointLight")
	light.Range = radius * 2
	light.Brightness = 2
	light.Parent = ring
	-- Marcador visible a través de las paredes
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(140, 50)
	billboard.StudsOffset = Vector3.new(0, 8, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = 1500
	billboard.Parent = ring
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextStrokeTransparency = 0.2
	label.Text = "◆ ZONA"
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Parent = billboard
	model.Parent = workspace
	visual = model
end

local paintedVisual, paintedColor -- (solo se repinta si cambia el color o la zona)
local function paint(color)
	if not visual or (visual == paintedVisual and color == paintedColor) then
		return
	end
	paintedVisual, paintedColor = visual, color
	for _, p in visual:GetDescendants() do
		if p:IsA("BasePart") then
			p.Color = color
		elseif p:IsA("PointLight") then
			p.Color = color
		elseif p:IsA("TextLabel") then
			p.TextColor3 = color
		end
	end
end

local function playersInZone(zone)
	local radius = zone:GetAttribute("Radius") or 10
	local center = zone.Position
	local byTeam = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if player.Team and humanoid and humanoid.Health > 0 and root and not player:GetAttribute("InMenu") then
			local offset = root.Position - center
			if Vector3.new(offset.X, 0, offset.Z).Magnitude <= radius and offset.Y > -3 and offset.Y < 10 then
				byTeam[player.Team] = byTeam[player.Team] or {}
				table.insert(byTeam[player.Team], player)
			end
		end
	end
	-- Los bots también ocupan y disputan la zona (sin XP: su lista queda vacía)
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart")
			local team = Teams:FindFirstChild(model:GetAttribute("Team") or "")
			if team and team:IsA("Team") and humanoid and humanoid.Health > 0 and root then
				local offset = root.Position - center
				if Vector3.new(offset.X, 0, offset.Z).Magnitude <= radius and offset.Y > -3 and offset.Y < 10 then
					byTeam[team] = byTeam[team] or {}
				end
			end
		end
	end
	return byTeam
end

local function moveTo(i)
	index = i
	local zone = zones[index]
	makeVisual(zone)
	ReplicatedStorage:SetAttribute("ZonePosition", zone.Position)
	Remotes.Notify:FireAllClients("Flag", "¡La zona se ha movido!")
end

function Hardpoint.Start()
	Hardpoint.Stop()
	zones = findZones()
	if #zones == 0 then
		return false
	end
	active = true
	moveTo(1)
	thread = task.spawn(function()
		local moveAt = os.clock() + ROTATE_TIME
		local tick = 0
		while active do
			task.wait(1)
			tick += 1
			local remaining = math.max(0, math.ceil(moveAt - os.clock()))
			ReplicatedStorage:SetAttribute("ZoneMoveIn", remaining)
			if remaining <= 0 then
				moveAt = os.clock() + ROTATE_TIME
				moveTo(index % #zones + 1)
			end
			local byTeam = playersInZone(zones[index])
			local owner, count = nil, 0
			for team in byTeam do
				count += 1
				owner = team
			end
			if count == 0 then
				ReplicatedStorage:SetAttribute("ZoneOwner", "")
				paint(Color3.new(1, 1, 1))
			elseif count > 1 then
				ReplicatedStorage:SetAttribute("ZoneOwner", "Contested")
				paint(Color3.fromRGB(255, 200, 40))
			else
				ReplicatedStorage:SetAttribute("ZoneOwner", owner.Name)
				paint(owner.TeamColor.Color)
				if Hardpoint.OnScore then
					Hardpoint.OnScore(owner, 1)
				end
				for _, player in byTeam[owner] do
					PlayerData.Track(player, "ZoneTime", 1)
				end
				if tick % XP_INTERVAL == 0 then
					for _, player in byTeam[owner] do
						PlayerData.AddXP(player, 20, "Zona")
					end
				end
			end
		end
	end)
	return true
end

function Hardpoint.Stop()
	active = false
	if thread then
		pcall(task.cancel, thread)
		thread = nil
	end
	if visual then
		visual:Destroy()
		visual = nil
	end
	ReplicatedStorage:SetAttribute("ZoneOwner", nil)
	ReplicatedStorage:SetAttribute("ZonePosition", nil)
	ReplicatedStorage:SetAttribute("ZoneMoveIn", nil)
end

return Hardpoint
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Hazards</string>
            <string name="Source"><![CDATA[-- Peligros del mapa: pisar lava quita vida cada cuarto de segundo.
-- Se detecta de dos formas, por si una falla en el servidor: el material del suelo (CrackedLava)
-- y un rayo hacia abajo contra las piezas marcadas con el atributo Hazard = "Lava".
local Players = game:GetService("Players")

local Hazards = {}

local LAVA_DAMAGE = 10 -- por cada 0.25 s
local RAY_LENGTH = 4.5 -- desde el centro del personaje hasta un poco por debajo de los pies

local cachedMap, lavaParts = nil, {}
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Include

local function refreshLava()
	local map = workspace:FindFirstChild("Map")
	if map == cachedMap then
		return
	end
	cachedMap = map
	lavaParts = {}
	if map then
		for _, d in map:GetDescendants() do
			if d:IsA("BasePart") and d:GetAttribute("Hazard") == "Lava" then
				table.insert(lavaParts, d)
			end
		end
	end
	params.FilterDescendantsInstances = lavaParts
end

local function onLava(humanoid, root)
	if humanoid.FloorMaterial == Enum.Material.CrackedLava then
		return true
	end
	if #lavaParts == 0 then
		return false
	end
	return workspace:Raycast(root.Position, Vector3.new(0, -RAY_LENGTH, 0), params) ~= nil
end

function Hazards.Init()
	task.spawn(function()
		while true do
			task.wait(0.25)
			refreshLava()
			-- Jugadores y bots
			local characters = {}
			for _, player in Players:GetPlayers() do
				if player.Character then
					table.insert(characters, player.Character)
				end
			end
			local bots = workspace:FindFirstChild("Bots")
			if bots then
				for _, model in bots:GetChildren() do
					table.insert(characters, model)
				end
			end
			for _, character in characters do
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				local root = character:FindFirstChild("HumanoidRootPart")
				if humanoid and root and humanoid.Health > 0 and onLava(humanoid, root) then
					-- La lava no es una baja de nadie
					humanoid:SetAttribute("LastAttacker", nil)
					humanoid:SetAttribute("LastBot", nil)
					humanoid:SetAttribute("LastWeapon", nil)
					humanoid:SetAttribute("LastHitTime", os.clock()) -- (la vida no se recupera dentro)
					humanoid:TakeDamage(LAVA_DAMAGE)
				end
			end
		end
	end)
end

return Hazards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">HealthRegen</string>
            <string name="Source"><![CDATA[-- Vida que se recupera sola, como en los shooters de móvil: tras GameConfig.HealthRegen.Delay
-- segundos sin recibir daño, la vida sube deprisa hasta llenarse. Para jugadores y bots.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local HealthRegen = {}

local STEP = 0.25

-- perk: la ventaja "Persistente" (GameConfig.Perks) empieza antes y recupera más deprisa
local function regen(humanoid, now, config, perk)
	if humanoid.Health <= 0 or humanoid.Health >= humanoid.MaxHealth then
		return
	end
	local hitTime = humanoid:GetAttribute("LastHitTime") or 0
	if now - hitTime < ((perk and perk.RegenDelay) or config.Delay) then
		return
	end
	humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + config.PerSecond * ((perk and perk.RegenMultiplier) or 1) * STEP)
end

local function perkOf(player)
	local id = player:GetAttribute("Perk")
	for _, perk in GameConfig.Perks or {} do
		if perk.Id == id then
			return perk
		end
	end
	return nil
end

function HealthRegen.Init()
	local config = GameConfig.HealthRegen
	if not config or not config.Enabled then
		return
	end
	task.spawn(function()
		while true do
			task.wait(STEP)
			local now = os.clock()
			for _, player in Players:GetPlayers() do
				local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
				if humanoid then
					regen(humanoid, now, config, perkOf(player))
				end
			end
			local bots = workspace:FindFirstChild("Bots")
			if bots then
				for _, model in bots:GetChildren() do
					local humanoid = model:FindFirstChildOfClass("Humanoid")
					if humanoid then
						regen(humanoid, now, config)
					end
				end
			end
		end
	end)
end

return HealthRegen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Killstreaks</string>
            <string name="Source"><![CDATA[-- Recompensas por racha de bajas (sin morir):
--   3 bajas: RADAR. Durante unos segundos tu equipo (o tú, en Todos contra todos) ve a los
--            enemigos a través de las paredes. Atributo de jugador RadarUntil = hora del servidor.
--            Los bots también lo consiguen (BotRadar): sus compañeros humanos lo ven y los rivales
--            reciben el aviso, como el radar enemigo de los shooters de móvil.
--   5 bajas: ATAQUE AÉREO. Se guarda (atributo Airstrikes) y se lanza con la tecla T: marca el
--            punto al que apuntas y caen 5 explosiones en línea.
-- No hay recompensas en Escalada de armas.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Weapons = require(Shared.Weapons)
local Remotes = require(Shared.Remotes)

local Combat = require(script.Parent.Combat)

local Killstreaks = {}

Killstreaks.RadarStreak = 3
Killstreaks.AirstrikeStreak = 5
local RADAR_TIME = 12
Killstreaks.RadarTime = RADAR_TIME
local MAX_RANGE = 600
local STRIKE_DELAY = 1.6 -- segundos de aviso antes de que caigan las bombas
local STRIKES = 5
local SPACING = 9

local function now()
	return workspace:GetServerTimeNow()
end

local function enabled()
	return ReplicatedStorage:GetAttribute("Mode") ~= "GUN"
end

-- Radar de un equipo (Radar_<equipo> en ReplicatedStorage = hasta cuándo): el minimapa del rival
-- se pone rojo mientras dura, como el radar enemigo de los shooters
local function markTeamRadar(team, untilTime)
	if team and ReplicatedStorage:GetAttribute("TeamMode") ~= false then
		local key = "Radar_" .. team.Name
		ReplicatedStorage:SetAttribute(key, math.max(ReplicatedStorage:GetAttribute(key) or 0, untilTime))
	end
end

local function activateRadar(player)
	local untilTime = now() + RADAR_TIME
	markTeamRadar(player.Team, untilTime)
	for _, other in Players:GetPlayers() do
		local ally = other == player or (player.Team ~= nil and other.Team == player.Team and ReplicatedStorage:GetAttribute("TeamMode") ~= false)
		if other == player then
			other:SetAttribute("RadarUntil", untilTime)
			Remotes.Notify:FireClient(other, "Big", "📡 ¡RADAR ACTIVADO!")
		elseif ally then
			other:SetAttribute("RadarUntil", untilTime)
			Remotes.Notify:FireClient(other, "Info", "📡 Radar activado por " .. player.Name)
		else
			Remotes.Notify:FireClient(other, "Info", "📡 ¡El enemigo tiene radar!")
		end
	end
end

-- Un bot llega a la racha del radar: lo comparten los jugadores de su equipo y se avisa al rival
-- (los bots de su equipo lo reciben en Bots.Radar, que llama Round)
function Killstreaks.OnBotStreak(botName, team, streak)
	if not enabled() or streak ~= Killstreaks.RadarStreak then
		return false
	end
	local untilTime = now() + RADAR_TIME
	markTeamRadar(team, untilTime)
	local teamMode = ReplicatedStorage:GetAttribute("TeamMode") ~= false
	for _, other in Players:GetPlayers() do
		if team ~= nil and teamMode and other.Team == team then
			other:SetAttribute("RadarUntil", math.max(other:GetAttribute("RadarUntil") or 0, untilTime))
			Remotes.Notify:FireClient(other, "Info", "📡 Radar activado por " .. botName)
		else
			Remotes.Notify:FireClient(other, "Info", "📡 ¡El enemigo tiene radar!")
		end
	end
	return true
end

-- Lo llama Round cada vez que alguien suma una baja a su racha
function Killstreaks.OnStreak(player, streak)
	-- (los zombis de la Infección no tienen recompensas por racha)
	if not enabled() or (player.Character and player.Character:GetAttribute("Zombie")) then
		return
	end
	if streak == Killstreaks.RadarStreak then
		activateRadar(player)
	elseif streak == Killstreaks.AirstrikeStreak then
		player:SetAttribute("Airstrikes", (player:GetAttribute("Airstrikes") or 0) + 1)
		Remotes.Notify:FireClient(player, "Big", "✈ ¡ATAQUE AÉREO LISTO! Pulsa T")
	end
end

-- Al empezar una ronda nadie conserva recompensas
function Killstreaks.Reset()
	for name in ReplicatedStorage:GetAttributes() do
		if string.sub(name, 1, 6) == "Radar_" then
			ReplicatedStorage:SetAttribute(name, nil)
		end
	end
	for _, player in Players:GetPlayers() do
		player:SetAttribute("Airstrikes", 0)
		player:SetAttribute("RadarUntil", 0)
	end
end

-- Punto del suelo bajo una posición (ignorando personajes, granadas y muros invisibles)
local function ground(position)
	local ignore = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	for _, name in { "Dummies", "Bots", "Grenades", "ClientFX" } do
		local f = workspace:FindFirstChild(name)
		if f then
			table.insert(ignore, f)
		end
	end
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	-- Desde una altura fija: las bombas siempre caen sobre el primer techo (no dentro de edificios)
	local result = workspace:Raycast(Vector3.new(position.X, 200, position.Z), Vector3.new(0, -260, 0), params)
	return result and result.Position + Vector3.new(0, 1, 0) or position
end

local function callAirstrike(player, target)
	if typeof(target) ~= "Vector3" or target ~= target then
		return
	end
	if not enabled() or player:GetAttribute("InMenu") or (player:GetAttribute("Airstrikes") or 0) <= 0 then
		return
	end
	if player.Character and player.Character:GetAttribute("Zombie") then
		return
	end
	if ReplicatedStorage:GetAttribute("State") ~= "Playing" or ReplicatedStorage:GetAttribute("Frozen") then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root then
		return
	end
	local offset = target - root.Position
	if offset.Magnitude > MAX_RANGE or offset.Y < -100 or offset.Y > 150 then
		return
	end
	player:SetAttribute("Airstrikes", player:GetAttribute("Airstrikes") - 1)

	-- 5 puntos en línea, en la dirección en la que mira el jugador
	local flat = Vector3.new(offset.X, 0, offset.Z)
	local direction = flat.Magnitude > 1 and flat.Unit or Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit
	local points = {}
	for i = 1, STRIKES do
		local along = (i - (STRIKES + 1) / 2) * SPACING
		table.insert(points, ground(target + direction * along))
	end
	Remotes.AirstrikeMark:FireAllClients(points, STRIKE_DELAY)
	Remotes.Notify:FireAllClients("Streak", "✈ ¡ATAQUE AÉREO de " .. player.Name .. "!")

	task.delay(STRIKE_DELAY, function()
		for _, point in points do
			if ReplicatedStorage:GetAttribute("State") ~= "Playing" then
				return -- la ronda terminó durante el aviso
			end
			Remotes.ExplosionFX:FireAllClients(point, Weapons.Airstrike.Explosive.Radius)
			if player.Parent then
				Combat.Explode(player, point, Weapons.Airstrike, "Airstrike")
			end
			task.wait(0.18)
		end
	end)
end

function Killstreaks.Init()
	Remotes.CallAirstrike.OnServerEvent:Connect(callAirstrike)
end

return Killstreaks
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Leaderboard</string>
            <string name="Source"><![CDATA[-- Clasificación global (todos los servidores): top 10 de bajas, de victorias y de rango (mejor RP).
-- Se guarda en OrderedDataStores y se publica a los clientes como texto JSON en atributos de
-- ReplicatedStorage ("Leaderboard_Kills", "Leaderboard_Wins", "Leaderboard_Rank") para la pantalla de inicio.
-- La de rango es de la temporada en curso (Ranks.Seasons): cada temporada empieza una tabla nueva.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PlayerData = require(script.Parent.PlayerData)
local Ranks = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Ranks"))

local Leaderboard = {}

local REFRESH = 90 -- segundos entre actualizaciones (los DataStores tienen límite de peticiones)
local TOP = 10

local BOARDS = {
	{ Id = "Kills", Store = "TopBajas_v1", Field = "TotalKills" },
	{ Id = "Wins", Store = "TopVictorias_v1", Field = "Wins" },
	{ Id = "Rank", Store = "TopRango_v1", Field = "RankPoints", Seasonal = true },
}

local stores = {} -- [board.Id] = OrderedDataStore
local storeNames = {} -- [board.Id] = nombre del almacén abierto (cambia con la temporada)

-- Nombre del almacén: el de rango lleva la temporada (la primera conserva el nombre de siempre)
local function storeName(board)
	if not board.Seasonal then
		return board.Store
	end
	local season = Ranks.CurrentSeason()
	return season.Id == Ranks.Seasons[1].Id and board.Store or (board.Store .. "_" .. season.Id)
end

local function openStores()
	for _, board in BOARDS do
		local name = storeName(board)
		if storeNames[board.Id] ~= name then
			local ok, store = pcall(function()
				return DataStoreService:GetOrderedDataStore(name)
			end)
			if ok then
				stores[board.Id] = store
				storeNames[board.Id] = name
			end
		end
	end
end
local pushed = {} -- [userId .. board] = último valor enviado
local names = {} -- caché de nombres por UserId

local function nameOf(userId)
	if names[userId] then
		return names[userId]
	end
	local online = Players:GetPlayerByUserId(userId)
	if online then
		names[userId] = online.Name
		return online.Name
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and type(name) == "string" then
		names[userId] = name
		return name
	end
	return "Jugador"
end

-- Sube los números de un jugador (solo si han cambiado)
local function push(player)
	local data = PlayerData.Get(player)
	if not data then
		return
	end
	for _, board in BOARDS do
		local store = stores[board.Id]
		local value = math.floor(tonumber(data[board.Field]) or 0)
		-- (tampoco si aún no se pudo abrir la tabla de la temporada nueva: irían a la anterior)
		if board.Seasonal and (data.RankSeason ~= Ranks.CurrentSeason().Id or (tonumber(data.SeasonBest) or 0) <= 0 or storeNames[board.Id] ~= storeName(board)) then
			value = 0 -- (RP de la temporada anterior, o aún no ha jugado de rango en esta: no sale en el top)
		end
		local k = player.UserId .. (storeNames[board.Id] or board.Id)
		if store and value > 0 and pushed[k] ~= value then
			-- Nunca baja un récord (por ejemplo si sus datos no cargaron y empieza de 0)
			local ok = pcall(function()
				store:UpdateAsync(tostring(player.UserId), function(old)
					return math.max(tonumber(old) or 0, value)
				end)
			end)
			if ok then
				pushed[k] = value
			end
		end
	end
end

local function fetch()
	for _, board in BOARDS do
		local store = stores[board.Id]
		if store then
			local ok, page = pcall(function()
				return store:GetSortedAsync(false, TOP):GetCurrentPage()
			end)
			if ok and type(page) == "table" then
				local rows = {}
				for rank, entry in page do
					local userId = tonumber(entry.key)
					if userId then
						table.insert(rows, { Rank = rank, UserId = userId, Name = nameOf(userId), Value = entry.value })
					end
				end
				ReplicatedStorage:SetAttribute("Leaderboard_" .. board.Id, HttpService:JSONEncode(rows))
			end
		end
	end
end

function Leaderboard.Init()
	openStores()
	if next(stores) == nil then
		warn("[Leaderboard] Sin acceso a DataStores: no hay clasificación global")
		return
	end
	Players.PlayerRemoving:Connect(push)
	task.spawn(function()
		task.wait(10)
		while true do
			openStores() -- (si ha empezado otra temporada, la tabla de rango es otra)
			for _, player in Players:GetPlayers() do
				push(player)
			end
			fetch()
			task.wait(REFRESH)
		end
	end)
end

return Leaderboard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">LightingVariants</string>
            <string name="Source"><![CDATA[-- Versiones de luz y clima que cualquier mapa exterior puede usar (Map.LightingVariants): en cada
-- partida, a veces, el mapa sale al atardecer, con tormenta y lluvia, con niebla de primera hora o con
-- ventisca. Solo cambian la luz y el tiempo; los colores del terreno, el agua y el cielo del mapa se
-- quedan. Kit.pickLighting elige una (o ninguna) y el cliente pone la lluvia, el viento y los truenos.
local RGB = Color3.fromRGB

local Variants = {}

-- Atardecer: sol bajo y anaranjado, sombras largas y cielo cálido
function Variants.Sunset(chance)
	return {
		Name = "Atardecer",
		Chance = chance or 0.25,
		ClockTime = 17.65,
		Brightness = 2.1,
		Exposure = 0.05,
		Ambient = RGB(84, 70, 64),
		OutdoorAmbient = RGB(158, 126, 108),
		Atmosphere = { Density = 0.34, Offset = 0.12, Color = RGB(236, 196, 160), Decay = RGB(150, 104, 86), Glare = 0.45, Haze = 1.8 },
		Color = { Saturation = 0.02, Contrast = 0.14, Brightness = 0, Tint = RGB(255, 236, 216) },
		Clouds = 0.45,
		CloudColor = RGB(255, 214, 186),
		SunRays = 0.09,
	}
end

-- Tormenta: cielo cubierto, luz gris, lluvia, viento y truenos
function Variants.Storm(chance)
	return {
		Name = "Tormenta",
		Chance = chance or 0.25,
		Weather = "Rain",
		ClockTime = 15.5,
		Brightness = 1.2,
		Exposure = -0.05,
		Ambient = RGB(62, 66, 72),
		OutdoorAmbient = RGB(104, 110, 118),
		Atmosphere = { Density = 0.42, Offset = 0.08, Color = RGB(152, 158, 166), Decay = RGB(92, 98, 108), Glare = 0, Haze = 2.6 },
		Color = { Saturation = -0.2, Contrast = 0.12, Brightness = 0, Tint = RGB(226, 232, 240) },
		Bloom = { Intensity = 0.3, Size = 20, Threshold = 2.4 },
		Clouds = 1,
		CloudColor = RGB(122, 126, 132),
		SunRays = 0,
		Wind = Vector3.new(14, 0, -6),
	}
end

-- Niebla de primera hora: luz blanca y suave, se ve menos de lejos
function Variants.Fog(chance)
	return {
		Name = "Niebla",
		Chance = chance or 0.2,
		ClockTime = 7.6,
		Brightness = 1.9,
		Ambient = RGB(82, 88, 94),
		OutdoorAmbient = RGB(142, 150, 158),
		Atmosphere = { Density = 0.5, Offset = 0.05, Color = RGB(206, 213, 220), Decay = RGB(150, 160, 170), Glare = 0, Haze = 3 },
		Color = { Saturation = -0.15, Contrast = 0.1, Brightness = 0.02, Tint = RGB(236, 242, 250) },
		Clouds = 0.85,
		SunRays = 0.02,
	}
end

-- Ventisca (mapas de nieve): viento fuerte, nieve que cae de lado y poca visibilidad
function Variants.Blizzard(chance)
	return {
		Name = "Ventisca",
		Chance = chance or 0.3,
		Weather = "Snowstorm",
		ClockTime = 14,
		Brightness = 1.6,
		Ambient = RGB(86, 92, 104),
		OutdoorAmbient = RGB(150, 158, 172),
		Atmosphere = { Density = 0.5, Offset = 0.06, Color = RGB(214, 222, 232), Decay = RGB(160, 172, 190), Glare = 0, Haze = 3.2 },
		Color = { Saturation = -0.15, Contrast = 0.1, Brightness = 0.02, Tint = RGB(236, 242, 255) },
		Clouds = 1,
		CloudColor = RGB(214, 220, 228),
		SunRays = 0,
		Wind = Vector3.new(22, 0, 8),
	}
end

return Variants
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Loadout</string>
            <string name="Source"><![CDATA[-- Entrega las armas (Tools) a cada jugador cuando aparece.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Weapons = require(Shared.Weapons)
local WeaponModels = require(Shared.WeaponModels)
local Remotes = require(Shared.Remotes)
local Outfits = require(Shared.Outfits)
local GameConfig = require(Shared.GameConfig)

local PlayerData = require(script.Parent.PlayerData)

local Loadout = {}

-- Los modos de juego pueden cambiar las armas: function(player) -> { "Arma1", "Arma2", ... } o nil
Loadout.Override = nil

function Loadout.MakeTool(weaponName, skinId, charmId)
	local def = Weapons.Get(weaponName)
	local tool = Instance.new("Tool")
	tool.Name = def.DisplayName
	tool.ToolTip = def.DisplayName
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	-- La mano derecha agarra la empuñadura del arma. El arma del mundo va a escala de una persona (la de
	-- primera persona, el viewmodel, se construye aparte a tamaño completo)
	local scale = GameConfig.WorldWeaponScale or 1
	tool.Grip = CFrame.new((def.RightHand or Vector3.zero) * scale)
	tool:SetAttribute("WorldScale", scale)
	tool:SetAttribute("Weapon", weaponName)
	tool:SetAttribute("Skin", skinId)
	tool:SetAttribute("Slot", def.Slot)
	if def.Type == "Gun" then
		tool:SetAttribute("Ammo", def.MagSize)
		tool:SetAttribute("Reserve", def.ReserveAmmo)
		tool:SetAttribute("Reloading", false)
		tool.Unequipped:Connect(function()
			tool:SetAttribute("Reloading", false) -- cambiar de arma cancela la recarga
		end)
	end

	local model = WeaponModels.Build(weaponName, skinId, nil, charmId, scale)
	tool:SetAttribute("Charm", charmId or "Default")
	for _, child in model:GetChildren() do
		child.Parent = tool
	end
	model:Destroy()
	return tool
end

-- Sin traje comprado, en los mapas realistas: uniforme militar con el color del equipo en el
-- brazalete (como los bots), salvo que el jugador prefiera su avatar (Ajustes → Uniforme). nil = nada
function Loadout.UniformFor(player, data)
	local map = workspace:FindFirstChild("Map")
	if GameConfig.SoldierUniform == false or not map or map:GetAttribute("Realistic") ~= true then
		return nil
	end
	local settings = data and data.Settings
	if type(settings) == "table" and settings.Uniform == 0 then
		return nil
	end
	return Outfits.Soldier(player.Team and player.Team.TeamColor.Color or nil)
end

local function giveLoadout(player, character)
	local data = PlayerData.WaitFor(player, 15)
	if player.Character ~= character then
		return
	end
	local list = Loadout.Override and Loadout.Override(player) or Loadout.DefaultList(data)

	-- Traje de operador (solo R15)
	-- (los zombis de la Infección no llevan traje: taparía la piel verde y los ojos)
	local zombie = ReplicatedStorage:GetAttribute("Infection") == "On" and player.Team ~= nil
		and player.Team.Name == ReplicatedStorage:GetAttribute("TeamB")
	local outfit = nil
	if data and data.EquippedOutfit ~= "Default" and not zombie then
		outfit = data.EquippedOutfit
	elseif not zombie then
		outfit = Loadout.UniformFor(player, data)
	end
	if outfit then
		character:WaitForChild("UpperTorso", 5)
		-- Espera a que cargue la ropa del avatar: si no, sus BodyColors y camisa taparían el traje
		local started = os.clock()
		while not player:HasAppearanceLoaded() and os.clock() - started < 5 do
			task.wait(0.1)
		end
		if player.Character ~= character then
			return
		end
		Outfits.Apply(character, outfit)
	end

	Loadout.Give(player, list)
end

-- Armas elegidas por el jugador (principal, secundaria y cuchillo)
function Loadout.DefaultList(data)
	local primary = data and data.Primary or "ARX27"
	local secondary = data and data.Secondary or Weapons.Secondary
	local melee = data and data.Melee or Weapons.Melee
	return { primary, secondary, melee }
end

-- Devuelve sus armas de siempre a un jugador vivo (por ejemplo al acabar la Escalada)
function Loadout.GiveDefault(player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		Loadout.Give(player, Loadout.DefaultList(PlayerData.Get(player)))
	end
end

-- Da al jugador exactamente estas armas (y equipa la primera).
-- Cada arma lleva su camuflaje de maestría si lo tiene elegido, o la skin general.
function Loadout.Give(player, list)
	local character = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not character or not backpack then
		return
	end
	local data = PlayerData.Get(player)
	for _, container in { backpack, character } do
		for _, child in container:GetChildren() do
			if child:IsA("Tool") then
				child:Destroy()
			end
		end
	end
	local first
	for _, weaponName in list do
		if Weapons.Get(weaponName) then
			local tool = Loadout.MakeTool(weaponName, PlayerData.SkinFor(data, weaponName), data and data.EquippedCharm)
			tool.Parent = backpack
			first = first or tool
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if first and humanoid and humanoid.Health > 0 then
		humanoid:EquipTool(first)
	end
end

local function onOutfitChanged(player, outfitId)
	local character = player.Character
	if character then
		if outfitId == "Default" then
			-- Para quitar el traje del todo hay que reaparecer (recupera la ropa original); en los mapas
			-- realistas, en su lugar el uniforme
			local uniform = Loadout.UniformFor(player, PlayerData.Get(player))
			if uniform then
				Outfits.Apply(character, uniform)
			else
				Outfits.Remove(character)
			end
		else
			Outfits.Apply(character, outfitId)
		end
	end
end

-- Vuelve a pintar las armas que lleva encima (skin general o camuflaje de maestría)
local function onSkinChanged(player)
	local data = PlayerData.Get(player)
	local containers = { player:FindFirstChild("Backpack"), player.Character }
	for _, container in containers do
		if container then
			for _, tool in container:GetChildren() do
				local weaponName = tool:IsA("Tool") and tool:GetAttribute("Weapon")
				if weaponName then
					local skinId = PlayerData.SkinFor(data, weaponName)
					if tool:GetAttribute("Skin") ~= skinId then
						WeaponModels.ApplySkin(tool, skinId, weaponName)
						tool:SetAttribute("Skin", skinId)
					end
				end
			end
		end
	end
end

-- Mientras el jugador está en la pantalla de inicio es invulnerable (escudo invisible)
local function addMenuShield(player, character)
	if player:GetAttribute("InMenu") and not character:FindFirstChild("MenuShield") then
		local shield = Instance.new("ForceField")
		shield.Name = "MenuShield"
		shield.Visible = false
		shield.Parent = character
	end
end

local spawnedAt = {} -- [player] = os.clock() de su última aparición

-- En plena ronda de Eliminación, quien no la empezó (y ya salió del menú) entra como espectador hasta
-- la siguiente: si no, podría aparecer de refresco a mitad de ronda. No cuenta como muerte.
local function makeSpectatorIfLate(player, character)
	if not ReplicatedStorage:GetAttribute("NoRespawn") or player:GetAttribute("ElimIn") or player:GetAttribute("InMenu") then
		return
	end
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid:SetAttribute("Spectator", true)
		humanoid.Health = 0
	end
end

local function onPlayer(player)
	player:SetAttribute("InMenu", true)
	player.CharacterAdded:Connect(function(character)
		spawnedAt[player] = os.clock()
		addMenuShield(player, character)
		-- (personaje que llega tarde a una ronda de Eliminación ya empezada)
		task.defer(function()
			character:WaitForChild("Humanoid", 5)
			makeSpectatorIfLate(player, character)
		end)
		giveLoadout(player, character)
	end)
	if player.Character then
		addMenuShield(player, player.Character)
		task.spawn(giveLoadout, player, player.Character)
	end
end

function Loadout.Init()
	PlayerData.OnSkinChanged = onSkinChanged
	PlayerData.OnOutfitChanged = onOutfitChanged
	-- "Volver al menú": vuelve a ser invulnerable y queda fuera de los objetivos
	Remotes.EnterMenu.OnServerEvent:Connect(function(player)
		-- Solo desde la pantalla de muerte: si no, cualquiera podría volverse invulnerable en plena pelea
		-- (o justo al reaparecer: el clic pudo llegar después de la reaparición automática, y ese
		-- personaje aún tiene la protección de aparición, así que no se gana nada haciendo trampa)
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		local justSpawned = os.clock() - (spawnedAt[player] or -math.huge) < 1.5
		if humanoid and humanoid.Health > 0 and not justSpawned then
			return
		end
		player:SetAttribute("InMenu", true)
		if player.Character then
			addMenuShield(player, player.Character)
		end
	end)
	Remotes.LeaveMenu.OnServerEvent:Connect(function(player)
		player:SetAttribute("InMenu", false)
		-- Desde cuándo juega esta partida (para el rango; Round lo pone a cero al empezar cada una)
		if not player:GetAttribute("MatchJoinedAt") then
			player:SetAttribute("MatchJoinedAt", workspace:GetServerTimeNow())
		end
		local shield = player.Character and player.Character:FindFirstChild("MenuShield")
		if shield then
			shield:Destroy()
		end
		-- En plena ronda de Eliminación quien no la empezó entra como espectador hasta la siguiente
		-- (si no, podría aparecer de refresco a mitad de ronda)
		makeSpectatorIfLate(player, player.Character)
	end)
	Players.PlayerAdded:Connect(onPlayer)
	Players.PlayerRemoving:Connect(function(player)
		spawnedAt[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
end

return Loadout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Loot</string>
            <string name="Source"><![CDATA[-- Botín: a veces el enemigo que eliminas suelta un paquete de suministros con un rayo de luz del
-- color de su rareza (como el botín de los juegos de disparos con saqueo). Solo lo puede recoger
-- quien hizo la baja, pasando por encima, y desaparece a los LIFETIME segundos. Dentro hay monedas
-- (y XP en los mejores): como nunca sabes qué toca, cada baja tiene su pequeña emoción.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local PlayerData = require(script.Parent.PlayerData)

local Loot = {}

Loot.Chance = 0.1 -- probabilidad de que una baja a otro jugador suelte botín
Loot.BotChance = 0.06 -- (contra bots, menos, y con los premios a la mitad: que no salga a cuenta "granjear" bots)
Loot.LIFETIME = 15
local RADIUS = 5

-- Rarezas: peso (probabilidad relativa), monedas, XP y color del rayo
Loot.Tiers = {
-- (de media, unas 23 monedas por paquete: un extra, no una segunda fuente de ingresos)
	{ Name = "Común", Weight = 62, Coins = 10, XP = 0, Color = Color3.fromRGB(200, 200, 200) },
	{ Name = "Raro", Weight = 26, Coins = 25, XP = 0, Color = Color3.fromRGB(70, 160, 255) },
	{ Name = "Épico", Weight = 10, Coins = 60, XP = 100, Color = Color3.fromRGB(190, 80, 255) },
	{ Name = "Legendario", Weight = 2, Coins = 200, XP = 250, Color = Color3.fromRGB(255, 180, 30) },
}

local active = {} -- { Model, Position, Owner, Tier, Expires }
local folder
local loopRunning = false

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

-- Suelo bajo el punto (si cae al vacío o a la lava, no hay botín)
local function groundBelow(position)
	local map = workspace:FindFirstChild("Map")
	if not map then
		return position
	end
	rayParams.FilterDescendantsInstances = { map, workspace.Terrain }
	local hit = workspace:Raycast(position + Vector3.new(0, 2, 0), Vector3.new(0, -60, 0), rayParams)
	if not hit then
		return nil
	end
	if hit.Instance:GetAttribute("Hazard") or hit.Instance.Name == "Lava" or hit.Material == Enum.Material.CrackedLava then
		return nil
	end
	return hit.Position
end

function Loot.RollTier(roll)
	local total = 0
	for _, tier in Loot.Tiers do
		total += tier.Weight
	end
	local pick = (roll or math.random()) * total
	for _, tier in Loot.Tiers do
		pick -= tier.Weight
		if pick <= 0 then
			return tier
		end
	end
	return Loot.Tiers[1]
end

local function build(position, tier)
	local model = Instance.new("Model")
	model.Name = "LootDrop"
	model:SetAttribute("Rarity", tier.Name)
	local function part(name, size, cf, color, material)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Parent = model
		return p
	end
	local base = CFrame.new(position)
	-- Paquete del color de la rareza (flota y gira en el cliente, con WorldFX)
	local box = part("LootBox", Vector3.new(1.6, 1.1, 1.1), base * CFrame.new(0, 1.4, 0), tier.Color, Enum.Material.SmoothPlastic)
	box:SetAttribute("Bob", 0.3)
	box:SetAttribute("Spin", 90)
	-- Rayo de luz que se ve desde lejos (más alto cuanto mejor el botín)
	local height = 10 + 4 * (table.find(Loot.Tiers, tier) or 1)
	local beam = part("LootBeam", Vector3.new(0.5, height, 0.5), base * CFrame.new(0, height / 2, 0), tier.Color, Enum.Material.Neon)
	beam.Transparency = 0.45
	local light = Instance.new("PointLight")
	light.Color = tier.Color
	light.Range = 10
	light.Brightness = 1.5
	light.Parent = box
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(tier.Color)
	sparkle.LightEmission = 1
	sparkle.Size = NumberSequence.new(0.35, 0)
	sparkle.Lifetime = NumberRange.new(0.6, 1)
	sparkle.Speed = NumberRange.new(2, 4)
	sparkle.SpreadAngle = Vector2.new(60, 60)
	sparkle.Rate = 8
	sparkle.Parent = box
	model.PrimaryPart = box
	return model
end

local function collect(entry, player)
	local tier = entry.Tier
	local scale = entry.Scale or 1
	local coins = PlayerData.AddCoins(player, math.max(1, math.floor(tier.Coins * scale)))
	local xp = math.floor(tier.XP * scale)
	if xp > 0 then
		PlayerData.AddXP(player, xp, "Botín " .. tier.Name)
	end
	Remotes.Notify:FireClient(player, "Loot", { Rarity = tier.Name, Coins = coins, XP = xp, Color = tier.Color })
end

local function step()
	local now = os.clock()
	for i = #active, 1, -1 do
		local entry = active[i]
		local owner = entry.Owner
		local character = owner.Parent and owner.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local alive = humanoid and humanoid.Health > 0
		if root and alive and (root.Position - entry.Position).Magnitude <= RADIUS then
			table.remove(active, i)
			entry.Model:Destroy()
			collect(entry, owner)
		elseif now >= entry.Expires or not owner.Parent or not entry.Model.Parent then
			table.remove(active, i)
			entry.Model:Destroy()
		end
	end
end

local function ensureLoop()
	if loopRunning then
		return
	end
	loopRunning = true
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.15 or #active == 0 then
			return
		end
		elapsed = 0
		step()
	end)
end

-- Tras una baja: a veces suelta botín para quien la hizo. roll (opcional, para pruebas)
function Loot.MaybeDrop(position, killer, againstBot, roll)
	if typeof(position) ~= "Vector3" or not killer or not killer:IsA("Player") then
		return nil
	end
	if (roll or math.random()) > (againstBot and Loot.BotChance or Loot.Chance) then
		return nil
	end
	local ground = groundBelow(position)
	if not ground then
		return nil
	end
	if not folder or not folder.Parent then
		folder = Instance.new("Folder")
		folder.Name = "Loot"
		folder.Parent = workspace
	end
	local tier = Loot.RollTier()
	local model = build(ground, tier)
	model:SetAttribute("Owner", killer.UserId)
	model.Parent = folder
	-- (contra bots, el premio se escala como las bajas a bots: GameConfig.Bots.RewardScale)
	local scale = againstBot and (GameConfig.Bots and GameConfig.Bots.RewardScale or 0.5) or 1
	table.insert(active, { Model = model, Position = ground, Owner = killer, Tier = tier, Scale = scale, Expires = os.clock() + Loot.LIFETIME })
	ensureLoop()
	-- Solo quien lo ha ganado ve el aviso
	Remotes.Notify:FireClient(killer, "LootDrop", tier.Name)
	return model, tier
end

-- Al acabar la partida o cambiar de mapa, fuera todo el botín
function Loot.Clear()
	for _, entry in active do
		entry.Model:Destroy()
	end
	table.clear(active)
end

Loot.Step = step
Loot.Active = active
Players.PlayerRemoving:Connect(function(player)
	for i = #active, 1, -1 do
		if active[i].Owner == player then
			active[i].Model:Destroy()
			table.remove(active, i)
		end
	end
end)

return Loot
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[-- Registro de mapas: construye el mapa elegido y publica su nombre para la interfaz.
-- Si construyes tu propio mapa en Studio dentro de workspace.Map (sin el atributo "Generated"),
-- se usará ese y no habrá rotación de mapas.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))

local MapBuilder = {}

MapBuilder.Defs = {}
for _, module in script.Parent.MapDefs:GetChildren() do
	local def = require(module)
	MapBuilder.Defs[def.Id] = def
end

-- Orden de rotación (también son las opciones de la votación)
MapBuilder.Order = { "Crossroads", "MilitaryBase", "Summit", "PastelPlaza", "CandyArena", "ToyBox", "HauntedManor", "MoonBase", "Carnival", "WildWest", "PirateCove", "Castle", "ChristmasVillage", "SakuraGarden", "TikiBeach", "HarborHeights", "ContainerClash", "NeonFoundry", "FrostStation", "JungleTemple", "Downtown" }

MapBuilder.Current = nil

-- ¿Puede salir este mapa ahora? Los de temporada (Season = nombre del evento) solo con su evento
-- en marcha (atributo EventName que pone Event)
function MapBuilder.InSeason(id)
	local def = MapBuilder.Defs[id]
	return def == nil or def.Season == nil or ReplicatedStorage:GetAttribute("EventName") == def.Season
end

-- (la pantalla de inicio dice cuántos mapas hay: los de siempre)
local permanent = 0
for _, id in MapBuilder.Order do
	if MapBuilder.Defs[id] and not MapBuilder.Defs[id].Season then
		permanent += 1
	end
end
ReplicatedStorage:SetAttribute("MapCount", permanent)

-- Mapa destacado del día (GameConfig.FeaturedMap): rota por los de siempre, uno cada día (UTC).
-- Se publica en el atributo FeaturedMap (su nombre) para la votación y el bonus de XP.
function MapBuilder.FeaturedId(day)
	local list = {}
	for _, id in MapBuilder.Order do
		if MapBuilder.Defs[id] and not MapBuilder.Defs[id].Season then
			table.insert(list, id)
		end
	end
	if #list == 0 then
		return nil
	end
	day = day or (os.time() // 86400)
	return list[(day % #list) + 1]
end

function MapBuilder.UpdateFeatured()
	local id = GameConfig.FeaturedMap and MapBuilder.FeaturedId()
	local def = id and MapBuilder.Defs[id]
	ReplicatedStorage:SetAttribute("FeaturedMap", def and def.Name or nil)
end
MapBuilder.UpdateFeatured()

-- ¿Hay un mapa hecho a mano en Studio?
function MapBuilder.IsCustom()
	local map = workspace:FindFirstChild("Map")
	return map ~= nil and not map:GetAttribute("Generated")
end

function MapBuilder.Get(id)
	return MapBuilder.Defs[id]
end

function MapBuilder.Build(id)
	if MapBuilder.IsCustom() then
		ReplicatedStorage:SetAttribute("MapName", "Mapa propio")
		return nil
	end
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end
	local def = MapBuilder.Defs[id or MapBuilder.Order[1]] or MapBuilder.Defs[MapBuilder.Order[1]]
	MapBuilder.UpdateFeatured() -- (cambia a medianoche: se revisa con cada mapa)
	def.Build()
	-- Gravedad del mapa (la Base Lunar tiene menos: se salta más y las granadas vuelan más)
	workspace.Gravity = def.Gravity or 196.2
	-- Decoración del evento de temporada (calabazas en Halloween)
	local ok, err = pcall(function()
		require(script.Parent.Event).Decorate()
	end)
	if not ok then
		warn("[MapBuilder] decoración del evento:", err)
	end
	MapBuilder.Current = def.Id
	ReplicatedStorage:SetAttribute("MapName", def.Name)
	ReplicatedStorage:SetAttribute("MapId", def.Id)
	return def
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="51">
          <Properties>
            <string name="Name">MapDefs</string>
          </Properties>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">CandyArena</string>
              <string name="Source"><![CDATA[-- ARENA CARAMELO: arena pequeña y simétrica para duelos rápidos (pensada para Eliminación, pero vale
-- para todos los modos). Tarta de dos pisos en el centro, gominolas y tabletas de chocolate como
-- cobertura, rosquillas, cornisas laterales, pilares de bastón de caramelo y piruletas gigantes de fondo.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)

local Map = {
	Id = "CandyArena",
	Name = "Arena Caramelo",
	Icon = "🍬",
	Description = "Arena pequeña · duelos rápidos · tarta central",
}

Map.Lighting = {
	ClockTime = 14.2,
	Brightness = 3.2,
	Exposure = 0.08,
	Ambient = Color3.fromRGB(135, 120, 140),
	OutdoorAmbient = Color3.fromRGB(175, 165, 190),
	Atmosphere = { Density = 0.2, Offset = 0.2, Color = Color3.fromRGB(255, 225, 245), Decay = Color3.fromRGB(190, 140, 210), Glare = 0, Haze = 0.5 },
	Color = { Saturation = 0.22, Contrast = 0.06, Brightness = 0.03, Tint = Color3.fromRGB(255, 250, 252) },
	Bloom = { Intensity = 0.35, Size = 22, Threshold = 2 },
	Clouds = 0.5,
	SunRays = 0.04,
	ShadowSoftness = 0.3,
	Wind = Vector3.new(2, 0, 1),
	TerrainColors = {
		Grass = Color3.fromRGB(150, 220, 120),
		LeafyGrass = Color3.fromRGB(120, 200, 110),
	},
}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad

local MINT = RGB(140, 225, 195) -- paredes
local MINT_DARK = RGB(100, 195, 165)
local PINK = RGB(255, 120, 175) -- bordes y tarta
local FLOOR = RGB(255, 205, 160) -- galleta
local CHOCOLATE = RGB(120, 70, 45)
local CREAM = RGB(255, 245, 235) -- nata (no se vuelve lavanda: ver KEEP_LOOK en MapKit)
local GUMDROPS = { RGB(255, 90, 110), RGB(90, 200, 255), RGB(255, 200, 60), RGB(140, 230, 90), RGB(200, 120, 255) }

local LENGTH, WIDTH = 180, 110

-- Muro de menta con borde rosa
local function wall(name, cf, size, color)
	local part = Kit.block(name, size, cf * CFrame.new(0, size.Y / 2, 0), color or MINT, Enum.Material.SmoothPlastic)
	Kit.deco(name .. "Cap", V(size.X + 0.4, 0.7, size.Z + 0.4), cf * CFrame.new(0, size.Y + 0.35, 0), PINK, Enum.Material.SmoothPlastic)
	return part
end

-- Pilar de bastón de caramelo (blanco con franjas rojas)
local function candyCane(cf, height)
	Kit.cylinder("CandyWhite", height, 3.4, cf * CFrame.new(0, height / 2, 0), CREAM, Enum.Material.SmoothPlastic)
	for y = 2.5, height - 1, 4 do
		Kit.cylinder("CandyRed", 1.3, 3.6, cf * CFrame.new(0, y, 0) * CFrame.Angles(rad(18), 0, 0), RGB(240, 50, 70), Enum.Material.SmoothPlastic, nil, true)
	end
	Kit.ball("CandyTop", 3.8, cf * CFrame.new(0, height, 0), RGB(240, 50, 70), Enum.Material.SmoothPlastic, true)
end

-- Gominola (media bola con azúcar): cobertura baja redondeada
local function gumdrop(position, size, color)
	Kit.ball("Gumdrop", size, CFrame.new(position), color, Enum.Material.SmoothPlastic)
	Kit.ball("GumdropShine", size * 0.22, CFrame.new(position + V(-size * 0.18, size * 0.36, -size * 0.12)), CREAM, Enum.Material.SmoothPlastic, true)
end

-- Tableta de chocolate de pie (cobertura) con onzas marcadas
local function chocolateBar(cf, length)
	Kit.block("ChocolateBar", V(length, 3.6, 1.8), cf * CFrame.new(0, 1.8, 0), CHOCOLATE, Enum.Material.SmoothPlastic)
	for x = -length / 2 + length / 4, length / 2 - 0.1, length / 4 do
		Kit.deco("ChocolateGroove", V(0.25, 3.62, 1.84), cf * CFrame.new(x, 1.8, 0), CHOCOLATE:Lerp(Color3.new(0, 0, 0), 0.25), Enum.Material.SmoothPlastic)
	end
	Kit.deco("ChocolateWrap", V(length * 0.4, 3.7, 1.9), cf * CFrame.new(length * 0.3, 1.8, 0), RGB(230, 60, 90), Enum.Material.SmoothPlastic)
end

-- Rosquilla de pie hecha con bolas en anillo (cobertura con hueco para asomarse)
local function donut(cf, color)
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2
		Kit.ball("Donut", 2.6, cf * CFrame.new(math.cos(a) * 2.8, 3.1 + math.sin(a) * 2.8, 0), color, Enum.Material.SmoothPlastic)
	end
end

-- Magdalena gigante (cobertura): cápsula de papel con rayas y bola de nata
local function cupcake(cf, color)
	Kit.cylinder("CupcakeBase", 3.4, 5.5, cf * CFrame.new(0, 1.7, 0), color, Enum.Material.SmoothPlastic)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		Kit.deco("CupcakeFold", V(0.4, 3.42, 0.6), cf * CFrame.new(math.cos(a) * 2.7, 1.7, math.sin(a) * 2.7) * CFrame.Angles(0, -a, 0), color:Lerp(Color3.new(1, 1, 1), 0.35), Enum.Material.SmoothPlastic)
	end
	Kit.ball("CupcakeCream", 5.6, cf * CFrame.new(0, 4, 0), RGB(255, 170, 210), Enum.Material.SmoothPlastic)
	Kit.ball("CupcakeCherry", 1.4, cf * CFrame.new(0, 7, 0), RGB(230, 30, 60), Enum.Material.SmoothPlastic, true)
end

-- Muro de barquillo (alto: corta las líneas de tiro largas)
local function waferWall(cf, length)
	Kit.block("Wafer", V(length, 8, 1.6), cf * CFrame.new(0, 4, 0), RGB(235, 180, 100), Enum.Material.SmoothPlastic)
	for y = 1.6, 7, 1.6 do
		Kit.deco("WaferLine", V(length + 0.05, 0.25, 1.65), cf * CFrame.new(0, y, 0), RGB(200, 140, 70), Enum.Material.SmoothPlastic)
	end
	Kit.deco("WaferCream", V(length + 0.1, 0.5, 1.7), cf * CFrame.new(0, 8.1, 0), RGB(255, 150, 200), Enum.Material.SmoothPlastic)
end

-- Pila de caramelos cuadrados de colores (cobertura alta para asomarse)
local function candyStack(cf)
	Kit.block("CandyBlock", V(4, 4, 4), cf * CFrame.new(0, 2, 0), GUMDROPS[1], Enum.Material.SmoothPlastic)
	Kit.block("CandyBlock", V(4, 4, 4), cf * CFrame.new(4.2, 2, 0.4) * CFrame.Angles(0, rad(12), 0), GUMDROPS[2], Enum.Material.SmoothPlastic)
	Kit.block("CandyBlock", V(4, 4, 4), cf * CFrame.new(1.8, 6, 0.2) * CFrame.Angles(0, rad(-8), 0), GUMDROPS[3], Enum.Material.SmoothPlastic)
end

-- Piruleta (palo + caramelo redondo); far = de fondo, más grande y sin colisión
local function lollipop(position, height, diameter, color, far)
	Kit.cylinder("LollipopStick", height, diameter * 0.08, CFrame.new(position + V(0, height / 2, 0)), CREAM, Enum.Material.SmoothPlastic, nil, far)
	-- Disco de cara a la arena (eje a lo largo de Z)
	local candy = Kit.cylinder("Lollipop", diameter * 0.18, diameter, CFrame.new(position + V(0, height + diameter * 0.4, 0)) * CFrame.Angles(rad(90), 0, 0), color, Enum.Material.SmoothPlastic, nil, true)
	Kit.cylinder("LollipopSwirl", diameter * 0.19, diameter * 0.55, candy.CFrame * CFrame.Angles(0, 0, -rad(90)), CREAM, Enum.Material.SmoothPlastic, nil, true)
end

-- Árbol de algodón de azúcar (de fondo)
local function cottonCandy(position, scale, color)
	Kit.cylinder("CottonStick", 8 * scale, 0.7 * scale, CFrame.new(position + V(0, 4 * scale, 0)), CREAM, Enum.Material.SmoothPlastic, nil, true)
	Kit.ball("CottonCandy", 9 * scale, CFrame.new(position + V(0, 10 * scale, 0)), color, Enum.Material.SmoothPlastic, true)
	Kit.ball("CottonCandy", 6 * scale, CFrame.new(position + V(2 * scale, 13.5 * scale, 1 * scale)), color:Lerp(Color3.new(1, 1, 1), 0.25), Enum.Material.SmoothPlastic, true)
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	folder:SetAttribute("Ambience", "Breeze") -- (sonido ambiente: ver Ambience en el cliente)
	Kit.applyLighting(Map.Lighting)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Suelo de galleta con círculo central rosa
	block("Floor", V(LENGTH + 40, 2, WIDTH + 40), CFrame.new(0, -1, 0), FLOOR, Enum.Material.SmoothPlastic)
	Kit.cylinder("Plaza", 0.2, 56, CFrame.new(0, 0.1, 0), RGB(255, 180, 205), Enum.Material.SmoothPlastic)
	Kit.cylinder("PlazaRing", 0.22, 58, CFrame.new(0, 0.09, 0), PINK, Enum.Material.SmoothPlastic, nil, true)

	-- Muro perimetral de menta con bastones de caramelo
	for _, z in { -1, 1 } do
		wall("OuterWall", CFrame.new(0, 0, z * (WIDTH / 2 + 1.5)), V(LENGTH + 6, 18, 3))
		for x = -75, 75, 30 do
			-- (sin pilar donde están las cornisas laterales)
			if not (math.abs(x) < 60 and math.sign(x) == z) then
				candyCane(CFrame.new(x, 0, z * (WIDTH / 2 - 0.5)), 19)
			end
		end
	end
	for _, x in { -1, 1 } do
		wall("OuterWall", CFrame.new(x * (LENGTH / 2 + 1.5), 0, 0), V(3, 18, WIDTH + 6))
		for _, z in { -40, 40 } do
			candyCane(CFrame.new(x * (LENGTH / 2 - 0.5), 0, z), 19)
		end
	end

	-- Tarta central de dos pisos (se sube por escaleras): piso 1 a 4 de altura, piso 2 a 8
	Kit.cylinder("CakeTier", 4, 28, CFrame.new(0, 2, 0), PINK, Enum.Material.SmoothPlastic)
	Kit.cylinder("CakeFrosting", 0.5, 28.8, CFrame.new(0, 4.05, 0), CREAM, Enum.Material.SmoothPlastic, nil, true)
	Kit.cylinder("CakeTier", 4, 14, CFrame.new(0, 6, 0), CHOCOLATE, Enum.Material.SmoothPlastic)
	Kit.cylinder("CakeFrosting", 0.5, 14.6, CFrame.new(0, 8.05, 0), CREAM, Enum.Material.SmoothPlastic, nil, true)
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		Kit.ball("FrostingDrip", 1.6, CFrame.new(math.cos(a) * 14.1, 3.6, math.sin(a) * 14.1), CREAM, Enum.Material.SmoothPlastic, true)
	end
	-- Vela con llama en el centro de la tarta (decorativa)
	Kit.cylinder("Candle", 3, 0.8, CFrame.new(0, 9.6, 0), RGB(120, 200, 255), Enum.Material.SmoothPlastic, nil, true)
	local flame = Kit.ball("CandleFlame", 0.9, CFrame.new(0, 11.4, 0), RGB(255, 200, 80), Enum.Material.Neon, true)
	Kit.light(flame, "PointLight", RGB(255, 190, 110), 14, 1.2)

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(255, 90, 110) or RGB(90, 160, 255)
		-- Escaleras de la tarta: al piso 1 desde el lado del equipo y al piso 2 de lado
		Kit.stairs((m * CFrame.new(-24, 0, 0)).Position, (m * CFrame.new(-13.6, 4, 0)).Position, 6, PINK:Lerp(Color3.new(1, 1, 1), 0.2), Enum.Material.SmoothPlastic)
		Kit.stairs((m * CFrame.new(0, 4, -13)).Position, (m * CFrame.new(0, 8, -6.8)).Position, 4, CHOCOLATE:Lerp(Color3.new(1, 1, 1), 0.15), Enum.Material.SmoothPlastic)

		-- Cornisa lateral (piso a 7) con escalera y barandilla
		local ledgeY = 7
		block("Ledge", V(34, 1, 7), m * CFrame.new(-28, ledgeY - 0.5, -(WIDTH / 2 - 3.5)), MINT_DARK, Enum.Material.SmoothPlastic)
		deco("LedgeTrim", V(34.4, 0.5, 0.4), m * CFrame.new(-28, ledgeY - 0.75, -(WIDTH / 2 - 7.2)), PINK, Enum.Material.SmoothPlastic)
		for _, x in { -42, -14 } do
			Kit.cylinder("LedgeLeg", ledgeY - 1, 1.6, m * CFrame.new(x, (ledgeY - 1) / 2, -(WIDTH / 2 - 6)), CREAM, Enum.Material.SmoothPlastic)
		end
		Kit.stairs((m * CFrame.new(-60, 0, -(WIDTH / 2 - 3.5))).Position, (m * CFrame.new(-45, ledgeY, -(WIDTH / 2 - 3.5))).Position, 5, MINT_DARK, Enum.Material.SmoothPlastic)
		Kit.railing((m * CFrame.new(-44, ledgeY, -(WIDTH / 2 - 7))).Position, (m * CFrame.new(-12, ledgeY, -(WIDTH / 2 - 7))).Position, 2.4, PINK)

		-- Coberturas: tabletas de chocolate, gominolas y rosquillas
		chocolateBar(m * CFrame.new(-38, 0, 14), 10)
		chocolateBar(m * CFrame.new(-30, 0, -24) * CFrame.Angles(0, rad(90), 0), 8)
		chocolateBar(m * CFrame.new(-56, 0, 34), 9)
		gumdrop((m * CFrame.new(-46, 0, -10)).Position, 7, GUMDROPS[1])
		gumdrop((m * CFrame.new(-20, 0, 30)).Position, 6, GUMDROPS[2])
		gumdrop((m * CFrame.new(-64, 0, -44)).Position, 6.5, GUMDROPS[3])
		gumdrop((m * CFrame.new(-10, 0, -40)).Position, 5.5, GUMDROPS[4])
		gumdrop((m * CFrame.new(-70, 0, 42)).Position, 6, GUMDROPS[5])
		donut(m * CFrame.new(-50, 0, 22) * CFrame.Angles(0, rad(90), 0), side == "A" and RGB(255, 150, 190) or RGB(150, 200, 255))
		donut(m * CFrame.new(-24, 0, 44), RGB(255, 200, 120))
		cupcake(m * CFrame.new(-12, 0, 22), GUMDROPS[5])
		cupcake(m * CFrame.new(-42, 0, -42), GUMDROPS[2])
		waferWall(m * CFrame.new(-6, 0, 34), 14)
		waferWall(m * CFrame.new(-54, 0, -16) * CFrame.Angles(0, rad(90), 0), 10)
		candyStack(m * CFrame.new(-36, 0, -6) * CFrame.Angles(0, rad(20), 0))
		candyStack(m * CFrame.new(-52, 0, 46))
		-- Plataformas de salto: a la tarta y a la cornisa
		Kit.jumpPad((m * CFrame.new(-17, 0, -8)).Position, 75)
		Kit.jumpPad((m * CFrame.new(-28, 0, -40)).Position, 75, RGB(255, 120, 200))

		-- Piruletas medianas (solo decoración, se atraviesan) y caramelos en el suelo
		lollipop((m * CFrame.new(-80, 0, -46)).Position, 7, 5, teamColor, true)
		lollipop((m * CFrame.new(-36, 0, 48)).Position, 6, 4.5, GUMDROPS[3], true)
		for i, p in { V(-28, 0.3, 6), V(-60, 0.3, -6), V(-44, 0.3, 40), V(-14, 0.3, -18) } do
			Kit.ball("Sprinkle", 0.7, m * CFrame.new(p), GUMDROPS[i % #GUMDROPS + 1], Enum.Material.SmoothPlastic, true)
		end
	end)

	-- Bases y banderas
	local spawnStyle = { Floor = RGB(255, 225, 235), Roof = MINT_DARK }
	Kit.spawnArea(teams[1], CFrame.new(-75, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-75, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-52, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-52, 0, 0))

	-- Fondo: piruletas gigantes, árboles de algodón de azúcar y colinas
	Kit.bounds(LENGTH, WIDTH, 45)
	local farColors = { RGB(255, 120, 180), RGB(120, 200, 255), RGB(255, 210, 90), RGB(170, 120, 255), RGB(120, 230, 160) }
	local n = 0
	for x = -130, 130, 26 do
		for _, z in { -1, 1 } do
			n += 1
			local color = farColors[n % #farColors + 1]
			if n % 3 == 0 then
				lollipop(V(x + z * 7, 0, z * (WIDTH / 2 + 22 + (n % 4) * 6)), 24 + (n % 3) * 6, 14, color, true)
			else
				cottonCandy(V(x + z * 7, 0, z * (WIDTH / 2 + 16 + (n % 5) * 5)), 1.2 + (n % 3) * 0.2, color)
			end
		end
	end
	for _, sx in { -1, 1 } do
		for z = -60, 60, 40 do
			cottonCandy(V(sx * (LENGTH / 2 + 20 + (math.abs(z) % 3) * 6), 0, z), 1.4, farColors[(z // 40) % #farColors + 1])
		end
	end
	for x = -180, 180, 70 do
		for _, z in { -1, 1 } do
			Kit.naturalHill(V(x, -18, z * 125), 46, Enum.Material.Grass, { Inward = V(0, 0, -z), Top = Enum.Material.LeafyGrass, RockCount = 0 })
		end
	end
	for _, sx in { -1, 1 } do
		for _, z in { -50, 20 } do
			Kit.naturalHill(V(sx * 150, -18, z), 48, Enum.Material.Grass, { Inward = V(-sx, 0, 0), Top = Enum.Material.LeafyGrass, RockCount = 0 })
		end
	end

	-- Modos
	for _, p in {
		V(-66, 0.5, 14), V(-66, 0.5, -14), V(-44, 0.5, 0), V(-34, 0.5, 34), V(-36, 0.5, -36),
		V(-20, 0.5, 16), V(-16, 0.5, -26), V(-28, 7.5, -51.5), V(-6, 4.5, -9), V(-70, 0.5, -46),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, 8.3, 0), 6, 1)
	Kit.zone(V(-34, 0, 30), 6, 2)
	Kit.zone(V(34, 0, -30), 6, 3)
	Kit.zone(V(-28, 7, -51.5), 5, 4)
	Kit.zone(V(28, 7, 51.5), 5, 5)
	Kit.dustMotes(CFrame.new(0, 8, 0), V(100, 14, 70), Color3.fromRGB(255, 200, 235), 14)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">Carnival</string>
              <string name="Source"><![CDATA[-- FERIA: parque de atracciones al atardecer. En el centro, un tiovivo con caballitos (se puede subir
-- a la plataforma y los caballos cubren); a cada lado, una fila de casetas de juegos con toldos de
-- rayas, los coches de choque (muro bajo), la casa de la risa con azotea por escaleras y el martillo
-- de fuerza. De fondo, la noria gigante, la montaña rusa y la carpa del circo. Simétrico.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)
local Variants = require(script.Parent.Parent.LightingVariants)

local Map = {
	Id = "Carnival",
	Name = "Feria",
	Icon = "🎡",
	Description = "Atardecer · tiovivo central · casetas, coches de choque y noria",
}

Map.Lighting = {
	CartoonNeutral = { Hue = 0.07, Sat = 0.12 }, -- grises cálidos de atardecer
	ClockTime = 17.6,
	Latitude = 20,
	Brightness = 2.6,
	Exposure = 0.1,
	Ambient = Color3.fromRGB(130, 105, 120),
	OutdoorAmbient = Color3.fromRGB(185, 150, 160),
	Atmosphere = { Density = 0.22, Offset = 0.15, Color = Color3.fromRGB(255, 200, 170), Decay = Color3.fromRGB(200, 110, 140), Glare = 0.2, Haze = 0.8 },
	Color = { Saturation = 0.25, Contrast = 0.08, Brightness = 0.02, Tint = Color3.fromRGB(255, 240, 230) },
	Bloom = { Intensity = 0.6, Size = 24, Threshold = 1.6 },
	Clouds = 0.35,
	SunRays = 0.08,
	ShadowSoftness = 0.25,
	Wind = Vector3.new(3, 0, 1),
	TerrainColors = {
		Grass = Color3.fromRGB(120, 200, 100),
		LeafyGrass = Color3.fromRGB(100, 180, 90),
	},
}
-- A veces sale con otra luz o con mal tiempo (ver LightingVariants)
Map.LightingVariants = { Variants.Sunset(0.3) }

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad

local PATH = RGB(235, 210, 170) -- paseo de arena
local GRASS = RGB(120, 200, 100)
local CREAM = RGB(255, 245, 225)
local GOLD = RGB(255, 200, 60)
local RED = RGB(230, 60, 70)
local TEAL = RGB(40, 190, 200)
local PURPLE = RGB(150, 90, 220)
local PINK = RGB(255, 120, 180)
local NEON_BULB = RGB(255, 230, 150)
local SMOOTH = Enum.Material.SmoothPlastic

local LENGTH, WIDTH = 200, 130

-- Cono de rayas (tejado de carpa o tiovivo): cilindros apilados cada vez más estrechos
local function stripedCone(cf, diameter, height, colorA, colorB, steps)
	steps = steps or 6
	for i = 0, steps - 1 do
		local d = diameter * (1 - i / steps) + 1
		Kit.cylinder("ConeRoof", height / steps, d, cf * CFrame.new(0, (i + 0.5) * height / steps, 0), i % 2 == 0 and colorA or colorB, SMOOTH, nil, true)
	end
	Kit.cylinder("ConeTopPole", 2.5, 0.3, cf * CFrame.new(0, height + 1.2, 0), GOLD, SMOOTH, nil, true)
	Kit.ball("ConeTop", 1.2, cf * CFrame.new(0, height + 2.6, 0), GOLD, Enum.Material.Neon, true)
end

-- Tiovivo: plataforma baja transitable, columna central, caballitos (cobertura) y tejado
local function carousel(cf)
	Kit.cylinder("CarouselBase", 1, 30, cf * CFrame.new(0, 0.5, 0), CREAM, SMOOTH)
	Kit.cylinder("CarouselRim", 1.05, 30.6, cf * CFrame.new(0, 0.45, 0), RED, SMOOTH, nil, true)
	Kit.cylinder("CarouselColumn", 10, 5, cf * CFrame.new(0, 6, 0), GOLD, SMOOTH)
	Kit.cylinder("CarouselColumnBand", 1.2, 5.3, cf * CFrame.new(0, 4, 0), PINK, SMOOTH, nil, true)
	local colors = { CREAM, PINK, TEAL, PURPLE }
	for i = 0, 7 do
		local spot = cf * CFrame.Angles(0, rad(i * 45 + 22.5), 0) * CFrame.new(0, 1, -10.5)
		Kit.cylinder("CarouselPole", 10, 0.35, spot * CFrame.new(0, 5, 0), GOLD, Enum.Material.Metal, nil, true)
		local horseColor = colors[i % 4 + 1]
		local y = (i % 2 == 0) and 3.2 or 4.2 -- unos arriba y otros abajo, como si subieran y bajaran
		local horse = spot * CFrame.new(0, y, 0) * CFrame.Angles(0, rad(90), 0)
		Kit.block("HorseBody", V(3.4, 1.5, 1.2), horse, horseColor, SMOOTH)
		Kit.deco("HorseNeck", V(0.9, 1.6, 0.9), horse * CFrame.new(-1.6, 1, 0) * CFrame.Angles(0, 0, rad(-20)), horseColor, SMOOTH)
		Kit.deco("HorseHead", V(1.6, 0.8, 0.8), horse * CFrame.new(-2.2, 1.8, 0), horseColor, SMOOTH)
		Kit.deco("HorseMane", V(0.3, 1.4, 0.3), horse * CFrame.new(-1.3, 1.3, 0) * CFrame.Angles(0, 0, rad(-20)), GOLD, SMOOTH)
		Kit.deco("HorseSaddle", V(1.2, 0.3, 1.3), horse * CFrame.new(0.2, 0.85, 0), RED, SMOOTH)
		for _, lx in { -1.2, 1.2 } do
			Kit.deco("HorseLeg", V(0.35, 1.4, 0.35), horse * CFrame.new(lx, -1.3, 0) * CFrame.Angles(0, 0, rad(lx * 12)), horseColor, SMOOTH)
		end
		Kit.deco("HorseTail", V(0.3, 1.2, 0.3), horse * CFrame.new(1.8, 0.1, 0) * CFrame.Angles(0, 0, rad(-30)), GOLD, SMOOTH)
	end
	-- Tejado con borde festoneado y bombillas
	Kit.cylinder("CarouselCanopy", 1.2, 32, cf * CFrame.new(0, 11.6, 0), RED, SMOOTH, nil, true)
	for i = 0, 23 do
		local edge = cf * CFrame.Angles(0, rad(i * 15), 0) * CFrame.new(0, 10.6, -15.6)
		Kit.deco("CanopyScallop", V(3.6, 1.1, 0.3), edge, i % 2 == 0 and CREAM or GOLD, SMOOTH)
		Kit.ball("CanopyBulb", 0.5, edge * CFrame.new(0, -0.8, -0.2), NEON_BULB, Enum.Material.Neon, true).CastShadow = false
	end
	stripedCone(cf * CFrame.new(0, 12.2, 0), 31, 6, RED, CREAM, 6)
end

-- Caseta de juegos: mostrador (cobertura), paredes, toldo de rayas, premios y letrero
local function booth(cf, color, text)
	Kit.block("BoothCounter", V(8, 3.2, 1.6), cf * CFrame.new(0, 1.6, 0), CREAM, SMOOTH)
	Kit.deco("BoothCounterStripe", V(8.05, 0.8, 1.65), cf * CFrame.new(0, 2.2, 0), color, SMOOTH)
	Kit.block("BoothBack", V(8, 7, 0.6), cf * CFrame.new(0, 3.5, 5), color:Lerp(CREAM, 0.35), SMOOTH)
	for _, x in { -3.7, 3.7 } do
		Kit.block("BoothSide", V(0.6, 7, 5.4), cf * CFrame.new(x, 3.5, 2.5), CREAM, SMOOTH)
		Kit.cylinder("BoothPost", 7.6, 0.5, cf * CFrame.new(x, 3.8, -0.6), GOLD, SMOOTH, nil, true)
	end
	Kit.deco("BoothRoof", V(8.6, 0.5, 6.6), cf * CFrame.new(0, 7.3, 2.4), color, SMOOTH)
	Kit.awning(cf * CFrame.new(0, 7.2, -0.6), 8, 2.6, color)
	-- Premios: peluches (bolas) y globos en las estanterías
	local prizeColors = { PINK, TEAL, GOLD, PURPLE, RED }
	for i = 0, 4 do
		local p = cf * CFrame.new(-2.8 + i * 1.4, 4.2, 4.4)
		Kit.ball("PrizeBody", 1.1, p, prizeColors[i + 1], SMOOTH, true)
		Kit.ball("PrizeHead", 0.8, p * CFrame.new(0, 0.85, 0), prizeColors[i + 1], SMOOTH, true)
		Kit.ball("PrizeShelfToy", 0.7, cf * CFrame.new(-2.8 + i * 1.4, 6.2, 4.4), prizeColors[(i + 2) % 5 + 1], SMOOTH, true)
	end
	Kit.deco("BoothShelf", V(7, 0.3, 0.8), cf * CFrame.new(0, 3.5, 4.4), RGB(150, 100, 60), Enum.Material.Wood)
	Kit.deco("BoothShelf", V(7, 0.3, 0.8), cf * CFrame.new(0, 5.6, 4.4), RGB(150, 100, 60), Enum.Material.Wood)
	Kit.neonSign(cf * CFrame.new(0, 8.6, 2), 7, 1.6, text, color:Lerp(Color3.new(1, 1, 1), 0.3), GOLD)
end

-- Coches de choque: pista con muro bajo (cobertura) y cochecitos con su poste
local function bumperCars(cf, colorA, colorB)
	local sx, sz = 24, 16
	Kit.deco("BumperFloor", V(sx, 0.2, sz), cf * CFrame.new(0, 0.1, 0), RGB(70, 70, 90), SMOOTH)
	for _, z in { -1, 1 } do
		-- (con un hueco en medio de los lados largos para entrar)
		for _, x in { -1, 1 } do
			Kit.block("BumperWall", V(sx / 2 - 2.5, 2.6, 1), cf * CFrame.new(x * (sx / 4 + 1.25), 1.3, z * sz / 2), colorA, SMOOTH)
			Kit.deco("BumperWallTop", V(sx / 2 - 2.5, 0.4, 1.1), cf * CFrame.new(x * (sx / 4 + 1.25), 2.7, z * sz / 2), GOLD, SMOOTH)
		end
	end
	for _, x in { -1, 1 } do
		Kit.block("BumperWall", V(1, 2.6, sz), cf * CFrame.new(x * sx / 2, 1.3, 0), colorA, SMOOTH)
		Kit.deco("BumperWallTop", V(1.1, 0.4, sz), cf * CFrame.new(x * sx / 2, 2.7, 0), GOLD, SMOOTH)
	end
	local cars = { { -6, -3, 20, colorB }, { 4, 3, -35, GOLD }, { 7, -4, 70, TEAL }, { -3, 4, 160, PINK } }
	for _, c in cars do
		local car = cf * CFrame.new(c[1], 0, c[2]) * CFrame.Angles(0, rad(c[3]), 0)
		Kit.block("BumperCar", V(2.6, 1.4, 3.6), car * CFrame.new(0, 0.9, 0), c[4], SMOOTH)
		Kit.deco("BumperRubber", V(2.9, 0.5, 3.9), car * CFrame.new(0, 0.4, 0), RGB(40, 40, 45), SMOOTH)
		Kit.deco("BumperSeat", V(1.8, 1, 0.6), car * CFrame.new(0, 1.9, 0.9), RGB(40, 40, 45), SMOOTH)
		Kit.cylinder("BumperPole", 5, 0.2, car * CFrame.new(0, 4, 1.5), RGB(180, 180, 190), Enum.Material.Metal, nil, true)
	end
end

-- Casa de la risa: bloque con cara de payaso (mirando al centro del mapa, +Z local), azotea transitable (murete) y escaleras
local function funhouse(cf, color)
	local h = 9
	Kit.block("Funhouse", V(16, h, 12), cf * CFrame.new(0, h / 2, 0), color, SMOOTH)
	Kit.deco("FunhouseRoofEdge", V(16.4, 0.5, 12.4), cf * CFrame.new(0, h + 0.25, 0), GOLD, SMOOTH)
	Kit.deco("FunhouseMouth", V(5, 3.6, 0.3), cf * CFrame.new(0, 1.8, 6.05), RGB(40, 20, 30), SMOOTH)
	Kit.deco("FunhouseLip", V(6, 0.6, 0.35), cf * CFrame.new(0, 3.8, 6.1), RED, SMOOTH)
	for _, x in { -3.6, 3.6 } do
		Kit.ball("FunhouseEye", 3, cf * CFrame.new(x, 6.2, 5.6), Color3.new(1, 1, 1), SMOOTH, true)
		Kit.ball("FunhousePupil", 1.4, cf * CFrame.new(x * 0.9, 6, 7), RGB(30, 30, 40), SMOOTH, true)
	end
	Kit.ball("FunhouseNose", 2, cf * CFrame.new(0, 4.8, 6.4), RED, SMOOTH, true)
	-- Murete de la azotea (con hueco donde llega la escalera)
	Kit.block("FunhouseParapet", V(16, 1.6, 0.6), cf * CFrame.new(0, h + 0.8, -5.7), color:Lerp(CREAM, 0.3), SMOOTH)
	Kit.block("FunhouseParapet", V(16, 1.6, 0.6), cf * CFrame.new(0, h + 0.8, 5.7), color:Lerp(CREAM, 0.3), SMOOTH)
	Kit.block("FunhouseParapet", V(0.6, 1.6, 12), cf * CFrame.new(-7.7, h + 0.8, 0), color:Lerp(CREAM, 0.3), SMOOTH)
	Kit.stairs((cf * CFrame.new(26, 0, 0)).Position, (cf * CFrame.new(8, h, 0)).Position, 5, CREAM, SMOOTH)
	return h
end

-- Martillo de fuerza: torre con escala de luces y campana
local function strengthTester(cf)
	Kit.block("TesterBase", V(3, 1.2, 3), cf * CFrame.new(0, 0.6, 0), RED, SMOOTH)
	Kit.deco("TesterTower", V(1.4, 14, 0.8), cf * CFrame.new(0, 8, 0), CREAM, SMOOTH)
	for i = 0, 6 do
		local color = RGB(80, 220, 90):Lerp(RGB(255, 60, 60), i / 6)
		Kit.deco("TesterLight", V(1, 1.2, 0.3), cf * CFrame.new(0, 2.4 + i * 1.8, -0.5), color, Enum.Material.Neon)
	end
	Kit.ball("TesterBell", 2, cf * CFrame.new(0, 15.6, 0), GOLD, Enum.Material.Metal, true)
	Kit.deco("TesterPad", V(2, 0.3, 2), cf * CFrame.new(0, 0.15, -2.4), RGB(60, 60, 70), SMOOTH)
end

-- Carrito de globos
local function balloonCart(cf)
	Kit.block("BalloonCart", V(4, 2.4, 2.4), cf * CFrame.new(0, 1.6, 0), CREAM, SMOOTH)
	for _, x in { -1.4, 1.4 } do
		Kit.cylinder("CartWheel", 0.4, 1.4, cf * CFrame.new(x, 0.7, -1.3) * CFrame.Angles(rad(90), 0, 0), RGB(60, 60, 70), SMOOTH, nil, true)
	end
	local colors = { RED, TEAL, GOLD, PINK, PURPLE, RGB(90, 200, 90) }
	local rng = Random.new(5)
	for i = 1, 9 do
		local top = cf * CFrame.new(rng:NextNumber(-1.8, 1.8), 8 + rng:NextNumber(-1, 1.5), rng:NextNumber(-1.2, 1.2))
		Kit.ball("Balloon", 1.5, top, colors[(i - 1) % #colors + 1], SMOOTH, true)
		local mid = (top.Position + (cf * CFrame.new(0, 3, 0)).Position) / 2
		Kit.deco("BalloonString", V(0.06, 0.06, (top.Position - (cf * CFrame.new(0, 3, 0)).Position).Magnitude), CFrame.lookAt(mid, top.Position), Color3.new(1, 1, 1), SMOOTH)
	end
end

-- Puesto de palomitas
local function popcornStand(cf)
	Kit.block("PopcornCart", V(3.4, 3, 2.4), cf * CFrame.new(0, 1.5, 0), RED, SMOOTH)
	Kit.deco("PopcornGlass", V(3, 2.4, 2), cf * CFrame.new(0, 4.2, 0), RGB(255, 240, 200), Enum.Material.Glass).Transparency = 0.4
	Kit.deco("Popcorn", V(2.8, 1, 1.8), cf * CFrame.new(0, 3.5, 0), RGB(255, 245, 210), SMOOTH)
	Kit.deco("PopcornRoof", V(3.8, 0.5, 2.8), cf * CFrame.new(0, 5.7, 0), CREAM, SMOOTH)
	Kit.deco("PopcornSign", V(3.6, 0.8, 0.2), cf * CFrame.new(0, 6.3, -1.2), GOLD, SMOOTH)
end

-- Farola de feria con bombillas (y de donde cuelgan las guirnaldas)
local function lampPost(cf)
	Kit.cylinder("FairLamp", 9, 0.5, cf * CFrame.new(0, 4.5, 0), RGB(60, 50, 70), Enum.Material.Metal, nil, true)
	Kit.ball("FairLampGlobe", 1.4, cf * CFrame.new(0, 9.4, 0), NEON_BULB, Enum.Material.Neon, true)
	return (cf * CFrame.new(0, 9, 0)).Position
end

-- Noria gigante de fondo (en el plano XY local, mirando hacia el mapa)
local function ferrisWheel(cf, radius)
	local hub = cf * CFrame.new(0, radius + 5, 0)
	-- La rueda gira despacio en el cliente (WorldFX: Orbit); las cabinas siguen derechas
	local axis = hub.LookVector
	local function spin(part, anchor)
		part:SetAttribute("Orbit", 7)
		part:SetAttribute("OrbitCenter", hub.Position)
		part:SetAttribute("OrbitAxis", axis)
		if anchor then
			part:SetAttribute("OrbitUpright", true)
			part:SetAttribute("OrbitAnchor", anchor)
		end
		return part
	end
	for _, z in { -3.5, 3.5 } do
		for _, s in { -1, 1 } do
			local foot = (cf * CFrame.new(s * radius * 0.6, 0, z * 1.6)).Position
			local top = (hub * CFrame.new(0, 0, z)).Position
			Kit.deco("WheelLeg", V(1.2, 1.2, (top - foot).Magnitude), CFrame.lookAt((foot + top) / 2, top), CREAM, SMOOTH)
		end
	end
	Kit.cylinder("WheelHub", 8, 3, hub * CFrame.Angles(rad(90), 0, 0), GOLD, SMOOTH, nil, true)
	local segments = 28
	local segLength = 2 * math.pi * radius / segments + 0.4
	for i = 0, segments - 1 do
		local around = hub * CFrame.Angles(0, 0, i / segments * 2 * math.pi)
		for _, z in { -1.6, 1.6 } do
			spin(Kit.deco("WheelRim", V(segLength, 0.7, 0.7), around * CFrame.new(0, radius, z), i % 2 == 0 and RED or CREAM, SMOOTH))
		end
		if i % 2 == 0 then
			spin(Kit.deco("WheelSpoke", V(0.35, radius, 0.35), around * CFrame.new(0, radius / 2, 0), CREAM, SMOOTH))
			spin(Kit.ball("WheelBulb", 0.7, around * CFrame.new(0, radius + 0.6, 0), NEON_BULB, Enum.Material.Neon, true)).CastShadow = false
		end
		if i % 4 == 0 then
			-- Cabina colgando (siempre derecha)
			local p = (around * CFrame.new(0, radius, 0)).Position
			local cabinColors = { TEAL, PINK, GOLD, PURPLE, RGB(90, 200, 90), RED, RGB(60, 140, 240) }
			local color = cabinColors[(i / 4) % #cabinColors + 1]
			local base = CFrame.new(p) * (cf - cf.Position)
			spin(Kit.deco("WheelCabin", V(4, 2.6, 3.4), base * CFrame.new(0, -2.6, 0), color, SMOOTH), p)
			spin(Kit.deco("WheelCabinRoof", V(4.4, 0.5, 3.8), base * CFrame.new(0, -1.1, 0), CREAM, SMOOTH), p)
			spin(Kit.deco("WheelCabinBar", V(0.3, 1, 0.3), base * CFrame.new(0, -0.5, 0), CREAM, SMOOTH), p)
		end
	end
end

-- Montaña rusa de fondo: vía ondulada sobre pilares, con un vagón
local function rollerCoaster(fromX, toX, z)
	local function height(x)
		return 14 + 9 * math.sin(x / 16) + 4 * math.sin(x / 7)
	end
	local stepX = 6
	local last
	local count = 0
	for x = fromX, toX, stepX do
		local p = V(x, height(x), z)
		if last then
			local mid = (last + p) / 2
			local look = CFrame.lookAt(mid, p)
			local length = (p - last).Magnitude + 0.3
			for _, side in { -1, 1 } do
				Kit.deco("CoasterRail", V(0.4, 0.4, length), look * CFrame.new(side * 1.1, 0, 0), RED, Enum.Material.Metal)
			end
			Kit.deco("CoasterTie", V(2.8, 0.25, 0.6), look * CFrame.new(0, -0.2, 0), RGB(90, 80, 90), SMOOTH)
		end
		count += 1
		if count % 2 == 0 then
			Kit.cylinder("CoasterPillar", p.Y, 0.8, CFrame.new(x, p.Y / 2, z), CREAM, SMOOTH, nil, true)
		end
		last = p
	end
	-- Vagón en una bajada
	local x = fromX + (toX - fromX) * 0.35
	local a, b = V(x, height(x), z), V(x + 3, height(x + 3), z)
	local car = CFrame.lookAt(a, b) * CFrame.new(0, 1.1, 0)
	Kit.deco("CoasterCar", V(2.6, 1.6, 4.6), car, GOLD, SMOOTH)
	Kit.deco("CoasterCarFront", V(2.7, 1.2, 0.5), car * CFrame.new(0, 0.3, -2.3), RED, SMOOTH)
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	folder:SetAttribute("Ambience", "Breeze") -- (sonido ambiente: ver Ambience en el cliente)
	Kit.applyLighting(Kit.pickLighting(Map))
	folder:SetAttribute("Variant", Kit.Variant)
	folder:SetAttribute("Weather", Kit.Weather)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Suelo: césped con paseos de arena (cruz central y anillo alrededor del tiovivo)
	block("Floor", V(LENGTH + 40, 2, WIDTH + 40), CFrame.new(0, -1, 0), GRASS, Enum.Material.SmoothPlastic)
	deco("Path", V(LENGTH, 0.1, 14), CFrame.new(0, 0.05, 0), PATH, SMOOTH)
	deco("Path", V(14, 0.1, WIDTH), CFrame.new(0, 0.05, 0), PATH, SMOOTH)
	Kit.cylinder("PathRing", 0.1, 44, CFrame.new(0, 0.06, 0), PATH, SMOOTH, nil, true)
	for _, z in { -1, 1 } do
		deco("Path", V(LENGTH - 30, 0.1, 10), CFrame.new(0, 0.05, z * 38), PATH, SMOOTH)
	end

	carousel(CFrame.new(0, 0, 0))

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(235, 70, 70) or RGB(60, 130, 240)
		-- Casetas de juegos mirando al centro
		booth(m * CFrame.new(-60, 0, 50), RED, "TIRO AL PATO")
		booth(m * CFrame.new(-48, 0, 50), TEAL, "ARO")
		booth(m * CFrame.new(-36, 0, 50), PURPLE, "PREMIOS")
		strengthTester(m * CFrame.new(-22, 0, 52))

		-- Coches de choque (muro bajo) y casa de la risa con azotea
		bumperCars(m * CFrame.new(-30, 0, -28), teamColor, GOLD)
		funhouse(m * CFrame.new(-70, 0, -48), side == "A" and PINK or TEAL)

		-- Cobertura media: cajas, barriles, carrito de globos y palomitas
		balloonCart(m * CFrame.new(-30, 0, 14) * CFrame.Angles(0, rad(20), 0))
		popcornStand(m * CFrame.new(-12, 0, -13) * CFrame.Angles(0, rad(-30), 0))
		Kit.crate(m * CFrame.new(-48, 0, 14), 4, RGB(200, 150, 90))
		Kit.crate(m * CFrame.new(-51, 0, 18), 3.5, RGB(200, 150, 90))
		Kit.crate(m * CFrame.new(-46, 0, -12), 4, RGB(200, 150, 90))
		Kit.barrel(m * CFrame.new(-22, 0, 28), RED)
		Kit.barrel(m * CFrame.new(-24, 0, 30.5), TEAL)
		Kit.barrel(m * CFrame.new(-56, 0, -18), GOLD)
		Kit.crate(m * CFrame.new(-12, 0, 44), 4, RGB(200, 150, 90))

		-- Farolas con guirnaldas de bombillas a lo largo de los paseos
		local a = lampPost(m * CFrame.new(-20, 0, 32))
		local b = lampPost(m * CFrame.new(-52, 0, 32))
		local c = lampPost(m * CFrame.new(-20, 0, -44))
		local d = lampPost(m * CFrame.new(-52, 0, -44))
		Kit.stringLights(a, b, RGB(255, 220, 140))
		Kit.stringLights(c, d, RGB(255, 220, 140))
		Kit.stringLights(a, V(0, 20, 0), RGB(255, 160, 200))

		-- Taquilla junto a la base
		block("TicketBooth", V(5, 5, 5), m * CFrame.new(-78, 2.5, 44), teamColor:Lerp(CREAM, 0.4), SMOOTH)
		deco("TicketWindow", V(3, 1.8, 0.3), m * CFrame.new(-78, 3, 41.4), RGB(255, 240, 200), Enum.Material.Neon)
		stripedCone(m * CFrame.new(-78, 5, 44), 6.5, 3, teamColor, CREAM, 3)

		-- Banderines del equipo
		Kit.banner(m * CFrame.new(-68, 12, 30) * CFrame.Angles(0, rad(90), 0), 4, 6, teamColor, GOLD)
		Kit.banner(m * CFrame.new(-68, 12, -30) * CFrame.Angles(0, rad(90), 0), 4, 6, teamColor, GOLD)
	end)

	-- Bases y banderas
	local spawnStyle = { Floor = RGB(255, 235, 210), Roof = CREAM }
	Kit.spawnArea(teams[1], CFrame.new(-85, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-85, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-62, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-62, 0, 0))

	-- Fondo: noria, montaña rusa, carpa del circo, pinos y colinas
	Kit.bounds(LENGTH, WIDTH, 60)
	ferrisWheel(CFrame.new(-10, 0, WIDTH / 2 + 26) * CFrame.Angles(0, rad(180), 0), 26)
	rollerCoaster(-110, 110, -(WIDTH / 2 + 24))
	stripedCone(CFrame.new(70, 0, WIDTH / 2 + 34), 34, 22, RED, CREAM, 8)
	stripedCone(CFrame.new(-75, 0, -(WIDTH / 2 + 40)), 26, 16, PURPLE, CREAM, 6)
	local rng = Random.new(31)
	for x = -130, 130, 22 do
		for _, z in { -1, 1 } do
			Kit.cartoonPine(V(x + rng:NextNumber(-6, 6), 0, z * (WIDTH / 2 + 52 + rng:NextNumber(0, 12))), 1.6, true)
		end
	end
	for _, sx in { -1, 1 } do
		for z = -60, 60, 30 do
			Kit.cartoonPine(V(sx * (LENGTH / 2 + 14 + rng:NextNumber(0, 8)), 0, z + rng:NextNumber(-6, 6)), 1.5, true)
		end
		for z = -80, 80, 55 do
			Kit.naturalHill(V(sx * 165, -16, z), 42, Enum.Material.Grass, { Inward = V(-sx, 0, 0), Top = Enum.Material.LeafyGrass, RockCount = 1 })
		end
	end
	for x = -200, 200, 60 do
		for _, z in { -1, 1 } do
			Kit.naturalHill(V(x, -16, z * 160), 42, Enum.Material.Grass, { Inward = V(0, 0, -z), Top = Enum.Material.LeafyGrass, RockCount = 1 })
		end
	end

	-- Modos
	for _, p in {
		V(-76, 0.5, 8), V(-76, 0.5, -16), V(-54, 0.5, 6), V(-40, 0.5, 22), V(-26, 0.5, 40),
		V(-30, 0.5, -28), V(-14, 0.5, -36), V(-70, 9.5, -48), V(-8, 1.5, 12), V(-40, 0.5, -56),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, 1, 0), 6, 1)
	Kit.zone(V(-30, 0, -28), 6, 2)
	Kit.zone(V(30, 0, 28), 6, 3)
	Kit.zone(V(-70, 9, -48), 5, 4)
	Kit.zone(V(70, 9, 48), 5, 5)
	Kit.dustMotes(CFrame.new(0, 6, 0), V(140, 10, 90), Color3.fromRGB(255, 220, 180), 8)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">Castle</string>
              <string name="Source"><![CDATA[-- CASTILLO DEL REY: patio medieval de mañana. En el centro, la torre del homenaje con un túnel que
-- la atraviesa de lado a lado y azotea almenada (escalera por fuera en cada lado). A cada lado, una
-- muralla con almenas y tres pasos, con rampa para subir al adarve; torreones redondos, pozo,
-- puestos de mercado con toldos, carros de heno, barriles y árboles. Colinas y pinos de fondo.
-- Simétrico.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)
local Variants = require(script.Parent.Parent.LightingVariants)

local Map = {
	Id = "Castle",
	Name = "Castillo del Rey",
	Icon = "🏰",
	Description = "Mañana · torre central con túnel · murallas con almenas",
}

Map.Lighting = {
	ClockTime = 10.5,
	Brightness = 3,
	Exposure = 0.05,
	Ambient = Color3.fromRGB(120, 120, 130),
	OutdoorAmbient = Color3.fromRGB(170, 170, 180),
	Atmosphere = { Density = 0.25, Offset = 0.2, Color = Color3.fromRGB(205, 225, 255), Decay = Color3.fromRGB(120, 160, 210), Glare = 0, Haze = 0.6 },
	Color = { Saturation = 0.18, Contrast = 0.06, Brightness = 0.02, Tint = Color3.fromRGB(255, 252, 245) },
	Bloom = { Intensity = 0.3, Size = 22, Threshold = 2 },
	Clouds = 0.45,
	SunRays = 0.05,
	ShadowSoftness = 0.3,
	Wind = Vector3.new(4, 0, 2),
	TerrainColors = {
		Grass = Color3.fromRGB(110, 190, 90),
		LeafyGrass = Color3.fromRGB(80, 165, 75),
		Rock = Color3.fromRGB(150, 145, 140),
	},
}
-- A veces sale con otra luz o con mal tiempo (ver LightingVariants)
Map.LightingVariants = { Variants.Sunset(0.25), Variants.Fog(0.25) }

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad

local GRASS = RGB(120, 195, 95)
local PATH = RGB(205, 190, 160)
local STONE = RGB(185, 180, 172)
local STONE_DARK = RGB(140, 135, 128)
local WOOD = RGB(165, 110, 62)
local WOOD_DARK = RGB(105, 68, 40)
local ROOF_BLUE = RGB(70, 100, 190)
local SMOOTH = Enum.Material.SmoothPlastic
local COBBLE = Enum.Material.Cobblestone

local LENGTH, WIDTH = 200, 130
local KEEP = 8 -- media anchura de la torre central
local KEEP_H = 10 -- altura de su azotea

-- Almenas a lo largo de un borde (de a a b, a la altura y), saltándose los tramos en `skip`
local function battlements(a, b, y, skip, thickness)
	local length = (b - a).Magnitude
	local dir = (b - a).Unit
	local count = math.floor(length / 3)
	for i = 0, count - 1 do
		local p = a + dir * ((i + 0.5) * length / count)
		local blocked = false
		for _, s in skip or {} do
			if (p - s).Magnitude < 3 then
				blocked = true
			end
		end
		if i % 2 == 0 and not blocked then
			Kit.block("Merlon", V(thickness or 2, 2, 2), CFrame.lookAt(V(p.X, y + 1, p.Z), V(p.X, y + 1, p.Z) + dir), STONE, COBBLE)
		end
	end
end

-- Torreón redondo con tejado cónico (cobertura grande)
local function tower(position, diameter, height, roofColor)
	Kit.cylinder("Tower", height, diameter, CFrame.new(position + V(0, height / 2, 0)), STONE, COBBLE)
	Kit.cylinder("TowerRing", 1, diameter + 0.8, CFrame.new(position + V(0, height - 0.5, 0)), STONE_DARK, COBBLE, nil, true)
	-- (el tejado es sólido: si no, alguien podría meterse dentro de un supersalto y disparar sin ser visto)
	for i = 0, 5 do
		local d = (diameter + 1) * (1 - i / 6)
		Kit.cylinder("TowerRoof", 1.4, d, CFrame.new(position + V(0, height + 0.7 + i * 1.4, 0)), roofColor, SMOOTH)
	end
	local flagPole = position + V(0, height + 9.5, 0)
	Kit.cylinder("FlagPole", 4, 0.25, CFrame.new(flagPole), WOOD_DARK, Enum.Material.Wood, nil, true)
	Kit.deco("Pennant", V(2.4, 1.2, 0.1), CFrame.new(flagPole + V(1.2, 1.4, 0)), roofColor, Enum.Material.Fabric)
	for _, a in { 0, 120, 240 } do
		local dir = V(math.sin(rad(a)), 0, math.cos(rad(a)))
		Kit.deco("ArrowSlit", V(0.6, 2.4, 0.3), CFrame.lookAt(position + dir * (diameter / 2 + 0.05) + V(0, height * 0.6, 0), position + dir * 10 + V(0, height * 0.6, 0)), RGB(40, 35, 35), SMOOTH)
	end
end

-- Puesto de mercado: mostrador (cobertura baja), postes y toldo de rayas
local function stall(cf, color)
	Kit.block("Counter", V(6, 2.4, 2), cf * CFrame.new(0, 1.2, 0), WOOD, Enum.Material.WoodPlanks)
	for _, x in { -2.8, 2.8 } do
		Kit.deco("StallPost", V(0.4, 5, 0.4), cf * CFrame.new(x, 2.5, 1.5), WOOD_DARK, Enum.Material.Wood)
	end
	for i = 0, 3 do
		Kit.deco("Awning", V(1.55, 0.2, 3.6), cf * CFrame.new(-2.3 + i * 1.55, 5, 0.6) * CFrame.Angles(rad(-15), 0, 0), i % 2 == 0 and color or RGB(250, 245, 235), Enum.Material.Fabric)
	end
	for i = 0, 2 do
		Kit.ball("Fruit", 0.7, cf * CFrame.new(-1.5 + i * 1.5, 2.75, 0), i == 1 and RGB(255, 170, 40) or RGB(220, 50, 50), SMOOTH, true)
	end
end

local function well(cf)
	Kit.cylinder("Well", 2.4, 5, cf * CFrame.new(0, 1.2, 0), STONE, COBBLE)
	Kit.cylinder("WellWater", 0.1, 4, cf * CFrame.new(0, 2.45, 0), RGB(70, 140, 200), SMOOTH, nil, true)
	for _, x in { -2.2, 2.2 } do
		Kit.deco("WellPost", V(0.4, 4, 0.4), cf * CFrame.new(x, 4, 0), WOOD_DARK, Enum.Material.Wood)
	end
	Kit.deco("WellRoof", V(5.6, 0.3, 3.4), cf * CFrame.new(0, 6.1, 0), RGB(170, 60, 50), SMOOTH)
end

local function hayCart(cf)
	Kit.block("CartBed", V(4, 1.6, 7), cf * CFrame.new(0, 1.8, 0), WOOD, Enum.Material.WoodPlanks)
	Kit.block("CartHay", V(3.6, 1.8, 6.4), cf * CFrame.new(0, 3.5, 0), RGB(240, 205, 95), Enum.Material.Grass)
	for _, z in { -2.4, 2.4 } do
		for _, x in { -2.2, 2.2 } do
			Kit.cylinder("CartWheel", 0.35, 2.4, cf * CFrame.new(x, 1.2, z) * CFrame.Angles(0, 0, rad(90)), WOOD_DARK, Enum.Material.Wood, nil, true)
		end
	end
	Kit.contactShadow(cf, 4.5, 7.5)
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	folder:SetAttribute("Ambience", "Breeze") -- (sonido ambiente: ver Ambience en el cliente)
	Kit.applyLighting(Kit.pickLighting(Map))
	folder:SetAttribute("Variant", Kit.Variant)
	folder:SetAttribute("Weather", Kit.Weather)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Suelo: césped con caminos de tierra en cruz
	block("Floor", V(LENGTH + 40, 2, WIDTH + 40), CFrame.new(0, -1, 0), GRASS, SMOOTH)
	deco("Path", V(LENGTH, 0.1, 12), CFrame.new(0, 0.05, 0), PATH, SMOOTH)
	deco("Path", V(12, 0.1, WIDTH), CFrame.new(0, 0.05, 0), PATH, SMOOTH)

	-- Torre del homenaje: dos mitades a los lados del túnel (a lo largo de x) y el techo del túnel
	for _, sz in { -1, 1 } do
		block("Keep", V(KEEP * 2, KEEP_H, KEEP - 3), CFrame.new(0, KEEP_H / 2, sz * (KEEP + 3) / 2), STONE, COBBLE)
	end
	block("KeepTop", V(KEEP * 2, KEEP_H - 6, 6), CFrame.new(0, 6 + (KEEP_H - 6) / 2, 0), STONE, COBBLE)
	deco("KeepTrim", V(KEEP * 2 + 0.6, 0.6, KEEP * 2 + 0.6), CFrame.new(0, KEEP_H - 0.3, 0), STONE_DARK, COBBLE)
	for _, sx in { -1, 1 } do
		deco("TunnelArch", V(0.6, 1, 7), CFrame.new(sx * (KEEP + 0.1), 6.3, 0), STONE_DARK, COBBLE)
		local torch = deco("Torch", V(0.5, 1.2, 0.5), CFrame.new(sx * (KEEP + 0.4), 5, 4.2), RGB(255, 170, 60), Enum.Material.Neon)
		Kit.light(torch, "PointLight", RGB(255, 170, 80), 12, 1)
	end
	-- Estandarte real en lo alto
	Kit.cylinder("KeepPole", 8, 0.35, CFrame.new(0, KEEP_H + 4, 0), WOOD_DARK, Enum.Material.Wood, nil, true)
	local banner = deco("RoyalBanner", V(4, 2.6, 0.12), CFrame.new(2, KEEP_H + 6.6, 0), RGB(150, 40, 160), Enum.Material.Fabric)
	Kit.sign(banner, Enum.NormalId.Front, "👑", RGB(255, 215, 70))
	Kit.sign(banner, Enum.NormalId.Back, "👑", RGB(255, 215, 70))

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(235, 70, 70) or RGB(60, 130, 240)

		-- Escalera exterior a la azotea de la torre y almenas de su lado
		Kit.stairs(m * V(-KEEP - 15.8, 0, 6), m * V(-KEEP - 0.2, KEEP_H, 6), 3, STONE, COBBLE)
		battlements(m * V(-KEEP + 0.9, 0, -KEEP + 0.9), m * V(-KEEP + 0.9, 0, KEEP - 0.9), KEEP_H, { m * V(-KEEP + 0.9, 0, 6) })
		battlements(m * V(-KEEP + 0.9, 0, KEEP - 0.9), m * V(KEEP - 0.9, 0, KEEP - 0.9), KEEP_H, { m * V(-5.3, 0, KEEP - 0.9) })

		-- Muralla con tres pasos y rampa al adarve
		local wallX = -48
		-- (los tramos de los extremos llegan al límite del mapa: solo se cruza por los tres pasos)
		for _, seg in { { -65, -30 }, { -18, -6 }, { 6, 18 }, { 30, 65 } } do
			local len = seg[2] - seg[1]
			local cz = (seg[1] + seg[2]) / 2
			-- (4 de ancho: las almenas van por el lado del centro y queda un adarve para andar)
			block("CastleWall", V(4, 7, len), m * CFrame.new(wallX, 3.5, cz), STONE, COBBLE)
			battlements(m * V(wallX + 1.4, 0, seg[1] + 0.5), m * V(wallX + 1.4, 0, seg[2] - 0.5), 7, nil, 1.2)
			Kit.banner(m * CFrame.new(wallX + 2.2, 4.6, cz) * CFrame.Angles(0, rad(-90), 0), 2.5, 3.5, teamColor, RGB(255, 215, 70))
		end
		Kit.stairs(m * V(wallX - 14, 0, 12), m * V(wallX - 2, 7, 12), 3, STONE, COBBLE)
		Kit.stairs(m * V(wallX - 14, 0, -40), m * V(wallX - 2, 7, -40), 3, STONE, COBBLE)
		-- Torreones en las esquinas de la muralla
		tower(m * V(wallX, 0, 56), 9, 14, side == "A" and RGB(200, 60, 60) or ROOF_BLUE)
		tower(m * V(wallX, 0, -56), 9, 14, side == "A" and RGB(200, 60, 60) or ROOF_BLUE)

		-- Patio: mercado, pozo, carros de heno, barriles, cajas y árboles
		stall(m * CFrame.new(-30, 0, 24) * CFrame.Angles(0, rad(180), 0), teamColor)
		stall(m * CFrame.new(-22, 0, 30) * CFrame.Angles(0, rad(150), 0), RGB(80, 170, 90))
		well(m * CFrame.new(-28, 0, -24))
		hayCart(m * CFrame.new(-16, 0, -14) * CFrame.Angles(0, rad(70), 0))
		hayCart(m * CFrame.new(-38, 0, 8) * CFrame.Angles(0, rad(10), 0))
		Kit.barrel(m * CFrame.new(-12, 0, 18), WOOD)
		Kit.barrel(m * CFrame.new(-14.3, 0, 19.5), WOOD_DARK)
		Kit.crate(m * CFrame.new(-36, 0, -42), 4, WOOD)
		Kit.crate(m * CFrame.new(-31.5, 0, -46), 3.5, WOOD)
		Kit.crate(m * CFrame.new(-62, 0, 24), 4, WOOD)
		Kit.crate(m * CFrame.new(-64, 0, -26), 4, WOOD)
		Kit.tree(m * CFrame.new(-20, 0, -48))
		Kit.tree(m * CFrame.new(-8, 0, 50))
		Kit.tree(m * CFrame.new(-66, 0, 52))
	end)

	-- Bases y banderas
	local spawnStyle = { Floor = RGB(235, 225, 205), Roof = STONE, RoofMaterial = COBBLE }
	Kit.spawnArea(teams[1], CFrame.new(-85, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-85, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-62, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-62, 0, 0))

	-- Fondo: colinas y pinos
	Kit.bounds(LENGTH, WIDTH, 60)
	local rng = Random.new(53)
	for x = -130, 130, 22 do
		for _, z in { -1, 1 } do
			Kit.cartoonPine(V(x + rng:NextNumber(-6, 6), 0, z * (WIDTH / 2 + 50 + rng:NextNumber(0, 12))), 1.6, true)
		end
	end
	for x = -200, 200, 60 do
		for _, z in { -1, 1 } do
			Kit.naturalHill(V(x, -16, z * 160), 42, Enum.Material.Grass, { Inward = V(0, 0, -z), Top = Enum.Material.LeafyGrass, RockCount = 1 })
		end
	end
	for _, sx in { -1, 1 } do
		for z = -80, 80, 55 do
			Kit.naturalHill(V(sx * 165, -16, z), 42, Enum.Material.Grass, { Inward = V(-sx, 0, 0), Top = Enum.Material.LeafyGrass, RockCount = 1 })
		end
	end

	-- Modos
	for _, p in {
		V(-76, 0.5, 8), V(-76, 0.5, -16), V(-56, 0.5, 2), V(-40, 0.5, 30), V(-26, 0.5, -36),
		V(-49, 7.5, 15), V(-4, KEEP_H + 0.5, -4), V(-20, 0.5, 0), V(-60, 0.5, -44), V(-38, 0.5, 50),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, KEEP_H, 0), 6, 1)
	Kit.zone(V(-28, 0, -10), 6, 2)
	Kit.zone(V(28, 0, 10), 6, 3)
	Kit.zone(V(0, 0, -36), 6, 4)
	Kit.zone(V(0, 0, 36), 6, 5)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">ChristmasVillage</string>
              <string name="Source"><![CDATA[-- VILLA NAVIDEÑA (solo sale en la votación durante el evento de Navidad, ver Season): pueblo nevado
-- al anochecer. En el centro, un árbol de Navidad gigante con bolas y estrella, rodeado de regalos
-- enormes (cobertura); a cada lado, casitas con tejado nevado y ventanas encendidas, un mercadillo
-- con toldos de rayas, una pista de patinaje con murete bajo y el trineo de Papá Noel. Nieve cayendo.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)

local Map = {
	Id = "ChristmasVillage",
	Name = "Villa Navideña",
	Icon = "🎄",
	Description = "Navidad · anochecer · árbol gigante, casitas y pista de patinaje",
	Season = "Navidad", -- (solo con el evento de ese nombre en marcha)
}

Map.Lighting = {
	CartoonNeutral = { Hue = 0.6, Sat = 0.12 },
	ClockTime = 18.3,
	Latitude = 50,
	Brightness = 1.8,
	Exposure = 0.15,
	Ambient = Color3.fromRGB(90, 95, 130),
	OutdoorAmbient = Color3.fromRGB(140, 150, 190),
	Atmosphere = { Density = 0.3, Offset = 0.1, Color = Color3.fromRGB(190, 200, 235), Decay = Color3.fromRGB(110, 110, 170), Glare = 0, Haze = 1.2 },
	Color = { Saturation = 0.15, Contrast = 0.1, Brightness = 0.03, Tint = Color3.fromRGB(240, 242, 255) },
	Bloom = { Intensity = 0.8, Size = 24, Threshold = 1.6 },
	Clouds = 0.6,
	CloudColor = Color3.fromRGB(200, 205, 225),
	SunRays = 0.05,
	Wind = Vector3.new(3, 0, 1),
	TerrainColors = {
		Snow = Color3.fromRGB(235, 240, 250),
		Rock = Color3.fromRGB(100, 105, 120),
	},
}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad

local SNOW = RGB(238, 243, 252)
local WOOD = RGB(150, 95, 60)
local WOOD_DARK = RGB(100, 62, 40)
local RED = RGB(210, 35, 45)
local GREEN = RGB(35, 140, 70)
local GOLD = RGB(255, 205, 60)
local WARM = RGB(255, 210, 120)
local ICE = RGB(175, 220, 245)
local SMOOTH = Enum.Material.SmoothPlastic

local LENGTH, WIDTH = 200, 130

-- Regalo enorme (cobertura): caja con cinta en cruz y lazo
local function present(cf, size, color, ribbon)
	Kit.block("Present", size, cf * CFrame.new(0, size.Y / 2, 0), color, SMOOTH)
	Kit.deco("PresentRibbon", V(size.X + 0.06, size.Y + 0.06, 0.5), cf * CFrame.new(0, size.Y / 2, 0), ribbon, SMOOTH)
	Kit.deco("PresentRibbon", V(0.5, size.Y + 0.06, size.Z + 0.06), cf * CFrame.new(0, size.Y / 2, 0), ribbon, SMOOTH)
	for _, a in { 45, -45 } do
		Kit.deco("PresentBow", V(0.9, 0.5, 0.3), cf * CFrame.new(0, size.Y + 0.25, 0) * CFrame.Angles(0, rad(a), rad(20)), ribbon, SMOOTH)
	end
end

-- Árbol de Navidad gigante (decoración) con bolas, guirnalda y estrella
local function christmasTree(cf)
	Kit.cylinder("TreeTrunk", 4, 3, cf * CFrame.new(0, 2, 0), WOOD_DARK, Enum.Material.Wood, nil, true)
	local tiers = 6
	for i = 1, tiers do
		local t = (i - 1) / (tiers - 1)
		local d = 22 - 17 * t
		local y = 5 + t * 22
		Kit.cylinder("TreeTier", 5, d, cf * CFrame.new(0, y, 0), GREEN:Lerp(RGB(25, 110, 55), (i % 2) * 0.5), SMOOTH, nil, true)
		Kit.cylinder("TreeSnow", 0.4, d * 0.7, cf * CFrame.new(0, y + 2.6, 0), SNOW, Enum.Material.Snow, nil, true)
		-- Bolas alrededor de cada piso
		local count = math.max(4, math.floor(d * 0.7))
		for k = 0, count - 1 do
			local a = k / count * math.pi * 2 + i
			local colors = { RED, GOLD, RGB(80, 160, 255), RGB(255, 120, 200) }
			Kit.ball("Ornament", 0.9, cf * CFrame.new(math.cos(a) * d / 2, y - 1.6, math.sin(a) * d / 2), colors[(k + i) % #colors + 1], Enum.Material.Neon, true).CastShadow = false
		end
	end
	-- Estrella (dos rombos cruzados que brillan)
	for _, a in { 0, 45 } do
		local star = Kit.deco("TreeStar", V(3, 3, 0.6), cf * CFrame.new(0, 31.5, 0) * CFrame.Angles(0, 0, rad(a)), GOLD, Enum.Material.Neon)
		Kit.light(star, "PointLight", GOLD, 30, 1.5)
	end
end

-- Casita con tejado a dos aguas nevado, chimenea, puerta y ventanas encendidas (paredes = cobertura)
local function cottage(cf, color)
	local w, h, d = 14, 8, 10
	Kit.block("CottageWalls", V(w, h, d), cf * CFrame.new(0, h / 2, 0), color, Enum.Material.Plaster)
	Kit.deco("CottageBase", V(w + 0.4, 1, d + 0.4), cf * CFrame.new(0, 0.5, 0), WOOD_DARK, Enum.Material.Wood)
	for _, s in { -1, 1 } do
		local slope = cf * CFrame.new(0, h + 2.2, s * d / 4) * CFrame.Angles(rad(s * 32), 0, 0)
		Kit.deco("CottageRoof", V(w + 1.6, 0.7, d * 0.62), slope, RED:Lerp(WOOD_DARK, 0.3), SMOOTH)
		Kit.deco("CottageRoofSnow", V(w + 1.7, 0.4, d * 0.6), slope * CFrame.new(0, 0.5, 0), SNOW, Enum.Material.Snow)
	end
	Kit.deco("CottageGable", V(w - 0.2, 3.6, d - 4), cf * CFrame.new(0, h + 1.6, 0), color, Enum.Material.Plaster)
	Kit.deco("Chimney", V(1.8, 5, 1.8), cf * CFrame.new(w / 2 - 3, h + 2.8, d / 4), RGB(150, 70, 55), Enum.Material.Brick)
	Kit.deco("ChimneySnow", V(2, 0.4, 2), cf * CFrame.new(w / 2 - 3, h + 5.4, d / 4), SNOW, Enum.Material.Snow)
	Kit.deco("CottageDoor", V(2.6, 4.4, 0.3), cf * CFrame.new(0, 2.2, -d / 2 - 0.1), WOOD_DARK, Enum.Material.Wood)
	Kit.deco("Wreath", V(1.4, 1.4, 0.3), cf * CFrame.new(0, 3.6, -d / 2 - 0.3) * CFrame.Angles(0, 0, rad(45)), GREEN, SMOOTH)
	for _, x in { -4.2, 4.2 } do
		local window = Kit.deco("CottageWindow", V(2.4, 2.2, 0.2), cf * CFrame.new(x, 4.4, -d / 2 - 0.08), WARM, Enum.Material.Neon)
		window.CastShadow = false
		Kit.deco("WindowFrame", V(2.8, 0.3, 0.3), cf * CFrame.new(x, 3.2, -d / 2 - 0.15), WOOD_DARK, Enum.Material.Wood)
	end
	Kit.stringLights((cf * CFrame.new(-w / 2, h + 0.3, -d / 2 - 0.4)).Position, (cf * CFrame.new(w / 2, h + 0.3, -d / 2 - 0.4)).Position, WARM)
end

-- Puesto del mercadillo navideño (mostrador de cobertura y toldo de rayas rojas)
local function marketStall(cf, text)
	Kit.block("StallCounter", V(8, 3, 1.6), cf * CFrame.new(0, 1.5, 0), WOOD, Enum.Material.Wood)
	Kit.block("StallBack", V(8, 6.5, 0.5), cf * CFrame.new(0, 3.25, 4.5), WOOD_DARK, Enum.Material.Wood)
	for _, x in { -3.8, 3.8 } do
		Kit.cylinder("StallPost", 7, 0.4, cf * CFrame.new(x, 3.5, -0.6), WOOD_DARK, Enum.Material.Wood, nil, true)
	end
	Kit.deco("StallRoof", V(8.6, 0.4, 6), cf * CFrame.new(0, 7, 2), RED, SMOOTH)
	Kit.deco("StallRoofSnow", V(8.7, 0.3, 6), cf * CFrame.new(0, 7.3, 2), SNOW, Enum.Material.Snow)
	Kit.awning(cf * CFrame.new(0, 6.8, -0.6), 8, 2.4, RED)
	for i = 0, 4 do
		local colors = { RED, GOLD, GREEN, RGB(80, 160, 255), RGB(255, 120, 200) }
		Kit.block("StallGift", V(0.9, 0.8, 0.9), cf * CFrame.new(-2.8 + i * 1.4, 3.4, 0), colors[i + 1], SMOOTH)
	end
	Kit.neonSign(cf * CFrame.new(0, 8.4, 2), 6.5, 1.4, text, WARM, RED)
end

-- Trineo de Papá Noel (cobertura) con su saco de regalos
local function sleigh(cf)
	Kit.block("SleighBody", V(4.6, 2.4, 8), cf * CFrame.new(0, 2.2, 0), RED, SMOOTH)
	Kit.deco("SleighTrim", V(4.7, 0.4, 8.1), cf * CFrame.new(0, 3.3, 0), GOLD, Enum.Material.Neon)
	Kit.block("SleighSeatBack", V(4.6, 2.2, 1), cf * CFrame.new(0, 4.4, 3.4), RED, SMOOTH)
	for _, x in { -2.1, 2.1 } do
		Kit.deco("SleighRunner", V(0.4, 0.4, 10), cf * CFrame.new(x, 0.4, -0.6), GOLD, Enum.Material.Metal)
		Kit.deco("SleighRunnerCurl", V(0.4, 1.6, 0.4), cf * CFrame.new(x, 1.1, -5.6), GOLD, Enum.Material.Metal)
	end
	Kit.ball("SleighSack", 3.6, cf * CFrame.new(0, 4.4, 1), RGB(150, 110, 70), Enum.Material.Fabric, true)
	present(cf * CFrame.new(-0.8, 3.4, -1.8), V(1.4, 1.2, 1.4), GREEN, GOLD)
	present(cf * CFrame.new(1, 3.4, -2.4), V(1.2, 1, 1.2), RGB(80, 160, 255), RED)
end

-- Bastón de caramelo gigante (farola)
local function candyCane(cf)
	for i = 0, 8 do
		Kit.cylinder("CaneStripe", 1, 0.7, cf * CFrame.new(0, 0.5 + i, 0), i % 2 == 0 and RED or RGB(250, 250, 250), SMOOTH, nil, true)
	end
	Kit.deco("CaneHook", V(2.2, 0.7, 0.7), cf * CFrame.new(0.8, 9.1, 0), RED, SMOOTH)
	Kit.deco("CaneHookEnd", V(0.7, 1.4, 0.7), cf * CFrame.new(1.6, 8.5, 0), RGB(250, 250, 250), SMOOTH)
	local lamp = Kit.ball("CaneLamp", 0.9, cf * CFrame.new(1.6, 7.6, 0), WARM, Enum.Material.Neon, true)
	Kit.light(lamp, "PointLight", WARM, 16, 1)
	return (cf * CFrame.new(1.6, 8, 0)).Position
end

-- Pista de patinaje: hielo con murete bajo de madera (huecos para entrar)
local function iceRink(cf)
	local sx, sz = 26, 16
	Kit.deco("Rink", V(sx, 0.2, sz), cf * CFrame.new(0, 0.1, 0), ICE, Enum.Material.Ice)
	for _, z in { -1, 1 } do
		for _, x in { -1, 1 } do
			Kit.block("RinkWall", V(sx / 2 - 2.5, 2.4, 0.8), cf * CFrame.new(x * (sx / 4 + 1.25), 1.2, z * sz / 2), WOOD, Enum.Material.Wood)
		end
	end
	for _, x in { -1, 1 } do
		Kit.block("RinkWall", V(0.8, 2.4, sz), cf * CFrame.new(x * sx / 2, 1.2, 0), WOOD, Enum.Material.Wood)
	end
	Kit.snowman(cf * CFrame.new(5, 0.2, 3), 0.8)
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	folder:SetAttribute("Ambience", "Snow") -- (sonido ambiente: ver Ambience en el cliente)
	Kit.applyLighting(Map.Lighting)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	block("Floor", V(LENGTH + 40, 2, WIDTH + 40), CFrame.new(0, -1, 0), SNOW, Enum.Material.Snow)
	-- Caminos pisados en la nieve
	deco("Path", V(LENGTH, 0.06, 10), CFrame.new(0, 0.03, 0), RGB(215, 222, 235), Enum.Material.Snow)
	deco("Path", V(10, 0.06, WIDTH), CFrame.new(0, 0.03, 0), RGB(215, 222, 235), Enum.Material.Snow)

	-- Centro: árbol gigante en una plaza elevada con regalos alrededor
	Kit.cylinder("TreePlaza", 1, 30, CFrame.new(0, 0.5, 0), RGB(200, 205, 220), Enum.Material.Cobblestone)
	christmasTree(CFrame.new(0, 1, 0))
	for i, spot in { { 9, 6, RED, GOLD }, { -8, 8, GREEN, RED }, { -9, -6, RGB(80, 160, 255), GOLD }, { 8, -8, GOLD, RED } } do
		local size = (i % 2 == 0) and V(4, 3.5, 4) or V(3.4, 3, 3.4)
		present(CFrame.new(spot[1], 1, spot[2]) * CFrame.Angles(0, rad(i * 25), 0), size, spot[3], spot[4])
	end

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(235, 70, 70) or RGB(60, 130, 240)
		-- Casitas
		cottage(m * CFrame.new(-55, 0, 46), RGB(240, 225, 200))
		cottage(m * CFrame.new(-34, 0, 48) * CFrame.Angles(0, rad(-8), 0), RGB(200, 225, 240))
		cottage(m * CFrame.new(-70, 0, -46) * CFrame.Angles(0, rad(180), 0), RGB(245, 210, 210))
		-- Mercadillo
		marketStall(m * CFrame.new(-22, 0, -40) * CFrame.Angles(0, rad(180), 0), "TURRÓN")
		marketStall(m * CFrame.new(-40, 0, -40) * CFrame.Angles(0, rad(180), 0), "REGALOS")
		-- Pista de patinaje y trineo
		iceRink(m * CFrame.new(-30, 0, 20))
		sleigh(m * CFrame.new(-58, 0, -14) * CFrame.Angles(0, rad(20), 0))
		-- Regalos y muñecos de nieve sueltos (cobertura media)
		present(m * CFrame.new(-46, 0, 8), V(4, 3.2, 4), teamColor, GOLD)
		present(m * CFrame.new(-49, 0, 12), V(3, 2.6, 3), GREEN, RED)
		present(m * CFrame.new(-18, 0, -14), V(3.6, 3, 3.6), RED, GOLD)
		Kit.snowman(m * CFrame.new(-14, 0, 30), 1.1)
		Kit.snowman(m * CFrame.new(-60, 0, 26), 1)
		-- Farolas de bastón de caramelo con guirnaldas
		local a = candyCane(m * CFrame.new(-20, 0, 32))
		local b = candyCane(m * CFrame.new(-48, 0, 32))
		local c = candyCane(m * CFrame.new(-20, 0, -28))
		local d = candyCane(m * CFrame.new(-48, 0, -28))
		Kit.stringLights(a, b, WARM)
		Kit.stringLights(c, d, RGB(255, 120, 120))
		Kit.banner(m * CFrame.new(-68, 12, 30) * CFrame.Angles(0, rad(90), 0), 4, 6, teamColor, GOLD)
		Kit.banner(m * CFrame.new(-68, 12, -30) * CFrame.Angles(0, rad(90), 0), 4, 6, teamColor, GOLD)
	end)

	-- Bases y banderas
	local spawnStyle = { Floor = RGB(235, 235, 245), Roof = RGB(230, 236, 248) }
	Kit.spawnArea(teams[1], CFrame.new(-85, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-85, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-62, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-62, 0, 0))

	-- Fondo: pinos y colinas nevadas
	Kit.bounds(LENGTH, WIDTH, 60)
	local rng = Random.new(12)
	for x = -130, 130, 20 do
		for _, z in { -1, 1 } do
			Kit.cartoonPine(V(x + rng:NextNumber(-5, 5), 0, z * (WIDTH / 2 + 30 + rng:NextNumber(0, 18))), 1.7, true)
		end
	end
	for _, sx in { -1, 1 } do
		for z = -60, 60, 30 do
			Kit.cartoonPine(V(sx * (LENGTH / 2 + 14 + rng:NextNumber(0, 10)), 0, z + rng:NextNumber(-6, 6)), 1.6, true)
		end
		for z = -80, 80, 55 do
			Kit.naturalHill(V(sx * 165, -16, z), 42, Enum.Material.Snow, { Inward = V(-sx, 0, 0), Top = Enum.Material.Snow, RockCount = 1 })
		end
	end
	for x = -200, 200, 60 do
		for _, z in { -1, 1 } do
			Kit.naturalHill(V(x, -16, z * 160), 42, Enum.Material.Snow, { Inward = V(0, 0, -z), Top = Enum.Material.Snow, RockCount = 1 })
		end
	end

	-- Nieve cayendo
	local sky = deco("Snowfall", V(LENGTH + 40, 1, WIDTH + 40), CFrame.new(0, 56, 0), SNOW, SMOOTH)
	sky.Transparency = 1
	sky.CastShadow = false
	local snow = Instance.new("ParticleEmitter")
	snow.Name = "Snow"
	snow.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	snow.Color = ColorSequence.new(Color3.new(1, 1, 1))
	snow.LightEmission = 0.3
	snow.Size = NumberSequence.new(0.25)
	snow.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.85, 0.2), NumberSequenceKeypoint.new(1, 1) })
	snow.Lifetime = NumberRange.new(7, 9)
	snow.Speed = NumberRange.new(5, 8)
	snow.SpreadAngle = Vector2.new(15, 15)
	snow.WindAffectsDrag = true
	snow.RotSpeed = NumberRange.new(-60, 60)
	snow.Rate = 110
	snow.EmissionDirection = Enum.NormalId.Bottom
	snow.Parent = sky

	-- Modos
	for _, p in {
		V(-76, 0.5, 8), V(-76, 0.5, -16), V(-50, 0.5, 2), V(-42, 0.5, 24), V(-30, 0.5, 20),
		V(-24, 0.5, -24), V(-12, 1.5, -12), V(-40, 0.5, -52), V(-62, 0.5, 30), V(-16, 0.5, 44),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, 1, 13), 5, 1)
	Kit.zone(V(-30, 0, 20), 6, 2)
	Kit.zone(V(30, 0, -20), 6, 3)
	Kit.zone(V(-31, 0, -46), 5, 4)
	Kit.zone(V(31, 0, 46), 5, 5)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">ContainerClash</string>
              <string name="Source"><![CDATA[-- CONTAINER CLASH: patio de contenedores al atardecer. Calle central con pila central,
-- pasillos laterales entre contenedores, pasarelas elevadas y almacenes como zonas de salida.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)
local Variants = require(script.Parent.Parent.LightingVariants)

local Map = {
	Id = "ContainerClash",
	Bomb = true, -- tiene sitios para Buscar y destruir
	Name = "Container Clash",
	Icon = "📦",
	Description = "Puerto · atardecer · pasillos y pasarelas",
}

Map.Lighting = {
	CartoonNeutral = { Hue = 0.07, Sat = 0.18 }, -- tono de los grises en estilo Cartoon
	ClockTime = 17.6,
	Brightness = 2.6,
	Exposure = 0,
	Ambient = Color3.fromRGB(70, 55, 55),
	OutdoorAmbient = Color3.fromRGB(150, 110, 95),
	Atmosphere = { Density = 0.35, Offset = 0.15, Color = Color3.fromRGB(255, 190, 140), Decay = Color3.fromRGB(170, 90, 85), Glare = 0.9, Haze = 2 },
	Color = { Saturation = 0.15, Contrast = 0.18, Brightness = 0, Tint = Color3.fromRGB(255, 232, 212) },
	Bloom = { Intensity = 0.6, Size = 26, Threshold = 1.8 },
	Clouds = 0.5,
	CloudColor = Color3.fromRGB(255, 200, 170),
	SunRays = 0.12,
	SunSize = 30, -- sol grande de atardecer
	Water = { Color = Color3.fromRGB(25, 70, 105), Reflectance = 1, Transparency = 0.3, WaveSize = 0.2, WaveSpeed = 9 },
}
-- A veces sale con otra luz o con mal tiempo (ver LightingVariants)
Map.LightingVariants = { Variants.Storm(0.25), Variants.Fog(0.2) }

local V = Vector3.new
local RGB = Color3.fromRGB
local C = Kit.C

local COLORS = { RGB(210, 60, 45), RGB(45, 110, 210), RGB(240, 150, 30), RGB(60, 160, 90), RGB(130, 135, 145), RGB(230, 230, 235) }

-- Contenedor ligero (pocas piezas) para muros y fondos
local function lite(cf, color, decorative)
	local fn = decorative and Kit.deco or Kit.block
	fn("Container", V(20, 8.5, 8), cf * CFrame.new(0, 4.25, 0), color, Enum.Material.CorrodedMetal)
	local dark = color:Lerp(Color3.new(0, 0, 0), 0.35)
	-- Los decorativos (fondo y fila de arriba) sin nervios: casi no se ven y ahorran piezas
	for i = -1, decorative and -2 or 1 do
		Kit.deco("Rib", V(0.5, 8.3, 8.2), cf * CFrame.new(i * 7, 4.25, 0), dark, Enum.Material.Metal).CastShadow = false
	end
	Kit.deco("Roof", V(20.2, 0.3, 8.2), cf * CFrame.new(0, 8.6, 0), dark, Enum.Material.Metal).CastShadow = false
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	folder:SetAttribute("Ambience", "Coast") -- (sonido ambiente: ver Ambience en el cliente)
	Kit.applyLighting(Kit.pickLighting(Map))
	folder:SetAttribute("Variant", Kit.Variant)
	folder:SetAttribute("Weather", Kit.Weather)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Suelo con marcas amarillas
	-- Asfalto de puerto con marcas amarillas gastadas
	block("Yard", V(340, 2, 240), CFrame.new(0, -1, 0), RGB(78, 78, 82), Enum.Material.Asphalt)
	for _, z in { -30, 30, -90, 90 } do
		deco("LaneLine", V(260, 0.05, 0.8), CFrame.new(0, 0.03, z), RGB(214, 178, 52), Enum.Material.Asphalt)
	end
	for x = -120, 120, 40 do
		deco("CrossLine", V(0.8, 0.05, 240), CFrame.new(x, 0.03, 0), RGB(200, 190, 120), Enum.Material.SmoothPlastic)
	end
	for i = 1, 14 do
		local x, z = ((i * 53) % 260) - 130, ((i * 71) % 200) - 100
		deco("Stain", V(6 + i % 4, 0.04, 4 + i % 3), CFrame.new(x, 0.025, z) * CFrame.Angles(0, i, 0), RGB(90, 88, 85), Enum.Material.Concrete).Transparency = 0.5
	end

	-- Pila central (dos contenedores a lo largo de Z y uno encima)
	Kit.container(CFrame.new(0, 0, -11) * CFrame.Angles(0, math.rad(90), 0), COLORS[5], "CENTER")
	Kit.container(CFrame.new(0, 0, 11) * CFrame.Angles(0, math.rad(90), 0), COLORS[5], "CENTER")
	Kit.container(CFrame.new(0, 8.9, 0) * CFrame.Angles(0, math.rad(90), 0), C.Yellow, "STACK 01")

	-- Grúa pórtico sobre el centro con un contenedor colgando
	local gantry = RGB(245, 185, 35)
	for _, x in { -22, 22 } do
		for _, z in { -38, 38 } do
			block("GantryLeg", V(2.5, 40, 2.5), CFrame.new(x, 20, z), gantry, Enum.Material.Metal)
		end
		block("GantryBeam", V(2.5, 3, 78), CFrame.new(x, 40, 0), gantry, Enum.Material.Metal)
	end
	block("GantryCross", V(46, 3, 3), CFrame.new(0, 41, -8), gantry, Enum.Material.Metal)
	deco("GantryCable", V(0.3, 9, 0.3), CFrame.new(0, 35, -8), RGB(30, 30, 30), Enum.Material.Metal)
	lite(CFrame.new(0, 22, -8) * CFrame.Angles(0, math.rad(90), 0), RGB(210, 70, 50), true)
	Kit.ball("GantryBeacon", 1, CFrame.new(0, 43, -8), RGB(255, 60, 40), Enum.Material.Neon, true):SetAttribute("Blink", 1)

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(210, 50, 45) or RGB(45, 110, 220)

		-- Pasillo lateral: dos filas de contenedores con huecos
		for i, x in { -104, -80, -50, -20 } do
			local c1 = COLORS[(i % #COLORS) + 1]
			local c2 = COLORS[((i + 2) % #COLORS) + 1]
			if i ~= 3 then
				Kit.container(m * CFrame.new(x, 0, -48), c1)
			end
			Kit.container(m * CFrame.new(x + 4, 0, -76), c2)
			if i % 2 == 0 then
				Kit.container(m * CFrame.new(x + 4, 8.9, -76), COLORS[((i + 4) % #COLORS) + 1])
			end
		end
		-- Rampa de cajas para subir a la fila alta del pasillo
		Kit.ramp(m * V(-100, 0, -55), m * V(-100, 8.6, -71.5), 5, RGB(150, 120, 80), Enum.Material.WoodPlanks)

		-- Contenedores y cobertura de la zona media
		Kit.container(m * CFrame.new(-55, 0, 25), COLORS[2])
		Kit.container(m * CFrame.new(-55, 0, 33.4), COLORS[1])
		Kit.container(m * CFrame.new(-30, 0, 55) * CFrame.Angles(0, math.rad(90), 0), COLORS[4])
		Kit.container(m * CFrame.new(-95, 0, 18) * CFrame.Angles(0, math.rad(90), 0), COLORS[3])
		Kit.metalCrate(m * CFrame.new(-25, 0, 22), 4)
		Kit.metalCrate(m * CFrame.new(-21, 0, 22), 4)
		Kit.metalCrate(m * CFrame.new(-23, 4, 22), 3.5)
		Kit.crate(m * CFrame.new(-70, 0, -10), 5)
		Kit.crate(m * CFrame.new(-40, 0, -15))
		Kit.crate(m * CFrame.new(-40, 0, -19.5), 3)
		Kit.crate(m * CFrame.new(-120, 0, 40))
		Kit.barrel(m * CFrame.new(-45, 0, 0), RGB(40, 90, 180))
		Kit.barrel(m * CFrame.new(-43, 0, 2.3), RGB(40, 90, 180))
		Kit.barrel(m * CFrame.new(-100, 0, -30), RGB(200, 60, 40))
		Kit.barrel(m * CFrame.new(-35, 0, 80), RGB(60, 160, 90))
		for _, p in { V(-60, 0, 0), V(-62, 0, 4), V(-15, 0, 40), V(-80, 0, 45) } do
			Kit.cone(m * CFrame.new(p))
		end
		Kit.forklift(m * CFrame.new(-75, 0, 60) * CFrame.Angles(0, math.rad(30), 0))

		-- Pasarela elevada delante del almacén con escaleras
		local walkY = 10
		block("Catwalk", V(8, 1, 100), m * CFrame.new(-118, walkY - 0.5, 0), RGB(80, 82, 92), Enum.Material.DiamondPlate)
		for z = -48, 48, 16 do
			block("CatwalkLeg", V(1, walkY - 1, 1), m * CFrame.new(-115, (walkY - 1) / 2, z), C.Metal, Enum.Material.Metal)
		end
		Kit.railing(m * V(-114.2, walkY, -50), m * V(-114.2, walkY, 50), 3, C.Yellow)
		Kit.stairs(m * V(-118, 0, 72), m * V(-118, walkY, 52), 6, RGB(120, 122, 130))
		Kit.stairs(m * V(-118, 0, -72), m * V(-118, walkY, -52), 6, RGB(120, 122, 130))

		-- Almacén de salida: paredes, número grande y estandartes
		local wallColor = RGB(120, 118, 115)
		block("WarehouseWall", V(32, 22, 2), m * CFrame.new(-145, 11, 37), wallColor, Enum.Material.CorrodedMetal)
		block("WarehouseWall", V(32, 22, 2), m * CFrame.new(-145, 11, -37), wallColor, Enum.Material.CorrodedMetal)
		block("WarehouseRoof", V(34, 1.5, 76), m * CFrame.new(-145, 22.5, 0), RGB(90, 88, 86), Enum.Material.CorrodedMetal)
		local front = block("WarehouseFront", V(2, 6, 76), m * CFrame.new(-129.5, 19.5, 0), wallColor, Enum.Material.CorrodedMetal)
		Kit.sign(front, Enum.NormalId.Right, side == "A" and "02" or "03", RGB(240, 240, 240), RGB(30, 30, 30))
		for _, z in { -30, 30 } do
			Kit.banner(m * CFrame.new(-128.2, 17, z) * CFrame.Angles(0, math.rad(-90), 0), 5, 9, teamColor, C.White)
		end
		for _, z in { -20, 20 } do
			local lamp = deco("WarehouseLamp", V(1.4, 0.6, 3), m * CFrame.new(-128.5, 15.6, z), RGB(255, 220, 160), Enum.Material.Neon)
			Kit.lightCone((m * CFrame.new(-128.5, 15.2, z)).Position, 14, 1, 6, RGB(255, 215, 160))
			Kit.light(lamp, "SpotLight", RGB(255, 210, 150), 30, 2, Enum.NormalId.Bottom).Angle = 110
		end
	end)

	-- Spawns y banderas
	local spawnStyle = { Floor = RGB(110, 108, 106), FloorMaterial = Enum.Material.Concrete, Roof = RGB(90, 88, 86), RoofMaterial = Enum.Material.CorrodedMetal }
	Kit.spawnArea(teams[1], CFrame.new(-145, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-145, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-102, 0, -2))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-102, 0, -2))

	-- Muro perimetral de contenedores (2 alturas) y límites
	Kit.bounds(320, 220, 60)
	for x = -150, 150, 21 do
		for _, z in { -114, 114 } do
			lite(CFrame.new(x, 0, z), COLORS[(math.abs(x) // 21 + (z > 0 and 1 or 0)) % #COLORS + 1])
			lite(CFrame.new(x, 8.9, z), COLORS[(math.abs(x) // 21 + 3) % #COLORS + 1], true)
		end
	end

	-- Fondo: grúas, barcos, más contenedores y el mar al atardecer
	workspace.Terrain:FillBlock(CFrame.new(0, -12, 330), V(1000, 20, 400), Enum.Material.Water)
	block("Quay", V(600, 4, 30), CFrame.new(0, -2, 135), RGB(120, 118, 115), Enum.Material.Concrete)
	for i, x in { -180, -100, -20, 60, 140, 220 } do
		Kit.crane(CFrame.new(x, 0, 140) * CFrame.Angles(0, math.rad(180), 0), 50 + (i % 3) * 6, i % 2 == 0 and RGB(220, 70, 50) or RGB(245, 185, 35))
	end
	Kit.ship(CFrame.new(-60, -2, 190), 140)
	Kit.ship(CFrame.new(160, -2, 260) * CFrame.Angles(0, math.rad(-12), 0), 110)
	for x = -220, 220, 21 do
		for row = 0, 2 do
			lite(CFrame.new(x, row * 8.6, -140 - (x % 3) * 9), COLORS[(math.abs(x) // 21 + row) % #COLORS + 1], true)
		end
	end
	for z = -100, 100, 25 do
		for _, sx in { -1, 1 } do
			lite(CFrame.new(sx * 175, 0, z) * CFrame.Angles(0, math.rad(90), 0), COLORS[(math.abs(z) // 25) % #COLORS + 1], true)
			lite(CFrame.new(sx * 175, 8.6, z) * CFrame.Angles(0, math.rad(90), 0), COLORS[(math.abs(z) // 25 + 2) % #COLORS + 1], true)
		end
	end

	-- Modos
	for _, p in {
		V(-130, 0.5, 50), V(-100, 0.5, -36), V(-70, 0.5, 10), V(-40, 0.5, 40), V(-35, 0.5, -60),
		V(-118, 10.5, 30), V(-118, 10.5, -30), V(-90, 0.5, 90), V(-15, 0.5, -30), V(-60, 0.5, -90),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	-- Buscar y destruir: sitios A y B en la mitad de cada equipo
	for _, site in { { V(-90, 0, 90), "A" }, { V(-60, 0, -90), "B" } } do
		Kit.bombSite(site[1], site[2], 1)
		Kit.bombSite(Kit.MIRROR * site[1], site[2], 2)
	end
	Kit.zone(V(0, 0, 30), 10, 1)
	Kit.zone(V(-60, 0, -62), 10, 2)
	Kit.zone(V(60, 0, 62), 10, 3)
	Kit.zone(V(0, 0, -30), 10, 4)
	Kit.zone(V(-75, 0, 10), 10, 5)
	-- Realismo: charcos que reflejan el atardecer, vapor y polvo dorado en el carril central
	for _, p in { Vector3.new(-66, 0, 14), Vector3.new(-35, 0, 45), Vector3.new(-10, 0, -26), Vector3.new(-95, 0, -41), Vector3.new(-55, 0, -95) } do
		Kit.puddle(p, 5)
		Kit.puddle(Kit.MIRROR * p, 5)
	end
	for _, p in { Vector3.new(-30, 0, -64), Vector3.new(-86, 0, 86) } do
		Kit.steamVent(CFrame.new(p), 1)
		Kit.steamVent(Kit.MIRROR * CFrame.new(p), 1)
	end
	Kit.dustMotes(CFrame.new(0, 7, 0), Vector3.new(220, 12, 40), Color3.fromRGB(255, 215, 160), 30)
	-- Realismo: suelo de puerto usado (alcantarillas, desagües, grietas, aceite y rodadas de la carretilla)
	Kit.symmetric(function(m)
		for _, p in { V(-50, 0, -10), V(-85, 0, 70), V(-12, 0, 10) } do
			Kit.manhole(m * p)
		end
		for _, p in { V(-30, 0, -88), V(-70, 0, 92) } do
			Kit.drain(m * CFrame.new(p))
		end
		for i, spec in { { V(-80, 0, -5), 8 }, { V(-25, 0, -45), 10 }, { V(-110, 0, 70), 9 }, { V(-60, 0, 82), 7 } } do
			Kit.crack(m * spec[1], spec[2], i * 17)
		end
		for _, p in { V(-73, 0, 56), V(-41, 0, 4), V(-98, 0, -27) } do
			Kit.oilStain(m * p, 3)
		end
		Kit.tireMarks(m * CFrame.new(-70, 0, 68) * CFrame.Angles(0, math.rad(30), 0), 22, 0.6)
	end)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">Crossroads</string>
              <string name="Source"><![CDATA[-- ENCRUCIJADA: ciudad en guerra al estilo de los mapas 5 contra 5 de los shooters de móvil.
-- Tres carriles de punta a punta: la avenida central (larga, con el monumento en medio que corta
-- la línea de tiro de base a base) y dos carriles laterales (callejón del mercado y obras). Entre
-- carriles, filas de edificios con pasos entre ellos y edificios de dos plantas en los que se
-- puede entrar, con ventanas de verdad para disparar desde arriba. Simétrico por rotación: cada
-- equipo tiene lo mismo a su izquierda y a su derecha. Siempre en estilo realista.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)

local Map = {
	Id = "Crossroads",
	Bomb = true, -- tiene sitios para Buscar y destruir
	Name = "Encrucijada",
	Icon = "🏚️",
	Description = "Ciudad en guerra · 3 carriles · 5 contra 5",
	Realistic = true,
}

Map.Lighting = {
	ClockTime = 15.2,
	Latitude = 28,
	Brightness = 3.2,
	Exposure = -0.1,
	Ambient = Color3.fromRGB(78, 70, 62),
	OutdoorAmbient = Color3.fromRGB(150, 138, 120),
	ShadowSoftness = 0.08,
	Atmosphere = { Density = 0.38, Offset = 0.12, Color = Color3.fromRGB(222, 196, 160), Decay = Color3.fromRGB(150, 120, 95), Glare = 0.4, Haze = 2.2 },
	Color = { Saturation = -0.05, Contrast = 0.2, Brightness = 0, Tint = Color3.fromRGB(255, 240, 222) },
	Bloom = { Intensity = 0.5, Size = 24, Threshold = 2 },
	Clouds = 0.35,
	CloudColor = Color3.fromRGB(240, 225, 205),
	SunRays = 0.08,
	Wind = Vector3.new(6, 0, 3),
	TerrainColors = { Ground = Color3.fromRGB(128, 108, 82), Sand = Color3.fromRGB(176, 152, 116), Rock = Color3.fromRGB(120, 112, 102), Pavement = Color3.fromRGB(112, 104, 94), Mud = Color3.fromRGB(86, 70, 54) },
}

-- Versiones de luz (a veces): atardecer naranja con sombras largas
Map.LightingVariants = {
	{
		Name = "Atardecer",
		Chance = 0.3,
		ClockTime = 17.85,
		Brightness = 2.2,
		Exposure = 0.05,
		Ambient = Color3.fromRGB(86, 64, 58),
		OutdoorAmbient = Color3.fromRGB(150, 112, 92),
		Atmosphere = { Density = 0.4, Offset = 0.1, Color = Color3.fromRGB(240, 172, 122), Decay = Color3.fromRGB(160, 92, 70), Glare = 0.8, Haze = 2.4 },
		Color = { Saturation = 0, Contrast = 0.18, Brightness = 0, Tint = Color3.fromRGB(255, 226, 200) },
		CloudColor = Color3.fromRGB(255, 190, 150),
		SunRays = 0.14,
	},
	{
		-- Noche: farolas encendidas y bidones ardiendo (oscuro, pero se ve)
		Name = "Noche",
		Chance = 0.25,
		ClockTime = 21.5,
		Brightness = 1,
		Exposure = 0.35,
		Ambient = Color3.fromRGB(52, 56, 72),
		OutdoorAmbient = Color3.fromRGB(70, 78, 104),
		Atmosphere = { Density = 0.35, Offset = 0.1, Color = Color3.fromRGB(60, 66, 90), Decay = Color3.fromRGB(30, 32, 48), Glare = 0, Haze = 1.2 },
		Color = { Saturation = -0.1, Contrast = 0.2, Brightness = 0.02, Tint = Color3.fromRGB(210, 220, 255) },
		Bloom = { Intensity = 0.7, Size = 24, Threshold = 1.6 },
		Clouds = 0.4,
		CloudColor = Color3.fromRGB(60, 64, 80),
		SunRays = 0,
	},
}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad
local M = Enum.Material

local LENGTH, WIDTH = 410, 270 -- zona jugable (X: de base a base; Z: de lado a lado)

local RealKit = require(script.Parent.Parent.RealKit)
local FLOOR_H = RealKit.FLOOR_H
local PALETTE = RealKit.PALETTE
local building, solidBlock, sandbags, ruinWall = RealKit.building, RealKit.solidBlock, RealKit.sandbags, RealKit.ruinWall
local burntCar, bus, tankWreck, stall = RealKit.burntCar, RealKit.bus, RealKit.tankWreck, RealKit.stall

local block, deco = Kit.block, Kit.deco

-- Fuego encima de un bidón o de un coche quemado (solo de noche): llamas y luz naranja
local function fire(cf, size)
	local core = deco("FireCore", V(1, 1, 1), cf, RGB(255, 140, 40), M.Neon)
	core.Transparency = 1
	local flames = Instance.new("Fire")
	flames.Size = size or 4
	flames.Heat = 6
	flames.Color = RGB(255, 140, 40)
	flames.SecondaryColor = RGB(255, 60, 20)
	flames.Parent = core
	Kit.light(core, "PointLight", RGB(255, 150, 70), 14, 1.6)
end

---------------------------------------------------------------------------
-- Mapa
---------------------------------------------------------------------------

function Map.Build()
	local folder = Kit.Begin(Map.Name, { Realistic = true })
	folder:SetAttribute("Ambience", "War") -- (sonido ambiente: ver Ambience en el cliente)
	Kit.applyLighting(Kit.pickLighting(Map))
	folder:SetAttribute("Variant", Kit.Variant)
	folder:SetAttribute("Weather", Kit.Weather)
	local teams = GameConfig.Teams

	-- Suelo: tierra en los carriles, asfalto en la avenida y aceras
	Kit.terrainFloor(M.Ground, LENGTH + 240, WIDTH + 240)
	block("Avenue", V(LENGTH + 40, 0.4, 36), CFrame.new(0, 0.2, 0), RGB(64, 64, 66), M.Asphalt)
	for _, z in { -1, 1 } do
		block("Sidewalk", V(LENGTH - 60, 0.7, 5), CFrame.new(0, 0.35, z * 20.5), RGB(150, 144, 134), M.Pavement)
		deco("Curb", V(LENGTH - 60, 0.75, 0.6), CFrame.new(0, 0.37, z * 18.2), RGB(170, 166, 158), M.Concrete)
	end
	for x = -180, 180, 12 do
		if math.abs(x) > 20 then
			deco("LaneDash", V(5, 0.05, 0.5), CFrame.new(x, 0.43, 0), RGB(210, 200, 170), M.Concrete)
		end
	end
	-- Cruce del centro (une la avenida con los dos carriles)
	block("CrossStreet", V(24, 0.4, WIDTH - 20), CFrame.new(0, 0.2, 0), RGB(70, 70, 72), M.Asphalt)

	-- Monumento central: corta la línea de tiro de base a base por la avenida
	Kit.cylinder("FountainBasin", 1.6, 18, CFrame.new(0, 0.8, 0), RGB(170, 160, 145), M.Limestone)
	Kit.cylinder("FountainWater", 0.2, 16, CFrame.new(0, 1.55, 0), RGB(60, 80, 70), M.Glass, nil, true)
	block("MonumentBase", V(7, 4, 7), CFrame.new(0, 3.6, 0), RGB(160, 150, 136), M.Limestone)
	block("MonumentColumn", V(3, 12, 3), CFrame.new(0, 11.6, 0), RGB(176, 166, 150), M.Marble)
	deco("MonumentTop", V(4.2, 1.2, 4.2), CFrame.new(0, 18.2, 0), RGB(150, 140, 125), M.Limestone)
	deco("MonumentStatue", V(1.6, 3.6, 1.2), CFrame.new(0, 20.6, 0) * CFrame.Angles(0, rad(20), 0), RGB(90, 110, 95), M.Metal)
	-- Escombros del monumento (una esquina rota)
	for i = 1, 4 do
		deco("Debris", V(1.5 + i * 0.4, 1, 1.2 + i * 0.3), CFrame.new(5 + i, 2.1, -6 + i * 0.8) * CFrame.Angles(i, i * 0.7, 0), RGB(165, 155, 140), M.Limestone)
	end

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and teams[1].Color.Color or teams[2].Color.Color

		------------------------------------------------------------------
		-- Fila norte (entre la avenida y el callejón del mercado), z 24..46
		------------------------------------------------------------------
		solidBlock(m * CFrame.new(-148, 0, 35), 26, 20, 16, PALETTE.Plaster[2], { Sign = side == "A" and "PANADERÍA" or "FERRETERÍA" })
		-- Hotel: dos plantas, ventanas a la avenida (puesto de tirador) y puertas a los dos lados
		building(m * CFrame.new(-110, 0, 35) * CFrame.Angles(0, 0, 0), 30, 22, {
			Floors = 2,
			Color = PALETTE.Plaster[1],
			Doors = { Front = { -6 }, Back = { 6 } },
			Blind = { Left = true },
			Sign = "HOTEL CENTRAL",
		})
		-- Tienda en ruinas: una planta sin tejado, muros rotos (se pelea dentro)
		building(m * CFrame.new(-66, 0, 34), 24, 18, {
			Floors = 1,
			Color = PALETTE.Plaster[4],
			Ruined = true,
			Doors = { Front = { -4 }, Back = { 5 }, Right = { 0 } },
		})
		-- Puestos del mercado junto al cruce
		stall(m * CFrame.new(-40, 0, 30), RGB(170, 60, 50))
		stall(m * CFrame.new(-30, 0, 40) * CFrame.Angles(0, rad(90), 0), RGB(60, 110, 150))
		sandbags(m * CFrame.new(-20, 0, 27), 8)

		------------------------------------------------------------------
		-- Fila sur (entre la avenida y las obras), z -46..-24
		------------------------------------------------------------------
		solidBlock(m * CFrame.new(-152, 0, -35), 22, 20, 20, PALETTE.Plaster[3], { Sign = side == "A" and "FARMACIA" or "CAFÉ" })
		-- Oficinas: dos plantas, ventanas a la avenida y a las obras
		building(m * CFrame.new(-114, 0, -35) * CFrame.Angles(0, math.pi, 0), 28, 22, {
			Floors = 2,
			Color = PALETTE.Plaster[5],
			Doors = { Front = { 5 }, Back = { -5 } },
			Blind = { Right = true },
			Sign = "OFICINAS",
		})
		solidBlock(m * CFrame.new(-72, 0, -35), 24, 20, 13, PALETTE.Brick, { Material = M.Brick })
		bus(m * CFrame.new(-34, 0, -31) * CFrame.Angles(0, rad(8), 0))

		------------------------------------------------------------------
		-- Avenida (z -18..18)
		------------------------------------------------------------------
		burntCar(m * CFrame.new(-138, 0, -9) * CFrame.Angles(0, rad(25), 0), true)
		Kit.barrier(V(10, 3.6, 1.6), m * CFrame.new(-96, 0, 7))
		sandbags(m * CFrame.new(-70, 0, -8) * CFrame.Angles(0, rad(90), 0), 9)
		burntCar(m * CFrame.new(-48, 0, 9) * CFrame.Angles(0, rad(-15), 0), false)
		Kit.barrier(V(1.6, 3.6, 8), m * CFrame.new(-24, 0, -11))
		for _, p in { V(-120, 0, 14), V(-82, 0, -14), V(-58, 0, 13) } do
			Kit.barrel(m * CFrame.new(p), RGB(80, 84, 70))
			if Kit.Variant == "Noche" then
				fire(m * CFrame.new(p + V(0, 3.4, 0)), 3.5)
			end
		end
		if Kit.Variant == "Noche" then
			fire(m * CFrame.new(-138, 2.6, -9), 6) -- (el coche quemado de la avenida)
			fire(m * CFrame.new(-62, 2.6, 104), 6) -- (el del callejón)
		end
		for _, x in { -150, -100, -50 } do
			Kit.streetLamp(m * CFrame.new(x, 0, 19.5) * CFrame.Angles(0, math.pi, 0), RGB(255, 225, 180))
		end
		-- Detalles de calle: postes de la luz con cables por la acera sur, asfalto parcheado y con baches,
		-- semáforo en la esquina del cruce y basura junto a las fachadas
		RealKit.utilityLine(m * CFrame.new(0, 0, -21.5), -170, -30, 35)
		for _, patch in { { -150, 6, 7, 5 }, { -108, -8, 9, 6 }, { -76, 10, 6, 4 }, { -40, -5, 8, 5 } } do
			RealKit.roadPatch(m * CFrame.new(patch[1], 0, patch[2]) * CFrame.Angles(0, rad(patch[1] % 40), 0), patch[3], patch[4])
		end
		-- Suelo con variedad: adoquines en el callejón del mercado, barro en las obras y tierra suelta
		Kit.terrainPatch(m * CFrame.new(-95, 0, 76), V(130, 1, 22), M.Pavement)
		Kit.terrainPatch(m * CFrame.new(-62, 0, -88), V(56, 1, 44), M.Mud)
		Kit.terrainPatch(m * CFrame.new(-140, 0, -100) * CFrame.Angles(0, rad(25), 0), V(30, 1, 18), M.Sand)
		Kit.terrainPatch(m * CFrame.new(-30, 0, 100) * CFrame.Angles(0, rad(-15), 0), V(22, 1, 16), M.Sand)
		-- Marcas de quemado (explosiones) y montones de escombros
		for _, scorch in { V(-138, 0, -9), V(-48, 0, 9), V(-92, 0, 66), V(-30, 0, -104), V(-118, 0, -95) } do
			local onRoad = math.abs(scorch.Z) < 18 -- (la avenida está 0,4 por encima del terreno)
			local disc = Kit.cylinder("Scorch", 0.06, 7, m * CFrame.new(scorch + V(0, onRoad and 0.45 or 0.04, 0)), RGB(34, 31, 28), M.Slate, nil, true)
			disc.CastShadow = false
		end
		for i, pile in { V(-150, 0, 96), V(-78, 0, 90), V(-138, 0, -80), V(-92, 0, -102), V(-58, 0, 52) } do
			for j = 1, 4 do
				local size = V(1.4 + (j % 2) * 0.8, 0.6 + (j % 3) * 0.3, 1.2 + ((i + j) % 2) * 0.7)
				deco("RubblePile", size, m * CFrame.new(pile + V((j - 2.5) * 1.1, size.Y / 2, ((i + j) % 3 - 1) * 0.9)) * CFrame.Angles(j * 0.4, i + j, j * 0.25), j % 2 == 0 and PALETTE.Concrete or PALETTE.Plaster[(i % 5) + 1], M.Concrete)
			end
		end
		-- Valla publicitaria en la azotea del bloque de ladrillo del callejón (se ve desde lejos)
		do
			local roof = m * CFrame.new(-90, 18, 124)
			for _, x in { -5, 5 } do
				deco("BillboardLeg", V(0.5, 7, 0.5), roof * CFrame.new(x, 3.5, 2), RGB(60, 60, 62), M.Metal)
			end
			local board = deco("Billboard", V(15, 6, 0.4), roof * CFrame.new(0, 7.5, 2), RGB(230, 225, 210), M.SmoothPlastic)
			board.CastShadow = true
			local adGui = Kit.sign(board, Enum.NormalId.Front, side == "A" and "RADIO 98.5 · LA VOZ DE LA CIUDAD" or "HOTEL CENTRAL ★★★", RGB(170, 40, 34), RGB(170, 40, 34))
			adGui.LightInfluence = 1
			deco("BillboardFrame", V(15.6, 0.4, 0.6), roof * CFrame.new(0, 10.6, 2), RGB(60, 60, 62), M.Metal)
		end
		-- Pintadas y carteles en las paredes que dan a la avenida
		RealKit.graffiti(m * CFrame.new(-156, 2.4, 24.95), side == "A" and "¡RESISTE!" or "NO PASARÁN", RGB(200, 40, 36), 8)
		RealKit.graffiti(m * CFrame.new(-72, 2.4, -24.95) * CFrame.Angles(0, math.pi, 0), "ZONA 4  →", RGB(235, 235, 230), 7)
		for i, p in { V(-140, 3.1, 24.95), V(-138.1, 3, 24.95), V(-100, 3.2, 23.95), V(-148, 3, -24.95), V(-82, 3.1, -24.95) } do
			RealKit.poster(m * CFrame.new(p) * CFrame.Angles(0, p.Z < 0 and math.pi or 0, 0), i)
		end
		RealKit.trafficLight(m * CFrame.new(-14, 0, -19.5))
		RealKit.trafficLight(m * CFrame.new(-14, 0, 19.5) * CFrame.Angles(0, math.pi, 0))
		for _, t in { V(-160, 0, 22), V(-92, 0, 22.2), V(-132, 0, -22.4), V(-86, 0, -22.2) } do
			RealKit.trashPile(m * CFrame.new(t) * CFrame.Angles(0, rad(t.X * 7 % 360), 0))
		end

		------------------------------------------------------------------
		-- Carril norte: callejón del mercado (z 50..125)
		------------------------------------------------------------------
		-- Casa con torre: dos plantas, ventanas que miran a lo largo del callejón
		building(m * CFrame.new(-128, 0, 100) * CFrame.Angles(0, -math.pi / 2, 0), 24, 22, {
			Floors = 2,
			Color = PALETTE.Plaster[3],
			Doors = { Front = { 0 }, Back = { 4 } },
		})
		-- Casa en ruinas en mitad del carril
		building(m * CFrame.new(-36, 0, 84), 22, 20, {
			Floors = 1,
			Color = PALETTE.Plaster[2],
			Ruined = true,
			Doors = { Left = { -2 }, Right = { 2 }, Front = { 4 } },
			Lamp = false,
		})
		burntCar(m * CFrame.new(-92, 0, 66) * CFrame.Angles(0, rad(70), 0), false)
		burntCar(m * CFrame.new(-62, 0, 104) * CFrame.Angles(0, rad(-10), 0), true)
		-- Fila exterior del callejón (cierra el carril: es un pasillo, no un descampado)
		solidBlock(m * CFrame.new(-163, 0, 123) * CFrame.Angles(0, math.pi, 0), 24, 22, 15, PALETTE.Plaster[5])
		solidBlock(m * CFrame.new(-90, 0, 124) * CFrame.Angles(0, math.pi, 0), 28, 20, 18, PALETTE.Brick, { Material = M.Brick })
		solidBlock(m * CFrame.new(-21, 0, 124) * CFrame.Angles(0, math.pi, 0), 22, 20, 12, PALETTE.Plaster[1], { Sign = side == "A" and "MERCADO" or "TALLER" })
		ruinWall(m * CFrame.new(-150, 0, 104) * CFrame.Angles(0, rad(90), 0), 18, 6)
		ruinWall(m * CFrame.new(-78, 0, 84), 14, 7)
		ruinWall(m * CFrame.new(-58, 0, 60) * CFrame.Angles(0, rad(90), 0), 10, 5)
		stall(m * CFrame.new(-112, 0, 64), RGB(120, 140, 70))
		stall(m * CFrame.new(-104, 0, 64), RGB(170, 90, 40))
		sandbags(m * CFrame.new(-100, 0, 82) * CFrame.Angles(0, rad(90), 0), 10)
		sandbags(m * CFrame.new(-12, 0, 62), 9)
		Kit.crate(m * CFrame.new(-60, 0, 76), 4.5)
		Kit.crate(m * CFrame.new(-56, 0, 79), 3.5)
		Kit.crate(m * CFrame.new(-58, 4.5, 77), 3)
		stall(m * CFrame.new(-150, 0, 66) * CFrame.Angles(0, rad(90), 0), RGB(150, 120, 60))
		-- Muro bajo de patio con huecos
		for _, seg in { { -168, -150 }, { -140, -118 } } do
			block("CourtWall", V(seg[2] - seg[1], 4, 1.2), m * CFrame.new((seg[1] + seg[2]) / 2, 2, 54), PALETTE.Plaster[4], M.Plaster)
		end

		------------------------------------------------------------------
		-- Carril sur: obras y trincheras (z -125..-50)
		------------------------------------------------------------------
		-- Estructura de hormigón a medio construir: pilares abajo y forjado arriba con rampa
		local obra = m * CFrame.new(-62, 0, -88)
		for _, x in { -12, 0, 12 } do
			for _, z in { -8, 8 } do
				block("Pillar", V(1.8, FLOOR_H, 1.8), obra * CFrame.new(x, FLOOR_H / 2, z), PALETTE.Concrete, M.Concrete)
			end
		end
		block("ObraSlab", V(28, 1, 20), obra * CFrame.new(0, FLOOR_H - 0.5, 0), PALETTE.Concrete, M.Concrete)
		for _, x in { -13.5, 13.5 } do
			block("ObraParapet", V(1, 3, 20), obra * CFrame.new(x, FLOOR_H + 1.5, 0), PALETTE.Concrete, M.Concrete)
		end
		block("ObraParapet", V(28, 3, 1), obra * CFrame.new(0, FLOOR_H + 1.5, 9.5), PALETTE.Concrete, M.Concrete)
		Kit.ramp(obra * V(-6, 0, -26), obra * V(-6, FLOOR_H, -10.5), 6, RGB(130, 110, 80), M.WoodPlanks)
		for i = 1, 5 do
			deco("Rebar", V(0.2, 3, 0.2), obra * CFrame.new(-12 + i * 5, FLOOR_H + 3, 9.5), PALETTE.Rust, M.Metal)
		end
		-- Andamio decorativo y grúa de obra al fondo
		Kit.crane(m * CFrame.new(-60, 0, -152), 46, RGB(225, 170, 40))
		-- Trincheras de sacos y restos
		sandbags(m * CFrame.new(-120, 0, -70), 12)
		sandbags(m * CFrame.new(-100, 0, -108) * CFrame.Angles(0, rad(90), 0), 10)
		sandbags(m * CFrame.new(-24, 0, -64), 10)
		tankWreck(m * CFrame.new(-30, 0, -104) * CFrame.Angles(0, rad(-20), 0))
		for _, p in { V(-146, 0, -96), V(-140, 0, -58), V(-84, 0, -60) } do
			Kit.barrier(V(8, 3.6, 1.6), m * CFrame.new(p))
		end
		for _, p in { V(-90, 0, -70), V(-88, 0, -73), V(-150, 0, -106) } do
			Kit.barrel(m * CFrame.new(p), PALETTE.Rust)
		end
		Kit.metalCrate(m * CFrame.new(-44, 0, -120), 5, RGB(90, 96, 80))
		-- Fila exterior de las obras: almacén y casas (cierra el carril)
		solidBlock(m * CFrame.new(-166, 0, -124), 24, 20, 14, PALETTE.Plaster[2])
		solidBlock(m * CFrame.new(-120, 0, -126), 22, 16, 10, PALETTE.Concrete, { Material = M.Concrete, Windows = false })
		solidBlock(m * CFrame.new(-8, 0, -126), 16, 16, 16, PALETTE.Plaster[3])
		ruinWall(m * CFrame.new(-138, 0, -88) * CFrame.Angles(0, rad(90), 0), 16, 7)
		ruinWall(m * CFrame.new(-92, 0, -96), 12, 6, PALETTE.Brick)
		ruinWall(m * CFrame.new(-36, 0, -78) * CFrame.Angles(0, rad(90), 0), 10, 6)
		-- Valla de obra (chapa) a lo largo del solar
		for i = 0, 3 do
			block("SiteFence", V(9, 6, 0.4), m * CFrame.new(-88 + i * 10, 3, -58), RGB(120, 128, 110), M.CorrodedMetal)
		end

		------------------------------------------------------------------
		-- Borde del mapa: fila de edificios macizos (horizonte de ciudad)
		------------------------------------------------------------------
		for i, x in { -190, -160, -130, -100, -70, -40, -10 } do
			local h = 18 + (i * 7) % 12
			solidBlock(m * CFrame.new(x + 15, 0, 147) * CFrame.Angles(0, math.pi, 0), 30, 20, h, PALETTE.Plaster[(i % #PALETTE.Plaster) + 1], { Windows = i % 2 == 0 })
		end
		for _, z in { -110, -70, 70, 110 } do
			solidBlock(m * CFrame.new(-222, 0, z) * CFrame.Angles(0, math.pi / 2, 0), 40, 16, 22, PALETTE.Plaster[3])
		end

		-- Base: el muro de detrás de la zona de salida
		block("BaseWall", V(2, 14, 90), m * CFrame.new(-206, 7, 0), PALETTE.Concrete, M.Concrete)
		for _, z in { -30, 30 } do
			Kit.banner(m * CFrame.new(-204.8, 9, z) * CFrame.Angles(0, rad(90), 0), 5, 9, teamColor, RGB(240, 240, 240))
		end
	end)

	-- Zonas de salida, banderas y límites
	local spawnStyle = { Floor = RGB(120, 116, 110), FloorMaterial = M.Concrete, Roof = RGB(100, 96, 90), RoofMaterial = M.CorrodedMetal }
	Kit.spawnArea(teams[1], CFrame.new(-190, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-190, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-162, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-162, 0, 0))
	Kit.bounds(LENGTH, WIDTH, 70)

	-- Polvo en el aire y humo a lo lejos (ciudad en guerra)
	Kit.dustMotes(CFrame.new(0, 8, 0), V(360, 14, 220), RGB(230, 205, 165), 35)
	for _, p in { V(-90, 0, 230), V(140, 0, -240), V(260, 0, 120), V(-280, 0, -90) } do
		local plume = deco("SmokePlume", V(4, 4, 4), CFrame.new(p + V(0, 30, 0)), RGB(60, 58, 55), M.Concrete)
		plume.Transparency = 1
		local smoke = Instance.new("ParticleEmitter")
		smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
		smoke.Color = ColorSequence.new(RGB(80, 74, 68), RGB(40, 38, 36))
		smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 14), NumberSequenceKeypoint.new(1, 50) })
		smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
		smoke.Lifetime = NumberRange.new(12, 18)
		smoke.Speed = NumberRange.new(6, 10)
		smoke.SpreadAngle = Vector2.new(10, 10)
		smoke.Rate = 2
		smoke.WindAffectsDrag = true
		smoke.Drag = 0.2
		smoke.EmissionDirection = Enum.NormalId.Top
		smoke.Parent = plume
	end
	-- Horizonte de ciudad fuera del límite: bloques altos (algunos medio derruidos) que hacen que la
	-- ciudad parezca seguir; la neblina los difumina. Sin colisión (nadie llega hasta ahí).
	local skyline = {}
	for x = -240, 240, 36 do
		table.insert(skyline, V(x, 0, 176 + (x % 3) * 9))
		table.insert(skyline, V(x + 14, 0, -178 - (x % 4) * 7))
	end
	for z = -110, 110, 44 do
		table.insert(skyline, V(258 + (z % 3) * 8, 0, z))
		table.insert(skyline, V(-262 - (z % 2) * 10, 0, z + 18))
	end
	for i, p in skyline do
		local w, d = 16 + (i * 7) % 14, 14 + (i * 5) % 10
		local h = 26 + (i * 13) % 46
		local color = PALETTE.Plaster[(i % 5) + 1]:Lerp(RGB(90, 82, 74), 0.35)
		deco("SkylineBlock", V(w, h, d), CFrame.new(p + V(0, h / 2, 0)), color, M.Concrete)
		-- Bandas oscuras de ventanas (sugieren las plantas desde lejos)
		for f = 1, math.floor(h / 9) do
			deco("SkylineWindows", V(w + 0.2, 1.6, d + 0.2), CFrame.new(p + V(0, f * 9 - 3.5, 0)), RGB(46, 44, 42), M.Concrete)
		end
		if i % 3 == 0 then
			-- Derruido: le falta una esquina de arriba y quedan vigas sueltas
			deco("SkylineRuin", V(w * 0.55, h * 0.25, d * 0.6), CFrame.new(p + V(w * 0.22, h + h * 0.125, d * 0.2)), color, M.Concrete)
			deco("SkylineBeam", V(0.6, 6, 0.6), CFrame.new(p + V(-w * 0.3, h + 3, 0)) * CFrame.Angles(0, 0, 0.3), RGB(70, 60, 52), M.CorrodedMetal)
		else
			deco("SkylineTank", V(4, 3, 4), CFrame.new(p + V(w * 0.2, h + 1.5, -d * 0.15)), RGB(80, 80, 82), M.Metal)
		end
	end

	-- Colinas secas lejos (fuera del límite)
	for _, spec in { { V(-320, 0, 260), 90 }, { V(340, 0, -250), 100 }, { V(0, 0, -330), 80 }, { V(60, 0, 340), 90 } } do
		Kit.naturalHill(spec[1], spec[2], M.Sand)
	end

	-- Puntos de salida libres (todos contra todos, eliminación...), por todo el mapa
	for _, p in {
		V(-150, 0.5, 8), V(-120, 0.5, -10), V(-80, 0.5, 12), V(-40, 0.5, -6),
		V(-150, 0.5, 80), V(-120, 0.5, 74), V(-60, 0.5, 100), V(-20, 0.5, 112),
		V(-150, 0.5, -80), V(-110, 0.5, -95), V(-62, 0.5, -112), V(-18, 0.5, -80),
		V(-110, FLOOR_H + 0.5, 30), V(-114, FLOOR_H + 0.5, -40),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	-- Puestos de los tiradores (ventanas que dan a la avenida, la torre del callejón y las obras)
	for _, spot in {
		{ V(-110, FLOOR_H, 26.7), V(-110, 4, -20) }, -- hotel, ventanas a la avenida
		{ V(-100, FLOOR_H, 26.7), V(-100, 4, -20) },
		{ V(-114, FLOOR_H, -26.7), V(-114, 4, 20) }, -- oficinas, ventana a la avenida
		{ V(-119.7, FLOOR_H, 108), V(-20, 4, 108) }, -- casa con torre, ventana al callejón
		{ V(-58, FLOOR_H, -86), V(0, 4, -90) }, -- forjado de las obras
	} do
		Kit.botSpot(spot[1], spot[2])
		Kit.botSpot(Kit.MIRROR * spot[1], Kit.MIRROR * spot[2])
	end
	-- Buscar y destruir: cada equipo defiende dos sitios en su mitad (A y B)
	for _, site in { { V(-96, 0, 100), "A" }, { V(-124, 0, -92), "B" } } do
		Kit.bombSite(site[1], site[2], 1)
		Kit.bombSite(Kit.MIRROR * site[1], site[2], 2)
	end
	-- Zonas de control: el monumento, la mitad de cada carril y los dos lados del cruce
	Kit.zone(V(0, 0, 0), 14, 1)
	Kit.zone(V(-36, 0, 84), 11, 2)
	Kit.zone(V(36, 0, -84), 11, 3)
	Kit.zone(V(0, 0, 34), 10, 4)
	Kit.zone(V(0, 0, -34), 10, 5)

	-- Detalles de suelo: grietas, manchas y alcantarillas
	Kit.symmetric(function(m)
		for i, spec in { { V(-120, 0, 4), 9 }, { V(-60, 0, -6), 11 }, { V(-90, 0, 80), 8 }, { V(-40, 0, -90), 10 } } do
			Kit.crack(m * spec[1], spec[2], i * 13)
		end
		for _, p in { V(-130, 0, -6), V(-30, 0, 4), V(-104, 0, 92) } do
			Kit.oilStain(m * p, 3)
		end
		for _, p in { V(-80, 0, 0), V(-140, 0, 10) } do
			Kit.manhole(m * p)
		end
	end)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">Downtown</string>
              <string name="Source"><![CDATA[-- Mapa "Downtown": ciudad simétrica con calles, tiendas, contenedores y plaza central (de día).
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)
local Variants = require(script.Parent.Parent.LightingVariants)

local Map = {
	Id = "Downtown",
	Bomb = true, -- tiene sitios para Buscar y destruir
	Name = "Downtown",
	Icon = "🏙",
	Description = "Ciudad · día · calles y azoteas",
}

local LENGTH = 320 -- eje X (de spawn a spawn)
local WIDTH = 220 -- eje Z
local WALL_HEIGHT = 34

local mapFolder

-- Paleta del mapa (colores pastel y vivos, estilo cartoon)
local C = {
	Asphalt = Color3.fromRGB(70, 74, 86),
	Sidewalk = Color3.fromRGB(214, 214, 222),
	Curb = Color3.fromRGB(240, 240, 245),
	LineWhite = Color3.fromRGB(245, 245, 250),
	LineYellow = Color3.fromRGB(255, 205, 50),
	WallBlue = Color3.fromRGB(150, 98, 78), -- ladrillo (el nombre se mantiene por compatibilidad)
	WallTrim = Color3.fromRGB(240, 244, 250),
	Window = Color3.fromRGB(70, 96, 118), -- cristal oscuro que refleja
	Metal = Color3.fromRGB(60, 62, 70),
	Ramp = Color3.fromRGB(150, 152, 165),
	Pink = Color3.fromRGB(255, 80, 170),
	Cyan = Color3.fromRGB(0, 220, 255),
	Leaf = Color3.fromRGB(90, 190, 90),
	LeafDark = Color3.fromRGB(60, 150, 70),
	Wood = Color3.fromRGB(176, 124, 70),
	WoodDark = Color3.fromRGB(120, 80, 45),
}

local function block(name, size, cf, color, material, parent)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = Kit.realisticMaterial(size, color, material)
	if part.Material == Enum.Material.Glass then
		part.Reflectance = 0.15
	end
	Kit.applyStyle(part)
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent or mapFolder
	return part
end

-- Pieza decorativa: no choca, no bloquea disparos y no hace sombra
local function deco(name, size, cf, color, material, parent)
	local part = block(name, size, cf, color, material, parent)
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = size.X * size.Y * size.Z >= 20 and part.Material ~= Enum.Material.Neon and part.Material ~= Enum.Material.Glass
	return part
end

-- Cilindro de pie (en Roblox el eje del cilindro es X, lo giramos para que sea vertical)
local function cylinder(name, height, diameter, cf, color, material, parent, decorative)
	local fn = decorative and deco or block
	local part = fn(
		name,
		Vector3.new(height, diameter, diameter),
		cf * CFrame.Angles(0, 0, math.pi / 2),
		color,
		material,
		parent
	)
	part.Shape = Enum.PartType.Cylinder
	return part
end

-- Texto pegado a una cara de una pieza (carteles, rótulos de neón...)
local function sign(part, face, text, color, strokeColor)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeColor3 = strokeColor or Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0
	label.Parent = gui
	return gui
end

-- Rampa inclinada desde "bottom" hasta "top" (posiciones de la superficie)
local function ramp(bottom, top, width, color)
	local mid = (bottom + top) / 2
	local length = (top - bottom).Magnitude
	local cf = CFrame.lookAt(mid, top) * CFrame.new(0, -0.5, 0)
	local part = block("Ramp", Vector3.new(width, 1, length + 1), cf, color, Enum.Material.DiamondPlate)
	-- Franjas amarillas de los bordes
	for _, side in { -1, 1 } do
		deco(
			"RampEdge",
			Vector3.new(0.4, 0.1, length + 1),
			cf * CFrame.new(side * (width / 2 - 0.3), 0.52, 0),
			C.LineYellow,
			Enum.Material.SmoothPlastic
		)
	end
	return part
end

-- Rotación de 180° alrededor del centro: la mitad del equipo Azul es espejo de la del Rojo
local MIRROR = CFrame.Angles(0, math.pi, 0)

local function symmetric(fn)
	fn(CFrame.new(), "A")
	fn(MIRROR, "B")
end

---------------------------------------------------------------------------
-- Piezas del mapa
---------------------------------------------------------------------------

local CARGO_NAMES = { "HYPER CARGO", "NEXO LINE", "FROST CO.", "TURBO SHIP" }
local cargoIndex = 0

local function container(cf, color)
	local model = Instance.new("Model")
	model.Name = "Container"
	model.Parent = mapFolder
	local size = Vector3.new(20, 8.5, 8)
	local body = block("Body", size, cf * CFrame.new(0, size.Y / 2, 0), color, Enum.Material.CorrodedMetal, model)
	Kit.contactShadow(cf, size.X, size.Z, false, model)
	local dark = color:Lerp(Color3.new(0, 0, 0), 0.35)
	for i = -4, 4, 2 do
		deco("Rib", Vector3.new(0.4, 8.2, 8.3), cf * CFrame.new(i * 2.2, 4.25, 0), dark, Enum.Material.Metal, model)
	end
	block("Roof", Vector3.new(20.2, 0.3, 8.2), cf * CFrame.new(0, 8.6, 0), dark, Enum.Material.Metal, model)
	-- Marco y puertas en un extremo
	deco("DoorFrame", Vector3.new(0.3, 8.6, 8.4), cf * CFrame.new(10.1, 4.25, 0), dark, Enum.Material.Metal, model)
	for _, z in { -2, 2 } do
		deco("LockBar", Vector3.new(0.3, 7.6, 0.25), cf * CFrame.new(10.3, 4.25, z), Color3.fromRGB(200, 200, 205), Enum.Material.Metal, model)
	end
	deco("DoorSplit", Vector3.new(0.35, 8, 0.15), cf * CFrame.new(10.3, 4.25, 0), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, model)
	-- Desgaste: chorretones de óxido bajando desde el techo
	local rust = color:Lerp(Color3.fromRGB(105, 58, 34), 0.6)
	for i, x in { -7.7, 3.3, 5.5 } do
		local side = i % 2 == 0 and 1 or -1
		local length = 2 + ((cargoIndex + i) % 3) * 1.4
		deco("RustStreak", Vector3.new(0.9, length, 0.06), cf * CFrame.new(x, 8.45 - length / 2, side * 4.04), rust, Enum.Material.CorrodedMetal, model)
	end
	-- Rótulo de la naviera en los dos lados largos
	cargoIndex = cargoIndex % #CARGO_NAMES + 1
	local text = CARGO_NAMES[cargoIndex]
	sign(body, Enum.NormalId.Front, text, Color3.new(1, 1, 1), dark)
	sign(body, Enum.NormalId.Back, text, Color3.new(1, 1, 1), dark)
	return model
end

local function crate(cf, size)
	size = size or 4
	local core = block(
		"Crate",
		Vector3.new(size, size, size),
		cf * CFrame.new(0, size / 2, 0),
		C.Wood,
		Enum.Material.WoodPlanks
	)
	Kit.contactShadow(cf, size, size)
	-- Bandas de refuerzo
	for _, y in { 0.12, 0.88 } do
		deco(
			"CrateBand",
			Vector3.new(size + 0.15, size * 0.12, size + 0.15),
			cf * CFrame.new(0, size * y, 0),
			C.WoodDark,
			Enum.Material.Wood
		)
	end
	return core
end

-- Barrera tipo "jersey" de hormigón con franjas rojas y blancas
local function barrier(size, cf)
	local part = block("Barrier", size, cf * CFrame.new(0, size.Y / 2, 0), Color3.fromRGB(225, 225, 230), Enum.Material.Concrete)
	Kit.contactShadow(cf, size.X, size.Z)
	local long = size.X >= size.Z
	local length = long and size.X or size.Z
	local count = math.max(2, math.floor(length / 3))
	for i = 0, count - 1 do
		local offset = -length / 2 + (i + 0.5) * (length / count)
		local color = i % 2 == 0 and Color3.fromRGB(230, 50, 50) or Color3.fromRGB(250, 250, 250)
		local stripeSize = long and Vector3.new(length / count, 1, size.Z + 0.1) or Vector3.new(size.X + 0.1, 1, length / count)
		local pos = long and CFrame.new(offset, size.Y - 1.2, 0) or CFrame.new(0, size.Y - 1.2, offset)
		deco("Stripe", stripeSize, cf * pos, color, Enum.Material.SmoothPlastic)
	end
	return part
end

local function streetLamp(cf)
	local model = Instance.new("Model")
	model.Name = "StreetLamp"
	model.Parent = mapFolder
	cylinder("Pole", 14, 0.6, cf * CFrame.new(0, 7, 0), C.Metal, Enum.Material.Metal, model)
	cylinder("Base", 1, 1.2, cf * CFrame.new(0, 0.5, 0), C.Metal, Enum.Material.Metal, model)
	deco("Arm", Vector3.new(0.4, 0.4, 4), cf * CFrame.new(0, 13.8, -1.8), C.Metal, Enum.Material.Metal, model)
	local head = deco("Lamp", Vector3.new(1.6, 0.5, 2.2), cf * CFrame.new(0, 13.4, -3.6), C.Metal, Enum.Material.Metal, model)
	local bulb = deco("Bulb", Vector3.new(1.2, 0.2, 1.8), cf * CFrame.new(0, 13.1, -3.6), Color3.fromRGB(255, 240, 200), Enum.Material.Neon, model)
	local light = Instance.new("SpotLight")
	light.Face = Enum.NormalId.Bottom
	light.Range = 26
	light.Angle = 100
	light.Brightness = 1.5
	light.Color = Color3.fromRGB(255, 235, 200)
	light.Shadows = true
	light:SetAttribute("QualityShadow", true)
	light.Parent = bulb
	return head
end

local function tree(cf)
	local model = Instance.new("Model")
	model.Name = "Tree"
	model.Parent = mapFolder
	block("Planter", Vector3.new(5, 1.6, 5), cf * CFrame.new(0, 0.8, 0), Color3.fromRGB(200, 200, 208), Enum.Material.Concrete, model)
	deco("Soil", Vector3.new(4.4, 0.2, 4.4), cf * CFrame.new(0, 1.65, 0), Color3.fromRGB(90, 60, 40), Enum.Material.Ground, model)
	cylinder("Trunk", 7, 0.9, cf * CFrame.new(0, 5, 0), Color3.fromRGB(110, 75, 45), Enum.Material.Wood, model)
	for i, spec in {
		{ Vector3.new(0, 9.5, 0), 6.5, C.Leaf },
		{ Vector3.new(1.6, 8.4, 1), 4.5, C.LeafDark },
		{ Vector3.new(-1.5, 8.8, -1.2), 4.8, C.Leaf },
		{ Vector3.new(0.3, 11.6, -0.4), 4, C.LeafDark },
	} do
		local leaf = deco("Leaves" .. i, Vector3.new(spec[2], spec[2], spec[2]), cf * CFrame.new(spec[1]), spec[3], Enum.Material.Grass, model)
		leaf.Shape = Enum.PartType.Ball
		leaf.CastShadow = true
	end
end

local function bollard(cf)
	cylinder("Bollard", 2.4, 0.8, cf * CFrame.new(0, 1.2, 0), C.LineYellow, Enum.Material.SmoothPlastic)
	cylinder("BollardBand", 0.4, 0.85, cf * CFrame.new(0, 1.9, 0), Color3.fromRGB(30, 30, 30), Enum.Material.SmoothPlastic, nil, true)
end

local SHOP_SIGNS = {
	{ "ARCADE", Color3.fromRGB(255, 80, 200) },
	{ "PIZZA", Color3.fromRGB(255, 170, 30) },
	{ "GYM", Color3.fromRGB(0, 220, 255) },
	{ "TACOS", Color3.fromRGB(120, 255, 90) },
}
local signIndex = 0

local brickToggle = false

local function building(cf, size, color)
	local model = Instance.new("Model")
	model.Name = "Building"
	model.Parent = mapFolder
	local trim = color:Lerp(Color3.new(0, 0, 0), 0.15)
	-- La mitad de los edificios son de ladrillo visto (más realista que todo hormigón)
	brickToggle = not brickToggle
	local wallMaterial = brickToggle and Enum.Material.Brick or Enum.Material.Concrete
	block("Block", size, cf * CFrame.new(0, size.Y / 2, 0), color, wallMaterial, model)
	-- Zócalo y cornisa
	deco("Base", Vector3.new(size.X + 0.4, 1.2, size.Z + 0.4), cf * CFrame.new(0, 0.6, 0), trim, Enum.Material.Concrete, model)
	deco("Cornice", Vector3.new(size.X + 0.6, 0.8, size.Z + 0.6), cf * CFrame.new(0, size.Y - 0.4, 0), C.WallTrim, Enum.Material.Concrete, model)
	deco("Stripe", Vector3.new(size.X + 0.3, 0.6, size.Z + 0.3), cf * CFrame.new(0, size.Y - 1.6, 0), C.WallTrim:Lerp(Color3.new(0, 0, 0), 0.2), Enum.Material.Concrete, model)

	-- Ventanas en las cuatro fachadas: una fila por planta, con marco y alféizar
	local floors = math.max(1, math.floor((size.Y - 3) / 7))
	local function windowsOnFace(axis, sign_, count, span, skip)
		for row = 1, floors do
			local y = 4.2 + (row - 1) * 7
			for i = 1, count do
				if i == skip and row == 1 then
					continue
				end
				local t = (i - 0.5) / count - 0.5
				local pos, glassSize, frameSize, sillSize, sillOffset
				if axis == "Z" then
					pos = CFrame.new(t * span, y, sign_ * (size.Z / 2 + 0.1))
					glassSize = Vector3.new(2.6, 3.6, 0.2)
					frameSize = Vector3.new(3.2, 4.2, 0.15)
					sillSize = Vector3.new(3.6, 0.3, 0.6)
					sillOffset = CFrame.new(0, -2.2, sign_ * 0.25)
				else
					pos = CFrame.new(sign_ * (size.X / 2 + 0.1), y, t * span)
					glassSize = Vector3.new(0.2, 3.6, 2.6)
					frameSize = Vector3.new(0.15, 4.2, 3.2)
					sillSize = Vector3.new(0.6, 0.3, 3.6)
					sillOffset = CFrame.new(sign_ * 0.25, -2.2, 0)
				end
				deco("WindowFrame", frameSize, cf * pos, C.WallTrim, Enum.Material.Concrete, model)
				deco("WindowSill", sillSize, cf * pos * sillOffset, C.WallTrim, Enum.Material.Concrete, model)
				local glass = deco("Window", glassSize, cf * pos, C.Window, Enum.Material.Glass, model)
				glass.Transparency = 0 -- opaco: delante de la pared no se nota y no cuesta ordenar transparencias
				glass.Reflectance = 0.25
			end
		end
	end
	windowsOnFace("Z", -1, 4, size.X - 6, 1) -- sin la primera: ahí va la puerta
	windowsOnFace("Z", 1, 4, size.X - 6)
	windowsOnFace("X", -1, 3, size.Z - 6)
	windowsOnFace("X", 1, 3, size.Z - 6)

	-- Puerta y toldo en la fachada que mira al centro del mapa (-Z)
	local front = -size.Z / 2
	local doorX = -0.375 * (size.X - 6)
	deco("Door", Vector3.new(4, 6.5, 0.3), cf * CFrame.new(doorX, 3.25, front - 0.1), Color3.fromRGB(50, 55, 70), Enum.Material.SmoothPlastic, model)
	signIndex = signIndex % #SHOP_SIGNS + 1
	local shop = SHOP_SIGNS[signIndex]
	for i = 0, 4 do
		deco(
			"Awning",
			Vector3.new(1.2, 0.3, 3),
			cf * CFrame.new(doorX - 2.4 + i * 1.2, 7.6, front - 1.5) * CFrame.Angles(math.rad(-15), 0, 0),
			i % 2 == 0 and shop[2] or Color3.new(1, 1, 1),
			Enum.Material.Fabric,
			model
		)
	end
	-- Rótulo de neón
	local signPart = deco("ShopSign", Vector3.new(10, 2.6, 0.4), cf * CFrame.new(size.X / 5, size.Y - 2.5, front - 0.3), Color3.fromRGB(25, 25, 35), Enum.Material.SmoothPlastic, model)
	sign(signPart, Enum.NormalId.Front, shop[1], shop[2], Color3.fromRGB(255, 255, 255))
	local glow = Instance.new("SurfaceLight")
	glow.Face = Enum.NormalId.Front
	glow.Color = shop[2]
	glow.Range = 10
	glow.Brightness = 1.5
	glow.Parent = signPart

	-- Murito de cobertura en la azotea (sólido)
	local h = 3
	local top = size.Y
	block("Rail", Vector3.new(size.X, h, 1), cf * CFrame.new(0, top + h / 2, -size.Z / 2 + 0.5), color, Enum.Material.Concrete, model)
	block("Rail", Vector3.new(size.X, h, 1), cf * CFrame.new(0, top + h / 2, size.Z / 2 - 0.5), color, Enum.Material.Concrete, model)

	-- Aires acondicionados y antena en la azotea
	for _, x in { -size.X / 4, -size.X / 4 + 4.5 } do
		block("ACUnit", Vector3.new(3.5, 2.4, 3), cf * CFrame.new(x, top + 1.2, 4), Color3.fromRGB(200, 205, 210), Enum.Material.Metal, model)
		local fan = cylinder("Fan", 0.2, 2.2, cf * CFrame.new(x, top + 2.45, 4), Color3.fromRGB(70, 70, 75), Enum.Material.Metal, model, true)
		fan:SetAttribute("Spin", 360)
	end
	cylinder("Antenna", 7, 0.25, cf * CFrame.new(size.X / 2 - 3, top + 3.5, size.Z / 2 - 3), C.Metal, Enum.Material.Metal, model, true)
	local beacon = deco("Beacon", Vector3.new(0.6, 0.6, 0.6), cf * CFrame.new(size.X / 2 - 3, top + 7.2, size.Z / 2 - 3), Color3.fromRGB(255, 40, 40), Enum.Material.Neon, model)
	beacon.Shape = Enum.PartType.Ball
	return model
end

local function spawnArea(team, cf)
	local teamColor = team.Color.Color
	local light = teamColor:Lerp(Color3.new(1, 1, 1), 0.55)
	local floor = block("SpawnFloor", Vector3.new(30, 0.4, 70), cf * CFrame.new(0, 0.2, 0), light, Enum.Material.SmoothPlastic)
	floor.Name = team.Name .. "SpawnFloor"
	-- Rejilla del suelo
	for z = -30, 30, 10 do
		deco("FloorLine", Vector3.new(30, 0.05, 0.3), cf * CFrame.new(0, 0.42, z), teamColor, Enum.Material.SmoothPlastic)
	end

	local roof = block("Roof", Vector3.new(30, 1, 70), cf * CFrame.new(0, 16, 0), Color3.fromRGB(235, 235, 240), Enum.Material.Concrete)
	deco("RoofTrim", Vector3.new(0.6, 0.5, 70.2), cf * CFrame.new(15, 15.4, 0), teamColor, Enum.Material.Neon)
	-- Cartel del equipo encima de la entrada
	local banner = block("TeamBanner", Vector3.new(0.6, 4, 28), cf * CFrame.new(15.2, 18.6, 0), teamColor, Enum.Material.SmoothPlastic)
	sign(banner, Enum.NormalId.Right, "EQUIPO " .. string.upper(team.Name), Color3.new(1, 1, 1))
	sign(banner, Enum.NormalId.Left, "EQUIPO " .. string.upper(team.Name), Color3.new(1, 1, 1))
	roof.Name = team.Name .. "SpawnRoof"
	roof.CanCollide = false -- (no se puede pisar: nadie acampa encima de la base enemiga)

	for _, z in { -34, 34 } do
		block("Pillar", Vector3.new(2, 16, 2), cf * CFrame.new(14, 8, z), Color3.fromRGB(235, 235, 240), Enum.Material.Concrete)
		deco("PillarStripe", Vector3.new(2.1, 1, 2.1), cf * CFrame.new(14, 12, z), teamColor, Enum.Material.Neon)
	end
	for _, z in { -24, 0, 24 } do
		block("Cover", Vector3.new(2, 4, 10), cf * CFrame.new(14, 2, z), teamColor, Enum.Material.SmoothPlastic)
		deco("CoverTop", Vector3.new(2.1, 0.3, 10.1), cf * CFrame.new(14, 4.05, z), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
	end

	for i, z in { -24, -8, 8, 24 } do
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = team.Name .. "Spawn" .. i
		spawn.Anchored = true
		spawn.Size = Vector3.new(6, 1, 6)
		spawn.CFrame = cf * CFrame.new(-4, 0.5, z) * CFrame.Angles(0, -math.pi / 2, 0)
		spawn.TeamColor = team.Color
		spawn.BrickColor = team.Color
		spawn.Material = Enum.Material.Neon
		spawn.Neutral = false
		spawn.AllowTeamChangeOnTouch = false
		spawn.Duration = GameConfig.SpawnProtection
		spawn.Parent = mapFolder
		local decal = spawn:FindFirstChildOfClass("Decal")
		if decal then
			decal:Destroy()
		end
	end

	-- Luz de equipo bajo el techo
	local lamp = deco("SpawnLight", Vector3.new(20, 0.2, 60), cf * CFrame.new(0, 15.4, 0), teamColor:Lerp(Color3.new(1, 1, 1), 0.7), Enum.Material.Neon)
	local surfaceLight = Instance.new("SurfaceLight")
	surfaceLight.Face = Enum.NormalId.Bottom
	surfaceLight.Range = 16
	surfaceLight.Brightness = 0.8
	surfaceLight.Color = teamColor:Lerp(Color3.new(1, 1, 1), 0.5)
	surfaceLight.Parent = lamp
end

-- Base de la bandera: el módulo Flags busca piezas "FlagBase" con el atributo Team.
-- En un mapa propio basta con poner una pieza llamada FlagBase con Team = "Rojo" / "Azul".
local function flagBase(team, cf)
	local teamColor = team.Color.Color
	local ring = deco("FlagBaseRing", Vector3.new(0.3, 13, 13), cf * CFrame.new(0, 0.15, 0) * CFrame.Angles(0, 0, math.pi / 2), teamColor, Enum.Material.Neon)
	ring.Shape = Enum.PartType.Cylinder
	local pad = block("FlagBase", Vector3.new(0.4, 11, 11), cf * CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(235, 235, 240), Enum.Material.Concrete)
	pad.Shape = Enum.PartType.Cylinder
	pad:SetAttribute("Team", team.Name)
	local inner = deco("FlagBaseInner", Vector3.new(0.45, 4, 4), cf * CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.pi / 2), teamColor, Enum.Material.Neon)
	inner.Shape = Enum.PartType.Cylinder
	-- Pilones luminosos alrededor
	for i = 0, 3 do
		local angle = i * math.pi / 2 + math.pi / 4
		local offset = CFrame.new(math.cos(angle) * 7.5, 0, math.sin(angle) * 7.5)
		cylinder("Pylon", 2, 0.7, cf * offset * CFrame.new(0, 1, 0), Color3.fromRGB(230, 230, 235), Enum.Material.SmoothPlastic, nil, true)
		local top = deco("PylonLight", Vector3.new(0.8, 0.8, 0.8), cf * offset * CFrame.new(0, 2.3, 0), teamColor, Enum.Material.Neon)
		top.Shape = Enum.PartType.Ball
	end
	local glow = Instance.new("PointLight")
	glow.Color = teamColor
	glow.Range = 16
	glow.Brightness = 1.5
	glow.Parent = inner
	return pad
end

-- Fachada con ventanas sobre la cara interior de un muro exterior.
-- `inward` = signo (+1/-1) de la dirección hacia el centro del mapa.
local function facade(center, length, alongX, inward)
	local rows = { 13, 22 }
	for _, y in rows do
		for t = -length / 2 + 8, length / 2 - 8, 12 do
			local pos = alongX and Vector3.new(t, y, center.Z + inward * 0.3) or Vector3.new(center.X + inward * 0.3, y, t)
			local frameSize = alongX and Vector3.new(5, 5, 0.3) or Vector3.new(0.3, 5, 5)
			local glassSize = alongX and Vector3.new(4.2, 4.2, 0.35) or Vector3.new(0.35, 4.2, 4.2)
			deco("FacadeFrame", frameSize, CFrame.new(pos), C.WallTrim, Enum.Material.Concrete)
			local glass = deco("FacadeWindow", glassSize, CFrame.new(pos), C.Window, Enum.Material.Glass)
			glass.Transparency = 0
			glass.Reflectance = 0.25
		end
	end
	-- Cornisa y franja inferior
	local trimSize = alongX and Vector3.new(length, 1.2, 1.2) or Vector3.new(1.2, 1.2, length)
	deco("WallCornice", trimSize, CFrame.new(center + Vector3.new(0, WALL_HEIGHT / 2 + 0.3, 0)), C.WallTrim, Enum.Material.Concrete)
	local baseSize = alongX and Vector3.new(length, 3, 0.6) or Vector3.new(0.6, 3, length)
	local basePos = alongX and Vector3.new(center.X, 1.5, center.Z + inward * 0.3) or Vector3.new(center.X + inward * 0.3, 1.5, center.Z)
	deco("WallBase", baseSize, CFrame.new(basePos), Color3.fromRGB(110, 108, 104), Enum.Material.Concrete)
end

---------------------------------------------------------------------------

Map.Lighting = {
	CartoonNeutral = { Hue = 0.6, Sat = 0.17 }, -- tono de los grises en estilo Cartoon
	ClockTime = 16.4,
	Brightness = 3,
	Exposure = 0,
	Ambient = Color3.fromRGB(60, 62, 72),
	OutdoorAmbient = Color3.fromRGB(125, 128, 140),
	Atmosphere = { Density = 0.3, Offset = 0.2, Color = Color3.fromRGB(200, 215, 235), Decay = Color3.fromRGB(110, 130, 160), Glare = 0.4, Haze = 1.6 },
	Color = { Saturation = 0.1, Contrast = 0.16, Brightness = 0, Tint = Color3.fromRGB(255, 246, 235) },
	Bloom = { Intensity = 0.7, Size = 24, Threshold = 1.6 },
	SunRays = 0.08,
}
-- A veces sale con otra luz o con mal tiempo (ver LightingVariants)
Map.LightingVariants = { Variants.Storm(0.25), Variants.Fog(0.15) }

function Map.Build()
	mapFolder = Kit.Begin(Map.Name)
	mapFolder:SetAttribute("Ambience", "Breeze") -- (sonido ambiente: ver Ambience en el cliente)
	Kit.applyLighting(Kit.pickLighting(Map))
	mapFolder:SetAttribute("Variant", Kit.Variant)
	mapFolder:SetAttribute("Weather", Kit.Weather)

	-- Suelo: asfalto, aceras y plaza central
	block("Floor", Vector3.new(LENGTH + 40, 2, WIDTH + 40), CFrame.new(0, -1, 0), C.Asphalt, Enum.Material.Asphalt)
	for _, side in { -1, 1 } do
		block("Sidewalk", Vector3.new(LENGTH, 0.4, 16), CFrame.new(0, 0.2, side * (WIDTH / 2 - 8)), C.Sidewalk, Enum.Material.Pavement)
		deco("Curb", Vector3.new(LENGTH, 0.45, 0.8), CFrame.new(0, 0.22, side * (WIDTH / 2 - 16.4)), C.Curb, Enum.Material.Concrete)
		-- Línea discontinua del carril
		for x = -125, 125, 10 do
			deco("LaneDash", Vector3.new(5, 0.05, 0.6), CFrame.new(x, 0.03, side * 50), C.LineWhite, Enum.Material.SmoothPlastic)
		end
		-- Pasos de cebra
		for _, x in { -40, 40 } do
			for i = 0, 6 do
				deco("Zebra", Vector3.new(8, 0.05, 1.4), CFrame.new(x, 0.035, side * (40 + i * 3)), C.LineWhite, Enum.Material.SmoothPlastic)
			end
		end
		-- Línea amarilla de borde
		deco("EdgeLine", Vector3.new(LENGTH - 60, 0.05, 0.5), CFrame.new(0, 0.03, side * (WIDTH / 2 - 19)), C.LineYellow, Enum.Material.SmoothPlastic)
	end
	-- Plaza central con baldosas de colores
	local tileColors = { Color3.fromRGB(235, 230, 220), Color3.fromRGB(255, 190, 200) }
	for ix = -5, 4 do
		for iz = -5, 4 do
			deco(
				"PlazaTile",
				Vector3.new(5.9, 0.06, 5.9),
				CFrame.new(ix * 6 + 3, 0.03, iz * 6 + 3),
				tileColors[(ix + iz) % 2 + 1],
				Enum.Material.Pavement
			)
		end
	end

	-- Muros exteriores con fachadas
	block("Wall", Vector3.new(LENGTH, WALL_HEIGHT, 4), CFrame.new(0, WALL_HEIGHT / 2, WIDTH / 2 + 2), C.WallBlue, Enum.Material.Brick)
	block("Wall", Vector3.new(LENGTH, WALL_HEIGHT, 4), CFrame.new(0, WALL_HEIGHT / 2, -WIDTH / 2 - 2), C.WallBlue, Enum.Material.Brick)
	block("Wall", Vector3.new(4, WALL_HEIGHT, WIDTH), CFrame.new(LENGTH / 2 + 2, WALL_HEIGHT / 2, 0), C.WallBlue, Enum.Material.Brick)
	block("Wall", Vector3.new(4, WALL_HEIGHT, WIDTH), CFrame.new(-LENGTH / 2 - 2, WALL_HEIGHT / 2, 0), C.WallBlue, Enum.Material.Brick)
	facade(Vector3.new(0, WALL_HEIGHT / 2, WIDTH / 2), LENGTH, true, -1)
	facade(Vector3.new(0, WALL_HEIGHT / 2, -WIDTH / 2), LENGTH, true, 1)
	facade(Vector3.new(LENGTH / 2, WALL_HEIGHT / 2, 0), WIDTH, false, -1)
	facade(Vector3.new(-LENGTH / 2, WALL_HEIGHT / 2, 0), WIDTH, false, 1)

	-- Techo invisible para que nadie salga del mapa
	local ceiling = block("Ceiling", Vector3.new(LENGTH, 1, WIDTH), CFrame.new(0, WALL_HEIGHT + 12, 0), Color3.new(1, 1, 1))
	ceiling.Transparency = 1
	ceiling.CastShadow = false
	-- Los disparos ignoran la carpeta Boundary
	local boundary = Instance.new("Folder")
	boundary.Name = "Boundary"
	boundary.Parent = ceiling.Parent
	ceiling.Parent = boundary

	-- Carteles gigantes con el nombre del juego sobre los muros largos
	for _, side in { -1, 1 } do
		local board = deco(
			"Billboard",
			Vector3.new(70, 14, 1),
			CFrame.new(0, WALL_HEIGHT + 9, side * (WIDTH / 2 + 3)) * (side > 0 and CFrame.new() or MIRROR),
			Color3.fromRGB(20, 20, 35),
			Enum.Material.SmoothPlastic
		)
		sign(board, Enum.NormalId.Front, GameConfig.GameTitle, Color3.fromRGB(255, 200, 40), Color3.fromRGB(120, 20, 80))
		deco("BillboardFrame", Vector3.new(72, 1, 1.2), board.CFrame * CFrame.new(0, 7.4, 0), C.Pink, Enum.Material.Neon)
		deco("BillboardFrame", Vector3.new(72, 1, 1.2), board.CFrame * CFrame.new(0, -7.4, 0), C.Pink, Enum.Material.Neon)
		for _, x in { -25, 25 } do
			deco("BillboardLeg", Vector3.new(1, 10, 1), board.CFrame * CFrame.new(x, -12, 0.5), C.Metal, Enum.Material.Metal)
		end
	end

	-- Spawns y banderas
	local teams = GameConfig.Teams
	spawnArea(teams[1], CFrame.new(-LENGTH / 2 + 15, 0, 0))
	spawnArea(teams[2], MIRROR * CFrame.new(-LENGTH / 2 + 15, 0, 0))
	flagBase(teams[1], CFrame.new(-118, 0, 12))
	flagBase(teams[2], MIRROR * CFrame.new(-118, 0, 12))

	-- Mitad simétrica del mapa
	symmetric(function(m)
		-- Contenedores
		container(m * CFrame.new(-95, 0, -62), Color3.fromRGB(220, 60, 50))
		container(m * CFrame.new(-95, 0, -62 + 8.4), Color3.fromRGB(40, 120, 220))
		container(m * CFrame.new(-95, 8.9, -58), Color3.fromRGB(240, 150, 30))
		container(m * CFrame.new(-60, 0, 10) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(60, 170, 90))
		container(m * CFrame.new(-35, 0, -85), Color3.fromRGB(240, 150, 30))
		container(m * CFrame.new(-120, 0, 75), Color3.fromRGB(40, 120, 220))

		-- Edificio con azotea accesible por rampa
		building(m * CFrame.new(-75, 0, 68), Vector3.new(26, 12, 22), Color3.fromRGB(245, 245, 250))
		ramp((m * CFrame.new(-38, 0, 74)).Position, (m * CFrame.new(-62, 12, 74)).Position, 7, C.Ramp)

		-- Pasarela elevada sobre los contenedores, con barandillas
		local catwalk = block("Catwalk", Vector3.new(30, 1, 6), m * CFrame.new(-95, 17.9, -45), Color3.fromRGB(90, 90, 100), Enum.Material.DiamondPlate)
		for _, z in { -2.8, 2.8 } do
			deco("Handrail", Vector3.new(30, 0.25, 0.25), catwalk.CFrame * CFrame.new(0, 3, z), C.LineYellow, Enum.Material.Metal)
			for x = -14, 14, 4 do
				deco("RailPost", Vector3.new(0.25, 2.5, 0.25), catwalk.CFrame * CFrame.new(x, 1.75, z), C.Metal, Enum.Material.Metal)
			end
		end
		for _, x in { -82, -108 } do
			block("CatwalkLeg", Vector3.new(1, 17.4, 1), m * CFrame.new(x, 8.7, -42.6), C.Metal, Enum.Material.Metal)
		end
		ramp((m * CFrame.new(-120, 0, -5)).Position, (m * CFrame.new(-110, 17.4, -45)).Position, 6, C.Ramp)

		-- Cajas de cobertura
		crate(m * CFrame.new(-110, 0, 20))
		crate(m * CFrame.new(-110, 0, 25))
		crate(m * CFrame.new(-110, 4, 22.5))
		crate(m * CFrame.new(-45, 0, 45), 5)
		crate(m * CFrame.new(-80, 0, -20))
		crate(m * CFrame.new(-25, 0, -40), 5)
		crate(m * CFrame.new(-25, 0, -35))

		-- Barreras de cobertura
		barrier(Vector3.new(2, 4.5, 16), m * CFrame.new(-40, 0, -15))
		barrier(Vector3.new(14, 4.5, 2), m * CFrame.new(-18, 0, 40))

		-- Rampa a la plataforma central
		ramp((m * CFrame.new(-34, 0, 0)).Position, (m * CFrame.new(-12, 7, 0)).Position, 8, C.Ramp)

		-- Farolas y árboles en las dos aceras (la otra mitad sale del espejo)
		for _, x in { -130, -90, -50, -10 } do
			streetLamp(m * CFrame.new(x, 0.4, -(WIDTH / 2 - 4)) * MIRROR) -- brazo hacia el centro
			streetLamp(m * CFrame.new(x, 0.4, WIDTH / 2 - 4))
		end
		for _, x in { -110, -70, -30 } do
			tree(m * CFrame.new(x, 0.4, -(WIDTH / 2 - 7)))
			tree(m * CFrame.new(x, 0.4, WIDTH / 2 - 7))
		end

		-- Bolardos en las esquinas de la plaza
		for _, z in { -28, 28 } do
			bollard(m * CFrame.new(-30, 0, z))
			bollard(m * CFrame.new(-26, 0, z))
		end
	end)

	-- Plataforma central
	local platform = block("CenterPlatform", Vector3.new(24, 1, 24), CFrame.new(0, 6.5, 0), Color3.fromRGB(80, 80, 95), Enum.Material.DiamondPlate)
	for _, x in { -10, 10 } do
		for _, z in { -10, 10 } do
			block("Pillar", Vector3.new(2, 6, 2), CFrame.new(x, 3, z), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
		end
	end
	-- Bordes de neón
	for _, z in { -12, 12 } do
		deco("PlatformEdge", Vector3.new(24.2, 0.3, 0.3), platform.CFrame * CFrame.new(0, -0.45, z), C.Pink, Enum.Material.Neon)
	end
	for _, x in { -12, 12 } do
		deco("PlatformEdge", Vector3.new(0.3, 0.3, 24.2), platform.CFrame * CFrame.new(x, -0.45, 0), C.Pink, Enum.Material.Neon)
	end
	block("CenterCover", Vector3.new(2, 4, 10), CFrame.new(0, 9, 7), C.Pink, Enum.Material.SmoothPlastic)
	block("CenterCover", Vector3.new(2, 4, 10), CFrame.new(0, 9, -7), C.Pink, Enum.Material.SmoothPlastic)
	-- Holograma giratorio sobre el centro (gira en el cliente)
	local holo = deco("Hologram", Vector3.new(0.3, 9, 9), CFrame.new(0, 22, 0) * CFrame.Angles(0, 0, math.pi / 2) * CFrame.Angles(math.rad(70), 0, 0), C.Cyan, Enum.Material.ForceField)
	holo.Shape = Enum.PartType.Cylinder
	holo:SetAttribute("Spin", 45)
	local holoCore = deco("HologramCore", Vector3.new(2.5, 2.5, 2.5), CFrame.new(0, 22, 0), C.Pink, Enum.Material.Neon)
	holoCore.Shape = Enum.PartType.Ball
	holoCore:SetAttribute("Bob", 1.2)
	local holoLight = Instance.new("PointLight")
	holoLight.Color = C.Pink
	holoLight.Range = 20
	holoLight.Brightness = 2
	holoLight.Parent = holoCore

	-- Rascacielos de fondo (decoración fuera de los muros)
	local rng = Random.new(42)
	local skyline = Instance.new("Folder")
	skyline.Name = "Skyline"
	skyline.Parent = mapFolder
	local palette = {
		Color3.fromRGB(120, 170, 230),
		Color3.fromRGB(90, 140, 210),
		Color3.fromRGB(200, 220, 245),
		Color3.fromRGB(70, 110, 180),
		Color3.fromRGB(240, 240, 250),
		Color3.fromRGB(255, 200, 210),
	}
	local neonTops = { C.Pink, C.Cyan, C.LineYellow, Color3.fromRGB(140, 255, 120) }

	-- near = fila cercana (con franjas); las lejanas van lisas: casi no se distinguen y ahorran cientos de piezas
	local function tower(position, w, d, h, near)
		local color = palette[rng:NextInteger(1, #palette)]
		local glassy = rng:NextNumber() < 0.6
		local body = deco("Tower", Vector3.new(w, h, d), CFrame.new(position + Vector3.new(0, h / 2, 0)), color, glassy and Enum.Material.Glass or Enum.Material.Concrete, skyline)
		body.Reflectance = glassy and 0.15 or 0
		-- Franjas horizontales (solo en la fila cercana, cada tres pisos, sin sombra)
		if near then
			for y = 12, h - 6, 24 do
				local stripe = deco("Floor", Vector3.new(w + 0.3, 0.8, d + 0.3), CFrame.new(position + Vector3.new(0, y, 0)), C.WallTrim, Enum.Material.SmoothPlastic, skyline)
				stripe.CastShadow = false
			end
		end
		-- Remate superior
		local capH = rng:NextNumber(2, 6)
		deco("Cap", Vector3.new(w * 0.7, capH, d * 0.7), CFrame.new(position + Vector3.new(0, h + capH / 2, 0)), C.WallTrim, Enum.Material.Concrete, skyline)
		if rng:NextNumber() < 0.5 then
			deco("NeonTop", Vector3.new(w + 0.6, 1, d + 0.6), CFrame.new(position + Vector3.new(0, h - 0.5, 0)), neonTops[rng:NextInteger(1, #neonTops)], Enum.Material.Neon, skyline)
		end
		if rng:NextNumber() < 0.4 then
			local antennaH = rng:NextNumber(8, 16)
			deco("Antenna", Vector3.new(0.6, antennaH, 0.6), CFrame.new(position + Vector3.new(0, h + capH + antennaH / 2, 0)), C.Metal, Enum.Material.Metal, skyline)
			local light = deco("AntennaLight", Vector3.new(1, 1, 1), CFrame.new(position + Vector3.new(0, h + capH + antennaH, 0)), Color3.fromRGB(255, 40, 40), Enum.Material.Neon, skyline)
			light.Shape = Enum.PartType.Ball
		end
	end

	for x = -230, 230, 38 do
		for _, side in { -1, 1 } do
			local w = rng:NextNumber(24, 34)
			tower(Vector3.new(x + rng:NextNumber(-6, 6), 0, side * (WIDTH / 2 + 42 + rng:NextNumber(0, 30))), w, w, rng:NextNumber(60, 160), true)
			-- Segunda fila más lejana y alta
			local w2 = rng:NextNumber(28, 40)
			tower(Vector3.new(x + 19, 0, side * (WIDTH / 2 + 110 + rng:NextNumber(0, 40))), w2, w2, rng:NextNumber(110, 240))
		end
	end
	for _, side in { -1, 1 } do
		for z = -140, 140, 40 do
			tower(Vector3.new(side * (LENGTH / 2 + 50), 0, z + rng:NextNumber(-5, 5)), 30, 30, rng:NextNumber(50, 130), true)
			tower(Vector3.new(side * (LENGTH / 2 + 120), 0, z + 20), 36, 36, rng:NextNumber(100, 220))
		end
	end

	-- Puntos para "Todos contra todos" y zonas de control
	for _, p in {
		Vector3.new(-120, 0.5, -80), Vector3.new(-60, 0.5, 40), Vector3.new(-20, 0.5, -60), Vector3.new(-90, 0.5, 0),
		Vector3.new(-40, 0.5, 85), Vector3.new(0, 7.5, 0), Vector3.new(-130, 0.5, 40), Vector3.new(-75, 12.5, 68),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Vector3.new(-p.X, p.Y, -p.Z))
	end
	-- Buscar y destruir: sitios A y B en la mitad de cada equipo
	for _, site in { { Vector3.new(-40, 0, 85), "A" }, { Vector3.new(-120, 0, -80), "B" } } do
		Kit.bombSite(site[1], site[2], 1)
		Kit.bombSite(Vector3.new(-site[1].X, site[1].Y, -site[1].Z), site[2], 2)
	end
	Kit.zone(Vector3.new(0, 7, 0), 12, 1)
	Kit.zone(Vector3.new(-75, 12.4, 68), 10, 2)
	Kit.zone(Vector3.new(75, 12.4, -68), 10, 3)
	Kit.zone(Vector3.new(-60, 0, -40), 12, 4)
	Kit.zone(Vector3.new(60, 0, 40), 12, 5)

	-- Realismo: charcos en el asfalto, alcantarillas con vapor y polvo en la plaza
	for _, p in { Vector3.new(-116, 0, -76), Vector3.new(-56, 0, 44), Vector3.new(-86, 0, 4), Vector3.new(-16, 0, -56), Vector3.new(-126, 0, 44) } do
		Kit.puddle(p, 4.5)
		Kit.puddle(Vector3.new(-p.X, p.Y, -p.Z), 4.5)
	end
	for _, p in { Vector3.new(-110, 0.05, -30), Vector3.new(-50, 0.05, 70) } do
		Kit.steamVent(CFrame.new(p), 0.8)
		Kit.steamVent(CFrame.new(-p.X, p.Y, -p.Z), 0.8)
	end
	Kit.dustMotes(CFrame.new(0, 6, 0), Vector3.new(60, 10, 60), Color3.fromRGB(255, 240, 210), 14)

	-- Realismo: losas de acera, alcantarillas, desagües junto al bordillo, grietas, aceite y rodadas
	for _, side in { -1, 1 } do
		Kit.floorJoints(CFrame.new(0, 0.4, side * (WIDTH / 2 - 8)), LENGTH, 16, 6, Color3.fromRGB(118, 116, 112))
	end
	symmetric(function(m)
		for _, p in { Vector3.new(-100, 0, 46), Vector3.new(-20, 0, -48), Vector3.new(-128, 0, -10) } do
			Kit.manhole(m * p)
		end
		for _, p in { Vector3.new(-80, 0, 92.4), Vector3.new(-20, 0, -92.4), Vector3.new(-130, 0, 92.4) } do
			Kit.drain(m * CFrame.new(p))
		end
		for i, spec in { { Vector3.new(-70, 0, 30), 9 }, { Vector3.new(-130, 0, -55), 8 }, { Vector3.new(-30, 0, 58), 10 }, { Vector3.new(-90, 0, -20), 7 } } do
			Kit.crack(m * spec[1], spec[2], i * 23)
		end
		for _, p in { Vector3.new(-108, 0, 54), Vector3.new(-62, 0, -50), Vector3.new(-25, 0, 30) } do
			Kit.oilStain(m * p, 2.6)
		end
		Kit.tireMarks(m * CFrame.new(-58, 0, 52) * CFrame.Angles(0, math.rad(80), 0), 26, -0.5)
		-- Coches aparcados junto al bordillo (también sirven de cobertura)
		Kit.car(m * CFrame.new(-110, 0, 91), Color3.fromRGB(175, 30, 35))
		Kit.car(m * CFrame.new(-70, 0, 91) * CFrame.Angles(0, math.pi, 0), Color3.fromRGB(225, 225, 228))
		Kit.car(m * CFrame.new(-58, 0, -91), Color3.fromRGB(30, 60, 120))
	end)

	return mapFolder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">FrostStation</string>
              <string name="Source"><![CDATA[-- FROST STATION: base de investigación polar. Lago helado resbaladizo en el centro bajo la torre
-- del radar, hangares con techo naranja, laboratorios sobre pilotes, montículos de nieve como
-- cobertura, montañas nevadas de fondo y nieve cayendo.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)
local Variants = require(script.Parent.Parent.LightingVariants)

local Map = {
	Id = "FrostStation",
	Name = "Frost Station",
	Icon = "❄",
	Description = "Polar · tarde · lago helado y nieve",
}

Map.Lighting = {
	CartoonNeutral = { Hue = 0.57, Sat = 0.16 }, -- tono de los grises en estilo Cartoon
	ClockTime = 15.6,
	Latitude = 70, -- sol bajo: sombras largas y azules sobre la nieve
	Brightness = 2.4,
	Exposure = 0.05,
	Ambient = Color3.fromRGB(75, 85, 105),
	OutdoorAmbient = Color3.fromRGB(130, 145, 170),
	Atmosphere = { Density = 0.4, Offset = 0.15, Color = Color3.fromRGB(210, 225, 245), Decay = Color3.fromRGB(140, 160, 205), Glare = 0.45, Haze = 2.2 },
	Color = { Saturation = 0.05, Contrast = 0.15, Brightness = 0.02, Tint = Color3.fromRGB(235, 243, 255) },
	Bloom = { Intensity = 0.5, Size = 24, Threshold = 2 },
	Clouds = 0.8,
	CloudColor = Color3.fromRGB(228, 234, 245),
	SunRays = 0.12,
	Wind = Vector3.new(8, 0, 3), -- viento polar: la nieve cae en diagonal y las nubes corren
	TerrainColors = {
		Snow = Color3.fromRGB(232, 238, 248),
		Glacier = Color3.fromRGB(150, 200, 235),
		Rock = Color3.fromRGB(95, 105, 120),
	},
}
-- A veces sale con otra luz o con mal tiempo (ver LightingVariants)
Map.LightingVariants = { Variants.Blizzard(0.3) }

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad
local C = Kit.C

local SNOW = RGB(236, 242, 250)
local ICE = RGB(165, 215, 245)
local RED = RGB(215, 70, 50)
local ORANGE = RGB(255, 140, 40)
local WALL = RGB(196, 202, 212)
local DARK = RGB(60, 66, 78)

-- Pino nevado: tronco y siete pisos redondos de ramas, cada vez más estrechos y muy juntos para
-- que la silueta sea un cono; nieve sobre pisos alternos y verdes algo distintos
-- `far` = pino de fondo: cuatro pisos más altos en vez de siete (la silueta lejana es la misma)
local function pine(position, scale, far)
	scale = scale or 1
	local cylinder = Kit.cylinder
	cylinder("PineTrunk", 5 * scale, 1.1 * scale, CFrame.new(position + V(0, 2.5 * scale, 0)), RGB(88, 62, 44), Enum.Material.Wood)
	local tiers = far and 4 or 7
	local step = 6 / (tiers - 1)
	for i = 1, tiers do
		local d = (10 - (i - 1) * 8.1 / (tiers - 1)) * scale
		local y = (3 + (i - 1) * 1.65 * step) * scale
		local green = RGB(34, 74, 52):Lerp(RGB(50, 98, 66), (i % 2) * 0.6)
		local height = (1.65 * step + 0.55) * scale -- los pisos se solapan un poco, sin huecos
		local branches = cylinder("PineTier", height, d, CFrame.new(position + V(0, y, 0)), green, Enum.Material.LeafyGrass, nil, true)
		branches.CastShadow = not far
		if far or i % 2 == 1 then
			cylinder("PineSnow", 0.4 * scale, d * 0.78, CFrame.new(position + V(0, y + height / 2, 0)), SNOW, Enum.Material.Snow, nil, true)
		end
	end
	cylinder("PineTip", 1.8 * scale, 0.9 * scale, CFrame.new(position + V(0, 14.2 * scale, 0)), RGB(40, 84, 58), Enum.Material.LeafyGrass, nil, true)
end

-- Montículo de nieve (terreno) que sirve de cobertura
local function snowMound(position, radius)
	workspace.Terrain:FillBall(position, radius, Enum.Material.Snow)
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	folder:SetAttribute("Ambience", "Snow") -- (sonido ambiente: ver Ambience en el cliente)
	Kit.applyLighting(Kit.pickLighting(Map))
	folder:SetAttribute("Variant", Kit.Variant)
	folder:SetAttribute("Weather", Kit.Weather)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Suelo nevado con huellas de vehículos
	block("Floor", V(340, 2, 240), CFrame.new(0, -1, 0), SNOW, Enum.Material.Snow)
	for _, z in { -62, 62 } do
		for _, dz in { -2.5, 2.5 } do
			deco("Tracks", V(200, 0.05, 1.2), CFrame.new(0, 0.03, z + dz), RGB(205, 215, 230), Enum.Material.Snow)
		end
	end

	-- Lago helado en el centro: ¡resbala!
	local lake = Kit.cylinder("FrozenLake", 0.3, 54, CFrame.new(0, 0.15, 0), ICE, Enum.Material.Ice)
	lake.CustomPhysicalProperties = PhysicalProperties.new(0.9, 0.02, 0.05, 100, 1)
	lake.Reflectance = 0.22 -- hielo pulido: refleja el cielo
	Kit.cylinder("LakeRim", 0.2, 57, CFrame.new(0, 0.1, 0), RGB(215, 228, 242), Enum.Material.Glacier, nil, true)
	for i = 1, 6 do
		local angle = i * math.pi / 3
		deco("IceCrack", V(0.15, 0.05, 10 + i), CFrame.new(math.cos(angle) * 14, 0.31, math.sin(angle) * 14) * CFrame.Angles(0, angle + 0.6, 0), RGB(235, 248, 255), Enum.Material.Neon).Transparency = 0.5
	end

	-- Torre del radar: plataforma elevada con cúpula y antena giratoria
	block("TowerDeck", V(24, 1.2, 24), CFrame.new(0, 9, 0), DARK, Enum.Material.DiamondPlate)
	deco("TowerDeckEdge", V(24.4, 0.4, 24.4), CFrame.new(0, 8.3, 0), ORANGE, Enum.Material.Neon)
	for _, x in { -10, 10 } do
		for _, z in { -10, 10 } do
			block("TowerLeg", V(2, 8.4, 2), CFrame.new(x, 4.2, z), RGB(80, 86, 98), Enum.Material.Metal)
		end
	end
	local dome = Kit.ball("RadarDome", 8, CFrame.new(0, 13.4, 0), RGB(245, 247, 252), Enum.Material.SmoothPlastic)
	dome.CastShadow = true
	Kit.cylinder("DomeBase", 1.4, 9, CFrame.new(0, 10.3, 0), RGB(200, 205, 215), Enum.Material.Metal)
	Kit.cylinder("RadarMast", 5, 0.8, CFrame.new(0, 19.6, 0), RGB(90, 95, 105), Enum.Material.Metal, nil, true)
	local dish = deco("RadarDish", V(0.5, 7, 7), CFrame.new(0, 22.5, 0) * CFrame.Angles(0, 0, rad(-20)), RGB(235, 238, 245), Enum.Material.Metal)
	dish.Shape = Enum.PartType.Cylinder
	dish:SetAttribute("Spin", 45)
	local beacon = Kit.ball("RadarBeacon", 1, CFrame.new(0, 26.4, 0), RGB(255, 40, 40), Enum.Material.Neon, true)
	beacon:SetAttribute("Blink", 1.2)
	Kit.light(beacon, "PointLight", RGB(255, 60, 60), 18, 2)
	local deckLight = deco("TowerLight", V(18, 0.2, 18), CFrame.new(0, 8.35, 0), RGB(255, 230, 190), Enum.Material.Neon)
	Kit.light(deckLight, "SurfaceLight", RGB(255, 220, 170), 14, 1, Enum.NormalId.Bottom)

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(255, 60, 80) or RGB(60, 140, 255)

		-- Escaleras de la torre y barandillas (con hueco donde llegan)
		Kit.stairs(m * V(-31, 0, -6), m * V(-12.5, 9.6, -6), 6, RGB(120, 125, 138), Enum.Material.DiamondPlate)
		Kit.railing(m * V(-12, 9.6, 12), m * V(12, 9.6, 12), 3, ORANGE)
		Kit.railing(m * V(-12, 9.6, -12), m * V(-12, 9.6, -9.5), 3, ORANGE)
		Kit.railing(m * V(-12, 9.6, -2.5), m * V(-12, 9.6, 12), 3, ORANGE)

		-- Hangar: lo atraviesa el carril norte, con techo naranja
		local hz = -62
		block("HangarBack", V(44, 14, 2), m * CFrame.new(-70, 7, hz - 15), WALL, Enum.Material.CorrodedMetal)
		block("HangarFrontA", V(16, 14, 2), m * CFrame.new(-84, 7, hz + 15), WALL, Enum.Material.CorrodedMetal)
		block("HangarFrontB", V(16, 14, 2), m * CFrame.new(-56, 7, hz + 15), WALL, Enum.Material.CorrodedMetal)
		block("HangarLintel", V(12, 4, 2), m * CFrame.new(-70, 12, hz + 15), WALL, Enum.Material.CorrodedMetal)
		block("HangarRoof", V(46, 1.5, 34), m * CFrame.new(-70, 14.75, hz), RED, Enum.Material.Metal)
		deco("HangarRoofSnow", V(44, 0.4, 30), m * CFrame.new(-70, 15.7, hz), SNOW, Enum.Material.Snow)
		for _, x in { -91, -49 } do
			deco("HangarStripe", V(2.2, 1, 34.2), m * CFrame.new(x, 13.6, hz), C.Yellow, Enum.Material.SmoothPlastic)
		end
		Kit.neonSign(m * CFrame.new(-70, 12, hz + 16.4) * CFrame.Angles(0, math.pi, 0), 10, 3, side == "A" and "HANGAR A" or "HANGAR B", teamColor, C.White)
		for _, x in { -82, -70, -58 } do
			local lamp = deco("HangarLamp", V(3, 0.3, 3), m * CFrame.new(x, 13.8, hz), RGB(255, 235, 200), Enum.Material.Neon)
			Kit.lightCone((m * CFrame.new(x, 13.6, hz)).Position, 12, 1.4, 5.5, RGB(255, 230, 190))
			Kit.light(lamp, "SpotLight", RGB(255, 225, 180), 22, 1.6, Enum.NormalId.Bottom).Angle = 110
		end
		-- Moto de nieve (snowcat) y cajas dentro del hangar
		block("SnowcatBody", V(8, 3.5, 5), m * CFrame.new(-64, 2.6, hz - 5), ORANGE, Enum.Material.SmoothPlastic)
		local cab = block("SnowcatCab", V(4, 3, 4.6), m * CFrame.new(-65.5, 5.8, hz - 5), RGB(120, 170, 220), Enum.Material.Glass)
		cab.Transparency = 0.3
		for _, dz in { -2.8, 2.8 } do
			block("SnowcatTrack", V(9, 1.6, 1.3), m * CFrame.new(-64, 0.8, hz - 5 + dz), RGB(30, 30, 34), Enum.Material.Rubber)
		end
		Kit.metalCrate(m * CFrame.new(-84, 0, hz - 8), 5, RGB(90, 96, 110), teamColor)
		Kit.metalCrate(m * CFrame.new(-84, 0, hz - 2.8), 5, RGB(90, 96, 110), teamColor)
		Kit.metalCrate(m * CFrame.new(-84, 5, hz - 5.4), 4, RGB(90, 96, 110), ORANGE)
		Kit.metalCrate(m * CFrame.new(-54, 0, hz + 8), 4, RGB(90, 96, 110), C.Cyan)

		-- Laboratorio sobre pilotes con terraza (puesto de tirador)
		local lab = m * CFrame.new(-72, 0, 45)
		block("LabDeck", V(26, 1, 20), lab * CFrame.new(0, 8, 0), DARK, Enum.Material.DiamondPlate)
		for _, x in { -12, 12 } do
			for _, z in { -9, 9 } do
				block("LabPile", V(1.5, 7.5, 1.5), lab * CFrame.new(x, 3.75, z), RGB(80, 86, 98), Enum.Material.Metal)
			end
		end
		block("LabCabin", V(16, 8, 10), lab * CFrame.new(-2, 12.5, 0), RED, Enum.Material.SmoothPlastic)
		block("LabRoof", V(17, 0.8, 11), lab * CFrame.new(-2, 16.9, 0), SNOW, Enum.Material.Snow)
		for _, z in { -5.1, 5.1 } do
			for _, x in { -7, -2, 3 } do
				local win = deco("LabWindow", V(3, 2.2, 0.2), lab * CFrame.new(x, 13.5, z), RGB(255, 225, 150), Enum.Material.Neon)
				win.Transparency = 0.2
			end
		end
		deco("LabStripe", V(16.2, 0.6, 10.2), lab * CFrame.new(-2, 9.2, 0), C.White, Enum.Material.SmoothPlastic)
		Kit.stairs(m * V(-46, 0, 50), m * V(-59.5, 8.5, 50), 5, RGB(120, 125, 138), Enum.Material.DiamondPlate)
		Kit.railing(lab * V(-13, 8.5, -10), lab * V(13, 8.5, -10), 3, teamColor)
		Kit.railing(lab * V(-13, 8.5, 10), lab * V(13, 8.5, 10), 3, teamColor)
		Kit.railing(lab * V(-13, 8.5, -10), lab * V(-13, 8.5, 10), 3, teamColor)
		Kit.railing(lab * V(13, 8.5, -10), lab * V(13, 8.5, 2.5), 3, teamColor)
		local dishPole = Kit.cylinder("LabAntenna", 6, 0.5, lab * CFrame.new(4, 20, 0), RGB(150, 155, 165), Enum.Material.Metal, nil, true)
		local labBeacon = Kit.ball("LabBeacon", 0.7, lab * CFrame.new(4, 23.3, 0), teamColor, Enum.Material.Neon, true)
		labBeacon:SetAttribute("Blink", 0.9)
		dishPole.CastShadow = true

		-- Depósitos de combustible
		for _, z in { -60, -76 } do
			Kit.cylinder("FuelTank", 10, 7, m * CFrame.new(-120, 5, z), RGB(240, 242, 246), Enum.Material.Metal)
			Kit.cylinder("FuelBand", 1.2, 7.3, m * CFrame.new(-120, 7, z), RED, Enum.Material.SmoothPlastic, nil, true)
			Kit.cylinder("FuelCap", 0.8, 5, m * CFrame.new(-120, 10.4, z), SNOW, Enum.Material.Snow, nil, true)
		end
		Kit.pipeRun(m * V(-116, 2, -68), m * V(-93, 2, -68), 1.2, RGB(150, 155, 165))

		-- Contenedores de suministros y cobertura
		Kit.container(m * CFrame.new(-36, 0, 74), RED, "POLAR-1")
		Kit.container(m * CFrame.new(-98, 0, -28) * CFrame.Angles(0, rad(90), 0), RGB(45, 110, 200), "SUMINISTROS")
		Kit.barrier(V(2, 4, 14), m * CFrame.new(-24, 0, -30))
		Kit.barrier(V(14, 4, 2), m * CFrame.new(-50, 0, -30))
		Kit.barrier(V(2, 4, 12), m * CFrame.new(-34, 0, 18))
		Kit.metalCrate(m * CFrame.new(-60, 0, 2), 5, RGB(90, 96, 110), ORANGE)
		Kit.metalCrate(m * CFrame.new(-60, 0, 7.2), 5, RGB(90, 96, 110), ORANGE)
		Kit.metalCrate(m * CFrame.new(-92, 0, 62), 5, RGB(90, 96, 110), teamColor)

		-- Montículos de nieve (terreno)
		-- Montículos de unos 4,5 studs de alto: tapan a un jugador agachado o deslizándose
		snowMound(m * V(-42, -1.5, 26), 6)
		snowMound(m * V(-28, -2.5, -48), 7)
		snowMound(m * V(-108, -1.5, -2), 6)
		snowMound(m * V(-115, -1.5, 46), 5.5)
		snowMound(m * V(-20, -2.5, 82), 7)

		-- Coches aparcados cubiertos de nieve
		Kit.car(m * CFrame.new(-130, 0, -62) * CFrame.Angles(0, rad(8), 0), RGB(40, 70, 110), { Snow = true })
		Kit.car(m * CFrame.new(-80, 0, 88) * CFrame.Angles(0, rad(175), 0), RGB(150, 40, 35), { Snow = true })

		-- Rocas que asoman entre la nieve
		Kit.rockCluster(m * V(-150, 0, -70), 4, Enum.Material.Rock)
		Kit.rockCluster(m * V(-75, 0, 104), 4.5, Enum.Material.Slate)
		Kit.rockCluster(m * V(-135, 0, -104), 4, Enum.Material.Rock)
		Kit.rockCluster(m * V(-40, 0, -104), 5, Enum.Material.Slate)

		-- Antena de comunicaciones con baliza
		local mast = m * CFrame.new(-128, 0, 88)
		Kit.cylinder("CommsMast", 32, 1, mast * CFrame.new(0, 16, 0), RGB(200, 70, 55), Enum.Material.Metal)
		for i = 1, 4 do
			deco("CommsBar", V(5, 0.3, 0.3), mast * CFrame.new(0, i * 7, 0) * CFrame.Angles(0, rad(i * 45), 0), RGB(230, 230, 235), Enum.Material.Metal)
		end
		local top = Kit.ball("CommsBeacon", 1.2, mast * CFrame.new(0, 32.6, 0), RGB(255, 40, 40), Enum.Material.Neon, true)
		top:SetAttribute("Blink", 1.5)

		-- Farolas naranjas
		for _, p in { V(-92, 0, 22), V(-40, 0, -42), V(-24, 0, 44), V(-110, 0, -40) } do
			Kit.streetLamp(m * CFrame.new(p) * CFrame.Angles(0, rad(90), 0), RGB(255, 190, 110))
		end

		-- Pinos en los bordes
		for _, p in { V(-140, 0, 96), V(-100, 0, 100), V(-60, 0, 98), V(-150, 0, -96), V(-88, 0, -98), V(-18, 0, -100) } do
			pine(m * p, 1 + (math.abs(p.X) % 3) * 0.15)
		end
	end)

	-- Nieve cayendo sobre todo el mapa
	local sky = deco("Snowfall", V(330, 1, 230), CFrame.new(0, 56, 0), SNOW, Enum.Material.SmoothPlastic)
	sky.Transparency = 1
	sky.CastShadow = false
	local snow = Instance.new("ParticleEmitter")
	snow.Name = "Snow"
	snow.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	snow.Color = ColorSequence.new(Color3.new(1, 1, 1))
	snow.LightEmission = 0.3
	snow.Size = NumberSequence.new(0.22)
	snow.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.85, 0.2), NumberSequenceKeypoint.new(1, 1) })
	snow.Lifetime = NumberRange.new(7, 9)
	snow.Speed = NumberRange.new(6, 9)
	snow.SpreadAngle = Vector2.new(15, 15)
	snow.Acceleration = V(0.4, 0, 0.2)
	snow.WindAffectsDrag = true
	snow.RotSpeed = NumberRange.new(-60, 60)
	snow.Rate = 140
	-- (con ventisca: mucha más nieve, más rápida y de lado)
	if Kit.Weather == "Snowstorm" then
		snow.Rate = 420
		snow.Speed = NumberRange.new(12, 18)
		snow.Lifetime = NumberRange.new(4, 6)
		snow.Acceleration = V(6, 0, 2.5)
	end
	snow.EmissionDirection = Enum.NormalId.Bottom
	snow.Parent = sky

	-- Spawns y banderas
	local spawnStyle = { Floor = RGB(205, 215, 230), FloorMaterial = Enum.Material.Concrete, Roof = RED, RoofMaterial = Enum.Material.Metal }
	Kit.spawnArea(teams[1], CFrame.new(-145, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-145, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-112, 0, 10))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-112, 0, 10))

	-- Límites y montañas nevadas de fondo
	Kit.bounds(320, 220, 60)
	for x = -240, 240, 60 do
		for _, z in { -1, 1 } do
			-- Laderas nevadas irregulares con roca a la vista y, detrás, picos de roca con nieve en la cima
			Kit.naturalHill(V(x + z * 15, -18, z * (175 + (math.abs(x) % 50))), 55 + (math.abs(x) % 4) * 8, Enum.Material.Snow, {
				Inward = V(0, 0, -z),
				RockCount = 4,
			})
			Kit.naturalHill(V(x + 25, -30, z * 230), 60, Enum.Material.Rock, {
				Inward = V(0, 0, -z),
				Rock = Enum.Material.Slate,
				Top = Enum.Material.Snow,
				TopCount = 4,
			})
		end
	end
	for z = -150, 150, 60 do
		for _, sx in { -1, 1 } do
			Kit.naturalHill(V(sx * 230, -20, z), 60, Enum.Material.Snow, { Inward = V(-sx, 0, 0), RockCount = 3 })
		end
	end
	-- Pinos fuera del mapa (bosque de fondo)
	for x = -150, 150, 22 do
		for _, z in { -1, 1 } do
			pine(V(x + (z * 7), 0, z * (122 + (math.abs(x) % 13))), 1.3, true)
		end
	end

	-- Modos
	for _, p in {
		V(-130, 0.5, 45), V(-100, 0.5, -10), V(-62.5, 8.6, 45), V(-70, 0.5, -62), V(-45, 0.5, 8),
		V(-20, 0.5, -60), V(-110, 0.5, 80), V(-60, 0.5, -15), V(-12, 0.5, 52), V(-125, 0.5, -90),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, 9.6, 0), 10, 1)
	Kit.zone(V(-70, 0, -62), 9, 2)
	Kit.zone(V(70, 0, 62), 9, 3)
	Kit.zone(V(-45, 0, 0), 9, 4)
	Kit.zone(V(45, 0, 0), 9, 5)
	-- Realismo: carámbanos en los tejados y ventisca rasante (nieve que arrastra el viento por el suelo)
	local function icicles(a, b, top, count, seed)
		local rng = Random.new(seed)
		for i = 0, count do
			local p = a:Lerp(b, i / count) + Vector3.new(rng:NextNumber(-0.3, 0.3), 0, rng:NextNumber(-0.2, 0.2))
			local length = rng:NextNumber(0.8, 2.6)
			Kit.deco("Icicle", Vector3.new(0.35, length, 0.35), CFrame.new(p.X, top - length / 2, p.Z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), Color3.fromRGB(205, 235, 255), Enum.Material.Ice)
			Kit.deco("IcicleTip", Vector3.new(0.18, length * 0.5, 0.18), CFrame.new(p.X, top - length - length * 0.2, p.Z), Color3.fromRGB(220, 242, 255), Enum.Material.Ice)
		end
	end
	Kit.symmetric(function(m, side)
		local seed = side == "A" and 11 or 29
		-- Borde del tejado del hangar (mirando al centro) y del laboratorio
		local a, b = m * Vector3.new(-92, 0, -45.2), m * Vector3.new(-48, 0, -45.2)
		icicles(a, b, 14, 22, seed)
		local c, d = m * Vector3.new(-82, 0, 50.6), m * Vector3.new(-66, 0, 50.6)
		icicles(c, d, 16.5, 8, seed + 1)
	end)
	local drift = Kit.deco("SnowDrift", Vector3.new(300, 2, 200), CFrame.new(0, 1.2, 0), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
	drift.Transparency = 1
	local blow = Instance.new("ParticleEmitter")
	blow.Name = "Spindrift"
	blow.Texture = "rbxasset://textures/particles/smoke_main.dds"
	blow.Color = ColorSequence.new(Color3.fromRGB(245, 248, 255))
	blow.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 4) })
	blow.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.82), NumberSequenceKeypoint.new(1, 1) })
	blow.Lifetime = NumberRange.new(3, 5)
	blow.Speed = NumberRange.new(10, 16)
	blow.SpreadAngle = Vector2.new(10, 4)
	blow.EmissionDirection = Enum.NormalId.Right
	blow.Shape = Enum.ParticleEmitterShape.Box
	blow.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	blow.Rate = Kit.Weather == "Snowstorm" and 45 or 18
	blow.Parent = drift
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">HarborHeights</string>
              <string name="Source"><![CDATA[-- HARBOR HEIGHTS: pueblo costero vertical. Canal con agua en el centro (pasarelas por debajo
-- de los puentes), torre de control en el puente central, azoteas en cada lado y el mar de fondo.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)
local Variants = require(script.Parent.Parent.LightingVariants)

local Map = {
	Id = "HarborHeights",
	Bomb = true, -- tiene sitios para Buscar y destruir
	Name = "Harbor Heights",
	Icon = "⚓",
	Description = "Costa · día · canal, puentes y azoteas",
}

Map.Lighting = {
	CartoonNeutral = { Hue = 0.08, Sat = 0.3 }, -- tono de los grises en estilo Cartoon
	ClockTime = 14.2,
	Brightness = 3.2,
	Exposure = 0,
	Ambient = Color3.fromRGB(60, 62, 72),
	OutdoorAmbient = Color3.fromRGB(125, 128, 140),
	Atmosphere = { Density = 0.3, Offset = 0.25, Color = Color3.fromRGB(199, 215, 235), Decay = Color3.fromRGB(106, 130, 160), Glare = 0.5, Haze = 1.6 },
	Color = { Saturation = 0.12, Contrast = 0.16, Brightness = 0.01, Tint = Color3.fromRGB(255, 250, 242) },
	Clouds = 0.6,
	SunRays = 0.06,
	-- Agua de puerto: verde azulada, con reflejos y oleaje suave
	Water = { Color = Color3.fromRGB(20, 110, 135), Reflectance = 0.8, Transparency = 0.45, WaveSize = 0.12, WaveSpeed = 8 },
	Latitude = 38,
	Bloom = { Intensity = 0.5, Size = 24, Threshold = 2 },
}
-- A veces sale con otra luz o con mal tiempo (ver LightingVariants)
Map.LightingVariants = { Variants.Sunset(0.25), Variants.Storm(0.25), Variants.Fog(0.15) }

local V = Vector3.new
local RGB = Color3.fromRGB
local C = Kit.C

local STONE = RGB(168, 158, 140) -- adoquín envejecido (antes casi blanco: deslumbraba)
local STONE_DARK = RGB(132, 122, 104)
local PLASTER = RGB(236, 226, 205)
local CANAL_HALF = 12 -- el canal va de x = -12 a x = 12
local LEDGE_Y = -7.5 -- altura de las pasarelas del canal
local WATER_Y = -8.5

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	folder:SetAttribute("Ambience", "Coast") -- (sonido ambiente: ver Ambience en el cliente)
	Kit.applyLighting(Kit.pickLighting(Map))
	folder:SetAttribute("Variant", Kit.Variant)
	folder:SetAttribute("Weather", Kit.Weather)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	---------------------------------------------------------------------------
	-- Suelo, canal y agua
	---------------------------------------------------------------------------
	Kit.symmetric(function(m)
		block("Ground", V(150, 2, 220), m * CFrame.new(-(CANAL_HALF + 75), -1, 0), STONE, Enum.Material.Cobblestone)
		-- Muro del canal y pasarela inferior
		block("CanalWall", V(2, 14, 220), m * CFrame.new(-(CANAL_HALF - 1), -7, 0), STONE_DARK, Enum.Material.Limestone)
		block("CanalLedge", V(4, 1, 220), m * CFrame.new(-(CANAL_HALF - 4), LEDGE_Y - 0.5, 0), STONE, Enum.Material.Cobblestone)
		deco("LedgeEdge", V(0.4, 0.3, 220), m * CFrame.new(-(CANAL_HALF - 6.2), LEDGE_Y + 0.05, 0), C.Yellow, Enum.Material.SmoothPlastic)
		-- Farolillos del canal
		for z = -90, 90, 30 do
			local lamp = deco("CanalLamp", V(0.8, 1, 0.8), m * CFrame.new(-(CANAL_HALF - 2.4), LEDGE_Y + 4, z), RGB(255, 210, 140), Enum.Material.Neon)
			Kit.light(lamp, "PointLight", RGB(255, 200, 130), 14, 1.4)
		end
		-- Escaleras de bajada al canal
		for _, z in { 30, -75 } do
			Kit.stairs(m * V(-(CANAL_HALF - 3), 0, z), m * V(-(CANAL_HALF - 3), LEDGE_Y, z + 15), 3.6, STONE)
		end
		-- Realismo: algas en la línea del agua, mancha de humedad en el muro y bolardos de amarre
		deco("WaterlineAlgae", V(0.06, 0.7, 220), m * CFrame.new(-(CANAL_HALF - 6) + 0.03, WATER_Y + 0.15, 0), RGB(48, 66, 44), Enum.Material.Slate)
		deco("WetStain", V(0.06, 1.2, 220), m * CFrame.new(-(CANAL_HALF - 1) + 1.03, LEDGE_Y + 0.6, 0), STONE_DARK:Lerp(RGB(40, 50, 40), 0.35), Enum.Material.Limestone)
		for z = -100, 100, 20 do
			local nearBridge = math.abs(z) < 12 or math.abs(math.abs(z) - 80) < 8
			local nearStairs = (z >= 26 and z <= 50) or (z >= -79 and z <= -56)
			if not nearBridge and not nearStairs then
				Kit.cylinder("Bollard", 1.4, 1, m * CFrame.new(-(CANAL_HALF - 1), 0.7, z), RGB(40, 42, 46), Enum.Material.Metal, nil, true)
				Kit.ball("BollardCap", 1.3, m * CFrame.new(-(CANAL_HALF - 1), 1.45, z), RGB(40, 42, 46), Enum.Material.Metal, true)
			end
		end
		Kit.manhole(m * V(-75, 0, -30))
		Kit.manhole(m * V(-115, 0, 50))
	end)
	block("CanalFloor", V(16, 1, 220), CFrame.new(0, -14, 0), RGB(60, 70, 60), Enum.Material.Mud)
	workspace.Terrain:FillBlock(CFrame.new(0, (WATER_Y - 14) / 2, 0), V(16, WATER_Y + 14, 222), Enum.Material.Water)
	-- Barca amarrada en el canal
	Kit.boat(CFrame.new(-1, WATER_Y, -40))

	---------------------------------------------------------------------------
	-- Puentes
	---------------------------------------------------------------------------
	local function bridge(z, width)
		block("Bridge", V(CANAL_HALF * 2 + 4, 1.5, width), CFrame.new(0, -0.75, z), STONE, Enum.Material.Cobblestone)
		-- Arco de piedra decorativo bajo el puente
		for _, x in { -6, 0, 6 } do
			deco("Arch", V(4, 1.2, width + 0.2), CFrame.new(x, -2.1 + math.abs(x) * 0.05, z), STONE_DARK, Enum.Material.Limestone)
		end
		for _, side in { -1, 1 } do
			Kit.railing(V(-(CANAL_HALF + 2), 0, z + side * (width / 2 - 0.3)), V(CANAL_HALF + 2, 0, z + side * (width / 2 - 0.3)), 3, RGB(90, 70, 50))
		end
	end
	bridge(0, 18)
	bridge(80, 9)
	bridge(-80, 9)

	---------------------------------------------------------------------------
	-- Torre de control (centro, sobre el puente)
	---------------------------------------------------------------------------
	local towerColor = RGB(200, 185, 160)
	for _, x in { -7, 7 } do
		for _, z in { -7, 7 } do
			block("TowerLeg", V(2.4, 24, 2.4), CFrame.new(x, 12, z), towerColor, Enum.Material.Limestone)
		end
	end
	-- Primer piso (con hueco para la escalera de mano)
	block("TowerFloor1", V(17, 1, 7), CFrame.new(0, 10.5, -5), STONE, Enum.Material.WoodPlanks)
	block("TowerFloor1", V(17, 1, 7), CFrame.new(0, 10.5, 5), STONE, Enum.Material.WoodPlanks)
	block("TowerFloor1", V(6, 1, 3), CFrame.new(-5.5, 10.5, 0), STONE, Enum.Material.WoodPlanks)
	block("TowerFloor1", V(6, 1, 3), CFrame.new(5.5, 10.5, 0), STONE, Enum.Material.WoodPlanks)
	-- Azotea de la torre (con hueco en el centro para la escalera de mano)
	for _, s in { -1, 1 } do
		block("TowerParapet", V(17, 2.6, 1), CFrame.new(0, 24.3, s * 8), towerColor, Enum.Material.Limestone)
		block("TowerParapet", V(1, 2.6, 15), CFrame.new(s * 8, 24.3, 0), towerColor, Enum.Material.Limestone)
		Kit.railing(V(-8.5, 11, s * 8.3), V(8.5, 11, s * 8.3), 3, RGB(90, 70, 50))
	end
	-- Escalera de mano (TrussPart: se puede trepar) del primer piso a la azotea
	local truss = Instance.new("TrussPart")
	truss.Name = "TowerLadder"
	truss.Anchored = true
	truss.Size = V(2, 12, 2)
	truss.CFrame = CFrame.new(0, 16.5, 0)
	truss.Color = RGB(110, 85, 60)
	truss.Parent = folder
	block("TowerTop", V(17, 1, 7.5), CFrame.new(0, 22.5, -4.75), towerColor, Enum.Material.Limestone)
	block("TowerTop", V(17, 1, 7.5), CFrame.new(0, 22.5, 4.75), towerColor, Enum.Material.Limestone)
	block("TowerTop", V(7, 1, 2), CFrame.new(-5, 22.5, 0), towerColor, Enum.Material.Limestone)
	block("TowerTop", V(7, 1, 2), CFrame.new(5, 22.5, 0), towerColor, Enum.Material.Limestone)
	-- Antena y radar
	Kit.cylinder("TowerMast", 10, 0.5, CFrame.new(5, 28, 5), C.Metal, Enum.Material.Metal, nil, true)
	local dish = deco("RadarDish", V(0.4, 4, 4), CFrame.new(-5, 27, -5) * CFrame.Angles(0, math.rad(35), math.rad(70)), RGB(230, 230, 235), Enum.Material.Metal)
	dish.Shape = Enum.PartType.Cylinder
	dish:SetAttribute("Spin", 30)
	Kit.ball("TowerBeacon", 1, CFrame.new(5, 33.5, 5), RGB(255, 40, 40), Enum.Material.Neon, true):SetAttribute("Blink", 1.2)
	-- Estandartes de la torre (neutros)
	for _, s in { -1, 1 } do
		Kit.banner(CFrame.new(0, 21, s * 8.7) * (s > 0 and CFrame.Angles(0, math.pi, 0) or CFrame.new()), 6, 8, RGB(240, 190, 40), C.White)
	end

	---------------------------------------------------------------------------
	-- Mitad simétrica: A (rojo) y B (azul)
	---------------------------------------------------------------------------
	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(200, 45, 40) or RGB(45, 100, 210)

		-- Rampa a la torre desde la orilla
		Kit.stairs(m * V(-32, 0, -3.5), m * V(-8.5, 11, -3.5), 4, STONE)

		-- Casas con azoteas (A1 con escalera exterior; A2 alta, comunicada con A1 por una pasarela)
		Kit.house(m * CFrame.new(-60, 0, 55), V(24, 10, 18), RGB(255, 222, 165), teamColor, { Vines = true, OpenSides = true })
		Kit.stairs(m * V(-45.5, 0, 68), m * V(-45.5, 10, 50), 4, STONE)
		Kit.house(m * CFrame.new(-100, 0, 72), V(20, 15, 16), RGB(255, 196, 180), teamColor, { Vines = true, OpenSides = true })
		Kit.ramp(m * V(-72, 10, 60), m * V(-90, 15, 68), 4, RGB(120, 90, 60), Enum.Material.WoodPlanks)
		Kit.house(m * CFrame.new(-78, 0, -58), V(22, 10, 20), RGB(200, 226, 240), teamColor, { DoorX = -4, OpenSides = true })
		Kit.stairs(m * V(-64.5, 0, -45), m * V(-64.5, 10, -61), 4, STONE)
		Kit.house(m * CFrame.new(-128, 0, -78), V(18, 12, 16), RGB(240, 235, 215), teamColor)

		-- Macetas en las azoteas y guirnaldas sobre el mercado
		Kit.flowerPot(m * CFrame.new(-68, 10, 50), RGB(255, 80, 120))
		Kit.flowerPot(m * CFrame.new(-52, 10, 60), RGB(255, 200, 60))
		Kit.flowerPot(m * CFrame.new(-104, 15, 76), RGB(255, 120, 200))
		Kit.flowerPot(m * CFrame.new(-84, 10, -54), RGB(120, 160, 255))
		-- Flores al pie de las casas y hierba alta en los rincones
		for i, p in { V(-50, 0, 44), V(-88, 0, 62), V(-70, 0, -46), V(-122, 0, -88), V(-140, 0, 72) } do
			Kit.flowers(m * p, 3, i * 11)
		end
		for i, p in { V(-30, 0, 60), V(-125, 0, -60), V(-148, 0, 96), V(-60, 0, -98) } do
			Kit.grassTuft(m * p, 1, i * 5)
		end
		Kit.stringLights(m * V(-44, 9, 12), m * V(-30, 9, 36))
		Kit.stringLights(m * V(-30, 9, 12), m * V(-44, 9, 36))

		-- Estandartes del equipo en las fachadas que miran al centro
		Kit.banner(m * CFrame.new(-55, 9.5, 45.6), 5, 7, teamColor, C.White)
		Kit.banner(m * CFrame.new(-82, 9.5, -47.4), 5, 7, teamColor, C.White)

		-- Mercado con toldos
		for i, z in { 18, 30 } do
			block("Stall", V(8, 3, 5), m * CFrame.new(-38, 1.5, z), RGB(150, 110, 70), Enum.Material.WoodPlanks)
			for _, x in { -3.7, 3.7 } do
				deco("StallPost", V(0.4, 6, 0.4), m * CFrame.new(-38 + x, 3, z - 2.2), RGB(110, 80, 50), Enum.Material.Wood)
			end
			Kit.awning(m * CFrame.new(-38, 6.2, z + 2), 9, 6, i == 1 and teamColor or RGB(240, 160, 40))
			Kit.crate(m * CFrame.new(-33, 0, z + 1), 2.5)
		end

		-- Contenedores y cajas de cobertura
		Kit.container(m * CFrame.new(-32, 0, -32) * CFrame.Angles(0, math.rad(90), 0), side == "A" and C.Red or C.Blue)
		Kit.container(m * CFrame.new(-112, 0, 22), side == "A" and C.Blue or C.Red)
		Kit.crate(m * CFrame.new(-25, 0, 8))
		Kit.crate(m * CFrame.new(-25, 0, 12.5))
		Kit.crate(m * CFrame.new(-25, 4, 10), 3.5)
		Kit.crate(m * CFrame.new(-55, 0, -20), 5)
		Kit.crate(m * CFrame.new(-90, 0, 40))
		Kit.crate(m * CFrame.new(-90, 0, 35), 3)
		Kit.crate(m * CFrame.new(-140, 0, 60), 4)
		Kit.barrel(m * CFrame.new(-50, 0, 10), RGB(40, 90, 180))
		Kit.barrel(m * CFrame.new(-48, 0, 12.5), RGB(180, 50, 40))
		Kit.barrel(m * CFrame.new(-100, 0, -30), RGB(40, 90, 180))
		-- Muros bajos de piedra
		block("StoneWall", V(2, 4, 14), m * CFrame.new(-45, 2, -8), STONE_DARK, Enum.Material.Cobblestone)
		block("StoneWall", V(12, 4, 2), m * CFrame.new(-95, 2, 0), STONE_DARK, Enum.Material.Cobblestone)
		block("StoneWall", V(2, 3, 18), m * CFrame.new(-120, 1.5, -40), STONE_DARK, Enum.Material.Cobblestone)

		-- Palmeras y farolas
		for _, p in { V(-20, 0, 45), V(-20, 0, -55), V(-70, 0, 20), V(-130, 0, 95), V(-55, 0, -95), V(-110, 0, -10) } do
			Kit.palm(m * CFrame.new(p) * CFrame.Angles(0, (p.X + p.Z) % 6, 0), 13 + (math.abs(p.Z) % 4))
		end
		for _, p in { V(-18, 0, 20), V(-18, 0, -30), V(-60, 0, 90), V(-90, 0, -95) } do
			Kit.streetLamp(m * CFrame.new(p) * CFrame.Angles(0, math.rad(90), 0), RGB(255, 225, 170))
		end
	end)

	---------------------------------------------------------------------------
	-- Spawns, banderas, bordes
	---------------------------------------------------------------------------
	local spawnStyle = { Floor = RGB(230, 215, 185), FloorMaterial = Enum.Material.CeramicTiles, Roof = RGB(200, 90, 60), RoofMaterial = Enum.Material.ClayRoofTiles }
	Kit.spawnArea(teams[1], CFrame.new(-145, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-145, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-118, 0, 12))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-118, 0, 12))
	Kit.bounds(320, 220, 60)

	-- Malecón con barandilla hacia el mar (lado +Z) y fachadas al otro lado (lado -Z)
	block("SeaWall", V(320, 3, 3), CFrame.new(0, 1.5, 111.5), STONE_DARK, Enum.Material.Limestone)
	Kit.railing(V(-160, 3, 111.5), V(160, 3, 111.5), 2.5, RGB(240, 240, 245))
	for x = -150, 150, 30 do
		local h = 18 + (math.abs(x) % 4) * 4
		block("BackHouse", V(28, h, 10), CFrame.new(x, h / 2, -116), (x / 30) % 2 == 0 and PLASTER or RGB(240, 210, 180), Enum.Material.Plaster)
		deco("BackRoof", V(29, 1.5, 11), CFrame.new(x, h + 0.75, -116), RGB(200, 90, 60), Enum.Material.ClayRoofTiles)
		for wx = -9, 9, 6 do
			deco("BackWindow", V(2.4, 3, 0.2), CFrame.new(x + wx, h * 0.6, -110.9), RGB(60, 70, 90), Enum.Material.Glass)
		end
	end
	for z = -90, 90, 30 do
		for _, sx in { -1, 1 } do
			block("SideHouse", V(10, 22, 28), CFrame.new(sx * 167, 11, z), PLASTER, Enum.Material.Plaster)
			deco("SideRoof", V(11, 1.5, 29), CFrame.new(sx * 167, 22.75, z), RGB(200, 90, 60), Enum.Material.ClayRoofTiles)
		end
	end

	-- Mar, isla del faro y barco (fondo)
	workspace.Terrain:FillBlock(CFrame.new(0, -12, 322), V(900, 20, 420), Enum.Material.Water)
	Kit.lighthouse(V(120, 0, 300))
	Kit.ship(CFrame.new(-140, -2, 250) * CFrame.Angles(0, math.rad(10), 0), 110)
	Kit.crane(CFrame.new(-60, 0, 150), 42)
	Kit.crane(CFrame.new(40, 0, 160) * CFrame.Angles(0, math.rad(20), 0), 38)

	---------------------------------------------------------------------------
	-- Modos: puntos libres y zonas
	---------------------------------------------------------------------------
	for _, p in {
		V(-130, 0.5, 45), V(-90, 0.5, -15), V(-50, 0.5, 30), V(-40, 0.5, -70), V(-100, 15.5, 72),
		V(-60, 10.5, 55), V(-10, LEDGE_Y + 0.5, 60), V(-70, 0.5, 90), V(-150, 0.5, -60), V(-25, 0.5, -10),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	-- Buscar y destruir: sitios A y B en la mitad de cada equipo
	for _, site in { { V(-70, 0, 90), "A" }, { V(-40, 0, -70), "B" } } do
		Kit.bombSite(site[1], site[2], 1)
		Kit.bombSite(Kit.MIRROR * site[1], site[2], 2)
	end
	Kit.zone(V(0, 0, 0), 9, 1)
	Kit.zone(V(-60, 10, 55), 10, 2)
	Kit.zone(V(60, 10, -55), 10, 3)
	Kit.zone(V(-40, 0, -45), 12, 4)
	Kit.zone(V(40, 0, 45), 12, 5)
	-- Realismo: polvo y polen flotando a contraluz sobre el mercado y el puente
	Kit.dustMotes(CFrame.new(0, 7, 0), Vector3.new(120, 12, 60), Color3.fromRGB(255, 245, 215), 16)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">HauntedManor</string>
              <string name="Source"><![CDATA[-- MANSIÓN ENCANTADA (mapa de Halloween): de noche, con luna grande y niebla violeta. Mansión en el
-- centro con planta baja de lado a lado y azotea con almenas (escaleras por fuera), cementerios con
-- lápidas como cobertura, criptas, árboles secos, calabazas, faroles naranjas y un caldero de bruja.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)

local Map = {
	Id = "HauntedManor",
	Name = "Mansión Encantada",
	Icon = "🎃",
	Description = "Halloween · noche · mansión y cementerios",
}

Map.Lighting = {
	CartoonNeutral = { Hue = 0.76, Sat = 0.2 }, -- grises violetas
	ClockTime = 0.2,
	Brightness = 1.2,
	Exposure = 0.3,
	Ambient = Color3.fromRGB(60, 45, 85),
	OutdoorAmbient = Color3.fromRGB(85, 70, 120),
	Atmosphere = { Density = 0.38, Offset = 0.1, Color = Color3.fromRGB(110, 80, 150), Decay = Color3.fromRGB(60, 35, 90), Glare = 0, Haze = 2.4 },
	Color = { Saturation = 0.25, Contrast = 0.15, Brightness = 0.04, Tint = Color3.fromRGB(245, 235, 255) },
	Bloom = { Intensity = 0.9, Size = 26, Threshold = 1.4 },
	Clouds = 0.4,
	CloudColor = Color3.fromRGB(90, 70, 120),
	SunRays = 0,
	Stars = 4000,
	MoonSize = 22,
	TerrainColors = {
		Grass = Color3.fromRGB(70, 90, 70),
		LeafyGrass = Color3.fromRGB(60, 80, 65),
	},
}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad

local GRASS = RGB(70, 95, 75)
local STONE = RGB(120, 115, 135)
local STONE_DARK = RGB(85, 80, 100)
local WOOD = RGB(90, 60, 45)
local ROOF = RGB(70, 40, 90)
local ORANGE = RGB(255, 140, 40)
local GLOW = RGB(255, 190, 90)

local LENGTH, WIDTH = 190, 130

local function wall(name, cf, size, color)
	local part = Kit.block(name, size, cf * CFrame.new(0, size.Y / 2, 0), color or STONE, Enum.Material.SmoothPlastic)
	Kit.deco(name .. "Cap", V(size.X + 0.4, 0.6, size.Z + 0.4), cf * CFrame.new(0, size.Y + 0.3, 0), STONE_DARK, Enum.Material.SmoothPlastic)
	return part
end

-- Lápida (cobertura baja): losa con parte de arriba redondeada
local function gravestone(cf, w)
	w = w or 2.4
	Kit.block("Gravestone", V(w, 2.6, 0.7), cf * CFrame.new(0, 1.3, 0), STONE, Enum.Material.SmoothPlastic)
	-- Medio disco arriba: cilindro con el eje hacia delante (Z), del mismo grosor que la losa
	local top = Kit.cylinder("GravestoneTop", 0.7, w, cf * CFrame.new(0, 2.6, 0) * CFrame.Angles(rad(90), 0, 0), STONE, Enum.Material.SmoothPlastic)
	top.CastShadow = false
	Kit.deco("GravestoneCross", V(0.2, 0.9, 0.05), cf * CFrame.new(0, 1.7, -0.37), STONE_DARK, Enum.Material.SmoothPlastic)
	Kit.deco("GravestoneCrossBar", V(0.6, 0.18, 0.05), cf * CFrame.new(0, 1.9, -0.37), STONE_DARK, Enum.Material.SmoothPlastic)
end

-- Árbol seco retorcido (decoración, se atraviesa por las ramas)
local function deadTree(position, scale, seed)
	local rng = Random.new(seed)
	local h = 10 * scale
	Kit.cylinder("DeadTrunk", h, 1.2 * scale, CFrame.new(position + V(0, h / 2, 0)) * CFrame.Angles(0, 0, rad(rng:NextNumber(-6, 6))), WOOD, Enum.Material.SmoothPlastic)
	for i = 1, 4 do
		local y = h * (0.45 + i * 0.12)
		local a = rng:NextNumber(0, math.pi * 2)
		local len = rng:NextNumber(3, 5) * scale
		local dir = V(math.cos(a), 0.6, math.sin(a)).Unit
		local mid = position + V(0, y, 0) + dir * len / 2
		Kit.deco("DeadBranch", V(0.45 * scale, 0.45 * scale, len), CFrame.lookAt(mid, mid + dir), WOOD, Enum.Material.SmoothPlastic)
	end
end

-- Farol de hierro con luz naranja
local function lamp(position)
	Kit.cylinder("LampPost", 7, 0.35, CFrame.new(position + V(0, 3.5, 0)), RGB(30, 28, 36), Enum.Material.SmoothPlastic, nil, true)
	local glass = Kit.deco("LampGlow", V(0.9, 1.1, 0.9), CFrame.new(position + V(0, 7.4, 0)), GLOW, Enum.Material.Neon)
	Kit.deco("LampCap", V(1.3, 0.3, 1.3), CFrame.new(position + V(0, 8.1, 0)), RGB(30, 28, 36), Enum.Material.SmoothPlastic)
	Kit.light(glass, "PointLight", ORANGE, 16, 1.2)
end

-- Cripta pequeña (cobertura grande con puerta oscura)
local function crypt(cf)
	Kit.block("Crypt", V(8, 6, 6), cf * CFrame.new(0, 3, 0), STONE_DARK, Enum.Material.SmoothPlastic)
	Kit.block("CryptRoof", V(9, 1, 7), cf * CFrame.new(0, 6.5, 0), ROOF, Enum.Material.SmoothPlastic)
	Kit.deco("CryptDoor", V(2.6, 4, 0.2), cf * CFrame.new(0, 2, -3.05), RGB(20, 15, 25), Enum.Material.SmoothPlastic)
	Kit.deco("CryptCross", V(0.4, 2, 0.4), cf * CFrame.new(0, 8, 0), STONE, Enum.Material.SmoothPlastic)
	Kit.deco("CryptCrossBar", V(1.4, 0.4, 0.4), cf * CFrame.new(0, 8.4, 0), STONE, Enum.Material.SmoothPlastic)
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	folder:SetAttribute("Ambience", "Night") -- (sonido ambiente: ver Ambience en el cliente)
	Kit.applyLighting(Map.Lighting)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Suelo de hierba oscura y camino de piedra central
	block("Floor", V(LENGTH + 40, 2, WIDTH + 40), CFrame.new(0, -1, 0), GRASS, Enum.Material.SmoothPlastic)
	block("Path", V(LENGTH - 20, 0.2, 12), CFrame.new(0, 0.1, 0), STONE_DARK, Enum.Material.SmoothPlastic)

	-- Muro perimetral con verja
	for _, z in { -1, 1 } do
		wall("OuterWall", CFrame.new(0, 0, z * (WIDTH / 2 + 1.5)), V(LENGTH + 6, 16, 3))
	end
	for _, x in { -1, 1 } do
		wall("OuterWall", CFrame.new(x * (LENGTH / 2 + 1.5), 0, 0), V(3, 16, WIDTH + 6))
	end

	-- Mansión central: planta baja de lado a lado (puertas en ±X), ventanas y azotea con almenas
	local w, d, h, t = 36, 24, 10, 1.6
	for _, z in { -1, 1 } do
		-- Paredes largas con ventanas (tres huecos a media altura)
		block("ManorWallLow", V(w, 3.5, t), CFrame.new(0, 1.75, z * (d / 2 - t / 2)), STONE, Enum.Material.SmoothPlastic)
		block("ManorWallHigh", V(w, h - 6.5, t), CFrame.new(0, 6.5 + (h - 6.5) / 2, z * (d / 2 - t / 2)), STONE, Enum.Material.SmoothPlastic)
		for _, x in { -15.5, -5.5, 5.5, 15.5 } do
			block("ManorWallMid", V(5, 3, t), CFrame.new(x, 5, z * (d / 2 - t / 2)), STONE, Enum.Material.SmoothPlastic)
		end
		for _, x in { -10.5, 0, 10.5 } do
			deco("ManorWindowGlow", V(4.6, 0.3, t + 0.1), CFrame.new(x, 6.4, z * (d / 2 - t / 2)), GLOW, Enum.Material.Neon)
		end
	end
	for _, x in { -1, 1 } do
		-- Paredes cortas con puerta grande en el centro
		local side = (d - 2 * t - 6) / 2
		for _, s in { -1, 1 } do
			block("ManorWallEnd", V(t, h, side), CFrame.new(x * (w / 2 - t / 2), h / 2, s * (3 + side / 2)), STONE, Enum.Material.SmoothPlastic)
		end
		block("ManorLintel", V(t, h - 7, 6), CFrame.new(x * (w / 2 - t / 2), 7 + (h - 7) / 2, 0), STONE, Enum.Material.SmoothPlastic)
		deco("ManorDoorFrame", V(t + 0.2, 0.5, 6.4), CFrame.new(x * (w / 2 - t / 2), 7.2, 0), ORANGE, Enum.Material.SmoothPlastic)
	end
	block("ManorRoof", V(w, 1, d), CFrame.new(0, h + 0.5, 0), ROOF, Enum.Material.SmoothPlastic)
	for _, z in { -1, 1 } do
		for x = -15, 15, 6 do
			block("Battlement", V(3, 1.6, 0.8), CFrame.new(x, h + 1.8, z * (d / 2 - 0.4)), STONE_DARK, Enum.Material.SmoothPlastic)
		end
	end
	-- Torreones con tejado puntiagudo y ventana iluminada en dos esquinas de la azotea (simétricos)
	Kit.symmetric(function(m)
		Kit.cylinder("Turret", 6, 4, m * CFrame.new(-14, h + 4, -8), STONE_DARK, Enum.Material.SmoothPlastic)
		Kit.deco("TurretRoof", V(4.6, 3, 4.6), m * CFrame.new(-14, h + 8.5, -8) * CFrame.Angles(0, rad(45), 0), ROOF, Enum.Material.SmoothPlastic)
		Kit.deco("TurretWindow", V(1, 1.4, 0.2), m * CFrame.new(-14, h + 4.5, -10.05), GLOW, Enum.Material.Neon)
	end)
	-- Lámpara de araña dentro
	local chandelier = deco("Chandelier", V(3, 0.4, 3), CFrame.new(0, h - 1.2, 0), GLOW, Enum.Material.Neon)
	Kit.light(chandelier, "PointLight", ORANGE, 18, 1.2)

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(255, 90, 90) or RGB(90, 150, 255)
		-- Escalera exterior a la azotea (pegada a la pared larga)
		Kit.stairs((m * CFrame.new(-w / 2 - 6, 0, -(d / 2 + 3))).Position, (m * CFrame.new(4, h + 1, -(d / 2 + 3))).Position, 5, STONE_DARK, Enum.Material.SmoothPlastic)
		block("StairLanding", V(6, 1, 6), m * CFrame.new(7, h + 0.5, -(d / 2 + 3)), STONE_DARK, Enum.Material.SmoothPlastic)

		-- Cementerio: lápidas en filas
		for row = 0, 2 do
			for col = 0, 3 do
				local x = -40 - col * 6.5 + (row % 2) * 3
				local z = 24 + row * 9
				gravestone(m * CFrame.new(x, 0, z) * CFrame.Angles(0, rad((col * 7 + row * 3) % 12 - 6), 0))
			end
		end
		crypt(m * CFrame.new(-36, 0, -36))
		crypt(m * CFrame.new(-70, 0, 44) * CFrame.Angles(0, rad(90), 0))

		-- Coberturas sueltas: tapias de piedra rotas y ataúdes
		wall("BrokenWall", m * CFrame.new(-30, 0, 10), V(10, 4, 1.5))
		wall("BrokenWall", m * CFrame.new(-52, 0, -14) * CFrame.Angles(0, rad(90), 0), V(9, 3.5, 1.5))
		block("Coffin", V(2.4, 1.6, 6), m * CFrame.new(-20, 0.8, -24) * CFrame.Angles(0, rad(20), 0), WOOD, Enum.Material.SmoothPlastic)
		Kit.deco("CoffinCross", V(0.3, 0.05, 2), m * CFrame.new(-20, 1.62, -24) * CFrame.Angles(0, rad(20), 0), ORANGE, Enum.Material.SmoothPlastic)

		-- Caldero de bruja con líquido verde brillante
		local cauldron = m * CFrame.new(-24, 0, 36)
		Kit.cylinder("Cauldron", 3, 4.2, cauldron * CFrame.new(0, 1.5, 0), RGB(25, 22, 30), Enum.Material.SmoothPlastic)
		local goo = Kit.cylinder("CauldronGoo", 0.3, 3.6, cauldron * CFrame.new(0, 3.05, 0), RGB(120, 255, 90), Enum.Material.Neon, nil, true)
		Kit.light(goo, "PointLight", RGB(120, 255, 90), 14, 1.2)

		-- Árboles secos, faroles y calabazas
		deadTree((m * CFrame.new(-74, 0, -48)).Position, 1.1, 3)
		deadTree((m * CFrame.new(-58, 0, 50)).Position, 1.3, 7)
		deadTree((m * CFrame.new(-12, 0, -46)).Position, 1, 11)
		for _, p in { V(-26, 0, -6), V(-62, 0, 8), V(-40, 0, 52), V(-86, 0, -40) } do
			lamp((m * CFrame.new(p)).Position)
		end
		for i, p in { V(-34, 0, 22), V(-60, 0, -28), V(-16, 0, 16), V(-48, 0, -48) } do
			Kit.pumpkin(m * CFrame.new(p) * CFrame.Angles(0, rad(i * 70), 0), 1 + (i % 2) * 0.3)
		end
		_ = teamColor
	end)

	-- Bases y banderas
	local spawnStyle = { Floor = STONE_DARK, Roof = ROOF }
	Kit.spawnArea(teams[1], CFrame.new(-80, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-80, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-56, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-56, 0, 0))

	-- Fondo: árboles secos y colinas oscuras
	Kit.bounds(LENGTH, WIDTH, 45)
	local n = 0
	for x = -130, 130, 24 do
		for _, z in { -1, 1 } do
			n += 1
			deadTree(V(x + z * 8, 0, z * (WIDTH / 2 + 14 + (n % 3) * 7)), 1.4 + (n % 3) * 0.2, n)
		end
	end
	for x = -180, 180, 70 do
		for _, z in { -1, 1 } do
			Kit.naturalHill(V(x, -18, z * 125), 48, Enum.Material.Grass, { Inward = V(0, 0, -z), Top = Enum.Material.LeafyGrass, RockCount = 1 })
		end
	end
	for _, sx in { -1, 1 } do
		for _, z in { -50, 20 } do
			Kit.naturalHill(V(sx * 150, -18, z), 48, Enum.Material.Grass, { Inward = V(-sx, 0, 0), Top = Enum.Material.LeafyGrass, RockCount = 1 })
		end
	end

	-- Modos
	for _, p in {
		V(-66, 0.5, 14), V(-66, 0.5, -14), V(-40, 0.5, 0), V(-30, 0.5, 30), V(-44, 0.5, -30),
		V(-12, 0.5, 0), V(-24, 0.5, -16), V(-6, h + 1.5, 4), V(-56, 0.5, 34), V(-80, 0.5, -46),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, h + 1, 0), 6, 1)
	Kit.zone(V(0, 0.2, 0), 6, 2)
	Kit.zone(V(-40, 0, 32), 6, 3)
	Kit.zone(V(40, 0, -32), 6, 4)
	Kit.zone(V(-28, 0, -36), 5, 5)
	Kit.dustMotes(CFrame.new(0, 8, 0), V(120, 14, 80), Color3.fromRGB(190, 150, 255), 14)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">JungleTemple</string>
              <string name="Source"><![CDATA[-- JUNGLE TEMPLE: ruinas en la selva. Pirámide escalonada en el centro con un santuario y una gema
-- que gira, rodeada por un foso de agua; salones de columnas en ruinas, plataformas de piedra con
-- enredaderas, cabezas de piedra gigantes, antorchas, árboles enormes y cascadas al fondo.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)
local Variants = require(script.Parent.Parent.LightingVariants)

local Map = {
	Id = "JungleTemple",
	Name = "Jungle Temple",
	Icon = "🌴",
	Description = "Selva · mediodía · pirámide y cascadas",
}

Map.Lighting = {
	CartoonNeutral = { Hue = 0.2, Sat = 0.17 }, -- tono de los grises en estilo Cartoon
	ClockTime = 13.2,
	Brightness = 2.8,
	Exposure = 0.05,
	Ambient = Color3.fromRGB(55, 62, 48),
	OutdoorAmbient = Color3.fromRGB(115, 128, 100),
	Atmosphere = { Density = 0.36, Offset = 0.2, Color = Color3.fromRGB(195, 220, 185), Decay = Color3.fromRGB(110, 140, 100), Glare = 0.3, Haze = 2 },
	Color = { Saturation = 0.14, Contrast = 0.16, Brightness = 0.01, Tint = Color3.fromRGB(255, 250, 235) },
	Bloom = { Intensity = 0.5, Size = 24, Threshold = 2 },
	Clouds = 0.6,
	SunRays = 0.14,
	Wind = Vector3.new(3, 0, 1.5),
	Water = { Color = Color3.fromRGB(40, 115, 95), Reflectance = 0.6, Transparency = 0.55, WaveSize = 0.05, WaveSpeed = 6 },
	TerrainColors = {
		Grass = Color3.fromRGB(88, 140, 58),
		LeafyGrass = Color3.fromRGB(70, 125, 50),
		Mud = Color3.fromRGB(105, 80, 52),
		Ground = Color3.fromRGB(110, 92, 62),
		Rock = Color3.fromRGB(120, 116, 100),
	},
}
-- A veces sale con otra luz o con mal tiempo (ver LightingVariants)
Map.LightingVariants = { Variants.Storm(0.3), Variants.Fog(0.25) }

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad

local STONE = RGB(150, 145, 125)
local STONE_DARK = RGB(110, 108, 92)
local MOSS = RGB(95, 130, 70)
local JADE = RGB(40, 255, 140)
local GRASS = RGB(85, 135, 60)

-- Árbol de la selva: tronco alto y copa de varias bolas de hojas
local function jungleTree(position, scale)
	scale = scale or 1
	Kit.cylinder("JungleTrunk", 16 * scale, 2.2 * scale, CFrame.new(position + V(0, 8 * scale, 0)), RGB(100, 75, 50), Enum.Material.Wood)
	for i, spec in { { V(0, 17, 0), 12 }, { V(4, 15.5, 2), 9 }, { V(-4, 16, -2.5), 9.5 }, { V(1, 20, -1), 8 } } do
		local leaf = Kit.ball("Canopy" .. i, spec[2] * scale, CFrame.new(position + spec[1] * scale), i % 2 == 0 and RGB(45, 120, 50) or RGB(60, 145, 55), Enum.Material.LeafyGrass, true)
		leaf.CastShadow = true
	end
	-- Lianas que cuelgan de la copa
	for i = 0, 2 do
		local angle = i * 2.1 + position.X * 0.13
		local length = (4 + (i * 1.7 + position.Z * 0.1) % 3) * scale
		local top = position + V(math.cos(angle) * 3.4, 12.5, math.sin(angle) * 3.4) * scale
		Kit.deco("Liana", V(0.25, length, 0.25) * V(scale, 1, scale), CFrame.new(top - V(0, length / 2, 0)), RGB(62, 105, 48), Enum.Material.LeafyGrass)
	end
	for i = 0, 3 do
		local angle = i * math.pi / 2 + 0.4
		Kit.deco("Root", V(1, 1.4, 4.5) * scale, CFrame.new(position + V(math.cos(angle) * 2.2, 0.5, math.sin(angle) * 2.2) * scale) * CFrame.Angles(0, -angle + math.pi / 2, rad(-15)), RGB(90, 68, 45), Enum.Material.Wood)
	end
end

-- Helecho (decoración del suelo)
local function fern(position)
	for i = 0, 4 do
		local angle = i * math.pi * 2 / 5
		Kit.deco("Fern", V(0.8, 0.15, 3.5), CFrame.new(position) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0.6, -1.5) * CFrame.Angles(rad(25), 0, 0), RGB(70, 155, 60), Enum.Material.Grass)
	end
end

-- Antorcha con fuego de verdad
local function torch(cf)
	Kit.cylinder("TorchPost", 5, 0.7, cf * CFrame.new(0, 2.5, 0), RGB(95, 70, 45), Enum.Material.Wood)
	local bowl = Kit.cylinder("TorchBowl", 0.8, 1.6, cf * CFrame.new(0, 5.2, 0), STONE_DARK, Enum.Material.Slate, nil, true)
	local fire = Instance.new("Fire")
	fire.Size = 3
	fire.Heat = 6
	fire.Color = RGB(255, 140, 40)
	fire.SecondaryColor = RGB(255, 220, 80)
	fire.Parent = bowl
	Kit.light(bowl, "PointLight", RGB(255, 160, 70), 18, 1.6)
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	folder:SetAttribute("Ambience", "Jungle") -- (sonido ambiente: ver Ambience en el cliente)
	Kit.applyLighting(Kit.pickLighting(Map))
	folder:SetAttribute("Variant", Kit.Variant)
	folder:SetAttribute("Weather", Kit.Weather)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Suelo de terreno con hierba 3D animada y caminos de barro (sin hierba)
	Kit.terrainFloor(Enum.Material.Grass, 340, 240)
	for _, z in { -60, 60 } do
		Kit.terrainPatch(CFrame.new(0, 0, z), V(260, 4, 8), Enum.Material.Mud)
	end
	Kit.terrainPatch(CFrame.new(0, 0, 0), V(260, 4, 8), Enum.Material.Mud)
	-- Tierra bajo las bases, salones y plataformas (para que la hierba no atraviese los suelos)
	for _, cf in { CFrame.new(-145, 0, 0), Kit.MIRROR * CFrame.new(-145, 0, 0) } do
		Kit.terrainPatch(cf, V(36, 4, 76), Enum.Material.Ground)
	end
	for _, cf in { CFrame.new(-112, 0, 10), Kit.MIRROR * CFrame.new(-112, 0, 10) } do
		Kit.terrainPatch(cf, V(20, 4, 20), Enum.Material.Ground)
	end

	-- Foso de agua alrededor de la pirámide (poco profundo) y puentes de piedra
	workspace.Terrain:FillCylinder(CFrame.new(0, 0.6, 0), 1.2, 31, Enum.Material.Water)
	for _, angle in { 0, 90 } do
		block("MoatBridge", V(66, 0.8, 7), CFrame.new(0, 0.4, 0) * CFrame.Angles(0, rad(angle), 0), STONE, Enum.Material.Cobblestone)
	end

	-- Pirámide escalonada con escaleras en dos lados
	for i, size in { 30, 24, 18, 12 } do
		local y = 1.5 + (i - 1) * 3
		block("PyramidTier", V(size, 3, size), CFrame.new(0, y, 0), i % 2 == 0 and STONE or STONE_DARK, Enum.Material.Slate)
		deco("PyramidMoss", V(size + 0.1, 0.4, size + 0.1), CFrame.new(0, y + 1.3, 0), MOSS, Enum.Material.LeafyGrass)
	end
	-- Santuario en la cima con la gema
	for _, x in { -4.5, 4.5 } do
		for _, z in { -4.5, 4.5 } do
			block("ShrineColumn", V(1.6, 7, 1.6), CFrame.new(x, 15.5, z), STONE, Enum.Material.Slate)
		end
	end
	block("ShrineRoof", V(12, 1.2, 12), CFrame.new(0, 19.6, 0), STONE_DARK, Enum.Material.Slate)
	block("ShrineRoofTop", V(7, 1.2, 7), CFrame.new(0, 20.8, 0), STONE, Enum.Material.Slate)
	local gem = deco("JadeGem", V(1.8, 2.6, 1.8), CFrame.new(0, 16, 0) * CFrame.Angles(0, 0, rad(45)), JADE, Enum.Material.Neon)
	gem:SetAttribute("Spin", 60)
	gem:SetAttribute("Bob", 0.4)
	Kit.light(gem, "PointLight", JADE, 22, 2.5)
	block("GemAltar", V(3, 1.6, 3), CFrame.new(0, 12.8, 0), STONE_DARK, Enum.Material.Slate)

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(255, 60, 80) or RGB(60, 140, 255)

		-- Escalinata de la pirámide (desde el puente)
		Kit.stairs(m * V(-27, 0.8, 0), m * V(-6, 12, 0), 6, STONE, Enum.Material.Cobblestone)

		-- Salón de columnas en ruinas
		local hall = m * CFrame.new(-78, 0, -55)
		Kit.terrainPatch(hall, V(32, 4, 24), Enum.Material.Ground)
		block("HallFloor", V(28, 1, 20), hall * CFrame.new(0, 0.5, 0), STONE, Enum.Material.Cobblestone)
		for i, x in { -12, -4, 4, 12 } do
			for _, z in { -8, 8 } do
				local broken = (i + (z > 0 and 1 or 0)) % 3 == 0
				local h = broken and 6 or 12
				Kit.cylinder("HallColumn", h, 2.4, hall * CFrame.new(x, 1 + h / 2, z), STONE, Enum.Material.Slate)
				deco("ColumnMoss", V(2.6, 1, 2.6), hall * CFrame.new(x, 1.5, z), MOSS, Enum.Material.LeafyGrass)
			end
		end
		block("HallRoof", V(16, 1.6, 20), hall * CFrame.new(-6, 13.8, 0), STONE_DARK, Enum.Material.Slate)
		Kit.vines(hall * CFrame.new(-6, 13, -10.2), 14, 6)
		Kit.vines(hall * CFrame.new(-6, 13, 10.2), 14, 6)
		block("Rubble", V(5, 2.5, 4), hall * CFrame.new(8, 2.25, 2) * CFrame.Angles(0, rad(20), rad(8)), STONE_DARK, Enum.Material.Slate)
		block("Rubble", V(3, 2, 3), hall * CFrame.new(5, 2, -3) * CFrame.Angles(0, rad(-35), 0), STONE, Enum.Material.Slate)
		torch(hall * CFrame.new(16, 0, -11))
		torch(hall * CFrame.new(16, 0, 11))

		-- Plataforma de piedra elevada (puesto de tirador) con parapetos y enredaderas
		local plat = m * CFrame.new(-70, 0, 50)
		block("Platform", V(20, 10, 16), plat * CFrame.new(0, 5, 0), STONE_DARK, Enum.Material.Slate)
		deco("PlatformMoss", V(20.2, 0.4, 16.2), plat * CFrame.new(0, 9.9, 0), MOSS, Enum.Material.LeafyGrass)
		block("Parapet", V(20, 1.4, 1), plat * CFrame.new(0, 10.7, -7.5), STONE, Enum.Material.Slate)
		block("Parapet", V(20, 1.4, 1), plat * CFrame.new(0, 10.7, 7.5), STONE, Enum.Material.Slate)
		block("Parapet", V(1, 1.4, 14), plat * CFrame.new(-9.5, 10.7, 0), STONE, Enum.Material.Slate)
		block("Parapet", V(1, 1.4, 4), plat * CFrame.new(9.5, 10.7, -5), STONE, Enum.Material.Slate)
		Kit.stairs(m * V(-48, 0, 53), m * V(-60.2, 10, 53), 5, STONE, Enum.Material.Cobblestone)
		Kit.vines(plat * CFrame.new(0, 10, -8.2), 18, 7)
		Kit.vines(plat * CFrame.new(0, 10, 8.2) * CFrame.Angles(0, math.pi, 0), 18, 7)
		local glyph = deco("Glyph", V(0.3, 3, 3), plat * CFrame.new(10.05, 5, -3), teamColor, Enum.Material.Neon)
		glyph.Transparency = 0.2
		torch(plat * CFrame.new(12, 0, -10))

		-- Cabeza de piedra gigante mirando al centro (cobertura)
		local head = m * CFrame.new(-38, 0, -12)
		block("StoneHead", V(8, 9, 8), head * CFrame.new(0, 4.5, 0), RGB(125, 130, 112), Enum.Material.Slate)
		block("StoneHelmet", V(8.6, 2, 8.6), head * CFrame.new(0, 9.5, 0), STONE_DARK, Enum.Material.Slate)
		for _, z in { -1.8, 1.8 } do
			deco("StoneEye", V(0.3, 1, 1.6), head * CFrame.new(4.05, 6, z), JADE, Enum.Material.Neon)
		end
		deco("StoneNose", V(1, 2, 1.4), head * CFrame.new(4.4, 4.6, 0), RGB(115, 120, 102), Enum.Material.Slate)
		deco("StoneMouth", V(0.3, 0.8, 3.6), head * CFrame.new(4.05, 2.6, 0), RGB(60, 60, 52), Enum.Material.Slate)

		-- Muros en ruinas como cobertura
		block("RuinWall", V(2, 5, 12), m * CFrame.new(-28, 2.5, 32), STONE, Enum.Material.Cobblestone)
		block("RuinWall", V(12, 4, 2), m * CFrame.new(-55, 2, 15), STONE, Enum.Material.Cobblestone)
		block("RuinWall", V(2, 6, 14), m * CFrame.new(-100, 3, -22), STONE, Enum.Material.Cobblestone)
		block("RuinWall", V(10, 3, 2), m * CFrame.new(-22, 1.5, -40), STONE_DARK, Enum.Material.Cobblestone)
		for _, p in { V(-28, 5.2, 28), V(-100, 6.2, -18) } do
			deco("WallMoss", V(2.2, 0.5, 5), m * CFrame.new(p), MOSS, Enum.Material.LeafyGrass)
		end
		torch(m * CFrame.new(-45, 0, -30))
		torch(m * CFrame.new(-95, 0, 25))

		-- Árboles y vegetación
		for i, p in { V(-120, 0, 72), V(-98, 0, 96), V(-58, 0, 94), V(-30, 0, -84), V(-112, 0, -82), V(-135, 0, -58), V(-24, 0, 88) } do
			jungleTree(m * p, 0.9 + (i % 3) * 0.15)
		end
		for _, p in { V(-35, 0, 45), V(-88, 0, 10), V(-60, 0, -10), V(-15, 0, -70), V(-120, 0, 30) } do
			fern(m * p)
		end
		Kit.palm(m * CFrame.new(-50, 0, 80), 15)
		Kit.palm(m * CFrame.new(-128, 0, -95), 13)
		-- Sotobosque: arbustos densos junto a los bordes y las ruinas, más helechos, troncos caídos
		-- (cobertura baja) y rocas medio enterradas
		for i, p in {
			V(-140, 0, 100), V(-118, 0, 101), V(-78, 0, 101), V(-40, 0, 99), V(-8, 0, 101),
			V(-150, 0, -100), V(-100, 0, -101), V(-70, 0, -99), V(-48, 0, -101),
			V(-155, 0, 62), V(-155, 0, -62), V(-31, 0, 41), V(-96, 0, -64), V(-60, 0, -67), V(-84, 0, 42),
		} do
			Kit.bush(m * p, 0.9 + (i % 3) * 0.2)
		end
		for _, p in { V(-130, 0, 62), V(-82, 0, -30), V(-52, 0, 66), V(-8, 0, -84), V(-138, 0, -74), V(-92, 0, 84) } do
			fern(m * p)
		end
		Kit.log(m * CFrame.new(-90, 0, -38) * CFrame.Angles(0, rad(30), 0), 10, 2.2)
		Kit.log(m * CFrame.new(-36, 0, 70) * CFrame.Angles(0, rad(-20), 0), 9, 2)
		Kit.rockCluster(m * V(-150, 0, -82), 4)
		Kit.rockCluster(m * V(-62, 0, -102), 5)
		Kit.rockCluster(m * V(-132, 0, 104), 4)
		Kit.rockCluster(m * V(-26, 0, 101), 4)
		-- Flores y matas de hierba alta (estilo cartoon)
		for i, p in { V(-42, 0, 52), V(-90, 0, 18), V(-66, 0, -14), V(-22, 0, -76), V(-112, 0, 36), V(-130, 0, -40), V(-104, 0, 90) } do
			Kit.flowers(m * p, 3, i * 13)
		end
		for i, p in { V(-28, 0, 24), V(-56, 0, 18), V(-100, 0, -30), V(-80, 0, 40), V(-35, 0, -38), V(-120, 0, -60), V(-60, 0, 62), V(-14, 0, 30) } do
			Kit.grassTuft(m * p, 1 + (i % 3) * 0.2, i * 7)
		end

		-- Cascada al fondo con poza
		local fall = m * CFrame.new(-20, 0, -108)
		local water = deco("Waterfall", V(16, 46, 1), fall * CFrame.new(0, 23, 0), RGB(150, 210, 240), Enum.Material.Glass)
		water.Transparency = 0.35
		local foam = deco("WaterfallFoam", V(18, 1.5, 6), fall * CFrame.new(0, 0.8, 3), RGB(240, 250, 255), Enum.Material.SmoothPlastic)
		foam.Transparency = 0.4
		local mist = Instance.new("ParticleEmitter")
		mist.Texture = "rbxasset://textures/particles/smoke_main.dds"
		mist.Color = ColorSequence.new(Color3.new(1, 1, 1))
		mist.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 8) })
		mist.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) })
		mist.Lifetime = NumberRange.new(2, 3)
		mist.Speed = NumberRange.new(2, 5)
		mist.SpreadAngle = Vector2.new(50, 50)
		mist.Rate = 12
		mist.EmissionDirection = Enum.NormalId.Top
		mist.Parent = foam
		workspace.Terrain:FillBlock(fall * CFrame.new(0, 0.5, 7), V(26, 1, 10), Enum.Material.Water)
		-- Acantilado de roca con hierba por encima (de donde cae el agua)
		for i, x in { -30, -16, 0, 16, 30 } do
			local h = 18 + (i % 2) * 6
			workspace.Terrain:FillBall((fall * CFrame.new(x, h, -22)).Position, 20, Enum.Material.Rock)
			workspace.Terrain:FillBall((fall * CFrame.new(x * 0.9, h + 16, -26)).Position, 15, Enum.Material.Grass)
		end
	end)

	-- Hojas que caen lentamente sobre el mapa
	local sky = deco("FallingLeaves", V(320, 1, 220), CFrame.new(0, 45, 0), GRASS, Enum.Material.SmoothPlastic)
	sky.Transparency = 1
	local leaves = Instance.new("ParticleEmitter")
	leaves.Name = "Leaves"
	leaves.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	leaves.Color = ColorSequence.new(RGB(150, 210, 90), RGB(230, 210, 90))
	leaves.Size = NumberSequence.new(0.35)
	leaves.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.9, 0.2), NumberSequenceKeypoint.new(1, 1) })
	leaves.Lifetime = NumberRange.new(12, 15)
	leaves.Speed = NumberRange.new(2.5, 4)
	leaves.SpreadAngle = Vector2.new(25, 25)
	leaves.RotSpeed = NumberRange.new(-90, 90)
	leaves.Acceleration = V(0.3, 0, 0.15)
	leaves.Rate = 20
	leaves.EmissionDirection = Enum.NormalId.Bottom
	leaves.WindAffectsDrag = true
	leaves.Parent = sky

	-- Spawns y banderas
	local spawnStyle = { Floor = RGB(160, 150, 125), FloorMaterial = Enum.Material.Cobblestone, Roof = RGB(120, 95, 65), RoofMaterial = Enum.Material.WoodPlanks }
	Kit.spawnArea(teams[1], CFrame.new(-145, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-145, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-112, 0, 10))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-112, 0, 10))

	-- Límites, colinas y selva de fondo
	Kit.bounds(320, 220, 60)
	for x = -240, 240, 60 do
		for _, z in { -1, 1 } do
			-- Colinas irregulares con salientes de roca y manchas de selva (LeafyGrass) en la cima
			Kit.naturalHill(V(x - z * 20, -22, z * (170 + (math.abs(x) % 40))), 55 + (math.abs(x) % 3) * 10, Enum.Material.Grass, {
				Inward = V(0, 0, -z),
				Top = Enum.Material.LeafyGrass,
				TopCount = 6,
				RockCount = 2,
			})
		end
	end
	for z = -150, 150, 60 do
		for _, sx in { -1, 1 } do
			Kit.naturalHill(V(sx * 225, -20, z), 58, Enum.Material.Grass, { Inward = V(-sx, 0, 0), Top = Enum.Material.LeafyGrass, RockCount = 2 })
		end
	end
	for x = -150, 150, 24 do
		for _, z in { -1, 1 } do
			if math.abs(x - z * 20) > 14 then -- deja ver las cascadas
				jungleTree(V(x, 0, z * (124 + (math.abs(x) % 11))), 1.2)
			end
		end
	end

	-- Modos
	for _, p in {
		V(-130, 0.5, 45), V(-100, 0.5, -5), V(-70, 10.5, 50), V(-78, 1.5, -55), V(-45, 0.5, 8),
		V(-20, 0.5, -55), V(-110, 0.5, 80), V(-60, 0.5, -25), V(-12, 0.5, 55), V(-125, 0.5, -90),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, 12, 0), 6, 1)
	Kit.zone(V(-78, 1, -55), 9, 2)
	Kit.zone(V(78, 1, 55), 9, 3)
	Kit.zone(V(-45, 0, 32), 9, 4)
	Kit.zone(V(45, 0, -32), 9, 5)
	-- Realismo: motas de polen en la luz alrededor de la pirámide
	Kit.dustMotes(CFrame.new(0, 10, 0), Vector3.new(90, 18, 90), Color3.fromRGB(240, 255, 200), 18)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">MilitaryBase</string>
              <string name="Source"><![CDATA[-- BASE MILITAR: base de entrenamiento en un valle verde, al estilo de los mapas 5 contra 5 de los
-- shooters de móvil. Tres carriles: en el centro, el búnker de mando (dos plantas, se entra por los
-- cuatro lados) con la galería de tiro y los camiones; a un lado el hangar con una avioneta y
-- contenedores; al otro los barracones (dos plantas), las trincheras y la torre de vigilancia.
-- Simétrico por rotación. Siempre en estilo realista.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)
local RealKit = require(script.Parent.Parent.RealKit)

local Map = {
	Id = "MilitaryBase",
	Bomb = true, -- tiene sitios para Buscar y destruir
	Name = "Base Militar",
	Icon = "🪖",
	Description = "Base en el valle · hangar, búnker y trincheras · 5 contra 5",
	Realistic = true,
}

Map.Lighting = {
	ClockTime = 9.6,
	Latitude = 45,
	Brightness = 2.6,
	Exposure = 0,
	Ambient = Color3.fromRGB(70, 76, 80),
	OutdoorAmbient = Color3.fromRGB(135, 145, 150),
	ShadowSoftness = 0.15,
	Atmosphere = { Density = 0.32, Offset = 0.2, Color = Color3.fromRGB(200, 212, 220), Decay = Color3.fromRGB(110, 125, 135), Glare = 0.2, Haze = 1.6 },
	Color = { Saturation = -0.08, Contrast = 0.16, Brightness = 0, Tint = Color3.fromRGB(242, 246, 250) },
	Bloom = { Intensity = 0.4, Size = 24, Threshold = 2.2 },
	Clouds = 0.7,
	CloudColor = Color3.fromRGB(235, 238, 242),
	SunRays = 0.05,
	Wind = Vector3.new(5, 0, -2),
	TerrainColors = { Grass = Color3.fromRGB(88, 112, 62), LeafyGrass = Color3.fromRGB(78, 100, 56), Ground = Color3.fromRGB(110, 96, 74), Rock = Color3.fromRGB(110, 112, 110) },
}

-- Versiones de luz (a veces): niebla de primera hora (se ve menos de lejos)
Map.LightingVariants = {
	{
		Name = "Niebla",
		Chance = 0.3,
		ClockTime = 7.4,
		Brightness = 1.9,
		Ambient = Color3.fromRGB(80, 86, 92),
		OutdoorAmbient = Color3.fromRGB(140, 148, 156),
		Atmosphere = { Density = 0.48, Offset = 0.05, Color = Color3.fromRGB(205, 212, 218), Decay = Color3.fromRGB(150, 160, 170), Glare = 0, Haze = 3 },
		Color = { Saturation = -0.15, Contrast = 0.1, Brightness = 0.02, Tint = Color3.fromRGB(235, 242, 250) },
		Clouds = 0.85,
		SunRays = 0.02,
	},
	{
		Name = "Tormenta",
		Chance = 0.3,
		Weather = "Rain",
		ClockTime = 16,
		Brightness = 1.2,
		Exposure = -0.05,
		Ambient = Color3.fromRGB(60, 64, 70),
		OutdoorAmbient = Color3.fromRGB(100, 106, 115),
		Atmosphere = { Density = 0.42, Offset = 0.08, Color = Color3.fromRGB(150, 155, 165), Decay = Color3.fromRGB(90, 95, 105), Glare = 0, Haze = 2.6 },
		Color = { Saturation = -0.25, Contrast = 0.12, Brightness = 0, Tint = Color3.fromRGB(225, 232, 240) },
		Bloom = { Intensity = 0.3, Size = 20, Threshold = 2.4 },
		Clouds = 1,
		CloudColor = Color3.fromRGB(120, 124, 130),
		SunRays = 0,
		Wind = Vector3.new(14, 0, -6),
	},
	{
		-- Noche: las torres de focos encendidas iluminan la base
		Name = "Noche",
		Chance = 0.25,
		ClockTime = 22,
		Brightness = 1,
		Exposure = 0.35,
		Ambient = Color3.fromRGB(50, 56, 70),
		OutdoorAmbient = Color3.fromRGB(68, 78, 100),
		Atmosphere = { Density = 0.33, Offset = 0.1, Color = Color3.fromRGB(56, 64, 86), Decay = Color3.fromRGB(28, 32, 46), Glare = 0, Haze = 1.2 },
		Color = { Saturation = -0.1, Contrast = 0.2, Brightness = 0.02, Tint = Color3.fromRGB(210, 222, 255) },
		Bloom = { Intensity = 0.7, Size = 24, Threshold = 1.6 },
		Clouds = 0.35,
		CloudColor = Color3.fromRGB(58, 62, 78),
		SunRays = 0,
	},
}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad
local M = Enum.Material

local LENGTH, WIDTH = 400, 260
local FLOOR_H = RealKit.FLOOR_H
local building, solidBlock, sandbags = RealKit.building, RealKit.solidBlock, RealKit.sandbags
local block, deco = Kit.block, Kit.deco

local OLIVE = RGB(92, 98, 70)
local OLIVE_DARK = RGB(64, 68, 50)
local CONCRETE = RGB(150, 148, 142)

---------------------------------------------------------------------------
-- Piezas de la base
---------------------------------------------------------------------------

-- Muro en T de hormigón (cobertura alta)
local function tWall(cf)
	block("TWall", V(6, 7, 1.2), cf * CFrame.new(0, 3.5, 0), CONCRETE, M.Concrete)
	deco("TWallFoot", V(6, 1, 3.4), cf * CFrame.new(0, 0.5, 0), CONCRETE:Lerp(RGB(0, 0, 0), 0.08), M.Concrete).CanCollide = true
	deco("TWallStripe", V(6.05, 0.5, 1.25), cf * CFrame.new(0, 6, 0), RGB(230, 190, 40), M.Concrete)
	Kit.contactShadow(cf, 6.2, 3.6)
end

-- Fila de muros en T entre dos puntos (con hueco cada pocos)
local function tWallRow(a, b, gapEvery)
	local direction = b - a
	local count = math.floor(direction.Magnitude / 6.2)
	local cf = CFrame.lookAt(a, b) * CFrame.Angles(0, math.pi / 2, 0)
	for i = 0, count - 1 do
		if not gapEvery or (i + 1) % gapEvery ~= 0 then
			tWall(CFrame.new(a + direction.Unit * (i * 6.2 + 3.1)) * (cf - cf.Position))
		end
	end
end

-- Alambrada: postes y malla; se ve y se dispara a través, pero no se pasa
local function fence(a, b, height)
	height = height or 7
	local direction = b - a
	local length = direction.Magnitude
	local cf = CFrame.lookAt((a + b) / 2, b)
	local mesh = deco("Fence", V(0.15, height, length), cf * CFrame.new(0, height / 2, 0), RGB(150, 155, 160), M.DiamondPlate)
	mesh.Transparency = 0.75
	mesh.CastShadow = false
	-- Lo que choca va aparte, donde las balas y la vista no lo ven (se dispara a través)
	local collider = block("FenceCollider", V(0.4, height, length), cf * CFrame.new(0, height / 2, 0), RGB(150, 155, 160), nil, Kit.shootThroughFolder())
	collider.Transparency = 1
	collider.CastShadow = false
	local posts = math.max(1, math.floor(length / 8))
	for i = 0, posts do
		local p = a:Lerp(b, i / posts)
		deco("FencePost", V(0.35, height + 0.6, 0.35), CFrame.new(p + V(0, (height + 0.6) / 2, 0)), RGB(90, 92, 96), M.Metal)
	end
	deco("BarbedWire", V(0.3, 0.3, length), cf * CFrame.new(0, height + 0.5, 0), RGB(70, 70, 72), M.Metal)
end

-- Camión militar con lona (cobertura grande)
local function truck(cf)
	block("TruckCab", V(6.5, 6.5, 7.5), cf * CFrame.new(-8, 3.6, 0), OLIVE, M.Metal)
	deco("TruckWindshield", V(0.2, 2.2, 6.4), cf * CFrame.new(-11.3, 5.2, 0), RGB(30, 34, 38), M.Glass)
	block("TruckBed", V(13, 2, 7.5), cf * CFrame.new(2, 2.4, 0), OLIVE_DARK, M.Metal)
	block("TruckCanvas", V(12.5, 6, 7.3), cf * CFrame.new(2.2, 6.4, 0), RGB(84, 88, 62), M.Fabric)
	for _, x in { -8, 0.5, 5.5 } do
		for _, z in { -3.6, 3.6 } do
			local wheel = deco("Wheel", V(3, 3, 1.2), cf * CFrame.new(x, 1.5, z) * CFrame.Angles(0, math.pi / 2, 0), RGB(28, 28, 30), M.Rubber)
			wheel.Shape = Enum.PartType.Cylinder
		end
	end
	Kit.contactShadow(cf * CFrame.new(-1.5, 0, 0), 20, 8)
end

-- Avioneta (dentro del hangar)
local function plane(cf)
	local body = RGB(176, 180, 176)
	Kit.pipe("Fuselage", 22, 4, cf * CFrame.new(0, 4, 0), body, M.Metal)
	block("Wing", V(6, 0.5, 30), cf * CFrame.new(-1, 4.6, 0), body, M.Metal)
	block("TailWing", V(3, 0.4, 10), cf * CFrame.new(9.5, 5, 0), body, M.Metal)
	block("TailFin", V(3, 4.5, 0.4), cf * CFrame.new(10, 7.2, 0), RGB(150, 60, 50), M.Metal)
	deco("Cockpit", V(4, 1.6, 2.6), cf * CFrame.new(-5, 6.3, 0), RGB(40, 48, 58), M.Glass)
	deco("Propeller", V(0.3, 6, 0.6), cf * CFrame.new(-11.2, 4, 0), RGB(40, 40, 42), M.Metal)
	for _, z in { -3, 3 } do
		deco("Gear", V(0.5, 2, 0.5), cf * CFrame.new(-2, 1, z), RGB(50, 50, 52), M.Metal)
		local wheel = deco("GearWheel", V(1.4, 1.4, 0.6), cf * CFrame.new(-2, 0.7, z) * CFrame.Angles(0, math.pi / 2, 0), RGB(28, 28, 30), M.Rubber)
		wheel.Shape = Enum.PartType.Cylinder
	end
end

-- Hangar: nave alta con los dos extremos abiertos (se cruza de punta a punta)
local function hangar(cf, sx, sz, height)
	local wallColor = RGB(126, 132, 120)
	for _, z in { -1, 1 } do
		block("HangarWall", V(sx, height, 1.2), cf * CFrame.new(0, height / 2, z * (sz / 2 - 0.6)), wallColor, M.CorrodedMetal)
		-- Ventanales altos (decoración)
		for i = -2, 2 do
			deco("HangarWindow", V(5, 2.4, 0.2), cf * CFrame.new(i * sx / 5, height - 3, z * (sz / 2 + 0.05)), RGB(40, 46, 52), M.Glass)
		end
	end
	-- Fachadas de los extremos con el portón abierto (dintel por encima)
	for _, x in { -1, 1 } do
		block("HangarLintel", V(1.2, 5, sz), cf * CFrame.new(x * (sx / 2 - 0.6), height - 2.5, 0), wallColor, M.CorrodedMetal)
		for _, z in { -1, 1 } do
			block("HangarJamb", V(1.2, height - 5, 4), cf * CFrame.new(x * (sx / 2 - 0.6), (height - 5) / 2, z * (sz / 2 - 2)), wallColor, M.CorrodedMetal)
		end
	end
	block("HangarRoof", V(sx + 2, 1, sz + 2), cf * CFrame.new(0, height + 0.5, 0), RGB(96, 100, 92), M.CorrodedMetal)
	for i = -2, 2 do
		deco("RoofRib", V(0.6, 0.6, sz + 2), cf * CFrame.new(i * sx / 5, height + 1.2, 0), RGB(80, 84, 78), M.Metal)
	end
	deco("HangarFloor", V(sx - 2, 0.1, sz - 2), cf * CFrame.new(0, 0.06, 0), RGB(118, 118, 116), M.Concrete)
	for i = -1, 1, 2 do
		local lamp = deco("HangarLamp", V(2, 0.4, 2), cf * CFrame.new(i * sx / 4, height - 0.6, 0), RGB(255, 240, 210), M.Neon)
		Kit.light(lamp, "PointLight", RGB(255, 236, 200), 30, 1.1)
	end
end

-- Torre de vigilancia: patas, escalera y plataforma con parapeto (puesto de tirador)
local function watchtower(cf, height)
	local wood = RGB(110, 86, 60)
	for _, x in { -3.5, 3.5 } do
		for _, z in { -3.5, 3.5 } do
			block("TowerLeg", V(1, height, 1), cf * CFrame.new(x, height / 2, z), wood, M.Wood)
		end
	end
	block("TowerFloor", V(9, 1, 9), cf * CFrame.new(0, height - 0.5, 0), wood, M.WoodPlanks)
	for _, side in { { 0, 4.3, 9, 0.6 }, { 0, -4.3, 9, 0.6 }, { 4.3, 0, 0.6, 9 } } do
		block("TowerWall", V(side[3], 2.6, side[4]), cf * CFrame.new(side[1], height + 1.3, side[2]), wood, M.WoodPlanks)
	end
	deco("TowerRoof", V(10.5, 0.6, 10.5), cf * CFrame.new(0, height + 6, 0), OLIVE_DARK, M.CorrodedMetal)
	for _, x in { -4.6, 4.6 } do
		for _, z in { -4.6, 4.6 } do
			deco("RoofPost", V(0.4, 6, 0.4), cf * CFrame.new(x, height + 3, z), wood, M.Wood)
		end
	end
	-- Escalera por el lado abierto (-X)
	Kit.stairs(cf * V(-4.5 - height * 1.5, 0, 0), cf * V(-4.5, height, 0), 4, wood, M.WoodPlanks)
	local lamp = deco("TowerSpot", V(1, 1, 1), cf * CFrame.new(3.6, height + 4.8, 3.6), RGB(255, 240, 200), M.Neon)
	Kit.light(lamp, "SpotLight", RGB(255, 236, 200), 40, 1.2, Enum.NormalId.Bottom)
end

-- Tienda de campaña militar: dos faldones inclinados y la lona de detrás (cobertura que tapa la vista)
local function tent(cf, length, width)
	local canvas = RGB(98, 102, 74)
	local h = width * 0.55
	for _, side in { -1, 1 } do
		local slope = math.sqrt((width / 2) ^ 2 + h ^ 2)
		local angle = math.atan2(h, width / 2)
		block("TentRoof", V(length, 0.3, slope), cf * CFrame.new(0, h / 2, side * width / 4) * CFrame.Angles(side * angle, 0, 0), canvas, M.Fabric)
	end
	block("TentBack", V(0.3, h * 0.8, width * 0.6), cf * CFrame.new(length / 2 - 0.2, h * 0.4, 0), canvas:Lerp(RGB(0, 0, 0), 0.1), M.Fabric)
	deco("TentRidge", V(length + 0.6, 0.35, 0.35), cf * CFrame.new(0, h + 0.05, 0), RGB(70, 60, 44), M.Wood)
end

-- Red de camuflaje sobre postes (sombra y vista, no para las balas)
local function camoNet(cf, sx, sz, height)
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			Kit.cylinder("NetPole", height, 0.35, cf * CFrame.new(x * (sx / 2 - 0.5), height / 2, z * (sz / 2 - 0.5)), RGB(80, 66, 48), M.Wood, nil, true)
		end
	end
	local net = deco("CamoNet", V(sx, 0.2, sz), cf * CFrame.new(0, height, 0), RGB(78, 88, 58), M.Fabric)
	net.CastShadow = true
	-- Manchas del camuflaje
	for i, spot in { { -0.25, -0.2, RGB(58, 66, 42) }, { 0.2, 0.15, RGB(104, 96, 66) }, { -0.05, 0.3, RGB(50, 58, 38) } } do
		deco("CamoSpot", V(sx * 0.35, 0.22, sz * 0.3), cf * CFrame.new(spot[1] * sx, height + 0.02, spot[2] * sz) * CFrame.Angles(0, i, 0), spot[3], M.Fabric)
	end
end

-- Torre de focos (de noche no se encienden: solo silueta)
local function floodlight(cf)
	local metal = RGB(96, 98, 100)
	Kit.cylinder("FloodPole", 18, 0.6, cf * CFrame.new(0, 9, 0), metal, M.Metal, nil, true)
	deco("FloodBar", V(5, 0.4, 0.4), cf * CFrame.new(0, 17.6, 0), metal, M.Metal)
	local lit = Kit.Variant == "Noche"
	for _, x in { -1.8, 0, 1.8 } do
		deco("FloodLamp", V(1.3, 1.1, 0.8), cf * CFrame.new(x, 18.4, 0.3) * CFrame.Angles(rad(-20), 0, 0), RGB(60, 62, 64), M.Metal)
		local glass = deco("FloodGlass", V(1, 0.8, 0.1), cf * CFrame.new(x, 18.4, 0.75) * CFrame.Angles(rad(-20), 0, 0), lit and RGB(255, 245, 220) or RGB(230, 230, 210), lit and M.Neon or M.Glass)
		-- De noche, el foco del centro alumbra la zona (uno por torre: las luces cuestan en móvil)
		if lit and x == 0 then
			local beam = Kit.light(glass, "SpotLight", RGB(255, 244, 220), 60, 3, Enum.NormalId.Bottom)
			beam.Angle = 120
		end
	end
end

-- Diana de la galería de tiro
local function target(cf)
	deco("TargetPost", V(0.3, 3, 0.3), cf * CFrame.new(0, 1.5, 0), RGB(100, 80, 60), M.Wood)
	local board = deco("TargetBoard", V(2.4, 3, 0.2), cf * CFrame.new(0, 4.2, 0), RGB(235, 230, 215), M.Wood)
	board.CastShadow = false
	for i, d in { 2, 1.3, 0.6 } do
		local ring = deco("TargetRing", V(0.05, d, d), cf * CFrame.new(0, 4.4, -0.12) * CFrame.Angles(0, math.pi / 2, 0), i % 2 == 1 and RGB(200, 40, 40) or RGB(240, 240, 235), M.SmoothPlastic)
		ring.Shape = Enum.PartType.Cylinder
	end
end

---------------------------------------------------------------------------
-- Mapa
---------------------------------------------------------------------------

function Map.Build()
	local folder = Kit.Begin(Map.Name, { Realistic = true })
	folder:SetAttribute("Ambience", "Base") -- (sonido ambiente: ver Ambience en el cliente)
	Kit.applyLighting(Kit.pickLighting(Map))
	folder:SetAttribute("Variant", Kit.Variant)
	folder:SetAttribute("Weather", Kit.Weather)
	local teams = GameConfig.Teams

	-- Suelo: hierba con caminos de hormigón y tierra
	Kit.terrainFloor(M.Grass, LENGTH + 260, WIDTH + 260)
	block("MainRoad", V(LENGTH + 30, 0.4, 22), CFrame.new(0, 0.2, 0), RGB(108, 108, 106), M.Concrete)
	block("CrossRoad", V(20, 0.4, WIDTH - 30), CFrame.new(0, 0.2, 0), RGB(108, 108, 106), M.Concrete)
	for _, z in { -1, 1 } do
		deco("RoadLine", V(LENGTH - 40, 0.05, 0.5), CFrame.new(0, 0.43, z * 10), RGB(220, 200, 90), M.Concrete)
	end

	-- Búnker de mando en el centro: dos plantas y puertas a los cuatro lados
	building(CFrame.new(0, 0, 0), 30, 26, {
		Floors = 2,
		Color = CONCRETE,
		Material = M.Concrete,
		Doors = { Front = { 6 }, Back = { -6 }, Right = { 0 } }, -- (por la izquierda va la escalera)
		Sign = "MANDO",
	})
	Kit.cylinder("Antenna", 16, 0.5, CFrame.new(10, 25, 8), RGB(70, 72, 76), M.Metal, nil, true)
	deco("Dish", V(0.6, 5, 5), CFrame.new(-8, 19.5, -6) * CFrame.Angles(0, rad(30), rad(-25)), RGB(220, 222, 225), M.Metal).Shape = Enum.PartType.Cylinder

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and teams[1].Color.Color or teams[2].Color.Color

		------------------------------------------------------------------
		-- Carril central (z -20..20): galería de tiro, camiones y muros en T
		------------------------------------------------------------------
		truck(m * CFrame.new(-120, 0, -12) * CFrame.Angles(0, rad(10), 0))
		truck(m * CFrame.new(-52, 0, 13) * CFrame.Angles(0, rad(-170), 0))
		tWallRow(m * V(-95, 0, -6), m * V(-95, 0, 12), nil)
		tWallRow(m * V(-34, 0, -14), m * V(-34, 0, 2), nil)
		sandbags(m * CFrame.new(-75, 0, -2) * CFrame.Angles(0, rad(90), 0), 8)
		-- Galería de tiro: puestos con muro bajo y dianas al fondo
		for i = 0, 3 do
			local z = 35 + i * 3.4
			block("RangeBooth", V(1.2, 3.6, 3), m * CFrame.new(-150, 1.8, z), RGB(120, 110, 96), M.WoodPlanks)
			target(m * CFrame.new(-125, 0, z) * CFrame.Angles(0, rad(90), 0))
		end
		for _, p in { V(-140, 0, 8), V(-108, 0, 15), V(-66, 0, -16) } do
			Kit.crate(m * CFrame.new(p), 4)
		end
		Kit.crate(m * CFrame.new(-66, 4, -16), 3)
		for _, p in { V(-128, 0, 16), V(-85, 0, -15) } do
			Kit.barrel(m * CFrame.new(p), OLIVE)
		end

		------------------------------------------------------------------
		-- Separación norte (z 24..44): alambrada con huecos y casetas
		------------------------------------------------------------------
		fence(m * V(-170, 0, 30), m * V(-132, 0, 30))
		fence(m * V(-118, 0, 30), m * V(-80, 0, 30))
		solidBlock(m * CFrame.new(-66, 0, 36), 18, 12, 9, RGB(140, 136, 120), { Material = M.Concrete, Sign = side == "A" and "ARMERÍA" or "COMBUSTIBLE", Awning = false })
		tWallRow(m * V(-48, 0, 28), m * V(-24, 0, 28), 3)

		------------------------------------------------------------------
		-- Separación sur (z -44..-24): almacén y contenedores
		------------------------------------------------------------------
		solidBlock(m * CFrame.new(-150, 0, -36), 26, 16, 12, RGB(126, 130, 118), { Material = M.CorrodedMetal, Windows = false })
		Kit.container(m * CFrame.new(-110, 0, -32), OLIVE)
		Kit.container(m * CFrame.new(-110, 8.6, -32), RGB(120, 70, 50))
		Kit.container(m * CFrame.new(-80, 0, -36) * CFrame.Angles(0, rad(90), 0), RGB(70, 90, 110))
		fence(m * V(-60, 0, -30), m * V(-24, 0, -30))

		------------------------------------------------------------------
		-- Carril norte (z 50..125): hangar con avioneta y contenedores
		------------------------------------------------------------------
		local hangarCf = m * CFrame.new(-92, 0, 88)
		hangar(hangarCf, 54, 40, 16)
		plane(hangarCf * CFrame.new(4, 0, 2) * CFrame.Angles(0, rad(8), 0))
		Kit.crate(hangarCf * CFrame.new(-18, 0, -12), 4)
		Kit.crate(hangarCf * CFrame.new(-18, 0, -8), 4)
		Kit.metalCrate(hangarCf * CFrame.new(18, 0, 14), 5, OLIVE_DARK)
		Kit.container(m * CFrame.new(-150, 0, 70) * CFrame.Angles(0, rad(90), 0), RGB(150, 120, 60))
		Kit.container(m * CFrame.new(-34, 0, 64), RGB(110, 60, 50))
		Kit.container(m * CFrame.new(-28, 0, 112) * CFrame.Angles(0, rad(15), 0), OLIVE)
		sandbags(m * CFrame.new(-50, 0, 92) * CFrame.Angles(0, rad(90), 0), 10)
		sandbags(m * CFrame.new(-12, 0, 82), 8)
		truck(m * CFrame.new(-150, 0, 108) * CFrame.Angles(0, rad(-80), 0))

		------------------------------------------------------------------
		-- Carril sur (z -125..-50): barracones, trincheras y torre
		------------------------------------------------------------------
		building(m * CFrame.new(-112, 0, -84) * CFrame.Angles(0, math.pi, 0), 30, 24, {
			Floors = 2,
			Color = RGB(150, 138, 112),
			Doors = { Front = { -6 }, Back = { 6 }, Right = { 0 } },
			Blind = { Left = true },
			Sign = "BARRACONES",
		})
		watchtower(m * CFrame.new(-40, 0, -100), 14)
		-- Trincheras: líneas de sacos en zigzag
		sandbags(m * CFrame.new(-70, 0, -64), 14)
		sandbags(m * CFrame.new(-60, 0, -74) * CFrame.Angles(0, rad(60), 0), 10)
		sandbags(m * CFrame.new(-150, 0, -64), 12)
		sandbags(m * CFrame.new(-18, 0, -66) * CFrame.Angles(0, rad(90), 0), 10)
		Kit.log(m * CFrame.new(-80, 0, -110) * CFrame.Angles(0, rad(20), 0), 10, 2.2)
		for _, p in { V(-150, 0, -100), V(-72, 0, -118) } do
			Kit.metalCrate(m * CFrame.new(p), 5, OLIVE_DARK)
		end

		------------------------------------------------------------------
		-- Perímetro: muro con alambre, garitas y bosque detrás
		------------------------------------------------------------------
		for _, z in { -1, 1 } do
			block("PerimeterWall", V(LENGTH / 2 + 10, 9, 1.5), m * CFrame.new(-LENGTH / 4, 4.5, z * (WIDTH / 2 + 2)), CONCRETE, M.Concrete)
			deco("PerimeterWire", V(LENGTH / 2 + 10, 0.4, 0.4), m * CFrame.new(-LENGTH / 4, 9.6, z * (WIDTH / 2 + 2)), RGB(70, 70, 72), M.Metal)
		end
		block("PerimeterWall", V(1.5, 9, WIDTH + 6), m * CFrame.new(-LENGTH / 2 - 8, 4.5, 0), CONCRETE, M.Concrete)
		for _, z in { -90, 90 } do
			Kit.cartoonPine(m * V(-LENGTH / 2 - 30, 0, z), 1.6, true)
		end
		for i = 0, 8 do
			local x = -LENGTH / 2 + i * 24
			for _, z in { -1, 1 } do
				Kit.cartoonPine(m * V(x + z * 6, 0, z * (WIDTH / 2 + 24 + (i % 3) * 8)), 1.5 + (i % 2) * 0.4, true)
			end
		end

		------------------------------------------------------------------
		-- Ambiente: caminos de tierra, tiendas, red de camuflaje, focos y postes de la luz
		------------------------------------------------------------------
		Kit.terrainPatch(m * CFrame.new(-95, 0, 62), V(150, 1, 7), M.Ground)
		Kit.terrainPatch(m * CFrame.new(-90, 0, -56), V(150, 1, 7), M.Ground)
		Kit.terrainPatch(m * CFrame.new(-65, 0, -70), V(26, 1, 16), M.Mud)
		Kit.terrainPatch(m * CFrame.new(-150, 0, -64), V(18, 1, 10), M.Mud)
		tent(m * CFrame.new(-176, 0, -90) * CFrame.Angles(0, rad(90), 0), 11, 8)
		tent(m * CFrame.new(-176, 0, -108) * CFrame.Angles(0, rad(90), 0), 11, 8)
		camoNet(m * CFrame.new(-150, 0, 108) * CFrame.Angles(0, rad(10), 0), 16, 12, 9)
		for _, p in { V(-178, 0, 48), V(-178, 0, -48) } do
			floodlight(m * CFrame.new(p) * CFrame.Angles(0, rad(p.Z > 0 and -90 or 90), 0))
		end
		RealKit.utilityLine(m * CFrame.new(0, 0, 22.5), -175, -23, 38)
		-- Helipuerto junto al hangar (solo dibujo en el suelo) y manga de viento
		local pad = Kit.cylinder("Helipad", 0.06, 14, m * CFrame.new(-112, 0.04, 121), RGB(70, 72, 70), M.Concrete, nil, true)
		pad.CastShadow = false
		local ring = Kit.cylinder("HelipadRing", 0.07, 12.4, m * CFrame.new(-112, 0.05, 121), RGB(225, 200, 60), M.SmoothPlastic, nil, true)
		ring.CastShadow = false
		local inner = Kit.cylinder("HelipadInner", 0.08, 11.4, m * CFrame.new(-112, 0.06, 121), RGB(70, 72, 70), M.Concrete, nil, true)
		inner.CastShadow = false
		local letter = deco("HelipadH", V(7, 0.05, 7), m * CFrame.new(-112, 0.1, 121), RGB(255, 255, 255), M.SmoothPlastic)
		letter.Transparency = 1
		local gui = Kit.sign(letter, Enum.NormalId.Top, "H", RGB(235, 235, 230), RGB(235, 235, 230))
		gui.LightInfluence = 1
		Kit.cylinder("WindsockPole", 9, 0.3, m * CFrame.new(-100, 4.5, 127), RGB(200, 200, 200), M.Metal, nil, true)
		for i = 0, 3 do
			deco("Windsock", V(0.9 - i * 0.12, 0.9 - i * 0.12, 1.1), m * CFrame.new(-100, 8.6 - i * 0.12, 127.7 + i * 1.05) * CFrame.Angles(rad(-6 * i), 0, 0), i % 2 == 0 and RGB(240, 110, 30) or RGB(240, 240, 235), M.Fabric)
		end

		-- Base: el muro de detrás de la zona de salida, con sus banderas
		for _, z in { -30, 30 } do
			Kit.banner(m * CFrame.new(-206.5, 6, z) * CFrame.Angles(0, rad(90), 0), 5, 9, teamColor, RGB(240, 240, 240))
		end
	end)

	-- Pájaros dando vueltas sobre el valle (los mueve el cliente: atributos Orbit de WorldFX);
	-- con tormenta no vuelan
	if Kit.Weather ~= "Rain" then
		for i, spec in { { 70, 48, 14 }, { 110, 58, -11 }, { 90, 52, 9 }, { 140, 64, -7 } } do
			local radius, height, speed = spec[1], spec[2], spec[3]
			local angle = i * 1.7
			local body = CFrame.new(math.cos(angle) * radius, height, math.sin(angle) * radius)
				* CFrame.Angles(0, -angle + (speed > 0 and 0 or math.pi), 0)
			for _, side in { -1, 1 } do
				local wing = deco("BirdWing", V(1.6, 0.08, 0.45), body * CFrame.new(side * 0.75, 0, 0) * CFrame.Angles(0, 0, rad(side * 22)), RGB(40, 38, 36), M.SmoothPlastic)
				wing.CastShadow = false
				wing:SetAttribute("Orbit", speed)
				wing:SetAttribute("OrbitCenter", V(0, height, 0))
				wing:SetAttribute("OrbitAxis", V(0, 1, 0))
			end
		end
	end

	-- Con tormenta: hormigón mojado (brilla un poco) y charcos por los caminos
	if Kit.Weather == "Rain" then
		for _, part in folder:GetDescendants() do
			if part:IsA("BasePart") and (part.Name == "MainRoad" or part.Name == "CrossRoad") then
				part.Color = part.Color:Lerp(RGB(0, 0, 0), 0.25)
				part.Reflectance = 0.12
			end
		end
		for i, p in { V(-150, 0, 4), V(-96, 0, -5), V(-60, 0, 7), V(-20, 0, -4), V(4, 0, 60), V(-4, 0, -70), V(-110, 0, 62), V(-80, 0, -56) } do
			for _, q in { p, Kit.MIRROR * p } do
				local onRoad = math.abs(q.Z) < 11 or math.abs(q.X) < 10
				local puddle = Kit.cylinder("Puddle", 0.04, 3 + (i % 3) * 1.5, CFrame.new(q + V(0, onRoad and 0.43 or 0.03, 0)), RGB(62, 66, 72), M.SmoothPlastic, nil, true)
				puddle.Reflectance = 0.35
				puddle.CastShadow = false
			end
		end
	end

	-- Zonas de salida, banderas y límites
	local spawnStyle = { Floor = RGB(118, 118, 114), FloorMaterial = M.Concrete, Roof = OLIVE_DARK, RoofMaterial = M.CorrodedMetal }
	Kit.spawnArea(teams[1], CFrame.new(-184, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-184, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-160, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-160, 0, 0))
	Kit.bounds(LENGTH, WIDTH, 70)

	-- Pinos de verde oscuro natural (el pino del kit es de colores de dibujo animado)
	for _, part in folder:GetDescendants() do
		if part:IsA("BasePart") and part.Name == "PineTier" then
			part.Color = RGB(46, 72, 44):Lerp(RGB(34, 56, 36), (math.floor(part.Position.Y) % 2) * 0.6)
			part.Material = M.LeafyGrass
		end
	end

	-- Montañas alrededor del valle
	for _, spec in { { V(-330, 0, 240), 110 }, { V(330, 0, -240), 110 }, { V(60, 0, 330), 120 }, { V(-60, 0, -330), 120 }, { V(-360, 0, -150), 90 }, { V(360, 0, 150), 90 } } do
		Kit.naturalHill(spec[1], spec[2], M.Grass)
	end

	-- Puntos de salida libres
	for _, p in {
		V(-150, 0.5, -6), V(-115, 0.5, 6), V(-80, 0.5, 8), V(-45, 0.5, -6),
		V(-160, 0.5, 90), V(-118, 0.5, 92), V(-70, 0.5, 80), V(-20, 0.5, 100),
		V(-160, 0.5, -85), V(-90, 0.5, -96), V(-56, 0.5, -112), V(-20, 0.5, -90),
		V(-2, FLOOR_H + 0.5, 4), V(-112, FLOOR_H + 0.5, -82),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	-- Puestos de los tiradores (torre de vigilancia, barracones y búnker de arriba)
	for _, spot in {
		{ V(-40, 14, -100), V(40, 4, -80) }, -- torre de vigilancia
		{ V(-112, FLOOR_H, -74.7), V(-112, 4, -20) }, -- barracones, ventana de arriba
		{ V(0, FLOOR_H, -10.3), V(0, 4, -60) }, -- búnker, ventana de arriba
	} do
		Kit.botSpot(spot[1], spot[2])
		Kit.botSpot(Kit.MIRROR * spot[1], Kit.MIRROR * spot[2])
	end
	-- Buscar y destruir: cada equipo defiende dos sitios en su mitad (A y B)
	for _, site in { { V(-108, 0, 100), "A" }, { V(-135, 0, -110), "B" } } do
		Kit.bombSite(site[1], site[2], 1)
		Kit.bombSite(Kit.MIRROR * site[1], site[2], 2)
	end
	-- Zonas de control: delante del búnker, los dos carriles y los dos lados del centro
	Kit.zone(V(0, 0, 20), 10, 1)
	Kit.zone(V(-92, 0, 88), 12, 2)
	Kit.zone(V(92, 0, -88), 12, 3)
	Kit.zone(V(0, 0, -20), 10, 4)
	Kit.zone(V(0, 0, 0), 9, 5)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">MoonBase</string>
              <string name="Source"><![CDATA[-- BASE LUNAR: base espacial de dibujos animados en la Luna, de noche con la Tierra enorme en el
-- cielo. En el centro, un cohete en su plataforma de lanzamiento con una pasarela a media altura;
-- cúpulas de los módulos, paneles solares, un rover, cajas de carga y cráteres. Plataformas con
-- propulsores (plataformas de salto) a los lados. Simétrico (rojo contra azul).
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)

local Map = {
	Id = "MoonBase",
	Name = "Base Lunar",
	Icon = "🚀",
	Description = "Espacio · cohete central · cúpulas y cráteres · gravedad lunar",
	Gravity = 120, -- (la normal es 196.2): saltos más altos y lentos
}

Map.Lighting = {
	CartoonNeutral = { Hue = 0.62, Sat = 0.1 }, -- grises lunares algo azulados
	ClockTime = 23.5,
	Brightness = 1.6,
	Exposure = 0.35,
	Ambient = Color3.fromRGB(80, 85, 115),
	OutdoorAmbient = Color3.fromRGB(120, 125, 160),
	Atmosphere = { Density = 0.12, Offset = 0, Color = Color3.fromRGB(70, 80, 130), Decay = Color3.fromRGB(30, 30, 70), Glare = 0, Haze = 0 },
	Color = { Saturation = 0.25, Contrast = 0.12, Brightness = 0.04, Tint = Color3.fromRGB(240, 245, 255) },
	Bloom = { Intensity = 0.8, Size = 24, Threshold = 1.5 },
	Clouds = 0,
	SunRays = 0,
	Stars = 6000,
	MoonSize = 0.1, -- (estamos en la Luna: la que se ve es la Tierra)
	ShadowSoftness = 0.15,
	Wind = Vector3.new(0, 0, 0),
	TerrainColors = {
		Rock = Color3.fromRGB(150, 150, 165),
		Basalt = Color3.fromRGB(120, 120, 135),
		Slate = Color3.fromRGB(135, 135, 150),
	},
}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad

local MOON = RGB(185, 185, 198) -- suelo lunar
local MOON_DARK = RGB(150, 150, 165)
local HULL = RGB(240, 242, 248) -- blanco de las naves y módulos
local TRIM = RGB(255, 170, 40)
local GLOW = RGB(90, 220, 255)
local PANEL = RGB(40, 70, 160)

local LENGTH, WIDTH = 200, 130

-- Cráter: anillo de borde y fondo un poco más oscuro (decoración plana, se puede pisar)
local function crater(position, size)
	Kit.cylinder("CraterRim", 0.5, size, CFrame.new(position + V(0, 0.15, 0)), MOON:Lerp(Color3.new(1, 1, 1), 0.25), Enum.Material.SmoothPlastic, nil, true)
	Kit.cylinder("Crater", 0.55, size * 0.8, CFrame.new(position + V(0, 0.18, 0)), MOON_DARK, Enum.Material.SmoothPlastic, nil, true)
end

-- Cúpula de un módulo habitable (media esfera sólida) con anillo, puerta y ventanas iluminadas
local function dome(cf, size, accent)
	Kit.ball("Dome", size, cf, HULL, Enum.Material.SmoothPlastic)
	Kit.cylinder("DomeRing", 1.2, size + 0.8, cf * CFrame.new(0, 0.6, 0), accent, Enum.Material.SmoothPlastic, nil, true)
	Kit.block("DomeDoor", V(4, 6, 2.5), cf * CFrame.new(0, 3, -size / 2 + 1), RGB(70, 75, 95), Enum.Material.SmoothPlastic)
	Kit.deco("DomeDoorGlow", V(4.4, 0.4, 2.7), cf * CFrame.new(0, 6.2, -size / 2 + 1), GLOW, Enum.Material.Neon)
	for _, angle in { -50, 50, 140, 220 } do
		local window = cf * CFrame.Angles(0, rad(angle), 0) * CFrame.new(0, size * 0.22, -size * 0.43) * CFrame.Angles(rad(-25), 0, 0)
		Kit.deco("DomeWindow", V(2.2, 1.4, 0.3), window, GLOW, Enum.Material.Neon)
	end
end

-- Panel solar inclinado sobre un poste (cobertura baja)
local function solarPanel(cf)
	Kit.block("SolarPost", V(0.8, 3, 0.8), cf * CFrame.new(0, 1.5, 0), RGB(160, 165, 180), Enum.Material.SmoothPlastic)
	local panel = cf * CFrame.new(0, 3.4, 0) * CFrame.Angles(rad(30), 0, 0)
	Kit.block("SolarPanel", V(9, 0.4, 5), panel, PANEL, Enum.Material.SmoothPlastic)
	for i = -1, 1 do
		Kit.deco("SolarCellLine", V(0.12, 0.42, 5), panel * CFrame.new(i * 3, 0, 0), RGB(200, 210, 230), Enum.Material.SmoothPlastic)
	end
	Kit.deco("SolarCellLine", V(9, 0.42, 0.12), panel, RGB(200, 210, 230), Enum.Material.SmoothPlastic)
end

-- Rover lunar (cobertura): carrocería, cabina, seis ruedas y antena
local function rover(cf, color)
	Kit.block("RoverBody", V(10, 2.2, 5.5), cf * CFrame.new(0, 2.4, 0), HULL, Enum.Material.SmoothPlastic)
	Kit.block("RoverCab", V(4, 2.4, 4.6), cf * CFrame.new(-2.5, 4.7, 0), color, Enum.Material.SmoothPlastic)
	Kit.deco("RoverWindow", V(0.3, 1.4, 3.6), cf * CFrame.new(-4.55, 4.9, 0), GLOW, Enum.Material.Neon)
	for _, x in { -3.6, 0, 3.6 } do
		for _, z in { -1, 1 } do
			Kit.cylinder("RoverWheel", 1, 2.6, cf * CFrame.new(x, 1.3, z * 3.1) * CFrame.Angles(rad(90), 0, 0), RGB(50, 52, 62), Enum.Material.SmoothPlastic, nil, true)
		end
	end
	Kit.cylinder("RoverAntenna", 3, 0.2, cf * CFrame.new(3, 5, 1.5), RGB(200, 200, 210), Enum.Material.SmoothPlastic, nil, true)
	Kit.ball("RoverAntennaTip", 0.6, cf * CFrame.new(3, 6.6, 1.5), TRIM, Enum.Material.Neon, true)
end

-- Antena parabólica (decoración de fondo)
local function dish(cf, scale)
	Kit.cylinder("DishPost", 8 * scale, 1.2 * scale, cf * CFrame.new(0, 4 * scale, 0), RGB(170, 175, 190), Enum.Material.SmoothPlastic, nil, true)
	local head = cf * CFrame.new(0, 8.5 * scale, 0) * CFrame.Angles(rad(-35), 0, 0)
	Kit.cylinder("Dish", 0.8 * scale, 9 * scale, head * CFrame.Angles(rad(90), 0, 0), HULL, Enum.Material.SmoothPlastic, nil, true)
	Kit.cylinder("DishFeed", 3 * scale, 0.3 * scale, head * CFrame.new(0, 0, -1.6 * scale) * CFrame.Angles(rad(90), 0, 0), RGB(170, 175, 190), Enum.Material.SmoothPlastic, nil, true)
	Kit.ball("DishLight", 0.8 * scale, head * CFrame.new(0, 0, -3.2 * scale), RGB(255, 80, 80), Enum.Material.Neon, true)
end

-- Cohete en el centro (decoración salvo la plataforma): cuerpo blanco con franjas, alerones y punta
local function rocket(base)
	local height = 34
	Kit.cylinder("RocketBody", height, 7, base * CFrame.new(0, height / 2 + 2, 0), HULL, Enum.Material.SmoothPlastic, nil, true)
	for _, y in { 8, 20, 30 } do
		Kit.cylinder("RocketStripe", 1.4, 7.15, base * CFrame.new(0, y, 0), RGB(230, 60, 60), Enum.Material.SmoothPlastic, nil, true)
	end
	Kit.cylinder("RocketWindowRing", 0.3, 3, base * CFrame.new(0, 25, -3.45) * CFrame.Angles(rad(90), 0, 0), TRIM, Enum.Material.SmoothPlastic, nil, true)
	Kit.cylinder("RocketWindow", 0.35, 2.3, base * CFrame.new(0, 25, -3.5) * CFrame.Angles(rad(90), 0, 0), GLOW, Enum.Material.Neon, nil, true)
	Kit.cylinder("RocketNoseBase", 4, 6, base * CFrame.new(0, height + 4, 0), RGB(230, 60, 60), Enum.Material.SmoothPlastic, nil, true)
	Kit.ball("RocketNose", 5.4, base * CFrame.new(0, height + 6.6, 0), RGB(230, 60, 60), Enum.Material.SmoothPlastic, true)
	for i = 0, 3 do
		local fin = base * CFrame.Angles(0, rad(45 + i * 90), 0) * CFrame.new(0, 5, -4.6)
		Kit.deco("RocketFin", V(0.8, 8, 4), fin * CFrame.Angles(rad(-12), 0, 0), RGB(230, 60, 60), Enum.Material.SmoothPlastic)
	end
	Kit.cylinder("RocketEngine", 2, 5, base * CFrame.new(0, 1.6, 0), RGB(80, 85, 100), Enum.Material.SmoothPlastic, nil, true)
end

-- La Tierra en el cielo: esfera azul con continentes verdes
local function earth(position, size)
	Kit.ball("Earth", size, CFrame.new(position), RGB(60, 130, 230), Enum.Material.SmoothPlastic, true)
	local rng = Random.new(7)
	for _ = 1, 9 do
		local dir = V(rng:NextNumber(-1, 1), rng:NextNumber(-0.6, 1), rng:NextNumber(0.2, 1)).Unit
		local patch = rng:NextNumber(0.22, 0.38) * size
		Kit.ball("EarthLand", patch, CFrame.new(position + dir * (size / 2 - patch * 0.42)), RGB(90, 190, 90), Enum.Material.SmoothPlastic, true)
	end

end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	Kit.applyLighting(Map.Lighting)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Suelo lunar con cráteres
	block("Floor", V(LENGTH + 40, 2, WIDTH + 40), CFrame.new(0, -1, 0), MOON, Enum.Material.SmoothPlastic)
	for _, c in { { V(-30, 0, 34), 12 }, { V(-60, 0, -20), 9 }, { V(-14, 0, -46), 10 }, { V(-78, 0, 50), 8 } } do
		crater(c[1], c[2])
		crater(Kit.MIRROR * c[1], c[2])
	end
	crater(V(0, 0, 50), 7)
	crater(V(0, 0, -50), 7)

	-- Plataforma de lanzamiento: base octogonal alta (cobertura) y pasarela alrededor del cohete
	local deckY = 8
	Kit.cylinder("LaunchPad", 2, 26, CFrame.new(0, 1, 0), RGB(120, 125, 145), Enum.Material.SmoothPlastic)
	Kit.cylinder("LaunchPadStripe", 2.05, 22, CFrame.new(0, 1.02, 0), TRIM, Enum.Material.SmoothPlastic, nil, true)
	rocket(CFrame.new(0, 2, 0))
	-- Pasarela (gantry) en forma de anillo cuadrado con barandillas
	for _, s in { -1, 1 } do
		block("Gantry", V(22, 1, 5), CFrame.new(0, deckY - 0.5, s * 8.5), RGB(150, 155, 175), Enum.Material.Metal)
		block("Gantry", V(5, 1, 12), CFrame.new(s * 8.5, deckY - 0.5, 0), RGB(150, 155, 175), Enum.Material.Metal)
		deco("GantryGlow", V(22, 0.2, 0.3), CFrame.new(0, deckY + 0.05, s * 10.9), GLOW, Enum.Material.Neon)
		for _, x in { -10, 10 } do
			block("GantryPillar", V(1.2, deckY - 1, 1.2), CFrame.new(x, (deckY - 1) / 2, s * 10), RGB(120, 125, 145), Enum.Material.Metal)
		end
		Kit.railing(V(-11, deckY, s * 11), V(11, deckY, s * 11), 2.5, RGB(220, 220, 230))
	end

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(235, 70, 70) or RGB(60, 130, 240)
		-- Rampa a la pasarela
		Kit.stairs((m * CFrame.new(-30, 0, 0)).Position, (m * CFrame.new(-11, deckY, 0)).Position, 5, RGB(150, 155, 175), Enum.Material.Metal)

		-- Cúpulas de los módulos (cobertura grande)
		dome(m * CFrame.new(-50, 0, 32) * CFrame.Angles(0, rad(200), 0), 18, teamColor)
		dome(m * CFrame.new(-34, 0, -38) * CFrame.Angles(0, rad(-20), 0), 14, teamColor)

		-- Plataforma elevada con propulsor (plataforma de salto) para subir
		local platY = 9
		block("LandingPlatform", V(18, 1.2, 12), m * CFrame.new(-60, platY - 0.6, -(WIDTH / 2 - 10)), RGB(170, 175, 195), Enum.Material.Metal)
		deco("LandingGlow", V(18.4, 0.3, 0.3), m * CFrame.new(-60, platY, -(WIDTH / 2 - 16.2)), teamColor, Enum.Material.Neon)
		for _, x in { -67, -53 } do
			for _, z in { -(WIDTH / 2 - 5), -(WIDTH / 2 - 15) } do
				block("LandingLeg", V(1.2, platY - 1.2, 1.2), m * CFrame.new(x, (platY - 1.2) / 2, z), RGB(120, 125, 145), Enum.Material.Metal)
			end
		end
		Kit.jumpPad((m * CFrame.new(-60, 0, -(WIDTH / 2 - 26))).Position, 72, teamColor)

		-- Paneles solares (cobertura baja)
		solarPanel(m * CFrame.new(-22, 0, 22) * CFrame.Angles(0, rad(90), 0))
		solarPanel(m * CFrame.new(-22, 0, 34) * CFrame.Angles(0, rad(90), 0))
		solarPanel(m * CFrame.new(-74, 0, -6) * CFrame.Angles(0, rad(15), 0))

		-- Rover y cajas de carga
		rover(m * CFrame.new(-42, 0, 4) * CFrame.Angles(0, rad(-10), 0), teamColor)
		Kit.metalCrate(m * CFrame.new(-16, 0, -18), 5, HULL, GLOW)
		Kit.metalCrate(m * CFrame.new(-20, 0, -24), 4, TRIM, GLOW)
		Kit.metalCrate(m * CFrame.new(-66, 0, 22), 5, HULL, teamColor)
		Kit.metalCrate(m * CFrame.new(-28, 0, 52), 4, HULL, GLOW)
		Kit.metalCrate(m * CFrame.new(-23, 0, 53), 4, TRIM, GLOW)

		-- Rocas lunares (cobertura natural de terreno)
		Kit.rockCluster((m * CFrame.new(-48, 0, -52)).Position, 3.5, Enum.Material.Basalt)
		Kit.rockCluster((m * CFrame.new(-10, 0, 28)).Position, 3, Enum.Material.Basalt)
		Kit.rockCluster((m * CFrame.new(-82, 0, -44)).Position, 3, Enum.Material.Basalt)

		-- Bandera de su "país" plantada (decoración)
		Kit.cylinder("FlagPole", 9, 0.3, m * CFrame.new(-80, 4.5, 30), RGB(220, 220, 230), Enum.Material.SmoothPlastic, nil, true)
		deco("PlantedFlag", V(0.2, 3, 5), m * CFrame.new(-80, 7.4, 32.6), teamColor, Enum.Material.SmoothPlastic)

		-- Muro bajo del módulo de aterrizaje (protege la salida de la base)
		block("BaseWall", V(2, 4, 16), m * CFrame.new(-72, 2, 18), HULL, Enum.Material.SmoothPlastic)
		deco("BaseWallGlow", V(2.2, 0.3, 16.2), m * CFrame.new(-72, 4.1, 18), teamColor, Enum.Material.Neon)
		block("BaseWall", V(2, 4, 16), m * CFrame.new(-72, 2, -26), HULL, Enum.Material.SmoothPlastic)
		deco("BaseWallGlow", V(2.2, 0.3, 16.2), m * CFrame.new(-72, 4.1, -26), teamColor, Enum.Material.Neon)
	end)

	-- Bases y banderas
	local spawnStyle = { Floor = RGB(225, 228, 238), Roof = HULL }
	Kit.spawnArea(teams[1], CFrame.new(-85, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-85, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-62, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-62, 0, 0))

	-- Fondo: colinas de roca lunar, antenas y la Tierra
	Kit.bounds(LENGTH, WIDTH, 60)
	for x = -200, 200, 60 do
		for _, z in { -1, 1 } do
			Kit.naturalHill(V(x, -16, z * 140), 42, Enum.Material.Rock, { Inward = V(0, 0, -z), Top = Enum.Material.Basalt, RockCount = 2 })
		end
	end
	for _, sx in { -1, 1 } do
		for z = -80, 80, 55 do
			Kit.naturalHill(V(sx * 160, -16, z), 42, Enum.Material.Rock, { Inward = V(-sx, 0, 0), Top = Enum.Material.Basalt, RockCount = 2 })
		end
	end
	dish(CFrame.new(-30, 0, WIDTH / 2 + 22) * CFrame.Angles(0, rad(160), 0), 1.4)
	dish(CFrame.new(30, 0, -(WIDTH / 2 + 22)) * CFrame.Angles(0, rad(-20), 0), 1.4)
	earth(V(-60, 150, -380), 110)

	-- Modos
	for _, p in {
		V(-76, 0.5, 8), V(-76, 0.5, -16), V(-50, 0.5, 10), V(-40, 0.5, -20), V(-24, 0.5, 40),
		V(-16, 0.5, -34), V(-30, 0.5, 18), V(-60, 9.5, -(WIDTH / 2 - 10)), V(-6, deckY + 0.5, 8), V(-84, 0.5, 44),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, deckY, 8.5), 4, 1)
	Kit.zone(V(-40, 0, -14), 6, 2)
	Kit.zone(V(40, 0, 14), 6, 3)
	Kit.zone(V(-60, 9, -(WIDTH / 2 - 10)), 5, 4)
	Kit.zone(V(60, 9, WIDTH / 2 - 10), 5, 5)
	Kit.dustMotes(CFrame.new(0, 6, 0), V(140, 10, 90), Color3.fromRGB(200, 220, 255), 10)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">NeonFoundry</string>
              <string name="Source"><![CDATA[-- NEON FOUNDRY: fundición de noche. Horno central con metal fundido, canales de lava (hacen daño),
-- puentes metálicos, cintas con lingotes, pasarelas y rótulos de neón.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)

local Map = {
	Id = "NeonFoundry",
	Name = "Neon Foundry",
	Icon = "🔥",
	Description = "Industrial · noche · lava y neón",
}

Map.Lighting = {
	CartoonNeutral = { Hue = 0.75, Sat = 0.18 }, -- tono de los grises en estilo Cartoon
	ClockTime = 0.3,
	Brightness = 1,
	Exposure = 0.2,
	Ambient = Color3.fromRGB(35, 30, 50),
	OutdoorAmbient = Color3.fromRGB(55, 50, 80),
	Atmosphere = { Density = 0.4, Offset = 0.1, Color = Color3.fromRGB(90, 70, 130), Decay = Color3.fromRGB(50, 30, 80), Glare = 0, Haze = 2.8 },
	Color = { Saturation = 0.2, Contrast = 0.2, Brightness = 0.02, Tint = Color3.fromRGB(240, 232, 255) },
	Bloom = { Intensity = 1, Size = 28, Threshold = 1.3 },
	Clouds = 0.35,
	CloudColor = Color3.fromRGB(80, 60, 110),
	SunRays = 0,
	Stars = 5000, -- cielo nocturno estrellado
	MoonSize = 16,
}

local V = Vector3.new
local RGB = Color3.fromRGB
local C = Kit.C

local FLOOR = RGB(58, 60, 72)
local WALL = RGB(70, 72, 84)
local ORANGE = RGB(255, 130, 30)
local LAVA_X = 32 -- canales de lava en x = ±32

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	folder:SetAttribute("Ambience", "Factory") -- (sonido ambiente: ver Ambience en el cliente)
	Kit.applyLighting(Map.Lighting)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Suelo de placas con líneas de neón
	-- Hormigón húmedo (con los charcos refleja el neón)
	block("Floor", V(340, 2, 240), CFrame.new(0, -1, 0), FLOOR, Enum.Material.Concrete)
	for _, z in { -45, 45 } do
		deco("FloorNeon", V(250, 0.06, 0.5), CFrame.new(0, 0.04, z), C.Cyan, Enum.Material.Neon)
	end
	for _, x in { -95, 95 } do
		deco("FloorNeon", V(0.5, 0.06, 200), CFrame.new(x, 0.04, 0), C.Pink, Enum.Material.Neon)
	end

	-- Horno central con metal fundido cayendo a una piscina de lava
	Kit.cylinder("Furnace", 34, 20, CFrame.new(0, 17, 0), RGB(75, 70, 80), Enum.Material.CorrodedMetal)
	for i, y in { 8, 18, 28 } do
		Kit.cylinder("FurnaceBand", 1.4, 20.6, CFrame.new(0, y, 0), i == 2 and ORANGE or RGB(45, 45, 52), i == 2 and Enum.Material.Neon or Enum.Material.Metal, nil, true)
	end
	local emblemPlate = deco("FurnaceEmblem", V(8, 8, 0.5), CFrame.new(0, 22, -10.3), RGB(40, 40, 48), Enum.Material.Metal)
	Kit.sign(emblemPlate, Enum.NormalId.Front, "⚡", ORANGE)
	local emblemBack = deco("FurnaceEmblem", V(8, 8, 0.5), CFrame.new(0, 22, 10.3), RGB(40, 40, 48), Enum.Material.Metal)
	Kit.sign(emblemBack, Enum.NormalId.Back, "⚡", ORANGE)
	for _, s in { -1, 1 } do
		local pour = deco("MoltenPour", V(3, 14, 1.2), CFrame.new(0, 7, s * 10.6), RGB(255, 150, 40), Enum.Material.Neon)
		Kit.light(pour, "PointLight", ORANGE, 30, 3)
		-- Chispas del metal fundido
		local sparks = Instance.new("ParticleEmitter")
		sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		sparks.Color = ColorSequence.new(RGB(255, 230, 150), ORANGE)
		sparks.LightEmission = 1
		sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
		sparks.Lifetime = NumberRange.new(0.6, 1.2)
		sparks.Speed = NumberRange.new(8, 16)
		sparks.SpreadAngle = Vector2.new(70, 70)
		sparks.Acceleration = V(0, -35, 0)
		sparks.Rate = 25
		sparks.EmissionDirection = Enum.NormalId.Top
		sparks.Parent = pour
		Kit.lava(V(12, 1, 6), CFrame.new(0, -0.3, s * 14))
		Kit.railing(V(-7, 0, s * 17.5), V(7, 0, s * 17.5), 3, ORANGE)
	end
	Kit.cylinder("FurnaceCap", 3, 14, CFrame.new(0, 35.5, 0), RGB(50, 50, 58), Enum.Material.Metal, nil, true)
	Kit.smokestack(V(0, 37, 0), 18)

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(255, 60, 80) or RGB(60, 140, 255)

		-- Canal de lava a lo largo de Z con tres puentes
		Kit.lava(V(10, 1, 210), m * CFrame.new(-LAVA_X, -0.4, 0))
		for _, bz in { -70, 5, 70 } do
			block("LavaBridge", V(14, 1, 10), m * CFrame.new(-LAVA_X, 0.5, bz), RGB(80, 82, 95), Enum.Material.DiamondPlate)
			for _, s in { -1, 1 } do
				Kit.railing(m * V(-LAVA_X - 7, 1, bz + s * 4.8), m * V(-LAVA_X + 7, 1, bz + s * 4.8), 2.5, ORANGE)
			end
		end

		-- Plataforma elevada con cinta transportadora
		block("ConveyorDeck", V(14, 8, 46), m * CFrame.new(-62, 4, -60), WALL, Enum.Material.CorrodedMetal)
		deco("DeckNeon", V(14.2, 0.4, 46.2), m * CFrame.new(-62, 7.9, -60), teamColor, Enum.Material.Neon)
		Kit.conveyor(m * V(-62, 8.5, -80), m * V(-62, 8.5, -40), 5)
		Kit.stairs(m * V(-62, 0, -100), m * V(-62, 8, -83), 6, RGB(90, 92, 105))
		Kit.stairs(m * V(-43, 0, -45), m * V(-55.5, 8, -45), 5, RGB(90, 92, 105))
		Kit.railing(m * V(-69, 8, -83), m * V(-69, 8, -37), 3, C.Yellow)

		-- Edificio del rótulo de neón (lado del equipo, con pasarela)
		block("Factory", V(30, 22, 26), m * CFrame.new(-95, 11, 75), WALL, Enum.Material.CorrodedMetal)
		deco("FactoryTrim", V(30.4, 1, 26.4), m * CFrame.new(-95, 21.8, 75), RGB(40, 40, 50), Enum.Material.Metal)
		for i, x in { -104, -95, -86 } do
			local win = deco("FactoryWindow", V(5, 4, 0.3), m * CFrame.new(x, 8, 61.9), i == 2 and ORANGE or RGB(255, 190, 80), Enum.Material.Neon)
			win.Transparency = 0.25
		end
		Kit.neonSign(m * CFrame.new(-95, 16, 61.6), 22, 6, side == "A" and "NEON FOUNDRY" or "FOUNDRY 02", side == "A" and C.Cyan or C.Pink, side == "A" and C.Pink or C.Cyan)
		block("FactoryWalk", V(8, 1, 40), m * CFrame.new(-76, 9.5, 75), RGB(80, 82, 95), Enum.Material.DiamondPlate)
		Kit.railing(m * V(-72.2, 10, 56), m * V(-72.2, 10, 94), 3, C.Cyan)
		Kit.stairs(m * V(-76, 0, 38), m * V(-76, 10, 55), 6, RGB(90, 92, 105))

		-- Cajas metálicas con brillo, tuberías y cobertura
		Kit.metalCrate(m * CFrame.new(-50, 0, 10), 5, RGB(70, 75, 90), teamColor)
		Kit.metalCrate(m * CFrame.new(-50, 0, 15.2), 5, RGB(70, 75, 90), teamColor)
		Kit.metalCrate(m * CFrame.new(-50, 5, 12.6), 4, RGB(70, 75, 90), C.Cyan)
		Kit.metalCrate(m * CFrame.new(-18, 0, 35), 5, RGB(80, 70, 70), ORANGE)
		Kit.metalCrate(m * CFrame.new(-18, 0, -35), 5, RGB(80, 70, 70), ORANGE)
		Kit.metalCrate(m * CFrame.new(-80, 0, 15), 6, RGB(70, 75, 90), C.Pink)
		Kit.metalCrate(m * CFrame.new(-110, 0, -40), 5, RGB(70, 75, 90), teamColor)
		Kit.metalCrate(m * CFrame.new(-110, 0, -34.8), 5, RGB(70, 75, 90), teamColor)
		Kit.container(m * CFrame.new(-82, 0, -15) * CFrame.Angles(0, math.rad(90), 0), RGB(140, 40, 60), "FOUNDRY")
		Kit.barrier(V(2, 4, 14), m * CFrame.new(-20, 0, 0))
		Kit.barrier(V(14, 4, 2), m * CFrame.new(-60, 0, 40))
		Kit.pipeRun(m * V(-140, 14, -96), m * V(-20, 14, -96), 2.4, RGB(110, 100, 120))
		Kit.pipeRun(m * V(-140, 18, -100), m * V(-40, 18, -100), 1.6, RGB(160, 80, 60))
		for _, x in { -130, -100, -70, -40 } do
			block("PipeSupport", V(1.2, 18, 1.2), m * CFrame.new(x, 9, -98), RGB(45, 45, 55), Enum.Material.Metal)
		end

		-- Grúa con caja colgando (decoración)
		deco("CraneArm", V(2, 2, 40), m * CFrame.new(-45, 34, 30), C.Yellow, Enum.Material.Metal)
		deco("CraneMast", V(2, 34, 2), m * CFrame.new(-45, 17, 50), C.Yellow, Enum.Material.Metal)
		deco("CraneCable", V(0.3, 10, 0.3), m * CFrame.new(-45, 28, 14), RGB(20, 20, 20), Enum.Material.Metal)
		Kit.metalCrate(m * CFrame.new(-45, 19, 14), 5, RGB(90, 90, 100), C.Yellow)

		-- Focos que barren el cielo
		local beam = deco("SkyBeam", V(1.5, 120, 1.5), m * CFrame.new(-120, 60, 100) * CFrame.Angles(math.rad(-15), 0, math.rad(12)), side == "A" and C.Cyan or C.Pink, Enum.Material.Neon)
		beam.Transparency = 0.75
		beam:SetAttribute("Sweep", 18)
	end)

	-- Pórticos de neón sobre los carriles con lámparas colgantes
	for _, z in { -45, 45 } do
		block("NeonGantry", V(2, 2, 2), CFrame.new(-60, 1, z), RGB(45, 45, 55), Enum.Material.Metal)
		block("NeonGantry", V(2, 2, 2), CFrame.new(60, 1, z), RGB(45, 45, 55), Enum.Material.Metal)
		deco("GantryPostA", V(1.4, 24, 1.4), CFrame.new(-60, 12, z), RGB(50, 50, 60), Enum.Material.Metal)
		deco("GantryPostB", V(1.4, 24, 1.4), CFrame.new(60, 12, z), RGB(50, 50, 60), Enum.Material.Metal)
		deco("GantryBeam", V(122, 1.6, 1.6), CFrame.new(0, 24, z), RGB(50, 50, 60), Enum.Material.Metal)
		deco("GantryNeon", V(122, 0.4, 1.7), CFrame.new(0, 23, z), z < 0 and C.Pink or C.Cyan, Enum.Material.Neon)
		for x = -45, 45, 30 do
			deco("LampCable", V(0.15, 6, 0.15), CFrame.new(x, 20, z), RGB(20, 20, 20), Enum.Material.Metal)
			local lamp = deco("HangingLamp", V(2.4, 0.8, 2.4), CFrame.new(x, 16.6, z), RGB(255, 210, 150), Enum.Material.Neon)
			Kit.lightCone(V(x, 16.2, z), 15, 1.2, 6, RGB(255, 205, 140))
			Kit.light(lamp, "SpotLight", RGB(255, 200, 140), 28, 2, Enum.NormalId.Bottom).Angle = 100
		end
	end

	-- Spawns y banderas
	local spawnStyle = { Floor = RGB(50, 52, 62), FloorMaterial = Enum.Material.DiamondPlate, Roof = RGB(45, 46, 56), RoofMaterial = Enum.Material.Metal }
	Kit.spawnArea(teams[1], CFrame.new(-145, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-145, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-112, 0, 10))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-112, 0, 10))

	-- Límites: muros de fábrica alrededor y chimeneas de fondo
	Kit.bounds(320, 220, 60)
	for x = -150, 150, 30 do
		for _, z in { -1, 1 } do
			local h = 26 + (math.abs(x) % 3) * 6
			block("BackFactory", V(30, h, 12), CFrame.new(x, h / 2, z * 117), WALL:Lerp(Color3.new(0, 0, 0), (math.abs(x) % 2) * 0.15), Enum.Material.CorrodedMetal)
			local stripe = deco("BackStripe", V(30.2, 0.6, 0.3), CFrame.new(x, h - 3, z * 110.9), (x / 30) % 2 == 0 and C.Cyan or C.Pink, Enum.Material.Neon)
			stripe.Transparency = 0.1
			deco("BackVertical", V(0.6, h - 6, 0.3), CFrame.new(x + 14, (h - 6) / 2, z * 110.9), (x / 30) % 2 == 0 and C.Pink or C.Cyan, Enum.Material.Neon)
			local window = deco("BackWindow", V(10, 4, 0.3), CFrame.new(x - 5, h * 0.45, z * 110.9), RGB(255, 180, 80), Enum.Material.Neon)
			window.Transparency = 0.35
		end
	end
	for z = -90, 90, 30 do
		for _, sx in { -1, 1 } do
			block("SideFactory", V(12, 30, 30), CFrame.new(sx * 168, 15, z), WALL, Enum.Material.CorrodedMetal)
		end
	end
	for i, p in { V(-120, 0, 160), V(-40, 0, 190), V(60, 0, 170), V(150, 0, 200), V(-160, 0, -170), V(20, 0, -190), V(130, 0, -160) } do
		Kit.smokestack(p, 50 + (i % 3) * 15)
	end

	-- Modos
	for _, p in {
		V(-130, 0.5, 45), V(-100, 0.5, -15), V(-60, 8.5, -60), V(-76, 10.5, 75), V(-45, 0.5, 30),
		V(-20, 0.5, -60), V(-110, 0.5, 85), V(-60, 0.5, 20), V(-15, 0.5, 60), V(-125, 0.5, -80),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, 0, 25), 9, 1)
	Kit.zone(V(-62, 8, -60), 9, 2)
	Kit.zone(V(62, 8, 60), 9, 3)
	Kit.zone(V(0, 0, -25), 9, 4)
	Kit.zone(V(-50, 0, 25), 10, 5)
	-- Realismo: suelo mojado con charcos que reflejan el neón, vapor y brasas en el aire
	for _, p in { Vector3.new(-56, 0, 24), Vector3.new(-40, 0, 34), Vector3.new(-11, 0, 64), Vector3.new(-16, 0, -56), Vector3.new(-121, 0, -76), Vector3.new(-126, 0, 49) } do
		Kit.puddle(p, 5.5)
		Kit.puddle(Kit.MIRROR * p, 5.5)
	end
	for _, p in { Vector3.new(-26, 0, -66), Vector3.new(-105, 0, -20), Vector3.new(-90, 0, 40) } do
		Kit.steamVent(CFrame.new(p), 1.4)
		Kit.steamVent(Kit.MIRROR * CFrame.new(p), 1.4)
	end
	Kit.dustMotes(CFrame.new(0, 12, 0), Vector3.new(70, 22, 70), Color3.fromRGB(255, 150, 60), 25)
	-- Losas de hormigón industrial con juntas, grietas y manchas de aceite de la maquinaria
	Kit.floorJoints(CFrame.new(), 300, 210, 12, Color3.fromRGB(38, 38, 42))
	Kit.symmetric(function(m)
		for i, spec in { { Vector3.new(-84, 0, -8), 9 }, { Vector3.new(-35, 0, -30), 8 }, { Vector3.new(-115, 0, 66), 10 } } do
			Kit.crack(m * spec[1], spec[2], i * 31)
		end
		for _, p in { Vector3.new(-66, 0, -34), Vector3.new(-100, 0, 30), Vector3.new(-30, 0, 80) } do
			Kit.oilStain(m * p, 3.2)
		end
		Kit.manhole(m * Vector3.new(-48, 0, -12))
	end)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">PastelPlaza</string>
              <string name="Source"><![CDATA[-- PASTEL PLAZA: arena compacta al estilo de los shooters más jugados de Roblox. Paredes lavanda con
-- pilares rosas, naranjas y amarillos, bordes naranjas, suelo de hierba, torre central de dos alturas,
-- casas laterales con azotea, muros en L, plataformas de hierba y pinos de dibujo animado.
-- Hecho para el estilo "Cartoon" y la textura de cuadrícula (ver assets/textures/LEEME.md).
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)

local Map = {
	Id = "PastelPlaza",
	Name = "Pastel Plaza",
	Icon = "🏰",
	Description = "Arena · mediodía · torre central y azoteas",
}

Map.Lighting = {
	ClockTime = 13.8,
	Brightness = 3.2,
	Exposure = 0.05,
	Ambient = Color3.fromRGB(120, 118, 140),
	OutdoorAmbient = Color3.fromRGB(165, 165, 185),
	Atmosphere = { Density = 0.22, Offset = 0.2, Color = Color3.fromRGB(205, 225, 255), Decay = Color3.fromRGB(120, 150, 210), Glare = 0, Haze = 0.4 },
	Color = { Saturation = 0.2, Contrast = 0.06, Brightness = 0.03, Tint = Color3.fromRGB(255, 252, 248) },
	Bloom = { Intensity = 0.35, Size = 22, Threshold = 2 },
	Clouds = 0.55,
	SunRays = 0.04,
	ShadowSoftness = 0.3,
	Wind = Vector3.new(3, 0, 1),
}

local V = Vector3.new
local RGB = Color3.fromRGB

local WALL = RGB(168, 162, 208) -- lavanda
local WALL_DARK = RGB(140, 134, 186)
local TRIM = RGB(255, 165, 50) -- naranja de los bordes
local PILLARS = { RGB(236, 92, 124), RGB(255, 170, 60), RGB(255, 214, 70) }
local GRASS = RGB(96, 206, 98)
local PLAZA = RGB(210, 205, 235)

local LENGTH, WIDTH = 240, 150

-- Muro con borde naranja encima
local function wall(name, cf, size, color)
	local part = Kit.block(name, size, cf * CFrame.new(0, size.Y / 2, 0), color or WALL, Enum.Material.SmoothPlastic)
	Kit.deco(name .. "Cap", V(size.X + 0.4, 0.7, size.Z + 0.4), cf * CFrame.new(0, size.Y + 0.35, 0), TRIM, Enum.Material.SmoothPlastic)
	return part
end

local function pillar(cf, height, color)
	Kit.block("Pillar", V(3.2, height, 3.2), cf * CFrame.new(0, height / 2, 0), color, Enum.Material.SmoothPlastic)
	Kit.deco("PillarCap", V(3.8, 0.8, 3.8), cf * CFrame.new(0, height + 0.4, 0), TRIM, Enum.Material.SmoothPlastic)
end

-- Cobertura baja con borde naranja
local function cover(cf, size)
	wall("Cover", cf, size, WALL_DARK)
end

-- Plataforma de hierba elevada (lados lavanda y tapa verde) con un escalón para subir
local function grassPlatform(cf, size, height, stepSide)
	Kit.block("PlatformBase", V(size.X, height, size.Z), cf * CFrame.new(0, height / 2, 0), WALL, Enum.Material.SmoothPlastic)
	Kit.block("PlatformTop", V(size.X + 0.6, 0.5, size.Z + 0.6), cf * CFrame.new(0, height + 0.1, 0), GRASS, Enum.Material.SmoothPlastic)
	Kit.block("PlatformStep", V(4, height / 2, 6), cf * CFrame.new(stepSide * (size.X / 2 + 2), height / 4, 0), WALL_DARK, Enum.Material.SmoothPlastic)
end

-- Casa con puerta hacia el centro, ventanas, azotea con murete y escalera exterior
local function house(m, cf)
	local w, d, h, t = 22, 16, 11, 1.4
	-- Paredes: la de +X (hacia el centro) con puerta; la de -Z (hacia la calle) con dos ventanas
	wall("HouseWall", cf * CFrame.new(0, 0, d / 2 - t / 2), V(w, h, t))
	wall("HouseWall", cf * CFrame.new(-w / 2 + t / 2, 0, 0), V(t, h, d - 2 * t))
	-- Pared con puerta (hueco de 5 de ancho y 7 de alto)
	local sideLen = (d - 2 * t - 5) / 2
	for _, s in { -1, 1 } do
		Kit.block("HouseWall", V(t, h, sideLen), cf * CFrame.new(w / 2 - t / 2, h / 2, s * (2.5 + sideLen / 2)), WALL, Enum.Material.SmoothPlastic)
	end
	Kit.block("HouseLintel", V(t, h - 7, 5), cf * CFrame.new(w / 2 - t / 2, 7 + (h - 7) / 2, 0), WALL, Enum.Material.SmoothPlastic)
	-- Pared con ventanas (de 4 de ancho, entre y=4 y y=7)
	local front = cf * CFrame.new(0, 0, -d / 2 + t / 2)
	Kit.block("HouseWallLow", V(w, 4, t), front * CFrame.new(0, 2, 0), WALL, Enum.Material.SmoothPlastic)
	Kit.block("HouseWallHigh", V(w, h - 7, t), front * CFrame.new(0, 7 + (h - 7) / 2, 0), WALL, Enum.Material.SmoothPlastic)
	for _, x in { -w / 2 + 2.5, 0, w / 2 - 2.5 } do
		Kit.block("HouseWallMid", V(x == 0 and 5 or 5, 3, t), front * CFrame.new(x, 5.5, 0), WALL, Enum.Material.SmoothPlastic)
	end
	-- Esquinas de color, tejado y murete
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			pillar(cf * CFrame.new(x * (w / 2), 0, z * (d / 2)), h + 0.5, PILLARS[(x + z) % 3 + 1])
		end
	end
	Kit.block("HouseRoof", V(w, 1, d), cf * CFrame.new(0, h + 0.5, 0), WALL_DARK, Enum.Material.SmoothPlastic)
	for _, z in { -1, 1 } do
		wall("RoofParapet", cf * CFrame.new(0, h + 1, z * (d / 2 - 0.4)), V(w - 4, 1.4, 0.8), WALL)
	end
	-- Escalera exterior por el lado de fuera hasta la azotea
	Kit.stairs((cf * CFrame.new(-w / 2 - 3, 0, -d / 2 + 1)).Position, (cf * CFrame.new(-w / 2 - 3, h + 1, d / 2 - 3)).Position, 5, WALL_DARK, Enum.Material.SmoothPlastic)
	Kit.crate(cf * CFrame.new(-4, 0, 3), 4)
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	folder:SetAttribute("Ambience", "Breeze") -- (sonido ambiente: ver Ambience en el cliente)
	Kit.applyLighting(Map.Lighting)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Suelo de hierba, plaza central y caminos
	block("Floor", V(LENGTH + 40, 2, WIDTH + 40), CFrame.new(0, -1, 0), GRASS, Enum.Material.SmoothPlastic)
	block("Plaza", V(84, 0.2, 64), CFrame.new(0, 0.1, 0), PLAZA, Enum.Material.SmoothPlastic)

	-- Muro perimetral con pilares de colores y borde naranja
	for _, z in { -1, 1 } do
		wall("OuterWall", CFrame.new(0, 0, z * (WIDTH / 2 + 1.5)), V(LENGTH + 6, 22, 3))
		for i, x in { -108, -78, -48, -18, 18, 48, 78, 108 } do
			pillar(CFrame.new(x, 0, z * (WIDTH / 2)), 23, PILLARS[i % 3 + 1])
		end
	end
	for _, x in { -1, 1 } do
		wall("OuterWall", CFrame.new(x * (LENGTH / 2 + 1.5), 0, 0), V(3, 22, WIDTH + 6))
		for i, z in { -55, -20, 20, 55 } do
			pillar(CFrame.new(x * (LENGTH / 2), 0, z), 23, PILLARS[i % 3 + 1])
		end
	end

	-- Torre central: plataforma a 10 de altura sobre cuatro pilares, con muretes
	local deckY = 10
	block("TowerDeck", V(24, 1.2, 24), CFrame.new(0, deckY, 0), WALL_DARK, Enum.Material.SmoothPlastic)
	deco("TowerDeckTrim", V(24.6, 0.5, 24.6), CFrame.new(0, deckY - 0.75, 0), TRIM, Enum.Material.SmoothPlastic)
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			pillar(CFrame.new(x * 10.5, 0, z * 10.5), deckY - 0.6, PILLARS[(x + z) % 3 + 1])
		end
	end
	cover(CFrame.new(0, 0, 0), V(8, 3.5, 2))
	Kit.symmetric(function(m)
		-- Muretes de la torre (con hueco donde llega la escalera)
		wall("TowerParapet", m * CFrame.new(0, deckY + 0.6, -11.6), V(24, 1.4, 0.8))
		wall("TowerParapet", m * CFrame.new(-11.6, deckY + 0.6, 3.75), V(0.8, 1.4, 16.5))
		wall("TowerParapet", m * CFrame.new(-11.6, deckY + 0.6, -10.75), V(0.8, 1.4, 2.5))
		Kit.stairs((m * CFrame.new(-28, 0, -7)).Position, (m * CFrame.new(-12.5, deckY + 0.6, -7)).Position, 5, WALL_DARK, Enum.Material.SmoothPlastic)
	end)

	Kit.symmetric(function(m, side)
		-- Camino de baldosas desde la base al centro
		block("Path", V(52, 0.2, 10), m * CFrame.new(-66, 0.1, 0), PLAZA, Enum.Material.SmoothPlastic)

		house(m, m * CFrame.new(-55, 0, 45))

		-- Muro en L y coberturas bajas
		wall("LWall", m * CFrame.new(-62, 0, -25), V(2, 8, 16))
		wall("LWall", m * CFrame.new(-55, 0, -32), V(12, 8, 2))
		cover(m * CFrame.new(-30, 0, -13), V(10, 3.5, 2))
		cover(m * CFrame.new(-48, 0, 8), V(2, 3.5, 10))
		cover(m * CFrame.new(-75, 0, 20), V(8, 3.5, 2))
		cover(m * CFrame.new(-22, 0, -38), V(2, 3.5, 8))
		cover(m * CFrame.new(-86, 0, -52), V(8, 3.5, 2))

		-- Plataformas de hierba elevadas
		grassPlatform(m * CFrame.new(-35, 0, 32), V(14, 0, 14), 3, 1)
		grassPlatform(m * CFrame.new(-78, 0, -40), V(12, 0, 12), 3, 1)

		-- Barriles, cajas y vegetación
		Kit.barrel(m * CFrame.new(-40, 0, -55), side == "A" and RGB(235, 80, 90) or RGB(70, 140, 255))
		Kit.barrel(m * CFrame.new(-42.5, 0, -52.5), RGB(255, 190, 60))
		Kit.crate(m * CFrame.new(-58, 0, 22), 4)
		Kit.crate(m * CFrame.new(-86, 0, 32), 4)
		Kit.crate(m * CFrame.new(-86, 0, 36.5), 3)
		for _, p in { V(-100, 0, 60), V(-15, 0, 64), V(-60, 0, -66) } do
			Kit.bush(m * p, 1.1, RGB(70, 190, 80))
		end
		for i, p in { V(-30, 0, 55), V(-75, 0, -62), V(-10, 0, -34), V(-96, 0, 44), V(-44, 0, 26) } do
			Kit.flowers(m * p, 3, i * 19)
		end
		for i, p in { V(-50, 0, -62), V(-85, 0, 62), V(-25, 0, 20), V(-68, 0, 8) } do
			Kit.grassTuft(m * p, 1.1, i * 3)
		end
		for _, p in { V(-110, 0, 64), V(-62, 0, 66), V(-22, 0, -66) } do
			Kit.cartoonPine(m * p, 1)
		end
	end)

	-- Bases y banderas
	local spawnStyle = { Floor = PLAZA, Roof = WALL_DARK }
	Kit.spawnArea(teams[1], CFrame.new(-105, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-105, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-80, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-80, 0, 0))

	-- Límites y fondo: pinos y colinas verdes detrás de los muros
	Kit.bounds(LENGTH, WIDTH, 50)
	for x = -150, 150, 26 do
		for _, z in { -1, 1 } do
			Kit.cartoonPine(V(x + z * 9, 0, z * (92 + (math.abs(x) % 17))), 1.4 + (math.abs(x) % 3) * 0.15, true)
		end
	end
	for x = -200, 200, 70 do
		for _, z in { -1, 1 } do
			Kit.naturalHill(V(x, -18, z * 150), 50, Enum.Material.Grass, { Inward = V(0, 0, -z), Top = Enum.Material.LeafyGrass, RockCount = 1 })
		end
	end
	for _, sx in { -1, 1 } do
		for z = -100, 100, 70 do
			Kit.naturalHill(V(sx * 190, -18, z), 52, Enum.Material.Grass, { Inward = V(-sx, 0, 0), Top = Enum.Material.LeafyGrass, RockCount = 1 })
		end
	end

	-- Modos
	for _, p in {
		V(-100, 0.5, 50), V(-80, 0.5, -20), V(-60, 0.5, 0), V(-40, 0.5, 20), V(-25, 0.5, -25),
		V(-55, 0.5, 45), V(-35, 3.85, 32), V(-12, 0.5, 50), V(-92, 0.5, -64), V(-3, deckY + 1.1, -5),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, deckY + 0.6, 0), 7, 1)
	Kit.zone(V(-55, 0, 45), 6, 2)
	Kit.zone(V(55, 0, -45), 6, 3)
	Kit.zone(V(-35, 3.35, 32), 6, 4)
	Kit.zone(V(35, 3.35, -32), 6, 5)
	Kit.dustMotes(CFrame.new(0, 8, 0), V(120, 14, 80), Color3.fromRGB(150, 230, 255), 16)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">PirateCove</string>
              <string name="Source"><![CDATA[-- BAHÍA PIRATA: dos orillas de arena separadas por un canal de agua. En el centro, un galeón
-- atracado: se sube por las pasarelas desde cada orilla, la cubierta tiene cañones y barandillas de
-- cobertura y dos castillos (proa y popa) con escalera. Por los extremos, dos puentes de madera
-- cruzan el canal. En las orillas, almacén con azotea, muelles, palmeras, cofres del tesoro y
-- barriles. Si caes al canal se nada y se sale por la orilla. Simétrico.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)
local Variants = require(script.Parent.Parent.LightingVariants)

local Map = {
	Id = "PirateCove",
	Name = "Bahía Pirata",
	Icon = "🏴‍☠️",
	Description = "Mediodía · galeón en el centro · canal, puentes y muelles",
}

Map.Lighting = {
	ClockTime = 13.8,
	Brightness = 3.2,
	Exposure = 0.05,
	Ambient = Color3.fromRGB(125, 122, 130),
	OutdoorAmbient = Color3.fromRGB(175, 170, 175),
	Atmosphere = { Density = 0.22, Offset = 0.2, Color = Color3.fromRGB(200, 230, 255), Decay = Color3.fromRGB(110, 170, 220), Glare = 0, Haze = 0.5 },
	Color = { Saturation = 0.2, Contrast = 0.06, Brightness = 0.03, Tint = Color3.fromRGB(255, 250, 240) },
	Bloom = { Intensity = 0.35, Size = 22, Threshold = 2 },
	Clouds = 0.4,
	SunRays = 0.05,
	ShadowSoftness = 0.3,
	Wind = Vector3.new(6, 0, 3),
	Water = { Color = Color3.fromRGB(25, 150, 175), Reflectance = 0.6, Transparency = 0.55, WaveSize = 0.15, WaveSpeed = 8 },
	TerrainColors = {
		Sand = Color3.fromRGB(240, 215, 150),
		Rock = Color3.fromRGB(150, 135, 120),
		Grass = Color3.fromRGB(110, 200, 90),
		LeafyGrass = Color3.fromRGB(70, 170, 80),
	},
}
-- A veces sale con otra luz o con mal tiempo (ver LightingVariants)
Map.LightingVariants = { Variants.Sunset(0.25), Variants.Storm(0.25) }

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad

local SAND = RGB(244, 218, 150)
local WOOD = RGB(165, 110, 62)
local WOOD_DARK = RGB(105, 68, 40)
local HULL = RGB(90, 55, 35)
local HULL_TRIM = RGB(225, 180, 70)
local SAIL = RGB(245, 240, 225)
local IRON = RGB(45, 45, 52)
local SMOOTH = Enum.Material.SmoothPlastic
local PLANKS = Enum.Material.WoodPlanks

local LENGTH, WIDTH = 200, 130
local CHANNEL = 24 -- media anchura del canal (x de -24 a 24)
local DECK = 4 -- altura de la cubierta del galeón

-- Cañón sobre su cureña: la cureña es cobertura baja; el tubo, decorado
local function cannon(cf)
	Kit.block("CannonCarriage", V(2.2, 1.2, 3), cf * CFrame.new(0, 0.6, 0), WOOD_DARK, Enum.Material.Wood)
	for _, x in { -1.15, 1.15 } do
		for _, z in { -1, 1 } do
			Kit.cylinder("CannonWheel", 0.3, 1.1, cf * CFrame.new(x, 0.55, z) * CFrame.Angles(0, 0, rad(90)), WOOD, Enum.Material.Wood, nil, true)
		end
	end
	Kit.cylinder("CannonBarrel", 3.6, 0.9, cf * CFrame.new(0, 1.55, -0.6) * CFrame.Angles(rad(90), 0, 0), IRON, Enum.Material.Metal, nil, true)
	Kit.ball("CannonMuzzle", 1.1, cf * CFrame.new(0, 1.55, -2.4), IRON, Enum.Material.Metal, true)
end

-- Cofre del tesoro con monedas
local function treasure(cf)
	Kit.block("Chest", V(3, 2, 2), cf * CFrame.new(0, 1, 0), WOOD_DARK, PLANKS)
	Kit.deco("ChestLid", V(3.1, 0.6, 2.1), cf * CFrame.new(0, 2.3, 0.2) * CFrame.Angles(rad(-25), 0, 0), WOOD, PLANKS)
	Kit.deco("ChestBand", V(3.15, 2.05, 0.3), cf * CFrame.new(0, 1, 0), HULL_TRIM, Enum.Material.Metal)
	for i = 0, 4 do
		Kit.cylinder("Coin", 0.15, 0.8, cf * CFrame.new(-0.8 + i * 0.4, 2.15 + (i % 2) * 0.12, -0.2) * CFrame.Angles(rad(70), 0, 0), RGB(255, 210, 60), Enum.Material.Neon, nil, true)
	end
end

-- Mástil con dos velas y bandera pirata
local function mast(cf, height)
	Kit.cylinder("Mast", height, 1.1, cf * CFrame.new(0, height / 2, 0), WOOD_DARK, Enum.Material.Wood, nil, true)
	Kit.block("MastBase", V(1.4, 3, 1.4), cf * CFrame.new(0, 1.5, 0), WOOD_DARK, Enum.Material.Wood)
	for i, y in { height * 0.45, height * 0.78 } do
		local w = i == 1 and 12 or 9
		Kit.deco("Yard", V(w + 1, 0.4, 0.4), cf * CFrame.new(0, y + 3.2, 0), WOOD_DARK, Enum.Material.Wood)
		Kit.deco("Sail", V(w, 6, 0.3), cf * CFrame.new(0, y, -0.6) * CFrame.Angles(rad(-6), 0, 0), SAIL, Enum.Material.Fabric)
	end
	local flag = Kit.deco("PirateFlag", V(3.4, 2.2, 0.1), cf * CFrame.new(1.9, height + 0.6, 0), RGB(25, 25, 30), Enum.Material.Fabric)
	Kit.sign(flag, Enum.NormalId.Front, "☠", Color3.new(1, 1, 1))
	Kit.sign(flag, Enum.NormalId.Back, "☠", Color3.new(1, 1, 1))
end

-- Mitad del galeón (la otra mitad sale girada 180°): castillo con escalera, barandilla con huecos
-- para las pasarelas, cañones y mástil
local function shipHalf(m, teamColor)
	-- Castillo (proa o popa) al final de la cubierta
	Kit.block("Castle", V(14, 4, 10), m * CFrame.new(0, DECK + 2, 23), HULL, PLANKS)
	Kit.deco("CastleTrim", V(14.3, 0.4, 10.3), m * CFrame.new(0, DECK + 3.8, 23), HULL_TRIM, SMOOTH)
	for _, x in { -6.6, 6.6 } do
		Kit.block("CastleRail", V(0.6, 1.4, 10), m * CFrame.new(x, DECK + 4.7, 23), WOOD_DARK, Enum.Material.Wood)
	end
	Kit.block("CastleRailEnd", V(14, 1.4, 0.6), m * CFrame.new(0, DECK + 4.7, 27.7), WOOD_DARK, Enum.Material.Wood)
	Kit.stairs(m * V(3.5, DECK, 10.5), m * V(3.5, DECK + 4, 17.9), 3, WOOD, PLANKS)
	-- Farol del castillo
	local lamp = Kit.deco("CastleLantern", V(0.8, 1.2, 0.8), m * CFrame.new(-5.5, DECK + 6.2, 27.2), RGB(255, 200, 110), Enum.Material.Neon)
	Kit.light(lamp, "PointLight", RGB(255, 190, 110), 14, 1)
	-- Barandilla del lado izquierdo (visto desde esta mitad) con huecos en z 0 y z -15 (pasarelas)
	for _, seg in { { -12, -3 }, { 3, 18 } } do
		local len = seg[2] - seg[1]
		Kit.block("DeckRail", V(0.6, 1.4, len), m * CFrame.new(-6.6, DECK + 0.7, (seg[1] + seg[2]) / 2), WOOD_DARK, Enum.Material.Wood)
	end
	-- Pasarelas desde la orilla
	for _, z in { 0, -15 } do
		Kit.ramp(m * V(-CHANNEL - 1, 0, z), m * V(-7, DECK, z), 4, WOOD, PLANKS)
	end
	-- Cañones mirando hacia la borda y un mástil
	-- (los cañones lejos del pie de las escaleras de los castillos)
	cannon(m * CFrame.new(-4.4, DECK, 5.5) * CFrame.Angles(0, rad(90), 0))
	cannon(m * CFrame.new(-4.4, DECK, -5.5) * CFrame.Angles(0, rad(90), 0))
	mast(m * CFrame.new(0, DECK, 12), 22)
	Kit.barrel(m * CFrame.new(2, DECK, -2), RGB(140, 90, 50))
	Kit.crate(m * CFrame.new(2.5, DECK, 1.5), 3, WOOD)
	-- Escudos del equipo en el casco
	for _, z in { -10, 10 } do
		Kit.cylinder("HullShield", 0.3, 2.4, m * CFrame.new(-7.1, DECK - 1.2, z) * CFrame.Angles(0, 0, rad(90)), teamColor, SMOOTH, nil, true)
	end
end

-- Almacén del muelle con escalera trasera a la azotea (murete delante)
local function warehouse(cf, size, color, label)
	Kit.block("Warehouse", size, cf * CFrame.new(0, size.Y / 2, 0), color, PLANKS)
	Kit.contactShadow(cf, size.X + 0.4, size.Z + 0.4, false)
	Kit.block("RoofWall", V(size.X, 2.6, 0.8), cf * CFrame.new(0, size.Y + 1.3, -(size.Z / 2 - 0.4)), color, PLANKS)
	Kit.deco("RoofTrim", V(size.X + 0.6, 0.5, size.Z + 0.6), cf * CFrame.new(0, size.Y - 0.25, 0), WOOD_DARK, SMOOTH)
	Kit.deco("Door", V(4, 6, 0.2), cf * CFrame.new(0, 3, -(size.Z / 2 + 0.1)), WOOD_DARK, PLANKS)
	local board = Kit.deco("Sign", V(size.X * 0.6, 2, 0.3), cf * CFrame.new(0, size.Y - 2, -(size.Z / 2 + 0.15)), RGB(245, 230, 190), SMOOTH)
	Kit.sign(board, Enum.NormalId.Front, label, RGB(110, 50, 30))
	for _, x in { -1, 1 } do
		Kit.deco("Window", V(2.2, 2.2, 0.2), cf * CFrame.new(x * size.X * 0.3, 3.5, -(size.Z / 2 + 0.1)), RGB(60, 70, 90), Enum.Material.Glass)
	end
	Kit.stairs(cf * V(-size.X / 2 + 2.5, 0, size.Z / 2 + 16), cf * V(-size.X / 2 + 2.5, size.Y, size.Z / 2 + 0.2), 4, WOOD, PLANKS)
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	folder:SetAttribute("Ambience", "Coast") -- (sonido ambiente: ver Ambience en el cliente)
	Kit.applyLighting(Kit.pickLighting(Map))
	folder:SetAttribute("Variant", Kit.Variant)
	folder:SetAttribute("Weather", Kit.Weather)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Mar alrededor y canal en el centro (el fondo del canal es arena)
	workspace.Terrain:FillBlock(CFrame.new(0, -6, 0), V(900, 10, 700), Enum.Material.Water)
	workspace.Terrain:FillBlock(CFrame.new(0, -12, 0), V(900, 2, 700), Enum.Material.Sand)
	for _, sx in { -1, 1 } do
		local width = LENGTH / 2 + 20 - CHANNEL
		-- (macizas hasta el fondo: no se puede bucear por debajo y salir del mapa)
		block("Sand", V(width, 12, WIDTH + 20), CFrame.new(sx * (CHANNEL + width / 2), -6, 0), SAND, Enum.Material.Sand)
		-- Muelle de tablones a lo largo del canal
		deco("Dock", V(5, 0.3, WIDTH + 10), CFrame.new(sx * (CHANNEL + 2.5), 0.12, 0), WOOD, PLANKS)
		for z = -60, 60, 10 do
			Kit.cylinder("DockPost", 5, 0.8, CFrame.new(sx * (CHANNEL + 0.4), -1.5, z), WOOD_DARK, Enum.Material.Wood, nil, true)
		end
	end
	block("ChannelBed", V(CHANNEL * 2, 1, WIDTH + 20), CFrame.new(0, -5.5, 0), SAND, Enum.Material.Sand)

	-- Galeón: casco y cubierta (las dos mitades iguales giradas)
	block("Hull", V(14, 8, 56), CFrame.new(0, 0, 0), HULL, PLANKS)
	deco("HullTrim", V(14.3, 0.6, 56.3), CFrame.new(0, DECK - 0.6, 0), HULL_TRIM, SMOOTH)
	deco("DeckPlanks", V(13.6, 0.1, 55.6), CFrame.new(0, DECK + 0.05, 0), WOOD, PLANKS)
	for _, sz in { -1, 1 } do
		block("Bow", V(9, 7, 5), CFrame.new(0, 0.5, sz * 30.5), HULL, PLANKS)
		block("BowTip", V(4, 6, 4), CFrame.new(0, 1, sz * 35), HULL, PLANKS)
	end
	Kit.pipe("Bowsprit", 12, 0.6, CFrame.new(0, DECK + 3, -40) * CFrame.Angles(0, rad(90), rad(15)), WOOD_DARK, nil, true)
	mast(CFrame.new(0, DECK, 0), 28)

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(235, 70, 70) or RGB(60, 130, 240)
		shipHalf(m, teamColor)

		-- Puente de madera sobre el canal (uno a cada extremo)
		block("Bridge", V(CHANNEL * 2 + 4, 1, 8), m * CFrame.new(0, 0, 52), WOOD, PLANKS)
		for _, z in { 48.3, 55.7 } do
			block("BridgeRail", V(CHANNEL * 2 + 4, 1.4, 0.5), m * CFrame.new(0, 1.2, z), WOOD_DARK, Enum.Material.Wood)
		end

		-- Orilla: almacén con azotea, cofres, barriles, cajas y palmeras
		warehouse(m * CFrame.new(-58, 0, 36), V(18, 9, 14), side == "A" and RGB(200, 120, 90) or RGB(110, 150, 190), "ALMACÉN")
		treasure(m * CFrame.new(-34, 0, 22) * CFrame.Angles(0, rad(20), 0))
		treasure(m * CFrame.new(-70, 0, -40) * CFrame.Angles(0, rad(-30), 0))
		Kit.crate(m * CFrame.new(-36, 0, -10), 4, WOOD)
		Kit.crate(m * CFrame.new(-39, 0, -13), 3.5, WOOD)
		Kit.crate(m * CFrame.new(-36, 4, -10), 2.5, WOOD)
		Kit.barrel(m * CFrame.new(-30, 0, 12), RGB(140, 90, 50))
		Kit.barrel(m * CFrame.new(-32, 0, 14.5), RGB(140, 90, 50))
		Kit.barrel(m * CFrame.new(-48, 0, -26), RGB(120, 80, 45))
		cannon(m * CFrame.new(-44, 0, 8) * CFrame.Angles(0, rad(-90), 0))
		cannon(m * CFrame.new(-44, 0, -36) * CFrame.Angles(0, rad(-90), 0))
		-- Muro bajo de piedra (cobertura) junto al canal
		block("SeaWall", V(2, 2.4, 16), m * CFrame.new(-31, 1.2, -32), RGB(160, 150, 135), Enum.Material.Cobblestone)
		block("SeaWall", V(2, 2.4, 10), m * CFrame.new(-31, 1.2, 34), RGB(160, 150, 135), Enum.Material.Cobblestone)
		for _, p in { V(-78, 0, 50), V(-28, 0, 58), V(-52, 0, -56), V(-80, 0, -52), V(-24, 0, -58) } do
			Kit.palm(m * CFrame.new(p), 13 + (p.Z % 4))
		end
		Kit.banner(m * CFrame.new(-68, 12, 22) * CFrame.Angles(0, rad(90), 0), 4, 6, teamColor, RGB(255, 210, 80))
		Kit.banner(m * CFrame.new(-68, 12, -22) * CFrame.Angles(0, rad(90), 0), 4, 6, teamColor, RGB(255, 210, 80))
	end)

	-- Bases y banderas
	local spawnStyle = { Floor = RGB(245, 225, 175), Roof = RGB(240, 225, 190), RoofMaterial = PLANKS }
	Kit.spawnArea(teams[1], CFrame.new(-85, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-85, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-62, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-62, 0, 0))

	-- Fondo: barcos y un faro en el mar
	Kit.bounds(LENGTH, WIDTH, 60)
	-- Los extremos del canal se cierran también por debajo del agua (los muros empiezan en y = 0)
	local boundary = folder:FindFirstChild("Boundary")
	for _, sz in { -1, 1 } do
		local wall = block("Boundary", V(CHANNEL * 2 + 4, 16, 4), CFrame.new(0, -6, sz * (WIDTH / 2 + 2)), Color3.new(1, 1, 1), nil, boundary)
		wall.Transparency = 1
		wall.CastShadow = false
	end
	Kit.lighthouse(V(-60, 0, -(WIDTH / 2 + 70)))
	for _, p in { { V(80, -1, WIDTH / 2 + 80), 0 }, { V(-150, -1, 30), 90 } } do
		local cf = CFrame.new(p[1]) * CFrame.Angles(0, rad(p[2]), 0)
		deco("FarHull", V(12, 6, 40), cf * CFrame.new(0, 1, 0), HULL, PLANKS)
		deco("FarSail", V(10, 12, 0.4), cf * CFrame.new(0, 12, 0), SAIL, Enum.Material.Fabric)
		deco("FarSail", V(8, 9, 0.4), cf * CFrame.new(0, 11, 12), SAIL, Enum.Material.Fabric)
	end

	-- Modos
	for _, p in {
		V(-76, 0.5, 8), V(-76, 0.5, -16), V(-50, 0.5, 6), V(-40, 0.5, 26), V(-30, 0.5, -46),
		V(-58, 9.5, 36), V(0, DECK + 0.5, -6), V(-3, DECK + 4.5, 23), V(-60, 0.5, -44), V(-38, 0.5, 52),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, DECK, 0), 6, 1)
	Kit.zone(V(-44, 0, -12), 6, 2)
	Kit.zone(V(44, 0, 12), 6, 3)
	Kit.zone(V(-58, 9, 36), 5, 4)
	Kit.zone(V(58, 9, -36), 5, 5)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">SakuraGarden</string>
              <string name="Source"><![CDATA[-- JARDÍN SAKURA: arena compacta en un jardín japonés de estilo cartoon. Pagoda central jugable de dos
-- plantas, toriis rojos en las entradas, estanques con nenúfares y puentes de madera, cerezos en flor
-- con pétalos cayendo, linternas de piedra, bambú, casas de té y una montaña nevada de fondo.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)
local Variants = require(script.Parent.Parent.LightingVariants)

local Map = {
	Id = "SakuraGarden",
	Name = "Jardín Sakura",
	Icon = "🌸",
	Description = "Jardín japonés · tarde · pagoda y estanques",
}

Map.Lighting = {
	ClockTime = 16.3,
	Brightness = 3,
	Exposure = 0.05,
	Ambient = Color3.fromRGB(125, 112, 130),
	OutdoorAmbient = Color3.fromRGB(170, 158, 175),
	Atmosphere = { Density = 0.24, Offset = 0.2, Color = Color3.fromRGB(255, 220, 230), Decay = Color3.fromRGB(200, 150, 190), Glare = 0, Haze = 0.6 },
	Color = { Saturation = 0.18, Contrast = 0.06, Brightness = 0.03, Tint = Color3.fromRGB(255, 244, 246) },
	Bloom = { Intensity = 0.35, Size = 24, Threshold = 2 },
	Clouds = 0.5,
	CloudColor = Color3.fromRGB(255, 236, 242),
	SunRays = 0.05,
	ShadowSoftness = 0.3,
	Wind = Vector3.new(4, 0, 1.5),
	TerrainColors = {
		Grass = Color3.fromRGB(110, 190, 90),
		LeafyGrass = Color3.fromRGB(240, 150, 190),
		Snow = Color3.fromRGB(245, 248, 255),
		Rock = Color3.fromRGB(120, 115, 130),
	},
}
-- A veces sale con otra luz o con mal tiempo (ver LightingVariants)
Map.LightingVariants = { Variants.Sunset(0.25), Variants.Fog(0.2) }

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad

local GRASS = RGB(120, 196, 96)
local STONE = RGB(196, 192, 205)
local STONE_DARK = RGB(150, 146, 160)
local PLASTER = RGB(246, 240, 232)
local WOOD = RGB(150, 98, 60)
local WOOD_DARK = RGB(100, 64, 42)
local TILE = RGB(60, 110, 120) -- tejas verde azulado
local RED = RGB(220, 50, 45)
local PINK = { RGB(255, 170, 205), RGB(250, 140, 185), RGB(255, 182, 212) } -- (saturación > 0,22: el estilo Cartoon no los vuelve lavanda)
local WATER = RGB(70, 170, 210)

local LENGTH, WIDTH = 230, 150

-- Cerezo: tronco inclinado y copa de bolas rosas
local function cherryTree(position, scale, seed)
	local rng = Random.new(seed or 1)
	scale = scale or 1
	local lean = CFrame.Angles(rad(rng:NextNumber(-8, 8)), 0, rad(rng:NextNumber(-8, 8)))
	Kit.cylinder("CherryTrunk", 8 * scale, 1.3 * scale, CFrame.new(position) * lean * CFrame.new(0, 4 * scale, 0), WOOD_DARK, Enum.Material.Wood)
	for i = 1, 4 do
		local offset = V(rng:NextNumber(-2.5, 2.5), 8.5 + rng:NextNumber(-0.5, 2), rng:NextNumber(-2.5, 2.5)) * scale
		local leaf = Kit.ball("Blossom", rng:NextNumber(5, 7.5) * scale, CFrame.new(position + offset), PINK[(i % 3) + 1], Enum.Material.SmoothPlastic, true)
		leaf.CastShadow = true
	end
end

-- Torii: dos pilares rojos, viga superior curvada y viga intermedia
local function torii(cf)
	for _, s in { -1, 1 } do
		Kit.cylinder("ToriiPillar", 13, 1.4, cf * CFrame.new(s * 6, 6.5, 0), RED, Enum.Material.SmoothPlastic)
		Kit.cylinder("ToriiFoot", 1, 1.9, cf * CFrame.new(s * 6, 0.5, 0), RGB(40, 36, 40), Enum.Material.SmoothPlastic, nil, true)
	end
	Kit.deco("ToriiKasagi", V(17, 1.2, 2), cf * CFrame.new(0, 13.6, 0), RGB(40, 36, 40), Enum.Material.SmoothPlastic)
	Kit.deco("ToriiShimaki", V(16, 1, 1.6), cf * CFrame.new(0, 12.6, 0), RED, Enum.Material.SmoothPlastic)
	for _, s in { -1, 1 } do
		Kit.deco("ToriiTip", V(2, 0.8, 2), cf * CFrame.new(s * 8.5, 14.3, 0) * CFrame.Angles(0, 0, rad(s * 12)), RGB(40, 36, 40), Enum.Material.SmoothPlastic)
	end
	Kit.deco("ToriiNuki", V(15, 0.8, 1), cf * CFrame.new(0, 10.4, 0), RED, Enum.Material.SmoothPlastic)
end

-- Linterna de piedra con luz cálida
local function lantern(cf)
	Kit.block("LanternBase", V(1.8, 1, 1.8), cf * CFrame.new(0, 0.5, 0), STONE_DARK, Enum.Material.SmoothPlastic)
	Kit.cylinder("LanternPost", 2.4, 0.8, cf * CFrame.new(0, 2.2, 0), STONE, Enum.Material.SmoothPlastic)
	local box = Kit.block("LanternBox", V(1.5, 1.3, 1.5), cf * CFrame.new(0, 4, 0), STONE, Enum.Material.SmoothPlastic)
	local glow = Kit.deco("LanternGlow", V(1.55, 0.7, 1.55), cf * CFrame.new(0, 4, 0), RGB(255, 210, 140), Enum.Material.Neon)
	Kit.light(glow, "PointLight", RGB(255, 200, 130), 12, 1)
	Kit.deco("LanternRoof", V(2.6, 0.5, 2.6), cf * CFrame.new(0, 4.9, 0) * CFrame.Angles(0, rad(45), 0), STONE_DARK, Enum.Material.SmoothPlastic)
	Kit.ball("LanternTop", 0.6, cf * CFrame.new(0, 5.4, 0), STONE_DARK, Enum.Material.SmoothPlastic, true)
	return box
end

-- Grupo de bambú (decorativo, se atraviesa)
local function bamboo(position, seed)
	local rng = Random.new(seed or 2)
	for i = 1, 5 do
		local h = rng:NextNumber(9, 15)
		local offset = V(rng:NextNumber(-1.5, 1.5), 0, rng:NextNumber(-1.5, 1.5))
		local stalk = Kit.cylinder("Bamboo", h, 0.45, CFrame.new(position + offset + V(0, h / 2, 0)), RGB(120, 190, 80):Lerp(RGB(90, 160, 60), i / 5), Enum.Material.SmoothPlastic, nil, true)
		stalk.CastShadow = false
		Kit.deco("BambooLeaf", V(0.1, 0.5, 2.2), CFrame.new(position + offset + V(0, h - 0.5, 0)) * CFrame.Angles(rad(30), i, 0), RGB(100, 180, 70), Enum.Material.SmoothPlastic)
	end
end

-- Estanque con borde de piedras, nenúfares y peces
local function pond(position, radius, seed)
	local rng = Random.new(seed or 3)
	local water = Kit.cylinder("Pond", 0.3, radius * 2, CFrame.new(position + V(0, 0.08, 0)), WATER, Enum.Material.SmoothPlastic, nil, true)
	water.Reflectance = 0.25
	local rim = Kit.cylinder("PondRim", 0.2, radius * 2 + 2, CFrame.new(position + V(0, 0.05, 0)), STONE_DARK, Enum.Material.SmoothPlastic, nil, true)
	rim.CastShadow = false
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
		local s = rng:NextNumber(1.2, 2.2)
		Kit.block("PondStone", V(s, s * 0.6, s), CFrame.new(position + V(math.cos(a) * (radius + 0.8), s * 0.25, math.sin(a) * (radius + 0.8))) * CFrame.Angles(0, a, 0), STONE, Enum.Material.SmoothPlastic)
	end
	for _ = 1, 4 do
		local p = position + V(rng:NextNumber(-0.6, 0.6) * radius, 0.26, rng:NextNumber(-0.6, 0.6) * radius)
		Kit.cylinder("LilyPad", 0.06, rng:NextNumber(1.4, 2.2), CFrame.new(p), RGB(90, 180, 80), Enum.Material.SmoothPlastic, nil, true)
		if rng:NextNumber() < 0.5 then
			Kit.ball("LilyFlower", 0.5, CFrame.new(p + V(0, 0.2, 0)), RGB(255, 190, 220), Enum.Material.SmoothPlastic, true)
		end
	end
	for _ = 1, 3 do
		local p = position + V(rng:NextNumber(-0.5, 0.5) * radius, 0.25, rng:NextNumber(-0.5, 0.5) * radius)
		local fish = Kit.deco("Koi", V(0.5, 0.1, 1.4), CFrame.new(p) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), rng:NextNumber() < 0.5 and RGB(255, 130, 40) or RGB(255, 245, 240), Enum.Material.SmoothPlastic)
		fish.CastShadow = false
	end
end

-- Casa de té: paredes de madera y papel, tejado de tejas, dos puertas
local function teaHouse(cf)
	local w, d, h = 18, 14, 9
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			Kit.block("TeaPost", V(1.2, h, 1.2), cf * CFrame.new(x * w / 2, h / 2, z * d / 2), WOOD_DARK, Enum.Material.Wood)
		end
	end
	-- Paredes largas (con puerta en el centro de la que mira al centro del mapa)
	for _, z in { -1, 1 } do
		local face = cf * CFrame.new(0, 0, z * d / 2)
		for _, x in { -1, 1 } do
			Kit.block("TeaWall", V(w / 2 - 2.5, h, 0.6), face * CFrame.new(x * (w / 4 + 1.25), h / 2, 0), PLASTER, Enum.Material.SmoothPlastic)
			Kit.deco("TeaBeam", V(w / 2 - 2.5, 0.4, 0.7), face * CFrame.new(x * (w / 4 + 1.25), 3.5, 0), WOOD, Enum.Material.Wood)
		end
		Kit.block("TeaLintel", V(5, h - 6.5, 0.6), face * CFrame.new(0, 6.5 + (h - 6.5) / 2, 0), PLASTER, Enum.Material.SmoothPlastic)
	end
	for _, x in { -1, 1 } do
		Kit.block("TeaWall", V(0.6, h, d), cf * CFrame.new(x * w / 2, h / 2, 0), PLASTER, Enum.Material.SmoothPlastic)
		for _, z in { -3, 3 } do
			Kit.deco("PaperWindow", V(0.7, 2.6, 3), cf * CFrame.new(x * w / 2, 5, z), RGB(255, 250, 230), Enum.Material.SmoothPlastic)
		end
	end
	Kit.block("TeaFloor", V(w, 0.6, d), cf * CFrame.new(0, 0.3, 0), WOOD, Enum.Material.WoodPlanks)
	-- Tejado de dos aguas en voladizo
	for _, s in { -1, 1 } do
		Kit.deco("TeaRoof", V(w + 4, 0.8, d / 2 + 3), cf * CFrame.new(0, h + 1.6, s * (d / 4 + 0.6)) * CFrame.Angles(rad(s * 22), 0, 0), TILE, Enum.Material.SmoothPlastic)
	end
	Kit.deco("TeaRidge", V(w + 4.4, 0.8, 1.2), cf * CFrame.new(0, h + 3.2, 0), RGB(40, 70, 80), Enum.Material.SmoothPlastic)
	Kit.block("TeaCeiling", V(w, 0.6, d), cf * CFrame.new(0, h + 0.3, 0), WOOD, Enum.Material.Wood)
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	folder:SetAttribute("Ambience", "Breeze") -- (sonido ambiente: ver Ambience en el cliente)
	Kit.applyLighting(Kit.pickLighting(Map))
	folder:SetAttribute("Variant", Kit.Variant)
	folder:SetAttribute("Weather", Kit.Weather)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	block("Floor", V(LENGTH + 40, 2, WIDTH + 40), CFrame.new(0, -1, 0), GRASS, Enum.Material.SmoothPlastic)
	block("CenterGravel", V(60, 0.2, 60), CFrame.new(0, 0.1, 0), RGB(226, 222, 214), Enum.Material.SmoothPlastic)

	-- Muro de jardín blanco con tejadillo de tejas
	for _, z in { -1, 1 } do
		block("GardenWall", V(LENGTH + 4, 14, 2.5), CFrame.new(0, 7, z * (WIDTH / 2 + 1.25)), PLASTER, Enum.Material.SmoothPlastic)
		deco("GardenWallTile", V(LENGTH + 8, 1, 4.5), CFrame.new(0, 14.5, z * (WIDTH / 2 + 1.25)), TILE, Enum.Material.SmoothPlastic)
		deco("GardenWallBase", V(LENGTH + 4.4, 2.5, 2.9), CFrame.new(0, 1.25, z * (WIDTH / 2 + 1.25)), STONE_DARK, Enum.Material.SmoothPlastic)
	end
	for _, x in { -1, 1 } do
		block("GardenWall", V(2.5, 14, WIDTH + 4), CFrame.new(x * (LENGTH / 2 + 1.25), 7, 0), PLASTER, Enum.Material.SmoothPlastic)
		deco("GardenWallTile", V(4.5, 1, WIDTH + 8), CFrame.new(x * (LENGTH / 2 + 1.25), 14.5, 0), TILE, Enum.Material.SmoothPlastic)
	end

	-- Pagoda central: planta baja abierta con columnas rojas y núcleo; segunda planta a 10 de altura
	block("PagodaBase", V(26, 1.4, 26), CFrame.new(0, 0.7, 0), STONE, Enum.Material.SmoothPlastic)
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			Kit.cylinder("PagodaColumn", 9, 1.6, CFrame.new(x * 10, 5.9, z * 10), RED, Enum.Material.SmoothPlastic)
		end
	end
	block("PagodaCore", V(6, 9, 6), CFrame.new(0, 5.9, 0), PLASTER, Enum.Material.SmoothPlastic)
	block("PagodaDeck", V(24, 1, 24), CFrame.new(0, 10.9, 0), WOOD, Enum.Material.WoodPlanks)
	deco("PagodaRoof1", V(32, 0.8, 32), CFrame.new(0, 10.1, 0), TILE, Enum.Material.SmoothPlastic)
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			Kit.cylinder("PagodaColumn2", 8, 1.2, CFrame.new(x * 9, 15.4, z * 9), RED, Enum.Material.SmoothPlastic)
		end
	end
	block("PagodaRoof2", V(24, 1, 24), CFrame.new(0, 19.9, 0), TILE, Enum.Material.SmoothPlastic)
	deco("PagodaRoof2Top", V(14, 2, 14), CFrame.new(0, 21.4, 0), TILE, Enum.Material.SmoothPlastic)
	Kit.cylinder("PagodaSpire", 6, 0.6, CFrame.new(0, 25, 0), RGB(230, 180, 60), Enum.Material.SmoothPlastic, nil, true)
	for i = 1, 3 do
		Kit.cylinder("SpireRing", 0.3, 1.6 - i * 0.3, CFrame.new(0, 22.6 + i * 1.2, 0), RGB(230, 180, 60), Enum.Material.SmoothPlastic, nil, true)
	end
	Kit.symmetric(function(m)
		-- Barandilla de la segunda planta (con hueco para la escalera) y escalera
		Kit.railing((m * CFrame.new(-11.5, 11.4, 11.5)).Position, (m * CFrame.new(11.5, 11.4, 11.5)).Position, 2.6, RED)
		Kit.railing((m * CFrame.new(-11.5, 11.4, -11.5)).Position, (m * CFrame.new(-11.5, 11.4, 1.5)).Position, 2.6, RED)
		Kit.railing((m * CFrame.new(-11.5, 11.4, 7.5)).Position, (m * CFrame.new(-11.5, 11.4, 11.5)).Position, 2.6, RED)
		Kit.stairs((m * CFrame.new(-28, 0, 4.5)).Position, (m * CFrame.new(-12.5, 11.4, 4.5)).Position, 5, WOOD, Enum.Material.WoodPlanks)
		lantern(m * CFrame.new(-15, 0, -15))
	end)

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(235, 70, 80) or RGB(70, 140, 255)
		-- Camino de piedra desde la base
		block("StonePath", V(46, 0.2, 8), m * CFrame.new(-66, 0.1, 0), STONE, Enum.Material.SmoothPlastic)
		for i = 0, 5 do
			deco("SteppingStone", V(3, 0.25, 3), m * CFrame.new(-40 + i * 4.5, 0.15, -20 - (i % 2) * 2) * CFrame.Angles(0, i, 0), STONE, Enum.Material.SmoothPlastic)
		end
		torii(m * CFrame.new(-80, 0, 0) * CFrame.Angles(0, rad(90), 0))

		-- Estanque con puente de madera
		pond(m * V(-45, 0, 38), 11, side == "A" and 5 or 6)
		block("Bridge", V(4, 0.6, 26), m * CFrame.new(-45, 0.9, 38), WOOD, Enum.Material.WoodPlanks)
		for _, x in { -2.2, 2.2 } do
			Kit.railing((m * CFrame.new(-45 + x, 1.2, 26)).Position, (m * CFrame.new(-45 + x, 1.2, 50)).Position, 1.8, RED)
		end

		-- Casa de té y coberturas de piedra con tejadillo
		teaHouse(m * CFrame.new(-62, 0, -42))
		for _, spec in { { V(-28, 0, -12), V(10, 3.5, 2) }, { V(-50, 0, 10), V(2, 3.5, 10) }, { V(-75, 0, 28), V(8, 3.5, 2) }, { V(-24, 0, 30), V(2, 3.5, 8) }, { V(-90, 0, -55), V(8, 3.5, 2) } } do
			local p, size = spec[1], spec[2]
			block("StoneWall", size, m * CFrame.new(p + V(0, size.Y / 2, 0)), STONE_DARK, Enum.Material.SmoothPlastic)
			deco("StoneWallTile", V(size.X + 0.8, 0.5, size.Z + 0.8), m * CFrame.new(p + V(0, size.Y + 0.25, 0)), TILE, Enum.Material.SmoothPlastic)
		end
		Kit.crate(m * CFrame.new(-36, 0, -40), 4)
		Kit.crate(m * CFrame.new(-36, 0, -35.5), 3)
		Kit.barrel(m * CFrame.new(-84, 0, 40), teamColor)

		-- Vegetación: cerezos, bambú, flores y linternas
		for i, p in { V(-100, 0, 58), V(-28, 0, 62), V(-70, 0, 62), V(-98, 0, -62), V(-20, 0, -62) } do
			cherryTree(m * p, 1 + (i % 2) * 0.2, i + (side == "A" and 0 or 10))
		end
		bamboo(m * V(-108, 0, 30), side == "A" and 8 or 9)
		bamboo(m * V(-30, 0, -50), side == "A" and 10 or 11)
		for i, p in { V(-56, 0, 22), V(-30, 0, 46), V(-80, 0, -30), V(-12, 0, -44) } do
			Kit.flowers(m * p, 3, i * 7 + (side == "A" and 0 or 50))
		end
		lantern(m * CFrame.new(-72, 0, 8))
		lantern(m * CFrame.new(-72, 0, -8))
		lantern(m * CFrame.new(-56, 0, 50))
	end)

	-- Pétalos de cerezo cayendo sobre todo el jardín
	local sky = deco("FallingPetals", V(LENGTH, 1, WIDTH), CFrame.new(0, 34, 0), RGB(255, 190, 220), Enum.Material.SmoothPlastic)
	sky.Transparency = 1
	sky.CastShadow = false
	local petals = Instance.new("ParticleEmitter")
	petals.Name = "Petals"
	petals.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	petals.Color = ColorSequence.new(RGB(255, 180, 210), RGB(255, 230, 240))
	petals.Size = NumberSequence.new(0.3)
	petals.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.9, 0.1), NumberSequenceKeypoint.new(1, 1) })
	petals.Lifetime = NumberRange.new(10, 13)
	petals.Speed = NumberRange.new(2.5, 3.5)
	petals.SpreadAngle = Vector2.new(25, 25)
	petals.RotSpeed = NumberRange.new(-120, 120)
	petals.Acceleration = V(0.4, 0, 0.1)
	petals.Rate = 28
	petals.WindAffectsDrag = true
	petals.EmissionDirection = Enum.NormalId.Bottom
	petals.Parent = sky

	-- Bases y banderas
	local spawnStyle = { Floor = STONE, Roof = TILE }
	Kit.spawnArea(teams[1], CFrame.new(-100, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-100, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-70, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-70, 0, 0))

	-- Límites y fondo: cerezos fuera del muro, colinas en flor y montaña nevada
	Kit.bounds(LENGTH, WIDTH, 50)
	for x = -140, 140, 28 do
		for _, z in { -1, 1 } do
			local position = V(x + z * 10, 0, z * (90 + (math.abs(x) % 13)))
			Kit.cylinder("CherryTrunk", 7, 1.4, CFrame.new(position + V(0, 3.5, 0)), WOOD_DARK, Enum.Material.Wood)
			local crown = Kit.ball("Blossom", 9, CFrame.new(position + V(0, 9, 0)), PINK[(math.abs(x) // 28) % 3 + 1], Enum.Material.SmoothPlastic, true)
			crown.CastShadow = false
		end
	end
	for x = -200, 200, 70 do
		for _, z in { -1, 1 } do
			Kit.naturalHill(V(x, -18, z * 150), 50, Enum.Material.Grass, { Inward = V(0, 0, -z), Top = Enum.Material.LeafyGrass, TopCount = 6, RockCount = 1 })
		end
	end
	Kit.naturalHill(V(260, -40, 120), 95, Enum.Material.Rock, { Inward = V(-1, 0, 0), Top = Enum.Material.Snow, TopCount = 6, Rock = Enum.Material.Slate })
	for _, sx in { -1, 1 } do
		for z = -100, 100, 70 do
			Kit.naturalHill(V(sx * 185, -18, z), 50, Enum.Material.Grass, { Inward = V(-sx, 0, 0), Top = Enum.Material.LeafyGrass, RockCount = 1 })
		end
	end

	-- Modos
	for _, p in {
		V(-98, 0.5, 50), V(-80, 0.5, -20), V(-58, 0.5, 0), V(-38, 0.5, 18), V(-26, 0.5, -26),
		V(-62, 1.1, -42), V(-45, 1.7, 30), V(-12, 0.5, 52), V(-92, 0.5, -64), V(-4, 11.9, -6),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, 11.4, 0), 7, 1)
	Kit.zone(V(-62, 0.6, -42), 6, 2)
	Kit.zone(V(62, 0.6, 42), 6, 3)
	Kit.zone(V(-45, 1.2, 38), 6, 4)
	Kit.zone(V(45, 1.2, -38), 6, 5)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">Summit</string>
              <string name="Source"><![CDATA[-- CUMBRE: estación de montaña nevada al atardecer, al estilo de los mapas 5 contra 5 de los
-- shooters de móvil. En el centro el refugio (dos plantas, se entra por los cuatro lados). Por el
-- carril central la carretera con la quitanieves y rocas; a un lado la estación del teleférico,
-- en alto, con su cabina (puesto de tirador); al otro el laboratorio, la cúpula del radar y los
-- depósitos de combustible. Simétrico por rotación. Siempre en estilo realista.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)
local RealKit = require(script.Parent.Parent.RealKit)

local Map = {
	Id = "Summit",
	Bomb = true, -- tiene sitios para Buscar y destruir
	Name = "Cumbre",
	Icon = "🏔️",
	Description = "Estación de montaña nevada · teleférico y laboratorio · 5 contra 5",
	Realistic = true,
}

Map.Lighting = {
	ClockTime = 17.3,
	Latitude = 50,
	Brightness = 2.4,
	Exposure = 0.05,
	Ambient = Color3.fromRGB(80, 86, 104),
	OutdoorAmbient = Color3.fromRGB(150, 158, 182),
	ShadowSoftness = 0.12,
	Atmosphere = { Density = 0.36, Offset = 0.18, Color = Color3.fromRGB(210, 196, 214), Decay = Color3.fromRGB(120, 112, 150), Glare = 0.6, Haze = 1.8 },
	Color = { Saturation = -0.04, Contrast = 0.15, Brightness = 0.02, Tint = Color3.fromRGB(240, 238, 255) },
	Bloom = { Intensity = 0.55, Size = 26, Threshold = 1.9 },
	Clouds = 0.45,
	CloudColor = Color3.fromRGB(255, 220, 210),
	SunRays = 0.1,
	SunSize = 26,
	Wind = Vector3.new(10, 0, 4),
	TerrainColors = { Snow = Color3.fromRGB(232, 236, 246), Rock = Color3.fromRGB(96, 98, 108), Glacier = Color3.fromRGB(170, 205, 235) },
}

-- Versiones de luz (a veces): mediodía despejado con el cielo azul
Map.LightingVariants = {
	{
		Name = "Mediodía",
		Chance = 0.3,
		ClockTime = 12.4,
		Brightness = 3,
		Exposure = -0.05,
		Ambient = Color3.fromRGB(90, 98, 112),
		OutdoorAmbient = Color3.fromRGB(160, 170, 190),
		Atmosphere = { Density = 0.28, Offset = 0.2, Color = Color3.fromRGB(205, 222, 245), Decay = Color3.fromRGB(120, 140, 170), Glare = 0.3, Haze = 1 },
		Color = { Saturation = 0, Contrast = 0.14, Brightness = 0, Tint = Color3.fromRGB(245, 250, 255) },
		CloudColor = Color3.fromRGB(255, 255, 255),
		SunRays = 0.06,
	},
	{
		-- Ventisca: nieve fuerte y en diagonal, niebla blanca (se ve poco de lejos) y mucho viento
		Name = "Ventisca",
		Chance = 0.25,
		Weather = "Snowstorm",
		ClockTime = 14,
		Brightness = 1.6,
		Exposure = 0.1,
		Ambient = Color3.fromRGB(110, 116, 128),
		OutdoorAmbient = Color3.fromRGB(170, 176, 190),
		Atmosphere = { Density = 0.5, Offset = 0.05, Color = Color3.fromRGB(220, 226, 236), Decay = Color3.fromRGB(170, 178, 192), Glare = 0, Haze = 3 },
		Color = { Saturation = -0.2, Contrast = 0.08, Brightness = 0.03, Tint = Color3.fromRGB(235, 242, 255) },
		Clouds = 1,
		CloudColor = Color3.fromRGB(200, 204, 212),
		SunRays = 0,
		Wind = Vector3.new(26, 0, 10),
	},
}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad
local M = Enum.Material

local LENGTH, WIDTH = 400, 260
local FLOOR_H = RealKit.FLOOR_H
local building, solidBlock, sandbags = RealKit.building, RealKit.solidBlock, RealKit.sandbags
local block, deco = Kit.block, Kit.deco

local SNOW = RGB(236, 240, 248)
local STONE = RGB(110, 112, 120)
local WOOD = RGB(116, 84, 58)

---------------------------------------------------------------------------
-- Piezas de la montaña
---------------------------------------------------------------------------

-- Capa de nieve encima de una pieza
local function snowCap(part)
	local s = part.Size
	local cap = deco("SnowCap", V(s.X + 0.3, 0.35, s.Z + 0.3), part.CFrame * CFrame.new(0, s.Y / 2 + 0.17, 0), SNOW, M.Snow)
	cap.CastShadow = false
	return cap
end

-- Muro de piedra con nieve encima (cobertura)
local function stoneWall(cf, length, height)
	local wall = block("StoneWall", V(length, height, 2), cf * CFrame.new(0, height / 2, 0), STONE, M.Slate)
	snowCap(wall)
	Kit.contactShadow(cf, length + 0.4, 2.4)
	return wall
end

-- Pino nevado (verde oscuro con nieve en las ramas)
local function snowyPine(position, scale)
	Kit.cartoonPine(position, scale, true)
end

-- Quitanieves (cobertura grande en la carretera)
local function snowplow(cf)
	local orange = RGB(220, 120, 30)
	block("PlowCab", V(6, 6.5, 7), cf * CFrame.new(-6, 3.8, 0), orange, M.Metal)
	deco("PlowWindow", V(0.2, 2.2, 6), cf * CFrame.new(-9.1, 5.4, 0), RGB(30, 34, 40), M.Glass)
	block("PlowBody", V(12, 4, 7), cf * CFrame.new(3, 2.8, 0), orange, M.Metal)
	block("PlowBlade", V(1, 3, 10), cf * CFrame.new(-11, 1.5, 0) * CFrame.Angles(0, rad(-12), 0), RGB(200, 200, 205), M.Metal)
	for _, x in { -6, 2, 6 } do
		for _, z in { -3.4, 3.4 } do
			local wheel = deco("Wheel", V(3, 3, 1.2), cf * CFrame.new(x, 1.5, z) * CFrame.Angles(0, math.pi / 2, 0), RGB(28, 28, 30), M.Rubber)
			wheel.Shape = Enum.PartType.Cylinder
		end
	end
	local light = deco("PlowBeacon", V(1, 0.6, 1), cf * CFrame.new(-6, 7.4, 0), RGB(255, 170, 40), M.Neon)
	Kit.light(light, "PointLight", RGB(255, 170, 40), 14, 1.2)
	Kit.contactShadow(cf * CFrame.new(-2, 0, 0), 22, 8)
end

-- Depósito de combustible (cilindro tumbado sobre patas)
local function fuelTank(cf)
	Kit.pipe("FuelTank", 14, 6, cf * CFrame.new(0, 4.5, 0), RGB(200, 202, 206), M.Metal)
	for _, x in { -5, 5 } do
		block("TankLeg", V(1, 2, 5), cf * CFrame.new(x, 1, 0), RGB(80, 80, 86), M.Metal)
	end
	deco("TankStripe", V(1, 6.1, 6.1), cf * CFrame.new(0, 4.5, 0), RGB(200, 60, 40), M.Metal).Shape = Enum.PartType.Cylinder
	deco("TankSnow", V(12, 0.4, 3), cf * CFrame.new(0, 7.6, 0), SNOW, M.Snow)
end

-- Estación del teleférico: plataforma en alto con rampa, barandilla, cabina y torre del cable
local function cableStation(cf)
	local height = 9
	block("StationDeck", V(26, 1, 18), cf * CFrame.new(0, height - 0.5, 0), RGB(130, 132, 138), M.Concrete)
	for _, x in { -11, 11 } do
		for _, z in { -7, 7 } do
			block("StationPillar", V(1.6, height - 1, 1.6), cf * CFrame.new(x, (height - 1) / 2, z), RGB(120, 122, 128), M.Concrete)
		end
	end
	snowCap(block("StationRoof", V(28, 1, 20), cf * CFrame.new(0, height + 8, 0), RGB(90, 92, 100), M.CorrodedMetal))
	for _, x in { -12.5, 12.5 } do
		deco("RoofPost", V(0.8, 7, 0.8), cf * CFrame.new(x, height + 4, 8.5), RGB(70, 72, 78), M.Metal)
		deco("RoofPost", V(0.8, 7, 0.8), cf * CFrame.new(x, height + 4, -8.5), RGB(70, 72, 78), M.Metal)
	end
	-- Parapeto delantero (cobertura) y barandillas
	block("StationParapet", V(26, 2.6, 0.8), cf * CFrame.new(0, height + 1.3, -8.6), RGB(140, 142, 148), M.Concrete)
	-- (con hueco donde llega la rampa)
	Kit.railing(cf * V(-13, height, 8.6), cf * V(-9.5, height, 8.6), 3, RGB(60, 62, 66))
	Kit.railing(cf * V(-2.5, height, 8.6), cf * V(13, height, 8.6), 3, RGB(60, 62, 66))
	-- Cabina colgada del cable (se puede usar como cobertura arriba)
	local cabin = block("CableCabin", V(8, 6, 5), cf * CFrame.new(4, height + 3, 2), RGB(200, 40, 40), M.Metal)
	deco("CabinWindows", V(8.1, 2, 5.1), cf * CFrame.new(4, height + 4.4, 2), RGB(40, 48, 58), M.Glass)
	snowCap(cabin)
	deco("Cable", V(0.25, 0.25, 200), cf * CFrame.new(4, height + 7.8, 2) * CFrame.Angles(rad(-8), rad(90), 0) * CFrame.new(0, 0, -100), RGB(40, 40, 42), M.Metal)
	-- Telesillas colgando del cable, montaña arriba (solo vista)
	local cableStart = cf * CFrame.new(4, height + 7.8, 2) * CFrame.Angles(rad(-8), rad(90), 0)
	for d = 30, 150, 30 do
		local hook = cableStart * CFrame.new(0, 0, -d)
		local hang = CFrame.new(hook.Position) * (cf - cf.Position) -- (cuelga recta, sin la inclinación del cable)
		deco("ChairHanger", V(0.18, 3.2, 0.18), hang * CFrame.new(0, -1.6, 0), RGB(60, 60, 64), M.Metal)
		deco("ChairSeat", V(3.4, 0.3, 1.2), hang * CFrame.new(0, -3.3, 0), RGB(200, 40, 40), M.Metal)
		deco("ChairBack", V(3.4, 1.2, 0.2), hang * CFrame.new(0, -2.7, 0.55), RGB(200, 40, 40), M.Metal)
		deco("ChairSnow", V(3.4, 0.12, 1.2), hang * CFrame.new(0, -3.1, 0), SNOW, M.Snow)
	end
	-- Rampa por detrás
	Kit.ramp(cf * V(-6, 0, 26), cf * V(-6, height, 9.5), 6, RGB(120, 100, 76), M.WoodPlanks)
end

-- Cúpula del radar
local function radarDome(cf)
	block("RadarBase", V(10, 6, 10), cf * CFrame.new(0, 3, 0), RGB(150, 152, 158), M.Concrete)
	Kit.ball("RadarDome", 11, cf * CFrame.new(0, 8, 0), RGB(240, 242, 246), M.SmoothPlastic)
	local beacon = Kit.ball("RadarBeacon", 0.8, cf * CFrame.new(0, 13.6, 0), RGB(255, 50, 40), M.Neon, true)
	beacon:SetAttribute("Blink", 1.2)
end

---------------------------------------------------------------------------
-- Mapa
---------------------------------------------------------------------------

function Map.Build()
	local folder = Kit.Begin(Map.Name, { Realistic = true })
	folder:SetAttribute("Ambience", "Wind") -- (sonido ambiente: ver Ambience en el cliente)
	Kit.applyLighting(Kit.pickLighting(Map))
	folder:SetAttribute("Variant", Kit.Variant)
	folder:SetAttribute("Weather", Kit.Weather)
	local teams = GameConfig.Teams

	-- Suelo nevado con la carretera despejada
	Kit.terrainFloor(M.Snow, LENGTH + 260, WIDTH + 260)
	block("Road", V(LENGTH + 30, 0.4, 20), CFrame.new(0, 0.2, 0), RGB(84, 86, 92), M.Asphalt)
	for _, z in { -1, 1 } do
		deco("RoadSnowBank", V(LENGTH - 40, 1.2, 3), CFrame.new(0, 0.6, z * 11.5), SNOW, M.Snow)
	end
	block("CrossPath", V(18, 0.3, WIDTH - 40), CFrame.new(0, 0.15, 0), RGB(170, 172, 180), M.Pavement)

	-- Refugio en el centro: dos plantas, puertas a los cuatro lados
	building(CFrame.new(0, 0, 0), 32, 24, {
		Floors = 2,
		Color = RGB(150, 112, 80),
		Material = M.WoodPlanks,
		Doors = { Front = { 7 }, Back = { -7 }, Right = { 0 } }, -- (por la izquierda va la escalera)
		Sign = "REFUGIO",
	})
	Kit.cylinder("Chimney", 6, 2.4, CFrame.new(-10, 19, 6), STONE, M.Slate, nil, true)

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and teams[1].Color.Color or teams[2].Color.Color

		-- Ambiente de montaña: balizas naranjas a los lados de la carretera, roca que asoma entre la
		-- nieve, un estanque helado y vallas de madera contra la nieve (todo sin colisión)
		for x = -176, -24, 19 do
			for _, z in { -1, 1 } do
				local px = x + (z > 0 and 9 or 0)
				-- (no dentro de las rocas del borde de la carretera)
				if (z < 0 and math.abs(px + 100) < 7) or (z > 0 and math.abs(px + 28) < 7) then
					continue
				end
				local base = m * CFrame.new(px, 0, z * 14)
				Kit.cylinder("SnowPole", 4.4, 0.28, base * CFrame.new(0, 2.2, 0), RGB(235, 110, 30), M.SmoothPlastic, nil, true)
				Kit.cylinder("SnowPoleBand", 0.6, 0.3, base * CFrame.new(0, 3.9, 0), RGB(30, 30, 32), M.SmoothPlastic, nil, true)
			end
		end
		for _, rock in { { -166, -52, 16, 10 }, { -84, 52, 12, 8 }, { -18, -46, 10, 7 }, { -136, 126, 18, 9 }, { -96, -124, 16, 8 } } do
			Kit.terrainPatch(m * CFrame.new(rock[1], 0, rock[2]) * CFrame.Angles(0, rad(rock[1] % 60), 0), V(rock[3], 1, rock[4]), M.Rock)
		end
		Kit.terrainPatch(m * CFrame.new(-128, 0, 50), V(22, 1, 12), M.Glacier)
		for i = 0, 5 do
			local post = m * CFrame.new(-176 + i * 3.2, 0, 44)
			deco("SnowFencePost", V(0.3, 3.4, 0.3), post * CFrame.new(0, 1.7, 0), RGB(96, 72, 50), M.Wood)
			if i < 5 then
				for _, y in { 1.1, 2.4 } do
					deco("SnowFenceSlat", V(3.2, 0.5, 0.12), post * CFrame.new(1.6, y, 0) * CFrame.Angles(0, 0, rad((i % 2) * 4 - 2)), RGB(120, 90, 60), M.WoodPlanks)
				end
			end
		end

		------------------------------------------------------------------
		-- Carretera central (z -20..20)
		------------------------------------------------------------------
		snowplow(m * CFrame.new(-118, 0, -6) * CFrame.Angles(0, rad(15), 0))
		stoneWall(m * CFrame.new(-90, 0, 8), 12, 4)
		stoneWall(m * CFrame.new(-62, 0, -10) * CFrame.Angles(0, rad(90), 0), 9, 4)
		sandbags(m * CFrame.new(-36, 0, 6), 9)
		for _, p in { V(-140, 0, 14), V(-76, 0, 15), V(-48, 0, -15) } do
			Kit.crate(m * CFrame.new(p), 4)
		end
		Kit.rockCluster(m * V(-100, 0, -16), 4)
		Kit.rockCluster(m * V(-28, 0, 16), 3.5)

		------------------------------------------------------------------
		-- Separaciones: muros de piedra con huecos, cabañas y depósitos
		------------------------------------------------------------------
		for _, seg in { { -168, -140 }, { -126, -96 }, { -82, -54 } } do
			stoneWall(m * CFrame.new((seg[1] + seg[2]) / 2, 0, 30), seg[2] - seg[1], 5)
		end
		solidBlock(m * CFrame.new(-40, 0, 36), 18, 12, 8, WOOD, { Material = M.WoodPlanks, Sign = side == "A" and "ALQUILER DE ESQUÍS" or "TAQUILLA" })
		fuelTank(m * CFrame.new(-150, 0, -36))
		fuelTank(m * CFrame.new(-120, 0, -38))
		stoneWall(m * CFrame.new(-86, 0, -30), 26, 5)
		stoneWall(m * CFrame.new(-44, 0, -30), 20, 5)

		------------------------------------------------------------------
		-- Carril norte (z 50..125): estación del teleférico
		------------------------------------------------------------------
		cableStation(m * CFrame.new(-100, 0, 88))
		stoneWall(m * CFrame.new(-150, 0, 70) * CFrame.Angles(0, rad(90), 0), 18, 5)
		stoneWall(m * CFrame.new(-48, 0, 100), 16, 4)
		sandbags(m * CFrame.new(-22, 0, 74) * CFrame.Angles(0, rad(90), 0), 10)
		Kit.metalCrate(m * CFrame.new(-60, 0, 66), 5, RGB(90, 96, 110))
		Kit.metalCrate(m * CFrame.new(-60, 5, 66), 4, RGB(90, 96, 110))
		solidBlock(m * CFrame.new(-70, 0, 114), 16, 12, 7, WOOD, { Material = M.WoodPlanks })
		Kit.rockCluster(m * V(-128, 0, 116), 6)
		Kit.rockCluster(m * V(-30, 0, 118), 5)

		------------------------------------------------------------------
		-- Carril sur (z -125..-50): laboratorio, radar y trincheras
		------------------------------------------------------------------
		building(m * CFrame.new(-104, 0, -86) * CFrame.Angles(0, math.pi, 0), 36, 22, {
			Floors = 1,
			Color = RGB(196, 200, 206),
			Material = M.Concrete,
			Doors = { Front = { -10, 10 }, Back = { 0 }, Right = { 0 } },
			Sign = "LABORATORIO",
		})
		radarDome(m * CFrame.new(-50, 0, -104))
		sandbags(m * CFrame.new(-66, 0, -62), 12)
		sandbags(m * CFrame.new(-150, 0, -66), 10)
		sandbags(m * CFrame.new(-20, 0, -72) * CFrame.Angles(0, rad(90), 0), 10)
		solidBlock(m * CFrame.new(-84, 0, -120), 14, 10, 6, WOOD, { Material = M.WoodPlanks, Windows = false })
		Kit.rockCluster(m * V(-150, 0, -112), 6)

		------------------------------------------------------------------
		-- Bosque y montañas alrededor; banderas de la base
		------------------------------------------------------------------
		for i = 0, 8 do
			local x = -LENGTH / 2 + i * 24
			for _, z in { -1, 1 } do
				snowyPine(m * V(x + z * 6, 0, z * (WIDTH / 2 + 12 + (i % 3) * 8)), 1.5 + (i % 2) * 0.4)
			end
		end
		for _, z in { -100, -40, 40, 100 } do
			snowyPine(m * V(-LENGTH / 2 - 14, 0, z), 1.7)
		end
		for _, z in { -30, 30 } do
			Kit.banner(m * CFrame.new(-205, 6, z) * CFrame.Angles(0, rad(90), 0), 5, 9, teamColor, RGB(240, 240, 240))
		end
		block("BaseWall", V(2, 12, 90), m * CFrame.new(-206.5, 6, 0), STONE, M.Slate)
	end)

	-- Pinos nevados: verde oscuro y nieve
	for _, part in folder:GetDescendants() do
		if part:IsA("BasePart") and part.Name == "PineTier" then
			local high = math.floor(part.Position.Y) % 3 == 0
			part.Color = high and RGB(220, 226, 236) or RGB(40, 64, 46)
			part.Material = high and M.Snow or M.LeafyGrass
		end
	end

	-- Nieve acumulada en todo lo que mira hacia arriba: tejados, cornisas, alféizares, parapetos,
	-- cajas, sacos, máquinas de las azoteas y vehículos (capas finas, sin sombra ni colisión)
	local SNOWY = {
		Roof = true, Cornice = true, Sill = true, Lintel = true, Parapet = true, Crate = true, MetalCrate = true,
		Sandbags = true, RoofAC = true, Band = true, PlowCab = true, PlowBody = true, Cover = true, WaterTank = false,
	}
	local capped = {}
	for _, part in folder:GetDescendants() do
		if part:IsA("BasePart") and SNOWY[part.Name] and part.CFrame.UpVector.Y > 0.97 and part.Shape == Enum.PartType.Block then
			table.insert(capped, part)
		end
	end
	for _, part in capped do
		local s = part.Size
		local thick = (part.Name == "Roof" or part.Name == "Parapet") and 0.45 or 0.22
		local cap = deco("SnowCap", V(s.X + 0.15, thick, s.Z + 0.15), part.CFrame * CFrame.new(0, s.Y / 2 + thick / 2, 0), SNOW, M.Snow)
		cap.CastShadow = false
	end

	-- Zonas de salida, banderas y límites
	local spawnStyle = { Floor = RGB(120, 122, 128), FloorMaterial = M.Concrete, Roof = RGB(90, 92, 100), RoofMaterial = M.CorrodedMetal }
	Kit.spawnArea(teams[1], CFrame.new(-184, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-184, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-160, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-160, 0, 0))
	Kit.bounds(LENGTH, WIDTH, 70)

	-- Montañas nevadas alrededor y nieve cayendo
	for _, spec in { { V(-320, 0, 230), 120 }, { V(320, 0, -230), 120 }, { V(40, 0, 320), 130 }, { V(-40, 0, -320), 130 }, { V(-350, 0, -140), 100 }, { V(350, 0, 140), 100 } } do
		Kit.naturalHill(spec[1], spec[2], M.Snow)
	end
	local snow = deco("SnowEmitter", V(LENGTH, 1, WIDTH), CFrame.new(0, 60, 0), SNOW, M.SmoothPlastic)
	snow.Transparency = 1
	local flakes = Instance.new("ParticleEmitter")
	flakes.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	flakes.Color = ColorSequence.new(Color3.new(1, 1, 1))
	flakes.Size = NumberSequence.new(0.25)
	flakes.Transparency = NumberSequence.new(0.2)
	flakes.Lifetime = NumberRange.new(10, 14)
	flakes.Speed = NumberRange.new(4, 7)
	flakes.SpreadAngle = Vector2.new(20, 20)
	flakes.Rate = Kit.Weather == "Snowstorm" and 420 or 120
	if Kit.Weather == "Snowstorm" then
		flakes.Speed = NumberRange.new(10, 16)
		flakes.Lifetime = NumberRange.new(5, 7)
	end
	flakes.EmissionDirection = Enum.NormalId.Bottom
	flakes.WindAffectsDrag = true
	flakes.Drag = 0.4
	flakes.Parent = snow

	-- Puntos de salida libres
	for _, p in {
		V(-150, 0.5, -6), V(-110, 0.5, 8), V(-74, 0.5, -6), V(-44, 0.5, 14),
		V(-160, 0.5, 90), V(-128, 0.5, 64), V(-70, 0.5, 90), V(-24, 0.5, 100),
		V(-160, 0.5, -90), V(-104, 0.5, -112), V(-70, 0.5, -84), V(-24, 0.5, -100),
		V(-108, 9.5, 92), V(-104, 0.5, -86),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	-- Puestos de los tiradores: la estación del teleférico y la planta de arriba del refugio
	for _, spot in {
		{ V(-96, 9, 82), V(-20, 4, 70) },
		{ V(-4, FLOOR_H, -9.3), V(-4, 4, -60) }, -- ventana de arriba del refugio
	} do
		Kit.botSpot(spot[1], spot[2])
		Kit.botSpot(Kit.MIRROR * spot[1], Kit.MIRROR * spot[2])
	end
	-- Buscar y destruir: cada equipo defiende dos sitios en su mitad (A y B)
	for _, site in { { V(-100, 0, 88), "A" }, { V(-135, 0, -105), "B" } } do
		Kit.bombSite(site[1], site[2], 1)
		Kit.bombSite(Kit.MIRROR * site[1], site[2], 2)
	end
	-- Zonas de control
	Kit.zone(V(0, 0, 20), 10, 1)
	Kit.zone(V(-100, 0, 88), 12, 2)
	Kit.zone(V(100, 0, -88), 12, 3)
	Kit.zone(V(0, 0, -20), 10, 4)
	Kit.zone(V(0, 0, 0), 9, 5)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">TikiBeach</string>
              <string name="Source"><![CDATA[-- PLAYA TIKI: isla tropical de estilo cartoon rodeada de mar. Torre de socorrista jugable en el centro,
-- chozas tiki con techo de paja, palmeras, sombrillas y toallas, tablas de surf, laguna turquesa,
-- antorchas tiki, sacos de arena y un muelle con barcas.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)
local Variants = require(script.Parent.Parent.LightingVariants)

local Map = {
	Id = "TikiBeach",
	Name = "Playa Tiki",
	Icon = "🏝",
	Description = "Isla tropical · mediodía · torre y chozas",
}

Map.Lighting = {
	ClockTime = 14.4,
	Brightness = 3.3,
	Exposure = 0.05,
	Ambient = Color3.fromRGB(125, 122, 130),
	OutdoorAmbient = Color3.fromRGB(175, 170, 175),
	Atmosphere = { Density = 0.22, Offset = 0.2, Color = Color3.fromRGB(200, 230, 255), Decay = Color3.fromRGB(110, 170, 220), Glare = 0, Haze = 0.5 },
	Color = { Saturation = 0.2, Contrast = 0.06, Brightness = 0.03, Tint = Color3.fromRGB(255, 250, 240) },
	Bloom = { Intensity = 0.35, Size = 22, Threshold = 2 },
	Clouds = 0.45,
	SunRays = 0.05,
	ShadowSoftness = 0.3,
	Wind = Vector3.new(5, 0, 2),
	Water = { Color = Color3.fromRGB(30, 170, 190), Reflectance = 0.7, Transparency = 0.5, WaveSize = 0.18, WaveSpeed = 9 },
	TerrainColors = {
		Sand = Color3.fromRGB(240, 215, 150),
		Rock = Color3.fromRGB(150, 135, 120),
		Grass = Color3.fromRGB(110, 200, 90),
		LeafyGrass = Color3.fromRGB(70, 170, 80),
	},
}
-- A veces sale con otra luz o con mal tiempo (ver LightingVariants)
Map.LightingVariants = { Variants.Sunset(0.3), Variants.Storm(0.15) }

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad

local SAND = RGB(244, 218, 150)
local WOOD = RGB(170, 115, 65)
local WOOD_DARK = RGB(120, 78, 45)
local THATCH = RGB(222, 182, 98)
local LAGOON = RGB(60, 210, 220)
local STRIPES = { RGB(255, 80, 90), RGB(60, 150, 255), RGB(255, 200, 50), RGB(80, 210, 120) }

local LENGTH, WIDTH = 230, 150

-- Techo de paja a cuatro aguas (cuatro faldones inclinados y una punta)
local function thatchRoof(cf, w, d)
	for _, s in { -1, 1 } do
		Kit.deco("Thatch", V(w + 3, 0.8, d / 2 + 2.5), cf * CFrame.new(0, 0, s * (d / 4 + 0.4)) * CFrame.Angles(rad(s * 28), 0, 0), THATCH, Enum.Material.SmoothPlastic)
		Kit.deco("ThatchSide", V(w / 2 + 1, 0.8, d + 1), cf * CFrame.new(s * (w / 4 + 0.6), -0.4, 0) * CFrame.Angles(0, 0, rad(-s * 28)), THATCH:Lerp(RGB(180, 140, 70), 0.3), Enum.Material.SmoothPlastic)
	end
	Kit.deco("ThatchTop", V(2.4, 1.6, d * 0.4), cf * CFrame.new(0, d / 4 + 0.6, 0), THATCH:Lerp(RGB(150, 110, 50), 0.3), Enum.Material.SmoothPlastic)
end

-- Antorcha tiki con fuego
local function tikiTorch(cf)
	Kit.cylinder("TikiPole", 6, 0.5, cf * CFrame.new(0, 3, 0), WOOD_DARK, Enum.Material.Wood)
	local cup = Kit.cylinder("TikiCup", 1, 1, cf * CFrame.new(0, 6.3, 0), RGB(90, 60, 40), Enum.Material.Wood, nil, true)
	local fire = Instance.new("Fire")
	fire.Size = 2.5
	fire.Heat = 5
	fire.Color = RGB(255, 140, 40)
	fire.SecondaryColor = RGB(255, 220, 80)
	fire.Parent = cup
	Kit.light(cup, "PointLight", RGB(255, 170, 80), 14, 1.2)
end

-- Sombrilla de rayas con toalla
local function umbrella(cf, colorA, colorB)
	Kit.cylinder("UmbrellaPole", 7, 0.25, cf * CFrame.new(0, 3.5, 0), RGB(240, 240, 240), Enum.Material.SmoothPlastic, nil, true)
	for i = 0, 7 do
		Kit.deco("UmbrellaCloth", V(2.6, 0.2, 4.4), cf * CFrame.Angles(0, i * math.pi / 4, 0) * CFrame.new(0, 6.5, -2) * CFrame.Angles(rad(-18), 0, 0), i % 2 == 0 and colorA or colorB, Enum.Material.SmoothPlastic)
	end
	Kit.deco("Towel", V(3, 0.08, 6), cf * CFrame.new(2.5, 0.05, 1) * CFrame.Angles(0, rad(15), 0), colorB, Enum.Material.SmoothPlastic)
	Kit.deco("TowelStripe", V(3.02, 0.09, 0.8), cf * CFrame.new(2.5, 0.05, 1) * CFrame.Angles(0, rad(15), 0), colorA, Enum.Material.SmoothPlastic)
end

-- Tabla de surf clavada en la arena
local function surfboard(cf, color)
	Kit.deco("Surfboard", V(1.8, 6.5, 0.3), cf * CFrame.new(0, 3, 0) * CFrame.Angles(rad(8), 0, 0), color, Enum.Material.SmoothPlastic)
	Kit.deco("SurfStripe", V(0.4, 6.4, 0.32), cf * CFrame.new(0, 3, 0) * CFrame.Angles(rad(8), 0, 0), RGB(255, 255, 255), Enum.Material.SmoothPlastic)
end

-- Choza tiki: suelo elevado de madera, paredes de bambú con puerta y ventana, techo de paja
local function hut(cf)
	local w, d, h = 16, 12, 7
	Kit.block("HutFloor", V(w + 2, 1, d + 2), cf * CFrame.new(0, 0.5, 0), WOOD, Enum.Material.WoodPlanks)
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			Kit.cylinder("HutPost", h + 1, 0.9, cf * CFrame.new(x * w / 2, 1 + h / 2, z * d / 2), WOOD_DARK, Enum.Material.Wood)
		end
	end
	-- Pared trasera completa, laterales con ventana y frontal con puerta (mira a +X)
	Kit.block("HutWall", V(0.6, h, d), cf * CFrame.new(-w / 2, 1 + h / 2, 0), RGB(200, 170, 100), Enum.Material.SmoothPlastic)
	for _, z in { -1, 1 } do
		local face = cf * CFrame.new(0, 0, z * d / 2)
		Kit.block("HutWallLow", V(w, 3, 0.6), face * CFrame.new(0, 2.5, 0), RGB(200, 170, 100), Enum.Material.SmoothPlastic)
		Kit.block("HutWallHigh", V(w, 1.5, 0.6), face * CFrame.new(0, 1 + h - 0.75, 0), RGB(200, 170, 100), Enum.Material.SmoothPlastic)
		for _, x in { -1, 1 } do
			Kit.block("HutWallSide", V(4, h - 4.5, 0.6), face * CFrame.new(x * (w / 2 - 2), 4 + (h - 4.5) / 2, 0), RGB(200, 170, 100), Enum.Material.SmoothPlastic)
		end
	end
	for _, z in { -1, 1 } do
		Kit.block("HutDoorSide", V(0.6, h, (d - 5) / 2), cf * CFrame.new(w / 2, 1 + h / 2, z * (2.5 + (d - 5) / 4)), RGB(200, 170, 100), Enum.Material.SmoothPlastic)
	end
	Kit.block("HutLintel", V(0.6, 1.5, 5), cf * CFrame.new(w / 2, 1 + h - 0.75, 0), RGB(200, 170, 100), Enum.Material.SmoothPlastic)
	Kit.block("HutCeiling", V(w, 0.5, d), cf * CFrame.new(0, 1 + h + 0.25, 0), WOOD, Enum.Material.Wood)
	thatchRoof(cf * CFrame.new(0, 1 + h + 1.6, 0), w, d)
	Kit.block("HutStep", V(3, 0.5, 5), cf * CFrame.new(w / 2 + 2, 0.25, 0), WOOD, Enum.Material.WoodPlanks)
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	folder:SetAttribute("Ambience", "Coast") -- (sonido ambiente: ver Ambience en el cliente)
	Kit.applyLighting(Kit.pickLighting(Map))
	folder:SetAttribute("Variant", Kit.Variant)
	folder:SetAttribute("Weather", Kit.Weather)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Isla de arena y mar alrededor
	block("Sand", V(LENGTH + 20, 2, WIDTH + 20), CFrame.new(0, -1, 0), SAND, Enum.Material.Sand)
	workspace.Terrain:FillBlock(CFrame.new(0, -6, 0), V(900, 10, 700), Enum.Material.Water)
	workspace.Terrain:FillBlock(CFrame.new(0, -12, 0), V(900, 2, 700), Enum.Material.Sand)
	-- Orilla mojada alrededor de la isla
	for _, z in { -1, 1 } do
		deco("WetSand", V(LENGTH + 24, 0.1, 6), CFrame.new(0, 0.02, z * (WIDTH / 2 + 8)), RGB(215, 185, 120), Enum.Material.SmoothPlastic)
	end

	-- Laguna central y torre de socorrista
	local lagoon = Kit.cylinder("Lagoon", 0.3, 34, CFrame.new(0, 0.12, 0), LAGOON, Enum.Material.SmoothPlastic, nil, true)
	lagoon.Reflectance = 0.25
	Kit.cylinder("LagoonRim", 0.2, 37, CFrame.new(0, 0.08, 0), RGB(230, 200, 140), Enum.Material.SmoothPlastic, nil, true)
	local deckY = 9
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			Kit.cylinder("TowerStilt", deckY, 1.4, CFrame.new(x * 8, deckY / 2, z * 8), WOOD_DARK, Enum.Material.Wood)
		end
	end
	block("TowerDeck", V(20, 1, 20), CFrame.new(0, deckY + 0.5, 0), WOOD, Enum.Material.WoodPlanks)
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			Kit.cylinder("TowerRoofPost", 7, 0.7, CFrame.new(x * 8.5, deckY + 4.5, z * 8.5), WOOD_DARK, Enum.Material.Wood, nil, true)
		end
	end
	block("TowerRoof", V(22, 0.6, 22), CFrame.new(0, deckY + 8.2, 0), WOOD, Enum.Material.Wood)
	thatchRoof(CFrame.new(0, deckY + 9.2, 0), 20, 20)
	local flag = deco("LifeguardFlag", V(0.2, 3, 4), CFrame.new(0, deckY + 15, 2), RGB(255, 60, 60), Enum.Material.Fabric)
	flag.CastShadow = false
	Kit.cylinder("FlagPole", 6, 0.25, CFrame.new(0, deckY + 13.5, 0), RGB(240, 240, 240), Enum.Material.SmoothPlastic, nil, true)
	Kit.symmetric(function(m)
		Kit.railing((m * CFrame.new(-10, deckY + 1, 10)).Position, (m * CFrame.new(10, deckY + 1, 10)).Position, 2.4, RGB(255, 255, 255))
		Kit.railing((m * CFrame.new(-10, deckY + 1, -10)).Position, (m * CFrame.new(-10, deckY + 1, 1)).Position, 2.4, RGB(255, 255, 255))
		Kit.railing((m * CFrame.new(-10, deckY + 1, 7)).Position, (m * CFrame.new(-10, deckY + 1, 10)).Position, 2.4, RGB(255, 255, 255))
		Kit.stairs((m * CFrame.new(-25, 0, 4)).Position, (m * CFrame.new(-10.5, deckY + 1, 4)).Position, 5, WOOD, Enum.Material.WoodPlanks)
	end)

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(255, 80, 90) or RGB(60, 150, 255)
		-- Pasarela de madera desde la base
		block("Boardwalk", V(44, 0.4, 7), m * CFrame.new(-64, 0.2, 0), WOOD, Enum.Material.WoodPlanks)
		for i = 0, 9 do
			deco("BoardGap", V(0.15, 0.42, 7.05), m * CFrame.new(-84 + i * 4.4, 0.2, 0), WOOD_DARK, Enum.Material.Wood)
		end

		hut(m * CFrame.new(-55, 0, 42))
		hut(m * CFrame.new(-55, 0, -42) * CFrame.Angles(0, 0, 0))

		-- Sacos de arena (cobertura baja) y cajas
		for _, spec in { { V(-30, 0, -10), 0 }, { V(-45, 0, 12), 90 }, { V(-80, 0, 26), 0 }, { V(-26, 0, 30), 90 }, { V(-88, 0, -50), 0 } } do
			local cf = m * CFrame.new(spec[1]) * CFrame.Angles(0, rad(spec[2]), 0)
			for row = 0, 1 do
				for i = -1, 1 do
					block("Sandbag", V(3.2, 1.6, 2), cf * CFrame.new(i * 3 + row * 1.5 - 0.75, 0.8 + row * 1.5, 0), RGB(200, 180, 130), Enum.Material.SmoothPlastic)
				end
			end
		end
		Kit.crate(m * CFrame.new(-38, 0, -30), 4)
		Kit.crate(m * CFrame.new(-34, 0, -30), 3)
		Kit.barrel(m * CFrame.new(-82, 0, 44), teamColor)

		-- Playa: palmeras, sombrillas, tablas de surf, pelotas y antorchas
		for i, p in { V(-100, 0, 58), V(-70, 0, 64), V(-20, 0, 62), V(-100, 0, -58), V(-25, 0, -64), V(-62, 0, 20) } do
			Kit.palm(m * CFrame.new(p) * CFrame.Angles(0, i * 1.3, 0), 13 + (i % 3) * 2)
		end
		umbrella(m * CFrame.new(-34, 0, 52), STRIPES[1], STRIPES[3])
		umbrella(m * CFrame.new(-82, 0, -64), STRIPES[2], STRIPES[4])
		surfboard(m * CFrame.new(-44, 0, 60) * CFrame.Angles(0, rad(10), 0), STRIPES[2])
		surfboard(m * CFrame.new(-47, 0, 60) * CFrame.Angles(0, rad(-12), 0), STRIPES[1])
		Kit.ball("BeachBall", 2, m * CFrame.new(-30, 1, 44), STRIPES[(side == "A" and 3 or 4)], Enum.Material.SmoothPlastic, true)
		for _, p in { V(-74, 0, 7), V(-74, 0, -7), V(-14, 0, 22), V(-40, 0, 26) } do
			tikiTorch(m * CFrame.new(p))
		end
		Kit.rockCluster(m * V(-112, 0, -30), 4, Enum.Material.Rock)
		Kit.rockCluster(m * V(-10, 0, 70), 4, Enum.Material.Rock)

		-- Muelle con barca en el mar
		block("Pier", V(8, 0.6, 26), m * CFrame.new(-60, 0.3, -WIDTH / 2 - 14), WOOD, Enum.Material.WoodPlanks)
		for _, z in { -24, -16, -8 } do
			for _, x in { -3.5, 3.5 } do
				Kit.cylinder("PierPost", 6, 0.7, m * CFrame.new(-60 + x, -2.5, -WIDTH / 2 + z), WOOD_DARK, Enum.Material.Wood, nil, true)
			end
		end
		Kit.boat(m * CFrame.new(-48, -1.2, -WIDTH / 2 - 22) * CFrame.Angles(0, rad(15), 0))
	end)

	-- Bases y banderas
	local spawnStyle = { Floor = RGB(250, 230, 175), Roof = THATCH }
	Kit.spawnArea(teams[1], CFrame.new(-100, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-100, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-72, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-72, 0, 0))

	-- Límites invisibles (la isla acaba en el agua) e islas lejanas
	Kit.bounds(LENGTH, WIDTH, 50)
	for i, spec in { { V(-260, 0, -220), 40 }, { V(240, 0, 240), 55 }, { V(330, 0, -60), 35 }, { V(-320, 0, 160), 45 } } do
		Kit.naturalHill(spec[1] + V(0, -spec[2] * 0.55, 0), spec[2], Enum.Material.Sand, { Top = Enum.Material.LeafyGrass, TopCount = 5, RockCount = 2, Seed = i * 7 })
	end

	-- Modos
	for _, p in {
		V(-98, 0.5, 50), V(-80, 0.5, -20), V(-58, 0.5, 6), V(-38, 0.5, 18), V(-26, 0.5, -24),
		V(-55, 1.5, 42), V(-55, 1.5, -42), V(-12, 0.5, 50), V(-94, 0.5, -64), V(-3, deckY + 1.5, -5),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, deckY + 1, 0), 7, 1)
	Kit.zone(V(-55, 1, 42), 6, 2)
	Kit.zone(V(55, 1, -42), 6, 3)
	Kit.zone(V(-30, 0, 0), 8, 4)
	Kit.zone(V(30, 0, 0), 8, 5)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">ToyBox</string>
              <string name="Source"><![CDATA[-- CAJA DE JUGUETES: eres del tamaño de un juguete dentro del cuarto de un niño. Castillo de bloques
-- en el centro con pasarela elevada, ladrillos de construcción gigantes y cubos con letras como
-- cobertura, tren de juguete, plataformas de ladrillos en los laterales, ceras de colores como
-- pilares y un osito de peluche gigante. Simétrico (rojo contra azul).
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)

local Map = {
	Id = "ToyBox",
	Name = "Caja de Juguetes",
	Icon = "🧸",
	Description = "Cuarto de juegos · castillo de bloques · ladrillos gigantes",
}

Map.Lighting = {
	ClockTime = 15.2,
	Brightness = 3,
	Exposure = 0.06,
	Ambient = Color3.fromRGB(130, 122, 140),
	OutdoorAmbient = Color3.fromRGB(170, 165, 185),
	Atmosphere = { Density = 0.24, Offset = 0.2, Color = Color3.fromRGB(235, 225, 255), Decay = Color3.fromRGB(150, 140, 210), Glare = 0, Haze = 0.5 },
	Color = { Saturation = 0.22, Contrast = 0.06, Brightness = 0.03, Tint = Color3.fromRGB(255, 250, 245) },
	Bloom = { Intensity = 0.35, Size = 22, Threshold = 2 },
	Clouds = 0.45,
	SunRays = 0.04,
	ShadowSoftness = 0.3,
	Wind = Vector3.new(2, 0, 1),
}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad

local WOOD = RGB(222, 168, 110) -- suelo de madera
local WALL = RGB(150, 200, 255) -- paredes azul cielo
local TRIM = RGB(255, 200, 60)
local BRICKS = { RGB(235, 60, 60), RGB(50, 130, 240), RGB(255, 205, 40), RGB(60, 200, 90), RGB(255, 140, 40), RGB(170, 90, 230) }

local LENGTH, WIDTH = 200, 130

local function wall(name, cf, size, color)
	local part = Kit.block(name, size, cf * CFrame.new(0, size.Y / 2, 0), color or WALL, Enum.Material.SmoothPlastic)
	Kit.deco(name .. "Cap", V(size.X + 0.4, 0.7, size.Z + 0.4), cf * CFrame.new(0, size.Y + 0.35, 0), TRIM, Enum.Material.SmoothPlastic)
	return part
end

-- Ladrillo de construcción con tetones (de pie sobre cf). size = ancho x alto x fondo
local function brick(cf, size, color, studs)
	Kit.block("ToyBrick", size, cf * CFrame.new(0, size.Y / 2, 0), color, Enum.Material.SmoothPlastic)
	local nx, nz = studs and studs.X or math.max(1, math.floor(size.X / 3)), studs and studs.Y or math.max(1, math.floor(size.Z / 3))
	for i = 1, nx do
		for j = 1, nz do
			local x = -size.X / 2 + (i - 0.5) * size.X / nx
			local z = -size.Z / 2 + (j - 0.5) * size.Z / nz
			Kit.cylinder("BrickStud", 0.6, math.min(size.X / nx, size.Z / nz) * 0.62, cf * CFrame.new(x, size.Y + 0.3, z), color, Enum.Material.SmoothPlastic, nil, true)
		end
	end
end

-- Cubo de madera con letras de colores en dos caras
local function letterBlock(cf, size, color, letterA, letterB)
	local block = Kit.block("LetterBlock", V(size, size, size), cf * CFrame.new(0, size / 2, 0), color, Enum.Material.SmoothPlastic)
	Kit.sign(block, Enum.NormalId.Front, letterA, Color3.new(1, 1, 1))
	Kit.sign(block, Enum.NormalId.Back, letterB, Color3.new(1, 1, 1))
	Kit.sign(block, Enum.NormalId.Left, letterB, Color3.new(1, 1, 1))
	Kit.sign(block, Enum.NormalId.Right, letterA, Color3.new(1, 1, 1))
	return block
end

-- Cera de colores gigante de pie (pilar): cuerpo, envoltorio de papel y punta
local function crayon(cf, height, color)
	Kit.cylinder("Crayon", height, 3.2, cf * CFrame.new(0, height / 2, 0), color, Enum.Material.SmoothPlastic)
	Kit.cylinder("CrayonWrap", height * 0.55, 3.3, cf * CFrame.new(0, height * 0.42, 0), color:Lerp(Color3.new(1, 1, 1), 0.55), Enum.Material.SmoothPlastic, nil, true)
	Kit.cylinder("CrayonBand", 0.4, 3.35, cf * CFrame.new(0, height * 0.7, 0), color:Lerp(Color3.new(0, 0, 0), 0.3), Enum.Material.SmoothPlastic, nil, true)
	Kit.cylinder("CrayonTipBase", 1.2, 2.4, cf * CFrame.new(0, height + 0.6, 0), color, Enum.Material.SmoothPlastic, nil, true)
	Kit.ball("CrayonTip", 1.6, cf * CFrame.new(0, height + 1.3, 0), color, Enum.Material.SmoothPlastic, true)
end

-- Tren de juguete (cobertura larga): locomotora y dos vagones con ruedas
local function train(cf, colors)
	local function wheels(at, length)
		for _, x in { -length / 2 + 1, length / 2 - 1 } do
			for _, z in { -1.7, 1.7 } do
				Kit.cylinder("TrainWheel", 0.5, 1.8, at * CFrame.new(x, 0.9, z) * CFrame.Angles(rad(90), 0, 0), RGB(40, 40, 46), Enum.Material.SmoothPlastic, nil, true)
			end
		end
	end
	-- Locomotora
	Kit.block("TrainCab", V(5, 5, 3.4), cf * CFrame.new(-6, 3.3, 0), colors[1], Enum.Material.SmoothPlastic)
	Kit.block("TrainRoof", V(5.6, 0.6, 4), cf * CFrame.new(-6, 6.1, 0), colors[2], Enum.Material.SmoothPlastic)
	Kit.cylinder("TrainBoiler", 5, 3, cf * CFrame.new(-1.5, 2.7, 0) * CFrame.Angles(0, 0, rad(90)), colors[2], Enum.Material.SmoothPlastic)
	Kit.cylinder("TrainChimney", 2, 1.2, cf * CFrame.new(0, 5, 0), RGB(40, 40, 46), Enum.Material.SmoothPlastic, nil, true)
	wheels(cf * CFrame.new(-3.5, 0, 0), 9)
	-- Vagones
	for i, color in { colors[3], colors[4] } do
		local at = cf * CFrame.new(3.5 + i * 7, 0, 0)
		Kit.block("TrainCar", V(6, 2.6, 3.4), at * CFrame.new(0, 2.1, 0), color, Enum.Material.SmoothPlastic)
		Kit.block("TrainCargo", V(2.4, 2.4, 2.4), at * CFrame.new(-1.3, 4.6, 0) * CFrame.Angles(0, rad(12), 0), BRICKS[(i + 2) % #BRICKS + 1], Enum.Material.SmoothPlastic)
		wheels(at, 6)
	end
end

-- Osito de peluche gigante sentado (decoración de fondo)
local function teddy(position, scale, facing)
	local cf = CFrame.new(position) * CFrame.Angles(0, facing, 0)
	local fur, light = RGB(176, 118, 70), RGB(230, 190, 140)
	Kit.ball("TeddyBody", 14 * scale, cf * CFrame.new(0, 7 * scale, 0), fur, Enum.Material.SmoothPlastic, true)
	Kit.ball("TeddyBelly", 9 * scale, cf * CFrame.new(0, 6.5 * scale, -3.4 * scale), light, Enum.Material.SmoothPlastic, true)
	Kit.ball("TeddyHead", 10 * scale, cf * CFrame.new(0, 17 * scale, 0), fur, Enum.Material.SmoothPlastic, true)
	Kit.ball("TeddySnout", 4 * scale, cf * CFrame.new(0, 16 * scale, -4.4 * scale), light, Enum.Material.SmoothPlastic, true)
	Kit.ball("TeddyNose", 1.4 * scale, cf * CFrame.new(0, 16.8 * scale, -6.2 * scale), RGB(40, 30, 30), Enum.Material.SmoothPlastic, true)
	for _, s in { -1, 1 } do
		Kit.ball("TeddyEar", 4 * scale, cf * CFrame.new(s * 4 * scale, 21.5 * scale, 0), fur, Enum.Material.SmoothPlastic, true)
		Kit.ball("TeddyEye", 1.2 * scale, cf * CFrame.new(s * 1.8 * scale, 18.6 * scale, -4.4 * scale), RGB(30, 25, 25), Enum.Material.SmoothPlastic, true)
		Kit.ball("TeddyArm", 5 * scale, cf * CFrame.new(s * 7.5 * scale, 9 * scale, -2 * scale), fur, Enum.Material.SmoothPlastic, true)
		Kit.ball("TeddyFoot", 6 * scale, cf * CFrame.new(s * 4.5 * scale, 2.4 * scale, -6 * scale), fur, Enum.Material.SmoothPlastic, true)
	end
	Kit.block("TeddyBow", V(6 * scale, 2 * scale, 1.4 * scale), cf * CFrame.new(0, 12.5 * scale, -4.5 * scale), RGB(235, 60, 90), Enum.Material.SmoothPlastic)
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	Kit.applyLighting(Map.Lighting)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Suelo de madera con tablas, alfombra redonda en el centro
	block("Floor", V(LENGTH + 40, 2, WIDTH + 40), CFrame.new(0, -1, 0), WOOD, Enum.Material.SmoothPlastic)
	for z = -WIDTH / 2, WIDTH / 2, 10 do
		deco("FloorBoardLine", V(LENGTH, 0.05, 0.3), CFrame.new(0, 0.02, z), WOOD:Lerp(Color3.new(0, 0, 0), 0.15), Enum.Material.SmoothPlastic)
	end
	Kit.cylinder("Rug", 0.2, 64, CFrame.new(0, 0.1, 0), RGB(120, 200, 255), Enum.Material.SmoothPlastic)
	Kit.cylinder("RugRing", 0.22, 52, CFrame.new(0, 0.11, 0), RGB(255, 230, 120), Enum.Material.SmoothPlastic, nil, true)
	Kit.cylinder("RugCenter", 0.24, 38, CFrame.new(0, 0.12, 0), RGB(255, 150, 190), Enum.Material.SmoothPlastic, nil, true)

	-- Paredes con ceras de colores
	for _, z in { -1, 1 } do
		wall("OuterWall", CFrame.new(0, 0, z * (WIDTH / 2 + 1.5)), V(LENGTH + 6, 20, 3))
		for i, x in { -84, -56, -28, 0, 28, 56, 84 } do
			crayon(CFrame.new(x, 0, z * (WIDTH / 2 - 1)), 18, BRICKS[(i + (z > 0 and 3 or 0)) % #BRICKS + 1])
		end
	end
	for _, x in { -1, 1 } do
		wall("OuterWall", CFrame.new(x * (LENGTH / 2 + 1.5), 0, 0), V(3, 20, WIDTH + 6))
	end

	-- Castillo central de bloques: cuatro torres de cubos y una pasarela en cruz a 8 de altura
	local deckY = 8
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			local base = CFrame.new(x * 11, 0, z * 11)
			for level = 0, 2 do
				local color = BRICKS[(level + (x + z) / 2 + 2) % #BRICKS + 1]
				block("CastleBlock", V(6, 4, 6), base * CFrame.new(0, level * 4 + 2, 0) * CFrame.Angles(0, rad(level * 8 * x), 0), color, Enum.Material.SmoothPlastic)
			end
			Kit.cylinder("CastleTop", 2, 4.4, base * CFrame.new(0, 13, 0), RGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, true)
			Kit.ball("CastleTopBall", 2.2, base * CFrame.new(0, 14.4, 0), BRICKS[1], Enum.Material.SmoothPlastic, true)
		end
	end
	block("CastleDeck", V(16, 1, 6), CFrame.new(0, deckY - 0.5, 0), BRICKS[3], Enum.Material.SmoothPlastic)
	block("CastleDeck", V(6, 1, 16), CFrame.new(0, deckY - 0.5, 0), BRICKS[3], Enum.Material.SmoothPlastic)
	for _, s in { -1, 1 } do
		for _, x in { -1, 1 } do
			-- Almenas bajas a los lados del brazo largo (sin cortar el cruce)
			block("Battlement", V(5, 1.6, 0.8), CFrame.new(x * 5.5, deckY + 0.8, s * 2.6), BRICKS[2], Enum.Material.SmoothPlastic)
		end
	end

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and BRICKS[1] or BRICKS[2]
		-- Escalera del castillo (sube por el lado de cada equipo)
		Kit.stairs((m * CFrame.new(-26, 0, 0)).Position, (m * CFrame.new(-8, deckY, 0)).Position, 5, BRICKS[4], Enum.Material.SmoothPlastic)

		-- Plataforma lateral de ladrillos (a 6 de altura) con escalera
		local platY = 6
		brick(m * CFrame.new(-41, 0, -(WIDTH / 2 - 8)), V(22, platY, 12), teamColor, Vector2.new(4, 2))
		Kit.stairs((m * CFrame.new(-62, 0, -(WIDTH / 2 - 8))).Position, (m * CFrame.new(-52, platY, -(WIDTH / 2 - 8))).Position, 5, BRICKS[5], Enum.Material.SmoothPlastic)

		-- Ladrillos gigantes como cobertura
		brick(m * CFrame.new(-36, 0, 18), V(9, 4, 4.5), BRICKS[3])
		brick(m * CFrame.new(-54, 0, -14) * CFrame.Angles(0, rad(90), 0), V(9, 4, 4.5), BRICKS[4])
		brick(m * CFrame.new(-22, 0, -30), V(6, 5, 6), BRICKS[6])
		brick(m * CFrame.new(-70, 0, 40), V(9, 4, 4.5), BRICKS[5])
		brick(m * CFrame.new(-46, 0, 46) * CFrame.Angles(0, rad(25), 0), V(6, 7, 3), BRICKS[1])

		-- Cubos con letras
		letterBlock(m * CFrame.new(-30, 0, -10) * CFrame.Angles(0, rad(15), 0), 5, BRICKS[2], "A", "B")
		letterBlock(m * CFrame.new(-62, 0, 20), 5, BRICKS[4], "C", "D")
		letterBlock(m * CFrame.new(-14, 0, 40), 4.5, BRICKS[5], "E", "F")
		letterBlock(m * CFrame.new(-14, 4.5, 40) * CFrame.Angles(0, rad(30), 0), 3.5, BRICKS[6], "G", "H")

		-- Tren de juguete en la banda lateral (cobertura larga)
		train(m * CFrame.new(-28, 0, 52), { RGB(235, 60, 60), RGB(40, 120, 230), RGB(255, 200, 40), RGB(60, 200, 90) })

		-- Pelota de goma (decoración, se atraviesa)
		local ball = Kit.ball("ToyBall", 5, m * CFrame.new(-80, 2.5, -48), RGB(255, 90, 90), Enum.Material.SmoothPlastic, true)
		ball.CastShadow = true
		Kit.cylinder("ToyBallStripe", 5.1, 1.2, m * CFrame.new(-80, 2.5, -48) * CFrame.Angles(0, 0, rad(90)), RGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, true)
	end)

	-- Bases y banderas
	local spawnStyle = { Floor = RGB(255, 240, 210), Roof = WALL }
	Kit.spawnArea(teams[1], CFrame.new(-85, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-85, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-62, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-62, 0, 0))

	-- Fondo: pilas de bloques gigantes, ositos y colinas
	Kit.bounds(LENGTH, WIDTH, 50)
	teddy(V(-40, 0, WIDTH / 2 + 30), 1.6, math.pi)
	teddy(V(40, 0, -(WIDTH / 2 + 30)), 1.6, 0)
	local n = 0
	for x = -140, 140, 35 do
		for _, z in { -1, 1 } do
			n += 1
			if math.abs(x - z * -40) > 25 then
				local base = V(x, 0, z * (WIDTH / 2 + 20 + (n % 3) * 8))
				local size = 12 + (n % 3) * 3
				for level = 0, n % 3 do
					deco("BigBlock", V(size, size, size), CFrame.new(base + V((level % 2) * 3, size / 2 + level * size, 0)) * CFrame.Angles(0, rad(level * 17 + n * 9), 0), BRICKS[(n + level) % #BRICKS + 1], Enum.Material.SmoothPlastic)
				end
			end
		end
	end
	for x = -200, 200, 70 do
		for _, z in { -1, 1 } do
			Kit.naturalHill(V(x, -18, z * 150), 50, Enum.Material.Grass, { Inward = V(0, 0, -z), Top = Enum.Material.LeafyGrass, RockCount = 0 })
		end
	end
	for _, sx in { -1, 1 } do
		for z = -90, 90, 60 do
			Kit.naturalHill(V(sx * 165, -18, z), 50, Enum.Material.Grass, { Inward = V(-sx, 0, 0), Top = Enum.Material.LeafyGrass, RockCount = 0 })
		end
	end

	-- Modos
	for _, p in {
		V(-74, 0.5, 16), V(-74, 0.5, -16), V(-48, 0.5, 2), V(-40, 0.5, 30), V(-44, 0.5, -34),
		V(-22, 0.5, 16), V(-12, 0.5, -20), V(-40, 6.5, -57), V(-1.5, deckY + 0.5, -5), V(-78, 0.5, -36),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, deckY, 0), 5, 1)
	Kit.zone(V(-40, 0, 30), 6, 2)
	Kit.zone(V(40, 0, -30), 6, 3)
	Kit.zone(V(-40, 6, -57), 5, 4)
	Kit.zone(V(40, 6, 57), 5, 5)
	Kit.dustMotes(CFrame.new(0, 8, 0), V(120, 14, 80), Color3.fromRGB(255, 240, 200), 14)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">WildWest</string>
              <string name="Source"><![CDATA[-- PUEBLO VAQUERO: calle mayor del Oeste a pleno sol. En el centro, el depósito de agua sobre patas
-- (cobertura entre las patas) con el abrevadero; a cada lado de la calle, edificios de madera con
-- fachada falsa: el saloon y el banco tienen escalera por detrás para subir a la azotea (la fachada
-- hace de parapeto hacia la calle). Por detrás, callejones de flanqueo con vallas, carros, balas de
-- heno y cactus. De fondo, mesetas rojas y un tren de vapor. Simétrico.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)
local Variants = require(script.Parent.Parent.LightingVariants)

local Map = {
	Id = "WildWest",
	Name = "Pueblo Vaquero",
	Icon = "🤠",
	Description = "Oeste · calle mayor · saloon, banco y depósito de agua",
}

Map.Lighting = {
	CartoonNeutral = { Hue = 0.08, Sat = 0.14 }, -- grises cálidos de desierto
	ClockTime = 15.2,
	Latitude = 25,
	Brightness = 3.2,
	Exposure = 0.05,
	Ambient = Color3.fromRGB(135, 120, 110),
	OutdoorAmbient = Color3.fromRGB(190, 170, 150),
	Atmosphere = { Density = 0.25, Offset = 0.15, Color = Color3.fromRGB(255, 220, 180), Decay = Color3.fromRGB(220, 150, 100), Glare = 0.1, Haze = 1 },
	Color = { Saturation = 0.22, Contrast = 0.07, Brightness = 0.03, Tint = Color3.fromRGB(255, 245, 230) },
	Bloom = { Intensity = 0.3, Size = 22, Threshold = 2 },
	Clouds = 0.2,
	SunRays = 0.06,
	ShadowSoftness = 0.25,
	Wind = Vector3.new(6, 0, 2),
	TerrainColors = {
		Sand = Color3.fromRGB(230, 190, 130),
		Sandstone = Color3.fromRGB(200, 110, 70),
		Rock = Color3.fromRGB(170, 100, 70),
		Ground = Color3.fromRGB(200, 150, 100),
	},
}
-- A veces sale con otra luz o con mal tiempo (ver LightingVariants)
Map.LightingVariants = { Variants.Sunset(0.35) }

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad

local DIRT = RGB(222, 180, 125) -- tierra de la calle
local DIRT_DARK = RGB(200, 155, 105)
local WOOD = RGB(176, 120, 70)
local WOOD_DARK = RGB(120, 78, 45)
local WOOD_RED = RGB(190, 75, 55)
local WOOD_TEAL = RGB(80, 160, 165)
local WOOD_CREAM = RGB(240, 220, 175)
local WOOD_MUSTARD = RGB(225, 175, 70)
local CACTUS = RGB(90, 170, 80)
local HAY = RGB(240, 200, 90)
local SMOOTH = Enum.Material.SmoothPlastic
local PLANKS = Enum.Material.WoodPlanks

local LENGTH, WIDTH = 200, 130

-- Edificio de madera con fachada falsa (la fachada sobresale por encima del tejado: parapeto hacia la
-- calle), porche con tejadillo y postes, ventanas y letrero. La puerta mira hacia -Z del cf.
local function westernBuilding(cf, size, color, signText, options)
	options = options or {}
	local trim = color:Lerp(Color3.new(1, 1, 1), 0.45)
	Kit.block("Walls", size, cf * CFrame.new(0, size.Y / 2, 0), color, PLANKS)
	Kit.contactShadow(cf, size.X + 0.4, size.Z + 0.4, false)
	-- Fachada falsa (parapeto de la azotea hacia la calle)
	local frontH = 3 -- (a la altura del pecho: se dispara por encima agachándose detrás)
	local front = Kit.block("FalseFront", V(size.X + 0.6, frontH, 1), cf * CFrame.new(0, size.Y + frontH / 2, -(size.Z / 2 - 0.5)), color, PLANKS)
	Kit.deco("FrontCap", V(size.X + 1.2, 0.6, 1.4), cf * CFrame.new(0, size.Y + frontH + 0.3, -(size.Z / 2 - 0.5)), trim, SMOOTH)
	-- Letrero grande en la fachada
	local board = Kit.deco("SignBoard", V(size.X * 0.7, 2.6, 0.3), cf * CFrame.new(0, size.Y + 1.6, -(size.Z / 2 + 0.1)), WOOD_CREAM, SMOOTH)
	Kit.sign(board, Enum.NormalId.Front, signText, RGB(120, 50, 30), RGB(255, 240, 210))
	Kit.sign(board, Enum.NormalId.Back, signText, RGB(120, 50, 30), RGB(255, 240, 210))
	-- Porche: tablado, tejadillo y postes
	local porchDepth = 4
	Kit.deco("Porch", V(size.X, 0.6, porchDepth), cf * CFrame.new(0, 0.3, -(size.Z / 2 + porchDepth / 2)), WOOD_DARK, PLANKS)
	Kit.deco("PorchRoof", V(size.X + 0.4, 0.4, porchDepth + 0.6), cf * CFrame.new(0, 7.2, -(size.Z / 2 + porchDepth / 2)) * CFrame.Angles(rad(-8), 0, 0), trim, PLANKS)
	for i = 0, 3 do
		local x = -size.X / 2 + 0.6 + i * (size.X - 1.2) / 3
		Kit.block("PorchPost", V(0.6, 7, 0.6), cf * CFrame.new(x, 3.5, -(size.Z / 2 + porchDepth - 0.4)), WOOD_DARK, Enum.Material.Wood)
	end
	-- Puerta batiente y ventanas
	local doorCf = cf * CFrame.new(options.DoorX or 0, 3, -(size.Z / 2 + 0.12))
	for _, s in { -1, 1 } do
		Kit.deco("SwingDoor", V(1.6, 3, 0.2), doorCf * CFrame.new(s * 0.85, 0.2, 0), WOOD_DARK, Enum.Material.Wood)
	end
	Kit.deco("DoorDark", V(3.6, 6, 0.1), doorCf * CFrame.new(0, 0, 0.05), RGB(40, 28, 20), SMOOTH)
	local windows = math.max(1, math.floor(size.X / 7))
	for i = 1, windows do
		local x = -size.X / 2 + (i - 0.5) * size.X / windows
		if math.abs(x - (options.DoorX or 0)) > 3 then
			Kit.deco("Window", V(2.4, 2.8, 0.2), cf * CFrame.new(x, 3.6, -(size.Z / 2 + 0.1)), RGB(60, 70, 90), Enum.Material.Glass)
			Kit.deco("WindowFrame", V(2.9, 0.35, 0.3), cf * CFrame.new(x, 2.1, -(size.Z / 2 + 0.15)), trim, SMOOTH)
		end
		if size.Y > 9 then
			-- Ventanas del piso de arriba
			Kit.deco("Window", V(2.2, 2.6, 0.2), cf * CFrame.new(x, size.Y - 3, -(size.Z / 2 + 0.1)), RGB(60, 70, 90), Enum.Material.Glass)
		end
	end
	-- Rayas de las tablas (más relieve)
	for y = 1.5, size.Y - 1, 2.5 do
		Kit.deco("PlankLine", V(size.X + 0.05, 0.12, size.Z + 0.05), cf * CFrame.new(0, y, 0), color:Lerp(Color3.new(0, 0, 0), 0.2), SMOOTH)
	end
	-- Escalera por detrás hasta la azotea
	if options.RoofStairs then
		local x = options.StairsX or 0
		Kit.stairs(cf * V(x, 0, size.Z / 2 + 17), cf * V(x, size.Y, size.Z / 2 + 0.2), 4, WOOD, PLANKS)
	end
	return front
end

-- Depósito de agua sobre cuatro patas (las patas son cobertura; el tanque, decorado)
local function waterTower(cf)
	local legH = 14
	for _, x in { -4, 4 } do
		for _, z in { -4, 4 } do
			Kit.block("TowerLeg", V(1.2, legH, 1.2), cf * CFrame.new(x, legH / 2, z), WOOD_DARK, Enum.Material.Wood)
		end
	end
	for _, z in { -4, 4 } do
		Kit.deco("TowerBrace", V(11.5, 0.5, 0.4), cf * CFrame.new(0, legH * 0.55, z) * CFrame.Angles(0, 0, rad(40)), WOOD_DARK, Enum.Material.Wood)
	end
	Kit.deco("TowerDeck", V(11, 0.6, 11), cf * CFrame.new(0, legH + 0.3, 0), WOOD, PLANKS)
	Kit.cylinder("Tank", 8, 10, cf * CFrame.new(0, legH + 4.6, 0), RGB(150, 100, 60), Enum.Material.WoodPlanks, nil, true)
	for _, y in { 2, 5, 8 } do
		Kit.cylinder("TankBand", 0.3, 10.15, cf * CFrame.new(0, legH + 0.6 + y, 0), RGB(70, 70, 75), Enum.Material.Metal, nil, true)
	end
	for i = 0, 5 do
		Kit.deco("TankRoof", V(6.5, 0.4, 3.2), cf * CFrame.new(0, legH + 9.4, 0) * CFrame.Angles(0, rad(i * 60), 0) * CFrame.new(0, 0, -1.4) * CFrame.Angles(rad(28), 0, 0), WOOD_RED, SMOOTH)
	end
	-- Abrevadero debajo (cobertura baja)
	Kit.block("Trough", V(7, 1.8, 2.2), cf * CFrame.new(0, 0.9, 0), WOOD, Enum.Material.Wood)
	Kit.deco("TroughWater", V(6.4, 0.1, 1.6), cf * CFrame.new(0, 1.75, 0), RGB(90, 170, 210), SMOOTH)
end

-- Carro cubierto (cobertura grande)
local function wagon(cf, canvasColor)
	Kit.block("WagonBed", V(5, 2.2, 10), cf * CFrame.new(0, 2.4, 0), WOOD, PLANKS)
	for _, z in { -3.4, 3.4 } do
		for _, x in { -2.9, 2.9 } do
			local wheel = cf * CFrame.new(x, 1.7, z) * CFrame.Angles(0, 0, rad(90))
			Kit.cylinder("WagonWheel", 0.4, 3.4, wheel, WOOD_DARK, Enum.Material.Wood, nil, true)
			Kit.cylinder("WagonHub", 0.6, 0.8, wheel, RGB(60, 60, 65), Enum.Material.Metal, nil, true)
		end
	end
	-- Lona en arcos
	for i = -2, 2 do
		local a = rad(i * 30)
		Kit.deco("WagonCanvas", V(2.2, 0.3, 9), cf * CFrame.new(0, 3.5, 0) * CFrame.new(math.sin(a) * 2.9, math.cos(a) * 2.9, 0) * CFrame.Angles(0, 0, -a), canvasColor, Enum.Material.Fabric)
	end
	Kit.block("WagonCanvasBlock", V(4.6, 2.6, 8.6), cf * CFrame.new(0, 4.8, 0), canvasColor, Enum.Material.Fabric)
	Kit.deco("WagonTongue", V(0.4, 0.4, 5), cf * CFrame.new(0, 1.6, -7.2), WOOD_DARK, Enum.Material.Wood)
	Kit.contactShadow(cf, 6, 10.5)
end

local function hayBale(cf)
	Kit.block("HayBale", V(4, 2.4, 2.6), cf * CFrame.new(0, 1.2, 0), HAY, Enum.Material.Grass)
	for _, x in { -1, 1 } do
		Kit.deco("HayBand", V(0.15, 2.45, 2.65), cf * CFrame.new(x, 1.2, 0), RGB(150, 110, 60), SMOOTH)
	end
end

-- Cactus saguaro de dibujo: tronco y dos brazos
local function cactus(position, scale)
	scale = scale or 1
	local base = CFrame.new(position)
	Kit.cylinder("Cactus", 8 * scale, 1.8 * scale, base * CFrame.new(0, 4 * scale, 0), CACTUS, SMOOTH)
	Kit.ball("CactusTop", 1.8 * scale, base * CFrame.new(0, 8 * scale, 0), CACTUS, SMOOTH, true)
	for _, s in { -1, 1 } do
		local h = (s > 0 and 3.5 or 4.6) * scale
		Kit.cylinder("CactusArm", 1.6 * scale, 1.2 * scale, base * CFrame.new(s * 1.4 * scale, h, 0) * CFrame.Angles(0, 0, rad(90)), CACTUS, SMOOTH, nil, true)
		Kit.cylinder("CactusArm", 2.6 * scale, 1.2 * scale, base * CFrame.new(s * 2.1 * scale, h + 1.3 * scale, 0), CACTUS, SMOOTH, nil, true)
		Kit.ball("CactusArmTop", 1.2 * scale, base * CFrame.new(s * 2.1 * scale, h + 2.6 * scale, 0), CACTUS, SMOOTH, true)
	end
end

-- Valla de madera entre dos puntos (cobertura baja)
local function fence(a, b)
	local length = (b - a).Magnitude
	local cf = CFrame.lookAt((a + b) / 2, b)
	for _, y in { 1.1, 2.2 } do
		Kit.deco("FenceRail", V(0.3, 0.4, length), cf * CFrame.new(0, y, 0), WOOD, Enum.Material.Wood)
	end
	Kit.block("FenceBlock", V(0.4, 2.6, length), cf * CFrame.new(0, 1.3, 0), WOOD, Enum.Material.Wood).Transparency = 1
	for i = 0, math.floor(length / 4) do
		Kit.deco("FencePost", V(0.5, 2.8, 0.5), cf * CFrame.new(0, 1.4, -length / 2 + i * length / math.floor(length / 4)), WOOD_DARK, Enum.Material.Wood)
	end
end

-- Tren de vapor de fondo sobre sus vías
local function train(cf)
	for x = -120, 120, 4 do
		Kit.deco("Sleeper", V(1, 0.3, 6), cf * CFrame.new(x, 0.15, 0), WOOD_DARK, Enum.Material.Wood)
	end
	for _, z in { -2, 2 } do
		Kit.deco("Rail", V(244, 0.3, 0.3), cf * CFrame.new(0, 0.45, z), RGB(90, 90, 95), Enum.Material.Metal)
	end
	local loco = cf * CFrame.new(-20, 0, 0)
	Kit.deco("LocoBody", V(14, 5, 5), loco * CFrame.new(0, 4, 0), RGB(40, 40, 48), SMOOTH)
	Kit.cylinder("LocoBoiler", 9, 4.6, loco * CFrame.new(-3, 4.6, 0) * CFrame.Angles(0, 0, rad(90)), RGB(30, 30, 36), SMOOTH, nil, true)
	Kit.deco("LocoCab", V(5, 5, 5.4), loco * CFrame.new(5, 7.5, 0), WOOD_RED, SMOOTH)
	Kit.deco("LocoCabRoof", V(6, 0.5, 6.2), loco * CFrame.new(5, 10.2, 0), RGB(30, 30, 36), SMOOTH)
	Kit.cylinder("Smokestack", 4, 1.6, loco * CFrame.new(-6, 9, 0), RGB(30, 30, 36), SMOOTH, nil, true)
	Kit.cylinder("SmokestackTop", 1, 2.6, loco * CFrame.new(-6, 11.2, 0), RGB(30, 30, 36), SMOOTH, nil, true)
	Kit.deco("Cowcatcher", V(2, 2, 5), loco * CFrame.new(-8, 1.6, 0) * CFrame.Angles(0, 0, rad(30)), WOOD_RED, SMOOTH)
	for _, x in { -5, -1, 3 } do
		for _, z in { -2.6, 2.6 } do
			Kit.cylinder("LocoWheel", 0.4, 2.6, loco * CFrame.new(x, 1.4, z) * CFrame.Angles(rad(90), 0, 0), WOOD_RED, SMOOTH, nil, true)
		end
	end
	local smoke = Kit.deco("SmokePuff", V(1, 1, 1), loco * CFrame.new(-6, 12, 0), RGB(255, 255, 255), SMOOTH)
	smoke.Transparency = 1
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	emitter.Color = ColorSequence.new(RGB(240, 240, 240))
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 7) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(3, 5)
	emitter.Rate = 3
	emitter.Speed = NumberRange.new(4, 6)
	emitter.SpreadAngle = Vector2.new(15, 15)
	emitter.Parent = smoke
	-- Vagones
	local wagonColors = { WOOD_RED, WOOD_TEAL, WOOD_MUSTARD }
	for i, color in wagonColors do
		local car = cf * CFrame.new(-20 + i * 13, 0, 0)
		Kit.deco("TrainCar", V(11, 5, 5), car * CFrame.new(0, 4.5, 0), color, PLANKS)
		Kit.deco("TrainCarRoof", V(11.6, 0.5, 5.6), car * CFrame.new(0, 7.2, 0), WOOD_DARK, SMOOTH)
		for _, x in { -3.5, 3.5 } do
			for _, z in { -2.6, 2.6 } do
				Kit.cylinder("CarWheel", 0.4, 2, car * CFrame.new(x, 1.2, z) * CFrame.Angles(rad(90), 0, 0), RGB(40, 40, 45), SMOOTH, nil, true)
			end
		end
	end
end

-- Meseta roja de fondo (tierra)
local function mesa(position, radius, height)
	local terrain = workspace.Terrain
	terrain:FillCylinder(CFrame.new(position + V(0, height / 2, 0)), height, radius, Enum.Material.Sandstone)
	terrain:FillCylinder(CFrame.new(position + V(0, height + 1, 0)), 2, radius * 0.92, Enum.Material.Sandstone)
	terrain:FillCylinder(CFrame.new(position + V(0, 2, 0)), 4, radius * 1.25, Enum.Material.Sand)
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	folder:SetAttribute("Ambience", "Desert") -- (sonido ambiente: ver Ambience en el cliente)
	Kit.applyLighting(Kit.pickLighting(Map))
	folder:SetAttribute("Variant", Kit.Variant)
	folder:SetAttribute("Weather", Kit.Weather)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Suelo: tierra, calle mayor más clara y huellas de carro
	block("Floor", V(LENGTH + 40, 2, WIDTH + 40), CFrame.new(0, -1, 0), DIRT_DARK, SMOOTH)
	deco("MainStreet", V(LENGTH, 0.1, 30), CFrame.new(0, 0.05, 0), DIRT, SMOOTH)
	for _, z in { -5, 5 } do
		deco("WheelRut", V(LENGTH - 20, 0.06, 0.8), CFrame.new(0, 0.12, z), DIRT_DARK, SMOOTH)
	end

	waterTower(CFrame.new(0, 0, 0))

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(235, 70, 70) or RGB(60, 130, 240)
		-- Fila norte: almacén y saloon (escalera a la azotea)
		westernBuilding(m * CFrame.new(-61, 0, 33), V(12, 8, 12), WOOD_TEAL, "ALMACÉN")
		westernBuilding(m * CFrame.new(-36, 0, 33), V(20, 11, 14), WOOD_RED, "SALOON", { RoofStairs = true, StairsX = -5 })
		-- Fila sur: banco (escalera a la azotea) y oficina del sheriff, mirando a la calle
		westernBuilding(m * CFrame.new(-58, 0, -33) * CFrame.Angles(0, math.pi, 0), V(16, 12, 14), WOOD_CREAM, "BANCO", { RoofStairs = true, StairsX = 3 })
		westernBuilding(m * CFrame.new(-31, 0, -33) * CFrame.Angles(0, math.pi, 0), V(14, 8, 12), WOOD_MUSTARD, "SHERIFF")

		-- Cobertura en la calle
		wagon(m * CFrame.new(-16, 0, -9) * CFrame.Angles(0, rad(75), 0), RGB(245, 240, 225))
		hayBale(m * CFrame.new(-48, 0, 9))
		hayBale(m * CFrame.new(-50, 0, 11.5) * CFrame.Angles(0, rad(30), 0))
		hayBale(m * CFrame.new(-26, 0, 12) * CFrame.Angles(0, rad(-15), 0))
		Kit.barrel(m * CFrame.new(-28, 0, 22), WOOD)
		Kit.barrel(m * CFrame.new(-30.5, 0, 22.5), WOOD_DARK)
		block("Trough", V(6, 1.8, 2), m * CFrame.new(-44, 0.9, -19), WOOD, Enum.Material.Wood)
		Kit.crate(m * CFrame.new(-66, 0, -14), 4, WOOD)
		Kit.crate(m * CFrame.new(-63, 0, -17), 3, WOOD)
		Kit.crate(m * CFrame.new(-8, 0, 20), 3.5, WOOD)

		-- Callejones de atrás: vallas, carro de heno, cactus y barriles
		fence(m * V(-70, 0, 52), m * V(-48, 0, 52))
		fence(m * V(-22, 0, -52), m * V(-6, 0, -52))
		hayBale(m * CFrame.new(-14, 0, 48) * CFrame.Angles(0, rad(10), 0))
		Kit.barrel(m * CFrame.new(-50, 0, -50), WOOD_RED)
		Kit.crate(m * CFrame.new(-12, 0, -46), 4, WOOD)
		cactus(m * V(-76, 0, 58), 1)
		cactus(m * V(-20, 0, 60), 0.8)
		cactus(m * V(-74, 0, -56), 0.9)

		-- Farol y carteles de "SE BUSCA" en los postes
		local poster = deco("WantedPoster", V(1.6, 2.2, 0.1), m * CFrame.new(-39.1, 4, 22.05), RGB(240, 225, 180), SMOOTH)
		Kit.sign(poster, Enum.NormalId.Front, "SE BUSCA", RGB(110, 40, 30))
		Kit.banner(m * CFrame.new(-68, 12, 22) * CFrame.Angles(0, rad(90), 0), 4, 6, teamColor, RGB(255, 210, 80))
		Kit.banner(m * CFrame.new(-68, 12, -22) * CFrame.Angles(0, rad(90), 0), 4, 6, teamColor, RGB(255, 210, 80))
	end)

	-- Bases y banderas
	local spawnStyle = { Floor = RGB(240, 215, 170), Roof = WOOD_CREAM, RoofMaterial = PLANKS }
	Kit.spawnArea(teams[1], CFrame.new(-85, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-85, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-62, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-62, 0, 0))

	-- Fondo: tren de vapor, mesetas y cactus
	Kit.bounds(LENGTH, WIDTH, 60)
	block("TrackGround", V(LENGTH + 80, 2, 16), CFrame.new(0, -1, WIDTH / 2 + 24), DIRT_DARK, SMOOTH)
	block("BackGround", V(LENGTH + 80, 2, 20), CFrame.new(0, -1, -(WIDTH / 2 + 26)), DIRT_DARK, SMOOTH)
	train(CFrame.new(0, 0, WIDTH / 2 + 24))
	local rng = Random.new(41)
	for x = -120, 120, 26 do
		cactus(V(x + rng:NextNumber(-8, 8), 0, -(WIDTH / 2 + 18 + rng:NextNumber(0, 10))), rng:NextNumber(0.8, 1.3))
	end
	for _, sx in { -1, 1 } do
		for z = -60, 60, 40 do
			cactus(V(sx * (LENGTH / 2 + 16 + rng:NextNumber(0, 8)), 0, z + rng:NextNumber(-8, 8)), rng:NextNumber(0.9, 1.3))
		end
	end
	mesa(V(-60, 0, -(WIDTH / 2 + 70)), 34, 40)
	mesa(V(70, 0, -(WIDTH / 2 + 80)), 42, 52)
	mesa(V(-150, 0, 40), 30, 34)
	mesa(V(150, 0, -30), 34, 44)
	mesa(V(20, 0, WIDTH / 2 + 90), 40, 46)

	-- Modos
	for _, p in {
		V(-76, 0.5, 8), V(-76, 0.5, -16), V(-52, 0.5, 4), V(-40, 0.5, 18), V(-20, 0.5, 44),
		V(-60, 0.5, 46), V(-14, 0.5, -36), V(-36, 11.5, 34), V(-8, 0.5, 10), V(-44, 0.5, -48),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, 0, 0), 7, 1)
	Kit.zone(V(-44, 0, -12), 6, 2)
	Kit.zone(V(44, 0, 12), 6, 3)
	Kit.zone(V(-36, 11, 33), 5, 4)
	Kit.zone(V(36, 11, -33), 5, 5)
	Kit.dustMotes(CFrame.new(0, 5, 0), V(150, 8, 90), Color3.fromRGB(240, 200, 150), 10)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">MapKit</string>
            <string name="Source"><![CDATA[-- Kit de construcción de mapas: piezas reutilizables (contenedores, edificios, palmeras, grúas...),
-- iluminación por mapa y puntos especiales (spawns, bandera, zonas, spawns libres).
local Lighting = game:GetService("Lighting")

local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)

local Kit = {}

Kit.folder = nil -- carpeta del mapa actual (la crea Begin)

-- Rotación de 180° alrededor del centro: la mitad Azul es espejo de la Roja
Kit.MIRROR = CFrame.Angles(0, math.pi, 0)

function Kit.symmetric(fn)
	fn(CFrame.new(), "A")
	fn(Kit.MIRROR, "B")
end

local rad = math.rad
local V = Vector3.new
local RGB = Color3.fromRGB

Kit.C = {
	Metal = RGB(60, 62, 70),
	Yellow = RGB(255, 205, 50),
	White = RGB(245, 245, 250),
	Wood = RGB(176, 124, 70),
	WoodDark = RGB(120, 80, 45),
	Leaf = RGB(80, 180, 80),
	LeafDark = RGB(50, 140, 60),
	Pink = RGB(255, 80, 170),
	Cyan = RGB(0, 220, 255),
	Red = RGB(210, 50, 45),
	Blue = RGB(45, 110, 220),
}
local C = Kit.C

-- Realismo: el plástico liso parece de juguete. Las piezas grandes pasan a materiales PBR reales
-- (yeso pintado si tienen color, hormigón si son oscuras o son suelos); lo pequeño (conos, flores,
-- carteles) se queda como está. Lo usan Kit.block y los mapas con su propia función de piezas.
function Kit.realisticMaterial(size, color, material)
	material = material or Enum.Material.SmoothPlastic
	if material ~= Enum.Material.SmoothPlastic and material ~= Enum.Material.Plastic then
		return material
	end
	local volume = size.X * size.Y * size.Z
	local flatFloor = size.Y <= 0.6 and size.X * size.Z >= 60
	if volume < 30 and not flatFloor then
		return material
	end
	local luminance = color.R * 0.3 + color.G * 0.59 + color.B * 0.11
	if flatFloor or luminance < 0.22 then
		return Enum.Material.Concrete
	end
	return Enum.Material.Plaster
end

-- Estilo Cartoon: los materiales "realistas" pasan a plástico liso y los colores ganan viveza; los
-- grises claros tiran a lavanda (paredes tipo shooter de Roblox). Los detalles de suelo no cambian.
Kit.Cartoon = GameConfig.VisualStyle ~= "Realista"
Kit.Designed = false -- (mapa hecho ya realista: ver Kit.Begin)
local CARTOON_FLAT = {}
for _, name in {
	"Plaster", "Concrete", "Brick", "Limestone", "Cobblestone", "Slate", "Pavement", "Asphalt", "Granite", "Marble",
	"Sandstone", "Pebble", "CorrodedMetal", "DiamondPlate", "Rock", "Basalt", "Plastic", "Grass", "LeafyGrass",
	"ClayRoofTiles", "CeramicTiles", "Fabric",
} do
	local ok, material = pcall(function()
		return (Enum.Material :: any)[name]
	end)
	if ok and material then
		CARTOON_FLAT[material] = true
	end
end
local KEEP_LOOK = {
	ContactShadow = true, OilStain = true, Crack = true, Joint = true, TireMark = true, Puddle = true,
	-- Nata y caramelo blanco de Arena Caramelo (si no, el blanco se volvería lavanda)
	CandyWhite = true, CakeFrosting = true, FrostingDrip = true, GumdropShine = true,
	LollipopStick = true, LollipopSwirl = true, CottonStick = true,
	CastleTop = true, JumpPadRing = true, -- blancos de Caja de Juguetes y de las plataformas de salto
}

-- Tono de los grises en estilo Cartoon (cada mapa puede tener el suyo: Lighting.CartoonNeutral)
Kit.Neutral = { Hue = 0.68, Sat = 0.16 } -- lavanda por defecto

function Kit.vivid(color)
	local h, s, v = color:ToHSV()
	if s < 0.22 then
		local neutral = Kit.Neutral
		if v >= 0.45 then
			-- piedra, yeso, gris claro → pastel del tono del mapa (lavanda por defecto)
			return Color3.fromHSV(neutral.Hue, neutral.Sat, math.min(1, v * 1.02 + 0.05))
		elseif v >= 0.2 then
			-- asfalto, hormigón oscuro → gris con un toque del mismo tono
			return Color3.fromHSV(neutral.Hue, math.min(0.35, neutral.Sat + 0.08), math.min(1, v * 1.12))
		end
		return color -- negros
	end
	return Color3.fromHSV(h, math.clamp(s * 1.45, 0, 0.95), math.clamp(v * 1.1 + 0.04, 0, 1))
end

-- Estilo realista en mapas pensados para Cartoon: los colores muy vivos pasan a pintura de verdad
-- (menos saturados y no tan claros); los grises y los marrones casi no cambian
function Kit.natural(color)
	local h, s, v = color:ToHSV()
	if s < 0.25 then
		return color
	end
	return Color3.fromHSV(h, s * (s > 0.6 and 0.78 or 0.88), v > 0.85 and v * 0.93 or v)
end

function Kit.applyStyle(part)
	if KEEP_LOOK[part.Name] or part.Material == Enum.Material.Neon then
		return
	end
	if not Kit.Cartoon then
		-- (los mapas hechos ya realistas, como Encrucijada, tienen sus colores pensados)
		if not Kit.Designed then
			part.Color = Kit.natural(part.Color)
		end
		return
	end
	if CARTOON_FLAT[part.Material] then
		part.Material = Enum.Material.SmoothPlastic
	end
	-- Textura de cuadrícula (MaterialVariant "Grid" en MaterialService, ver assets/textures/LEEME.md).
	-- Si la variante no existe todavía, Roblox usa el plástico liso normal: no rompe nada.
	if part.Material == Enum.Material.SmoothPlastic then
		part.MaterialVariant = "Grid"
	end
	part.Color = Kit.vivid(part.Color)
end

function Kit.block(name, size, cf, color, material, parent)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = Kit.realisticMaterial(size, color, material)
	if part.Material == Enum.Material.Glass then
		part.Reflectance = 0.15 -- los cristales reflejan un poco el cielo
	end
	Kit.applyStyle(part)
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent or Kit.folder
	return part
end
local block = Kit.block

-- Pieza decorativa: no choca, no bloquea disparos y no hace sombra
function Kit.deco(name, size, cf, color, material, parent)
	local part = block(name, size, cf, color, material, parent)
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	-- Realismo con coste medio: solo lo grande (grúas, tejados, barcos, copas) proyecta sombra
	part.CastShadow = size.X * size.Y * size.Z >= 20 and part.Material ~= Enum.Material.Neon and part.Material ~= Enum.Material.Glass
	return part
end
local deco = Kit.deco

-- Cilindro de pie (el eje del cilindro en Roblox es X; lo giramos para que sea vertical)
function Kit.cylinder(name, height, diameter, cf, color, material, parent, decorative)
	local fn = decorative and deco or block
	local part = fn(name, V(height, diameter, diameter), cf * CFrame.Angles(0, 0, math.pi / 2), color, material, parent)
	part.Shape = Enum.PartType.Cylinder
	return part
end
local cylinder = Kit.cylinder

-- Cilindro tumbado a lo largo del eje X local
function Kit.pipe(name, length, diameter, cf, color, material, decorative)
	local fn = decorative and deco or block
	local part = fn(name, V(length, diameter, diameter), cf, color, material)
	part.Shape = Enum.PartType.Cylinder
	return part
end

function Kit.ball(name, diameter, cf, color, material, decorative)
	local fn = decorative and deco or block
	local part = fn(name, V(diameter, diameter, diameter), cf, color, material)
	part.Shape = Enum.PartType.Ball
	return part
end

-- Texto pegado a una cara de una pieza (carteles, rótulos de neón...)
function Kit.sign(part, face, text, color, strokeColor)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeColor3 = strokeColor or Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0
	label.Parent = gui
	return gui
end
local sign = Kit.sign

function Kit.light(part, kind, color, range, brightness, face)
	local light = Instance.new(kind or "PointLight")
	light.Color = color
	light.Range = range or 12
	light.Brightness = brightness or 1.5
	if face and (light:IsA("SpotLight") or light:IsA("SurfaceLight")) then
		light.Face = face
	end
	-- Los focos (farolas, lámparas) proyectan sombras reales; el menú Ajustes las apaga en Baja/Media
	if light:IsA("SpotLight") then
		light.Shadows = true
		light:SetAttribute("QualityShadow", true)
	end
	light.Parent = part
	return light
end

-- Rampa inclinada desde "bottom" hasta "top" (posiciones de la superficie)
function Kit.ramp(bottom, top, width, color, material)
	local mid = (bottom + top) / 2
	local length = (top - bottom).Magnitude
	local cf = CFrame.lookAt(mid, top) * CFrame.new(0, -0.5, 0)
	local part = block("Ramp", V(width, 1, length + 1), cf, color or RGB(150, 152, 165), material or Enum.Material.DiamondPlate)
	for _, side in { -1, 1 } do
		deco("RampEdge", V(0.4, 0.1, length + 1), cf * CFrame.new(side * (width / 2 - 0.3), 0.52, 0), C.Yellow, Enum.Material.SmoothPlastic)
	end
	return part
end

-- Escalera de piedra (rampa con escalones decorativos)
function Kit.stairs(bottom, top, width, color, material)
	local part = Kit.ramp(bottom, top, width, color, material or Enum.Material.Concrete)
	local steps = math.max(3, math.floor((top - bottom).Magnitude / 1.6))
	local stepColor = (color or RGB(200, 190, 170)):Lerp(Color3.new(0, 0, 0), 0.12)
	for i = 0, steps - 1 do
		local p = bottom:Lerp(top, (i + 0.5) / steps)
		local dir = (top - bottom)
		local flat = V(dir.X, 0, dir.Z).Unit
		deco("Step", V(width, 0.3, 0.3), CFrame.lookAt(p, p + flat) * CFrame.new(0, 0.05, 0), stepColor, Enum.Material.Concrete)
	end
	return part
end

-- Barandilla entre dos puntos (altura h)
function Kit.railing(a, b, h, color)
	h = h or 3
	color = color or C.Metal
	local length = (b - a).Magnitude
	local mid = (a + b) / 2
	local cf = CFrame.lookAt(mid, b)
	deco("Handrail", V(0.25, 0.25, length), cf * CFrame.new(0, h, 0), color, Enum.Material.Metal)
	deco("MidRail", V(0.15, 0.15, length), cf * CFrame.new(0, h * 0.5, 0), color, Enum.Material.Metal)
	local posts = math.max(2, math.floor(length / 4))
	for i = 0, posts do
		local p = a:Lerp(b, i / posts)
		deco("RailPost", V(0.25, h, 0.25), CFrame.new(p + V(0, h / 2, 0)), color, Enum.Material.Metal)
	end
	-- colisión invisible para no caerse (en la carpeta Boundary: las balas y la vista la atraviesan)
	local wall = block("RailCollider", V(0.4, h, length), cf * CFrame.new(0, h / 2, 0), color, nil, Kit.shootThroughFolder())
	wall.Transparency = 1
	wall.CastShadow = false
end

-- Carpeta para lo que choca pero no para las balas ni la vista (barandillas, alambradas): es la de
-- los muros del borde (Map.Boundary), que todos los raycasts del juego excluyen. CanQuery = false
-- no sirve en piezas que colisionan.
function Kit.shootThroughFolder()
	local folder = Kit.folder:FindFirstChild("Boundary")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Boundary"
		folder.Parent = Kit.folder
	end
	return folder
end

---------------------------------------------------------------------------
-- Piezas
---------------------------------------------------------------------------

-- Sombra de contacto (oclusión ambiental falsa): dos láminas oscuras semitransparentes algo más
-- grandes que la base, para que lo que está en el suelo parezca apoyado y no flotando. Solo a ras
-- de suelo (encima de otro objeto no hace falta). Material rugoso: el plástico liso brillaba con el
-- cielo y la sombra se veía más clara que el suelo.
function Kit.contactShadow(cf, sizeX, sizeZ, round, parent)
	local pos = cf.Position
	if math.abs(pos.Y) > 0.6 then
		return
	end
	local yaw = cf - pos
	for i, spec in { { 0.45, 0.7 }, { 1.2, 0.86 } } do
		local grow = spec[1] * 2
		local shadow
		if round then
			local d = math.max(sizeX, sizeZ) + grow
			shadow = deco("ContactShadow", V(0.02, d, d), CFrame.new(pos + V(0, 0.012 + i * 0.003, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.new(0, 0, 0), Enum.Material.Concrete, parent)
			shadow.Shape = Enum.PartType.Cylinder
		else
			shadow = deco("ContactShadow", V(sizeX + grow, 0.02, sizeZ + grow), CFrame.new(pos + V(0, 0.012 + i * 0.003, 0)) * yaw, Color3.new(0, 0, 0), Enum.Material.Concrete, parent)
		end
		shadow.Transparency = spec[2]
		shadow.CastShadow = false
	end
end

local CARGO_NAMES = { "HYPER CARGO", "NEXO LINE", "FROST CO.", "TURBO SHIP", "BLAZE LOG.", "VOLT MARINE" }
local cargoIndex = 0

function Kit.container(cf, color, labelText)
	local model = Instance.new("Model")
	model.Name = "Container"
	model.Parent = Kit.folder
	local size = V(20, 8.5, 8)
	local body = block("Body", size, cf * CFrame.new(0, size.Y / 2, 0), color, Enum.Material.CorrodedMetal, model)
	Kit.contactShadow(cf, size.X, size.Z, false, model)
	local dark = color:Lerp(Color3.new(0, 0, 0), 0.35)
	-- Nervios, techo y marco van pegados al cuerpo: su sombra ya la da el cuerpo (sin sombra propia)
	for i = -4, 4, 2 do
		deco("Rib", V(0.4, 8.2, 8.3), cf * CFrame.new(i * 2.2, 4.25, 0), dark, Enum.Material.Metal, model).CastShadow = false
	end
	block("Roof", V(20.2, 0.3, 8.2), cf * CFrame.new(0, 8.6, 0), dark, Enum.Material.Metal, model).CastShadow = false
	deco("DoorFrame", V(0.3, 8.6, 8.4), cf * CFrame.new(10.1, 4.25, 0), dark, Enum.Material.Metal, model).CastShadow = false
	for _, z in { -2, 2 } do
		deco("LockBar", V(0.3, 7.6, 0.25), cf * CFrame.new(10.3, 4.25, z), RGB(200, 200, 205), Enum.Material.Metal, model)
	end
	deco("DoorSplit", V(0.35, 8, 0.15), cf * CFrame.new(10.3, 4.25, 0), RGB(30, 30, 30), Enum.Material.Metal, model)
	-- Desgaste: chorretones de óxido que bajan desde el techo en los dos laterales largos
	local rust = color:Lerp(RGB(105, 58, 34), 0.6)
	for i, x in { -7.7, 3.3, 5.5 } do
		local side = i % 2 == 0 and 1 or -1
		local length = 2 + ((cargoIndex + i) % 3) * 1.4
		deco("RustStreak", V(0.9, length, 0.06), cf * CFrame.new(x, 8.45 - length / 2, side * 4.04), rust, Enum.Material.CorrodedMetal, model)
	end
	cargoIndex = cargoIndex % #CARGO_NAMES + 1
	local text = labelText or CARGO_NAMES[cargoIndex]
	sign(body, Enum.NormalId.Front, text, Color3.new(1, 1, 1), dark)
	sign(body, Enum.NormalId.Back, text, Color3.new(1, 1, 1), dark)
	return model
end

function Kit.crate(cf, size, color)
	size = size or 4
	local core = block("Crate", V(size, size, size), cf * CFrame.new(0, size / 2, 0), color or C.Wood, Enum.Material.WoodPlanks)
	Kit.contactShadow(cf, size, size)
	for _, y in { 0.12, 0.88 } do
		deco("CrateBand", V(size + 0.15, size * 0.12, size + 0.15), cf * CFrame.new(0, size * y, 0), C.WoodDark, Enum.Material.Wood)
	end
	deco("CrateCross", V(size + 0.1, size * 0.1, size * 1.3), cf * CFrame.new(0, size / 2, 0) * CFrame.Angles(rad(45), 0, 0), C.WoodDark, Enum.Material.Wood)
	return core
end

-- Caja metálica con chevron (estilo industrial)
function Kit.metalCrate(cf, size, color, glow)
	size = size or 5
	local core = block("MetalCrate", V(size, size, size), cf * CFrame.new(0, size / 2, 0), color or RGB(70, 75, 90), Enum.Material.DiamondPlate)
	Kit.contactShadow(cf, size, size)
	deco("CrateRim", V(size + 0.2, 0.3, size + 0.2), cf * CFrame.new(0, size - 0.15, 0), RGB(40, 42, 50), Enum.Material.Metal)
	deco("CrateRimB", V(size + 0.2, 0.3, size + 0.2), cf * CFrame.new(0, 0.15, 0), RGB(40, 42, 50), Enum.Material.Metal)
	if glow then
		deco("CrateGlow", V(size + 0.05, 0.2, size * 0.6), cf * CFrame.new(0, size * 0.5, 0), glow, Enum.Material.Neon)
	end
	return core
end

function Kit.barrel(cf, color)
	cylinder("Barrel", 3, 2, cf * CFrame.new(0, 1.5, 0), color or RGB(40, 90, 180), Enum.Material.Metal)
	Kit.contactShadow(cf, 2, 2, true)
	cylinder("BarrelRing", 0.2, 2.06, cf * CFrame.new(0, 0.8, 0), RGB(40, 40, 45), Enum.Material.Metal, nil, true)
	cylinder("BarrelRing", 0.2, 2.06, cf * CFrame.new(0, 2.2, 0), RGB(40, 40, 45), Enum.Material.Metal, nil, true)
end

function Kit.cone(cf)
	cylinder("ConeBase", 0.2, 1.4, cf * CFrame.new(0, 0.1, 0), RGB(255, 120, 20), Enum.Material.SmoothPlastic, nil, true)
	cylinder("Cone", 1.4, 0.8, cf * CFrame.new(0, 0.8, 0), RGB(255, 120, 20), Enum.Material.SmoothPlastic, nil, true)
	cylinder("ConeStripe", 0.25, 0.85, cf * CFrame.new(0, 0.9, 0), C.White, Enum.Material.SmoothPlastic, nil, true)
end

function Kit.barrier(size, cf)
	local part = block("Barrier", size, cf * CFrame.new(0, size.Y / 2, 0), RGB(225, 225, 230), Enum.Material.Concrete)
	Kit.contactShadow(cf, size.X, size.Z)
	local long = size.X >= size.Z
	local length = long and size.X or size.Z
	local count = math.max(2, math.floor(length / 3))
	for i = 0, count - 1 do
		local offset = -length / 2 + (i + 0.5) * (length / count)
		local color = i % 2 == 0 and RGB(230, 50, 50) or RGB(250, 250, 250)
		local stripeSize = long and V(length / count, 1, size.Z + 0.1) or V(size.X + 0.1, 1, length / count)
		local pos = long and CFrame.new(offset, size.Y - 1.2, 0) or CFrame.new(0, size.Y - 1.2, offset)
		deco("Stripe", stripeSize, cf * pos, color, Enum.Material.SmoothPlastic)
	end
	return part
end

function Kit.streetLamp(cf, color)
	cylinder("Pole", 14, 0.6, cf * CFrame.new(0, 7, 0), C.Metal, Enum.Material.Metal)
	cylinder("Base", 1, 1.2, cf * CFrame.new(0, 0.5, 0), C.Metal, Enum.Material.Metal)
	deco("Arm", V(0.4, 0.4, 4), cf * CFrame.new(0, 13.8, -1.8), C.Metal, Enum.Material.Metal)
	deco("Lamp", V(1.6, 0.5, 2.2), cf * CFrame.new(0, 13.4, -3.6), C.Metal, Enum.Material.Metal)
	local bulb = deco("Bulb", V(1.2, 0.2, 1.8), cf * CFrame.new(0, 13.1, -3.6), color or RGB(255, 240, 200), Enum.Material.Neon)
	Kit.light(bulb, "SpotLight", color or RGB(255, 235, 200), 26, 1.5, Enum.NormalId.Bottom).Angle = 100
end

function Kit.tree(cf)
	block("Planter", V(5, 1.6, 5), cf * CFrame.new(0, 0.8, 0), RGB(200, 200, 208), Enum.Material.Concrete)
	deco("Soil", V(4.4, 0.2, 4.4), cf * CFrame.new(0, 1.65, 0), RGB(90, 60, 40), Enum.Material.Ground)
	cylinder("Trunk", 7, 0.9, cf * CFrame.new(0, 5, 0), RGB(110, 75, 45), Enum.Material.Wood)
	for i, spec in {
		{ V(0, 9.5, 0), 6.5, C.Leaf },
		{ V(1.6, 8.4, 1), 4.5, C.LeafDark },
		{ V(-1.5, 8.8, -1.2), 4.8, C.Leaf },
		{ V(0.3, 11.6, -0.4), 4, C.LeafDark },
	} do
		local leaf = deco("Leaves" .. i, V(spec[2], spec[2], spec[2]), cf * CFrame.new(spec[1]), spec[3], Enum.Material.LeafyGrass)
		leaf.Shape = Enum.PartType.Ball
		leaf.CastShadow = true
	end
end

-- Palmera: tronco inclinado por segmentos y hojas largas
function Kit.palm(cf, height)
	height = height or 14
	local segments = 6
	local lean = rad(8)
	local pos = cf
	for i = 1, segments do
		local seg = height / segments
		local piece = cylinder("PalmTrunk", seg + 0.2, 1.1 - i * 0.07, pos * CFrame.new(0, seg / 2, 0), RGB(140, 105, 70), Enum.Material.Wood, nil, i > 2)
		piece.CanCollide = i <= 2
		deco("TrunkRing", V(0.25, 1.2 - i * 0.07, 1.2 - i * 0.07), pos * CFrame.new(0, seg, 0) * CFrame.Angles(0, 0, math.pi / 2), RGB(110, 80, 50), Enum.Material.Wood).Shape = Enum.PartType.Cylinder
		pos = pos * CFrame.new(0, seg, 0) * CFrame.Angles(lean / segments * 2, 0, 0)
	end
	local top = pos
	for i = 0, 6 do
		local angle = i * math.pi * 2 / 7
		local frond = deco(
			"Frond",
			V(1.6, 0.25, 7),
			top * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0.2, -3.2) * CFrame.Angles(rad(-20), 0, 0),
			i % 2 == 0 and RGB(70, 170, 70) or RGB(50, 140, 55),
			Enum.Material.Grass
		)
		frond.CastShadow = true
	end
	Kit.ball("Coconuts", 1.4, top * CFrame.new(0, -0.4, 0), RGB(110, 80, 40), Enum.Material.Wood, true)
end

-- Enredadera colgando de una pared (cara mirando en la dirección `normal`)
function Kit.vines(cf, width, height)
	for i = 0, math.floor(width / 1.5) do
		local h = height * (0.5 + ((i * 37) % 10) / 20)
		deco("Vine", V(1.2, h, 0.3), cf * CFrame.new(-width / 2 + i * 1.5, -h / 2, 0), (i % 2 == 0) and RGB(70, 150, 60) or RGB(90, 175, 70), Enum.Material.LeafyGrass)
	end
end

-- Estandarte de tela con emblema (cuelga de una pared, cara -Z)
function Kit.banner(cf, width, height, color, emblemColor)
	local cloth = deco("Banner", V(width, height, 0.15), cf * CFrame.new(0, -height / 2, 0), color, Enum.Material.Fabric)
	deco("BannerRod", V(width + 1, 0.3, 0.3), cf, C.Metal, Enum.Material.Metal)
	-- Emblema tipo chevron
	for _, s in { -1, 1 } do
		deco("Emblem", V(width * 0.12, height * 0.35, 0.05), cf * CFrame.new(s * width * 0.13, -height * 0.45, -0.1) * CFrame.Angles(0, 0, rad(35 * s)), emblemColor or C.White, Enum.Material.SmoothPlastic)
	end
	deco("BannerTip", V(width * 0.7, width * 0.7, 0.14), cf * CFrame.new(0, -height, 0) * CFrame.Angles(0, 0, rad(45)), color, Enum.Material.Fabric)
	return cloth
end

-- Toldo inclinado
function Kit.awning(cf, width, depth, color)
	for i = 0, math.floor(width / 1.5) - 1 do
		deco("Awning", V(1.5, 0.25, depth), cf * CFrame.new(-width / 2 + 0.75 + i * 1.5, 0, -depth / 2) * CFrame.Angles(rad(-18), 0, 0), i % 2 == 0 and color or C.White, Enum.Material.Fabric)
	end
end

-- Edificio mediterráneo: estuco, cornisa, ventanas, puerta, azotea transitable con murete
function Kit.house(cf, size, color, accent, options)
	options = options or {}
	local model = Instance.new("Model")
	model.Name = "House"
	model.Parent = Kit.folder
	local trim = color:Lerp(Color3.new(0, 0, 0), 0.18)
	block("Walls", size, cf * CFrame.new(0, size.Y / 2, 0), color, Enum.Material.Plaster, model)
	deco("Base", V(size.X + 0.4, 1.4, size.Z + 0.4), cf * CFrame.new(0, 0.7, 0), trim, Enum.Material.Limestone, model)
	Kit.contactShadow(cf, size.X + 0.4, size.Z + 0.4, false, model)
	deco("Cornice", V(size.X + 0.8, 0.8, size.Z + 0.8), cf * CFrame.new(0, size.Y - 0.4, 0), accent or RGB(200, 70, 50), Enum.Material.Plaster, model)
	-- Murete de la azotea (cobertura)
	local h = 2.6
	for _, z in { -1, 1 } do
		block("Parapet", V(size.X, h, 1), cf * CFrame.new(0, size.Y + h / 2, z * (size.Z / 2 - 0.5)), color, Enum.Material.Plaster, model)
	end
	if not options.OpenSides then
		for _, x in { -1, 1 } do
			block("Parapet", V(1, h, size.Z - 2), cf * CFrame.new(x * (size.X / 2 - 0.5), size.Y + h / 2, 0), color, Enum.Material.Plaster, model)
		end
	end
	-- Ventanas con contraventanas
	local floors = math.max(1, math.floor(size.Y / 7))
	for f = 1, floors do
		local y = (f - 0.5) * size.Y / floors + 0.6
		for _, face in { -1, 1 } do
			for i = 1, math.max(1, math.floor(size.X / 9)) do
				local x = -size.X / 2 + (i - 0.5) * size.X / math.max(1, math.floor(size.X / 9))
				local p = cf * CFrame.new(x, y, face * (size.Z / 2 + 0.1))
				deco("Window", V(2.4, 3.2, 0.2), p, RGB(60, 70, 90), Enum.Material.Glass, model) -- opaco (más barato que semitransparente)
				deco("Sill", V(3, 0.3, 0.6), p * CFrame.new(0, -1.75, 0), trim, Enum.Material.Limestone, model)
				for _, s in { -1, 1 } do
					deco("Shutter", V(1.1, 3.2, 0.15), p * CFrame.new(s * 1.85, 0, face * 0.1), accent or RGB(60, 120, 170), Enum.Material.Wood, model)
				end
			end
		end
	end
	-- Puerta con luz
	local doorCf = cf * CFrame.new(options.DoorX or 0, 3.3, -(size.Z / 2 + 0.12))
	deco("Door", V(3.6, 6.6, 0.25), doorCf, RGB(100, 65, 40), Enum.Material.WoodPlanks, model)
	deco("DoorArch", V(4.6, 0.8, 0.4), doorCf * CFrame.new(0, 3.6, 0), trim, Enum.Material.Limestone, model)
	local lamp = deco("DoorLamp", V(0.6, 0.8, 0.6), doorCf * CFrame.new(2.8, 2.5, -0.3), RGB(255, 210, 140), Enum.Material.Neon, model)
	Kit.light(lamp, "PointLight", RGB(255, 200, 120), 12, 1.2)
	if options.Vines then
		Kit.vines(cf * CFrame.new(size.X * 0.25, size.Y - 0.5, -(size.Z / 2 + 0.25)), 6, 8)
	end
	return model
end

-- Grúa pórtico decorativa (para fondos de puerto)
function Kit.crane(cf, height, color)
	color = color or RGB(240, 190, 40)
	height = height or 40
	for _, x in { -6, 6 } do
		for _, z in { -3, 3 } do
			deco("CraneLeg", V(1.2, height, 1.2), cf * CFrame.new(x, height / 2, z), color, Enum.Material.Metal)
		end
	end
	deco("CraneTop", V(14, 2, 8), cf * CFrame.new(0, height, 0), color, Enum.Material.Metal)
	deco("CraneBoom", V(2, 2, 50), cf * CFrame.new(0, height + 2, -14), color, Enum.Material.Metal)
	deco("CraneCab", V(4, 3, 4), cf * CFrame.new(0, height - 2.5, -6), RGB(230, 230, 235), Enum.Material.SmoothPlastic)
	deco("Cable", V(0.2, 12, 0.2), cf * CFrame.new(0, height - 5, -30), RGB(30, 30, 30), Enum.Material.Metal)
	local beacon = Kit.ball("CraneBeacon", 1, cf * CFrame.new(0, height + 3.5, -38), RGB(255, 40, 40), Enum.Material.Neon, true)
	beacon:SetAttribute("Blink", 1)
end

-- Barco de carga decorativo
function Kit.ship(cf, length)
	length = length or 90
	deco("Hull", V(length, 10, 18), cf * CFrame.new(0, 3, 0), RGB(40, 50, 70), Enum.Material.Metal)
	deco("HullStripe", V(length + 0.2, 1.5, 18.2), cf * CFrame.new(0, -1, 0), RGB(200, 40, 40), Enum.Material.Metal)
	deco("Bridge", V(10, 12, 14), cf * CFrame.new(length / 2 - 8, 14, 0), C.White, Enum.Material.SmoothPlastic)
	local colors = { C.Red, C.Blue, RGB(240, 150, 30), RGB(60, 170, 90) }
	local i = 0
	for x = -length / 2 + 8, length / 2 - 18, 9 do
		for row = 0, 1 do
			i += 1
			deco("Cargo", V(8.5, 4, 8), cf * CFrame.new(x, 10 + row * 4, (i % 2 == 0) and -4.2 or 4.2), colors[i % #colors + 1], Enum.Material.CorrodedMetal)
		end
	end
end

-- Faro sobre una isla de roca (fondo)
function Kit.lighthouse(position)
	local terrain = workspace.Terrain
	terrain:FillBall(position + V(0, -6, 0), 26, Enum.Material.Rock)
	terrain:FillBall(position + V(14, -10, 8), 18, Enum.Material.Rock)
	terrain:FillBall(position + V(-10, -2, -6), 14, Enum.Material.Grass)
	local base = position + V(0, 12, 0)
	cylinder("LighthouseTower", 26, 7, CFrame.new(base + V(0, 13, 0)), C.White, Enum.Material.Plaster, nil, true)
	for i = 0, 2 do
		cylinder("LighthouseStripe", 2.5, 7.1, CFrame.new(base + V(0, 6 + i * 8, 0)), C.Red, Enum.Material.Plaster, nil, true)
	end
	cylinder("LighthouseTop", 3, 5, CFrame.new(base + V(0, 27.5, 0)), RGB(255, 245, 200), Enum.Material.Neon, nil, true)
	cylinder("LighthouseRoof", 2, 6, CFrame.new(base + V(0, 30, 0)), C.Red, Enum.Material.Plaster, nil, true)
end

-- Tubería industrial con soportes
function Kit.pipeRun(a, b, diameter, color)
	local length = (b - a).Magnitude
	local cf = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, rad(90), 0)
	Kit.pipe("Pipe", length, diameter, cf, color or RGB(90, 95, 110), Enum.Material.Metal, true)
	local rings = math.floor(length / 8)
	for i = 1, rings do
		local p = a:Lerp(b, i / (rings + 1))
		Kit.pipe("PipeRing", 0.5, diameter + 0.3, CFrame.lookAt(p, b) * CFrame.Angles(0, rad(90), 0), RGB(50, 52, 60), Enum.Material.Metal, true)
	end
end

-- Canal de lava (daña al tocarla; ver Hazards)
function Kit.lava(size, cf)
	local lava = block("Lava", size, cf, RGB(255, 100, 20), Enum.Material.CrackedLava)
	lava:SetAttribute("Hazard", "Lava")
	local glow = deco("LavaGlow", V(size.X, 0.1, size.Z), cf * CFrame.new(0, size.Y / 2 + 0.05, 0), RGB(255, 140, 30), Enum.Material.Neon)
	glow.Transparency = 0.4
	Kit.light(glow, "SurfaceLight", RGB(255, 120, 30), 16, 1.2, Enum.NormalId.Top)
	return lava
end

-- Cinta transportadora con lingotes
function Kit.conveyor(a, b, width)
	local length = (b - a).Magnitude
	local cf = CFrame.lookAt((a + b) / 2, b)
	block("Conveyor", V(width, 1, length), cf, RGB(40, 42, 48), Enum.Material.DiamondPlate)
	for _, s in { -1, 1 } do
		deco("ConveyorSide", V(0.4, 1.2, length), cf * CFrame.new(s * (width / 2 + 0.2), 0.3, 0), RGB(255, 170, 30), Enum.Material.Metal)
	end
	for i = 1, math.floor(length / 4) do
		local bar = deco("GoldBar", V(1.6, 0.6, 2.4), cf * CFrame.new(0, 0.8, -length / 2 + i * 4), RGB(255, 200, 60), Enum.Material.Foil)
		bar.CastShadow = true
	end
end

-- Chimenea industrial con luz roja
function Kit.smokestack(position, height)
	cylinder("Smokestack", height, 6, CFrame.new(position + V(0, height / 2, 0)), RGB(70, 65, 70), Enum.Material.Concrete, nil, true)
	for i = 1, 3 do
		cylinder("StackStripe", 1.2, 6.1, CFrame.new(position + V(0, height * i / 4, 0)), RGB(200, 60, 40), Enum.Material.Concrete, nil, true)
	end
	local light = Kit.ball("StackLight", 1.2, CFrame.new(position + V(0, height + 0.8, 0)), RGB(255, 40, 40), Enum.Material.Neon, true)
	light:SetAttribute("Blink", 1.5)
	-- Humo saliendo de la chimenea
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Color = ColorSequence.new(RGB(120, 110, 130), RGB(60, 55, 70))
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 16) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
	smoke.Lifetime = NumberRange.new(5, 8)
	smoke.Speed = NumberRange.new(4, 7)
	smoke.SpreadAngle = Vector2.new(12, 12)
	smoke.Acceleration = V(2, 1, 0)
	smoke.Rate = 4
	smoke.EmissionDirection = Enum.NormalId.Top
	smoke.Parent = light
end

-- Guirnalda de bombillas entre dos puntos (cuelga un poco por el centro)
function Kit.stringLights(a, b, color)
	local count = math.max(4, math.floor((b - a).Magnitude / 2.5))
	for i = 0, count do
		local t = i / count
		local p = a:Lerp(b, t) - V(0, math.sin(t * math.pi) * 1.5, 0)
		local bulb = Kit.ball("Bulb", 0.45, CFrame.new(p), (i % 3 == 0) and RGB(255, 120, 120) or (color or RGB(255, 220, 140)), Enum.Material.Neon, true)
		bulb.CastShadow = false
	end
	local mid = (a + b) / 2 - V(0, 0.75, 0)
	deco("LightWire", V(0.08, 0.08, (b - a).Magnitude), CFrame.lookAt(mid, b), RGB(30, 30, 30), Enum.Material.SmoothPlastic)
end

-- Maceta con flores
function Kit.flowerPot(cf, flowerColor)
	block("Pot", V(2, 1.6, 2), cf * CFrame.new(0, 0.8, 0), RGB(190, 100, 60), Enum.Material.Plaster)
	Kit.ball("Bush", 2.4, cf * CFrame.new(0, 2.1, 0), RGB(70, 160, 70), Enum.Material.Grass, true)
	for i = 0, 2 do
		Kit.ball("Flower", 0.6, cf * CFrame.new(math.cos(i * 2.1) * 0.8, 2.9, math.sin(i * 2.1) * 0.8), flowerColor or RGB(255, 90, 140), Enum.Material.SmoothPlastic, true)
	end
end

-- Parche de flores (tulipanes de colores con tallo y hoja), decorativo: se atraviesa
local TULIP_COLORS = { RGB(235, 50, 60), RGB(255, 200, 40), RGB(255, 110, 170), RGB(250, 250, 255), RGB(160, 90, 255) }
function Kit.flowers(position, count, seed)
	local rng = Random.new(seed or math.floor(position.X * 17 + position.Z * 29))
	count = count or 3
	for _ = 1, count do
		local offset = V(rng:NextNumber(-1.6, 1.6), 0, rng:NextNumber(-1.6, 1.6))
		local h = rng:NextNumber(0.9, 1.5)
		local base = CFrame.new(position + offset) * CFrame.Angles(rng:NextNumber(-0.15, 0.15), rng:NextNumber(0, 6.28), rng:NextNumber(-0.15, 0.15))
		deco("FlowerStem", V(0.1, h, 0.1), base * CFrame.new(0, h / 2, 0), RGB(60, 160, 60), Enum.Material.SmoothPlastic)
		local color = TULIP_COLORS[rng:NextInteger(1, #TULIP_COLORS)]
		local bloom = deco("FlowerBloom", V(0.34, 0.42, 0.34), base * CFrame.new(0, h + 0.15, 0), color, Enum.Material.SmoothPlastic)
		bloom.CastShadow = false
		for k = 0, 2 do
			deco("FlowerPetal", V(0.18, 0.3, 0.06), base * CFrame.Angles(0, k * 2.09, 0) * CFrame.new(0, h + 0.24, 0.16) * CFrame.Angles(rad(-20), 0, 0), color, Enum.Material.SmoothPlastic)
		end
	end
end

-- Pino cartoon (pisos redondos cada vez más estrechos, verde vivo). far = menos pisos (fondo)
function Kit.cartoonPine(position, scale, far)
	scale = scale or 1
	cylinder("PineTrunk", 4 * scale, 1.2 * scale, CFrame.new(position + V(0, 2 * scale, 0)), RGB(120, 80, 50), Enum.Material.Wood)
	local tiers = far and 3 or 5
	for i = 1, tiers do
		local t = (i - 1) / (tiers - 1)
		local d = (9 - 6.5 * t) * scale
		local y = (3.5 + t * 9) * scale
		local h = (12 / tiers + 0.8) * scale
		local tier = cylinder("PineTier", h, d, CFrame.new(position + V(0, y, 0)), RGB(60, 190, 90):Lerp(RGB(40, 150, 70), (i % 2) * 0.5), Enum.Material.SmoothPlastic, nil, true)
		tier.CastShadow = not far
	end
end

-- Mata de hierba alta (hojas finas inclinadas en abanico)
function Kit.grassTuft(position, scale, seed)
	local rng = Random.new(seed or math.floor(position.X * 23 + position.Z * 7))
	scale = scale or 1
	for i = 0, 3 do
		local h = rng:NextNumber(1.1, 1.9) * scale
		local angle = i * 1.57 + rng:NextNumber(-0.3, 0.3)
		local tilt = rad(rng:NextNumber(12, 30))
		local blade = deco("GrassBlade", V(0.16 * scale, h, 0.05), CFrame.new(position) * CFrame.Angles(0, angle, 0) * CFrame.Angles(tilt, 0, 0) * CFrame.new(0, h / 2, 0), RGB(70, 190, 70):Lerp(RGB(40, 140, 50), rng:NextNumber()), Enum.Material.SmoothPlastic)
		blade.CastShadow = false
	end
end

-- Cartel de neón grande con texto
function Kit.neonSign(cf, width, height, text, color, frameColor)
	local board = deco("NeonBoard", V(width, height, 0.6), cf, RGB(20, 20, 30), Enum.Material.SmoothPlastic)
	sign(board, Enum.NormalId.Front, text, color, frameColor or color:Lerp(Color3.new(1, 1, 1), 0.5))
	for _, y in { -1, 1 } do
		deco("NeonFrame", V(width + 0.6, 0.35, 0.7), cf * CFrame.new(0, y * height / 2, 0), frameColor or color, Enum.Material.Neon)
	end
	for _, x in { -1, 1 } do
		deco("NeonFrame", V(0.35, height, 0.7), cf * CFrame.new(x * width / 2, 0, 0), frameColor or color, Enum.Material.Neon)
	end
	Kit.light(board, "SurfaceLight", color, 18, 1.5, Enum.NormalId.Front)
	return board
end

-- Carretilla elevadora decorativa
function Kit.forklift(cf)
	block("ForkBody", V(4, 3, 6), cf * CFrame.new(0, 2, 0), RGB(250, 190, 30), Enum.Material.SmoothPlastic)
	deco("ForkCab", V(3.6, 3, 0.3), cf * CFrame.new(0, 5, 1.5), RGB(40, 40, 45), Enum.Material.Metal)
	deco("ForkRoof", V(4, 0.3, 4), cf * CFrame.new(0, 6.6, 0), RGB(40, 40, 45), Enum.Material.Metal)
	deco("ForkMast", V(3, 6, 0.4), cf * CFrame.new(0, 3.5, -3.2), RGB(40, 40, 45), Enum.Material.Metal)
	for _, x in { -1, 1 } do
		deco("Fork", V(0.4, 0.3, 3), cf * CFrame.new(x * 1, 0.6, -4.8), RGB(40, 40, 45), Enum.Material.Metal)
		for _, z in { -2, 2 } do
			Kit.pipe("Wheel", 0.8, 1.6, cf * CFrame.new(x * 2.1, 0.8, z), RGB(25, 25, 28), Enum.Material.Rubber, true)
		end
	end
end

-- Barca decorativa en el agua
function Kit.boat(cf)
	deco("BoatHull", V(6, 2, 14), cf * CFrame.new(0, 0.5, 0), C.White, Enum.Material.SmoothPlastic)
	deco("BoatStripe", V(6.1, 0.6, 14.1), cf * CFrame.new(0, 0.2, 0), C.Red, Enum.Material.SmoothPlastic)
	deco("BoatCabin", V(4.4, 3, 5), cf * CFrame.new(0, 3, 1), RGB(230, 230, 235), Enum.Material.SmoothPlastic)
	deco("BoatRoof", V(5, 0.4, 6), cf * CFrame.new(0, 4.7, 1), C.Red, Enum.Material.SmoothPlastic)
	deco("BoatWindow", V(4.5, 1, 0.2), cf * CFrame.new(0, 3.3, -1.5), RGB(60, 120, 180), Enum.Material.Glass)
end

---------------------------------------------------------------------------
-- Detalles realistas
---------------------------------------------------------------------------

-- Charco: manchas planas de agua que reflejan el cielo y las luces (formas irregulares)
function Kit.puddle(position, size, seed)
	local rng = Random.new(seed or math.floor(position.X * 7 + position.Z * 13))
	for i = 1, 3 do
		local d = size * (i == 1 and 1 or rng:NextNumber(0.45, 0.75))
		local offset = i == 1 and V(0, 0, 0) or V(rng:NextNumber(-0.4, 0.4) * size, 0, rng:NextNumber(-0.4, 0.4) * size)
		local water = deco("Puddle", V(0.04, d, d), CFrame.new(position + offset + V(0, 0.03 + i * 0.002, 0)) * CFrame.Angles(0, 0, math.pi / 2), RGB(38, 44, 52), Enum.Material.Glass)
		water.Shape = Enum.PartType.Cylinder
		water.Transparency = 0.25
		water.Reflectance = 0.45
	end
end

-- Cono de luz volumétrica bajo una lámpara: discos casi transparentes cada vez más anchos (se ve
-- el haz en el aire, sobre todo con niebla). `top` es la posición de la lámpara.
function Kit.lightCone(top, height, topRadius, bottomRadius, color)
	local segments = 5
	local step = height / segments
	for i = 1, segments do
		local t = (i - 0.5) / segments
		local radius = topRadius + (bottomRadius - topRadius) * t
		local disc = deco("LightCone", V(step, radius * 2, radius * 2), CFrame.new(top - V(0, step * (i - 0.5), 0)) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.Material.Neon)
		disc.Shape = Enum.PartType.Cylinder
		disc.Transparency = 0.93 + 0.01 * i
		disc.CastShadow = false
	end
end

-- Vapor que sale de una rejilla del suelo
function Kit.steamVent(cf, strength)
	strength = strength or 1
	local grate = deco("VentGrate", V(3, 0.1, 3), cf * CFrame.new(0, 0.05, 0), RGB(40, 42, 48), Enum.Material.DiamondPlate)
	for i = -1, 1 do
		deco("VentSlot", V(2.6, 0.12, 0.25), cf * CFrame.new(0, 0.06, i * 0.8), RGB(15, 15, 18), Enum.Material.Metal)
	end
	local steam = Instance.new("ParticleEmitter")
	steam.Name = "Steam"
	steam.Texture = "rbxasset://textures/particles/smoke_main.dds"
	steam.Color = ColorSequence.new(RGB(235, 238, 245))
	steam.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 6) })
	steam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.75), NumberSequenceKeypoint.new(0.3, 0.6), NumberSequenceKeypoint.new(1, 1) })
	steam.Lifetime = NumberRange.new(2.5, 4)
	steam.Speed = NumberRange.new(3, 6)
	steam.SpreadAngle = Vector2.new(12, 12)
	steam.Acceleration = V(0, 0.8, 0)
	steam.RotSpeed = NumberRange.new(-20, 20)
	steam.Rotation = NumberRange.new(0, 360)
	steam.Rate = 6 * strength
	steam.LightInfluence = 1
	steam.EmissionDirection = Enum.NormalId.Top
	steam.WindAffectsDrag = true
	steam.Parent = grate
	return grate
end

-- Polvo flotando en el aire (se ve a contraluz): una caja invisible que emite motas lentas
function Kit.dustMotes(cf, size, color, rate)
	local volume = deco("DustVolume", size, cf, RGB(255, 255, 255), Enum.Material.SmoothPlastic)
	volume.Transparency = 1
	local dust = Instance.new("ParticleEmitter")
	dust.Name = "Dust"
	dust.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	dust.Color = ColorSequence.new(color or RGB(255, 245, 220))
	dust.LightEmission = 0.4
	dust.LightInfluence = 0.6
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.12), NumberSequenceKeypoint.new(1, 0) })
	dust.Transparency = NumberSequence.new(0.3)
	dust.Lifetime = NumberRange.new(5, 8)
	dust.Speed = NumberRange.new(0.2, 0.6)
	dust.SpreadAngle = Vector2.new(180, 180)
	dust.RotSpeed = NumberRange.new(-30, 30)
	dust.Rate = rate or 12
	dust.WindAffectsDrag = true
	dust.Shape = Enum.ParticleEmitterShape.Box
	dust.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	dust.Parent = volume
	return volume
end

-- Colina natural de fondo (terreno): una bola grande deformada con bultos, salientes de roca y,
-- si se pide, manchas de otro material por encima (selva, nieve...). Nada de bolas perfectas.
-- `inward` (vector horizontal hacia el centro del mapa) evita que los bultos invadan la zona de juego.
function Kit.naturalHill(center, radius, material, options)
	options = options or {}
	local terrain = workspace.Terrain
	local rng = Random.new(options.Seed or math.floor(center.X * 3 + center.Z * 7))
	local inward = options.Inward
	local function away(offset)
		if inward and offset:Dot(inward) > 0 then
			return offset - inward * (2 * offset:Dot(inward))
		end
		return offset
	end
	-- Dirección sobre la superficie que queda por encima del suelo (y > 3)
	local function surfaceDir(minUp, maxUp)
		local low = math.asin(math.clamp((3 - center.Y) / radius, -1, 1))
		local elevation = math.max(low, minUp) + rng:NextNumber(0, 1) * math.max(0, maxUp - math.max(low, minUp))
		local angle = rng:NextNumber(0, math.pi * 2)
		return V(math.cos(angle) * math.cos(elevation), math.sin(elevation), math.sin(angle) * math.cos(elevation))
	end
	terrain:FillBall(center, radius, material)
	for _ = 1, 4 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local dist = rng:NextNumber(0.35, 0.7) * radius
		local offset = away(V(math.cos(angle) * dist, rng:NextNumber(-0.25, 0.05) * radius, math.sin(angle) * dist))
		terrain:FillBall(center + offset, radius * rng:NextNumber(0.45, 0.65), material)
	end
	-- Salientes de roca en la ladera
	for _ = 1, options.RockCount or 3 do
		local dir = surfaceDir(0.15, 1.1)
		terrain:FillBall(center + dir * radius * 0.94, radius * rng:NextNumber(0.1, 0.18), options.Rock or Enum.Material.Rock)
	end
	-- Manchas en la cima (copas de árboles con LeafyGrass, nieve en una montaña de roca...)
	if options.Top then
		for _ = 1, options.TopCount or 5 do
			local dir = surfaceDir(0.5, 1.4)
			terrain:FillBall(center + dir * radius * 0.92, radius * rng:NextNumber(0.18, 0.3), options.Top)
		end
	end
end

-- Grupo de rocas de terreno medio enterradas (una grande y dos pequeñas al lado)
function Kit.rockCluster(position, size, material, seed)
	local rng = Random.new(seed or math.floor(position.X * 5 + position.Z * 11))
	material = material or Enum.Material.Rock
	local terrain = workspace.Terrain
	terrain:FillBall(position - V(0, size * 0.35, 0), size, material)
	for _ = 1, 2 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local r = size * rng:NextNumber(0.45, 0.65)
		terrain:FillBall(position + V(math.cos(angle) * size * 0.9, -r * 0.4, math.sin(angle) * size * 0.9), r, material)
	end
end

-- Arbusto: tres bolas de hojas con tonos distintos (decorativo: se atraviesa)
function Kit.bush(position, scale, color)
	scale = scale or 1
	local rng = Random.new(math.floor(position.X * 11 + position.Z * 5))
	local base = color or RGB(58, 112, 46)
	for _ = 1, 3 do
		local d = scale * rng:NextNumber(2.4, 3.6)
		local offset = V(rng:NextNumber(-1, 1) * scale, d * 0.3, rng:NextNumber(-1, 1) * scale)
		local leaf = Kit.ball("Bush", d, CFrame.new(position + offset), base:Lerp(Color3.new(0, 0, 0), rng:NextNumber(0, 0.25)), Enum.Material.LeafyGrass, true)
		leaf.CastShadow = d >= 3
	end
end

-- Tronco caído con musgo por encima y los cortes claros (sirve de cobertura baja)
function Kit.log(cf, length, diameter)
	local y = diameter * 0.42
	Kit.pipe("Log", length, diameter, cf * CFrame.new(0, y, 0), RGB(92, 70, 50), Enum.Material.Wood)
	Kit.deco("LogMoss", V(length * 0.7, 0.2, diameter * 0.5), cf * CFrame.new(length * 0.05, y + diameter * 0.42, 0), RGB(78, 118, 52), Enum.Material.LeafyGrass)
	for _, side in { -1, 1 } do
		Kit.pipe("LogEnd", 0.1, diameter * 0.9, cf * CFrame.new(side * length / 2, y, 0), RGB(168, 132, 92), Enum.Material.Wood, true)
	end
end

-- Coche aparcado (sedán): carrocería de pintura brillante, cabina de cristal, ruedas de goma con
-- tapacubos, faros y pilotos. La carrocería y la cabina son cobertura; el resto es decorativo.
-- Largo en el eje X local (el morro mira a -X). options.Snow = true le pone nieve encima.
function Kit.car(cf, color, options)
	options = options or {}
	local model = Instance.new("Model")
	model.Name = "Car"
	model.Parent = Kit.folder
	local function paint(part)
		part.Material = Enum.Material.SmoothPlastic -- pintura lisa con brillo (no yeso)
		part.MaterialVariant = "" -- sin cuadrícula: es pintura de coche
		part.Reflectance = 0.12
		return part
	end
	paint(block("CarBody", V(9, 1.5, 4.2), cf * CFrame.new(0, 1.25, 0), color, nil, model))
	paint(block("CarHood", V(2.6, 0.35, 4.1), cf * CFrame.new(-3.1, 2.15, 0), color, nil, model))
	paint(block("CarTrunk", V(1.6, 0.35, 4.1), cf * CFrame.new(3.6, 2.15, 0), color, nil, model))
	local cabin = block("CarCabin", V(4.6, 1.35, 3.8), cf * CFrame.new(0.2, 2.65, 0), RGB(28, 34, 44), Enum.Material.Glass, model)
	cabin.Reflectance = 0.35
	cabin.Transparency = 0.15
	paint(deco("CarRoof", V(3.4, 0.22, 3.86), cf * CFrame.new(0.3, 3.42, 0), color, nil, model))
	-- Parabrisas y luna trasera inclinados (cuñas de cristal)
	for _, spec in { { -2.6, 1, math.pi / 2 }, { 2.9, 0.8, -math.pi / 2 } } do
		local glass = Instance.new("WedgePart")
		glass.Name = "CarWindshield"
		glass.Anchored = true
		glass.CanCollide = false
		glass.CanQuery = false
		glass.CanTouch = false
		glass.CastShadow = false
		glass.Size = V(3.8, 1.35, spec[2])
		glass.CFrame = cf * CFrame.new(spec[1], 2.65, 0) * CFrame.Angles(0, spec[3], 0)
		glass.Color = RGB(28, 34, 44)
		glass.Material = Enum.Material.Glass
		glass.Reflectance = 0.35
		glass.Transparency = 0.15
		glass.Parent = model
	end
	for _, x in { -2.15, 2.5 } do
		paint(deco("CarPillar", V(0.3, 1.35, 3.86), cf * CFrame.new(x, 2.65, 0), color, nil, model))
	end
	-- Ruedas y tapacubos
	for _, x in { -2.9, 2.9 } do
		for _, z in { -1.85, 1.85 } do
			local wheel = deco("Wheel", V(1.75, 1.75, 0.7), cf * CFrame.new(x, 0.875, z) * CFrame.Angles(0, math.pi / 2, 0), RGB(24, 24, 26), Enum.Material.Rubber, model)
			wheel.Shape = Enum.PartType.Cylinder
			local hub = deco("Hubcap", V(0.08, 0.95, 0.95), cf * CFrame.new(x, 0.875, z + (z > 0 and 0.36 or -0.36)) * CFrame.Angles(0, math.pi / 2, 0), RGB(190, 192, 198), Enum.Material.Metal, model)
			hub.Shape = Enum.PartType.Cylinder
		end
	end
	-- Parachoques, faros y pilotos
	for _, x in { -4.6, 4.6 } do
		deco("Bumper", V(0.3, 0.5, 4.3), cf * CFrame.new(x, 0.85, 0), RGB(35, 35, 38), Enum.Material.Plastic, model)
	end
	for _, z in { -1.5, 1.5 } do
		deco("Headlight", V(0.12, 0.35, 0.8), cf * CFrame.new(-4.52, 1.55, z), RGB(250, 248, 235), Enum.Material.Neon, model)
		deco("Taillight", V(0.12, 0.3, 0.7), cf * CFrame.new(4.52, 1.6, z), RGB(200, 25, 25), Enum.Material.Neon, model)
	end
	deco("Plate", V(0.08, 0.35, 1.1), cf * CFrame.new(4.62, 1.05, 0), RGB(235, 235, 225), Enum.Material.SmoothPlastic, model)
	if options.Snow then
		local snow = RGB(240, 245, 252)
		deco("CarSnow", V(3.2, 0.35, 3.6), cf * CFrame.new(0.3, 3.7, 0), snow, Enum.Material.Snow, model)
		deco("CarSnow", V(2.3, 0.25, 3.8), cf * CFrame.new(-3.2, 2.45, 0), snow, Enum.Material.Snow, model)
		deco("CarSnow", V(1.4, 0.25, 3.8), cf * CFrame.new(3.6, 2.45, 0), snow, Enum.Material.Snow, model)
	end
	Kit.contactShadow(cf, 9, 4.2, false, model)
	return model
end

-- Tapa de alcantarilla de hierro fundido
function Kit.manhole(position)
	Kit.cylinder("ManholeRim", 0.05, 3.5, CFrame.new(position + V(0, 0.025, 0)), RGB(72, 70, 66), Enum.Material.Metal, nil, true)
	Kit.cylinder("Manhole", 0.07, 3, CFrame.new(position + V(0, 0.035, 0)), RGB(46, 44, 42), Enum.Material.DiamondPlate, nil, true)
end

-- Rejilla de desagüe junto a un bordillo
function Kit.drain(cf)
	Kit.deco("DrainFrame", V(3.2, 0.06, 1.6), cf * CFrame.new(0, 0.03, 0), RGB(60, 58, 55), Enum.Material.Metal)
	for i = -3, 3 do
		Kit.deco("DrainSlot", V(0.18, 0.07, 1.2), cf * CFrame.new(i * 0.4, 0.036, 0), RGB(14, 14, 16), Enum.Material.Metal)
	end
end

-- Mancha de aceite: discos oscuros semitransparentes con un brillo leve
function Kit.oilStain(position, size, seed)
	local rng = Random.new(seed or math.floor(position.X * 13 + position.Z * 3))
	for i = 1, 3 do
		local d = size * (i == 1 and 1 or rng:NextNumber(0.4, 0.7))
		local offset = i == 1 and V(0, 0, 0) or V(rng:NextNumber(-0.35, 0.35) * size, 0, rng:NextNumber(-0.35, 0.35) * size)
		local stain = Kit.cylinder("OilStain", 0.02, d, CFrame.new(position + offset + V(0, 0.012 + i * 0.002, 0)), RGB(18, 18, 20), Enum.Material.SmoothPlastic, nil, true)
		stain.Transparency = 0.55 + i * 0.08
		stain.Reflectance = 0.08
	end
end

-- Grieta en el suelo: segmentos finos en zigzag
function Kit.crack(position, length, seed)
	local rng = Random.new(seed or math.floor(position.X * 7 + position.Z * 17))
	local heading = rng:NextNumber(0, math.pi * 2)
	local point = position
	local segments = math.max(3, math.floor(length / 2.5))
	for i = 1, segments do
		heading += rng:NextNumber(-0.7, 0.7)
		local seg = length / segments
		local dir = V(math.cos(heading), 0, math.sin(heading))
		local width = 0.16 * (1 - i / (segments + 1)) + 0.05
		Kit.deco("Crack", V(seg + 0.1, 0.03, width), CFrame.lookAt(point + dir * (seg / 2) + V(0, 0.015, 0), point + dir * seg + V(0, 0.015, 0)) * CFrame.Angles(0, math.pi / 2, 0), RGB(28, 28, 30), Enum.Material.SmoothPlastic)
		point += dir * seg
	end
end

-- Juntas de dilatación de una losa de hormigón o asfalto: líneas oscuras cada `spacing` studs
function Kit.floorJoints(cf, length, width, spacing, color)
	color = color or RGB(40, 40, 42)
	for x = -length / 2 + spacing, length / 2 - spacing / 2, spacing do
		Kit.deco("Joint", V(0.15, 0.03, width), cf * CFrame.new(x, 0.015, 0), color, Enum.Material.SmoothPlastic)
	end
	for z = -width / 2 + spacing, width / 2 - spacing / 2, spacing do
		Kit.deco("Joint", V(length, 0.03, 0.15), cf * CFrame.new(0, 0.015, z), color, Enum.Material.SmoothPlastic)
	end
end

-- Marcas de neumático: dos franjas oscuras paralelas que hacen una curva suave
function Kit.tireMarks(cf, length, bend)
	bend = bend or 0.3
	local segments = 6
	local seg = length / segments
	local pose = cf
	for _ = 1, segments do
		pose = pose * CFrame.Angles(0, bend / segments, 0)
		for _, side in { -1.1, 1.1 } do
			local mark = Kit.deco("TireMark", V(0.7, 0.02, seg + 0.05), pose * CFrame.new(side, 0.011, -seg / 2), RGB(20, 20, 22), Enum.Material.SmoothPlastic)
			mark.Transparency = 0.6
		end
		pose = pose * CFrame.new(0, 0, -seg)
	end
end

---------------------------------------------------------------------------
-- Puntos especiales del modo de juego
---------------------------------------------------------------------------

-- Zona de reaparición del equipo con techo, muretes y SpawnLocations
function Kit.spawnArea(team, cf, style)
	style = style or {}
	local teamColor = team.Color.Color
	local light = teamColor:Lerp(Color3.new(1, 1, 1), 0.55)
	local floorColor = style.Floor or light
	-- (los colores del equipo se quedan puros, también en el estilo realista: así casan con los neones
	-- y las zonas de aparición y se reconoce de un vistazo de qué equipo es la base)
	local floor = block(team.Name .. "SpawnFloor", V(30, 0.4, 70), cf * CFrame.new(0, 0.2, 0), floorColor, style.FloorMaterial or Enum.Material.SmoothPlastic)
	floor.Color = floorColor
	for z = -30, 30, 10 do
		deco("FloorLine", V(30, 0.05, 0.3), cf * CFrame.new(0, 0.42, z), teamColor, Enum.Material.SmoothPlastic).Color = teamColor
	end
	local roofColor = style.Roof or RGB(235, 235, 240)
	local roof = block(team.Name .. "SpawnRoof", V(30, 1, 70), cf * CFrame.new(0, 16, 0), roofColor, style.RoofMaterial or Enum.Material.Concrete)
	-- (no se puede pisar: con el supersalto alguien podría subirse a acampar encima de la base enemiga;
	-- las balas sí lo siguen chocando)
	roof.CanCollide = false
	deco("RoofTrim", V(0.6, 0.5, 70.2), cf * CFrame.new(15, 15.4, 0), teamColor, Enum.Material.Neon)
	local banner = block("TeamBanner", V(0.6, 4, 28), cf * CFrame.new(15.2, 18.6, 0), teamColor, Enum.Material.SmoothPlastic)
	banner.Color = teamColor
	sign(banner, Enum.NormalId.Right, "EQUIPO " .. string.upper(team.Name), Color3.new(1, 1, 1))
	sign(banner, Enum.NormalId.Left, "EQUIPO " .. string.upper(team.Name), Color3.new(1, 1, 1))
	for _, z in { -34, 34 } do
		block("Pillar", V(2, 16, 2), cf * CFrame.new(14, 8, z), roofColor, Enum.Material.Concrete)
		deco("PillarStripe", V(2.1, 1, 2.1), cf * CFrame.new(14, 12, z), teamColor, Enum.Material.Neon)
	end
	for _, z in { -24, 0, 24 } do
		block("Cover", V(2, 4, 10), cf * CFrame.new(14, 2, z), teamColor, Enum.Material.SmoothPlastic).Color = teamColor
		deco("CoverTop", V(2.1, 0.3, 10.1), cf * CFrame.new(14, 4.05, z), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
	end
	for i, z in { -24, -8, 8, 24 } do
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = team.Name .. "Spawn" .. i
		spawn.Anchored = true
		spawn.Size = V(6, 1, 6)
		spawn.CFrame = cf * CFrame.new(-4, 0.5, z) * CFrame.Angles(0, -math.pi / 2, 0)
		spawn.TeamColor = team.Color
		spawn.BrickColor = team.Color
		spawn.Material = Enum.Material.Neon
		spawn.Neutral = false
		spawn.AllowTeamChangeOnTouch = false
		spawn.Duration = GameConfig.SpawnProtection
		spawn.Parent = Kit.folder
		local decal = spawn:FindFirstChildOfClass("Decal")
		if decal then
			decal:Destroy()
		end
	end
	local lamp = deco("SpawnLight", V(20, 0.2, 60), cf * CFrame.new(0, 15.4, 0), teamColor:Lerp(Color3.new(1, 1, 1), 0.7), Enum.Material.Neon)
	Kit.light(lamp, "SurfaceLight", teamColor:Lerp(Color3.new(1, 1, 1), 0.5), 16, 0.8, Enum.NormalId.Bottom)
end

-- Base de la bandera (Captura la bandera). Flags busca piezas "FlagBase" con el atributo Team.
function Kit.flagBase(team, cf)
	local teamColor = team.Color.Color
	local ring = deco("FlagBaseRing", V(0.3, 13, 13), cf * CFrame.new(0, 0.15, 0) * CFrame.Angles(0, 0, math.pi / 2), teamColor, Enum.Material.Neon)
	ring.Shape = Enum.PartType.Cylinder
	local pad = block("FlagBase", V(0.4, 11, 11), cf * CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.pi / 2), RGB(235, 235, 240), Enum.Material.Concrete)
	pad.Shape = Enum.PartType.Cylinder
	pad:SetAttribute("Team", team.Name)
	local inner = deco("FlagBaseInner", V(0.45, 4, 4), cf * CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.pi / 2), teamColor, Enum.Material.Neon)
	inner.Shape = Enum.PartType.Cylinder
	for i = 0, 3 do
		local angle = i * math.pi / 2 + math.pi / 4
		local offset = CFrame.new(math.cos(angle) * 7.5, 0, math.sin(angle) * 7.5)
		cylinder("Pylon", 2, 0.7, cf * offset * CFrame.new(0, 1, 0), RGB(230, 230, 235), Enum.Material.SmoothPlastic, nil, true)
		Kit.ball("PylonLight", 0.8, cf * offset * CFrame.new(0, 2.3, 0), teamColor, Enum.Material.Neon, true)
	end
	Kit.light(inner, "PointLight", teamColor, 16, 1.5)
	return pad
end

-- Calabaza de Halloween con cara iluminada (decoración del evento; se atraviesa)
function Kit.pumpkin(cf, scale)
	scale = scale or 1
	-- Esferas achatadas: una Ball de Roblox siempre es redonda, así que se usa una malla de esfera
	local function squashed(part)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = part
	end
	local body = deco("Pumpkin", V(3 * scale, 2.4 * scale, 3 * scale), cf * CFrame.new(0, 1.2 * scale, 0), RGB(255, 130, 20), Enum.Material.SmoothPlastic)
	squashed(body)
	for _, a in { 0, 60, 120 } do
		local rib = deco("PumpkinRib", V(0.6 * scale, 2.3 * scale, 3.06 * scale), cf * CFrame.new(0, 1.2 * scale, 0) * CFrame.Angles(0, rad(a), 0), RGB(230, 100, 10), Enum.Material.SmoothPlastic)
		squashed(rib)
	end
	Kit.cylinder("PumpkinStem", 0.6 * scale, 0.35 * scale, cf * CFrame.new(0, 2.5 * scale, 0), RGB(80, 120, 40), Enum.Material.SmoothPlastic, nil, true)
	-- Ojos y boca brillantes (hacia -Z del cf)
	for _, s in { -1, 1 } do
		deco("PumpkinEye", V(0.45 * scale, 0.4 * scale, 0.2 * scale), cf * CFrame.new(s * 0.5 * scale, 1.5 * scale, -1.42 * scale) * CFrame.Angles(0, 0, rad(s * 20)), RGB(255, 220, 90), Enum.Material.Neon)
	end
	local mouth = deco("PumpkinMouth", V(1.1 * scale, 0.25 * scale, 0.2 * scale), cf * CFrame.new(0, 0.85 * scale, -1.45 * scale), RGB(255, 220, 90), Enum.Material.Neon)
	Kit.light(mouth, "PointLight", RGB(255, 160, 60), 8 * scale, 0.8)
	return body
end

-- Muñeco de nieve (decoración del evento de Navidad): tres bolas, ojos de carbón, nariz de
-- zanahoria, bufanda y sombrero de copa
function Kit.snowman(cf, scale)
	scale = scale or 1
	local snow = RGB(245, 248, 255)
	Kit.ball("SnowmanBase", 3.2 * scale, cf * CFrame.new(0, 1.5 * scale, 0), snow, Enum.Material.SmoothPlastic, true)
	Kit.ball("SnowmanBody", 2.4 * scale, cf * CFrame.new(0, 3.4 * scale, 0), snow, Enum.Material.SmoothPlastic, true)
	local headCf = cf * CFrame.new(0, 4.95 * scale, 0)
	Kit.ball("SnowmanHead", 1.7 * scale, headCf, snow, Enum.Material.SmoothPlastic, true)
	for _, s in { -1, 1 } do
		Kit.ball("SnowmanEye", 0.22 * scale, headCf * CFrame.new(s * 0.3 * scale, 0.2 * scale, -0.75 * scale), RGB(25, 25, 30), Enum.Material.SmoothPlastic, true)
	end
	deco("SnowmanNose", V(0.18 * scale, 0.18 * scale, 0.7 * scale), headCf * CFrame.new(0, 0, -1.05 * scale), RGB(255, 130, 30), Enum.Material.SmoothPlastic)
	for i = 1, 3 do
		Kit.ball("SnowmanButton", 0.22 * scale, cf * CFrame.new(0, (2.8 + i * 0.4) * scale, -1.12 * scale), RGB(25, 25, 30), Enum.Material.SmoothPlastic, true)
	end
	Kit.cylinder("SnowmanScarf", 0.35 * scale, 1.75 * scale, cf * CFrame.new(0, 4.25 * scale, 0), RGB(220, 40, 50), Enum.Material.Fabric, nil, true)
	deco("SnowmanScarfTail", V(0.35 * scale, 1 * scale, 0.12 * scale), cf * CFrame.new(0.45 * scale, 3.8 * scale, -0.8 * scale), RGB(220, 40, 50), Enum.Material.Fabric)
	Kit.cylinder("SnowmanHatBrim", 0.12 * scale, 1.9 * scale, headCf * CFrame.new(0, 0.75 * scale, 0), RGB(25, 25, 30), Enum.Material.SmoothPlastic, nil, true)
	Kit.cylinder("SnowmanHat", 1 * scale, 1.15 * scale, headCf * CFrame.new(0, 1.3 * scale, 0), RGB(25, 25, 30), Enum.Material.SmoothPlastic, nil, true)
	Kit.cylinder("SnowmanHatBand", 0.2 * scale, 1.18 * scale, headCf * CFrame.new(0, 0.95 * scale, 0), RGB(220, 40, 50), Enum.Material.SmoothPlastic, nil, true)
end

-- Plataforma de salto: al pisarla te lanza hacia arriba (el cliente lo hace, ver JumpPads).
-- power = velocidad vertical (75 ≈ 14 studs de altura). Para subir a cornisas y a lo alto.
function Kit.jumpPad(position, power, color)
	color = color or RGB(80, 230, 255)
	local ring = Kit.cylinder("JumpPadRing", 0.4, 7.6, CFrame.new(position + V(0, 0.2, 0)), RGB(250, 250, 255), Enum.Material.SmoothPlastic)
	ring:SetAttribute("JumpPad", power or 75) -- también lanza si pisas el borde
	local pad = Kit.cylinder("JumpPad", 0.5, 6, CFrame.new(position + V(0, 0.3, 0)), color, Enum.Material.Neon)
	pad:SetAttribute("JumpPad", power or 75)
	local sparks = Instance.new("ParticleEmitter")
	sparks.Name = "JumpPadSparks"
	sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparks.Color = ColorSequence.new(color)
	sparks.LightEmission = 1
	sparks.Size = NumberSequence.new(0.6, 0)
	sparks.Lifetime = NumberRange.new(0.6, 1)
	sparks.Rate = 8
	sparks.Speed = NumberRange.new(8, 12)
	sparks.SpreadAngle = Vector2.new(12, 12)
	sparks.EmissionDirection = Enum.NormalId.Right -- el eje X del cilindro es el vertical: suben
	sparks.Parent = pad
	return pad
end

-- Punto de aparición para "Todos contra todos" y "Escalada" (invisible)
function Kit.ffaSpawn(position)
	local p = deco("FFASpawn", V(2, 1, 2), CFrame.new(position + V(0, 0.5, 0)), C.White, Enum.Material.SmoothPlastic)
	p.Transparency = 1
	return p
end

-- Puesto de vigilancia para los bots tiradores (ventana, azotea, torre): se apostan ahí mirando
-- hacia look. No es un punto de aparición.
function Kit.botSpot(position, look)
	local p = deco("BotSpot", V(1, 1, 1), CFrame.new(position + V(0, 0.5, 0)), C.White, Enum.Material.SmoothPlastic)
	p.Transparency = 1
	p:SetAttribute("Look", look)
	return p
end

-- Sitio de la bomba (Buscar y destruir): letra "A" o "B" y qué equipo lo defiende (1 o 2, el de
-- GameConfig.Teams). Cada equipo defiende los dos sitios de su mitad.
function Kit.bombSite(position, letter, defender)
	local p = deco("BombSite", V(1, 1, 1), CFrame.new(position + V(0, 0.5, 0)), C.White, Enum.Material.SmoothPlastic)
	p.Transparency = 1
	p:SetAttribute("Letter", letter)
	p:SetAttribute("Defender", defender)
	p:SetAttribute("Radius", 7)
	-- La letra pintada en el suelo, como en los mapas de los shooters (se ve en todos los modos)
	local floorY = position.Y
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { Kit.folder, workspace.Terrain }
	local hit = workspace:Raycast(position + V(0, 2, 0), V(0, -5, 0), params)
	if hit then
		floorY = hit.Position.Y
	end
	local paint = deco("SiteLetter", V(7, 0.05, 7), CFrame.new(position.X, floorY + 0.04, position.Z), C.White, Enum.Material.SmoothPlastic)
	paint.Transparency = 1
	paint.CastShadow = false
	local gui = sign(paint, Enum.NormalId.Top, letter, Color3.fromRGB(205, 58, 40), Color3.fromRGB(205, 58, 40))
	gui.LightInfluence = 1
	local label = gui:FindFirstChildOfClass("TextLabel")
	if label then
		label.Font = Enum.Font.GothamBlack
		label.TextTransparency = 0.12
		label.TextStrokeTransparency = 1
	end
	return p
end

-- Zona de control (modo "Zona"). order = orden de rotación.
function Kit.zone(position, radius, order)
	local z = deco("HardpointZone", V(0.3, radius * 2, radius * 2), CFrame.new(position + V(0, 0.15, 0)) * CFrame.Angles(0, 0, math.pi / 2), C.White, Enum.Material.SmoothPlastic)
	z.Shape = Enum.PartType.Cylinder
	z.Transparency = 1
	z:SetAttribute("Order", order)
	z:SetAttribute("Radius", radius)
	return z
end

-- Muros exteriores invisibles (y techo) para que nadie se salga
-- Muros y techo invisibles. Van en la carpeta Map.Boundary, que los disparos ignoran
-- (CanQuery = false no sirve en piezas que colisionan, así que se excluyen en cada raycast).
function Kit.bounds(length, width, height)
	local folder = Kit.folder:FindFirstChild("Boundary") or Instance.new("Folder")
	folder.Name = "Boundary"
	folder.Parent = Kit.folder
	local function wall(size, cf)
		local w = block("Boundary", size, cf, Color3.new(1, 1, 1), nil, folder)
		w.Transparency = 1
		w.CastShadow = false
	end
	wall(V(length, height, 4), CFrame.new(0, height / 2, width / 2 + 2))
	wall(V(length, height, 4), CFrame.new(0, height / 2, -width / 2 - 2))
	wall(V(4, height, width), CFrame.new(length / 2 + 2, height / 2, 0))
	wall(V(4, height, width), CFrame.new(-length / 2 - 2, height / 2, 0))
	wall(V(length, 1, width), CFrame.new(0, height, 0))
end

---------------------------------------------------------------------------
-- Iluminación por mapa
---------------------------------------------------------------------------

-- Colores por defecto de los materiales del terreno (se restauran al cambiar de mapa)
local TERRAIN_DEFAULTS = {
	Grass = RGB(106, 127, 63),
	LeafyGrass = RGB(115, 132, 74),
	Mud = RGB(58, 46, 36),
	Ground = RGB(102, 92, 59),
	Snow = RGB(195, 199, 218),
	Glacier = RGB(101, 176, 234),
	Rock = RGB(102, 108, 111),
	Sand = RGB(143, 126, 95),
	Sandstone = RGB(137, 90, 71),
	Slate = RGB(63, 127, 107),
	Pavement = RGB(148, 148, 140),
}

-- Hierba y hojas más vivas en estilo Cartoon
local CARTOON_TERRAIN = {
	Grass = RGB(80, 175, 70),
	LeafyGrass = RGB(66, 150, 58),
	Ground = RGB(150, 120, 80),
}

local function ensure(className, parent)
	parent = parent or Lighting
	local inst = parent:FindFirstChildOfClass(className)
	if not inst then
		inst = Instance.new(className)
		inst.Parent = parent
	end
	return inst
end

-- Estilo Cartoon: luz más suave y clara (sombras rellenas), menos neblina, sin deslumbramiento y
-- más saturación; el ambiente de cada mapa (hora, color del cielo) se mantiene
local function cartoonize(preset)
	local p = table.clone(preset)
	local clock = p.ClockTime or 14
	local night = clock < 6 or clock > 18.6
	p.Ambient = (p.Ambient or RGB(60, 62, 72)):Lerp(night and RGB(70, 70, 105) or RGB(125, 125, 145), 0.55)
	p.OutdoorAmbient = (p.OutdoorAmbient or RGB(125, 128, 140)):Lerp(night and RGB(90, 90, 135) or RGB(170, 170, 190), 0.55)
	p.ShadowSoftness = 0.3
	if not night then
		p.Brightness = math.max(p.Brightness or 3, 3)
	end
	local a = table.clone(p.Atmosphere or {})
	a.Density = math.min(a.Density or 0.3, 0.26)
	a.Haze = math.min(a.Haze or 1.4, 0.6)
	a.Glare = 0
	p.Atmosphere = a
	local c = table.clone(p.Color or {})
	c.Saturation = (c.Saturation or 0.1) + 0.12
	c.Contrast = 0.06
	c.Brightness = (c.Brightness or 0.02) + 0.02
	p.Color = c
	local b = table.clone(p.Bloom or {})
	b.Intensity = math.min(b.Intensity or 0.8, 0.45)
	p.Bloom = b
	p.Clouds = math.max(p.Clouds or 0.55, 0.6)
	p.SunRays = math.min(p.SunRays or 0.06, 0.05)
	local terrain = {}
	for name, color in TERRAIN_DEFAULTS do
		terrain[name] = Kit.vivid((p.TerrainColors and p.TerrainColors[name]) or CARTOON_TERRAIN[name] or color)
	end
	p.TerrainColors = terrain
	return p
end

-- Estilo realista en mapas pensados para Cartoon: luz más contrastada (sombras más oscuras y nítidas),
-- color natural (menos tono pastel en el ambiente y la neblina), neblina y brillo del sol de verdad,
-- y hierba y tierra de colores naturales. Se respeta el carácter de cada mapa: la hora, las sombras
-- azuladas de la nieve, el aire limpio de la Luna, los pétalos rosas, la nieve blanca y el brillo de
-- los neones de noche (que además se aclara un poco para que se vea bien en el móvil).
local function neutralize(color, amount)
	local h, s, v = color:ToHSV()
	return Color3.fromHSV(h, s * (1 - amount), v)
end

-- Que el color tenga al menos este brillo (el canal más alto), sin cambiar su tono
local function atLeast(color, minimum)
	local top = math.max(color.R, color.G, color.B) * 255
	if top >= minimum or top <= 0 then
		return color
	end
	local k = minimum / top
	return Color3.new(math.min(1, color.R * k), math.min(1, color.G * k), math.min(1, color.B * k))
end

local SNOWY = { Snow = true, Ice = true, Glacier = true }

local function realize(preset)
	local p = table.clone(preset)
	local clock = p.ClockTime or 14
	-- (el atardecer y el anochecer cuentan como noche: sin brillo del sol forzado)
	local night = clock < 6.2 or clock > 17.8
	p.Ambient = neutralize(p.Ambient or RGB(60, 62, 72), 0.35)
		:Lerp(night and RGB(44, 46, 60) or RGB(70, 72, 82), night and 0.25 or 0.3)
	p.OutdoorAmbient = neutralize(p.OutdoorAmbient or RGB(125, 128, 140), 0.35)
		:Lerp(night and RGB(70, 74, 98) or RGB(120, 122, 132), night and 0.25 or 0.3)
	if night then
		p.Ambient = atLeast(p.Ambient, 50)
		p.OutdoorAmbient = atLeast(p.OutdoorAmbient, 80)
	end
	p.ShadowSoftness = math.min(p.ShadowSoftness or 0.12, 0.15)
	local a = table.clone(p.Atmosphere or {})
	-- (si el mapa pide un aire muy limpio, como la Luna, se respeta)
	local thin = (a.Density or 0.3) < 0.2
	if not thin then
		a.Density = math.max(a.Density or 0.3, 0.3)
		a.Haze = math.max(a.Haze or 1.4, 1.2)
	end
	-- (de noche, sin aire o con el cielo cubierto —tormenta, niebla— no hay brillo de sol)
	local overcast = (p.Clouds or 0) >= 0.85
	a.Glare = (night or thin or overcast) and (a.Glare or 0) or math.max(a.Glare or 0.3, 0.25)
	if a.Color then
		a.Color = neutralize(a.Color, 0.4)
	end
	if a.Decay then
		a.Decay = neutralize(a.Decay, 0.4)
	end
	p.Atmosphere = a
	local c = table.clone(p.Color or {})
	c.Saturation = math.min(c.Saturation or 0.05, night and 0.12 or 0.05)
	c.Contrast = math.max(c.Contrast or 0.12, 0.12)
	c.Brightness = math.min(c.Brightness or 0, 0.02)
	if c.Tint then
		c.Tint = neutralize(c.Tint, 0.5)
	end
	p.Color = c
	-- Brillo: de día contenido (el sol no deslumbra como en un dibujo); de noche se deja que los
	-- neones brillen
	local b = table.clone(p.Bloom or {})
	b.Intensity = math.min(b.Intensity or 0.6, night and 0.9 or 0.6)
	b.Threshold = math.max(b.Threshold or 1.6, night and 1.35 or 1.6)
	p.Bloom = b
	-- Terreno: los verdes muy vivos van hacia el tono natural; lo demás pensado a propósito (pétalos,
	-- arena, roca) solo se apaga un poco, y la nieve y el hielo se quedan como están
	local terrain = {}
	for name, color in TERRAIN_DEFAULTS do
		local custom = p.TerrainColors and p.TerrainColors[name]
		if not custom then
			terrain[name] = color
		elseif SNOWY[name] then
			terrain[name] = custom
		else
			local h, sat = custom:ToHSV()
			if sat > 0.25 and h > 0.12 and h < 0.45 then
				terrain[name] = neutralize(custom, 0.3):Lerp(color, 0.35)
			else
				terrain[name] = Kit.natural(custom)
			end
		end
	end
	p.TerrainColors = terrain
	return p
end
Kit.realize = realize

-- Luz de esta partida: a veces sale otra hora del día del mapa (como las versiones de los mapas en
-- los shooters de móvil). map.LightingVariants = { { Name = "Atardecer", Chance = 0.3, ...cambios } }.
-- Deja el nombre de la variante en Kit.Variant (y el mapa lo guarda en su atributo Variant).
function Kit.pickLighting(map)
	Kit.Variant, Kit.Weather = nil, nil
	for _, variant in map.LightingVariants or {} do
		if math.random() < (variant.Chance or 0.3) then
			local preset = table.clone(map.Lighting)
			for key, value in variant do
				if key ~= "Name" and key ~= "Chance" and key ~= "Weather" then
					preset[key] = value
				end
			end
			Kit.Variant = variant.Name
			Kit.Weather = variant.Weather -- ("Rain": lluvia y truenos en el cliente, ver Ambience)
			return preset
		end
	end
	return map.Lighting
end

-- preset: tabla con ClockTime, Brightness, Ambient, OutdoorAmbient, Atmosphere{...}, Color{...}, Bloom{...}, Clouds
function Kit.applyLighting(preset)
	-- Tono de los grises de este mapa (se usa al crear las piezas, que van después)
	local neutral = preset.CartoonNeutral
	Kit.Neutral = type(neutral) == "table" and { Hue = neutral.Hue or 0.68, Sat = neutral.Sat or 0.16 } or { Hue = 0.68, Sat = 0.16 }
	if Kit.Cartoon then
		preset = cartoonize(preset)
	elseif not Kit.Designed then
		preset = realize(preset)
	end
	Lighting.ClockTime = preset.ClockTime or 14
	Lighting.GeographicLatitude = preset.Latitude or 35
	Lighting.Brightness = preset.Brightness or 3
	Lighting.ExposureCompensation = preset.Exposure or 0
	Lighting.Ambient = preset.Ambient or RGB(60, 62, 72)
	Lighting.OutdoorAmbient = preset.OutdoorAmbient or RGB(125, 128, 140)
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = preset.ShadowSoftness or 0.12 -- sombras de sol nítidas pero no duras
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = Kit.Cartoon and 0.5 or 1 -- en Cartoon, menos brillo de plástico
	-- Viento: mueve la hierba del terreno, las nubes y las partículas con WindAffectsDrag
	workspace.GlobalWind = preset.Wind or V(4, 0, 2)

	local a = preset.Atmosphere or {}
	local atmosphere = ensure("Atmosphere")
	atmosphere.Density = a.Density or 0.3
	atmosphere.Offset = a.Offset or 0.25
	atmosphere.Color = a.Color or RGB(199, 220, 255)
	atmosphere.Decay = a.Decay or RGB(106, 120, 150)
	atmosphere.Glare = a.Glare or 0.3
	atmosphere.Haze = a.Haze or 1.4

	local c = preset.Color or {}
	local cc = ensure("ColorCorrectionEffect")
	cc.Saturation = c.Saturation or 0.1
	cc.Contrast = c.Contrast or 0.15
	cc.Brightness = c.Brightness or 0.02
	cc.TintColor = c.Tint or RGB(255, 250, 245)

	local b = preset.Bloom or {}
	local bloom = ensure("BloomEffect")
	bloom.Intensity = b.Intensity or 0.8
	bloom.Size = b.Size or 24
	bloom.Threshold = b.Threshold or 2

	local rays = ensure("SunRaysEffect")
	rays.Intensity = preset.SunRays or 0.06
	rays.Spread = 0.6

	local sky = ensure("Sky")
	sky.StarCount = preset.Stars or 3000
	sky.SunAngularSize = preset.SunSize or 21
	sky.MoonAngularSize = preset.MoonSize or 11
	sky.CelestialBodiesShown = true

	local clouds = ensure("Clouds", workspace.Terrain)
	clouds.Cover = preset.Clouds or 0.55
	clouds.Density = Kit.Cartoon and 0.72 or 0.6 -- nubes más esponjosas en Cartoon
	clouds.Color = preset.CloudColor or RGB(255, 255, 255)

	-- Agua del terreno: color, reflejo, transparencia y olas de cada mapa
	local w = preset.Water or {}
	local terrain = workspace.Terrain
	terrain.WaterColor = w.Color or RGB(12, 84, 92)
	terrain.WaterReflectance = w.Reflectance or 1
	terrain.WaterTransparency = w.Transparency or 0.3
	terrain.WaterWaveSize = w.WaveSize or 0.15
	terrain.WaterWaveSpeed = w.WaveSpeed or 10

	-- Colores de los materiales del terreno (hierba, nieve, roca...) según el mapa
	for name, color in TERRAIN_DEFAULTS do
		local custom = preset.TerrainColors and preset.TerrainColors[name]
		pcall(function()
			terrain:SetMaterialColor(Enum.Material[name], custom or color)
		end)
	end
end

-- Suelo de terreno (en vez de una pieza): con Grass sale hierba 3D animada (Terrain.Decoration,
-- activada en default.project.json). La superficie queda exactamente en y = 0.
function Kit.terrainFloor(material, length, width)
	workspace.Terrain:FillBlock(CFrame.new(0, -2, 0), V(length, 4, width), material)
end

-- Cambia el material del terreno del suelo en una zona (caminos de barro, suelo bajo edificios...)
function Kit.terrainPatch(cf, size, material)
	workspace.Terrain:FillBlock(cf * CFrame.new(0, -2, 0), V(size.X, 4, size.Z), material)
end

-- Empieza un mapa nuevo: borra el anterior (y el agua/roca de Terrain). options.Realistic: este
-- mapa usa materiales y luz realistas aunque el juego esté en estilo Cartoon (mapas tipo CoD)
function Kit.Begin(name, options)
	Kit.Cartoon = GameConfig.VisualStyle ~= "Realista" and not (options and options.Realistic)
	-- (mapa hecho ya realista: su luz y sus colores se respetan tal cual)
	Kit.Designed = options ~= nil and options.Realistic == true
	local old = workspace:FindFirstChild("Map")
	if old then
		old:Destroy()
	end
	workspace.Terrain:Clear()
	local folder = Instance.new("Folder")
	folder.Name = "Map"
	folder:SetAttribute("Generated", true)
	folder:SetAttribute("MapName", name)
	folder:SetAttribute("Realistic", Kit.Cartoon == false or nil)
	folder.Parent = workspace
	Kit.folder = folder
	return folder
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">PlayerData</string>
            <string name="Source"><![CDATA[-- Datos persistentes del jugador (nivel, XP, monedas, skins, trajes, armas) guardados con DataStore,
-- y toda la economía: tienda con monedas, compras con Robux, VIP, recompensa diaria, cajas,
-- retos diarios y maestría de armas.
-- En Studio activa: Game Settings > Security > "Enable Studio Access to API Services".
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local PolicyService = game:GetService("PolicyService")
local GroupService = game:GetService("GroupService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.GameConfig)
local Skins = require(Shared.Skins)
local Weapons = require(Shared.Weapons)
local Outfits = require(Shared.Outfits)
local Ranks = require(Shared.Ranks)
local Shop = require(Shared.Shop)
local Friends = require(script.Parent.Friends)
local Badges = require(script.Parent.Badges)
local Challenges = require(Shared.Challenges)
local Mastery = require(Shared.Mastery)
local KillEffects = require(Shared.KillEffects)
local Charms = require(Shared.Charms)
local Sprays = require(Shared.Sprays)
local Titles = require(Shared.Titles)
local Remotes = require(Shared.Remotes)

local PlayerData = {}

-- Callbacks que otros módulos pueden asignar
PlayerData.OnSkinChanged = nil -- function(player, skinId)
PlayerData.OnOutfitChanged = nil -- function(player, outfitId)
PlayerData.OnLeaving = nil :: ((player: Player) -> ())? -- justo antes del guardado final al salir

local store
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("ShooterRobData_v1")
	end)
	if ok then
		store = result
	else
		warn("[PlayerData] DataStore no disponible, el progreso no se guardará:", result)
	end
end

local profiles = {}
local noSave = {} -- jugadores cuya carga falló: no sobrescribimos sus datos
local cratesRestricted = {} -- países donde no se permiten objetos aleatorios de pago

local STARTING_COINS = 250
local MAX_PURCHASE_LOG = 60
-- Bloqueo de sesión: un servidor "reserva" los datos del jugador mientras está dentro, para que otro
-- servidor no lea datos viejos y los sobrescriba (por ejemplo al cambiar rápido de servidor).
local LOCK_TIMEOUT = 600 -- si el servidor que tenía el bloqueo se cayó, a los 10 min se puede quitar
local LOCK_WAIT = 25 -- segundos máximos esperando a que el otro servidor suelte los datos
local SAVE_COOLDOWN = 7 -- Roblox permite ~1 escritura por clave cada 6 s

local saving = {} -- jugadores con un guardado en curso
local dirty = {} -- jugadores con cambios pendientes de guardar
local pendingPerk = {} -- [jugador] = true: la ventaja cambiada se aplica al reaparecer
local saveScheduled = {}

local function defaults()
	return {
		Level = 1,
		XP = 0,
		Coins = STARTING_COINS,
		Skins = { Default = true },
		EquippedSkin = "Default",
		Primary = "ARX27",
		Secondary = "Viper",
		Melee = "Knife", -- arma cuerpo a cuerpo elegida (Weapons.Melees)
		OwnedWeapons = {},
		Outfits = { Default = true },
		EquippedOutfit = "Default",
		ClaimedFree = {},
		ClaimedPremium = {},
		TotalKills = 0,
		Wins = 0,
		TotalDeaths = 0, -- estadísticas del perfil
		Matches = 0,
		BestStreak = 0,
		BestMatchKills = 0, -- récord de bajas en una partida (al batirlo, celebración en el resumen)
		Headshots = 0,
		RankPoints = 0, -- puntos de rango competitivo (ver Ranks)
		RankBest = 1, -- rango más alto alcanzado (sus premios ya se dieron)
		Premium = false,
		DailyStreak = 0,
		LastDailyDay = -1,
		LastPlayDay = -1,
		FirstWinDay = -1, -- día de la última "primera victoria del día"
		BonusLevel = 0, -- último nivel revisado para los premios de después del pase (0 = sin empezar)
		CratePity = 0, -- partidas seguidas sin caja sorpresa -- último día (Shop.DayNumber) en que entró: para el premio de regreso
		FreeCrates = 0,
		Purchases = {},
		KillEffects = { Default = true }, -- efectos de eliminación comprados
		EquippedKillEffect = "Default",
		Charms = { Default = true }, -- colgantes de arma comprados
		EquippedCharm = "Default",
		Sprays = { Default = true }, -- grafitis comprados (tecla J)
		EquippedSpray = "Default",
		Assists = 0, -- asistencias (ver Combat)
		RankSeason = "", -- temporada de rango de sus RP (ver Ranks.Seasons)
		SeasonBest = 0, -- mejor rango alcanzado en esta temporada (0 = aún no ha jugado de rango)
		ReferredBy = 0, -- quién le invitó (UserId), ver GameConfig.Referral
		Referrals = 0, -- amigos nuevos que entraron con su invitación y le dieron premio
		Titles = {}, -- títulos comprados (los ganados jugando salen de las estadísticas)
		EquippedTitle = "Novato",
		WeaponKills = {}, -- bajas con cada arma (maestría)
		WeaponCamos = {}, -- camuflaje de maestría elegido para cada arma
		Challenges = { Day = -1, List = {}, Rerolls = 0, Bonus = false },
		WeeklyChallenges = { Week = -1, List = {}, Bonus = false }, -- retos semanales
		StarterPack = false, -- ya compró el pack de inicio
		Bundles = {}, -- packs de temporada comprados ([Id] = true, ver Shop.Bundles)
		TutorialDone = false, -- ya vio la tarjeta de controles de la primera partida
		NewsSeen = 0, -- última versión de las novedades que ha visto (GameConfig.News)
		Achievements = {}, -- logros reclamados ([Id] = true)
		GroupReward = false, -- ya reclamó el premio del grupo (GameConfig.Group)
		EventProgress = { Id = "", Count = 0 }, -- caramelos del evento de temporada (ver Event)
		Revives = GameConfig.StartingRevives, -- "Revivir instantáneo" disponibles
		BoostXP = 0, -- segundos de juego que quedan de XP doble (Shop.Boosters)
		BoostCoins = 0, -- segundos de juego que quedan de monedas dobles
		Gifts = { Day = -1, Claimed = 0, Seconds = 0 }, -- regalos por tiempo jugado de hoy (ver Gifts)
		WheelDay = -1, -- último día con giro gratis de la ruleta usado
		WheelSpins = 0, -- giros de ruleta comprados sin usar
		Settings = table.clone(GameConfig.DefaultSettings),
	}
end

---------------------------------------------------------------------------
-- Retos diarios
---------------------------------------------------------------------------

-- Reparte retos nuevos si ha cambiado el día
local function ensureChallenges(player, data)
	local today = Shop.DayNumber()
	local state = data.Challenges
	if type(state) ~= "table" or state.Day ~= today or type(state.List) ~= "table" then
		local list = {}
		for _, id in Challenges.Pick(today, player.UserId, data.Level, Challenges.PerDay) do
			table.insert(list, { Id = id, Progress = 0, Done = false })
		end
		state = { Day = today, List = list, Rerolls = 0, Bonus = false }
		data.Challenges = state
	end
	return state
end

-- Reparte retos semanales nuevos si ha empezado otra semana
local function ensureWeekly(player, data)
	local week = Challenges.WeekNumber(Shop.DayNumber())
	local state = data.WeeklyChallenges
	if type(state) ~= "table" or state.Week ~= week or type(state.List) ~= "table" then
		local list = {}
		for _, id in Challenges.Pick(week, player.UserId, data.Level, Challenges.WeeklyCount, nil, 17, Challenges.WeeklyPool) do
			table.insert(list, { Id = id, Progress = 0, Done = false })
		end
		state = { Week = week, List = list, Bonus = false }
		data.WeeklyChallenges = state
	end
	return state
end

local function entriesView(entries)
	local list = {}
	for _, entry in entries do
		local def = Challenges.Get(entry.Id)
		if def then
			table.insert(list, {
				Id = entry.Id,
				Text = def.Text,
				Goal = def.Goal,
				Progress = math.min(entry.Progress, def.Goal),
				Done = entry.Done,
				Coins = def.Coins,
				XP = def.XP,
			})
		end
	end
	return list
end

local function challengesView(player, data)
	local state = ensureChallenges(player, data)
	local weekly = ensureWeekly(player, data)
	local list = entriesView(state.List)
	return {
		List = list,
		RerollsLeft = math.max(0, Challenges.RerollsPerDay - (state.Rerolls or 0)),
		Bonus = state.Bonus == true,
		BonusCrates = Challenges.BonusCrates,
		Weekly = {
			List = entriesView(weekly.List),
			Bonus = weekly.Bonus == true,
			BonusCrates = Challenges.WeeklyBonusCrates,
			EndsAt = Challenges.WeekEndsAt(weekly.Week),
		},
	}
end

-- Skin con la que se ve un arma: el camuflaje de maestría elegido para ella (si lo tiene) o la skin general
function PlayerData.SkinFor(data, weaponName)
	if not data then
		return "Default"
	end
	local camo = data.WeaponCamos and data.WeaponCamos[weaponName]
	if camo and Mastery.HasCamo(data.WeaponKills and data.WeaponKills[weaponName] or 0, camo) then
		return camo
	end
	return data.EquippedSkin or "Default"
end

local function key(player)
	return "u_" .. player.UserId
end

local function publicView(player, data)
	-- (la temporada en curso; tras la última de Ranks.Seasons no se muestra)
	local season = Ranks.CurrentSeason()
	local seasonView = os.time() < season.EndsAt and data.RankSeason == season.Id and season or nil
	return {
		Level = data.Level,
		XP = data.XP,
		XPPerLevel = GameConfig.XPPerLevel,
		Coins = data.Coins,
		Skins = data.Skins,
		EquippedSkin = data.EquippedSkin,
		Primary = data.Primary,
		Secondary = data.Secondary,
		Melee = data.Melee,
		OwnedWeapons = data.OwnedWeapons,
		Outfits = data.Outfits,
		EquippedOutfit = data.EquippedOutfit,
		TotalKills = data.TotalKills,
		Wins = data.Wins,
		TotalDeaths = data.TotalDeaths,
		Assists = data.Assists,
		Matches = data.Matches,
		BestStreak = data.BestStreak,
		Headshots = data.Headshots,
		RankPoints = data.RankPoints,
		Premium = data.Premium,
		VIP = player:GetAttribute("VIP") == true,
		DailyStreak = data.DailyStreak,
		DailyAvailable = data.LastDailyDay ~= Shop.DayNumber(),
		-- Día que tocaría al reclamar hoy (si se saltó un día, la racha vuelve al 1)
		DailyNext = (data.LastDailyDay == Shop.DayNumber() - 1) and (data.DailyStreak % #Shop.DailyRewards + 1) or 1,
		FirstWinAvailable = data.FirstWinDay ~= Shop.DayNumber(),
		FreeCrates = data.FreeCrates,
		CratesRestricted = cratesRestricted[player] == true,
		Day = Shop.DayNumber(),
		WeaponKills = data.WeaponKills,
		WeaponCamos = data.WeaponCamos,
		KillEffects = data.KillEffects,
		EquippedKillEffect = data.EquippedKillEffect,
		Charms = data.Charms,
		EquippedCharm = data.EquippedCharm,
		Sprays = data.Sprays,
		EquippedSpray = data.EquippedSpray,
		Titles = data.Titles,
		EquippedTitle = data.EquippedTitle,
		Settings = data.Settings,
		Revives = data.Revives,
		BoostXP = data.BoostXP,
		BoostCoins = data.BoostCoins,
		WheelFree = data.WheelDay ~= Shop.DayNumber(),
		WheelSpins = data.WheelSpins,
		-- (si sus datos no se guardan, no se le enseña el tutorial: probablemente ya lo vio)
		TutorialDone = data.TutorialDone == true or noSave[player] == true,
		NewsSeen = data.NewsSeen,
		Achievements = data.Achievements,
		GroupReward = data.GroupReward == true,
		RankBest = data.RankBest,
		RankSeasonName = seasonView and seasonView.Name or nil,
		RankSeasonEndsAt = seasonView and seasonView.EndsAt or nil,
		EventCandy = (type(data.EventProgress) == "table" and data.EventProgress.Id == GameConfig.Event.Id) and data.EventProgress.Count or 0,
		StarterPackAvailable = Shop.StarterPack.ProductId ~= 0 and not data.StarterPack and data.Level <= Shop.StarterPack.MaxLevel,
		BundlesAvailable = (function()
			local list = {}
			for _, bundle in Shop.Bundles do
				if Shop.BundleOnSale(bundle) and not data.Bundles[bundle.Id] then
					table.insert(list, bundle.Id)
				end
			end
			return list
		end)(),
		Challenges = challengesView(player, data),
	}
end

local function sendUpdate(player)
	local data = profiles[player]
	if data then
		Remotes.DataUpdate:FireClient(player, publicView(player, data))
	end
end
PlayerData.SendUpdate = sendUpdate

function PlayerData.GetLeaderstats(player)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		for _, name in { "Bajas", "Muertes", "Nivel" } do
			local value = Instance.new("IntValue")
			value.Name = name
			value.Parent = stats
		end
		stats.Parent = player
	end
	return stats
end

local function grant(player, data, reward)
	if not reward then
		return
	end
	if reward.Type == "Skin" then
		data.Skins[reward.Id] = true
		Remotes.Notify:FireClient(player, "Unlock", "¡Skin desbloqueada: " .. Skins.Get(reward.Id).Name .. "!")
	elseif reward.Type == "Outfit" then
		data.Outfits[reward.Id] = true
		Remotes.Notify:FireClient(player, "Unlock", "¡Traje desbloqueado: " .. Outfits.Get(reward.Id).Name .. "!")
	elseif reward.Type == "KillEffect" then
		data.KillEffects[reward.Id] = true
		Remotes.Notify:FireClient(player, "Unlock", "¡Efecto desbloqueado: " .. KillEffects.Get(reward.Id).Name .. "!")
	elseif reward.Type == "Crate" then
		data.FreeCrates += reward.Amount or 1
	elseif reward.Type == "Coins" then
		data.Coins += reward.Amount
	end
end

-- Entrega todas las recompensas del pase hasta el nivel actual que aún no se hayan reclamado
local function grantTierRewards(player)
	local data = profiles[player]
	if not data then
		return
	end
	local maxTier = math.min(data.Level, #GameConfig.BattlePass)
	for tier = 1, maxTier do
		local t = GameConfig.BattlePass[tier]
		local k = tostring(tier)
		if not data.ClaimedFree[k] then
			data.ClaimedFree[k] = true
			grant(player, data, t.Free)
		end
		if data.Premium and not data.ClaimedPremium[k] then
			data.ClaimedPremium[k] = true
			grant(player, data, t.Premium)
		end
	end
	-- Tras el pase: premio cada pocos niveles (GameConfig.PostPassRewards). BonusLevel = último nivel
	-- ya revisado; 0 = sin empezar (los que ya estaban por encima del pase empiezan a contar desde ahora)
	local bonus = GameConfig.PostPassRewards
	local passLevels = #GameConfig.BattlePass
	if bonus then
		local checked = tonumber(data.BonusLevel) or 0
		if checked <= 0 then
			data.BonusLevel = math.max(data.Level, passLevels)
		elseif data.Level > checked then
			for level = checked + 1, data.Level do
				if level > passLevels and (level - passLevels) % bonus.Every == 0 then
					data.Coins += bonus.Coins
					data.FreeCrates += bonus.Crates
					Remotes.Notify:FireClient(player, "Challenge", "⭐ ¡Nivel " .. level .. "! +" .. bonus.Coins .. " 🪙 y " .. bonus.Crates .. (bonus.Crates == 1 and " caja" or " cajas"))
				end
			end
			data.BonusLevel = data.Level
		end
	end
end

local function ownsPass(player, passId)
	if not passId or passId == 0 then
		return false
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
	end)
	return ok and owns
end

local function checkPolicy(player)
	local ok, info = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(player)
	end)
	-- Si no podemos comprobarlo, por seguridad tratamos las cajas de pago como restringidas
	cratesRestricted[player] = not ok or (info and info.ArePaidRandomItemsRestricted == true)
end

local function load(player)
	local data
	if store then
		local loaded, result = false, nil
		local started = os.clock()
		local attempt = 0
		while player.Parent do
			attempt += 1
			local locked = false
			local force = os.clock() - started > LOCK_WAIT
			loaded, result = pcall(function()
				return store:UpdateAsync(key(player), function(old)
					local lock = type(old) == "table" and old.SessionLock
					if type(lock) == "table" and lock.Job ~= game.JobId and not force and os.time() - (lock.Time or 0) < LOCK_TIMEOUT then
						locked = true
						return nil -- otro servidor aún tiene los datos: no tocamos nada
					end
					old = type(old) == "table" and old or {}
					old.SessionLock = { Job = game.JobId, Time = os.time() }
					return old
				end)
			end)
			if loaded and not locked then
				break
			end
			if not loaded and attempt >= 3 then
				break
			end
			task.wait(loaded and 3 or attempt)
		end
		if loaded then
			data = result
		else
			warn("[PlayerData] No se pudieron cargar los datos de", player.Name, result)
			noSave[player] = true
		end
	end

	local merged = defaults()
	local isNew = type(data) ~= "table" or data.Level == nil
	if not isNew then
		for k, v in data do
			merged[k] = v
		end
		if data.Coins == nil then
			merged.Coins = 0
		end
	end
	if type(merged.WeaponKills) ~= "table" then
		merged.WeaponKills = {}
	end
	if type(merged.WeaponCamos) ~= "table" then
		merged.WeaponCamos = {}
	end
	if type(merged.Revives) ~= "number" or merged.Revives ~= merged.Revives then
		merged.Revives = GameConfig.StartingRevives
	end
	if type(merged.Settings) ~= "table" then
		merged.Settings = table.clone(GameConfig.DefaultSettings)
	end
	if type(merged.Gifts) ~= "table" or type(merged.Gifts.Claimed) ~= "number" or type(merged.Gifts.Seconds) ~= "number" then
		merged.Gifts = { Day = -1, Claimed = 0, Seconds = 0 }
	end
	-- Antes la calidad por defecto era "Alta" (daba lag en equipos modestos): pasa a "Auto" una vez
	if merged.Settings.QualityVersion ~= GameConfig.DefaultSettings.QualityVersion then
		merged.Settings.Quality = "Auto"
		merged.Settings.QualityVersion = GameConfig.DefaultSettings.QualityVersion
	end
	-- Ajustes nuevos que aún no tenía guardados (después de la migración de calidad)
	for key, value in GameConfig.DefaultSettings do
		if merged.Settings[key] == nil then
			merged.Settings[key] = value
		end
	end
	if type(merged.KillEffects) ~= "table" then
		merged.KillEffects = { Default = true }
	end
	if not KillEffects.List[merged.EquippedKillEffect] or not merged.KillEffects[merged.EquippedKillEffect] then
		merged.EquippedKillEffect = "Default"
	end
	-- Nombres de armas antiguos -> nuevos
	merged.Primary = Weapons.Legacy[merged.Primary] or merged.Primary
	merged.Secondary = Weapons.Legacy[merged.Secondary] or merged.Secondary
	if not Skins.List[merged.EquippedSkin] or not merged.Skins[merged.EquippedSkin] then
		merged.EquippedSkin = "Default"
	end
	if not Outfits.List[merged.EquippedOutfit] or not merged.Outfits[merged.EquippedOutfit] then
		merged.EquippedOutfit = "Default"
	end
	if not table.find(Weapons.Primaries, merged.Primary) or not Weapons.IsUnlocked(merged.Primary, merged) then
		merged.Primary = "ARX27"
	end
	if not table.find(Weapons.Secondaries, merged.Secondary) or not Weapons.IsUnlocked(merged.Secondary, merged) then
		merged.Secondary = Weapons.Secondary
	end
	if not table.find(Weapons.Melees, merged.Melee) or not Weapons.IsUnlocked(merged.Melee, merged) then
		merged.Melee = Weapons.Melee
	end
	if type(merged.RankPoints) ~= "number" or merged.RankPoints ~= merged.RankPoints then
		merged.RankPoints = 0
	end
	if type(merged.Charms) ~= "table" then
		merged.Charms = { Default = true }
	end
	if not Charms.List[merged.EquippedCharm] or not merged.Charms[merged.EquippedCharm] then
		merged.EquippedCharm = "Default"
	end
	if type(merged.Achievements) ~= "table" then
		merged.Achievements = {}
	end
	if type(merged.Bundles) ~= "table" then
		merged.Bundles = {}
	end
	if merged.HalloweenBundle == true then
		merged.Bundles.Halloween = true -- (antes se guardaba aparte)
	end
	merged.HalloweenBundle = nil
	if type(merged.Titles) ~= "table" then
		merged.Titles = {}
	end
	if not Titles.List[merged.EquippedTitle] then
		merged.EquippedTitle = "Novato"
	end
	if type(merged.Sprays) ~= "table" then
		merged.Sprays = { Default = true }
	end
	-- (el de VIP se comprueba al pintar: el atributo VIP aún no está puesto al cargar)
	local equippedSpray = Sprays.List[merged.EquippedSpray]
	if not equippedSpray or not (merged.Sprays[merged.EquippedSpray] or equippedSpray.VIPOnly) then
		merged.EquippedSpray = "Default"
	end
	merged.GroupReward = merged.GroupReward == true
	if type(merged.WheelSpins) ~= "number" or merged.WheelSpins < 0 then
		merged.WheelSpins = 0
	end
	if type(merged.WheelDay) ~= "number" then
		merged.WheelDay = -1
	end
	-- (los guardados de antes de existir RankBest: su rango actual)
	if type(merged.RankBest) ~= "number" or (not isNew and type(data) == "table" and data.RankBest == nil) then
		merged.RankBest = math.max(type(merged.RankBest) == "number" and merged.RankBest or 1, Ranks.Index(merged.RankPoints))
	end
	if type(merged.EventProgress) ~= "table" or type(merged.EventProgress.Count) ~= "number" then
		merged.EventProgress = { Id = "", Count = 0 }
	end
	-- Quien ya jugaba antes de existir el tutorial no lo ve
	-- Los nuevos no ven las novedades (ven la tarjeta de controles)
	if isNew or type(merged.NewsSeen) ~= "number" then
		merged.NewsSeen = isNew and GameConfig.ActiveNews().Version or 0
	end
	if not isNew and data.TutorialDone == nil and ((merged.Level or 1) > 1 or (merged.TotalKills or 0) > 0) then
		merged.TutorialDone = true
	end
	merged.Premium = merged.Premium or ownsPass(player, GameConfig.PremiumPassId)
	player:SetAttribute("VIP", ownsPass(player, Shop.VIPPassId))
	PlayerData.UpdatePremium(player)
	checkPolicy(player)

	if not player.Parent then
		noSave[player] = nil
		cratesRestricted[player] = nil
		return
	end
	-- Temporada de rango (premio de la que acabó mientras no jugaba; el aviso, cuando ya ve la pantalla)
	local seasonText = PlayerData.RollSeason(merged)
	if seasonText then
		task.delay(8, function()
			if player.Parent then
				Remotes.Notify:FireClient(player, "Big", seasonText)
			end
		end)
	end
	-- Premio de regreso (tras unos días sin jugar)
	local comebackText = PlayerData.RollComeback(merged)
	if comebackText then
		task.delay(seasonText and 12 or 8, function()
			if player.Parent then
				Remotes.Notify:FireClient(player, "Big", comebackText)
			end
		end)
	end
	profiles[player] = merged
	Badges.Check(player, merged)
	PlayerData.GetLeaderstats(player).Nivel.Value = merged.Level
	player:SetAttribute("Rank", Ranks.Index(merged.RankPoints))
	player:SetAttribute("Perk", math.floor((merged.Settings and merged.Settings.Perk) or 0)) -- (ventaja: la leen los demás sistemas)
	PlayerData.PublishTitle(player)
	grantTierRewards(player)
	if isNew and not noSave[player] then -- (si no se pudieron cargar sus datos, quizá no es nuevo)
		PlayerData.HandleReferral(player)
	end
	sendUpdate(player)
end

-- Invitación de un amigo (GameConfig.Referral): la invitación lleva "ref:<UserId>" en LaunchData.
-- Solo para jugadores nuevos y una vez; el que invitó cobra si está en este servidor.
function PlayerData.HandleReferral(player)
	local data = profiles[player]
	local config = GameConfig.Referral
	if not data or not config or (data.ReferredBy or 0) ~= 0 then
		return
	end
	local ok, joinData = pcall(player.GetJoinData, player)
	local launch = ok and type(joinData) == "table" and joinData.LaunchData
	local inviterId = type(launch) == "string" and tonumber(string.match(launch, "^ref:(%d+)$"))
	if not inviterId or inviterId == player.UserId or inviterId <= 0 then
		return
	end
	data.ReferredBy = inviterId
	dirty[player] = true
	local inviter = Players:GetPlayerByUserId(inviterId)
	local given = PlayerData.AddCoins(player, config.NewPlayerCoins or 0, false)
	Remotes.Notify:FireClient(player, "Big", "👥 ¡Te invitó " .. (inviter and inviter.DisplayName or "un amigo") .. "! +" .. given .. " 🪙")
	local inviterData = inviter and profiles[inviter]
	-- (cuentas recién creadas no dan premio al que invita: así no se abusa con cuentas de usar y tirar)
	if inviterData and (inviterData.Referrals or 0) < (config.MaxRewards or 0) and (player.AccountAge or 0) >= (config.MinAccountAge or 0) then
		inviterData.Referrals = (inviterData.Referrals or 0) + 1
		local bonus = PlayerData.AddCoins(inviter, config.InviterCoins or 0, false)
		dirty[inviter] = true
		Remotes.Notify:FireClient(inviter, "Big", "👥 ¡" .. player.DisplayName .. " entró con tu invitación! +" .. bonus .. " 🪙")
	end
end

-- Guarda los datos. release = true al salir el jugador: suelta el bloqueo de sesión.
local function save(player, release)
	local data = profiles[player]
	if not data or not store or noSave[player] then
		return false
	end
	-- Espera a que acabe otro guardado de este jugador (no pisar escrituras)
	local waited = 0
	while saving[player] and waited < 15 do
		task.wait(0.5)
		waited += 0.5
	end
	saving[player] = true
	dirty[player] = nil
	local stolen = false
	local ok, err = pcall(function()
		store:UpdateAsync(key(player), function(old)
			local lock = type(old) == "table" and old.SessionLock
			if type(lock) == "table" and lock.Job ~= game.JobId then
				stolen = true
				return nil -- otro servidor tiene ahora los datos: no los sobrescribimos
			end
			data.SessionLock = if release then nil else { Job = game.JobId, Time = os.time() }
			return data
		end)
	end)
	saving[player] = nil
	if not ok then
		warn("[PlayerData] Error al guardar", player.Name, err)
		dirty[player] = true
	elseif stolen then
		warn("[PlayerData] Otro servidor tiene los datos de", player.Name, "- no se guardan aquí")
		noSave[player] = true
		return false
	end
	return ok
end

-- Pide un guardado pronto, agrupando varios cambios seguidos en una sola escritura
local function requestSave(player)
	dirty[player] = true
	if saveScheduled[player] then
		return
	end
	saveScheduled[player] = true
	task.delay(SAVE_COOLDOWN, function()
		saveScheduled[player] = nil
		if dirty[player] and player.Parent then
			save(player)
		end
	end)
end

function PlayerData.Get(player)
	return profiles[player]
end

-- Espera a que los datos del jugador estén cargados (máx. timeout segundos)
function PlayerData.WaitFor(player, timeout)
	local start = os.clock()
	while not profiles[player] and player.Parent and os.clock() - start < (timeout or 15) do
		task.wait(0.1)
	end
	return profiles[player]
end

-- Potenciador comprado activo (Shop.Boosters) para "XP" o "Coins"
-- (solo cuenta en partida: lo que se reclama desde la portada, como la recompensa diaria, no se dobla)
local function boosterMultiplier(player, data, kind)
	if player:GetAttribute("InMenu") ~= false then
		return 1
	end
	for _, booster in Shop.Boosters do
		if booster.Kind == kind and (tonumber(data[booster.Field]) or 0) > 0 then
			return booster.Multiplier
		end
	end
	return 1
end

-- VIP (x2), Roblox Premium (x1,2) y bonus de amigos en el servidor (+10% por amigo, ver Friends)
local featuredBonus -- (definida más abajo, junto a xpBoost)
local function multiplier(player)
	local vip = player:GetAttribute("VIP") and Shop.VIPMultiplier or 1
	local premium = player:GetAttribute("RobloxPremium") and GameConfig.RobloxPremium and GameConfig.RobloxPremium.Multiplier or 1
	return vip * premium * Friends.Multiplier(player)
end

-- XP extra de hoy (GameConfig.XPBoost: fin de semana de XP doble)
local function xpBoost()
	local boost = GameConfig.XPBoost
	if not boost or not boost.Enabled then
		return 1
	end
	local today = os.date("!*t").wday
	return table.find(boost.Days, today) and boost.Multiplier or 1
end
PlayerData.XPBoost = xpBoost

-- Bonus de XP del mapa destacado del día (mientras se juega en él)
featuredBonus = function()
	local config = GameConfig.FeaturedMap
	local featured = ReplicatedStorage:GetAttribute("FeaturedMap")
	if config and featured and ReplicatedStorage:GetAttribute("State") == "Playing" and ReplicatedStorage:GetAttribute("MapName") == featured then
		return config.XPBonus or 1
	end
	return 1
end

-- Lo pone Event: se llama al recoger la recompensa diaria
PlayerData.OnDailyClaimed = nil :: ((Player) -> ())?

-- Roblox Premium (atributo RobloxPremium: lo leen el multiplicador y la Tienda)
function PlayerData.UpdatePremium(player)
	local ok, premium = pcall(function()
		return player.MembershipType == Enum.MembershipType.Premium
	end)
	player:SetAttribute("RobloxPremium", ok and premium == true)
end

-- Envía los datos al cliente (cambios hechos desde fuera, p. ej. el evento)
function PlayerData.SendUpdate(player)
	sendUpdate(player)
end

-- Da una skin (premios de evento); devuelve true si es nueva
function PlayerData.GiveSkin(player, skinId)
	local data = profiles[player]
	if not data or not Skins.List[skinId] or data.Skins[skinId] then
		return false
	end
	data.Skins[skinId] = true
	dirty[player] = true
	sendUpdate(player)
	return true
end

-- Da un traje (recompensas de evento). Devuelve false si ya lo tenía
function PlayerData.GiveOutfit(player, outfitId)
	local data = profiles[player]
	if not data or not Outfits.List[outfitId] or data.Outfits[outfitId] then
		return false
	end
	data.Outfits[outfitId] = true
	dirty[player] = true
	sendUpdate(player)
	return true
end

-- Da un arma (premios de evento). Devuelve false si ya la tenía
function PlayerData.GiveWeapon(player, weaponName)
	local data = profiles[player]
	if not data or not Weapons.List[weaponName] or data.OwnedWeapons[weaponName] then
		return false
	end
	data.OwnedWeapons[weaponName] = true
	dirty[player] = true
	sendUpdate(player)
	return true
end

-- Marca los datos para guardarlos en el próximo guardado automático (cambios hechos desde fuera)
function PlayerData.MarkDirty(player)
	if profiles[player] then
		dirty[player] = true
	end
end

-- Da revivir instantáneos (regalos por tiempo jugado)
function PlayerData.AddRevives(player, amount)
	local data = profiles[player]
	if not data or amount <= 0 then
		return
	end
	data.Revives = (data.Revives or 0) + amount
	dirty[player] = true
	sendUpdate(player)
end

-- Gasta un "Revivir instantáneo". Devuelve false si no le quedan.
function PlayerData.UseRevive(player)
	local data = profiles[player]
	if not data or (data.Revives or 0) <= 0 then
		return false
	end
	data.Revives -= 1
	dirty[player] = true
	sendUpdate(player)
	return true
end

-- Lo ganado en la partida actual (para el resumen del final de la ronda)
local match = {} -- [player] = { XP, Coins, StartLevel, StartXP }

local function matchOf(player, data)
	local entry = match[player]
	if not entry then
		entry = { XP = 0, Coins = 0, StartLevel = data.Level, StartXP = data.XP, StartRank = data.RankPoints }
		match[player] = entry
	end
	return entry
end

-- Empieza una partida: se pone a cero lo ganado
function PlayerData.StartMatch(player)
	match[player] = nil
	local data = profiles[player]
	if data then
		matchOf(player, data)
	end
end

-- Resumen de lo ganado desde StartMatch
function PlayerData.MatchSummary(player)
	local data = profiles[player]
	if not data then
		return nil
	end
	local entry = matchOf(player, data)
	return {
		XP = entry.XP,
		Coins = entry.Coins,
		StartLevel = entry.StartLevel,
		StartXP = entry.StartXP,
		Level = data.Level,
		LevelXP = data.XP,
		XPPerLevel = GameConfig.XPPerLevel,
		StartRank = entry.StartRank or data.RankPoints,
		RankPoints = data.RankPoints,
	}
end

-- Cambio de temporada de rango: premio por el mejor rango de la anterior y RP a la mitad.
-- Devuelve el texto del aviso (o nil si no tocaba).
function PlayerData.RollSeason(data)
	local season = Ranks.CurrentSeason()
	if data.RankSeason == season.Id then
		return nil
	end
	if type(data.RankSeason) ~= "string" or data.RankSeason == "" then
		-- (jugador nuevo o guardado de antes de las temporadas: empieza en la actual sin premio)
		data.RankSeason = season.Id
		data.SeasonBest = 0
		return nil
	end
	-- (SeasonBest = 0: no jugó ninguna partida de rango esa temporada, así que no hay premio)
	local best = math.clamp(math.floor(tonumber(data.SeasonBest) or 0), 0, #Ranks.Tiers)
	local coins = best > 0 and Ranks.SeasonRewards[best] or 0
	local finished = Ranks.SeasonName(data.RankSeason)
	data.Coins += coins
	data.RankPoints = math.floor((data.RankPoints or 0) * Ranks.SeasonCarry)
	data.RankSeason = season.Id
	data.SeasonBest = 0
	if best == 0 then
		return "🏁 ¡Empieza la " .. season.Name .. "! Tus RP pasan a la mitad: juega para subir"
	end
	local tier = Ranks.Tiers[best]
	return "🏁 ¡Fin de la " .. finished .. "! Llegaste a " .. tier.Icon .. " " .. tier.Name .. ": +" .. coins .. " 🪙. Empieza la " .. season.Name
end

-- Premio de regreso (GameConfig.Comeback): se apunta el día de hoy; si hacía Days días o más que no
-- entraba, monedas y cajas gratis. Los guardados sin LastPlayDay (nuevos o de antes) solo se apuntan.
function PlayerData.RollComeback(data, today)
	today = today or Shop.DayNumber()
	local last = tonumber(data.LastPlayDay) or -1
	data.LastPlayDay = today
	local config = GameConfig.Comeback
	if not config or last < 0 or today - last < config.Days then
		return nil
	end
	data.Coins += config.Coins
	data.FreeCrates = (data.FreeCrates or 0) + config.Crates
	data.BoostXP = (tonumber(data.BoostXP) or 0) + (config.BoostXPMinutes or 0) * 60
	return "👋 ¡BIENVENIDO DE VUELTA! Regalo por volver: +" .. config.Coins .. " 🪙"
		.. (config.Crates > 0 and (", " .. config.Crates .. (config.Crates == 1 and " caja gratis" or " cajas gratis")) or "")
		.. ((config.BoostXPMinutes or 0) > 0 and (" y ⚡ XP doble " .. config.BoostXPMinutes .. " min") or "")
end

-- Primera victoria del día (GameConfig.FirstWinOfDay): premio extra una vez al día (hora UTC).
-- Devuelve las monedas dadas (o nil si ya la tuvo hoy).
function PlayerData.ClaimFirstWin(player, scale)
	local data = profiles[player]
	local config = GameConfig.FirstWinOfDay
	if not data or not config then
		return nil
	end
	local today = Shop.DayNumber()
	if data.FirstWinDay == today then
		return nil
	end
	data.FirstWinDay = today
	dirty[player] = true
	scale = scale or 1
	PlayerData.AddXP(player, math.floor(config.XP * scale), "Primera victoria del día")
	return PlayerData.AddCoins(player, math.floor(config.Coins * scale))
end

-- Caja sorpresa (GameConfig.SurpriseCrate): al acabar una partida jugada, una probabilidad pequeña de
-- una caja gratis; tras Pity partidas sin ninguna, sale seguro. Devuelve true si toca.
function PlayerData.RollSurpriseCrate(player, roll)
	local data = profiles[player]
	local config = GameConfig.SurpriseCrate
	if not data or not config then
		return false
	end
	data.CratePity = (tonumber(data.CratePity) or 0) + 1
	local chance = config.Chance * (player:GetAttribute("VIP") and (config.VIPMultiplier or 1) or 1)
	if (roll or math.random()) >= chance and data.CratePity < config.Pity then
		return false
	end
	data.CratePity = 0
	data.FreeCrates += 1
	dirty[player] = true
	sendUpdate(player)
	return true
end

-- Cambia de temporada a un jugador conectado (al acabar una partida o desde el bucle del servidor).
-- Devuelve true si ha cambiado.
function PlayerData.CheckSeason(player)
	local data = profiles[player]
	if not data then
		return false
	end
	local text = PlayerData.RollSeason(data)
	if not text then
		return false
	end
	player:SetAttribute("Rank", Ranks.Index(data.RankPoints))
	-- (el resumen de la partida compara con los RP ya recortados: el recorte no es de la partida)
	if match[player] then
		match[player].StartRank = data.RankPoints
	end
	Remotes.Notify:FireClient(player, "Big", text)
	dirty[player] = true
	sendUpdate(player)
	return true
end

-- Suma (o resta) puntos de rango al acabar una partida; nunca baja del inicio del rango actual
function PlayerData.AddRankPoints(player, delta)
	local data = profiles[player]
	if not data or delta == 0 then
		return 0
	end
	matchOf(player, data) -- (el resumen de la partida guarda el rango de antes)
	-- (si la temporada acabó con el servidor encendido, se cambia antes de sumar)
	PlayerData.CheckSeason(player)
	local before = data.RankPoints
	data.RankPoints = Ranks.Apply(before, delta)
	local index = Ranks.Index(data.RankPoints)
	data.SeasonBest = math.max(tonumber(data.SeasonBest) or 0, index)
	player:SetAttribute("Rank", index)
	-- Premios de los rangos alcanzados por primera vez
	while (data.RankBest or 1) < index do
		data.RankBest = (data.RankBest or 1) + 1
		local tier = Ranks.Tiers[data.RankBest]
		local reward = tier.Reward or {}
		local text = tier.Icon .. " ¡Rango " .. tier.Name .. "!"
		if reward.Coins then
			data.Coins += reward.Coins
			text ..= "  +" .. reward.Coins .. " 🪙"
		end
		if reward.Crates then
			data.FreeCrates += reward.Crates
			text ..= "  +" .. reward.Crates .. (reward.Crates == 1 and " caja" or " cajas")
		end
		Remotes.Notify:FireClient(player, "Challenge", text)
	end
	Badges.Check(player, data)
	dirty[player] = true
	sendUpdate(player)
	return data.RankPoints - before
end

-- fixed = true: premio fijo (no lo multiplican VIP ni amigos y no cuenta en el resumen de la partida)
function PlayerData.AddXP(player, amount, reason, fixed)
	local data = profiles[player]
	if not data or amount <= 0 then
		return
	end
	if not fixed then
		amount = math.floor(amount * multiplier(player) * xpBoost() * boosterMultiplier(player, data, "XP") * featuredBonus())
		matchOf(player, data).XP += amount
	end
	data.XP += amount
	Remotes.Notify:FireClient(player, "XP", "+" .. amount .. " XP  " .. (reason or ""))
	local leveled = false
	while data.XP >= GameConfig.XPPerLevel do
		data.XP -= GameConfig.XPPerLevel
		data.Level += 1
		leveled = true
	end
	if leveled then
		Badges.Check(player, data)
		PlayerData.GetLeaderstats(player).Nivel.Value = data.Level
		Remotes.Notify:FireClient(player, "LevelUp", data.Level)
		-- ¿Desbloquea alguna arma este nivel?
		for name, def in Weapons.List do
			if def.UnlockLevel == data.Level and not def.Hidden then
				Remotes.Notify:FireClient(player, "Unlock", "¡Arma desbloqueada: " .. def.DisplayName .. "!")
			end
		end
		grantTierRewards(player)
	end
	sendUpdate(player)
end

-- earned = true para monedas ganadas jugando (el VIP las duplica)
-- noBoost = true: le aplican VIP y amigos pero no los potenciadores (p. ej. la recompensa diaria)
function PlayerData.AddCoins(player, amount, earned, noBoost)
	local data = profiles[player]
	if data then
		if earned ~= false then
			amount = math.floor(amount * multiplier(player) * (noBoost and 1 or boosterMultiplier(player, data, "Coins")))
			matchOf(player, data).Coins += amount
		end
		data.Coins += amount
		sendUpdate(player)
		return amount -- lo que se ha sumado de verdad (con VIP y amigos)
	end
	return 0
end

function PlayerData.Increment(player, field, amount)
	local data = profiles[player]
	if data and type(data[field]) == "number" then
		data[field] += amount or 1
		if field == "TotalKills" or field == "Wins" then
			Badges.Check(player, data)
		end
	end
end

-- Guarda un récord (por ejemplo la mejor racha de bajas) si lo supera
function PlayerData.SetBest(player, field, value)
	local data = profiles[player]
	if data and type(data[field]) == "number" and value > data[field] then
		data[field] = value
		dirty[player] = true
	end
end

-- Título que ven los demás (atributos Title y TitleColor). Si ya no lo tiene (p. ej. el de VIP), Novato.
function PlayerData.PublishTitle(player)
	local data = profiles[player]
	if not data then
		return
	end
	local id = data.EquippedTitle
	if not Titles.Owns(data, id, player:GetAttribute("VIP") == true) then
		id = "Novato"
	end
	local title = Titles.Get(id)
	player:SetAttribute("Title", id ~= "Novato" and title.Name or nil)
	player:SetAttribute("TitleColor", title.Color)
end

-- Progreso de los retos diarios. stat: ver Challenges.luau. Para "Streak" amount es la racha actual.
function PlayerData.Track(player, stat, amount, weaponName)
	local data = profiles[player]
	if not data then
		return
	end
	local state = ensureChallenges(player, data)
	local changed = false
	for _, entry in state.List do
		local def = Challenges.Get(entry.Id)
		if def and not entry.Done and Challenges.Matches(def, stat, weaponName) then
			if stat == "Streak" then
				entry.Progress = math.max(entry.Progress, amount or 0)
			else
				entry.Progress += amount or 1
			end
			if entry.Progress >= def.Goal then
				entry.Done = true
				changed = true
				Remotes.Notify:FireClient(player, "Challenge", "¡RETO COMPLETADO! +" .. def.Coins .. " 🪙")
				PlayerData.AddCoins(player, def.Coins, false)
				PlayerData.AddXP(player, def.XP, "Reto diario")
			end
		end
	end
	if changed and not state.Bonus then
		local all = #state.List > 0
		for _, entry in state.List do
			all = all and entry.Done
		end
		if all then
			state.Bonus = true
			data.FreeCrates += Challenges.BonusCrates
			Remotes.Notify:FireClient(player, "Unlock", "¡Todos los retos de hoy completados! Caja gratis 🎁")
		end
	end
	-- Retos semanales
	local weekly = ensureWeekly(player, data)
	local weeklyChanged = false
	for _, entry in weekly.List do
		local def = Challenges.Get(entry.Id)
		if def and not entry.Done and Challenges.Matches(def, stat, weaponName) then
			if stat == "Streak" then
				entry.Progress = math.max(entry.Progress, amount or 0)
			else
				entry.Progress += amount or 1
			end
			if entry.Progress >= def.Goal then
				entry.Done = true
				weeklyChanged = true
				Remotes.Notify:FireClient(player, "Challenge", "¡RETO SEMANAL COMPLETADO! +" .. def.Coins .. " 🪙")
				PlayerData.AddCoins(player, def.Coins, false)
				PlayerData.AddXP(player, def.XP, "Reto semanal")
			end
		end
	end
	if weeklyChanged and not weekly.Bonus then
		local all = #weekly.List > 0
		for _, entry in weekly.List do
			all = all and entry.Done
		end
		if all then
			weekly.Bonus = true
			data.FreeCrates += Challenges.WeeklyBonusCrates
			Remotes.Notify:FireClient(player, "Unlock", "¡Retos de la semana completados! " .. Challenges.WeeklyBonusCrates .. " cajas gratis 🎁")
		end
	end
	if changed or weeklyChanged then
		sendUpdate(player)
	end
end

-- Cuenta una baja con un arma y entrega la maestría al subir de nivel
function PlayerData.AddWeaponKill(player, weaponName)
	local data = profiles[player]
	if not data or type(weaponName) ~= "string" or not Weapons.List[weaponName] or Weapons.List[weaponName].Hidden then
		return -- (las garras de zombi no tienen maestría)
	end
	local before = data.WeaponKills[weaponName] or 0
	local after = before + 1
	data.WeaponKills[weaponName] = after
	local oldLevel, newLevel = Mastery.Level(before), Mastery.Level(after)
	if newLevel > oldLevel then
		local tier = Mastery.Tiers[newLevel]
		-- Equipa el camuflaje nuevo automáticamente: ¡que se vea!
		data.WeaponCamos[weaponName] = tier.Camo
		Remotes.Notify:FireClient(player, "Mastery", "MAESTRÍA " .. string.upper(tier.Name) .. ": " .. Weapons.List[weaponName].DisplayName)
		PlayerData.AddCoins(player, tier.Coins, false)
		if PlayerData.OnSkinChanged then
			PlayerData.OnSkinChanged(player)
		end
		sendUpdate(player)
	else
		-- "¡Ya casi!": con 3 bajas o menos para el siguiente camuflaje, un aviso en cada baja
		local nextTier = Mastery.Tiers[newLevel + 1]
		local left = nextTier and nextTier.Kills - after
		if left and left > 0 and left <= 3 then
			Remotes.Notify:FireClient(player, "XP", "🎯 " .. Weapons.List[weaponName].DisplayName .. ": " .. (left == 1 and "¡1 baja" or ("¡" .. left .. " bajas")) .. " para el camuflaje " .. nextTier.Name .. "!")
		end
	end
end

---------------------------------------------------------------------------
-- Tienda
---------------------------------------------------------------------------

local function buyItem(player, kind, id)
	local data = profiles[player]
	if not data or type(kind) ~= "string" or type(id) ~= "string" then
		return false, "Datos no cargados"
	end
	local price
	if kind == "Weapon" then
		local def = Weapons.List[id]
		if not def or not def.Price then
			return false, "No está a la venta"
		end
		if Weapons.IsUnlocked(id, data) then
			return false, "Ya la tienes"
		end
		price = def.Price
	elseif kind == "Skin" then
		if not Skins.List[id] then
			return false, "No existe"
		end
		if data.Skins[id] then
			return false, "Ya la tienes"
		end
		price = Shop.GetPrice("Skin", id)
	elseif kind == "Outfit" then
		if not Outfits.List[id] then
			return false, "No existe"
		end
		if data.Outfits[id] then
			return false, "Ya lo tienes"
		end
		price = Shop.GetPrice("Outfit", id)
	elseif kind == "KillEffect" then
		if not KillEffects.List[id] then
			return false, "No existe"
		end
		if data.KillEffects[id] then
			return false, "Ya lo tienes"
		end
		price = Shop.GetPrice("KillEffect", id)
	elseif kind == "Charm" then
		if not Charms.List[id] then
			return false, "No existe"
		end
		if data.Charms[id] then
			return false, "Ya lo tienes"
		end
		price = Shop.GetPrice("Charm", id)
	elseif kind == "Spray" then
		if not Sprays.List[id] then
			return false, "No existe"
		end
		if data.Sprays[id] then
			return false, "Ya lo tienes"
		end
		price = Shop.GetPrice("Spray", id)
	elseif kind == "Title" then
		if not Titles.List[id] then
			return false, "No existe"
		end
		if data.Titles[id] then
			return false, "Ya lo tienes"
		end
		price = Shop.GetPrice("Title", id)
	end
	if not price then
		return false, "No está a la venta"
	end
	if data.Coins < price then
		return false, "Te faltan " .. (price - data.Coins) .. " monedas"
	end
	data.Coins -= price
	if kind == "Weapon" then
		data.OwnedWeapons[id] = true
	elseif kind == "Skin" then
		data.Skins[id] = true
	elseif kind == "KillEffect" then
		data.KillEffects[id] = true
		data.EquippedKillEffect = id -- se equipa al comprarlo
	elseif kind == "Charm" then
		data.Charms[id] = true
		data.EquippedCharm = id -- se equipa al comprarlo (se ve al reaparecer)
	elseif kind == "Spray" then
		data.Sprays[id] = true
		data.EquippedSpray = id -- se equipa al comprarlo
	elseif kind == "Title" then
		data.Titles[id] = true
		data.EquippedTitle = id
		PlayerData.PublishTitle(player)
	else
		data.Outfits[id] = true
	end
	sendUpdate(player)
	requestSave(player)
	return true, "¡Comprado!"
end

local function claimDaily(player)
	local data = profiles[player]
	if not data then
		return false
	end
	local today = Shop.DayNumber()
	if data.LastDailyDay == today then
		return false
	end
	local streak = (data.LastDailyDay == today - 1) and data.DailyStreak + 1 or 1
	if streak > #Shop.DailyRewards then
		streak = 1
	end
	data.DailyStreak = streak
	data.LastDailyDay = today
	local coins = Shop.DailyRewards[streak]
	local given = PlayerData.AddCoins(player, coins, true, true)
	local crate = streak == Shop.DailyCrateDay
	if crate then
		data.FreeCrates += 1
	end
	if player:GetAttribute("VIP") then
		data.FreeCrates += 1 -- caja diaria extra del VIP
	end
	sendUpdate(player)
	-- (el evento en marcha regala también unos objetos; lo pone Event)
	if PlayerData.OnDailyClaimed then
		task.spawn(PlayerData.OnDailyClaimed, player)
	end
	return true, { Streak = streak, Coins = given, Crate = crate }
end

local pendingReceipt = {} -- [player] = true mientras se guarda una compra con Robux

-- Ruleta: gasta el giro gratis de hoy (o uno comprado) y da un premio al azar según su peso.
-- Devuelve el índice del premio para que el cliente pare la ruleta en él.
local lastSpin = {} -- [player] = os.clock() (no más de un giro cada 3 s: dura la animación)
local function spinWheel(player)
	local data = profiles[player]
	if not data then
		return false, "Cargando..."
	end
	if os.clock() - (lastSpin[player] or 0) < 3 then
		return false, "Espera a que pare la ruleta"
	end
	local today = Shop.DayNumber()
	if data.WheelDay ~= today then
		data.WheelDay = today
	elseif data.WheelSpins > 0 and not cratesRestricted[player] and not pendingReceipt[player] then
		-- (los giros comprados son premios al azar de pago: no donde no se permiten; y no mientras se
		-- guarda una compra, por si hay que deshacerla)
		data.WheelSpins -= 1
	else
		return false, "Vuelve mañana para otro giro gratis"
	end
	lastSpin[player] = os.clock()
	local prizes = Shop.Wheel.Prizes
	local total = 0
	for _, prize in prizes do
		total += prize.Weight
	end
	local roll = math.random() * total
	local index = #prizes
	for i, prize in prizes do
		roll -= prize.Weight
		if roll <= 0 then
			index = i
			break
		end
	end
	local prize = prizes[index]
	-- (premio fijo: no lo multiplica el VIP)
	if prize.Kind == "Coins" then
		data.Coins += prize.Amount
	elseif prize.Kind == "Revives" then
		data.Revives += prize.Amount
	elseif prize.Kind == "Crate" then
		data.FreeCrates += prize.Amount
	elseif prize.Kind == "XP" then
		PlayerData.AddXP(player, prize.Amount, "Ruleta", true)
	elseif prize.Kind == "Boost" then
		data[prize.Field] = (tonumber(data[prize.Field]) or 0) + prize.Amount * 60
	end
	sendUpdate(player)
	requestSave(player)
	return true, index
end
Players.PlayerRemoving:Connect(function(player)
	lastSpin[player] = nil
	pendingPerk[player] = nil
end)

-- Abre una caja. Devuelve lo que ha tocado para la animación del cliente.
local function openCrate(player, crateId, useFree)
	local data = profiles[player]
	local crate = Shop.Crates[crateId]
	if not data or not crate then
		return false, "No existe"
	end
	if useFree then
		if data.FreeCrates <= 0 then
			return false, "No tienes cajas gratis"
		end
		data.FreeCrates -= 1
	else
		if cratesRestricted[player] then
			return false, "Las cajas de pago no están disponibles en tu región"
		end
		if data.Coins < crate.Price then
			return false, "Te faltan " .. (crate.Price - data.Coins) .. " monedas"
		end
		data.Coins -= crate.Price
	end

	-- Rareza según probabilidades
	local total = 0
	for _, entry in crate.Odds do
		total += entry.Weight
	end
	local roll = math.random() * total
	local rarity = crate.Odds[#crate.Odds].Rarity
	for _, entry in crate.Odds do
		roll -= entry.Weight
		if roll <= 0 then
			rarity = entry.Rarity
			break
		end
	end
	-- Objeto aleatorio de esa rareza (skins y trajes)
	local pool = {}
	for id, skin in Skins.List do
		if id ~= "Default" and not skin.Mastery and not skin.Event and skin.Rarity == rarity then
			table.insert(pool, { Kind = "Skin", Id = id })
		end
	end
	for id, outfit in Outfits.List do
		if id ~= "Default" and not outfit.Event and outfit.Rarity == rarity then
			table.insert(pool, { Kind = "Outfit", Id = id })
		end
	end
	if #pool == 0 then
		for id, skin in Skins.List do
			if id ~= "Default" and not skin.Mastery and not skin.Event then
				table.insert(pool, { Kind = "Skin", Id = id })
			end
		end
	end
	local prize = pool[math.random(1, #pool)]
	local owned
	if prize.Kind == "Skin" then
		owned = data.Skins[prize.Id] == true
	else
		owned = data.Outfits[prize.Id] == true
	end
	local refund = 0
	if owned then
		refund = math.floor(crate.Price * crate.DuplicateRefund)
		data.Coins += refund
	elseif prize.Kind == "Skin" then
		data.Skins[prize.Id] = true
	else
		data.Outfits[prize.Id] = true
	end
	sendUpdate(player)
	requestSave(player)
	return true, { Kind = prize.Kind, Id = prize.Id, Rarity = rarity, Duplicate = owned, Refund = refund }
end

-- Compras con Robux (Developer Products). Idempotente: cada PurchaseId se entrega una sola vez.
local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = PlayerData.WaitFor(player, 20)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(data.Purchases, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	-- Qué se entrega: un pack de monedas, de revivir o el pack de inicio
	local revivePack
	for _, p in Shop.RevivePacks do
		if p.ProductId ~= 0 and p.ProductId == receipt.ProductId then
			revivePack = p
		end
	end
	local grant, undo, message
	local starter = Shop.StarterPack
	local wheel = Shop.Wheel
	local bundle
	for _, b in Shop.Bundles do
		if b.ProductId ~= 0 and b.ProductId == receipt.ProductId then
			bundle = b
		end
	end
	local booster
	for _, b in Shop.Boosters do
		if b.ProductId ~= 0 and b.ProductId == receipt.ProductId then
			booster = b
		end
	end
	if bundle then
		-- Pack de temporada (si ya lo tenía, Roblox ya cobró: se entregan solo las monedas). Al
		-- deshacer solo se quita lo que se dio.
		local repeated = data.Bundles[bundle.Id] == true
		local had = {
			Effect = data.KillEffects[bundle.KillEffect] == true,
			Charm = data.Charms[bundle.Charm] == true,
			Spray = data.Sprays[bundle.Spray] == true,
			Outfits = {},
		}
		for _, outfitId in bundle.Outfits or {} do
			had.Outfits[outfitId] = data.Outfits[outfitId] == true
		end
		grant = function()
			data.Coins += bundle.Coins
			if not repeated then
				data.KillEffects[bundle.KillEffect] = true
				data.Charms[bundle.Charm] = true
				data.Sprays[bundle.Spray] = true
				for _, outfitId in bundle.Outfits or {} do
					data.Outfits[outfitId] = true
				end
				data.Bundles[bundle.Id] = true
			end
		end
		undo = function()
			data.Coins -= bundle.Coins
			if not repeated then
				for outfitId, hadIt in had.Outfits do
					if not hadIt then
						data.Outfits[outfitId] = nil
					end
				end
				if not had.Effect then
					data.KillEffects[bundle.KillEffect] = nil
				end
				if not had.Charm then
					data.Charms[bundle.Charm] = nil
				end
				if not had.Spray then
					data.Sprays[bundle.Spray] = nil
				end
				data.Bundles[bundle.Id] = nil
			end
		end
		message = repeated and ("+" .. bundle.Coins .. " MONEDAS") or (bundle.Icon .. " ¡" .. bundle.Name .. " DESBLOQUEADO!")
	elseif booster then
		local seconds = booster.Minutes * 60
		grant = function()
			data[booster.Field] = (tonumber(data[booster.Field]) or 0) + seconds
		end
		undo = function()
			data[booster.Field] = math.max(0, (tonumber(data[booster.Field]) or 0) - seconds)
		end
		message = booster.Icon .. " ¡" .. string.upper(booster.Name) .. " " .. booster.Minutes .. " MIN!"
	elseif wheel.SpinProductId ~= 0 and receipt.ProductId == wheel.SpinProductId then
		grant = function()
			data.WheelSpins += wheel.SpinsPerPurchase
		end
		undo = function()
			data.WheelSpins -= wheel.SpinsPerPurchase
		end
		message = "+" .. wheel.SpinsPerPurchase .. " GIROS DE RULETA"
	elseif starter.ProductId ~= 0 and receipt.ProductId == starter.ProductId and data.StarterPack then
		-- Ya lo tenía (compra repetida): Roblox ya cobró, así que se entregan solo las monedas
		grant = function()
			data.Coins += starter.Coins
		end
		undo = function()
			data.Coins -= starter.Coins
		end
		message = "+" .. starter.Coins .. " MONEDAS"
	elseif starter.ProductId ~= 0 and receipt.ProductId == starter.ProductId then
		-- Al deshacer solo se quita lo que se dio (no se vuelve a un saldo antiguo:
		-- mientras se guardaba pudo ganar o gastar monedas)
		local had = {
			Outfit = data.Outfits[starter.Outfit] == true,
			Skin = data.Skins[starter.Skin] == true,
			Effect = data.KillEffects[starter.KillEffect] == true,
		}
		grant = function()
			data.Coins += starter.Coins
			data.Outfits[starter.Outfit] = true
			data.Skins[starter.Skin] = true
			data.KillEffects[starter.KillEffect] = true
			data.StarterPack = true
		end
		undo = function()
			data.Coins -= starter.Coins
			if not had.Outfit then
				data.Outfits[starter.Outfit] = nil
			end
			if not had.Skin then
				data.Skins[starter.Skin] = nil
			end
			if not had.Effect then
				data.KillEffects[starter.KillEffect] = nil
			end
			data.StarterPack = false
		end
		message = "¡PACK DE INICIO DESBLOQUEADO!"
	elseif revivePack then
		local pack = revivePack
		grant = function()
			data.Revives += pack.Revives
		end
		undo = function()
			data.Revives -= pack.Revives
		end
		message = "+" .. pack.Revives .. " REVIVIR INSTANTÁNEO"
	else
		local pack
		for _, p in Shop.CoinPacks do
			if p.ProductId ~= 0 and p.ProductId == receipt.ProductId then
				pack = p
			end
		end
		if not pack then
			warn("[PlayerData] Producto desconocido:", receipt.ProductId)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		grant = function()
			data.Coins += pack.Coins
		end
		undo = function()
			data.Coins -= pack.Coins
		end
		message = "+" .. pack.Coins .. " MONEDAS"
	end
	pendingReceipt[player] = true
	grant()
	table.insert(data.Purchases, receipt.PurchaseId)
	while #data.Purchases > MAX_PURCHASE_LOG do
		table.remove(data.Purchases, 1)
	end
	local saved = store and not noSave[player] and save(player)
	pendingReceipt[player] = nil
	if not saved then
		-- No se pudo guardar: deshacemos y Roblox lo reintentará más tarde (así nunca se pierden Robux)
		undo()
		local index = table.find(data.Purchases, receipt.PurchaseId)
		if index then
			table.remove(data.Purchases, index)
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	Remotes.Notify:FireClient(player, "Big", message)
	sendUpdate(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

---------------------------------------------------------------------------

function PlayerData.Init()
	-- Publica si hay XP extra hoy (la pantalla de inicio lo anuncia); se revisa cada minuto
	-- Potenciadores: su tiempo corre solo mientras se juega (no en la portada)
	task.spawn(function()
		local STEP = 5
		while true do
			task.wait(STEP)
			for player, data in profiles do
				if player:GetAttribute("InMenu") ~= false then
					continue -- (en la portada o aún sin entrar en partida)
				end
				local changed, update = false, false
				for _, booster in Shop.Boosters do
					local left = tonumber(data[booster.Field]) or 0
					if left > 0 then
						data[booster.Field] = math.max(0, left - STEP)
						changed = true
						if data[booster.Field] == 0 then
							Remotes.Notify:FireClient(player, "Challenge", booster.Icon .. " Se acabó tu " .. booster.Name)
							update = true
						elseif data[booster.Field] % 60 < STEP then
							update = true -- (el cliente cuenta los segundos; se corrige cada minuto)
						end
					end
				end
				if changed then
					dirty[player] = true
				end
				if update then
					sendUpdate(player)
				end
			end
		end
	end)
	task.spawn(function()
		while true do
			ReplicatedStorage:SetAttribute("XPBoost", xpBoost())
			-- (la temporada de rango puede acabar con el servidor encendido)
			for player in profiles do
				PlayerData.CheckSeason(player)
			end
			task.wait(60)
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		PlayerData.GetLeaderstats(player)
		load(player)
	end)
	for _, player in Players:GetPlayers() do
		PlayerData.GetLeaderstats(player)
		task.spawn(load, player)
	end
	-- Se hace Premium sin salir del juego (botón de la Tienda)
	pcall(function()
		Players.PlayerMembershipChanged:Connect(function(player)
			PlayerData.UpdatePremium(player)
			local config = GameConfig.RobloxPremium
			if player:GetAttribute("RobloxPremium") and config then
				Remotes.Notify:FireClient(player, "Big", utf8.char(0xE001) .. " ¡ROBLOX PREMIUM! +" .. math.floor((config.Multiplier - 1) * 100 + 0.5) .. "% monedas y XP")
			end
			if profiles[player] then
				sendUpdate(player) -- (la Tienda se vuelve a dibujar con el bonus activo)
			end
		end)
	end)

	local pending = 0
	Players.PlayerRemoving:Connect(function(player)
		pending += 1
		-- Últimos cambios de otros módulos antes del guardado final (p. ej. el tiempo de los regalos)
		if PlayerData.OnLeaving then
			pcall(PlayerData.OnLeaving, player)
		end
		save(player, true)
		pending -= 1
		profiles[player] = nil
		Badges.Forget(player)
		noSave[player] = nil
		match[player] = nil
		cratesRestricted[player] = nil
		dirty[player] = nil
		saveScheduled[player] = nil
	end)

	-- Al cerrar el servidor espera a que terminen todos los guardados (máx. ~25 s)
	game:BindToClose(function()
		for _, player in Players:GetPlayers() do
			if PlayerData.OnLeaving then
				pcall(PlayerData.OnLeaving, player)
			end
			pending += 1
			task.spawn(function()
				save(player, true)
				pending -= 1
			end)
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < 25 do
			task.wait(0.2)
		end
	end)

	-- Autoguardado
	task.spawn(function()
		while true do
			task.wait(120)
			for _, player in Players:GetPlayers() do
				task.spawn(save, player)
			end
		end
	end)

	Remotes.GetData.OnServerInvoke = function(player)
		local data = PlayerData.WaitFor(player, 20)
		return data and publicView(player, data)
	end

	Remotes.EquipSkin.OnServerEvent:Connect(function(player, skinId)
		local data = profiles[player]
		if not data or type(skinId) ~= "string" or not Skins.List[skinId] or not data.Skins[skinId] then
			return
		end
		if Skins.List[skinId].Mastery then
			return
		end
		data.EquippedSkin = skinId
		if PlayerData.OnSkinChanged then
			PlayerData.OnSkinChanged(player)
		end
		sendUpdate(player)
	end)

	Remotes.EquipOutfit.OnServerEvent:Connect(function(player, outfitId)
		local data = profiles[player]
		if not data or type(outfitId) ~= "string" or not Outfits.List[outfitId] or not data.Outfits[outfitId] then
			return
		end
		data.EquippedOutfit = outfitId
		if PlayerData.OnOutfitChanged then
			PlayerData.OnOutfitChanged(player, outfitId)
		end
		sendUpdate(player)
	end)

	local function setWeapon(player, weaponName, field, list)
		local data = profiles[player]
		if not data or type(weaponName) ~= "string" or not table.find(list, weaponName) then
			return
		end
		if not Weapons.IsUnlocked(weaponName, data) then
			return
		end
		data[field] = weaponName
		Remotes.Notify:FireClient(player, "Info", Weapons.Get(weaponName).DisplayName .. " equipada (al reaparecer)")
		sendUpdate(player)
	end
	Remotes.SetPrimary.OnServerEvent:Connect(function(player, weaponName)
		setWeapon(player, weaponName, "Primary", Weapons.Primaries)
	end)
	Remotes.SetSecondary.OnServerEvent:Connect(function(player, weaponName)
		setWeapon(player, weaponName, "Secondary", Weapons.Secondaries)
	end)
	Remotes.TutorialDone.OnServerEvent:Connect(function(player)
		local data = profiles[player]
		if data and not data.TutorialDone then
			data.TutorialDone = true
			dirty[player] = true
			sendUpdate(player)
		end
	end)
	Remotes.NewsSeen.OnServerEvent:Connect(function(player)
		local data = profiles[player]
		local version = GameConfig.ActiveNews().Version
		if data and (data.NewsSeen or 0) < version then
			data.NewsSeen = version
			dirty[player] = true
			sendUpdate(player)
		end
	end)
	Remotes.SetMelee.OnServerEvent:Connect(function(player, weaponName)
		setWeapon(player, weaponName, "Melee", Weapons.Melees)
	end)

	-- Ajustes del jugador: se validan y se guardan con su progreso
	Remotes.SaveSettings.OnServerEvent:Connect(function(player, settings)
		local data = profiles[player]
		if not data or type(settings) ~= "table" then
			return
		end
		local clean = table.clone(data.Settings)
		if type(settings.Quality) == "string" and table.find(GameConfig.QualityLevels, settings.Quality) then
			clean.Quality = settings.Quality
		end
		for key, limits in GameConfig.SettingsLimits do
			local value = settings[key]
			if type(value) == "number" and value == value then
				clean[key] = math.clamp(math.floor(value * 100 + 0.5) / 100, limits[1], limits[2])
			end
		end
		data.Settings = clean
		-- La ventaja nueva vale desde la próxima aparición (no se cambia a mitad de un tiroteo)
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if player:GetAttribute("InMenu") or not humanoid or humanoid.Health <= 0 then
			player:SetAttribute("Perk", math.floor(clean.Perk or 0))
		elseif not pendingPerk[player] then
			pendingPerk[player] = true
			player.CharacterAdded:Once(function()
				pendingPerk[player] = nil
				local current = profiles[player]
				player:SetAttribute("Perk", math.floor((current and current.Settings.Perk) or 0))
			end)
		end
		dirty[player] = true
	end)

	Remotes.EquipCharm.OnServerEvent:Connect(function(player, charmId)
		local data = profiles[player]
		if not data or type(charmId) ~= "string" or not Charms.List[charmId] or not data.Charms[charmId] then
			return
		end
		data.EquippedCharm = charmId
		dirty[player] = true
		sendUpdate(player)
	end)

	Remotes.EquipTitle.OnServerEvent:Connect(function(player, titleId)
		local data = profiles[player]
		if not data or type(titleId) ~= "string" or not Titles.Owns(data, titleId, player:GetAttribute("VIP") == true) then
			return
		end
		data.EquippedTitle = titleId
		dirty[player] = true
		PlayerData.PublishTitle(player)
		sendUpdate(player)
	end)

	Remotes.EquipSpray.OnServerEvent:Connect(function(player, sprayId)
		local data = profiles[player]
		if not data or type(sprayId) ~= "string" or not Sprays.Owns(data.Sprays, sprayId, player:GetAttribute("VIP") == true) then
			return
		end
		data.EquippedSpray = sprayId
		dirty[player] = true
		sendUpdate(player)
	end)

	Remotes.EquipKillEffect.OnServerEvent:Connect(function(player, effectId)
		local data = profiles[player]
		if not data or type(effectId) ~= "string" or not KillEffects.List[effectId] or not data.KillEffects[effectId] then
			return
		end
		data.EquippedKillEffect = effectId
		sendUpdate(player)
	end)

	-- Camuflaje de maestría para un arma ("Default" = usar la skin general)
	Remotes.SetCamo.OnServerEvent:Connect(function(player, weaponName, camoId)
		local data = profiles[player]
		if not data or type(weaponName) ~= "string" or not Weapons.List[weaponName] or type(camoId) ~= "string" then
			return
		end
		if camoId == "Default" then
			data.WeaponCamos[weaponName] = nil
		elseif Mastery.HasCamo(data.WeaponKills[weaponName] or 0, camoId) then
			data.WeaponCamos[weaponName] = camoId
		else
			return
		end
		if PlayerData.OnSkinChanged then
			PlayerData.OnSkinChanged(player)
		end
		sendUpdate(player)
	end)

	-- Cambiar un reto diario sin completar por otro (1 al día)
	Remotes.RerollChallenge.OnServerInvoke = function(player, index)
		local data = profiles[player]
		if not data or type(index) ~= "number" then
			return false
		end
		local state = ensureChallenges(player, data)
		local entry = state.List[index]
		if not entry or entry.Done or (state.Rerolls or 0) >= Challenges.RerollsPerDay then
			return false
		end
		local exclude = {}
		for _, e in state.List do
			exclude[e.Id] = true
		end
		state.Rerolls = (state.Rerolls or 0) + 1
		local new = Challenges.Pick(state.Day, player.UserId, data.Level, 1, exclude, state.Rerolls)[1]
		if not new then
			return false
		end
		state.List[index] = { Id = new, Progress = 0, Done = false }
		sendUpdate(player)
		return true
	end

	Remotes.BuyItem.OnServerInvoke = buyItem
	Remotes.ClaimDaily.OnServerInvoke = claimDaily
	Remotes.SpinWheel.OnServerInvoke = spinWheel
	-- Logros: se reclaman si el dato llega a la meta y no se habían reclamado
	Remotes.ClaimAchievement.OnServerInvoke = function(player, id)
		local data = profiles[player]
		if not data or type(id) ~= "string" then
			return false, "No se pudo reclamar"
		end
		for _, achievement in GameConfig.Achievements do
			if achievement.Id == id then
				if data.Achievements[id] then
					return false, "Ya lo tienes"
				end
				if (tonumber(data[achievement.Stat]) or 0) < achievement.Goal then
					return false, "Aún no lo has conseguido"
				end
				data.Achievements[id] = true
				data.Coins += achievement.Coins
				dirty[player] = true
				sendUpdate(player)
				return true, achievement.Coins
			end
		end
		return false, "No existe"
	end
	-- Premio por unirse al grupo (una vez). IsInGroup se guarda en caché en el servidor, así que si
	-- dice que no se pregunta también a GroupService (por si se acaba de unir sin salir del juego)
	local groupChecked = {}
	Remotes.ClaimGroup.OnServerInvoke = function(player)
		local data = profiles[player]
		local group = GameConfig.Group
		if not data or not group or group.Id == 0 then
			return false, "No disponible"
		end
		if data.GroupReward then
			return false, "Ya lo tienes"
		end
		local now = os.clock()
		if groupChecked[player] and now - groupChecked[player] < 3 then
			return false, "Espera un momento"
		end
		groupChecked[player] = now
		local ok, member = pcall(player.IsInGroup, player, group.Id)
		if not (ok and member) then
			local found, groups = pcall(GroupService.GetGroupsAsync, GroupService, player.UserId)
			member = false
			if found and type(groups) == "table" then
				for _, info in groups do
					if info.Id == group.Id then
						member = true
					end
				end
			end
		end
		if not member or profiles[player] ~= data or data.GroupReward then
			return false, "NotMember"
		end
		data.GroupReward = true
		data.Coins += group.Coins
		dirty[player] = true
		sendUpdate(player)
		return true, group.Coins
	end
	Players.PlayerRemoving:Connect(function(player)
		groupChecked[player] = nil
	end)
	Remotes.OpenCrate.OnServerInvoke = openCrate
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local data = profiles[player]
		if not data then
			return
		end
		if passId == GameConfig.PremiumPassId and GameConfig.PremiumPassId ~= 0 then
			data.Premium = true
			Remotes.Notify:FireClient(player, "Big", "¡PASE PREMIUM ACTIVADO!")
			grantTierRewards(player)
		elseif passId == Shop.VIPPassId and Shop.VIPPassId ~= 0 then
			player:SetAttribute("VIP", true)
			PlayerData.PublishTitle(player)
			Remotes.Notify:FireClient(player, "Big", "¡VIP ACTIVADO! x2 XP y monedas")
		end
		sendUpdate(player)
		save(player)
	end)
end

return PlayerData
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">Pumpkins</string>
            <string name="Source"><![CDATA[-- Modo Calabazas (como "Kill Confirmed"): quien cae suelta una calabaza con el color de su equipo.
-- Si la recoge el equipo contrario, punto para ellos (baja confirmada); si la recoge un compañero del
-- caído, la baja no cuenta (recuperada). Las calabazas desaparecen a los LIFETIME segundos.
-- Round decide qué pasa al recoger (OnCollect) y quién puede recoger (Collectors).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Pumpkins = {}

Pumpkins.OnCollect = nil -- function(collector, confirmed, pumpkinTeam)
Pumpkins.Collectors = nil -- function() -> { { Position, Team, Player?, Bot? } }

local LIFETIME = 30
local RADIUS = 4.5

local running = false
local generation = 0 -- (cada Start tiene su propio bucle; el de una partida anterior se para solo)
local active = {} -- { Model, Position, Team, Expires }
local folder

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

-- Suelo bajo el punto (quien cae en el aire suelta la calabaza en el suelo). nil si debajo no hay
-- suelo o es lava (nadie podría recogerla y los bots se lanzarían a por ella)
local function groundBelow(position)
	local map = workspace:FindFirstChild("Map")
	if not map then
		return position
	end
	rayParams.FilterDescendantsInstances = { map, workspace.Terrain } -- (algunos mapas tienen suelo de terreno)
	local hit = workspace:Raycast(position + Vector3.new(0, 2, 0), Vector3.new(0, -60, 0), rayParams)
	if not hit then
		return nil
	end
	local part = hit.Instance
	if part:GetAttribute("Hazard") or hit.Material == Enum.Material.CrackedLava or part.Name == "Lava" then
		return nil
	end
	return hit.Position
end

-- Fuera de Halloween el modo es "Baja confirmada": en vez de calabazas, placas de identificación
-- (se decide al empezar la partida: si Halloween empieza o acaba a mitad, no cambia)
local tagsThisMatch = nil
function Pumpkins.Tags()
	if tagsThisMatch ~= nil then
		return tagsThisMatch
	end
	return ReplicatedStorage:GetAttribute("EventName") ~= "Halloween"
end

local function build(position, team)
	local tags = Pumpkins.Tags()
	local model = Instance.new("Model")
	model.Name = "Pumpkin"
	local body = Instance.new("Part")
	body.Name = "PumpkinBody"
	if tags then
		-- Placa metálica colgando (con el color del equipo en el anillo del suelo)
		body.Size = Vector3.new(1.3, 1.9, 0.2)
		body.Color = Color3.fromRGB(205, 208, 214)
		body.Material = Enum.Material.Metal
	else
		body.Shape = Enum.PartType.Ball
		body.Size = Vector3.new(2.4, 2.4, 2.4)
		body.Color = Color3.fromRGB(255, 130, 20)
		body.Material = Enum.Material.SmoothPlastic
	end
	body.CFrame = CFrame.new(position + Vector3.new(0, 1.7, 0))
	body.Anchored = true
	body.CanCollide = false
	body.CanQuery = false
	body.CanTouch = false
	body.CastShadow = false
	-- (WorldFX la hace flotar en el cliente)
	body:SetAttribute("Bob", 0.35)
	local light = Instance.new("PointLight")
	light.Color = tags and Color3.fromRGB(230, 236, 255) or Color3.fromRGB(255, 160, 60)
	light.Range = 8
	light.Brightness = 1
	light.Parent = body
	local face = Instance.new("BillboardGui")
	face.Size = UDim2.fromOffset(46, 46)
	face.AlwaysOnTop = false
	face.LightInfluence = 0
	face.MaxDistance = 120
	face.Parent = body
	local icon = Instance.new("TextLabel")
	icon.Size = UDim2.fromScale(1, 1)
	icon.BackgroundTransparency = 1
	icon.Text = tags and "🏷️" or "🎃"
	icon.TextScaled = true
	icon.Parent = face
	body.Parent = model
	-- Anillo en el suelo con el color del equipo del caído
	local ring = Instance.new("Part")
	ring.Name = "PumpkinRing"
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.2, 4.5, 4.5)
	ring.CFrame = CFrame.new(position + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	ring.Color = team and team.TeamColor.Color or Color3.new(1, 1, 1)
	ring.Material = Enum.Material.Neon
	ring.Transparency = 0.35
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Parent = model
	model.Parent = folder
	return model
end

-- Suelta una calabaza donde cayó alguien del equipo `team`. victimId: UserId del caído (nunca puede
-- recoger la suya); fromBot: el caído era un bot (premia menos)
function Pumpkins.Drop(position, team, victimId, fromBot)
	if not running or typeof(position) ~= "Vector3" or not team then
		return
	end
	local ground = groundBelow(position)
	if not ground then
		return
	end
	table.insert(active, { Model = build(ground, team), Position = ground, Team = team, Expires = os.clock() + LIFETIME, VictimId = victimId, FromBot = fromBot })
end

-- La calabaza más cercana a un punto (para los bots); nil si no hay
function Pumpkins.Nearest(position)
	local best, bestDistance = nil, math.huge
	for _, pumpkin in active do
		local distance = (pumpkin.Position - position).Magnitude
		if distance < bestDistance then
			best, bestDistance = pumpkin.Position, distance
		end
	end
	return best, bestDistance
end

function Pumpkins.Count()
	return #active
end

local function step()
	local now = os.clock()
	local collectors = Pumpkins.Collectors and Pumpkins.Collectors() or {}
	for i = #active, 1, -1 do
		local pumpkin = active[i]
		if now > pumpkin.Expires or not pumpkin.Model.Parent then
			pumpkin.Model:Destroy()
			table.remove(active, i)
		else
			for _, collector in collectors do
				local own = collector.Player and collector.Player.UserId == pumpkin.VictimId
				local revived = collector.Player and now - (collector.Player:GetAttribute("RevivedAt") or -math.huge) < 5
				if collector.Team and not own and not revived and (collector.Position - pumpkin.Position).Magnitude <= RADIUS then
					pumpkin.Model:Destroy()
					table.remove(active, i)
					if Pumpkins.OnCollect then
						task.spawn(Pumpkins.OnCollect, collector, collector.Team ~= pumpkin.Team, pumpkin.Team, pumpkin.FromBot)
					end
					break
				end
			end
		end
	end
end

function Pumpkins.Start()
	Pumpkins.Stop()
	tagsThisMatch = ReplicatedStorage:GetAttribute("EventName") ~= "Halloween"
	running = true
	generation += 1
	local mine = generation
	folder = Instance.new("Folder")
	folder.Name = "Pumpkins"
	folder.Parent = workspace
	task.spawn(function()
		while running and generation == mine do
			step()
			task.wait(0.1)
		end
	end)
end

function Pumpkins.Stop()
	tagsThisMatch = nil
	running = false
	for _, pumpkin in active do
		pumpkin.Model:Destroy()
	end
	table.clear(active)
	if folder then
		folder:Destroy()
		folder = nil
	end
end

return Pumpkins
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">Ragdoll</string>
            <string name="Source"><![CDATA[-- Muñeco de trapo al morir (como en los shooters): en vez de romperse en piezas, las articulaciones
-- pasan a ser rótulas sueltas con límites y el cuerpo cae de forma natural. Sirve para jugadores y
-- bots (R15). Prepare antes de morir (para que Roblox no rompa las uniones) y Apply al morir.
local Ragdoll = {}

-- Límites de giro de cada articulación (grados): cuello y cintura poco, hombros y caderas más
local LIMITS = {
	Neck = { 35, 20 },
	Waist = { 25, 15 },
	Root = { 20, 10 },
	LeftShoulder = { 80, 40 },
	RightShoulder = { 80, 40 },
	LeftElbow = { 70, 10 },
	RightElbow = { 70, 10 },
	LeftWrist = { 30, 10 },
	RightWrist = { 30, 10 },
	LeftHip = { 60, 25 },
	RightHip = { 60, 25 },
	LeftKnee = { 70, 8 },
	RightKnee = { 70, 8 },
	LeftAnkle = { 25, 8 },
	RightAnkle = { 25, 8 },
}

Ragdoll.SettleTime = 2.5

function Ragdoll.Prepare(humanoid)
	if humanoid and humanoid:IsA("Humanoid") then
		humanoid.BreakJointsOnDeath = false
	end
end

-- push (opcional): empujón inicial del cuerpo (p. ej. alejándose de una explosión)
function Ragdoll.Apply(character, push)
	if not character or character:GetAttribute("Ragdolled") then
		return false
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local motors = {}
	for _, d in character:GetDescendants() do
		if d:IsA("Motor6D") and d.Part0 and d.Part1 then
			table.insert(motors, d)
		end
	end
	if #motors == 0 then
		return false
	end
	character:SetAttribute("Ragdolled", true)
	-- (el cuerpo de un jugador lo mueve su propio cliente: el servidor se lo queda para que el
	-- empujón y la caída se vean igual para todos)
	for _, part in character:GetDescendants() do
		if part:IsA("BasePart") and not part.Anchored then
			pcall(part.SetNetworkOwner, part, nil)
		end
	end
	-- El eje X de la rótula va a lo largo del hueso (en R15 los miembros van en Y): así UpperAngle
	-- limita cuánto se dobla y los límites de giro, cuánto rota sobre sí mismo
	local alongBone = CFrame.Angles(0, 0, math.pi / 2)
	for _, motor in motors do
		local a0 = Instance.new("Attachment")
		a0.Name = "RagdollA0"
		a0.CFrame = motor.C0 * alongBone
		a0.Parent = motor.Part0
		local a1 = Instance.new("Attachment")
		a1.Name = "RagdollA1"
		a1.CFrame = motor.C1 * alongBone
		a1.Parent = motor.Part1
		-- Las piezas unidas se solapan en la articulación: que no choquen entre sí (temblarían)
		local noCollide = Instance.new("NoCollisionConstraint")
		noCollide.Part0 = motor.Part0
		noCollide.Part1 = motor.Part1
		noCollide.Parent = motor.Part1
		local socket = Instance.new("BallSocketConstraint")
		socket.Name = "RagdollSocket"
		socket.Attachment0 = a0
		socket.Attachment1 = a1
		local limit = LIMITS[motor.Name] or { 45, 15 }
		socket.LimitsEnabled = true
		socket.UpperAngle = limit[1]
		socket.TwistLimitsEnabled = true
		socket.TwistLowerAngle = -limit[2]
		socket.TwistUpperAngle = limit[2]
		socket.Parent = motor.Part1
		motor.Enabled = false
	end
	-- Las piezas del cuerpo chocan con el suelo (si no, atravesarían el suelo); la raíz no
	for _, part in character:GetChildren() do
		if part:IsA("BasePart") then
			part.CanCollide = part ~= root
			if part == root then
				part.Massless = true
			end
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.PlatformStand = true
		humanoid.AutoRotate = false
	end
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if torso and torso:IsA("BasePart") and typeof(push) == "Vector3" then
		torso.AssemblyLinearVelocity += push
	end
	-- Cuando ya ha caído, se queda quieto y sin colisión: no estorba en puertas ni escaleras (en
	-- Eliminación y Buscar y destruir el cuerpo dura toda la ronda) y no gasta física
	task.delay(Ragdoll.SettleTime, function()
		if not character.Parent then
			return
		end
		for _, part in character:GetDescendants() do
			if part:IsA("BasePart") then
				part.Anchored = true
				part.CanCollide = false
			end
		end
	end)
	return true
end

return Ragdoll
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">RealKit</string>
            <string name="Source"><![CDATA[-- Kit de construcción "realista" para los mapas tipo shooter militar (Encrucijada, Base Militar...):
-- edificios en los que se entra (con escalera, plantas y ventanas de verdad), bloques macizos de
-- fachada, sacos terreros, muros en ruinas, coches quemados, autobús, tanque y puestos de mercado.
local Kit = require(script.Parent.MapKit)

local RealKit = {}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad
local M = Enum.Material

RealKit.FLOOR_H = 8 -- altura de cada planta
local FLOOR_H = RealKit.FLOOR_H
RealKit.WALL_T = 1.2 -- grosor de los muros
local WALL_T = RealKit.WALL_T

RealKit.PALETTE = {
	Plaster = { RGB(196, 178, 150), RGB(182, 160, 128), RGB(206, 192, 168), RGB(170, 150, 122), RGB(188, 168, 140) },
	Brick = RGB(150, 92, 70),
	Concrete = RGB(150, 146, 138),
	Trim = RGB(120, 106, 88),
	Dark = RGB(60, 56, 52),
	Sand = RGB(190, 168, 128),
	Rust = RGB(120, 70, 45),
}

local block, deco = Kit.block, Kit.deco

---------------------------------------------------------------------------
-- Piezas de construcción
---------------------------------------------------------------------------

-- Muro a lo largo de su eje X local con huecos (puertas y ventanas de verdad: se ve y se dispara a
-- través). cf = centro de la base del muro. openings = { { X = centro, W = ancho, Y0 = abajo, Y1 = arriba } }
function RealKit.wall(cf, length, height, color, material, openings)
	openings = openings or {}
	-- Columnas: los huecos con la misma X (ventana de abajo y de arriba) se cortan juntos
	local columns = {}
	for _, o in openings do
		local column
		for _, c in columns do
			if math.abs(c.X - o.X) < 0.01 and math.abs(c.W - o.W) < 0.01 then
				column = c
			end
		end
		if not column then
			column = { X = o.X, W = o.W, Holes = {} }
			table.insert(columns, column)
		end
		table.insert(column.Holes, o)
	end
	table.sort(columns, function(a, b)
		return a.X < b.X
	end)
	local function solid(x0, x1, y0, y1)
		if x1 - x0 > 0.05 and y1 - y0 > 0.05 then
			block("Wall", V(x1 - x0, y1 - y0, WALL_T), cf * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, 0), color, material)
		end
	end
	local x = -length / 2
	for _, column in columns do
		local x0, x1 = column.X - column.W / 2, column.X + column.W / 2
		solid(x, x0, 0, height)
		table.sort(column.Holes, function(a, b)
			return a.Y0 < b.Y0
		end)
		local y = 0
		for _, o in column.Holes do
			solid(x0, x1, y, o.Y0)
			y = o.Y1
			-- Marco del hueco (dintel y alféizar) para que no parezca un corte en el muro
			deco("Lintel", V(o.W + 0.8, 0.5, WALL_T + 0.3), cf * CFrame.new(o.X, o.Y1 + 0.25, 0), RealKit.PALETTE.Trim, M.Limestone)
			if o.Y0 > 0.5 then
				deco("Sill", V(o.W + 0.6, 0.35, WALL_T + 0.5), cf * CFrame.new(o.X, o.Y0 - 0.17, 0), RealKit.PALETTE.Trim, M.Limestone)
			end
		end
		solid(x0, x1, y, height)
		x = x1
	end
	solid(x, length / 2, 0, height)
end

-- Huecos de una fachada: puertas en la planta baja (doors = lista de X) y ventanas cada ~8 studs
-- en cada planta (sin pisar las puertas). windows = false para un muro ciego.
function RealKit.facadeOpenings(length, floors, doors, windows)
	local list = {}
	for _, x in doors or {} do
		table.insert(list, { X = x, W = 6, Y0 = 0, Y1 = 7.2 })
	end
	if windows ~= false then
		local count = math.max(1, math.floor(length / 8))
		for f = 0, floors - 1 do
			for i = 1, count do
				local x = -length / 2 + (i - 0.5) * length / count
				-- (ni al lado de una puerta ni encima: el muro de sobre la puerta taparía la ventana)
				local clash = false
				for _, d in doors or {} do
					if math.abs(d - x) < (f == 0 and 6 or 4.6) then
						clash = true
					end
				end
				if not clash and math.abs(x) < length / 2 - 2.5 then
					table.insert(list, { X = x, W = 3, Y0 = f * FLOOR_H + 2.8, Y1 = f * FLOOR_H + 6.2 })
				end
			end
		end
	end
	return list
end

-- Número "al azar" pero fijo para cada sitio (el mapa sale igual siempre)
local function hash(cf, i)
	local p = cf.Position
	return (math.floor(math.abs(p.X * 7.13 + p.Z * 3.71 + i * 17.3)) % 97) / 97
end

-- Detalles de fachada que no chocan (sin tocar la jugabilidad): banda de piedra entre plantas,
-- bajante en una esquina, aparatos de aire bajo algunas ventanas de arriba y trastos en la azotea.
-- windowXs = posiciones X de las ventanas de la fachada delantera/trasera (de facadeOpenings)
local function facadeDetails(cf, sx, sz, height, floors, roofed, windowXs)
	local trim = RealKit.PALETTE.Trim
	for f = 1, floors - 1 do
		local y = f * FLOOR_H - 0.6
		for _, z in { -1, 1 } do
			deco("Band", V(sx + 0.5, 0.45, 0.5), cf * CFrame.new(0, y, z * (sz / 2 + 0.05)), trim, M.Limestone)
		end
		for _, x in { -1, 1 } do
			deco("Band", V(0.5, 0.45, sz + 0.5), cf * CFrame.new(x * (sx / 2 + 0.05), y, 0), trim, M.Limestone)
		end
	end
	-- Bajante de la azotea (esquina delantera derecha)
	Kit.cylinder("Downpipe", height, 0.45, cf * CFrame.new(sx / 2 - 0.7, height / 2, -sz / 2 - 0.35), RGB(88, 84, 78), M.Metal, nil, true)
	-- Aparatos de aire bajo algunas ventanas de la planta de arriba (delante y detrás)
	if floors >= 2 and windowXs then
		for i, x in windowXs do
			for side = -1, 1, 2 do
				if hash(cf, i * 3 + side) < 0.32 then
					local y = (floors - 1) * FLOOR_H + 1.6
					local unit = cf * CFrame.new(x, y, side * (sz / 2 + 0.75))
					deco("ACUnit", V(2.2, 1.5, 1.2), unit, RGB(196, 196, 190), M.Metal)
					deco("ACGrille", V(1.4, 1.1, 0.1), unit * CFrame.new(0, 0, side * 0.62), RGB(70, 72, 74), M.DiamondPlate)
				end
			end
		end
	end
	if roofed then
		-- Azotea: máquina del aire, chimenea de ventilación y antena
		deco("RoofAC", V(3.2, 1.8, 2.6), cf * CFrame.new(-sx / 4, height + 0.9, -sz / 5), RGB(170, 170, 166), M.Metal)
		Kit.cylinder("RoofVent", 2.4, 0.9, cf * CFrame.new(sx / 5, height + 1.2, -sz / 4), RGB(110, 108, 104), M.Metal, nil, true)
		if hash(cf, 7) < 0.6 then
			Kit.cylinder("Antenna", 7, 0.25, cf * CFrame.new(-sx / 2 + 1.5, height + 3.5, sz / 2 - 1.5), RGB(60, 60, 62), M.Metal, nil, true)
			deco("AntennaBar", V(3, 0.2, 0.2), cf * CFrame.new(-sx / 2 + 1.5, height + 5.8, sz / 2 - 1.5), RGB(60, 60, 62), M.Metal)
		end
	end
end

-- Edificio en el que se entra. cf = centro de la planta baja (suelo en y = 0); sx = ancho (X local),
-- sz = fondo (Z local, el frente mira a -Z). opts:
--   Floors (1 o 2), Color, Material, Doors = { Front = {x...}, Back = {...}, Left = {...}, Right = {...} },
--   Blind = { Left = true, ... } (muro sin ventanas), Ruined (sin tejado y con el muro roto arriba),
--   Sign = texto del rótulo de la fachada, Lamp (luz dentro)
function RealKit.building(cf, sx, sz, opts)
	opts = opts or {}
	local floors = opts.Floors or 2
	local height = floors * FLOOR_H + (opts.Ruined and 0 or 1)
	local color = opts.Color or RealKit.PALETTE.Plaster[1]
	local material = opts.Material or M.Plaster
	local doors = opts.Doors or {}
	local blind = opts.Blind or {}
	local function face(name, wallCf, length)
		RealKit.wall(wallCf, length, height, color, material, RealKit.facadeOpenings(length, floors, doors[name], not blind[name]))
	end
	-- Muros: frente (-Z), fondo (+Z), izquierda (-X) y derecha (+X)
	face("Front", cf * CFrame.new(0, 0, -sz / 2 + WALL_T / 2), sx)
	face("Back", cf * CFrame.new(0, 0, sz / 2 - WALL_T / 2) * CFrame.Angles(0, math.pi, 0), sx)
	face("Left", cf * CFrame.new(-sx / 2 + WALL_T / 2, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0), sz - 2 * WALL_T)
	face("Right", cf * CFrame.new(sx / 2 - WALL_T / 2, 0, 0) * CFrame.Angles(0, math.pi / 2, 0), sz - 2 * WALL_T)
	-- Zócalo y cornisa
	deco("Plinth", V(sx + 0.4, 1, sz + 0.4), cf * CFrame.new(0, 0.5, 0), RealKit.PALETTE.Trim, M.Limestone).CanCollide = false
	-- Suelo interior de baldosas
	deco("InteriorFloor", V(sx - 2 * WALL_T, 0.1, sz - 2 * WALL_T), cf * CFrame.new(0, 0.06, 0), RGB(150, 132, 112), M.CeramicTiles)
	local inner = sx - 2 * WALL_T
	local innerZ = sz - 2 * WALL_T
	if floors >= 2 then
		-- Escalera junto al muro izquierdo (franja de 7 studs) y forjado con el hueco de la escalera
		local stripX = -sx / 2 + WALL_T + 3.5
		local run = math.min(innerZ - 6, 16)
		local z0 = -sz / 2 + WALL_T + 1
		Kit.stairs(cf * V(stripX, 0, z0), cf * V(stripX, FLOOR_H, z0 + run), 6, RealKit.PALETTE.Concrete, M.Concrete)
		block("Slab", V(inner - 7, 1, innerZ), cf * CFrame.new(-sx / 2 + WALL_T + 7 + (inner - 7) / 2, FLOOR_H - 0.5, 0), RealKit.PALETTE.Concrete, M.Concrete)
		local landing = innerZ - (run + 1)
		if landing > 0.5 then
			block("Landing", V(7, 1, landing), cf * CFrame.new(stripX, FLOOR_H - 0.5, sz / 2 - WALL_T - landing / 2), RealKit.PALETTE.Concrete, M.Concrete)
		end
		-- Barandilla del hueco de la escalera
		Kit.railing(cf * V(stripX + 3.6, FLOOR_H, z0 + 0.5), cf * V(stripX + 3.6, FLOOR_H, z0 + run - 0.5), 3, RealKit.PALETTE.Dark)
	end
	if opts.Ruined then
		-- Muro roto: trozos sueltos por arriba y escombros en el suelo
		for i = 1, 6 do
			local px = ((i * 37) % 100) / 100 - 0.5
			deco("Rubble", V(2 + i % 3, 1 + i % 2, 2 + (i + 1) % 3), cf * CFrame.new(px * (sx - 6), 0.6, ((i * 53) % 100 / 100 - 0.5) * (sz - 6)) * CFrame.Angles(i, i * 2, 0), RealKit.PALETTE.Concrete, M.Concrete).CanCollide = true
		end
	else
		block("Roof", V(sx + 0.6, 1, sz + 0.6), cf * CFrame.new(0, height - 0.5, 0), RealKit.PALETTE.Concrete, M.Concrete)
		deco("Cornice", V(sx + 1.2, 0.8, sz + 1.2), cf * CFrame.new(0, height - 1.2, 0), RealKit.PALETTE.Trim, M.Limestone)
		for _, z in { -1, 1 } do
			deco("Parapet", V(sx + 0.6, 1.8, 0.6), cf * CFrame.new(0, height + 0.9, z * (sz / 2)), color, material)
		end
		for _, x in { -1, 1 } do
			deco("Parapet", V(0.6, 1.8, sz + 0.6), cf * CFrame.new(x * (sx / 2), height + 0.9, 0), color, material)
		end
		-- Depósito de agua y antena en la azotea (silueta de ciudad)
		Kit.cylinder("WaterTank", 3, 3, cf * CFrame.new(sx / 4, height + 1.5, sz / 4), RGB(70, 72, 76), M.Metal, nil, true)
	end
	-- Ventanas de la fachada (para colocar los aparatos de aire debajo)
	local windowXs = {}
	if not blind.Front then
		for _, o in RealKit.facadeOpenings(sx, floors, doors.Front, true) do
			if o.Y0 > (floors - 1) * FLOOR_H then
				table.insert(windowXs, o.X)
			end
		end
	end
	facadeDetails(cf, sx, sz, height, floors, not opts.Ruined, windowXs)
	if opts.Sign then
		local plate = deco("ShopSign", V(math.min(sx - 4, 14), 2.2, 0.3), cf * CFrame.new(0, 8.6, -sz / 2 - 0.3), RGB(40, 38, 36), M.Wood)
		Kit.sign(plate, Enum.NormalId.Front, opts.Sign, RGB(235, 225, 200), RGB(20, 20, 20))
		plate.CanCollide = false
	end
	-- Muebles (cobertura dentro): mesa al fondo y estantería delante, contra el muro derecho, y cajas
	-- arriba (en el lado derecho: la escalera va por el izquierdo y la puerta lateral está en el centro)
	if not opts.Empty then
		-- (nada delante de una puerta del muro derecho: su hueco va en z = -offset, 6 de ancho)
		local function clearOfDoors(z, halfDepth)
			for _, d in doors.Right or {} do
				if math.abs(-d - z) < 3 + halfDepth + 0.5 then
					return false
				end
			end
			return true
		end
		local tableZ = sz / 4 + 0.8
		if clearOfDoors(tableZ, 2.2) then
			local tableCf = cf * CFrame.new(sx / 2 - WALL_T - 2, 0, tableZ)
			block("Table", V(2.6, 0.3, 4.4), tableCf * CFrame.new(0, 3, 0), RGB(110, 80, 56), M.WoodPlanks)
			block("TableBase", V(2.2, 2.85, 0.4), tableCf * CFrame.new(0, 1.45, 0), RGB(90, 64, 44), M.Wood) -- (se esconde detrás)
			-- Sillas junto a la mesa (una volcada)
			for i, dz in { -1.2, 1.3 } do
				local chair = tableCf * CFrame.new(-2.2, 0, dz) * (i == 2 and CFrame.Angles(0, 0, rad(80)) * CFrame.new(0.9, -0.6, 0) or CFrame.new())
				deco("ChairSeat", V(1.4, 0.2, 1.4), chair * CFrame.new(0, 1.8, 0), RGB(96, 70, 48), M.Wood)
				deco("ChairBack", V(0.2, 1.8, 1.4), chair * CFrame.new(-0.6, 2.8, 0), RGB(96, 70, 48), M.Wood)
				for _, leg in { V(-0.55, 0, -0.55), V(0.55, 0, -0.55), V(-0.55, 0, 0.55), V(0.55, 0, 0.55) } do
					deco("ChairLeg", V(0.18, 1.7, 0.18), chair * CFrame.new(leg + V(0, 0.85, 0)), RGB(80, 58, 40), M.Wood)
				end
			end
		end
		-- Alfombra en el centro y papeles por el suelo
		deco("Rug", V(math.min(sx / 3, 8), 0.05, math.min(sz / 3, 6)), cf * CFrame.new(sx / 8, 0.14, 0), RGB(120, 52, 44), M.Fabric)
		for i = 1, 4 do
			deco("FloorPaper", V(0.9, 0.04, 0.7), cf * CFrame.new(sx / 8 + (i - 2.5) * 1.6, 0.18, (i % 2 - 0.5) * 3) * CFrame.Angles(0, i * 0.9, 0), RGB(225, 220, 205), M.SmoothPlastic)
		end
		if clearOfDoors(-sz / 4, 2) then
			block("Shelf", V(1.2, 5, 4), cf * CFrame.new(sx / 2 - WALL_T - 0.6, 2.5, -sz / 4), RGB(96, 90, 82), M.Metal)
		end
		if floors >= 2 then
			local crateCf = cf * CFrame.new(sx / 2 - WALL_T - 2, FLOOR_H, -sz / 4)
			Kit.crate(crateCf, 2.5)
			Kit.crate(crateCf * CFrame.new(0, 0, 2.8), 2.5)
			-- Cama arriba, en la esquina del fondo a la derecha (cobertura baja)
			local bedCf = cf * CFrame.new(sx / 2 - WALL_T - 1.8, FLOOR_H, sz / 2 - WALL_T - 3.4)
			block("BedFrame", V(3.2, 1, 6.2), bedCf * CFrame.new(0, 0.5, 0), RGB(70, 60, 52), M.Wood)
			deco("Mattress", V(3, 0.5, 5.8), bedCf * CFrame.new(0, 1.25, 0), RGB(170, 168, 150), M.Fabric)
			deco("Blanket", V(3.1, 0.12, 3.4), bedCf * CFrame.new(0, 1.55, -1.1) * CFrame.Angles(0, 0, rad(3)), RGB(70, 84, 64), M.Fabric)
			deco("Pillow", V(2, 0.4, 1), bedCf * CFrame.new(0, 1.7, 2.2), RGB(225, 222, 210), M.Fabric)
		end
	end
	-- Una luz cálida dentro (las plantas bajas se verían negras al entrar desde el sol)
	if opts.Lamp ~= false then
		for f = 0, floors - 1 do
			local bulb = deco("CeilingLamp", V(1.2, 0.3, 1.2), cf * CFrame.new(sx / 6, f * FLOOR_H + FLOOR_H - 1.2, 0), RGB(255, 220, 170), M.Neon)
			Kit.light(bulb, "PointLight", RGB(255, 210, 160), 22, 0.8)
		end
	end
end

-- Bloque macizo (fachada con ventanas pintadas, no se entra): separa carriles y hace de horizonte
function RealKit.solidBlock(cf, sx, sz, height, color, opts)
	opts = opts or {}
	block("Block", V(sx, height, sz), cf * CFrame.new(0, height / 2, 0), color, opts.Material or M.Plaster)
	deco("Plinth", V(sx + 0.4, 1.2, sz + 0.4), cf * CFrame.new(0, 0.6, 0), RealKit.PALETTE.Trim, M.Limestone)
	deco("Cornice", V(sx + 1, 0.8, sz + 1), cf * CFrame.new(0, height - 0.4, 0), RealKit.PALETTE.Trim, M.Limestone)
	if opts.Windows ~= false then
		local floors = math.max(1, math.floor(height / FLOOR_H))
		for f = 0, floors - 1 do
			for _, side in { -1, 1 } do
				local count = math.max(1, math.floor(sx / 8))
				for i = 1, count do
					local x = -sx / 2 + (i - 0.5) * sx / count
					local windowCf = cf * CFrame.new(x, f * FLOOR_H + 4.4, side * (sz / 2 + 0.1))
					deco("Window", V(3, 3.4, 0.2), windowCf, RGB(40, 44, 50), M.Glass)
					-- Algunas ventanas tapiadas con tablones (ciudad en guerra)
					if opts.Boarded ~= false and hash(windowCf, f * 7 + i) < 0.22 then
						for b, angle in { 0.35, -0.3 } do
							deco("Board", V(3.6, 0.5, 0.12), windowCf * CFrame.new(0, (b - 1.5) * 0.6, side * 0.12) * CFrame.Angles(0, 0, angle), RGB(120 - b * 12, 92 - b * 8, 62), M.WoodPlanks)
						end
					end
				end
			end
		end
	end
	local floorsHigh = math.max(1, math.floor(height / FLOOR_H))
	local windowXs = {}
	if opts.Windows ~= false then
		local count = math.max(1, math.floor(sx / 8))
		for i = 1, count do
			table.insert(windowXs, -sx / 2 + (i - 0.5) * sx / count)
		end
	end
	facadeDetails(cf, sx, sz, height, floorsHigh, true, windowXs)
	if opts.Sign then
		if opts.Awning ~= false then
			RealKit.awning(cf * CFrame.new(0, 6.6, -sz / 2), math.min(sx - 4, 14), opts.AwningColor)
		end
		local plate = deco("ShopSign", V(math.min(sx - 4, 14), 2.2, 0.3), cf * CFrame.new(0, 8.2, -sz / 2 - 0.3), RGB(40, 38, 36), M.Wood)
		Kit.sign(plate, Enum.NormalId.Front, opts.Sign, RGB(235, 225, 200), RGB(20, 20, 20))
	end
	Kit.contactShadow(cf, sx + 0.4, sz + 0.4)
end

---------------------------------------------------------------------------
-- Detalles de calle (no chocan: solo vista)
---------------------------------------------------------------------------

-- Postes de la luz en fila a lo largo del eje X local de cf (desde x0 hasta x1, cada `step`) con
-- dos cables entre poste y poste
function RealKit.utilityLine(cf, x0, x1, step)
	local wood, wire = RGB(92, 74, 56), RGB(30, 30, 32)
	local last
	for x = x0, x1, step do
		local base = cf * CFrame.new(x, 0, 0)
		Kit.cylinder("UtilityPole", 15, 0.7, base * CFrame.new(0, 7.5, 0), wood, M.Wood, nil, true)
		deco("Crossarm", V(0.4, 0.4, 4), base * CFrame.new(0, 13.8, 0), wood, M.Wood)
		deco("Transformer", V(1.2, 1.8, 1.2), base * CFrame.new(0.7, 11.8, 0), RGB(110, 112, 110), M.Metal)
		if last then
			for _, z in { -1.6, 1.6 } do
				deco("Wire", V(x - last, 0.1, 0.1), cf * CFrame.new((x + last) / 2, 13.2, z), wire, M.SmoothPlastic)
			end
		end
		last = x
	end
end

-- Parche de asfalto (más oscuro) con un bache y grietas
function RealKit.roadPatch(cf, sx, sz)
	deco("RoadPatch", V(sx, 0.06, sz), cf * CFrame.new(0, 0.42, 0), RGB(48, 48, 50), M.Asphalt)
	deco("Pothole", V(sx * 0.35, 0.07, sz * 0.4), cf * CFrame.new(sx * 0.15, 0.44, -sz * 0.1) * CFrame.Angles(0, 0.6, 0), RGB(36, 34, 33), M.Slate)
	for i = 1, 2 do
		deco("Crack", V(sx * 0.6, 0.07, 0.18), cf * CFrame.new(-sx * 0.1, 0.44, (i - 1.5) * sz * 0.4) * CFrame.Angles(0, (i - 1.5) * 0.7, 0), RGB(30, 30, 30), M.Asphalt)
	end
end

-- Basura junto a una pared: bolsas, cajas de cartón y papeles
function RealKit.trashPile(cf)
	for i, offset in { V(0, 0, 0), V(1.3, 0, 0.5), V(0.5, 0, -1.1) } do
		local size = 1.2 + (i % 2) * 0.3
		Kit.ball("TrashBag", size, cf * CFrame.new(offset + V(0, size / 2 - 0.1, 0)), i == 2 and RGB(40, 60, 40) or RGB(28, 28, 30), M.Plastic, true)
	end
	deco("Cardboard", V(1.6, 1.1, 1.3), cf * CFrame.new(-1.4, 0.55, 0.4) * CFrame.Angles(0, 0.4, 0), RGB(160, 124, 82), M.Cardboard)
	deco("Cardboard", V(1.2, 0.8, 1), cf * CFrame.new(-1.2, 1.5, 0.3) * CFrame.Angles(0, -0.3, 0.1), RGB(150, 116, 76), M.Cardboard)
	for i = 1, 3 do
		deco("Paper", V(0.8, 0.03, 0.6), cf * CFrame.new(-2 + i * 1.4, 0.45, 1.6 + (i % 2)) * CFrame.Angles(0, i, 0), RGB(220, 214, 200), M.SmoothPlastic)
	end
end

-- Semáforo (apagado por la guerra) en la esquina: poste, brazo y caja de luces
function RealKit.trafficLight(cf)
	local metal = RGB(56, 58, 60)
	Kit.cylinder("SignalPole", 11, 0.5, cf * CFrame.new(0, 5.5, 0), metal, M.Metal, nil, true)
	deco("SignalArm", V(0.35, 0.35, 6), cf * CFrame.new(0, 10.6, 3), metal, M.Metal)
	local box = deco("SignalBox", V(1.2, 3.2, 1.1), cf * CFrame.new(0, 9.4, 5.6), RGB(40, 42, 40), M.Metal)
	for i, color in { RGB(90, 30, 28), RGB(90, 80, 30), RGB(30, 80, 40) } do
		deco("SignalLamp", V(0.75, 0.75, 0.1), box.CFrame * CFrame.new(-0.62, 1.05 - (i - 1) * 1.05, 0) * CFrame.Angles(0, math.pi / 2, 0), color, M.Glass)
	end
end

-- Toldo de tienda a rayas sobre la fachada (cf = centro del borde de arriba, pegado al muro)
local AWNING_COLORS = { RGB(150, 46, 40), RGB(40, 90, 120), RGB(60, 110, 60), RGB(170, 120, 40) }
function RealKit.awning(cf, width, color)
	color = color or AWNING_COLORS[math.floor(hash(cf, 3) * #AWNING_COLORS) + 1]
	local depth = 3
	local stripes = math.max(3, math.floor(width / 1.6))
	for i = 1, stripes do
		local x = -width / 2 + (i - 0.5) * width / stripes
		deco("Awning", V(width / stripes, 0.12, depth), cf * CFrame.new(x, -0.6, -depth / 2) * CFrame.Angles(rad(-22), 0, 0), i % 2 == 0 and RGB(226, 218, 200) or color, M.Fabric)
	end
	deco("AwningValance", V(width, 0.5, 0.08), cf * CFrame.new(0, -1.5, -depth + 0.15), color, M.Fabric)
end

-- Cartel de papel pegado en una pared (cf = sobre la cara del muro, mirando hacia fuera por -Z)
local POSTER_COLORS = { RGB(200, 70, 50), RGB(220, 200, 150), RGB(60, 90, 140), RGB(230, 225, 210) }
function RealKit.poster(cf, i)
	local color = POSTER_COLORS[(i % #POSTER_COLORS) + 1]
	local paper = deco("Poster", V(1.7, 2.3, 0.04), cf * CFrame.Angles(0, 0, rad((i % 3 - 1) * 4)), color, M.SmoothPlastic)
	deco("PosterBand", V(1.5, 0.35, 0.05), paper.CFrame * CFrame.new(0, 0.6, 0), color:Lerp(RGB(20, 20, 20), 0.6), M.SmoothPlastic)
	deco("PosterBand", V(1.2, 0.18, 0.05), paper.CFrame * CFrame.new(0, -0.3, 0), color:Lerp(RGB(20, 20, 20), 0.45), M.SmoothPlastic)
end

-- Pintada en una pared (cf igual que poster): texto con aerosol
function RealKit.graffiti(cf, text, color, width)
	local plate = deco("Graffiti", V(width or 8, 2.6, 0.04), cf, RGB(255, 255, 255), M.SmoothPlastic)
	plate.Transparency = 1
	local gui = Kit.sign(plate, Enum.NormalId.Front, text, color, color)
	gui.LightInfluence = 1
	local label = gui:FindFirstChildOfClass("TextLabel")
	if label then
		label.Font = Enum.Font.PermanentMarker
		label.TextStrokeTransparency = 1
		label.TextTransparency = 0.12
	end
end

-- Muro de sacos terreros (cobertura baja, hasta el pecho)
function RealKit.sandbags(cf, length)
	block("Sandbags", V(length, 3.4, 2.4), cf * CFrame.new(0, 1.7, 0), RealKit.PALETTE.Sand, M.Fabric)
	local count = math.max(2, math.floor(length / 2.2))
	for i = 1, count do
		local x = -length / 2 + (i - 0.5) * length / count
		deco("Sandbag", V(length / count * 0.95, 0.8, 2.2), cf * CFrame.new(x, 3.6, (i % 2) * 0.2 - 0.1) * CFrame.Angles(0, (i % 3 - 1) * 0.08, 0), RealKit.PALETTE.Sand:Lerp(RGB(120, 100, 70), (i % 3) * 0.12), M.Fabric)
	end
	Kit.contactShadow(cf, length + 0.4, 2.8)
end

-- Muro en ruinas: tramo con el borde de arriba roto (cobertura alta con huecos para asomarse)
function RealKit.ruinWall(cf, length, height, color)
	local pieces = math.max(2, math.floor(length / 3))
	for i = 1, pieces do
		local h = height * (0.55 + ((i * 37) % 45) / 100)
		local x = -length / 2 + (i - 0.5) * length / pieces
		block("RuinWall", V(length / pieces + 0.05, h, 1.4), cf * CFrame.new(x, h / 2, 0), color or RealKit.PALETTE.Plaster[4], M.Plaster)
	end
	for i = 1, 3 do
		deco("Rubble", V(1.2 + i * 0.4, 0.8, 1 + i * 0.3), cf * CFrame.new((i - 2) * length / 3, 0.4, 1.4) * CFrame.Angles(i, i * 1.7, 0), RealKit.PALETTE.Concrete, M.Concrete)
	end
end

-- Coche quemado con humo
function RealKit.burntCar(cf, smoke)
	local model = Kit.car(cf, RGB(52, 46, 42))
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part.Material == M.Glass then
			part.Transparency = 1 -- sin cristales
		elseif part:IsA("BasePart") and part.Name == "CarBody" then
			part.Material = M.CorrodedMetal
			part.Reflectance = 0
		end
	end
	-- (que tape de verdad: la cabina de cristal no choca)
	local cover = block("CarCover", V(9, 3.6, 4.2), cf * CFrame.new(0, 1.8, 0), RGB(52, 46, 42), M.CorrodedMetal)
	cover.Transparency = 1
	cover.CastShadow = false
	if smoke then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
		emitter.Color = ColorSequence.new(RGB(70, 66, 62), RGB(40, 38, 36))
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 12) })
		emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 1) })
		emitter.Lifetime = NumberRange.new(4, 7)
		emitter.Speed = NumberRange.new(3, 6)
		emitter.SpreadAngle = Vector2.new(15, 15)
		emitter.Rate = 3
		emitter.WindAffectsDrag = true
		emitter.Drag = 0.5
		emitter.EmissionDirection = Enum.NormalId.Top
		emitter.Parent = cover
	end
	return model
end

-- Autobús volcado de lado / atravesado (cobertura grande)
function RealKit.bus(cf)
	local body = block("Bus", V(26, 8, 7), cf * CFrame.new(0, 4.2, 0), RGB(190, 150, 60), M.CorrodedMetal)
	deco("BusStripe", V(26.1, 1, 7.1), cf * CFrame.new(0, 3.2, 0), RGB(150, 60, 40), M.CorrodedMetal)
	for i = -2, 2 do
		deco("BusWindow", V(3.6, 2.4, 7.1), cf * CFrame.new(i * 4.6, 6, 0), RGB(30, 30, 32), M.Glass)
	end
	for _, x in { -8.5, 8.5 } do
		for _, z in { -3.4, 3.4 } do
			local wheel = deco("Wheel", V(2.6, 2.6, 0.9), cf * CFrame.new(x, 1.1, z) * CFrame.Angles(0, math.pi / 2, 0), RGB(24, 24, 26), M.Rubber)
			wheel.Shape = Enum.PartType.Cylinder
		end
	end
	Kit.contactShadow(cf, 26, 7)
	return body
end

-- Tanque destruido (cobertura y silueta)
function RealKit.tankWreck(cf)
	block("TankHull", V(14, 3.6, 7.5), cf * CFrame.new(0, 2.6, 0), RGB(78, 82, 64), M.CorrodedMetal)
	for _, z in { -3.6, 3.6 } do
		block("TankTrack", V(15, 2.4, 1.6), cf * CFrame.new(0, 1.2, z), RGB(40, 40, 38), M.Metal)
	end
	block("TankTurret", V(6.5, 2.4, 5.5), cf * CFrame.new(1, 5.6, 0) * CFrame.Angles(0, rad(25), 0), RGB(72, 76, 60), M.CorrodedMetal)
	deco("TankGun", V(9, 0.7, 0.7), cf * CFrame.new(-4, 5.8, -2.2) * CFrame.Angles(0, rad(25), rad(-6)), RGB(60, 62, 52), M.Metal)
	Kit.contactShadow(cf, 15, 8)
end

-- Puesto de mercado con toldo (cobertura media)
function RealKit.stall(cf, color)
	block("StallCounter", V(6, 3.2, 2.5), cf * CFrame.new(0, 1.6, 0), RGB(130, 96, 62), M.WoodPlanks)
	for _, x in { -2.8, 2.8 } do
		deco("StallPole", V(0.3, 7, 0.3), cf * CFrame.new(x, 3.5, 1.2), RGB(90, 70, 50), M.Wood)
	end
	deco("StallAwning", V(7, 0.2, 4), cf * CFrame.new(0, 7, 0.4) * CFrame.Angles(rad(-10), 0, 0), color, M.Fabric)
	for i = 1, 3 do
		deco("Goods", V(1.4, 0.8, 1.2), cf * CFrame.new(-2.5 + i * 1.6, 3.6, -0.3), ({ RGB(200, 80, 50), RGB(220, 170, 60), RGB(90, 140, 60) })[i], M.Fabric)
	end
end

return RealKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">Respawn</string>
            <string name="Source"><![CDATA[-- Reaparición controlada por el juego (Players.CharacterAutoLoads = false en default.project.json):
--   * Al morir se reaparece solo tras GameConfig.RespawnTime segundos
--   * "Regenerar ahora": a partir de GameConfig.RespawnNowDelay se puede reaparecer antes
--   * "Revivir instantáneo": gasta un revivir (data.Revives) y vuelve justo donde moriste
-- Round llama a Respawn.ApplyRevive al aparecer el personaje para colocarlo en ese punto.
-- En plena ronda de Eliminación (atributo NoRespawn) no hay reaparición: se espera a la siguiente ronda.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)

local PlayerData = require(script.Parent.PlayerData)

local Respawn = {}

local deaths = {} -- [player] = { Time = os.clock(), Position = Vector3?, Character = Model }
local revivePoints = {} -- [player] = Vector3 donde debe aparecer tras revivir
local loading = {} -- [player] = true mientras se carga un personaje (evita cargas dobles)

local function noRespawn()
	return ReplicatedStorage:GetAttribute("NoRespawn") == true
end

local function isDead(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return character == nil or humanoid == nil or humanoid.Health <= 0
end

local function load(player)
	if loading[player] or not player.Parent then
		return
	end
	loading[player] = true
	local ok, err = pcall(player.LoadCharacter, player)
	loading[player] = nil
	if ok then
		deaths[player] = nil
	else
		-- Sin CharacterAutoLoads nadie más lo reintentaría: se queda muerto. Reintento en un segundo.
		-- (deaths se conserva para que "Regenerar ahora" siga funcionando mientras tanto)
		warn("[Respawn] No se pudo cargar el personaje:", err)
		revivePoints[player] = nil
		task.delay(1, function()
			if player.Parent and isDead(player) then
				load(player)
			end
		end)
	end
end
Respawn.Load = load

-- ¿Se está cargando su personaje ahora mismo? (Eliminación lo cuenta como vivo)
function Respawn.IsLoading(player)
	return loading[player] == true
end

local function watch(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end
	humanoid.Died:Connect(function()
		local root = character:FindFirstChild("HumanoidRootPart")
		deaths[player] = { Time = os.clock(), Position = root and root.Position, Character = character }
		task.delay(GameConfig.RespawnTime, function()
			-- Solo si sigue con el mismo personaje muerto (no ha usado "Regenerar" ni "Revivir")
			if player.Parent and player.Character == character and not noRespawn() then
				load(player)
			end
		end)
	end)
end

-- Llamada por Round al aparecer: si el jugador acaba de revivir, lo pone donde murió.
-- Devuelve true si lo ha colocado (y entonces no se usa el punto de aparición normal).
function Respawn.ApplyRevive(player, character)
	local point = revivePoints[player]
	if not point then
		return false
	end
	revivePoints[player] = nil
	local root = character:WaitForChild("HumanoidRootPart", 5)
	if not root then
		return false
	end
	task.wait()
	character:PivotTo(CFrame.new(point + Vector3.new(0, 3, 0)) * (root.CFrame - root.Position))
	-- Protección breve al revivir (se pierde al disparar, como la de reaparición)
	local shield = Instance.new("ForceField")
	shield.Name = "SpawnShield"
	shield.Visible = true
	shield.Parent = character
	task.delay(GameConfig.ReviveShieldTime, function()
		if shield.Parent then
			shield:Destroy()
		end
	end)
	return true
end

-- Comprueba si se puede revivir ahora mismo; devuelve el punto o nil y el motivo
local function reviveCheck(player)
	local death = deaths[player]
	if not death or not isDead(player) then
		return nil, "Solo al morir"
	end
	if os.clock() - death.Time > GameConfig.RespawnTime + 0.5 then
		return nil, "Demasiado tarde"
	end
	if ReplicatedStorage:GetAttribute("State") ~= "Playing" then
		return nil, "La ronda no está en juego"
	end
	if noRespawn() then
		return nil, "Una sola vida por ronda"
	end
	-- Infección: un superviviente que cae ya es zombi (no vuelve como humano)
	if ReplicatedStorage:GetAttribute("Infection") == "On" and player.Team and player.Team.Name == ReplicatedStorage:GetAttribute("TeamA") then
		return nil, "¡Te han infectado!"
	end
	if ReplicatedStorage:GetAttribute("Frozen") or loading[player] then
		return nil, "Ya estás reapareciendo"
	end
	local point = death.Position
	if not point or point.Y < -20 then
		return nil, "No se puede revivir aquí"
	end
	-- Tiene que haber suelo debajo (no en el aire sobre un hueco) y no puede ser lava
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(point + Vector3.new(0, 2, 0), Vector3.new(0, -14, 0), params)
	if not hit then
		return nil, "No hay suelo aquí"
	end
	if hit.Instance:GetAttribute("Hazard") or hit.Material == Enum.Material.CrackedLava then
		return nil, "No se puede revivir en la lava"
	end
	return hit.Position
end

function Respawn.Init()
	Players.CharacterAutoLoads = false -- también en default.project.json; aquí por si se usa otro lugar
	Remotes.RespawnNow.OnServerEvent:Connect(function(player)
		local death = deaths[player]
		if death and isDead(player) and os.clock() - death.Time >= GameConfig.RespawnNowDelay and not noRespawn() then
			load(player)
		end
	end)

	Remotes.InstantRevive.OnServerInvoke = function(player)
		local point, reason = reviveCheck(player)
		if not point then
			return false, reason
		end
		if not PlayerData.UseRevive(player) then
			return false, "Sin revivir"
		end
		revivePoints[player] = point
		-- (al revivir no se puede coger enseguida la bandera ni las calabazas de donde caíste)
		player:SetAttribute("RevivedAt", os.clock())
		task.spawn(load, player)
		return true
	end

	local function onPlayer(player)
		player.CharacterAdded:Connect(function(character)
			task.spawn(watch, player, character)
		end)
		if player.Character then
			task.spawn(watch, player, player.Character)
		else
			-- Primera aparición (CharacterAutoLoads está desactivado)
			task.defer(load, player)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		deaths[player] = nil
		revivePoints[player] = nil
		loading[player] = nil
	end)
end

return Respawn
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">Round</string>
            <string name="Source"><![CDATA[-- Rondas, modos de juego, votación de mapa/modo, equipos, marcador, rachas y recompensas.
-- Modos: TDM (duelo por equipos), CTF (captura la bandera), KOTH (zona de control),
--        FFA (todos contra todos), GUN (escalada de armas) y ELIM (eliminación: rondas de una vida).
--
-- Estado publicado en ReplicatedStorage para la interfaz:
--   State ("Intermission" | "Playing" | "Ended"), Mode, ModeName, TeamMode, TimeLeft, ScoreToWin,
--   Score_<Equipo>, LeaderName, LeaderScore, MapName,
--   NoRespawn (true en plena ronda de Eliminación), AliveA / AliveB (vivos de cada equipo en Eliminación),
--   VoteN_Map, VoteN_Mode, VoteN_Count (N = 1..3) durante el descanso
-- En cada jugador: atributo Score (bajas en FFA / nivel en Escalada), Streak, Captures, GunLevel
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.GameConfig)
local Weapons = require(Shared.Weapons)
local Remotes = require(Shared.Remotes)
local Ranks = require(Shared.Ranks)

local PlayerData = require(script.Parent.PlayerData)
local Flags = require(script.Parent.Flags)
local Hardpoint = require(script.Parent.Hardpoint)
local Domination = require(script.Parent.Domination)
local Bomb = require(script.Parent.Bomb)
local MapBuilder = require(script.Parent.MapBuilder)
local Loadout = require(script.Parent.Loadout)
local Killstreaks = require(script.Parent.Killstreaks)
local Grenades = require(script.Parent.Grenades)
local Respawn = require(script.Parent.Respawn)
local Bots = require(script.Parent.Bots)
local SpawnPicker = require(script.Parent.SpawnPicker)
local Zombie = require(script.Parent.Zombie)
local Bounty = require(script.Parent.Bounty)
local Pumpkins = require(script.Parent.Pumpkins)
local Loot = require(script.Parent.Loot)
local Combat = require(script.Parent.Combat)
local Friends = require(script.Parent.Friends)

local Round = {}

local teams = {}
local roundOver = false
local currentMode = "TDM"
local votes = {} -- [player] = índice
local voteOptions = {}

local onInfectionDeath -- (Infección: quien cae ante los zombis se convierte; ver más abajo)

-- ¿Ha ganado la partida este jugador? En Infección, si ganan los zombis solo cuentan como ganadores
-- los que ya eran zombis al empezar (los supervivientes convertidos han perdido)
local function wonTeam(player, winner)
	if winner == nil or player.Team ~= winner then
		return false
	end
	if currentMode == "INF" and winner == teams[2] then
		return player:GetAttribute("InfZombieStart") == true
	end
	return true
end

-- Rivales distintos eliminados en la racha actual (para SE BUSCA: matar al mismo amigo varias veces
-- no cuenta como "racha contra jugadores")
local streakVictims = {} -- [player] = { [UserId] = true }
local firstBlood = false -- ya hubo la primera baja de la partida (medalla Primera sangre)

local STREAK_ANNOUNCE = { [3] = true, [5] = true, [7] = true, [10] = true, [15] = true, [20] = true }

local function setState(state)
	ReplicatedStorage:SetAttribute("State", state)
end

local function settings(mode)
	return GameConfig.ModeSettings[mode or currentMode]
end

-- Nombre del modo para la interfaz (Calabazas es "Baja confirmada" fuera de Halloween)
local function modeName(mode)
	if mode == "CAL" and Pumpkins.Tags() then
		return "Baja confirmada"
	end
	return GameConfig.ModeSettings[mode].Name
end

local function isTeamMode(mode)
	return settings(mode).Teams ~= false
end

local function getScore(teamName)
	return ReplicatedStorage:GetAttribute("Score_" .. teamName) or 0
end

local function setupTeams()
	for _, cfg in GameConfig.Teams do
		local team = Teams:FindFirstChild(cfg.Name)
		if not team then
			team = Instance.new("Team")
			team.Name = cfg.Name
			team.TeamColor = cfg.Color
			team.AutoAssignable = false
			team.Parent = Teams
		end
		table.insert(teams, team)
		ReplicatedStorage:SetAttribute("Score_" .. cfg.Name, 0)
	end
	ReplicatedStorage:SetAttribute("TeamA", teams[1].Name)
	ReplicatedStorage:SetAttribute("TeamB", teams[2].Name)
end

local function addScore(team, amount)
	if ReplicatedStorage:GetAttribute("State") ~= "Playing" or not team then
		return
	end
	local score = getScore(team.Name) + amount
	ReplicatedStorage:SetAttribute("Score_" .. team.Name, score)
	if score >= (ReplicatedStorage:GetAttribute("ScoreToWin") or math.huge) then
		roundOver = true
	end
end

-- Líder individual (modos sin equipos). Puede ser un bot (tabla de Bots, con Name y Score).
local function updateLeader(leaving)
	local best, bestScore = nil, -1
	for _, player in Players:GetPlayers() do
		local score = player:GetAttribute("Score") or 0
		if player ~= leaving and score > bestScore then
			best, bestScore = player, score
		end
	end
	for _, agent in Bots.Agents do
		if (agent.Score or 0) > bestScore then
			best, bestScore = agent, agent.Score or 0
		end
	end
	ReplicatedStorage:SetAttribute("LeaderName", best and best.Name or "")
	ReplicatedStorage:SetAttribute("LeaderScore", math.max(bestScore, 0))
	return best, bestScore
end

local function addPlayerScore(player, amount)
	local score = (player:GetAttribute("Score") or 0) + amount
	player:SetAttribute("Score", score)
	updateLeader()
	if ReplicatedStorage:GetAttribute("State") == "Playing" and score >= (ReplicatedStorage:GetAttribute("ScoreToWin") or math.huge) then
		roundOver = true
	end
end

---------------------------------------------------------------------------
-- Equipos
---------------------------------------------------------------------------

-- Amigos de Roblox de player que hay en ese equipo
local function friendsIn(team, player)
	local count = 0
	for _, p in team:GetPlayers() do
		if p ~= player and Friends.AreFriends(player, p) then
			count += 1
		end
	end
	return count
end

-- El equipo con menos jugadores (sin contar a exclude). Si empatan, el que tiene amigos suyos
-- (los amigos juegan juntos) y si no, al azar.
local function smallestTeam(exclude)
	local best, bestCount, bestFriends = nil, math.huge, -1
	for _, team in teams do
		local count = 0
		for _, p in team:GetPlayers() do
			if p ~= exclude then
				count += 1
			end
		end
		local friends = exclude and friendsIn(team, exclude) or 0
		if count < bestCount or (count == bestCount and (friends > bestFriends or (friends == bestFriends and math.random() < 0.5))) then
			best, bestCount, bestFriends = team, count, friends
		end
	end
	return best
end

local function assignTeam(player)
	-- Infección: quien entra antes de la infección es superviviente; después, zombi
	local infection = ReplicatedStorage:GetAttribute("Infection")
	if infection then
		player.Neutral = false
		player.Team = infection == "On" and teams[2] or teams[1]
		if infection == "On" then
			player:SetAttribute("InfZombieStart", true)
		end
		return
	end
	if isTeamMode() then
		player.Neutral = false
		player.Team = smallestTeam(player)
	else
		player.Team = nil
		player.Neutral = true
	end
end

local function balanceTeams()
	-- Infección: todos empiezan como supervivientes
	if ReplicatedStorage:GetAttribute("Infection") then
		for _, player in Players:GetPlayers() do
			player.Neutral = false
			player.Team = teams[1]
		end
		return
	end
	if not isTeamMode() then
		for _, player in Players:GetPlayers() do
			player.Team = nil
			player.Neutral = true
		end
		return
	end
	for _, player in Players:GetPlayers() do
		if not player.Team then
			player.Neutral = false
			player.Team = smallestTeam(player)
		end
	end
	local a, b = teams[1], teams[2]
	-- Amigos separados: se intercambian con alguien del otro equipo que no tenga amigos allí (los
	-- tamaños no cambian)
	for _, p in Players:GetPlayers() do
		local mine = p.Team
		local other = mine == a and b or (mine == b and a or nil)
		if other and friendsIn(mine, p) == 0 and friendsIn(other, p) > 0 then
			for _, q in other:GetPlayers() do
				if not Friends.AreFriends(q, p) and friendsIn(other, q) == 0 then
					p.Team, q.Team = other, mine
					break
				end
			end
		end
	end
	while math.abs(#a:GetPlayers() - #b:GetPlayers()) > 1 do
		local big = #a:GetPlayers() > #b:GetPlayers() and a or b
		local small = big == a and b or a
		-- (se cambia preferiblemente a quien tiene menos amigos en su equipo)
		local list = big:GetPlayers()
		local pick, pickFriends = nil, math.huge
		for _, p in list do
			local friends = friendsIn(big, p) - friendsIn(small, p) + math.random() * 0.5
			if friends < pickFriends then
				pick, pickFriends = p, friends
			end
		end
		pick.Team = small
	end
end

local function resetStats()
	for _, player in Players:GetPlayers() do
		local stats = PlayerData.GetLeaderstats(player)
		stats.Bajas.Value = 0
		stats.Muertes.Value = 0
		player:SetAttribute("Streak", 0)
		player:SetAttribute("StreakPlayers", 0)
		streakVictims[player] = nil
		player:SetAttribute("BestStreak", 0)
		Bounty.Reset(player)
		player:SetAttribute("Captures", 0)
		player:SetAttribute("Score", 0)
		player:SetAttribute("GunLevel", 1)
		-- Participación para el rango: desde cuándo juega esta partida (Loadout lo pone al salir del menú)
		player:SetAttribute("MatchJoinedAt", if player:GetAttribute("InMenu") then nil else workspace:GetServerTimeNow())
		player:SetAttribute("ElimPlayed", nil)
		player:SetAttribute("InfZombieStart", nil)
		player:SetAttribute("LastKiller", nil)
		PlayerData.StartMatch(player)
	end
	Killstreaks.Reset()
	Grenades.Reset()
	firstBlood = false
	for _, team in teams do
		ReplicatedStorage:SetAttribute("Score_" .. team.Name, 0)
	end
	updateLeader()
end

---------------------------------------------------------------------------
-- Escalada de armas
---------------------------------------------------------------------------

local function gunGameWeapons(player)
	local order = Weapons.GunGameOrder
	local level = math.clamp(player:GetAttribute("GunLevel") or 1, 1, #order)
	local weapon = order[level]
	if weapon == Weapons.Melee then
		return { weapon }
	end
	return { weapon, Weapons.Melee }
end

local function gunGameKill(killer, victim, weaponName)
	local order = Weapons.GunGameOrder
	local level = (killer:GetAttribute("GunLevel") or 1) + 1
	killer:SetAttribute("GunLevel", level)
	killer:SetAttribute("Score", level - 1)
	updateLeader()
	if level > #order then
		roundOver = true
		return
	end
	Remotes.Notify:FireClient(killer, "Info", "Nueva arma: " .. Weapons.Get(order[level]).DisplayName)
	Loadout.Give(killer, gunGameWeapons(killer))
	-- Humillación: una baja con cuchillo hace bajar un nivel a la víctima
	if victim and weaponName == Weapons.Melee then
		local vLevel = math.max(1, (victim:GetAttribute("GunLevel") or 1) - 1)
		victim:SetAttribute("GunLevel", vLevel)
		victim:SetAttribute("Score", vLevel - 1)
		Remotes.Notify:FireClient(victim, "Info", "¡Te han bajado de nivel con el cuchillo!")
	end
end

---------------------------------------------------------------------------
-- Bajas
---------------------------------------------------------------------------

-- killerBot / victimBot: el bot (ver Bots) cuando quien hace la baja o quien muere es un bot
-- Medalla de baja: aviso y XP (scale: menos contra bots)
local function medal(player, id, scale)
	local def = GameConfig.Medals and GameConfig.Medals[id]
	if def then
		Remotes.Notify:FireClient(player, "Medal", def.Text)
		PlayerData.AddXP(player, math.max(1, math.floor(def.XP * scale)), def.Name)
	end
end

-- Medallas que gana un jugador con esta baja
local function awardMedals(killer, victimName, victimStreak, weaponName, position, scale)
	local medals = GameConfig.Medals or {}
	if not firstBlood then
		firstBlood = true
		medal(killer, "FirstBlood", scale)
	end
	-- (no en un intercambio: si los dos caen a la vez no es venganza)
	if victimName and killer:GetAttribute("LastKiller") == victimName and os.clock() - (killer:GetAttribute("LastKilledAt") or 0) >= 1 then
		killer:SetAttribute("LastKiller", nil)
		medal(killer, "Revenge", scale)
	end
	if medals.StreakEnder and victimStreak >= medals.StreakEnder.Streak then
		medal(killer, "StreakEnder", scale)
	end
	local character = killer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 then
		medal(killer, "Afterlife", scale)
	elseif root and typeof(position) == "Vector3" and medals.LongShot then
		local weapon = weaponName and Weapons.Get(weaponName)
		if weapon and not weapon.Explosive and weapon.Type ~= "Melee" and (root.Position - position).Magnitude >= medals.LongShot.Distance then
			medal(killer, "LongShot", scale)
		end
	end
end

function Round.RegisterKill(killer, victim, victimName, weaponName, headshot, position, killerBot, victimBot)
	local bounty = 0
	-- (la racha que llevaba el caído, antes de ponerla a 0: para la medalla Cazarrachas)
	local victimStreak = (victim and victim:GetAttribute("Streak")) or (victimBot and victimBot.Streak) or 0
	-- Para la medalla Venganza: quién eliminó a este jugador la última vez
	if victim then
		local by = (killer and killer ~= victim and killer.Name) or (killerBot and killerBot.Name) or nil
		victim:SetAttribute("LastKiller", by)
		victim:SetAttribute("LastKilledAt", os.clock())
	end
	if victim then
		PlayerData.GetLeaderstats(victim).Muertes.Value += 1
		PlayerData.Increment(victim, "TotalDeaths", 1)
		bounty = Bounty.Clear(victim)
		-- (si casi toda la racha fue contra bots, la recompensa vale menos: no se puede inflar
		-- matando bots para que un amigo la cobre)
		if bounty > 0 and (victim:GetAttribute("StreakPlayers") or 0) < 3 then
			bounty = math.max(1, math.floor(bounty * GameConfig.Bots.RewardScale))
		end
		victim:SetAttribute("Streak", 0)
		victim:SetAttribute("StreakPlayers", 0)
		streakVictims[victim] = nil
	end
	local playing = ReplicatedStorage:GetAttribute("State") == "Playing"

	local killerColor, victimColor = Color3.new(1, 1, 1), Color3.new(1, 1, 1)
	if victim and victim.Team then
		victimColor = victim.TeamColor.Color
	elseif victimBot and victimBot.Team then
		victimColor = victimBot.Team.TeamColor.Color
	end

	if victimBot then
		Bots.AddStat(victimBot, "Deaths", 1)
		victimBot.Streak = 0
	end
	-- Racha del bot (sin morir): con 3 bajas su equipo tiene radar (no los zombis)
	if killerBot and killerBot ~= victimBot and playing and not killerBot.Zombie then
		killerBot.Streak = (killerBot.Streak or 0) + 1
		if Killstreaks.OnBotStreak(killerBot.Name, killerBot.Team, killerBot.Streak) then
			Bots.Radar(Bots.RadarKey(killerBot), Killstreaks.RadarTime)
		end
	end
	-- Un bot hace una baja: punto para su equipo (en equipos) o para él (todos contra todos)
	if killerBot then
		Bots.AddStat(killerBot, "Kills", 1)
		if playing then
			firstBlood = true -- (la primera sangre de un bot cuenta: ya no la gana nadie más)
		end
		if killerBot.Team then
			killerColor = killerBot.Team.TeamColor.Color
			if playing and currentMode == "TDM" then
				addScore(killerBot.Team, 1)
			end
		elseif playing and currentMode == "FFA" then
			killerBot.Score = (killerBot.Score or 0) + 1
			Bots.AddStat(killerBot, "Score", 1)
			updateLeader()
			if killerBot.Score >= (ReplicatedStorage:GetAttribute("ScoreToWin") or math.huge) then
				roundOver = true
			end
		end
	end

	if killer and killer ~= victim then
		if killer.Team then
			killerColor = killer.TeamColor.Color
		end
		if victim or victimBot then
			-- Contra bots: misma emoción (marcador, racha, retos, maestría) pero menos XP y monedas,
			-- y no cuentan para la clasificación global
			local botScale = victimBot and GameConfig.Bots.RewardScale or 1
			PlayerData.GetLeaderstats(killer).Bajas.Value += 1
			local streak = (killer:GetAttribute("Streak") or 0) + 1
			killer:SetAttribute("Streak", streak)
			if victim then
				local seen = streakVictims[killer] or {}
				streakVictims[killer] = seen
				if not seen[victim.UserId] then
					seen[victim.UserId] = true
					killer:SetAttribute("StreakPlayers", (killer:GetAttribute("StreakPlayers") or 0) + 1)
				end
			end
			if streak > (killer:GetAttribute("BestStreak") or 0) then
				killer:SetAttribute("BestStreak", streak)
			end

			if playing then
				if currentMode == "TDM" then
					addScore(killer.Team, 1)
				elseif currentMode == "FFA" then
					addPlayerScore(killer, 1)
				elseif currentMode == "GUN" then
					-- (también cuentan las bajas a bots: así se puede jugar solo)
					gunGameKill(killer, victim, weaponName)
				end
			end

			local xp = GameConfig.XP.Kill + GameConfig.XP.StreakBonus * (streak - 1)
			if headshot then
				xp += GameConfig.XP.Headshot
			end
			PlayerData.AddXP(killer, math.floor(xp * botScale), headshot and "Disparo a la cabeza" or "Eliminación")
			if playing then
				awardMedals(killer, victimName, victimStreak, weaponName, position, botScale)
			end
			PlayerData.AddCoins(killer, math.max(1, math.floor(GameConfig.Coins.Kill * botScale)))
			if victim then
				PlayerData.Increment(killer, "TotalKills", 1)
			end
			PlayerData.AddWeaponKill(killer, weaponName)
			PlayerData.Track(killer, "Kill", 1, weaponName)
			PlayerData.Track(killer, "Streak", streak)
			PlayerData.SetBest(killer, "BestStreak", streak)
			if headshot then
				PlayerData.Increment(killer, "Headshots", 1)
				PlayerData.Track(killer, "Headshot", 1, weaponName)
			end

			if STREAK_ANNOUNCE[streak] then
				Remotes.Notify:FireAllClients("Streak", killer.Name .. " tiene una racha de " .. streak .. " bajas")
			end
			Killstreaks.OnStreak(killer, streak)
			-- (el radar de un jugador también lo usan los bots de su equipo)
			if streak == Killstreaks.RadarStreak and killer.Team and isTeamMode()
				and currentMode ~= "GUN" and not (killer.Character and killer.Character:GetAttribute("Zombie")) then
				Bots.Radar(killer.Team.Name, Killstreaks.RadarTime)
			end
			-- (los zombis de la Infección no tienen recompensa por su cabeza)
			if not (ReplicatedStorage:GetAttribute("Infection") == "On" and killer.Team == teams[2]) then
				Bounty.OnStreak(killer, streak)
			end
		end
	end

	-- "SE BUSCA": quien elimina al buscado cobra su recompensa (si lo mata un bot o muere solo, se pierde)
	if bounty > 0 and victim then
		if killer and killer ~= victim then
			local given = PlayerData.AddCoins(killer, bounty, false) -- (premio fijo: no lo multiplican VIP ni amigos)
			PlayerData.AddXP(killer, GameConfig.Bounty.XP or 0, "Recompensa cobrada")
			Remotes.Notify:FireClient(killer, "BountyClaimed", given)
			Bounty.Announce(victim.Name, bounty, killer.Name)
		else
			Bounty.Announce(victim.Name, bounty, nil)
		end
	end

	-- Efecto de eliminación: el que tenga equipado quien ha hecho la baja (o el normal)
	if typeof(position) == "Vector3" then
		local effect = "Default"
		local killerData = killer and killer ~= victim and PlayerData.Get(killer)
		if killerData and killerData.EquippedKillEffect then
			effect = killerData.EquippedKillEffect
		end
		-- Los muñecos (sin jugador ni equipo) estallan en amarillo, como antes
		local burstColor = (victim or (victimBot and victimBot.Team)) and victimColor or Color3.fromRGB(255, 200, 60)
		Remotes.KillFX:FireAllClients(position, effect, burstColor)
	end

	local weapon = weaponName and Weapons.Get(weaponName)
	Remotes.KillFeed:FireAllClients({
		Killer = (killer and killer.Name) or (killerBot and killerBot.Name) or nil,
		KillerColor = killerColor,
		Victim = victimName,
		VictimColor = victimColor,
		Weapon = weapon and weapon.DisplayName or "",
		WeaponId = weapon and weaponName or nil, -- (el cliente dibuja la silueta del arma)
		Headshot = headshot,
	})
	-- Botín: a veces el caído suelta un paquete para quien le eliminó (no en Calabazas: ya sueltan algo)
	-- (solo bajas a jugadores o bots de verdad: los muñecos de práctica no cuentan)
	if playing and currentMode ~= "CAL" and killer and killer ~= victim and (victim or victimBot) and typeof(position) == "Vector3" then
		Loot.MaybeDrop(position, killer, victimBot ~= nil)
	end
	-- Calabazas: el caído suelta una calabaza con el color de su equipo
	-- (solo si alguien le eliminó: caerse o la lava no regala puntos al rival)
	if playing and currentMode == "CAL" and typeof(position) == "Vector3" and ((killer and killer ~= victim) or killerBot) then
		local team = (victim and victim.Team) or (victimBot and victimBot.Team)
		Pumpkins.Drop(position, team, victim and victim.UserId or nil, victimBot ~= nil)
	end
	-- Infección: el superviviente que cae se convierte en zombi en el acto (antes de que pueda revivir)
	if ReplicatedStorage:GetAttribute("Infection") == "On" and onInfectionDeath then
		onInfectionDeath(victim, victimBot)
	end
end

-- Asistencias (ver Combat): XP y monedas a quien ayudó a eliminar (menos si la víctima era un bot)
function Round.RegisterAssist(helpers, victimName, victimBot, victimPlayer)
	if not victimBot and not victimPlayer then
		return -- (los muñecos de práctica no dan asistencias)
	end
	local scale = victimBot and GameConfig.Bots.RewardScale or 1
	for _, helper in helpers do
		PlayerData.AddXP(helper, math.floor((GameConfig.XP.Assist or 0) * scale), "Asistencia")
		PlayerData.AddCoins(helper, math.max(1, math.floor((GameConfig.Coins.Assist or 0) * scale)))
		PlayerData.Increment(helper, "Assists", 1)
		Remotes.Notify:FireClient(helper, "Assist", tostring(victimName or ""))
	end
end

---------------------------------------------------------------------------
-- Aparición libre (FFA / Escalada): el punto más alejado de los demás
---------------------------------------------------------------------------

local ffaCache = { Map = nil, Points = {} }
local spawnedThisRound = {} -- [player] = true: ya apareció en esta ronda (la siguiente vez, dinámica)

local function ffaSpawnFor(player, character)
	if isTeamMode() then
		-- Por equipos: la primera vez en la base; al reaparecer, en el punto más seguro (SpawnPicker)
		local first = not spawnedThisRound[player]
		if ReplicatedStorage:GetAttribute("State") == "Playing" then
			spawnedThisRound[player] = true
		end
		if first or not SpawnPicker.Enabled() then
			return
		end
		local point = SpawnPicker.Pick(player.Team, character)
		local root = point and character:WaitForChild("HumanoidRootPart", 5)
		if root then
			task.wait()
			character:PivotTo(CFrame.new(point + Vector3.new(0, 3, 0)) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
		end
		return
	end
	local map = workspace:FindFirstChild("Map")
	if not map then
		return
	end
	-- Puntos libres del mapa (se guardan mientras no cambie el mapa)
	if ffaCache.Map ~= map then
		ffaCache.Map, ffaCache.Points = map, {}
		for _, d in map:GetDescendants() do
			if d:IsA("BasePart") and d.Name == "FFASpawn" then
				table.insert(ffaCache.Points, d)
			end
		end
	end
	local points = ffaCache.Points
	if #points == 0 then
		return
	end
	-- Lejos de los demás jugadores y de los bots
	local others = {}
	for _, p in Players:GetPlayers() do
		local root = p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if root then
			table.insert(others, root.Position)
		end
	end
	for _, agent in Bots.Agents do
		if agent.Root and agent.Root.Parent then
			table.insert(others, agent.Root.Position)
		end
	end
	local best, bestDistance = points[math.random(1, #points)], -1
	for _, point in points do
		local nearest = math.huge
		for _, pos in others do
			nearest = math.min(nearest, (pos - point.Position).Magnitude)
		end
		nearest += math.random() * 10 -- un poco de azar entre puntos parecidos
		if nearest > bestDistance then
			best, bestDistance = point, nearest
		end
	end
	local root = character:WaitForChild("HumanoidRootPart", 5)
	if root then
		task.wait()
		character:PivotTo(CFrame.new(best.Position + Vector3.new(0, 3, 0)) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	end
end

---------------------------------------------------------------------------
-- Votación de mapa + modo
---------------------------------------------------------------------------

local function availableModes(mapId)
	local list = {}
	local def = MapBuilder.Get(mapId)
	for _, mode in GameConfig.Modes do
		-- (Buscar y destruir, solo en los mapas con sitios para la bomba)
		if GameConfig.ModeSettings[mode] and (mode ~= "SND" or (def and def.Bomb)) then
			table.insert(list, mode)
		end
	end
	if #list == 0 then
		table.insert(list, GameConfig.Modes[1] or "TDM")
	end
	return list
end

local function makeVoteOptions()
	local maps = {}
	for _, id in MapBuilder.Order do
		if MapBuilder.InSeason(id) then -- (los mapas de temporada, solo en su evento)
			table.insert(maps, id)
		end
	end
	if MapBuilder.IsCustom() then
		maps = { "Custom" }
	end
	-- Prioriza mapas distintos al actual
	for i = #maps, 2, -1 do
		local j = math.random(1, i)
		maps[i], maps[j] = maps[j], maps[i]
	end
	table.sort(maps, function(a, b)
		return (a ~= MapBuilder.Current and 0 or 1) < (b ~= MapBuilder.Current and 0 or 1)
	end)
	-- Siempre hay un mapa de 5 contra 5 estilo shooter militar (Encrucijada, Base Militar...) en la
	-- votación, con Duelo por equipos o Dominio (GameConfig.VoteRealisticMap)
	local realisticFirst = false
	if GameConfig.VoteRealisticMap ~= false then
		for i, id in maps do
			local def = MapBuilder.Get(id)
			if def and def.Realistic then
				table.insert(maps, 1, table.remove(maps, i))
				realisticFirst = true
				break
			end
		end
	end
	local options = {}
	local usedModes = {}
	for i = 1, 3 do
		local mapId = maps[((i - 1) % #maps) + 1]
		local modes = availableModes(mapId)
		if i == 1 and realisticFirst then
			local classic = {}
			for _, mode in modes do
				if mode == "TDM" or mode == "DOM" or mode == "SND" then
					table.insert(classic, mode)
				end
			end
			if #classic > 0 then
				modes = classic
			end
		end
		local mode = modes[math.random(1, #modes)]
		for _ = 1, 6 do
			if not usedModes[mode] then
				break
			end
			mode = modes[math.random(1, #modes)]
		end
		usedModes[mode] = true
		table.insert(options, { Map = mapId, Mode = mode })
	end
	return options
end

local function publishVotes()
	local counts = { 0, 0, 0 }
	for _, choice in votes do
		counts[choice] = (counts[choice] or 0) + 1
	end
	for i, option in voteOptions do
		local def = MapBuilder.Get(option.Map)
		ReplicatedStorage:SetAttribute("Vote" .. i .. "_Map", def and ((def.Icon and def.Icon .. " " or "") .. def.Name) or "Mapa propio")
		ReplicatedStorage:SetAttribute("Vote" .. i .. "_Mode", modeName(option.Mode))
		ReplicatedStorage:SetAttribute("Vote" .. i .. "_Count", counts[i])
	end
	return counts
end

local function clearVotes()
	for i = 1, 3 do
		ReplicatedStorage:SetAttribute("Vote" .. i .. "_Map", nil)
		ReplicatedStorage:SetAttribute("Vote" .. i .. "_Mode", nil)
		ReplicatedStorage:SetAttribute("Vote" .. i .. "_Count", nil)
	end
end

---------------------------------------------------------------------------
-- Ciclo de rondas
---------------------------------------------------------------------------

local function countdown(seconds, stopWhen)
	for t = seconds, 0, -1 do
		ReplicatedStorage:SetAttribute("TimeLeft", t)
		if stopWhen and stopWhen() then
			return
		end
		task.wait(1)
	end
end

local function respawnAll()
	for _, player in Players:GetPlayers() do
		task.spawn(Respawn.Load, player) -- con la protección contra cargas dobles
	end
end

local function isDeadPlayer(player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	return not humanoid or humanoid.Health <= 0
end

---------------------------------------------------------------------------
-- Infección (INF): supervivientes (equipo A) contra zombis (equipo B)
---------------------------------------------------------------------------

-- Los zombis solo llevan garras; los supervivientes, sus armas de siempre
local function infectionLoadout(player)
	if ReplicatedStorage:GetAttribute("Infection") == "On" and player.Team == teams[2] then
		return { "Claws" }
	end
	return nil
end

-- Aspecto de zombi al aparecer (después de cargar la ropa del avatar, que si no lo taparía)
local function zombify(player, character)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid or player.Character ~= character then
		return
	end
	Zombie.Apply(character, settings("INF").ZombieHealth)
	local started = os.clock()
	while not player:HasAppearanceLoaded() and os.clock() - started < 5 do
		task.wait(0.2)
	end
	if player.Character == character then
		Zombie.Apply(character, nil)
	end
end

-- Convierte en zombi a un jugador. Si sigue vivo (paciente cero) reaparece ya como zombi.
local function infectPlayer(player, announce)
	if player.Team == teams[2] then
		return
	end
	player.Neutral = false
	player.Team = teams[2]
	player:SetAttribute("Airstrikes", 0) -- (los zombis no tienen recompensas por racha)
	player:SetAttribute("Streak", 0)
	player:SetAttribute("StreakPlayers", 0)
	streakVictims[player] = nil
	player:SetAttribute("RadarUntil", 0)
	Bounty.Reset(player)
	if announce then
		Remotes.Notify:FireAllClients("Streak", "🧟 " .. player.Name .. " se ha convertido en zombi")
	end
	if not isDeadPlayer(player) and not player:GetAttribute("InMenu") then
		task.spawn(Respawn.Load, player)
	end
end

local function infectionCounts()
	local survivors, zombies = 0, 0
	for _, player in Players:GetPlayers() do
		if not player:GetAttribute("InMenu") then
			if player.Team == teams[1] then
				local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
				if Respawn.IsLoading(player) or (humanoid and humanoid.Health > 0) then
					survivors += 1
				end
			elseif player.Team == teams[2] then
				zombies += 1
			end
		end
	end
	for _, agent in Bots.Agents do
		if agent.Team == teams[1] then
			if agent.Spawning or (agent.Humanoid and agent.Humanoid.Health > 0) then
				survivors += 1
			end
		elseif agent.Team == teams[2] then
			zombies += 1
		end
	end
	return survivors, zombies
end

-- Elige pacientes cero al azar entre los supervivientes (jugadores fuera del menú y bots)
local function infectRandom(count)
	local pool = {}
	for _, player in Players:GetPlayers() do
		if player.Team == teams[1] and not player:GetAttribute("InMenu") then
			table.insert(pool, player)
		end
	end
	for _, agent in Bots.Agents do
		if agent.Team == teams[1] and agent.Humanoid then
			table.insert(pool, agent)
		end
	end
	local infected = 0
	for _ = 1, math.min(count, #pool - 1) do
		local chosen = table.remove(pool, math.random(1, #pool))
		infected += 1
		if typeof(chosen) == "Instance" then
			chosen:SetAttribute("InfZombieStart", true)
			infectPlayer(chosen, true)
		else
			Bots.Infect(chosen, teams[2])
			Remotes.Notify:FireAllClients("Streak", "🧟 " .. chosen.Name .. " se ha convertido en zombi")
		end
	end
	return infected
end

onInfectionDeath = function(victim, victimBot)
	if victim and victim.Team == teams[1] then
		infectPlayer(victim, true)
	elseif victimBot and victimBot.Team == teams[1] then
		Bots.Infect(victimBot, teams[2])
		Remotes.Notify:FireAllClients("Streak", "🧟 " .. victimBot.Name .. " se ha convertido en zombi")
	end
end

local function infectionRound(s)
	local a, b = teams[1], teams[2]
	-- Preparación: todos son supervivientes y se reparten por el mapa
	for t = s.PrepTime, 1, -1 do
		ReplicatedStorage:SetAttribute("TimeLeft", t)
		if t == s.PrepTime or t <= 3 then
			Remotes.Notify:FireAllClients("Big", "🧟 La infección empieza en " .. t .. "…")
		end
		local survivors = infectionCounts()
		ReplicatedStorage:SetAttribute("AliveA", survivors)
		ReplicatedStorage:SetAttribute("AliveB", 0)
		task.wait(1)
	end
	ReplicatedStorage:SetAttribute("Infection", "On")
	-- Quien sigue en la pantalla de inicio no es superviviente: si entra, lo hará como zombi
	for _, player in Players:GetPlayers() do
		if player.Team == a and player:GetAttribute("InMenu") then
			player.Team = b
			player:SetAttribute("InfZombieStart", true)
		end
	end
	local survivors = infectionCounts()
	if infectRandom(math.max(1, math.floor(survivors / (s.ZombieRatio or 5)))) == 0 then
		Remotes.Notify:FireAllClients("Big", "Hacen falta al menos 2 jugadores para la infección")
		task.wait(2)
		return
	end
	Remotes.Notify:FireAllClients("Big", "🧟 ¡HAN LLEGADO LOS ZOMBIS! ¡Sobrevive!")
	local roundEnd = os.clock() + s.RoundTime
	local winner
	local lastAnnounced = false
	while not roundOver do
		-- Los supervivientes que caen (por lo que sea) se convierten en zombis; quien vuelve al menú
		-- deja de ser superviviente
		for _, player in Players:GetPlayers() do
			if player.Team == a then
				if player:GetAttribute("InMenu") then
					infectPlayer(player, false)
				elseif not Respawn.IsLoading(player) and isDeadPlayer(player) then
					infectPlayer(player, true)
				end
			end
		end
		for _, agent in table.clone(Bots.Agents) do
			if agent.Team == a and not agent.Humanoid and not agent.Spawning then
				Bots.Infect(agent, b)
			end
		end
		local alive, zombies = infectionCounts()
		-- ¡Último superviviente! Se anuncia y recibe más vida para el final
		if alive == 1 and not lastAnnounced then
			lastAnnounced = true
			for _, player in Players:GetPlayers() do
				local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
				if player.Team == a and not player:GetAttribute("InMenu") and humanoid and humanoid.Health > 0 then
					humanoid.MaxHealth = 150
					humanoid.Health = 150
					Remotes.Notify:FireAllClients("Big", "🧑 ¡" .. string.upper(player.Name) .. " ES EL ÚLTIMO SUPERVIVIENTE!")
				end
			end
			for _, agent in Bots.Agents do
				if agent.Team == a and agent.Humanoid and agent.Humanoid.Health > 0 then
					agent.Humanoid.MaxHealth = 150
					agent.Humanoid.Health = 150
					Remotes.Notify:FireAllClients("Big", "🧑 ¡" .. string.upper(agent.Name) .. " ES EL ÚLTIMO SUPERVIVIENTE!")
				end
			end
		end
		ReplicatedStorage:SetAttribute("AliveA", alive)
		ReplicatedStorage:SetAttribute("AliveB", zombies)
		ReplicatedStorage:SetAttribute("TimeLeft", math.max(0, math.ceil(roundEnd - os.clock())))
		if alive == 0 then
			winner = b
			break
		elseif zombies == 0 and alive >= 2 then
			-- Se fueron todos los zombis: nuevo paciente cero
			infectRandom(1)
		end
		if os.clock() >= roundEnd then
			winner = a
			break
		end
		task.wait(0.25)
	end
	if winner then
		addScore(winner, 1)
		Remotes.Notify:FireAllClients("Big", winner == a and "🧑 ¡GANAN LOS SUPERVIVIENTES!" or "🧟 ¡GANAN LOS ZOMBIS!")
		task.wait(2)
	end
end

-- Limpia el estado de Infección (al acabar o si la ronda falla)
local function clearInfection()
	ReplicatedStorage:SetAttribute("Infection", nil)
	ReplicatedStorage:SetAttribute("AliveA", nil)
	ReplicatedStorage:SetAttribute("AliveB", nil)
end

---------------------------------------------------------------------------
-- Eliminación (ELIM)
---------------------------------------------------------------------------

-- Vivos y participantes de un equipo (jugadores fuera del menú + bots)
-- Vivos y participantes de un equipo. Solo cuentan los jugadores que empezaron la ronda (atributo
-- ElimIn) y los bots; un bot que aún se está creando cuenta como vivo.
local function aliveCount(team)
	local alive, members = 0, 0
	for _, player in team:GetPlayers() do
		if player:GetAttribute("ElimIn") then
			members += 1
			-- Quien vuelve al menú no cuenta como vivo (si no, su equipo no se podría eliminar);
			-- quien está reapareciendo justo al empezar, sí
			local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if not player:GetAttribute("InMenu") and (Respawn.IsLoading(player) or (humanoid and humanoid.Health > 0)) then
				alive += 1
			end
		end
	end
	for _, agent in Bots.Agents do
		if agent.Team == team then
			members += 1
			if agent.Spawning or (agent.Humanoid and agent.Humanoid.Health > 0) then
				alive += 1
			end
		end
	end
	return alive, members
end

-- Limpia el estado de Eliminación (al acabar o si la ronda falla)
local function clearElimination()
	Bomb.Stop()
	ReplicatedStorage:SetAttribute("NoRespawn", false)
	ReplicatedStorage:SetAttribute("Frozen", false)
	ReplicatedStorage:SetAttribute("AliveA", nil)
	ReplicatedStorage:SetAttribute("AliveB", nil)
	for _, player in Players:GetPlayers() do
		player:SetAttribute("ElimIn", nil)
	end
end

-- Rondas de una vida hasta que un equipo llegue a ScoreToWin rondas ganadas (o se acabe el tiempo total)
local MIN_SUBROUND = 20 -- no se empieza una ronda si quedan menos segundos que esto (más la preparación)
-- Buscar y destruir (SND) usa las mismas rondas con la bomba: atacan y defienden por turnos
local function eliminationRounds(s)
	local deadline = os.clock() + s.RoundTime
	local number = 0
	local a, b = teams[1], teams[2]
	local snd = currentMode == "SND"
	while not roundOver and deadline - os.clock() >= s.PrepTime + MIN_SUBROUND do
		number += 1
		local attackers = number % 2 == 1 and a or b
		local defenders = attackers == a and b or a
		-- Preparación: todos vuelven a su base con la vida llena y quietos (no se puede disparar)
		ReplicatedStorage:SetAttribute("Frozen", true)
		ReplicatedStorage:SetAttribute("NoRespawn", false)
		for _, player in Players:GetPlayers() do
			player:SetAttribute("ElimIn", nil)
		end
		-- (sin contador de vivos durante la preparación)
		ReplicatedStorage:SetAttribute("AliveA", nil)
		ReplicatedStorage:SetAttribute("AliveB", nil)
		respawnAll()
		Bots.RespawnAll()
		Remotes.Notify:FireAllClients("Big", "RONDA " .. number .. " · ¡Una sola vida!")
		countdown(s.PrepTime)
		-- Que nadie empiece muerto (p. ej. un bot que aún se estaba creando o alguien que cayó en la preparación)
		local waitUntil = os.clock() + 5
		while os.clock() < waitUntil do
			local spawning = false
			for _, agent in Bots.Agents do
				spawning = spawning or agent.Spawning == true
			end
			if not spawning then
				break
			end
			task.wait(0.2)
		end
		for _, player in Players:GetPlayers() do
			if not player:GetAttribute("InMenu") then
				if isDeadPlayer(player) then
					task.spawn(Respawn.Load, player)
				end
				player:SetAttribute("ElimIn", true) -- participa en esta ronda
				player:SetAttribute("ElimPlayed", true)
			end
		end
		Bots.RespawnDead()
		ReplicatedStorage:SetAttribute("NoRespawn", true)
		ReplicatedStorage:SetAttribute("Frozen", false)
		if snd and Bomb.Start(attackers, defenders) then
			-- Cada equipo sabe qué le toca
			for _, player in Players:GetPlayers() do
				if player.Team == attackers then
					Remotes.Notify:FireClient(player, "Big", "💣 ATACAS: planta la bomba en A o B")
				elseif player.Team == defenders then
					Remotes.Notify:FireClient(player, "Big", "🛡️ DEFIENDES: protege A y B")
				end
			end
		else
			snd = false -- (sin sitios en el mapa: como Eliminación)
			Remotes.Notify:FireAllClients("Big", "¡YA!")
		end
		task.wait(0.5)

		local roundEnd = math.min(os.clock() + s.SubRoundTime, deadline)
		local winner, decided = nil, false
		while not roundOver do
			local aliveA, membersA = aliveCount(a)
			local aliveB, membersB = aliveCount(b)
			ReplicatedStorage:SetAttribute("AliveA", aliveA)
			ReplicatedStorage:SetAttribute("AliveB", aliveB)
			ReplicatedStorage:SetAttribute("TimeLeft", math.max(0, math.ceil(roundEnd - os.clock())))
			local contest = membersA > 0 and membersB > 0
			if snd then
				-- Bomba: explota = atacantes; desactivada = defensores. Sin bomba plantada, si caen todos
				-- los atacantes o se acaba el tiempo, ganan los defensores; si caen todos los defensores,
				-- los atacantes. Con la bomba plantada, los defensores tienen que desactivarla.
				local aliveAtt = attackers == a and aliveA or aliveB
				local aliveDef = attackers == a and aliveB or aliveA
				if Bomb.Planted then
					ReplicatedStorage:SetAttribute("TimeLeft", ReplicatedStorage:GetAttribute("Bomb_Timer") or 0)
				end
				local result = nil
				if Bomb.Result == "Exploded" then
					result = attackers
				elseif Bomb.Result == "Defused" then
					result = defenders
				elseif contest and aliveDef == 0 then
					result = attackers
				elseif contest and aliveAtt == 0 and not Bomb.Planted then
					result = defenders
				elseif not Bomb.Planted and os.clock() >= roundEnd then
					result = defenders
				elseif Bomb.Planted and os.clock() >= roundEnd + (s.BombTime or 35) + 5 then
					result = defenders -- (por si la bomba dejara de contar: la ronda nunca se queda colgada)
				end
				if result or (not contest and os.clock() >= roundEnd) then
					winner = contest and result or nil
					decided = true
					break
				end
				task.wait(0.25)
				continue
			end
			-- Solo hay ronda si los dos equipos tienen a alguien
			if contest and (aliveA == 0 or aliveB == 0) then
				winner = (aliveA > 0 and a) or (aliveB > 0 and b) or nil
				decided = true
				break
			end
			if os.clock() >= roundEnd then
				-- Se acaba el tiempo: gana el equipo con más supervivientes (sin rival no gana nadie)
				winner = contest and ((aliveA > aliveB and a) or (aliveB > aliveA and b)) or nil
				decided = true
				break
			end
			task.wait(0.25)
		end
		Bomb.Stop()
		if decided then
			if winner then
				addScore(winner, 1)
				Remotes.Notify:FireAllClients("Big", "¡RONDA PARA " .. string.upper(winner.Name) .. "!")
			else
				Remotes.Notify:FireAllClients("Big", "RONDA EMPATADA")
			end
			task.wait(3)
		end
	end
	clearElimination()
	-- Nadie se queda muerto durante la pantalla final
	respawnAll()
end

-- Los 3 mejores de la partida (jugadores y bots, por bajas y luego menos muertes), para el podio
-- de la pantalla final. Hay que calcularlo antes de cambiar de estado: al cambiar, los bots se quitan
local function topPlayers()
	local list = {}
	for _, player in Players:GetPlayers() do
		local stats = PlayerData.GetLeaderstats(player)
		local kills, deaths = stats.Bajas.Value, stats.Muertes.Value
		if not player:GetAttribute("InMenu") or kills + deaths > 0 then
			table.insert(list, { Name = tostring(player.DisplayName), Kills = kills, Deaths = deaths, Team = player.Team and player.Team.Name or nil })
		end
	end
	local botStats = ReplicatedStorage:FindFirstChild("BotStats")
	if botStats then
		for _, entry in botStats:GetChildren() do
			table.insert(list, {
				Name = entry.Name,
				Kills = entry:GetAttribute("Kills") or 0,
				Deaths = entry:GetAttribute("Deaths") or 0,
				Team = entry:GetAttribute("Team"),
				Bot = true,
			})
		end
	end
	table.sort(list, function(x, y)
		if x.Kills ~= y.Kills then
			return x.Kills > y.Kills
		end
		if x.Deaths ~= y.Deaths then
			return x.Deaths < y.Deaths
		end
		return x.Name < y.Name
	end)
	local top = {}
	for i = 1, math.min(3, #list) do
		top[i] = list[i]
	end
	return top
end

local function endRound()
	-- El líder se calcula antes de cambiar de estado (al cambiar, los bots se quitan)
	local leader, leaderScore = updateLeader()
	-- (el podio es un extra: si fallara, la partida termina igual)
	local okTop, top = pcall(topPlayers)
	if not okTop then
		warn("[Round] podio:", top)
		top = nil
	end
	setState("Ended")
	local teamMode = isTeamMode()
	local a, b = teams[1], teams[2]
	local scoreA, scoreB = getScore(a.Name), getScore(b.Name)
	local winner = nil
	if teamMode then
		if scoreA > scoreB then
			winner = a
		elseif scoreB > scoreA then
			winner = b
		end
	end

	-- MVP = más bajas (en CTF cada captura cuenta como 3 bajas)
	local mvp, mvpKills, mvpScore = nil, 0, -1
	for _, player in Players:GetPlayers() do
		local kills = PlayerData.GetLeaderstats(player).Bajas.Value
		local score = kills + (player:GetAttribute("Captures") or 0) * 3
		if score > mvpScore then
			mvp, mvpKills, mvpScore = player, kills, score
		end
	end

	-- Contra bots (menos de 2 jugadores de verdad) la victoria da menos premio y no cuenta para
	-- la clasificación global de victorias
	local humans = 0
	for _, player in Players:GetPlayers() do
		local stats = PlayerData.GetLeaderstats(player)
		-- Ha jugado: está fuera del menú o tiene alguna baja o muerte en esta partida
		if not player:GetAttribute("InMenu") or stats.Bajas.Value + stats.Muertes.Value > 0 then
			humans += 1
		end
	end
	local soloMatch = humans < 2
	-- Por equipos, si todos los jugadores de verdad están en el mismo equipo, es contra bots
	-- (para el rango: dos amigos juntos contra bots no suben como en una partida de verdad)
	local botsOnly = soloMatch
	-- (en Infección los equipos cambian durante la ronda: basta con que jueguen dos personas)
	if teamMode and not soloMatch and currentMode ~= "INF" then
		local humansA, humansB = 0, 0
		for _, player in Players:GetPlayers() do
			if player:GetAttribute("MatchJoinedAt") then
				if player.Team == a then
					humansA += 1
				elseif player.Team == b then
					humansB += 1
				end
			end
		end
		botsOnly = humansA == 0 or humansB == 0
	end
	-- Rango: solo para quien ha jugado de verdad (lleva un rato en la partida, ha tenido bajas o
	-- muertes, o ha jugado alguna ronda de Eliminación). También si ha vuelto al menú (no se esquiva
	-- la derrota así). Empate (por equipos, o nadie puntúa en todos contra todos) = sin cambios.
	local now = workspace:GetServerTimeNow()
	local elim = currentMode == "ELIM" or currentMode == "SND"
	local playedMatch = {} -- [player] = true si ha jugado de verdad (para la primera victoria del día y la caja sorpresa)
	for _, player in Players:GetPlayers() do
		local joined = player:GetAttribute("MatchJoinedAt")
		local stats = PlayerData.GetLeaderstats(player)
		local active = stats.Bajas.Value + stats.Muertes.Value > 0
		local played = joined ~= nil
			and (active or (if elim then player:GetAttribute("ElimPlayed") == true else now - joined >= 60))
		if played then
			playedMatch[player] = true
			PlayerData.Increment(player, "Matches", 1)
			local won
			if teamMode then
				won = wonTeam(player, winner)
			else
				won = leader == player and leaderScore > 0
			end
			local draw = (teamMode and winner == nil) or (not teamMode and leaderScore <= 0)
			local result = won and "Win" or (draw and "Draw" or "Loss")
			PlayerData.AddRankPoints(player, Ranks.Delta(result, not teamMode, botsOnly, mvp == player and mvpScore > 0))
		end
	end
	local winScale = soloMatch and GameConfig.Bots.RewardScale or 1

	-- Premios solo para quien ha jugado (no para quien sigue en la pantalla de inicio)
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("InMenu") then
			continue
		end
		local won
		if teamMode then
			won = wonTeam(player, winner)
		else
			won = leader == player and leaderScore > 0
		end
		if won then
			PlayerData.AddXP(player, math.floor(GameConfig.XP.Win * winScale), "Victoria")
			PlayerData.AddCoins(player, math.floor(GameConfig.Coins.Win * winScale))
			-- Racha de victorias (en esta sesión): cada victoria seguida da un poco más
			local winStreak = (player:GetAttribute("WinStreak") or 0) + 1
			player:SetAttribute("WinStreak", winStreak)
			local extra = math.floor((GameConfig.Coins.WinStreak or 0) * math.min(winStreak - 1, GameConfig.Coins.WinStreakMax or 5) * winScale)
			if extra > 0 then
				local given = PlayerData.AddCoins(player, extra)
				Remotes.Notify:FireClient(player, "Challenge", "🔥 ¡" .. winStreak .. " victorias seguidas!  +" .. given .. " 🪙")
			end
			if not soloMatch then
				PlayerData.Increment(player, "Wins", 1)
			end
			if playedMatch[player] then
				-- (completa también contra bots: es una vez al día, no se puede abusar)
				local firstWin = PlayerData.ClaimFirstWin(player, 1)
				if firstWin then
					Remotes.Notify:FireClient(player, "Challenge", "🏆 ¡Primera victoria del día!  +" .. firstWin .. " 🪙")
				end
			end
			PlayerData.Track(player, "Win", 1)
			-- (reto semanal: ganar en el mapa destacado del día)
			local featured = ReplicatedStorage:GetAttribute("FeaturedMap")
			if featured and featured == ReplicatedStorage:GetAttribute("MapName") then
				PlayerData.Track(player, "FeaturedWin", 1)
			end
			if currentMode == "INF" and winner == teams[1] then
				PlayerData.Track(player, "Survive", 1)
			end
		else
			player:SetAttribute("WinStreak", 0)
			PlayerData.AddXP(player, GameConfig.XP.Loss, "Partida completada")
		end
		PlayerData.Track(player, "Match", 1)
		if playedMatch[player] and PlayerData.RollSurpriseCrate(player) then
			task.delay(2.5, function()
				if player.Parent then
					Remotes.Notify:FireClient(player, "Big", "🎁 ¡CAJA SORPRESA! Tienes una caja gratis en la Tienda")
				end
			end)
		end
	end

	Remotes.RoundEnd:FireAllClients({
		TeamMode = teamMode,
		Winner = if teamMode then (winner and winner.Name) else (leader and leader.Name),
		WinnerColor = winner and winner.TeamColor.Color or Color3.fromRGB(255, 200, 60),
		ScoreA = scoreA,
		ScoreB = scoreB,
		LeaderScore = leaderScore,
		MVP = mvp and mvp.Name or nil,
		MVPKills = mvpKills,
		MVPCaptures = mvp and mvp:GetAttribute("Captures") or 0,
		Top = top,
	})
	-- Resumen personal: lo ganado en esta partida (el cliente lo anima: barra de nivel, monedas...)
	for _, player in Players:GetPlayers() do
		local summary = not player:GetAttribute("InMenu") and PlayerData.MatchSummary(player)
		if summary then
			local stats = PlayerData.GetLeaderstats(player)
			summary.Kills = stats.Bajas.Value
			summary.Deaths = stats.Muertes.Value
			summary.BestStreak = player:GetAttribute("BestStreak") or 0
			summary.Captures = player:GetAttribute("Captures") or 0
			summary.WinStreak = player:GetAttribute("WinStreak") or 0
			-- ¿Récord personal de bajas en una partida? (desde 5, para que no salte en las primeras)
			local data = PlayerData.Get(player)
			local record = data and data.BestMatchKills or 0
			if data and summary.Kills >= 5 and summary.Kills > record then
				summary.NewRecord = summary.Kills
				summary.PrevRecord = record
			end
			PlayerData.SetBest(player, "BestMatchKills", summary.Kills)
			Remotes.MatchSummary:FireClient(player, summary)
		end
	end
	task.wait(GameConfig.EndScreenTime)
end

local function startMode(mode)
	currentMode = mode
	local s = settings(mode)
	local scoreToWin = s.ScoreToWin
	if mode == "GUN" then
		scoreToWin = #Weapons.GunGameOrder
	end
	ReplicatedStorage:SetAttribute("Mode", mode)
	ReplicatedStorage:SetAttribute("ModeName", modeName(mode))
	ReplicatedStorage:SetAttribute("TeamMode", s.Teams ~= false)
	ReplicatedStorage:SetAttribute("ScoreToWin", scoreToWin)
	-- (antes de empezar: así los bots que entran al empezar ya son supervivientes)
	ReplicatedStorage:SetAttribute("Infection", if mode == "INF" then "Prep" else nil)
	if mode == "GUN" then
		Loadout.Override = gunGameWeapons
	elseif mode == "INF" then
		Loadout.Override = infectionLoadout
	else
		Loadout.Override = nil
	end
end

-- Una ronda completa: descanso con votación, partida y pantalla final
local function playRound()
	do
		-- Descanso con votación
		setState("Intermission")
		table.clear(votes)
		voteOptions = makeVoteOptions()
		publishVotes()
		countdown(GameConfig.IntermissionTime)
		while #Players:GetPlayers() < GameConfig.MinPlayers do
			ReplicatedStorage:SetAttribute("TimeLeft", 0)
			task.wait(1)
		end

		-- Resultado de la votación (empate = al azar entre los empatados)
		local counts = publishVotes()
		local bestCount = -1
		local ties = {}
		for i = 1, #voteOptions do
			local c = counts[i] or 0
			if c > bestCount then
				bestCount = c
				ties = { i }
			elseif c == bestCount then
				table.insert(ties, i)
			end
		end
		local choice = voteOptions[ties[math.random(1, #ties)]]
		clearVotes()

		local mode = choice.Mode
		-- Comprueba que el mapa soporta el modo
		if choice.Map ~= "Custom" and choice.Map ~= MapBuilder.Current then
			-- Pantalla de carga en los clientes (ver LoadingScreen): se tapa la construcción del mapa
			ReplicatedStorage:SetAttribute("LoadingMap", MapBuilder.Get(choice.Map).Name)
			task.wait(0.6)
			Flags.Stop()
			Hardpoint.Stop()
			Domination.Stop()
			local built, buildError = pcall(MapBuilder.Build, choice.Map)
			task.wait(0.3)
			ReplicatedStorage:SetAttribute("LoadingMap", nil)
			if not built then
				error(buildError, 0)
			end
		end
		if mode == "CTF" and not Flags.IsAvailable() then
			mode = "TDM"
		elseif mode == "KOTH" and not Hardpoint.IsAvailable() then
			mode = "TDM"
		elseif mode == "DOM" and not Domination.IsAvailable() then
			mode = "TDM"
		elseif mode == "SND" and not Bomb.IsAvailable() then
			mode = "ELIM" -- (mapa sin sitios para la bomba)
		end
		startMode(mode)

		roundOver = false
		balanceTeams()
		resetStats()
		table.clear(spawnedThisRound)
		setState("Playing")
		-- Mapa destacado del día: aviso al empezar
		local featured = ReplicatedStorage:GetAttribute("FeaturedMap")
		if featured and featured == ReplicatedStorage:GetAttribute("MapName") and GameConfig.FeaturedMap then
			Remotes.Notify:FireAllClients("Big", "⭐ ¡MAPA DESTACADO DE HOY! +" .. math.floor((GameConfig.FeaturedMap.XPBonus - 1) * 100 + 0.5) .. "% XP")
		end
		if mode == "CTF" then
			Flags.Start()
		elseif mode == "KOTH" then
			Hardpoint.Start()
		elseif mode == "DOM" then
			Domination.Start()
		elseif mode == "CAL" then
			Pumpkins.Start()
		end
		if mode ~= "ELIM" and mode ~= "SND" then
			respawnAll() -- (Eliminación reaparece a todos al empezar cada ronda)
		end
		local s = settings(mode)
		local goal = ReplicatedStorage:GetAttribute("ScoreToWin")
		local intro = {
			TDM = "¡A LUCHAR! Primero a " .. goal .. " bajas",
			CTF = "¡CAPTURA LA BANDERA! Primero a " .. goal,
			KOTH = "¡ZONA DE CONTROL! Primero a " .. goal .. " puntos",
			DOM = "🚩 ¡DOMINIO! Captura A, B y C · primero a " .. goal .. " puntos",
			FFA = "¡TODOS CONTRA TODOS! Primero a " .. goal .. " bajas",
			GUN = "¡ESCALADA DE ARMAS! Una baja con cada arma",
			ELIM = "¡ELIMINACIÓN! Una vida por ronda · primero a " .. goal .. " rondas",
			SND = "💣 ¡BUSCAR Y DESTRUIR! Una vida · planta o desactiva la bomba · primero a " .. goal .. " rondas",
			INF = "🧟 ¡INFECCIÓN! Escóndete y prepárate",
			CAL = Pumpkins.Tags() and ("🏷️ ¡BAJA CONFIRMADA! Recoge las placas de tus enemigos caídos · primero a " .. goal)
				or ("🎃 ¡CALABAZAS! Recoge las de tus enemigos caídos · primero a " .. goal),
		}
		Remotes.Notify:FireAllClients("Big", intro[mode] or s.Name)
		if mode == "ELIM" or mode == "SND" then
			task.wait(2)
			eliminationRounds(s)
		elseif mode == "INF" then
			infectionRound(s)
		else
			countdown(s.RoundTime, function()
				return roundOver
			end)
		end
		Flags.Stop()
		Hardpoint.Stop()
		Domination.Stop()
		Pumpkins.Stop()
		Loot.Clear()
		Loadout.Override = nil
		if mode == "INF" then
			clearInfection()
			-- Fuera de la Infección todos vuelven a ser normales (los zombis reaparecen)
			respawnAll()
		end
		if mode == "GUN" then
			-- Fuera de la Escalada cada uno recupera sus armas
			for _, player in Players:GetPlayers() do
				Loadout.GiveDefault(player)
			end
		end
		endRound()
	end
end

local function gameLoop()
	while true do
		-- Si algo falla en una ronda, el servidor no se queda colgado: se limpia y empieza otra
		local ok, err = xpcall(playRound, debug.traceback)
		if not ok then
			warn("[Round] Error en la ronda, se reinicia:", err)
			pcall(Flags.Stop)
			pcall(Hardpoint.Stop)
			pcall(Domination.Stop)
			pcall(Pumpkins.Stop)
			pcall(Loot.Clear)
			clearElimination()
			clearInfection()
			-- (primero las armas normales: si no, tras un fallo en Escalada se quedarían las de esa ronda)
			Loadout.Override = nil
			for _, player in Players:GetPlayers() do
				pcall(Loadout.GiveDefault, player)
			end
			pcall(respawnAll)
			roundOver = true
			task.wait(3)
		end
	end
end

-- Amistad detectada (Friends tarda un poco al entrar alguien): si el que acaba de entrar sigue en
-- la portada y su amigo está en el otro equipo, se le cambia con él si el reparto sigue igualado
local function onFriendship(newcomer, friend)
	if not isTeamMode() or ReplicatedStorage:GetAttribute("Infection") then
		return
	end
	if not newcomer.Parent or not friend.Parent or newcomer:GetAttribute("InMenu") ~= true then
		return
	end
	local target = friend.Team
	local current = newcomer.Team
	if not target or target == current or not table.find(teams, target) then
		return
	end
	local after = #target:GetPlayers() + 1
	local left = current and (#current:GetPlayers() - 1) or 0
	if current == nil or math.abs(after - left) <= 1 then
		newcomer.Team = target
	end
end

function Round.Init()
	Friends.OnFriendship = onFriendship
	Players.RespawnTime = GameConfig.RespawnTime
	setupTeams()
	startMode("TDM")
	setState("Intermission")
	ReplicatedStorage:SetAttribute("TimeLeft", GameConfig.IntermissionTime)
	Flags.OnCapture = function(_, team)
		addScore(team, 1)
	end
	Hardpoint.OnScore = function(team, amount)
		addScore(team, amount)
	end
	Domination.OnScore = function(team, amount)
		addScore(team, amount)
	end
	-- Calabazas: quién puede recogerlas (jugadores vivos en partida y bots) y qué pasa al recogerlas
	Pumpkins.Collectors = function()
		local list = {}
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and humanoid and humanoid.Health > 0 and player.Team and not player:GetAttribute("InMenu") then
				table.insert(list, { Position = root.Position, Team = player.Team, Player = player })
			end
		end
		for _, agent in Combat.BotsByName do
			if agent.Root and agent.Root.Parent and agent.Humanoid and agent.Humanoid.Health > 0 and agent.Team then
				table.insert(list, { Position = agent.Root.Position, Team = agent.Team, Bot = agent })
			end
		end
		return list
	end
	Pumpkins.OnCollect = function(collector, confirmed, _, fromBot)
		if confirmed then
			addScore(collector.Team, 1)
		end
		local player = collector.Player
		if player then
			Remotes.Notify:FireClient(player, "Pumpkin", confirmed)
			-- (la calabaza de un bot vale menos, como la baja)
			local scale = fromBot and GameConfig.Bots.RewardScale or 1
			if confirmed then
				PlayerData.AddXP(player, math.floor((GameConfig.XP.PumpkinConfirm or 0) * scale), Pumpkins.Tags() and "🏷️ Baja confirmada" or "🎃 Calabaza confirmada")
				PlayerData.AddCoins(player, math.max(1, math.floor((GameConfig.Coins.Pumpkin or 2) * scale)))
				PlayerData.Track(player, "Pumpkin", 1)
			else
				PlayerData.AddXP(player, math.floor((GameConfig.XP.PumpkinDeny or 0) * scale), Pumpkins.Tags() and "🏷️ Placa recuperada" or "🎃 Calabaza recuperada")
			end
		end
	end

	Remotes.VoteMap.OnServerEvent:Connect(function(player, index)
		if ReplicatedStorage:GetAttribute("State") ~= "Intermission" then
			return
		end
		if type(index) ~= "number" or not voteOptions[index] then
			return
		end
		votes[player] = index
		publishVotes()
	end)

	local function onPlayer(player)
		assignTeam(player)
		player.CharacterAdded:Connect(function(character)
			task.spawn(function()
				-- Revivir instantáneo: aparece donde murió; si no, punto normal (FFA)
				if not Respawn.ApplyRevive(player, character) then
					ffaSpawnFor(player, character)
				end
				if ReplicatedStorage:GetAttribute("Infection") == "On" and player.Team == teams[2] then
					zombify(player, character)
				end
			end)
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	Players.PlayerRemoving:Connect(function(player)
		votes[player] = nil
		streakVictims[player] = nil
		updateLeader(player)
	end)
	for _, player in Players:GetPlayers() do
		if not player.Team then
			onPlayer(player)
			Respawn.Load(player)
		end
	end

	task.spawn(gameLoop)
end

return Round
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">SpawnPicker</string>
            <string name="Source"><![CDATA[-- Apariciones dinámicas en los modos por equipos (como en los shooters de móvil): al reaparecer
-- no se vuelve siempre a la base, sino al punto del mapa (FFASpawn o una salida del equipo) más
-- seguro: lejos de los enemigos y, a ser posible, cerca de los compañeros. La primera aparición de
-- cada ronda sigue siendo en la base. Lo usan Round (jugadores) y Bots.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local SpawnPicker = {}

local MODES = { TDM = true, KOTH = true, CAL = true, DOM = true } -- (en bandera y eliminación, siempre en la base)
local SAFE_DISTANCE = 40 -- un enemigo más cerca que esto descarta el punto

local cache = { Map = nil, Free = {}, ByColor = {} }

local function points()
	local map = workspace:FindFirstChild("Map")
	if cache.Map ~= map then
		cache.Map, cache.Free, cache.ByColor = map, {}, {}
		if map then
			for _, d in map:GetDescendants() do
				if d:IsA("SpawnLocation") then
					local key = d.TeamColor.Name
					cache.ByColor[key] = cache.ByColor[key] or {}
					table.insert(cache.ByColor[key], d.Position)
				elseif d:IsA("BasePart") and d.Name == "FFASpawn" then
					table.insert(cache.Free, d.Position)
				end
			end
		end
	end
	return cache
end

-- ¿Se usan apariciones dinámicas ahora mismo?
function SpawnPicker.Enabled()
	return GameConfig.DynamicSpawns ~= false
		and ReplicatedStorage:GetAttribute("TeamMode") == true
		and MODES[ReplicatedStorage:GetAttribute("Mode") or ""] == true
		and not ReplicatedStorage:GetAttribute("Infection")
end

-- Mejor punto para alguien del equipo team (selfModel = su propio personaje, que no cuenta)
function SpawnPicker.Pick(team, selfModel)
	if not team then
		return nil
	end
	local data = points()
	local candidates = table.clone(data.Free)
	for _, p in data.ByColor[team.TeamColor.Name] or {} do
		table.insert(candidates, p)
	end
	if #candidates == 0 then
		return nil
	end
	local enemies, friends = {}, {}
	local function add(model, modelTeam)
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local root = model:FindFirstChild("HumanoidRootPart")
		if model ~= selfModel and humanoid and humanoid.Health > 0 and root then
			table.insert(modelTeam == team.Name and friends or enemies, root.Position)
		end
	end
	for _, player in Players:GetPlayers() do
		if player.Character and player.Team and not player:GetAttribute("InMenu") then
			add(player.Character, player.Team.Name)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			add(model, model:GetAttribute("Team"))
		end
	end
	local best, bestScore = nil, -math.huge
	for _, point in candidates do
		local nearestEnemy, nearestFriend = math.huge, math.huge
		for _, p in enemies do
			nearestEnemy = math.min(nearestEnemy, (p - point).Magnitude)
		end
		for _, p in friends do
			nearestFriend = math.min(nearestFriend, (p - point).Magnitude)
		end
		local score = math.min(nearestEnemy, 140) - math.min(nearestFriend, 120) * 0.35 + math.random() * 12
		if nearestEnemy < SAFE_DISTANCE then
			score -= 1000 -- (solo si no queda otra)
		end
		if score > bestScore then
			best, bestScore = point, score
		end
	end
	return best
end

return SpawnPicker
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">Zombie</string>
            <string name="Source"><![CDATA[-- Aspecto y vida de los zombis del modo Infección (jugadores y bots): piel verde, ojos rojos
-- brillantes y más vida. Las garras y la velocidad vienen del arma (Weapons.Claws).
local Zombie = {}

Zombie.Skin = Color3.fromRGB(110, 165, 80)
local EYE = Color3.fromRGB(255, 40, 30)
local SKIN_PARTS = {
	"Head",
	"LeftHand",
	"RightHand",
	"LeftLowerArm",
	"RightLowerArm",
	"LeftUpperArm",
	"RightUpperArm",
	"Left Arm",
	"Right Arm",
}

local function eye(head, x)
	local part = Instance.new("Part")
	part.Name = "ZombieEye"
	part.Size = Vector3.new(0.2, 0.12, 0.05)
	part.Color = EYE
	part.Material = Enum.Material.Neon
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
	part.CFrame = head.CFrame * CFrame.new(x * head.Size.X, head.Size.Y * 0.12, -head.Size.Z * 0.5)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = part
	weld.Parent = part
	part.Parent = head
end

-- Pinta al personaje de zombi y le da la vida indicada
function Zombie.Apply(character, health)
	character:SetAttribute("Zombie", true)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and health then
		humanoid.MaxHealth = health
		humanoid.Health = health
	end
	local bodyColors = character:FindFirstChildOfClass("BodyColors")
	if bodyColors then
		bodyColors.HeadColor3 = Zombie.Skin
		bodyColors.LeftArmColor3 = Zombie.Skin
		bodyColors.RightArmColor3 = Zombie.Skin
	end
	for _, name in SKIN_PARTS do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			part.Color = Zombie.Skin
		end
	end
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") and not head:FindFirstChild("ZombieEye") then
		eye(head, -0.17)
		eye(head, 0.17)
	end
end

return Zombie
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="82">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <token name="CameraMode">1</token>
      <float name="CharacterWalkSpeed">18</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="83">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="84">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="85">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Punto de entrada del cliente.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local Modules = script.Parent:WaitForChild("Modules")
local ClientState = require(Modules.ClientState)
local WeaponController = require(Modules.WeaponController)
local Movement = require(Modules.Movement)
local HUD = require(Modules.HUD)
local Menu = require(Modules.Menu)
local MainMenu = require(Modules.MainMenu)
local WorldFX = require(Modules.WorldFX)
local VoteUI = require(Modules.VoteUI)
local GrenadeController = require(Modules.GrenadeController)
local KillstreakController = require(Modules.KillstreakController)
local Settings = require(Modules.Settings)
local Footprints = require(Modules.Footprints)
local DeathScreen = require(Modules.DeathScreen)
local QuestTracker = require(Modules.QuestTracker)
local Abilities = require(Modules.Abilities)
local Emotes = require(Modules.Emotes)
local Scoreboard = require(Modules.Scoreboard)
local PlaytimeGifts = require(Modules.PlaytimeGifts)
local SkinFX = require(Modules.SkinFX)
local JumpPads = require(Modules.JumpPads)
local Tutorial = require(Modules.Tutorial)
local EventHUD = require(Modules.EventHUD)
local ChatTags = require(Modules.ChatTags)
local InfectionFX = require(Modules.InfectionFX)
local News = require(Modules.News)
local Graffiti = require(Modules.Graffiti)
local DamageIndicator = require(Modules.DamageIndicator)
local BoostHUD = require(Modules.BoostHUD)
local Minimap = require(Modules.Minimap)
local DominationHUD = require(Modules.DominationHUD)
local MatchIntro = require(Modules.MatchIntro)
local BombHUD = require(Modules.BombHUD)
local BotFootsteps = require(Modules.BotFootsteps)
local ScopeGlint = require(Modules.ScopeGlint)
local GrenadeWarning = require(Modules.GrenadeWarning)
local Ambience = require(Modules.Ambience)
local LoadingScreen = require(Modules.LoadingScreen)
local EnemyName = require(Modules.EnemyName)
local RewardFX = require(Modules.RewardFX)
local AimFX = require(Modules.AimFX)
local CombatFX = require(Modules.CombatFX)
local RiflePose = require(Modules.RiflePose)
local BodyView = require(Modules.BodyView)
local Effects = require(Modules.Effects)

Remotes.DataUpdate.OnClientEvent:Connect(ClientState.SetData)
task.spawn(function()
	local ok, data = pcall(function()
		return Remotes.GetData:InvokeServer()
	end)
	if ok and data and not ClientState.Data then
		ClientState.SetData(data)
	end
end)

-- Arranca cada sistema por separado: si uno falla, se avisa en Output y los demás siguen
local function start(name, fn, ...)
	local ok, err = xpcall(fn, debug.traceback, ...)
	if not ok then
		warn("[Arranque] " .. name .. " falló: " .. tostring(err))
	end
end

start("Settings", Settings.Init)
start("RewardFX", RewardFX.Init)
start("HUD", HUD.Init)
start("Minimap", Minimap.Init)
start("DominationHUD", DominationHUD.Init)
start("MatchIntro", MatchIntro.Init)
start("BombHUD", BombHUD.Init)
start("BotFootsteps", BotFootsteps.Init)
start("ScopeGlint", ScopeGlint.Init)
start("GrenadeWarning", GrenadeWarning.Init)
start("Ambience", Ambience.Init)
start("LoadingScreen", LoadingScreen.Init)
start("EnemyName", EnemyName.Init)
start("AimFX", AimFX.Init)
start("RiflePose", RiflePose.Init)
start("BodyView", BodyView.Init)
start("CombatFX", function()
	CombatFX.Init()
	Effects.OnConcussion = CombatFX.Concussion
end)
start("Menu", Menu.Init)
start("Movement", Movement.Init)
start("WeaponController", WeaponController.Init)
start("WorldFX", WorldFX.Init)
start("Footprints", Footprints.Init)
start("DeathScreen", DeathScreen.Init)
start("QuestTracker", QuestTracker.Init)
start("Abilities", Abilities.Init)
start("Emotes", Emotes.Init)
start("Scoreboard", Scoreboard.Init)
start("PlaytimeGifts", PlaytimeGifts.Init)
start("SkinFX", SkinFX.Init)
start("JumpPads", JumpPads.Init)
start("Tutorial", Tutorial.Init)
start("EventHUD", EventHUD.Init)
start("ChatTags", ChatTags.Init)
start("InfectionFX", InfectionFX.Init)
start("News", News.Init)
start("Graffiti", Graffiti.Init)
start("DamageIndicator", DamageIndicator.Init)
start("BoostHUD", BoostHUD.Init)
start("VoteUI", VoteUI.Init)
start("GrenadeController", GrenadeController.Init)
start("KillstreakController", KillstreakController.Init)
start("MainMenu", MainMenu.Init) -- la última: muestra la pantalla de inicio
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="86">
          <Properties>
            <string name="Name">Modules</string>
          </Properties>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">Abilities</string>
              <string name="Source"><![CDATA[-- Habilidades con tiempo de recarga (iconos abajo en el centro, también se tocan en móvil):
--   E  Impulso    : acelerón corto hacia donde te mueves (o hacia donde miras)
--   Z  Supersalto : salto muy alto con un poco de impulso hacia delante
--   X  Poción     : cura con el tiempo (la valida el servidor)
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Sounds = require(Shared.Sounds)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Abilities = {}

local CONFIG = GameConfig.Abilities
local readyAt = { Dash = 0, Jump = 0, Potion = 0 }
local slots = {} -- [nombre] = { Cover, Timer, Frame, WasReady }
local gui

local function getCharacter()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then
		return character, humanoid, root
	end
	return nil
end

local function canUse(name)
	return not ClientState.IsBlocked() and not ClientState.Frozen() and os.clock() >= readyAt[name]
end

-- Estela blanca breve detrás del personaje
local function burst(root, color, count, speed)
	local attachment = Instance.new("Attachment")
	attachment.Parent = root
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	emitter.Color = ColorSequence.new(color)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 3) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(0.3, 0.5)
	emitter.Speed = NumberRange.new(speed * 0.5, speed)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Enabled = false
	emitter.Parent = attachment
	emitter:Emit(count)
	task.delay(1, function()
		attachment:Destroy()
	end)
end

local function dash()
	if not canUse("Dash") or ClientState.Sliding then
		return
	end
	local _, humanoid, root = getCharacter()
	if not humanoid or not root then
		return
	end
	local config = CONFIG.Dash
	local direction = humanoid.MoveDirection
	if direction.Magnitude < 0.1 then
		direction = camera.CFrame.LookVector
	end
	direction = Vector3.new(direction.X, 0, direction.Z)
	if direction.Magnitude < 0.01 then
		return
	end
	direction = direction.Unit
	readyAt.Dash = os.clock() + config.Cooldown

	local attachment = Instance.new("Attachment")
	attachment.Name = "DashAttachment"
	attachment.Parent = root
	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	velocity.PrimaryTangentAxis = Vector3.xAxis
	velocity.SecondaryTangentAxis = Vector3.zAxis
	velocity.MaxForce = 120000
	velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z) * config.Speed
	velocity.Parent = root
	ClientState.Dashing = true
	task.delay(config.Duration, function()
		ClientState.Dashing = false
		velocity:Destroy()
		attachment:Destroy()
	end)
	ClientState.FovKick = 10
	Sounds.Play("Slide")
	burst(root, Color3.fromRGB(235, 245, 255), 14, 12)
end

local function superJump()
	if not canUse("Jump") then
		return
	end
	local _, humanoid, root = getCharacter()
	if not humanoid or not root or humanoid.FloorMaterial == Enum.Material.Air then
		return
	end
	local config = CONFIG.Jump
	readyAt.Jump = os.clock() + config.Cooldown
	local forward = humanoid.MoveDirection
	if forward.Magnitude < 0.1 then
		forward = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
	end
	if forward.Magnitude > 0.01 then
		forward = forward.Unit
	end
	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	local v = root.AssemblyLinearVelocity
	local launch = Vector3.new(v.X + forward.X * config.Forward, config.Power, v.Z + forward.Z * config.Forward)
	root.AssemblyLinearVelocity = launch
	-- Otra vez en el siguiente paso de física: el salto del Humanoid podría pisar la velocidad
	task.defer(function()
		local dt = RunService.Heartbeat:Wait()
		-- (lo esperado tras un paso es Power - gravedad·dt; solo se corrige si quedó muy por debajo)
		if root.Parent and humanoid.Health > 0 and root.AssemblyLinearVelocity.Y < config.Power - workspace.Gravity * dt - 8 then
			root.AssemblyLinearVelocity = launch
		end
	end)
	ClientState.FovKick = 6
	Sounds.Play("Swing")
	burst(root, Color3.fromRGB(170, 220, 255), 18, 8)
end

local function potion()
	if not canUse("Potion") then
		return
	end
	local _, humanoid = getCharacter()
	if not humanoid or humanoid.Health >= humanoid.MaxHealth then
		return
	end
	readyAt.Potion = os.clock() + CONFIG.Potion.Cooldown
	Sounds.Play("Kill")
	task.spawn(function()
		local ok, used = pcall(function()
			return Remotes.UsePotion:InvokeServer()
		end)
		if not ok or not used then
			readyAt.Potion = os.clock() + 1 -- el servidor no la aceptó: se puede reintentar enseguida
		end
	end)
end

local ACTIONS = {
	{ Name = "Dash", Key = "E", Icon = "💨", Use = dash, Color = Color3.fromRGB(70, 160, 255) },
	{ Name = "Jump", Key = "Z", Icon = "⏫", Use = superJump, Color = Color3.fromRGB(80, 200, 255) },
	{ Name = "Potion", Key = "X", Icon = "🧪", Use = potion, Color = Color3.fromRGB(80, 220, 120) },
}

local function build()
	gui = UI.new("ScreenGui", {
		Name = "Abilities",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local bar = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -58), -- (por encima del nivel y la barra de XP)
		Size = UDim2.fromOffset(3 * 78 + 2 * 12, 92),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 12),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local scale = UI.new("UIScale", { Parent = bar })
	local function rescale()
		local size = camera.ViewportSize
		scale.Scale = math.clamp(math.min(size.X / 1280, size.Y / 720), 0.65, 1)
	end
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()

	for i, action in ACTIONS do
		local button = UI.button({
			LayoutOrder = i,
			Size = UDim2.fromOffset(78, 78),
			Text = "",
			BackgroundColor3 = action.Color,
			AutoButtonColor = true,
			Parent = bar,
		}, { UI.stroke(Color3.new(1, 1, 1), 3, 0), UI.gloss() })
		UI.label({ Size = UDim2.fromScale(1, 1), Text = action.Icon, TextSize = 40, Parent = button })
		local cover = UI.new("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.fromScale(1, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.35,
			ZIndex = 2,
			Parent = button,
		}, { UI.corner(8) })
		local timer = UI.label({ Size = UDim2.fromScale(1, 1), Text = "", TextSize = 30, ZIndex = 3, Parent = button })
		local badge = UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 1, 2),
			Size = UDim2.fromOffset(30, 26),
			BackgroundColor3 = Color3.fromRGB(20, 22, 34),
			ZIndex = 4,
			-- (en el móvil no hay teclas: solo se toca el botón)
			Visible = not (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled),
			Parent = button,
		}, { UI.corner(6), UI.stroke(Color3.new(1, 1, 1), 2, 0) })
		UI.label({ Size = UDim2.fromScale(1, 1), Text = action.Key, TextSize = 18, ZIndex = 5, Parent = badge })
		button.Activated:Connect(action.Use)
		slots[action.Name] = { Cover = cover, Timer = timer, Frame = button, WasReady = true }
	end
end

local function update()
	-- (tampoco con el resumen de fin de partida en pantalla: en el móvil lo tapaban)
	gui.Enabled = not ClientState.InMainMenu and not ClientState.Dead and not ClientState.MenuOpen and not ClientState.VotePanelVisible
		and ReplicatedStorage:GetAttribute("State") ~= "Ended"
	local now = os.clock()
	if not gui.Enabled then
		-- (oculto: solo se apunta si ya está lista, para que el salto no salga al volver a mostrarse)
		for _, action in ACTIONS do
			slots[action.Name].WasReady = readyAt[action.Name] - now <= 0
		end
		return
	end
	for _, action in ACTIONS do
		local slot = slots[action.Name]
		local left = readyAt[action.Name] - now
		local ready = left <= 0
		-- (solo se escribe cuando cambia: el contador va por segundos y la barra en pasos de 1/50)
		local fraction = ready and 0 or math.clamp(left / CONFIG[action.Name].Cooldown, 0, 1)
		local step = math.ceil(fraction * 50)
		if step ~= slot.LastStep then
			slot.LastStep = step
			slot.Cover.Size = UDim2.fromScale(1, step / 50)
		end
		local seconds = ready and 0 or math.ceil(left)
		if seconds ~= slot.LastSeconds then
			slot.LastSeconds = seconds
			slot.Timer.Text = ready and "" or tostring(seconds)
		end
		if ready and not slot.WasReady then
			-- Lista otra vez: pequeño salto del icono
			local s = slot.Frame:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = slot.Frame })
			s.Scale = 1.2
			TweenService:Create(s, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
		slot.WasReady = ready
	end
end

function Abilities.Init()
	build()
	local keys = {
		Dash = { Enum.KeyCode.E, Enum.KeyCode.DPadLeft },
		Jump = { Enum.KeyCode.Z, Enum.KeyCode.DPadDown },
		Potion = { Enum.KeyCode.X },
	}
	for _, action in ACTIONS do
		ContextActionService:BindAction("Ability" .. action.Name, function(_, state)
			if state == Enum.UserInputState.Begin then
				action.Use()
			end
			return Enum.ContextActionResult.Pass
		end, false, table.unpack(keys[action.Name]))
	end
	-- Al reaparecer, las recargas se mantienen (no se reinician gratis)
	RunService.RenderStepped:Connect(update)
end

return Abilities
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="88">
            <Properties>
              <string name="Name">AimAssist</string>
              <string name="Source"><![CDATA[-- Asistencia de apuntado (como en los shooters de móvil): con pantalla táctil o mando, si un enemigo
-- visible está cerca de la mira, la cámara se va hacia su pecho poco a poco (más al apuntar con la
-- mira) y, al empezar a apuntar con él cerca, da un pequeño "salto" hacia él. Nunca con ratón: ahí
-- apuntar es cosa de cada uno. Se puede bajar o quitar en Ajustes (Settings.AimAssist: 2 normal,
-- 1 suave, 0 no). WeaponController la llama cada fotograma justo después del retroceso.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ClientState = require(script.Parent.ClientState)
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local AimAssist = {}

local player = Players.LocalPlayer

-- Cono de captura (grados) sin apuntar y apuntando, y cuánto del ángulo que falta se corrige por
-- segundo (fracción). El "salto" al empezar a apuntar corrige una parte en ~0,2 s.
AimAssist.HipCone = 5
AimAssist.AdsCone = 9
AimAssist.HipPull = 1.2
AimAssist.AdsPull = 3.2
AimAssist.SnapCone = 12
AimAssist.SnapPull = 9
AimAssist.SnapTime = 0.2

AimAssist.SnapCooldown = 0.8 -- (apuntar y desapuntar sin parar no vuelve a dar el salto)

local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude
local lastAds = 0
local snapUntil = 0
local lastSnap = -10

local GAMEPAD = {}
for i = 1, 8 do
	local ok, value = pcall(function()
		return (Enum.UserInputType :: any)["Gamepad" .. i]
	end)
	if ok and value then
		GAMEPAD[value] = true
	end
end

-- ¿Se está jugando con el dedo o con mando? (con ratón, nada)
function AimAssist.UsingAssistInput()
	local ok, last = pcall(function()
		return UserInputService:GetLastInputType()
	end)
	if ok and (last == Enum.UserInputType.Touch or GAMEPAD[last]) then
		return true
	end
	-- (móvil sin teclado aunque aún no haya tocado nada)
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function level()
	local settings = ClientState.Settings or GameConfig.DefaultSettings
	local value = settings.AimAssist
	if value == nil then
		value = 2
	end
	return math.floor(value + 0.5)
end

local function isEnemy(model)
	if model == player.Character then
		return false
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	-- (con la protección de aparición no se le puede herir: no tira de la mira)
	if model:FindFirstChildOfClass("ForceField") then
		return false
	end
	local teamMode = ReplicatedStorage:GetAttribute("TeamMode") ~= false
	local owner = Players:GetPlayerFromCharacter(model)
	if owner then
		return not (teamMode and player.Team ~= nil and owner.Team == player.Team)
	end
	if model:GetAttribute("Bot") then
		return not (teamMode and player.Team ~= nil and model:GetAttribute("Team") == player.Team.Name)
	end
	return false
end

local function candidates()
	local list = {}
	for _, other in Players:GetPlayers() do
		if other ~= player and other.Character then
			table.insert(list, other.Character)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			if model:IsA("Model") then
				table.insert(list, model)
			end
		end
	end
	return list
end

-- Lo que no tapa la vista: tú, la cámara, los efectos y las barandillas invisibles del mapa (lo
-- mismo que atraviesan las balas)
local function updateIgnore(camera)
	local ignore = { camera }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local fx = workspace:FindFirstChild("ClientFX")
	if fx then
		table.insert(ignore, fx)
	end
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	params.FilterDescendantsInstances = ignore
end

-- Punto del cuerpo al que tirar: el de su eje (de la cadera a la cabeza) a la altura por la que pasa
-- la mira. Si ya apuntas a la cabeza, se queda en la cabeza (no te la baja al pecho); si apuntas por
-- encima o por debajo, lo más cercano del cuerpo.
local function aimPoint(model, origin, look)
	local center = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart")
	if not center or not center:IsA("BasePart") then
		return nil
	end
	local head = model:FindFirstChild("Head")
	local top = (head and head:IsA("BasePart")) and head.Position.Y or center.Position.Y + 1.5
	local bottom = center.Position.Y - 1.2
	local position = center.Position
	local flatLook = Vector3.new(look.X, 0, look.Z)
	local flatDistance = Vector3.new(position.X - origin.X, 0, position.Z - origin.Z).Magnitude
	if flatLook.Magnitude < 0.05 then
		return position
	end
	local rayHeight = origin.Y + look.Y / flatLook.Magnitude * flatDistance
	return Vector3.new(position.X, math.clamp(rayHeight, math.min(bottom, top), top), position.Z)
end

-- Mejor objetivo dentro del cono: { Model, Point, Angle } o nil
function AimAssist.FindTarget(camera, coneDegrees, range)
	local cf = camera.CFrame
	local origin = cf.Position
	local look = cf.LookVector
	local cone = math.rad(coneDegrees)
	local best
	local ignoreReady = false
	for _, model in candidates() do
		if isEnemy(model) then
			local point = aimPoint(model, origin, look)
			if point then
				local offset = point - origin
				local distance = offset.Magnitude
				if distance > 1 and distance <= range then
					local angle = math.acos(math.clamp(look:Dot(offset / distance), -1, 1))
					if angle < cone and (not best or angle < best.Angle) then
						-- (que se vea: nada de imanes a través de las paredes)
						if not ignoreReady then
							updateIgnore(camera)
							ignoreReady = true
						end
						local hit = workspace:Raycast(origin, offset, params)
						if not hit or hit.Instance:IsDescendantOf(model) then
							best = { Model = model, Point = point, Angle = angle }
						end
					end
				end
			end
		end
	end
	return best
end

-- Gira la cámara una fracción hacia el punto (en su propio espacio: arriba/abajo e izquierda/derecha).
-- Devuelve el giro aplicado (cabeceo, guiñada; positivo = arriba / izquierda)
local function turnToward(camera, point, fraction)
	local direction = (point - camera.CFrame.Position).Unit
	local localDir = camera.CFrame:VectorToObjectSpace(direction)
	local yaw = math.atan2(-localDir.X, -localDir.Z)
	local pitch = math.atan2(localDir.Y, math.sqrt(localDir.X * localDir.X + localDir.Z * localDir.Z))
	camera.CFrame = camera.CFrame * CFrame.Angles(pitch * fraction, yaw * fraction, 0)
	return pitch * fraction, yaw * fraction
end

-- Devuelve el objetivo (o nil) y el giro aplicado (cabeceo, guiñada): WeaponController lo descuenta de
-- la recuperación del retroceso (si no, al soltar la mira bajaría de más)
function AimAssist.Update(dt)
	local camera = workspace.CurrentCamera
	local def = ClientState.CurrentDef
	local strength = level()
	local ads = ClientState.AimAlpha or 0
	local startedAiming = ads > 0.1 and lastAds <= 0.1
	lastAds = ads
	if not camera or strength <= 0 or not def or def.Type ~= "Gun" or ClientState.Dead or ClientState.IsBlocked() then
		return nil, 0, 0
	end
	-- (bailando un emote, la cámara es de tercera persona; corriendo no se apunta)
	if ClientState.Emoting or ClientState.Sprinting then
		return nil, 0, 0
	end
	if not AimAssist.UsingAssistInput() then
		return nil, 0, 0
	end
	local scale = strength == 1 and 0.5 or 1
	local range = def.Range or 300
	local now = os.clock()
	if startedAiming and now - lastSnap >= AimAssist.SnapCooldown then
		snapUntil = now + AimAssist.SnapTime
		lastSnap = now
	end
	local snapping = os.clock() < snapUntil
	local cone = snapping and AimAssist.SnapCone or (AimAssist.HipCone + (AimAssist.AdsCone - AimAssist.HipCone) * ads)
	local target = AimAssist.FindTarget(camera, cone, range)
	if not target then
		return nil, 0, 0
	end
	local pull = snapping and AimAssist.SnapPull or (AimAssist.HipPull + (AimAssist.AdsPull - AimAssist.HipPull) * ads)
	-- (más fuerte cuanto más cerca de la mira; en el borde del cono casi nada)
	local closeness = 1 - target.Angle / math.rad(cone)
	local fraction = math.clamp(pull * scale * closeness * dt, 0, 0.5)
	local pitch, yaw = turnToward(camera, target.Point, fraction)
	return target, pitch, yaw
end

return AimAssist
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="89">
            <Properties>
              <string name="Name">AimFX</string>
              <string name="Source"><![CDATA[-- Apuntar con realismo: al apuntar con la mira, el fondo se desenfoca un poco más allá de lo que
-- miras (profundidad de campo, enfocada a la distancia del punto de mira) y los bordes de la pantalla
-- se oscurecen suavemente, como al mirar por el arma. Solo en este cliente; con la mira telescópica
-- puesta no hace falta (la tapa el visor) y en calidad Baja no se usa (cuesta en móviles modestos).
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")

local ClientState = require(script.Parent.ClientState)

local AimFX = {}

-- desenfoque del fondo con la mira del todo puesta (0 = nada, 1 = mucho). Por debajo de 0,22: ahí el
-- desenfoque de Roblox da un salto brusco (y aparecería de golpe en vez de poco a poco)
local MAX_BLUR = 0.2
local MAX_FOCUS = 200 -- (lo máximo que admite FocusDistance)
local MAX_RADIUS = 50 -- (lo máximo que admite InFocusRadius)
local MAX_VIGNETTE = 0.38 -- oscuridad de los bordes

local dof, gui
local edges = {}
local focus = 60
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude
local pausedQualityDof = nil -- el desenfoque lejano de calidad Ultra, apagado mientras se apunta

-- Distancia a lo que hay bajo la mira. No cuentan las barandillas invisibles del mapa (las balas las
-- atraviesan) ni los cristales: se enfoca a lo que hay detrás
local function focusTarget(camera)
	local ignore = { camera }
	local character = Players.LocalPlayer.Character
	if character then
		table.insert(ignore, character)
	end
	local fx = workspace:FindFirstChild("ClientFX")
	if fx then
		table.insert(ignore, fx)
	end
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	local origin = camera.CFrame.Position
	local direction = camera.CFrame.LookVector * 300
	for _ = 1, 3 do
		params.FilterDescendantsInstances = ignore
		local hit = workspace:Raycast(origin, direction, params)
		if not hit then
			return MAX_FOCUS
		end
		if hit.Instance.Transparency < 0.3 then
			return (hit.Position - origin).Magnitude
		end
		table.insert(ignore, hit.Instance)
	end
	return MAX_FOCUS
end

-- Dos desenfoques a la vez no: mientras se apunta, el de calidad Ultra se apaga
local function pauseQualityDof(pause)
	if pause then
		local quality = Lighting:FindFirstChild("QualityDOF")
		if quality and quality:IsA("DepthOfFieldEffect") and quality.Enabled then
			quality.Enabled = false
			pausedQualityDof = quality
		end
	elseif pausedQualityDof then
		if pausedQualityDof.Parent and ClientState.EffectiveQuality == "Ultra" then
			pausedQualityDof.Enabled = true
		end
		pausedQualityDof = nil
	end
end

local function buildVignette()
	gui = Instance.new("ScreenGui")
	gui.Name = "AimVignette"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = -1 -- (debajo del HUD)
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local specs = {
		{ Vector2.new(0.5, 0), UDim2.fromScale(0.5, 0), UDim2.fromScale(1, 0.3), 90 },
		{ Vector2.new(0.5, 1), UDim2.fromScale(0.5, 1), UDim2.fromScale(1, 0.3), -90 },
		{ Vector2.new(0, 0.5), UDim2.fromScale(0, 0.5), UDim2.fromScale(0.25, 1), 0 },
		{ Vector2.new(1, 0.5), UDim2.fromScale(1, 0.5), UDim2.fromScale(0.25, 1), 180 },
	}
	for i, spec in specs do
		local frame = Instance.new("Frame")
		frame.Name = "Edge" .. i
		frame.AnchorPoint = spec[1]
		frame.Position = spec[2]
		frame.Size = spec[3]
		frame.BorderSizePixel = 0
		frame.BackgroundColor3 = Color3.new(0, 0, 0)
		frame.BackgroundTransparency = 1
		local gradient = Instance.new("UIGradient")
		gradient.Rotation = spec[4]
		gradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.7, 0.9),
			NumberSequenceKeypoint.new(1, 1),
		})
		gradient.Parent = frame
		frame.Parent = gui
		edges[i] = frame
	end
end

local function ensureDof(camera)
	if dof and dof.Parent == camera then
		return dof
	end
	if dof then
		dof:Destroy()
	end
	dof = Instance.new("DepthOfFieldEffect")
	dof.Name = "AimDepthOfField"
	dof.NearIntensity = 0
	dof.FarIntensity = 0
	dof.FocusDistance = 60
	dof.InFocusRadius = 30
	dof.Enabled = false
	dof.Parent = camera
	return dof
end

function AimFX.Update(dt)
	dt = dt or 1 / 60
	local camera = workspace.CurrentCamera
	if not camera or not gui then
		return
	end
	local alpha = ClientState.AimAlpha or 0
	local def = ClientState.CurrentDef
	-- (con el visor de francotirador puesto lo tapa todo el visor)
	local scoped = def ~= nil and def.Scope == true and alpha > 0.85
	local active = alpha > 0.02 and not scoped and not ClientState.InMainMenu and not ClientState.Dead
	local low = ClientState.EffectiveQuality == "Baja"

	-- Viñeta: bordes algo más oscuros al apuntar
	local edgeTransparency = active and (1 - MAX_VIGNETTE * alpha) or 1
	for _, edge in edges do
		edge.BackgroundTransparency = edgeTransparency
	end

	local effect = ensureDof(camera)
	if not active or low then
		effect.Enabled = false
		pauseQualityDof(false)
		return
	end
	-- Enfoque a lo que hay bajo la mira (suave, como el ojo)
	local target = math.clamp(focusTarget(camera), 6, MAX_FOCUS)
	focus += (target - focus) * math.min(1, dt * 8)
	pauseQualityDof(true)
	effect.Enabled = true
	effect.FocusDistance = math.min(focus, MAX_FOCUS)
	effect.InFocusRadius = math.clamp(focus * 0.45, 10, MAX_RADIUS)
	effect.FarIntensity = MAX_BLUR * alpha
	effect.NearIntensity = 0
end

function AimFX.Init()
	buildVignette()
	RunService.RenderStepped:Connect(function(dt)
		local ok, err = pcall(AimFX.Update, dt)
		if not ok then
			warn("[AimFX]", err)
		end
	end)
end

return AimFX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="90">
            <Properties>
              <string name="Name">Ambience</string>
              <string name="Source"><![CDATA[-- Sonido ambiente de los mapas realistas (atributo Ambience de workspace.Map, lo pone cada mapa):
--   "War"  (Encrucijada): explosiones y ráfagas lejanas, como una guerra en otros barrios, y algo de viento
--   "Base" (Base Militar): disparos sueltos de la galería de tiro a lo lejos y brisa
--   "Wind" (Cumbre): viento fuerte de montaña
--   y en los demás mapas: "Breeze" (brisa), "Snow" (viento helado), "Coast" (brisa y olas que rompen),
--   "Night" (viento suave de noche), "Jungle", "Factory" (nave: casi nada, eco de nave) y "Desert"
-- Y el tiempo (atributo Weather de workspace.Map): "Rain" = lluvia alrededor de la cámara, ruido de
-- lluvia y, de vez en cuando, un relámpago (destello) y el trueno un par de segundos después.
-- Todo con sonidos que vienen con Roblox, apagados (filtro de graves) para que suenen lejos. Solo
-- durante la partida y nunca en la pantalla de inicio.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local ClientState = require(script.Parent.ClientState)

local Ambience = {}

local WIND_ID = "rbxasset://sounds/action_falling.mp3"
local BOOM_ID = "rbxasset://sounds/Rocket shot.wav"
local SHOT_ID = "rbxasset://sounds/paintball.wav"
local WAVE_ID = "rbxasset://sounds/impact_water.mp3"

local PRESETS = {
	War = { Wind = 0.12, WindSpeed = 0.55, Booms = { 9, 22 }, Bursts = { 4, 11 } },
	Base = { Wind = 0.07, WindSpeed = 0.5, Booms = nil, Bursts = { 6, 16 } },
	Wind = { Wind = 0.4, WindSpeed = 0.42, Booms = nil, Bursts = nil },
	Breeze = { Wind = 0.06, WindSpeed = 0.5 },
	Snow = { Wind = 0.22, WindSpeed = 0.45 },
	Coast = { Wind = 0.1, WindSpeed = 0.55, Waves = { 5, 10 } },
	Night = { Wind = 0.12, WindSpeed = 0.38 },
	Jungle = { Wind = 0.07, WindSpeed = 0.62 },
	Factory = { Wind = 0.03, WindSpeed = 0.3 },
	Desert = { Wind = 0.16, WindSpeed = 0.5 },
}

local group, wind
local nextBoom, nextBurst, nextWave = 0, 0, 0
local rainBox, rainSound, rainConnection
local nextThunder = 0

-- Grupo con filtro de graves y un poco de eco: todo suena lejano
local function ensureGroup()
	if group and group.Parent then
		return group
	end
	group = Instance.new("SoundGroup")
	group.Name = "Ambiente"
	group.Volume = 1
	local eq = Instance.new("EqualizerSoundEffect")
	eq.HighGain = -28
	eq.MidGain = -8
	eq.LowGain = 3
	eq.Parent = group
	local reverb = Instance.new("ReverbSoundEffect")
	reverb.DecayTime = 2.2
	reverb.WetLevel = -6
	reverb.Parent = group
	group.Parent = SoundService
	return group
end

local function oneShot(id, volume, speed)
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume
	sound.PlaybackSpeed = speed
	sound.SoundGroup = ensureGroup()
	sound.Parent = SoundService
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	task.delay(6, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
end

-- Ráfaga lejana: 3 a 7 disparos seguidos con la cadencia de un fusil
local function burst()
	local shots = math.random(3, 7)
	local speed = 0.55 + math.random() * 0.25
	local volume = 0.05 + math.random() * 0.06
	task.spawn(function()
		for _ = 1, shots do
			oneShot(SHOT_ID, volume, speed * (0.95 + math.random() * 0.1))
			task.wait(0.08 + math.random() * 0.05)
		end
	end)
end

local function current()
	if ClientState.InMainMenu or ReplicatedStorage:GetAttribute("State") == "Intermission" then
		return nil
	end
	local map = workspace:FindFirstChild("Map")
	local kind = map and map:GetAttribute("Ambience")
	return kind and PRESETS[kind] or nil
end

-- Lluvia: una caja invisible encima de la cámara que la sigue y suelta gotas rápidas y alargadas
local function startRain()
	if rainBox and rainBox.Parent then
		return
	end
	rainBox = Instance.new("Part")
	rainBox.Name = "RainBox"
	rainBox.Anchored = true
	rainBox.CanCollide = false
	rainBox.CanQuery = false
	rainBox.CanTouch = false
	rainBox.Transparency = 1
	rainBox.Size = Vector3.new(70, 1, 70)
	local drops = Instance.new("ParticleEmitter")
	drops.Name = "Drops"
	drops.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	drops.Color = ColorSequence.new(Color3.fromRGB(200, 210, 225))
	drops.LightInfluence = 1
	drops.Transparency = NumberSequence.new(0.45)
	drops.Size = NumberSequence.new(0.09)
	drops.Squash = NumberSequence.new(-2.5) -- (gotas alargadas en la dirección en la que caen)
	drops.Orientation = Enum.ParticleOrientation.VelocityParallel
	drops.Lifetime = NumberRange.new(0.55, 0.7)
	drops.Speed = NumberRange.new(85, 100)
	drops.SpreadAngle = Vector2.new(4, 4)
	drops.EmissionDirection = Enum.NormalId.Bottom
	drops.Rate = 650
	drops.Shape = Enum.ParticleEmitterShape.Box
	drops.Parent = rainBox
	rainBox.Parent = workspace.CurrentCamera or workspace
	rainSound = Instance.new("Sound")
	rainSound.Name = "AmbienceRain"
	rainSound.SoundId = WIND_ID
	rainSound.Looped = true
	rainSound.Volume = 0.22
	rainSound.PlaybackSpeed = 1.45 -- (el viento acelerado suena como lluvia)
	rainSound.Parent = SoundService
	rainSound:Play()
	rainConnection = RunService.Heartbeat:Connect(function()
		local camera = workspace.CurrentCamera
		if camera and rainBox then
			local p = camera.CFrame.Position
			rainBox.CFrame = CFrame.new(p.X, p.Y + 40, p.Z)
		end
	end)
end

local function stopRain()
	if rainConnection then
		rainConnection:Disconnect()
		rainConnection = nil
	end
	if rainBox then
		rainBox:Destroy()
		rainBox = nil
	end
	if rainSound then
		rainSound:Destroy()
		rainSound = nil
	end
end

-- Relámpago: la escena se ilumina de golpe un instante y el trueno llega después
local function lightning()
	local before = Lighting.ExposureCompensation
	Lighting.ExposureCompensation = before + 1.6
	task.delay(0.08, function()
		Lighting.ExposureCompensation = before + 0.4
		task.wait(0.06)
		Lighting.ExposureCompensation = before + 1.1
		task.wait(0.1)
		Lighting.ExposureCompensation = before
	end)
	task.delay(1 + math.random() * 2, function()
		oneShot(BOOM_ID, 0.45, 0.22 + math.random() * 0.06)
	end)
end

-- Eco del sitio (SoundService.AmbientReverb, afecta a todos los sonidos): dentro de un edificio los
-- disparos retumban como en una habitación; fuera, según el mapa (ciudad, montaña, campo abierto)
local OUTDOOR_REVERB = {
	War = Enum.ReverbType.City,
	Base = Enum.ReverbType.Plain,
	Wind = Enum.ReverbType.Mountains,
	Snow = Enum.ReverbType.Mountains,
	Jungle = Enum.ReverbType.Forest,
	Factory = Enum.ReverbType.Hangar,
}
local reverbParams = RaycastParams.new()
reverbParams.FilterType = Enum.RaycastFilterType.Include
local function updateReverb(map, preset)
	local reverb = Enum.ReverbType.NoReverb
	local camera = workspace.CurrentCamera
	if map and camera and not ClientState.InMainMenu then
		reverb = (preset and OUTDOOR_REVERB[map:GetAttribute("Ambience")]) or Enum.ReverbType.Plain
		-- ¿Bajo techo? (y no es el techo invisible del límite del mapa)
		reverbParams.FilterDescendantsInstances = { map }
		local roof = workspace:Raycast(camera.CFrame.Position, Vector3.new(0, 30, 0), reverbParams)
		local boundary = map:FindFirstChild("Boundary")
		if roof and not (boundary and roof.Instance:IsDescendantOf(boundary)) and roof.Instance.Name ~= "Boundary" then
			-- (y con paredes alrededor: bajo un árbol o un toldo sigue siendo la calle)
			local walls = 0
			local origin = camera.CFrame.Position
			for _, direction in { Vector3.new(24, 0, 0), Vector3.new(-24, 0, 0), Vector3.new(0, 0, 24), Vector3.new(0, 0, -24) } do
				local hit = workspace:Raycast(origin, direction, reverbParams)
				if hit and not (boundary and hit.Instance:IsDescendantOf(boundary)) then
					walls += 1
				end
			end
			if walls >= 2 then
				reverb = roof.Distance < 14 and Enum.ReverbType.Room or Enum.ReverbType.Hallway
			end
		end
	end
	if SoundService.AmbientReverb ~= reverb then
		SoundService.AmbientReverb = reverb
	end
	Ambience.Reverb = reverb
end

function Ambience.Update()
	local preset = current()
	local map = workspace:FindFirstChild("Map")
	pcall(updateReverb, map, preset)
	local raining = preset ~= nil and map ~= nil and map:GetAttribute("Weather") == "Rain"
	if raining then
		startRain()
		-- Bajo techo no caen gotas (seguirían atravesando el tejado); en calidad Baja, menos gotas
		local drops = rainBox and rainBox:FindFirstChild("Drops")
		local camera = workspace.CurrentCamera
		if drops and drops:IsA("ParticleEmitter") and camera then
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Include
			params.FilterDescendantsInstances = { map }
			local roof = workspace:Raycast(camera.CFrame.Position, Vector3.new(0, 60, 0), params)
			-- (el techo invisible del límite del mapa no cuenta como tejado)
			local boundary = map:FindFirstChild("Boundary")
			if roof and boundary and roof.Instance:IsDescendantOf(boundary) then
				roof = nil
			end
			drops.Enabled = roof == nil
			local quality = ClientState.EffectiveQuality
			drops.Rate = (quality == "Baja" and 250) or (quality == "Media" and 420) or 650
		end
		if os.clock() >= nextThunder then
			if nextThunder > 0 then
				lightning()
			end
			nextThunder = os.clock() + 14 + math.random() * 18
		end
	else
		stopRain()
	end
	if not preset then
		if wind then
			wind.Volume = 0
		end
		return
	end
	if not wind or not wind.Parent then
		wind = Instance.new("Sound")
		wind.Name = "AmbienceWind"
		wind.SoundId = WIND_ID
		wind.Looped = true
		wind.SoundGroup = ensureGroup()
		wind.Parent = SoundService
		wind:Play()
	end
	-- (el viento sube y baja poco a poco, como ráfagas)
	local gust = 0.8 + 0.2 * math.sin(os.clock() * 0.35) + 0.1 * math.sin(os.clock() * 1.3)
	-- (con ventisca, el viento sopla mucho más fuerte)
	local storm = map ~= nil and map:GetAttribute("Weather") == "Snowstorm"
	wind.Volume = preset.Wind * gust * (storm and 1.7 or 1)
	wind.PlaybackSpeed = preset.WindSpeed
	if not wind.IsPlaying then
		wind:Play()
	end
	local now = os.clock()
	if preset.Booms and now >= nextBoom then
		if nextBoom > 0 then
			oneShot(BOOM_ID, 0.18 + math.random() * 0.15, 0.3 + math.random() * 0.12)
		end
		nextBoom = now + preset.Booms[1] + math.random() * (preset.Booms[2] - preset.Booms[1])
	end
	if preset.Bursts and now >= nextBurst then
		if nextBurst > 0 then
			burst()
		end
		nextBurst = now + preset.Bursts[1] + math.random() * (preset.Bursts[2] - preset.Bursts[1])
	end
	-- Olas que rompen a lo lejos (puertos y playas)
	if preset.Waves and now >= nextWave then
		if nextWave > 0 then
			oneShot(WAVE_ID, 0.08 + math.random() * 0.06, 0.45 + math.random() * 0.15)
		end
		nextWave = now + preset.Waves[1] + math.random() * (preset.Waves[2] - preset.Waves[1])
	end
end

function Ambience.Init()
	task.spawn(function()
		while true do
			local ok, err = pcall(Ambience.Update)
			if not ok then
				warn("[Ambiente]", err)
				task.wait(5)
			end
			task.wait(0.25)
		end
	end)
end

return Ambience
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="91">
            <Properties>
              <string name="Name">BodyView</string>
              <string name="Source"><![CDATA[-- Tu cuerpo en primera persona: al mirar hacia abajo ves tus piernas y tus botas (con lo que lleve el
-- traje o el uniforme en ellas), como en los shooters modernos. Roblox esconde todo el personaje en
-- primera persona; aquí, justo después de la cámara, se vuelven a mostrar la cadera y las piernas. Se
-- esconden otra vez agachado o deslizándote (la cámara baja y las atravesaría), muerto, en el menú y
-- con la cámara lejos (emotes).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ClientState = require(script.Parent.ClientState)

local BodyView = {}

local LOWER_BODY = {
	LowerTorso = true,
	LeftUpperLeg = true,
	LeftLowerLeg = true,
	LeftFoot = true,
	RightUpperLeg = true,
	RightLowerLeg = true,
	RightFoot = true,
}

local player = Players.LocalPlayer
local shown = {} -- piezas a mostrar del personaje actual
local character = nil
local pending = false -- (una sola recogida por fotograma aunque lleguen muchas piezas de golpe)

-- La cadera, las piernas y lo que va pegado a ellas (botas, rodilleras, cinturón del traje)
local function collect(model)
	table.clear(shown)
	if not model then
		return
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and LOWER_BODY[d.Name] then
			table.insert(shown, d)
		end
	end
	for _, d in model:GetDescendants() do
		if d:IsA("WeldConstraint") or d:IsA("Weld") then
			local a, b = d.Part0, d.Part1
			local onLeg = (a and LOWER_BODY[a.Name] and a:IsDescendantOf(model)) or (b and LOWER_BODY[b.Name] and b:IsDescendantOf(model))
			if onLeg then
				for _, part in { a, b } do
					if part and part:IsA("BasePart") and not LOWER_BODY[part.Name] and not table.find(shown, part) then
						table.insert(shown, part)
					end
				end
			end
		end
	end
end

-- ¿Se ven las piernas ahora? (primera persona, de pie o andando)
function BodyView.Active()
	if not character or ClientState.Dead or ClientState.InMainMenu or ClientState.Emoting then
		return false
	end
	if ClientState.Crouching or ClientState.Sliding then
		return false
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local head = character:FindFirstChild("Head")
	local camera = workspace.CurrentCamera
	if not humanoid or humanoid.Health <= 0 or not head or not camera then
		return false
	end
	return (camera.CFrame.Position - head.Position).Magnitude < 2
end

function BodyView.Update()
	if not BodyView.Active() then
		return
	end
	for _, part in shown do
		if part.Parent then
			part.LocalTransparencyModifier = 0
		end
	end
end

-- (para las pruebas)
function BodyView.Shown()
	return shown
end

function BodyView.Track(model)
	character = model
	collect(model)
	if model then
		-- Lo que se le pone después (uniforme, traje) también cuenta
		model.DescendantAdded:Connect(function()
			if character == model and not pending then
				pending = true
				task.defer(function()
					pending = false
					if character == model then
						collect(model)
					end
				end)
			end
		end)
	end
end

function BodyView.Init()
	if player.Character then
		BodyView.Track(player.Character)
	end
	player.CharacterAdded:Connect(BodyView.Track)
	-- Justo después de la cámara (que es la que esconde el personaje en primera persona)
	RunService:BindToRenderStep("BodyView", Enum.RenderPriority.Camera.Value + 2, function()
		local ok, err = pcall(BodyView.Update)
		if not ok then
			warn("[BodyView]", err)
		end
	end)
end

return BodyView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="92">
            <Properties>
              <string name="Name">BombHUD</string>
              <string name="Source"><![CDATA[-- Buscar y destruir: qué te toca (atacar o defender), la cuenta atrás de la bomba plantada y la
-- barra de plantar / desactivar. Debajo del marcador.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UI)
local ClientState = require(script.Parent.ClientState)

local player = Players.LocalPlayer

local BombHUD = {}

local gui, label, barBack, bar, barText, droppedMarker
local nextBeep = 0

-- Bomba plantada: la luz parpadea y pita, cada vez más deprisa según se acaba el tiempo
local function beep(timer)
	local bomb = workspace:FindFirstChild("PlantedBomb")
	local light = bomb and bomb:FindFirstChild("BombLight")
	if not light or not light:IsA("BasePart") then
		return
	end
	local now = os.clock()
	if now < nextBeep then
		return
	end
	nextBeep = now + math.clamp(timer / 30, 0.15, 1)
	light.Transparency = 0
	task.delay(0.08, function()
		if light.Parent then
			light.Transparency = 0.7
		end
	end)
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxasset://sounds/electronicpingshort.wav"
	sound.Volume = 0.55
	sound.PlaybackSpeed = 1.9
	sound.RollOffMaxDistance = 140
	sound.Parent = light
	sound:Play()
	task.delay(1.5, function()
		sound:Destroy()
	end)
end

local function update()
	local attackers = ReplicatedStorage:GetAttribute("Bomb_Attackers")
	gui.Enabled = attackers ~= nil and not ClientState.InMainMenu
	if not gui.Enabled then
		droppedMarker.Parent = nil
		return
	end
	local state = ReplicatedStorage:GetAttribute("Bomb_State")
	local site = ReplicatedStorage:GetAttribute("Bomb_Site") or ""
	local attacking = player.Team ~= nil and player.Team.Name == attackers
	if state == "Planted" then
		local timer = ReplicatedStorage:GetAttribute("Bomb_Timer") or 0
		beep(timer)
		label.Text = string.format("💣 BOMBA EN %s · %d s%s", site, timer, attacking and " · ¡protégela!" or " · ¡desactívala!")
		label.TextColor3 = Color3.fromRGB(255, 90, 70)
	elseif attacking then
		-- Quién lleva la bomba (solo el portador puede plantarla)
		local carrier = ReplicatedStorage:GetAttribute("Bomb_Carrier")
		if carrier == player.Name then
			label.Text = "💣 LLEVAS LA BOMBA · plántala en A o B"
		elseif typeof(ReplicatedStorage:GetAttribute("Bomb_Dropped")) == "Vector3" then
			label.Text = "💣 ¡LA BOMBA ESTÁ EN EL SUELO! · recógela"
		elseif carrier then
			local carrierPlayer = Players:FindFirstChild(tostring(carrier))
			local shown = carrierPlayer and carrierPlayer:IsA("Player") and carrierPlayer.DisplayName or tostring(carrier)
			label.Text = "💣 ATACAS · " .. shown .. " lleva la bomba: cúbrele"
		else
			label.Text = "💣 ATACAS · planta la bomba en A o B"
		end
		label.TextColor3 = Color3.fromRGB(255, 210, 90)
	else
		label.Text = "🛡️ DEFIENDES · protege A y B"
		label.TextColor3 = Color3.fromRGB(140, 200, 255)
	end
	-- Marca de la bomba en el suelo, solo para los atacantes (los defensores no la ven a través de las paredes)
	local dropped = ReplicatedStorage:GetAttribute("Bomb_Dropped")
	if attacking and state ~= "Planted" and typeof(dropped) == "Vector3" then
		droppedMarker.Position = dropped - Vector3.new(0, 2.5, 0)
		droppedMarker.Parent = workspace
	else
		droppedMarker.Parent = nil
	end
	local action = ReplicatedStorage:GetAttribute("Bomb_Action") or ""
	local progress = ReplicatedStorage:GetAttribute("Bomb_Progress") or 0
	barBack.Visible = action ~= "" and progress > 0
	bar.Size = UDim2.fromScale(math.clamp(progress, 0, 1), 1)
	bar.BackgroundColor3 = action == "Planting" and Color3.fromRGB(255, 120, 50) or Color3.fromRGB(80, 170, 255)
	barText.Text = (action == "Planting" and "PLANTANDO EN " .. site or "DESACTIVANDO") .. "..."
end

function BombHUD.Init()
	-- Marca de la bomba en el suelo (pieza invisible con el icono encima, solo en este cliente)
	droppedMarker = Instance.new("Part")
	droppedMarker.Name = "DroppedBombMarker"
	droppedMarker.Anchored = true
	droppedMarker.CanCollide = false
	droppedMarker.CanQuery = false
	droppedMarker.CanTouch = false
	droppedMarker.Transparency = 1
	droppedMarker.Size = Vector3.new(0.2, 0.2, 0.2)
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(36, 36)
	billboard.StudsOffset = Vector3.new(0, 2, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = 400
	billboard.Parent = droppedMarker
	local icon = Instance.new("TextLabel")
	icon.Size = UDim2.fromScale(1, 1)
	icon.BackgroundTransparency = 1
	icon.TextScaled = true
	icon.Text = "💣"
	icon.Parent = billboard
	gui = UI.new("ScreenGui", {
		Name = "BombHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 2,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	label = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 118),
		Size = UDim2.fromOffset(460, 30),
		Text = "",
		TextScaled = true, -- (con nombres largos se encoge)
		Parent = gui,
	}, { UI.new("UITextSizeConstraint", { MaxTextSize = 22 }) })
	barBack = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0.5, -30), -- (encima de la mira: debajo salen las medallas en el móvil)
		Size = UDim2.fromOffset(260, 22),
		BackgroundColor3 = Color3.fromRGB(20, 22, 28),
		BackgroundTransparency = 0.2,
		Visible = false,
		Parent = gui,
	}, { UI.corner(6), UI.stroke(Color3.new(0, 0, 0), 2, 0.2) })
	bar = UI.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BorderSizePixel = 0,
		Parent = barBack,
	}, { UI.corner(6) })
	barText = UI.label({
		Size = UDim2.fromScale(1, 1),
		Text = "",
		TextSize = 16,
		ZIndex = 2,
		Parent = barBack,
	})
	task.spawn(function()
		while gui.Parent do
			update()
			task.wait(0.15)
		end
	end)
end

BombHUD.Update = update

return BombHUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="93">
            <Properties>
              <string name="Name">BoostHUD</string>
              <string name="Source"><![CDATA[-- Potenciadores activos (Shop.Boosters): "⚡ x2 XP 23:10" arriba en el centro, debajo del marcador.
-- El servidor manda los segundos que quedan; aquí se cuentan hacia atrás solo mientras se juega
-- (igual que en el servidor) y se corrigen con cada actualización de datos.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shop = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Shop"))
local UI = require(script.Parent.UI)
local ClientState = require(script.Parent.ClientState)

local player = Players.LocalPlayer

local BoostHUD = {}

local left = {} -- [Field] = segundos que quedan
local label

local function format(seconds)
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

local function render()
	local parts = {}
	for _, booster in Shop.Boosters do
		local seconds = left[booster.Field] or 0
		if seconds > 0 then
			table.insert(parts, booster.Icon .. " x" .. booster.Multiplier .. (booster.Kind == "XP" and " XP " or " ") .. format(seconds))
		end
	end
	label.Text = table.concat(parts, "   ")
	label.Visible = #parts > 0 and not ClientState.InMainMenu and not ClientState.MenuOpen
end

function BoostHUD.Init()
	local gui = UI.new("ScreenGui", {
		Name = "Boosters",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		Parent = player:WaitForChild("PlayerGui"),
	})
	label = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 140), -- (debajo de la fila de jugadores del marcador)
		Size = UDim2.fromOffset(320, 22),
		Text = "",
		TextSize = 17,
		TextColor3 = Color3.fromRGB(120, 230, 255),
		Visible = false,
		Parent = gui,
	})
	local function onData(data)
		if not data then
			return
		end
		for _, booster in Shop.Boosters do
			-- (el servidor descuenta de 5 en 5 s: solo se corrige si se ha ido más que eso, para que
			-- el reloj no salte hacia arriba con cada baja)
			local server = tonumber(data[booster.Field]) or 0
			local mine = left[booster.Field]
			if not mine or math.abs(server - mine) > 6 or server == 0 then
				left[booster.Field] = server
			end
		end
		render()
	end
	ClientState.DataChanged.Event:Connect(onData)
	onData(ClientState.Data)
	task.spawn(function()
		while true do
			task.wait(1)
			if not ClientState.InMainMenu then
				for field, seconds in left do
					left[field] = math.max(0, seconds - 1)
				end
			end
			render()
		end
	end)
end

return BoostHUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="94">
            <Properties>
              <string name="Name">BotFootsteps</string>
              <string name="Source"><![CDATA[-- Pasos de los bots (solo en el cliente). Los personajes de los jugadores ya suenan al correr con los
-- sonidos de Roblox, pero los bots no: aquí cada bot cercano lleva el mismo sonido de pasos en bucle,
-- más rápido cuanto más corre, y solo mientras se mueve por el suelo. Los enemigos se oyen más que
-- los compañeros (como en los shooters: oír los pasos del rival es información).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local BotFootsteps = {}

local SOUND_ID = "rbxasset://sounds/action_footsteps_plastic.mp3"
local MAX_DISTANCE = 90 -- más lejos no se oyen (y no se gastan sonidos)
local CHECK_INTERVAL = 0.1
local ENEMY_VOLUME = 0.8
local ALLY_VOLUME = 0.35

local player = Players.LocalPlayer
local sounds = {} -- [modelo del bot] = Sound

local function isEnemy(model)
	if ReplicatedStorage:GetAttribute("TeamMode") == false then
		return true
	end
	local team = model:GetAttribute("Team")
	return team == nil or player.Team == nil or team ~= player.Team.Name
end

local function soundFor(model, root)
	local sound = sounds[model]
	if sound and sound.Parent == root then
		return sound
	end
	sound = Instance.new("Sound")
	sound.Name = "Pasos"
	sound.SoundId = SOUND_ID
	sound.Looped = true
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 6
	sound.RollOffMaxDistance = MAX_DISTANCE
	sound.Parent = root
	sounds[model] = sound
	return sound
end

local function update()
	local folder = workspace:FindFirstChild("Bots")
	local camera = workspace.CurrentCamera
	local seen = {}
	if folder and camera then
		for _, model in folder:GetChildren() do
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart")
			if humanoid and root and root:IsA("BasePart") and humanoid.Health > 0
				and (root.Position - camera.CFrame.Position).Magnitude < MAX_DISTANCE then
				seen[model] = true
				local velocity = root.AssemblyLinearVelocity
				local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
				local sound = soundFor(model, root)
				-- (en el aire o casi quieto no suenan)
				if speed > 3 and math.abs(velocity.Y) < 6 then
					sound.Volume = isEnemy(model) and ENEMY_VOLUME or ALLY_VOLUME
					sound.PlaybackSpeed = math.clamp(speed / 16, 0.7, 1.6)
					if not sound.IsPlaying then
						sound:Play()
					end
				elseif sound.IsPlaying then
					sound:Stop()
				end
			end
		end
	end
	-- Bots que se alejan, mueren o desaparecen: fuera su sonido
	for model, sound in sounds do
		if not seen[model] then
			sound:Destroy()
			sounds[model] = nil
		end
	end
end

function BotFootsteps.Init()
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < CHECK_INTERVAL then
			return
		end
		elapsed = 0
		update()
	end)
end

BotFootsteps.Update = update
return BotFootsteps
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="95">
            <Properties>
              <string name="Name">ChatTags</string>
              <string name="Source"><![CDATA[-- Etiquetas en el chat: [VIP] dorada para quien tenga el pase VIP, el icono de su rango competitivo,
-- el nivel de cada jugador (con color según el nivel) y su título. Solo cambia cómo se ve el mensaje (TextChatService, chat nuevo de Roblox).
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Ranks = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Ranks"))

local ChatTags = {}

-- Color del nivel: gris, verde, azul, morado y dorado según se sube
local function levelColor(level)
	if level >= 40 then
		return "#FFC83C"
	elseif level >= 25 then
		return "#C064FF"
	elseif level >= 12 then
		return "#4AA8FF"
	elseif level >= 5 then
		return "#6EE06E"
	end
	return "#C8C8D2"
end

local function tagsFor(player)
	local tags = ""
	if player:GetAttribute("VIP") then
		tags ..= '<font color="#FFC83C">[VIP]</font> '
	end
	local rank = Ranks.Tiers[player:GetAttribute("Rank") or 0]
	if rank then
		tags ..= rank.Icon .. " "
	end
	local stats = player:FindFirstChild("leaderstats")
	local level = stats and stats:FindFirstChild("Nivel")
	if level and typeof(level.Value) == "number" then
		tags ..= string.format('<font color="%s">[Nv %d]</font> ', levelColor(level.Value), level.Value)
	end
	-- Título elegido (Titles)
	local title = player:GetAttribute("Title")
	local titleColor = player:GetAttribute("TitleColor")
	if type(title) == "string" and title ~= "" then
		tags ..= string.format('<font color="#%s">«%s»</font> ', typeof(titleColor) == "Color3" and titleColor:ToHex() or "C8C8D2", title)
	end
	return tags
end

function ChatTags.Init()
	if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
		return -- chat antiguo: no se puede personalizar así
	end
	TextChatService.OnIncomingMessage = function(message)
		local properties = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		local player = source and Players:GetPlayerByUserId(source.UserId)
		if player then
			properties.PrefixText = tagsFor(player) .. message.PrefixText
		end
		return properties
	end
end

return ChatTags
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="96">
            <Properties>
              <string name="Name">ClientState</string>
              <string name="Source"><![CDATA[-- Estado compartido entre los módulos del cliente.
local ClientState = {
	Data = nil, -- datos de progreso (nivel, XP, skins...)
	Settings = nil :: { [string]: any }?, -- ajustes del jugador (los rellena Settings)
	EffectiveQuality = "Media", -- calidad real aplicada ("Auto" ya resuelto); la rellena Settings
	Dead = false, -- pantalla de muerte abierta (la rellena DeathScreen)
	KillcamActive = false, -- la killcam se está viendo (DeathScreen; el HUD oculta su «ELIMINADO POR»)
	Emoting = false, -- haciendo un emote (cámara en tercera persona, arma oculta)
	EmoteMenuOpen = false, -- menú de emotes abierto (N)
	TutorialOpen = false, -- tarjeta de controles de la primera partida en pantalla
	WheelOpen = false, -- ruleta diaria abierta
	NewsOpen = false, -- tarjeta de novedades abierta (News)
	FovKick = 0, -- empujón de campo de visión (habilidades); lo consume WeaponController
	Shake = 0, -- temblor de cámara pendiente (explosiones cercanas); lo consume WeaponController
	ConcussedUntil = 0, -- aturdido por una explosión cercana hasta este os.clock() (CombatFX)
	SuppressedAt = 0, -- última bala que pasó rozando (os.clock(); CombatFX)
	MenuOpen = false, -- menú del pase/tienda abierto
	VoteOpen = false, -- panel de votación con el ratón libre
	InMainMenu = true, -- pantalla de inicio visible
	Aiming = false,
	AimAlpha = 0, -- 0 = cadera, 1 = apuntando
	Sprinting = false,
	Stamina = 1, -- 0..1 (correr la gasta; Movement)
	Exhausted = false, -- se agotó y aún no se ha recuperado lo bastante para correr
	LandKick = 0, -- golpe de cámara al aterrizar desde alto; lo consume WeaponController
	MinimapBottom = nil :: number?, -- borde de abajo del minimapa (para colocar lo de debajo)
	Sliding = false,
	Crouching = false, -- agachado (C sin correr): más bajo, más lento y más preciso
	CurrentTool = nil,
	CurrentDef = nil,
	Ammo = 0,
	Reloading = false,
	ReloadProgress = 0,
	LastShotTime = 0,
	LastHitPosition = nil :: Vector3?, -- dónde dio tu último disparo a un personaje (números de daño)
	LastHitTime = 0,
	LastHitModel = nil :: Model?, -- a quién dio ese disparo (el destello al impactar)
	VotePanelVisible = false, -- hay votación de mapa en pantalla (la V es para votar, no para inspeccionar)
	Dashing = false, -- impulso (E) en curso: no se puede deslizar a la vez
	MenuClosedAt = 0, -- cuándo se cerró la tienda (la B no revive justo después)
	Bloom = 0, -- apertura extra de la mira por disparos
	Spread = 0, -- dispersión actual (grados)

	DataChanged = Instance.new("BindableEvent"),
	WeaponChanged = Instance.new("BindableEvent"),
	ShotFired = Instance.new("BindableEvent"),
}

-- ¿Hay algún menú que impida jugar (disparar, moverse con el ratón...)?
function ClientState.IsBlocked()
	return ClientState.MenuOpen or ClientState.VoteOpen or ClientState.InMainMenu or ClientState.Dead or ClientState.EmoteMenuOpen
		or ClientState.TutorialOpen or ClientState.WheelOpen or ClientState.NewsOpen
end

-- Cuenta atrás de Eliminación: quietos y sin disparar (lo decide el servidor)
function ClientState.Frozen()
	return game:GetService("ReplicatedStorage"):GetAttribute("Frozen") == true
end

-- El cursor se ve siempre que haya algún menú abierto (cada menú llama a esto al abrirse o cerrarse)
function ClientState.UpdateMouse()
	local blocked = ClientState.IsBlocked()
	game:GetService("UserInputService").MouseIconEnabled = blocked
	-- Botones táctiles del juego: ocultos mientras hay un menú abierto
	-- (los botones táctiles son nuestros, de TouchLayout: se pide aquí para no requerirlo al cargar)
	local okLayout, TouchLayout = pcall(require, script.Parent.TouchLayout)
	if not okLayout then
		return
	end
	-- (el de emotes sigue visible con su propia rueda abierta: en el móvil es la forma de cerrarla)
	local onlyEmotes = ClientState.EmoteMenuOpen and not (ClientState.MenuOpen or ClientState.VoteOpen or ClientState.InMainMenu
		or ClientState.Dead or ClientState.TutorialOpen or ClientState.WheelOpen or ClientState.NewsOpen)
	for _, name in { "Fire", "Aim", "Reload", "Melee", "SwapWeapon", "Sprint", "Slide", "Grenade", "Airstrike", "Emotes", "Spray", "Scoreboard" } do
		local button = TouchLayout.GetButton(name)
		if button then
			button.Visible = not blocked or (name == "Emotes" and onlyEmotes)
			-- (el del ataque aéreo solo cuando hay alguno listo)
			if name == "Airstrike" then
				button.Visible = button.Visible and (game:GetService("Players").LocalPlayer:GetAttribute("Airstrikes") or 0) > 0
			end
		end
	end
end

function ClientState.SetData(data)
	if type(data) ~= "table" then
		return
	end
	ClientState.Data = data
	ClientState.DataChanged:Fire(data)
end

return ClientState
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="97">
            <Properties>
              <string name="Name">CombatFX</string>
              <string name="Source"><![CDATA[-- Sensaciones de combate (realismo), solo en este cliente:
--   Concussion: una explosión cerca te aturde: destello blanco, desenfoque, pitido en los oídos y todo
--               lo demás suena apagado unos segundos (más cuanto más cerca)
--   Suppress:   balas que pasan rozando: un instante de desenfoque y la imagen se oscurece (supresión)
--   Latido:     con poca vida, un latido grave que se acelera cuanto menos vida queda
-- En calidad Baja, sin desenfoques (cuestan en móviles modestos); el sonido sí.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Sounds = require(ReplicatedStorage.Shared.Sounds)
local ClientState = require(script.Parent.ClientState)

local CombatFX = {}

local player = Players.LocalPlayer
local blur, flash, ring
local muffles = {}
local muffleUntil, muffleStrength = 0, 0
local blurTarget = 0
local nextBeat = 0

local function lowQuality()
	return ClientState.EffectiveQuality == "Baja"
end

local function ensureEffects()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	if not blur or blur.Parent ~= camera then
		blur = Instance.new("BlurEffect")
		blur.Name = "CombatBlur"
		blur.Size = 0
		blur.Parent = camera
	end
	if not flash or flash.Parent ~= camera then
		flash = Instance.new("ColorCorrectionEffect")
		flash.Name = "CombatFlash"
		flash.Parent = camera
	end
end

-- Filtro que apaga los agudos de todo lo que suena (el oído "taponado" tras una explosión): uno en
-- cada grupo de sonido (armas, ambiente y el resto, ver Sounds), que es donde Roblox aplica los efectos
local function ensureMuffles()
	Sounds.GetWorldGroup()
	Sounds.GetGunGroup()
	muffles = {}
	for _, group in SoundService:GetChildren() do
		if group:IsA("SoundGroup") then
			local eq = group:FindFirstChild("ConcussionMuffle")
			if not eq then
				eq = Instance.new("EqualizerSoundEffect")
				eq.Name = "ConcussionMuffle"
				eq.HighGain = 0
				eq.MidGain = 0
				eq.LowGain = 0
				eq.Priority = 10
				eq.Parent = group
			end
			table.insert(muffles, eq)
		end
	end
end

local function setMuffle(high, mid)
	for _, eq in muffles do
		if eq.Parent then
			eq.HighGain = high
			eq.MidGain = mid
			eq.Enabled = high < -0.5
		end
	end
end

-- strength: 0..1 (1 = la explosión casi encima)
function CombatFX.Concussion(strength)
	strength = math.clamp(strength or 0, 0, 1)
	-- (muerto: la cámara es la de la killcam o la de observar, no tus oídos)
	if strength < 0.2 or ClientState.InMainMenu or ClientState.Dead then
		return
	end
	ensureEffects()
	if not lowQuality() and blur and flash then
		blur.Size = 18 * strength
		blurTarget = 0
		flash.Brightness = 0.45 * strength
		flash.Contrast = -0.2 * strength
		flash.Saturation = -0.5 * strength
		TweenService:Create(flash, TweenInfo.new(1.6 * strength + 0.4), { Brightness = 0, Contrast = 0, Saturation = 0 }):Play()
	end
	-- Oído taponado: los agudos y medios bajan de golpe y vuelven poco a poco
	muffleStrength = strength
	muffleUntil = os.clock() + 1.2 + 2.3 * strength
	ensureMuffles()
	setMuffle(-30 * strength, -14 * strength)
	-- Pitido en los oídos (fuera de los grupos: no se apaga con el filtro)
	if ring then
		ring:Destroy()
	end
	ring = Sounds.Play("Tinnitus", nil, 1, 0.4 + 0.6 * strength)
	if ring then
		ring.Name = "Tinnitus"
		ring.SoundGroup = nil
		ring.Looped = true
		local fade = 1.4 + 2.2 * strength
		TweenService:Create(ring, TweenInfo.new(fade), { Volume = 0 }):Play()
		local sound = ring
		task.delay(fade + 0.1, function()
			if sound.Parent then
				sound:Destroy()
			end
		end)
	end
	ClientState.ConcussedUntil = muffleUntil
end

-- Bala que pasa rozando: un instante de desenfoque y la imagen se oscurece un poco (te "encoges")
function CombatFX.Suppress(amount)
	amount = math.clamp(amount or 0.5, 0, 1)
	if ClientState.Dead or ClientState.InMainMenu then
		return
	end
	ensureEffects()
	if not lowQuality() and blur and flash then
		blur.Size = math.max(blur.Size, 5 * amount)
		blurTarget = 0
		-- (sin pisar el destello de una explosión que aún se está yendo)
		if os.clock() >= muffleUntil then
			flash.Brightness = -0.06 * amount
			flash.Contrast = 0.1 * amount
			flash.Saturation = -0.2 * amount
			TweenService:Create(flash, TweenInfo.new(0.5), { Brightness = 0, Contrast = 0, Saturation = 0 }):Play()
		end
	end
	ClientState.SuppressedAt = os.clock()
end

function CombatFX.Update(dt)
	dt = dt or 1 / 60
	-- El desenfoque se va solo (y al morir o en el menú, al momento: que se vea bien la killcam)
	if blur and blur.Size > blurTarget then
		if ClientState.Dead or ClientState.InMainMenu then
			blur.Size = blurTarget
		else
			blur.Size = math.max(blurTarget, blur.Size - dt * 9)
		end
	end
	-- El oído se destapona poco a poco
	if #muffles > 0 then
		local left = muffleUntil - os.clock()
		if left <= 0 then
			setMuffle(0, 0)
			muffles = {}
		else
			local k = math.clamp(left / (1.2 + 2.3 * math.max(muffleStrength, 0.01)), 0, 1)
			setMuffle(-30 * muffleStrength * k, -14 * muffleStrength * k)
		end
	end
	-- Latido con poca vida
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 and humanoid.MaxHealth > 0 and not ClientState.InMainMenu then
		local ratio = humanoid.Health / humanoid.MaxHealth
		if ratio < 0.35 then
			local now = os.clock()
			if now >= nextBeat then
				local danger = 1 - ratio / 0.35
				-- (dos golpes, "pum-pum", cada vez más seguidos)
				Sounds.Play("Boom", nil, 0.55, 0.35 + 0.35 * danger)
				task.delay(0.16, function()
					Sounds.Play("Boom", nil, 0.5, 0.25 + 0.25 * danger)
				end)
				nextBeat = now + (1.1 - 0.5 * danger)
			end
		end
	end
end

function CombatFX.Init()
	RunService.RenderStepped:Connect(function(dt)
		local ok, err = pcall(CombatFX.Update, dt)
		if not ok then
			warn("[CombatFX]", err)
		end
	end)
end

return CombatFX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">DamageIndicator</string>
              <string name="Source"><![CDATA[-- Indicador de daño: al recibir un disparo sale una marca roja alrededor de la mira que apunta hacia
-- quien te ha dado (sigue su posición mientras se desvanece). El servidor deja en tu Humanoid quién
-- fue (atributos LastAttacker / LastBot, ver Combat) y LastHitTime cambia con cada impacto.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local UI = require(script.Parent.UI)
local ClientState = require(script.Parent.ClientState)

local player = Players.LocalPlayer

local DamageIndicator = {}

local RADIUS = 150
local FADE_TIME = 1.4
local MAX_MARKS = 4

local gui, holder
local marks = {} -- { Key, Frame, Source, ShownAt }

local function attackerPosition(source)
	if source.UserId then
		local other = Players:GetPlayerByUserId(source.UserId)
		local root = other and other.Character and other.Character:FindFirstChild("HumanoidRootPart")
		return root and root.Position
	end
	local folder = workspace:FindFirstChild("Bots")
	local model = folder and folder:FindFirstChild(source.Bot)
	local root = model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart)
	return root and root.Position
end

local function newMark()
	local frame = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(110, 16),
		BackgroundColor3 = Color3.fromRGB(255, 40, 40),
		BorderSizePixel = 0,
		Parent = holder,
	}, {
		UI.corner(8),
		UI.new("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.3, 0.15),
				NumberSequenceKeypoint.new(0.7, 0.15),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})
	-- Punta hacia fuera (hacia el atacante)
	UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, 2),
		Size = UDim2.fromOffset(24, 18),
		Text = "▲",
		TextSize = 18,
		TextColor3 = Color3.fromRGB(255, 60, 60),
		TextStrokeTransparency = 1,
		Parent = frame,
	})
	return frame
end

local function onHit(humanoid)
	local userId = humanoid:GetAttribute("LastAttacker")
	local bot = humanoid:GetAttribute("LastBot")
	if userId == player.UserId then
		return -- (tu propio cohete o granada)
	end
	-- Con escudo (al reaparecer o en la pantalla de inicio) el disparo no hace daño: sin marca
	local character = humanoid.Parent
	if ClientState.Dead or ClientState.InMainMenu or (character and character:FindFirstChildOfClass("ForceField")) then
		return
	end
	local source = userId and { UserId = userId } or (bot and { Bot = bot }) or nil
	if not source then
		return
	end
	local key = userId and ("p" .. userId) or ("b" .. bot)
	for _, mark in marks do
		if mark.Key == key then
			mark.ShownAt = os.clock()
			mark.Source = source
			return
		end
	end
	if #marks >= MAX_MARKS then
		local oldest = table.remove(marks, 1)
		oldest.Frame:Destroy()
	end
	table.insert(marks, { Key = key, Frame = newMark(), Source = source, ShownAt = os.clock() })
end

local function clear()
	for _, mark in marks do
		mark.Frame:Destroy()
	end
	table.clear(marks)
end

local function update()
	if #marks == 0 then
		return
	end
	if ClientState.Dead or ClientState.InMainMenu then
		clear()
		return
	end
	local camera = workspace.CurrentCamera
	local now = os.clock()
	for i = #marks, 1, -1 do
		local mark = marks[i]
		local age = now - mark.ShownAt
		local position = attackerPosition(mark.Source)
		if age > FADE_TIME then
			mark.Frame:Destroy()
			table.remove(marks, i)
		else
			if position then
				mark.LastPosition = position
			end
			local target = mark.LastPosition
			if target then
				local relative = camera.CFrame:PointToObjectSpace(target)
				local angle = math.atan2(relative.X, -relative.Z) -- 0 = delante (arriba en pantalla)
				mark.Frame.Position = UDim2.new(0.5, math.sin(angle) * RADIUS, 0.5, -math.cos(angle) * RADIUS)
				mark.Frame.Rotation = math.deg(angle)
				mark.Frame.Visible = true
			else
				mark.Frame.Visible = false
			end
			-- Se desvanece en el último tramo
			local fade = math.clamp((age - FADE_TIME * 0.45) / (FADE_TIME * 0.55), 0, 1)
			mark.Frame.BackgroundTransparency = fade
			local arrow = mark.Frame:FindFirstChildOfClass("TextLabel")
			if arrow then
				arrow.TextTransparency = fade
			end
		end
	end
end

local function watch(character)
	clear()
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid or not humanoid:IsA("Humanoid") then
		return
	end
	humanoid:GetAttributeChangedSignal("LastHitTime"):Connect(function()
		onHit(humanoid)
	end)
end

function DamageIndicator.Init()
	gui = UI.new("ScreenGui", {
		Name = "DamageIndicator",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 4,
		Parent = player:WaitForChild("PlayerGui"),
	})
	holder = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
	player.CharacterAdded:Connect(watch)
	if player.Character then
		task.spawn(watch, player.Character)
	end
	RunService.RenderStepped:Connect(update)
end

return DamageIndicator
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="99">
            <Properties>
              <string name="Name">DeathScreen</string>
              <string name="Source"><![CDATA[-- Pantalla de muerte (estilo shooters de Roblox):
--   * Observas al que te eliminó en tercera persona (clic / clic derecho cambia de jugador)
--   * VOLVER AL MENÚ, REVIVIR INSTANTÁNEO (B, gasta un revivir: vuelves donde caíste) y
--     REGENERAR AHORA (Espacio o F, a partir de GameConfig.RespawnNowDelay)
-- Sin revivir disponibles, el botón abre la compra del pack (si está configurado en Shop).
-- En plena ronda de Eliminación (NoRespawn) no hay revivir ni regenerar: se observa hasta la siguiente.
-- También se puede observar a los bots (modelos en workspace.Bots).
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Shop = require(Shared.Shop)
local Sounds = require(Shared.Sounds)
local Weapons = require(Shared.Weapons)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local MainMenu = require(script.Parent.MainMenu)
local Menu = require(script.Parent.Menu)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local DeathScreen = {}

local gui: any = nil
local refs: { [string]: any } = {}
local deathTime = 0
local targets = {} -- jugadores (Player) o bots (Model) que se pueden observar
local targetIndex = 0
local spectating = nil -- Player o bot observado
local reviving = false
local originalZoom = { 0.5, 400 } -- zoom de la cámara del jugador (se restaura al reaparecer)

local BLUE = Color3.fromRGB(40, 140, 255)
local PINK = Color3.fromRGB(255, 70, 200)
local GREEN = Color3.fromRGB(70, 220, 60)

-- Personaje de un objetivo: el Character de un jugador o el propio modelo de un bot
local function characterOf(target)
	if target:IsA("Player") then
		return target.Character
	end
	return target.Parent and target or nil
end

local function teamOf(target)
	if target:IsA("Player") then
		return target.Team
	end
	local name = target:GetAttribute("Team")
	local team = name and name ~= "" and Teams:FindFirstChild(name)
	return team and team:IsA("Team") and team or nil
end

local function alive(p)
	local character = characterOf(p)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0, humanoid
end

local function noRespawn()
	return ReplicatedStorage:GetAttribute("NoRespawn") == true
end

-- Cámara en tercera persona detrás del jugador observado
local function watch(target)
	spectating = target
	local ok, humanoid = alive(target)
	if not ok then
		return
	end
	player.CameraMode = Enum.CameraMode.Classic
	player.CameraMinZoomDistance = 10
	player.CameraMaxZoomDistance = 14
	camera.CameraType = Enum.CameraType.Custom
	camera.CameraSubject = humanoid
	refs.SpectateName.Text = target:IsA("Player") and (target.DisplayName .. " (" .. target.Name .. ")") or target.Name
	refs.SpectatePanel.Visible = true
end

local function stopWatching()
	spectating = nil
	refs.SpectatePanel.Visible = false
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

local function restoreCamera()
	player.CameraMinZoomDistance = originalZoom[1]
	player.CameraMaxZoomDistance = originalZoom[2]
	player.CameraMode = Enum.CameraMode.LockFirstPerson
end

-- En Eliminación solo se observa a compañeros (si no, se podría chivar dónde están los enemigos)
local function canWatch(target)
	if target:IsA("Player") and target:GetAttribute("InMenu") then
		return false
	end
	if noRespawn() and player.Team then
		return teamOf(target) == player.Team
	end
	return true
end

local function refreshTargets(firstChoice)
	targets = {}
	for _, p in Players:GetPlayers() do
		if p ~= player and alive(p) and canWatch(p) then
			table.insert(targets, p)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			if model:IsA("Model") and alive(model) and canWatch(model) then
				table.insert(targets, model)
			end
		end
	end
	-- Primero el que te eliminó, luego tus compañeros
	local function rank(p)
		if p == firstChoice then
			return 0
		end
		return (player.Team and teamOf(p) == player.Team) and 1 or 2
	end
	table.sort(targets, function(a, b)
		return rank(a) < rank(b)
	end)
end

---------------------------------------------------------------------------
-- Killcam (como en los shooters): al morir, unos segundos desde los ojos del que te eliminó, mirando
-- hacia donde estabas, un poco a cámara lenta y sin color. Para eso se guardan, varias veces por
-- segundo, las posiciones de las cabezas de todos (jugadores y bots) durante los últimos segundos.
-- Luego sigue la pantalla de muerte de siempre (observar al que te eliminó). Clic o toque: saltarla.
-- No hay killcam en los modos de una sola vida (enseñaría en directo dónde está el enemigo) ni con
-- granadas o ataques aéreos, ni si al morir no había línea de visión (se vería una pared).
---------------------------------------------------------------------------
local HISTORY_TIME = 3.2
local SAMPLE_TIME = 0.05
local SLOW_MOTION = 1.25
DeathScreen.KillcamLength = 2.4 -- segundos de repetición (si hay tantos guardados)
DeathScreen.KillcamEnabled = true

local history = {} -- [Model] = { { tiempo, posición } }
local killcam = nil -- la repetición en curso
local sampleClock = 0
local losParams = RaycastParams.new()
losParams.FilterType = Enum.RaycastFilterType.Exclude

-- ¿Se veían? (del ojo del que te eliminó a ti; las personas, los efectos, las barandillas invisibles
-- y los cristales no tapan)
local function clearLine(from, to)
	local ignore = { camera }
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	for _, name in { "Bots", "ClientFX" } do
		local folder = workspace:FindFirstChild(name)
		if folder then
			table.insert(ignore, folder)
		end
	end
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	for _ = 1, 4 do
		losParams.FilterDescendantsInstances = ignore
		local hit = workspace:Raycast(from, to - from, losParams)
		if not hit then
			return true
		end
		if hit.Instance.Transparency < 0.3 then
			return false
		end
		table.insert(ignore, hit.Instance)
	end
	return true
end

-- Durante la killcam: tu cuerpo se ve (la cámara de primera persona lo deja invisible) y el del que
-- te eliminó no (la cámara está en su cabeza: se vería por dentro)
local function setModelLook(model, modifier)
	if not model then
		return
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") or part:IsA("Decal") then
			part.LocalTransparencyModifier = modifier
		end
	end
end

local function headPosition(model)
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head.Position
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position + Vector3.new(0, 1.5, 0)
	end
	return nil
end

local function recordHistory()
	local now = os.clock()
	local models = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(models, p.Character)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			if model:IsA("Model") then
				table.insert(models, model)
			end
		end
	end
	for _, model in models do
		local position = headPosition(model)
		if position then
			local list = history[model]
			if not list then
				list = {}
				history[model] = list
			end
			table.insert(list, { now, position })
			while #list > 0 and now - list[1][1] > HISTORY_TIME do
				table.remove(list, 1)
			end
		end
	end
	for model in history do
		if not model.Parent then
			history[model] = nil
		end
	end
end

-- Posición en el instante t (interpolando entre muestras)
local function sampleAt(list, t)
	if not list or #list == 0 then
		return nil
	end
	if t <= list[1][1] then
		return list[1][2]
	end
	for i = 2, #list do
		local b = list[i]
		if b[1] >= t then
			local a = list[i - 1]
			local k = (t - a[1]) / math.max(1e-3, b[1] - a[1])
			return a[2]:Lerp(b[2], math.clamp(k, 0, 1))
		end
	end
	return list[#list][2]
end

local spectateAfterKillcam -- (se define más abajo)

local function endKillcam(thenSpectate)
	local k = killcam
	if not k then
		return
	end
	killcam = nil
	ClientState.KillcamActive = false
	pcall(function()
		RunService:UnbindFromRenderStep("Killcam")
	end)
	if k.Effect then
		k.Effect:Destroy()
	end
	if k.KillerModel and k.KillerModel.Parent then
		setModelLook(k.KillerModel, 0)
	end
	refs.Killcam.Visible = false
	camera.FieldOfView = k.Fov
	camera.CameraType = Enum.CameraType.Custom
	if thenSpectate and ClientState.Dead then
		spectateAfterKillcam(k.Target)
	end
end

local function stepKillcam()
	local k = killcam
	if not k then
		return
	end
	local elapsed = os.clock() - k.Start
	if elapsed >= k.Span * SLOW_MOTION then
		endKillcam(true)
		return
	end
	local t = k.From + elapsed / SLOW_MOTION
	local eye = sampleAt(k.KillerTrack, t)
	local victim = sampleAt(k.VictimTrack, t)
	if not eye or not victim then
		endKillcam(true)
		return
	end
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = 60
	-- (si los dos puntos casi coinciden, se mantiene hacia donde se miraba)
	if (victim - eye).Magnitude > 0.5 then
		k.Look = CFrame.lookAt(eye + Vector3.new(0, 0.15, 0), victim - Vector3.new(0, 0.4, 0))
	end
	camera.CFrame = k.Look or CFrame.new(eye + Vector3.new(0, 0.15, 0))
	setModelLook(k.KillerModel, 1)
	setModelLook(k.MyModel, 0)
end

-- Empieza la repetición si hay suficiente historia del que te eliminó; si no, devuelve false
local function startKillcam(target, weaponName)
	if not DeathScreen.KillcamEnabled or not target or noRespawn() then
		return false
	end
	if weaponName == "Grenade" or weaponName == "Airstrike" then
		return false
	end
	endKillcam(false) -- (nunca dos a la vez)
	local killerModel = characterOf(target)
	local myModel = player.Character
	if not killerModel or not myModel or killerModel == myModel then
		return false
	end
	local killerTrack, victimTrack = history[killerModel], history[myModel]
	if not killerTrack or not victimTrack or #killerTrack < 6 or #victimTrack < 6 then
		return false
	end
	local available = deathTime - killerTrack[1][1]
	if available < 0.6 then
		return false
	end
	local eyeAtDeath, meAtDeath = sampleAt(killerTrack, deathTime), sampleAt(victimTrack, deathTime)
	if not eyeAtDeath or not meAtDeath or not clearLine(eyeAtDeath, meAtDeath) then
		return false
	end
	local span = math.min(DeathScreen.KillcamLength, available)
	local effect = Instance.new("ColorCorrectionEffect")
	effect.Name = "KillcamColor"
	effect.Saturation = -0.45
	effect.Contrast = 0.12
	effect.TintColor = Color3.fromRGB(235, 240, 255)
	effect.Parent = camera
	killcam = {
		Target = target,
		Start = os.clock(),
		From = deathTime - span,
		Span = span,
		KillerTrack = table.clone(killerTrack),
		VictimTrack = table.clone(victimTrack),
		Fov = camera.FieldOfView,
		Effect = effect,
		KillerModel = killerModel,
		MyModel = myModel,
		Look = nil :: CFrame?,
	}
	ClientState.KillcamActive = true
	local name = target:IsA("Player") and target.DisplayName or target.Name
	local weapon = type(weaponName) == "string" and Weapons.List[weaponName]
	local weaponText = weapon and weapon.DisplayName or weaponName
	refs.KillcamName.Text = name .. ((weaponText and weaponText ~= "") and ("  ·  " .. tostring(weaponText)) or "")
	refs.Killcam.Visible = true
	refs.SpectatePanel.Visible = false
	-- (al final de todo lo demás: nada mueve la cámara mientras dura)
	RunService:BindToRenderStep("Killcam", Enum.RenderPriority.Last.Value, stepKillcam)
	return true
end

DeathScreen.KillcamActive = function()
	return killcam ~= nil
end

local function cycle(step)
	-- (durante la killcam, el clic la salta)
	if killcam then
		endKillcam(true)
		return
	end
	refreshTargets(spectating)
	if #targets == 0 then
		stopWatching()
		return
	end
	local current = spectating and table.find(targets, spectating) or 0
	targetIndex = ((current - 1 + step) % #targets) + 1
	watch(targets[targetIndex])
end

local function revivesLeft()
	local data = ClientState.Data
	return data and data.Revives or 0
end

local function toast(text)
	refs.Toast.Text = text
	refs.Toast.Visible = true
	task.delay(2, function()
		if refs.Toast.Text == text then
			refs.Toast.Visible = false
		end
	end)
end

local function tryRevive()
	if not ClientState.Dead or reviving then
		return
	end
	if noRespawn() then
		toast("Una sola vida por ronda")
		return
	end
	if revivesLeft() <= 0 then
		local pack = Shop.RevivePacks[1]
		if pack and pack.ProductId ~= 0 then
			MarketplaceService:PromptProductPurchase(player, pack.ProductId)
		else
			toast("No te quedan revivir")
		end
		return
	end
	reviving = true
	Sounds.Play("Click")
	local ok, result, reason = pcall(function()
		return Remotes.InstantRevive:InvokeServer()
	end)
	reviving = false
	if not ok or not result then
		toast(reason or "No se pudo revivir")
	end
end

local function respawnNow()
	if ClientState.Dead and os.clock() - deathTime >= GameConfig.RespawnNowDelay and not noRespawn() then
		Sounds.Play("Click")
		Remotes.RespawnNow:FireServer()
	end
end

local function close()
	if killcam then
		endKillcam(false)
	end
	if not ClientState.Dead then
		return
	end
	ClientState.Dead = false
	gui.Enabled = false
	stopWatching()
	restoreCamera()
	ClientState.UpdateMouse()
end

local function open(killerName, weaponName)
	ClientState.Dead = true
	-- La tienda se cierra al morir (si no, la B que iba a cerrarla gastaría un revivir)
	Menu.Close()
	deathTime = os.clock()
	gui.Enabled = true
	refs.Toast.Visible = false
	ClientState.UpdateMouse()
	local bots = workspace:FindFirstChild("Bots")
	local killer = killerName and (Players:FindFirstChild(killerName) or (bots and bots:FindFirstChild(killerName)))
	-- Primero la killcam (si hay con qué); al acabar, a observar como siempre
	if killer and startKillcam(killer, weaponName) then
		return
	end
	spectateAfterKillcam(killer)
end

function spectateAfterKillcam(killer)
	refreshTargets(killer)
	if killer and alive(killer) and canWatch(killer) then
		watch(killer)
	elseif #targets > 0 then
		watch(targets[1])
	else
		refs.SpectatePanel.Visible = false
	end
end

-- Botón grande con texto encima ("Presiona B") y barra debajo
local function actionButton(text, hint, color, x)
	local holder = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, x, 1, -150),
		Size = UDim2.fromOffset(280, 110),
		BackgroundTransparency = 1,
		Parent = refs.Bottom,
	})
	if hint then
		UI.label({
			Size = UDim2.new(1, 0, 0, 26),
			Text = hint,
			TextSize = 22,
			Parent = holder,
		})
	end
	local button = UI.button({
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, 58),
		Text = text,
		TextSize = 26,
		BackgroundColor3 = color,
		Parent = holder,
	}, { UI.stroke(Color3.new(1, 1, 1), 3, 0), UI.gloss() })
	local bar = UI.new("Frame", {
		Position = UDim2.fromOffset(6, 92),
		Size = UDim2.new(1, -12, 0, 14),
		BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.65),
		Parent = holder,
	}, { UI.corner(7) })
	local fill = UI.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = color,
		Parent = bar,
	}, { UI.corner(7) })
	return holder, button, fill
end

local function build()
	gui = UI.new("ScreenGui", {
		Name = "DeathScreen",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 3,
		Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- Libera el ratón aunque la cámara esté en primera persona
	UI.new("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true, Parent = gui })

	-- Killcam: bandas negras de cine arriba y abajo, «KILLCAM» y quién te eliminó con qué
	refs.Killcam = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = gui })
	UI.new("Frame", {
		Size = UDim2.new(1, 0, 0.09, 0),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Parent = refs.Killcam,
	})
	UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0.09, 0),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Parent = refs.Killcam,
	})
	UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.09, 6),
		Size = UDim2.new(0.6, 0, 0, 34),
		Text = "▶ KILLCAM",
		TextScaled = true,
		TextColor3 = Color3.fromRGB(255, 70, 60),
		TextStrokeTransparency = 0.2,
		Parent = refs.Killcam,
	}, { UI.new("UITextSizeConstraint", { MaxTextSize = 30 }) })
	refs.KillcamName = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.09, 40),
		Size = UDim2.new(0.6, 0, 0, 24),
		Text = "",
		TextScaled = true,
		Parent = refs.Killcam,
	}, { UI.new("UITextSizeConstraint", { MaxTextSize = 20 }) })

	refs.Bottom = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
	local scale = UI.new("UIScale", { Parent = refs.Bottom })
	local function rescale()
		local size = camera.ViewportSize
		scale.Scale = math.clamp(math.min(size.X / 1280, size.Y / 720), 0.55, 1)
	end
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()

	local _, menuButton = actionButton("VOLVER AL MENÚ", nil, BLUE, -300)
	local reviveHolder, reviveButton, reviveFill = actionButton("REVIVIR INSTANTÁNEO", "Presiona B", PINK, 0)
	local respawnHolder, respawnButton, respawnFill = actionButton("REGENERAR AHORA", "Presiona Espacio o F", GREEN, 300)
	refs.ReviveButton, refs.ReviveFill, refs.RespawnButton, refs.RespawnFill = reviveButton, reviveFill, respawnButton, respawnFill
	refs.ReviveHolder, refs.RespawnHolder = reviveHolder, respawnHolder
	-- Eliminación: en lugar de revivir/regenerar, un aviso
	refs.WaitLabel = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 150, 1, -170),
		Size = UDim2.fromOffset(560, 60),
		Text = "UNA VIDA POR RONDA\nEspera a la siguiente ronda",
		TextSize = 26,
		TextColor3 = Color3.fromRGB(255, 220, 90),
		Visible = false,
		Parent = refs.Bottom,
	})

	-- Corazón con alas y "N restantes"
	refs.ReviveBadge = UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, -6, 0, 22),
		Size = UDim2.fromOffset(150, 30),
		Rotation = -14,
		Text = "",
		TextSize = 22,
		TextColor3 = Color3.new(1, 1, 1),
		Parent = reviveHolder,
	})
	UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, -2, 0, 58),
		Size = UDim2.fromOffset(60, 60),
		Text = "💖",
		TextSize = 48,
		Parent = reviveHolder,
	})

	menuButton.Activated:Connect(function()
		Sounds.Play("Click")
		close()
		MainMenu.Show()
	end)
	reviveButton.Activated:Connect(tryRevive)
	respawnButton.Activated:Connect(respawnNow)

	-- Panel de observar (izquierda)
	refs.SpectatePanel = UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 30, 0.5, 20),
		Size = UDim2.fromOffset(440, 220),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = refs.Bottom,
	})
	refs.SpectateName = UI.label({
		Size = UDim2.new(1, 0, 0, 40),
		Text = "",
		TextSize = 32,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = refs.SpectatePanel,
	})
	UI.label({
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(1, 0, 0, 26),
		Text = "Haz clic / clic derecho para cambiar",
		TextSize = 20,
		TextColor3 = Color3.fromRGB(215, 215, 230),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = refs.SpectatePanel,
	})
	local stop = UI.button({
		Position = UDim2.fromOffset(0, 90),
		Size = UDim2.fromOffset(230, 46),
		Text = "DEJAR DE OBSERVAR",
		TextSize = 20,
		BackgroundColor3 = Color3.fromRGB(230, 50, 60),
		Parent = refs.SpectatePanel,
	}, { UI.stroke(Color3.new(1, 1, 1), 2, 0), UI.gloss() })
	stop.Activated:Connect(function()
		Sounds.Play("Click")
		stopWatching()
	end)

	refs.Toast = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -270),
		Size = UDim2.fromOffset(500, 34),
		Text = "",
		TextSize = 26,
		TextColor3 = Color3.fromRGB(255, 120, 140),
		Visible = false,
		Parent = refs.Bottom,
	})
end

local function update()
	if not ClientState.Dead then
		return
	end
	local oneLife = noRespawn()
	refs.ReviveHolder.Visible = not oneLife
	refs.RespawnHolder.Visible = not oneLife
	refs.WaitLabel.Visible = oneLife
	local elapsed = os.clock() - deathTime
	-- Revivir: la barra se vacía mientras queda tiempo para usarlo
	local reviveWindow = math.clamp(1 - elapsed / GameConfig.RespawnTime, 0, 1)
	refs.ReviveFill.Size = UDim2.fromScale(reviveWindow, 1)
	local left = revivesLeft()
	refs.ReviveBadge.Text = left > 0 and (left .. " restantes") or "¡Consigue más!"
	refs.ReviveButton.AutoButtonColor = reviveWindow > 0
	-- Regenerar: la barra se llena hasta que se puede pulsar
	local charge = math.clamp(elapsed / GameConfig.RespawnNowDelay, 0, 1)
	refs.RespawnFill.Size = UDim2.fromScale(charge, 1)
	refs.RespawnButton.BackgroundTransparency = charge >= 1 and 0 or 0.35
	-- Si el observado muere o se va, pasa al siguiente
	if spectating and not alive(spectating) then
		cycle(1)
	end
end

function DeathScreen.Init()
	originalZoom = { player.CameraMinZoomDistance, player.CameraMaxZoomDistance }
	build()
	Remotes.Died.OnClientEvent:Connect(open)
	player.CharacterAdded:Connect(function(character)
		close()
		local humanoid = character:WaitForChild("Humanoid", 5)
		if humanoid and not ClientState.InMainMenu then
			camera.CameraType = Enum.CameraType.Custom
			camera.CameraSubject = humanoid
		end
	end)
	-- Las teclas B, F y Espacio están enlazadas con ContextActionService (menú, cuchillo, salto), así que
	-- llegan marcadas como "procesadas": solo se ignoran si se está escribiendo en el chat. Los clics sí se
	-- ignoran cuando caen sobre un botón de la interfaz.
	UserInputService.InputBegan:Connect(function(input, processed)
		if not ClientState.Dead or UserInputService:GetFocusedTextBox() then
			return
		end
		local isClick = input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2
			or input.UserInputType == Enum.UserInputType.Touch
		if isClick and processed then
			return
		end
		-- (en el móvil, tocar la pantalla salta la killcam)
		if input.UserInputType == Enum.UserInputType.Touch then
			if killcam then
				endKillcam(true)
			end
			return
		end
		if input.KeyCode == Enum.KeyCode.B or input.KeyCode == Enum.KeyCode.ButtonY then
			-- No gasta un revivir si la B era para cerrar la tienda
			if not ClientState.MenuOpen and os.clock() - ClientState.MenuClosedAt > 1 then
				tryRevive()
			end
		elseif input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.ButtonA then
			respawnNow()
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonR1 then
			cycle(1)
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 or input.KeyCode == Enum.KeyCode.ButtonL1 then
			cycle(-1)
		end
	end)
	RunService.RenderStepped:Connect(update)
	-- Historia de posiciones para la killcam (cada SAMPLE_TIME s)
	RunService.Heartbeat:Connect(function(dt)
		sampleClock += dt
		if sampleClock < SAMPLE_TIME then
			return
		end
		sampleClock = 0
		pcall(recordHistory)
	end)
	-- Muerto en Eliminación y de vuelta desde la pantalla de inicio: vuelve a la pantalla de muerte
	-- (se observa a los compañeros hasta la siguiente ronda en vez de quedarse mirando el cuerpo)
	RunService.Heartbeat:Connect(function()
		if ClientState.Dead or ClientState.InMainMenu or not noRespawn() then
			return
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health <= 0 then
			open(nil)
		end
	end)
end

return DeathScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="100">
            <Properties>
              <string name="Name">DominationHUD</string>
              <string name="Source"><![CDATA[-- Dominio: las tres banderas (A, B, C) arriba, debajo del marcador. Cada una con el color de su
-- dueño, una barra con la captura en curso (del color de quien la captura) y "!" si está disputada.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Teams = game:GetService("Teams")

local UI = require(script.Parent.UI)
local ClientState = require(script.Parent.ClientState)

local player = Players.LocalPlayer

local DominationHUD = {}

local LETTERS = { "A", "B", "C" }
local NEUTRAL = Color3.fromRGB(70, 72, 80)

local gui
local badges = {}

local function teamColor(name)
	local team = name ~= "" and Teams:FindFirstChild(name or "")
	return team and team:IsA("Team") and team.TeamColor.Color or nil
end

local function update()
	local active = ReplicatedStorage:GetAttribute("Dom_A_Position") ~= nil
	gui.Enabled = active and not ClientState.InMainMenu
	if not gui.Enabled then
		return
	end
	for _, letter in LETTERS do
		local badge = badges[letter]
		local prefix = "Dom_" .. letter .. "_"
		local owner = ReplicatedStorage:GetAttribute(prefix .. "Owner") or ""
		local capturing = ReplicatedStorage:GetAttribute(prefix .. "Capturing") or ""
		local progress = ReplicatedStorage:GetAttribute(prefix .. "Progress") or 0
		local contested = ReplicatedStorage:GetAttribute(prefix .. "Contested") == true
		badge.Box.BackgroundColor3 = teamColor(owner) or NEUTRAL
		local mine = player.Team and owner == player.Team.Name
		badge.Stroke.Color = mine and Color3.fromRGB(255, 255, 255) or Color3.new(0, 0, 0)
		badge.Bar.Visible = capturing ~= "" and progress > 0
		badge.Bar.Size = UDim2.new(progress, 0, 0, 5)
		badge.Bar.BackgroundColor3 = teamColor(capturing) or Color3.new(1, 1, 1)
		badge.Label.Text = contested and (letter .. "!") or letter
		badge.Label.TextColor3 = contested and Color3.fromRGB(255, 210, 60) or Color3.new(1, 1, 1)
	end
end

function DominationHUD.Init()
	gui = UI.new("ScreenGui", {
		Name = "DominationHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 2,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local row = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 118),
		Size = UDim2.fromOffset(3 * 46 + 2 * 8, 46),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}),
	})
	for i, letter in LETTERS do
		local stroke = UI.stroke(Color3.new(0, 0, 0), 2, 0)
		local box = UI.new("Frame", {
			Name = letter,
			LayoutOrder = i,
			Size = UDim2.fromOffset(46, 46),
			BackgroundColor3 = NEUTRAL,
			Parent = row,
		}, { UI.corner(10), stroke })
		local label = UI.label({
			Size = UDim2.new(1, 0, 1, -4),
			Text = letter,
			TextSize = 28,
			Parent = box,
		})
		local bar = UI.new("Frame", {
			Position = UDim2.new(0, 0, 1, -5),
			Size = UDim2.new(0, 0, 0, 5),
			BorderSizePixel = 0,
			Visible = false,
			Parent = box,
		})
		badges[letter] = { Box = box, Label = label, Bar = bar, Stroke = stroke }
	end
	task.spawn(function()
		while gui.Parent do
			update()
			task.wait(0.15)
		end
	end)
end

DominationHUD.Update = update

return DominationHUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="101">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[-- Efectos visuales (solo en el cliente): fogonazo, balas trazadoras, impactos, casquillos y bajas.
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ClientState = require(script.Parent.ClientState)
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local Effects = {}

-- Lo pone CombatFX: se llama con la fuerza (0..1) cuando una explosión estalla muy cerca de la cámara
Effects.OnConcussion = nil :: ((number) -> ())?

-- Texturas de partículas incluidas con Roblox
local TEX = {
	Fire = "rbxasset://textures/particles/fire_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
}

local folder = Instance.new("Folder")
folder.Name = "ClientFX"
folder.Parent = workspace

-- ¿Mapa realista? (atributo Realistic del mapa; con el estilo Realista, todos). Ahí los impactos en
-- personas y la baja normal son realistas en vez de destellos de colores
local function realisticMap()
	local map = workspace:FindFirstChild("Map")
	return map ~= nil and map:GetAttribute("Realistic") == true
end

local function fxPart(props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	for key, value in props do
		part[key] = value
	end
	part.Parent = folder
	return part
end

-- lookAt que no falla cuando la dirección es vertical (por ejemplo, impactos en el suelo)
local function safeLookAt(position, direction)
	local up = math.abs(direction.Unit.Y) > 0.99 and Vector3.zAxis or Vector3.yAxis
	return CFrame.lookAt(position, position + direction, up)
end

local function seq(a, b)
	return NumberSequence.new({ NumberSequenceKeypoint.new(0, a), NumberSequenceKeypoint.new(1, b) })
end

-- Pieza invisible que sirve de emisor; su +Y apunta hacia `direction`
local function emitterAnchor(position, direction, lifetime)
	direction = (direction and direction.Magnitude > 0.01) and direction.Unit or Vector3.yAxis
	local anchor = fxPart({
		Size = Vector3.new(0.1, 0.1, 0.1),
		Transparency = 1,
		CFrame = safeLookAt(position, direction) * CFrame.Angles(-math.pi / 2, 0, 0),
	})
	Debris:AddItem(anchor, lifetime or 2)
	return anchor
end

local function emit(parent, props, count)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Enabled = false
	emitter.EmissionDirection = Enum.NormalId.Top
	for key, value in props do
		emitter[key] = value
	end
	emitter.Parent = parent
	emitter:Emit(count)
	return emitter
end

-- Reutilización para los efectos de cada disparo: en un tiroteo se creaban decenas de piezas y
-- emisores por segundo (y cada uno avisaba a Settings). Ahora hay un juego de anclas que se van
-- turnando, cada una con sus emisores guardados por tipo; las partículas ya emitidas no se mueven
-- al recolocar el ancla (están en el mundo).
local ANCHOR_POOL = 24
local anchorPool, anchorIndex = {}, 0
local emitterCache = {} -- [ancla] = { [tipo] = ParticleEmitter }

local function pooledAnchor(position, direction)
	direction = (direction and direction.Magnitude > 0.01) and direction.Unit or Vector3.yAxis
	anchorIndex = anchorIndex % ANCHOR_POOL + 1
	local anchor = anchorPool[anchorIndex]
	if not anchor or not anchor.Parent then
		if anchor then
			emitterCache[anchor] = nil
		end
		anchor = fxPart({ Name = "FXAnchor", Size = Vector3.new(0.1, 0.1, 0.1), Transparency = 1 })
		anchorPool[anchorIndex] = anchor
		emitterCache[anchor] = {}
	end
	anchor.CFrame = safeLookAt(position, direction) * CFrame.Angles(-math.pi / 2, 0, 0)
	return anchor
end

-- Como emit, pero con el emisor guardado en el ancla (se crea la primera vez; el color se actualiza)
local function emitPooled(anchor, key, props, count)
	local cache = emitterCache[anchor]
	if not cache then
		return emit(anchor, props, count)
	end
	local emitter = cache[key]
	if not emitter then
		emitter = emit(anchor, props, 0)
		cache[key] = emitter
	elseif props.Color then
		emitter.Color = props.Color
	end
	emitter:Emit(count)
	return emitter
end

-- Piezas que se reutilizan por turnos (trazadoras y marcas de bala)
local function partRing(size)
	return { Parts = {}, Index = 0, Size = size, Tokens = {} }
end
local function ringPart(ring, props)
	ring.Index = ring.Index % ring.Size + 1
	local part = ring.Parts[ring.Index]
	if not part or not part.Parent then
		part = fxPart(props)
		ring.Parts[ring.Index] = part
	else
		for key, value in props do
			part[key] = value
		end
	end
	local token = (ring.Tokens[ring.Index] or 0) + 1
	ring.Tokens[ring.Index] = token
	return part, ring.Index, token
end
-- Oculta la pieza al acabar, si nadie la ha reutilizado mientras tanto
local function hideLater(ring, index, token, delay)
	task.delay(delay, function()
		local part = ring.Parts[index]
		if ring.Tokens[index] == token and part then
			part.Transparency = 1
		end
	end)
end
-- (las marcas duran 5 s: con 16 disparos por segundo hacen falta unas 80 para que no desaparezcan antes)
local bulletRing, trailRing, markRing, chipRing = partRing(30), partRing(30), partRing(80), partRing(80)

---------------------------------------------------------------------------

-- Trazadoras de verdad (mapas realistas): como la munición trazadora, una de cada tres balas deja
-- una raya brillante de color cálido; las demás, solo un destello tenue y rapidísimo
local TRACER_WARM = Color3.fromRGB(255, 196, 128)
local tracerCount = 0
local function realisticTracer(from, to, distance)
	tracerCount += 1
	local bright = tracerCount % 3 == 1
	local direction = safeLookAt(from, to - from)
	if bright then
		local trail = ringPart(trailRing, {
			Color = TRACER_WARM,
			Size = Vector3.new(0.025, 0.025, distance),
			CFrame = direction * CFrame.new(0, 0, -distance / 2),
			Transparency = 0.82,
		})
		TweenService:Create(trail, TweenInfo.new(0.07), { Transparency = 1 }):Play()
	end
	local length = math.min(bright and 5 or 3, distance)
	local travel = math.max(distance - length, 0.01)
	local duration = math.clamp(distance / 1400, 0.015, 0.2)
	local bullet, index, token = ringPart(bulletRing, {
		Color = bright and TRACER_WARM or Color3.fromRGB(255, 236, 205),
		Size = Vector3.new(bright and 0.07 or 0.04, bright and 0.07 or 0.04, length),
		CFrame = direction * CFrame.new(0, 0, -length / 2),
		Transparency = bright and 0.05 or 0.6,
	})
	TweenService
		:Create(bullet, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = direction * CFrame.new(0, 0, -length / 2 - travel) })
		:Play()
	hideLater(bulletRing, index, token, duration + 0.02)
end

-- Bala trazadora que viaja desde el cañón hasta el impacto, con una estela tenue
function Effects.Tracer(from, to, color)
	local distance = (to - from).Magnitude
	if distance < 1 then
		return
	end
	if realisticMap() then
		realisticTracer(from, to, distance)
		return
	end
	color = color or Color3.fromRGB(255, 230, 120)
	local direction = safeLookAt(from, to - from)

	-- Estela fina que se desvanece
	local trail = ringPart(trailRing, {
		Color = color,
		Size = Vector3.new(0.03, 0.03, distance),
		CFrame = direction * CFrame.new(0, 0, -distance / 2),
		Transparency = 0.6,
	})
	TweenService:Create(trail, TweenInfo.new(0.1), { Transparency = 1 }):Play()

	-- La bala
	local length = math.min(6, distance)
	local travel = math.max(distance - length, 0.01)
	local duration = math.clamp(distance / 900, 0.02, 0.25)
	local bullet, index, token = ringPart(bulletRing, {
		Color = color,
		Size = Vector3.new(0.12, 0.12, length),
		CFrame = direction * CFrame.new(0, 0, -length / 2),
		Transparency = 0,
	})
	TweenService
		:Create(bullet, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = direction * CFrame.new(0, 0, -length / 2 - travel) })
		:Play()
	hideLater(bulletRing, index, token, duration + 0.02)
end

-- Fogonazo realista: cada disparo distinto (3-5 lenguas de fuego cortas de distinto largo alrededor
-- del cañón, un núcleo casi blanco de un fotograma, un cono de llama hacia delante), un golpe de luz
-- cálida y un humo gris que se queda flotando un momento
local FLASH_WARM = Color3.fromRGB(255, 190, 105)
local function realisticFlash(cf, remote)
	local scale = 0.7 + math.random() * 0.55
	local spin = math.random() * math.pi * 2
	local prongs = remote and 3 or math.random(3, 5)
	for i = 1, prongs do
		local angle = spin + (i + (math.random() - 0.5) * 0.4) * (math.pi * 2 / prongs)
		local length = (0.22 + math.random() * 0.3) * scale
		local prong = fxPart({
			Color = FLASH_WARM:Lerp(Color3.new(1, 1, 1), 0.3),
			Size = Vector3.new(0.045 * scale, length, 0.1 * scale),
			CFrame = cf * CFrame.new(0, 0, -0.1) * CFrame.Angles(0, 0, angle) * CFrame.new(0, length / 2, 0),
			Transparency = 0.1 + math.random() * 0.3,
		})
		Debris:AddItem(prong, 0.035)
	end
	local flameLength = (0.35 + math.random() * 0.35) * scale
	local flame = fxPart({
		Color = FLASH_WARM,
		Size = Vector3.new(0.13 * scale, 0.13 * scale, flameLength),
		CFrame = cf * CFrame.new(0, 0, -0.08 - flameLength / 2),
		Transparency = 0.2 + math.random() * 0.2,
	})
	Debris:AddItem(flame, 0.035)
	local core = fxPart({
		Color = Color3.fromRGB(255, 244, 214),
		Size = Vector3.one * (0.2 + math.random() * 0.1) * scale,
		Shape = Enum.PartType.Ball,
		CFrame = cf * CFrame.new(0, 0, -0.1),
		Transparency = 0.05,
	})
	if not remote then
		local light = Instance.new("PointLight")
		light.Color = FLASH_WARM
		light.Range = 13 + math.random() * 5
		light.Brightness = 5
		light.Parent = core
	end
	Debris:AddItem(core, 0.045)

	local anchor = pooledAnchor(cf.Position, cf.LookVector)
	emitPooled(anchor, "MuzzleFireReal", {
		Texture = TEX.Fire,
		Color = ColorSequence.new(Color3.fromRGB(255, 236, 190), FLASH_WARM),
		LightEmission = 1,
		Size = seq(0.3, 0),
		Transparency = seq(0.1, 1),
		Lifetime = NumberRange.new(0.03, 0.06),
		Speed = NumberRange.new(5, 10),
		SpreadAngle = Vector2.new(8, 8),
	}, 4)
	emitPooled(anchor, "MuzzleSmokeReal", {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(Color3.fromRGB(205, 205, 200), Color3.fromRGB(170, 170, 165)),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.15),
			NumberSequenceKeypoint.new(0.4, 0.8),
			NumberSequenceKeypoint.new(1, 1.6),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.75),
			NumberSequenceKeypoint.new(0.3, 0.8),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(0.7, 1.3),
		Speed = NumberRange.new(1.5, 3.5),
		Drag = 3,
		RotSpeed = NumberRange.new(-40, 40),
		Rotation = NumberRange.new(0, 360),
		SpreadAngle = Vector2.new(14, 14),
		Acceleration = Vector3.new(0, 1.2, 0),
	}, remote and 1 or 2)
end

-- Fogonazo: estrella de luz, llamas y humo. remote = disparo de otro (más barato: sin luz ni estrella)
function Effects.MuzzleFlash(attachment, color, remote)
	if not attachment then
		return
	end
	color = color or Color3.fromRGB(255, 200, 90)
	local cf = attachment.WorldCFrame
	if realisticMap() then
		realisticFlash(cf, remote)
		return
	end
	local spin = math.random() * math.pi
	for i = 0, remote and -1 or 1 do
		local star = fxPart({
			Color = color:Lerp(Color3.new(1, 1, 1), 0.4),
			Size = Vector3.new(0.08, 0.7, 0.3),
			CFrame = cf * CFrame.new(0, 0, -0.2) * CFrame.Angles(0, 0, spin + i * math.pi / 2),
		})
		Debris:AddItem(star, 0.04)
	end
	local core = fxPart({
		Color = Color3.fromRGB(255, 240, 200),
		Size = Vector3.new(0.3, 0.3, 0.3),
		Shape = Enum.PartType.Ball,
		CFrame = cf * CFrame.new(0, 0, -0.15),
	})
	if not remote then
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = 12
		light.Brightness = 4
		light.Parent = core
	end
	Debris:AddItem(core, 0.05)

	local anchor = pooledAnchor(cf.Position, cf.LookVector)
	emitPooled(anchor, "MuzzleFire", {
		Texture = TEX.Fire,
		Color = ColorSequence.new(Color3.fromRGB(255, 240, 180), color),
		LightEmission = 1,
		Size = seq(0.45, 0),
		Transparency = seq(0, 1),
		Lifetime = NumberRange.new(0.04, 0.08),
		Speed = NumberRange.new(4, 8),
		SpreadAngle = Vector2.new(12, 12),
	}, 5)
	emitPooled(anchor, "MuzzleSmoke", {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(Color3.fromRGB(220, 220, 220)),
		Size = seq(0.2, 0.9),
		Transparency = seq(0.6, 1),
		Lifetime = NumberRange.new(0.4, 0.8),
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(20, 20),
		Acceleration = Vector3.new(0, 1.5, 0),
	}, 2)
end

-- Tipo de superficie según el material: cambia la reacción al impacto (chispas en metal, astillas
-- en madera, polvo y esquirlas en piedra, tierra o nieve que saltan, salpicadura en agua)
local SURFACE = {}
for kind, materials in {
	Metal = { "Metal", "CorrodedMetal", "DiamondPlate", "Foil" },
	Wood = { "Wood", "WoodPlanks" },
	Stone = {
		"Concrete", "Brick", "Cobblestone", "Slate", "Granite", "Marble", "Pebble", "Rock", "Basalt", "Limestone",
		"Pavement", "Asphalt", "Plaster", "Sandstone", "CeramicTiles", "ClayRoofTiles", "CrackedLava",
	},
	Dirt = { "Grass", "LeafyGrass", "Ground", "Mud", "Sand" },
	Snow = { "Snow", "Ice", "Glacier" },
	Water = { "Water" },
	Glass = { "Glass" },
} do
	for _, name in materials do
		local ok, material = pcall(function()
			return (Enum.Material :: any)[name]
		end)
		if ok and material then
			SURFACE[material] = kind
		end
	end
end

local function surfaceColor(hitPart, material)
	if hitPart and hitPart:IsA("Terrain") then
		local ok, color = pcall(function()
			return workspace.Terrain:GetMaterialColor(material)
		end)
		return ok and color or Color3.fromRGB(150, 140, 120)
	end
	return hitPart and hitPart.Color or Color3.fromRGB(200, 200, 200)
end

-- Impacto: reacción según la superficie, polvo del color del material y marca de bala
-- Pintura (arma de paintball): gotas de un color al azar y, en superficies, una mancha plana que se
-- desvanece a los pocos segundos (como mucho MAX_SPLATS a la vez)
local PAINT_COLORS = {
	Color3.fromRGB(255, 60, 140),
	Color3.fromRGB(60, 200, 255),
	Color3.fromRGB(255, 220, 40),
	Color3.fromRGB(120, 230, 60),
	Color3.fromRGB(170, 90, 255),
	Color3.fromRGB(255, 140, 40),
}
local MAX_SPLATS = 40
local splats = {}

local function paintSplat(anchor, position, normal, isCharacter)
	local color = PAINT_COLORS[math.random(1, #PAINT_COLORS)]
	emitPooled(anchor, "Paint", {
		Texture = TEX.Sparkle,
		Color = ColorSequence.new(color),
		LightEmission = 0.2,
		Size = seq(0.4, 0.1),
		Lifetime = NumberRange.new(0.3, 0.55),
		Speed = NumberRange.new(8, 16),
		SpreadAngle = Vector2.new(55, 55),
		Acceleration = Vector3.new(0, -60, 0),
	}, isCharacter and 12 or 10)
	if isCharacter then
		return
	end
	normal = (normal and normal.Magnitude > 0.01) and normal.Unit or Vector3.yAxis
	local size = 1.2 + math.random() * 1.2
	-- Cilindro muy fino pegado a la superficie (su eje X apunta en la dirección de la normal)
	local splat = fxPart({
		Name = "PaintSplat",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.04, size, size),
		CFrame = safeLookAt(position + normal * 0.03, normal) * CFrame.Angles(0, math.pi / 2, 0),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
	})
	table.insert(splats, splat)
	if #splats > MAX_SPLATS then
		local oldest = table.remove(splats, 1)
		if oldest then
			oldest:Destroy()
		end
	end
	task.delay(5, function()
		if splat.Parent then
			TweenService:Create(splat, TweenInfo.new(1.5), { Transparency = 1 }):Play()
			task.delay(1.6, function()
				local index = table.find(splats, splat)
				if index then
					table.remove(splats, index)
				end
				splat:Destroy()
			end)
		end
	end)
end

-- style = "Paint" para las armas de paintball (def.ImpactStyle)
function Effects.Impact(position, normal, hitPart, material, style)
	local isCharacter = hitPart ~= nil
		and hitPart.Parent ~= nil
		and (hitPart.Parent:FindFirstChildOfClass("Humanoid") ~= nil or hitPart.Parent:IsA("Accessory"))
	local anchor = pooledAnchor(position + (normal or Vector3.yAxis) * 0.05, normal)
	if style == "Paint" then
		paintSplat(anchor, position, normal, isCharacter)
		return
	end

	if isCharacter and realisticMap() and not GameConfig.RealisticBlood then
		-- Impacto realista sin sangre: golpe seco de polvo y fibras de la ropa que saltan y caen
		emitPooled(anchor, "HitPuff", {
			Texture = TEX.Smoke,
			Color = ColorSequence.new(Color3.fromRGB(176, 168, 150), Color3.fromRGB(120, 114, 100)),
			LightInfluence = 1,
			Size = seq(0.3, 1.3),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.3),
				NumberSequenceKeypoint.new(0.4, 0.6),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Lifetime = NumberRange.new(0.25, 0.45),
			Speed = NumberRange.new(2, 5),
			SpreadAngle = Vector2.new(40, 40),
			Drag = 6,
			Rotation = NumberRange.new(0, 360),
		}, 3)
		emitPooled(anchor, "HitFibers", {
			Texture = TEX.Smoke,
			Color = ColorSequence.new(Color3.fromRGB(70, 66, 58)),
			LightInfluence = 1,
			Size = seq(0.1, 0.04),
			Lifetime = NumberRange.new(0.3, 0.5),
			Speed = NumberRange.new(7, 12),
			SpreadAngle = Vector2.new(30, 30),
			Acceleration = Vector3.new(0, -50, 0),
		}, 4)
		return
	end
	if isCharacter and realisticMap() then
		-- Impacto realista con sangre (GameConfig.RealisticBlood): una nube rojo oscuro que se abre y
		-- se desvanece enseguida, unas gotitas que caen y polvo de la ropa (sin charcos ni marcas)
		emitPooled(anchor, "HitMist", {
			Texture = TEX.Smoke,
			Color = ColorSequence.new(Color3.fromRGB(125, 12, 14), Color3.fromRGB(70, 8, 10)),
			LightInfluence = 0.8,
			Size = seq(0.35, 1.4),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.25),
				NumberSequenceKeypoint.new(0.4, 0.55),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Lifetime = NumberRange.new(0.22, 0.38),
			Speed = NumberRange.new(2, 5),
			SpreadAngle = Vector2.new(35, 35),
			Drag = 6,
			Rotation = NumberRange.new(0, 360),
		}, 3)
		emitPooled(anchor, "HitDrops", {
			Texture = TEX.Smoke,
			Color = ColorSequence.new(Color3.fromRGB(110, 10, 12)),
			LightInfluence = 0.8,
			Size = seq(0.14, 0.05),
			Lifetime = NumberRange.new(0.3, 0.5),
			Speed = NumberRange.new(8, 14),
			SpreadAngle = Vector2.new(28, 28),
			Acceleration = Vector3.new(0, -60, 0),
		}, 5)
		emitPooled(anchor, "HitCloth", {
			Texture = TEX.Smoke,
			Color = ColorSequence.new(Color3.fromRGB(150, 140, 120)),
			LightInfluence = 1,
			Size = seq(0.25, 0.8),
			Transparency = seq(0.5, 1),
			Lifetime = NumberRange.new(0.3, 0.5),
			Speed = NumberRange.new(1, 3),
			SpreadAngle = Vector2.new(50, 50),
		}, 2)
		return
	end
	if isCharacter then
		-- Destello de golpe (estilo cartoon, sin sangre)
		emitPooled(anchor, "Hit", {
			Texture = TEX.Sparkle,
			Color = ColorSequence.new(Color3.fromRGB(255, 90, 90), Color3.fromRGB(255, 220, 120)),
			LightEmission = 1,
			Size = seq(0.5, 0),
			Lifetime = NumberRange.new(0.15, 0.3),
			Speed = NumberRange.new(6, 12),
			SpreadAngle = Vector2.new(60, 60),
			Rotation = NumberRange.new(0, 360),
		}, 8)
		return
	end

	material = material or (hitPart and hitPart.Material) or Enum.Material.Plastic
	local kind = SURFACE[material] or "Plastic"
	local baseColor = surfaceColor(hitPart, material)

	if kind == "Water" then
		-- Salpicadura: gotas hacia arriba que caen y un poco de espuma
		emitPooled(anchor, "WaterDrops", {
			Texture = TEX.Sparkle,
			Color = ColorSequence.new(Color3.fromRGB(220, 240, 255)),
			LightEmission = 0.3,
			Size = seq(0.25, 0.05),
			Lifetime = NumberRange.new(0.4, 0.7),
			Speed = NumberRange.new(10, 18),
			SpreadAngle = Vector2.new(18, 18),
			Acceleration = Vector3.new(0, -50, 0),
		}, 12)
		emitPooled(anchor, "WaterFoam", {
			Texture = TEX.Smoke,
			Color = ColorSequence.new(Color3.fromRGB(240, 248, 255)),
			Size = seq(0.6, 2),
			Transparency = seq(0.4, 1),
			Lifetime = NumberRange.new(0.4, 0.6),
			Speed = NumberRange.new(1, 2),
			SpreadAngle = Vector2.new(70, 70),
		}, 3)
		return
	end

	-- Chispas: muchas en metal, pocas en piedra y cristal, ninguna en materiales blandos
	local sparks = (kind == "Metal" and 12) or ((kind == "Stone" or kind == "Glass" or kind == "Plastic") and 4) or 0
	if sparks > 0 then
		emitPooled(anchor, "Sparks" .. kind, {
			Texture = TEX.Sparkle,
			Color = ColorSequence.new(Color3.fromRGB(255, 230, 150), Color3.fromRGB(255, 150, 60)),
			LightEmission = 1,
			Size = seq(kind == "Metal" and 0.22 or 0.16, 0),
			Lifetime = NumberRange.new(0.15, kind == "Metal" and 0.5 or 0.3),
			Speed = NumberRange.new(10, 20),
			SpreadAngle = Vector2.new(50, 50),
			Acceleration = Vector3.new(0, -45, 0),
		}, sparks)
	end

	-- Esquirlas que saltan y caen (astillas de madera, trozos de piedra, terrones, cristal)
	if kind == "Wood" or kind == "Stone" or kind == "Dirt" or kind == "Glass" or kind == "Snow" then
		local chipColor = kind == "Glass" and Color3.fromRGB(220, 240, 255) or baseColor:Lerp(Color3.new(0, 0, 0), kind == "Wood" and 0.25 or 0.1)
		emitPooled(anchor, "Chips" .. kind, {
			Texture = TEX.Smoke,
			Color = ColorSequence.new(chipColor),
			LightInfluence = 1,
			Size = seq(kind == "Snow" and 0.35 or 0.22, 0.12),
			Lifetime = NumberRange.new(0.35, 0.6),
			Speed = NumberRange.new(8, 15),
			SpreadAngle = Vector2.new(40, 40),
			Acceleration = Vector3.new(0, -55, 0),
			Rotation = NumberRange.new(0, 360),
			RotSpeed = NumberRange.new(-300, 300),
		}, kind == "Wood" and 6 or 5)
	end

	-- Nube de polvo del color de la superficie (más grande en tierra y nieve)
	local soft = kind == "Dirt" or kind == "Snow"
	local dustColor = baseColor:Lerp(Color3.new(1, 1, 1), kind == "Snow" and 0.5 or 0.3)
	if kind ~= "Metal" and kind ~= "Glass" then
		emitPooled(anchor, soft and "DustSoft" or "Dust", {
			Texture = TEX.Smoke,
			Color = ColorSequence.new(dustColor),
			LightInfluence = 1,
			Size = seq(soft and 0.6 or 0.3, soft and 2.4 or 1.5),
			Transparency = seq(soft and 0.2 or 0.3, 1),
			Lifetime = NumberRange.new(soft and 0.7 or 0.45, soft and 1.1 or 0.8),
			Speed = NumberRange.new(soft and 3 or 1.5, soft and 6 or 3),
			SpreadAngle = Vector2.new(30, 30),
			Acceleration = Vector3.new(0, soft and -6 or 0.5, 0),
			WindAffectsDrag = true,
		}, soft and 5 or 3)
	end

	-- Marca de bala (no queda en nieve ni en tierra blanda)
	if soft then
		return
	end
	local markColor = (kind == "Metal" and Color3.fromRGB(70, 70, 76))
		or (kind == "Wood" and Color3.fromRGB(45, 30, 20))
		or (kind == "Glass" and Color3.fromRGB(230, 240, 250))
		or Color3.fromRGB(25, 25, 28)
	local mark = ringPart(markRing, {
		Color = markColor,
		Material = kind == "Metal" and Enum.Material.Metal or Enum.Material.SmoothPlastic,
		Size = Vector3.new(0.22, 0.22, 0.03),
		Shape = Enum.PartType.Block,
		CFrame = safeLookAt(position, normal or Vector3.yAxis) * CFrame.Angles(0, 0, math.random() * math.pi),
		Transparency = kind == "Glass" and 0.4 or 0.15,
	})
	if kind == "Stone" then
		-- Desconchón claro alrededor del agujero
		local chip = ringPart(chipRing, {
			Color = baseColor:Lerp(Color3.new(1, 1, 1), 0.25),
			Material = Enum.Material.SmoothPlastic,
			Size = Vector3.new(0.45, 0.45, 0.012),
			CFrame = mark.CFrame * CFrame.new(0, 0, -0.003) * CFrame.Angles(0, 0, 0.6),
			Transparency = 0.35,
		})
		TweenService:Create(chip, TweenInfo.new(5, Enum.EasingStyle.Linear), { Transparency = 1 }):Play()
	end
	TweenService:Create(mark, TweenInfo.new(5, Enum.EasingStyle.Linear), { Transparency = 1 }):Play()
end

-- Casquillo que sale disparado por la derecha del arma
local liveCasings = 0
local MAX_CASINGS = 8 -- con fuego automático no hace falta simular más a la vez

function Effects.ShellCasing(attachment, cameraCFrame, color)
	if not attachment or liveCasings >= MAX_CASINGS then
		return
	end
	liveCasings += 1
	task.delay(1.5, function()
		liveCasings -= 1
	end)
	local casing = Instance.new("Part")
	casing.Size = Vector3.new(0.06, 0.06, 0.16)
	casing.Color = color or Color3.fromRGB(230, 180, 60)
	casing.Material = Enum.Material.Metal
	casing.Reflectance = 0.2
	casing.CanCollide = true
	casing.CanQuery = false
	casing.CanTouch = false
	casing.CastShadow = false
	casing.Massless = true
	casing.CustomPhysicalProperties = PhysicalProperties.new(0.05, 0.3, 0.6)
	casing.CFrame = attachment.WorldCFrame
	casing.Parent = folder
	local right = cameraCFrame.RightVector
	local up = cameraCFrame.UpVector
	casing.AssemblyLinearVelocity = right * (6 + math.random() * 3) + up * (5 + math.random() * 3)
	casing.AssemblyAngularVelocity = Vector3.new(math.random(-20, 20), math.random(-20, 20), math.random(-20, 20))
	Debris:AddItem(casing, 1.5)
end

-- Humo del cañón: tras una ráfaga larga, del cañón caliente sale un hilo de humo un par de segundos
-- (amount 0..1 según lo larga que fue la ráfaga). Un emisor por arma, en la propia boca del cañón.
function Effects.BarrelSmoke(attachment, amount)
	if not attachment or not attachment.Parent or ClientState.EffectiveQuality == "Baja" then
		return
	end
	amount = math.clamp(amount or 0.5, 0, 1)
	local emitter = attachment:FindFirstChild("BarrelSmoke")
	if not emitter then
		emitter = Instance.new("ParticleEmitter")
		emitter.Name = "BarrelSmoke"
		emitter.Texture = TEX.Smoke
		emitter.Color = ColorSequence.new(Color3.fromRGB(215, 215, 212))
		emitter.LightInfluence = 1
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.05),
			NumberSequenceKeypoint.new(1, 0.55),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.85),
			NumberSequenceKeypoint.new(0.5, 0.88),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Lifetime = NumberRange.new(0.9, 1.4)
		emitter.Speed = NumberRange.new(0.3, 0.7)
		emitter.Drag = 1
		emitter.RotSpeed = NumberRange.new(-30, 30)
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.SpreadAngle = Vector2.new(10, 10)
		emitter.Acceleration = Vector3.new(0, 2.2, 0)
		emitter.EmissionDirection = Enum.NormalId.Top
		emitter.Enabled = false
		emitter.Parent = attachment
	end
	emitter.Rate = 10 + 16 * amount
	emitter.Enabled = true
	local token = (emitter:GetAttribute("Token") or 0) + 1
	emitter:SetAttribute("Token", token)
	task.delay(0.8 + 1.6 * amount, function()
		if emitter.Parent and emitter:GetAttribute("Token") == token then
			emitter.Enabled = false
		end
	end)
	return emitter
end

-- Al volver a disparar, el humo se corta (el fogonazo lo tapa)
function Effects.StopBarrelSmoke(attachment)
	local emitter = attachment and attachment:FindFirstChild("BarrelSmoke")
	if emitter then
		emitter.Enabled = false
	end
end

-- Explosión del cohete
function Effects.Explosion(position, radius, color)
	radius = radius or 12
	-- Temblor de cámara si la explosión es cercana (más fuerte cuanto más cerca)
	local camera = workspace.CurrentCamera
	if camera then
		local distance = (camera.CFrame.Position - position).Magnitude
		local strength = math.clamp(1 - distance / (radius * 4), 0, 1)
		if strength > 0 then
			ClientState.Shake = math.max(ClientState.Shake or 0, strength)
		end
		-- Muy cerca: aturdimiento (pitido, sonido apagado, destello y desenfoque; ver CombatFX)
		local concussion = math.clamp(1 - distance / (radius * 2.2), 0, 1)
		local onConcussion = Effects.OnConcussion
		if concussion > 0 and onConcussion then
			onConcussion(concussion)
		end
	end
	color = color or Color3.fromRGB(255, 140, 30)
	local fireball = fxPart({
		Color = Color3.fromRGB(255, 200, 80),
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(2, 2, 2),
		CFrame = CFrame.new(position),
		Transparency = 0,
	})
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = radius * 2.5
	light.Brightness = 6
	light.Parent = fireball
	TweenService:Create(fireball, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Size = Vector3.one * radius * 1.2, Transparency = 1, Color = color }):Play()
	TweenService:Create(light, TweenInfo.new(0.5), { Brightness = 0 }):Play()
	Debris:AddItem(fireball, 0.55)

	local realistic = realisticMap()
	local anchor = emitterAnchor(position, Vector3.yAxis, 3)
	if realistic then
		-- Onda expansiva de verdad: una ola de polvo y tierra que sale a ras de suelo
		emit(anchor, {
			Texture = TEX.Smoke,
			Color = ColorSequence.new(Color3.fromRGB(150, 138, 118), Color3.fromRGB(110, 102, 90)),
			LightInfluence = 1,
			Size = seq(1.5, 5),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.35),
				NumberSequenceKeypoint.new(0.5, 0.6),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Lifetime = NumberRange.new(0.8, 1.4),
			Speed = NumberRange.new(radius * 1.6, radius * 2.4),
			SpreadAngle = Vector2.new(88, 88),
			Drag = 4,
			Acceleration = Vector3.new(0, -4, 0),
			Rotation = NumberRange.new(0, 360),
			RotSpeed = NumberRange.new(-40, 40),
		}, 22)
	else
		-- Onda expansiva en el suelo
		local ring = fxPart({
			Color = color:Lerp(Color3.new(1, 1, 1), 0.4),
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.2, 2, 2),
			CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2),
			Transparency = 0.2,
		})
		TweenService:Create(ring, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Size = Vector3.new(0.1, radius * 2.4, radius * 2.4), Transparency = 1 }):Play()
		Debris:AddItem(ring, 0.45)
	end
	emit(anchor, {
		Texture = TEX.Fire,
		Color = ColorSequence.new(Color3.fromRGB(255, 230, 150), color),
		LightEmission = 1,
		Size = seq(3, 0.5),
		Transparency = seq(0, 1),
		Lifetime = NumberRange.new(0.3, 0.6),
		Speed = NumberRange.new(10, 22),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 3,
	}, 30)
	emit(anchor, {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(Color3.fromRGB(70, 65, 60)),
		Size = seq(2, 7),
		Transparency = seq(0.2, 1),
		Lifetime = NumberRange.new(1.2, 2.2),
		Speed = NumberRange.new(3, 8),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, 3, 0),
	}, 14)
	-- Chispas (en los mapas realistas, brasas que caen dejando estela en vez de estrellitas)
	emit(anchor, {
		Texture = realistic and TEX.Fire or TEX.Sparkle,
		Color = ColorSequence.new(Color3.fromRGB(255, 220, 120), realistic and Color3.fromRGB(255, 120, 40) or Color3.fromRGB(255, 220, 120)),
		LightEmission = 1,
		Size = realistic and seq(0.18, 0.04) or seq(0.3, 0),
		Lifetime = NumberRange.new(0.5, realistic and 1.3 or 1),
		Speed = NumberRange.new(25, 45),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -60, 0),
	}, realistic and 26 or 20)

	-- Columna de humo negro que se queda unos segundos
	local smokeAnchor = emitterAnchor(position + Vector3.new(0, 1, 0), Vector3.yAxis, 6)
	emit(smokeAnchor, {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(Color3.fromRGB(40, 38, 36), Color3.fromRGB(90, 88, 85)),
		Size = seq(3, 10),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.5),
			NumberSequenceKeypoint.new(0.6, 0.7),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(3, 5),
		Speed = NumberRange.new(2, 4),
		SpreadAngle = Vector2.new(25, 25),
		Acceleration = Vector3.new(0.5, 2.5, 0),
		RotSpeed = NumberRange.new(-25, 25),
		Rotation = NumberRange.new(0, 360),
	}, 10)

	-- Escombros que salen despedidos
	for _ = 1, 8 do
		local chunk = fxPart({
			Size = Vector3.new(0.3 + math.random() * 0.4, 0.2 + math.random() * 0.3, 0.3 + math.random() * 0.4),
			Color = Color3.fromRGB(70, 66, 62),
			Material = Enum.Material.Slate,
			CFrame = CFrame.new(position + Vector3.new(0, 0.5, 0)) * CFrame.Angles(math.random() * 6, math.random() * 6, 0),
		})
		chunk.Anchored = false
		local dir = Vector3.new(math.random() - 0.5, 0.7 + math.random() * 0.6, math.random() - 0.5).Unit
		chunk.AssemblyLinearVelocity = dir * (25 + math.random() * 20)
		chunk.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 25
		TweenService:Create(chunk, TweenInfo.new(0.4, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 1.4), { Transparency = 1 }):Play()
		Debris:AddItem(chunk, 1.9)
	end

	-- Marca de quemado en el suelo (si hay suelo cerca)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { folder }
	local ground = workspace:Raycast(position + Vector3.new(0, 2, 0), Vector3.new(0, -8, 0), params)
	if ground and ground.Instance then
		local scorch = fxPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.05, radius * 0.9, radius * 0.9),
			Color = Color3.fromRGB(22, 20, 18),
			Material = Enum.Material.Slate,
			CFrame = safeLookAt(ground.Position + ground.Normal * 0.04, ground.Normal) * CFrame.Angles(0, math.pi / 2, 0),
			Transparency = 0.25,
		})
		TweenService:Create(scorch, TweenInfo.new(4, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 6), { Transparency = 1 }):Play()
		Debris:AddItem(scorch, 10.2)
	end
end

-- Cohete que vuela hasta `to` y explota al llegar
-- style = "Pumpkin": el proyectil es una calabaza con cara (Calabazooka)
function Effects.Rocket(from, to, speed, color, radius, style)
	local distance = (to - from).Magnitude
	if distance < 0.5 then
		Effects.Explosion(to, radius, color)
		return
	end
	local direction = safeLookAt(from, to - from)
	local pumpkin = style == "Pumpkin"
	local rocket = fxPart({
		Color = pumpkin and Color3.fromRGB(255, 130, 20) or Color3.fromRGB(230, 230, 235),
		Material = Enum.Material.SmoothPlastic,
		Shape = pumpkin and Enum.PartType.Ball or Enum.PartType.Block,
		Size = pumpkin and Vector3.new(1.1, 1.1, 1.1) or Vector3.new(0.35, 0.35, 1.3),
		CFrame = direction,
	})
	local tip = fxPart({
		Color = pumpkin and Color3.fromRGB(255, 220, 60) or Color3.fromRGB(220, 40, 40),
		Material = pumpkin and Enum.Material.Neon or Enum.Material.SmoothPlastic,
		Shape = pumpkin and Enum.PartType.Block or Enum.PartType.Ball,
		Size = pumpkin and Vector3.new(0.5, 0.18, 0.1) or Vector3.new(0.38, 0.38, 0.38),
		CFrame = direction * CFrame.new(0, pumpkin and 0.1 or 0, pumpkin and -0.52 or -0.65),
	})
	local flame = fxPart({
		Color = color or Color3.fromRGB(255, 160, 40),
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.45, 0.45, 0.45),
		CFrame = direction * CFrame.new(0, 0, 0.7),
	})
	local trail = Instance.new("ParticleEmitter")
	trail.Texture = TEX.Smoke
	trail.Color = ColorSequence.new(Color3.fromRGB(200, 200, 200))
	trail.Size = seq(0.4, 1.6)
	trail.Transparency = seq(0.3, 1)
	trail.Lifetime = NumberRange.new(0.5, 0.9)
	trail.Speed = NumberRange.new(0.5, 1)
	trail.Rate = 80
	trail.Parent = flame
	local duration = distance / speed
	for _, part in { rocket, tip, flame } do
		local offset = direction:ToObjectSpace(part.CFrame)
		local finalCF = direction * CFrame.new(0, 0, -distance) * offset
		TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = finalCF }):Play()
	end
	task.delay(duration, function()
		trail.Enabled = false
		rocket:Destroy()
		tip:Destroy()
		flame.Transparency = 1
		Debris:AddItem(flame, 1)
		Effects.Explosion(to, radius, color)
	end)
end

-- Explosión de partículas cuando alguien es eliminado
function Effects.DeathBurst(position, color)
	color = color or Color3.new(1, 1, 1)
	local anchor = emitterAnchor(position, Vector3.yAxis, 2.5)
	emit(anchor, {
		Texture = TEX.Sparkle,
		Color = ColorSequence.new(color, Color3.new(1, 1, 1)),
		LightEmission = 1,
		Size = seq(0.9, 0),
		Lifetime = NumberRange.new(0.5, 0.9),
		Speed = NumberRange.new(10, 20),
		SpreadAngle = Vector2.new(180, 180),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-180, 180),
		Drag = 4,
	}, 24)
	emit(anchor, {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.6)),
		Size = seq(1.5, 4),
		Transparency = seq(0.4, 1),
		Lifetime = NumberRange.new(0.8, 1.3),
		Speed = NumberRange.new(2, 5),
		SpreadAngle = Vector2.new(180, 180),
	}, 6)
	local flash = fxPart({
		Color = color,
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(position),
		Transparency = 0.2,
	})
	TweenService:Create(flash, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Size = Vector3.new(7, 7, 7), Transparency = 1 }):Play()
	Debris:AddItem(flash, 0.4)
end

---------------------------------------------------------------------------
-- Efectos de eliminación (ver KillEffects.luau)
---------------------------------------------------------------------------

-- Emoji o texto que flota en el mundo (BillboardGui) y se desvanece
local function floatingText(position, text, size, rise, duration, color)
	local anchor = fxPart({ Size = Vector3.new(0.1, 0.1, 0.1), Transparency = 1, CFrame = CFrame.new(position) })
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(size, size)
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = 400
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.Parent = gui
	TweenService:Create(anchor, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.new(position + rise) }):Play()
	TweenService:Create(label, TweenInfo.new(duration * 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, duration * 0.5), { TextTransparency = 1 }):Play()
	Debris:AddItem(anchor, duration + 0.1)
end

-- Piezas sueltas que salen disparadas con física (confeti, monedas, cristales)
local function debrisBurst(position, count, makePart, speed, lifetime)
	for _ = 1, count do
		local part = makePart()
		part.Anchored = false
		part.CanCollide = false -- no empujan a nadie; desaparecen antes de caer mucho
		part.CFrame = CFrame.new(position + Vector3.new(math.random() - 0.5, math.random() * 0.5, math.random() - 0.5))
			* CFrame.Angles(math.random() * 6.28, math.random() * 6.28, math.random() * 6.28)
		local dir = Vector3.new(math.random() - 0.5, 0.6 + math.random() * 0.8, math.random() - 0.5).Unit
		part.AssemblyLinearVelocity = dir * speed * (0.6 + math.random() * 0.6)
		part.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 20
		TweenService:Create(part, TweenInfo.new(0.4, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, lifetime - 0.4), { Transparency = 1 }):Play()
		Debris:AddItem(part, lifetime)
	end
end

local CONFETTI_COLORS = {
	Color3.fromRGB(255, 70, 90),
	Color3.fromRGB(255, 210, 40),
	Color3.fromRGB(60, 200, 255),
	Color3.fromRGB(120, 255, 120),
	Color3.fromRGB(200, 100, 255),
	Color3.fromRGB(255, 140, 30),
}

local function flashBall(position, color, size, duration)
	local flash = fxPart({ Color = color, Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(position), Transparency = 0.2 })
	TweenService:Create(flash, TweenInfo.new(duration, Enum.EasingStyle.Quad), { Size = Vector3.one * size, Transparency = 1 }):Play()
	Debris:AddItem(flash, duration + 0.05)
	return flash
end

