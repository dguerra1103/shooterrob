end

---------------------------------------------------------------------------
-- Mensajes
---------------------------------------------------------------------------

local function popup(text, color)
	local label = UI.label({
		Size = UDim2.fromOffset(400, 26),
		Text = text,
		TextSize = 22,
		TextColor3 = color or Color3.fromRGB(255, 230, 120),
		LayoutOrder = math.floor(os.clock() * 100) % 100000,
		Parent = refs.Popups,
	})
	task.delay(1.4, function()
		tween(label, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	Debris:AddItem(label, 2)
end

local bigToken
local function bigMessage(text, color)
	local label = refs.BigText
	label.Text = text
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextTransparency = 0
	label.TextStrokeTransparency = 0
	label.Size = UDim2.fromOffset(800, 70)
	label.TextSize = 70
	label.Visible = true
	tween(label, 0.25, { TextSize = 54 }, Enum.EasingStyle.Back)
	local token = {}
	bigToken = token
	task.delay(2.5, function()
		if bigToken == token then
			tween(label, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
	end)
end

local function timedLabel(label, text, duration)
	label.Text = text
	label.Visible = true
	local token = {}
	label:SetAttribute("Token", tostring(token))
	task.delay(duration, function()
		if label:GetAttribute("Token") == tostring(token) then
			label.Visible = false
		end
	end)
end

local function onNotify(kind, text)
	if kind == "XP" then
		popup(text)
	elseif kind == "Big" then
		bigMessage(text)
	elseif kind == "Challenge" then
		bigMessage("✅ " .. text, Color3.fromRGB(90, 255, 140))
		Sounds.Play("Kill")
	elseif kind == "Mastery" then
		bigMessage("🏆 " .. text, Color3.fromRGB(255, 200, 50))
		Sounds.Play("Kill")
	elseif kind == "LevelUp" then
		bigMessage("⬆ ¡NIVEL " .. tostring(text) .. "!", Color3.fromRGB(255, 210, 60))
		Sounds.Play("Kill")
		-- Qué da este nivel del pase (y qué daría el premium, si no lo tiene)
		local tier = type(text) == "number" and GameConfig.BattlePass[text]
		if tier then
			local function describe(reward)
				if not reward then
					return nil
				elseif reward.Type == "Coins" then
					return "🪙 +" .. tostring(reward.Amount)
				elseif reward.Type == "Skin" then
					return "🎨 Skin " .. Skins.Get(reward.Id).Name
				elseif reward.Type == "Crate" then
					return "🎁 Caja"
				elseif reward.Type == "Outfit" then
					return "👕 Traje nuevo"
				end
				return reward.Type
			end
			local data = ClientState.Data
			local free, premium = describe(tier.Free), describe(tier.Premium)
			local line = free and ("Recompensa: " .. free) or ""
			if premium and (GameConfig.PremiumPassId ~= 0 or (data and data.Premium)) then
				if data and data.Premium then
					line ..= (line ~= "" and "   ·   " or "") .. "👑 " .. premium
				else
					line ..= (line ~= "" and "   ·   " or "") .. "👑 Con el pase premium: " .. premium
				end
			end
			if line ~= "" then
				-- En el aviso inferior (el banner superior lo usan las rachas y banderas)
				task.delay(0.6, function()
					timedLabel(refs.Toast, line, 4)
				end)
			end
		end
	elseif kind == "Flag" then
		timedLabel(refs.Banner, "🚩 " .. text, 3)
		Sounds.Play("Flag")
	elseif kind == "Streak" then
		timedLabel(refs.Banner, "🔥 " .. text, 3)
	else
		timedLabel(refs.Toast, text, 3)
		Sounds.Play("Click")
	end
end

local multiCount, lastKillTime, killToken = 0, 0, nil
local MULTI_NAMES = { [2] = "¡DOBLE BAJA!", [3] = "¡TRIPLE BAJA!", [4] = "¡CUÁDRUPLE!" }

local function showKillBanner(victim, headshot)
	local now = os.clock()
	multiCount = (now - lastKillTime < 4) and multiCount + 1 or 1
	lastKillTime = now
	local multi = MULTI_NAMES[multiCount] or (multiCount >= 5 and "¡IMPARABLE!" or nil)
	refs.KillTitle.Text = multi or "ELIMINADO"
	refs.KillTitle.TextColor3 = multi and Color3.fromRGB(255, 180, 30) or Color3.fromRGB(255, 70, 70)
	refs.KillSub.Text = tostring(victim) .. (headshot and "  ·  DISPARO A LA CABEZA" or "")
	refs.KillIcon.Text = headshot and "🎯" or "💀"
	refs.KillBanner.Visible = true
	refs.KillScale.Scale = 1.5
	tween(refs.KillScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	local token = {}
	killToken = token
	task.delay(2.2, function()
		if killToken == token then
			refs.KillBanner.Visible = false
		end
	end)
end

local function onKillFeed(info)
	if type(info) ~= "table" then
		return
	end
	if info.Killer == player.Name and info.Victim ~= player.Name then
		showKillBanner(info.Victim, info.Headshot)
	end
	local killer = info.Killer
	local text
	local weapon = info.Weapon ~= "" and (" [" .. info.Weapon .. "] ") or " ✖ "
	if info.Headshot then
		weapon ..= "🎯 "
	end
	local victim = string.format('<font color="%s">%s</font>', UI.hex(info.VictimColor), info.Victim or "?")
	if killer then
		text = string.format('<font color="%s">%s</font>%s%s', UI.hex(info.KillerColor), killer, weapon, victim)
	else
		text = victim .. " se eliminó"
	end
	local entry = UI.new("Frame", {
		Size = UDim2.fromOffset(380, 26),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		LayoutOrder = math.floor(os.clock() * 100) % 1000000,
		Parent = refs.KillFeed,
	}, { UI.corner(6) })
	if killer == player.Name or info.Victim == player.Name then
		UI.stroke(Color3.fromRGB(255, 210, 80), 2, 0.2).Parent = entry
	end
	UI.label({
		Size = UDim2.new(1, -12, 1, 0),
		Position = UDim2.fromOffset(6, 0),
		Text = text,
		RichText = true,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = entry,
	})
	local entries = {}
	for _, child in refs.KillFeed:GetChildren() do
		if child:IsA("Frame") then
			table.insert(entries, child)
		end
	end
	if #entries > 6 then
		table.sort(entries, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		entries[1]:Destroy()
	end
	Debris:AddItem(entry, 7)
end

local hitToken
local function onHitConfirm(damage, headshot, killed, serverPosition)
	local color = Color3.new(1, 1, 1)
	if killed then
		color = Color3.fromRGB(255, 40, 40)
	elseif headshot then
		color = Color3.fromRGB(255, 210, 40)
	end
	for _, line in refs.HitLines do
		line.BackgroundColor3 = color
		line.Size = killed and UDim2.fromOffset(14, 4) or UDim2.fromOffset(10, 3)
	end
	refs.Hitmarker.Visible = true
	local token = {}
	hitToken = token
	task.delay(killed and 0.35 or 0.15, function()
		if hitToken == token then
			refs.Hitmarker.Visible = false
		end
	end)
	Sounds.Play(killed and "Kill" or (headshot and "Headshot" or "Hit"))

	-- Número de daño en el mundo, encima de donde le diste (si lo sabemos), con un rebote
	-- El servidor dice dónde fue el daño; si no, el último impacto del propio cliente
	local hitPosition = typeof(serverPosition) == "Vector3" and serverPosition
		or (os.clock() - ClientState.LastHitTime < 0.6 and ClientState.LastHitPosition)
	if type(damage) == "number" and hitPosition then
		local anchor = Instance.new("Attachment")
		anchor.WorldPosition = hitPosition + Vector3.new(math.random(-10, 10) / 10, 1.2, math.random(-10, 10) / 10)
		anchor.Parent = workspace.Terrain
		local board = Instance.new("BillboardGui")
		board.Size = UDim2.fromOffset(120, 50)
		board.AlwaysOnTop = true
		board.LightInfluence = 0
		board.Adornee = anchor
		board.Parent = gui.Parent -- (un BillboardGui dentro de un ScreenGui no se dibuja)
		local label = UI.label({
			Size = UDim2.fromScale(1, 1),
			Text = (killed and "💀 " or "") .. tostring(damage) .. (headshot and "!" or ""),
			TextSize = killed and 34 or (headshot and 32 or 26),
			TextColor3 = color,
			Parent = board,
		})
		local scale = UI.new("UIScale", { Scale = 1.6, Parent = label })
		tween(scale, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
		task.delay(0.35, function()
			tween(label, 0.5, { TextTransparency = 1, TextStrokeTransparency = 1 })
			tween(board, 0.5, { StudsOffsetWorldSpace = Vector3.new(0, 2, 0) })
		end)
		Debris:AddItem(board, 1)
		Debris:AddItem(anchor, 1)
	elseif type(damage) == "number" then
		local label = UI.label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.random(30, 60), 0.5, math.random(-40, -20)),
			Size = UDim2.fromOffset(80, 30),
			Text = tostring(damage),
			TextSize = headshot and 28 or 22,
			TextColor3 = color,
			Parent = gui,
		})
		tween(label, 0.6, {
			Position = label.Position + UDim2.fromOffset(0, -30),
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		})
		Debris:AddItem(label, 0.7)
	end
end

local summaryToken = 0

-- Anima el resumen: estadísticas, la barra de nivel se llena (y se vacía al subir de nivel) y las
-- monedas cuentan hacia arriba
local function onMatchSummary(summary)
	if type(summary) ~= "table" or type(summary.XP) ~= "number" then
		return
	end
	summaryToken += 1
	local token = summaryToken
	refs.RoundEnd.Size = UDim2.fromOffset(560, 390)
	refs.Summary.Visible = true
	refs.SummaryLevelUp.Visible = false
	local stats = string.format("🎯 %d bajas   💀 %d muertes   🔥 racha %d", summary.Kills or 0, summary.Deaths or 0, summary.BestStreak or 0)
	if (summary.Captures or 0) > 0 then
		stats ..= "   🚩 " .. summary.Captures
	end
	if (summary.WinStreak or 0) >= 2 then
		stats ..= "   🏆 x" .. summary.WinStreak
	end
	refs.SummaryStats.Text = stats
	local perLevel = math.max(1, summary.XPPerLevel or 1)
	local level = summary.StartLevel or summary.Level or 1
	refs.SummaryLevel.Text = "NIVEL " .. level
	refs.SummaryFill.Size = UDim2.fromScale(math.clamp((summary.StartXP or 0) / perLevel, 0, 1), 1)
	refs.SummaryXP.Text = "+0 XP"
	refs.SummaryCoins.Text = "+0 🪙"
	local levelsUp = math.max(0, (summary.Level or level) - level)
	local startRank = summary.StartRank or summary.RankPoints or 0
	local endRank = summary.RankPoints or startRank
	local rankDelta = endRank - startRank
	local function rankText(points, delta)
		local tier = Ranks.Get(points)
		local deltaText = ""
		if delta > 0 then
			deltaText = '  <font color="#6EE06E">+' .. delta .. " RP</font>"
		elseif delta < 0 then
			deltaText = '  <font color="#FF6E6E">' .. delta .. " RP</font>"
		end
		return string.format('%s <font color="%s"><b>%s</b></font>%s', tier.Icon, UI.hex(tier.Color), string.upper(tier.Name), deltaText)
	end
	refs.SummaryRank.Text = rankText(startRank, 0)
	task.spawn(function()
		task.wait(0.4)
		-- Barra de XP: un tramo por cada nivel subido
		local levels = math.max(0, (summary.Level or level) - level)
		for i = 0, levels do
			if token ~= summaryToken then
				return
			end
			local target = i < levels and 1 or math.clamp((summary.LevelXP or 0) / perLevel, 0, 1)
			tween(refs.SummaryFill, 0.7, { Size = UDim2.fromScale(target, 1) })
			task.wait(0.75)
			if i < levels then
				level += 1
				refs.SummaryLevel.Text = "NIVEL " .. level
				refs.SummaryLevelUp.Text = "⬆ ¡SUBES DE NIVEL!"
				refs.SummaryLevelUp.TextColor3 = Color3.fromRGB(255, 220, 70)
				refs.SummaryLevelUp.Visible = true
				Sounds.Play("Flag")
				refs.SummaryFill.Size = UDim2.fromScale(0, 1)
			end
		end
	end)
	task.spawn(function()
		-- Contadores de XP y monedas
		local steps = 24
		for i = 1, steps do
			if token ~= summaryToken then
				return
			end
			local t = i / steps
			refs.SummaryXP.Text = "+" .. math.floor(summary.XP * t) .. " XP"
			refs.SummaryCoins.Text = "+" .. math.floor((summary.Coins or 0) * t) .. " 🪙"
			task.wait(0.05)
		end
		Sounds.Play("Kill")
		if rankDelta ~= 0 and token == summaryToken then
			refs.SummaryRank.Text = rankText(endRank, rankDelta)
			-- ¡Subes de rango!
			if Ranks.Index(endRank) > Ranks.Index(startRank) then
				-- (después de la animación de subir de nivel, que usa el mismo cartel)
				task.wait(math.max(0.3, 0.4 + 0.75 * (levelsUp + 1) - 1.2))
				if token ~= summaryToken then
					return
				end
				local tier = Ranks.Get(endRank)
				refs.SummaryLevelUp.Text = tier.Icon .. " ¡ASCIENDES A " .. string.upper(tier.Name) .. "!"
				refs.SummaryLevelUp.TextColor3 = tier.Color
				refs.SummaryLevelUp.Visible = true
				Sounds.Play("Flag")
			end
		end
	end)
end

local function onRoundEnd(info)
	if type(info) ~= "table" then
		return
	end
	summaryToken += 1
	refs.RoundEnd.Size = UDim2.fromOffset(560, 220)
	refs.Summary.Visible = false
	local teamA = ReplicatedStorage:GetAttribute("TeamA") or "Rojo"
	local teamB = ReplicatedStorage:GetAttribute("TeamB") or "Azul"
	if info.TeamMode == false then
		local won = info.Winner == player.Name
		refs.RoundTitle.Text = won and "¡VICTORIA!" or (info.Winner and (info.Winner .. " GANA") or "FIN")
		refs.RoundTitle.TextColor3 = won and Color3.fromRGB(255, 210, 60) or Color3.fromRGB(255, 120, 80)
		refs.RoundScore.Text = "👑 " .. tostring(info.Winner or "-") .. " · " .. tostring(info.LeaderScore or 0)
		refs.RoundMVP.Text = info.MVP and ("⭐ MVP: " .. info.MVP .. " (" .. info.MVPKills .. " bajas)") or ""
		refs.RoundEnd.Visible = true
		task.delay(7, function()
			refs.RoundEnd.Visible = false
		end)
		return
	elseif info.Winner then
		local won = player.Team and player.Team.Name == info.Winner
		refs.RoundTitle.Text = won and "¡VICTORIA!" or "DERROTA"
		refs.RoundTitle.TextColor3 = won and Color3.fromRGB(255, 210, 60) or Color3.fromRGB(255, 80, 80)
	else
		refs.RoundTitle.Text = "EMPATE"
		refs.RoundTitle.TextColor3 = Color3.new(1, 1, 1)
	end
	local colorA = refs.ScoreABox.BackgroundColor3
	local colorB = refs.ScoreBBox.BackgroundColor3
	refs.RoundScore.Text = string.format(
		'<font color="%s">%s %d</font>  -  <font color="%s">%d %s</font>',
		UI.hex(colorA),
		teamA,
		info.ScoreA or 0,
		UI.hex(colorB),
		info.ScoreB or 0,
		teamB
	)
	local mvpText = ""
	if info.MVP then
		local captures = info.MVPCaptures or 0
		mvpText = "⭐ MVP: " .. info.MVP .. " (" .. info.MVPKills .. " bajas"
		if captures > 0 then
			mvpText ..= ", " .. captures .. (captures == 1 and " captura" or " capturas")
		end
		mvpText ..= ")"
	end
	refs.RoundMVP.Text = mvpText
	refs.RoundEnd.Visible = true
	task.delay(7, function()
		refs.RoundEnd.Visible = false
	end)
end

---------------------------------------------------------------------------
-- Actualización
---------------------------------------------------------------------------

local function getThumbnail(userId)
	if thumbnails[userId] ~= nil then
		return thumbnails[userId]
	end
	thumbnails[userId] = ""
	task.spawn(function()
		local ok, image = pcall(function()
			return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
		end)
		thumbnails[userId] = ok and image or ""
	end)
	return ""
end

local lastRowSignature = ""

local function updatePlayerRow()
	local list = Players:GetPlayers()
	local function kills(p)
		local stats = p:FindFirstChild("leaderstats")
		local value = stats and stats:FindFirstChild("Bajas")
		return value and value.Value or 0
	end
	table.sort(list, function(a, b)
		return kills(a) > kills(b)
	end)
	-- Solo se reconstruye si algo ha cambiado (orden, bajas, equipos o fotos ya cargadas)
	local parts = {}
	for rank = 1, math.min(10, #list) do
		local p = list[rank]
		table.insert(parts, p.UserId .. ":" .. kills(p) .. ":" .. tostring(p.Team) .. ":" .. tostring(getThumbnail(p.UserId) ~= ""))
	end
	local signature = table.concat(parts, "|")
	if signature == lastRowSignature then
		return
	end
	lastRowSignature = signature
	for _, child in refs.PlayerRow:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	for rank = 1, math.min(10, #list) do
		local p = list[rank]
		local teamColor = p.Team and p.TeamColor.Color or Color3.new(1, 1, 1)
		local card = UI.new("Frame", {
			LayoutOrder = rank,
			Size = UDim2.fromOffset(40, 54),
			BackgroundTransparency = 1,
			Parent = refs.PlayerRow,
		})
		UI.new("ImageLabel", {
			Size = UDim2.fromOffset(40, 40),
			BackgroundColor3 = Color3.fromRGB(40, 40, 45),
			Image = getThumbnail(p.UserId),
			Parent = card,
		}, { UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0) }), UI.stroke(teamColor, 3, 0) })
		UI.label({
			Position = UDim2.fromOffset(-6, -6),
			Size = UDim2.fromOffset(24, 14),
			Text = "#" .. rank,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		UI.label({
			Position = UDim2.fromOffset(0, 38),
			Size = UDim2.fromOffset(40, 16),
			Text = tostring(kills(p)),
			TextSize = 15,
			TextColor3 = p == player and Color3.fromRGB(255, 210, 60) or Color3.new(1, 1, 1),
			Parent = card,
		})
	end
end

-- Últimos valores escritos en el HUD (para no reescribir textos iguales cada fotograma)
local hudCache: { [string]: any } = {}

local function updateScoreboard()
	local teamA = ReplicatedStorage:GetAttribute("TeamA")
	local teamB = ReplicatedStorage:GetAttribute("TeamB")
	if teamA then
		refs.ScoreA.Text = tostring(ReplicatedStorage:GetAttribute("Score_" .. teamA) or 0)
		local team = game:GetService("Teams"):FindFirstChild(teamA)
		if team then
			refs.ScoreABox.BackgroundColor3 = team.TeamColor.Color
		end
	end
	if teamB then
		refs.ScoreB.Text = tostring(ReplicatedStorage:GetAttribute("Score_" .. teamB) or 0)
		local team = game:GetService("Teams"):FindFirstChild(teamB)
		if team then
			refs.ScoreBBox.BackgroundColor3 = team.TeamColor.Color
		end
	end
	local state = ReplicatedStorage:GetAttribute("State")
	local timeLeft = ReplicatedStorage:GetAttribute("TimeLeft") or 0
	local modeName = ReplicatedStorage:GetAttribute("ModeName") or "Duelo por equipos"
	local mapName = ReplicatedStorage:GetAttribute("MapName") or ""
	local teamMode = ReplicatedStorage:GetAttribute("TeamMode") ~= false
	refs.Timer.Text = UI.formatTime(timeLeft)
	if state == "Intermission" then
		refs.Mode.Text = "Calentamiento · " .. mapName .. " · vota el siguiente mapa (" .. timeLeft .. ")"
	elseif state == "Ended" then
		refs.Mode.Text = "Fin de la ronda"
	else
		refs.Mode.Text = mapName .. " · " .. modeName .. " · Primero a " .. tostring(ReplicatedStorage:GetAttribute("ScoreToWin") or "?")
		-- Eliminación: cuántos quedan en pie de cada equipo
		local aliveA, aliveB = ReplicatedStorage:GetAttribute("AliveA"), ReplicatedStorage:GetAttribute("AliveB")
		if aliveA and aliveB and teamA and teamB then
			refs.Mode.Text = modeName .. " · En pie: " .. teamA .. " " .. aliveA .. " – " .. aliveB .. " " .. teamB
		end
	end

	-- Modos sin equipos: tu puntuación contra la del líder
	if not teamMode then
		refs.ScoreA.Text = tostring(player:GetAttribute("Score") or 0)
		refs.ScoreB.Text = tostring(ReplicatedStorage:GetAttribute("LeaderScore") or 0)
		refs.ScoreABox.BackgroundColor3 = Color3.fromRGB(60, 170, 90)
		refs.ScoreBBox.BackgroundColor3 = Color3.fromRGB(230, 160, 30)
		refs.FlagA.Text, refs.FlagA.TextColor3 = "TÚ", Color3.fromRGB(150, 255, 150)
		local leader = ReplicatedStorage:GetAttribute("LeaderName") or ""
		refs.FlagB.Text = leader ~= "" and ("👑 " .. leader) or "LÍDER"
		refs.FlagB.TextColor3 = Color3.fromRGB(255, 210, 80)
		return
	end

	-- Banderas
	local function flagStatus(teamName)
		local flagState = teamName and ReplicatedStorage:GetAttribute("FlagState_" .. teamName)
		if flagState == "Home" then
			return "🚩 En base", Color3.fromRGB(150, 255, 150)
		elseif flagState == "Carried" then
			local carrier = ReplicatedStorage:GetAttribute("FlagCarrier_" .. teamName) or ""
			return "⚠ " .. carrier, Color3.fromRGB(255, 90, 90)
		elseif flagState == "Dropped" then
			return "⬇ Caída", Color3.fromRGB(255, 210, 80)
		end
		return "", Color3.new(1, 1, 1)
	end
	refs.FlagA.Text, refs.FlagA.TextColor3 = flagStatus(teamA)
	refs.FlagB.Text, refs.FlagB.TextColor3 = flagStatus(teamB)

	-- Zona de control
	local zoneOwner = ReplicatedStorage:GetAttribute("ZoneOwner")
	if zoneOwner ~= nil then
		if zoneOwner == "" then
			refs.FlagA.Text, refs.FlagA.TextColor3 = "◆ Zona libre", Color3.new(1, 1, 1)
		elseif zoneOwner == "Contested" then
			refs.FlagA.Text, refs.FlagA.TextColor3 = "◆ ¡DISPUTADA!", Color3.fromRGB(255, 200, 40)
		else
			local team = game:GetService("Teams"):FindFirstChild(zoneOwner)
			refs.FlagA.Text = "◆ Zona: " .. zoneOwner
			refs.FlagA.TextColor3 = team and team.TeamColor.Color or Color3.new(1, 1, 1)
		end
		refs.FlagB.Text = "Se mueve en " .. tostring(ReplicatedStorage:GetAttribute("ZoneMoveIn") or 0) .. "s"
		refs.FlagB.TextColor3 = Color3.fromRGB(200, 210, 230)
	end

	-- Infección: supervivientes contra zombis (en vez de los puntos)
	local infection = ReplicatedStorage:GetAttribute("Infection")
	if infection and state == "Playing" then
		local survivors = ReplicatedStorage:GetAttribute("AliveA") or 0
		local zombies = ReplicatedStorage:GetAttribute("AliveB") or 0
		refs.ScoreA.Text = tostring(survivors)
		refs.ScoreB.Text = tostring(zombies)
		refs.ScoreBBox.BackgroundColor3 = Color3.fromRGB(90, 160, 60)
		refs.FlagA.Text, refs.FlagA.TextColor3 = "🧑 Supervivientes", Color3.fromRGB(200, 230, 255)
		refs.FlagB.Text, refs.FlagB.TextColor3 = "🧟 Zombis", Color3.fromRGB(150, 255, 120)
		local zombie = player.Team and player.Team.Name == teamB and infection == "On"
		if infection == "Prep" then
			refs.Mode.Text = modeName .. " · ¡Escóndete! La infección va a empezar"
		elseif zombie then
			refs.Mode.Text = modeName .. " · 🧟 Eres un zombi: ¡atrapa a los supervivientes!"
		else
			refs.Mode.Text = modeName .. " · ¡Sobrevive hasta que acabe el tiempo!"
		end
	end

	-- La bandera que llevamos a la espalda no nos tapa la vista
	-- (solo se repasa cuando cambia qué banderas llevamos: este aviso llega con cada atributo)
	local flagsFolder = workspace:FindFirstChild("Flags")
	local carrying = ""
	if flagsFolder then
		for _, model in flagsFolder:GetChildren() do
			local teamName = string.gsub(model.Name, "^Flag_", "")
			if ReplicatedStorage:GetAttribute("FlagCarrier_" .. teamName) == player.Name then
				carrying ..= teamName
			end
		end
		carrying ..= "#" .. #flagsFolder:GetChildren()
	end
	if flagsFolder and carrying ~= hudCache.Carrying then
		hudCache.Carrying = carrying
		for _, model in flagsFolder:GetChildren() do
			local teamName = string.gsub(model.Name, "^Flag_", "")
			local mine = ReplicatedStorage:GetAttribute("FlagCarrier_" .. teamName) == player.Name
			for _, part in model:GetDescendants() do
				if part:IsA("BasePart") then
					part.LocalTransparencyModifier = mine and 1 or 0
				elseif part:IsA("BillboardGui") then
					part.Enabled = not mine
				end
			end
		end
	end
end

local function updateData(data)
	if not data then
		return
	end
	local per = data.XPPerLevel or 1000
	refs.LevelText.Text = "Nivel " .. data.Level .. "  ·  " .. data.XP .. "/" .. per .. " XP"
	tween(refs.XPFill, 0.3, { Size = UDim2.fromScale(math.clamp(data.XP / per, 0, 1), 1) })
end

local lastHealth = 100
local lastDamageTime = 0
local lowHealthCC: ColorCorrectionEffect? = nil
local chipRatio = 1
local renderCrosshair

local function render(dt)
	gui.Enabled = not ClientState.InMainMenu
	if ClientState.InMainMenu then
		return -- en la pantalla de inicio no se dibuja el HUD
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	-- Vida
	if humanoid then
		local health = math.max(0, humanoid.Health)
		local ratio = health / math.max(humanoid.MaxHealth, 1)
		local shown = math.ceil(health)
		local healthChanged = ratio ~= hudCache.HealthRatio or shown ~= hudCache.HealthShown or not (lowHealthCC and lowHealthCC.Parent)
		hudCache.HealthRatio, hudCache.HealthShown = ratio, shown
		if healthChanged then
			refs.HealthFill.Size = UDim2.fromScale(ratio, 1)
			refs.HealthFill.BackgroundColor3 = Color3.fromRGB(230, 60, 60):Lerp(Color3.fromRGB(70, 220, 90), ratio)
			refs.HealthText.Text = tostring(shown)
		end
		-- La parte blanca baja despacio y deja ver el daño recibido
		local newChip = ratio > chipRatio and ratio or math.max(ratio, chipRatio - dt * 0.5)
		if newChip ~= chipRatio or healthChanged then
			chipRatio = newChip
			refs.HealthChip.Size = UDim2.fromScale(chipRatio, 1)
		end
		if health < lastHealth - 0.5 then
			lastDamageTime = os.clock()
			refs.DamageStroke.Transparency = 0.35
			tween(refs.DamageStroke, 0.6, { Transparency = 1 })
		elseif ratio < 0.35 and ratio > 0 and os.clock() - lastDamageTime > 0.6 then
			-- Vida baja: la viñeta roja late
			refs.DamageStroke.Transparency = 0.7 + 0.15 * math.sin(os.clock() * 5)
		end
		lastHealth = health
		-- Vida baja: el mundo pierde color poco a poco (corrección de color solo en este cliente)
		local lowCC = lowHealthCC
		if healthChanged then
			if not lowCC or not lowCC.Parent then
				lowCC = Instance.new("ColorCorrectionEffect")
				lowCC.Name = "LowHealthCC"
				lowCC.Parent = game:GetService("Lighting")
				lowHealthCC = lowCC
			end
			local danger = (health > 0 and ratio < 0.4) and (1 - ratio / 0.4) or 0
			lowCC.Saturation = -0.7 * danger
			lowCC.TintColor = Color3.new(1, 1, 1):Lerp(Color3.fromRGB(255, 200, 200), danger)
			lowCC.Contrast = 0.1 * danger
		end
	end

	-- Racha (los textos solo se reescriben cuando cambia el valor: cada escritura recoloca la interfaz)
	local streak = player:GetAttribute("Streak") or 0
	if streak ~= hudCache.Streak then
		hudCache.Streak = streak
		refs.StreakText.Text = "Racha x" .. streak
		refs.StreakFill.Size = UDim2.fromScale(1, math.clamp(streak / 10, 0, 1))
	end

	-- Arma
	local def = ClientState.CurrentDef
	local tool = ClientState.CurrentTool
	if def and tool then
		refs.WeaponName.Text = def.DisplayName
		if def.Type == "Gun" then
			local reserve = tool:GetAttribute("Reserve") or 0
			local low = ClientState.Ammo <= math.ceil(def.MagSize * 0.25)
			if ClientState.Ammo ~= hudCache.Ammo or reserve ~= hudCache.Reserve or low ~= hudCache.Low then
				hudCache.Ammo, hudCache.Reserve, hudCache.Low = ClientState.Ammo, reserve, low
				refs.Ammo.Text = string.format(
					'<font color="%s">%d</font><font size="28" color="#C8C8C8"> | %d</font>',
					low and "#FF5050" or "#FFFFFF",
					ClientState.Ammo,
					reserve
				)
			end
			refs.AmmoBar.Visible = true
			local fill = ClientState.Reloading and ClientState.ReloadProgress or ClientState.Ammo / def.MagSize
			refs.AmmoFill.Size = UDim2.fromScale(math.clamp(fill, 0, 1), 1)
			refs.AmmoFill.BackgroundColor3 = ClientState.Reloading and Color3.fromRGB(120, 200, 255)
				or (ClientState.Ammo <= math.ceil(def.MagSize * 0.25) and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(255, 210, 80))
			local percent = ClientState.Reloading and math.floor(ClientState.ReloadProgress * 100) or -1
			if ClientState.Reloading then
				if percent ~= hudCache.ReloadPercent then
					refs.ReloadHint.Text = "RECARGANDO " .. percent .. "%"
				end
			elseif ClientState.Ammo == 0 and reserve == 0 then
				refs.ReloadHint.Text = "SIN MUNICIÓN"
			elseif ClientState.Ammo <= math.ceil(def.MagSize * 0.25) then
				refs.ReloadHint.Text = "[R] Recargar"
			else
				refs.ReloadHint.Text = ""
			end
			hudCache.ReloadPercent = percent
		else
			hudCache.Ammo = nil
			refs.Ammo.Text = "∞"
			refs.ReloadHint.Text = ""
			refs.AmmoBar.Visible = false
		end
	else
		hudCache.Ammo = nil
		refs.WeaponName.Text = ""
		refs.Ammo.Text = ""
		refs.ReloadHint.Text = ""
		refs.AmmoBar.Visible = false
	end

	-- Ranuras: se revisan al cambiar de arma y, si no, unas 4 veces por segundo
	local now = os.clock()
	if tool == hudCache.SlotTool and now - (hudCache.SlotsAt or 0) < 0.25 then
		renderCrosshair(def)
		return
	end
	hudCache.SlotTool, hudCache.SlotsAt = tool, now
	local tools = WeaponController.GetTools()
	for slot, row in refs.Slots do
		local slotTool = tools[slot]
		local weaponName = slotTool and slotTool:GetAttribute("Weapon")
		local slotDef = weaponName and Weapons.Get(weaponName)
		row.Row.Visible = slotDef ~= nil
		row.Name.Text = slotDef and slotDef.DisplayName or ""
		local active = slotTool ~= nil and slotTool == tool
		row.Name.TextColor3 = active and Color3.fromRGB(255, 210, 60) or Color3.fromRGB(220, 220, 220)
		row.Key.BackgroundColor3 = active and Color3.fromRGB(255, 170, 30) or Color3.fromRGB(20, 20, 25)
		row.Stroke.Transparency = active and 0 or 1
		row.Row.BackgroundTransparency = active and 0.45 or 0.7
		-- Icono 3D (solo se reconstruye si cambia el arma o la skin)
		local skinId = slotTool and slotTool:GetAttribute("Skin")
		local iconKey = slotDef and (weaponName .. "|" .. tostring(skinId)) or nil
		if iconKey ~= row.IconKey then
			row.IconKey = iconKey
			row.Icon:ClearAllChildren()
			if iconKey then
				WeaponIcon.Create(weaponName, skinId, { Size = UDim2.fromScale(1, 1), Parent = row.Icon }, "side", 170 / 44)
			end
		end
	end

	renderCrosshair(def)
end

-- Mira
function renderCrosshair(def)
	local aim = ClientState.AimAlpha
	local isGun = def and def.Type == "Gun"
	local gap = 6 + ClientState.Spread * 6
	for _, line in refs.CrossLines do
		line.Frame.Position = UDim2.fromOffset(line.Dir.X * (gap + 4), line.Dir.Y * (gap + 4))
		line.Frame.Visible = isGun and aim < 0.5
	end
	refs.CrossDot.Visible = aim < 0.5
	refs.Crosshair.Visible = not ClientState.IsBlocked()
	refs.Scope.Visible = def ~= nil and def.Scope == true and aim > 0.85
end

---------------------------------------------------------------------------

function HUD.Init()
	task.spawn(disableCoreGui)

	gui = UI.new("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	buildTopBar()
	buildCrosshair()
	buildWeaponPanel()
	buildPlayerPanel()
	buildFeedsAndOverlays()

	Remotes.Notify.OnClientEvent:Connect(onNotify)
	Remotes.KillFeed.OnClientEvent:Connect(onKillFeed)
	Remotes.HitConfirm.OnClientEvent:Connect(onHitConfirm)
	Remotes.RoundEnd.OnClientEvent:Connect(onRoundEnd)
	Remotes.MatchSummary.OnClientEvent:Connect(onMatchSummary)
	Remotes.Died.OnClientEvent:Connect(function(killerName, weaponName, killerHealth)
		local weapon = weaponName and Weapons.Get(weaponName)
		if killerName then
			refs.DeathText.Text = "ELIMINADO POR <b>"
				.. killerName
				.. "</b>"
				.. (weapon and (" · " .. weapon.DisplayName) or "")
				.. (type(killerHealth) == "number" and killerHealth > 0 and killerName ~= player.Name and string.format('  <font color="#7CFF8A">❤ %d</font>', killerHealth) or "")
		else
			refs.DeathText.Text = "HAS MUERTO"
		end
		refs.DeathIcon:ClearAllChildren()
		if weapon and weapon.Parts then
			WeaponIcon.Create(weaponName, "Default", { Size = UDim2.fromScale(1, 1), Parent = refs.DeathIcon }, "angled", 280 / 110)
		elseif weapon then
			-- Armas sin modelo (granada): un emoji grande
			local icon = Instance.new("TextLabel")
			icon.Size = UDim2.fromScale(1, 1)
			icon.BackgroundTransparency = 1
			icon.Text = "💣"
			icon.TextScaled = true
			icon.Parent = refs.DeathIcon
		end
		refs.DeathScreen.Visible = true
	end)
	player.CharacterAdded:Connect(function()
		refs.DeathScreen.Visible = false
		lastHealth = 100
		refs.DamageStroke.Transparency = 1
	end)

	ClientState.DataChanged.Event:Connect(updateData)
	updateData(ClientState.Data)

	ReplicatedStorage.AttributeChanged:Connect(updateScoreboard)
	player:GetAttributeChangedSignal("Score"):Connect(updateScoreboard)
	updateScoreboard()

	local function updateCarrier()
		refs.CarrierBanner.Visible = player:GetAttribute("CarryingFlag") == true
	end
	player:GetAttributeChangedSignal("CarryingFlag"):Connect(updateCarrier)
	updateCarrier()

	task.spawn(function()
		while true do
			if not ClientState.InMainMenu then
				updatePlayerRow()
			end
			task.wait(1)
		end
	end)

	RunService.RenderStepped:Connect(render)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">InfectionFX</string>
              <string name="Source"><![CDATA[-- Ambiente del modo Infección: la pantalla se vuelve más apagada para los supervivientes y verdosa
-- para los zombis, y suena un golpe grave cuando llegan los zombis. Fuera de la Infección, nada.
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Sounds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Sounds"))

local player = Players.LocalPlayer

local InfectionFX = {}

local LOOKS = {
	None = { TintColor = Color3.new(1, 1, 1), Saturation = 0, Contrast = 0 },
	Prep = { TintColor = Color3.fromRGB(235, 235, 245), Saturation = -0.1, Contrast = 0.05 },
	Survivor = { TintColor = Color3.fromRGB(225, 235, 230), Saturation = -0.25, Contrast = 0.1 },
	Zombie = { TintColor = Color3.fromRGB(190, 255, 170), Saturation = -0.1, Contrast = 0.15 },
}

-- Cambios de ambiente que llevan el golpe grave (llegan los zombis o te conviertes)
local SOUND_ON = { ["Prep>Survivor"] = true, ["Prep>Zombie"] = true, ["Survivor>Zombie"] = true }

function InfectionFX.Init()
	local effect = Instance.new("ColorCorrectionEffect")
	effect.Name = "InfectionTint"
	effect.Enabled = false
	effect.Parent = Lighting
	local current: string = "None"
	local function update()
		local infection = ReplicatedStorage:GetAttribute("Infection")
		local look: string = "None"
		if infection and ReplicatedStorage:GetAttribute("State") == "Playing" then
			if infection == "Prep" then
				look = "Prep"
			elseif player.Team and player.Team.Name == ReplicatedStorage:GetAttribute("TeamB") then
				look = "Zombie"
			else
				look = "Survivor"
			end
		end
		if look == current then
			return
		end
		if SOUND_ON[current .. ">" .. look] then
			Sounds.Play("Infected")
		end
		current = look
		effect.Enabled = true
		local tween = TweenService:Create(effect, TweenInfo.new(1.2), LOOKS[look])
		tween:Play()
		if look == "None" then
			tween.Completed:Once(function()
				if current == "None" then
					effect.Enabled = false
				end
			end)
		end
	end
	ReplicatedStorage:GetAttributeChangedSignal("Infection"):Connect(update)
	ReplicatedStorage:GetAttributeChangedSignal("State"):Connect(update)
	player:GetPropertyChangedSignal("Team"):Connect(update)
	update()
end

return InfectionFX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">JumpPads</string>
              <string name="Source"><![CDATA[-- Plataformas de salto del mapa (piezas con el atributo JumpPad = velocidad vertical, ver
-- Kit.jumpPad): al pisar una sales disparado hacia arriba y puedes dirigirte en el aire.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Sounds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Sounds"))

local ClientState = require(script.Parent.ClientState)

local player = Players.LocalPlayer

local JumpPads = {}

local COOLDOWN = 0.6
local lastLaunch = 0
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude
local filteredCharacter = nil -- el filtro se cambia solo cuando cambia el personaje

function JumpPads.Init()
	RunService.Heartbeat:Connect(function()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not humanoid or not root or humanoid.Health <= 0 or ClientState.Frozen() then
			return
		end
		if os.clock() - lastLaunch < COOLDOWN then
			return
		end
		if filteredCharacter ~= character then
			filteredCharacter = character
			params.FilterDescendantsInstances = { character }
		end
		local hit = workspace:Raycast(root.Position, Vector3.new(0, -4, 0), params)
		local power = hit and hit.Instance:GetAttribute("JumpPad")
		if type(power) ~= "number" then
			return
		end
		lastLaunch = os.clock()
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(v.X, power, v.Z)
		-- Otra vez en el siguiente paso de física: el salto del Humanoid podría pisar la velocidad
		task.defer(function()
			local dt = RunService.Heartbeat:Wait()
			local now = root.AssemblyLinearVelocity
			-- (lo esperado tras un paso es power - gravedad·dt; solo se corrige si quedó muy por debajo)
			if root.Parent and humanoid.Health > 0 and now.Y < power - workspace.Gravity * dt - 8 then
				root.AssemblyLinearVelocity = Vector3.new(now.X, power, now.Z)
			end
		end)
		ClientState.FovKick = 8
		Sounds.Play("Swing")
	end)
end

return JumpPads
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">KillstreakController</string>
              <string name="Source"><![CDATA[-- Recompensas por racha en el cliente:
--  * Radar: resalta en rojo a los enemigos a través de las paredes mientras dure (RadarUntil)
--  * Ataque aéreo: tecla T (cruceta derecha en mando) lanza el ataque al punto al que apuntas
--  * Marcas rojas en el suelo antes de que caigan las bombas
local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local KillstreakController = {}

local strikeWidget, strikeLabel, radarLabel

local function radarActive()
	return workspace:GetServerTimeNow() < (player:GetAttribute("RadarUntil") or 0)
end

local function isEnemy(other)
	if other == player then
		return false
	end
	if ReplicatedStorage:GetAttribute("TeamMode") ~= false and player.Team ~= nil and other.Team == player.Team then
		return false
	end
	return true
end

-- Pone o quita el contorno rojo del radar en los enemigos.
-- Roblox dibuja como mucho 31 Highlights: con el radar activo se apagan los de los compañeros.
local function updateRadar()
	local active = radarActive()
	for _, other in Players:GetPlayers() do
		local teamHighlight = other.Character and other.Character:FindFirstChild("TeamHighlight")
		if teamHighlight and teamHighlight:IsA("Highlight") then
			teamHighlight.Enabled = not active
		end
	end
	-- Jugadores y bots (los bots llevan el nombre de su equipo en el atributo Team)
	local marks = {}
	for _, other in Players:GetPlayers() do
		if other.Character then
			table.insert(marks, { other.Character, isEnemy(other) })
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			local teamName = model:GetAttribute("Team")
			local sameTeam = ReplicatedStorage:GetAttribute("TeamMode") ~= false and player.Team ~= nil and teamName == player.Team.Name
			local teamHighlight = model:FindFirstChild("TeamHighlight")
			if teamHighlight and teamHighlight:IsA("Highlight") then
				teamHighlight.Enabled = not active
			end
			table.insert(marks, { model, not sameTeam })
		end
	end
	for _, mark in marks do
		local character, enemy = mark[1], mark[2]
		local highlight = character:FindFirstChild("RadarHighlight")
		if active and enemy then
			if not highlight then
				highlight = Instance.new("Highlight")
				highlight.Name = "RadarHighlight"
				highlight.FillColor = Color3.fromRGB(255, 40, 40)
				highlight.FillTransparency = 0.55
				highlight.OutlineColor = Color3.fromRGB(255, 120, 120)
				highlight.OutlineTransparency = 0
				highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				highlight.Parent = character
			end
		elseif highlight then
			highlight:Destroy()
		end
	end
	local left = (player:GetAttribute("RadarUntil") or 0) - workspace:GetServerTimeNow()
	radarLabel.Visible = active and not ClientState.InMainMenu
	radarLabel.Text = "📡 RADAR " .. math.max(0, math.ceil(left)) .. "s"
end

local function updateWidget()
	local charges = player:GetAttribute("Airstrikes") or 0
	strikeWidget.Visible = charges > 0 and not ClientState.InMainMenu
	strikeLabel.Text = "✈ T" .. (charges > 1 and (" ×" .. charges) or "")
end

-- Punto al que apunta la cámara (o lejos al frente si apunta al cielo)
local function aimPoint()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = { camera }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	local fx = workspace:FindFirstChild("ClientFX")
	if fx then
		table.insert(ignore, fx)
	end
	params.FilterDescendantsInstances = ignore
	local origin = camera.CFrame.Position
	local direction = camera.CFrame.LookVector * 500
	local result = workspace:Raycast(origin, direction, params)
	return result and result.Position or origin + camera.CFrame.LookVector * 150
end

local function callAirstrike()
	if ClientState.IsBlocked() or (player:GetAttribute("Airstrikes") or 0) <= 0 then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	Remotes.CallAirstrike:FireServer(aimPoint())
	Sounds.Play("Flag", nil, 1.3, 1)
end

-- Columna roja y anillo donde va a caer cada bomba
local function markPoints(points, delay)
	local folder = workspace:FindFirstChild("ClientFX") or workspace
	for _, point in points do
		if typeof(point) == "Vector3" then
			local beam = Instance.new("Part")
			beam.Anchored = true
			beam.CanCollide = false
			beam.CanQuery = false
			beam.CanTouch = false
			beam.CastShadow = false
			beam.Material = Enum.Material.Neon
			beam.Color = Color3.fromRGB(255, 40, 40)
			beam.Transparency = 0.5
			beam.Size = Vector3.new(0.8, 70, 0.8)
			beam.CFrame = CFrame.new(point + Vector3.new(0, 35, 0))
			beam.Parent = folder
			local ring = Instance.new("Part")
			ring.Anchored = true
			ring.CanCollide = false
			ring.CanQuery = false
			ring.CanTouch = false
			ring.CastShadow = false
			ring.Material = Enum.Material.Neon
			ring.Color = Color3.fromRGB(255, 60, 40)
			ring.Shape = Enum.PartType.Cylinder
			ring.Transparency = 0.3
			ring.Size = Vector3.new(0.2, 2, 2)
			ring.CFrame = CFrame.new(point) * CFrame.Angles(0, 0, math.pi / 2)
			ring.Parent = folder
			TweenService:Create(ring, TweenInfo.new(delay, Enum.EasingStyle.Linear), { Size = Vector3.new(0.2, 22, 22), Transparency = 0.8 }):Play()
			TweenService:Create(beam, TweenInfo.new(delay, Enum.EasingStyle.Linear), { Size = Vector3.new(2.2, 70, 2.2) }):Play()
			Debris:AddItem(beam, delay + 0.2)
			Debris:AddItem(ring, delay + 0.2)
		end
	end
	Sounds.Play("Flag", nil, 0.6, 1.2)
end

function KillstreakController.Init()
	local gui = UI.new("ScreenGui", {
		Name = "Killstreaks",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 2,
		Parent = player:WaitForChild("PlayerGui"),
	})
	strikeWidget = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -116, 1, -150),
		Size = UDim2.fromOffset(84, 34),
		BackgroundColor3 = Color3.fromRGB(150, 30, 30),
		Visible = false,
		Parent = gui,
	}, { UI.corner(10), UI.stroke(Color3.fromRGB(255, 200, 60), 2, 0), UI.gloss() })
	strikeLabel = UI.label({ Size = UDim2.fromScale(1, 1), Text = "✈ T", TextSize = 20, Parent = strikeWidget })
	radarLabel = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 92),
		Size = UDim2.fromOffset(220, 28),
		Text = "",
		TextSize = 22,
		TextColor3 = Color3.fromRGB(255, 110, 110),
		Visible = false,
		Parent = gui,
	})

	ContextActionService:BindAction("Airstrike", function(_, state)
		if state == Enum.UserInputState.Begin then
			callAirstrike()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.T, Enum.KeyCode.DPadRight)
	ContextActionService:SetTitle("Airstrike", "✈")
	ContextActionService:SetPosition("Airstrike", UDim2.new(1, -280, 1, -310))

	Remotes.AirstrikeMark.OnClientEvent:Connect(function(points, delay)
		if type(points) == "table" then
			markPoints(points, type(delay) == "number" and delay or 1.5)
		end
	end)

	task.spawn(function()
		while true do
			updateRadar()
			updateWidget()
			task.wait(0.25)
		end
	end)
end

return KillstreakController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">MainMenu</string>
              <string name="Source"><![CDATA[-- Pantalla de inicio: título del juego, cámara girando alrededor del mapa y botones.
-- Mientras está abierta el personaje no se mueve y es invulnerable (escudo del servidor).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")
local SocialService = game:GetService("SocialService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)
local Ranks = require(Shared.Ranks)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local Menu = require(script.Parent.Menu)
local WeaponIcon = require(script.Parent.WeaponIcon)
local Wheel = require(script.Parent.Wheel)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local MainMenu = {}

local gui, root, infoLabel, showcase, dailyButton, starterButton, wheelButton
local rankCard -- { Title, Fill, Next }: progreso hacia el siguiente rango
local blur
local titleScale
local orbitAngle = 0
local controls

local ORBIT_CENTER = Vector3.new(0, 8, 0)
local ORBIT_RADIUS = 150
local ORBIT_HEIGHT = 65

local function getControls()
	if controls then
		return controls
	end
	local ok, result = pcall(function()
		local playerModule = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
		return playerModule:GetControls()
	end)
	if ok then
		controls = result
	end
	return controls
end

local function orbit(dt)
	orbitAngle += dt * 0.06
	local position = ORBIT_CENTER + Vector3.new(math.cos(orbitAngle) * ORBIT_RADIUS, ORBIT_HEIGHT, math.sin(orbitAngle) * ORBIT_RADIUS)
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.lookAt(position, ORBIT_CENTER)
	camera.FieldOfView = 60
end

local function bigButton(text, color, order, parent)
	local button = UI.button({
		LayoutOrder = order,
		Size = UDim2.fromOffset(300, 58),
		Text = text,
		TextSize = 28,
		BackgroundColor3 = color,
		Parent = parent,
	}, { UI.stroke(Color3.new(0, 0, 0), 3, 0), UI.gloss() })
	button.TextStrokeTransparency = 0.5
	local scale = UI.new("UIScale", { Parent = button })
	button.MouseEnter:Connect(function()
		if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
			return -- en móvil MouseLeave casi nunca llega y el botón se quedaría grande
		end
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1.06 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1 }):Play()
	end)
	return button
end

local shownWeapon = nil

local function refreshInfo()
	local data = ClientState.Data
	if dailyButton then
		dailyButton.Visible = data ~= nil and data.DailyAvailable == true
	end
	if wheelButton then
		wheelButton.Text = (data and data.WheelFree) and "🎡  RULETA ¡GRATIS!" or "🎡  RULETA"
	end
	if starterButton then
		starterButton.Visible = data ~= nil and data.StarterPackAvailable == true
	end
	if infoLabel then
		infoLabel.Text = data and string.format("Nivel %d   ·   🪙 %d   ·   %d bajas", data.Level, data.Coins, data.TotalKills or 0)
			or "Cargando..."
	end
	if rankCard and data then
		local points = data.RankPoints or 0
		local tier = Ranks.Get(points)
		local fraction, nextTier = Ranks.Progress(points)
		rankCard.Title.Text = string.format('%s <font color="%s"><b>%s</b></font>  ·  %d RP', tier.Icon, UI.hex(tier.Color), string.upper(tier.Name), points)
		rankCard.Fill.Size = UDim2.fromScale(fraction, 1)
		rankCard.Fill.BackgroundColor3 = tier.Color
		if nextTier then
			local reward = nextTier.Reward or {}
			local prize = (reward.Coins and ("+" .. reward.Coins .. " 🪙") or "") .. (reward.Crates and ("  +" .. reward.Crates .. " 📦") or "")
			rankCard.Next.Text = string.format("Faltan %d RP para %s %s   %s", nextTier.Min - points, nextTier.Icon, nextTier.Name, prize)
		else
			rankCard.Next.Text = "¡Rango máximo!"
		end
	end
	-- Arma principal con la skin equipada, a la derecha (solo se rehace si cambia)
	if showcase and data and ClientState.InMainMenu then
		local primary = data.Primary or "ARX27"
		local key = primary .. "/" .. tostring(Menu.SkinFor(data, primary))
		if key ~= shownWeapon then
			shownWeapon = key
			showcase:ClearAllChildren()
			WeaponIcon.Create(primary, Menu.SkinFor(data, primary), { Size = UDim2.fromScale(1, 1), Parent = showcase }, "angled", 1.6)
		end
	end
end

-- Clasificación global (la publica el servidor en atributos como JSON)
-- Escala un bloque de la pantalla de inicio según el tamaño de la pantalla (móviles)
local function fitToScreen(frame)
	local uiScale = UI.new("UIScale", { Parent = frame })
	local function rescale()
		local viewport = camera.ViewportSize
		uiScale.Scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.45, 1)
	end
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()
end

local function buildLeaderboard(parent)
	local panel = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -20, 0, 20),
		Size = UDim2.fromOffset(330, 282),
		BackgroundColor3 = Color3.fromRGB(16, 18, 32),
		BackgroundTransparency = 0.2,
		Parent = parent,
	}, { UI.corner(14), UI.stroke(Color3.fromRGB(255, 200, 60), 2, 0.2) })
	-- Invitar amigos, justo debajo de la clasificación (cada amigo en el servidor da +10% de XP y
	-- monedas, ver Friends en el servidor)
	local invite = bigButton("👥  INVITAR AMIGOS  +10%", Color3.fromRGB(40, 170, 200), 0, panel)
	invite.Position = UDim2.new(0, 0, 1, 10)
	invite.Size = UDim2.new(1, 0, 0, 44)
	invite.TextSize = 22
	invite.Activated:Connect(function()
		Sounds.Play("Click")
		local ok, canInvite = pcall(SocialService.CanSendGameInviteAsync, SocialService, player)
		if ok and canInvite then
			pcall(SocialService.PromptGameInvite, SocialService, player)
		else
			invite.Text = "No puedes invitar desde aquí"
			task.delay(2, function()
				invite.Text = "👥  INVITAR AMIGOS  +10%"
			end)
		end
	end)
	fitToScreen(panel)
	UI.label({
		Position = UDim2.fromOffset(14, 6),
		Size = UDim2.new(1, -28, 0, 30),
		Text = "🏆 TOP",
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(255, 210, 60),
		Parent = panel,
	})
	local list = UI.new("Frame", {
		Position = UDim2.fromOffset(12, 44),
		Size = UDim2.new(1, -24, 1, -52),
		BackgroundTransparency = 1,
		Parent = panel,
	}, { UI.new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }) })

	local board = "Kills"
	local tabButtons = {}
	local function render()
		for _, child in list:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		for id, button in tabButtons do
			button.BackgroundColor3 = id == board and Color3.fromRGB(50, 130, 255) or Color3.fromRGB(45, 48, 70)
		end
		local raw = ReplicatedStorage:GetAttribute("Leaderboard_" .. board)
		local ok, rows = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		if type(raw) ~= "string" or not ok or type(rows) ~= "table" or #rows == 0 then
			UI.label({ Size = UDim2.new(1, 0, 0, 60), Text = "Aún no hay datos.\n¡Sé el primero!", TextSize = 18, TextWrapped = true, Parent = list })
			return
		end
		local medals = { "🥇", "🥈", "🥉" }
		for i, row in rows do
			local me = row.UserId == player.UserId
			local line = UI.new("Frame", {
				LayoutOrder = i,
				Size = UDim2.new(1, 0, 0, 21),
				BackgroundColor3 = me and Color3.fromRGB(120, 90, 20) or Color3.fromRGB(30, 32, 50),
				BackgroundTransparency = me and 0.1 or 0.5,
				Parent = list,
			}, { UI.corner(6) })
			UI.label({
				Position = UDim2.fromOffset(6, 0),
				Size = UDim2.fromOffset(34, 21),
				Text = medals[i] or ("#" .. tostring(row.Rank or i)),
				TextSize = 16,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = line,
			})
			UI.label({
				Position = UDim2.fromOffset(42, 0),
				Size = UDim2.new(1, -120, 1, 0),
				Text = tostring(row.Name or "?"),
				TextSize = 16,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextColor3 = me and Color3.fromRGB(255, 230, 120) or Color3.new(1, 1, 1),
				Parent = line,
			})
			UI.label({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -8, 0, 0),
				Size = UDim2.fromOffset(80, 21),
				Text = board == "Rank" and (Ranks.Get(tonumber(row.Value) or 0).Icon .. " " .. tostring(row.Value or 0))
					or tostring(row.Value or 0),
				TextSize = 16,
				TextXAlignment = Enum.TextXAlignment.Right,
				TextColor3 = Color3.fromRGB(255, 210, 60),
				Parent = line,
			})
		end
	end
	for i, info in { { "Kills", "Bajas" }, { "Wins", "Victorias" }, { "Rank", "Rango" } } do
		local button = UI.button({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12 - (3 - i) * 74, 0, 9),
			Size = UDim2.fromOffset(70, 26),
			Text = info[2],
			TextSize = 14,
			Parent = panel,
		})
		button.Activated:Connect(function()
			Sounds.Play("Click")
			board = info[1]
			render()
		end)
		tabButtons[info[1]] = button
	end
	render()
	ReplicatedStorage.AttributeChanged:Connect(function(name)
		if name == "Leaderboard_" .. board then
			render()
		end
	end)
end

-- Abre la pantalla de inicio: desenfoque, cámara girando, título que respira y controles bloqueados
local function openMenu()
	blur = blur or Instance.new("BlurEffect")
	blur.Name = "MainMenuBlur"
	blur.Size = 10
	blur.Parent = Lighting

	ClientState.InMainMenu = true
	UserInputService.MouseIconEnabled = true
	ClientState.UpdateMouse() -- oculta los botones táctiles del juego mientras está la pantalla de inicio
	RunService:BindToRenderStep("MainMenuOrbit", Enum.RenderPriority.Camera.Value + 2, orbit)

	-- El título "respira"
	task.spawn(function()
		while ClientState.InMainMenu do
			TweenService:Create(titleScale, TweenInfo.new(1.2, Enum.EasingStyle.Sine), { Scale = 1.04 }):Play()
			task.wait(1.2)
			TweenService:Create(titleScale, TweenInfo.new(1.2, Enum.EasingStyle.Sine), { Scale = 1 }):Play()
			task.wait(1.2)
		end
	end)

	-- Bloquea el movimiento del personaje mientras tanto
	task.spawn(function()
		local ctrl = getControls()
		if ctrl and ClientState.InMainMenu then
			ctrl:Disable()
		end
	end)
end

local function play()
	if not ClientState.InMainMenu then
		return
	end
	Sounds.Play("Click")
	Remotes.LeaveMenu:FireServer()
	TweenService:Create(root, TweenInfo.new(0.35), { GroupTransparency = 1 }):Play()
	showcase.Visible = false
	if blur then
		TweenService:Create(blur, TweenInfo.new(0.35), { Size = 0 }):Play()
	end
	task.delay(0.35, function()
		RunService:UnbindFromRenderStep("MainMenuOrbit")
		ClientState.InMainMenu = false
		gui.Enabled = false
		if blur then
			blur:Destroy()
			blur = nil
		end
		camera.CameraType = Enum.CameraType.Custom
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		-- (si ya estás en la pantalla de muerte, la cámara es suya: observando a un compañero)
		if humanoid and not ClientState.Dead then
			camera.CameraSubject = humanoid
		end
		local ctrl = getControls()
		if ctrl then
			ctrl:Enable()
		end
		ClientState.UpdateMouse()
	end)
end

-- "Volver al menú" (por ejemplo desde la pantalla de muerte)
function MainMenu.Show()
	if ClientState.InMainMenu or not gui then
		return
	end
	Remotes.EnterMenu:FireServer()
	gui.Enabled = true
	root.GroupTransparency = 0
	showcase.Visible = true
	openMenu()
	refreshInfo()
	ClientState.UpdateMouse()
end

function MainMenu.Init()
	gui = UI.new("ScreenGui", {
		Name = "MainMenu",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 4,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	root = UI.new("CanvasGroup", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	})

	-- Oscurecido a la izquierda para que se lea el texto
	UI.new("Frame", {
		Size = UDim2.fromScale(0.65, 1),
		BackgroundColor3 = Color3.fromRGB(10, 10, 25),
		BorderSizePixel = 0,
		Parent = root,
	}, {
		UI.new("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.15),
				NumberSequenceKeypoint.new(0.6, 0.5),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})

	-- Botón invisible "Modal": libera el ratón aunque la cámara sea en primera persona
	UI.new("TextButton", {
		Size = UDim2.fromOffset(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		Modal = true,
		Parent = root,
	})

	local left = UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 40, 0.5, 0),
		Size = UDim2.fromOffset(560, 520),
		BackgroundTransparency = 1,
		Parent = root,
	})
	fitToScreen(left)

	-- Título con degradado y borde grueso
	local title = UI.label({
		Size = UDim2.new(1, 0, 0, 110),
		Text = GameConfig.GameTitle,
		TextSize = 96,
		TextScaled = true,
		TextStrokeTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = left,
	}, {
		UI.new("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 230, 60)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 140, 30)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 70, 170)),
			}),
			Rotation = 90,
		}),
		UI.new("UIStroke", { Thickness = 6, Color = Color3.fromRGB(30, 10, 40) }),
	})
	titleScale = UI.new("UIScale", { Parent = title })

	UI.label({
		Position = UDim2.fromOffset(4, 112),
		Size = UDim2.new(1, 0, 0, 30),
		Text = "12 MAPAS  ·  6 MODOS  ·  17 ARMAS  ·  HABILIDADES",
		TextSize = 24,
		TextColor3 = Color3.fromRGB(200, 230, 255),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = left,
	})
	-- Novedades (late para llamar la atención)
	local news = UI.label({
		Position = UDim2.fromOffset(4, 142),
		Size = UDim2.new(1, 0, 0, 26),
		Text = "🎃 EVENTO DE HALLOWEEN · Mansión Encantada · 🆕 Eliminación · Katana",
		TextSize = 19,
		TextColor3 = Color3.fromRGB(255, 225, 90),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = left,
	})
	task.spawn(function()
		while news.Parent do
			TweenService:Create(news, TweenInfo.new(0.9, Enum.EasingStyle.Sine), { TextTransparency = 0.35 }):Play()
			task.wait(0.9)
			TweenService:Create(news, TweenInfo.new(0.9, Enum.EasingStyle.Sine), { TextTransparency = 0 }):Play()
			task.wait(0.9)
		end
	end)

	local buttons = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 182),
		Size = UDim2.fromOffset(300, 440),
		BackgroundTransparency = 1,
		Parent = left,
	}, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local playButton = bigButton("▶  JUGAR", Color3.fromRGB(60, 200, 90), 1, buttons)
	playButton.Size = UDim2.fromOffset(300, 70)
	playButton.TextSize = 36
	playButton.Activated:Connect(play)
	bigButton("⭐  PASE DE BATALLA", Color3.fromRGB(255, 130, 30), 2, buttons).Activated:Connect(function()
		Sounds.Play("Click")
		Menu.Open("Pase")
	end)
	bigButton("🔫  ARMAS Y TRAJES", Color3.fromRGB(50, 130, 255), 3, buttons).Activated:Connect(function()
		Sounds.Play("Click")
		Menu.Open("Armas")
	end)
	bigButton("🛒  TIENDA", Color3.fromRGB(190, 70, 255), 4, buttons).Activated:Connect(function()
		Sounds.Play("Click")
		Menu.Open("Tienda")
	end)

	-- Recompensa diaria (late mientras está disponible)
	dailyButton = bigButton("🎁  RECOMPENSA DIARIA", Color3.fromRGB(60, 200, 90), 5, buttons)
	dailyButton.Visible = false
	dailyButton.Activated:Connect(function()
		if Menu.ClaimDaily() then
			dailyButton.Visible = false
		end
	end)
	-- Pack de inicio para jugadores nuevos
	starterButton = bigButton("🔥  PACK DE INICIO", Color3.fromRGB(230, 70, 60), 6, buttons)
	starterButton.Visible = false
	starterButton.Activated:Connect(function()
		Sounds.Play("Click")
		Menu.Open("Tienda")
	end)
	-- Ruleta diaria (late mientras hay giro gratis)
	-- (debajo de la tarjeta de rango, para no alargar la columna de botones)
	wheelButton = bigButton("🎡  RULETA", Color3.fromRGB(255, 120, 40), 7, left)
	wheelButton.Position = UDim2.fromOffset(330, 298)
	wheelButton.Size = UDim2.fromOffset(230, 50)
	wheelButton.TextSize = 24
	wheelButton.Activated:Connect(function()
		Sounds.Play("Click")
		Wheel.Open()
	end)
		-- Los botones de regalo y oferta laten mientras están disponibles
	task.spawn(function()
		local scales = { dailyButton:FindFirstChildOfClass("UIScale"), starterButton:FindFirstChildOfClass("UIScale"), wheelButton:FindFirstChildOfClass("UIScale") }
		local buttonsList = { dailyButton, starterButton, wheelButton }
		-- (sigue vivo toda la sesión: al volver a la pantalla de inicio vuelven a latir)
		while gui.Parent do
			if not ClientState.InMainMenu then
				task.wait(0.5)
				continue
			end
			for i, button in buttonsList do
				-- (la ruleta solo late con giro gratis)
				local wheelReady = button ~= wheelButton or (ClientState.Data and ClientState.Data.WheelFree)
				if button.Visible and scales[i] and wheelReady then
					TweenService:Create(scales[i], TweenInfo.new(0.5, Enum.EasingStyle.Sine), { Scale = 1.06 }):Play()
				end
			end
			task.wait(0.5)
			for i in buttonsList do
				if scales[i] then
					TweenService:Create(scales[i], TweenInfo.new(0.5, Enum.EasingStyle.Sine), { Scale = 1 }):Play()
				end
			end
			task.wait(0.5)
		end
	end)

	infoLabel = UI.label({
		Position = UDim2.fromOffset(330, 175),
		Size = UDim2.new(1, 0, 0, 26),
		Text = "Cargando...",
		TextSize = 22,
		TextColor3 = Color3.fromRGB(255, 220, 120),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = left,
	})
	-- Rango competitivo: nombre, puntos y barra hasta el siguiente (con su premio)
	local card = UI.new("Frame", {
		Position = UDim2.fromOffset(330, 210),
		Size = UDim2.fromOffset(230, 78),
		BackgroundColor3 = Color3.fromRGB(16, 18, 32),
		BackgroundTransparency = 0.25,
		Parent = left,
	}, { UI.corner(12), UI.stroke(Color3.fromRGB(255, 255, 255), 1, 0.7) })
	local rankBar = UI.new("Frame", {
		Position = UDim2.fromOffset(10, 36),
		Size = UDim2.new(1, -20, 0, 10),
		BackgroundColor3 = Color3.fromRGB(40, 44, 70),
		Parent = card,
	}, { UI.corner(5) })
	rankCard = {
		Title = UI.label({
			Position = UDim2.fromOffset(10, 4),
			Size = UDim2.new(1, -20, 0, 28),
			Text = "",
			TextSize = 20,
			RichText = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		}),
		Fill = UI.new("Frame", { Size = UDim2.fromScale(0, 1), Parent = rankBar }, { UI.corner(5) }),
		Next = UI.label({
			Position = UDim2.fromOffset(10, 50),
			Size = UDim2.new(1, -20, 0, 22),
			Text = "",
			TextSize = 14,
			TextScaled = true,
			TextColor3 = Color3.fromRGB(200, 205, 225),
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		}),
	}
	UI.label({
		Position = UDim2.fromOffset(4, 150),
		Size = UDim2.new(1, 0, 0, 22),
		Text = "Clic izq. disparar · Clic der. apuntar · Shift correr · C deslizar · G granada · B menú",
		TextSize = 16,
		TextColor3 = Color3.fromRGB(190, 195, 215),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = left,
	})

	-- Escaparate del arma a la derecha (fuera del CanvasGroup para que el 3D se dibuje siempre)
	showcase = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -30, 1, -20),
		Size = UDim2.fromOffset(440, 260),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	fitToScreen(showcase)

	buildLeaderboard(root)

	openMenu()

	ClientState.DataChanged.Event:Connect(refreshInfo)
	refreshInfo()

	-- También se puede empezar con Enter / botón A del mando
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not ClientState.InMainMenu or Menu.IsOpen() then
			return
		end
		if input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.ButtonA then
			play()
		end
	end)
end

return MainMenu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">Menu</string>
              <string name="Source"><![CDATA[-- Menú principal del jugador (tecla B): perfil, pase de batalla, retos, armas, skins, trajes, efectos y tienda.
local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local MarketplaceService = game:GetService("MarketplaceService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Skins = require(Shared.Skins)
local Weapons = require(Shared.Weapons)
local Outfits = require(Shared.Outfits)
local Shop = require(Shared.Shop)
local Mastery = require(Shared.Mastery)
local KillEffects = require(Shared.KillEffects)
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)
local Ranks = require(Shared.Ranks)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local WeaponIcon = require(script.Parent.WeaponIcon)
local Effects = require(script.Parent.Effects)
local Settings = require(script.Parent.Settings)

local player = Players.LocalPlayer

local Menu = {}

local gui, panel, content, headerInfo, toast
local tabButtons = {}
local currentTab = "Pase"
local busy = false
local refresh -- reconstruye la pestaña actual (definida más abajo)

local GOLD = Color3.fromRGB(255, 190, 40)
local PANEL_BG = Color3.fromRGB(22, 24, 38)
local CARD_BG = Color3.fromRGB(38, 42, 64)
local GREEN = Color3.fromRGB(60, 170, 90)
local BLUE = Color3.fromRGB(40, 120, 255)
local GREY = Color3.fromRGB(70, 70, 82)

local TABS = { "Perfil", "Pase", "Retos", "Armas", "Skins", "Trajes", "Efectos", "Tienda", "Ajustes" }

local function rarityColor(rarity)
	return Skins.RarityColors[rarity] or Color3.new(1, 1, 1)
end

local function showToast(text, color)
	if not toast then
		return
	end
	toast.Text = text
	toast.TextColor3 = color or Color3.new(1, 1, 1)
	toast.Visible = true
	local token = {}
	toast:SetAttribute("T", tostring(token))
	task.delay(2.5, function()
		if toast:GetAttribute("T") == tostring(token) then
			toast.Visible = false
		end
	end)
end

local function coinsText(n)
	return "🪙 " .. tostring(n)
end

-- Skin con la que se ve un arma (camuflaje de maestría elegido o skin general)
local function skinFor(data, weaponName)
	local camo = data.WeaponCamos and data.WeaponCamos[weaponName]
	if camo and Mastery.HasCamo(data.WeaponKills and data.WeaponKills[weaponName] or 0, camo) then
		return camo
	end
	return data.EquippedSkin
end
Menu.SkinFor = skinFor

-- Barra de progreso sencilla
local function progressBar(parent, position, size, fraction, color)
	local bar = UI.new("Frame", {
		Position = position,
		Size = size,
		BackgroundColor3 = Color3.fromRGB(20, 22, 34),
		Parent = parent,
	}, { UI.corner(6) })
	UI.new("Frame", {
		Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1),
		BackgroundColor3 = color,
		Parent = bar,
	}, { UI.corner(6), UI.gloss() })
	return bar
end

local function scroller(layout)
	return UI.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		Parent = content,
	}, { layout })
end

local function buy(kind, id)
	if busy then
		return
	end
	busy = true
	Sounds.Play("Click")
	local ok, result, message = pcall(function()
		return Remotes.BuyItem:InvokeServer(kind, id)
	end)
	busy = false
	if ok and result then
		Sounds.Play("Kill")
		showToast(message or "¡Comprado!", GOLD)
	else
		showToast(ok and (message or "No se pudo comprar") or "Error de conexión", Color3.fromRGB(255, 90, 90))
	end
end

-- Maniquí R15 sencillo para previsualizar trajes
local function mannequin(outfitId)
	local model = Instance.new("Model")
	local skin = Color3.fromRGB(255, 204, 153)
	local legs = Color3.fromRGB(60, 60, 70)
	local torso = Color3.fromRGB(90, 120, 200)
	local parts = {
		{ "Head", Vector3.new(1.2, 1.2, 1.2), 0, 5.2, skin },
		{ "UpperTorso", Vector3.new(2, 1.6, 1), 0, 3.8, torso },
		{ "LowerTorso", Vector3.new(2, 0.4, 1), 0, 2.8, torso },
		{ "LeftUpperArm", Vector3.new(1, 1.2, 1), -1.5, 4.0, skin },
		{ "RightUpperArm", Vector3.new(1, 1.2, 1), 1.5, 4.0, skin },
		{ "LeftLowerArm", Vector3.new(1, 1.1, 1), -1.5, 2.85, skin },
		{ "RightLowerArm", Vector3.new(1, 1.1, 1), 1.5, 2.85, skin },
		{ "LeftHand", Vector3.new(1, 0.3, 1), -1.5, 2.15, skin },
		{ "RightHand", Vector3.new(1, 0.3, 1), 1.5, 2.15, skin },
		{ "LeftUpperLeg", Vector3.new(1, 1.2, 1), -0.5, 2.0, legs },
		{ "RightUpperLeg", Vector3.new(1, 1.2, 1), 0.5, 2.0, legs },
		{ "LeftLowerLeg", Vector3.new(1, 1.1, 1), -0.5, 0.85, legs },
		{ "RightLowerLeg", Vector3.new(1, 1.1, 1), 0.5, 0.85, legs },
		{ "LeftFoot", Vector3.new(1, 0.3, 1), -0.5, 0.15, legs },
		{ "RightFoot", Vector3.new(1, 0.3, 1), 0.5, 0.15, legs },
	}
	for _, spec in parts do
		local p = Instance.new("Part")
		p.Name = spec[1]
		p.Size = spec[2]
		p.CFrame = CFrame.new(spec[3], spec[4], 0)
		p.Color = spec[5]
		p.Anchored = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
	end
	local face = Instance.new("Part")
	face.Size = Vector3.new(0.6, 0.12, 0.05)
	face.CFrame = CFrame.new(0, 5.35, -0.62)
	face.Color = Color3.fromRGB(25, 25, 25)
	face.Anchored = true
	face.Parent = model
	Outfits.Apply(model, outfitId)
	return model
end

local function outfitViewport(outfitId, props)
	local viewport = UI.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(170, 170, 185),
		LightColor = Color3.new(1, 1, 1),
		LightDirection = Vector3.new(-1, -1.5, 1),
	})
	for k, v in props do
		viewport[k] = v
	end
	local model = mannequin(outfitId)
	model.Parent = viewport
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	camera.CFrame = CFrame.lookAt(Vector3.new(5, 4.6, -12), Vector3.new(0, 3, 0))
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	return viewport
end

---------------------------------------------------------------------------
-- Pestaña: Pase de batalla
---------------------------------------------------------------------------

local function rewardCard(reward, unlocked, premium, parent, order)
	local card = UI.new("Frame", {
		LayoutOrder = order,
		Size = UDim2.fromOffset(120, 116),
		BackgroundColor3 = CARD_BG,
		Parent = parent,
	}, { UI.corner(10), UI.stroke(premium and GOLD or Color3.fromRGB(90, 100, 140), 2, 0) })

	if not reward then
		UI.label({ Size = UDim2.fromScale(1, 1), Text = "—", TextSize = 30, TextTransparency = 0.5, Parent = card })
	elseif reward.Type == "Skin" then
		local skin = Skins.Get(reward.Id)
		WeaponIcon.Create(
			ClientState.Data and ClientState.Data.Primary or "ARX27",
			reward.Id,
			{ Position = UDim2.fromOffset(4, 4), Size = UDim2.fromOffset(112, 52), Parent = card },
			"angled",
			112 / 52
		)
		UI.label({ Position = UDim2.fromOffset(0, 58), Size = UDim2.new(1, 0, 0, 22), Text = skin.Name, TextSize = 17, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 80),
			Size = UDim2.new(1, 0, 0, 18),
			Text = skin.Rarity,
			TextSize = 14,
			TextColor3 = rarityColor(skin.Rarity),
			Parent = card,
		})
	elseif reward.Type == "Outfit" then
		local outfit = Outfits.Get(reward.Id)
		outfitViewport(reward.Id, { Position = UDim2.fromOffset(20, 2), Size = UDim2.fromOffset(80, 70), Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 74), Size = UDim2.new(1, 0, 0, 20), Text = outfit.Name, TextSize = 15, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 94),
			Size = UDim2.new(1, 0, 0, 16),
			Text = outfit.Rarity,
			TextSize = 13,
			TextColor3 = rarityColor(outfit.Rarity),
			Parent = card,
		})
	elseif reward.Type == "Crate" then
		UI.label({ Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 40), Text = "🎁", TextSize = 36, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 66), Size = UDim2.new(1, 0, 0, 24), Text = "Caja", TextSize = 18, Parent = card })
	else
		UI.label({ Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 40), Text = "🪙", TextSize = 34, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 62),
			Size = UDim2.new(1, 0, 0, 24),
			Text = tostring(reward.Amount),
			TextSize = 20,
			TextColor3 = GOLD,
			Parent = card,
		})
	end

	if reward then
		UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -4, 0, 2),
			Size = UDim2.fromOffset(24, 24),
			Text = unlocked and "✔" or "🔒",
			TextSize = 18,
			TextColor3 = unlocked and Color3.fromRGB(90, 230, 110) or Color3.new(1, 1, 1),
			ZIndex = 3,
			Parent = card,
		})
		if not unlocked then
			UI.new("Frame", {
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Color3.new(0, 0, 0),
				BackgroundTransparency = 0.5,
				ZIndex = 2,
				Parent = card,
			}, { UI.corner(10) })
		end
	end
	return card
end

local function buildPassPage(data)
	local page = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = content })
	local per = data.XPPerLevel or GameConfig.XPPerLevel
	UI.label({
		Size = UDim2.fromOffset(420, 26),
		Text = "Nivel " .. data.Level .. "  ·  " .. data.XP .. " / " .. per .. " XP",
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = page,
	})
	local bar = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.fromOffset(420, 12),
		BackgroundColor3 = Color3.fromRGB(10, 10, 15),
		Parent = page,
	}, { UI.corner(6) })
	UI.new("Frame", {
		Size = UDim2.fromScale(math.clamp(data.XP / per, 0, 1), 1),
		BackgroundColor3 = Color3.fromRGB(80, 170, 255),
		Parent = bar,
	}, { UI.corner(6), UI.gloss() })

	if data.Premium then
		UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 4),
			Size = UDim2.fromOffset(260, 34),
			Text = "👑 PREMIUM ACTIVO",
			TextSize = 22,
			TextColor3 = GOLD,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = page,
		})
	else
		local buyPass = UI.button({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 2),
			Size = UDim2.fromOffset(260, 40),
			Text = "👑 Obtener Premium",
			BackgroundColor3 = GOLD,
			TextColor3 = Color3.fromRGB(40, 25, 0),
			Parent = page,
		}, { UI.gloss() })
		buyPass.Activated:Connect(function()
			if GameConfig.PremiumPassId == 0 then
				showToast("Próximamente")
				return
			end
			MarketplaceService:PromptGamePassPurchase(player, GameConfig.PremiumPassId)
		end)
	end

	UI.label({ Position = UDim2.fromOffset(0, 98), Size = UDim2.fromOffset(70, 116), Text = "GRATIS", TextSize = 16, Parent = page })
	UI.label({
		Position = UDim2.fromOffset(0, 222),
		Size = UDim2.fromOffset(70, 116),
		Text = "PREMIUM",
		TextSize = 16,
		TextColor3 = GOLD,
		Parent = page,
	})

	local scroll = UI.new("ScrollingFrame", {
		Position = UDim2.fromOffset(74, 56),
		Size = UDim2.new(1, -74, 1, -56),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		Parent = page,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for tier, rewards in GameConfig.BattlePass do
		local reached = data.Level >= tier
		local column = UI.new("Frame", {
			LayoutOrder = tier,
			Size = UDim2.fromOffset(120, 280),
			BackgroundTransparency = 1,
			Parent = scroll,
		}, {
			UI.new("UIListLayout", {
				Padding = UDim.new(0, 8),
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		UI.label({
			LayoutOrder = 0,
			Size = UDim2.fromOffset(120, 26),
			Text = "NIVEL " .. tier,
			TextSize = 18,
			TextColor3 = reached and Color3.fromRGB(90, 230, 110) or Color3.fromRGB(180, 180, 190),
			Parent = column,
		})
		rewardCard(rewards.Free, reached, false, column, 1)
		rewardCard(rewards.Premium, reached and data.Premium, true, column, 2)
	end
end

---------------------------------------------------------------------------
-- Pestaña: Retos diarios
---------------------------------------------------------------------------

-- Perfil: rango, nivel, estadísticas de siempre, arma favorita y colección
local function buildProfilePage(data)
	local scroll = scroller(UI.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }))
	-- Rango y nivel
	local points = data.RankPoints or 0
	local tier = Ranks.Get(points)
	local fraction, nextTier = Ranks.Progress(points)
	local top = UI.new("Frame", { LayoutOrder = 1, Size = UDim2.new(1, -12, 0, 120), BackgroundColor3 = CARD_BG, Parent = scroll }, {
		UI.corner(12),
		UI.stroke(tier.Color, 2, 0.2),
	})
	UI.label({ Position = UDim2.fromOffset(12, 10), Size = UDim2.fromOffset(100, 100), Text = tier.Icon, TextSize = 72, Parent = top })
	UI.label({
		Position = UDim2.fromOffset(120, 12),
		Size = UDim2.new(1, -140, 0, 34),
		Text = string.upper(tier.Name) .. "   ·   " .. points .. " RP",
		TextSize = 30,
		TextColor3 = tier.Color,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = top,
	})
	progressBar(top, UDim2.fromOffset(120, 54), UDim2.new(1, -140, 0, 16), fraction, tier.Color)
	local nextText = "¡Rango máximo!"
	if nextTier then
		nextText = string.format("Faltan %d RP para %s %s", nextTier.Min - points, nextTier.Icon, nextTier.Name)
	end
	UI.label({
		Position = UDim2.fromOffset(120, 78),
		Size = UDim2.new(1, -140, 0, 26),
		Text = nextText .. "     ·     Nivel " .. data.Level .. (data.VIP and "  👑 VIP" or ""),
		TextSize = 18,
		TextColor3 = Color3.fromRGB(200, 205, 225),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = top,
	})

	-- Estadísticas
	local kills, deaths = data.TotalKills or 0, data.TotalDeaths or 0
	local matches, wins = data.Matches or 0, data.Wins or 0
	local stats = {
		{ "🎯", "Bajas", tostring(kills) },
		{ "💀", "Muertes", tostring(deaths) },
		{ "⚖", "K/D", string.format("%.2f", kills / math.max(1, deaths)) },
		{ "🏆", "Victorias", tostring(wins) },
		{ "🎮", "Partidas", tostring(matches) },
		{ "📈", "% victorias", matches > 0 and (math.floor(wins / matches * 100 + 0.5) .. "%") or "-" },
		{ "🔥", "Mejor racha", tostring(data.BestStreak or 0) },
		{ "🧠", "A la cabeza", tostring(data.Headshots or 0) },
	}
	local grid = UI.new("Frame", { LayoutOrder = 2, Size = UDim2.new(1, -12, 0, 170), BackgroundTransparency = 1, Parent = scroll }, {
		UI.new("UIGridLayout", { CellSize = UDim2.new(0.25, -8, 0, 80), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i, stat in stats do
		local cell = UI.new("Frame", { LayoutOrder = i, BackgroundColor3 = CARD_BG, Parent = grid }, { UI.corner(10) })
		UI.label({ Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 36), Text = stat[1] .. " " .. stat[3], TextSize = 28, Parent = cell })
		UI.label({ Position = UDim2.fromOffset(0, 48), Size = UDim2.new(1, 0, 0, 22), Text = stat[2], TextSize = 16, TextColor3 = Color3.fromRGB(170, 180, 215), Parent = cell })
	end

	-- Arma favorita (la de más bajas) y colección
	local favorite, favoriteKills = nil, 0
	for name, count in data.WeaponKills or {} do
		local def = Weapons.Get(name)
		if def and not def.Hidden and type(count) == "number" and count > favoriteKills then
			favorite, favoriteKills = name, count
		end
	end
	local bottom = UI.new("Frame", { LayoutOrder = 3, Size = UDim2.new(1, -12, 0, 130), BackgroundTransparency = 1, Parent = scroll })
	local favCard = UI.new("Frame", { Size = UDim2.new(0.5, -5, 1, 0), BackgroundColor3 = CARD_BG, Parent = bottom }, { UI.corner(12) })
	UI.label({ Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 24), Text = "⭐ ARMA FAVORITA", TextSize = 18, TextColor3 = GOLD, TextXAlignment = Enum.TextXAlignment.Left, Parent = favCard })
	if favorite then
		WeaponIcon.Create(favorite, skinFor(data, favorite), { Position = UDim2.fromOffset(10, 34), Size = UDim2.new(0.55, 0, 0, 86), Parent = favCard }, "angled", 2.2)
		UI.label({
			Position = UDim2.new(0.58, 0, 0, 44),
			Size = UDim2.new(0.42, -12, 0, 60),
			Text = Weapons.Get(favorite).DisplayName .. "\n" .. favoriteKills .. " bajas",
			TextSize = 20,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = favCard,
		})
	else
		UI.label({ Position = UDim2.fromOffset(14, 50), Size = UDim2.new(1, -28, 0, 40), Text = "¡Haz alguna baja para descubrirla!", TextSize = 18, Parent = favCard })
	end
	local function count(owned, list, skip)
		local have, total = 0, 0
		for id, item in list do
			if id ~= "Default" and not (skip and skip(item)) then
				total += 1
				if owned and owned[id] then
					have += 1
				end
			end
		end
		return have, total
	end
	local skinsHave, skinsTotal = count(data.Skins, Skins.List, function(skin)
		return skin.Mastery == true
	end)
	local outfitsHave, outfitsTotal = count(data.Outfits, Outfits.List)
	local effectsHave, effectsTotal = count(data.KillEffects, KillEffects.List)
	local collection = UI.new("Frame", { Position = UDim2.new(0.5, 5, 0, 0), Size = UDim2.new(0.5, -5, 1, 0), BackgroundColor3 = CARD_BG, Parent = bottom }, { UI.corner(12) })
	UI.label({ Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 24), Text = "🎒 COLECCIÓN", TextSize = 18, TextColor3 = GOLD, TextXAlignment = Enum.TextXAlignment.Left, Parent = collection })
	for i, row in { { "🎨 Skins", skinsHave, skinsTotal }, { "🦺 Trajes", outfitsHave, outfitsTotal }, { "💥 Efectos", effectsHave, effectsTotal } } do
		local y = 36 + (i - 1) * 30
		UI.label({ Position = UDim2.fromOffset(14, y), Size = UDim2.fromOffset(110, 22), Text = row[1], TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, Parent = collection })
		progressBar(collection, UDim2.fromOffset(124, y + 5), UDim2.new(1, -210, 0, 12), row[2] / math.max(1, row[3]), BLUE)
		UI.label({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, y), Size = UDim2.fromOffset(70, 22), Text = row[2] .. "/" .. row[3], TextSize = 16, TextXAlignment = Enum.TextXAlignment.Right, Parent = collection })
	end
end

local function buildChallengesPage(data)
	local info = data.Challenges
	local scroll = scroller(UI.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }))
	local secondsLeft = 86400 - os.time() % 86400
	UI.label({
		LayoutOrder = 0,
		Size = UDim2.new(1, -12, 0, 30),
		Text = string.format("RETOS DE HOY  ·  nuevos en %dh %02dm", secondsLeft // 3600, (secondsLeft % 3600) // 60),
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = GOLD,
		Parent = scroll,
	})
	if not info then
		return
	end
	for i, challenge in info.List do
		local card = UI.new("Frame", {
			LayoutOrder = i,
			Size = UDim2.new(1, -12, 0, 96),
			BackgroundColor3 = challenge.Done and Color3.fromRGB(34, 70, 50) or CARD_BG,
			Parent = scroll,
		}, { UI.corner(12), UI.stroke(challenge.Done and GREEN or Color3.fromRGB(90, 100, 140), 2, 0) })
		UI.label({
			Position = UDim2.fromOffset(16, 10),
			Size = UDim2.new(1, -260, 0, 28),
			Text = (challenge.Done and "✅ " or "🎯 ") .. challenge.Text,
			TextSize = 22,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		progressBar(card, UDim2.fromOffset(16, 50), UDim2.new(1, -300, 0, 14), challenge.Progress / challenge.Goal, challenge.Done and GREEN or BLUE)
		UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -270, 0, 66),
			Size = UDim2.fromOffset(140, 20),
			Text = challenge.Progress .. " / " .. challenge.Goal,
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = card,
		})
		UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -16, 0, 12),
			Size = UDim2.fromOffset(230, 26),
			Text = coinsText(challenge.Coins) .. "   +" .. challenge.XP .. " XP",
			TextSize = 20,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = GOLD,
			Parent = card,
		})
		if not challenge.Done and info.RerollsLeft > 0 then
			local reroll = UI.button({
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -16, 1, -10),
				Size = UDim2.fromOffset(150, 32),
				Text = "🔄 Cambiar reto",
				TextSize = 16,
				BackgroundColor3 = Color3.fromRGB(110, 80, 200),
				Parent = card,
			}, { UI.gloss() })
			reroll.Activated:Connect(function()
				if busy then
					return
				end
				busy = true
				Sounds.Play("Click")
				local ok, result = pcall(function()
					return Remotes.RerollChallenge:InvokeServer(i)
				end)
				busy = false
				if not (ok and result) then
					showToast("No se pudo cambiar el reto", Color3.fromRGB(255, 90, 90))
				end
			end)
		end
	end
	local done = 0
	for _, challenge in info.List do
		if challenge.Done then
			done += 1
		end
	end
	local bonus = UI.new("Frame", {
		LayoutOrder = 10,
		Size = UDim2.new(1, -12, 0, 70),
		BackgroundColor3 = info.Bonus and Color3.fromRGB(70, 60, 20) or Color3.fromRGB(50, 40, 70),
		Parent = scroll,
	}, { UI.corner(12), UI.stroke(GOLD, 2, info.Bonus and 0 or 0.5) })
	UI.label({
		Position = UDim2.fromOffset(16, 0),
		Size = UDim2.new(1, -32, 1, 0),
		Text = info.Bonus and "🎁 ¡Premio de hoy conseguido! Tienes una caja gratis en la Tienda"
			or ("🎁 Completa los " .. #info.List .. " retos (" .. done .. "/" .. #info.List .. ") y gana " .. info.BonusCrates .. " caja gratis"),
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = GOLD,
		Parent = bonus,
	})
	-- Evento de temporada: premios por caramelos (GameConfig.Event) con su vista previa
	local event = GameConfig.Event
	if event and event.Enabled and ReplicatedStorage:GetAttribute("EventName") then
		local candy = data.EventCandy or 0
		local card = UI.new("Frame", {
			LayoutOrder = 11,
			Size = UDim2.new(1, -12, 0, 214),
			BackgroundColor3 = Color3.fromRGB(50, 26, 66),
			Parent = scroll,
		}, { UI.corner(12), UI.stroke(Color3.fromRGB(255, 140, 30), 2, 0.1) })
		UI.label({
			Position = UDim2.fromOffset(16, 8),
			Size = UDim2.new(1, -32, 0, 28),
			Text = "🎃 EVENTO DE " .. string.upper(event.Name) .. "  ·  🍬 " .. math.min(candy, event.Goal) .. " / " .. event.Goal .. " caramelos",
			TextSize = 22,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.fromRGB(255, 170, 60),
			Parent = card,
		})
		UI.label({
			Position = UDim2.fromOffset(16, 34),
			Size = UDim2.new(1, -32, 0, 20),
			Text = "Recoge los caramelos que aparecen por el mapa durante las partidas",
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.fromRGB(210, 195, 230),
			Font = UI.FontBody,
			TextStrokeTransparency = 1,
			Parent = card,
		})
		progressBar(card, UDim2.fromOffset(16, 60), UDim2.new(1, -32, 0, 12), candy / event.Goal, Color3.fromRGB(255, 140, 30))
		-- Premios: los de por el camino y la skin final
		local prizes = {}
		for _, milestone in event.Milestones or {} do
			if milestone.Count < event.Goal then
				table.insert(prizes, milestone)
			end
		end
		table.insert(prizes, { Count = event.Goal, Skin = event.RewardSkin })
		local width = 1 / #prizes
		for i, prize in prizes do
			local got = candy >= prize.Count
			local cell = UI.new("Frame", {
				Position = UDim2.new(width * (i - 1), i == 1 and 16 or 6, 0, 82),
				Size = UDim2.new(width, i == 1 and -22 or -12, 0, 122),
				BackgroundColor3 = got and Color3.fromRGB(40, 80, 50) or CARD_BG,
				Parent = card,
			}, { UI.corner(10), UI.stroke(got and GREEN or Color3.fromRGB(110, 90, 140), 2, 0.2) })
			local preview = { Position = UDim2.fromOffset(4, 2), Size = UDim2.new(1, -8, 0, 78), Parent = cell }
			local title
			if prize.Outfit and Outfits.List[prize.Outfit] then
				outfitViewport(prize.Outfit, preview)
				title = "Traje " .. Outfits.List[prize.Outfit].Name
			elseif prize.Skin and Skins.List[prize.Skin] then
				WeaponIcon.Create(data.Primary or "ARX27", prize.Skin, preview, "angled", 2.2)
				title = "Skin " .. Skins.List[prize.Skin].Name
			else
				UI.label({ Position = UDim2.fromOffset(0, 14), Size = UDim2.new(1, 0, 0, 50), Text = "🪙", TextSize = 44, Parent = cell })
				title = coinsText(prize.Coins or 0)
			end
			UI.label({
				Position = UDim2.new(0, 4, 1, -42),
				Size = UDim2.new(1, -8, 0, 20),
				Text = title,
				TextSize = 15,
				TextScaled = true,
				Parent = cell,
			})
			UI.label({
				Position = UDim2.new(0, 4, 1, -22),
				Size = UDim2.new(1, -8, 0, 18),
				Text = got and "✅ Conseguido" or ("🍬 " .. prize.Count),
				TextSize = 15,
				TextColor3 = got and Color3.fromRGB(150, 255, 150) or Color3.fromRGB(255, 190, 90),
				Parent = cell,
			})
		end
	end
	UI.label({
		LayoutOrder = 12,
		Size = UDim2.new(1, -12, 0, 40),
		Text = "Consejo: cada arma tiene MAESTRÍA. Consigue bajas con ella para ganar camuflajes Carbono, Oro, Diamante y Materia oscura (pestaña Armas).",
		TextSize = 15,
		TextWrapped = true,
		TextColor3 = Color3.fromRGB(190, 195, 220),
		Font = UI.FontBody,
		TextStrokeTransparency = 1,
		Parent = scroll,
	})
end

