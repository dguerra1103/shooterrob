	refs.KillTitle = UI.label({
		Position = UDim2.fromOffset(70, 2),
		Size = UDim2.fromOffset(370, 34),
		Text = "",
		TextSize = 32,
		TextStrokeTransparency = 0,
		TextColor3 = Color3.fromRGB(255, 70, 70),
