          <Item class="ModuleScript" referent="138">
            <Properties>
              <string name="Name">AimAssist</string>
              <string name="Source"><![CDATA[-- Asistencia de apuntado (como en los shooters de móvil): con pantalla táctil o mando, si un enemigo
-- visible está cerca de la mira, la cámara se va hacia su pecho poco a poco (más al apuntar con la
-- mira) y, al empezar a apuntar con él cerca, da un pequeño "salto" hacia él. Nunca con ratón: ahí
-- apuntar es cosa de cada uno. Se puede bajar o quitar en Ajustes (Settings.AimAssist: 2 normal,
-- 1 suave, 0 no). WeaponController la llama cada fotograma justo después del retroceso.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))

local ClientState = require(script.Parent.ClientState)
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local AimAssist = {}

local player = Players.LocalPlayer

-- Cono de captura (grados) sin apuntar y apuntando, y cuánto del ángulo que falta se corrige por
-- segundo (fracción). El "salto" al empezar a apuntar corrige una parte en ~0,2 s.
AimAssist.HipCone = 5
AimAssist.AdsCone = 9
AimAssist.HipPull = 1.2
AimAssist.AdsPull = 3.2
AimAssist.SnapCone = 12
AimAssist.SnapPull = 9
AimAssist.SnapTime = 0.2

AimAssist.SnapCooldown = 0.8 -- (apuntar y desapuntar sin parar no vuelve a dar el salto)

local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude
local lastAds = 0
local snapUntil = 0
local lastSnap = -10

local GAMEPAD = {}
for i = 1, 8 do
	local ok, value = pcall(function()
		return (Enum.UserInputType :: any)["Gamepad" .. i]
	end)
	if ok and value then
		GAMEPAD[value] = true
	end
end

-- ¿Se está jugando con el dedo o con mando? (con ratón, nada)
function AimAssist.UsingAssistInput()
	local ok, last = pcall(function()
		return UserInputService:GetLastInputType()
	end)
	if ok and (last == Enum.UserInputType.Touch or GAMEPAD[last]) then
		return true
	end
	-- (móvil sin teclado aunque aún no haya tocado nada)
	return InputMode.TouchUI()
end

local function level()
	local settings = ClientState.Settings or GameConfig.DefaultSettings
	local value = settings.AimAssist
	if value == nil then
		value = 2
	end
	return math.floor(value + 0.5)
end

local function isEnemy(model)
	if model == player.Character then
		return false
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	-- (con la protección de aparición no se le puede herir: no tira de la mira)
	if model:FindFirstChildOfClass("ForceField") then
		return false
	end
	local teamMode = ReplicatedStorage:GetAttribute("TeamMode") ~= false
	local owner = Players:GetPlayerFromCharacter(model)
	if owner then
		return not (teamMode and player.Team ~= nil and owner.Team == player.Team)
	end
	if model:GetAttribute("Bot") then
		return not (teamMode and player.Team ~= nil and model:GetAttribute("Team") == player.Team.Name)
	end
	return false
end

local function candidates()
	local list = {}
	for _, other in Players:GetPlayers() do
		if other ~= player and other.Character then
			table.insert(list, other.Character)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			if model:IsA("Model") then
				table.insert(list, model)
			end
		end
	end
	return list
end

-- Lo que no tapa la vista: tú, la cámara, los efectos y las barandillas invisibles del mapa (lo
-- mismo que atraviesan las balas)
local function updateIgnore(camera)
	local ignore = { camera }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local fx = workspace:FindFirstChild("ClientFX")
	if fx then
		table.insert(ignore, fx)
	end
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	params.FilterDescendantsInstances = ignore
end

-- Punto del cuerpo al que tirar: el de su eje (de la cadera a la cabeza) a la altura por la que pasa
-- la mira. Si ya apuntas a la cabeza, se queda en la cabeza (no te la baja al pecho); si apuntas por
-- encima o por debajo, lo más cercano del cuerpo.
local function aimPoint(model, origin, look)
	local center = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart")
	if not center or not center:IsA("BasePart") then
		return nil
	end
	local head = model:FindFirstChild("Head")
	local top = (head and head:IsA("BasePart")) and head.Position.Y or center.Position.Y + 1.5
	local bottom = center.Position.Y - 1.2
	local position = center.Position
	local flatLook = Vector3.new(look.X, 0, look.Z)
	local flatDistance = Vector3.new(position.X - origin.X, 0, position.Z - origin.Z).Magnitude
	if flatLook.Magnitude < 0.05 then
		return position
	end
	local rayHeight = origin.Y + look.Y / flatLook.Magnitude * flatDistance
	return Vector3.new(position.X, math.clamp(rayHeight, math.min(bottom, top), top), position.Z)
end

-- Mejor objetivo dentro del cono: { Model, Point, Angle } o nil
function AimAssist.FindTarget(camera, coneDegrees, range)
	local cf = camera.CFrame
	local origin = cf.Position
	local look = cf.LookVector
	local cone = math.rad(coneDegrees)
	local best
	local ignoreReady = false
	for _, model in candidates() do
		if isEnemy(model) then
			local point = aimPoint(model, origin, look)
			if point then
				local offset = point - origin
				local distance = offset.Magnitude
				if distance > 1 and distance <= range then
					local angle = math.acos(math.clamp(look:Dot(offset / distance), -1, 1))
					if angle < cone and (not best or angle < best.Angle) then
						-- (que se vea: nada de imanes a través de las paredes)
						if not ignoreReady then
							updateIgnore(camera)
							ignoreReady = true
						end
						local hit = workspace:Raycast(origin, offset, params)
						if not hit or hit.Instance:IsDescendantOf(model) then
							best = { Model = model, Point = point, Angle = angle }
						end
					end
				end
			end
		end
	end
	return best
end

-- Gira la cámara una fracción hacia el punto (en su propio espacio: arriba/abajo e izquierda/derecha).
-- Devuelve el giro aplicado (cabeceo, guiñada; positivo = arriba / izquierda)
local function turnToward(camera, point, fraction)
	local direction = (point - camera.CFrame.Position).Unit
	local localDir = camera.CFrame:VectorToObjectSpace(direction)
	local yaw = math.atan2(-localDir.X, -localDir.Z)
	local pitch = math.atan2(localDir.Y, math.sqrt(localDir.X * localDir.X + localDir.Z * localDir.Z))
	camera.CFrame = camera.CFrame * CFrame.Angles(pitch * fraction, yaw * fraction, 0)
	return pitch * fraction, yaw * fraction
end

-- Devuelve el objetivo (o nil) y el giro aplicado (cabeceo, guiñada): WeaponController lo descuenta de
-- la recuperación del retroceso (si no, al soltar la mira bajaría de más)
function AimAssist.Update(dt)
	local camera = workspace.CurrentCamera
	local def = ClientState.CurrentDef
	local strength = level()
	local ads = ClientState.AimAlpha or 0
	local startedAiming = ads > 0.1 and lastAds <= 0.1
	lastAds = ads
	if not camera or strength <= 0 or not def or def.Type ~= "Gun" or ClientState.Dead or ClientState.IsBlocked() then
		return nil, 0, 0
	end
	-- (bailando un emote, la cámara es de tercera persona; corriendo no se apunta)
	if ClientState.Emoting or ClientState.Sprinting then
		return nil, 0, 0
	end
	if not AimAssist.UsingAssistInput() then
		return nil, 0, 0
	end
	local scale = strength == 1 and 0.5 or 1
	local range = def.Range or 300
	local now = os.clock()
	if startedAiming and now - lastSnap >= AimAssist.SnapCooldown then
		snapUntil = now + AimAssist.SnapTime
		lastSnap = now
	end
	local snapping = os.clock() < snapUntil
	local cone = snapping and AimAssist.SnapCone or (AimAssist.HipCone + (AimAssist.AdsCone - AimAssist.HipCone) * ads)
	local target = AimAssist.FindTarget(camera, cone, range)
	if not target then
		return nil, 0, 0
	end
	local pull = snapping and AimAssist.SnapPull or (AimAssist.HipPull + (AimAssist.AdsPull - AimAssist.HipPull) * ads)
	-- (más fuerte cuanto más cerca de la mira; en el borde del cono casi nada)
	local closeness = 1 - target.Angle / math.rad(cone)
	local fraction = math.clamp(pull * scale * closeness * dt, 0, 0.5)
	local pitch, yaw = turnToward(camera, target.Point, fraction)
	return target, pitch, yaw
end

return AimAssist
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="139">
            <Properties>
              <string name="Name">AimFX</string>
              <string name="Source"><![CDATA[-- Apuntar con realismo: al apuntar con la mira, los bordes de la pantalla se oscurecen suavemente,
-- como al mirar por el arma. Solo en este cliente; con la mira telescópica puesta no hace falta (la
-- tapa el visor).
--
-- Profundidad de campo (DOF): NUNCA en partida por defecto (Fase 3: en combate todo enemigo debe verse
-- nítido, esté a la distancia que esté). El desenfoque al apuntar sigue disponible con
-- GameConfig.AimDepthOfField = true (enfocado a la distancia del punto de mira; no en calidad Baja), y
-- el desenfoque lejano de calidad Ultra (QualityDOF, de Settings) solo se ve en los menús.
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ClientState = require(script.Parent.ClientState)
local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))

local AimFX = {}

-- desenfoque del fondo con la mira del todo puesta (0 = nada, 1 = mucho). Por debajo de 0,22: ahí el
-- desenfoque de Roblox da un salto brusco (y aparecería de golpe en vez de poco a poco)
local MAX_BLUR = 0.2
local MAX_FOCUS = 200 -- (lo máximo que admite FocusDistance)
local MAX_RADIUS = 50 -- (lo máximo que admite InFocusRadius)
local MAX_VIGNETTE = 0.38 -- oscuridad de los bordes

local dof, gui
local edges = {}
local focus = 60
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude

-- Distancia a lo que hay bajo la mira. No cuentan las barandillas invisibles del mapa (las balas las
-- atraviesan) ni los cristales: se enfoca a lo que hay detrás
local function focusTarget(camera)
	local ignore = { camera }
	local character = Players.LocalPlayer.Character
	if character then
		table.insert(ignore, character)
	end
	local fx = workspace:FindFirstChild("ClientFX")
	if fx then
		table.insert(ignore, fx)
	end
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	local origin = camera.CFrame.Position
	local direction = camera.CFrame.LookVector * 300
	for _ = 1, 3 do
		params.FilterDescendantsInstances = ignore
		local hit = workspace:Raycast(origin, direction, params)
		if not hit then
			return MAX_FOCUS
		end
		if hit.Instance.Transparency < 0.3 then
			return (hit.Position - origin).Magnitude
		end
		table.insert(ignore, hit.Instance)
	end
	return MAX_FOCUS
end

local function buildVignette()
	gui = Instance.new("ScreenGui")
	gui.Name = "AimVignette"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = -1 -- (debajo del HUD)
	-- (velo a pantalla completa, sin nada que tocar: también por detrás de la muesca del teléfono)
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.None
		gui.ClipToDeviceSafeArea = false
	end)
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local specs = {
		{ Vector2.new(0.5, 0), UDim2.fromScale(0.5, 0), UDim2.fromScale(1, 0.3), 90 },
		{ Vector2.new(0.5, 1), UDim2.fromScale(0.5, 1), UDim2.fromScale(1, 0.3), -90 },
		{ Vector2.new(0, 0.5), UDim2.fromScale(0, 0.5), UDim2.fromScale(0.25, 1), 0 },
		{ Vector2.new(1, 0.5), UDim2.fromScale(1, 0.5), UDim2.fromScale(0.25, 1), 180 },
	}
	for i, spec in specs do
		local frame = Instance.new("Frame")
		frame.Name = "Edge" .. i
		frame.AnchorPoint = spec[1]
		frame.Position = spec[2]
		frame.Size = spec[3]
		frame.BorderSizePixel = 0
		frame.BackgroundColor3 = Color3.new(0, 0, 0)
		frame.BackgroundTransparency = 1
		local gradient = Instance.new("UIGradient")
		gradient.Rotation = spec[4]
		gradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.7, 0.9),
			NumberSequenceKeypoint.new(1, 1),
		})
		gradient.Parent = frame
		frame.Parent = gui
		edges[i] = frame
	end
end

local function ensureDof(camera)
	if dof and dof.Parent == camera then
		return dof
	end
	if dof then
		dof:Destroy()
	end
	dof = Instance.new("DepthOfFieldEffect")
	dof.Name = "AimDepthOfField"
	dof.NearIntensity = 0
	dof.FarIntensity = 0
	dof.FocusDistance = 60
	dof.InFocusRadius = 30
	dof.Enabled = false
	dof.Parent = camera
	return dof
end

function AimFX.Update(dt)
	dt = dt or 1 / 60
	local camera = workspace.CurrentCamera
	if not camera or not gui then
		return
	end
	local alpha = ClientState.AimAlpha or 0
	local def = ClientState.CurrentDef
	-- (con el visor de francotirador puesto lo tapa todo el visor)
	local scoped = def ~= nil and def.Scope == true and alpha > 0.85
	local active = alpha > 0.02 and not scoped and not ClientState.InMainMenu and not ClientState.Dead
		and not ClientState.ReducedFX()
	local low = ClientState.EffectiveQuality == "Baja"

	-- Desenfoque lejano de Ultra: solo en los menús (en partida apagado siempre)
	local quality = Lighting:FindFirstChild("QualityDOF")
	if quality and quality:IsA("DepthOfFieldEffect") then
		local wanted = ClientState.EffectiveQuality == "Ultra" and ClientState.InMainMenu == true
		if quality.Enabled ~= wanted then
			quality.Enabled = wanted
		end
	end

	-- Viñeta: bordes algo más oscuros al apuntar
	local edgeTransparency = active and (1 - MAX_VIGNETTE * alpha) or 1
	for _, edge in edges do
		edge.BackgroundTransparency = edgeTransparency
	end

	local effect = ensureDof(camera)
	if not active or low or not GameConfig.AimDepthOfField then
		effect.Enabled = false
		return
	end
	-- Enfoque a lo que hay bajo la mira (suave, como el ojo)
	local target = math.clamp(focusTarget(camera), 6, MAX_FOCUS)
	focus += (target - focus) * math.min(1, dt * 8)
	effect.Enabled = true
	effect.FocusDistance = math.min(focus, MAX_FOCUS)
	effect.InFocusRadius = math.clamp(focus * 0.45, 10, MAX_RADIUS)
	effect.FarIntensity = MAX_BLUR * alpha
	effect.NearIntensity = 0
end

function AimFX.Init()
	buildVignette()
	RunService.RenderStepped:Connect(function(dt)
		local ok, err = pcall(AimFX.Update, dt)
		if not ok then
			warn("[AimFX]", err)
		end
	end)
end

return AimFX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="140">
            <Properties>
              <string name="Name">AimPitch</string>
              <string name="Source"><![CDATA[-- Manda al servidor hacia dónde miras arriba/abajo (unas pocas veces por segundo y solo si cambia), para
-- que los demás te vean apuntar con el arma inclinada (RiflePose, en sus clientes)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Remotes)
local ClientState = require(script.Parent.ClientState)

local AimPitch = {}

AimPitch.Interval = 0.2 -- segundos entre envíos
AimPitch.Threshold = 0.05 -- cambio mínimo (radianes, unos 3°) para mandarlo

local player = Players.LocalPlayer
local clock = 0
local lastSent = 0

function AimPitch.Current()
	local camera = workspace.CurrentCamera
	if not camera then
		return 0
	end
	return math.asin(math.clamp(camera.CFrame.LookVector.Y, -1, 1))
end

function AimPitch.Update(dt)
	clock += dt
	if clock < AimPitch.Interval then
		return
	end
	clock = 0
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or ClientState.InMainMenu or ClientState.Dead or ClientState.KillcamActive then
		return
	end
	local pitch = AimPitch.Current()
	if math.abs(pitch - lastSent) >= AimPitch.Threshold then
		lastSent = pitch
		Remotes.AimPitch:FireServer(pitch)
	end
end

function AimPitch.Init()
	RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(AimPitch.Update, dt)
		if not ok then
			warn("[AimPitch]", err)
		end
	end)
	-- (personaje nuevo: se vuelve a mandar aunque mire igual)
	player.CharacterAdded:Connect(function()
		lastSent = 1000
	end)
end

return AimPitch
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="141">
            <Properties>
              <string name="Name">Ambience</string>
              <string name="Source"><![CDATA[-- Sonido ambiente de los mapas realistas (atributo Ambience de workspace.Map, lo pone cada mapa):
--   "War": explosiones y ráfagas lejanas, como una guerra en otros barrios, y algo de viento
--   "Base" (Construction, Terminal): disparos sueltos a lo lejos y brisa
--   "Wind" (Rooftop District): viento fuerte de altura
--   y en los demás mapas: "Breeze" (brisa), "Snow" (viento helado), "Coast" (brisa y olas que rompen),
--   "Night" (viento suave de noche), "Jungle", "Factory" (nave: casi nada, eco de nave) y "Desert"
-- Y el tiempo (atributo Weather de workspace.Map): "Rain" = lluvia alrededor de la cámara, ruido de
-- lluvia y, de vez en cuando, un relámpago (destello) y el trueno un par de segundos después.
-- Todo con sonidos que vienen con Roblox, apagados (filtro de graves) para que suenen lejos. Solo
-- durante la partida y nunca en la pantalla de inicio.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local ClientState = require(script.Parent.ClientState)

local Ambience = {}

local WIND_ID = "rbxasset://sounds/action_falling.mp3"
local BOOM_ID = "rbxasset://sounds/Rocket shot.wav"
local SHOT_ID = "rbxasset://sounds/paintball.wav"
local WAVE_ID = "rbxasset://sounds/impact_water.mp3"

local PRESETS = {
	War = { Wind = 0.12, WindSpeed = 0.55, Booms = { 9, 22 }, Bursts = { 4, 11 } },
	Base = { Wind = 0.07, WindSpeed = 0.5, Booms = nil, Bursts = { 6, 16 } },
	Wind = { Wind = 0.4, WindSpeed = 0.42, Booms = nil, Bursts = nil },
	Breeze = { Wind = 0.06, WindSpeed = 0.5 },
	Snow = { Wind = 0.22, WindSpeed = 0.45 },
	Coast = { Wind = 0.1, WindSpeed = 0.55, Waves = { 5, 10 } },
	Night = { Wind = 0.12, WindSpeed = 0.38 },
	Jungle = { Wind = 0.07, WindSpeed = 0.62 },
	Factory = { Wind = 0.03, WindSpeed = 0.3 },
	Desert = { Wind = 0.16, WindSpeed = 0.5 },
}

local group, wind
local nextBoom, nextBurst, nextWave = 0, 0, 0
local rainBox, rainSound, rainConnection
local nextThunder = 0

-- Grupo con filtro de graves y un poco de eco: todo suena lejano
local function ensureGroup()
	if group and group.Parent then
		return group
	end
	group = Instance.new("SoundGroup")
	group.Name = "Ambiente"
	group.Volume = 1
	local eq = Instance.new("EqualizerSoundEffect")
	eq.HighGain = -28
	eq.MidGain = -8
	eq.LowGain = 3
	eq.Parent = group
	local reverb = Instance.new("ReverbSoundEffect")
	reverb.DecayTime = 2.2
	reverb.WetLevel = -6
	reverb.Parent = group
	group.Parent = SoundService
	return group
end

local function oneShot(id, volume, speed)
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume
	sound.PlaybackSpeed = speed
	sound.SoundGroup = ensureGroup()
	sound.Parent = SoundService
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	task.delay(6, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
end

-- Ráfaga lejana: 3 a 7 disparos seguidos con la cadencia de un fusil
local function burst()
	local shots = math.random(3, 7)
	local speed = 0.55 + math.random() * 0.25
	local volume = 0.05 + math.random() * 0.06
	task.spawn(function()
		for _ = 1, shots do
			oneShot(SHOT_ID, volume, speed * (0.95 + math.random() * 0.1))
			task.wait(0.08 + math.random() * 0.05)
		end
	end)
end

local function current()
	if ClientState.InMainMenu or ReplicatedStorage:GetAttribute("State") == "Intermission" then
		return nil
	end
	local map = workspace:FindFirstChild("Map")
	local kind = map and map:GetAttribute("Ambience")
	return kind and PRESETS[kind] or nil
end

-- Lluvia: una caja invisible encima de la cámara que la sigue y suelta gotas rápidas y alargadas
local function startRain()
	if rainBox and rainBox.Parent then
		return
	end
	rainBox = Instance.new("Part")
	rainBox.Name = "RainBox"
	rainBox.Anchored = true
	rainBox.CanCollide = false
	rainBox.CanQuery = false
	rainBox.CanTouch = false
	rainBox.Transparency = 1
	rainBox.Size = Vector3.new(70, 1, 70)
	local drops = Instance.new("ParticleEmitter")
	drops.Name = "Drops"
	drops.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	drops.Color = ColorSequence.new(Color3.fromRGB(200, 210, 225))
	drops.LightInfluence = 1
	drops.Transparency = NumberSequence.new(0.45)
	drops.Size = NumberSequence.new(0.09)
	drops.Squash = NumberSequence.new(-2.5) -- (gotas alargadas en la dirección en la que caen)
	drops.Orientation = Enum.ParticleOrientation.VelocityParallel
	drops.Lifetime = NumberRange.new(0.55, 0.7)
	drops.Speed = NumberRange.new(85, 100)
	drops.SpreadAngle = Vector2.new(4, 4)
	drops.EmissionDirection = Enum.NormalId.Bottom
	drops.Rate = 650
	drops.Shape = Enum.ParticleEmitterShape.Box
	drops.Parent = rainBox
	rainBox.Parent = workspace.CurrentCamera or workspace
	rainSound = Instance.new("Sound")
	rainSound.Name = "AmbienceRain"
	rainSound.SoundId = WIND_ID
	rainSound.Looped = true
	rainSound.Volume = 0.22
	rainSound.PlaybackSpeed = 1.45 -- (el viento acelerado suena como lluvia)
	rainSound.SoundGroup = ensureGroup()
	rainSound.Parent = SoundService
	rainSound:Play()
	rainConnection = RunService.Heartbeat:Connect(function()
		local camera = workspace.CurrentCamera
		if camera and rainBox then
			local p = camera.CFrame.Position
			rainBox.CFrame = CFrame.new(p.X, p.Y + 40, p.Z)
		end
	end)
end

local function stopRain()
	if rainConnection then
		rainConnection:Disconnect()
		rainConnection = nil
	end
	if rainBox then
		rainBox:Destroy()
		rainBox = nil
	end
	if rainSound then
		rainSound:Destroy()
		rainSound = nil
	end
end

-- Relámpago: la escena se ilumina de golpe un instante y el trueno llega después
local function lightning()
	local before = Lighting.ExposureCompensation
	Lighting.ExposureCompensation = before + 1.6
	task.delay(0.08, function()
		Lighting.ExposureCompensation = before + 0.4
		task.wait(0.06)
		Lighting.ExposureCompensation = before + 1.1
		task.wait(0.1)
		Lighting.ExposureCompensation = before
	end)
	task.delay(1 + math.random() * 2, function()
		oneShot(BOOM_ID, 0.45, 0.22 + math.random() * 0.06)
	end)
end

-- Eco del sitio (SoundService.AmbientReverb, afecta a todos los sonidos): dentro de un edificio los
-- disparos retumban como en una habitación; fuera, según el mapa (ciudad, montaña, campo abierto)
local OUTDOOR_REVERB = {
	War = Enum.ReverbType.City,
	Base = Enum.ReverbType.Plain,
	Wind = Enum.ReverbType.Mountains,
	Snow = Enum.ReverbType.Mountains,
	Jungle = Enum.ReverbType.Forest,
	Factory = Enum.ReverbType.Hangar,
}
local reverbParams = RaycastParams.new()
reverbParams.FilterType = Enum.RaycastFilterType.Include
local function updateReverb(map, preset)
	local reverb = Enum.ReverbType.NoReverb
	local camera = workspace.CurrentCamera
	if map and camera and not ClientState.InMainMenu then
		reverb = (preset and OUTDOOR_REVERB[map:GetAttribute("Ambience")]) or Enum.ReverbType.Plain
		-- ¿Bajo techo? (y no es el techo invisible del límite del mapa)
		reverbParams.FilterDescendantsInstances = { map }
		local roof = workspace:Raycast(camera.CFrame.Position, Vector3.new(0, 30, 0), reverbParams)
		local boundary = map:FindFirstChild("Boundary")
		if roof and not (boundary and roof.Instance:IsDescendantOf(boundary)) and roof.Instance.Name ~= "Boundary" then
			-- (y con paredes alrededor: bajo un árbol o un toldo sigue siendo la calle)
			local walls = 0
			local origin = camera.CFrame.Position
			for _, direction in { Vector3.new(24, 0, 0), Vector3.new(-24, 0, 0), Vector3.new(0, 0, 24), Vector3.new(0, 0, -24) } do
				local hit = workspace:Raycast(origin, direction, reverbParams)
				if hit and not (boundary and hit.Instance:IsDescendantOf(boundary)) then
					walls += 1
				end
			end
			if walls >= 2 then
				reverb = roof.Distance < 14 and Enum.ReverbType.Room or Enum.ReverbType.Hallway
			end
		end
	end
	if SoundService.AmbientReverb ~= reverb then
		SoundService.AmbientReverb = reverb
	end
	Ambience.Reverb = reverb
end

-- Suelo mojado con lluvia: el suelo al aire libre (piedra, asfalto, madera, metal...) se oscurece un
-- poco y brilla, y el terreno (hierba, tierra, roca) se oscurece; al parar, todo vuelve. Se reparte en
-- varios fotogramas para no dar un tirón
local WET_MATERIALS = {} -- (por nombre del material)
for _, name in {
	"Concrete", "Asphalt", "Pavement", "Slate", "Cobblestone", "Brick", "Granite", "Marble", "Basalt", "Limestone",
	"Sandstone", "Plastic", "SmoothPlastic", "Metal", "DiamondPlate", "CorrodedMetal", "Wood", "WoodPlanks",
	"CeramicTiles", "ClayRoofTiles", "Rock",
} do
	WET_MATERIALS[name] = true
end
local WET_TERRAIN = { "Grass", "LeafyGrass", "Ground", "Mud", "Sand", "Rock", "Asphalt", "Concrete", "Pavement", "Slate", "Cobblestone", "Brick" }
local wetMap = nil -- mapa mojado ahora mismo
local wetParts = {} -- [pieza] = { color, brillo } de antes
local wetTerrain = {} -- [material] = { color de antes, color mojado }
local wetParams = RaycastParams.new()
wetParams.FilterType = Enum.RaycastFilterType.Include

local function dry(sameMap)
	for part, saved in wetParts do
		if part.Parent then
			part.Color = saved[1]
			part.Reflectance = saved[2]
		end
	end
	table.clear(wetParts)
	-- (si ya es otro mapa y el servidor puso colores nuevos, no se tocan; si puso los mismos de antes,
	-- no llega nada al cliente y siguen los mojados: esos sí se devuelven)
	for material, saved in wetTerrain do
		pcall(function()
			local now = workspace.Terrain:GetMaterialColor(material)
			local untouched = math.abs(now.R - saved[2].R) + math.abs(now.G - saved[2].G) + math.abs(now.B - saved[2].B) < 0.01
			if sameMap or untouched then
				workspace.Terrain:SetMaterialColor(material, saved[1])
			end
		end)
	end
	table.clear(wetTerrain)
	wetMap = nil
end

local function wet(map)
	wetMap = map
	for _, name in WET_TERRAIN do
		pcall(function()
			local material = (Enum.Material :: any)[name]
			local color = workspace.Terrain:GetMaterialColor(material)
			local darker = color:Lerp(Color3.new(0, 0, 0), 0.2)
			wetTerrain[material] = { color, darker }
			workspace.Terrain:SetMaterialColor(material, darker)
		end)
	end
	task.spawn(function()
		local boundary = map:FindFirstChild("Boundary")
		wetParams.FilterDescendantsInstances = { map }
		local count = 0
		for _, part in map:GetDescendants() do
			if wetMap ~= map then
				return -- (dejó de llover o cambió el mapa)
			end
			if part:IsA("BasePart") and WET_MATERIALS[part.Material.Name] and part.Transparency < 0.5
				and part.Size.Y <= 3 and part.CFrame.UpVector.Y > 0.9 and not wetParts[part]
				and not (boundary and part:IsDescendantOf(boundary)) then
				-- (solo lo que está al aire libre: bajo techo no llueve)
				local top = part.Position + Vector3.new(0, part.Size.Y / 2 + 0.1, 0)
				local roof = workspace:Raycast(top, Vector3.new(0, 60, 0), wetParams)
				if not roof or (boundary and roof.Instance:IsDescendantOf(boundary)) then
					wetParts[part] = { part.Color, part.Reflectance }
					part.Color = part.Color:Lerp(Color3.new(0, 0, 0), 0.18)
					part.Reflectance = math.max(part.Reflectance, 0.07)
				end
			end
			count += 1
			if count % 250 == 0 then
				task.wait()
			end
		end
	end)
end

-- (para las pruebas)
function Ambience.WetParts()
	return wetParts
end

function Ambience.Update()
	local preset = current()
	local map = workspace:FindFirstChild("Map")
	pcall(updateReverb, map, preset)
	local raining = preset ~= nil and map ~= nil and map:GetAttribute("Weather") == "Rain"
	-- Suelo mojado (y seco otra vez al parar o al cambiar de mapa)
	if wetMap and (wetMap ~= map or not raining) then
		dry(wetMap == map)
	end
	if raining and wetMap ~= map and map then
		wet(map)
	end
	if raining then
		startRain()
		-- Bajo techo no caen gotas (seguirían atravesando el tejado); en calidad Baja, menos gotas
		local drops = rainBox and rainBox:FindFirstChild("Drops")
		local camera = workspace.CurrentCamera
		if drops and drops:IsA("ParticleEmitter") and camera then
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Include
			params.FilterDescendantsInstances = { map }
			local roof = workspace:Raycast(camera.CFrame.Position, Vector3.new(0, 60, 0), params)
			-- (el techo invisible del límite del mapa no cuenta como tejado)
			local boundary = map:FindFirstChild("Boundary")
			if roof and boundary and roof.Instance:IsDescendantOf(boundary) then
				roof = nil
			end
			drops.Enabled = roof == nil
			local quality = ClientState.EffectiveQuality
			drops.Rate = (quality == "Baja" and 250) or (quality == "Media" and 420) or 650
		end
		if os.clock() >= nextThunder then
			if nextThunder > 0 then
				lightning()
			end
			nextThunder = os.clock() + 14 + math.random() * 18
		end
	else
		stopRain()
	end
	if not preset then
		if wind then
			wind.Volume = 0
		end
		return
	end
	if not wind or not wind.Parent then
		wind = Instance.new("Sound")
		wind.Name = "AmbienceWind"
		wind.SoundId = WIND_ID
		wind.Looped = true
		wind.SoundGroup = ensureGroup()
		wind.Parent = SoundService
		wind:Play()
	end
	-- (el viento sube y baja poco a poco, como ráfagas)
	local gust = 0.8 + 0.2 * math.sin(os.clock() * 0.35) + 0.1 * math.sin(os.clock() * 1.3)
	-- (con ventisca, el viento sopla mucho más fuerte)
	local storm = map ~= nil and map:GetAttribute("Weather") == "Snowstorm"
	wind.Volume = preset.Wind * gust * (storm and 1.7 or 1)
	wind.PlaybackSpeed = preset.WindSpeed
	if not wind.IsPlaying then
		wind:Play()
	end
	local now = os.clock()
	if preset.Booms and now >= nextBoom then
		if nextBoom > 0 then
			oneShot(BOOM_ID, 0.18 + math.random() * 0.15, 0.3 + math.random() * 0.12)
		end
		nextBoom = now + preset.Booms[1] + math.random() * (preset.Booms[2] - preset.Booms[1])
	end
	if preset.Bursts and now >= nextBurst then
		if nextBurst > 0 then
			burst()
		end
		nextBurst = now + preset.Bursts[1] + math.random() * (preset.Bursts[2] - preset.Bursts[1])
	end
	-- Olas que rompen a lo lejos (puertos y playas)
	if preset.Waves and now >= nextWave then
		if nextWave > 0 then
			oneShot(WAVE_ID, 0.08 + math.random() * 0.06, 0.45 + math.random() * 0.15)
		end
		nextWave = now + preset.Waves[1] + math.random() * (preset.Waves[2] - preset.Waves[1])
	end
end

function Ambience.Init()
	task.spawn(function()
		while true do
			local ok, err = pcall(Ambience.Update)
			if not ok then
				warn("[Ambiente]", err)
				task.wait(5)
			end
			task.wait(0.25)
		end
	end)
end

return Ambience
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="142">
            <Properties>
              <string name="Name">BodyView</string>
              <string name="Source"><![CDATA[-- Tu cuerpo en primera persona: al mirar hacia abajo ves tus piernas y tus botas (con lo que lleve el
-- traje o el uniforme en ellas), como en los shooters modernos. Roblox esconde todo el personaje en
-- primera persona; aquí, justo después de la cámara, se vuelven a mostrar la cadera y las piernas. Se
-- esconden otra vez agachado o deslizándote (la cámara baja y las atravesaría), muerto, en el menú y
-- con la cámara lejos (emotes).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ClientState = require(script.Parent.ClientState)

local BodyView = {}

local LOWER_BODY = {
	LowerTorso = true,
	LeftUpperLeg = true,
	LeftLowerLeg = true,
	LeftFoot = true,
	RightUpperLeg = true,
	RightLowerLeg = true,
	RightFoot = true,
}

local player = Players.LocalPlayer
local shown = {} -- piezas a mostrar del personaje actual
local character = nil
local wasActive = false
local pending = false -- (una sola recogida por fotograma aunque lleguen muchas piezas de golpe)

-- La cadera, las piernas y lo que va pegado a ellas (botas, rodilleras, cinturón del traje)
local function collect(model)
	table.clear(shown)
	if not model then
		return
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and LOWER_BODY[d.Name] then
			table.insert(shown, d)
		end
	end
	for _, d in model:GetDescendants() do
		if d:IsA("WeldConstraint") or d:IsA("Weld") then
			local a, b = d.Part0, d.Part1
			local onLeg = (a and LOWER_BODY[a.Name] and a:IsDescendantOf(model)) or (b and LOWER_BODY[b.Name] and b:IsDescendantOf(model))
			if onLeg then
				for _, part in { a, b } do
					if part and part:IsA("BasePart") and not LOWER_BODY[part.Name] and not table.find(shown, part) then
						table.insert(shown, part)
					end
				end
			end
		end
	end
end

-- ¿Se ven las piernas ahora? (primera persona, de pie o andando)
function BodyView.Active()
	if not character or ClientState.Dead or ClientState.InMainMenu or ClientState.Emoting then
		return false
	end
	if ClientState.Crouching or ClientState.Sliding then
		return false
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local head = character:FindFirstChild("Head")
	local camera = workspace.CurrentCamera
	if not humanoid or humanoid.Health <= 0 or not head or not camera then
		return false
	end
	return (camera.CFrame.Position - head.Position).Magnitude < 2
end

-- ¿La cámara sigue en la cabeza? (primera persona, aunque ahora no toque mostrar las piernas)
local function cameraInHead()
	local head = character and character:FindFirstChild("Head")
	local camera = workspace.CurrentCamera
	return head ~= nil and head:IsA("BasePart") and camera ~= nil and (camera.CFrame.Position - head.Position).Magnitude < 2
end

function BodyView.Update()
	if not BodyView.Active() then
		-- (al dejar de mostrarlas, se esconden otra vez: Roblox no lo hace solo si para él nada cambió)
		if wasActive then
			wasActive = false
			if cameraInHead() then
				for _, part in shown do
					if part.Parent then
						part.LocalTransparencyModifier = 1
					end
				end
			end
		end
		return
	end
	wasActive = true
	for _, part in shown do
		if part.Parent then
			part.LocalTransparencyModifier = 0
		end
	end
end

-- (para las pruebas)
function BodyView.Shown()
	return shown
end

function BodyView.Track(model)
	character = model
	wasActive = false
	collect(model)
	if model then
		-- Lo que se le pone después (uniforme, traje) también cuenta
		model.DescendantAdded:Connect(function(d)
			if not (d:IsA("BasePart") or d:IsA("Weld") or d:IsA("WeldConstraint")) then
				return
			end
			if character == model and not pending then
				pending = true
				task.defer(function()
					pending = false
					if character == model then
						collect(model)
					end
				end)
			end
		end)
	end
end

function BodyView.Init()
	if player.Character then
		BodyView.Track(player.Character)
	end
	player.CharacterAdded:Connect(BodyView.Track)
	-- Justo después de la cámara (que es la que esconde el personaje en primera persona)
	RunService:BindToRenderStep("BodyView", Enum.RenderPriority.Camera.Value + 2, function()
		local ok, err = pcall(BodyView.Update)
		if not ok then
			warn("[BodyView]", err)
		end
	end)
end

return BodyView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="143">
            <Properties>
              <string name="Name">BombHUD</string>
              <string name="Source"><![CDATA[-- Buscar y destruir: qué te toca (atacar o defender), la cuenta atrás de la bomba plantada y la
-- barra de plantar / desactivar. Debajo del marcador.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UI)
local ClientState = require(script.Parent.ClientState)
local HUDZones = require(script.Parent.HUDZones)
local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))
local Sounds = require(ReplicatedStorage:WaitForChild("Shared").Sounds)

local player = Players.LocalPlayer

local BombHUD = {}

local gui, label, barBack, bar, barText, droppedMarker
local nextBeep = 0

-- Bomba plantada: la luz parpadea y pita, cada vez más deprisa según se acaba el tiempo
local function beep(timer)
	local bomb = workspace:FindFirstChild("PlantedBomb")
	local light = bomb and bomb:FindFirstChild("BombLight")
	if not light or not light:IsA("BasePart") then
		return
	end
	local now = os.clock()
	if now < nextBeep then
		return
	end
	nextBeep = now + math.clamp(timer / 30, 0.15, 1)
	light.Transparency = 0
	task.delay(0.08, function()
		if light.Parent then
			light.Transparency = 0.7
		end
	end)
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxasset://sounds/electronicpingshort.wav"
	sound.Volume = 0.55
	sound.PlaybackSpeed = 1.9
	sound.RollOffMaxDistance = 140
	sound.SoundGroup = Sounds.GetWorldGroup() -- (así también se oye apagado tras una explosión)
	sound.Parent = light
	sound:Play()
	task.delay(1.5, function()
		sound:Destroy()
	end)
end

local function update()
	local attackers = ReplicatedStorage:GetAttribute("Bomb_Attackers")
	gui.Enabled = attackers ~= nil and not ClientState.InMainMenu
	if not gui.Enabled then
		droppedMarker.Parent = nil
		return
	end
	local state = ReplicatedStorage:GetAttribute("Bomb_State")
	local site = ReplicatedStorage:GetAttribute("Bomb_Site") or ""
	local attacking = player.Team ~= nil and player.Team.Name == attackers
	if state == "Planted" then
		local timer = ReplicatedStorage:GetAttribute("Bomb_Timer") or 0
		beep(timer)
		label.Text = UI.HudText(string.format("💣 BOMBA EN %s · %d s%s", site, timer, attacking and " · ¡protégela!" or " · ¡desactívala!"))
		label.TextColor3 = Color3.fromRGB(255, 90, 70)
	elseif attacking then
		-- Quién lleva la bomba (solo el portador puede plantarla)
		local carrier = ReplicatedStorage:GetAttribute("Bomb_Carrier")
		if carrier == player.Name then
			label.Text = UI.HudText("💣 LLEVAS LA BOMBA · plántala en A o B")
		elseif typeof(ReplicatedStorage:GetAttribute("Bomb_Dropped")) == "Vector3" then
			label.Text = UI.HudText("💣 ¡LA BOMBA ESTÁ EN EL SUELO! · recógela")
		elseif carrier then
			local carrierPlayer = Players:FindFirstChild(tostring(carrier))
			local shown = carrierPlayer and carrierPlayer:IsA("Player") and carrierPlayer.DisplayName or tostring(carrier)
			label.Text = UI.HudText("💣 ATACAS · ") .. shown .. " lleva la bomba: cúbrele"
		else
			label.Text = UI.HudText("💣 ATACAS · planta la bomba en A o B")
		end
		label.TextColor3 = Color3.fromRGB(255, 210, 90)
	else
		label.Text = UI.HudText("🛡️ DEFIENDES · protege A y B")
		label.TextColor3 = Color3.fromRGB(140, 200, 255)
	end
	-- Marca de la bomba en el suelo, solo para los atacantes (los defensores no la ven a través de las paredes)
	local dropped = ReplicatedStorage:GetAttribute("Bomb_Dropped")
	if attacking and state ~= "Planted" and typeof(dropped) == "Vector3" then
		droppedMarker.Position = dropped - Vector3.new(0, 2.5, 0)
		droppedMarker.Parent = workspace
	else
		droppedMarker.Parent = nil
	end
	local action = ReplicatedStorage:GetAttribute("Bomb_Action") or ""
	local progress = ReplicatedStorage:GetAttribute("Bomb_Progress") or 0
	barBack.Visible = action ~= "" and progress > 0
	bar.Size = UDim2.fromScale(math.clamp(progress, 0, 1), 1)
	bar.BackgroundColor3 = action == "Planting" and Color3.fromRGB(255, 120, 50) or Color3.fromRGB(80, 170, 255)
	barText.Text = (action == "Planting" and "PLANTANDO EN " .. site or "DESACTIVANDO") .. "..."
end

function BombHUD.Init()
	-- Marca de la bomba en el suelo (pieza invisible con el icono encima, solo en este cliente)
	droppedMarker = Instance.new("Part")
	droppedMarker.Name = "DroppedBombMarker"
	droppedMarker.Anchored = true
	droppedMarker.CanCollide = false
	droppedMarker.CanQuery = false
	droppedMarker.CanTouch = false
	droppedMarker.Transparency = 1
	droppedMarker.Size = Vector3.new(0.2, 0.2, 0.2)
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(36, 36)
	billboard.StudsOffset = Vector3.new(0, 2, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = 400
	billboard.Parent = droppedMarker
	local icon = Instance.new("TextLabel")
	icon.Size = UDim2.fromScale(1, 1)
	icon.BackgroundTransparency = 1
	icon.TextScaled = true
	icon.Text = "💣"
	icon.Parent = billboard
	gui = UI.new("ScreenGui", {
		Name = "BombHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 2,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	label = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 118),
		Size = UDim2.fromOffset(460, 30),
		Text = "",
		TextScaled = true, -- (con nombres largos se encoge)
		Parent = gui,
	}, { UI.new("UITextSizeConstraint", { MaxTextSize = 22 }) })
	barBack = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0.5, -30), -- (encima de la mira: debajo salen las medallas en el móvil)
		Size = UDim2.fromOffset(260, 22),
		BackgroundColor3 = Color3.fromRGB(20, 22, 28),
		BackgroundTransparency = 0.2,
		Visible = false,
		Parent = gui,
	}, { UI.corner(6), UI.stroke(Color3.new(0, 0, 0), 2, 0.2) })
	bar = UI.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BorderSizePixel = 0,
		Parent = barBack,
	}, { UI.corner(6) })
	barText = UI.label({
		Size = UDim2.fromScale(1, 1),
		Text = "",
		TextSize = 16,
		ZIndex = 2,
		Parent = barBack,
	})
	-- Táctil (Fase 16): el estado de la bomba va con el objetivo, bajo el minimapa; el progreso de
	-- plantar o desactivar, bajo la mira (fuera del centro libre). Antes los dos iban fijos arriba y
	-- encima de la mira y en una partida pisaban las medallas y el aviso de baja
	if InputMode.TouchUI() then
		label.Size = UDim2.fromOffset(220, 20)
		barBack.Size = UDim2.fromOffset(200, 18)
		barText.TextSize = 13
		HUDZones.Register("BombStatus", label, "TOP_LEFT", 1, { Gui = gui, Fit = true })
		HUDZones.Register("BombProgress", barBack, "BOTTOM_NOTICE", 0, { Gui = gui })
	end
	task.spawn(function()
		while gui.Parent do
			update()
			task.wait(0.15)
		end
	end)
end

BombHUD.Update = update

return BombHUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="144">
            <Properties>
              <string name="Name">BoostHUD</string>
              <string name="Source"><![CDATA[-- Potenciadores activos (Shop.Boosters): "⚡ x2 XP 23:10" arriba en el centro, debajo del marcador.
-- El servidor manda los segundos que quedan; aquí se cuentan hacia atrás solo mientras se juega
-- (igual que en el servidor) y se corrigen con cada actualización de datos.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))

local Shop = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Shop"))
local UI = require(script.Parent.UI)
local ClientState = require(script.Parent.ClientState)
local HUDZones = require(script.Parent.HUDZones)

local player = Players.LocalPlayer

local BoostHUD = {}

local left = {} -- [Field] = segundos que quedan
local label

local function format(seconds)
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

local function render()
	local parts = {}
	for _, booster in Shop.Boosters do
		local seconds = left[booster.Field] or 0
		if seconds > 0 then
			table.insert(parts, booster.Icon .. " x" .. booster.Multiplier .. (booster.Kind == "XP" and " XP " or " ") .. format(seconds))
		end
	end
	label.Text = table.concat(parts, "   ")
	label.Visible = #parts > 0 and not ClientState.InMainMenu and not ClientState.MenuOpen
		-- (táctil, Fase 16: en plena pelea no; se ve al morir, en el calentamiento y en los menús)
		and not (InputMode.TouchUI() and HUDZones.Fighting())
end

function BoostHUD.Init()
	local gui = UI.new("ScreenGui", {
		Name = "Boosters",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		Parent = player:WaitForChild("PlayerGui"),
	})
	label = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 140), -- (debajo de la fila de jugadores del marcador)
		Size = UDim2.fromOffset(320, 22),
		Text = "",
		TextSize = 17,
		TextColor3 = Color3.fromRGB(120, 230, 255),
		Visible = false,
		Parent = gui,
	})
	local function onData(data)
		if not data then
			return
		end
		for _, booster in Shop.Boosters do
			-- (el servidor descuenta de 5 en 5 s: solo se corrige si se ha ido más que eso, para que
			-- el reloj no salte hacia arriba con cada baja)
			local server = tonumber(data[booster.Field]) or 0
			local mine = left[booster.Field]
			if not mine or math.abs(server - mine) > 6 or server == 0 then
				left[booster.Field] = server
			end
		end
		render()
	end
	ClientState.DataChanged.Event:Connect(onData)
	onData(ClientState.Data)
	task.spawn(function()
		while true do
			task.wait(1)
			if not ClientState.InMainMenu then
				for field, seconds in left do
					left[field] = math.max(0, seconds - 1)
				end
			end
			render()
		end
	end)
end

return BoostHUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="145">
            <Properties>
              <string name="Name">BotFootsteps</string>
              <string name="Source"><![CDATA[-- Pasos de los bots (solo en el cliente). Los personajes de los jugadores ya suenan al correr con los
-- sonidos de Roblox, pero los bots no: aquí cada bot cercano lleva el mismo sonido de pasos en bucle,
-- más rápido cuanto más corre, y solo mientras se mueve por el suelo. Los enemigos se oyen más que
-- los compañeros (como en los shooters: oír los pasos del rival es información).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Sounds = require(ReplicatedStorage:WaitForChild("Shared").Sounds)

local BotFootsteps = {}

local SOUND_ID = "rbxasset://sounds/action_footsteps_plastic.mp3"
local MAX_DISTANCE = 90 -- más lejos no se oyen (y no se gastan sonidos)
local CHECK_INTERVAL = 0.1
local ENEMY_VOLUME = 0.8
local ALLY_VOLUME = 0.35

local player = Players.LocalPlayer
local sounds = {} -- [modelo del bot] = Sound

local function isEnemy(model)
	if ReplicatedStorage:GetAttribute("TeamMode") == false then
		return true
	end
	local team = model:GetAttribute("Team")
	return team == nil or player.Team == nil or team ~= player.Team.Name
end

local function soundFor(model, root)
	local sound = sounds[model]
	if sound and sound.Parent == root then
		return sound
	end
	sound = Instance.new("Sound")
	sound.Name = "Pasos"
	sound.SoundId = SOUND_ID
	sound.Looped = true
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 6
	sound.RollOffMaxDistance = MAX_DISTANCE
	sound.SoundGroup = Sounds.GetWorldGroup() -- (así también se oye apagado tras una explosión)
	sound.Parent = root
	sounds[model] = sound
	return sound
end

local function update()
	local folder = workspace:FindFirstChild("Bots")
	local camera = workspace.CurrentCamera
	local seen = {}
	if folder and camera then
		for _, model in folder:GetChildren() do
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart")
			if humanoid and root and root:IsA("BasePart") and humanoid.Health > 0
				and (root.Position - camera.CFrame.Position).Magnitude < MAX_DISTANCE then
				seen[model] = true
				local velocity = root.AssemblyLinearVelocity
				local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
				local sound = soundFor(model, root)
				-- (en el aire o casi quieto no suenan)
				if speed > 3 and math.abs(velocity.Y) < 6 then
					sound.Volume = isEnemy(model) and ENEMY_VOLUME or ALLY_VOLUME
					sound.PlaybackSpeed = math.clamp(speed / 16, 0.7, 1.6)
					if not sound.IsPlaying then
						sound:Play()
					end
				elseif sound.IsPlaying then
					sound:Stop()
				end
			end
		end
	end
	-- Bots que se alejan, mueren o desaparecen: fuera su sonido
	for model, sound in sounds do
		if not seen[model] then
			sound:Destroy()
			sounds[model] = nil
		end
	end
end

function BotFootsteps.Init()
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < CHECK_INTERVAL then
			return
		end
		elapsed = 0
		update()
	end)
end

BotFootsteps.Update = update
return BotFootsteps
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="146">
            <Properties>
              <string name="Name">Callouts</string>
              <string name="Source"><![CDATA[-- Avisos de los compañeros (como en los shooters por equipos): encima de la cabeza de un compañero
-- (jugador o bot) sale un momento «🔄 ¡Recargando!» cuando recarga y «💣 ¡Granada!» cuando lanza una.
-- Solo los de tu equipo (de los enemigos no se sabe nada) y solo en modos por equipos. Solo en este
-- cliente.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local Callouts = {}

Callouts.Duration = 1.6
Callouts.Range = 140 -- (más lejos no se ve el cartel)

local player = Players.LocalPlayer
local reloading = setmetatable({}, { __mode = "k" }) -- [Tool] = true
local seenGrenades = setmetatable({}, { __mode = "k" }) -- [granada] = true
local bubbles = setmetatable({}, { __mode = "k" }) -- [Model] = { Gui, Token }
local clock = 0

local function teamMode()
	return ReplicatedStorage:GetAttribute("TeamMode") ~= false
end

-- ¿Es un compañero? (jugador de tu equipo o bot de tu equipo; tú no)
local function teammate(model)
	if not model or model == player.Character or not player.Team or not teamMode() then
		return false
	end
	local owner = Players:GetPlayerFromCharacter(model)
	if owner then
		return owner ~= player and owner.Team == player.Team
	end
	return model:GetAttribute("Bot") == true and model:GetAttribute("Team") == player.Team.Name
end

-- Muestra el aviso encima de la cabeza (si ya había uno, lo sustituye)
function Callouts.Show(model, text)
	local head = model and model:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return nil
	end
	local camera = workspace.CurrentCamera
	if camera and (head.Position - camera.CFrame.Position).Magnitude > Callouts.Range then
		return nil
	end
	-- Los avisos de personajes que ya no existen (murieron, bots quitados) se borran: si no, se iban
	-- acumulando en PlayerGui partida tras partida
	for other, old in bubbles do
		if not other.Parent then
			old.Gui:Destroy()
			bubbles[other] = nil
		end
	end
	local entry = bubbles[model]
	if not entry or not entry.Gui.Parent then
		local gui = UI.new("BillboardGui", {
			Name = "Callout",
			Size = UDim2.fromOffset(150, 30),
			StudsOffsetWorldSpace = Vector3.new(0, 2.6, 0),
			AlwaysOnTop = true,
			LightInfluence = 0,
			MaxDistance = Callouts.Range,
			Adornee = head,
			Parent = player:WaitForChild("PlayerGui"),
		})
		local label = UI.label({
			Name = "Text",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.fromRGB(20, 26, 36),
			BackgroundTransparency = 0.35,
			TextSize = 16,
			TextColor3 = Color3.fromRGB(150, 220, 255),
			Parent = gui,
		}, { UI.corner(8) })
		entry = { Gui = gui, Label = label, Token = 0 }
		bubbles[model] = entry
	end
	entry.Token += 1
	local token = entry.Token
	entry.Label.Text = text
	entry.Gui.Enabled = true
	task.delay(Callouts.Duration, function()
		if bubbles[model] == entry and entry.Token == token then
			entry.Gui.Enabled = false
			if not model.Parent then
				entry.Gui:Destroy()
				bubbles[model] = nil
			end
		end
	end)
	return entry.Gui
end

local function characters()
	local list = {}
	for _, p in Players:GetPlayers() do
		if p ~= player and p.Character then
			table.insert(list, p.Character)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			if model:IsA("Model") then
				table.insert(list, model)
			end
		end
	end
	return list
end

local function modelNamed(name)
	local p = Players:FindFirstChild(name)
	if p and p:IsA("Player") then
		return p.Character
	end
	local bots = workspace:FindFirstChild("Bots")
	return bots and bots:FindFirstChild(name) or nil
end

function Callouts.Update(dt)
	clock += dt or 0
	if clock < 0.15 then
		return
	end
	clock = 0
	if ClientState.InMainMenu then
		return
	end
	-- Recargas
	for _, model in characters() do
		local tool = model:FindFirstChildOfClass("Tool")
		if tool and tool:GetAttribute("Weapon") then
			local now = tool:GetAttribute("Reloading") == true
			if now and not reloading[tool] and teammate(model) then
				Callouts.Show(model, UI.HudText("🔄 ¡Recargando!"))
			end
			reloading[tool] = now or nil
		end
	end
	-- Granadas recién lanzadas por compañeros
	local folder = workspace:FindFirstChild("Grenades")
	if folder then
		for _, grenade in folder:GetChildren() do
			if not seenGrenades[grenade] then
				seenGrenades[grenade] = true
				local thrower = grenade:GetAttribute("Thrower")
				local model = type(thrower) == "string" and modelNamed(thrower) or nil
				if model and teammate(model) then
					Callouts.Show(model, UI.HudText("💣 ¡Granada!"))
				end
			end
		end
	end
end

function Callouts.Init()
	RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(Callouts.Update, dt)
		if not ok then
			warn("[Callouts]", err)
		end
	end)
end

return Callouts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="147">
            <Properties>
              <string name="Name">ChatTags</string>
              <string name="Source"><![CDATA[-- Etiquetas en el chat: [VIP] dorada para quien tenga el pase VIP, el icono de su rango competitivo,
-- el nivel de cada jugador (con color según el nivel) y su título. Solo cambia cómo se ve el mensaje (TextChatService, chat nuevo de Roblox).
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Ranks = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Ranks"))

local ChatTags = {}

-- Color del nivel: gris, verde, azul, morado y dorado según se sube
local function levelColor(level)
	if level >= 40 then
		return "#FFC83C"
	elseif level >= 25 then
		return "#C064FF"
	elseif level >= 12 then
		return "#4AA8FF"
	elseif level >= 5 then
		return "#6EE06E"
	end
	return "#C8C8D2"
end

local function tagsFor(player)
	local tags = ""
	if player:GetAttribute("VIP") then
		tags ..= '<font color="#FFC83C">[VIP]</font> '
	end
	local rank = Ranks.Tiers[player:GetAttribute("Rank") or 0]
	if rank then
		tags ..= rank.Icon .. " "
	end
	local stats = player:FindFirstChild("leaderstats")
	local level = stats and stats:FindFirstChild("Nivel")
	if level and typeof(level.Value) == "number" then
		tags ..= string.format('<font color="%s">[Nv %d]</font> ', levelColor(level.Value), level.Value)
	end
	-- Título elegido (Titles)
	local title = player:GetAttribute("Title")
	local titleColor = player:GetAttribute("TitleColor")
	if type(title) == "string" and title ~= "" then
		tags ..= string.format('<font color="#%s">«%s»</font> ', typeof(titleColor) == "Color3" and titleColor:ToHex() or "C8C8D2", title)
	end
	return tags
end

function ChatTags.Init()
	if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
		return -- chat antiguo: no se puede personalizar así
	end
	TextChatService.OnIncomingMessage = function(message)
		local properties = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		local player = source and Players:GetPlayerByUserId(source.UserId)
		if player then
			properties.PrefixText = tagsFor(player) .. message.PrefixText
		end
		return properties
	end
end

return ChatTags
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="148">
            <Properties>
              <string name="Name">ClientState</string>
              <string name="Source"><![CDATA[-- Estado compartido entre los módulos del cliente.
local ClientState = {
	Data = nil, -- datos de progreso (nivel, XP, skins...)
	Settings = nil :: { [string]: any }?, -- ajustes del jugador (los rellena Settings)
	EffectiveQuality = "Media", -- calidad real aplicada ("Auto" ya resuelto); la rellena Settings
	Dead = false, -- pantalla de muerte abierta (la rellena DeathScreen)
	KillcamActive = false, -- se está viendo una killcam (Killcam; el HUD oculta su «ELIMINADO POR»)
	KillcamFinal = false, -- es la killcam final de la partida/ronda (el HUD se esconde entero)
	Emoting = false, -- haciendo un emote (cámara en tercera persona, arma oculta)
	EmoteMenuOpen = false, -- menú de emotes abierto (N)
	TutorialOpen = false, -- tarjeta de controles de la primera partida en pantalla
	WheelOpen = false, -- ruleta diaria abierta
	NewsOpen = false, -- tarjeta de novedades abierta (News)
	HUDEditorOpen = false, -- editor de los controles táctiles abierto (HUDEditor): no se juega
	FovKick = 0, -- empujón de campo de visión (habilidades); lo consume WeaponController
	Shake = 0, -- temblor de cámara pendiente (explosiones cercanas); lo consume WeaponController
	ConcussedUntil = 0, -- aturdido por una explosión cercana hasta este os.clock() (CombatFX)
	SuppressedAt = 0, -- última bala que pasó rozando (os.clock(); CombatFX)
	MenuOpen = false, -- menú del pase/tienda abierto
	VoteOpen = false, -- panel de votación con el ratón libre
	InMainMenu = true, -- pantalla de inicio visible
	ResultsScreen = false, -- la pantalla final del flujo existe (sustituye al cuadro de fin del HUD)
	ResultsActive = false, -- la partida ha acabado y se ve (o está a punto) la pantalla final
	StoreModal = false, -- vista previa o confirmación de la tienda abierta
	RevealOpen = false, -- escena de compra abierta
	ConfirmOpen = false, -- confirmación de compra con monedas abierta
	Aiming = false,
	AimAlpha = 0, -- 0 = cadera, 1 = apuntando
	Sprinting = false,
	SprintToggled = false, -- (táctil) el botón de correr está puesto (es de pulsar y soltar)
	Stamina = 1, -- 0..1 (correr la gasta; Movement)
	Exhausted = false, -- se agotó y aún no se ha recuperado lo bastante para correr
	LandKick = 0, -- golpe de cámara al aterrizar desde alto; lo consume WeaponController
	MinimapBottom = nil :: number?, -- borde de abajo del minimapa (para colocar lo de debajo)
	MinimapLeft = nil :: number?, -- su borde izquierdo (lo de debajo se alinea con él)
	ScoreSpot = nil :: Vector2?, -- (táctil) dónde van los puntos de la baja, junto a la mira (lo calcula HUD)
	ScoreSpotLeft = false, -- (y si van a la izquierda de la mira)
	MinimapSize = nil :: number?, -- su lado
	Sliding = false,
	Crouching = false, -- agachado (C sin correr): más bajo, más lento y más preciso
	CurrentTool = nil,
	CurrentDef = nil,
	Ammo = 0,
	Reloading = false,
	ReloadProgress = 0,
	LastShotTime = 0,
	LastHitPosition = nil :: Vector3?, -- dónde dio tu último disparo a un personaje (números de daño)
	LastHitTime = 0,
	LastHitModel = nil :: Model?, -- a quién dio ese disparo (el destello al impactar)
	VotePanelVisible = false, -- hay votación de mapa en pantalla (la V es para votar, no para inspeccionar)
	Dashing = false, -- impulso (E) en curso: no se puede deslizar a la vez
	MenuClosedAt = 0, -- cuándo se cerró la tienda (la B no revive justo después)
	Bloom = 0, -- apertura extra de la mira por disparos
	Spread = 0, -- dispersión actual (grados)
	QAShotHook = nil :: ((Vector3, { any }) -> ())?, -- modo QA de Studio: dibuja cada disparo (QAPanel)
	QASkinPreview = nil :: string?, -- modo QA de Studio: skin que se ve en primera persona (solo aquí, no da la skin)
	WeaponAction = "None", -- acción del viewmodel ahora (WeaponVisual.ActionPriority; "ADS" si apunta en reposo)

	DataChanged = Instance.new("BindableEvent"),
	SettingsChanged = Instance.new("BindableEvent"), -- (Ajustes: se cambió algo que otros módulos aplican)
	WeaponChanged = Instance.new("BindableEvent"),
	ShotFired = Instance.new("BindableEvent"),
	-- Momentos del arma propia para animaciones y audio (WeaponController):
	-- ("Equip", arma) · ("Fire", arma) · ("ReloadStart", arma, { Empty, Duration }) · ("ReloadCancel", arma)
	-- · ("Inspect", arma) · ("InspectCancel", arma)
	WeaponEvent = Instance.new("BindableEvent"),
}

-- ¿Hay algún menú que impida jugar (disparar, moverse con el ratón...)?
function ClientState.IsBlocked()
	return ClientState.MenuOpen or ClientState.VoteOpen or ClientState.InMainMenu or ClientState.Dead or ClientState.EmoteMenuOpen
		or ClientState.TutorialOpen or ClientState.WheelOpen or ClientState.NewsOpen or ClientState.HUDEditorOpen
end

-- Cuenta atrás de Eliminación: quietos y sin disparar (lo decide el servidor)
-- Ajustes → Efectos de pantalla «Reducidos»: sin desenfoques, destellos ni temblores (accesibilidad)
function ClientState.ReducedFX()
	local settings = ClientState.Settings
	return settings ~= nil and settings.ScreenFX == 0
end

function ClientState.Frozen()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	if ReplicatedStorage:GetAttribute("Frozen") == true then
		return true
	end
	-- (Buscar y destruir: los atacantes esperan unos segundos más en su base, ver Round)
	local held = ReplicatedStorage:GetAttribute("HeldTeam")
	local localPlayer = held and game:GetService("Players").LocalPlayer
	local team = localPlayer and localPlayer.Team
	return team ~= nil and team.Name == held
end

-- El cursor se ve siempre que haya algún menú abierto (cada menú llama a esto al abrirse o cerrarse)
function ClientState.UpdateMouse()
	local blocked = ClientState.IsBlocked()
	game:GetService("UserInputService").MouseIconEnabled = blocked
	-- Botones táctiles del juego: ocultos mientras hay un menú abierto
	-- (los botones táctiles son nuestros, de TouchLayout: se pide aquí para no requerirlo al cargar)
	local okLayout, TouchLayout = pcall(require, script.Parent.TouchLayout)
	if not okLayout then
		return
	end
	-- (cuáles se ven lo decide TouchLayout: menús abiertos, cargas del ataque aéreo, ajustes...)
	TouchLayout.RefreshVisibility()
end

function ClientState.SetData(data)
	if type(data) ~= "table" then
		return
	end
	ClientState.Data = data
	ClientState.DataChanged:Fire(data)
end

return ClientState
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="149">
            <Properties>
              <string name="Name">CombatFX</string>
              <string name="Source"><![CDATA[-- Sensaciones de combate (realismo), solo en este cliente:
--   Concussion: una explosión cerca te aturde: destello blanco, desenfoque, pitido en los oídos y todo
--               lo demás suena apagado unos segundos (más cuanto más cerca)
--   Suppress:   balas que pasan rozando: un instante de desenfoque y la imagen se oscurece (supresión)
--   Latido:     con poca vida, un latido grave que se acelera cuanto menos vida queda
-- En calidad Baja, sin desenfoques (cuestan en móviles modestos); el sonido sí.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Sounds = require(ReplicatedStorage.Shared.Sounds)
local ClientState = require(script.Parent.ClientState)

local CombatFX = {}

local player = Players.LocalPlayer
local blur, flash, ring
local muffles = {}
local muffleUntil, muffleStrength = 0, 0
local blurTarget = 0
local nextBeat = 0

local function lowQuality()
	return ClientState.EffectiveQuality == "Baja"
end

local function ensureEffects()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	if not blur or blur.Parent ~= camera then
		blur = Instance.new("BlurEffect")
		blur.Name = "CombatBlur"
		blur.Size = 0
		blur.Parent = camera
	end
	if not flash or flash.Parent ~= camera then
		flash = Instance.new("ColorCorrectionEffect")
		flash.Name = "CombatFlash"
		flash.Parent = camera
	end
end

-- Filtro que apaga los agudos de todo lo que suena (el oído "taponado" tras una explosión): uno en
-- cada grupo de sonido (armas, ambiente y el resto, ver Sounds), que es donde Roblox aplica los efectos
local function ensureMuffles()
	Sounds.GetWorldGroup()
	Sounds.GetGunGroup()
	muffles = {}
	for _, group in SoundService:GetChildren() do
		if group:IsA("SoundGroup") then
			local eq = group:FindFirstChild("ConcussionMuffle")
			if not eq then
				eq = Instance.new("EqualizerSoundEffect")
				eq.Name = "ConcussionMuffle"
				eq.HighGain = 0
				eq.MidGain = 0
				eq.LowGain = 0
				eq.Priority = 10
				eq.Parent = group
			end
			table.insert(muffles, eq)
		end
	end
end

local function setMuffle(high, mid)
	for _, eq in muffles do
		if eq.Parent then
			eq.HighGain = high
			eq.MidGain = mid
			eq.Enabled = high < -0.5
		end
	end
end

-- strength: 0..1 (1 = la explosión casi encima)
function CombatFX.Concussion(strength)
	strength = math.clamp(strength or 0, 0, 1)
	-- (muerto: la cámara es la de la killcam o la de observar, no tus oídos)
	if strength < 0.2 or ClientState.InMainMenu or ClientState.Dead then
		return
	end
	ensureEffects()
	if not lowQuality() and not ClientState.ReducedFX() and blur and flash then
		blur.Size = 18 * strength
		blurTarget = 0
		flash.Brightness = 0.45 * strength
		flash.Contrast = -0.2 * strength
		flash.Saturation = -0.5 * strength
		TweenService:Create(flash, TweenInfo.new(1.6 * strength + 0.4), { Brightness = 0, Contrast = 0, Saturation = 0 }):Play()
	end
	-- Oído taponado: los agudos y medios bajan de golpe y vuelven poco a poco
	muffleStrength = strength
	muffleUntil = os.clock() + 1.2 + 2.3 * strength
	ensureMuffles()
	setMuffle(-30 * strength, -14 * strength)
	-- Pitido en los oídos (fuera de los grupos: no se apaga con el filtro)
	if ring then
		ring:Destroy()
	end
	-- (un único pitido agudo que se apaga solo: en bucle sonaría a pitidos seguidos)
	ring = Sounds.Play("Tinnitus", nil, 1, 0.4 + 0.6 * strength)
	if ring then
		ring.Name = "Tinnitus"
		ring.SoundGroup = nil
	end
	ClientState.ConcussedUntil = muffleUntil
end

-- Bala que pasa rozando: un instante de desenfoque y la imagen se oscurece un poco (te "encoges")
function CombatFX.Suppress(amount)
	amount = math.clamp(amount or 0.5, 0, 1)
	if ClientState.Dead or ClientState.InMainMenu then
		return
	end
	ensureEffects()
	if not lowQuality() and not ClientState.ReducedFX() and blur and flash then
		blur.Size = math.max(blur.Size, 5 * amount)
		blurTarget = 0
		-- (sin pisar el destello de una explosión que aún se está yendo)
		if os.clock() >= muffleUntil then
			flash.Brightness = -0.06 * amount
			flash.Contrast = 0.1 * amount
			flash.Saturation = -0.2 * amount
			TweenService:Create(flash, TweenInfo.new(0.5), { Brightness = 0, Contrast = 0, Saturation = 0 }):Play()
		end
	end
	ClientState.SuppressedAt = os.clock()
end

function CombatFX.Update(dt)
	dt = dt or 1 / 60
	-- El desenfoque se va solo (y al morir o en el menú, al momento: que se vea bien la killcam)
	if blur and blur.Size > blurTarget then
		if ClientState.Dead or ClientState.InMainMenu then
			blur.Size = blurTarget
		else
			blur.Size = math.max(blurTarget, blur.Size - dt * 9)
		end
	end
	-- El oído se destapona poco a poco
	if #muffles > 0 then
		local left = muffleUntil - os.clock()
		if left <= 0 then
			setMuffle(0, 0)
			muffles = {}
		else
			local k = math.clamp(left / (1.2 + 2.3 * math.max(muffleStrength, 0.01)), 0, 1)
			setMuffle(-30 * muffleStrength * k, -14 * muffleStrength * k)
		end
	end
	-- Latido con poca vida
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 and humanoid.MaxHealth > 0 and not ClientState.InMainMenu then
		local ratio = humanoid.Health / humanoid.MaxHealth
		if ratio < 0.35 then
			local now = os.clock()
			if now >= nextBeat then
				local danger = 1 - ratio / 0.35
				-- (dos golpes, "pum-pum", cada vez más seguidos)
				Sounds.Play("Boom", nil, 0.55, 0.35 + 0.35 * danger)
				task.delay(0.16, function()
					Sounds.Play("Boom", nil, 0.5, 0.25 + 0.25 * danger)
				end)
				nextBeat = now + (1.1 - 0.5 * danger)
			end
		end
	end
end

function CombatFX.Init()
	RunService.RenderStepped:Connect(function(dt)
		local ok, err = pcall(CombatFX.Update, dt)
		if not ok then
			warn("[CombatFX]", err)
		end
	end)
end

return CombatFX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="150">
            <Properties>
              <string name="Name">DamageIndicator</string>
              <string name="Source"><![CDATA[-- Indicador de daño: al recibir un disparo sale una marca roja alrededor de la mira que apunta hacia
-- quien te ha dado (sigue su posición mientras se desvanece). El servidor deja en tu Humanoid quién
-- fue (atributos LastAttacker / LastBot, ver Combat) y LastHitTime cambia con cada impacto.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local UI = require(script.Parent.UI)
local ClientState = require(script.Parent.ClientState)

local player = Players.LocalPlayer

local DamageIndicator = {}

local RADIUS = 150
local FADE_TIME = 1.4
local MAX_MARKS = 4

local gui, holder
local marks = {} -- { Key, Frame, Source, ShownAt }

local function attackerPosition(source)
	if source.UserId then
		local other = Players:GetPlayerByUserId(source.UserId)
		local root = other and other.Character and other.Character:FindFirstChild("HumanoidRootPart")
		return root and root.Position
	end
	local folder = workspace:FindFirstChild("Bots")
	local model = folder and folder:FindFirstChild(source.Bot)
	local root = model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart)
	return root and root.Position
end

local function newMark()
	local frame = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(110, 16),
		BackgroundColor3 = Color3.fromRGB(255, 40, 40),
		BorderSizePixel = 0,
		Parent = holder,
	}, {
		UI.corner(8),
		UI.new("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.3, 0.15),
				NumberSequenceKeypoint.new(0.7, 0.15),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})
	-- Punta hacia fuera (hacia el atacante)
	UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, 2),
		Size = UDim2.fromOffset(24, 18),
		Text = "▲",
		TextSize = 18,
		TextColor3 = Color3.fromRGB(255, 60, 60),
		TextStrokeTransparency = 1,
		Parent = frame,
	})
	return frame
end

local function onHit(humanoid)
	local userId = humanoid:GetAttribute("LastAttacker")
	local bot = humanoid:GetAttribute("LastBot")
	if userId == player.UserId then
		return -- (tu propio cohete o granada)
	end
	-- Con escudo (al reaparecer o en la pantalla de inicio) el disparo no hace daño: sin marca
	local character = humanoid.Parent
	if ClientState.Dead or ClientState.InMainMenu or (character and character:FindFirstChildOfClass("ForceField")) then
		return
	end
	local source = userId and { UserId = userId } or (bot and { Bot = bot }) or nil
	if not source then
		return
	end
	local key = userId and ("p" .. userId) or ("b" .. bot)
	for _, mark in marks do
		if mark.Key == key then
			mark.ShownAt = os.clock()
			mark.Source = source
			return
		end
	end
	if #marks >= MAX_MARKS then
		local oldest = table.remove(marks, 1)
		oldest.Frame:Destroy()
	end
	table.insert(marks, { Key = key, Frame = newMark(), Source = source, ShownAt = os.clock() })
end

local function clear()
	for _, mark in marks do
		mark.Frame:Destroy()
	end
	table.clear(marks)
end

local function update()
	if #marks == 0 then
		return
	end
	if ClientState.Dead or ClientState.InMainMenu then
		clear()
		return
	end
	local camera = workspace.CurrentCamera
	local now = os.clock()
	for i = #marks, 1, -1 do
		local mark = marks[i]
		local age = now - mark.ShownAt
		local position = attackerPosition(mark.Source)
		if age > FADE_TIME then
			mark.Frame:Destroy()
			table.remove(marks, i)
		else
			if position then
				mark.LastPosition = position
			end
			local target = mark.LastPosition
			if target then
				local relative = camera.CFrame:PointToObjectSpace(target)
				local angle = math.atan2(relative.X, -relative.Z) -- 0 = delante (arriba en pantalla)
				mark.Frame.Position = UDim2.new(0.5, math.sin(angle) * RADIUS, 0.5, -math.cos(angle) * RADIUS)
				mark.Frame.Rotation = math.deg(angle)
				mark.Frame.Visible = true
			else
				mark.Frame.Visible = false
			end
			-- Se desvanece en el último tramo
			local fade = math.clamp((age - FADE_TIME * 0.45) / (FADE_TIME * 0.55), 0, 1)
			mark.Frame.BackgroundTransparency = fade
			local arrow = mark.Frame:FindFirstChildOfClass("TextLabel")
			if arrow then
				arrow.TextTransparency = fade
			end
		end
	end
end

local function watch(character)
	clear()
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid or not humanoid:IsA("Humanoid") then
		return
	end
	humanoid:GetAttributeChangedSignal("LastHitTime"):Connect(function()
		onHit(humanoid)
	end)
end

function DamageIndicator.Init()
	gui = UI.new("ScreenGui", {
		Name = "DamageIndicator",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 4,
		Parent = player:WaitForChild("PlayerGui"),
	})
	holder = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
	player.CharacterAdded:Connect(watch)
	if player.Character then
		task.spawn(watch, player.Character)
	end
	RunService.RenderStepped:Connect(update)
end

return DamageIndicator
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="151">
            <Properties>
              <string name="Name">DeathScreen</string>
              <string name="Source"><![CDATA[-- Pantalla de muerte (estilo shooters de Roblox):
--   * Observas al que te eliminó en tercera persona (clic / clic derecho cambia de jugador)
--   * VOLVER AL MENÚ, REVIVIR INSTANTÁNEO (B, gasta un revivir: vuelves donde caíste) y
--     REGENERAR AHORA (Espacio o F, a partir de GameConfig.RespawnNowDelay)
-- Sin revivir disponibles, el botón abre la compra del pack (si está configurado en Shop).
-- En plena ronda de Eliminación (NoRespawn) no hay revivir ni regenerar: se observa hasta la siguiente.
-- También se puede observar a los bots (modelos en workspace.Bots).
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Shop = require(Shared.Shop)
local MonetizationConfig = require(Shared.Economy.MonetizationConfig)
local Sounds = require(Shared.Sounds)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))
local Killcam = require(script.Parent.Killcam)
local MainMenu = require(script.Parent.MainMenu)
local Menu = require(script.Parent.Menu)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local DeathScreen = {}

local gui: any = nil
local refs: { [string]: any } = {}
local deathTime = 0
local targets = {} -- jugadores (Player) o bots (Model) que se pueden observar
local targetIndex = 0
local spectating = nil -- Player o bot observado
local reviving = false
local originalZoom = { 0.5, 400 } -- zoom de la cámara del jugador (se restaura al reaparecer)

local BLUE = Color3.fromRGB(40, 140, 255)
local PINK = Color3.fromRGB(255, 70, 200)
local GREEN = Color3.fromRGB(70, 220, 60)

-- Personaje de un objetivo: el Character de un jugador o el propio modelo de un bot
local function characterOf(target)
	if target:IsA("Player") then
		return target.Character
	end
	return target.Parent and target or nil
end

local function teamOf(target)
	if target:IsA("Player") then
		return target.Team
	end
	local name = target:GetAttribute("Team")
	local team = name and name ~= "" and Teams:FindFirstChild(name)
	return team and team:IsA("Team") and team or nil
end

local function alive(p)
	local character = characterOf(p)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0, humanoid
end

local function noRespawn()
	return ReplicatedStorage:GetAttribute("NoRespawn") == true
end

-- Cámara en tercera persona detrás del jugador observado
local function watch(target)
	spectating = target
	local ok, humanoid = alive(target)
	if not ok then
		return
	end
	player.CameraMode = Enum.CameraMode.Classic
	player.CameraMinZoomDistance = 10
	player.CameraMaxZoomDistance = 14
	camera.CameraType = Enum.CameraType.Custom
	camera.CameraSubject = humanoid
	refs.SpectateName.Text = target:IsA("Player") and (target.DisplayName .. " (" .. target.Name .. ")") or target.Name
	refs.SpectatePanel.Visible = true
end

local function stopWatching()
	spectating = nil
	refs.SpectatePanel.Visible = false
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

local function restoreCamera()
	player.CameraMinZoomDistance = originalZoom[1]
	player.CameraMaxZoomDistance = originalZoom[2]
	player.CameraMode = Enum.CameraMode.LockFirstPerson
end

-- En Eliminación solo se observa a compañeros (si no, se podría chivar dónde están los enemigos)
local function canWatch(target)
	if target:IsA("Player") and target:GetAttribute("InMenu") then
		return false
	end
	if noRespawn() and player.Team then
		return teamOf(target) == player.Team
	end
	return true
end

local function refreshTargets(firstChoice)
	targets = {}
	for _, p in Players:GetPlayers() do
		if p ~= player and alive(p) and canWatch(p) then
			table.insert(targets, p)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			if model:IsA("Model") and alive(model) and canWatch(model) then
				table.insert(targets, model)
			end
		end
	end
	-- Primero el que te eliminó, luego tus compañeros
	local function rank(p)
		if p == firstChoice then
			return 0
		end
		return (player.Team and teamOf(p) == player.Team) and 1 or 2
	end
	table.sort(targets, function(a, b)
		return rank(a) < rank(b)
	end)
end

---------------------------------------------------------------------------
-- Killcam al morir (ver Killcam): unos segundos desde los ojos del que te eliminó, mirando hacia donde
-- estabas. Luego sigue la pantalla de muerte de siempre (observar al que te eliminó). Clic o toque:
-- saltarla. No hay en los modos de una sola vida (enseñaría en directo dónde está el enemigo) ni con
-- granadas o ataques aéreos, ni si al morir no había línea de visión (se vería una pared).
---------------------------------------------------------------------------
DeathScreen.KillcamEnabled = true

local spectateAfterKillcam -- (se define más abajo)

-- Empieza la repetición si hay suficiente historia del que te eliminó; si no, devuelve false
local function startKillcam(target, weaponName)
	if not DeathScreen.KillcamEnabled or not target or noRespawn() then
		return false
	end
	if weaponName == "Grenade" or weaponName == "Airstrike" then
		return false
	end
	local killerModel = characterOf(target)
	local myModel = player.Character
	if not killerModel or not myModel or killerModel == myModel then
		return false
	end
	local started = Killcam.Play({
		Killer = killerModel,
		Victim = myModel,
		At = deathTime,
		Title = "▶ KILLCAM",
		Name = Killcam.Caption(target, weaponName),
		CheckSight = true,
		OnEnd = function()
			if ClientState.Dead then
				spectateAfterKillcam(target)
			end
		end,
	})
	if started then
		refs.SpectatePanel.Visible = false
	end
	return started
end

DeathScreen.KillcamActive = function()
	return Killcam.Active()
end

local function cycle(step)
	-- (durante la killcam, el clic la salta)
	if Killcam.Active() then
		Killcam.Stop(true)
		return
	end
	refreshTargets(spectating)
	if #targets == 0 then
		stopWatching()
		return
	end
	local current = spectating and table.find(targets, spectating) or 0
	targetIndex = ((current - 1 + step) % #targets) + 1
	watch(targets[targetIndex])
end

local function revivesLeft()
	local data = ClientState.Data
	return data and data.Revives or 0
end

local function toast(text)
	refs.Toast.Text = text
	refs.Toast.Visible = true
	task.delay(2, function()
		if refs.Toast.Text == text then
			refs.Toast.Visible = false
		end
	end)
end

local function tryRevive()
	if not ClientState.Dead or reviving then
		return
	end
	if noRespawn() then
		toast("Una sola vida por ronda")
		return
	end
	if revivesLeft() <= 0 then
		-- (revivir donde caíste es ventaja en combate: ya no se vende con Robux, solo se gana jugando)
		local pack = Shop.RevivePacks[1]
		if MonetizationConfig.Rules.SellRevives and pack and pack.ProductId ~= 0 then
			MarketplaceService:PromptProductPurchase(player, pack.ProductId)
		else
			toast("No te quedan revivir")
		end
		return
	end
	reviving = true
	Sounds.Play("Click")
	local ok, result, reason = pcall(function()
		return Remotes.InstantRevive:InvokeServer()
	end)
	reviving = false
	if not ok or not result then
		toast(reason or "No se pudo revivir")
	end
end

local function respawnNow()
	if ClientState.Dead and os.clock() - deathTime >= GameConfig.RespawnNowDelay and not noRespawn() then
		Sounds.Play("Click")
		Remotes.RespawnNow:FireServer()
	end
end

local function close()
	-- (la killcam final del servidor sigue aunque reaparezcas; la de tu muerte no)
	if not ClientState.KillcamFinal then
		Killcam.Stop(false)
	end
	if not ClientState.Dead then
		return
	end
	ClientState.Dead = false
	gui.Enabled = false
	stopWatching()
	restoreCamera()
	ClientState.UpdateMouse()
end

local function open(killerName, weaponName)
	ClientState.Dead = true
	-- La tienda se cierra al morir (si no, la B que iba a cerrarla gastaría un revivir)
	Menu.Close()
	deathTime = os.clock()
	gui.Enabled = true
	refs.Toast.Visible = false
	ClientState.UpdateMouse()
	local bots = workspace:FindFirstChild("Bots")
	local killer = killerName and (Players:FindFirstChild(killerName) or (bots and bots:FindFirstChild(killerName)))
	-- Primero la killcam (si hay con qué); al acabar, a observar como siempre
	if killer and startKillcam(killer, weaponName) then
		return
	end
	spectateAfterKillcam(killer)
end

function spectateAfterKillcam(killer)
	refreshTargets(killer)
	if killer and alive(killer) and canWatch(killer) then
		watch(killer)
	elseif #targets > 0 then
		watch(targets[1])
	else
		refs.SpectatePanel.Visible = false
	end
end

-- Botón grande con texto encima ("Presiona B") y barra debajo
local function actionButton(text, hint, color, x)
	local holder = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, x, 1, -150),
		Size = UDim2.fromOffset(280, 110),
		BackgroundTransparency = 1,
		Parent = refs.Bottom,
	})
	if hint then
		UI.label({
			Size = UDim2.new(1, 0, 0, 26),
			Text = hint,
			TextSize = 22,
			Parent = holder,
		})
	end
	local button = UI.button({
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, 58),
		Text = text,
		TextSize = 26,
		BackgroundColor3 = color,
		Parent = holder,
	}, { UI.stroke(Color3.new(1, 1, 1), 3, 0), UI.gloss() })
	local bar = UI.new("Frame", {
		Position = UDim2.fromOffset(6, 92),
		Size = UDim2.new(1, -12, 0, 14),
		BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.65),
		Parent = holder,
	}, { UI.corner(7) })
	local fill = UI.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = color,
		Parent = bar,
	}, { UI.corner(7) })
	return holder, button, fill
end

local function build()
	gui = UI.new("ScreenGui", {
		Name = "DeathScreen",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 3,
		Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- Libera el ratón aunque la cámara esté en primera persona
	UI.new("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true, Parent = gui })

	refs.Bottom = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
	local scale = UI.new("UIScale", { Parent = refs.Bottom })
	local function rescale()
		local size = camera.ViewportSize
		scale.Scale = math.clamp(math.min(size.X / 1280, size.Y / 720), 0.55, 1)
	end
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()

	local _, menuButton = actionButton("VOLVER AL MENÚ", nil, BLUE, -300)
	local reviveHolder, reviveButton, reviveFill = actionButton("REVIVIR INSTANTÁNEO", "Presiona B", PINK, 0)
	local respawnHolder, respawnButton, respawnFill = actionButton("REGENERAR AHORA", "Presiona Espacio o F", GREEN, 300)
	refs.ReviveButton, refs.ReviveFill, refs.RespawnButton, refs.RespawnFill = reviveButton, reviveFill, respawnButton, respawnFill
	refs.ReviveHolder, refs.RespawnHolder = reviveHolder, respawnHolder
	-- Eliminación: en lugar de revivir/regenerar, un aviso
	refs.WaitLabel = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 150, 1, -170),
		Size = UDim2.fromOffset(560, 60),
		Text = "UNA VIDA POR RONDA\nEspera a la siguiente ronda",
		TextSize = 26,
		TextColor3 = Color3.fromRGB(255, 220, 90),
		Visible = false,
		Parent = refs.Bottom,
	})

	-- Corazón con alas y "N restantes"
	refs.ReviveBadge = UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, -6, 0, 22),
		Size = UDim2.fromOffset(150, 30),
		Rotation = -14,
		Text = "",
		TextSize = 22,
		TextColor3 = Color3.new(1, 1, 1),
		Parent = reviveHolder,
	})
	UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, -2, 0, 58),
		Size = UDim2.fromOffset(60, 60),
		Text = "💖",
		TextSize = 48,
		Parent = reviveHolder,
	})

	menuButton.Activated:Connect(function()
		Sounds.Play("Click")
		close()
		MainMenu.Show()
	end)
	reviveButton.Activated:Connect(tryRevive)
	respawnButton.Activated:Connect(respawnNow)

	-- Panel de observar (izquierda)
	refs.SpectatePanel = UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 30, 0.5, 20),
		Size = UDim2.fromOffset(440, 220),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = refs.Bottom,
	})
	refs.SpectateName = UI.label({
		Size = UDim2.new(1, 0, 0, 40),
		Text = "",
		TextSize = 32,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = refs.SpectatePanel,
	})
	local touchOnly = InputMode.TouchUI()
	UI.label({
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(1, 0, 0, 26),
		-- (en táctil se cambia con las flechas: tocar la pantalla solo salta la killcam)
		Text = touchOnly and "Toca las flechas para cambiar" or "Haz clic / clic derecho para cambiar",
		TextSize = 20,
		TextColor3 = Color3.fromRGB(215, 215, 230),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = refs.SpectatePanel,
	})
	local stop = UI.button({
		Position = UDim2.fromOffset(0, 90),
		Size = UDim2.fromOffset(230, 46),
		Text = "DEJAR DE OBSERVAR",
		TextSize = 20,
		BackgroundColor3 = Color3.fromRGB(230, 50, 60),
		Parent = refs.SpectatePanel,
	}, { UI.stroke(Color3.new(1, 1, 1), 2, 0), UI.gloss() })
	stop.Activated:Connect(function()
		Sounds.Play("Click")
		stopWatching()
	end)
	-- Táctil (Fase 17): flechas para cambiar a quién observas (antes no había forma en el móvil)
	if touchOnly then
		for i, step in { -1, 1 } do
			local arrow = UI.button({
				Name = step < 0 and "PrevTarget" or "NextTarget",
				Position = UDim2.fromOffset(240 + (i - 1) * 62, 90),
				Size = UDim2.fromOffset(54, 46),
				Text = step < 0 and "◀" or "▶",
				TextSize = 22,
				BackgroundColor3 = Color3.fromRGB(40, 44, 56),
				Parent = refs.SpectatePanel,
			}, { UI.stroke(Color3.new(1, 1, 1), 2, 0.4) })
			arrow.Activated:Connect(function()
				Sounds.Play("Click")
				cycle(step)
			end)
		end
	end

	refs.Toast = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -270),
		Size = UDim2.fromOffset(500, 34),
		Text = "",
		TextSize = 26,
		TextColor3 = Color3.fromRGB(255, 120, 140),
		Visible = false,
		Parent = refs.Bottom,
	})
end

local function update()
	if not ClientState.Dead then
		return
	end
	local oneLife = noRespawn()
	refs.ReviveHolder.Visible = not oneLife
	refs.RespawnHolder.Visible = not oneLife
	refs.WaitLabel.Visible = oneLife
	local elapsed = os.clock() - deathTime
	-- Revivir: la barra se vacía mientras queda tiempo para usarlo
	local reviveWindow = math.clamp(1 - elapsed / GameConfig.RespawnTime, 0, 1)
	refs.ReviveFill.Size = UDim2.fromScale(reviveWindow, 1)
	local left = revivesLeft()
	refs.ReviveBadge.Text = left > 0 and (left .. " restantes") or (MonetizationConfig.Rules.SellRevives and "¡Consigue más!" or "Se ganan jugando")
	refs.ReviveButton.AutoButtonColor = reviveWindow > 0
	-- Regenerar: la barra se llena hasta que se puede pulsar
	local charge = math.clamp(elapsed / GameConfig.RespawnNowDelay, 0, 1)
	refs.RespawnFill.Size = UDim2.fromScale(charge, 1)
	refs.RespawnButton.BackgroundTransparency = charge >= 1 and 0 or 0.35
	-- Si el observado muere o se va, pasa al siguiente
	if spectating and not alive(spectating) then
		cycle(1)
	end
end

function DeathScreen.Init()
	originalZoom = { player.CameraMinZoomDistance, player.CameraMaxZoomDistance }
	build()
	Remotes.Died.OnClientEvent:Connect(open)
	-- Fin de partida: la pantalla final ocupa todo (si no, esta se quedaría debajo de la escena)
	ReplicatedStorage:GetAttributeChangedSignal("State"):Connect(function()
		if ReplicatedStorage:GetAttribute("State") == "Ended" and ClientState.ResultsScreen then
			close()
		end
	end)
	player.CharacterAdded:Connect(function(character)
		close()
		local humanoid = character:WaitForChild("Humanoid", 5)
		if humanoid and not ClientState.InMainMenu then
			camera.CameraType = Enum.CameraType.Custom
			camera.CameraSubject = humanoid
		end
	end)
	-- Las teclas B, F y Espacio están enlazadas con ContextActionService (menú, cuchillo, salto), así que
	-- llegan marcadas como "procesadas": solo se ignoran si se está escribiendo en el chat. Los clics sí se
	-- ignoran cuando caen sobre un botón de la interfaz.
	UserInputService.InputBegan:Connect(function(input, processed)
		if not ClientState.Dead or UserInputService:GetFocusedTextBox() then
			return
		end
		local isClick = input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2
			or input.UserInputType == Enum.UserInputType.Touch
		if isClick and processed then
			return
		end
		-- (en el móvil, tocar la pantalla salta la killcam)
		if input.UserInputType == Enum.UserInputType.Touch then
			if Killcam.Active() then
				Killcam.Stop(true)
			end
			return
		end
		if input.KeyCode == Enum.KeyCode.B or input.KeyCode == Enum.KeyCode.ButtonY then
			-- No gasta un revivir si la B era para cerrar la tienda
			if not ClientState.MenuOpen and os.clock() - ClientState.MenuClosedAt > 1 then
				tryRevive()
			end
		elseif input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.ButtonA then
			respawnNow()
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonR1 then
			cycle(1)
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 or input.KeyCode == Enum.KeyCode.ButtonL1 then
			cycle(-1)
		end
	end)
	RunService.RenderStepped:Connect(update)
	-- Muerto en Eliminación y de vuelta desde la pantalla de inicio: vuelve a la pantalla de muerte
	-- (se observa a los compañeros hasta la siguiente ronda en vez de quedarse mirando el cuerpo)
	RunService.Heartbeat:Connect(function()
		if ClientState.Dead or ClientState.InMainMenu or not noRespawn() then
			return
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health <= 0 then
			open(nil)
		end
	end)
end

return DeathScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="152">
            <Properties>
              <string name="Name">DominationHUD</string>
              <string name="Source"><![CDATA[-- Dominio: las tres banderas (A, B, C) arriba, debajo del marcador. Cada una con el color de su
-- dueño, una barra con la captura en curso (del color de quien la captura) y "!" si está disputada.
-- Pantalla táctil (Fase 12): arriba a la izquierda, bajo el minimapa y más pequeñas, para dejar libre
-- el centro (la mira) y lo de arriba en el centro (marcador y avisos de baja).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Teams = game:GetService("Teams")
local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))

local UI = require(script.Parent.UI)
local ClientState = require(script.Parent.ClientState)
local HUDZones = require(script.Parent.HUDZones)

local player = Players.LocalPlayer

local DominationHUD = {}

local LETTERS = { "A", "B", "C" }
local NEUTRAL = Color3.fromRGB(70, 72, 80)

local gui
local row
local badges = {}
local touchUI = false
local placedAt

-- Táctil: bajo el minimapa; si ahí tocaría los botones de habilidades (pantallas muy bajas), a la
-- derecha del minimapa
local function placeTouch()
	local top = ClientState.MinimapBottom or 156
	local key = top
	local ok, TouchLayout = pcall(require, script.Parent.TouchLayout)
	local dashTop
	if ok then
		local center, size = TouchLayout.Rect("AbilityDash")
		if center and size then
			dashTop = center.Y - size.Y / 2
			key ..= ":" .. math.floor(dashTop)
		end
	end
	if key == placedAt then
		return
	end
	placedAt = key
	local height = 46 * 0.65
	row.AnchorPoint = Vector2.new(0, 0)
	if dashTop and top + 6 + height > dashTop - 6 then
		row.Position = UDim2.fromOffset((ClientState.MinimapLeft or 14) + (ClientState.MinimapSize or 96) + 8, 60)
	else
		row.Position = UDim2.fromOffset(ClientState.MinimapLeft or 14, top + 6)
	end
end

local function teamColor(name)
	local team = name ~= "" and Teams:FindFirstChild(name or "")
	return team and team:IsA("Team") and team.TeamColor.Color or nil
end

local function update()
	local active = ReplicatedStorage:GetAttribute("Dom_A_Position") ~= nil
	gui.Enabled = active and not ClientState.InMainMenu
	if not gui.Enabled then
		return
	end
	if touchUI and not HUDZones.Enabled() then
		placeTouch()
	end
	for _, letter in LETTERS do
		local badge = badges[letter]
		local prefix = "Dom_" .. letter .. "_"
		local owner = ReplicatedStorage:GetAttribute(prefix .. "Owner") or ""
		local capturing = ReplicatedStorage:GetAttribute(prefix .. "Capturing") or ""
		local progress = ReplicatedStorage:GetAttribute(prefix .. "Progress") or 0
		local contested = ReplicatedStorage:GetAttribute(prefix .. "Contested") == true
		badge.Box.BackgroundColor3 = teamColor(owner) or NEUTRAL
		local mine = player.Team and owner == player.Team.Name
		badge.Stroke.Color = mine and Color3.fromRGB(255, 255, 255) or Color3.new(0, 0, 0)
		badge.Bar.Visible = capturing ~= "" and progress > 0
		badge.Bar.Size = UDim2.new(progress, 0, 0, 5)
		badge.Bar.BackgroundColor3 = teamColor(capturing) or Color3.new(1, 1, 1)
		badge.Label.Text = contested and (letter .. "!") or letter
		badge.Label.TextColor3 = contested and Color3.fromRGB(255, 210, 60) or Color3.new(1, 1, 1)
	end
end

function DominationHUD.Init()
	gui = UI.new("ScreenGui", {
		Name = "DominationHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 2,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	row = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 118),
		Size = UDim2.fromOffset(3 * 46 + 2 * 8, 46),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}),
	})
	touchUI = InputMode.TouchUI()
	if touchUI then
		UI.new("UIScale", { Scale = 0.65, Parent = row })
		row:FindFirstChildOfClass("UIListLayout").HorizontalAlignment = Enum.HorizontalAlignment.Left
		-- (Fase 16: su sitio lo da la zona de arriba a la izquierda, bajo el minimapa)
		HUDZones.Register("DomFlags", row, "TOP_LEFT", 1, { Gui = gui })
	end
	for i, letter in LETTERS do
		local stroke = UI.stroke(Color3.new(0, 0, 0), 2, 0)
		local box = UI.new("Frame", {
			Name = letter,
			LayoutOrder = i,
			Size = UDim2.fromOffset(46, 46),
			BackgroundColor3 = NEUTRAL,
			Parent = row,
		}, { UI.corner(10), stroke })
		local label = UI.label({
			Size = UDim2.new(1, 0, 1, -4),
			Text = letter,
			TextSize = 28,
			Parent = box,
		})
		local bar = UI.new("Frame", {
			Position = UDim2.new(0, 0, 1, -5),
			Size = UDim2.new(0, 0, 0, 5),
			BorderSizePixel = 0,
			Visible = false,
			Parent = box,
		})
		badges[letter] = { Box = box, Label = label, Bar = bar, Stroke = stroke }
	end
	task.spawn(function()
		while gui.Parent do
			update()
			task.wait(0.15)
		end
	end)
end

DominationHUD.Update = update

return DominationHUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="153">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[-- Efectos visuales (solo en el cliente): fogonazo, balas trazadoras, impactos, casquillos y bajas.
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))

local ClientState = require(script.Parent.ClientState)
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Sounds = require(ReplicatedStorage.Shared.Sounds)
local WeaponFeel = require(ReplicatedStorage.Shared.WeaponFeel)

local Effects = {}

-- Presupuesto de efectos de las armas según la calidad (y recortado en móvil): WeaponFeel.Quality.
-- Nunca cambia el hitmarker, los avisos de baja ni los impactos sobre personas (es información).
local budgetCache, budgetKey = nil, nil
local function budget()
	local mobile = InputMode.TouchUI()
	local key = tostring(ClientState.EffectiveQuality) .. (mobile and "|m" or "")
	if key ~= budgetKey then
		budgetKey = key
		budgetCache = WeaponFeel.Budget(ClientState.EffectiveQuality, mobile)
	end
	return budgetCache
end
Effects.Budget = budget

-- Cuántas partículas emitir con el presupuesto (al menos 1 si había alguna)
local function scaled(count, factor)
	if count <= 0 or factor <= 0 then
		return 0
	end
	return math.max(1, math.floor(count * factor + 0.5))
end

-- Lo pone CombatFX: se llama con la fuerza (0..1) cuando una explosión estalla muy cerca de la cámara
Effects.OnConcussion = nil :: ((number) -> ())?

-- Texturas de partículas incluidas con Roblox
local TEX = {
	Fire = "rbxasset://textures/particles/fire_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
}

local folder = Instance.new("Folder")
folder.Name = "ClientFX"
folder.Parent = workspace

-- ¿Mapa realista? (atributo Realistic del mapa; con el estilo Realista, todos). Ahí los impactos en
-- personas y la baja normal son realistas en vez de destellos de colores
local function realisticMap()
	local map = workspace:FindFirstChild("Map")
	return map ~= nil and map:GetAttribute("Realistic") == true
end

local function fxPart(props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	for key, value in props do
		part[key] = value
	end
	part.Parent = folder
	return part
end

-- lookAt que no falla cuando la dirección es vertical (por ejemplo, impactos en el suelo)
local function safeLookAt(position, direction)
	local up = math.abs(direction.Unit.Y) > 0.99 and Vector3.zAxis or Vector3.yAxis
	return CFrame.lookAt(position, position + direction, up)
end

local function seq(a, b)
	return NumberSequence.new({ NumberSequenceKeypoint.new(0, a), NumberSequenceKeypoint.new(1, b) })
end

-- Pieza invisible que sirve de emisor; su +Y apunta hacia `direction`
local function emitterAnchor(position, direction, lifetime)
	direction = (direction and direction.Magnitude > 0.01) and direction.Unit or Vector3.yAxis
	local anchor = fxPart({
		Size = Vector3.new(0.1, 0.1, 0.1),
		Transparency = 1,
		CFrame = safeLookAt(position, direction) * CFrame.Angles(-math.pi / 2, 0, 0),
	})
	Debris:AddItem(anchor, lifetime or 2)
	return anchor
end

local function emit(parent, props, count)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Enabled = false
	emitter.EmissionDirection = Enum.NormalId.Top
	for key, value in props do
		emitter[key] = value
	end
	emitter.Parent = parent
	emitter:Emit(count)
	return emitter
end

-- Reutilización para los efectos de cada disparo: en un tiroteo se creaban decenas de piezas y
-- emisores por segundo (y cada uno avisaba a Settings). Ahora hay un juego de anclas que se van
-- turnando, cada una con sus emisores guardados por tipo; las partículas ya emitidas no se mueven
-- al recolocar el ancla (están en el mundo).
local ANCHOR_POOL = 24
local anchorPool, anchorIndex = {}, 0
local emitterCache = {} -- [ancla] = { [tipo] = ParticleEmitter }

local function pooledAnchor(position, direction)
	direction = (direction and direction.Magnitude > 0.01) and direction.Unit or Vector3.yAxis
	anchorIndex = anchorIndex % ANCHOR_POOL + 1
	local anchor = anchorPool[anchorIndex]
	if not anchor or not anchor.Parent then
		if anchor then
			emitterCache[anchor] = nil
		end
		anchor = fxPart({ Name = "FXAnchor", Size = Vector3.new(0.1, 0.1, 0.1), Transparency = 1 })
		anchorPool[anchorIndex] = anchor
		emitterCache[anchor] = {}
	end
	anchor.CFrame = safeLookAt(position, direction) * CFrame.Angles(-math.pi / 2, 0, 0)
	return anchor
end

-- Como emit, pero con el emisor guardado en el ancla (se crea la primera vez; el color se actualiza)
local function emitPooled(anchor, key, props, count)
	local cache = emitterCache[anchor]
	if not cache then
		return emit(anchor, props, count)
	end
	local emitter = cache[key]
	if not emitter then
		emitter = emit(anchor, props, 0)
		cache[key] = emitter
	elseif props.Color then
		emitter.Color = props.Color
	end
	emitter:Emit(count)
	return emitter
end

-- Piezas que se reutilizan por turnos (trazadoras y marcas de bala)
local function partRing(size)
	return { Parts = {}, Index = 0, Size = size, Tokens = {} }
end
local function ringPart(ring, props)
	ring.Index = ring.Index % ring.Size + 1
	local part = ring.Parts[ring.Index]
	if not part or not part.Parent then
		part = fxPart(props)
		ring.Parts[ring.Index] = part
	else
		for key, value in props do
			part[key] = value
		end
	end
	local token = (ring.Tokens[ring.Index] or 0) + 1
	ring.Tokens[ring.Index] = token
	return part, ring.Index, token
end
-- Oculta la pieza al acabar, si nadie la ha reutilizado mientras tanto
local function hideLater(ring, index, token, delay)
	task.delay(delay, function()
		local part = ring.Parts[index]
		if ring.Tokens[index] == token and part then
			part.Transparency = 1
		end
	end)
end
-- Marcas de bala: duran 5 s y como mucho MAX_MARKS a la vez (WeaponFeel.Quality.BulletMarks: 50 en
-- Alta, 30 en Media, 20 en móvil, ninguna en Baja). Al pasarse se reutiliza la más antigua.
local MAX_MARKS = 50
local bulletRing, trailRing, markRing, chipRing = partRing(30), partRing(30), partRing(MAX_MARKS), partRing(MAX_MARKS)

---------------------------------------------------------------------------

-- Trazadoras de verdad (mapas realistas): como la munición trazadora, una de cada tres balas deja
-- una raya brillante de color cálido; las demás, solo un destello tenue y rapidísimo
local TRACER_WARM = Color3.fromRGB(255, 196, 128)
local tracerCount = 0
local function realisticTracer(from, to, distance)
	tracerCount += 1
	local bright = tracerCount % 3 == 1
	local direction = safeLookAt(from, to - from)
	if bright then
		local trail = ringPart(trailRing, {
			Color = TRACER_WARM,
			Size = Vector3.new(0.025, 0.025, distance),
			CFrame = direction * CFrame.new(0, 0, -distance / 2),
			Transparency = 0.82,
		})
		TweenService:Create(trail, TweenInfo.new(0.07), { Transparency = 1 }):Play()
	end
	local length = math.min(bright and 5 or 3, distance)
	local travel = math.max(distance - length, 0.01)
	local duration = math.clamp(distance / 1400, 0.015, 0.2)
	local bullet, index, token = ringPart(bulletRing, {
		Color = bright and TRACER_WARM or Color3.fromRGB(255, 236, 205),
		Size = Vector3.new(bright and 0.07 or 0.04, bright and 0.07 or 0.04, length),
		CFrame = direction * CFrame.new(0, 0, -length / 2),
		Transparency = bright and 0.05 or 0.6,
	})
	TweenService
		:Create(bullet, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = direction * CFrame.new(0, 0, -length / 2 - travel) })
		:Play()
	hideLater(bulletRing, index, token, duration + 0.02)
end

-- Bala trazadora que viaja desde el cañón hasta el impacto, con una estela tenue
function Effects.Tracer(from, to, color)
	local distance = (to - from).Magnitude
	if distance < 1 then
		return
	end
	if realisticMap() then
		realisticTracer(from, to, distance)
		return
	end
	color = color or Color3.fromRGB(255, 230, 120)
	local direction = safeLookAt(from, to - from)

	-- Estela fina que se desvanece
	local trail = ringPart(trailRing, {
		Color = color,
		Size = Vector3.new(0.03, 0.03, distance),
		CFrame = direction * CFrame.new(0, 0, -distance / 2),
		Transparency = 0.6,
	})
	TweenService:Create(trail, TweenInfo.new(0.1), { Transparency = 1 }):Play()

	-- La bala
	local length = math.min(6, distance)
	local travel = math.max(distance - length, 0.01)
	local duration = math.clamp(distance / 900, 0.02, 0.25)
	local bullet, index, token = ringPart(bulletRing, {
		Color = color,
		Size = Vector3.new(0.12, 0.12, length),
		CFrame = direction * CFrame.new(0, 0, -length / 2),
		Transparency = 0,
	})
	TweenService
		:Create(bullet, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = direction * CFrame.new(0, 0, -length / 2 - travel) })
		:Play()
	hideLater(bulletRing, index, token, duration + 0.02)
end

-- Fogonazo realista: cada disparo distinto (3-5 lenguas de fuego cortas de distinto largo alrededor
-- del cañón, un núcleo casi blanco de un fotograma, un cono de llama hacia delante), un golpe de luz
-- cálida y un humo gris que se queda flotando un momento
local FLASH_WARM = Color3.fromRGB(255, 190, 105)
-- (piezas reutilizadas: en un tiroteo serían decenas de piezas nuevas por segundo)
local flashRing, flashBallRing = partRing(60), partRing(16)
local flashLight, flashLightToken = nil, 0
local function realisticFlash(cf, remote, flash)
	local scale = (0.7 + math.random() * 0.55) * flash.Scale
	local life = flash.Duration
	local spin = math.random() * math.pi * 2
	local prongs = remote and 3 or math.random(3, 5)
	for i = 1, prongs do
		local angle = spin + (i + (math.random() - 0.5) * 0.4) * (math.pi * 2 / prongs)
		local length = (0.22 + math.random() * 0.3) * scale
		local _, index, token = ringPart(flashRing, {
			Color = FLASH_WARM:Lerp(Color3.new(1, 1, 1), 0.3),
			Size = Vector3.new(0.045 * scale, length, 0.1 * scale),
			CFrame = cf * CFrame.new(0, 0, -0.1) * CFrame.Angles(0, 0, angle) * CFrame.new(0, length / 2, 0),
			Transparency = 0.1 + math.random() * 0.3,
		})
		hideLater(flashRing, index, token, life * 0.875)
	end
	local flameLength = (0.35 + math.random() * 0.35) * scale
	local _, flameIndex, flameToken = ringPart(flashRing, {
		Color = FLASH_WARM,
		Size = Vector3.new(0.13 * scale, 0.13 * scale, flameLength),
		CFrame = cf * CFrame.new(0, 0, -0.08 - flameLength / 2),
		Transparency = 0.2 + math.random() * 0.2,
	})
	hideLater(flashRing, flameIndex, flameToken, life * 0.875)
	local _, coreIndex, coreToken = ringPart(flashBallRing, {
		Color = Color3.fromRGB(255, 244, 214),
		Size = Vector3.one * (0.2 + math.random() * 0.1) * scale,
		Shape = Enum.PartType.Ball,
		CFrame = cf * CFrame.new(0, 0, -0.1),
		Transparency = 0.05,
	})
	hideLater(flashBallRing, coreIndex, coreToken, life * 1.1)
	-- Golpe de luz (solo los tuyos): una sola luz que se mueve al cañón y se apaga enseguida
	-- (en calidad Baja, sin luz: el fogonazo se sigue viendo)
	if not remote and flash.Light > 0 and budget().MuzzleLight ~= false then
		local holderPart = flashLight and flashLight.Parent
		if not holderPart or not holderPart.Parent then
			local holder = fxPart({ Name = "FlashLight", Size = Vector3.one * 0.1, Transparency = 1 })
			flashLight = Instance.new("PointLight")
			flashLight.Color = FLASH_WARM
			flashLight.Brightness = 5
			flashLight.Parent = holder
		end
		local holder = flashLight.Parent :: BasePart
		holder.CFrame = cf * CFrame.new(0, 0, -0.15)
		flashLight.Range = (13 + math.random() * 5) * flash.Light
		flashLight.Enabled = true
		flashLightToken += 1
		local token = flashLightToken
		task.delay(life * 1.1, function()
			if flashLightToken == token and flashLight then
				flashLight.Enabled = false
			end
		end)
	end

	local anchor = pooledAnchor(cf.Position, cf.LookVector)
	emitPooled(anchor, "MuzzleFireReal", {
		Texture = TEX.Fire,
		Color = ColorSequence.new(Color3.fromRGB(255, 236, 190), FLASH_WARM),
		LightEmission = 1,
		Size = seq(0.3, 0),
		Transparency = seq(0.1, 1),
		Lifetime = NumberRange.new(0.03, 0.06),
		Speed = NumberRange.new(5, 10),
		SpreadAngle = Vector2.new(8, 8),
	}, scaled(4, budget().FlashParticles))
	if not budget().MuzzleSmoke or flash.Smoke <= 0 then
		return
	end
	emitPooled(anchor, "MuzzleSmokeReal", {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(Color3.fromRGB(205, 205, 200), Color3.fromRGB(170, 170, 165)),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.15),
			NumberSequenceKeypoint.new(0.4, 0.8),
			NumberSequenceKeypoint.new(1, 1.6),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.75),
			NumberSequenceKeypoint.new(0.3, 0.8),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(0.7, 1.3),
		Speed = NumberRange.new(1.5, 3.5),
		Drag = 3,
		RotSpeed = NumberRange.new(-40, 40),
		Rotation = NumberRange.new(0, 360),
		SpreadAngle = Vector2.new(14, 14),
		Acceleration = Vector3.new(0, 1.2, 0),
	}, remote and 1 or scaled(2, flash.Smoke))
end

-- Fogonazo: estrella de luz, llamas y humo. remote = disparo de otro (más barato: sin luz ni estrella).
-- flash = perfil del arma (WeaponFeel: tamaño, duración, luz y humo); sin él, el del fusil
local DEFAULT_FLASH = WeaponFeel.Get(WeaponFeel.ReferenceWeapon).Flash
function Effects.MuzzleFlash(attachment, color, remote, flash)
	if not attachment then
		return
	end
	flash = flash or DEFAULT_FLASH
	if flash.Scale <= 0 then
		return -- (ballesta: sin fogonazo)
	end
	color = color or Color3.fromRGB(255, 200, 90)
	local cf = attachment.WorldCFrame
	if realisticMap() then
		realisticFlash(cf, remote, flash)
		return
	end
	local spin = math.random() * math.pi
	local size = flash.Scale
	for i = 0, remote and -1 or 1 do
		local star = fxPart({
			Color = color:Lerp(Color3.new(1, 1, 1), 0.4),
			Size = Vector3.new(0.08, 0.7, 0.3) * size,
			CFrame = cf * CFrame.new(0, 0, -0.2) * CFrame.Angles(0, 0, spin + i * math.pi / 2),
		})
		Debris:AddItem(star, flash.Duration)
	end
	local core = fxPart({
		Color = Color3.fromRGB(255, 240, 200),
		Size = Vector3.new(0.3, 0.3, 0.3) * size,
		Shape = Enum.PartType.Ball,
		CFrame = cf * CFrame.new(0, 0, -0.15),
	})
	if not remote and flash.Light > 0 and budget().MuzzleLight ~= false then
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = 12 * flash.Light
		light.Brightness = 4
		light.Parent = core
	end
	Debris:AddItem(core, flash.Duration * 1.25)

	local anchor = pooledAnchor(cf.Position, cf.LookVector)
	emitPooled(anchor, "MuzzleFire", {
		Texture = TEX.Fire,
		Color = ColorSequence.new(Color3.fromRGB(255, 240, 180), color),
		LightEmission = 1,
		Size = seq(0.45, 0),
		Transparency = seq(0, 1),
		Lifetime = NumberRange.new(0.04, 0.08),
		Speed = NumberRange.new(4, 8),
		SpreadAngle = Vector2.new(12, 12),
	}, scaled(5, budget().FlashParticles))
	if not budget().MuzzleSmoke or flash.Smoke <= 0 then
		return
	end
	emitPooled(anchor, "MuzzleSmoke", {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(Color3.fromRGB(220, 220, 220)),
		Size = seq(0.2, 0.9),
		Transparency = seq(0.6, 1),
		Lifetime = NumberRange.new(0.4, 0.8),
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(20, 20),
		Acceleration = Vector3.new(0, 1.5, 0),
	}, scaled(2, flash.Smoke))
end

-- Tipo de superficie según el material: cambia la reacción al impacto (chispas en metal, astillas
-- en madera, polvo y esquirlas en piedra, tierra o nieve que saltan, salpicadura en agua)
local SURFACE = {}
local SURFACE_BY_NAME = {} -- (también por nombre: en el simulador de pruebas los Enum no son únicos)
for kind, materials in {
	Metal = { "Metal", "CorrodedMetal", "DiamondPlate", "Foil" },
	Wood = { "Wood", "WoodPlanks" },
	Stone = {
		"Concrete", "Brick", "Cobblestone", "Slate", "Granite", "Marble", "Pebble", "Rock", "Basalt", "Limestone",
		"Pavement", "Asphalt", "Plaster", "Sandstone", "CeramicTiles", "ClayRoofTiles", "CrackedLava",
	},
	Dirt = { "Grass", "LeafyGrass", "Ground", "Mud", "Sand" },
	Snow = { "Snow", "Ice", "Glacier" },
	Water = { "Water" },
	Glass = { "Glass" },
} do
	for _, name in materials do
		SURFACE_BY_NAME[name] = kind
		local ok, material = pcall(function()
			return (Enum.Material :: any)[name]
		end)
		if ok and material then
			SURFACE[material] = kind
		end
	end
end

local function surfaceColor(hitPart, material)
	if hitPart and hitPart:IsA("Terrain") then
		local ok, color = pcall(function()
			return workspace.Terrain:GetMaterialColor(material)
		end)
		return ok and color or Color3.fromRGB(150, 140, 120)
	end
	return hitPart and hitPart.Color or Color3.fromRGB(200, 200, 200)
end

-- Impacto: reacción según la superficie, polvo del color del material y marca de bala
-- Pintura (arma de paintball): gotas de un color al azar y, en superficies, una mancha plana que se
-- desvanece a los pocos segundos (como mucho MAX_SPLATS a la vez)
local PAINT_COLORS = {
	Color3.fromRGB(255, 60, 140),
	Color3.fromRGB(60, 200, 255),
	Color3.fromRGB(255, 220, 40),
	Color3.fromRGB(120, 230, 60),
	Color3.fromRGB(170, 90, 255),
	Color3.fromRGB(255, 140, 40),
}
local MAX_SPLATS = 40
local splats = {}

local function paintSplat(anchor, position, normal, isCharacter)
	local color = PAINT_COLORS[math.random(1, #PAINT_COLORS)]
	emitPooled(anchor, "Paint", {
		Texture = TEX.Sparkle,
		Color = ColorSequence.new(color),
		LightEmission = 0.2,
		Size = seq(0.4, 0.1),
		Lifetime = NumberRange.new(0.3, 0.55),
		Speed = NumberRange.new(8, 16),
		SpreadAngle = Vector2.new(55, 55),
		Acceleration = Vector3.new(0, -60, 0),
	}, isCharacter and 12 or 10)
	if isCharacter then
		return
	end
	normal = (normal and normal.Magnitude > 0.01) and normal.Unit or Vector3.yAxis
	local size = 1.2 + math.random() * 1.2
	-- Cilindro muy fino pegado a la superficie (su eje X apunta en la dirección de la normal)
	local splat = fxPart({
		Name = "PaintSplat",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.04, size, size),
		CFrame = safeLookAt(position + normal * 0.03, normal) * CFrame.Angles(0, math.pi / 2, 0),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
	})
	table.insert(splats, splat)
	if #splats > MAX_SPLATS then
		local oldest = table.remove(splats, 1)
		if oldest then
			oldest:Destroy()
		end
	end
	task.delay(5, function()
		if splat.Parent then
			TweenService:Create(splat, TweenInfo.new(1.5), { Transparency = 1 }):Play()
			task.delay(1.6, function()
				local index = table.find(splats, splat)
				if index then
					table.remove(splats, index)
				end
				splat:Destroy()
			end)
		end
	end)
end

-- style = "Paint" para las armas de paintball (def.ImpactStyle)
function Effects.Impact(position, normal, hitPart, material, style)
	local isCharacter = hitPart ~= nil
		and hitPart.Parent ~= nil
		and (hitPart.Parent:FindFirstChildOfClass("Humanoid") ~= nil or hitPart.Parent:IsA("Accessory"))
	local anchor = pooledAnchor(position + (normal or Vector3.yAxis) * 0.05, normal)
	if style == "Paint" then
		paintSplat(anchor, position, normal, isCharacter)
		return
	end

	if isCharacter and realisticMap() and not GameConfig.RealisticBlood then
		-- Impacto realista sin sangre: golpe seco de polvo y fibras de la ropa que saltan y caen
		emitPooled(anchor, "HitPuff", {
			Texture = TEX.Smoke,
			Color = ColorSequence.new(Color3.fromRGB(176, 168, 150), Color3.fromRGB(120, 114, 100)),
			LightInfluence = 1,
			Size = seq(0.3, 1.3),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.3),
				NumberSequenceKeypoint.new(0.4, 0.6),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Lifetime = NumberRange.new(0.25, 0.45),
			Speed = NumberRange.new(2, 5),
			SpreadAngle = Vector2.new(40, 40),
			Drag = 6,
			Rotation = NumberRange.new(0, 360),
		}, 3)
		emitPooled(anchor, "HitFibers", {
			Texture = TEX.Smoke,
			Color = ColorSequence.new(Color3.fromRGB(70, 66, 58)),
			LightInfluence = 1,
			Size = seq(0.1, 0.04),
			Lifetime = NumberRange.new(0.3, 0.5),
			Speed = NumberRange.new(7, 12),
			SpreadAngle = Vector2.new(30, 30),
			Acceleration = Vector3.new(0, -50, 0),
		}, 4)
		return
	end
	if isCharacter and realisticMap() then
		-- Impacto realista con sangre (GameConfig.RealisticBlood): una nube rojo oscuro que se abre y
		-- se desvanece enseguida, unas gotitas que caen y polvo de la ropa (sin charcos ni marcas)
		emitPooled(anchor, "HitMist", {
			Texture = TEX.Smoke,
			Color = ColorSequence.new(Color3.fromRGB(125, 12, 14), Color3.fromRGB(70, 8, 10)),
			LightInfluence = 0.8,
			Size = seq(0.35, 1.4),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.25),
				NumberSequenceKeypoint.new(0.4, 0.55),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Lifetime = NumberRange.new(0.22, 0.38),
			Speed = NumberRange.new(2, 5),
			SpreadAngle = Vector2.new(35, 35),
			Drag = 6,
			Rotation = NumberRange.new(0, 360),
		}, 3)
		emitPooled(anchor, "HitDrops", {
			Texture = TEX.Smoke,
			Color = ColorSequence.new(Color3.fromRGB(110, 10, 12)),
			LightInfluence = 0.8,
			Size = seq(0.14, 0.05),
			Lifetime = NumberRange.new(0.3, 0.5),
			Speed = NumberRange.new(8, 14),
			SpreadAngle = Vector2.new(28, 28),
			Acceleration = Vector3.new(0, -60, 0),
		}, 5)
		emitPooled(anchor, "HitCloth", {
			Texture = TEX.Smoke,
			Color = ColorSequence.new(Color3.fromRGB(150, 140, 120)),
			LightInfluence = 1,
			Size = seq(0.25, 0.8),
			Transparency = seq(0.5, 1),
			Lifetime = NumberRange.new(0.3, 0.5),
			Speed = NumberRange.new(1, 3),
			SpreadAngle = Vector2.new(50, 50),
		}, 2)
		return
	end
	if isCharacter then
		-- Destello de golpe (estilo cartoon, sin sangre)
		emitPooled(anchor, "Hit", {
			Texture = TEX.Sparkle,
			Color = ColorSequence.new(Color3.fromRGB(255, 90, 90), Color3.fromRGB(255, 220, 120)),
			LightEmission = 1,
			Size = seq(0.5, 0),
			Lifetime = NumberRange.new(0.15, 0.3),
			Speed = NumberRange.new(6, 12),
			SpreadAngle = Vector2.new(60, 60),
			Rotation = NumberRange.new(0, 360),
		}, 8)
		return
	end

	material = material or (hitPart and hitPart.Material) or Enum.Material.Plastic
	local kind = SURFACE[material] or SURFACE_BY_NAME[material.Name] or "Plastic"
	local baseColor = surfaceColor(hitPart, material)
	-- Sonido del impacto según el material (Fase 11): información de juego, también en calidad Baja
	if kind ~= "Water" then
		Sounds.PlayImpact(kind, anchor)
	end
	-- (impactos en el escenario: con calidad baja o en móvil, menos partículas y menos marcas)
	local fx = budget()
	local amount = fx.ImpactParticles

	if kind == "Water" then
		-- Salpicadura: gotas hacia arriba que caen y un poco de espuma
		emitPooled(anchor, "WaterDrops", {
			Texture = TEX.Sparkle,
			Color = ColorSequence.new(Color3.fromRGB(220, 240, 255)),
			LightEmission = 0.3,
			Size = seq(0.25, 0.05),
			Lifetime = NumberRange.new(0.4, 0.7),
			Speed = NumberRange.new(10, 18),
			SpreadAngle = Vector2.new(18, 18),
			Acceleration = Vector3.new(0, -50, 0),
		}, scaled(12, amount))
		emitPooled(anchor, "WaterFoam", {
			Texture = TEX.Smoke,
			Color = ColorSequence.new(Color3.fromRGB(240, 248, 255)),
			Size = seq(0.6, 2),
			Transparency = seq(0.4, 1),
			Lifetime = NumberRange.new(0.4, 0.6),
			Speed = NumberRange.new(1, 2),
			SpreadAngle = Vector2.new(70, 70),
		}, scaled(3, amount))
		return
	end

	-- Chispas: muchas en metal, pocas en piedra y cristal, ninguna en materiales blandos
	local sparks = scaled((kind == "Metal" and 12) or ((kind == "Stone" or kind == "Glass" or kind == "Plastic") and 4) or 0, amount)
	if sparks > 0 then
		emitPooled(anchor, "Sparks" .. kind, {
			Texture = TEX.Sparkle,
			Color = ColorSequence.new(Color3.fromRGB(255, 230, 150), Color3.fromRGB(255, 150, 60)),
			LightEmission = 1,
			Size = seq(kind == "Metal" and 0.22 or 0.16, 0),
			Lifetime = NumberRange.new(0.15, kind == "Metal" and 0.5 or 0.3),
			Speed = NumberRange.new(10, 20),
			SpreadAngle = Vector2.new(50, 50),
			Acceleration = Vector3.new(0, -45, 0),
		}, sparks)
	end

	-- Esquirlas que saltan y caen (astillas de madera, trozos de piedra, terrones, cristal)
	if kind == "Wood" or kind == "Stone" or kind == "Dirt" or kind == "Glass" or kind == "Snow" then
		local chipColor = kind == "Glass" and Color3.fromRGB(220, 240, 255) or baseColor:Lerp(Color3.new(0, 0, 0), kind == "Wood" and 0.25 or 0.1)
		emitPooled(anchor, "Chips" .. kind, {
			Texture = TEX.Smoke,
			Color = ColorSequence.new(chipColor),
			LightInfluence = 1,
			Size = seq(kind == "Snow" and 0.35 or 0.22, 0.12),
			Lifetime = NumberRange.new(0.35, 0.6),
			Speed = NumberRange.new(8, 15),
			SpreadAngle = Vector2.new(40, 40),
			Acceleration = Vector3.new(0, -55, 0),
			Rotation = NumberRange.new(0, 360),
			RotSpeed = NumberRange.new(-300, 300),
		}, scaled(kind == "Wood" and 6 or 5, amount))
	end

	-- Nube de polvo del color de la superficie (más grande en tierra y nieve)
	local soft = kind == "Dirt" or kind == "Snow"
	local dustColor = baseColor:Lerp(Color3.new(1, 1, 1), kind == "Snow" and 0.5 or 0.3)
	if kind ~= "Metal" and kind ~= "Glass" then
		emitPooled(anchor, soft and "DustSoft" or "Dust", {
			Texture = TEX.Smoke,
			Color = ColorSequence.new(dustColor),
			LightInfluence = 1,
			Size = seq(soft and 0.6 or 0.3, soft and 2.4 or 1.5),
			Transparency = seq(soft and 0.2 or 0.3, 1),
			Lifetime = NumberRange.new(soft and 0.7 or 0.45, soft and 1.1 or 0.8),
			Speed = NumberRange.new(soft and 3 or 1.5, soft and 6 or 3),
			SpreadAngle = Vector2.new(30, 30),
			Acceleration = Vector3.new(0, soft and -6 or 0.5, 0),
			WindAffectsDrag = true,
		}, scaled(soft and 5 or 3, amount))
	end

	-- Marca de bala (no queda en nieve ni en tierra blanda). Como mucho fx.BulletMarks a la vez: al
	-- pasarse, se reutiliza la más antigua
	if soft or fx.BulletMarks <= 0 then
		return
	end
	markRing.Size = math.min(fx.BulletMarks, MAX_MARKS)
	chipRing.Size = markRing.Size
	local markColor = (kind == "Metal" and Color3.fromRGB(70, 70, 76))
		or (kind == "Wood" and Color3.fromRGB(45, 30, 20))
		or (kind == "Glass" and Color3.fromRGB(230, 240, 250))
		or Color3.fromRGB(25, 25, 28)
	local mark = ringPart(markRing, {
		Color = markColor,
		Material = kind == "Metal" and Enum.Material.Metal or Enum.Material.SmoothPlastic,
		Size = Vector3.new(0.22, 0.22, 0.03),
		Shape = Enum.PartType.Block,
		CFrame = safeLookAt(position, normal or Vector3.yAxis) * CFrame.Angles(0, 0, math.random() * math.pi),
		Transparency = kind == "Glass" and 0.4 or 0.15,
	})
	if kind == "Stone" then
		-- Desconchón claro alrededor del agujero
		local chip = ringPart(chipRing, {
			Color = baseColor:Lerp(Color3.new(1, 1, 1), 0.25),
			Material = Enum.Material.SmoothPlastic,
			Size = Vector3.new(0.45, 0.45, 0.012),
			CFrame = mark.CFrame * CFrame.new(0, 0, -0.003) * CFrame.Angles(0, 0, 0.6),
			Transparency = 0.35,
		})
		TweenService:Create(chip, TweenInfo.new(5, Enum.EasingStyle.Linear), { Transparency = 1 }):Play()
	end
	TweenService:Create(mark, TweenInfo.new(5, Enum.EasingStyle.Linear), { Transparency = 1 }):Play()
end

-- Casquillo que sale disparado por la derecha del arma
local liveCasings = 0
local MAX_CASINGS = 8 -- con fuego automático no hace falta simular más a la vez

local lastClink = 0
-- inherit (opcional): velocidad del jugador, que el casquillo hereda (corriendo no se queda atrás)
local lastCasingSound = 0
function Effects.ShellCasing(attachment, cameraCFrame, color, inherit: Vector3?)
	if not attachment or liveCasings >= MAX_CASINGS or not budget().Shells then
		return
	end
	liveCasings += 1
	task.delay(1.5, function()
		liveCasings -= 1
	end)
	-- Tintineo del casquillo al llegar al suelo (Fase 11): flojito y como mucho uno cada 0,16 s
	local now = os.clock()
	if now - lastCasingSound >= 0.16 then
		lastCasingSound = now
		task.delay(0.38 + math.random() * 0.12, function()
			Sounds.Play("CasingDrop", nil, 0.95 + math.random() * 0.1)
		end)
	end
	local casing = Instance.new("Part")
	casing.Size = Vector3.new(0.06, 0.06, 0.16)
	casing.Color = color or Color3.fromRGB(230, 180, 60)
	casing.Material = Enum.Material.Metal
	casing.Reflectance = 0.2
	casing.CanCollide = true
	casing.CanQuery = false
	casing.CanTouch = false
	casing.CastShadow = false
	casing.Massless = true
	casing.CustomPhysicalProperties = PhysicalProperties.new(0.05, 0.3, 0.6)
	casing.CFrame = attachment.WorldCFrame
	casing.Parent = folder
	local right = cameraCFrame.RightVector
	local up = cameraCFrame.UpVector
	-- Sale a la derecha y hacia arriba, un poco hacia delante (como un fusil de verdad)
	local forward = cameraCFrame.LookVector
	casing.AssemblyLinearVelocity = right * (6 + math.random() * 3) + up * (5 + math.random() * 3) + forward * (0.6 + math.random() * 0.8)
		+ (inherit or Vector3.zero)
	casing.AssemblyAngularVelocity = Vector3.new(math.random(-20, 20), math.random(-20, 20), math.random(-20, 20))
	Debris:AddItem(casing, 1.5)
	-- Tintineo del casquillo al caer al suelo (como mucho uno cada 0,1 s: con ráfagas, una lluvia de latón)
	local now = os.clock()
	if now - lastClink >= 0.1 then
		lastClink = now
		task.delay(0.45 + math.random() * 0.2, function()
			if casing.Parent then
				local clink = Sounds.Play("Mech", casing, 2 + math.random() * 0.6, 0.14)
				if clink then
					clink.RollOffMaxDistance = 40
				end
			end
		end)
	end
end

-- Humo del cañón: tras una ráfaga larga, del cañón caliente sale un hilo de humo un par de segundos
-- (amount 0..1 según lo larga que fue la ráfaga). Un emisor por arma, en la propia boca del cañón.
function Effects.BarrelSmoke(attachment, amount)
	if not attachment or not attachment.Parent or not budget().BarrelSmoke then
		return
	end
	amount = math.clamp(amount or 0.5, 0, 1)
	local emitter = attachment:FindFirstChild("BarrelSmoke")
	if not emitter then
		emitter = Instance.new("ParticleEmitter")
		emitter.Name = "BarrelSmoke"
		emitter.Texture = TEX.Smoke
		emitter.Color = ColorSequence.new(Color3.fromRGB(215, 215, 212))
		emitter.LightInfluence = 1
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.05),
			NumberSequenceKeypoint.new(1, 0.55),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.85),
			NumberSequenceKeypoint.new(0.5, 0.88),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Lifetime = NumberRange.new(0.9, 1.4)
		emitter.Speed = NumberRange.new(0.3, 0.7)
		emitter.Drag = 1
		emitter.RotSpeed = NumberRange.new(-30, 30)
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.SpreadAngle = Vector2.new(10, 10)
		emitter.Acceleration = Vector3.new(0, 2.2, 0)
		emitter.EmissionDirection = Enum.NormalId.Top
		emitter.Enabled = false
		emitter.Parent = attachment
	end
	emitter.Rate = 10 + 16 * amount
	emitter.Enabled = true
	local token = (emitter:GetAttribute("Token") or 0) + 1
	emitter:SetAttribute("Token", token)
	task.delay(0.8 + 1.6 * amount, function()
		if emitter.Parent and emitter:GetAttribute("Token") == token then
			emitter.Enabled = false
		end
	end)
	return emitter
end

-- Al volver a disparar, el humo se corta (el fogonazo lo tapa)
function Effects.StopBarrelSmoke(attachment)
	local emitter = attachment and attachment:FindFirstChild("BarrelSmoke")
	if emitter then
		emitter.Enabled = false
	end
end

-- Explosión del cohete
function Effects.Explosion(position, radius, color)
	radius = radius or 12
	-- Temblor de cámara si la explosión es cercana (más fuerte cuanto más cerca)
	local camera = workspace.CurrentCamera
	if camera then
		local distance = (camera.CFrame.Position - position).Magnitude
		local strength = math.clamp(1 - distance / (radius * 4), 0, 1)
		-- (muerto u observando, la cámara no tiembla: la sacudida se quedaría para la vida siguiente)
		if strength > 0 and not ClientState.Dead then
			ClientState.Shake = math.max(ClientState.Shake or 0, strength)
		end
		-- Muy cerca: aturdimiento (pitido, sonido apagado, destello y desenfoque; ver CombatFX)
		local concussion = math.clamp(1 - distance / (radius * 2.2), 0, 1)
		local onConcussion = Effects.OnConcussion
		if concussion > 0 and onConcussion then
			onConcussion(concussion)
		end
	end
	color = color or Color3.fromRGB(255, 140, 30)
	local fireball = fxPart({
		Color = Color3.fromRGB(255, 200, 80),
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(2, 2, 2),
		CFrame = CFrame.new(position),
		Transparency = 0,
	})
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = radius * 2.5
	light.Brightness = 6
	light.Parent = fireball
	TweenService:Create(fireball, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Size = Vector3.one * radius * 1.2, Transparency = 1, Color = color }):Play()
	TweenService:Create(light, TweenInfo.new(0.5), { Brightness = 0 }):Play()
	Debris:AddItem(fireball, 0.55)

	local realistic = realisticMap()
	local anchor = emitterAnchor(position, Vector3.yAxis, 3)
	if realistic then
		-- Onda expansiva de verdad: una ola de polvo y tierra que sale a ras de suelo en todas direcciones
		-- (8 chorros horizontales: un anillo, no una cúpula)
		for i = 0, 7 do
			local angle = i * math.pi / 4
			local ground = emitterAnchor(position + Vector3.new(0, 0.4, 0), Vector3.new(math.cos(angle), 0, math.sin(angle)), 2)
			emit(ground, {
				Texture = TEX.Smoke,
				Color = ColorSequence.new(Color3.fromRGB(150, 138, 118), Color3.fromRGB(110, 102, 90)),
				LightInfluence = 1,
				Size = seq(1.5, 5),
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.35),
					NumberSequenceKeypoint.new(0.5, 0.6),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Lifetime = NumberRange.new(0.8, 1.4),
				Speed = NumberRange.new(radius * 1.6, radius * 2.4),
				SpreadAngle = Vector2.new(22, 22),
				Drag = 4,
				Acceleration = Vector3.new(0, -2, 0),
				Rotation = NumberRange.new(0, 360),
				RotSpeed = NumberRange.new(-40, 40),
			}, 3)
		end
	else
		-- Onda expansiva en el suelo
		local ring = fxPart({
			Color = color:Lerp(Color3.new(1, 1, 1), 0.4),
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.2, 2, 2),
			CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2),
			Transparency = 0.2,
		})
		TweenService:Create(ring, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Size = Vector3.new(0.1, radius * 2.4, radius * 2.4), Transparency = 1 }):Play()
		Debris:AddItem(ring, 0.45)
	end
	emit(anchor, {
		Texture = TEX.Fire,
		Color = ColorSequence.new(Color3.fromRGB(255, 230, 150), color),
		LightEmission = 1,
		Size = seq(3, 0.5),
		Transparency = seq(0, 1),
		Lifetime = NumberRange.new(0.3, 0.6),
		Speed = NumberRange.new(10, 22),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 3,
	}, 30)
	emit(anchor, {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(Color3.fromRGB(70, 65, 60)),
		Size = seq(2, 7),
		Transparency = seq(0.2, 1),
		Lifetime = NumberRange.new(1.2, 2.2),
		Speed = NumberRange.new(3, 8),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, 3, 0),
	}, 14)
	-- Chispas (en los mapas realistas, brasas que caen dejando estela en vez de estrellitas)
	emit(anchor, {
		Texture = realistic and TEX.Fire or TEX.Sparkle,
		Color = ColorSequence.new(Color3.fromRGB(255, 220, 120), realistic and Color3.fromRGB(255, 120, 40) or Color3.fromRGB(255, 220, 120)),
		LightEmission = 1,
		Size = realistic and seq(0.18, 0.04) or seq(0.3, 0),
		Lifetime = NumberRange.new(0.5, realistic and 1.3 or 1),
		Speed = NumberRange.new(25, 45),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -60, 0),
	}, realistic and 26 or 20)

	-- Columna de humo negro que se queda unos segundos
	local smokeAnchor = emitterAnchor(position + Vector3.new(0, 1, 0), Vector3.yAxis, 6)
	emit(smokeAnchor, {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(Color3.fromRGB(40, 38, 36), Color3.fromRGB(90, 88, 85)),
		Size = seq(3, 10),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.5),
			NumberSequenceKeypoint.new(0.6, 0.7),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(3, 5),
		Speed = NumberRange.new(2, 4),
		SpreadAngle = Vector2.new(25, 25),
		Acceleration = Vector3.new(0.5, 2.5, 0),
		RotSpeed = NumberRange.new(-25, 25),
		Rotation = NumberRange.new(0, 360),
	}, 10)

	-- Escombros que salen despedidos
	for _ = 1, 8 do
		local chunk = fxPart({
			Size = Vector3.new(0.3 + math.random() * 0.4, 0.2 + math.random() * 0.3, 0.3 + math.random() * 0.4),
			Color = Color3.fromRGB(70, 66, 62),
			Material = Enum.Material.Slate,
			CFrame = CFrame.new(position + Vector3.new(0, 0.5, 0)) * CFrame.Angles(math.random() * 6, math.random() * 6, 0),
		})
		chunk.Anchored = false
		local dir = Vector3.new(math.random() - 0.5, 0.7 + math.random() * 0.6, math.random() - 0.5).Unit
		chunk.AssemblyLinearVelocity = dir * (25 + math.random() * 20)
		chunk.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 25
		TweenService:Create(chunk, TweenInfo.new(0.4, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 1.4), { Transparency = 1 }):Play()
		Debris:AddItem(chunk, 1.9)
	end

	-- Marca de quemado en el suelo (si hay suelo cerca)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { folder }
	local ground = workspace:Raycast(position + Vector3.new(0, 2, 0), Vector3.new(0, -8, 0), params)
	if ground and ground.Instance then
		local scorch = fxPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.05, radius * 0.9, radius * 0.9),
			Color = Color3.fromRGB(22, 20, 18),
			Material = Enum.Material.Slate,
			CFrame = safeLookAt(ground.Position + ground.Normal * 0.04, ground.Normal) * CFrame.Angles(0, math.pi / 2, 0),
			Transparency = 0.25,
		})
		TweenService:Create(scorch, TweenInfo.new(4, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 6), { Transparency = 1 }):Play()
		Debris:AddItem(scorch, 10.2)
	end
end

-- Cohete que vuela hasta `to` y explota al llegar
-- style = "Pumpkin": el proyectil es una calabaza con cara (Calabazooka)
function Effects.Rocket(from, to, speed, color, radius, style)
	local distance = (to - from).Magnitude
	if distance < 0.5 then
		Effects.Explosion(to, radius, color)
		return
	end
	local direction = safeLookAt(from, to - from)
	local pumpkin = style == "Pumpkin"
	local rocket = fxPart({
		Color = pumpkin and Color3.fromRGB(255, 130, 20) or Color3.fromRGB(230, 230, 235),
		Material = Enum.Material.SmoothPlastic,
		Shape = pumpkin and Enum.PartType.Ball or Enum.PartType.Block,
		Size = pumpkin and Vector3.new(1.1, 1.1, 1.1) or Vector3.new(0.35, 0.35, 1.3),
		CFrame = direction,
	})
	local tip = fxPart({
		Color = pumpkin and Color3.fromRGB(255, 220, 60) or Color3.fromRGB(220, 40, 40),
		Material = pumpkin and Enum.Material.Neon or Enum.Material.SmoothPlastic,
		Shape = pumpkin and Enum.PartType.Block or Enum.PartType.Ball,
		Size = pumpkin and Vector3.new(0.5, 0.18, 0.1) or Vector3.new(0.38, 0.38, 0.38),
		CFrame = direction * CFrame.new(0, pumpkin and 0.1 or 0, pumpkin and -0.52 or -0.65),
	})
	local flame = fxPart({
		Color = color or Color3.fromRGB(255, 160, 40),
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.45, 0.45, 0.45),
		CFrame = direction * CFrame.new(0, 0, 0.7),
	})
	local trail = Instance.new("ParticleEmitter")
	trail.Texture = TEX.Smoke
	trail.Color = ColorSequence.new(Color3.fromRGB(200, 200, 200))
	trail.Size = seq(0.4, 1.6)
	trail.Transparency = seq(0.3, 1)
	trail.Lifetime = NumberRange.new(0.5, 0.9)
	trail.Speed = NumberRange.new(0.5, 1)
	trail.Rate = 80
	trail.Parent = flame
	local duration = distance / speed
	for _, part in { rocket, tip, flame } do
		local offset = direction:ToObjectSpace(part.CFrame)
		local finalCF = direction * CFrame.new(0, 0, -distance) * offset
		TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = finalCF }):Play()
	end
	task.delay(duration, function()
		trail.Enabled = false
		rocket:Destroy()
		tip:Destroy()
		flame.Transparency = 1
		Debris:AddItem(flame, 1)
		Effects.Explosion(to, radius, color)
	end)
end

-- Explosión de partículas cuando alguien es eliminado
function Effects.DeathBurst(position, color)
	color = color or Color3.new(1, 1, 1)
	local anchor = emitterAnchor(position, Vector3.yAxis, 2.5)
	emit(anchor, {
		Texture = TEX.Sparkle,
		Color = ColorSequence.new(color, Color3.new(1, 1, 1)),
		LightEmission = 1,
		Size = seq(0.9, 0),
		Lifetime = NumberRange.new(0.5, 0.9),
		Speed = NumberRange.new(10, 20),
		SpreadAngle = Vector2.new(180, 180),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-180, 180),
		Drag = 4,
	}, 24)
	emit(anchor, {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.6)),
		Size = seq(1.5, 4),
		Transparency = seq(0.4, 1),
		Lifetime = NumberRange.new(0.8, 1.3),
		Speed = NumberRange.new(2, 5),
		SpreadAngle = Vector2.new(180, 180),
	}, 6)
	local flash = fxPart({
		Color = color,
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(position),
		Transparency = 0.2,
	})
	TweenService:Create(flash, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Size = Vector3.new(7, 7, 7), Transparency = 1 }):Play()
	Debris:AddItem(flash, 0.4)
end

---------------------------------------------------------------------------
-- Efectos de eliminación (ver KillEffects.luau)
---------------------------------------------------------------------------

-- Emoji o texto que flota en el mundo (BillboardGui) y se desvanece
local function floatingText(position, text, size, rise, duration, color)
	local anchor = fxPart({ Size = Vector3.new(0.1, 0.1, 0.1), Transparency = 1, CFrame = CFrame.new(position) })
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(size, size)
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = 400
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.Parent = gui
	TweenService:Create(anchor, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.new(position + rise) }):Play()
	TweenService:Create(label, TweenInfo.new(duration * 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, duration * 0.5), { TextTransparency = 1 }):Play()
	Debris:AddItem(anchor, duration + 0.1)
end

-- Piezas sueltas que salen disparadas con física (confeti, monedas, cristales)
local function debrisBurst(position, count, makePart, speed, lifetime)
	for _ = 1, count do
		local part = makePart()
		part.Anchored = false
		part.CanCollide = false -- no empujan a nadie; desaparecen antes de caer mucho
		part.CFrame = CFrame.new(position + Vector3.new(math.random() - 0.5, math.random() * 0.5, math.random() - 0.5))
			* CFrame.Angles(math.random() * 6.28, math.random() * 6.28, math.random() * 6.28)
		local dir = Vector3.new(math.random() - 0.5, 0.6 + math.random() * 0.8, math.random() - 0.5).Unit
		part.AssemblyLinearVelocity = dir * speed * (0.6 + math.random() * 0.6)
		part.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 20
		TweenService:Create(part, TweenInfo.new(0.4, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, lifetime - 0.4), { Transparency = 1 }):Play()
		Debris:AddItem(part, lifetime)
	end
end

local CONFETTI_COLORS = {
	Color3.fromRGB(255, 70, 90),
	Color3.fromRGB(255, 210, 40),
	Color3.fromRGB(60, 200, 255),
	Color3.fromRGB(120, 255, 120),
	Color3.fromRGB(200, 100, 255),
	Color3.fromRGB(255, 140, 30),
}

local function flashBall(position, color, size, duration)
	local flash = fxPart({ Color = color, Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(position), Transparency = 0.2 })
	TweenService:Create(flash, TweenInfo.new(duration, Enum.EasingStyle.Quad), { Size = Vector3.one * size, Transparency = 1 }):Play()
	Debris:AddItem(flash, duration + 0.05)
	return flash
end

