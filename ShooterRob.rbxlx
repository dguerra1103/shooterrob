---------------------------------------------------------------------------
-- Pestaña: Tienda (diaria, ofertas, cajas, Robux, VIP)
---------------------------------------------------------------------------

local function itemName(kind, id)
	if kind == "Outfit" then
		return Outfits.Get(id).Name, Outfits.Get(id).Rarity
	elseif kind == "KillEffect" then
		return KillEffects.Get(id).Name, KillEffects.Get(id).Rarity
	end
	return Skins.Get(id).Name, Skins.Get(id).Rarity
end

-- Animación de apertura de caja: una tira de premios que gira y se para en el tuyo
local crateOverlay = nil -- animación de caja en curso (el menú no se puede cerrar hasta acabar)

local function crateAnimation(result)
	local overlay = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.25,
		Active = true, -- los clics no atraviesan (no se compra otra caja sin querer)
		ZIndex = 20,
		Parent = gui,
	})
	crateOverlay = overlay
	UI.new("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true, Parent = overlay })
	local window = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(760, 170),
		BackgroundColor3 = Color3.fromRGB(15, 16, 26),
		ClipsDescendants = true,
		ZIndex = 21,
		Parent = overlay,
	}, { UI.corner(12), UI.stroke(GOLD, 3, 0) })
	local reel = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 15),
		Size = UDim2.fromOffset(40 * 150, 140),
		BackgroundTransparency = 1,
		ZIndex = 22,
		Parent = window,
	}, {
		UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	-- Rellenamos con objetos aleatorios y el premio en la posición 32
	local pool = {}
	for id, skin in Skins.List do
		if id ~= "Default" and not skin.Mastery and not skin.Event then
			table.insert(pool, { "Skin", id })
		end
	end
	for id, outfit in Outfits.List do
		if id ~= "Default" and not outfit.Event then
			table.insert(pool, { "Outfit", id })
		end
	end
	local PRIZE_INDEX = 32
	for i = 1, 38 do
		local kind, id
		if i == PRIZE_INDEX then
			kind, id = result.Kind, result.Id
		else
			local pick = pool[math.random(1, #pool)]
			kind, id = pick[1], pick[2]
		end
		local name, rarity = itemName(kind, id)
		local card = UI.new("Frame", {
			LayoutOrder = i,
			Size = UDim2.fromOffset(140, 140),
			BackgroundColor3 = rarityColor(rarity):Lerp(Color3.new(0, 0, 0), 0.55),
			ZIndex = 23,
			Parent = reel,
		}, { UI.corner(10), UI.stroke(rarityColor(rarity), 3, 0) })
		UI.label({
			Position = UDim2.fromOffset(0, 30),
			Size = UDim2.new(1, 0, 0, 50),
			Text = kind == "Outfit" and "🧥" or "🔫",
			TextSize = 40,
			ZIndex = 24,
			Parent = card,
		})
		UI.label({ Position = UDim2.fromOffset(4, 90), Size = UDim2.new(1, -8, 0, 22), Text = name, TextScaled = true, ZIndex = 24, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 112),
			Size = UDim2.new(1, 0, 0, 18),
			Text = rarity,
			TextSize = 14,
			TextColor3 = rarityColor(rarity),
			ZIndex = 24,
			Parent = card,
		})
	end
	-- Marcador central
	UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.new(0, 4, 1, 0),
		BackgroundColor3 = GOLD,
		BorderSizePixel = 0,
		ZIndex = 30,
		Parent = window,
	})
	local cardStep = 150
	local target = -((PRIZE_INDEX - 1) * cardStep + 70 - 380) + math.random(-50, 50)
	local spin = TweenService:Create(reel, TweenInfo.new(4.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = UDim2.fromOffset(target, 15) })
	spin:Play()
	-- "tic" mientras gira
	task.spawn(function()
		local last = 0
		while spin.PlaybackState == Enum.PlaybackState.Playing do
			local index = math.floor(-reel.Position.X.Offset / cardStep)
			if index ~= last then
				last = index
				Sounds.Play("Click")
			end
			task.wait()
		end
	end)
	spin.Completed:Wait()
	local name, rarity = itemName(result.Kind, result.Id)
	Sounds.Play("Kill")
	local title = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.45, 100),
		Size = UDim2.fromOffset(700, 50),
		Text = result.Duplicate and ("Repetido: " .. name .. "  ·  +" .. result.Refund .. " monedas") or ("¡" .. name .. "! (" .. rarity .. ")"),
		TextSize = 34,
		TextColor3 = rarityColor(rarity),
		TextStrokeTransparency = 0,
		ZIndex = 25,
		Parent = overlay,
	})
	local scale = UI.new("UIScale", { Scale = 1.6, Parent = title })
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	local close = UI.button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.45, 160),
		Size = UDim2.fromOffset(220, 46),
		Text = "¡Genial!",
		BackgroundColor3 = GREEN,
		ZIndex = 25,
		Parent = overlay,
	}, { UI.gloss() })
	close.Activated:Connect(function()
		overlay:Destroy()
		crateOverlay = nil
		busy = false
	end)
end

local function openCrate(crateId, useFree)
	if busy then
		return
	end
	busy = true
	local ok, success, result = pcall(function()
		return Remotes.OpenCrate:InvokeServer(crateId, useFree)
	end)
	if ok and success and type(result) == "table" then
		-- busy sigue activo hasta cerrar la animación (no se puede abrir otra mientras gira)
		crateAnimation(result)
	else
		busy = false
		showToast(ok and tostring(result) or "Error de conexión", Color3.fromRGB(255, 90, 90))
	end
end

local function sectionTitle(parent, text, order)
	return UI.label({
		LayoutOrder = order,
		Size = UDim2.new(1, -10, 0, 30),
		Text = text,
		TextSize = 24,
		TextColor3 = GOLD,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = parent,
	})
end

-- Fila de tarjetas: si no caben (pantallas estrechas) pasan a la línea siguiente
local function row(parent, order, height)
	return UI.new("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, -10, 0, height),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Wraps = true,
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
end

local function buildShopPage(data)
	local scroll = scroller(UI.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }))

	-- Pack de inicio (solo jugadores nuevos, una vez)
	local starter = Shop.StarterPack
	if data.StarterPackAvailable then
		local card = UI.new("Frame", {
			LayoutOrder = 0,
			Size = UDim2.new(1, -10, 0, 130),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			Parent = scroll,
		}, {
			UI.corner(14),
			UI.stroke(GOLD, 3, 0),
			UI.new("UIGradient", {
				Color = ColorSequence.new(Color3.fromRGB(255, 90, 40), Color3.fromRGB(150, 40, 200)),
				Rotation = 0,
			}),
		})
		UI.label({
			Position = UDim2.fromOffset(18, 8),
			Size = UDim2.new(1, -280, 0, 36),
			Text = "🔥 PACK DE INICIO  ·  solo una vez",
			TextSize = 28,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		UI.label({
			Position = UDim2.fromOffset(18, 48),
			Size = UDim2.new(1, -280, 0, 72),
			Text = string.format(
				"🪙 %d monedas  ·  👕 Traje %s  ·  🎨 Skin %s  ·  %s Efecto %s\n¡Vale más de 4 veces su precio!",
				starter.Coins,
				Outfits.Get(starter.Outfit).Name,
				Skins.Get(starter.Skin).Name,
				KillEffects.Get(starter.KillEffect).Icon,
				KillEffects.Get(starter.KillEffect).Name
			),
			TextSize = 18,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = card,
		})
		local buyStarter = UI.button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -18, 0.5, 0),
			Size = UDim2.fromOffset(230, 60),
			Text = starter.ProductId ~= 0 and ("R$ " .. starter.Robux .. "  ¡COMPRAR!") or "Próximamente",
			TextSize = 24,
			BackgroundColor3 = starter.ProductId ~= 0 and GREEN or GREY,
			Parent = card,
		}, { UI.gloss() })
		buyStarter.Activated:Connect(function()
			if not buyStarter.Active then
				return
			end
			if starter.ProductId ~= 0 then
				Sounds.Play("Click")
				-- Un solo intento hasta que llegue la respuesta del servidor (la página se rehace)
				buyStarter.Active = false
				buyStarter.AutoButtonColor = false
				buyStarter.Text = "Procesando..."
				MarketplaceService:PromptProductPurchase(player, starter.ProductId)
			else
				showToast("Próximamente")
			end
		end)
	end

	-- Recompensa diaria
	local daily = UI.new("Frame", {
		LayoutOrder = 1,
		Size = UDim2.new(1, -10, 0, 70),
		BackgroundColor3 = Color3.fromRGB(40, 60, 40),
		Parent = scroll,
	}, { UI.corner(12), UI.stroke(Color3.fromRGB(90, 230, 110), 2, 0) })
	local streak = data.DailyStreak or 0
	local nextDay = data.DailyAvailable and ((streak % #Shop.DailyRewards) + 1) or streak
	UI.label({
		Position = UDim2.fromOffset(16, 0),
		Size = UDim2.new(1, -260, 1, 0),
		Text = "🎁 Recompensa diaria · Día " .. tostring(nextDay) .. "/" .. #Shop.DailyRewards .. "  (día 7: caja gratis)",
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = daily,
	})
	local claim = UI.button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(220, 46),
		Text = data.DailyAvailable and "¡Reclamar!" or "Vuelve mañana",
		BackgroundColor3 = data.DailyAvailable and GREEN or GREY,
		Parent = daily,
	}, { UI.gloss() })
	claim.Activated:Connect(function()
		Menu.ClaimDaily()
	end)

	-- Ofertas del día
	sectionTitle(scroll, "🔥 Ofertas de hoy (-" .. math.floor(Shop.OfferDiscount * 100) .. "%)", 2)
	local offers = row(scroll, 3, 190)
	for i, offer in Shop.GetDailyOffers(data.Day) do
		local name, rarity = itemName(offer.Kind, offer.Id)
		local owned
		if offer.Kind == "Skin" then
			owned = data.Skins[offer.Id] == true
		elseif offer.Kind == "KillEffect" then
			owned = data.KillEffects ~= nil and data.KillEffects[offer.Id] == true
		else
			owned = data.Outfits[offer.Id] == true
		end
		local card = UI.new("Frame", { LayoutOrder = i, Size = UDim2.fromOffset(200, 190), BackgroundColor3 = CARD_BG, Parent = offers }, {
			UI.corner(12),
			UI.stroke(rarityColor(rarity), 2, 0),
		})
		if offer.Kind == "Skin" then
			WeaponIcon.Create(data.Primary or "ARX27", offer.Id, { Position = UDim2.fromOffset(8, 6), Size = UDim2.fromOffset(184, 80), Parent = card }, "angled", 184 / 80)
		elseif offer.Kind == "KillEffect" then
			local icon = UI.button({
				Position = UDim2.fromOffset(50, 6),
				Size = UDim2.fromOffset(100, 80),
				Text = KillEffects.Get(offer.Id).Icon,
				TextSize = 56,
				BackgroundTransparency = 1,
				Parent = card,
			})
			icon.Activated:Connect(function()
				previewKillEffect(offer.Id)
			end)
		else
			outfitViewport(offer.Id, { Position = UDim2.fromOffset(50, 2), Size = UDim2.fromOffset(100, 90), Parent = card })
		end
		UI.label({ Position = UDim2.fromOffset(0, 92), Size = UDim2.new(1, 0, 0, 24), Text = name, TextSize = 19, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 116),
			Size = UDim2.new(1, 0, 0, 18),
			Text = (offer.Kind == "Outfit" and "Traje · " or offer.Kind == "KillEffect" and "Efecto · " or "Skin · ") .. rarity,
			TextSize = 14,
			TextColor3 = rarityColor(rarity),
			Parent = card,
		})
		priceButton(card, offer.Kind, offer.Id, owned, false, function()
			Sounds.Play("Click")
			if offer.Kind == "Skin" then
				Remotes.EquipSkin:FireServer(offer.Id)
			elseif offer.Kind == "KillEffect" then
				Remotes.EquipKillEffect:FireServer(offer.Id)
			else
				Remotes.EquipOutfit:FireServer(offer.Id)
			end
		end)
	end

	-- Cajas
	sectionTitle(scroll, "🎁 Cajas", 4)
	local crates = row(scroll, 5, 150)
	for crateId, crate in Shop.Crates do
		local card = UI.new("Frame", { Size = UDim2.fromOffset(480, 150), BackgroundColor3 = Color3.fromRGB(50, 30, 80), Parent = crates }, {
			UI.corner(12),
			UI.stroke(Color3.fromRGB(190, 80, 255), 2, 0),
			UI.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(140, 100, 255)), Rotation = 30 }),
		})
		UI.label({
			Position = UDim2.fromOffset(16, 8),
			Size = UDim2.fromOffset(300, 30),
			Text = "🎁 " .. crate.Name,
			TextSize = 26,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		local oddsText = {}
		for _, entry in crate.Odds do
			table.insert(oddsText, entry.Rarity .. " " .. entry.Weight .. "%")
		end
		UI.label({
			Position = UDim2.fromOffset(16, 40),
			Size = UDim2.fromOffset(450, 36),
			Text = "Probabilidades: "
				.. table.concat(oddsText, " · ")
				.. "\nSkins y trajes. Si repites, recuperas el "
				.. math.floor(crate.DuplicateRefund * 100)
				.. "%.",
			TextSize = 14,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = UI.FontBody,
			TextStrokeTransparency = 1,
			Parent = card,
		})
		local buyCrate = UI.button({
			Position = UDim2.fromOffset(16, 90),
			Size = UDim2.fromOffset(210, 46),
			Text = data.CratesRestricted and "No disponible" or ("Abrir · " .. coinsText(crate.Price)),
			BackgroundColor3 = data.CratesRestricted and GREY or Color3.fromRGB(230, 140, 20),
			Parent = card,
		}, { UI.gloss() })
		buyCrate.Activated:Connect(function()
			if not data.CratesRestricted then
				openCrate(crateId, false)
			end
		end)
		local free = UI.button({
			Position = UDim2.fromOffset(240, 90),
			Size = UDim2.fromOffset(220, 46),
			Text = "Gratis (" .. tostring(data.FreeCrates or 0) .. ")",
			BackgroundColor3 = (data.FreeCrates or 0) > 0 and GREEN or GREY,
			Parent = card,
		}, { UI.gloss() })
		free.Activated:Connect(function()
			if (data.FreeCrates or 0) > 0 then
				openCrate(crateId, true)
			end
		end)
	end

	-- Monedas con Robux
	sectionTitle(scroll, "🪙 Monedas", 6)
	local packs = row(scroll, 7, 170)
	for i, pack in Shop.CoinPacks do
		local card = UI.new("Frame", { LayoutOrder = i, Size = UDim2.fromOffset(200, 170), BackgroundColor3 = Color3.fromRGB(60, 50, 20), Parent = packs }, {
			UI.corner(12),
			UI.stroke(GOLD, 2, 0),
			UI.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 160, 60)), Rotation = 90 }),
		})
		UI.label({ Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 44), Text = string.rep("🪙", math.min(i + 1, 4)), TextSize = 30, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 56), Size = UDim2.new(1, 0, 0, 30), Text = tostring(pack.Coins), TextSize = 30, TextColor3 = GOLD, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 86), Size = UDim2.new(1, 0, 0, 20), Text = pack.Name, TextSize = 16, Parent = card })
		if pack.Tag then
			UI.label({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -6, 0, 4),
				Size = UDim2.fromOffset(120, 18),
				Text = pack.Tag,
				TextSize = 13,
				TextColor3 = Color3.fromRGB(120, 255, 140),
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = card,
			})
		end
		local buyPack = UI.button({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.new(1, -20, 0, 40),
			Text = pack.ProductId ~= 0 and ("R$ " .. pack.Robux) or "Próximamente",
			BackgroundColor3 = pack.ProductId ~= 0 and GREEN or GREY,
			Parent = card,
		}, { UI.gloss() })
		buyPack.Activated:Connect(function()
			if pack.ProductId ~= 0 then
				MarketplaceService:PromptProductPurchase(player, pack.ProductId)
			end
		end)
	end

	-- Revivir instantáneo con Robux (vuelves a la acción justo donde caíste)
	local PINK_REVIVE = Color3.fromRGB(255, 70, 200)
	sectionTitle(scroll, "💖 Revivir instantáneo", 8)
	local revives = row(scroll, 9, 150)
	for i, pack in Shop.RevivePacks do
		local card = UI.new("Frame", { LayoutOrder = i, Size = UDim2.fromOffset(200, 150), BackgroundColor3 = Color3.fromRGB(70, 20, 60), Parent = revives }, {
			UI.corner(12),
			UI.stroke(PINK_REVIVE, 2, 0),
			UI.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 80, 170)), Rotation = 90 }),
		})
		UI.label({ Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 40), Text = string.rep("💖", i + 1), TextSize = 28, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 48), Size = UDim2.new(1, 0, 0, 30), Text = "x" .. pack.Revives, TextSize = 30, TextColor3 = Color3.fromRGB(255, 200, 240), Parent = card })
		if pack.Tag then
			UI.label({ Position = UDim2.fromOffset(0, 78), Size = UDim2.new(1, 0, 0, 18), Text = pack.Tag, TextSize = 13, TextColor3 = Color3.fromRGB(120, 255, 140), Parent = card })
		end
		local buyRevive = UI.button({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.new(1, -20, 0, 40),
			Text = pack.ProductId ~= 0 and ("R$ " .. pack.Robux) or "Próximamente",
			BackgroundColor3 = pack.ProductId ~= 0 and GREEN or GREY,
			Parent = card,
		}, { UI.gloss() })
		buyRevive.Activated:Connect(function()
			if pack.ProductId ~= 0 then
				MarketplaceService:PromptProductPurchase(player, pack.ProductId)
			end
		end)
	end

	-- VIP
	local vip = UI.new("Frame", {
		LayoutOrder = 10,
		Size = UDim2.new(1, -10, 0, 90),
		BackgroundColor3 = Color3.fromRGB(70, 50, 10),
		Parent = scroll,
	}, {
		UI.corner(12),
		UI.stroke(GOLD, 3, 0),
		UI.new("UIGradient", { Color = ColorSequence.new(GOLD, Color3.fromRGB(120, 60, 200)), Rotation = 0 }),
	})
	UI.label({
		Position = UDim2.fromOffset(16, 6),
		Size = UDim2.new(1, -280, 0, 34),
		Text = "👑 VIP",
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = vip,
	})
	UI.label({
		Position = UDim2.fromOffset(16, 42),
		Size = UDim2.new(1, -280, 0, 40),
		Text = "x2 XP · x2 monedas · caja gratis cada día",
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = vip,
	})
	local vipText = "Próximamente"
	if data.VIP then
		vipText = "✔ Ya eres VIP"
	elseif Shop.VIPPassId ~= 0 then
		vipText = "Hazte VIP · R$ " .. Shop.VIPRobux
	end
	local vipButton = UI.button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(240, 52),
		Text = vipText,
		BackgroundColor3 = data.VIP and GREEN or (Shop.VIPPassId ~= 0 and GOLD or GREY),
		TextColor3 = Color3.fromRGB(30, 20, 0),
		Parent = vip,
	}, { UI.gloss() })
	vipButton.Activated:Connect(function()
		if not data.VIP and Shop.VIPPassId ~= 0 then
			MarketplaceService:PromptGamePassPurchase(player, Shop.VIPPassId)
		end
	end)
end

---------------------------------------------------------------------------

local lastBuiltTab = nil

function refresh()
	if not content then
		return
	end
	-- Si se reconstruye la misma pestaña, se mantiene la posición del scroll
	local keepScroll = nil
	if lastBuiltTab == currentTab then
		local old = content:FindFirstChildOfClass("ScrollingFrame")
		keepScroll = old and old.CanvasPosition
	end
	lastBuiltTab = currentTab
	for _, child in content:GetChildren() do
		child:Destroy()
	end
	local data = ClientState.Data
	if headerInfo then
		headerInfo.Text = data and ("Nivel " .. data.Level .. "   " .. coinsText(data.Coins) .. (data.VIP and "   👑" or "")) or "Cargando..."
	end
	for name, button in tabButtons do
		button.BackgroundColor3 = name == currentTab and BLUE or CARD_BG
	end
	if not data then
		UI.label({ Size = UDim2.fromScale(1, 1), Text = "Cargando datos...", TextSize = 24, Parent = content })
		return
	end
	if currentTab == "Perfil" then
		buildProfilePage(data)
	elseif currentTab == "Pase" then
		buildPassPage(data)
	elseif currentTab == "Retos" then
		buildChallengesPage(data)
	elseif currentTab == "Armas" then
		buildWeaponsPage(data)
	elseif currentTab == "Skins" then
		buildSkinsPage(data)
	elseif currentTab == "Trajes" then
		buildOutfitsPage(data)
	elseif currentTab == "Efectos" then
		buildKillEffectsPage(data)
	elseif currentTab == "Ajustes" then
		buildSettingsPage()
	else
		buildShopPage(data)
	end
	if keepScroll then
		local scroll = content:FindFirstChildOfClass("ScrollingFrame")
		if scroll then
			task.defer(function()
				scroll.CanvasPosition = keepScroll
			end)
		end
	end
end

local menuModal -- botón Modal a nivel de pantalla: libera el ratón aunque el panel esté oculto

local function setOpen(open)
	if not open and crateOverlay then
		return -- no se cierra a mitad de abrir una caja
	end
	ClientState.MenuOpen = open
	if not open then
		ClientState.MenuClosedAt = os.clock()
	end
	panel.Visible = open
	if menuModal then
		menuModal.Visible = open
	end
	ClientState.UpdateMouse()
	if open then
		refresh()
	end
end

function Menu.Toggle()
	-- Durante la vista previa de un efecto el panel está oculto pero el menú sigue abierto
	setOpen(not ClientState.MenuOpen)
end

-- Abre el menú directamente en una pestaña
function Menu.Open(tab)
	if tab then
		currentTab = tab
	end
	setOpen(true)
end

function Menu.Close()
	if ClientState.MenuOpen then
		setOpen(false)
	end
end

function Menu.IsOpen()
	return panel ~= nil and ClientState.MenuOpen
end

-- Recoge la recompensa diaria (también se usa desde la pantalla de inicio)
function Menu.ClaimDaily()
	if busy then
		return false
	end
	busy = true
	local ok, success, result = pcall(function()
		return Remotes.ClaimDaily:InvokeServer()
	end)
	busy = false
	if ok and success and type(result) == "table" then
		Sounds.Play("Kill")
		showToast("Día " .. result.Streak .. ": +" .. result.Coins .. " monedas" .. (result.Crate and " y una caja gratis 🎁" or ""), GOLD)
		return true
	end
	showToast("Ya la has recogido hoy. ¡Vuelve mañana!")
	return false
end

function Menu.Init()
	gui = UI.new("ScreenGui", {
		Name = "Menu",
		ResetOnSpawn = false,
		DisplayOrder = 5,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})

	-- Botón superior (útil en móvil)
	local open = UI.button({
		Position = UDim2.fromOffset(16, 58),
		Size = UDim2.fromOffset(210, 38),
		Text = "⭐ PASE · TIENDA",
		BackgroundColor3 = Color3.fromRGB(255, 120, 30),
		TextSize = 18,
		Parent = gui,
	}, { UI.stroke(Color3.new(0, 0, 0), 2, 0.3), UI.gloss() })
	open.Activated:Connect(Menu.Toggle)

	panel = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.new(0.92, 0, 0.84, 0),
		BackgroundColor3 = PANEL_BG,
		Active = true, -- los clics y toques no atraviesan el panel
		Visible = false,
		Parent = gui,
	}, {
		UI.corner(16),
		UI.stroke(Color3.fromRGB(255, 140, 40), 3, 0),
		UI.padding(16),
		UI.new("UISizeConstraint", { MaxSize = Vector2.new(1100, 640) }),
		UI.new("UIGradient", {
			Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 120, 200)),
			Rotation = 120,
		}),
	})

	-- Botón "Modal": libera el ratón en primera persona mientras el menú está abierto
	menuModal = UI.new("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true, Visible = false, Parent = gui })

	-- En pantallas pequeñas (móviles) todo el panel se escala para que quepa entero
	local panelScale = UI.new("UIScale", { Parent = panel })
	local function rescalePanel()
		local viewport = workspace.CurrentCamera.ViewportSize
		local s = math.clamp(math.min(viewport.X / 1150, viewport.Y / 700), 0.5, 1)
		panelScale.Scale = s
		panel.Size = UDim2.fromScale(math.min(0.92 / s, 1 / s), math.min(0.84 / s, 0.95 / s))
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescalePanel)
	rescalePanel()

	UI.label({
		Size = UDim2.fromOffset(400, 36),
		Text = "⚡ " .. GameConfig.GameTitle,
		TextSize = 32,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(255, 170, 50),
		Parent = panel,
	})
	headerInfo = UI.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -50, 0, 0),
		Size = UDim2.fromOffset(360, 36),
		Text = "",
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = panel,
	})
	local close = UI.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(36, 36),
		Text = "✕",
		BackgroundColor3 = Color3.fromRGB(220, 60, 60),
		Parent = panel,
	})
	close.Activated:Connect(function()
		setOpen(false)
	end)

	-- Barra de pestañas con desplazamiento horizontal (en pantallas estrechas no caben todas)
	local tabs = UI.new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 0, 42),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 3,
		Parent = panel,
	}, {
		UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i, name in TABS do
		local button = UI.button({
			LayoutOrder = i,
			Size = UDim2.fromOffset(name == "Ajustes" and 52 or 112, 38),
			Text = name == "Tienda" and "🛒 Tienda" or name == "Retos" and "🎯 Retos" or name == "Efectos" and "💥 Efectos" or name == "Ajustes" and "⚙" or name,
			BackgroundColor3 = CARD_BG,
			Parent = tabs,
		})
		button.Activated:Connect(function()
			currentTab = name
			Sounds.Play("Click")
			refresh()
		end)
		tabButtons[name] = button
	end

	content = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 96),
		Size = UDim2.new(1, 0, 1, -96),
		BackgroundTransparency = 1,
		Parent = panel,
	})

	toast = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -20),
		Size = UDim2.fromOffset(700, 36),
		Text = "",
		TextSize = 24,
		TextStrokeTransparency = 0,
		Visible = false,
		ZIndex = 40,
		Parent = gui,
	})

	ContextActionService:BindAction("Menu", function(_, state)
		-- Muerto, la B es "Revivir instantáneo" (pantalla de muerte); solo sirve para cerrar la tienda
		if state == Enum.UserInputState.Begin and (not ClientState.Dead or ClientState.MenuOpen) then
			Menu.Toggle()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.B, Enum.KeyCode.ButtonSelect)

	-- Si se cancela la compra del pack de inicio, el botón vuelve a estar disponible
	MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, purchased)
		if userId == player.UserId and productId == Shop.StarterPack.ProductId and not purchased and ClientState.MenuOpen then
			refresh()
		end
	end)

	-- Una baja puede mandar varias actualizaciones seguidas: se agrupan en una sola reconstrucción
	local refreshQueued = false
	ClientState.DataChanged.Event:Connect(function()
		if not panel.Visible or refreshQueued then
			return
		end
		refreshQueued = true
		task.delay(0.4, function()
			refreshQueued = false
			if panel.Visible then
				refresh()
			end
		end)
	end)
end

return Menu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">Movement</string>
              <string name="Source"><![CDATA[-- Movimiento: correr (Shift) y deslizarse (C).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Sounds = require(Shared.Sounds)

local ClientState = require(script.Parent.ClientState)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Movement = {}

local humanoid, rootPart
local sprintHeld = false
local lastSlide = -10
local stopSlide

local function tweenCameraOffset(offset, time)
	if humanoid then
		TweenService:Create(humanoid, TweenInfo.new(time, Enum.EasingStyle.Quad), { CameraOffset = offset }):Play()
	end
end

-- Polvo que levanta el deslizamiento, del color del suelo (nieve, tierra, hormigón...)
local SLIDE_DUST = {
	[Enum.Material.Snow] = Color3.fromRGB(240, 245, 255),
	[Enum.Material.Ice] = Color3.fromRGB(225, 240, 255),
	[Enum.Material.Glacier] = Color3.fromRGB(225, 240, 255),
	[Enum.Material.Grass] = Color3.fromRGB(140, 120, 85),
	[Enum.Material.LeafyGrass] = Color3.fromRGB(140, 120, 85),
	[Enum.Material.Ground] = Color3.fromRGB(150, 125, 90),
	[Enum.Material.Mud] = Color3.fromRGB(110, 85, 60),
	[Enum.Material.Sand] = Color3.fromRGB(205, 185, 140),
}

local function slideDust(floorMaterial)
	if not rootPart or not humanoid or ClientState.EffectiveQuality == "Baja" then
		return nil
	end
	local feet = Instance.new("Attachment")
	feet.Name = "SlideDust"
	feet.Position = Vector3.new(0, -(humanoid.HipHeight + rootPart.Size.Y / 2) + 0.3, 0)
	feet.Parent = rootPart
	local dust = Instance.new("ParticleEmitter")
	dust.Texture = "rbxasset://textures/particles/smoke_main.dds"
	dust.Color = ColorSequence.new(SLIDE_DUST[floorMaterial] or Color3.fromRGB(175, 172, 165))
	dust.LightInfluence = 1
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 2.4) })
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
	dust.Lifetime = NumberRange.new(0.5, 0.8)
	dust.Speed = NumberRange.new(2, 4)
	dust.SpreadAngle = Vector2.new(50, 50)
	dust.Acceleration = Vector3.new(0, 1, 0)
	dust.Rotation = NumberRange.new(0, 360)
	dust.RotSpeed = NumberRange.new(-40, 40)
	dust.Rate = 40
	dust.EmissionDirection = Enum.NormalId.Top
	dust.Parent = feet
	return feet
end

local wasFrozen = false

local function slide()
	if ClientState.Sliding or ClientState.Dashing or ClientState.IsBlocked() or ClientState.Frozen() or not humanoid or humanoid.Health <= 0 or not rootPart then
		return
	end
	if os.clock() - lastSlide < GameConfig.SlideCooldown or humanoid.FloorMaterial == Enum.Material.Air then
		return
	end
	local direction = humanoid.MoveDirection
	if direction.Magnitude < 0.1 then
		direction = camera.CFrame.LookVector
	end
	direction = Vector3.new(direction.X, 0, direction.Z)
	if direction.Magnitude < 0.01 then
		return
	end
	direction = direction.Unit

	lastSlide = os.clock()
	ClientState.Sliding = true
	Sounds.Play("Slide")
	local dust = slideDust(humanoid.FloorMaterial)

	local attachment = Instance.new("Attachment")
	attachment.Name = "SlideAttachment"
	attachment.Parent = rootPart
	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	-- Modo plano: solo empuja en X/Z, la gravedad sigue actuando
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	velocity.PrimaryTangentAxis = Vector3.xAxis
	velocity.SecondaryTangentAxis = Vector3.zAxis
	velocity.MaxForce = 80000
	velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z) * GameConfig.SlideSpeed
	velocity.Parent = rootPart

	tweenCameraOffset(Vector3.new(0, -1.8, 0), 0.12)

	local start = os.clock()
	local connection
	local stopped = false
	stopSlide = function()
		if stopped then
			return
		end
		stopped = true
		connection:Disconnect()
		velocity:Destroy()
		attachment:Destroy()
		if dust then
			-- Deja de emitir y se borra cuando se han disipado las últimas partículas
			local emitter = dust:FindFirstChildOfClass("ParticleEmitter")
			if emitter then
				emitter.Enabled = false
			end
			task.delay(1, function()
				dust:Destroy()
			end)
		end
		ClientState.Sliding = false
		tweenCameraOffset(Vector3.zero, 0.2)
	end
	connection = RunService.Heartbeat:Connect(function()
		local alpha = (os.clock() - start) / GameConfig.SlideDuration
		local state = humanoid:GetState()
		if alpha >= 1 or humanoid.Health <= 0 or humanoid.Jump or state == Enum.HumanoidStateType.Jumping then
			stopSlide()
			return
		end
		local speed = GameConfig.SlideSpeed + (GameConfig.WalkSpeed - GameConfig.SlideSpeed) * alpha * alpha
		velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z) * speed
	end)
end

-- Hielo: el Humanoid ignora la fricción del suelo, así que el patinaje se hace con una LinearVelocity
-- (dentro del paso de física, como el deslizamiento): la velocidad cambia despacio hacia donde quieres ir.
local iceVelocity = Vector3.zero
local iceMover: LinearVelocity? = nil

local function stopIce()
	if iceMover then
		local attachment = iceMover.Attachment0
		iceMover:Destroy()
		if attachment then
			attachment:Destroy()
		end
		iceMover = nil
	end
end

local function iceSlide(dt)
	local state = humanoid:GetState()
	local onIce = humanoid.FloorMaterial == Enum.Material.Ice
		and not ClientState.Sliding
		and not ClientState.Dashing
		and state ~= Enum.HumanoidStateType.Jumping
		and state ~= Enum.HumanoidStateType.Freefall
	if not onIce then
		stopIce()
		local velocity = rootPart.AssemblyLinearVelocity
		iceVelocity = Vector3.new(velocity.X, 0, velocity.Z)
		return
	end
	if not iceMover or iceMover.Parent ~= rootPart then
		stopIce()
		local attachment = Instance.new("Attachment")
		attachment.Name = "IceAttachment"
		attachment.Parent = rootPart
		local mover = Instance.new("LinearVelocity")
		mover.Name = "IceVelocity"
		mover.Attachment0 = attachment
		mover.RelativeTo = Enum.ActuatorRelativeTo.World
		mover.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
		mover.PrimaryTangentAxis = Vector3.xAxis
		mover.SecondaryTangentAxis = Vector3.zAxis
		mover.MaxForce = 30000
		mover.Parent = rootPart
		iceMover = mover
	end
	local wanted = humanoid.MoveDirection * humanoid.WalkSpeed
	iceVelocity = iceVelocity:Lerp(Vector3.new(wanted.X, 0, wanted.Z), math.min(1, dt * 1.5))
	if iceMover then
		iceMover.PlaneVelocity = Vector2.new(iceVelocity.X, iceVelocity.Z)
	end
end

local function update(dt)
	if not humanoid or humanoid.Health <= 0 or not rootPart then
		ClientState.Sprinting = false
		return
	end
	iceSlide(dt)
	local moving = humanoid.MoveDirection.Magnitude > 0.1
	local recentlyShot = os.clock() - ClientState.LastShotTime < 0.35
	ClientState.Sprinting = sprintHeld
		and moving
		and not ClientState.Aiming
		and not recentlyShot
		and not ClientState.Sliding
		and not ClientState.IsBlocked()

	local speed = GameConfig.WalkSpeed
	if ClientState.Sprinting then
		speed = GameConfig.SprintSpeed
	elseif ClientState.Aiming then
		speed = GameConfig.AimWalkSpeed
	end
	local weaponDef = ClientState.CurrentDef
	if weaponDef and weaponDef.WalkSpeedMultiplier then
		speed *= weaponDef.WalkSpeedMultiplier
	end
	if player:GetAttribute("CarryingFlag") then
		speed *= GameConfig.Flag.CarrierSpeedMultiplier
	end
	-- Cuenta atrás de Eliminación: quieto y sin saltar
	local frozen = ClientState.Frozen()
	if frozen then
		speed = 0
	end
	if frozen ~= wasFrozen then
		wasFrozen = frozen
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, not frozen)
	end
	humanoid.WalkSpeed = speed
end

local function onCharacter(newCharacter)
	if stopSlide then
		stopSlide()
		stopSlide = nil
	end
	ClientState.Sliding = false
	iceMover = nil -- era del personaje anterior
	humanoid = newCharacter:WaitForChild("Humanoid")
	wasFrozen = false -- el humanoide nuevo empieza con el salto activado (después de cambiarlo)
	rootPart = newCharacter:WaitForChild("HumanoidRootPart")
	humanoid.CameraOffset = Vector3.zero
end

function Movement.Init()
	ContextActionService:BindAction("Sprint", function(_, state, input)
		if input.UserInputType == Enum.UserInputType.Touch then
			if state == Enum.UserInputState.Begin and not ClientState.IsBlocked() then
				sprintHeld = not sprintHeld
			end
		elseif state == Enum.UserInputState.Begin then
			sprintHeld = true
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			sprintHeld = false
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
	ContextActionService:SetTitle("Sprint", "Correr")
	ContextActionService:SetPosition("Sprint", UDim2.new(1, -260, 1, -160))

	ContextActionService:BindAction("Slide", function(_, state)
		if state == Enum.UserInputState.Begin then
			slide()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.C, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonR3)
	ContextActionService:SetTitle("Slide", "Deslizar")
	ContextActionService:SetPosition("Slide", UDim2.new(1, -270, 1, -240))

	-- Si la ventana pierde el foco dejamos de correr
	UserInputService.WindowFocusReleased:Connect(function()
		sprintHeld = false
	end)

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	RunService.Heartbeat:Connect(update)
end

return Movement
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">PlaytimeGifts</string>
              <string name="Source"><![CDATA[-- Botón de regalos por tiempo jugado (a la izquierda, debajo de los retos): cuenta atrás hasta el
-- siguiente regalo y, cuando está listo, brilla y se recoge con la tecla H (en partida el ratón está
-- bloqueado) o tocándolo en móvil. Lo valida el servidor (Gifts).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Sounds = require(Shared.Sounds)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local PlaytimeGifts = {}

local READY = Color3.fromRGB(255, 190, 40)
local WAITING = Color3.fromRGB(45, 50, 80)

local gui, button, icon, label, sub, scale
local claiming = false
local message, messageUntil = nil, 0 -- aviso breve si el servidor no deja recogerlo
local compact = false -- móvil: solo el icono y el tiempo (arriba a la izquierda)

local function rewardText(gift)
	local parts = {}
	if gift.Coins then
		table.insert(parts, gift.Coins .. " 🪙")
	end
	if gift.XP then
		table.insert(parts, gift.XP .. " XP")
	end
	if gift.Revives then
		table.insert(parts, gift.Revives .. " 💖")
	end
	return table.concat(parts, " + ")
end

-- Siguiente regalo y segundos que faltan (nil si ya se recogieron todos)
local function nextGift()
	local start = player:GetAttribute("GiftStart")
	local index = (player:GetAttribute("GiftsClaimed") or 0) + 1
	local gift = GameConfig.PlaytimeGifts[index]
	if not start or not gift then
		return nil
	end
	return gift, math.max(0, start + gift.Minutes * 60 - workspace:GetServerTimeNow())
end

local function update()
	local gift, left = nextGift()
	gui.Enabled = gift ~= nil and not ClientState.InMainMenu and not ClientState.Dead
	if not gift then
		return
	end
	local ready = left <= 0
	button.BackgroundColor3 = ready and READY or WAITING
	if compact then
		label.Text = ready and "¡YA!" or UI.formatTime(left)
	else
		label.Text = ready and "¡RECOGER! (H)" or ("REGALO EN " .. UI.formatTime(left))
	end
	sub.Text = (message and os.clock() < messageUntil) and message or rewardText(gift)
	-- Late cuando está listo
	scale.Scale = ready and (1 + math.sin(os.clock() * 6) * 0.05) or 1
	icon.Rotation = ready and math.sin(os.clock() * 10) * 12 or 0
end

local function claim()
	local gift, left = nextGift()
	if claiming or not gift or left > 0 then
		return
	end
	claiming = true
	Sounds.Play("Click")
	local ok, result, reason = pcall(function()
		return Remotes.ClaimGift:InvokeServer()
	end)
	claiming = false
	if not (ok and result) then
		message, messageUntil = (ok and type(reason) == "string") and reason or "Inténtalo otra vez", os.clock() + 2
	end
	if ok and result then
		Sounds.Play("Flag")
		-- Pequeño salto del botón al recogerlo
		scale.Scale = 1.25
		TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
end

function PlaytimeGifts.Init()
	gui = UI.new("ScreenGui", {
		Name = "PlaytimeGifts",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- En móvil: botón pequeño arriba a la izquierda (abajo está el joystick y los retos ocupan el centro)
	compact = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	button = UI.button({
		AnchorPoint = Vector2.new(0, 0),
		Position = compact and UDim2.fromOffset(10, 104) or UDim2.new(0, 66, 0.38, 112), -- (en móvil, debajo del botón de la tienda)
		Size = compact and UDim2.fromOffset(52, 64) or UDim2.fromOffset(230, 56),
		Text = "",
		BackgroundColor3 = WAITING,
		BackgroundTransparency = 0.1,
		Parent = gui,
	}, { UI.stroke(Color3.new(1, 1, 1), 2, 0.3) })
	scale = UI.new("UIScale", { Parent = button })
	icon = UI.label({
		Position = UDim2.fromOffset(4, 0),
		Size = UDim2.fromOffset(50, 56),
		Text = "🎁",
		TextSize = 34,
		Parent = button,
	})
	label = UI.label({
		Position = UDim2.fromOffset(56, 6),
		Size = UDim2.new(1, -62, 0, 24),
		Text = "",
		TextSize = 19,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = button,
	})
	sub = UI.label({
		Position = UDim2.fromOffset(56, 30),
		Size = UDim2.new(1, -62, 0, 20),
		Text = "",
		TextSize = 15,
		TextColor3 = Color3.fromRGB(255, 235, 170),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = button,
	})
	if compact then
		-- Icono arriba y el tiempo debajo, sin la línea del premio
		icon.Position, icon.Size, icon.TextSize = UDim2.fromOffset(0, 2), UDim2.new(1, 0, 0, 38), 30
		label.Position, label.Size = UDim2.fromOffset(0, 40), UDim2.new(1, 0, 0, 20)
		label.TextXAlignment = Enum.TextXAlignment.Center
		label.TextSize = 15
		sub.Visible = false
	end
	button.Activated:Connect(claim)
	ContextActionService:BindAction("ClaimGift", function(_, state)
		if state == Enum.UserInputState.Begin and gui.Enabled and not ClientState.IsBlocked() then
			claim()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.H)
	task.spawn(function()
		while true do
			update()
			-- Rápido solo cuando late (regalo listo y a la vista)
			local gift, left = nextGift()
			task.wait((gui.Enabled and gift and left <= 0) and 0.1 or 0.25)
		end
	end)
end

return PlaytimeGifts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">QuestTracker</string>
              <string name="Source"><![CDATA[-- Retos del día siempre a la vista (izquierda de la pantalla), con barra de progreso que se llena al
-- jugar y un aviso dorado al completarlos. Se oculta en la pantalla de inicio y al morir.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Sounds = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Sounds"))

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local QuestTracker = {}

local gui, panel
local rows = {} -- [índice] = { Frame, Text, Fill, Count, Check, Done, Progress }

local GREEN = Color3.fromRGB(80, 230, 90)
local GOLD = Color3.fromRGB(255, 205, 60)

local function makeRow(index)
	local frame = UI.new("Frame", {
		LayoutOrder = index,
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	local text = UI.label({
		Size = UDim2.new(1, -40, 0, 20),
		Text = "",
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})
	local count = UI.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(60, 20),
		Text = "",
		TextSize = 15,
		TextColor3 = Color3.fromRGB(210, 215, 230),
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = frame,
	})
	local bar = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 0, 12),
		BackgroundColor3 = Color3.fromRGB(30, 32, 44),
		BackgroundTransparency = 0.2,
		Parent = frame,
	}, { UI.corner(6), UI.stroke(Color3.new(0, 0, 0), 1.5, 0.4) })
	local fill = UI.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.fromRGB(70, 170, 255),
		Parent = bar,
	}, { UI.corner(6), UI.gloss() })
	local check = UI.label({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 4, 0, 30),
		Size = UDim2.fromOffset(22, 22),
		Text = "✔",
		TextSize = 20,
		TextColor3 = GREEN,
		Visible = false,
		Parent = frame,
	})
	return { Frame = frame, Text = text, Fill = fill, Count = count, Check = check, Done = nil, Progress = nil }
end

-- Destello dorado cuando se completa un reto
local function celebrate(row)
	Sounds.Play("Flag")
	local flash = UI.new("Frame", {
		Size = UDim2.new(1, 12, 1, 8),
		Position = UDim2.fromOffset(-6, -4),
		BackgroundColor3 = GOLD,
		BackgroundTransparency = 0.35,
		ZIndex = 0,
		Parent = row.Frame,
	}, { UI.corner(8) })
	TweenService:Create(flash, TweenInfo.new(1.2), { BackgroundTransparency = 1 }):Play()
	task.delay(1.3, function()
		flash:Destroy()
	end)
end

local function refresh(data)
	local challenges = data and data.Challenges
	local list = challenges and challenges.List or {}
	for i, entry in list do
		local row = rows[i] or makeRow(i)
		rows[i] = row
		row.Frame.Visible = true
		row.Text.Text = entry.Text or ""
		local goal = math.max(1, entry.Goal or 1)
		local progress = math.min(entry.Progress or 0, goal)
		row.Count.Text = entry.Done and "" or (progress .. "/" .. goal)
		row.Check.Visible = entry.Done == true
		row.Text.TextColor3 = entry.Done and GREEN or Color3.new(1, 1, 1)
		local ratio = entry.Done and 1 or progress / goal
		TweenService:Create(row.Fill, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { Size = UDim2.fromScale(ratio, 1) }):Play()
		row.Fill.BackgroundColor3 = entry.Done and GREEN or Color3.fromRGB(70, 170, 255)
		-- Solo celebra si lo hemos visto pasar de pendiente a hecho (no al cargar)
		if row.Done == false and entry.Done then
			celebrate(row)
		end
		row.Done = entry.Done == true
		row.Progress = progress
	end
	for i = #list + 1, #rows do
		rows[i].Frame.Visible = false
	end
	panel.Parent.Visible = #list > 0
end

function QuestTracker.Init()
	gui = UI.new("ScreenGui", {
		Name = "QuestTracker",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local holder = UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 66, 0.38, 0),
		Size = UDim2.fromOffset(250, 190),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	local scale = UI.new("UIScale", { Parent = holder })
	local function rescale()
		local size = camera.ViewportSize
		scale.Scale = math.clamp(math.min(size.X / 1280, size.Y / 720), 0.6, 1)
	end
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()
	UI.label({
		Size = UDim2.new(1, 0, 0, 24),
		Text = "🎯 RETOS DE HOY",
		TextSize = 18,
		TextColor3 = GOLD,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = holder,
	})
	panel = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 1, -28),
		BackgroundTransparency = 1,
		Parent = holder,
	}, { UI.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })

	ClientState.DataChanged.Event:Connect(refresh)
	refresh(ClientState.Data)
	RunService.Heartbeat:Connect(function()
		gui.Enabled = not ClientState.InMainMenu and not ClientState.Dead and not ClientState.MenuOpen
	end)
end

return QuestTracker
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">Scoreboard</string>
              <string name="Source"><![CDATA[-- Marcador de la partida (mantén Tab; en móvil, botón 📋): los dos equipos en columnas (o una sola
-- lista en los modos sin equipos) con bajas, muertes y puntos. Incluye a los bots (ReplicatedStorage.
-- BotStats, que rellena el servidor) y resalta tu fila. Sustituye a la lista de jugadores de Roblox.
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Ranks = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Ranks"))
local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local Scoreboard = {}

local gui, panel, title, columns
local visible = false
local ROW_HEIGHT = 30
local MAX_ROWS = 10

-- Una fila por jugador o bot: { Name, Team, Kills, Deaths, Score, Captures, IsBot, IsMe }
local function collect()
	local rows = {}
	for _, p in Players:GetPlayers() do
		local stats = p:FindFirstChild("leaderstats")
		local kills = stats and stats:FindFirstChild("Bajas")
		local deaths = stats and stats:FindFirstChild("Muertes")
		local rank = Ranks.Tiers[p:GetAttribute("Rank") or 0]
		table.insert(rows, {
			Name = (rank and (rank.Icon .. " ") or "") .. p.DisplayName,
			Team = p.Team,
			Kills = kills and kills.Value or 0,
			Deaths = deaths and deaths.Value or 0,
			Score = p:GetAttribute("Score") or 0,
			Captures = p:GetAttribute("Captures") or 0,
			InMenu = p:GetAttribute("InMenu") == true,
			IsMe = p == player,
		})
	end
	local bots = ReplicatedStorage:FindFirstChild("BotStats")
	if bots then
		for _, entry in bots:GetChildren() do
			local teamName = entry:GetAttribute("Team")
			local team = teamName and teamName ~= "" and Teams:FindFirstChild(teamName) or nil
			table.insert(rows, {
				Name = "🤖 " .. entry.Name,
				Team = team,
				Kills = entry:GetAttribute("Kills") or 0,
				Deaths = entry:GetAttribute("Deaths") or 0,
				Score = entry:GetAttribute("Score") or 0,
				Captures = 0,
				IsBot = true,
			})
		end
	end
	return rows
end

local function header(parent, text, color)
	local bar = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = color,
		Parent = parent,
	}, { UI.corner(8) })
	UI.label({
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -24, 1, 0),
		Text = text,
		TextSize = 22,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = bar,
	})
	return bar
end

local function columnTitles(parent, y, third)
	local frame = UI.new("Frame", {
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	for i, text in { "JUGADOR", "BAJAS", "MUERTES", third } do
		UI.label({
			Position = i == 1 and UDim2.fromOffset(12, 0) or UDim2.new(1, -230 + (i - 2) * 76, 0, 0),
			Size = UDim2.fromOffset(i == 1 and 200 or 76, 22),
			Text = text,
			TextSize = 14,
			TextColor3 = Color3.fromRGB(200, 200, 220),
			TextXAlignment = i == 1 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center,
			Parent = frame,
		})
	end
end

local function rowFrame(parent, y, row, thirdValue, color)
	local frame = UI.new("Frame", {
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.new(1, 0, 0, ROW_HEIGHT - 2),
		BackgroundColor3 = row.IsMe and Color3.fromRGB(255, 205, 60) or color,
		BackgroundTransparency = row.IsMe and 0.25 or 0.65,
		Parent = parent,
	}, { UI.corner(6) })
	UI.label({
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -250, 1, 0),
		Text = row.Name .. (row.InMenu and "  💤" or ""),
		TextSize = 18,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = row.IsBot and Color3.fromRGB(215, 215, 230) or Color3.new(1, 1, 1),
		Parent = frame,
	})
	for i, value in { row.Kills, row.Deaths, thirdValue } do
		UI.label({
			Position = UDim2.new(1, -230 + (i - 1) * 76, 0, 0),
			Size = UDim2.fromOffset(76, ROW_HEIGHT - 2),
			Text = tostring(value),
			TextSize = 19,
			Parent = frame,
		})
	end
end

-- Columna de un equipo (o de todos en los modos sin equipos)
local function buildColumn(x, width, headerText, headerColor, rows, thirdTitle, thirdOf)
	local column = UI.new("Frame", {
		Position = UDim2.fromOffset(x, 56),
		Size = UDim2.fromOffset(width, 60 + MAX_ROWS * ROW_HEIGHT),
		BackgroundTransparency = 1,
		Parent = columns,
	})
	header(column, headerText, headerColor)
	columnTitles(column, 38, thirdTitle)
	-- Si no caben todos, tu fila siempre sale (en el último hueco)
	local shown = table.move(rows, 1, math.min(#rows, MAX_ROWS), 1, {})
	for i = MAX_ROWS + 1, #rows do
		if rows[i].IsMe then
			shown[MAX_ROWS] = rows[i]
		end
	end
	for i, row in shown do
		rowFrame(column, 60 + (i - 1) * ROW_HEIGHT, row, thirdOf(row), headerColor:Lerp(Color3.new(0, 0, 0), 0.4))
	end
	return column
end

local lastSignature = ""

local function refresh()
	if not visible then
		return
	end
	local mode = ReplicatedStorage:GetAttribute("Mode")
	local teamMode = ReplicatedStorage:GetAttribute("TeamMode") ~= false
	local mapName = ReplicatedStorage:GetAttribute("MapName") or ""
	local modeName = ReplicatedStorage:GetAttribute("ModeName") or ""
	title.Text = string.upper(modeName) .. "  ·  " .. mapName .. "  ·  " .. UI.formatTime(ReplicatedStorage:GetAttribute("TimeLeft") or 0)
	local rows = collect()
	-- Solo se reconstruye si ha cambiado algo (si no, cada medio segundo se crearían ~150 objetos)
	local parts = { tostring(mode), tostring(ReplicatedStorage:GetAttribute("TeamMode")), tostring(ReplicatedStorage:GetAttribute("LeaderName")) }
	for _, row in rows do
		table.insert(parts, string.format("%s/%s/%d/%d/%d/%d/%s", row.Name, tostring(row.Team), row.Kills, row.Deaths, row.Score, row.Captures, tostring(row.InMenu)))
	end
	for _, teamName in { ReplicatedStorage:GetAttribute("TeamA"), ReplicatedStorage:GetAttribute("TeamB") } do
		table.insert(parts, tostring(teamName and ReplicatedStorage:GetAttribute("Score_" .. teamName)))
	end
	local signature = table.concat(parts, "|")
	if signature == lastSignature and #columns:GetChildren() > 0 then
		return
	end
	lastSignature = signature
	columns:ClearAllChildren()
	local thirdTitle, thirdOf = "PUNTOS", function(row)
		return row.Score
	end
	if mode == "CTF" then
		thirdTitle, thirdOf = "CAPTURAS", function(row)
			return row.Captures
		end
	elseif teamMode then
		thirdTitle, thirdOf = "K/D", function(row)
			return string.format("%.1f", row.Kills / math.max(1, row.Deaths))
		end
	end
	local function byKills(a, b)
		if a.Kills ~= b.Kills then
			return a.Kills > b.Kills
		end
		return a.Deaths < b.Deaths
	end
	if teamMode then
		local nameA = ReplicatedStorage:GetAttribute("TeamA")
		local nameB = ReplicatedStorage:GetAttribute("TeamB")
		for i, teamName in { nameA, nameB } do
			local team = teamName and Teams:FindFirstChild(teamName)
			local list = {}
			for _, row in rows do
				if team and row.Team == team then
					table.insert(list, row)
				end
			end
			table.sort(list, byKills)
			local color = team and team:IsA("Team") and team.TeamColor.Color or Color3.fromRGB(80, 80, 100)
			local score = teamName and (ReplicatedStorage:GetAttribute("Score_" .. teamName) or 0) or 0
			local text = string.format("<b>%s</b>   %d", string.upper(teamName or "?"), score)
			buildColumn((i - 1) * 472, 440, text, color, list, thirdTitle, thirdOf)
		end
		panel.Size = UDim2.fromOffset(940, 56 + 60 + MAX_ROWS * ROW_HEIGHT + 16)
	else
		table.sort(rows, function(a, b)
			if a.Score ~= b.Score then
				return a.Score > b.Score
			end
			return byKills(a, b)
		end)
		local leader = ReplicatedStorage:GetAttribute("LeaderName")
		buildColumn(0, 572, "<b>TODOS CONTRA TODOS</b>" .. ((leader and leader ~= "") and ("   👑 " .. leader) or ""), Color3.fromRGB(200, 120, 40), rows, thirdTitle, thirdOf)
		panel.Size = UDim2.fromOffset(600, 56 + 60 + MAX_ROWS * ROW_HEIGHT + 16)
	end
end

local function setVisible(on)
	on = on and not ClientState.InMainMenu
	if on == visible then
		return
	end
	visible = on
	gui.Enabled = on
	refresh()
end

function Scoreboard.Init()
	-- La lista de jugadores de Roblox no enseña a los bots ni los equipos así: se usa esta
	task.spawn(function()
		for _ = 1, 20 do
			if pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.PlayerList, false) then
				return
			end
			task.wait(0.5)
		end
	end)
	gui = UI.new("ScreenGui", {
		Name = "Scoreboard",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 4,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	panel = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.48),
		Size = UDim2.fromOffset(940, 420),
		BackgroundColor3 = Color3.fromRGB(18, 20, 34),
		BackgroundTransparency = 0.12,
		Parent = gui,
	}, { UI.corner(16), UI.stroke(Color3.new(1, 1, 1), 3, 0.6), UI.padding(14) })
	local scale = UI.new("UIScale", { Parent = panel })
	local function fit()
		local viewport = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.clamp(math.min((viewport.X - 30) / panel.Size.X.Offset, (viewport.Y - 30) / panel.Size.Y.Offset), 0.4, 1)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	panel:GetPropertyChangedSignal("Size"):Connect(fit)
	title = UI.label({
		Size = UDim2.new(1, 0, 0, 40),
		Text = "",
		TextSize = 26,
		Parent = panel,
	})
	columns = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = panel })
	fit()

	-- Tab: se ve mientras se mantiene pulsado. En móvil el botón 📋 lo abre y lo cierra.
	ContextActionService:BindAction("Scoreboard", function(_, state, input)
		if input.UserInputType == Enum.UserInputType.Touch then
			if state == Enum.UserInputState.Begin then
				setVisible(not visible)
			end
		elseif state == Enum.UserInputState.Begin then
			setVisible(true)
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			setVisible(false)
		end
		return Enum.ContextActionResult.Pass
	end, UserInputService.TouchEnabled, Enum.KeyCode.Tab)
	-- Si la ventana pierde el foco con Tab pulsado, no llega el "soltar": se cierra igualmente
	UserInputService.WindowFocusReleased:Connect(function()
		if not UserInputService.TouchEnabled then
			setVisible(false)
		end
	end)
	ContextActionService:SetTitle("Scoreboard", "📋")
	ContextActionService:SetPosition("Scoreboard", UDim2.new(1, -60, 0, 70))

	task.spawn(function()
		while true do
			task.wait(0.5)
			if visible and ClientState.InMainMenu then
				setVisible(false)
			end
			refresh()
		end
	end)
end

return Scoreboard
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">Settings</string>
              <string name="Source"><![CDATA[-- Ajustes del jugador en el cliente: calidad gráfica, campo de visión y sensibilidad.
-- Los cambios de Lighting hechos en el cliente solo afectan a este jugador.
--
-- Calidad:
--   Auto  : Baja en móviles (solo táctil) y Media en PC
--   Baja  : sin sombras, sin bloom, sin rayos de sol, sin nubes ni partículas del mapa (móviles)
--   Media : sombras y bloom, sin rayos de sol ni conos de luz, menos partículas del mapa
--   Alta  : todo como lo diseñó el mapa
--   Ultra : además, desenfoque de profundidad lejano y más partículas
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)

local Settings = {}

local PARTICLE_FACTOR = { Baja = 0, Media = 0.4, Alta = 1, Ultra = 1.3 }

local current = table.clone(GameConfig.DefaultSettings)
ClientState.Settings = current

-- Calidad que se aplica de verdad ("Auto" según el dispositivo)
local function effectiveQuality()
	local q = current.Quality
	if q == "Auto" or not PARTICLE_FACTOR[q] then
		local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
		return touchOnly and "Baja" or "Media"
	end
	return q
end

-- Partículas ambientales del mapa (nieve, hojas, chispas, humo): se escalan según la calidad
local function scaleEmitter(emitter)
	if not emitter:IsA("ParticleEmitter") then
		return
	end
	local map = workspace:FindFirstChild("Map")
	if not map or not emitter:IsDescendantOf(map) then
		return
	end
	local base = emitter:GetAttribute("BaseRate")
	if base == nil then
		base = emitter.Rate
		emitter:SetAttribute("BaseRate", base)
	end
	local factor = PARTICLE_FACTOR[effectiveQuality()] or 1
	emitter.Rate = base * factor
	emitter.Enabled = factor > 0
end

-- Focos con sombras reales: solo en calidad Alta y Ultra
local function applyLightShadow(inst)
	if inst:IsA("Light") and inst:GetAttribute("QualityShadow") then
		local q = effectiveQuality()
		inst.Shadows = q == "Alta" or q == "Ultra"
	end
end

-- Detalles caros que se ocultan en calidades bajas (solo en este cliente)
local HIDE_BELOW = { LightCone = "Alta", ContactShadow = "Media", Puddle = "Media" }
local RANK = { Baja = 1, Media = 2, Alta = 3, Ultra = 4 }
local function applyDetail(inst)
	local minimum = HIDE_BELOW[inst.Name]
	if minimum and inst:IsA("BasePart") then
		inst.LocalTransparencyModifier = (RANK[effectiveQuality()] or 2) < RANK[minimum] and 1 or 0
	end
end

local function applyQuality()
	local q = effectiveQuality()
	ClientState.EffectiveQuality = q
	local low = q == "Baja"
	Lighting.GlobalShadows = not low
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
	if bloom then
		bloom.Enabled = not low
	end
	local rays = Lighting:FindFirstChildOfClass("SunRaysEffect")
	if rays then
		rays.Enabled = q == "Alta" or q == "Ultra"
	end
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds then
		clouds.Enabled = not low
	end
	-- Desenfoque lejano solo en Ultra (creado en el cliente)
	local dof = Lighting:FindFirstChild("QualityDOF")
	if q == "Ultra" then
		if not dof then
			dof = Instance.new("DepthOfFieldEffect")
			dof.Name = "QualityDOF"
			dof.FarIntensity = 0.12
			dof.FocusDistance = 70
			dof.InFocusRadius = 90
			dof.NearIntensity = 0
			dof.Parent = Lighting
		end
		dof.Enabled = true
	elseif dof then
		dof.Enabled = false
	end
	local map = workspace:FindFirstChild("Map")
	if map then
		for _, d in map:GetDescendants() do
			scaleEmitter(d)
			applyLightShadow(d)
			applyDetail(d)
		end
	end
end

function Settings.Get()
	return current
end

-- Cambia un ajuste, lo aplica al momento y lo guarda en el servidor (agrupando cambios seguidos)
local saveQueued = false
function Settings.Set(key, value)
	if key == "Quality" then
		if not table.find(GameConfig.QualityLevels, value) then
			return
		end
	else
		local limits = GameConfig.SettingsLimits[key]
		if not limits or type(value) ~= "number" then
			return
		end
		value = math.clamp(math.floor(value * 100 + 0.5) / 100, limits[1], limits[2])
	end
	current[key] = value
	if key == "Quality" then
		applyQuality()
	end
	if not saveQueued then
		saveQueued = true
		task.delay(1.5, function()
			saveQueued = false
			Remotes.SaveSettings:FireServer(current)
		end)
	end
end

function Settings.Init()
	-- Ajustes guardados del jugador
	local function fromData(data)
		if type(data) ~= "table" or type(data.Settings) ~= "table" or saveQueued then
			return
		end
		local changedQuality = data.Settings.Quality ~= current.Quality
		for key, value in data.Settings do
			if GameConfig.DefaultSettings[key] ~= nil and type(value) == type(GameConfig.DefaultSettings[key]) then
				current[key] = value
			end
		end
		if changedQuality then
			applyQuality()
		end
	end
	ClientState.DataChanged.Event:Connect(fromData)
	fromData(ClientState.Data)

	-- Al cambiar de mapa el servidor rehace la iluminación: volvemos a aplicar la calidad
	ReplicatedStorage:GetAttributeChangedSignal("MapName"):Connect(function()
		task.delay(1, applyQuality)
	end)
	workspace.DescendantAdded:Connect(function(inst)
		if inst:IsA("ParticleEmitter") then
			task.defer(scaleEmitter, inst)
		elseif inst:IsA("Light") then
			task.defer(applyLightShadow, inst)
		elseif HIDE_BELOW[inst.Name] then
			task.defer(applyDetail, inst)
		end
	end)
	applyQuality()
end

return Settings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">SkinFX</string>
              <string name="Source"><![CDATA[-- Anima las skins arcoíris: las piezas con la etiqueta "RainbowSkin" (ver WeaponModels) van cambiando
-- de color. Cada pieza tiene su fase (RainbowPhase) para que el color recorra el arma como una ola.
-- Funciona igual en tu arma (viewmodel) y en las de los demás. ~30 veces por segundo.
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local SkinFX = {}

local TAG = "RainbowSkin"
local SPEED = 0.22 -- vueltas al arcoíris por segundo
local parts = {} -- [part] = { Phase, Sat, Val, Viewport }

local function add(part)
	if part:IsA("BasePart") then
		parts[part] = {
			Phase = part:GetAttribute("RainbowPhase") or 0,
			Sat = part:GetAttribute("RainbowSat") or 1,
			Val = part:GetAttribute("RainbowVal") or 1,
			Viewport = part:FindFirstAncestorWhichIsA("ViewportFrame"), -- icono de la interfaz
		}
	end
end

-- ¿Se ve el icono? (el panel del menú cerrado sigue existiendo: no hace falta animar lo que no se ve)
local function guiVisible(gui)
	local node = gui
	while node do
		if node:IsA("GuiObject") and not node.Visible then
			return false
		elseif node:IsA("LayerCollector") then
			return node.Enabled
		end
		node = node.Parent
	end
	return false
end

local function remove(part)
	parts[part] = nil
end

function SkinFX.Init()
	for _, part in CollectionService:GetTagged(TAG) do
		add(part)
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(add)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(remove)
	local accumulator = 0
	RunService.RenderStepped:Connect(function(dt)
		accumulator += dt
		if accumulator < 1 / 30 then
			return
		end
		accumulator = 0
		local t = os.clock() * SPEED
		local shown = {} -- visibilidad de cada icono, calculada una vez por paso
		for part, info in parts do
			if not part.Parent then
				parts[part] = nil
				continue
			end
			local visible
			if info.Viewport then
				visible = shown[info.Viewport]
				if visible == nil then
					visible = guiVisible(info.Viewport)
					shown[info.Viewport] = visible
				end
			else
				-- Arma oculta (la tuya en la mano la sustituye el viewmodel)
				visible = part.LocalTransparencyModifier < 1 and part.Transparency < 1
			end
			if visible then
				part.Color = Color3.fromHSV((t + info.Phase) % 1, info.Sat, info.Val)
			end
		end
	end)
end

return SkinFX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[-- Tarjeta de controles para jugadores nuevos: la primera vez que entran en partida ven los controles
-- básicos (adaptados a PC o a móvil). Se cierra con el botón o a los 20 s y no vuelve a salir
-- (el servidor guarda TutorialDone).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Sounds = require(Shared.Sounds)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local Tutorial = {}

local PC_TIPS = {
	{ "🖱", "Clic izquierdo dispara · clic derecho apunta" },
	{ "⌨", "WASD te mueve · Shift corre · C te desliza" },
	{ "⚡", "E impulso · Z supersalto · X poción" },
	{ "🔪", "F golpe rápido · G granada · R recargar" },
	{ "🛒", "B abre la tienda, el pase y los retos" },
	{ "📋", "Tab: marcador · H: recoger regalo 🎁" },
}
local TOUCH_TIPS = {
	{ "🕹", "Joystick a la izquierda para moverte" },
	{ "🔫", "Botón Disparar a la derecha · Apuntar al lado" },
	{ "⚡", "Iconos abajo: impulso, supersalto y poción" },
	{ "💣", "Botones de granada, deslizar y cambiar arma" },
	{ "🛒", "Botón de la tienda: pase, retos, armas y skins" },
	{ "🎁", "Toca el regalo de arriba cuando esté listo" },
}

local shown = false

local function show()
	if shown then
		return
	end
	shown = true
	-- Mientras se lee: ratón libre y visible, sin disparar
	ClientState.TutorialOpen = true
	ClientState.UpdateMouse()
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local gui = UI.new("ScreenGui", {
		Name = "Tutorial",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 5,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local card = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(520, 400),
		BackgroundColor3 = Color3.fromRGB(20, 22, 36),
		BackgroundTransparency = 0.08,
		Parent = gui,
	}, { UI.corner(18), UI.stroke(Color3.fromRGB(255, 205, 60), 3, 0) })
	local scale = UI.new("UIScale", { Scale = 0.6, Parent = card })
	local viewport = workspace.CurrentCamera.ViewportSize
	local fit = math.clamp(math.min((viewport.X - 20) / 520, (viewport.Y - 20) / 400), 0.45, 1)
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = fit }):Play()
	UI.label({
		Position = UDim2.fromOffset(0, 14),
		Size = UDim2.new(1, 0, 0, 40),
		Text = "¡BIENVENIDO A LA PELEA!",
		TextSize = 32,
		TextColor3 = Color3.fromRGB(255, 210, 60),
		Parent = card,
	})
	for i, tip in touch and TOUCH_TIPS or PC_TIPS do
		local row = UI.new("Frame", {
			Position = UDim2.fromOffset(24, 60 + (i - 1) * 46),
			Size = UDim2.new(1, -48, 0, 40),
			BackgroundColor3 = Color3.fromRGB(40, 44, 70),
			BackgroundTransparency = 0.2,
			Parent = card,
		}, { UI.corner(10) })
		UI.label({ Size = UDim2.fromOffset(44, 40), Text = tip[1], TextSize = 24, Parent = row })
		UI.label({
			Position = UDim2.fromOffset(48, 0),
			Size = UDim2.new(1, -56, 1, 0),
			Text = tip[2],
			TextSize = 18,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			Parent = row,
		})
	end
	local button = UI.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(220, 46),
		Text = "¡A JUGAR!",
		TextSize = 24,
		BackgroundColor3 = Color3.fromRGB(70, 200, 90),
		Parent = card,
	}, { UI.gloss() })
	-- El botón Modal libera el ratón mientras se lee (en primera persona está bloqueado)
	button.Modal = true
	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		ClientState.TutorialOpen = false
		ClientState.UpdateMouse()
		Sounds.Play("Click")
		Remotes.TutorialDone:FireServer()
		TweenService:Create(scale, TweenInfo.new(0.2), { Scale = 0 }):Play()
		task.delay(0.25, function()
			gui:Destroy()
		end)
	end
	button.Activated:Connect(close)
	task.delay(20, close)
	-- Se quita si mueres o vuelves a la pantalla de inicio
	task.spawn(function()
		while not closed do
			if ClientState.Dead or ClientState.InMainMenu then
				close()
			end
			task.wait(0.2)
		end
	end)
end

function Tutorial.Init()
	task.spawn(function()
		-- Cuando sale de la pantalla de inicio por primera vez y sus datos dicen que es nuevo
		while not shown do
			task.wait(0.5)
			local data = ClientState.Data
			if data and data.TutorialDone == false and not ClientState.InMainMenu and not ClientState.Dead then
				task.wait(1.5) -- que primero vea el mapa
				if not ClientState.InMainMenu and not ClientState.Dead then
					show()
				end
			elseif data and data.TutorialDone then
				return
			end
		end
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[-- Pequeña utilidad para crear interfaces desde código.
local UI = {}

UI.Font = Enum.Font.FredokaOne
UI.FontBody = Enum.Font.GothamBold

function UI.new(className, props, children)
	local inst = Instance.new(className)
	local parent
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			inst[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.corner(radius)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

function UI.stroke(color, thickness, transparency)
	return UI.new("UIStroke", {
		Color = color or Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

-- Degradado brillante (de claro arriba a más oscuro abajo) sobre el color de fondo
function UI.gloss(bottom)
	return UI.new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), bottom or Color3.fromRGB(185, 185, 195)),
		Rotation = 90,
	})
end

function UI.padding(px)
	return UI.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
	})
end

-- Texto con borde negro estilo "cartoon"
function UI.label(props, children)
	local defaults = {
		BackgroundTransparency = 1,
		Font = UI.Font,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0.4,
		TextSize = 18,
	}
	for key, value in props or {} do
		defaults[key] = value
	end
	return UI.new("TextLabel", defaults, children)
end

function UI.button(props, children)
	local defaults = {
		Font = UI.Font,
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 18,
		AutoButtonColor = true,
		BackgroundColor3 = Color3.fromRGB(40, 120, 255),
	}
	for key, value in props or {} do
		defaults[key] = value
	end
	local button = UI.new("TextButton", defaults, children)
	UI.corner(8).Parent = button
	return button
end

function UI.formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d", seconds // 60, seconds % 60)
end

function UI.hex(color)
	return "#" .. color:ToHex()
end

return UI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">VoteUI</string>
              <string name="Source"><![CDATA[-- Votación de mapa + modo durante el descanso. Pulsa V (o el botón) para liberar el ratón y votar.
local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local VoteUI = {}

local gui, panel, hint, modal
local cards = {}
local myVote = nil
local open = false

local MODE_ICONS = {
	["Duelo por equipos"] = "⚔",
	["Captura la bandera"] = "🚩",
	["Zona de control"] = "◆",
	["Todos contra todos"] = "💀",
	["Escalada de armas"] = "🔫",
	["Eliminación"] = "☠",
}

local function setOpen(value)
	open = value
	modal.Visible = value
	ClientState.VoteOpen = value
	ClientState.UpdateMouse()
end

local function refresh()
	local voting = ReplicatedStorage:GetAttribute("State") == "Intermission" and ReplicatedStorage:GetAttribute("Vote1_Map") ~= nil
	-- No tapa el menú ni la pantalla de inicio (sus tarjetas se comerían los clics)
	panel.Visible = voting and not ClientState.MenuOpen and not ClientState.InMainMenu
	ClientState.VotePanelVisible = panel.Visible
	hint.Visible = voting and not open and not ClientState.InMainMenu
	if not voting then
		myVote = nil
		if open then
			setOpen(false)
		end
		return
	end
	for i, card in cards do
		local map = ReplicatedStorage:GetAttribute("Vote" .. i .. "_Map") or "?"
		local mode = ReplicatedStorage:GetAttribute("Vote" .. i .. "_Mode") or "?"
		local count = ReplicatedStorage:GetAttribute("Vote" .. i .. "_Count") or 0
		card.Map.Text = map
		card.Mode.Text = (MODE_ICONS[mode] or "") .. " " .. mode
		card.Count.Text = tostring(count) .. (count == 1 and " voto" or " votos")
		card.Stroke.Color = myVote == i and Color3.fromRGB(255, 200, 40) or Color3.fromRGB(90, 100, 140)
		card.Stroke.Thickness = myVote == i and 4 or 2
	end
	local timeLeft = ReplicatedStorage:GetAttribute("TimeLeft") or 0
	panel.Title.Text = "VOTA EL SIGUIENTE MAPA · " .. timeLeft .. "s"
end

function VoteUI.Init()
	gui = UI.new("ScreenGui", {
		Name = "Vote",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 6,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	panel = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -40),
		Size = UDim2.fromOffset(660, 150),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	UI.label({
		Name = "Title",
		Size = UDim2.new(1, 0, 0, 28),
		Text = "VOTA EL SIGUIENTE MAPA",
		TextSize = 24,
		TextColor3 = Color3.fromRGB(255, 210, 60),
		Parent = panel,
	})
	local row = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, 0, 0, 110),
		BackgroundTransparency = 1,
		Parent = panel,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 12),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for i = 1, 3 do
		local card = UI.button({
			LayoutOrder = i,
			Size = UDim2.fromOffset(205, 110),
			Text = "",
			BackgroundColor3 = Color3.fromRGB(28, 32, 52),
			Parent = row,
		}, { UI.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 150, 200)), Rotation = 90 }) })
		local stroke = UI.stroke(Color3.fromRGB(90, 100, 140), 2, 0)
		stroke.Parent = card
		-- Los nombres largos con icono se encogen para caber en la tarjeta
		local mapLabel = UI.label({ Position = UDim2.fromOffset(6, 8), Size = UDim2.new(1, -12, 0, 30), Text = "", TextScaled = true, Parent = card }, {
			UI.new("UITextSizeConstraint", { MaxTextSize = 24, MinTextSize = 12 }),
		})
		local modeLabel = UI.label({ Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 24), Text = "", TextSize = 18, TextColor3 = Color3.fromRGB(150, 220, 255), Parent = card })
		local countLabel = UI.label({ Position = UDim2.fromOffset(0, 74), Size = UDim2.new(1, 0, 0, 24), Text = "", TextSize = 18, TextColor3 = Color3.fromRGB(255, 210, 60), Parent = card })
		card.Activated:Connect(function()
			myVote = i
			Sounds.Play("Click")
			Remotes.VoteMap:FireServer(i)
			refresh()
		end)
		cards[i] = { Map = mapLabel, Mode = modeLabel, Count = countLabel, Stroke = stroke }
	end
	hint = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -196),
		Size = UDim2.fromOffset(400, 26),
		Text = "Pulsa [V] para votar con el ratón",
		TextSize = 20,
		Visible = false,
		Parent = gui,
	})
	-- Botón Modal: libera el ratón mientras se vota
	modal = UI.new("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true, Visible = false, Parent = gui })

	ContextActionService:BindAction("Vote", function(_, state)
		if state == Enum.UserInputState.Begin and panel.Visible and not ClientState.InMainMenu then
			setOpen(not open)
			refresh()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.V, Enum.KeyCode.DPadUp)

	ReplicatedStorage.AttributeChanged:Connect(refresh)
	refresh()
end

return VoteUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">WeaponController</string>
              <string name="Source"><![CDATA[-- Control de armas en primera persona: viewmodel, disparo, recarga, apuntado, cuchillo y cambio de arma.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weapons = require(Shared.Weapons)
local WeaponModels = require(Shared.WeaponModels)
local Sounds = require(Shared.Sounds)
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)
local Effects = require(script.Parent.Effects)
local Outfits = require(Shared.Outfits)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local WeaponController = {}

-- Hombros del viewmodel (espacio de cámara, fuera de pantalla)
local RIGHT_SHOULDER = Vector3.new(1.1, -1.5, 0.4)
local LEFT_SHOULDER = Vector3.new(-0.7, -1.5, 0.2)

local character, humanoid, rootPart
local equippedTool, def
local viewmodel
local attrConnection

local triggerHeld = false
local aimHeld = false
local lastShot = 0
local localAmmo = 0
local reloadStart = nil
local equipTime = 0
local meleeTime = -10
local inspectTime = -10 -- "Inspeccionar" (V): gira el arma para lucir la skin
local INSPECT_TIME = 2.6
local meleeWithKnife = false

local recoilKick, recoilRot = 0, 0
local camKick, camYaw = 0, 0
local swayX, swayY = 0, 0
local bobTime = 0
local aimAlpha, sprintAlpha = 0, 0
local viewmodelHidden = false
local pulseParts = {} -- piezas de neón que laten (skins míticas)
local pulseSkin = nil
local strafeRoll = 0
local shakeRoll = 0

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function lerp(a, b, t)
	return a + (b - a) * t
end

local function updateRayFilter()
	local ignore = { camera }
	if character then
		table.insert(ignore, character)
	end
	local fx = workspace:FindFirstChild("ClientFX")
	if fx then
		table.insert(ignore, fx)
	end
	-- Muros y techo invisibles del borde del mapa: las balas los atraviesan
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	rayParams.FilterDescendantsInstances = ignore
end

---------------------------------------------------------------------------
-- Viewmodel
---------------------------------------------------------------------------

local function skinTone()
	local hand = character and (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm"))
	return hand and hand.Color or Color3.fromRGB(255, 204, 153)
end

local function addArm(model, handPos, shoulderCam, weaponDef)
	local shoulder = weaponDef.ViewOffset:PointToObjectSpace(shoulderCam)
	local length = (shoulder - handPos).Magnitude
	local sleeveColor = player.Team and player.TeamColor.Color or Color3.fromRGB(60, 60, 70)
	-- Con traje de operador, los brazos llevan sus colores
	local outfitColors = Outfits.ArmColors(ClientState.Data and ClientState.Data.EquippedOutfit)
	if outfitColors then
		sleeveColor = outfitColors.Sleeve
	end
	-- Zombi (garras): brazos verdes y manga rota oscura
	local zombieSkin = weaponDef.ZombieArms
	if zombieSkin then
		sleeveColor = Color3.fromRGB(60, 45, 55)
		outfitColors = { Sleeve = sleeveColor, Glove = zombieSkin, Cuff = sleeveColor }
	end

	local arm = Instance.new("Part")
	arm.Name = "Arm"
	arm.Size = Vector3.new(0.4, 0.4, length)
	arm.CFrame = CFrame.lookAt((handPos + shoulder) / 2, handPos)
	arm.Color = zombieSkin or skinTone()
	arm.Material = Enum.Material.SmoothPlastic
	arm.Parent = model

	local sleeve = Instance.new("Part")
	sleeve.Name = "Sleeve"
	sleeve.Size = Vector3.new(0.46, 0.46, length * 0.55)
	sleeve.CFrame = CFrame.lookAt(shoulder:Lerp(handPos, 0.27), handPos)
	sleeve.Color = sleeveColor
	sleeve.Material = Enum.Material.Fabric
	sleeve.Parent = model

	local glove = Instance.new("Part")
	glove.Name = "Glove"
	glove.Size = Vector3.new(0.48, 0.48, 0.55)
	glove.CFrame = CFrame.lookAt(handPos + (shoulder - handPos).Unit * 0.15, handPos)
	glove.Color = outfitColors and outfitColors.Glove or Color3.fromRGB(25, 25, 28)
	glove.Material = Enum.Material.Fabric
	glove.Parent = model

	-- Puño blanco de la manga
	local cuff = Instance.new("Part")
	cuff.Name = "Cuff"
	cuff.Size = Vector3.new(0.5, 0.5, 0.12)
	cuff.CFrame = CFrame.lookAt(shoulder:Lerp(handPos, 0.545), handPos)
	cuff.Color = outfitColors and outfitColors.Cuff or Color3.fromRGB(245, 245, 250)
	cuff.Material = (outfitColors and not zombieSkin) and Enum.Material.Neon or Enum.Material.Fabric
	cuff.Parent = model
end

-- Oculta en nuestra pantalla el Tool real (los demás jugadores sí lo ven)
local function hideToolLocally(tool)
	for _, inst in tool:GetDescendants() do
		if inst:IsA("BasePart") then
			inst.LocalTransparencyModifier = 1
		elseif inst:IsA("ParticleEmitter") then
			inst.Enabled = false
		elseif inst:IsA("SurfaceGui") or inst:IsA("BillboardGui") then
			inst.Enabled = false -- los rótulos del arma se verían flotando
		end
	end
end

local function destroyViewmodel()
	if viewmodel then
		viewmodel:Destroy()
		viewmodel = nil
	end
	viewmodelHidden = false
end

local function createViewmodel(tool)
	destroyViewmodel()
	local weaponName = tool:GetAttribute("Weapon")
	local weaponDef = Weapons.Get(weaponName)
	local model = WeaponModels.Build(weaponName, tool:GetAttribute("Skin"))
	if weaponDef.RightHand then
		addArm(model, weaponDef.RightHand, RIGHT_SHOULDER, weaponDef)
	end
	if weaponDef.LeftHand then
		addArm(model, weaponDef.LeftHand, LEFT_SHOULDER, weaponDef)
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.CastShadow = false
		end
	end
	model.Name = "Viewmodel"
	-- Brillo suave del neón del arma sobre las manos (se nota mucho en mapas oscuros)
	local glowPalette = WeaponModels.GetPalette(weaponName, tool:GetAttribute("Skin"))
	-- Solo si el neón brilla de verdad (las armas clásicas sin skin no llevan neón)
	local neonAccent = (glowPalette.AccentMaterial or Enum.Material.Neon) == Enum.Material.Neon
	if model.PrimaryPart and neonAccent then
		local glow = Instance.new("PointLight")
		glow.Name = "NeonGlow"
		glow.Color = glowPalette.Accent
		glow.Range = 4.5
		glow.Brightness = 0.7
		glow.Shadows = false
		glow.Parent = model.PrimaryPart
	end
	model.Parent = camera
	viewmodel = model

	-- Skins con "Pulse": los detalles de neón laten
	table.clear(pulseParts)
	pulseSkin = WeaponModels.GetPalette(weaponName, tool:GetAttribute("Skin"))
	if pulseSkin.Pulse then
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") and part:GetAttribute("Role") == "Accent" then
				table.insert(pulseParts, part)
			end
		end
	end
end

local function setViewmodelHidden(hidden)
	if not viewmodel or viewmodelHidden == hidden then
		return
	end
	viewmodelHidden = hidden
	for _, part in viewmodel:GetDescendants() do
		if part:IsA("BasePart") then
			part.LocalTransparencyModifier = hidden and 1 or 0
		elseif part:IsA("ParticleEmitter") then
			part.Enabled = not hidden
		elseif part:IsA("SurfaceGui") or part:IsA("PointLight") then
			part.Enabled = not hidden
		end
	end
end

---------------------------------------------------------------------------
-- Equipar
---------------------------------------------------------------------------

local function onUnequipped()
	if attrConnection then
		attrConnection:Disconnect()
		attrConnection = nil
	end
	destroyViewmodel()
	equippedTool, def = nil, nil
	triggerHeld = false
	reloadStart = nil
	ClientState.CurrentTool = nil
	ClientState.CurrentDef = nil
	ClientState.Reloading = false
	ClientState.WeaponChanged:Fire()
end

local function onEquipped(tool)
	if equippedTool then
		onUnequipped()
	end
	local weaponDef = Weapons.Get(tool:GetAttribute("Weapon"))
	if not weaponDef then
		return
	end
	equippedTool, def = tool, weaponDef
	equipTime = os.clock()
	inspectTime = -10
	reloadStart = nil
	localAmmo = tool:GetAttribute("Ammo") or 0

	hideToolLocally(tool)
	createViewmodel(tool)

	attrConnection = tool.AttributeChanged:Connect(function(attribute)
		if attribute == "Ammo" then
			local serverAmmo = tool:GetAttribute("Ammo") or 0
			-- Subida = recarga; bajada = confirmación de disparos que ya predijimos
			if serverAmmo > localAmmo then
				localAmmo = serverAmmo
			else
				localAmmo = math.min(localAmmo, serverAmmo)
			end
		elseif attribute == "Skin" then
			createViewmodel(tool)
			hideToolLocally(tool)
		elseif attribute == "Reloading" and not tool:GetAttribute("Reloading") then
			reloadStart = nil
		end
	end)

	ClientState.CurrentTool = tool
	ClientState.CurrentDef = weaponDef
	ClientState.WeaponChanged:Fire()
end

local function getTools()
	local list = {}
	local containers = { player:FindFirstChildOfClass("Backpack"), character }
	for _, container in containers do
		if container then
			for _, tool in container:GetChildren() do
				if tool:IsA("Tool") and tool:GetAttribute("Slot") then
					list[tool:GetAttribute("Slot")] = tool
				end
			end
		end
	end
	return list
end
WeaponController.GetTools = getTools

local function equipSlot(slot)
	if not humanoid or humanoid.Health <= 0 or ClientState.IsBlocked() then
		return
	end
	local tool = getTools()[slot]
	if tool and tool ~= equippedTool then
		humanoid:EquipTool(tool)
	end
end

local function cycleSlot(direction)
	local current = equippedTool and equippedTool:GetAttribute("Slot") or 1
	local tools = getTools()
	for i = 1, 3 do
		local slot = (current - 1 + direction * i) % 3 + 1
		if tools[slot] then
			equipSlot(slot)
			return
		end
	end
end

---------------------------------------------------------------------------
-- Disparo
---------------------------------------------------------------------------

local function randomInCone(direction, degrees)
	if degrees <= 0 then
		return direction
	end
	local angle = math.rad(degrees) * math.sqrt(math.random())
	local spin = math.random() * math.pi * 2
	return (CFrame.lookAt(Vector3.zero, direction) * CFrame.Angles(0, 0, spin) * CFrame.Angles(angle, 0, 0)).LookVector
end

local function currentSpread()
	if not def or def.Type ~= "Gun" then
		return 0
	end
	local spread = lerp(def.Spread, def.AimSpread, aimAlpha)
	if rootPart then
		local velocity = rootPart.AssemblyLinearVelocity
		if Vector3.new(velocity.X, 0, velocity.Z).Magnitude > 2 then
			spread *= 1.5
		end
	end
	if humanoid and humanoid.FloorMaterial == Enum.Material.Air then
		spread *= 2
	end
	return spread + ClientState.Bloom * (1 - aimAlpha * 0.7)
end

local function requestReload()
	if not equippedTool or not def or def.Type ~= "Gun" or reloadStart then
		return
	end
	local reserve = equippedTool:GetAttribute("Reserve") or 0
	if localAmmo >= def.MagSize or reserve <= 0 then
		return
	end
	reloadStart = os.clock()
	inspectTime = -10
	Remotes.Reload:FireServer(equippedTool)
	Sounds.Play("Reload")
end

local function fire()
	local now = os.clock()
	if not equippedTool or not def or def.Type ~= "Gun" or ClientState.IsBlocked() or ClientState.Frozen() then
		return
	end
	if now - lastShot < 1 / def.FireRate or reloadStart or now - equipTime < 0.25 then
		return
	end
	if localAmmo <= 0 then
		lastShot = now
		Sounds.Play("Empty")
		requestReload()
		return
	end

	lastShot = now
	localAmmo -= 1
	ClientState.LastShotTime = now
	inspectTime = -10
	ClientState.Sprinting = false

	updateRayFilter()
	local origin = camera.CFrame.Position
	local look = camera.CFrame.LookVector
	local muzzle = viewmodel and viewmodel.PrimaryPart and viewmodel.PrimaryPart:FindFirstChild("Muzzle")
	local muzzlePos = muzzle and muzzle.WorldPosition or origin
	local tracerColor = WeaponModels.GetPalette(equippedTool:GetAttribute("Weapon"), equippedTool:GetAttribute("Skin")).Accent
	local spread = currentSpread()

	local rays = {}
	if def.Explosive then
		-- Cohete: viaja hasta el impacto y explota
		local direction = randomInCone(look, spread)
		local result = workspace:Raycast(origin, direction * def.Range, rayParams)
		local hitPosition = result and result.Position or origin + direction * def.Range
		table.insert(rays, { Part = result and result.Instance or nil, Position = hitPosition })
		Effects.Rocket(muzzlePos, hitPosition, def.ProjectileSpeed or 200, tracerColor, def.Explosive.Radius)
	end
	for pellet = 1, def.Explosive and 0 or def.Pellets do
		local direction = randomInCone(look, spread)
		local result = workspace:Raycast(origin, direction * def.Range, rayParams)
		local hitPosition = result and result.Position or origin + direction * def.Range
		table.insert(rays, { Part = result and result.Instance or nil, Position = hitPosition })
		-- (escopetas: basta con dibujar unos pocos perdigones; el daño cuenta todos)
		if pellet <= 3 then
			Effects.Tracer(muzzlePos, hitPosition, tracerColor)
		end
		if result then
			if pellet <= 4 then
				Effects.Impact(result.Position, result.Normal, result.Instance, result.Material, def.ImpactStyle)
			end
			local model = result.Instance:FindFirstAncestorOfClass("Model")
			if model and model:FindFirstChildOfClass("Humanoid") then
				ClientState.LastHitPosition = result.Position
				ClientState.LastHitTime = os.clock()
			end
		end
	end
	Remotes.Fire:FireServer(equippedTool, origin, rays)

	Effects.MuzzleFlash(muzzle)
	local eject = viewmodel and viewmodel.PrimaryPart and viewmodel.PrimaryPart:FindFirstChild("Eject")
	if not def.Explosive then
		Effects.ShellCasing(eject, camera.CFrame, def.Pellets > 1 and Color3.fromRGB(220, 50, 50) or nil)
	end
	Sounds.PlayShot(equippedTool and equippedTool:GetAttribute("Weapon"), def)
	shakeRoll += (math.random() - 0.5) * math.rad(def.Recoil) * 0.6

	-- Retroceso
	local recoil = math.rad(def.Recoil)
	recoilKick += 0.08 + def.Recoil * 0.03
	recoilRot += recoil * 0.6
	camKick += recoil * (1 - aimAlpha * 0.35)
	camYaw += (math.random() - 0.5) * recoil * 0.5
	ClientState.Bloom = math.min(ClientState.Bloom + def.Recoil * 0.4, 6)
	ClientState.ShotFired:Fire()

	if localAmmo <= 0 then
		task.delay(0.2, requestReload)
	end
end

-- Ráfaga (Vortex AR-9, Phantom Sidewind): varios disparos seguidos con una pausa entre ráfagas
local bursting = false
local lastBurstEnd = 0
local function startBurst()
	if bursting or not def or not def.Burst then
		return
	end
	if os.clock() - lastBurstEnd < (def.BurstCooldown or 0.3) then
		return
	end
	bursting = true
	local burstDef = def
	task.spawn(function()
		for i = 1, burstDef.Burst do
			if def ~= burstDef or localAmmo <= 0 or reloadStart then
				break
			end
			fire()
			if i < burstDef.Burst then
				task.wait(1 / burstDef.FireRate + 0.01)
			end
		end
		lastBurstEnd = os.clock()
		bursting = false
	end)
end

local function melee()
	-- El arma cuerpo a cuerpo que lleves (cuchillo, martillo o katana) está en la ranura 3
	local meleeTool = getTools()[3]
	local knife = meleeTool and Weapons.Get(meleeTool:GetAttribute("Weapon"))
	if not knife or knife.Type ~= "Melee" then
		return
	end
	local now = os.clock()
	if now - meleeTime < knife.Cooldown or ClientState.IsBlocked() or ClientState.Frozen() or not humanoid or humanoid.Health <= 0 then
		return
	end
	meleeTime = now
	meleeWithKnife = def ~= nil and def.Type == "Melee"
	reloadStart = nil
	Sounds.Play("Swing")

	updateRayFilter()
	local origin = camera.CFrame.Position
	local direction = camera.CFrame.LookVector * knife.Range
	local result = workspace:Spherecast(origin, 1.2, direction, rayParams) or workspace:Raycast(origin, direction, rayParams)
	if result and result.Instance then
		Remotes.Melee:FireServer(result.Instance)
	end
end

---------------------------------------------------------------------------
-- Animación procedural del viewmodel (cada frame)
---------------------------------------------------------------------------

local function renderStep(dt)
	if not character or not humanoid then
		return
	end

	-- Disparo automático
	if triggerHeld and def and def.Type == "Gun" and def.Automatic then
		fire()
	end

	ClientState.Bloom = math.max(0, ClientState.Bloom - dt * 8)
	ClientState.Spread = currentSpread()

	-- Recarga: tiempo límite por si el servidor la rechazó
	if reloadStart and def and os.clock() - reloadStart > def.ReloadTime + 1 then
		reloadStart = nil
	end
	ClientState.Reloading = reloadStart ~= nil
	ClientState.ReloadProgress = (reloadStart and def) and math.clamp((os.clock() - reloadStart) / def.ReloadTime, 0, 1)
		or 0
	ClientState.Ammo = localAmmo

	-- Apuntar
	local canAim = def ~= nil and def.Type == "Gun" and aimHeld and not reloadStart and not ClientState.IsBlocked()
	ClientState.Aiming = canAim
	if canAim then
		inspectTime = -10
	end
	aimAlpha = lerp(aimAlpha, canAim and 1 or 0, math.min(1, dt * 14))
	if aimAlpha < 0.001 then
		aimAlpha = 0
	end
	ClientState.AimAlpha = aimAlpha
	sprintAlpha = lerp(sprintAlpha, (ClientState.Sprinting and not reloadStart) and 1 or 0, math.min(1, dt * 10))

	-- Retroceso de cámara
	local applyPitch = camKick * math.min(1, dt * 22)
	local applyYaw = camYaw * math.min(1, dt * 22)
	camKick -= applyPitch
	camYaw -= applyYaw
	if applyPitch ~= 0 or applyYaw ~= 0 then
		camera.CFrame = camera.CFrame * CFrame.Angles(applyPitch, applyYaw, 0)
	end

	-- Inclinación de cámara al moverse de lado y pequeña sacudida al disparar.
	-- El módulo de cámara recalcula el giro cada frame, así que esto no se acumula.
	if rootPart then
		local velocity = rootPart.AssemblyLinearVelocity
		local side = velocity:Dot(camera.CFrame.RightVector)
		strafeRoll = lerp(strafeRoll, math.clamp(-side / 26, -1, 1) * math.rad(1.6), math.min(1, dt * 8))
	end
	shakeRoll = lerp(shakeRoll, 0, math.min(1, dt * 18))
	camera.CFrame = camera.CFrame * CFrame.Angles(0, 0, strafeRoll + shakeRoll)
	-- Temblor por explosiones cercanas (se apaga solo en ~0,6 s)
	local shake = ClientState.Shake or 0
	if shake > 0.01 then
		local t = os.clock() * 40
		camera.CFrame = camera.CFrame
			* CFrame.Angles(math.noise(t, 1) * shake * 0.05, math.noise(t, 2) * shake * 0.05, math.noise(t, 3) * shake * 0.03)
		ClientState.Shake = math.max(0, shake - dt * 1.6)
	end

	-- Latido de las skins míticas
	if #pulseParts > 0 and pulseSkin then
		local t = (math.sin(os.clock() * 3) + 1) / 2
		local color = pulseSkin.Accent:Lerp(pulseSkin.Accent2 or Color3.new(1, 1, 1), t)
		for _, part in pulseParts do
			part.Color = color
		end
		local glow = viewmodel and viewmodel.PrimaryPart and viewmodel.PrimaryPart:FindFirstChild("NeonGlow")
		if glow and glow:IsA("PointLight") then
			glow.Color = color
		end
	end

	-- Campo de visión (el del menú Ajustes) y sensibilidad: al apuntar baja en proporción al zoom
	local settings = ClientState.Settings or GameConfig.DefaultSettings
	local baseFov = settings.FOV or GameConfig.FieldOfView
	local targetFov = baseFov
	local aimScale = 1
	if def and def.AimFOV then
		targetFov = lerp(baseFov, math.min(def.AimFOV, baseFov), aimAlpha)
		aimScale = lerp(1, (settings.AimSensitivity or 0.8) * math.min(1, def.AimFOV / baseFov) ^ 0.5, aimAlpha)
	end
	local kick = ClientState.FovKick or 0
	if kick > 0.01 then
		ClientState.FovKick = kick * math.max(0, 1 - dt * 5)
	else
		ClientState.FovKick = 0
	end
	camera.FieldOfView = targetFov + sprintAlpha * 6 + kick
	UserInputService.MouseDeltaSensitivity = (settings.Sensitivity or 1) * aimScale

	if not viewmodel or not def then
		return
	end

	local now = os.clock()

	-- Balanceo al caminar
	local speed = 0
	if rootPart then
		local velocity = rootPart.AssemblyLinearVelocity
		speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	end
	local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
	if grounded and not ClientState.Sliding then
		bobTime += dt * math.min(speed, 30) * 0.45
	end
	local bobAmount = math.clamp(speed / 18, 0, 1.5) * (1 - aimAlpha * 0.9)
	if not grounded or ClientState.Sliding then
		bobAmount = 0
	end
	local bob = CFrame.new(math.cos(bobTime) * 0.05 * bobAmount, -math.abs(math.sin(bobTime)) * 0.06 * bobAmount, 0)

	-- Inercia al mover el ratón
	local delta = UserInputService:GetMouseDelta()
	swayX = lerp(swayX, math.clamp(-delta.X * 0.004, -0.12, 0.12), math.min(1, dt * 10))
	swayY = lerp(swayY, math.clamp(-delta.Y * 0.004, -0.12, 0.12), math.min(1, dt * 10))
	local swayScale = 1 - aimAlpha * 0.75
	local sway = CFrame.Angles(swayY * swayScale, swayX * swayScale, swayX * 0.6 * swayScale)

	-- Retroceso del arma
	recoilKick = lerp(recoilKick, 0, math.min(1, dt * 16))
	recoilRot = lerp(recoilRot, 0, math.min(1, dt * 14))
	local recoilCF = CFrame.new(0, 0, recoilKick) * CFrame.Angles(recoilRot, 0, 0)

	-- Cadera -> mira
	local base = def.ViewOffset
	if def.AimPoint then
		local a = def.AimPoint
		local aimCF = CFrame.new(-a.X, -a.Y, -def.AimDistance - a.Z)
		base = def.ViewOffset:Lerp(aimCF, aimAlpha)
	end

	-- Correr
	local s = sprintAlpha
	local sprintCF = CFrame.new(-0.25 * s, -0.2 * s, 0.1 * s) * CFrame.Angles(math.rad(-12) * s, math.rad(35) * s, math.rad(18) * s)

	-- Recarga
	local reloadCF = CFrame.new()
	if reloadStart then
		local r = math.sin(ClientState.ReloadProgress * math.pi)
		reloadCF = CFrame.new(0, -0.35 * r, 0) * CFrame.Angles(math.rad(-20) * r, 0, math.rad(35) * r)
	end

	-- Sacar arma
	local e = 1 - math.clamp((now - equipTime) / 0.3, 0, 1)
	local equipCF = CFrame.new(0, -0.8 * e * e, 0) * CFrame.Angles(math.rad(-40) * e, 0, 0)

	-- Cuchillazo / golpe rápido
	local meleeCF = CFrame.new()
	local m = (now - meleeTime) / 0.35
	if m < 1 then
		local k = math.sin(m * math.pi)
		if meleeWithKnife then
			meleeCF = CFrame.new(-0.6 * k, 0.2 * k, -0.6 * k)
				* CFrame.Angles(math.rad(-20) * k, math.rad(70) * k, math.rad(-30) * k)
		else
			meleeCF = CFrame.new(-0.3 * k, 0, -0.5 * k) * CFrame.Angles(0, math.rad(30) * k, math.rad(20) * k)
		end
	end

	-- Inspeccionar: sube el arma, la gira para ver un costado y luego el otro, y vuelve
	local inspectCF = CFrame.new()
	local it = (now - inspectTime) / INSPECT_TIME
	if it < 1 then
		local function smooth(x)
			x = math.clamp(x, 0, 1)
			return x * x * (3 - 2 * x)
		end
		local envelope = smooth(math.min(it / 0.18, (1 - it) / 0.18))
		local turn = smooth((it - 0.18) / 0.64)
		local yaw = math.rad(70 + (-45 - 70) * turn)
		local roll = math.rad(-25 + 35 * turn)
		inspectCF = CFrame.new(-0.35 * envelope, 0.18 * envelope, 0.25 * envelope)
			* CFrame.Angles(math.rad(12) * envelope, yaw * envelope, roll * envelope)
	end

	-- Mira telescópica: ocultar el arma
	-- (y también en la pantalla de inicio, donde la cámara está lejos)
	local hide = (def.Scope == true and aimAlpha > 0.85) or ClientState.InMainMenu or ClientState.Emoting
	setViewmodelHidden(hide)
	if not hide then -- oculta no hace falta moverla cada fotograma
		viewmodel:PivotTo(camera.CFrame * bob * sway * base * sprintCF * reloadCF * equipCF * meleeCF * inspectCF * recoilCF)
	end
end

---------------------------------------------------------------------------
-- Entrada
---------------------------------------------------------------------------

local function bindActions()
	ContextActionService:BindAction("Fire", function(_, state)
		if ClientState.IsBlocked() then
			triggerHeld = false
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin then
			triggerHeld = true
			if def and def.Type == "Melee" then
				melee()
			elseif def and def.Burst then
				startBurst()
			else
				fire()
			end
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			triggerHeld = false
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)
	ContextActionService:SetTitle("Fire", "Disparar")
	ContextActionService:SetPosition("Fire", UDim2.new(1, -110, 1, -160))

	ContextActionService:BindAction("Aim", function(_, state, input)
		if ClientState.IsBlocked() then
			aimHeld = false
			return Enum.ContextActionResult.Pass
		end
		if input.UserInputType == Enum.UserInputType.Touch then
			if state == Enum.UserInputState.Begin then
				aimHeld = not aimHeld -- en móvil es un interruptor
			end
		elseif state == Enum.UserInputState.Begin then
			aimHeld = true
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			aimHeld = false
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL2)
	ContextActionService:SetTitle("Aim", "Apuntar")
	ContextActionService:SetPosition("Aim", UDim2.new(1, -190, 1, -110))

	ContextActionService:BindAction("Reload", function(_, state)
		if state == Enum.UserInputState.Begin and not ClientState.IsBlocked() then
			requestReload()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.R, Enum.KeyCode.ButtonX)
	ContextActionService:SetTitle("Reload", "R")
	ContextActionService:SetPosition("Reload", UDim2.new(1, -200, 1, -190))

	ContextActionService:BindAction("Melee", function(_, state)
		if state == Enum.UserInputState.Begin and not ClientState.IsBlocked() then
			melee()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.F, Enum.KeyCode.ButtonB)
	ContextActionService:SetTitle("Melee", "F")
	ContextActionService:SetPosition("Melee", UDim2.new(1, -120, 1, -240))

	ContextActionService:BindAction("Slots", function(_, state, input)
		if state ~= Enum.UserInputState.Begin then
			return Enum.ContextActionResult.Pass
		end
		if input.KeyCode == Enum.KeyCode.One then
			equipSlot(1)
		elseif input.KeyCode == Enum.KeyCode.Two then
			equipSlot(2)
		elseif input.KeyCode == Enum.KeyCode.Three then
			equipSlot(3)
		elseif input.KeyCode == Enum.KeyCode.ButtonY then
			cycleSlot(1)
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.ButtonY)

	-- Cambiar de arma: tecla Q (siguiente) y botón táctil en móvil (no hay barra de inventario)
	ContextActionService:BindAction("Inspect", function(_, state)
		if state == Enum.UserInputState.Begin and not ClientState.IsBlocked() and not ClientState.VotePanelVisible and def and not reloadStart and not ClientState.Aiming then
			if os.clock() - inspectTime > INSPECT_TIME then
				inspectTime = os.clock()
			end
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.V, Enum.KeyCode.DPadUp)

	ContextActionService:BindAction("SwapWeapon", function(_, state)
		if state == Enum.UserInputState.Begin and not ClientState.IsBlocked() then
			cycleSlot(1)
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.Q)
	ContextActionService:SetTitle("SwapWeapon", "⇄")
	ContextActionService:SetPosition("SwapWeapon", UDim2.new(1, -280, 1, -100))

	UserInputService.InputChanged:Connect(function(input, processed)
		if processed or ClientState.IsBlocked() then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			cycleSlot(input.Position.Z > 0 and -1 or 1)
		end
	end)
end

---------------------------------------------------------------------------
-- Personaje
---------------------------------------------------------------------------

local characterConnections = {}

local function onCharacter(newCharacter)
	-- Las conexiones del personaje anterior se cortan (si no, el personaje viejo queda en memoria)
	for _, connection in characterConnections do
		connection:Disconnect()
	end
	table.clear(characterConnections)
	onUnequipped()
	character = newCharacter
	humanoid = newCharacter:WaitForChild("Humanoid")
	rootPart = newCharacter:WaitForChild("HumanoidRootPart")
	aimHeld = false
	camKick, camYaw = 0, 0
	updateRayFilter()

	table.insert(characterConnections, newCharacter.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and child:GetAttribute("Weapon") then
			onEquipped(child)
		end
	end))
	table.insert(characterConnections, newCharacter.ChildRemoved:Connect(function(child)
		if child == equippedTool then
			onUnequipped()
		end
	end))
	local existing = newCharacter:FindFirstChildOfClass("Tool")
	if existing and existing:GetAttribute("Weapon") then
		onEquipped(existing)
	end

	table.insert(characterConnections, humanoid.Died:Connect(function()
		onUnequipped()
		triggerHeld = false
	end))
end

-- Efectos de los disparos de otros jugadores (y bots). Para no dar tirones en móviles: de lejos o
-- con calidad Baja solo la trazadora, y como mucho un sonido por arma cada 0,1 s.
local FAR_SHOT = 120
local lastRemoteSound = setmetatable({}, { __mode = "k" }) -- [tool] = os.clock()

local function onShotFX(tool, endpoints)
	if typeof(tool) ~= "Instance" or not tool.Parent or type(endpoints) ~= "table" then
		return
	end
	local handle = tool:FindFirstChild("Handle")
	local muzzle = handle and handle:FindFirstChild("Muzzle")
	if not muzzle then
		return
	end
	local color = WeaponModels.GetPalette(tool:GetAttribute("Weapon"), tool:GetAttribute("Skin")).Accent
	local weaponDef = Weapons.Get(tool:GetAttribute("Weapon"))
	local cheap = ClientState.EffectiveQuality == "Baja" or (muzzle.WorldPosition - camera.CFrame.Position).Magnitude > FAR_SHOT
	for index, position in endpoints do
		if typeof(position) == "Vector3" and index <= 3 then
			if weaponDef and weaponDef.Explosive then
				Effects.Rocket(muzzle.WorldPosition, position, weaponDef.ProjectileSpeed or 200, color, weaponDef.Explosive.Radius)
			else
				Effects.Tracer(muzzle.WorldPosition, position, color)
				-- Paintball: también se ven las manchas de los disparos de los demás (si no es caro)
				if weaponDef and weaponDef.ImpactStyle and not cheap then
					local direction = position - muzzle.WorldPosition
					if direction.Magnitude > 1 then
						local hit = workspace:Raycast(position - direction.Unit * 1.5, direction.Unit * 3, rayParams)
						if hit then
							Effects.Impact(hit.Position, hit.Normal, hit.Instance, hit.Material, weaponDef.ImpactStyle)
						end
					end
				end
			end
		end
	end
	if not cheap then
		Effects.MuzzleFlash(muzzle, nil, true)
	end
	local now = os.clock()
	if now - (lastRemoteSound[tool] or 0) >= 0.1 then
		lastRemoteSound[tool] = now
		Sounds.PlayShot(tool:GetAttribute("Weapon"), weaponDef, handle)
	end
end

function WeaponController.Init()
	UserInputService.MouseIconEnabled = false
	bindActions()
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	Remotes.ShotFX.OnClientEvent:Connect(onShotFX)
	RunService:BindToRenderStep("WeaponViewmodel", Enum.RenderPriority.Camera.Value + 1, renderStep)
end

return WeaponController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="88">
            <Properties>
              <string name="Name">WeaponIcon</string>
              <string name="Source"><![CDATA[-- Iconos 3D de armas: dibuja el modelo real (con su skin) dentro de un ViewportFrame.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local WeaponModels = require(Shared.WeaponModels)

local WeaponIcon = {}

local FOV = 20

-- view: "side" (de perfil, cañón a la derecha) o "angled" (tres cuartos)
-- aspect: ancho / alto del ViewportFrame
function WeaponIcon.Create(weaponName, skinId, props, view, aspect)
	local viewport = Instance.new("ViewportFrame")
	viewport.BackgroundTransparency = 1
	viewport.Ambient = Color3.fromRGB(170, 170, 185)
	viewport.LightColor = Color3.fromRGB(255, 255, 255)
	viewport.LightDirection = Vector3.new(-1, -1.5, -0.6)
	for key, value in props or {} do
		viewport[key] = value
	end

	local model = WeaponModels.Build(weaponName, skinId, false)
	model.Parent = viewport

	local camera = Instance.new("Camera")
	camera.FieldOfView = FOV
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	local boxCFrame, size = model:GetBoundingBox()
	local center = boxCFrame.Position
	aspect = aspect or 2.5
	local tanHalf = math.tan(math.rad(FOV / 2))

	local direction
	if view == "angled" then
		direction = Vector3.new(1, 0.35, 0.45).Unit
	else
		direction = Vector3.new(1, 0.05, 0).Unit
	end
	-- Distancia para que quepa: el largo del arma (Z) en horizontal y el alto (Y) en vertical
	local fitVertical = (size.Y / 2) / tanHalf
	local fitHorizontal = (size.Z / 2) / (tanHalf * aspect)
	local margin = view == "angled" and 1.35 or 1.12
	local distance = math.max(fitVertical, fitHorizontal) * margin + size.X / 2
	camera.CFrame = CFrame.lookAt(center + direction * distance, center)
	return viewport
end

return WeaponIcon
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="89">
            <Properties>
              <string name="Name">Wheel</string>
              <string name="Source"><![CDATA[-- Ruleta diaria (Shop.Wheel): un giro gratis al día y giros extra con Robux. La ruleta gira y se para
-- en el premio que decide el servidor. Las probabilidades se ven debajo de la ruleta.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local MarketplaceService = game:GetService("MarketplaceService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Shop = require(Shared.Shop)
local Sounds = require(Shared.Sounds)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local Wheel = {}

local SIZE = 340
local gui, panel, rotor, spinButton, buyButton, status, closeButton
local spinning = false
local currentRotation = 0

local function prizes()
	return Shop.Wheel.Prizes
end

-- Texto del botón según los giros disponibles
local function refresh()
	if not gui then
		return
	end
	local data = ClientState.Data
	local free = data and data.WheelFree == true
	local bought = data and data.WheelSpins or 0
	if spinning then
		spinButton.Text = "..."
	elseif free then
		spinButton.Text = "🎁 ¡GIRO GRATIS!"
	elseif bought > 0 then
		spinButton.Text = "🎡 GIRAR (" .. bought .. ")"
	else
		spinButton.Text = "Vuelve mañana"
	end
	spinButton.BackgroundColor3 = (free or bought > 0) and Color3.fromRGB(60, 200, 90) or Color3.fromRGB(70, 70, 82)
	local canBuy = Shop.Wheel.SpinProductId ~= 0 and not (data and data.CratesRestricted)
	buyButton.Visible = canBuy
end

local function build()
	gui = UI.new("ScreenGui", {
		Name = "Wheel",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 20,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local shade = UI.new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Text = "",
		AutoButtonColor = false,
		Modal = true,
		Parent = gui,
	})
	_ = shade
	panel = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(440, 600),
		BackgroundColor3 = Color3.fromRGB(22, 24, 38),
		Parent = gui,
	}, { UI.corner(18), UI.stroke(Color3.fromRGB(255, 200, 60), 3, 0) })
	local scale = UI.new("UIScale", { Parent = panel })
	local function fit()
		local viewport = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.clamp(math.min((viewport.X - 20) / 440, (viewport.Y - 20) / 600), 0.45, 1)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	fit()
	UI.label({ Position = UDim2.fromOffset(0, 12), Size = UDim2.new(1, 0, 0, 36), Text = "🎡 RULETA DIARIA", TextSize = 30, TextColor3 = Color3.fromRGB(255, 210, 60), Parent = panel })
	closeButton = UI.button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.fromOffset(36, 36), Text = "✕", TextSize = 22, BackgroundColor3 = Color3.fromRGB(200, 60, 70), Parent = panel })
	closeButton.Activated:Connect(function()
		if not spinning then
			Wheel.Close()
		end
	end)

	-- Ruleta: un círculo (CanvasGroup redondo que recorta) con una porción por premio
	local wheelFrame = UI.new("CanvasGroup", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 66),
		Size = UDim2.fromOffset(SIZE, SIZE),
		BackgroundColor3 = Color3.fromRGB(40, 44, 70),
		Parent = panel,
	}, { UI.corner(SIZE / 2) })
	rotor = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = wheelFrame })
	local list = prizes()
	local step = 360 / #list
	-- Cada porción es un abanico de barras finas que salen del centro (parece una cuña)
	local BARS = 10
	local radius = SIZE / 2 + 2
	for i, prize in list do
		local angle = (i - 1) * step
		for k = 1, BARS do
			local sub = angle - step / 2 + (k - 0.5) * step / BARS
			local rad = math.rad(sub)
			UI.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, math.sin(rad) * radius / 2, 0.5, -math.cos(rad) * radius / 2),
				Size = UDim2.fromOffset(math.ceil(2 * radius * math.sin(math.rad(step / BARS / 2))) + 2, radius),
				Rotation = sub,
				BackgroundColor3 = prize.Color,
				BorderSizePixel = 0,
				Parent = rotor,
			})
		end
		-- Separador blanco entre porciones
		local edge = math.rad(angle - step / 2)
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.sin(edge) * radius / 2, 0.5, -math.cos(edge) * radius / 2),
			Size = UDim2.fromOffset(3, radius),
			Rotation = angle - step / 2,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = rotor,
		})
		-- Premio escrito a lo largo del radio
		local rad = math.rad(angle)
		UI.label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.sin(rad) * radius * 0.62, 0.5, -math.cos(rad) * radius * 0.62),
			Size = UDim2.fromOffset(84, 26),
			Rotation = angle, -- (el ganador queda arriba y se lee derecho)
			Text = Shop.WheelPrizeText(prize),
			TextSize = 20,
			TextScaled = true,
			TextColor3 = Color3.new(1, 1, 1),
			ZIndex = 4,
			Parent = rotor,
		})
	end
	-- Centro y puntero
	UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(56, 56),
		BackgroundColor3 = Color3.fromRGB(255, 210, 60),
		ZIndex = 6,
		Parent = wheelFrame,
	}, { UI.corner(28), UI.stroke(Color3.new(1, 1, 1), 3, 0) })
	UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 44),
		Size = UDim2.fromOffset(40, 40),
		Text = "▼",
		TextSize = 40,
		TextColor3 = Color3.fromRGB(255, 70, 90),
		ZIndex = 8,
		Parent = panel,
	})

	-- Probabilidades
	local total = 0
	for _, prize in list do
		total += prize.Weight
	end
	local odds = {}
	for _, prize in list do
		table.insert(odds, Shop.WheelPrizeText(prize) .. " " .. string.format("%g", math.floor(prize.Weight / total * 1000 + 0.5) / 10) .. "%")
	end
	UI.label({
		Position = UDim2.fromOffset(16, 416),
		Size = UDim2.new(1, -32, 0, 40),
		Text = "Probabilidades: " .. table.concat(odds, " · "),
		TextSize = 13,
		TextWrapped = true,
		TextColor3 = Color3.fromRGB(180, 185, 210),
		Font = UI.FontBody,
		TextStrokeTransparency = 1,
		Parent = panel,
	})
	status = UI.label({ Position = UDim2.fromOffset(0, 460), Size = UDim2.new(1, 0, 0, 30), Text = "", TextSize = 22, TextColor3 = Color3.fromRGB(255, 220, 90), Parent = panel })

	spinButton = UI.button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 496),
		Size = UDim2.fromOffset(260, 46),
		Text = "",
		TextSize = 24,
		Parent = panel,
	}, { UI.gloss() })
	buyButton = UI.button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 548),
		Size = UDim2.fromOffset(260, 36),
		Text = "+" .. Shop.Wheel.SpinsPerPurchase .. " giros · " .. Shop.Wheel.SpinRobux .. " R$",
		TextSize = 18,
		BackgroundColor3 = Color3.fromRGB(40, 170, 90),
		Parent = panel,
	}, { UI.gloss() })
	buyButton.Activated:Connect(function()
		Sounds.Play("Click")
		pcall(MarketplaceService.PromptProductPurchase, MarketplaceService, player, Shop.Wheel.SpinProductId)
	end)
	spinButton.Activated:Connect(Wheel.Spin)
	ClientState.DataChanged.Event:Connect(refresh)
end

function Wheel.Spin()
	if spinning then
		return
	end
	local data = ClientState.Data
	if not data or not (data.WheelFree or (data.WheelSpins or 0) > 0) then
		status.Text = "Vuelve mañana para otro giro gratis"
		return
	end
	spinning = true
	status.Text = ""
	refresh()
	Sounds.Play("Click")
	local ok, success, index = pcall(function()
		return Remotes.SpinWheel:InvokeServer()
	end)
	if not (ok and success and type(index) == "number") then
		spinning = false
		status.Text = (ok and type(index) == "string") and index or "No se pudo girar"
		refresh()
		return
	end
	-- Para con el premio arriba (bajo el puntero), tras unas vueltas
	local step = 360 / #prizes()
	local target = -((index - 1) * step) + (math.random() - 0.5) * step * 0.6
	local base = currentRotation - currentRotation % 360
	local final = base + 360 * 5 + target
	currentRotation = final
	local tween = TweenService:Create(rotor, TweenInfo.new(4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Rotation = final })
	tween:Play()
	-- Clic de la ruleta al pasar las porciones
	task.spawn(function()
		local last = math.floor(rotor.Rotation / step)
		while tween.PlaybackState == Enum.PlaybackState.Playing do
			local now = math.floor(rotor.Rotation / step)
			if now ~= last then
				last = now
				Sounds.Play("Click", nil, 1.4, 0.6)
			end
			task.wait()
		end
	end)
	tween.Completed:Wait()
	local prize = prizes()[index]
	Sounds.Play(prize.Jackpot and "Flag" or "Kill")
	status.Text = (prize.Jackpot and "💥 ¡PREMIO GORDO! " or "¡Has ganado ") .. Shop.WheelPrizeText(prize) .. (prize.Jackpot and "" or "!")
	spinning = false
	refresh()
end

function Wheel.Open()
	if not gui then
		build()
	end
	gui.Enabled = true
	ClientState.WheelOpen = true
	ClientState.UpdateMouse()
	status.Text = ""
	refresh()
end

function Wheel.Close()
	if gui then
		gui.Enabled = false
	end
	ClientState.WheelOpen = false
	ClientState.UpdateMouse()
end

function Wheel.Init()
	-- (se construye la primera vez que se abre)
end

return Wheel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="90">
            <Properties>
              <string name="Name">WorldFX</string>
              <string name="Source"><![CDATA[-- Efectos del mundo en el cliente:
--  * Piezas del mapa con atributo Spin (grados/seg) giran y con Bob (studs) flotan
--  * Contorno de color en los compañeros de equipo (visible a través de paredes)
--  * Oculta el nombre de los enemigos
--  * Explosión de partículas cuando alguien es eliminado
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Teams = game:GetService("Teams")

local Effects = require(script.Parent.Effects)
local Remotes = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Remotes"))

local player = Players.LocalPlayer

local WorldFX = {}

local animated = {} -- [part] = { Base = CFrame, Spin = number, Bob = number, Phase = number }

local function track(inst)
	-- (los efectos sueltos de ClientFX nunca se animan aquí: se descartan lo antes posible)
	if not inst:IsA("BasePart") or (inst.Parent and inst.Parent.Name == "ClientFX") then
		return
	end
	local spin = inst:GetAttribute("Spin")
	local bob = inst:GetAttribute("Bob")
	local blink = inst:GetAttribute("Blink")
	local sweep = inst:GetAttribute("Sweep")
	if spin or bob or blink or sweep then
		animated[inst] = {
			Base = inst.CFrame,
			Spin = spin or 0,
			Bob = bob or 0,
			Blink = blink,
			Sweep = sweep,
			BaseTransparency = inst.Transparency,
			Phase = math.random() * 10,
		}
	end
end

local function animate()
	local t = os.clock()
	for part, info in animated do
		if not part.Parent then
			animated[part] = nil
			continue
		end
		if info.Blink then
			-- Baliza que parpadea
			local on = math.sin((t + info.Phase) * math.pi * 2 / info.Blink) > 0
			part.Transparency = on and info.BaseTransparency or 0.95
		end
		if info.Sweep then
			-- Haz de luz que barre a un lado y a otro desde su base
			local pivot = (info.Base * CFrame.new(0, -part.Size.Y / 2, 0)).Position
			local angle = math.rad(info.Sweep) * math.sin(t * 0.4 + info.Phase)
			part.CFrame = CFrame.new(pivot) * CFrame.Angles(0, angle, 0) * (CFrame.new(pivot):Inverse() * info.Base)
		elseif info.Spin ~= 0 or info.Bob ~= 0 then
			local position = info.Base.Position + Vector3.new(0, math.sin(t * 1.5 + info.Phase) * info.Bob, 0)
			local rotation = info.Base - info.Base.Position
			-- Giro alrededor del eje Y del mundo que pasa por la pieza
			part.CFrame = CFrame.new(position) * CFrame.Angles(0, math.rad(info.Spin * t), 0) * rotation
		end
	end
end

---------------------------------------------------------------------------
-- Jugadores
---------------------------------------------------------------------------

local function teamColorOf(other)
	return other and other.Team and other.TeamColor.Color or Color3.fromRGB(255, 200, 60)
end

-- Compañeros: contorno del color del equipo y nombre visible. Enemigos: sin nombre.
local function applyStyle(character, isTeammate, isSelf, color)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local highlight = character:FindFirstChild("TeamHighlight")
	if isTeammate and not isSelf then
		if not highlight then
			highlight = Instance.new("Highlight")
			highlight.Name = "TeamHighlight"
			highlight.FillTransparency = 1
			highlight.OutlineTransparency = 0.2
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.Parent = character
		end
		highlight.OutlineColor = color
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	else
		if highlight then
			highlight:Destroy()
		end
		if not isSelf then
			-- Sin nombre sobre los enemigos: hay que encontrarlos
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
	end
end

local function styleCharacter(other, character)
	applyStyle(character, player.Team ~= nil and other.Team == player.Team, other == player, teamColorOf(other))
end

-- Bots (carpeta workspace.Bots): el servidor les pone el atributo Team
local function styleBot(model)
	local teamName = model:GetAttribute("Team")
	local team = teamName and teamName ~= "" and Teams:FindFirstChild(teamName)
	local isTeammate = player.Team ~= nil and team == player.Team
	applyStyle(model, isTeammate, false, team and team:IsA("Team") and team.TeamColor.Color or Color3.fromRGB(255, 200, 60))
end

local function onCharacter(other, character)
	character:WaitForChild("Humanoid", 10)
	styleCharacter(other, character)
end

local function onPlayer(other)
	other.CharacterAdded:Connect(function(character)
		onCharacter(other, character)
	end)
	if other.Character then
		task.spawn(onCharacter, other, other.Character)
	end
	other:GetPropertyChangedSignal("Team"):Connect(function()
		if other.Character then
			styleCharacter(other, other.Character)
		end
	end)
end

local function restyleAll()
	for _, other in Players:GetPlayers() do
		if other.Character then
			styleCharacter(other, other.Character)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			styleBot(model)
		end
	end
end

function WorldFX.Init()
	-- Animaciones del mapa
	for _, inst in workspace:GetDescendants() do
		track(inst)
	end
	workspace.DescendantAdded:Connect(track)
	RunService.RenderStepped:Connect(animate)

	-- Jugadores
	for _, other in Players:GetPlayers() do
		onPlayer(other)
	end
	Players.PlayerAdded:Connect(onPlayer)
	player:GetPropertyChangedSignal("Team"):Connect(restyleAll)
	task.spawn(function()
		local bots = workspace:WaitForChild("Bots", 30)
		if not bots then
			return
		end
		bots.ChildAdded:Connect(function(model)
			model:WaitForChild("Humanoid", 10)
			styleBot(model)
		end)
		for _, model in bots:GetChildren() do
			task.spawn(styleBot, model)
		end
	end)

	-- Efecto de eliminación (lo decide el servidor: el que tenga equipado quien hizo la baja)
	Remotes.KillFX.OnClientEvent:Connect(function(position, effectId, color)
		if typeof(position) == "Vector3" and type(effectId) == "string" then
			Effects.KillEffect(effectId, position, typeof(color) == "Color3" and color or nil)
		end
	end)
end

return WorldFX
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
