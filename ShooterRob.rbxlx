      </Properties>
      <Item class="Script" referent="21">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Punto de entrada del servidor: inicia todos los sistemas en orden.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

require(ReplicatedStorage.Shared.Remotes) -- crea los RemoteEvents antes que nada

local Modules = script.Parent.Modules
local MapBuilder = require(Modules.MapBuilder)
local PlayerData = require(Modules.PlayerData)
local Loadout = require(Modules.Loadout)
local Combat = require(Modules.Combat)
local Round = require(Modules.Round)
local Dummies = require(Modules.Dummies)
local Hazards = require(Modules.Hazards)
local Grenades = require(Modules.Grenades)
local Leaderboard = require(Modules.Leaderboard)
local Killstreaks = require(Modules.Killstreaks)
local Respawn = require(Modules.Respawn)
local Abilities = require(Modules.Abilities)
local Bots = require(Modules.Bots)
local Gifts = require(Modules.Gifts)
local Friends = require(Modules.Friends)
local Event = require(Modules.Event)


-- Arranca cada sistema por separado: si uno falla, se avisa en Output y los demás siguen
local function start(name, fn, ...)
	local ok, err = xpcall(fn, debug.traceback, ...)
	if not ok then
		warn("[Arranque] " .. name .. " falló: " .. tostring(err))
	end
end

start("MapBuilder", MapBuilder.Build) -- primer mapa de la rotación (o tu mapa propio si existe workspace.Map)
start("PlayerData", PlayerData.Init)
start("Loadout", Loadout.Init)
start("Combat", Combat.Init)
Combat.OnKill = Round.RegisterKill
start("Round", Round.Init)
start("Respawn", Respawn.Init) -- reaparición propia (CharacterAutoLoads desactivado): después de Round
start("Dummies", Dummies.Init)
start("Hazards", Hazards.Init)
start("Grenades", Grenades.Init)
start("Leaderboard", Leaderboard.Init)
start("Killstreaks", Killstreaks.Init)
start("Abilities", Abilities.Init)
start("Bots", Bots.Init)
start("Gifts", Gifts.Init)
start("Friends", Friends.Init)
start("Event", Event.Init)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="22">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Abilities</string>
            <string name="Source"><![CDATA[-- Habilidades: Impulso (E) y Supersalto (Z) se mueven en el cliente (el personaje es suyo en la
-- física); el servidor solo valida la Poción (X), que cura con el tiempo, y avisa a los demás para
-- que vean el efecto.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)

local Abilities = {}

local lastPotion = {} -- [player] = os.clock()

local function healEffect(character)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "PotionFX"
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(90, 255, 120), Color3.fromRGB(200, 255, 140))
	emitter.LightEmission = 0.8
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	emitter.Lifetime = NumberRange.new(0.8, 1.2)
	emitter.Speed = NumberRange.new(2, 4)
	emitter.SpreadAngle = Vector2.new(40, 40)
	emitter.Acceleration = Vector3.new(0, 4, 0)
	emitter.Rate = 30
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Parent = root
	task.delay(GameConfig.Abilities.Potion.Duration, function()
		emitter.Enabled = false
		task.wait(1.2)
		emitter:Destroy()
	end)
end

-- Cura poco a poco; se corta si el jugador muere
local function usePotion(player)
	local config = GameConfig.Abilities.Potion
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or player:GetAttribute("InMenu") then
		return false
	end
	local now = os.clock()
	if lastPotion[player] and now - lastPotion[player] < config.Cooldown - 0.25 then
		return false
	end
	lastPotion[player] = now
	healEffect(character)
	local steps = 10
	task.spawn(function()
		for _ = 1, steps do
			task.wait(config.Duration / steps)
			if humanoid.Parent == nil or humanoid.Health <= 0 then
				return
			end
			humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + config.Heal / steps)
		end
	end)
	return true
end
Abilities.UsePotion = usePotion

function Abilities.Init()
	Remotes.UsePotion.OnServerInvoke = usePotion
	Players.PlayerRemoving:Connect(function(player)
		lastPotion[player] = nil
	end)
end

return Abilities
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Badges</string>
            <string name="Source"><![CDATA[-- Insignias de Roblox (BadgeService). Se dan solas al cumplir cada logro. Con ID 0 no se da
-- (créalas en el Creator Hub → tu experiencia → Insignias y pega los ID en GameConfig.Badges).
local BadgeService = game:GetService("BadgeService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local Ranks = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Ranks"))

local Badges = {}

local awarded = {} -- [player] = { [nombre] = true } (para no repetir llamadas en la sesión)

-- Logros: nombre en GameConfig.Badges -> condición sobre los datos del jugador
local RULES = {
	{ Name = "Welcome", Check = function(_data)
		return true
	end },
	{ Name = "FirstKill", Check = function(data)
		return (data.TotalKills or 0) >= 1
	end },
	{ Name = "Kills100", Check = function(data)
		return (data.TotalKills or 0) >= 100
	end },
	{ Name = "FirstWin", Check = function(data)
		return (data.Wins or 0) >= 1
	end },
	{ Name = "Level10", Check = function(data)
		return (data.Level or 1) >= 10
	end },
	{ Name = "RankGold", Check = function(data)
		return Ranks.Index(data.RankPoints) >= 3
	end },
	{ Name = "RankDiamond", Check = function(data)
		return Ranks.Index(data.RankPoints) >= 5
	end },
	{ Name = "RankChampion", Check = function(data)
		return Ranks.Index(data.RankPoints) >= 6
	end },
}

local function award(player, name)
	local id = GameConfig.Badges and GameConfig.Badges[name]
	if type(id) ~= "number" or id == 0 then
		return
	end
	awarded[player] = awarded[player] or {}
	if awarded[player][name] then
		return
	end
	awarded[player][name] = "pending"
	task.spawn(function()
		local ok, has = pcall(BadgeService.UserHasBadgeAsync, BadgeService, player.UserId, id)
		local done = ok and has
		if ok and not has and player.Parent then
			done = pcall(BadgeService.AwardBadge, BadgeService, player.UserId, id)
		end
		-- Si falló (p. ej. demasiadas peticiones), se reintenta la próxima vez que se compruebe
		if awarded[player] then
			awarded[player][name] = done and true or nil
		end
	end)
end

-- Revisa los logros con los datos actuales (lo llama PlayerData al cargar y cuando cambian)
function Badges.Check(player, data)
	if not data then
		return
	end
	for _, rule in RULES do
		if rule.Check(data) then
			award(player, rule.Name)
		end
	end
end

function Badges.Forget(player)
	awarded[player] = nil
end

return Badges
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Bots</string>
            <string name="Source"><![CDATA[-- Bots: rellenan la partida cuando hay pocos jugadores (GameConfig.Bots). Llevan un arma de verdad
-- (los demás ven trazadoras, fogonazo y sonido como con un jugador), recorren el mapa con
-- PathfindingService, buscan enemigos con línea de visión y fallan más cuanto más lejos disparan.
-- Cuentan para el marcador por equipos y dan algo de XP y monedas, pero no para la clasificación global.
-- Solo durante la ronda; en "Escalada de armas" no hay bots. En Eliminación (NoRespawn) no reaparecen
-- hasta la ronda siguiente (Round llama a Bots.RespawnAll).
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Weapons = require(Shared.Weapons)
local Remotes = require(Shared.Remotes)

local Combat = require(script.Parent.Combat)
local Loadout = require(script.Parent.Loadout)
local Zombie = require(script.Parent.Zombie)

local Bots = {}

local CONFIG = GameConfig.Bots
local NAMES = { "Tito", "Luna", "Max", "Kira", "Rocco", "Nova", "Pipo", "Zara", "Dante", "Mia", "Toby", "Vega" }

local folder
local statsFolder -- ReplicatedStorage.BotStats: una carpeta por bot con Team, Kills, Deaths y Score (marcador)
local agents = {} -- lista de bots activos
local nameIndex = 0

local function state()
	return ReplicatedStorage:GetAttribute("State")
end

local function noRespawn()
	return ReplicatedStorage:GetAttribute("NoRespawn") == true
end

-- Cuenta atrás de Eliminación: todos quietos y sin disparar
local function frozen()
	return ReplicatedStorage:GetAttribute("Frozen") == true
end

local function teamMode()
	return ReplicatedStorage:GetAttribute("TeamMode") == true
end

-- ¿Cuántos bots hacen falta ahora mismo?
local function desiredCount()
	if not CONFIG.Enabled or state() ~= "Playing" or ReplicatedStorage:GetAttribute("Mode") == "GUN" then
		return 0
	end
	return math.max(0, CONFIG.FillTo - #Players:GetPlayers())
end

-- Equipo con menos miembros (jugadores + bots)
local function pickTeam()
	if not teamMode() then
		return nil
	end
	-- Infección: antes de la infección, superviviente (equipo A); después, zombi (equipo B)
	local infection = ReplicatedStorage:GetAttribute("Infection")
	if infection then
		return Teams:FindFirstChild(ReplicatedStorage:GetAttribute(infection == "On" and "TeamB" or "TeamA") or "")
	end
	local best, bestCount = nil, math.huge
	for _, team in Teams:GetTeams() do
		local count = #team:GetPlayers()
		for _, agent in agents do
			if agent.Team == team then
				count += 1
			end
		end
		if count < bestCount then
			best, bestCount = team, count
		end
	end
	return best
end

-- Puntos del mapa (se guardan hasta que cambia el mapa: recorrer todas las piezas es caro)
local cachedMap, spawnsByColor, ffaPoints = nil, {}, {}
local function refreshPoints()
	local map = workspace:FindFirstChild("Map")
	if map == cachedMap and map ~= nil and map.Parent ~= nil then
		return
	end
	cachedMap, spawnsByColor, ffaPoints = map, {}, {}
	if not map then
		return
	end
	for _, d in map:GetDescendants() do
		if d:IsA("SpawnLocation") then
			local key = d.TeamColor.Name
			spawnsByColor[key] = spawnsByColor[key] or {}
			table.insert(spawnsByColor[key], d.Position)
		elseif d:IsA("BasePart") and d.Name == "FFASpawn" then
			table.insert(ffaPoints, d.Position)
		end
	end
end

local function spawnPoint(team)
	refreshPoints()
	local points = team and spawnsByColor[team.TeamColor.Name] or {}
	if #points == 0 then
		points = ffaPoints
	end
	if #points == 0 then
		return Vector3.new(0, 10, 0)
	end
	return points[math.random(1, #points)] + Vector3.new(0, 4, 0)
end

-- Pinta al bot con los colores de su equipo (o de color aleatorio en todos contra todos)
local function makeDescription(team, zombie)
	local description = Instance.new("HumanoidDescription")
	local shirt = team and team.TeamColor.Color or Color3.fromHSV(math.random(), 0.6, 0.85)
	local skin = ({ Color3.fromRGB(255, 205, 160), Color3.fromRGB(200, 150, 110), Color3.fromRGB(140, 95, 65), Color3.fromRGB(255, 220, 190) })[math.random(1, 4)]
	if zombie then
		skin = Zombie.Skin
	end
	description.HeadColor = skin
	description.LeftArmColor = skin
	description.RightArmColor = skin
	description.TorsoColor = shirt
	description.LeftLegColor = Color3.fromRGB(45, 48, 60)
	description.RightLegColor = Color3.fromRGB(45, 48, 60)
	return description
end

local function isEnemyOf(agent, otherTeam)
	if not teamMode() then
		return true
	end
	return agent.Team ~= otherTeam
end

-- Objetivos posibles: jugadores vivos fuera del menú y sin escudo, y bots enemigos
local function candidates(agent)
	local list = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local head = character and character:FindFirstChild("Head")
		if humanoid and head and humanoid.Health > 0 and not player:GetAttribute("InMenu")
			and not character:FindFirstChildOfClass("ForceField") and isEnemyOf(agent, player.Team) then
			table.insert(list, { Model = character, Humanoid = humanoid, Head = head })
		end
	end
	for _, other in agents do
		if other ~= agent and other.Humanoid and other.Humanoid.Health > 0 and isEnemyOf(agent, other.Team) then
			local head = other.Model:FindFirstChild("Head")
			if head then
				table.insert(list, { Model = other.Model, Humanoid = other.Humanoid, Head = head })
			end
		end
	end
	return list
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function canSee(agent, target)
	local head = agent.Model:FindFirstChild("Head")
	if not head then
		return false
	end
	local ignore = { agent.Model }
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	rayParams.FilterDescendantsInstances = ignore
	local direction = target.Head.Position - head.Position
	local hit = workspace:Raycast(head.Position, direction, rayParams)
	return hit == nil or hit.Instance:IsDescendantOf(target.Model)
end

-- El enemigo visible más cercano: se ordenan por distancia y solo se lanzan rayos hasta encontrar
-- uno a la vista (antes se comprobaban todos)
local function findTarget(agent)
	local root = agent.Root
	local inRange = {}
	for _, target in candidates(agent) do
		local distance = (target.Head.Position - root.Position).Magnitude
		if distance < CONFIG.Range then
			target.Distance = distance
			table.insert(inRange, target)
		end
	end
	table.sort(inRange, function(x, y)
		return x.Distance < y.Distance
	end)
	for _, target in inRange do
		if canSee(agent, target) then
			return target, target.Distance
		end
	end
	return nil, CONFIG.Range
end

-- Captura la bandera: si lleva la bandera, a casa; si no, a devolver la suya caída, a perseguir a
-- quien se la lleva o a por la enemiga (ver Flags: FlagPos_/FlagHome_/FlagState_)
local function flagGoal(agent)
	if ReplicatedStorage:GetAttribute("Mode") ~= "CTF" or not agent.Team then
		return nil
	end
	local own = agent.Team.Name
	local enemy
	for _, team in Teams:GetTeams() do
		if team ~= agent.Team then
			enemy = team.Name
		end
	end
	if agent.CarryingFlag then
		return ReplicatedStorage:GetAttribute("FlagHome_" .. own)
	end
	local ownState = ReplicatedStorage:GetAttribute("FlagState_" .. own)
	if (ownState == "Dropped" or ownState == "Carried") and math.random() < 0.6 then
		return ReplicatedStorage:GetAttribute("FlagPos_" .. own)
	end
	if enemy and math.random() < 0.65 then
		return ReplicatedStorage:GetAttribute("FlagPos_" .. enemy)
	end
	return nil
end

-- Camino hasta un punto al azar del mapa (o la zona activa en Zona de control)
local function pickGoal(agent)
	local flagTarget = flagGoal(agent)
	if typeof(flagTarget) == "Vector3" then
		return flagTarget, true
	end
	-- En Zona de control, la mitad de las veces van a la zona activa
	local zone = ReplicatedStorage:GetAttribute("ZonePosition")
	if typeof(zone) == "Vector3" and math.random() < 0.75 then
		return zone + Vector3.new(math.random(-5, 5), 0, math.random(-5, 5))
	end
	refreshPoints()
	if #ffaPoints == 0 then
		return nil
	end
	return ffaPoints[math.random(1, #ffaPoints)]
end

local function computePath(agent, goal)
	agent.Waypoints = nil
	agent.WaypointIndex = 0
	local path = PathfindingService:CreatePath({
		AgentRadius = 2,
		AgentHeight = 5,
		AgentCanJump = true,
		WaypointSpacing = 6,
		Costs = { CrackedLava = math.huge }, -- nunca por la lava
	})
	local ok = pcall(function()
		path:ComputeAsync(agent.Root.Position, goal)
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		agent.Waypoints = path:GetWaypoints()
		agent.WaypointIndex = 1
	end
end

local function shoot(agent, target, distance)
	local tool = agent.Tool
	local def = Weapons.Get(agent.Weapon)
	if not tool or not tool.Parent or not def then
		return
	end
	-- Recarga de vez en cuando (pausa breve)
	agent.Shots += 1
	if agent.Shots >= def.MagSize then
		agent.Shots = 0
		agent.NextShot = os.clock() + def.ReloadTime
		return
	end
	-- Dificultad según el rango del jugador al que disparan (contra otros bots, normal)
	local targetPlayer = Players:GetPlayerFromCharacter(target.Model)
	local skill = targetPlayer and CONFIG.SkillByRank and CONFIG.SkillByRank[targetPlayer:GetAttribute("Rank") or 1] or 1
	local accuracy = math.min(0.95, CONFIG.Accuracy * skill)
	local chance = math.clamp(accuracy - distance * CONFIG.AccuracyFalloff, 0.06, accuracy)
	local targetRoot = target.Model:FindFirstChild("HumanoidRootPart")
	if targetRoot and targetRoot.AssemblyLinearVelocity.Magnitude > 12 then
		chance *= 0.7 -- cuesta más acertar a quien se mueve rápido
	end
	local hit = math.random() < chance
	local endpoint
	if hit then
		endpoint = target.Head.Position + Vector3.new(math.random() - 0.5, -math.random() * 1.5, math.random() - 0.5)
		local damage = (distance > (def.FalloffStart or 100) and def.MinDamage or def.Damage) * CONFIG.DamageScale * skill
		Combat.BotDamage(agent, target.Humanoid, damage, agent.Weapon)
	else
		local miss = Vector3.new(math.random() - 0.5, math.random() - 0.3, math.random() - 0.5).Unit * (2 + math.random() * 3)
		endpoint = target.Head.Position + miss
	end
	Remotes.ShotFX:FireAllClients(tool, { endpoint })
end

-- Zombi (Infección): persigue al superviviente más cercano (aunque no lo vea, con el buscador de
-- caminos) y le araña cuando lo tiene al alcance
local function zombieThink(agent, humanoid, root, now)
	local def = Weapons.Get("Claws")
	local best, bestDistance = nil, math.huge
	for _, target in candidates(agent) do
		local distance = (target.Head.Position - root.Position).Magnitude
		if distance < bestDistance then
			best, bestDistance = target, distance
		end
	end
	if not best then
		humanoid:MoveTo(root.Position)
		return
	end
	local targetRoot = best.Model:FindFirstChild("HumanoidRootPart") or best.Head
	if bestDistance <= def.Range + 1 and math.abs(targetRoot.Position.Y - root.Position.Y) < 4 and canSee(agent, best) then
		humanoid:MoveTo(targetRoot.Position)
		if now >= agent.NextShot then
			agent.NextShot = now + def.Cooldown + math.random() * 0.3
			local targetPlayer = Players:GetPlayerFromCharacter(best.Model)
			local skill = targetPlayer and CONFIG.SkillByRank and CONFIG.SkillByRank[targetPlayer:GetAttribute("Rank") or 1] or 1
			Combat.BotDamage(agent, best.Humanoid, def.Damage * CONFIG.DamageScale * 1.4 * skill, "Claws")
		end
		return
	end
	-- Cerca y a la vista: directo; si no, por el camino (se recalcula cada poco)
	if bestDistance < 30 and canSee(agent, best) then
		agent.Waypoints = nil
		humanoid:MoveTo(targetRoot.Position)
		return
	end
	if not agent.Computing and (not agent.Waypoints or now > agent.GoalDeadline or agent.WaypointIndex > #agent.Waypoints) then
		agent.Computing = true
		agent.GoalDeadline = now + 2.5
		local goal = targetRoot.Position
		task.spawn(function()
			computePath(agent, goal)
			agent.Computing = false
			if not agent.Waypoints and agent.Humanoid then
				agent.Humanoid:MoveTo(goal)
			end
		end)
		return
	end
	local waypoints = agent.Waypoints
	if waypoints and waypoints[agent.WaypointIndex] then
		local waypoint = waypoints[agent.WaypointIndex]
		if (Vector3.new(waypoint.Position.X, root.Position.Y, waypoint.Position.Z) - root.Position).Magnitude < 3 then
			agent.WaypointIndex += 1
		else
			if waypoint.Action == Enum.PathWaypointAction.Jump then
				humanoid.Jump = true
			end
			humanoid:MoveTo(waypoint.Position)
		end
	end
end

local function think(agent)
	local humanoid, root = agent.Humanoid, agent.Root
	if not humanoid or humanoid.Health <= 0 or not root or not root.Parent then
		return
	end
	if frozen() then
		humanoid:MoveTo(root.Position)
		return
	end
	local now = os.clock()
	if agent.Zombie then
		zombieThink(agent, humanoid, root, now)
		return
	end
	local target, distance = findTarget(agent)
	-- Con la bandera a cuestas no se para a pelear: dispara mientras sigue su camino a casa
	if target and agent.CarryingFlag then
		if agent.Target ~= target.Model then
			agent.Target = target.Model
			agent.NextShot = math.max(agent.NextShot, now + CONFIG.Reaction)
		end
		if now >= agent.NextShot then
			local def = Weapons.Get(agent.Weapon)
			agent.NextShot = now + 1 / math.min(def and def.FireRate or 6, CONFIG.MaxFireRate) + math.random() * 0.12
			shoot(agent, target, distance)
		end
		target = nil
	end
	if target then
		if agent.Target ~= target.Model then
			agent.Target = target.Model
			agent.NextShot = math.max(agent.NextShot, now + CONFIG.Reaction)
		end
		-- Mira al objetivo y se mueve un poco de lado mientras dispara (sin girar hacia donde camina)
		humanoid.AutoRotate = false
		local look = Vector3.new(target.Head.Position.X, root.Position.Y, target.Head.Position.Z)
		if (look - root.Position).Magnitude > 0.5 then
			root.CFrame = CFrame.lookAt(root.Position, look)
		end
		if now >= agent.NextStrafe then
			agent.NextStrafe = now + 1.2 + math.random()
			humanoid:MoveTo(root.Position + root.CFrame.RightVector * (math.random() < 0.5 and -6 or 6))
			-- De vez en cuando salta mientras pelea (como un jugador)
			if math.random() < CONFIG.JumpChance then
				humanoid.Jump = true
			end
		end
		if now >= agent.NextShot then
			local def = Weapons.Get(agent.Weapon)
			agent.NextShot = now + 1 / math.min(def and def.FireRate or 6, CONFIG.MaxFireRate) + math.random() * 0.12
			shoot(agent, target, distance)
		end
		return
	end
	agent.Target = nil
	humanoid.AutoRotate = true
	-- Sin enemigos a la vista: seguir el camino o buscar uno nuevo
	local waypoints = agent.Waypoints
	if agent.Computing then
		return
	end
	if not waypoints or agent.WaypointIndex > #waypoints or now > agent.GoalDeadline then
		if now < agent.GoalDeadline and not waypoints then
			return -- sin camino: va en línea recta un rato antes de volver a intentarlo
		end
		local goal, objective = pickGoal(agent)
		-- (las banderas se mueven: el camino hacia ellas se recalcula antes)
		agent.GoalDeadline = now + (objective and 5 or 12)
		if goal then
			agent.Computing = true
			task.spawn(function()
				computePath(agent, goal)
				agent.Computing = false
				if not agent.Waypoints and agent.Humanoid then
					agent.Humanoid:MoveTo(goal)
					agent.GoalDeadline = os.clock() + 3
				end
			end)
		else
			agent.GoalDeadline = now + 3
		end
		return
	end
	local waypoint = waypoints[agent.WaypointIndex]
	if (Vector3.new(waypoint.Position.X, root.Position.Y, waypoint.Position.Z) - root.Position).Magnitude < 3 then
		agent.WaypointIndex += 1
		return
	end
	if waypoint.Action == Enum.PathWaypointAction.Jump then
		humanoid.Jump = true
	end
	humanoid:MoveTo(waypoint.Position)
end

local spawnAgent, safeSpawn

-- Estadísticas del bot para el marcador (Tab) de los clientes
local function statsOf(agent)
	if not statsFolder or not table.find(agents, agent) then
		return nil
	end
	local entry = statsFolder:FindFirstChild(agent.Name)
	if not entry then
		entry = Instance.new("Folder")
		entry.Name = agent.Name
		entry:SetAttribute("Kills", 0)
		entry:SetAttribute("Deaths", 0)
		entry:SetAttribute("Score", 0)
		entry.Parent = statsFolder
	end
	entry:SetAttribute("Team", agent.Team and agent.Team.Name or "")
	return entry
end

-- Suma a una estadística del bot (Kills, Deaths o Score); lo llama Round al registrar bajas
function Bots.AddStat(agent, field, amount)
	local entry = agent and statsOf(agent)
	if entry then
		entry:SetAttribute(field, (entry:GetAttribute(field) or 0) + amount)
	end
end


-- Nombre que no lleve ya otro bot activo
local function nextName()
	for _ = 1, #NAMES do
		nameIndex = nameIndex % #NAMES + 1
		local name = "Bot " .. NAMES[nameIndex]
		if not Combat.BotsByName[name] then
			return name
		end
	end
	return "Bot " .. math.random(100, 999)
end

-- Animaciones R15 estándar de Roblox. El script Animate de los personajes es local y no corre en un
-- NPC, así que el servidor las reproduce (se replican a todos).
local ANIMS = {
	Idle = "rbxassetid://507766388",
	Run = "rbxassetid://507767714",
	Jump = "rbxassetid://507765000",
	Fall = "rbxassetid://507767968",
	Hold = "rbxassetid://507768375", -- brazo estirado sujetando el arma
}

local function animate(humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local tracks = {}
	for key, id in ANIMS do
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(animation)
		end)
		if ok and track then
			tracks[key] = track
		end
	end
	local current
	local function play(key, fade)
		local track = tracks[key]
		if track and current ~= track then
			if current then
				current:Stop(fade or 0.2)
			end
			current = track
			track.Looped = key ~= "Jump"
			track:Play(fade or 0.2)
		end
	end
	if tracks.Hold then
		tracks.Hold.Priority = Enum.AnimationPriority.Action
		tracks.Hold.Looped = true
		tracks.Hold:Play()
	end
	play("Idle")
	humanoid.Running:Connect(function(speed)
		play(speed > 0.5 and "Run" or "Idle")
		if tracks.Run then
			tracks.Run:AdjustSpeed(math.max(speed / 16, 0.5))
		end
	end)
	humanoid.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Jumping then
			play("Jump", 0.1)
		elseif new == Enum.HumanoidStateType.Freefall then
			play("Fall", 0.2)
		elseif new == Enum.HumanoidStateType.Landed then
			play("Idle", 0.1)
		end
	end)
end

spawnAgent = function(agent)
	if agent.Spawning then
		return false
	end
	agent.Team = agent.Team or pickTeam()
	if ReplicatedStorage:GetAttribute("Infection") == "On" and agent.Team and agent.Team.Name == ReplicatedStorage:GetAttribute("TeamB") then
		agent.Zombie = true
	end
	agent.Spawning = true
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescriptionAsync(makeDescription(agent.Team, agent.Zombie), Enum.HumanoidRigType.R15)
	end)
	if not ok then
		ok, model = pcall(function()
			return Players:CreateHumanoidModelFromDescription(makeDescription(agent.Team, agent.Zombie), Enum.HumanoidRigType.R15)
		end)
	end
	agent.Spawning = false
	if not ok or not model then
		warn("[Bots] No se pudo crear el bot:", model)
		return false
	end
	-- Lo quitaron (fin de ronda) mientras se creaba
	if not table.find(agents, agent) or not folder then
		model:Destroy()
		return false
	end
	local localAnimate = model:FindFirstChild("Animate")
	if localAnimate then
		localAnimate:Destroy()
	end
	model.Name = agent.Name
	model:SetAttribute("Bot", true)
	model:SetAttribute("Team", agent.Team and agent.Team.Name or "")
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	humanoid.DisplayName = agent.Name
	humanoid.MaxHealth = 100
	humanoid.Health = 100
	humanoid.WalkSpeed = CONFIG.WalkSpeed
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	model:PivotTo(CFrame.new(spawnPoint(agent.Team)) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	model.Parent = folder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	agent.Model, agent.Humanoid, agent.Root = model, humanoid, root
	statsOf(agent)
	animate(humanoid)
	agent.Weapon = agent.Zombie and "Claws" or CONFIG.Weapons[math.random(1, #CONFIG.Weapons)]
	if agent.Zombie then
		local claws = Weapons.Get("Claws")
		Zombie.Apply(model, GameConfig.ModeSettings.INF.ZombieHealth)
		humanoid.WalkSpeed = CONFIG.WalkSpeed * (claws.WalkSpeedMultiplier or 1)
	end
	agent.Tool = Loadout.MakeTool(agent.Weapon, "Default")
	agent.Tool.Parent = model
	humanoid:EquipTool(agent.Tool)
	agent.Shots, agent.NextShot, agent.NextStrafe, agent.GoalDeadline = 0, 0, 0, 0
	agent.Waypoints, agent.Target = nil, nil

	Combat.WatchHumanoid(humanoid, nil, agent.Name, agent)
	humanoid.Died:Connect(function()
		agent.Humanoid = nil
		task.delay(3, function()
			model:Destroy()
		end)
		task.delay(GameConfig.RespawnTime + 1, function()
			if table.find(agents, agent) and not agent.Humanoid and desiredCount() >= #agents and not noRespawn() then
				safeSpawn(agent)
			end
		end)
	end)
	return true
end

local function removeAgent(agent)
	local index = table.find(agents, agent)
	if index then
		table.remove(agents, index)
	end
	if statsFolder then
		local entry = statsFolder:FindFirstChild(agent.Name)
		if entry then
			entry:Destroy()
		end
	end
	Combat.BotsByName[agent.Name] = nil
	if agent.Model then
		agent.Model:Destroy()
	end
end

-- Crea el bot sin que un error deje un hueco fantasma: si falla, el bot se quita de la lista
safeSpawn = function(agent)
	if agent.Spawning then
		return true -- ya se está creando
	end
	local ok, spawned = pcall(spawnAgent, agent)
	if not ok then
		warn("[Bots] spawn:", spawned)
		agent.Spawning = false
	end
	if not (ok and spawned) then
		if agent.Model and agent.Model.Parent and not agent.Humanoid then
			agent.Model:Destroy()
		end
		removeAgent(agent)
		return false
	end
	return true
end

-- Bot a quitar: del equipo con más miembros (jugadores + bots) para no desequilibrar
local function botToRemove()
	if not teamMode() then
		return agents[#agents]
	end
	local best, bestCount = nil, -1
	for _, team in Teams:GetTeams() do
		local count = #team:GetPlayers()
		local candidate
		for _, agent in agents do
			if agent.Team == team then
				count += 1
				candidate = agent
			end
		end
		if candidate and count > bestCount then
			best, bestCount = candidate, count
		end
	end
	return best or agents[#agents]
end

-- Ajusta el número de bots. En plena ronda de Eliminación no entran bots nuevos.
local function balance()
	local desired = desiredCount()
	while #agents < desired and not noRespawn() and state() == "Playing" do
		local agent = { Name = nextName() }
		table.insert(agents, agent)
		Combat.BotsByName[agent.Name] = agent
		if not safeSpawn(agent) then
			break
		end
		desired = desiredCount()
	end
	if #agents > desired then
		if not noRespawn() then
			removeAgent(botToRemove())
		else
			-- En plena ronda de Eliminación solo se quita un bot ya eliminado (no se le quita un luchador
			-- a un equipo a mitad de ronda); el resto se ajusta en la preparación de la siguiente
			for i = #agents, 1, -1 do
				if not agents[i].Humanoid and not agents[i].Spawning then
					removeAgent(agents[i])
					break
				end
			end
		end
	end
end

-- Nueva ronda de Eliminación: los muertos reaparecen y los vivos vuelven a su base con la vida llena
function Bots.RespawnAll()
	for _, agent in table.clone(agents) do
		if agent.Humanoid and agent.Humanoid.Health > 0 and agent.Model then
			agent.Humanoid.Health = agent.Humanoid.MaxHealth
			agent.Model:PivotTo(CFrame.new(spawnPoint(agent.Team)) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
			agent.Waypoints, agent.Target, agent.Shots, agent.GoalDeadline = nil, nil, 0, 0
		elseif not agent.Spawning then
			task.spawn(safeSpawn, agent)
		end
	end
end

-- Fin de la preparación de Eliminación: reaparece cualquier bot que siga muerto
function Bots.RespawnDead()
	for _, agent in table.clone(agents) do
		if not agent.Humanoid and not agent.Spawning then
			task.spawn(safeSpawn, agent)
		end
	end
end

-- Infección: el bot pasa a ser zombi (si está vivo, reaparece ya como zombi; si no, al reaparecer)
function Bots.Infect(agent, zombieTeam)
	if agent.Zombie then
		return
	end
	agent.Team = zombieTeam
	agent.Zombie = true
	local entry = statsOf(agent)
	if entry then
		entry:SetAttribute("Team", zombieTeam.Name)
	end
	if agent.Humanoid and agent.Humanoid.Health > 0 and agent.Model then
		-- Paciente cero: se cambia el cuerpo por uno de zombi (sin contar como muerte)
		local model = agent.Model
		agent.Humanoid = nil
		model:Destroy()
		task.spawn(safeSpawn, agent)
	end
end

-- Al cambiar de modo o de equipos, los bots vuelven a elegir equipo
function Bots.Reset()
	for i = #agents, 1, -1 do
		removeAgent(agents[i])
	end
end

function Bots.Init()
	if not CONFIG.Enabled then
		return
	end
	folder = Instance.new("Folder")
	folder.Name = "Bots"
	folder.Parent = workspace
	statsFolder = Instance.new("Folder")
	statsFolder.Name = "BotStats"
	statsFolder.Parent = ReplicatedStorage
	ReplicatedStorage:GetAttributeChangedSignal("State"):Connect(function()
		if state() ~= "Playing" then
			Bots.Reset()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(balance)
			if not ok then
				warn("[Bots] balance:", err)
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.15)
			for _, agent in table.clone(agents) do
				local ok, err = pcall(think, agent)
				if not ok then
					warn("[Bots] think:", err)
				end
			end
		end
	end)
end

Bots.Agents = agents
return Bots
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Combat</string>
            <string name="Source"><![CDATA[-- Validación de disparos y daño en el servidor (anti-trampas básico).
-- El cliente calcula el impacto; el servidor comprueba cadencia, munición, distancia y línea de visión.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Weapons = require(Shared.Weapons)
local Remotes = require(Shared.Remotes)

local Combat = {}

-- Asignado desde Main: function(killer: Player?, victim: Player?, victimName, weaponName, headshot, position: Vector3?)
Combat.OnKill = nil

-- Cadencia: "cubo" de disparos por arma. Se rellena a FireRate por segundo y guarda hasta 3, así los
-- disparos legítimos que llegan juntos (lag) no se pierden, pero no se puede disparar más rápido.
local fireBudget = setmetatable({}, { __mode = "k" })
local FIRE_BURST_ALLOWANCE = 3
local reloadTokens = setmetatable({}, { __mode = "k" })
local lastMelee = {}

local function getCharacterFromPart(part)
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid then
			return model, humanoid
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil, nil
end

-- Bots activos por nombre (los registra Bots): para saber quién hizo una baja
Combat.BotsByName = {}

local function isEnemy(attacker, targetPlayer, targetChar)
	if not targetPlayer then
		-- Bots del mismo equipo no se dañan; muñecos de práctica y bots enemigos sí
		if targetChar and targetChar:GetAttribute("Bot") and ReplicatedStorage:GetAttribute("TeamMode") and attacker.Team then
			return targetChar:GetAttribute("Team") ~= attacker.Team.Name
		end
		return true
	end
	if attacker == targetPlayer then
		return false
	end
	if attacker.Neutral or targetPlayer.Neutral or not attacker.Team then
		return true
	end
	return attacker.Team ~= targetPlayer.Team
end

local function isHeadshot(part, character, position)
	if part.Name == "Head" then
		return true
	end
	return false
end

-- Los accesorios del avatar (sombreros, alas, mochilas) no reciben disparos: ni escudo ni cabeza gigante
local function ignoreAccessories(character)
	local function apply(inst)
		if inst:IsA("BasePart") and inst:FindFirstAncestorOfClass("Accessory") then
			inst.CanQuery = false
		end
	end
	for _, inst in character:GetDescendants() do
		apply(inst)
	end
	character.DescendantAdded:Connect(apply)
end

local function hasLineOfSight(origin, target, ignore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	ignore = table.clone(ignore)
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary) -- muros invisibles del borde del mapa
	end
	params.FilterDescendantsInstances = ignore
	local offset = target - origin
	local distance = offset.Magnitude - 1.5
	if distance <= 0 then
		return true
	end
	return workspace:Raycast(origin, offset.Unit * distance, params) == nil
end

local function damageAtDistance(def, distance)
	if distance <= def.FalloffStart then
		return def.Damage
	end
	if distance >= def.FalloffEnd then
		return def.MinDamage
	end
	local alpha = (distance - def.FalloffStart) / (def.FalloffEnd - def.FalloffStart)
	return def.Damage + (def.MinDamage - def.Damage) * alpha
end

-- Al atacar se pierde cualquier escudo (el de reaparición y el de la pantalla de inicio)
local function removeSpawnShield(character)
	for _, child in character:GetChildren() do
		if child:IsA("ForceField") then
			child:Destroy()
		end
	end
	local player = Players:GetPlayerFromCharacter(character)
	if player then
		player:SetAttribute("InMenu", false)
	end
end

-- Aplica daño y deja la "etiqueta" del atacante. Devuelve daño real y si murió.
local function applyDamage(attacker, humanoid, damage, weaponName, headshot)
	if humanoid.Health <= 0 then
		return 0, false
	end
	humanoid:SetAttribute("LastAttacker", attacker.UserId)
	humanoid:SetAttribute("LastBot", nil)
	humanoid:SetAttribute("LastWeapon", weaponName)
	humanoid:SetAttribute("LastHeadshot", headshot)
	humanoid:SetAttribute("LastHitTime", os.clock())
	local before = humanoid.Health
	humanoid:TakeDamage(damage) -- respeta el ForceField de spawn
	local dealt = before - humanoid.Health
	return dealt, humanoid.Health <= 0
end

-- Daño de un bot (ver Bots): deja su nombre como atacante
function Combat.BotDamage(bot, humanoid, damage, weaponName)
	if humanoid.Health <= 0 then
		return 0, false
	end
	humanoid:SetAttribute("LastAttacker", nil)
	humanoid:SetAttribute("LastBot", bot.Name)
	humanoid:SetAttribute("LastWeapon", weaponName)
	humanoid:SetAttribute("LastHeadshot", false)
	humanoid:SetAttribute("LastHitTime", os.clock())
	local before = humanoid.Health
	humanoid:TakeDamage(damage)
	return before - humanoid.Health, humanoid.Health <= 0
end

-- Daño en área (cohetes). Afecta a enemigos y muñecos con línea de visión desde la explosión.
function Combat.Explode(attacker, position, def, weaponName)
	local info = def.Explosive
	local candidates = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(candidates, p.Character)
		end
	end
	for _, folderName in { "Dummies", "Bots" } do
		local npcs = workspace:FindFirstChild(folderName)
		if npcs then
			for _, d in npcs:GetChildren() do
				table.insert(candidates, d)
			end
		end
	end
	local totalDealt, anyKill, hitPosition, best = 0, false, nil, 0
	local attackerChar = attacker.Character
	for _, targetChar in candidates do
		local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
		local root = targetChar:FindFirstChild("HumanoidRootPart")
		if humanoid and root and humanoid.Health > 0 and targetChar ~= attackerChar then
			local targetPlayer = Players:GetPlayerFromCharacter(targetChar)
			local distance = (root.Position - position).Magnitude
			if distance <= info.Radius and isEnemy(attacker, targetPlayer, targetChar) then
				if hasLineOfSight(position, root.Position, { targetChar, attackerChar }) then
					local alpha = distance / info.Radius
					local damage = info.Damage + (info.MinDamage - info.Damage) * alpha
					local dealt, killed = applyDamage(attacker, humanoid, damage, weaponName, false)
					totalDealt += dealt
					anyKill = anyKill or killed
					if dealt > best then
						best, hitPosition = dealt, root.Position
					end
				end
			end
		end
	end
	if totalDealt > 0 then
		Remotes.HitConfirm:FireClient(attacker, math.floor(totalDealt + 0.5), false, anyKill, hitPosition)
	end
end

-- Detecta la muerte de un Humanoid y avisa a quien corresponda
-- victimBot: el bot (ver Bots) si el que muere es un bot
function Combat.WatchHumanoid(humanoid, victimPlayer, victimName, victimBot)
	humanoid.Died:Connect(function()
		local killer, killerBot
		local hitTime = humanoid:GetAttribute("LastHitTime")
		local recent = hitTime and os.clock() - hitTime < 10
		local attackerId = humanoid:GetAttribute("LastAttacker")
		if attackerId and recent then
			killer = Players:GetPlayerByUserId(attackerId)
		end
		local botName = humanoid:GetAttribute("LastBot")
		if botName and recent and not killer then
			killerBot = Combat.BotsByName[botName]
		end
		local weaponName = humanoid:GetAttribute("LastWeapon")
		local headshot = humanoid:GetAttribute("LastHeadshot") == true
		local character = humanoid.Parent
		local root = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head"))
		local position = root and root.Position
		if victimPlayer then
			-- Vida que le quedaba al que te eliminó (se enseña en la pantalla de muerte)
			local killerHumanoid = killer and killer.Character and killer.Character:FindFirstChildOfClass("Humanoid")
				or (killerBot and killerBot.Humanoid)
			local killerHealth = killerHumanoid and math.ceil(math.max(0, killerHumanoid.Health)) or nil
			local killerName = (killer and killer.Name) or (killerBot and killerBot.Name) or nil
			Remotes.Died:FireClient(victimPlayer, killerName, weaponName, killerHealth)
		end
		-- Espectador de Eliminación (entró a mitad de ronda): pantalla de muerte, pero sin baja ni muerte
		if Combat.OnKill and not humanoid:GetAttribute("Spectator") then
			Combat.OnKill(killer, victimPlayer, victimName, weaponName, headshot, position, killerBot, victimBot)
		end
	end)
end

local function frozen()
	return ReplicatedStorage:GetAttribute("Frozen") == true -- cuenta atrás de Eliminación
end

local function onFire(player, tool, origin, rays)
	if frozen() then
		return
	end
	if typeof(tool) ~= "Instance" or not tool:IsA("Tool") or typeof(origin) ~= "Vector3" or type(rays) ~= "table" then
		return
	end
	local character = player.Character
	if not character or tool.Parent ~= character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local head = character:FindFirstChild("Head")
	if not humanoid or humanoid.Health <= 0 or not head then
		return
	end
	local weaponName = tool:GetAttribute("Weapon")
	local def = Weapons.Get(weaponName)
	if not def or def.Type ~= "Gun" or tool:GetAttribute("Reloading") then
		return
	end
	local ammo = tool:GetAttribute("Ammo") or 0
	if ammo <= 0 then
		return
	end
	local now = os.clock()
	-- Armas lentas (escopetas, francotiradores) no acumulan: 1 disparo; las rápidas hasta 3
	local cap = math.clamp(def.FireRate * 0.2, 1, FIRE_BURST_ALLOWANCE)
	local budget = fireBudget[tool]
	if not budget then
		budget = { Time = now, Shots = cap }
		fireBudget[tool] = budget
	end
	budget.Shots = math.min(cap, budget.Shots + (now - budget.Time) * def.FireRate * 1.15)
	budget.Time = now
	if budget.Shots < 1 then
		return
	end
	-- El origen del disparo tiene que estar cerca de la cabeza y SIN pared en medio
	if (head.Position - origin).Magnitude > 12 or not hasLineOfSight(head.Position, origin, { character }) then
		return
	end
	budget.Shots -= 1
	tool:SetAttribute("Ammo", ammo - 1)
	removeSpawnShield(character)

	if def.Explosive then
		local ray = rays[1]
		if type(ray) ~= "table" or typeof(ray.Position) ~= "Vector3" then
			return
		end
		local position = ray.Position
		if (position - origin).Magnitude > def.Range + 5 then
			return
		end
		-- El cohete no puede atravesar paredes hasta el punto de impacto
		local back = (origin - position).Unit * 1.5
		if not hasLineOfSight(origin, position + back, { character }) then
			return
		end
		Combat.Explode(player, position + back * 0.5, def, tool:GetAttribute("Weapon"))
		for _, other in Players:GetPlayers() do
			if other ~= player then
				Remotes.ShotFX:FireClient(other, tool, { position })
			end
		end
		return
	end

	local endpoints = {}
	local perTarget = {}
	for i = 1, math.min(#rays, def.Pellets) do
		local ray = rays[i]
		if type(ray) == "table" and typeof(ray.Position) == "Vector3" then
			local position = ray.Position
			local distance = (position - origin).Magnitude
			if distance <= def.Range + 5 then
				table.insert(endpoints, position)
				local part = ray.Part
				if typeof(part) == "Instance" and part:IsA("BasePart") and part:IsDescendantOf(workspace) then
					local targetChar, targetHum = getCharacterFromPart(part)
					if targetChar and targetChar ~= character and targetHum.Health > 0 then
						local targetPlayer = Players:GetPlayerFromCharacter(targetChar)
						local closeEnough = (part.Position - position).Magnitude <= part.Size.Magnitude / 2 + 8
						if
							isEnemy(player, targetPlayer, targetChar)
							and closeEnough
							and hasLineOfSight(origin, position, { character, targetChar })
						then
							local headshot = isHeadshot(part, targetChar, position)
							local damage = damageAtDistance(def, distance)
								* (headshot and def.HeadshotMultiplier or 1)
							local entry = perTarget[targetHum]
							if not entry then
								entry = { Damage = 0, Headshot = false }
								perTarget[targetHum] = entry
							end
							entry.Damage += damage
							entry.Position = position
							entry.Headshot = entry.Headshot or headshot
						end
					end
				end
			end
		end
	end

	-- hitPosition: dónde se hizo más daño (el cliente pone ahí el número de daño)
	local totalDealt, anyHeadshot, anyKill, hitPosition, best = 0, false, false, nil, 0
	for targetHum, entry in perTarget do
		local dealt, killed = applyDamage(player, targetHum, entry.Damage, weaponName, entry.Headshot)
		if dealt > 0 then
			totalDealt += dealt
			anyHeadshot = anyHeadshot or entry.Headshot
			anyKill = anyKill or killed
			if dealt > best then
				best, hitPosition = dealt, entry.Position
			end
		end
	end
	if totalDealt > 0 then
		Remotes.HitConfirm:FireClient(player, math.floor(totalDealt + 0.5), anyHeadshot, anyKill, hitPosition)
	end

	for _, other in Players:GetPlayers() do
		if other ~= player then
			Remotes.ShotFX:FireClient(other, tool, endpoints)
		end
	end
end

local function onReload(player, tool)
	if typeof(tool) ~= "Instance" or not tool:IsA("Tool") then
		return
	end
	local character = player.Character
	if not character or tool.Parent ~= character then
		return
	end
	local def = Weapons.Get(tool:GetAttribute("Weapon"))
	if not def or def.Type ~= "Gun" or tool:GetAttribute("Reloading") then
		return
	end
	local ammo = tool:GetAttribute("Ammo") or 0
	local reserve = tool:GetAttribute("Reserve") or 0
	if ammo >= def.MagSize or reserve <= 0 then
		return
	end
	tool:SetAttribute("Reloading", true)
	local token = {}
	reloadTokens[tool] = token
	task.delay(def.ReloadTime, function()
		if reloadTokens[tool] ~= token then
			return
		end
		reloadTokens[tool] = nil
		-- Si cambió de arma la recarga ya se canceló (Reloading = false)
		if not tool:GetAttribute("Reloading") or tool.Parent ~= player.Character then
			tool:SetAttribute("Reloading", false)
			return
		end
		local currentAmmo = tool:GetAttribute("Ammo") or 0
		local currentReserve = tool:GetAttribute("Reserve") or 0
		local take = math.min(def.MagSize - currentAmmo, currentReserve)
		tool:SetAttribute("Ammo", currentAmmo + take)
		tool:SetAttribute("Reserve", currentReserve - take)
		tool:SetAttribute("Reloading", false)
	end)
end

-- Arma cuerpo a cuerpo que lleva el jugador (cuchillo, martillo o katana): su nombre
local function findMelee(player)
	for _, container in { player.Character, player:FindFirstChild("Backpack") } do
		if container then
			for _, tool in container:GetChildren() do
				local name = tool:IsA("Tool") and tool:GetAttribute("Weapon")
				local def = name and Weapons.Get(name)
				if def and def.Type == "Melee" then
					return name
				end
			end
		end
	end
	return nil
end

local function onMelee(player, part)
	if frozen() then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local meleeName = findMelee(player)
	if not humanoid or humanoid.Health <= 0 or not root or not meleeName then
		return
	end
	local def = Weapons.Get(meleeName)
	local now = os.clock()
	if now - (lastMelee[player] or 0) < def.Cooldown * 0.8 then
		return
	end
	lastMelee[player] = now
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") or not part:IsDescendantOf(workspace) then
		return
	end
	local targetChar, targetHum = getCharacterFromPart(part)
	if not targetChar or targetChar == character or targetHum.Health <= 0 then
		return
	end
	local targetRoot = targetChar:FindFirstChild("HumanoidRootPart") or part
	if (targetRoot.Position - root.Position).Magnitude > def.Range + 4 then
		return
	end
	if not isEnemy(player, Players:GetPlayerFromCharacter(targetChar), targetChar) then
		return
	end
	-- Nada de cuchillazos a través de paredes
	if not hasLineOfSight(root.Position, targetRoot.Position, { character, targetChar }) then
		return
	end
	removeSpawnShield(character)
	local dealt, killed = applyDamage(player, targetHum, def.Damage, meleeName, false)
	if dealt > 0 then
		Remotes.HitConfirm:FireClient(player, math.floor(dealt + 0.5), false, killed, targetRoot.Position)
	end
end

function Combat.Init()
	Remotes.Fire.OnServerEvent:Connect(onFire)
	Remotes.Reload.OnServerEvent:Connect(onReload)
	Remotes.Melee.OnServerEvent:Connect(onMelee)

	local function onPlayer(player)
		player.CharacterAdded:Connect(function(character)
			ignoreAccessories(character)
			local humanoid = character:WaitForChild("Humanoid")
			Combat.WatchHumanoid(humanoid, player, player.Name)
		end)
		if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
			ignoreAccessories(player.Character)
			Combat.WatchHumanoid(player.Character:FindFirstChildOfClass("Humanoid"), player, player.Name)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastMelee[player] = nil
	end)
end

return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Dummies</string>
            <string name="Source"><![CDATA[-- Muñecos de práctica para probar las armas en Studio (desactívalos en GameConfig.TrainingDummies).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Combat = require(script.Parent.Combat)

local Dummies = {}

local SPOTS = {
	Vector3.new(-20, 4, -60),
	Vector3.new(20, 4, 60),
	Vector3.new(-50, 4, 30),
	Vector3.new(50, 4, -30),
	Vector3.new(0, 11, 0),
}

local folder

-- Un punto libre del mapa actual (puntos FFASpawn) o uno de los fijos si no hay
local function randomSpot(fallback)
	local map = workspace:FindFirstChild("Map")
	local points = {}
	if map then
		for _, d in map:GetDescendants() do
			if d:IsA("BasePart") and d.Name == "FFASpawn" then
				table.insert(points, d.Position + Vector3.new(0, 3, 0))
			end
		end
	end
	if #points > 0 then
		return points[math.random(1, #points)]
	end
	return fallback
end

local function spawnDummy(position)
	position = randomSpot(position)
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = Color3.fromRGB(255, 200, 80)
	description.TorsoColor = Color3.fromRGB(80, 80, 90)
	description.LeftArmColor = Color3.fromRGB(255, 200, 80)
	description.RightArmColor = Color3.fromRGB(255, 200, 80)
	description.LeftLegColor = Color3.fromRGB(60, 60, 70)
	description.RightLegColor = Color3.fromRGB(60, 60, 70)

	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescriptionAsync(description, Enum.HumanoidRigType.R15)
	end)
	if not ok then
		ok, model = pcall(function()
			return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
		end)
	end
	if not ok then
		warn("[Dummies] No se pudo crear el muñeco:", model)
		return
	end
	model.Name = "Muñeco"
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayName = "Muñeco"
	humanoid.MaxHealth = 100
	humanoid.Health = 100
	model:PivotTo(CFrame.new(position) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	model.Parent = folder

	Combat.WatchHumanoid(humanoid, nil, "Muñeco")
	humanoid.Died:Connect(function()
		task.wait(4)
		model:Destroy()
		spawnDummy(position)
	end)
end

function Dummies.Init()
	if not GameConfig.TrainingDummies then
		return
	end
	folder = Instance.new("Folder")
	folder.Name = "Dummies"
	folder.Parent = workspace
	-- (cada uno en su hilo: crear el modelo espera a la red y no debe frenar el arranque del servidor)
	for _, position in SPOTS do
		task.spawn(spawnDummy, position)
	end
end

return Dummies
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Event</string>
            <string name="Source"><![CDATA[-- Evento de temporada (GameConfig.Event, ahora Halloween): durante las rondas van apareciendo
-- caramelos por el mapa (en los puntos de aparición libres). Al tocar uno: monedas y +1 al contador
-- del evento (se guarda); hay premios por el camino (Milestones) y al llegar a Goal se gana la
-- skin exclusiva. También pone calabazas en los
-- mapas (Event.Decorate lo llama MapBuilder). Los bots no recogen caramelos.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Skins = require(Shared.Skins)
local Outfits = require(Shared.Outfits)

local PlayerData = require(script.Parent.PlayerData)
local Kit = require(script.Parent.MapKit)

local Event = {}

local CONFIG = GameConfig.Event
local CANDY_COLORS = {
	Color3.fromRGB(255, 130, 20),
	Color3.fromRGB(170, 80, 255),
	Color3.fromRGB(120, 230, 60),
	Color3.fromRGB(255, 70, 120),
}

local folder
local candies = {}
local lastPickup = {} -- [player] = os.clock() (límite de recogida)
local LIFETIME = 60 -- segundos que dura un caramelo sin recoger
local PICKUP_RANGE = 9 -- distancia máxima real al caramelo (contra trampas de "toque" a distancia)

local function enabled()
	return CONFIG and CONFIG.Enabled and (CONFIG.EndsAt == nil or os.time() < CONFIG.EndsAt)
end

-- Puntos libres del mapa actual (FFASpawn); se guardan mientras no cambie el mapa
local cachedMap, cachedPoints = nil, {}
local function spawnPoints()
	local map = workspace:FindFirstChild("Map")
	if map ~= cachedMap then
		cachedMap, cachedPoints = map, {}
		if map then
			for _, d in map:GetDescendants() do
				if d:IsA("BasePart") and d.Name == "FFASpawn" then
					table.insert(cachedPoints, d.Position)
				end
			end
		end
	end
	return cachedPoints
end

local function clear()
	for _, candy in candies do
		candy:Destroy()
	end
	table.clear(candies)
end

local function collect(player, candy)
	if not candy.Parent or candy:GetAttribute("Taken") then
		return
	end
	-- Comprobaciones del servidor: de verdad cerca y no demasiado seguido
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - candy.Position).Magnitude > PICKUP_RANGE then
		return
	end
	if os.clock() - (lastPickup[player] or 0) < 0.25 then
		return
	end
	lastPickup[player] = os.clock()
	candy:SetAttribute("Taken", true)
	local index = table.find(candies, candy)
	if index then
		table.remove(candies, index)
	end
	candy:Destroy()
	local data = PlayerData.Get(player)
	if not data then
		return
	end
	if type(data.EventProgress) ~= "table" or data.EventProgress.Id ~= CONFIG.Id then
		data.EventProgress = { Id = CONFIG.Id, Count = 0 }
	end
	if type(data.EventProgress.Claimed) ~= "table" then
		-- Premios por el camino ya dados ("m25" = true). Los que ya se pasaron antes de existir esta
		-- lista se dieron al llegar justo a su número: se marcan como dados para no pagarlos dos veces
		local claimed = {}
		for _, milestone in CONFIG.Milestones or {} do
			if data.EventProgress.Count >= milestone.Count then
				claimed["m" .. milestone.Count] = true
			end
		end
		data.EventProgress.Claimed = claimed
	end
	data.EventProgress.Count += 1
	local count = data.EventProgress.Count
	PlayerData.MarkDirty(player)
	local coins = PlayerData.AddCoins(player, CONFIG.CandyCoins) -- (envía los datos al cliente, contador incluido)
	Remotes.Notify:FireClient(player, "XP", "🍬 Caramelo  +" .. coins .. " 🪙  (" .. math.min(count, CONFIG.Goal) .. "/" .. CONFIG.Goal .. ")")
	-- Premios por el camino (también los que quedaron atrás si el premio se añadió con el evento empezado)
	local claimed = data.EventProgress.Claimed
	for _, milestone in CONFIG.Milestones or {} do
		local key = "m" .. milestone.Count
		if count >= milestone.Count and milestone.Count < CONFIG.Goal and not claimed[key] then
			claimed[key] = true
			if milestone.Outfit and PlayerData.GiveOutfit(player, milestone.Outfit) then
				local outfit = Outfits.Get(milestone.Outfit)
				Remotes.Notify:FireClient(player, "Challenge", "🎃 ¡" .. milestone.Count .. " caramelos! Traje " .. outfit.Name .. " desbloqueado")
			else
				local amount = milestone.Coins or milestone.Compensate or 0
				if amount > 0 then
					PlayerData.AddCoins(player, amount, false) -- premio fijo (no lo dobla el VIP)
					Remotes.Notify:FireClient(player, "Challenge", "🎃 ¡" .. milestone.Count .. " caramelos! +" .. amount .. " 🪙")
				end
			end
		end
	end
	if count >= CONFIG.Goal and PlayerData.GiveSkin(player, CONFIG.RewardSkin) then
		local skin = Skins.Get(CONFIG.RewardSkin)
		Remotes.Notify:FireClient(player, "Challenge", "🎃 ¡Skin " .. skin.Name .. " desbloqueada!")
	end
end

-- Raycast solo contra el mapa (ni jugadores ni bots)
local mapParams = RaycastParams.new()
mapParams.FilterType = Enum.RaycastFilterType.Include

local function groundAt(position, up, down)
	local map = workspace:FindFirstChild("Map")
	if not map then
		return nil
	end
	mapParams.FilterDescendantsInstances = { map, workspace.Terrain }
	local hit = workspace:Raycast(position + Vector3.new(0, up, 0), Vector3.new(0, -(up + down), 0), mapParams)
	return hit and hit.Instance.CanCollide and hit.Position or nil
end

local function spawnCandy()
	local points = spawnPoints()
	if #points == 0 then
		return
	end
	local base = points[math.random(1, #points)]
	-- Cerca del punto, sobre el suelo y sin meterse en paredes (si no, en el propio punto)
	local position = base + Vector3.new(0, 2.2, 0)
	for _ = 1, 4 do
		local candidate = base + Vector3.new(math.random(-40, 40) / 10, 0, math.random(-40, 40) / 10)
		local floor = groundAt(candidate, 2, 4)
		if floor and math.abs(floor.Y - base.Y) < 1.5 then
			local mapFolder = workspace:FindFirstChild("Map")
			local overlap = OverlapParams.new()
			overlap.FilterType = Enum.RaycastFilterType.Include
			overlap.FilterDescendantsInstances = { mapFolder }
			local blocking = false
			for _, part in workspace:GetPartBoundsInRadius(floor + Vector3.new(0, 2.2, 0), 0.9, overlap) do
				if part.CanCollide then
					blocking = true
					break
				end
			end
			if not blocking then
				position = floor + Vector3.new(0, 2.2, 0)
				break
			end
		end
	end
	local candy = Instance.new("Part")
	candy.Name = "Candy"
	candy.Shape = Enum.PartType.Ball
	candy.Size = Vector3.new(1.6, 1.6, 1.6)
	candy.Color = CANDY_COLORS[math.random(1, #CANDY_COLORS)]
	candy.Material = Enum.Material.SmoothPlastic
	candy.Anchored = true
	candy.CanCollide = false
	candy.CanQuery = false
	candy.CanTouch = true
	candy.CastShadow = false
	candy.CFrame = CFrame.new(position)
	candy:SetAttribute("Bob", 0.5) -- flota (lo anima WorldFX en el cliente)
	local light = Instance.new("PointLight")
	light.Color = candy.Color
	light.Range = 8
	light.Brightness = 1
	light.Parent = candy
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(candy.Color)
	sparkle.LightEmission = 1
	sparkle.Size = NumberSequence.new(0.4, 0)
	sparkle.Lifetime = NumberRange.new(0.5, 0.8)
	sparkle.Rate = 5
	sparkle.Speed = NumberRange.new(1, 2)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.Parent = candy
	candy.Touched:Connect(function(hit)
		local character = hit.Parent
		local player = character and Players:GetPlayerFromCharacter(character)
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if player and humanoid and humanoid.Health > 0 and not player:GetAttribute("InMenu") then
			collect(player, candy)
		end
	end)
	candy.Parent = folder
	table.insert(candies, candy)
	-- Si nadie lo coge, desaparece (y deja sitio a otro)
	task.delay(LIFETIME, function()
		if candy.Parent then
			local index = table.find(candies, candy)
			if index then
				table.remove(candies, index)
			end
			candy:Destroy()
		end
	end)
end

-- Calabazas junto a algunos puntos libres del mapa (determinista: siempre en los mismos sitios)
function Event.Decorate()
	if not enabled() or not CONFIG.Pumpkins then
		return
	end
	local points = spawnPoints()
	local rng = Random.new(#points * 7 + 3)
	for i, point in points do
		if i % 3 == 1 then
			local offset = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1))
			if offset.Magnitude < 0.1 then
				offset = Vector3.xAxis
			end
			-- Sobre el suelo que haya debajo (si el punto está en una plataforma, que no flote en el aire)
			local ground = groundAt(point + offset.Unit * 5, 3, 4)
			if ground then
				Kit.pumpkin(CFrame.new(ground) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0), rng:NextNumber(0.8, 1.3))
			end
		end
	end
end

function Event.Init()
	if not enabled() then
		return
	end
	folder = Instance.new("Folder")
	folder.Name = "EventCandies"
	folder.Parent = workspace
	ReplicatedStorage:SetAttribute("EventName", CONFIG.Name)
	ReplicatedStorage:SetAttribute("EventGoal", CONFIG.Goal)
	Players.PlayerRemoving:Connect(function(player)
		lastPickup[player] = nil
	end)
	ReplicatedStorage:GetAttributeChangedSignal("State"):Connect(function()
		if ReplicatedStorage:GetAttribute("State") ~= "Playing" then
			clear()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(CONFIG.SpawnEvery)
			-- Se acabó la fecha del evento con el servidor encendido: fuera caramelos y contador
			if not enabled() then
				clear()
				ReplicatedStorage:SetAttribute("EventName", nil)
				return
			end
			local playing = ReplicatedStorage:GetAttribute("State") == "Playing" and not ReplicatedStorage:GetAttribute("Frozen")
			if playing and #candies < CONFIG.MaxCandies then
				local ok, err = pcall(spawnCandy)
				if not ok then
					warn("[Event] caramelo:", err)
				end
			end
		end
	end)
end

Event.Collect = collect -- (para las pruebas)
return Event
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Flags</string>
            <string name="Source"><![CDATA[-- Modo Captura la bandera.
-- Cada equipo tiene una bandera en su base. Coge la enemiga (acércate a ella) y llévala a tu base
-- mientras tu bandera siga allí para puntuar. Si matan al portador la bandera cae al suelo:
-- sus dueños la devuelven tocándola y si nadie la toca vuelve sola.
--
-- Estado publicado en ReplicatedStorage para la interfaz:
--   FlagState_<Equipo>   = "Home" | "Carried" | "Dropped"
--   FlagCarrier_<Equipo> = nombre del portador ("" si nadie)
--   FlagPos_<Equipo>     = dónde está la bandera ahora (los bots van a por ella)
--   FlagHome_<Equipo>    = su base
-- y en el jugador: atributo CarryingFlag = true/false.
-- Los bots también cogen, llevan, capturan y devuelven banderas (el portador puede ser un jugador o
-- un bot: tabla de Bots con Name, Team, Model, Root y Humanoid).
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)

local PlayerData = require(script.Parent.PlayerData)
local Bots = require(script.Parent.Bots)

local Flags = {}

-- Asignado por Round: function(player, team) que suma el punto
Flags.OnCapture = nil

local SETTINGS = GameConfig.Flag
local POLE_HEIGHT = 8

local folder
local flags = {} -- [teamName] = flag
local active = false
local heartbeat

local function findBases()
	local bases = {}
	for _, inst in workspace:GetDescendants() do
		if inst:IsA("BasePart") and inst.Name == "FlagBase" then
			local team = inst:GetAttribute("Team")
			if type(team) == "string" then
				bases[team] = inst
			end
		end
	end
	return bases
end

-- ¿El mapa tiene una base para cada equipo?
function Flags.IsAvailable()
	local bases = findBases()
	for _, cfg in GameConfig.Teams do
		if not bases[cfg.Name] then
			return false
		end
	end
	return true
end

local function publish(flag)
	ReplicatedStorage:SetAttribute("FlagState_" .. flag.Team.Name, flag.State)
	ReplicatedStorage:SetAttribute("FlagPos_" .. flag.Team.Name, flag.Position)
	ReplicatedStorage:SetAttribute("FlagCarrier_" .. flag.Team.Name, flag.Carrier and flag.Carrier.Name or "")
	local text = "BANDERA " .. string.upper(flag.Team.Name)
	if flag.State == "Carried" then
		text ..= "\n¡ROBADA!"
	elseif flag.State == "Dropped" then
		text ..= "\nCAÍDA"
	end
	flag.Label.Text = text
end

local function buildFlag(team)
	local model = Instance.new("Model")
	model.Name = "Flag_" .. team.Name

	local function part(name, size, color, material, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.Material = material
		p.Shape = shape or Enum.PartType.Block
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false -- no bloquea disparos
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = false
		p.Parent = model
		return p
	end

	local pole = part("Pole", Vector3.new(0.3, POLE_HEIGHT, 0.3), Color3.fromRGB(220, 220, 225), Enum.Material.Metal)
	local cloth = part("Cloth", Vector3.new(0.15, 2.4, 3.6), team.TeamColor.Color, Enum.Material.Neon)
	cloth.CFrame = pole.CFrame * CFrame.new(0, POLE_HEIGHT / 2 - 1.4, 1.8)
	local tip = part("Tip", Vector3.new(0.6, 0.6, 0.6), Color3.fromRGB(255, 200, 40), Enum.Material.Neon, Enum.PartType.Ball)
	tip.CFrame = pole.CFrame * CFrame.new(0, POLE_HEIGHT / 2 + 0.3, 0)
	for _, p in { cloth, tip } do
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = pole
		weld.Part1 = p
		weld.Parent = p
	end
	model.PrimaryPart = pole

	local light = Instance.new("PointLight")
	light.Color = team.TeamColor.Color
	light.Range = 14
	light.Brightness = 2
	light.Parent = cloth

	-- Destellos del color del equipo
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkles.Color = ColorSequence.new(team.TeamColor.Color, Color3.new(1, 1, 1))
	sparkles.LightEmission = 1
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
	sparkles.Lifetime = NumberRange.new(0.6, 1.2)
	sparkles.Speed = NumberRange.new(0.5, 1.5)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Rate = 8
	sparkles.Parent = cloth

	-- Marcador visible a través de las paredes
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Marker"
	billboard.Size = UDim2.fromOffset(160, 56)
	billboard.StudsOffset = Vector3.new(0, POLE_HEIGHT / 2 + 2.5, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = 1000
	billboard.Parent = pole
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextSize = 18
	label.TextColor3 = team.TeamColor.Color:Lerp(Color3.new(1, 1, 1), 0.25)
	label.TextStrokeTransparency = 0.2
	label.Text = ""
	label.Parent = billboard

	model.Parent = folder
	return model, label
end

local function setAnchored(flag, anchored)
	for _, p in flag.Model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = anchored
		end
	end
end

-- Coloca la bandera de pie en una posición del suelo
local function placeAt(flag, groundPosition)
	if flag.Weld then
		flag.Weld:Destroy()
		flag.Weld = nil
	end
	setAnchored(flag, true)
	flag.Model:PivotTo(CFrame.new(groundPosition + Vector3.new(0, POLE_HEIGHT / 2, 0)))
	flag.Position = groundPosition
end

local function homePosition(flag)
	-- Superficie de la base (sirve para piezas giradas o cilindros)
	return flag.Base.Position + Vector3.new(0, flag.Base.ExtentsSize.Y / 2, 0)
end

-- ¿El personaje (su HumanoidRootPart) está junto a un punto del suelo?
local function isNear(rootPosition, groundPosition, radius)
	local offset = rootPosition - groundPosition
	return Vector3.new(offset.X, 0, offset.Z).Magnitude <= radius and offset.Y > -2 and offset.Y < 8
end

local function isPlayer(entity)
	return typeof(entity) == "Instance"
end

local function setCarrying(entity, value)
	if isPlayer(entity) then
		entity:SetAttribute("CarryingFlag", value)
	elseif entity then
		entity.CarryingFlag = value
	end
end

local function setCarrier(flag, player)
	if flag.Carrier then
		setCarrying(flag.Carrier, false)
	end
	flag.Carrier = player
	if player then
		setCarrying(player, true)
	end
end

local function returnHome(flag, returner, silent)
	setCarrier(flag, nil)
	flag.State = "Home"
	flag.CarrierHumanoid = nil
	placeAt(flag, homePosition(flag))
	publish(flag)
	if silent then
		return
	elseif returner then
		Remotes.Notify:FireAllClients("Flag", returner.Name .. " devolvió la bandera " .. flag.Team.Name)
		if isPlayer(returner) then
			PlayerData.AddXP(returner, GameConfig.XP.FlagReturn, "Bandera devuelta")
		end
	else
		Remotes.Notify:FireAllClients("Flag", "La bandera " .. flag.Team.Name .. " volvió a su base")
	end
end

local function groundBelow(position, ignore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	ignore = table.clone(ignore)
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	params.FilterDescendantsInstances = ignore
	local result = workspace:Raycast(position + Vector3.new(0, 2, 0), Vector3.new(0, -60, 0), params)
	return result and result.Position or position - Vector3.new(0, 3, 0)
end

local function drop(flag)
	local carrier = flag.Carrier
	local humanoid = flag.CarrierHumanoid
	local root = flag.Model.PrimaryPart
	local ignore = { folder }
	local carrierModel = carrier and (isPlayer(carrier) and carrier.Character or carrier.Model)
	if carrierModel then
		table.insert(ignore, carrierModel)
	end
	local position = groundBelow(flag.LastCarrierPosition or root.Position, ignore)

	-- Recompensa a quien eliminó al portador
	if humanoid then
		local attackerId = humanoid:GetAttribute("LastAttacker")
		local hitTime = humanoid:GetAttribute("LastHitTime")
		local killer = attackerId and Players:GetPlayerByUserId(attackerId)
		if killer and hitTime and os.clock() - hitTime < 10 and humanoid.Health <= 0 then
			PlayerData.AddXP(killer, GameConfig.XP.CarrierKill, "Portador eliminado")
		end
	end

	setCarrier(flag, nil)
	flag.CarrierHumanoid = nil
	flag.State = "Dropped"
	flag.DroppedAt = os.clock()
	placeAt(flag, position)
	publish(flag)
	Remotes.Notify:FireAllClients("Flag", "¡La bandera " .. flag.Team.Name .. " ha caído!")
end

local function pickup(flag, player, character)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	setCarrier(flag, player)
	flag.CarrierHumanoid = character:FindFirstChildOfClass("Humanoid")
	flag.State = "Carried"
	flag.LastCarrierPosition = root.Position

	-- Soldada a la espalda del portador
	setAnchored(flag, false)
	flag.Model:PivotTo(root.CFrame * CFrame.new(0, 1.2, 1) * CFrame.Angles(math.rad(-15), 0, 0))
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = flag.Model.PrimaryPart
	weld.Parent = flag.Model.PrimaryPart
	flag.Weld = weld

	publish(flag)
	Remotes.Notify:FireAllClients("Flag", player.Name .. " tiene la bandera " .. flag.Team.Name .. "!")
end

local function capture(flag, player)
	local team = player.Team
	returnHome(flag, nil, true)
	Remotes.Notify:FireAllClients("Big", "¡" .. string.upper(player.Name) .. " CAPTURÓ LA BANDERA!")
	if isPlayer(player) then
		PlayerData.AddXP(player, GameConfig.XP.Capture, "Captura")
		PlayerData.AddCoins(player, GameConfig.Coins.Capture)
		PlayerData.Track(player, "Capture", 1)
		player:SetAttribute("Captures", (player:GetAttribute("Captures") or 0) + 1)
	end
	if Flags.OnCapture then
		Flags.OnCapture(player, team)
	end
end

local function aliveCharacter(player)
	if not isPlayer(player) then
		-- Bot
		if player.Humanoid and player.Humanoid.Health > 0 and player.Model and player.Root then
			return player.Model, player.Root
		end
		return nil, nil
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then
		return character, root
	end
	return nil, nil
end

local function isCarrying(player)
	for _, flag in flags do
		if flag.Carrier == player then
			return true
		end
	end
	return false
end

local lastTick = 0
local function step()
	if not active or os.clock() - lastTick < 0.1 then
		return
	end
	lastTick = os.clock()

	for _, flag in flags do
		if flag.State == "Carried" then
			local carrier = flag.Carrier
			local character, root = nil, nil
			if carrier and (not isPlayer(carrier) or carrier.Parent) then
				character, root = aliveCharacter(carrier)
			end
			if
				not character
				or flag.CarrierHumanoid == nil
				or character:FindFirstChildOfClass("Humanoid") ~= flag.CarrierHumanoid
				or carrier.Team == flag.Team
			then
				drop(flag)
			else
				flag.LastCarrierPosition = root.Position
				ReplicatedStorage:SetAttribute("FlagPos_" .. flag.Team.Name, root.Position)
				-- ¿Ha llegado a su base con su propia bandera en casa?
				local ownFlag = carrier.Team and flags[carrier.Team.Name]
				if
					ownFlag
					and ownFlag.State == "Home"
					and isNear(root.Position, homePosition(ownFlag), SETTINGS.CaptureRadius)
				then
					capture(flag, carrier)
				end
			end
		else
			if flag.State == "Dropped" and os.clock() - flag.DroppedAt >= SETTINGS.AutoReturnTime then
				returnHome(flag, nil)
			end
			-- Jugadores y bots que tocan la bandera
			local touchers = Players:GetPlayers()
			for _, agent in Bots.Agents do
				table.insert(touchers, agent)
			end
			for _, player in touchers do
				-- Quien sigue en la pantalla de inicio (invulnerable) no puede coger ni devolver banderas
				local inMenu = isPlayer(player) and player:GetAttribute("InMenu")
				if player.Team and flag.State ~= "Carried" and not inMenu then
					local character, root = aliveCharacter(player)
					if character and isNear(root.Position, flag.Position, SETTINGS.PickupRadius) then
						if player.Team == flag.Team then
							if flag.State == "Dropped" then
								returnHome(flag, player)
							end
						elseif not isCarrying(player) then
							pickup(flag, player, character)
						end
					end
				end
			end
		end
	end
end

-- Crea las banderas en sus bases (inicio de una ronda de CTF)
function Flags.Start()
	Flags.Stop()
	local bases = findBases()
	folder = Instance.new("Folder")
	folder.Name = "Flags"
	folder.Parent = workspace
	for _, team in Teams:GetTeams() do
		local base = bases[team.Name]
		if base then
			local flag = { Team = team, Base = base, State = "Home" }
			flag.Model, flag.Label = buildFlag(team)
			placeAt(flag, homePosition(flag))
			ReplicatedStorage:SetAttribute("FlagHome_" .. team.Name, homePosition(flag))
			flags[team.Name] = flag
			publish(flag)
		end
	end
	active = true
	heartbeat = RunService.Heartbeat:Connect(step)
end

-- Quita las banderas (fin de la ronda)
function Flags.Stop()
	active = false
	if heartbeat then
		heartbeat:Disconnect()
		heartbeat = nil
	end
	for teamName, flag in flags do
		setCarrier(flag, nil)
		ReplicatedStorage:SetAttribute("FlagState_" .. teamName, nil)
		ReplicatedStorage:SetAttribute("FlagCarrier_" .. teamName, nil)
		ReplicatedStorage:SetAttribute("FlagPos_" .. teamName, nil)
		ReplicatedStorage:SetAttribute("FlagHome_" .. teamName, nil)
	end
	table.clear(flags)
	if folder then
		folder:Destroy()
		folder = nil
	end
	for _, player in Players:GetPlayers() do
		player:SetAttribute("CarryingFlag", false)
	end
end

return Flags
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Friends</string>
            <string name="Source"><![CDATA[-- Bonus de amigos: +10% de XP y monedas por cada amigo de Roblox que esté en el mismo servidor
-- (hasta +30%). Anima a invitar a amigos. Atributo del jugador: FriendsHere (cuántos hay).
-- PlayerData lo aplica en su multiplicador de premios.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local Friends = {}

Friends.BonusPerFriend = 0.1
Friends.MaxFriends = 3

local friendsOf = {} -- [player] = { [otherPlayer] = true }

local function publish(player)
	local count = 0
	for other in friendsOf[player] or {} do
		if other.Parent then
			count += 1
		end
	end
	player:SetAttribute("FriendsHere", count)
end

-- Multiplicador por amigos (1 = sin bonus)
function Friends.Multiplier(player)
	return 1 + Friends.BonusPerFriend * math.min(Friends.MaxFriends, player:GetAttribute("FriendsHere") or 0)
end

local function onPlayer(player)
	friendsOf[player] = friendsOf[player] or {}
	publish(player)
	for _, other in Players:GetPlayers() do
		if other ~= player then
			task.spawn(function()
				local ok, isFriend = pcall(player.IsFriendsWith, player, other.UserId)
				if ok and isFriend and player.Parent and other.Parent then
					if friendsOf[player][other] then
						return -- ya contados (y avisados)
					end
					friendsOf[player][other] = true
					friendsOf[other] = friendsOf[other] or {}
					friendsOf[other][player] = true
					publish(player)
					publish(other)
					local bonus = math.floor(Friends.BonusPerFriend * 100)
					Remotes.Notify:FireClient(other, "Info", "👥 Tu amigo " .. player.DisplayName .. " ha entrado: +" .. bonus .. "% XP y monedas")
					Remotes.Notify:FireClient(player, "Info", "👥 Juegas con tu amigo " .. other.DisplayName .. ": +" .. bonus .. "% XP y monedas")
				end
			end)
		end
	end
end

function Friends.Init()
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayer, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		for other in friendsOf[player] or {} do
			if friendsOf[other] then
				friendsOf[other][player] = nil
				if other.Parent then
					publish(other)
				end
			end
		end
		friendsOf[player] = nil
	end)
end

return Friends
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Gifts</string>
            <string name="Source"><![CDATA[-- Regalos por tiempo jugado (GameConfig.PlaytimeGifts): cada pocos minutos de sesión hay un regalo
-- que se recoge con el botón 🎁 (monedas, XP o revivir instantáneos). El servidor cuenta el tiempo.
-- El progreso del día (regalos recogidos y tiempo jugado) se guarda con el resto de datos, así que
-- salir y volver a entrar no reinicia la cuenta: al día siguiente empieza de cero.
-- Atributos del jugador para la interfaz: GiftStart (hora del servidor equivalente al inicio de la
-- cuenta) y GiftsClaimed.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Shop = require(Shared.Shop)

local PlayerData = require(script.Parent.PlayerData)

local Gifts = {}

local started = {} -- [player] = os.clock() equivalente al inicio de la cuenta de hoy
local claimed = {} -- [player] = regalos recogidos hoy
local days = {} -- [player] = día (Shop.DayNumber) al que corresponde la cuenta
local restored = {} -- [player] = true cuando ya se ha leído el progreso guardado (antes no se guarda ni se reclama)

local function publish(player)
	player:SetAttribute("GiftStart", workspace:GetServerTimeNow() - (os.clock() - started[player]))
	player:SetAttribute("GiftsClaimed", claimed[player] or 0)
end

-- Si ha cambiado el día (la sesión cruzó la medianoche UTC), la cuenta empieza de cero
local function checkDay(player)
	local today = Shop.DayNumber()
	if started[player] and days[player] ~= today then
		days[player] = today
		started[player] = os.clock()
		claimed[player] = 0
		publish(player)
	end
end

-- Copia el progreso a los datos guardados
local function persist(player)
	local data = PlayerData.Get(player)
	if data and started[player] and restored[player] then
		checkDay(player)
		data.Gifts = { Day = days[player], Claimed = claimed[player] or 0, Seconds = math.floor(os.clock() - started[player]) }
		PlayerData.MarkDirty(player)
	end
end

local function describe(gift)
	local parts = {}
	if gift.Coins then
		table.insert(parts, "+" .. gift.Coins .. " 🪙")
	end
	if gift.XP then
		table.insert(parts, "+" .. gift.XP .. " XP")
	end
	if gift.Revives then
		table.insert(parts, "+" .. gift.Revives .. " 💖 revivir")
	end
	return table.concat(parts, "  ")
end
Gifts.Describe = describe

local function claim(player)
	checkDay(player)
	local index = (claimed[player] or 0) + 1
	local gift = GameConfig.PlaytimeGifts[index]
	if not gift or not started[player] then
		return false, "No hay más regalos hoy"
	end
	if os.clock() - started[player] < gift.Minutes * 60 - 1 then
		return false, "Todavía no"
	end
	if not PlayerData.Get(player) or not restored[player] then
		return false, "Cargando tus datos"
	end
	claimed[player] = index
	player:SetAttribute("GiftsClaimed", index)
	persist(player)
	if gift.Coins then
		PlayerData.AddCoins(player, gift.Coins, false)
	end
	if gift.XP then
		PlayerData.AddXP(player, gift.XP, "Regalo")
	end
	if gift.Revives then
		PlayerData.AddRevives(player, gift.Revives)
	end
	Remotes.Notify:FireClient(player, "Challenge", "🎁 Regalo: " .. describe(gift))
	return true, index
end

function Gifts.Init()
	Remotes.ClaimGift.OnServerInvoke = claim
	local function onPlayer(player)
		started[player] = os.clock()
		claimed[player] = 0
		days[player] = Shop.DayNumber()
		publish(player)
		-- Recupera el progreso de hoy (si ya jugó hoy en otro servidor o antes de salir). Espera lo que
		-- haga falta: hasta entonces no se guarda nada (si no, se borraría el progreso guardado)
		task.spawn(function()
			local data
			while player.Parent and started[player] and not data do
				data = PlayerData.WaitFor(player, 5)
			end
			if not data or not player.Parent or not started[player] then
				return
			end
			local saved = data.Gifts
			if type(saved) == "table" and saved.Day == days[player] then
				claimed[player] = math.max(claimed[player], saved.Claimed or 0)
				started[player] = math.min(started[player], os.clock() - (saved.Seconds or 0))
				publish(player)
			end
			restored[player] = true
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	-- Antes del guardado final (al salir o al cerrar el servidor); después se olvida al jugador
	PlayerData.OnLeaving = function(player)
		persist(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		-- Se limpia un poco después para que el guardado final lo encuentre (el orden de los
		-- eventos de salida no está garantizado)
		task.delay(5, function()
			started[player] = nil
			claimed[player] = nil
			days[player] = nil
			restored[player] = nil
		end)
	end)
	-- Guarda el tiempo jugado de vez en cuando (por si el servidor se cierra de golpe)
	task.spawn(function()
		while true do
			task.wait(30)
			for player in started do
				if player.Parent then
					persist(player)
				end
			end
		end
	end)
end

return Gifts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Grenades</string>
            <string name="Source"><![CDATA[-- Granadas: el servidor crea la granada con física, la deja rebotar y la hace explotar.
-- Cada jugador tiene una, que se recarga sola (atributo GrenadeReadyAt = hora del servidor).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Weapons = require(Shared.Weapons)
local Remotes = require(Shared.Remotes)

local Combat = require(script.Parent.Combat)

local Grenades = {}

local DEF = Weapons.Grenade

local folder

local function now()
	return workspace:GetServerTimeNow()
end

local function makeGrenade(cf)
	local ball = Instance.new("Part")
	ball.Name = "Grenade"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(0.9, 0.9, 0.9)
	ball.Color = Color3.fromRGB(60, 70, 50)
	ball.Material = Enum.Material.Metal
	ball.CFrame = cf
	ball.CanCollide = true
	ball.CanQuery = false
	ball.CanTouch = false
	ball.CustomPhysicalProperties = PhysicalProperties.new(2, 0.7, 0.35, 1, 1)
	local band = Instance.new("Part")
	band.Name = "Band"
	band.Shape = Enum.PartType.Cylinder
	band.Size = Vector3.new(0.2, 0.95, 0.95)
	band.Color = Color3.fromRGB(255, 50, 40)
	band.Material = Enum.Material.Neon
	band.CanCollide = false
	band.CanQuery = false
	band.CanTouch = false
	band.Massless = true
	band.CFrame = cf
	band.Parent = ball
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = ball
	weld.Part1 = band
	weld.Parent = band
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 60, 40)
	light.Range = 8
	light.Brightness = 2
	light.Parent = band
	return ball, light
end

local function throw(player, direction)
	if typeof(direction) ~= "Vector3" then
		return
	end
	local length = direction.Magnitude
	if not (length >= 0.5 and length <= 1.5) then -- también descarta NaN
		return
	end
	if player:GetAttribute("InMenu") or ReplicatedStorage:GetAttribute("Mode") == "GUN" or ReplicatedStorage:GetAttribute("Frozen") then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local head = character and character:FindFirstChild("Head")
	-- (los zombis de la Infección solo arañan)
	if not humanoid or humanoid.Health <= 0 or not head or character:GetAttribute("Zombie") then
		return
	end
	if now() < (player:GetAttribute("GrenadeReadyAt") or 0) then
		return
	end
	player:SetAttribute("GrenadeReadyAt", now() + DEF.Cooldown)
	-- Lanzar quita la protección de aparición, como disparar
	for _, child in character:GetChildren() do
		if child:IsA("ForceField") then
			child:Destroy()
		end
	end

	direction = direction.Unit
	-- Nunca aparece al otro lado de una pared: si hay algo delante, se queda de este lado
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, folder }
	local hit = workspace:Raycast(head.Position, direction * 2.5, params)
	local start = hit and (hit.Position - direction * 0.6) or (head.Position + direction * 2)
	local grenade, light = makeGrenade(CFrame.new(start))
	-- No choca con quien la lanza (si mira hacia abajo no sale rebotada de su cuerpo)
	for _, part in character:GetDescendants() do
		if part:IsA("BasePart") then
			local noCollide = Instance.new("NoCollisionConstraint")
			noCollide.Part0 = grenade
			noCollide.Part1 = part
			noCollide.Parent = grenade
		end
	end
	grenade.Parent = folder
	grenade:SetNetworkOwner(nil)
	grenade.AssemblyLinearVelocity = direction * DEF.ThrowSpeed + Vector3.new(0, 14, 0)
	grenade.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 20

	task.spawn(function()
		-- Parpadeo cada vez más rápido
		local fuseEnd = os.clock() + DEF.Fuse
		while os.clock() < fuseEnd and grenade.Parent do
			light.Enabled = not light.Enabled
			task.wait(math.max(0.06, (fuseEnd - os.clock()) * 0.15))
		end
		if not grenade.Parent then
			return
		end
		local position = grenade.Position + Vector3.new(0, 0.6, 0)
		grenade:Destroy()
		Remotes.ExplosionFX:FireAllClients(position, DEF.Explosive.Radius)
		if player.Parent then
			Combat.Explode(player, position, DEF, "Grenade")
		end
	end)
end

function Grenades.Init()
	folder = Instance.new("Folder")
	folder.Name = "Grenades"
	folder.Parent = workspace
	Remotes.ThrowGrenade.OnServerEvent:Connect(throw)
end

-- Al empezar una ronda todos tienen la granada lista (reaparecer no la recarga: evita abusar)
function Grenades.Reset()
	for _, player in Players:GetPlayers() do
		player:SetAttribute("GrenadeReadyAt", 0)
	end
end

return Grenades
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Hardpoint</string>
            <string name="Source"><![CDATA[-- Modo "Zona de control": una zona activa que cambia de sitio cada minuto. El equipo que la ocupa
-- (sin enemigos dentro) suma 1 punto por segundo. Si hay jugadores de los dos equipos, está disputada.
--
-- Estado para la interfaz (atributos de ReplicatedStorage):
--   ZoneOwner = "" | nombre del equipo | "Contested",  ZoneMoveIn = segundos hasta que cambie,
--   ZonePosition = Vector3
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Teams = game:GetService("Teams")

local Shared = ReplicatedStorage.Shared
local Remotes = require(Shared.Remotes)

local PlayerData = require(script.Parent.PlayerData)

local Hardpoint = {}

Hardpoint.OnScore = nil -- function(team, amount)

local ROTATE_TIME = 60
local XP_INTERVAL = 5

local active = false
local zones = {}
local index = 0
local visual
local thread

local function findZones()
	local list = {}
	local map = workspace:FindFirstChild("Map")
	if map then
		for _, d in map:GetDescendants() do
			if d:IsA("BasePart") and d.Name == "HardpointZone" then
				table.insert(list, d)
			end
		end
	end
	table.sort(list, function(a, b)
		return (a:GetAttribute("Order") or 0) < (b:GetAttribute("Order") or 0)
	end)
	return list
end

function Hardpoint.IsAvailable()
	return #findZones() > 0
end

local function makeVisual(zone)
	if visual then
		visual:Destroy()
	end
	local radius = zone:GetAttribute("Radius") or 10
	local model = Instance.new("Model")
	model.Name = "ActiveZone"
	local function part(name, size, cf, material, transparency)
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Size = size
		p.CFrame = cf
		p.Material = material
		p.Transparency = transparency or 0
		p.Color = Color3.new(1, 1, 1)
		p.Parent = model
		return p
	end
	local base = zone.Position
	local ring = part("Ring", Vector3.new(0.3, radius * 2 + 1, radius * 2 + 1), CFrame.new(base + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.pi / 2), Enum.Material.Neon)
	ring.Shape = Enum.PartType.Cylinder
	local inner = part("Fill", Vector3.new(0.32, radius * 2 - 1, radius * 2 - 1), CFrame.new(base + Vector3.new(0, 0.21, 0)) * CFrame.Angles(0, 0, math.pi / 2), Enum.Material.ForceField, 0.3)
	inner.Shape = Enum.PartType.Cylinder
	local beam = part("Beam", Vector3.new(80, radius * 0.6, radius * 0.6), CFrame.new(base + Vector3.new(0, 40, 0)) * CFrame.Angles(0, 0, math.pi / 2), Enum.Material.Neon, 0.8)
	beam.Shape = Enum.PartType.Cylinder
	local light = Instance.new("PointLight")
	light.Range = radius * 2
	light.Brightness = 2
	light.Parent = ring
	-- Marcador visible a través de las paredes
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(140, 50)
	billboard.StudsOffset = Vector3.new(0, 8, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = 1500
	billboard.Parent = ring
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextStrokeTransparency = 0.2
	label.Text = "◆ ZONA"
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Parent = billboard
	model.Parent = workspace
	visual = model
end

local function paint(color)
	if not visual then
		return
	end
	for _, p in visual:GetDescendants() do
		if p:IsA("BasePart") then
			p.Color = color
		elseif p:IsA("PointLight") then
			p.Color = color
		elseif p:IsA("TextLabel") then
			p.TextColor3 = color
		end
	end
end

local function playersInZone(zone)
	local radius = zone:GetAttribute("Radius") or 10
	local center = zone.Position
	local byTeam = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if player.Team and humanoid and humanoid.Health > 0 and root and not player:GetAttribute("InMenu") then
			local offset = root.Position - center
			if Vector3.new(offset.X, 0, offset.Z).Magnitude <= radius and offset.Y > -3 and offset.Y < 10 then
				byTeam[player.Team] = byTeam[player.Team] or {}
				table.insert(byTeam[player.Team], player)
			end
		end
	end
	-- Los bots también ocupan y disputan la zona (sin XP: su lista queda vacía)
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart")
			local team = Teams:FindFirstChild(model:GetAttribute("Team") or "")
			if team and team:IsA("Team") and humanoid and humanoid.Health > 0 and root then
				local offset = root.Position - center
				if Vector3.new(offset.X, 0, offset.Z).Magnitude <= radius and offset.Y > -3 and offset.Y < 10 then
					byTeam[team] = byTeam[team] or {}
				end
			end
		end
	end
	return byTeam
end

local function moveTo(i)
	index = i
	local zone = zones[index]
	makeVisual(zone)
	ReplicatedStorage:SetAttribute("ZonePosition", zone.Position)
	Remotes.Notify:FireAllClients("Flag", "¡La zona se ha movido!")
end

function Hardpoint.Start()
	Hardpoint.Stop()
	zones = findZones()
	if #zones == 0 then
		return false
	end
	active = true
	moveTo(1)
	thread = task.spawn(function()
		local moveAt = os.clock() + ROTATE_TIME
		local tick = 0
		while active do
			task.wait(1)
			tick += 1
			local remaining = math.max(0, math.ceil(moveAt - os.clock()))
			ReplicatedStorage:SetAttribute("ZoneMoveIn", remaining)
			if remaining <= 0 then
				moveAt = os.clock() + ROTATE_TIME
				moveTo(index % #zones + 1)
			end
			local byTeam = playersInZone(zones[index])
			local owner, count = nil, 0
			for team in byTeam do
				count += 1
				owner = team
			end
			if count == 0 then
				ReplicatedStorage:SetAttribute("ZoneOwner", "")
				paint(Color3.new(1, 1, 1))
			elseif count > 1 then
				ReplicatedStorage:SetAttribute("ZoneOwner", "Contested")
				paint(Color3.fromRGB(255, 200, 40))
			else
				ReplicatedStorage:SetAttribute("ZoneOwner", owner.Name)
				paint(owner.TeamColor.Color)
				if Hardpoint.OnScore then
					Hardpoint.OnScore(owner, 1)
				end
				for _, player in byTeam[owner] do
					PlayerData.Track(player, "ZoneTime", 1)
				end
				if tick % XP_INTERVAL == 0 then
					for _, player in byTeam[owner] do
						PlayerData.AddXP(player, 20, "Zona")
					end
				end
			end
		end
	end)
	return true
end

function Hardpoint.Stop()
	active = false
	if thread then
		pcall(task.cancel, thread)
		thread = nil
	end
	if visual then
		visual:Destroy()
		visual = nil
	end
	ReplicatedStorage:SetAttribute("ZoneOwner", nil)
	ReplicatedStorage:SetAttribute("ZonePosition", nil)
	ReplicatedStorage:SetAttribute("ZoneMoveIn", nil)
end

return Hardpoint
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Hazards</string>
            <string name="Source"><![CDATA[-- Peligros del mapa: pisar lava quita vida cada cuarto de segundo.
-- Se detecta de dos formas, por si una falla en el servidor: el material del suelo (CrackedLava)
-- y un rayo hacia abajo contra las piezas marcadas con el atributo Hazard = "Lava".
local Players = game:GetService("Players")

local Hazards = {}

local LAVA_DAMAGE = 10 -- por cada 0.25 s
local RAY_LENGTH = 4.5 -- desde el centro del personaje hasta un poco por debajo de los pies

local cachedMap, lavaParts = nil, {}
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Include

local function refreshLava()
	local map = workspace:FindFirstChild("Map")
	if map == cachedMap then
		return
	end
	cachedMap = map
	lavaParts = {}
	if map then
		for _, d in map:GetDescendants() do
			if d:IsA("BasePart") and d:GetAttribute("Hazard") == "Lava" then
				table.insert(lavaParts, d)
			end
		end
	end
	params.FilterDescendantsInstances = lavaParts
end

local function onLava(humanoid, root)
	if humanoid.FloorMaterial == Enum.Material.CrackedLava then
		return true
	end
	if #lavaParts == 0 then
		return false
	end
	return workspace:Raycast(root.Position, Vector3.new(0, -RAY_LENGTH, 0), params) ~= nil
end

function Hazards.Init()
	task.spawn(function()
		while true do
			task.wait(0.25)
			refreshLava()
			-- Jugadores y bots
			local characters = {}
			for _, player in Players:GetPlayers() do
				if player.Character then
					table.insert(characters, player.Character)
				end
			end
			local bots = workspace:FindFirstChild("Bots")
			if bots then
				for _, model in bots:GetChildren() do
					table.insert(characters, model)
				end
			end
			for _, character in characters do
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				local root = character:FindFirstChild("HumanoidRootPart")
				if humanoid and root and humanoid.Health > 0 and onLava(humanoid, root) then
					-- La lava no es una baja de nadie
					humanoid:SetAttribute("LastAttacker", nil)
					humanoid:SetAttribute("LastBot", nil)
					humanoid:SetAttribute("LastWeapon", nil)
					humanoid:TakeDamage(LAVA_DAMAGE)
				end
			end
		end
	end)
end

return Hazards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Killstreaks</string>
            <string name="Source"><![CDATA[-- Recompensas por racha de bajas (sin morir):
--   3 bajas: RADAR. Durante unos segundos tu equipo (o tú, en Todos contra todos) ve a los
--            enemigos a través de las paredes. Atributo de jugador RadarUntil = hora del servidor.
--   5 bajas: ATAQUE AÉREO. Se guarda (atributo Airstrikes) y se lanza con la tecla T: marca el
--            punto al que apuntas y caen 5 explosiones en línea.
-- No hay recompensas en Escalada de armas.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Weapons = require(Shared.Weapons)
local Remotes = require(Shared.Remotes)

local Combat = require(script.Parent.Combat)

local Killstreaks = {}

Killstreaks.RadarStreak = 3
Killstreaks.AirstrikeStreak = 5
local RADAR_TIME = 12
local MAX_RANGE = 600
local STRIKE_DELAY = 1.6 -- segundos de aviso antes de que caigan las bombas
local STRIKES = 5
local SPACING = 9

local function now()
	return workspace:GetServerTimeNow()
end

local function enabled()
	return ReplicatedStorage:GetAttribute("Mode") ~= "GUN"
end

local function activateRadar(player)
	local untilTime = now() + RADAR_TIME
	for _, other in Players:GetPlayers() do
		local ally = other == player or (player.Team ~= nil and other.Team == player.Team and ReplicatedStorage:GetAttribute("TeamMode") ~= false)
		if other == player then
			other:SetAttribute("RadarUntil", untilTime)
			Remotes.Notify:FireClient(other, "Big", "📡 ¡RADAR ACTIVADO!")
		elseif ally then
			other:SetAttribute("RadarUntil", untilTime)
			Remotes.Notify:FireClient(other, "Info", "📡 Radar activado por " .. player.Name)
		else
			Remotes.Notify:FireClient(other, "Info", "📡 ¡El enemigo tiene radar!")
		end
	end
end

-- Lo llama Round cada vez que alguien suma una baja a su racha
function Killstreaks.OnStreak(player, streak)
	-- (los zombis de la Infección no tienen recompensas por racha)
	if not enabled() or (player.Character and player.Character:GetAttribute("Zombie")) then
		return
	end
	if streak == Killstreaks.RadarStreak then
		activateRadar(player)
	elseif streak == Killstreaks.AirstrikeStreak then
		player:SetAttribute("Airstrikes", (player:GetAttribute("Airstrikes") or 0) + 1)
		Remotes.Notify:FireClient(player, "Big", "✈ ¡ATAQUE AÉREO LISTO! Pulsa T")
	end
end

-- Al empezar una ronda nadie conserva recompensas
function Killstreaks.Reset()
	for _, player in Players:GetPlayers() do
		player:SetAttribute("Airstrikes", 0)
		player:SetAttribute("RadarUntil", 0)
	end
end

-- Punto del suelo bajo una posición (ignorando personajes, granadas y muros invisibles)
local function ground(position)
	local ignore = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	for _, name in { "Dummies", "Bots", "Grenades", "ClientFX" } do
		local f = workspace:FindFirstChild(name)
		if f then
			table.insert(ignore, f)
		end
	end
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	-- Desde una altura fija: las bombas siempre caen sobre el primer techo (no dentro de edificios)
	local result = workspace:Raycast(Vector3.new(position.X, 200, position.Z), Vector3.new(0, -260, 0), params)
	return result and result.Position + Vector3.new(0, 1, 0) or position
end

local function callAirstrike(player, target)
	if typeof(target) ~= "Vector3" or target ~= target then
		return
	end
	if not enabled() or player:GetAttribute("InMenu") or (player:GetAttribute("Airstrikes") or 0) <= 0 then
		return
	end
	if player.Character and player.Character:GetAttribute("Zombie") then
		return
	end
	if ReplicatedStorage:GetAttribute("State") ~= "Playing" or ReplicatedStorage:GetAttribute("Frozen") then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root then
		return
	end
	local offset = target - root.Position
	if offset.Magnitude > MAX_RANGE or offset.Y < -100 or offset.Y > 150 then
		return
	end
	player:SetAttribute("Airstrikes", player:GetAttribute("Airstrikes") - 1)

	-- 5 puntos en línea, en la dirección en la que mira el jugador
	local flat = Vector3.new(offset.X, 0, offset.Z)
	local direction = flat.Magnitude > 1 and flat.Unit or Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit
	local points = {}
	for i = 1, STRIKES do
		local along = (i - (STRIKES + 1) / 2) * SPACING
		table.insert(points, ground(target + direction * along))
	end
	Remotes.AirstrikeMark:FireAllClients(points, STRIKE_DELAY)
	Remotes.Notify:FireAllClients("Streak", "✈ ¡ATAQUE AÉREO de " .. player.Name .. "!")

	task.delay(STRIKE_DELAY, function()
		for _, point in points do
			if ReplicatedStorage:GetAttribute("State") ~= "Playing" then
				return -- la ronda terminó durante el aviso
			end
			Remotes.ExplosionFX:FireAllClients(point, Weapons.Airstrike.Explosive.Radius)
			if player.Parent then
				Combat.Explode(player, point, Weapons.Airstrike, "Airstrike")
			end
			task.wait(0.18)
		end
	end)
end

function Killstreaks.Init()
	Remotes.CallAirstrike.OnServerEvent:Connect(callAirstrike)
end

return Killstreaks
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Leaderboard</string>
            <string name="Source"><![CDATA[-- Clasificación global (todos los servidores): top 10 de bajas, de victorias y de rango (mejor RP).
-- Se guarda en OrderedDataStores y se publica a los clientes como texto JSON en atributos de
-- ReplicatedStorage ("Leaderboard_Kills", "Leaderboard_Wins", "Leaderboard_Rank") para la pantalla de inicio.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PlayerData = require(script.Parent.PlayerData)

local Leaderboard = {}

local REFRESH = 90 -- segundos entre actualizaciones (los DataStores tienen límite de peticiones)
local TOP = 10

local BOARDS = {
	{ Id = "Kills", Store = "TopBajas_v1", Field = "TotalKills" },
	{ Id = "Wins", Store = "TopVictorias_v1", Field = "Wins" },
	{ Id = "Rank", Store = "TopRango_v1", Field = "RankPoints" },
}

local stores = {}
local pushed = {} -- [userId .. board] = último valor enviado
local names = {} -- caché de nombres por UserId

local function nameOf(userId)
	if names[userId] then
		return names[userId]
	end
	local online = Players:GetPlayerByUserId(userId)
	if online then
		names[userId] = online.Name
		return online.Name
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and type(name) == "string" then
		names[userId] = name
		return name
	end
	return "Jugador"
end

-- Sube los números de un jugador (solo si han cambiado)
local function push(player)
	local data = PlayerData.Get(player)
	if not data then
		return
	end
	for _, board in BOARDS do
		local store = stores[board.Id]
		local value = math.floor(tonumber(data[board.Field]) or 0)
		local k = player.UserId .. board.Id
		if store and value > 0 and pushed[k] ~= value then
			-- Nunca baja un récord (por ejemplo si sus datos no cargaron y empieza de 0)
			local ok = pcall(function()
				store:UpdateAsync(tostring(player.UserId), function(old)
					return math.max(tonumber(old) or 0, value)
				end)
			end)
			if ok then
				pushed[k] = value
			end
		end
	end
end

local function fetch()
	for _, board in BOARDS do
		local store = stores[board.Id]
		if store then
			local ok, page = pcall(function()
				return store:GetSortedAsync(false, TOP):GetCurrentPage()
			end)
			if ok and type(page) == "table" then
				local rows = {}
				for rank, entry in page do
					local userId = tonumber(entry.key)
					if userId then
						table.insert(rows, { Rank = rank, UserId = userId, Name = nameOf(userId), Value = entry.value })
					end
				end
				ReplicatedStorage:SetAttribute("Leaderboard_" .. board.Id, HttpService:JSONEncode(rows))
			end
		end
	end
end

function Leaderboard.Init()
	for _, board in BOARDS do
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore(board.Store)
		end)
		if ok then
			stores[board.Id] = store
		end
	end
	if next(stores) == nil then
		warn("[Leaderboard] Sin acceso a DataStores: no hay clasificación global")
		return
	end
	Players.PlayerRemoving:Connect(push)
	task.spawn(function()
		task.wait(10)
		while true do
			for _, player in Players:GetPlayers() do
				push(player)
			end
			fetch()
			task.wait(REFRESH)
		end
	end)
end

return Leaderboard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Loadout</string>
            <string name="Source"><![CDATA[-- Entrega las armas (Tools) a cada jugador cuando aparece.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Weapons = require(Shared.Weapons)
local WeaponModels = require(Shared.WeaponModels)
local Remotes = require(Shared.Remotes)
local Outfits = require(Shared.Outfits)

local PlayerData = require(script.Parent.PlayerData)

local Loadout = {}

-- Los modos de juego pueden cambiar las armas: function(player) -> { "Arma1", "Arma2", ... } o nil
Loadout.Override = nil

function Loadout.MakeTool(weaponName, skinId)
	local def = Weapons.Get(weaponName)
	local tool = Instance.new("Tool")
	tool.Name = def.DisplayName
	tool.ToolTip = def.DisplayName
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	-- La mano derecha agarra la empuñadura del arma
	tool.Grip = CFrame.new(def.RightHand or Vector3.zero)
	tool:SetAttribute("Weapon", weaponName)
	tool:SetAttribute("Skin", skinId)
	tool:SetAttribute("Slot", def.Slot)
	if def.Type == "Gun" then
		tool:SetAttribute("Ammo", def.MagSize)
		tool:SetAttribute("Reserve", def.ReserveAmmo)
		tool:SetAttribute("Reloading", false)
		tool.Unequipped:Connect(function()
			tool:SetAttribute("Reloading", false) -- cambiar de arma cancela la recarga
		end)
	end

	local model = WeaponModels.Build(weaponName, skinId)
	for _, child in model:GetChildren() do
		child.Parent = tool
	end
	model:Destroy()
	return tool
end

local function giveLoadout(player, character)
	local data = PlayerData.WaitFor(player, 15)
	if player.Character ~= character then
		return
	end
	local list = Loadout.Override and Loadout.Override(player) or Loadout.DefaultList(data)

	-- Traje de operador (solo R15)
	-- (los zombis de la Infección no llevan traje: taparía la piel verde y los ojos)
	local zombie = ReplicatedStorage:GetAttribute("Infection") == "On" and player.Team ~= nil
		and player.Team.Name == ReplicatedStorage:GetAttribute("TeamB")
	if data and data.EquippedOutfit ~= "Default" and not zombie then
		character:WaitForChild("UpperTorso", 5)
		-- Espera a que cargue la ropa del avatar: si no, sus BodyColors y camisa taparían el traje
		local started = os.clock()
		while not player:HasAppearanceLoaded() and os.clock() - started < 5 do
			task.wait(0.1)
		end
		if player.Character ~= character then
			return
		end
		Outfits.Apply(character, data.EquippedOutfit)
	end

	Loadout.Give(player, list)
end

-- Armas elegidas por el jugador (principal, secundaria y cuchillo)
function Loadout.DefaultList(data)
	local primary = data and data.Primary or "ARX27"
	local secondary = data and data.Secondary or Weapons.Secondary
	local melee = data and data.Melee or Weapons.Melee
	return { primary, secondary, melee }
end

-- Devuelve sus armas de siempre a un jugador vivo (por ejemplo al acabar la Escalada)
function Loadout.GiveDefault(player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		Loadout.Give(player, Loadout.DefaultList(PlayerData.Get(player)))
	end
end

-- Da al jugador exactamente estas armas (y equipa la primera).
-- Cada arma lleva su camuflaje de maestría si lo tiene elegido, o la skin general.
function Loadout.Give(player, list)
	local character = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not character or not backpack then
		return
	end
	local data = PlayerData.Get(player)
	for _, container in { backpack, character } do
		for _, child in container:GetChildren() do
			if child:IsA("Tool") then
				child:Destroy()
			end
		end
	end
	local first
	for _, weaponName in list do
		if Weapons.Get(weaponName) then
			local tool = Loadout.MakeTool(weaponName, PlayerData.SkinFor(data, weaponName))
			tool.Parent = backpack
			first = first or tool
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if first and humanoid and humanoid.Health > 0 then
		humanoid:EquipTool(first)
	end
end

local function onOutfitChanged(player, outfitId)
	local character = player.Character
	if character then
		if outfitId == "Default" then
			-- Para quitar el traje del todo hay que reaparecer (recupera la ropa original)
			Outfits.Remove(character)
		else
			Outfits.Apply(character, outfitId)
		end
	end
end

-- Vuelve a pintar las armas que lleva encima (skin general o camuflaje de maestría)
local function onSkinChanged(player)
	local data = PlayerData.Get(player)
	local containers = { player:FindFirstChild("Backpack"), player.Character }
	for _, container in containers do
		if container then
			for _, tool in container:GetChildren() do
				local weaponName = tool:IsA("Tool") and tool:GetAttribute("Weapon")
				if weaponName then
					local skinId = PlayerData.SkinFor(data, weaponName)
					if tool:GetAttribute("Skin") ~= skinId then
						WeaponModels.ApplySkin(tool, skinId, weaponName)
						tool:SetAttribute("Skin", skinId)
					end
				end
			end
		end
	end
end

-- Mientras el jugador está en la pantalla de inicio es invulnerable (escudo invisible)
local function addMenuShield(player, character)
	if player:GetAttribute("InMenu") and not character:FindFirstChild("MenuShield") then
		local shield = Instance.new("ForceField")
		shield.Name = "MenuShield"
		shield.Visible = false
		shield.Parent = character
	end
end

local spawnedAt = {} -- [player] = os.clock() de su última aparición

-- En plena ronda de Eliminación, quien no la empezó (y ya salió del menú) entra como espectador hasta
-- la siguiente: si no, podría aparecer de refresco a mitad de ronda. No cuenta como muerte.
local function makeSpectatorIfLate(player, character)
	if not ReplicatedStorage:GetAttribute("NoRespawn") or player:GetAttribute("ElimIn") or player:GetAttribute("InMenu") then
		return
	end
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid:SetAttribute("Spectator", true)
		humanoid.Health = 0
	end
end

local function onPlayer(player)
	player:SetAttribute("InMenu", true)
	player.CharacterAdded:Connect(function(character)
		spawnedAt[player] = os.clock()
		addMenuShield(player, character)
		-- (personaje que llega tarde a una ronda de Eliminación ya empezada)
		task.defer(function()
			character:WaitForChild("Humanoid", 5)
			makeSpectatorIfLate(player, character)
		end)
		giveLoadout(player, character)
	end)
	if player.Character then
		addMenuShield(player, player.Character)
		task.spawn(giveLoadout, player, player.Character)
	end
end

function Loadout.Init()
	PlayerData.OnSkinChanged = onSkinChanged
	PlayerData.OnOutfitChanged = onOutfitChanged
	-- "Volver al menú": vuelve a ser invulnerable y queda fuera de los objetivos
	Remotes.EnterMenu.OnServerEvent:Connect(function(player)
		-- Solo desde la pantalla de muerte: si no, cualquiera podría volverse invulnerable en plena pelea
		-- (o justo al reaparecer: el clic pudo llegar después de la reaparición automática, y ese
		-- personaje aún tiene la protección de aparición, así que no se gana nada haciendo trampa)
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		local justSpawned = os.clock() - (spawnedAt[player] or -math.huge) < 1.5
		if humanoid and humanoid.Health > 0 and not justSpawned then
			return
		end
		player:SetAttribute("InMenu", true)
		if player.Character then
			addMenuShield(player, player.Character)
		end
	end)
	Remotes.LeaveMenu.OnServerEvent:Connect(function(player)
		player:SetAttribute("InMenu", false)
		-- Desde cuándo juega esta partida (para el rango; Round lo pone a cero al empezar cada una)
		if not player:GetAttribute("MatchJoinedAt") then
			player:SetAttribute("MatchJoinedAt", workspace:GetServerTimeNow())
		end
		local shield = player.Character and player.Character:FindFirstChild("MenuShield")
		if shield then
			shield:Destroy()
		end
		-- En plena ronda de Eliminación quien no la empezó entra como espectador hasta la siguiente
		-- (si no, podría aparecer de refresco a mitad de ronda)
		makeSpectatorIfLate(player, player.Character)
	end)
	Players.PlayerAdded:Connect(onPlayer)
	Players.PlayerRemoving:Connect(function(player)
		spawnedAt[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
end

return Loadout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[-- Registro de mapas: construye el mapa elegido y publica su nombre para la interfaz.
-- Si construyes tu propio mapa en Studio dentro de workspace.Map (sin el atributo "Generated"),
-- se usará ese y no habrá rotación de mapas.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MapBuilder = {}

MapBuilder.Defs = {}
for _, module in script.Parent.MapDefs:GetChildren() do
	local def = require(module)
	MapBuilder.Defs[def.Id] = def
end

-- Orden de rotación (también son las opciones de la votación)
MapBuilder.Order = { "PastelPlaza", "CandyArena", "ToyBox", "HauntedManor", "MoonBase", "SakuraGarden", "TikiBeach", "HarborHeights", "ContainerClash", "NeonFoundry", "FrostStation", "JungleTemple", "Downtown" }

MapBuilder.Current = nil

-- ¿Hay un mapa hecho a mano en Studio?
function MapBuilder.IsCustom()
	local map = workspace:FindFirstChild("Map")
	return map ~= nil and not map:GetAttribute("Generated")
end

function MapBuilder.Get(id)
	return MapBuilder.Defs[id]
end

function MapBuilder.Build(id)
	if MapBuilder.IsCustom() then
		ReplicatedStorage:SetAttribute("MapName", "Mapa propio")
		return nil
	end
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end
	local def = MapBuilder.Defs[id or MapBuilder.Order[1]] or MapBuilder.Defs[MapBuilder.Order[1]]
	def.Build()
	-- Decoración del evento de temporada (calabazas en Halloween)
	local ok, err = pcall(function()
		require(script.Parent.Event).Decorate()
	end)
	if not ok then
		warn("[MapBuilder] decoración del evento:", err)
	end
	MapBuilder.Current = def.Id
	ReplicatedStorage:SetAttribute("MapName", def.Name)
	ReplicatedStorage:SetAttribute("MapId", def.Id)
	return def
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="39">
          <Properties>
            <string name="Name">MapDefs</string>
          </Properties>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">CandyArena</string>
              <string name="Source"><![CDATA[-- ARENA CARAMELO: arena pequeña y simétrica para duelos rápidos (pensada para Eliminación, pero vale
-- para todos los modos). Tarta de dos pisos en el centro, gominolas y tabletas de chocolate como
-- cobertura, rosquillas, cornisas laterales, pilares de bastón de caramelo y piruletas gigantes de fondo.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)

local Map = {
	Id = "CandyArena",
	Name = "Arena Caramelo",
	Icon = "🍬",
	Description = "Arena pequeña · duelos rápidos · tarta central",
}

Map.Lighting = {
	ClockTime = 14.2,
	Brightness = 3.2,
	Exposure = 0.08,
	Ambient = Color3.fromRGB(135, 120, 140),
	OutdoorAmbient = Color3.fromRGB(175, 165, 190),
	Atmosphere = { Density = 0.2, Offset = 0.2, Color = Color3.fromRGB(255, 225, 245), Decay = Color3.fromRGB(190, 140, 210), Glare = 0, Haze = 0.5 },
	Color = { Saturation = 0.22, Contrast = 0.06, Brightness = 0.03, Tint = Color3.fromRGB(255, 250, 252) },
	Bloom = { Intensity = 0.35, Size = 22, Threshold = 2 },
	Clouds = 0.5,
	SunRays = 0.04,
	ShadowSoftness = 0.3,
	Wind = Vector3.new(2, 0, 1),
	TerrainColors = {
		Grass = Color3.fromRGB(150, 220, 120),
		LeafyGrass = Color3.fromRGB(120, 200, 110),
	},
}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad

local MINT = RGB(140, 225, 195) -- paredes
local MINT_DARK = RGB(100, 195, 165)
local PINK = RGB(255, 120, 175) -- bordes y tarta
local FLOOR = RGB(255, 205, 160) -- galleta
local CHOCOLATE = RGB(120, 70, 45)
local CREAM = RGB(255, 245, 235) -- nata (no se vuelve lavanda: ver KEEP_LOOK en MapKit)
local GUMDROPS = { RGB(255, 90, 110), RGB(90, 200, 255), RGB(255, 200, 60), RGB(140, 230, 90), RGB(200, 120, 255) }

local LENGTH, WIDTH = 180, 110

-- Muro de menta con borde rosa
local function wall(name, cf, size, color)
	local part = Kit.block(name, size, cf * CFrame.new(0, size.Y / 2, 0), color or MINT, Enum.Material.SmoothPlastic)
	Kit.deco(name .. "Cap", V(size.X + 0.4, 0.7, size.Z + 0.4), cf * CFrame.new(0, size.Y + 0.35, 0), PINK, Enum.Material.SmoothPlastic)
	return part
end

-- Pilar de bastón de caramelo (blanco con franjas rojas)
local function candyCane(cf, height)
	Kit.cylinder("CandyWhite", height, 3.4, cf * CFrame.new(0, height / 2, 0), CREAM, Enum.Material.SmoothPlastic)
	for y = 2.5, height - 1, 4 do
		Kit.cylinder("CandyRed", 1.3, 3.6, cf * CFrame.new(0, y, 0) * CFrame.Angles(rad(18), 0, 0), RGB(240, 50, 70), Enum.Material.SmoothPlastic, nil, true)
	end
	Kit.ball("CandyTop", 3.8, cf * CFrame.new(0, height, 0), RGB(240, 50, 70), Enum.Material.SmoothPlastic, true)
end

-- Gominola (media bola con azúcar): cobertura baja redondeada
local function gumdrop(position, size, color)
	Kit.ball("Gumdrop", size, CFrame.new(position), color, Enum.Material.SmoothPlastic)
	Kit.ball("GumdropShine", size * 0.22, CFrame.new(position + V(-size * 0.18, size * 0.36, -size * 0.12)), CREAM, Enum.Material.SmoothPlastic, true)
end

-- Tableta de chocolate de pie (cobertura) con onzas marcadas
local function chocolateBar(cf, length)
	Kit.block("ChocolateBar", V(length, 3.6, 1.8), cf * CFrame.new(0, 1.8, 0), CHOCOLATE, Enum.Material.SmoothPlastic)
	for x = -length / 2 + length / 4, length / 2 - 0.1, length / 4 do
		Kit.deco("ChocolateGroove", V(0.25, 3.62, 1.84), cf * CFrame.new(x, 1.8, 0), CHOCOLATE:Lerp(Color3.new(0, 0, 0), 0.25), Enum.Material.SmoothPlastic)
	end
	Kit.deco("ChocolateWrap", V(length * 0.4, 3.7, 1.9), cf * CFrame.new(length * 0.3, 1.8, 0), RGB(230, 60, 90), Enum.Material.SmoothPlastic)
end

-- Rosquilla de pie hecha con bolas en anillo (cobertura con hueco para asomarse)
local function donut(cf, color)
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2
		Kit.ball("Donut", 2.6, cf * CFrame.new(math.cos(a) * 2.8, 3.1 + math.sin(a) * 2.8, 0), color, Enum.Material.SmoothPlastic)
	end
end

-- Magdalena gigante (cobertura): cápsula de papel con rayas y bola de nata
local function cupcake(cf, color)
	Kit.cylinder("CupcakeBase", 3.4, 5.5, cf * CFrame.new(0, 1.7, 0), color, Enum.Material.SmoothPlastic)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		Kit.deco("CupcakeFold", V(0.4, 3.42, 0.6), cf * CFrame.new(math.cos(a) * 2.7, 1.7, math.sin(a) * 2.7) * CFrame.Angles(0, -a, 0), color:Lerp(Color3.new(1, 1, 1), 0.35), Enum.Material.SmoothPlastic)
	end
	Kit.ball("CupcakeCream", 5.6, cf * CFrame.new(0, 4, 0), RGB(255, 170, 210), Enum.Material.SmoothPlastic)
	Kit.ball("CupcakeCherry", 1.4, cf * CFrame.new(0, 7, 0), RGB(230, 30, 60), Enum.Material.SmoothPlastic, true)
end

-- Muro de barquillo (alto: corta las líneas de tiro largas)
local function waferWall(cf, length)
	Kit.block("Wafer", V(length, 8, 1.6), cf * CFrame.new(0, 4, 0), RGB(235, 180, 100), Enum.Material.SmoothPlastic)
	for y = 1.6, 7, 1.6 do
		Kit.deco("WaferLine", V(length + 0.05, 0.25, 1.65), cf * CFrame.new(0, y, 0), RGB(200, 140, 70), Enum.Material.SmoothPlastic)
	end
	Kit.deco("WaferCream", V(length + 0.1, 0.5, 1.7), cf * CFrame.new(0, 8.1, 0), RGB(255, 150, 200), Enum.Material.SmoothPlastic)
end

-- Pila de caramelos cuadrados de colores (cobertura alta para asomarse)
local function candyStack(cf)
	Kit.block("CandyBlock", V(4, 4, 4), cf * CFrame.new(0, 2, 0), GUMDROPS[1], Enum.Material.SmoothPlastic)
	Kit.block("CandyBlock", V(4, 4, 4), cf * CFrame.new(4.2, 2, 0.4) * CFrame.Angles(0, rad(12), 0), GUMDROPS[2], Enum.Material.SmoothPlastic)
	Kit.block("CandyBlock", V(4, 4, 4), cf * CFrame.new(1.8, 6, 0.2) * CFrame.Angles(0, rad(-8), 0), GUMDROPS[3], Enum.Material.SmoothPlastic)
end

-- Piruleta (palo + caramelo redondo); far = de fondo, más grande y sin colisión
local function lollipop(position, height, diameter, color, far)
	Kit.cylinder("LollipopStick", height, diameter * 0.08, CFrame.new(position + V(0, height / 2, 0)), CREAM, Enum.Material.SmoothPlastic, nil, far)
	-- Disco de cara a la arena (eje a lo largo de Z)
	local candy = Kit.cylinder("Lollipop", diameter * 0.18, diameter, CFrame.new(position + V(0, height + diameter * 0.4, 0)) * CFrame.Angles(rad(90), 0, 0), color, Enum.Material.SmoothPlastic, nil, true)
	Kit.cylinder("LollipopSwirl", diameter * 0.19, diameter * 0.55, candy.CFrame * CFrame.Angles(0, 0, -rad(90)), CREAM, Enum.Material.SmoothPlastic, nil, true)
end

-- Árbol de algodón de azúcar (de fondo)
local function cottonCandy(position, scale, color)
	Kit.cylinder("CottonStick", 8 * scale, 0.7 * scale, CFrame.new(position + V(0, 4 * scale, 0)), CREAM, Enum.Material.SmoothPlastic, nil, true)
	Kit.ball("CottonCandy", 9 * scale, CFrame.new(position + V(0, 10 * scale, 0)), color, Enum.Material.SmoothPlastic, true)
	Kit.ball("CottonCandy", 6 * scale, CFrame.new(position + V(2 * scale, 13.5 * scale, 1 * scale)), color:Lerp(Color3.new(1, 1, 1), 0.25), Enum.Material.SmoothPlastic, true)
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	Kit.applyLighting(Map.Lighting)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Suelo de galleta con círculo central rosa
	block("Floor", V(LENGTH + 40, 2, WIDTH + 40), CFrame.new(0, -1, 0), FLOOR, Enum.Material.SmoothPlastic)
	Kit.cylinder("Plaza", 0.2, 56, CFrame.new(0, 0.1, 0), RGB(255, 180, 205), Enum.Material.SmoothPlastic)
	Kit.cylinder("PlazaRing", 0.22, 58, CFrame.new(0, 0.09, 0), PINK, Enum.Material.SmoothPlastic, nil, true)

	-- Muro perimetral de menta con bastones de caramelo
	for _, z in { -1, 1 } do
		wall("OuterWall", CFrame.new(0, 0, z * (WIDTH / 2 + 1.5)), V(LENGTH + 6, 18, 3))
		for x = -75, 75, 30 do
			-- (sin pilar donde están las cornisas laterales)
			if not (math.abs(x) < 60 and math.sign(x) == z) then
				candyCane(CFrame.new(x, 0, z * (WIDTH / 2 - 0.5)), 19)
			end
		end
	end
	for _, x in { -1, 1 } do
		wall("OuterWall", CFrame.new(x * (LENGTH / 2 + 1.5), 0, 0), V(3, 18, WIDTH + 6))
		for _, z in { -40, 40 } do
			candyCane(CFrame.new(x * (LENGTH / 2 - 0.5), 0, z), 19)
		end
	end

	-- Tarta central de dos pisos (se sube por escaleras): piso 1 a 4 de altura, piso 2 a 8
	Kit.cylinder("CakeTier", 4, 28, CFrame.new(0, 2, 0), PINK, Enum.Material.SmoothPlastic)
	Kit.cylinder("CakeFrosting", 0.5, 28.8, CFrame.new(0, 4.05, 0), CREAM, Enum.Material.SmoothPlastic, nil, true)
	Kit.cylinder("CakeTier", 4, 14, CFrame.new(0, 6, 0), CHOCOLATE, Enum.Material.SmoothPlastic)
	Kit.cylinder("CakeFrosting", 0.5, 14.6, CFrame.new(0, 8.05, 0), CREAM, Enum.Material.SmoothPlastic, nil, true)
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		Kit.ball("FrostingDrip", 1.6, CFrame.new(math.cos(a) * 14.1, 3.6, math.sin(a) * 14.1), CREAM, Enum.Material.SmoothPlastic, true)
	end
	-- Vela con llama en el centro de la tarta (decorativa)
	Kit.cylinder("Candle", 3, 0.8, CFrame.new(0, 9.6, 0), RGB(120, 200, 255), Enum.Material.SmoothPlastic, nil, true)
	local flame = Kit.ball("CandleFlame", 0.9, CFrame.new(0, 11.4, 0), RGB(255, 200, 80), Enum.Material.Neon, true)
	Kit.light(flame, "PointLight", RGB(255, 190, 110), 14, 1.2)

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(255, 90, 110) or RGB(90, 160, 255)
		-- Escaleras de la tarta: al piso 1 desde el lado del equipo y al piso 2 de lado
		Kit.stairs((m * CFrame.new(-24, 0, 0)).Position, (m * CFrame.new(-13.6, 4, 0)).Position, 6, PINK:Lerp(Color3.new(1, 1, 1), 0.2), Enum.Material.SmoothPlastic)
		Kit.stairs((m * CFrame.new(0, 4, -13)).Position, (m * CFrame.new(0, 8, -6.8)).Position, 4, CHOCOLATE:Lerp(Color3.new(1, 1, 1), 0.15), Enum.Material.SmoothPlastic)

		-- Cornisa lateral (piso a 7) con escalera y barandilla
		local ledgeY = 7
		block("Ledge", V(34, 1, 7), m * CFrame.new(-28, ledgeY - 0.5, -(WIDTH / 2 - 3.5)), MINT_DARK, Enum.Material.SmoothPlastic)
		deco("LedgeTrim", V(34.4, 0.5, 0.4), m * CFrame.new(-28, ledgeY - 0.75, -(WIDTH / 2 - 7.2)), PINK, Enum.Material.SmoothPlastic)
		for _, x in { -42, -14 } do
			Kit.cylinder("LedgeLeg", ledgeY - 1, 1.6, m * CFrame.new(x, (ledgeY - 1) / 2, -(WIDTH / 2 - 6)), CREAM, Enum.Material.SmoothPlastic)
		end
		Kit.stairs((m * CFrame.new(-60, 0, -(WIDTH / 2 - 3.5))).Position, (m * CFrame.new(-45, ledgeY, -(WIDTH / 2 - 3.5))).Position, 5, MINT_DARK, Enum.Material.SmoothPlastic)
		Kit.railing((m * CFrame.new(-44, ledgeY, -(WIDTH / 2 - 7))).Position, (m * CFrame.new(-12, ledgeY, -(WIDTH / 2 - 7))).Position, 2.4, PINK)

		-- Coberturas: tabletas de chocolate, gominolas y rosquillas
		chocolateBar(m * CFrame.new(-38, 0, 14), 10)
		chocolateBar(m * CFrame.new(-30, 0, -24) * CFrame.Angles(0, rad(90), 0), 8)
		chocolateBar(m * CFrame.new(-56, 0, 34), 9)
		gumdrop((m * CFrame.new(-46, 0, -10)).Position, 7, GUMDROPS[1])
		gumdrop((m * CFrame.new(-20, 0, 30)).Position, 6, GUMDROPS[2])
		gumdrop((m * CFrame.new(-64, 0, -44)).Position, 6.5, GUMDROPS[3])
		gumdrop((m * CFrame.new(-10, 0, -40)).Position, 5.5, GUMDROPS[4])
		gumdrop((m * CFrame.new(-70, 0, 42)).Position, 6, GUMDROPS[5])
		donut(m * CFrame.new(-50, 0, 22) * CFrame.Angles(0, rad(90), 0), side == "A" and RGB(255, 150, 190) or RGB(150, 200, 255))
		donut(m * CFrame.new(-24, 0, 44), RGB(255, 200, 120))
		cupcake(m * CFrame.new(-12, 0, 22), GUMDROPS[5])
		cupcake(m * CFrame.new(-42, 0, -42), GUMDROPS[2])
		waferWall(m * CFrame.new(-6, 0, 34), 14)
		waferWall(m * CFrame.new(-54, 0, -16) * CFrame.Angles(0, rad(90), 0), 10)
		candyStack(m * CFrame.new(-36, 0, -6) * CFrame.Angles(0, rad(20), 0))
		candyStack(m * CFrame.new(-52, 0, 46))
		-- Plataformas de salto: a la tarta y a la cornisa
		Kit.jumpPad((m * CFrame.new(-17, 0, -8)).Position, 75)
		Kit.jumpPad((m * CFrame.new(-28, 0, -40)).Position, 75, RGB(255, 120, 200))

		-- Piruletas medianas (solo decoración, se atraviesan) y caramelos en el suelo
		lollipop((m * CFrame.new(-80, 0, -46)).Position, 7, 5, teamColor, true)
		lollipop((m * CFrame.new(-36, 0, 48)).Position, 6, 4.5, GUMDROPS[3], true)
		for i, p in { V(-28, 0.3, 6), V(-60, 0.3, -6), V(-44, 0.3, 40), V(-14, 0.3, -18) } do
			Kit.ball("Sprinkle", 0.7, m * CFrame.new(p), GUMDROPS[i % #GUMDROPS + 1], Enum.Material.SmoothPlastic, true)
		end
	end)

	-- Bases y banderas
	local spawnStyle = { Floor = RGB(255, 225, 235), Roof = MINT_DARK }
	Kit.spawnArea(teams[1], CFrame.new(-75, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-75, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-52, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-52, 0, 0))

	-- Fondo: piruletas gigantes, árboles de algodón de azúcar y colinas
	Kit.bounds(LENGTH, WIDTH, 45)
	local farColors = { RGB(255, 120, 180), RGB(120, 200, 255), RGB(255, 210, 90), RGB(170, 120, 255), RGB(120, 230, 160) }
	local n = 0
	for x = -130, 130, 26 do
		for _, z in { -1, 1 } do
			n += 1
			local color = farColors[n % #farColors + 1]
			if n % 3 == 0 then
				lollipop(V(x + z * 7, 0, z * (WIDTH / 2 + 22 + (n % 4) * 6)), 24 + (n % 3) * 6, 14, color, true)
			else
				cottonCandy(V(x + z * 7, 0, z * (WIDTH / 2 + 16 + (n % 5) * 5)), 1.2 + (n % 3) * 0.2, color)
			end
		end
	end
	for _, sx in { -1, 1 } do
		for z = -60, 60, 40 do
			cottonCandy(V(sx * (LENGTH / 2 + 20 + (math.abs(z) % 3) * 6), 0, z), 1.4, farColors[(z // 40) % #farColors + 1])
		end
	end
	for x = -180, 180, 70 do
		for _, z in { -1, 1 } do
			Kit.naturalHill(V(x, -18, z * 125), 46, Enum.Material.Grass, { Inward = V(0, 0, -z), Top = Enum.Material.LeafyGrass, RockCount = 0 })
		end
	end
	for _, sx in { -1, 1 } do
		for _, z in { -50, 20 } do
			Kit.naturalHill(V(sx * 150, -18, z), 48, Enum.Material.Grass, { Inward = V(-sx, 0, 0), Top = Enum.Material.LeafyGrass, RockCount = 0 })
		end
	end

	-- Modos
	for _, p in {
		V(-66, 0.5, 14), V(-66, 0.5, -14), V(-44, 0.5, 0), V(-34, 0.5, 34), V(-36, 0.5, -36),
		V(-20, 0.5, 16), V(-16, 0.5, -26), V(-28, 7.5, -51.5), V(-6, 4.5, -9), V(-70, 0.5, -46),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, 8.3, 0), 6, 1)
	Kit.zone(V(-34, 0, 30), 6, 2)
	Kit.zone(V(34, 0, -30), 6, 3)
	Kit.zone(V(-28, 7, -51.5), 5, 4)
	Kit.zone(V(28, 7, 51.5), 5, 5)
	Kit.dustMotes(CFrame.new(0, 8, 0), V(100, 14, 70), Color3.fromRGB(255, 200, 235), 14)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">ContainerClash</string>
              <string name="Source"><![CDATA[-- CONTAINER CLASH: patio de contenedores al atardecer. Calle central con pila central,
-- pasillos laterales entre contenedores, pasarelas elevadas y almacenes como zonas de salida.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)

local Map = {
	Id = "ContainerClash",
	Name = "Container Clash",
	Icon = "📦",
	Description = "Puerto · atardecer · pasillos y pasarelas",
}

Map.Lighting = {
	CartoonNeutral = { Hue = 0.07, Sat = 0.18 }, -- tono de los grises en estilo Cartoon
	ClockTime = 17.6,
	Brightness = 2.6,
	Exposure = 0,
	Ambient = Color3.fromRGB(70, 55, 55),
	OutdoorAmbient = Color3.fromRGB(150, 110, 95),
	Atmosphere = { Density = 0.35, Offset = 0.15, Color = Color3.fromRGB(255, 190, 140), Decay = Color3.fromRGB(170, 90, 85), Glare = 0.9, Haze = 2 },
	Color = { Saturation = 0.15, Contrast = 0.18, Brightness = 0, Tint = Color3.fromRGB(255, 232, 212) },
	Bloom = { Intensity = 0.6, Size = 26, Threshold = 1.8 },
	Clouds = 0.5,
	CloudColor = Color3.fromRGB(255, 200, 170),
	SunRays = 0.12,
	SunSize = 30, -- sol grande de atardecer
	Water = { Color = Color3.fromRGB(25, 70, 105), Reflectance = 1, Transparency = 0.3, WaveSize = 0.2, WaveSpeed = 9 },
}

local V = Vector3.new
local RGB = Color3.fromRGB
local C = Kit.C

local COLORS = { RGB(210, 60, 45), RGB(45, 110, 210), RGB(240, 150, 30), RGB(60, 160, 90), RGB(130, 135, 145), RGB(230, 230, 235) }

-- Contenedor ligero (pocas piezas) para muros y fondos
local function lite(cf, color, decorative)
	local fn = decorative and Kit.deco or Kit.block
	fn("Container", V(20, 8.5, 8), cf * CFrame.new(0, 4.25, 0), color, Enum.Material.CorrodedMetal)
	local dark = color:Lerp(Color3.new(0, 0, 0), 0.35)
	-- Los decorativos (fondo y fila de arriba) sin nervios: casi no se ven y ahorran piezas
	for i = -1, decorative and -2 or 1 do
		Kit.deco("Rib", V(0.5, 8.3, 8.2), cf * CFrame.new(i * 7, 4.25, 0), dark, Enum.Material.Metal).CastShadow = false
	end
	Kit.deco("Roof", V(20.2, 0.3, 8.2), cf * CFrame.new(0, 8.6, 0), dark, Enum.Material.Metal).CastShadow = false
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	Kit.applyLighting(Map.Lighting)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Suelo con marcas amarillas
	-- Asfalto de puerto con marcas amarillas gastadas
	block("Yard", V(340, 2, 240), CFrame.new(0, -1, 0), RGB(78, 78, 82), Enum.Material.Asphalt)
	for _, z in { -30, 30, -90, 90 } do
		deco("LaneLine", V(260, 0.05, 0.8), CFrame.new(0, 0.03, z), RGB(214, 178, 52), Enum.Material.Asphalt)
	end
	for x = -120, 120, 40 do
		deco("CrossLine", V(0.8, 0.05, 240), CFrame.new(x, 0.03, 0), RGB(200, 190, 120), Enum.Material.SmoothPlastic)
	end
	for i = 1, 14 do
		local x, z = ((i * 53) % 260) - 130, ((i * 71) % 200) - 100
		deco("Stain", V(6 + i % 4, 0.04, 4 + i % 3), CFrame.new(x, 0.025, z) * CFrame.Angles(0, i, 0), RGB(90, 88, 85), Enum.Material.Concrete).Transparency = 0.5
	end

	-- Pila central (dos contenedores a lo largo de Z y uno encima)
	Kit.container(CFrame.new(0, 0, -11) * CFrame.Angles(0, math.rad(90), 0), COLORS[5], "CENTER")
	Kit.container(CFrame.new(0, 0, 11) * CFrame.Angles(0, math.rad(90), 0), COLORS[5], "CENTER")
	Kit.container(CFrame.new(0, 8.9, 0) * CFrame.Angles(0, math.rad(90), 0), C.Yellow, "STACK 01")

	-- Grúa pórtico sobre el centro con un contenedor colgando
	local gantry = RGB(245, 185, 35)
	for _, x in { -22, 22 } do
		for _, z in { -38, 38 } do
			block("GantryLeg", V(2.5, 40, 2.5), CFrame.new(x, 20, z), gantry, Enum.Material.Metal)
		end
		block("GantryBeam", V(2.5, 3, 78), CFrame.new(x, 40, 0), gantry, Enum.Material.Metal)
	end
	block("GantryCross", V(46, 3, 3), CFrame.new(0, 41, -8), gantry, Enum.Material.Metal)
	deco("GantryCable", V(0.3, 9, 0.3), CFrame.new(0, 35, -8), RGB(30, 30, 30), Enum.Material.Metal)
	lite(CFrame.new(0, 22, -8) * CFrame.Angles(0, math.rad(90), 0), RGB(210, 70, 50), true)
	Kit.ball("GantryBeacon", 1, CFrame.new(0, 43, -8), RGB(255, 60, 40), Enum.Material.Neon, true):SetAttribute("Blink", 1)

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(210, 50, 45) or RGB(45, 110, 220)

		-- Pasillo lateral: dos filas de contenedores con huecos
		for i, x in { -104, -80, -50, -20 } do
			local c1 = COLORS[(i % #COLORS) + 1]
			local c2 = COLORS[((i + 2) % #COLORS) + 1]
			if i ~= 3 then
				Kit.container(m * CFrame.new(x, 0, -48), c1)
			end
			Kit.container(m * CFrame.new(x + 4, 0, -76), c2)
			if i % 2 == 0 then
				Kit.container(m * CFrame.new(x + 4, 8.9, -76), COLORS[((i + 4) % #COLORS) + 1])
			end
		end
		-- Rampa de cajas para subir a la fila alta del pasillo
		Kit.ramp(m * V(-100, 0, -55), m * V(-100, 8.6, -71.5), 5, RGB(150, 120, 80), Enum.Material.WoodPlanks)

		-- Contenedores y cobertura de la zona media
		Kit.container(m * CFrame.new(-55, 0, 25), COLORS[2])
		Kit.container(m * CFrame.new(-55, 0, 33.4), COLORS[1])
		Kit.container(m * CFrame.new(-30, 0, 55) * CFrame.Angles(0, math.rad(90), 0), COLORS[4])
		Kit.container(m * CFrame.new(-95, 0, 18) * CFrame.Angles(0, math.rad(90), 0), COLORS[3])
		Kit.metalCrate(m * CFrame.new(-25, 0, 22), 4)
		Kit.metalCrate(m * CFrame.new(-21, 0, 22), 4)
		Kit.metalCrate(m * CFrame.new(-23, 4, 22), 3.5)
		Kit.crate(m * CFrame.new(-70, 0, -10), 5)
		Kit.crate(m * CFrame.new(-40, 0, -15))
		Kit.crate(m * CFrame.new(-40, 0, -19.5), 3)
		Kit.crate(m * CFrame.new(-120, 0, 40))
		Kit.barrel(m * CFrame.new(-45, 0, 0), RGB(40, 90, 180))
		Kit.barrel(m * CFrame.new(-43, 0, 2.3), RGB(40, 90, 180))
		Kit.barrel(m * CFrame.new(-100, 0, -30), RGB(200, 60, 40))
		Kit.barrel(m * CFrame.new(-35, 0, 80), RGB(60, 160, 90))
		for _, p in { V(-60, 0, 0), V(-62, 0, 4), V(-15, 0, 40), V(-80, 0, 45) } do
			Kit.cone(m * CFrame.new(p))
		end
		Kit.forklift(m * CFrame.new(-75, 0, 60) * CFrame.Angles(0, math.rad(30), 0))

		-- Pasarela elevada delante del almacén con escaleras
		local walkY = 10
		block("Catwalk", V(8, 1, 100), m * CFrame.new(-118, walkY - 0.5, 0), RGB(80, 82, 92), Enum.Material.DiamondPlate)
		for z = -48, 48, 16 do
			block("CatwalkLeg", V(1, walkY - 1, 1), m * CFrame.new(-115, (walkY - 1) / 2, z), C.Metal, Enum.Material.Metal)
		end
		Kit.railing(m * V(-114.2, walkY, -50), m * V(-114.2, walkY, 50), 3, C.Yellow)
		Kit.stairs(m * V(-118, 0, 72), m * V(-118, walkY, 52), 6, RGB(120, 122, 130))
		Kit.stairs(m * V(-118, 0, -72), m * V(-118, walkY, -52), 6, RGB(120, 122, 130))

		-- Almacén de salida: paredes, número grande y estandartes
		local wallColor = RGB(120, 118, 115)
		block("WarehouseWall", V(32, 22, 2), m * CFrame.new(-145, 11, 37), wallColor, Enum.Material.CorrodedMetal)
		block("WarehouseWall", V(32, 22, 2), m * CFrame.new(-145, 11, -37), wallColor, Enum.Material.CorrodedMetal)
		block("WarehouseRoof", V(34, 1.5, 76), m * CFrame.new(-145, 22.5, 0), RGB(90, 88, 86), Enum.Material.CorrodedMetal)
		local front = block("WarehouseFront", V(2, 6, 76), m * CFrame.new(-129.5, 19.5, 0), wallColor, Enum.Material.CorrodedMetal)
		Kit.sign(front, Enum.NormalId.Right, side == "A" and "02" or "03", RGB(240, 240, 240), RGB(30, 30, 30))
		for _, z in { -30, 30 } do
			Kit.banner(m * CFrame.new(-128.2, 17, z) * CFrame.Angles(0, math.rad(-90), 0), 5, 9, teamColor, C.White)
		end
		for _, z in { -20, 20 } do
			local lamp = deco("WarehouseLamp", V(1.4, 0.6, 3), m * CFrame.new(-128.5, 15.6, z), RGB(255, 220, 160), Enum.Material.Neon)
			Kit.lightCone((m * CFrame.new(-128.5, 15.2, z)).Position, 14, 1, 6, RGB(255, 215, 160))
			Kit.light(lamp, "SpotLight", RGB(255, 210, 150), 30, 2, Enum.NormalId.Bottom).Angle = 110
		end
	end)

	-- Spawns y banderas
	local spawnStyle = { Floor = RGB(110, 108, 106), FloorMaterial = Enum.Material.Concrete, Roof = RGB(90, 88, 86), RoofMaterial = Enum.Material.CorrodedMetal }
	Kit.spawnArea(teams[1], CFrame.new(-145, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-145, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-102, 0, -2))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-102, 0, -2))

	-- Muro perimetral de contenedores (2 alturas) y límites
	Kit.bounds(320, 220, 60)
	for x = -150, 150, 21 do
		for _, z in { -114, 114 } do
			lite(CFrame.new(x, 0, z), COLORS[(math.abs(x) // 21 + (z > 0 and 1 or 0)) % #COLORS + 1])
			lite(CFrame.new(x, 8.9, z), COLORS[(math.abs(x) // 21 + 3) % #COLORS + 1], true)
		end
	end

	-- Fondo: grúas, barcos, más contenedores y el mar al atardecer
	workspace.Terrain:FillBlock(CFrame.new(0, -12, 330), V(1000, 20, 400), Enum.Material.Water)
	block("Quay", V(600, 4, 30), CFrame.new(0, -2, 135), RGB(120, 118, 115), Enum.Material.Concrete)
	for i, x in { -180, -100, -20, 60, 140, 220 } do
		Kit.crane(CFrame.new(x, 0, 140) * CFrame.Angles(0, math.rad(180), 0), 50 + (i % 3) * 6, i % 2 == 0 and RGB(220, 70, 50) or RGB(245, 185, 35))
	end
	Kit.ship(CFrame.new(-60, -2, 190), 140)
	Kit.ship(CFrame.new(160, -2, 260) * CFrame.Angles(0, math.rad(-12), 0), 110)
	for x = -220, 220, 21 do
		for row = 0, 2 do
			lite(CFrame.new(x, row * 8.6, -140 - (x % 3) * 9), COLORS[(math.abs(x) // 21 + row) % #COLORS + 1], true)
		end
	end
	for z = -100, 100, 25 do
		for _, sx in { -1, 1 } do
			lite(CFrame.new(sx * 175, 0, z) * CFrame.Angles(0, math.rad(90), 0), COLORS[(math.abs(z) // 25) % #COLORS + 1], true)
			lite(CFrame.new(sx * 175, 8.6, z) * CFrame.Angles(0, math.rad(90), 0), COLORS[(math.abs(z) // 25 + 2) % #COLORS + 1], true)
		end
	end

	-- Modos
	for _, p in {
		V(-130, 0.5, 50), V(-100, 0.5, -36), V(-70, 0.5, 10), V(-40, 0.5, 40), V(-35, 0.5, -60),
		V(-118, 10.5, 30), V(-118, 10.5, -30), V(-90, 0.5, 90), V(-15, 0.5, -30), V(-60, 0.5, -90),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, 0, 30), 10, 1)
	Kit.zone(V(-60, 0, -62), 10, 2)
	Kit.zone(V(60, 0, 62), 10, 3)
	Kit.zone(V(0, 0, -30), 10, 4)
	Kit.zone(V(-75, 0, 10), 10, 5)
	-- Realismo: charcos que reflejan el atardecer, vapor y polvo dorado en el carril central
	for _, p in { Vector3.new(-66, 0, 14), Vector3.new(-35, 0, 45), Vector3.new(-10, 0, -26), Vector3.new(-95, 0, -41), Vector3.new(-55, 0, -95) } do
		Kit.puddle(p, 5)
		Kit.puddle(Kit.MIRROR * p, 5)
	end
	for _, p in { Vector3.new(-30, 0, -64), Vector3.new(-86, 0, 86) } do
		Kit.steamVent(CFrame.new(p), 1)
		Kit.steamVent(Kit.MIRROR * CFrame.new(p), 1)
	end
	Kit.dustMotes(CFrame.new(0, 7, 0), Vector3.new(220, 12, 40), Color3.fromRGB(255, 215, 160), 30)
	-- Realismo: suelo de puerto usado (alcantarillas, desagües, grietas, aceite y rodadas de la carretilla)
	Kit.symmetric(function(m)
		for _, p in { V(-50, 0, -10), V(-85, 0, 70), V(-12, 0, 10) } do
			Kit.manhole(m * p)
		end
		for _, p in { V(-30, 0, -88), V(-70, 0, 92) } do
			Kit.drain(m * CFrame.new(p))
		end
		for i, spec in { { V(-80, 0, -5), 8 }, { V(-25, 0, -45), 10 }, { V(-110, 0, 70), 9 }, { V(-60, 0, 82), 7 } } do
			Kit.crack(m * spec[1], spec[2], i * 17)
		end
		for _, p in { V(-73, 0, 56), V(-41, 0, 4), V(-98, 0, -27) } do
			Kit.oilStain(m * p, 3)
		end
		Kit.tireMarks(m * CFrame.new(-70, 0, 68) * CFrame.Angles(0, math.rad(30), 0), 22, 0.6)
	end)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">Downtown</string>
              <string name="Source"><![CDATA[-- Mapa "Downtown": ciudad simétrica con calles, tiendas, contenedores y plaza central (de día).
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)

local Map = {
	Id = "Downtown",
	Name = "Downtown",
	Icon = "🏙",
	Description = "Ciudad · día · calles y azoteas",
}

local LENGTH = 320 -- eje X (de spawn a spawn)
local WIDTH = 220 -- eje Z
local WALL_HEIGHT = 34

local mapFolder

-- Paleta del mapa (colores pastel y vivos, estilo cartoon)
local C = {
	Asphalt = Color3.fromRGB(70, 74, 86),
	Sidewalk = Color3.fromRGB(214, 214, 222),
	Curb = Color3.fromRGB(240, 240, 245),
	LineWhite = Color3.fromRGB(245, 245, 250),
	LineYellow = Color3.fromRGB(255, 205, 50),
	WallBlue = Color3.fromRGB(150, 98, 78), -- ladrillo (el nombre se mantiene por compatibilidad)
	WallTrim = Color3.fromRGB(240, 244, 250),
	Window = Color3.fromRGB(70, 96, 118), -- cristal oscuro que refleja
	Metal = Color3.fromRGB(60, 62, 70),
	Ramp = Color3.fromRGB(150, 152, 165),
	Pink = Color3.fromRGB(255, 80, 170),
	Cyan = Color3.fromRGB(0, 220, 255),
	Leaf = Color3.fromRGB(90, 190, 90),
	LeafDark = Color3.fromRGB(60, 150, 70),
	Wood = Color3.fromRGB(176, 124, 70),
	WoodDark = Color3.fromRGB(120, 80, 45),
}

local function block(name, size, cf, color, material, parent)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = Kit.realisticMaterial(size, color, material)
	if part.Material == Enum.Material.Glass then
		part.Reflectance = 0.15
	end
	Kit.applyStyle(part)
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent or mapFolder
	return part
end

-- Pieza decorativa: no choca, no bloquea disparos y no hace sombra
local function deco(name, size, cf, color, material, parent)
	local part = block(name, size, cf, color, material, parent)
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = size.X * size.Y * size.Z >= 20 and part.Material ~= Enum.Material.Neon and part.Material ~= Enum.Material.Glass
	return part
end

-- Cilindro de pie (en Roblox el eje del cilindro es X, lo giramos para que sea vertical)
local function cylinder(name, height, diameter, cf, color, material, parent, decorative)
	local fn = decorative and deco or block
	local part = fn(
		name,
		Vector3.new(height, diameter, diameter),
		cf * CFrame.Angles(0, 0, math.pi / 2),
		color,
		material,
		parent
	)
	part.Shape = Enum.PartType.Cylinder
	return part
end

-- Texto pegado a una cara de una pieza (carteles, rótulos de neón...)
local function sign(part, face, text, color, strokeColor)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeColor3 = strokeColor or Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0
	label.Parent = gui
	return gui
end

-- Rampa inclinada desde "bottom" hasta "top" (posiciones de la superficie)
local function ramp(bottom, top, width, color)
	local mid = (bottom + top) / 2
	local length = (top - bottom).Magnitude
	local cf = CFrame.lookAt(mid, top) * CFrame.new(0, -0.5, 0)
	local part = block("Ramp", Vector3.new(width, 1, length + 1), cf, color, Enum.Material.DiamondPlate)
	-- Franjas amarillas de los bordes
	for _, side in { -1, 1 } do
		deco(
			"RampEdge",
			Vector3.new(0.4, 0.1, length + 1),
			cf * CFrame.new(side * (width / 2 - 0.3), 0.52, 0),
			C.LineYellow,
			Enum.Material.SmoothPlastic
		)
	end
	return part
end

-- Rotación de 180° alrededor del centro: la mitad del equipo Azul es espejo de la del Rojo
local MIRROR = CFrame.Angles(0, math.pi, 0)

local function symmetric(fn)
	fn(CFrame.new(), "A")
	fn(MIRROR, "B")
end

---------------------------------------------------------------------------
-- Piezas del mapa
---------------------------------------------------------------------------

local CARGO_NAMES = { "HYPER CARGO", "NEXO LINE", "FROST CO.", "TURBO SHIP" }
local cargoIndex = 0

local function container(cf, color)
	local model = Instance.new("Model")
	model.Name = "Container"
	model.Parent = mapFolder
	local size = Vector3.new(20, 8.5, 8)
	local body = block("Body", size, cf * CFrame.new(0, size.Y / 2, 0), color, Enum.Material.CorrodedMetal, model)
	Kit.contactShadow(cf, size.X, size.Z, false, model)
	local dark = color:Lerp(Color3.new(0, 0, 0), 0.35)
	for i = -4, 4, 2 do
		deco("Rib", Vector3.new(0.4, 8.2, 8.3), cf * CFrame.new(i * 2.2, 4.25, 0), dark, Enum.Material.Metal, model)
	end
	block("Roof", Vector3.new(20.2, 0.3, 8.2), cf * CFrame.new(0, 8.6, 0), dark, Enum.Material.Metal, model)
	-- Marco y puertas en un extremo
	deco("DoorFrame", Vector3.new(0.3, 8.6, 8.4), cf * CFrame.new(10.1, 4.25, 0), dark, Enum.Material.Metal, model)
	for _, z in { -2, 2 } do
		deco("LockBar", Vector3.new(0.3, 7.6, 0.25), cf * CFrame.new(10.3, 4.25, z), Color3.fromRGB(200, 200, 205), Enum.Material.Metal, model)
	end
	deco("DoorSplit", Vector3.new(0.35, 8, 0.15), cf * CFrame.new(10.3, 4.25, 0), Color3.fromRGB(30, 30, 30), Enum.Material.Metal, model)
	-- Desgaste: chorretones de óxido bajando desde el techo
	local rust = color:Lerp(Color3.fromRGB(105, 58, 34), 0.6)
	for i, x in { -7.7, 3.3, 5.5 } do
		local side = i % 2 == 0 and 1 or -1
		local length = 2 + ((cargoIndex + i) % 3) * 1.4
		deco("RustStreak", Vector3.new(0.9, length, 0.06), cf * CFrame.new(x, 8.45 - length / 2, side * 4.04), rust, Enum.Material.CorrodedMetal, model)
	end
	-- Rótulo de la naviera en los dos lados largos
	cargoIndex = cargoIndex % #CARGO_NAMES + 1
	local text = CARGO_NAMES[cargoIndex]
	sign(body, Enum.NormalId.Front, text, Color3.new(1, 1, 1), dark)
	sign(body, Enum.NormalId.Back, text, Color3.new(1, 1, 1), dark)
	return model
end

local function crate(cf, size)
	size = size or 4
	local core = block(
		"Crate",
		Vector3.new(size, size, size),
		cf * CFrame.new(0, size / 2, 0),
		C.Wood,
		Enum.Material.WoodPlanks
	)
	Kit.contactShadow(cf, size, size)
	-- Bandas de refuerzo
	for _, y in { 0.12, 0.88 } do
		deco(
			"CrateBand",
			Vector3.new(size + 0.15, size * 0.12, size + 0.15),
			cf * CFrame.new(0, size * y, 0),
			C.WoodDark,
			Enum.Material.Wood
		)
	end
	return core
end

-- Barrera tipo "jersey" de hormigón con franjas rojas y blancas
local function barrier(size, cf)
	local part = block("Barrier", size, cf * CFrame.new(0, size.Y / 2, 0), Color3.fromRGB(225, 225, 230), Enum.Material.Concrete)
	Kit.contactShadow(cf, size.X, size.Z)
	local long = size.X >= size.Z
	local length = long and size.X or size.Z
	local count = math.max(2, math.floor(length / 3))
	for i = 0, count - 1 do
		local offset = -length / 2 + (i + 0.5) * (length / count)
		local color = i % 2 == 0 and Color3.fromRGB(230, 50, 50) or Color3.fromRGB(250, 250, 250)
		local stripeSize = long and Vector3.new(length / count, 1, size.Z + 0.1) or Vector3.new(size.X + 0.1, 1, length / count)
		local pos = long and CFrame.new(offset, size.Y - 1.2, 0) or CFrame.new(0, size.Y - 1.2, offset)
		deco("Stripe", stripeSize, cf * pos, color, Enum.Material.SmoothPlastic)
	end
	return part
end

local function streetLamp(cf)
	local model = Instance.new("Model")
	model.Name = "StreetLamp"
	model.Parent = mapFolder
	cylinder("Pole", 14, 0.6, cf * CFrame.new(0, 7, 0), C.Metal, Enum.Material.Metal, model)
	cylinder("Base", 1, 1.2, cf * CFrame.new(0, 0.5, 0), C.Metal, Enum.Material.Metal, model)
	deco("Arm", Vector3.new(0.4, 0.4, 4), cf * CFrame.new(0, 13.8, -1.8), C.Metal, Enum.Material.Metal, model)
	local head = deco("Lamp", Vector3.new(1.6, 0.5, 2.2), cf * CFrame.new(0, 13.4, -3.6), C.Metal, Enum.Material.Metal, model)
	local bulb = deco("Bulb", Vector3.new(1.2, 0.2, 1.8), cf * CFrame.new(0, 13.1, -3.6), Color3.fromRGB(255, 240, 200), Enum.Material.Neon, model)
	local light = Instance.new("SpotLight")
	light.Face = Enum.NormalId.Bottom
	light.Range = 26
	light.Angle = 100
	light.Brightness = 1.5
	light.Color = Color3.fromRGB(255, 235, 200)
	light.Shadows = true
	light:SetAttribute("QualityShadow", true)
	light.Parent = bulb
	return head
end

local function tree(cf)
	local model = Instance.new("Model")
	model.Name = "Tree"
	model.Parent = mapFolder
	block("Planter", Vector3.new(5, 1.6, 5), cf * CFrame.new(0, 0.8, 0), Color3.fromRGB(200, 200, 208), Enum.Material.Concrete, model)
	deco("Soil", Vector3.new(4.4, 0.2, 4.4), cf * CFrame.new(0, 1.65, 0), Color3.fromRGB(90, 60, 40), Enum.Material.Ground, model)
	cylinder("Trunk", 7, 0.9, cf * CFrame.new(0, 5, 0), Color3.fromRGB(110, 75, 45), Enum.Material.Wood, model)
	for i, spec in {
		{ Vector3.new(0, 9.5, 0), 6.5, C.Leaf },
		{ Vector3.new(1.6, 8.4, 1), 4.5, C.LeafDark },
		{ Vector3.new(-1.5, 8.8, -1.2), 4.8, C.Leaf },
		{ Vector3.new(0.3, 11.6, -0.4), 4, C.LeafDark },
	} do
		local leaf = deco("Leaves" .. i, Vector3.new(spec[2], spec[2], spec[2]), cf * CFrame.new(spec[1]), spec[3], Enum.Material.Grass, model)
		leaf.Shape = Enum.PartType.Ball
		leaf.CastShadow = true
	end
end

local function bollard(cf)
	cylinder("Bollard", 2.4, 0.8, cf * CFrame.new(0, 1.2, 0), C.LineYellow, Enum.Material.SmoothPlastic)
	cylinder("BollardBand", 0.4, 0.85, cf * CFrame.new(0, 1.9, 0), Color3.fromRGB(30, 30, 30), Enum.Material.SmoothPlastic, nil, true)
end

local SHOP_SIGNS = {
	{ "ARCADE", Color3.fromRGB(255, 80, 200) },
	{ "PIZZA", Color3.fromRGB(255, 170, 30) },
	{ "GYM", Color3.fromRGB(0, 220, 255) },
	{ "TACOS", Color3.fromRGB(120, 255, 90) },
}
local signIndex = 0

local brickToggle = false

local function building(cf, size, color)
	local model = Instance.new("Model")
	model.Name = "Building"
	model.Parent = mapFolder
	local trim = color:Lerp(Color3.new(0, 0, 0), 0.15)
	-- La mitad de los edificios son de ladrillo visto (más realista que todo hormigón)
	brickToggle = not brickToggle
	local wallMaterial = brickToggle and Enum.Material.Brick or Enum.Material.Concrete
	block("Block", size, cf * CFrame.new(0, size.Y / 2, 0), color, wallMaterial, model)
	-- Zócalo y cornisa
	deco("Base", Vector3.new(size.X + 0.4, 1.2, size.Z + 0.4), cf * CFrame.new(0, 0.6, 0), trim, Enum.Material.Concrete, model)
	deco("Cornice", Vector3.new(size.X + 0.6, 0.8, size.Z + 0.6), cf * CFrame.new(0, size.Y - 0.4, 0), C.WallTrim, Enum.Material.Concrete, model)
	deco("Stripe", Vector3.new(size.X + 0.3, 0.6, size.Z + 0.3), cf * CFrame.new(0, size.Y - 1.6, 0), C.WallTrim:Lerp(Color3.new(0, 0, 0), 0.2), Enum.Material.Concrete, model)

	-- Ventanas en las cuatro fachadas: una fila por planta, con marco y alféizar
	local floors = math.max(1, math.floor((size.Y - 3) / 7))
	local function windowsOnFace(axis, sign_, count, span, skip)
		for row = 1, floors do
			local y = 4.2 + (row - 1) * 7
			for i = 1, count do
				if i == skip and row == 1 then
					continue
				end
				local t = (i - 0.5) / count - 0.5
				local pos, glassSize, frameSize, sillSize, sillOffset
				if axis == "Z" then
					pos = CFrame.new(t * span, y, sign_ * (size.Z / 2 + 0.1))
					glassSize = Vector3.new(2.6, 3.6, 0.2)
					frameSize = Vector3.new(3.2, 4.2, 0.15)
					sillSize = Vector3.new(3.6, 0.3, 0.6)
					sillOffset = CFrame.new(0, -2.2, sign_ * 0.25)
				else
					pos = CFrame.new(sign_ * (size.X / 2 + 0.1), y, t * span)
					glassSize = Vector3.new(0.2, 3.6, 2.6)
					frameSize = Vector3.new(0.15, 4.2, 3.2)
					sillSize = Vector3.new(0.6, 0.3, 3.6)
					sillOffset = CFrame.new(sign_ * 0.25, -2.2, 0)
				end
				deco("WindowFrame", frameSize, cf * pos, C.WallTrim, Enum.Material.Concrete, model)
				deco("WindowSill", sillSize, cf * pos * sillOffset, C.WallTrim, Enum.Material.Concrete, model)
				local glass = deco("Window", glassSize, cf * pos, C.Window, Enum.Material.Glass, model)
				glass.Transparency = 0 -- opaco: delante de la pared no se nota y no cuesta ordenar transparencias
				glass.Reflectance = 0.25
			end
		end
	end
	windowsOnFace("Z", -1, 4, size.X - 6, 1) -- sin la primera: ahí va la puerta
	windowsOnFace("Z", 1, 4, size.X - 6)
	windowsOnFace("X", -1, 3, size.Z - 6)
	windowsOnFace("X", 1, 3, size.Z - 6)

	-- Puerta y toldo en la fachada que mira al centro del mapa (-Z)
	local front = -size.Z / 2
	local doorX = -0.375 * (size.X - 6)
	deco("Door", Vector3.new(4, 6.5, 0.3), cf * CFrame.new(doorX, 3.25, front - 0.1), Color3.fromRGB(50, 55, 70), Enum.Material.SmoothPlastic, model)
	signIndex = signIndex % #SHOP_SIGNS + 1
	local shop = SHOP_SIGNS[signIndex]
	for i = 0, 4 do
		deco(
			"Awning",
			Vector3.new(1.2, 0.3, 3),
			cf * CFrame.new(doorX - 2.4 + i * 1.2, 7.6, front - 1.5) * CFrame.Angles(math.rad(-15), 0, 0),
			i % 2 == 0 and shop[2] or Color3.new(1, 1, 1),
			Enum.Material.Fabric,
			model
		)
	end
	-- Rótulo de neón
	local signPart = deco("ShopSign", Vector3.new(10, 2.6, 0.4), cf * CFrame.new(size.X / 5, size.Y - 2.5, front - 0.3), Color3.fromRGB(25, 25, 35), Enum.Material.SmoothPlastic, model)
	sign(signPart, Enum.NormalId.Front, shop[1], shop[2], Color3.fromRGB(255, 255, 255))
	local glow = Instance.new("SurfaceLight")
	glow.Face = Enum.NormalId.Front
	glow.Color = shop[2]
	glow.Range = 10
	glow.Brightness = 1.5
	glow.Parent = signPart

	-- Murito de cobertura en la azotea (sólido)
	local h = 3
	local top = size.Y
	block("Rail", Vector3.new(size.X, h, 1), cf * CFrame.new(0, top + h / 2, -size.Z / 2 + 0.5), color, Enum.Material.Concrete, model)
	block("Rail", Vector3.new(size.X, h, 1), cf * CFrame.new(0, top + h / 2, size.Z / 2 - 0.5), color, Enum.Material.Concrete, model)

	-- Aires acondicionados y antena en la azotea
	for _, x in { -size.X / 4, -size.X / 4 + 4.5 } do
		block("ACUnit", Vector3.new(3.5, 2.4, 3), cf * CFrame.new(x, top + 1.2, 4), Color3.fromRGB(200, 205, 210), Enum.Material.Metal, model)
		local fan = cylinder("Fan", 0.2, 2.2, cf * CFrame.new(x, top + 2.45, 4), Color3.fromRGB(70, 70, 75), Enum.Material.Metal, model, true)
		fan:SetAttribute("Spin", 360)
	end
	cylinder("Antenna", 7, 0.25, cf * CFrame.new(size.X / 2 - 3, top + 3.5, size.Z / 2 - 3), C.Metal, Enum.Material.Metal, model, true)
	local beacon = deco("Beacon", Vector3.new(0.6, 0.6, 0.6), cf * CFrame.new(size.X / 2 - 3, top + 7.2, size.Z / 2 - 3), Color3.fromRGB(255, 40, 40), Enum.Material.Neon, model)
	beacon.Shape = Enum.PartType.Ball
	return model
end

local function spawnArea(team, cf)
	local teamColor = team.Color.Color
	local light = teamColor:Lerp(Color3.new(1, 1, 1), 0.55)
	local floor = block("SpawnFloor", Vector3.new(30, 0.4, 70), cf * CFrame.new(0, 0.2, 0), light, Enum.Material.SmoothPlastic)
	floor.Name = team.Name .. "SpawnFloor"
	-- Rejilla del suelo
	for z = -30, 30, 10 do
		deco("FloorLine", Vector3.new(30, 0.05, 0.3), cf * CFrame.new(0, 0.42, z), teamColor, Enum.Material.SmoothPlastic)
	end

	local roof = block("Roof", Vector3.new(30, 1, 70), cf * CFrame.new(0, 16, 0), Color3.fromRGB(235, 235, 240), Enum.Material.Concrete)
	deco("RoofTrim", Vector3.new(0.6, 0.5, 70.2), cf * CFrame.new(15, 15.4, 0), teamColor, Enum.Material.Neon)
	-- Cartel del equipo encima de la entrada
	local banner = block("TeamBanner", Vector3.new(0.6, 4, 28), cf * CFrame.new(15.2, 18.6, 0), teamColor, Enum.Material.SmoothPlastic)
	sign(banner, Enum.NormalId.Right, "EQUIPO " .. string.upper(team.Name), Color3.new(1, 1, 1))
	sign(banner, Enum.NormalId.Left, "EQUIPO " .. string.upper(team.Name), Color3.new(1, 1, 1))
	roof.Name = team.Name .. "SpawnRoof"

	for _, z in { -34, 34 } do
		block("Pillar", Vector3.new(2, 16, 2), cf * CFrame.new(14, 8, z), Color3.fromRGB(235, 235, 240), Enum.Material.Concrete)
		deco("PillarStripe", Vector3.new(2.1, 1, 2.1), cf * CFrame.new(14, 12, z), teamColor, Enum.Material.Neon)
	end
	for _, z in { -24, 0, 24 } do
		block("Cover", Vector3.new(2, 4, 10), cf * CFrame.new(14, 2, z), teamColor, Enum.Material.SmoothPlastic)
		deco("CoverTop", Vector3.new(2.1, 0.3, 10.1), cf * CFrame.new(14, 4.05, z), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
	end

	for i, z in { -24, -8, 8, 24 } do
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = team.Name .. "Spawn" .. i
		spawn.Anchored = true
		spawn.Size = Vector3.new(6, 1, 6)
		spawn.CFrame = cf * CFrame.new(-4, 0.5, z) * CFrame.Angles(0, -math.pi / 2, 0)
		spawn.TeamColor = team.Color
		spawn.BrickColor = team.Color
		spawn.Material = Enum.Material.Neon
		spawn.Neutral = false
		spawn.AllowTeamChangeOnTouch = false
		spawn.Duration = GameConfig.SpawnProtection
		spawn.Parent = mapFolder
		local decal = spawn:FindFirstChildOfClass("Decal")
		if decal then
			decal:Destroy()
		end
	end

	-- Luz de equipo bajo el techo
	local lamp = deco("SpawnLight", Vector3.new(20, 0.2, 60), cf * CFrame.new(0, 15.4, 0), teamColor:Lerp(Color3.new(1, 1, 1), 0.7), Enum.Material.Neon)
	local surfaceLight = Instance.new("SurfaceLight")
	surfaceLight.Face = Enum.NormalId.Bottom
	surfaceLight.Range = 16
	surfaceLight.Brightness = 0.8
	surfaceLight.Color = teamColor:Lerp(Color3.new(1, 1, 1), 0.5)
	surfaceLight.Parent = lamp
end

-- Base de la bandera: el módulo Flags busca piezas "FlagBase" con el atributo Team.
-- En un mapa propio basta con poner una pieza llamada FlagBase con Team = "Rojo" / "Azul".
local function flagBase(team, cf)
	local teamColor = team.Color.Color
	local ring = deco("FlagBaseRing", Vector3.new(0.3, 13, 13), cf * CFrame.new(0, 0.15, 0) * CFrame.Angles(0, 0, math.pi / 2), teamColor, Enum.Material.Neon)
	ring.Shape = Enum.PartType.Cylinder
	local pad = block("FlagBase", Vector3.new(0.4, 11, 11), cf * CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(235, 235, 240), Enum.Material.Concrete)
	pad.Shape = Enum.PartType.Cylinder
	pad:SetAttribute("Team", team.Name)
	local inner = deco("FlagBaseInner", Vector3.new(0.45, 4, 4), cf * CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.pi / 2), teamColor, Enum.Material.Neon)
	inner.Shape = Enum.PartType.Cylinder
	-- Pilones luminosos alrededor
	for i = 0, 3 do
		local angle = i * math.pi / 2 + math.pi / 4
		local offset = CFrame.new(math.cos(angle) * 7.5, 0, math.sin(angle) * 7.5)
		cylinder("Pylon", 2, 0.7, cf * offset * CFrame.new(0, 1, 0), Color3.fromRGB(230, 230, 235), Enum.Material.SmoothPlastic, nil, true)
		local top = deco("PylonLight", Vector3.new(0.8, 0.8, 0.8), cf * offset * CFrame.new(0, 2.3, 0), teamColor, Enum.Material.Neon)
		top.Shape = Enum.PartType.Ball
	end
	local glow = Instance.new("PointLight")
	glow.Color = teamColor
	glow.Range = 16
	glow.Brightness = 1.5
	glow.Parent = inner
	return pad
end

-- Fachada con ventanas sobre la cara interior de un muro exterior.
-- `inward` = signo (+1/-1) de la dirección hacia el centro del mapa.
local function facade(center, length, alongX, inward)
	local rows = { 13, 22 }
	for _, y in rows do
		for t = -length / 2 + 8, length / 2 - 8, 12 do
			local pos = alongX and Vector3.new(t, y, center.Z + inward * 0.3) or Vector3.new(center.X + inward * 0.3, y, t)
			local frameSize = alongX and Vector3.new(5, 5, 0.3) or Vector3.new(0.3, 5, 5)
			local glassSize = alongX and Vector3.new(4.2, 4.2, 0.35) or Vector3.new(0.35, 4.2, 4.2)
			deco("FacadeFrame", frameSize, CFrame.new(pos), C.WallTrim, Enum.Material.Concrete)
			local glass = deco("FacadeWindow", glassSize, CFrame.new(pos), C.Window, Enum.Material.Glass)
			glass.Transparency = 0
			glass.Reflectance = 0.25
		end
	end
	-- Cornisa y franja inferior
	local trimSize = alongX and Vector3.new(length, 1.2, 1.2) or Vector3.new(1.2, 1.2, length)
	deco("WallCornice", trimSize, CFrame.new(center + Vector3.new(0, WALL_HEIGHT / 2 + 0.3, 0)), C.WallTrim, Enum.Material.Concrete)
	local baseSize = alongX and Vector3.new(length, 3, 0.6) or Vector3.new(0.6, 3, length)
	local basePos = alongX and Vector3.new(center.X, 1.5, center.Z + inward * 0.3) or Vector3.new(center.X + inward * 0.3, 1.5, center.Z)
	deco("WallBase", baseSize, CFrame.new(basePos), Color3.fromRGB(110, 108, 104), Enum.Material.Concrete)
end

---------------------------------------------------------------------------

Map.Lighting = {
	CartoonNeutral = { Hue = 0.6, Sat = 0.17 }, -- tono de los grises en estilo Cartoon
	ClockTime = 16.4,
	Brightness = 3,
	Exposure = 0,
	Ambient = Color3.fromRGB(60, 62, 72),
	OutdoorAmbient = Color3.fromRGB(125, 128, 140),
	Atmosphere = { Density = 0.3, Offset = 0.2, Color = Color3.fromRGB(200, 215, 235), Decay = Color3.fromRGB(110, 130, 160), Glare = 0.4, Haze = 1.6 },
	Color = { Saturation = 0.1, Contrast = 0.16, Brightness = 0, Tint = Color3.fromRGB(255, 246, 235) },
	Bloom = { Intensity = 0.7, Size = 24, Threshold = 1.6 },
	SunRays = 0.08,
}

function Map.Build()
	mapFolder = Kit.Begin(Map.Name)
	Kit.applyLighting(Map.Lighting)

	-- Suelo: asfalto, aceras y plaza central
	block("Floor", Vector3.new(LENGTH + 40, 2, WIDTH + 40), CFrame.new(0, -1, 0), C.Asphalt, Enum.Material.Asphalt)
	for _, side in { -1, 1 } do
		block("Sidewalk", Vector3.new(LENGTH, 0.4, 16), CFrame.new(0, 0.2, side * (WIDTH / 2 - 8)), C.Sidewalk, Enum.Material.Pavement)
		deco("Curb", Vector3.new(LENGTH, 0.45, 0.8), CFrame.new(0, 0.22, side * (WIDTH / 2 - 16.4)), C.Curb, Enum.Material.Concrete)
		-- Línea discontinua del carril
		for x = -125, 125, 10 do
			deco("LaneDash", Vector3.new(5, 0.05, 0.6), CFrame.new(x, 0.03, side * 50), C.LineWhite, Enum.Material.SmoothPlastic)
		end
		-- Pasos de cebra
		for _, x in { -40, 40 } do
			for i = 0, 6 do
				deco("Zebra", Vector3.new(8, 0.05, 1.4), CFrame.new(x, 0.035, side * (40 + i * 3)), C.LineWhite, Enum.Material.SmoothPlastic)
			end
		end
		-- Línea amarilla de borde
		deco("EdgeLine", Vector3.new(LENGTH - 60, 0.05, 0.5), CFrame.new(0, 0.03, side * (WIDTH / 2 - 19)), C.LineYellow, Enum.Material.SmoothPlastic)
	end
	-- Plaza central con baldosas de colores
	local tileColors = { Color3.fromRGB(235, 230, 220), Color3.fromRGB(255, 190, 200) }
	for ix = -5, 4 do
		for iz = -5, 4 do
			deco(
				"PlazaTile",
				Vector3.new(5.9, 0.06, 5.9),
				CFrame.new(ix * 6 + 3, 0.03, iz * 6 + 3),
				tileColors[(ix + iz) % 2 + 1],
				Enum.Material.Pavement
			)
		end
	end

	-- Muros exteriores con fachadas
	block("Wall", Vector3.new(LENGTH, WALL_HEIGHT, 4), CFrame.new(0, WALL_HEIGHT / 2, WIDTH / 2 + 2), C.WallBlue, Enum.Material.Brick)
	block("Wall", Vector3.new(LENGTH, WALL_HEIGHT, 4), CFrame.new(0, WALL_HEIGHT / 2, -WIDTH / 2 - 2), C.WallBlue, Enum.Material.Brick)
	block("Wall", Vector3.new(4, WALL_HEIGHT, WIDTH), CFrame.new(LENGTH / 2 + 2, WALL_HEIGHT / 2, 0), C.WallBlue, Enum.Material.Brick)
	block("Wall", Vector3.new(4, WALL_HEIGHT, WIDTH), CFrame.new(-LENGTH / 2 - 2, WALL_HEIGHT / 2, 0), C.WallBlue, Enum.Material.Brick)
	facade(Vector3.new(0, WALL_HEIGHT / 2, WIDTH / 2), LENGTH, true, -1)
	facade(Vector3.new(0, WALL_HEIGHT / 2, -WIDTH / 2), LENGTH, true, 1)
	facade(Vector3.new(LENGTH / 2, WALL_HEIGHT / 2, 0), WIDTH, false, -1)
	facade(Vector3.new(-LENGTH / 2, WALL_HEIGHT / 2, 0), WIDTH, false, 1)

	-- Techo invisible para que nadie salga del mapa
	local ceiling = block("Ceiling", Vector3.new(LENGTH, 1, WIDTH), CFrame.new(0, WALL_HEIGHT + 12, 0), Color3.new(1, 1, 1))
	ceiling.Transparency = 1
	ceiling.CastShadow = false
	-- Los disparos ignoran la carpeta Boundary
	local boundary = Instance.new("Folder")
	boundary.Name = "Boundary"
	boundary.Parent = ceiling.Parent
	ceiling.Parent = boundary

	-- Carteles gigantes con el nombre del juego sobre los muros largos
	for _, side in { -1, 1 } do
		local board = deco(
			"Billboard",
			Vector3.new(70, 14, 1),
			CFrame.new(0, WALL_HEIGHT + 9, side * (WIDTH / 2 + 3)) * (side > 0 and CFrame.new() or MIRROR),
			Color3.fromRGB(20, 20, 35),
			Enum.Material.SmoothPlastic
		)
		sign(board, Enum.NormalId.Front, GameConfig.GameTitle, Color3.fromRGB(255, 200, 40), Color3.fromRGB(120, 20, 80))
		deco("BillboardFrame", Vector3.new(72, 1, 1.2), board.CFrame * CFrame.new(0, 7.4, 0), C.Pink, Enum.Material.Neon)
		deco("BillboardFrame", Vector3.new(72, 1, 1.2), board.CFrame * CFrame.new(0, -7.4, 0), C.Pink, Enum.Material.Neon)
		for _, x in { -25, 25 } do
			deco("BillboardLeg", Vector3.new(1, 10, 1), board.CFrame * CFrame.new(x, -12, 0.5), C.Metal, Enum.Material.Metal)
		end
	end

	-- Spawns y banderas
	local teams = GameConfig.Teams
	spawnArea(teams[1], CFrame.new(-LENGTH / 2 + 15, 0, 0))
	spawnArea(teams[2], MIRROR * CFrame.new(-LENGTH / 2 + 15, 0, 0))
	flagBase(teams[1], CFrame.new(-118, 0, 12))
	flagBase(teams[2], MIRROR * CFrame.new(-118, 0, 12))

	-- Mitad simétrica del mapa
	symmetric(function(m)
		-- Contenedores
		container(m * CFrame.new(-95, 0, -62), Color3.fromRGB(220, 60, 50))
		container(m * CFrame.new(-95, 0, -62 + 8.4), Color3.fromRGB(40, 120, 220))
		container(m * CFrame.new(-95, 8.9, -58), Color3.fromRGB(240, 150, 30))
		container(m * CFrame.new(-60, 0, 10) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(60, 170, 90))
		container(m * CFrame.new(-35, 0, -85), Color3.fromRGB(240, 150, 30))
		container(m * CFrame.new(-120, 0, 75), Color3.fromRGB(40, 120, 220))

		-- Edificio con azotea accesible por rampa
		building(m * CFrame.new(-75, 0, 68), Vector3.new(26, 12, 22), Color3.fromRGB(245, 245, 250))
		ramp((m * CFrame.new(-38, 0, 74)).Position, (m * CFrame.new(-62, 12, 74)).Position, 7, C.Ramp)

		-- Pasarela elevada sobre los contenedores, con barandillas
		local catwalk = block("Catwalk", Vector3.new(30, 1, 6), m * CFrame.new(-95, 17.9, -45), Color3.fromRGB(90, 90, 100), Enum.Material.DiamondPlate)
		for _, z in { -2.8, 2.8 } do
			deco("Handrail", Vector3.new(30, 0.25, 0.25), catwalk.CFrame * CFrame.new(0, 3, z), C.LineYellow, Enum.Material.Metal)
			for x = -14, 14, 4 do
				deco("RailPost", Vector3.new(0.25, 2.5, 0.25), catwalk.CFrame * CFrame.new(x, 1.75, z), C.Metal, Enum.Material.Metal)
			end
		end
		for _, x in { -82, -108 } do
			block("CatwalkLeg", Vector3.new(1, 17.4, 1), m * CFrame.new(x, 8.7, -42.6), C.Metal, Enum.Material.Metal)
		end
		ramp((m * CFrame.new(-120, 0, -5)).Position, (m * CFrame.new(-110, 17.4, -45)).Position, 6, C.Ramp)

		-- Cajas de cobertura
		crate(m * CFrame.new(-110, 0, 20))
		crate(m * CFrame.new(-110, 0, 25))
		crate(m * CFrame.new(-110, 4, 22.5))
		crate(m * CFrame.new(-45, 0, 45), 5)
		crate(m * CFrame.new(-80, 0, -20))
		crate(m * CFrame.new(-25, 0, -40), 5)
		crate(m * CFrame.new(-25, 0, -35))

		-- Barreras de cobertura
		barrier(Vector3.new(2, 4.5, 16), m * CFrame.new(-40, 0, -15))
		barrier(Vector3.new(14, 4.5, 2), m * CFrame.new(-18, 0, 40))

		-- Rampa a la plataforma central
		ramp((m * CFrame.new(-34, 0, 0)).Position, (m * CFrame.new(-12, 7, 0)).Position, 8, C.Ramp)

		-- Farolas y árboles en las dos aceras (la otra mitad sale del espejo)
		for _, x in { -130, -90, -50, -10 } do
			streetLamp(m * CFrame.new(x, 0.4, -(WIDTH / 2 - 4)) * MIRROR) -- brazo hacia el centro
			streetLamp(m * CFrame.new(x, 0.4, WIDTH / 2 - 4))
		end
		for _, x in { -110, -70, -30 } do
			tree(m * CFrame.new(x, 0.4, -(WIDTH / 2 - 7)))
			tree(m * CFrame.new(x, 0.4, WIDTH / 2 - 7))
		end

		-- Bolardos en las esquinas de la plaza
		for _, z in { -28, 28 } do
			bollard(m * CFrame.new(-30, 0, z))
			bollard(m * CFrame.new(-26, 0, z))
		end
	end)

	-- Plataforma central
	local platform = block("CenterPlatform", Vector3.new(24, 1, 24), CFrame.new(0, 6.5, 0), Color3.fromRGB(80, 80, 95), Enum.Material.DiamondPlate)
	for _, x in { -10, 10 } do
		for _, z in { -10, 10 } do
			block("Pillar", Vector3.new(2, 6, 2), CFrame.new(x, 3, z), Color3.fromRGB(60, 60, 70), Enum.Material.Metal)
		end
	end
	-- Bordes de neón
	for _, z in { -12, 12 } do
		deco("PlatformEdge", Vector3.new(24.2, 0.3, 0.3), platform.CFrame * CFrame.new(0, -0.45, z), C.Pink, Enum.Material.Neon)
	end
	for _, x in { -12, 12 } do
		deco("PlatformEdge", Vector3.new(0.3, 0.3, 24.2), platform.CFrame * CFrame.new(x, -0.45, 0), C.Pink, Enum.Material.Neon)
	end
	block("CenterCover", Vector3.new(2, 4, 10), CFrame.new(0, 9, 7), C.Pink, Enum.Material.SmoothPlastic)
	block("CenterCover", Vector3.new(2, 4, 10), CFrame.new(0, 9, -7), C.Pink, Enum.Material.SmoothPlastic)
	-- Holograma giratorio sobre el centro (gira en el cliente)
	local holo = deco("Hologram", Vector3.new(0.3, 9, 9), CFrame.new(0, 22, 0) * CFrame.Angles(0, 0, math.pi / 2) * CFrame.Angles(math.rad(70), 0, 0), C.Cyan, Enum.Material.ForceField)
	holo.Shape = Enum.PartType.Cylinder
	holo:SetAttribute("Spin", 45)
	local holoCore = deco("HologramCore", Vector3.new(2.5, 2.5, 2.5), CFrame.new(0, 22, 0), C.Pink, Enum.Material.Neon)
	holoCore.Shape = Enum.PartType.Ball
	holoCore:SetAttribute("Bob", 1.2)
	local holoLight = Instance.new("PointLight")
	holoLight.Color = C.Pink
	holoLight.Range = 20
	holoLight.Brightness = 2
	holoLight.Parent = holoCore

	-- Rascacielos de fondo (decoración fuera de los muros)
	local rng = Random.new(42)
	local skyline = Instance.new("Folder")
	skyline.Name = "Skyline"
	skyline.Parent = mapFolder
	local palette = {
		Color3.fromRGB(120, 170, 230),
		Color3.fromRGB(90, 140, 210),
		Color3.fromRGB(200, 220, 245),
		Color3.fromRGB(70, 110, 180),
		Color3.fromRGB(240, 240, 250),
		Color3.fromRGB(255, 200, 210),
	}
	local neonTops = { C.Pink, C.Cyan, C.LineYellow, Color3.fromRGB(140, 255, 120) }

	-- near = fila cercana (con franjas); las lejanas van lisas: casi no se distinguen y ahorran cientos de piezas
	local function tower(position, w, d, h, near)
		local color = palette[rng:NextInteger(1, #palette)]
		local glassy = rng:NextNumber() < 0.6
		local body = deco("Tower", Vector3.new(w, h, d), CFrame.new(position + Vector3.new(0, h / 2, 0)), color, glassy and Enum.Material.Glass or Enum.Material.Concrete, skyline)
		body.Reflectance = glassy and 0.15 or 0
		-- Franjas horizontales (solo en la fila cercana, cada tres pisos, sin sombra)
		if near then
			for y = 12, h - 6, 24 do
				local stripe = deco("Floor", Vector3.new(w + 0.3, 0.8, d + 0.3), CFrame.new(position + Vector3.new(0, y, 0)), C.WallTrim, Enum.Material.SmoothPlastic, skyline)
				stripe.CastShadow = false
			end
		end
		-- Remate superior
		local capH = rng:NextNumber(2, 6)
		deco("Cap", Vector3.new(w * 0.7, capH, d * 0.7), CFrame.new(position + Vector3.new(0, h + capH / 2, 0)), C.WallTrim, Enum.Material.Concrete, skyline)
		if rng:NextNumber() < 0.5 then
			deco("NeonTop", Vector3.new(w + 0.6, 1, d + 0.6), CFrame.new(position + Vector3.new(0, h - 0.5, 0)), neonTops[rng:NextInteger(1, #neonTops)], Enum.Material.Neon, skyline)
		end
		if rng:NextNumber() < 0.4 then
			local antennaH = rng:NextNumber(8, 16)
			deco("Antenna", Vector3.new(0.6, antennaH, 0.6), CFrame.new(position + Vector3.new(0, h + capH + antennaH / 2, 0)), C.Metal, Enum.Material.Metal, skyline)
			local light = deco("AntennaLight", Vector3.new(1, 1, 1), CFrame.new(position + Vector3.new(0, h + capH + antennaH, 0)), Color3.fromRGB(255, 40, 40), Enum.Material.Neon, skyline)
			light.Shape = Enum.PartType.Ball
		end
	end

	for x = -230, 230, 38 do
		for _, side in { -1, 1 } do
			local w = rng:NextNumber(24, 34)
			tower(Vector3.new(x + rng:NextNumber(-6, 6), 0, side * (WIDTH / 2 + 42 + rng:NextNumber(0, 30))), w, w, rng:NextNumber(60, 160), true)
			-- Segunda fila más lejana y alta
			local w2 = rng:NextNumber(28, 40)
			tower(Vector3.new(x + 19, 0, side * (WIDTH / 2 + 110 + rng:NextNumber(0, 40))), w2, w2, rng:NextNumber(110, 240))
		end
	end
	for _, side in { -1, 1 } do
		for z = -140, 140, 40 do
			tower(Vector3.new(side * (LENGTH / 2 + 50), 0, z + rng:NextNumber(-5, 5)), 30, 30, rng:NextNumber(50, 130), true)
			tower(Vector3.new(side * (LENGTH / 2 + 120), 0, z + 20), 36, 36, rng:NextNumber(100, 220))
		end
	end

	-- Puntos para "Todos contra todos" y zonas de control
	for _, p in {
		Vector3.new(-120, 0.5, -80), Vector3.new(-60, 0.5, 40), Vector3.new(-20, 0.5, -60), Vector3.new(-90, 0.5, 0),
		Vector3.new(-40, 0.5, 85), Vector3.new(0, 7.5, 0), Vector3.new(-130, 0.5, 40), Vector3.new(-75, 12.5, 68),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Vector3.new(-p.X, p.Y, -p.Z))
	end
	Kit.zone(Vector3.new(0, 7, 0), 12, 1)
	Kit.zone(Vector3.new(-75, 12.4, 68), 10, 2)
	Kit.zone(Vector3.new(75, 12.4, -68), 10, 3)
	Kit.zone(Vector3.new(-60, 0, -40), 12, 4)
	Kit.zone(Vector3.new(60, 0, 40), 12, 5)

	-- Realismo: charcos en el asfalto, alcantarillas con vapor y polvo en la plaza
	for _, p in { Vector3.new(-116, 0, -76), Vector3.new(-56, 0, 44), Vector3.new(-86, 0, 4), Vector3.new(-16, 0, -56), Vector3.new(-126, 0, 44) } do
		Kit.puddle(p, 4.5)
		Kit.puddle(Vector3.new(-p.X, p.Y, -p.Z), 4.5)
	end
	for _, p in { Vector3.new(-110, 0.05, -30), Vector3.new(-50, 0.05, 70) } do
		Kit.steamVent(CFrame.new(p), 0.8)
		Kit.steamVent(CFrame.new(-p.X, p.Y, -p.Z), 0.8)
	end
	Kit.dustMotes(CFrame.new(0, 6, 0), Vector3.new(60, 10, 60), Color3.fromRGB(255, 240, 210), 14)

	-- Realismo: losas de acera, alcantarillas, desagües junto al bordillo, grietas, aceite y rodadas
	for _, side in { -1, 1 } do
		Kit.floorJoints(CFrame.new(0, 0.4, side * (WIDTH / 2 - 8)), LENGTH, 16, 6, Color3.fromRGB(118, 116, 112))
	end
	symmetric(function(m)
		for _, p in { Vector3.new(-100, 0, 46), Vector3.new(-20, 0, -48), Vector3.new(-128, 0, -10) } do
			Kit.manhole(m * p)
		end
		for _, p in { Vector3.new(-80, 0, 92.4), Vector3.new(-20, 0, -92.4), Vector3.new(-130, 0, 92.4) } do
			Kit.drain(m * CFrame.new(p))
		end
		for i, spec in { { Vector3.new(-70, 0, 30), 9 }, { Vector3.new(-130, 0, -55), 8 }, { Vector3.new(-30, 0, 58), 10 }, { Vector3.new(-90, 0, -20), 7 } } do
			Kit.crack(m * spec[1], spec[2], i * 23)
		end
		for _, p in { Vector3.new(-108, 0, 54), Vector3.new(-62, 0, -50), Vector3.new(-25, 0, 30) } do
			Kit.oilStain(m * p, 2.6)
		end
		Kit.tireMarks(m * CFrame.new(-58, 0, 52) * CFrame.Angles(0, math.rad(80), 0), 26, -0.5)
		-- Coches aparcados junto al bordillo (también sirven de cobertura)
		Kit.car(m * CFrame.new(-110, 0, 91), Color3.fromRGB(175, 30, 35))
		Kit.car(m * CFrame.new(-70, 0, 91) * CFrame.Angles(0, math.pi, 0), Color3.fromRGB(225, 225, 228))
		Kit.car(m * CFrame.new(-58, 0, -91), Color3.fromRGB(30, 60, 120))
	end)

	return mapFolder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">FrostStation</string>
              <string name="Source"><![CDATA[-- FROST STATION: base de investigación polar. Lago helado resbaladizo en el centro bajo la torre
-- del radar, hangares con techo naranja, laboratorios sobre pilotes, montículos de nieve como
-- cobertura, montañas nevadas de fondo y nieve cayendo.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)

local Map = {
	Id = "FrostStation",
	Name = "Frost Station",
	Icon = "❄",
	Description = "Polar · tarde · lago helado y nieve",
}

Map.Lighting = {
	CartoonNeutral = { Hue = 0.57, Sat = 0.16 }, -- tono de los grises en estilo Cartoon
	ClockTime = 15.6,
	Latitude = 70, -- sol bajo: sombras largas y azules sobre la nieve
	Brightness = 2.4,
	Exposure = 0.05,
	Ambient = Color3.fromRGB(75, 85, 105),
	OutdoorAmbient = Color3.fromRGB(130, 145, 170),
	Atmosphere = { Density = 0.4, Offset = 0.15, Color = Color3.fromRGB(210, 225, 245), Decay = Color3.fromRGB(140, 160, 205), Glare = 0.45, Haze = 2.2 },
	Color = { Saturation = 0.05, Contrast = 0.15, Brightness = 0.02, Tint = Color3.fromRGB(235, 243, 255) },
	Bloom = { Intensity = 0.5, Size = 24, Threshold = 2 },
	Clouds = 0.8,
	CloudColor = Color3.fromRGB(228, 234, 245),
	SunRays = 0.12,
	Wind = Vector3.new(8, 0, 3), -- viento polar: la nieve cae en diagonal y las nubes corren
	TerrainColors = {
		Snow = Color3.fromRGB(232, 238, 248),
		Glacier = Color3.fromRGB(150, 200, 235),
		Rock = Color3.fromRGB(95, 105, 120),
	},
}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad
local C = Kit.C

local SNOW = RGB(236, 242, 250)
local ICE = RGB(165, 215, 245)
local RED = RGB(215, 70, 50)
local ORANGE = RGB(255, 140, 40)
local WALL = RGB(196, 202, 212)
local DARK = RGB(60, 66, 78)

-- Pino nevado: tronco y siete pisos redondos de ramas, cada vez más estrechos y muy juntos para
-- que la silueta sea un cono; nieve sobre pisos alternos y verdes algo distintos
-- `far` = pino de fondo: cuatro pisos más altos en vez de siete (la silueta lejana es la misma)
local function pine(position, scale, far)
	scale = scale or 1
	local cylinder = Kit.cylinder
	cylinder("PineTrunk", 5 * scale, 1.1 * scale, CFrame.new(position + V(0, 2.5 * scale, 0)), RGB(88, 62, 44), Enum.Material.Wood)
	local tiers = far and 4 or 7
	local step = 6 / (tiers - 1)
	for i = 1, tiers do
		local d = (10 - (i - 1) * 8.1 / (tiers - 1)) * scale
		local y = (3 + (i - 1) * 1.65 * step) * scale
		local green = RGB(34, 74, 52):Lerp(RGB(50, 98, 66), (i % 2) * 0.6)
		local height = (1.65 * step + 0.55) * scale -- los pisos se solapan un poco, sin huecos
		local branches = cylinder("PineTier", height, d, CFrame.new(position + V(0, y, 0)), green, Enum.Material.LeafyGrass, nil, true)
		branches.CastShadow = not far
		if far or i % 2 == 1 then
			cylinder("PineSnow", 0.4 * scale, d * 0.78, CFrame.new(position + V(0, y + height / 2, 0)), SNOW, Enum.Material.Snow, nil, true)
		end
	end
	cylinder("PineTip", 1.8 * scale, 0.9 * scale, CFrame.new(position + V(0, 14.2 * scale, 0)), RGB(40, 84, 58), Enum.Material.LeafyGrass, nil, true)
end

-- Montículo de nieve (terreno) que sirve de cobertura
local function snowMound(position, radius)
	workspace.Terrain:FillBall(position, radius, Enum.Material.Snow)
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	Kit.applyLighting(Map.Lighting)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Suelo nevado con huellas de vehículos
	block("Floor", V(340, 2, 240), CFrame.new(0, -1, 0), SNOW, Enum.Material.Snow)
	for _, z in { -62, 62 } do
		for _, dz in { -2.5, 2.5 } do
			deco("Tracks", V(200, 0.05, 1.2), CFrame.new(0, 0.03, z + dz), RGB(205, 215, 230), Enum.Material.Snow)
		end
	end

	-- Lago helado en el centro: ¡resbala!
	local lake = Kit.cylinder("FrozenLake", 0.3, 54, CFrame.new(0, 0.15, 0), ICE, Enum.Material.Ice)
	lake.CustomPhysicalProperties = PhysicalProperties.new(0.9, 0.02, 0.05, 100, 1)
	lake.Reflectance = 0.22 -- hielo pulido: refleja el cielo
	Kit.cylinder("LakeRim", 0.2, 57, CFrame.new(0, 0.1, 0), RGB(215, 228, 242), Enum.Material.Glacier, nil, true)
	for i = 1, 6 do
		local angle = i * math.pi / 3
		deco("IceCrack", V(0.15, 0.05, 10 + i), CFrame.new(math.cos(angle) * 14, 0.31, math.sin(angle) * 14) * CFrame.Angles(0, angle + 0.6, 0), RGB(235, 248, 255), Enum.Material.Neon).Transparency = 0.5
	end

	-- Torre del radar: plataforma elevada con cúpula y antena giratoria
	block("TowerDeck", V(24, 1.2, 24), CFrame.new(0, 9, 0), DARK, Enum.Material.DiamondPlate)
	deco("TowerDeckEdge", V(24.4, 0.4, 24.4), CFrame.new(0, 8.3, 0), ORANGE, Enum.Material.Neon)
	for _, x in { -10, 10 } do
		for _, z in { -10, 10 } do
			block("TowerLeg", V(2, 8.4, 2), CFrame.new(x, 4.2, z), RGB(80, 86, 98), Enum.Material.Metal)
		end
	end
	local dome = Kit.ball("RadarDome", 8, CFrame.new(0, 13.4, 0), RGB(245, 247, 252), Enum.Material.SmoothPlastic)
	dome.CastShadow = true
	Kit.cylinder("DomeBase", 1.4, 9, CFrame.new(0, 10.3, 0), RGB(200, 205, 215), Enum.Material.Metal)
	Kit.cylinder("RadarMast", 5, 0.8, CFrame.new(0, 19.6, 0), RGB(90, 95, 105), Enum.Material.Metal, nil, true)
	local dish = deco("RadarDish", V(0.5, 7, 7), CFrame.new(0, 22.5, 0) * CFrame.Angles(0, 0, rad(-20)), RGB(235, 238, 245), Enum.Material.Metal)
	dish.Shape = Enum.PartType.Cylinder
	dish:SetAttribute("Spin", 45)
	local beacon = Kit.ball("RadarBeacon", 1, CFrame.new(0, 26.4, 0), RGB(255, 40, 40), Enum.Material.Neon, true)
	beacon:SetAttribute("Blink", 1.2)
	Kit.light(beacon, "PointLight", RGB(255, 60, 60), 18, 2)
	local deckLight = deco("TowerLight", V(18, 0.2, 18), CFrame.new(0, 8.35, 0), RGB(255, 230, 190), Enum.Material.Neon)
	Kit.light(deckLight, "SurfaceLight", RGB(255, 220, 170), 14, 1, Enum.NormalId.Bottom)

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(255, 60, 80) or RGB(60, 140, 255)

		-- Escaleras de la torre y barandillas (con hueco donde llegan)
		Kit.stairs(m * V(-31, 0, -6), m * V(-12.5, 9.6, -6), 6, RGB(120, 125, 138), Enum.Material.DiamondPlate)
		Kit.railing(m * V(-12, 9.6, 12), m * V(12, 9.6, 12), 3, ORANGE)
		Kit.railing(m * V(-12, 9.6, -12), m * V(-12, 9.6, -9.5), 3, ORANGE)
		Kit.railing(m * V(-12, 9.6, -2.5), m * V(-12, 9.6, 12), 3, ORANGE)

		-- Hangar: lo atraviesa el carril norte, con techo naranja
		local hz = -62
		block("HangarBack", V(44, 14, 2), m * CFrame.new(-70, 7, hz - 15), WALL, Enum.Material.CorrodedMetal)
		block("HangarFrontA", V(16, 14, 2), m * CFrame.new(-84, 7, hz + 15), WALL, Enum.Material.CorrodedMetal)
		block("HangarFrontB", V(16, 14, 2), m * CFrame.new(-56, 7, hz + 15), WALL, Enum.Material.CorrodedMetal)
		block("HangarLintel", V(12, 4, 2), m * CFrame.new(-70, 12, hz + 15), WALL, Enum.Material.CorrodedMetal)
		block("HangarRoof", V(46, 1.5, 34), m * CFrame.new(-70, 14.75, hz), RED, Enum.Material.Metal)
		deco("HangarRoofSnow", V(44, 0.4, 30), m * CFrame.new(-70, 15.7, hz), SNOW, Enum.Material.Snow)
		for _, x in { -91, -49 } do
			deco("HangarStripe", V(2.2, 1, 34.2), m * CFrame.new(x, 13.6, hz), C.Yellow, Enum.Material.SmoothPlastic)
		end
		Kit.neonSign(m * CFrame.new(-70, 12, hz + 16.4) * CFrame.Angles(0, math.pi, 0), 10, 3, side == "A" and "HANGAR A" or "HANGAR B", teamColor, C.White)
		for _, x in { -82, -70, -58 } do
			local lamp = deco("HangarLamp", V(3, 0.3, 3), m * CFrame.new(x, 13.8, hz), RGB(255, 235, 200), Enum.Material.Neon)
			Kit.lightCone((m * CFrame.new(x, 13.6, hz)).Position, 12, 1.4, 5.5, RGB(255, 230, 190))
			Kit.light(lamp, "SpotLight", RGB(255, 225, 180), 22, 1.6, Enum.NormalId.Bottom).Angle = 110
		end
		-- Moto de nieve (snowcat) y cajas dentro del hangar
		block("SnowcatBody", V(8, 3.5, 5), m * CFrame.new(-64, 2.6, hz - 5), ORANGE, Enum.Material.SmoothPlastic)
		local cab = block("SnowcatCab", V(4, 3, 4.6), m * CFrame.new(-65.5, 5.8, hz - 5), RGB(120, 170, 220), Enum.Material.Glass)
		cab.Transparency = 0.3
		for _, dz in { -2.8, 2.8 } do
			block("SnowcatTrack", V(9, 1.6, 1.3), m * CFrame.new(-64, 0.8, hz - 5 + dz), RGB(30, 30, 34), Enum.Material.Rubber)
		end
		Kit.metalCrate(m * CFrame.new(-84, 0, hz - 8), 5, RGB(90, 96, 110), teamColor)
		Kit.metalCrate(m * CFrame.new(-84, 0, hz - 2.8), 5, RGB(90, 96, 110), teamColor)
		Kit.metalCrate(m * CFrame.new(-84, 5, hz - 5.4), 4, RGB(90, 96, 110), ORANGE)
		Kit.metalCrate(m * CFrame.new(-54, 0, hz + 8), 4, RGB(90, 96, 110), C.Cyan)

		-- Laboratorio sobre pilotes con terraza (puesto de tirador)
		local lab = m * CFrame.new(-72, 0, 45)
		block("LabDeck", V(26, 1, 20), lab * CFrame.new(0, 8, 0), DARK, Enum.Material.DiamondPlate)
		for _, x in { -12, 12 } do
			for _, z in { -9, 9 } do
				block("LabPile", V(1.5, 7.5, 1.5), lab * CFrame.new(x, 3.75, z), RGB(80, 86, 98), Enum.Material.Metal)
			end
		end
		block("LabCabin", V(16, 8, 10), lab * CFrame.new(-2, 12.5, 0), RED, Enum.Material.SmoothPlastic)
		block("LabRoof", V(17, 0.8, 11), lab * CFrame.new(-2, 16.9, 0), SNOW, Enum.Material.Snow)
		for _, z in { -5.1, 5.1 } do
			for _, x in { -7, -2, 3 } do
				local win = deco("LabWindow", V(3, 2.2, 0.2), lab * CFrame.new(x, 13.5, z), RGB(255, 225, 150), Enum.Material.Neon)
				win.Transparency = 0.2
			end
		end
		deco("LabStripe", V(16.2, 0.6, 10.2), lab * CFrame.new(-2, 9.2, 0), C.White, Enum.Material.SmoothPlastic)
		Kit.stairs(m * V(-46, 0, 50), m * V(-59.5, 8.5, 50), 5, RGB(120, 125, 138), Enum.Material.DiamondPlate)
		Kit.railing(lab * V(-13, 8.5, -10), lab * V(13, 8.5, -10), 3, teamColor)
		Kit.railing(lab * V(-13, 8.5, 10), lab * V(13, 8.5, 10), 3, teamColor)
		Kit.railing(lab * V(-13, 8.5, -10), lab * V(-13, 8.5, 10), 3, teamColor)
		Kit.railing(lab * V(13, 8.5, -10), lab * V(13, 8.5, 2.5), 3, teamColor)
		local dishPole = Kit.cylinder("LabAntenna", 6, 0.5, lab * CFrame.new(4, 20, 0), RGB(150, 155, 165), Enum.Material.Metal, nil, true)
		local labBeacon = Kit.ball("LabBeacon", 0.7, lab * CFrame.new(4, 23.3, 0), teamColor, Enum.Material.Neon, true)
		labBeacon:SetAttribute("Blink", 0.9)
		dishPole.CastShadow = true

		-- Depósitos de combustible
		for _, z in { -60, -76 } do
			Kit.cylinder("FuelTank", 10, 7, m * CFrame.new(-120, 5, z), RGB(240, 242, 246), Enum.Material.Metal)
			Kit.cylinder("FuelBand", 1.2, 7.3, m * CFrame.new(-120, 7, z), RED, Enum.Material.SmoothPlastic, nil, true)
			Kit.cylinder("FuelCap", 0.8, 5, m * CFrame.new(-120, 10.4, z), SNOW, Enum.Material.Snow, nil, true)
		end
		Kit.pipeRun(m * V(-116, 2, -68), m * V(-93, 2, -68), 1.2, RGB(150, 155, 165))

		-- Contenedores de suministros y cobertura
		Kit.container(m * CFrame.new(-36, 0, 74), RED, "POLAR-1")
		Kit.container(m * CFrame.new(-98, 0, -28) * CFrame.Angles(0, rad(90), 0), RGB(45, 110, 200), "SUMINISTROS")
		Kit.barrier(V(2, 4, 14), m * CFrame.new(-24, 0, -30))
		Kit.barrier(V(14, 4, 2), m * CFrame.new(-50, 0, -30))
		Kit.barrier(V(2, 4, 12), m * CFrame.new(-34, 0, 18))
		Kit.metalCrate(m * CFrame.new(-60, 0, 2), 5, RGB(90, 96, 110), ORANGE)
		Kit.metalCrate(m * CFrame.new(-60, 0, 7.2), 5, RGB(90, 96, 110), ORANGE)
		Kit.metalCrate(m * CFrame.new(-92, 0, 62), 5, RGB(90, 96, 110), teamColor)

		-- Montículos de nieve (terreno)
		-- Montículos de unos 4,5 studs de alto: tapan a un jugador agachado o deslizándose
		snowMound(m * V(-42, -1.5, 26), 6)
		snowMound(m * V(-28, -2.5, -48), 7)
		snowMound(m * V(-108, -1.5, -2), 6)
		snowMound(m * V(-115, -1.5, 46), 5.5)
		snowMound(m * V(-20, -2.5, 82), 7)

		-- Coches aparcados cubiertos de nieve
		Kit.car(m * CFrame.new(-130, 0, -62) * CFrame.Angles(0, rad(8), 0), RGB(40, 70, 110), { Snow = true })
		Kit.car(m * CFrame.new(-80, 0, 88) * CFrame.Angles(0, rad(175), 0), RGB(150, 40, 35), { Snow = true })

		-- Rocas que asoman entre la nieve
		Kit.rockCluster(m * V(-150, 0, -70), 4, Enum.Material.Rock)
		Kit.rockCluster(m * V(-75, 0, 104), 4.5, Enum.Material.Slate)
		Kit.rockCluster(m * V(-135, 0, -104), 4, Enum.Material.Rock)
		Kit.rockCluster(m * V(-40, 0, -104), 5, Enum.Material.Slate)

		-- Antena de comunicaciones con baliza
		local mast = m * CFrame.new(-128, 0, 88)
		Kit.cylinder("CommsMast", 32, 1, mast * CFrame.new(0, 16, 0), RGB(200, 70, 55), Enum.Material.Metal)
		for i = 1, 4 do
			deco("CommsBar", V(5, 0.3, 0.3), mast * CFrame.new(0, i * 7, 0) * CFrame.Angles(0, rad(i * 45), 0), RGB(230, 230, 235), Enum.Material.Metal)
		end
		local top = Kit.ball("CommsBeacon", 1.2, mast * CFrame.new(0, 32.6, 0), RGB(255, 40, 40), Enum.Material.Neon, true)
		top:SetAttribute("Blink", 1.5)

		-- Farolas naranjas
		for _, p in { V(-92, 0, 22), V(-40, 0, -42), V(-24, 0, 44), V(-110, 0, -40) } do
			Kit.streetLamp(m * CFrame.new(p) * CFrame.Angles(0, rad(90), 0), RGB(255, 190, 110))
		end

		-- Pinos en los bordes
		for _, p in { V(-140, 0, 96), V(-100, 0, 100), V(-60, 0, 98), V(-150, 0, -96), V(-88, 0, -98), V(-18, 0, -100) } do
			pine(m * p, 1 + (math.abs(p.X) % 3) * 0.15)
		end
	end)

	-- Nieve cayendo sobre todo el mapa
	local sky = deco("Snowfall", V(330, 1, 230), CFrame.new(0, 56, 0), SNOW, Enum.Material.SmoothPlastic)
	sky.Transparency = 1
	sky.CastShadow = false
	local snow = Instance.new("ParticleEmitter")
	snow.Name = "Snow"
	snow.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	snow.Color = ColorSequence.new(Color3.new(1, 1, 1))
	snow.LightEmission = 0.3
	snow.Size = NumberSequence.new(0.22)
	snow.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.85, 0.2), NumberSequenceKeypoint.new(1, 1) })
	snow.Lifetime = NumberRange.new(7, 9)
	snow.Speed = NumberRange.new(6, 9)
	snow.SpreadAngle = Vector2.new(15, 15)
	snow.Acceleration = V(0.4, 0, 0.2)
	snow.WindAffectsDrag = true
	snow.RotSpeed = NumberRange.new(-60, 60)
	snow.Rate = 140
	snow.EmissionDirection = Enum.NormalId.Bottom
	snow.Parent = sky

	-- Spawns y banderas
	local spawnStyle = { Floor = RGB(205, 215, 230), FloorMaterial = Enum.Material.Concrete, Roof = RED, RoofMaterial = Enum.Material.Metal }
	Kit.spawnArea(teams[1], CFrame.new(-145, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-145, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-112, 0, 10))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-112, 0, 10))

	-- Límites y montañas nevadas de fondo
	Kit.bounds(320, 220, 60)
	for x = -240, 240, 60 do
		for _, z in { -1, 1 } do
			-- Laderas nevadas irregulares con roca a la vista y, detrás, picos de roca con nieve en la cima
			Kit.naturalHill(V(x + z * 15, -18, z * (175 + (math.abs(x) % 50))), 55 + (math.abs(x) % 4) * 8, Enum.Material.Snow, {
				Inward = V(0, 0, -z),
				RockCount = 4,
			})
			Kit.naturalHill(V(x + 25, -30, z * 230), 60, Enum.Material.Rock, {
				Inward = V(0, 0, -z),
				Rock = Enum.Material.Slate,
				Top = Enum.Material.Snow,
				TopCount = 4,
			})
		end
	end
	for z = -150, 150, 60 do
		for _, sx in { -1, 1 } do
			Kit.naturalHill(V(sx * 230, -20, z), 60, Enum.Material.Snow, { Inward = V(-sx, 0, 0), RockCount = 3 })
		end
	end
	-- Pinos fuera del mapa (bosque de fondo)
	for x = -150, 150, 22 do
		for _, z in { -1, 1 } do
			pine(V(x + (z * 7), 0, z * (122 + (math.abs(x) % 13))), 1.3, true)
		end
	end

	-- Modos
	for _, p in {
		V(-130, 0.5, 45), V(-100, 0.5, -10), V(-62.5, 8.6, 45), V(-70, 0.5, -62), V(-45, 0.5, 8),
		V(-20, 0.5, -60), V(-110, 0.5, 80), V(-60, 0.5, -15), V(-12, 0.5, 52), V(-125, 0.5, -90),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, 9.6, 0), 10, 1)
	Kit.zone(V(-70, 0, -62), 9, 2)
	Kit.zone(V(70, 0, 62), 9, 3)
	Kit.zone(V(-45, 0, 0), 9, 4)
	Kit.zone(V(45, 0, 0), 9, 5)
	-- Realismo: carámbanos en los tejados y ventisca rasante (nieve que arrastra el viento por el suelo)
	local function icicles(a, b, top, count, seed)
		local rng = Random.new(seed)
		for i = 0, count do
			local p = a:Lerp(b, i / count) + Vector3.new(rng:NextNumber(-0.3, 0.3), 0, rng:NextNumber(-0.2, 0.2))
			local length = rng:NextNumber(0.8, 2.6)
			Kit.deco("Icicle", Vector3.new(0.35, length, 0.35), CFrame.new(p.X, top - length / 2, p.Z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), Color3.fromRGB(205, 235, 255), Enum.Material.Ice)
			Kit.deco("IcicleTip", Vector3.new(0.18, length * 0.5, 0.18), CFrame.new(p.X, top - length - length * 0.2, p.Z), Color3.fromRGB(220, 242, 255), Enum.Material.Ice)
		end
	end
	Kit.symmetric(function(m, side)
		local seed = side == "A" and 11 or 29
		-- Borde del tejado del hangar (mirando al centro) y del laboratorio
		local a, b = m * Vector3.new(-92, 0, -45.2), m * Vector3.new(-48, 0, -45.2)
		icicles(a, b, 14, 22, seed)
		local c, d = m * Vector3.new(-82, 0, 50.6), m * Vector3.new(-66, 0, 50.6)
		icicles(c, d, 16.5, 8, seed + 1)
	end)
	local drift = Kit.deco("SnowDrift", Vector3.new(300, 2, 200), CFrame.new(0, 1.2, 0), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
	drift.Transparency = 1
	local blow = Instance.new("ParticleEmitter")
	blow.Name = "Spindrift"
	blow.Texture = "rbxasset://textures/particles/smoke_main.dds"
	blow.Color = ColorSequence.new(Color3.fromRGB(245, 248, 255))
	blow.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 4) })
	blow.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.82), NumberSequenceKeypoint.new(1, 1) })
	blow.Lifetime = NumberRange.new(3, 5)
	blow.Speed = NumberRange.new(10, 16)
	blow.SpreadAngle = Vector2.new(10, 4)
	blow.EmissionDirection = Enum.NormalId.Right
	blow.Shape = Enum.ParticleEmitterShape.Box
	blow.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	blow.Rate = 18
	blow.Parent = drift
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">HarborHeights</string>
              <string name="Source"><![CDATA[-- HARBOR HEIGHTS: pueblo costero vertical. Canal con agua en el centro (pasarelas por debajo
-- de los puentes), torre de control en el puente central, azoteas en cada lado y el mar de fondo.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)

local Map = {
	Id = "HarborHeights",
	Name = "Harbor Heights",
	Icon = "⚓",
	Description = "Costa · día · canal, puentes y azoteas",
}

Map.Lighting = {
	CartoonNeutral = { Hue = 0.08, Sat = 0.3 }, -- tono de los grises en estilo Cartoon
	ClockTime = 14.2,
	Brightness = 3.2,
	Exposure = 0,
	Ambient = Color3.fromRGB(60, 62, 72),
	OutdoorAmbient = Color3.fromRGB(125, 128, 140),
	Atmosphere = { Density = 0.3, Offset = 0.25, Color = Color3.fromRGB(199, 215, 235), Decay = Color3.fromRGB(106, 130, 160), Glare = 0.5, Haze = 1.6 },
	Color = { Saturation = 0.12, Contrast = 0.16, Brightness = 0.01, Tint = Color3.fromRGB(255, 250, 242) },
	Clouds = 0.6,
	SunRays = 0.06,
	-- Agua de puerto: verde azulada, con reflejos y oleaje suave
	Water = { Color = Color3.fromRGB(20, 110, 135), Reflectance = 0.8, Transparency = 0.45, WaveSize = 0.12, WaveSpeed = 8 },
	Latitude = 38,
	Bloom = { Intensity = 0.5, Size = 24, Threshold = 2 },
}

local V = Vector3.new
local RGB = Color3.fromRGB
local C = Kit.C

local STONE = RGB(168, 158, 140) -- adoquín envejecido (antes casi blanco: deslumbraba)
local STONE_DARK = RGB(132, 122, 104)
local PLASTER = RGB(236, 226, 205)
local CANAL_HALF = 12 -- el canal va de x = -12 a x = 12
local LEDGE_Y = -7.5 -- altura de las pasarelas del canal
local WATER_Y = -8.5

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	Kit.applyLighting(Map.Lighting)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	---------------------------------------------------------------------------
	-- Suelo, canal y agua
	---------------------------------------------------------------------------
	Kit.symmetric(function(m)
		block("Ground", V(150, 2, 220), m * CFrame.new(-(CANAL_HALF + 75), -1, 0), STONE, Enum.Material.Cobblestone)
		-- Muro del canal y pasarela inferior
		block("CanalWall", V(2, 14, 220), m * CFrame.new(-(CANAL_HALF - 1), -7, 0), STONE_DARK, Enum.Material.Limestone)
		block("CanalLedge", V(4, 1, 220), m * CFrame.new(-(CANAL_HALF - 4), LEDGE_Y - 0.5, 0), STONE, Enum.Material.Cobblestone)
		deco("LedgeEdge", V(0.4, 0.3, 220), m * CFrame.new(-(CANAL_HALF - 6.2), LEDGE_Y + 0.05, 0), C.Yellow, Enum.Material.SmoothPlastic)
		-- Farolillos del canal
		for z = -90, 90, 30 do
			local lamp = deco("CanalLamp", V(0.8, 1, 0.8), m * CFrame.new(-(CANAL_HALF - 2.4), LEDGE_Y + 4, z), RGB(255, 210, 140), Enum.Material.Neon)
			Kit.light(lamp, "PointLight", RGB(255, 200, 130), 14, 1.4)
		end
		-- Escaleras de bajada al canal
		for _, z in { 30, -75 } do
			Kit.stairs(m * V(-(CANAL_HALF - 3), 0, z), m * V(-(CANAL_HALF - 3), LEDGE_Y, z + 15), 3.6, STONE)
		end
		-- Realismo: algas en la línea del agua, mancha de humedad en el muro y bolardos de amarre
		deco("WaterlineAlgae", V(0.06, 0.7, 220), m * CFrame.new(-(CANAL_HALF - 6) + 0.03, WATER_Y + 0.15, 0), RGB(48, 66, 44), Enum.Material.Slate)
		deco("WetStain", V(0.06, 1.2, 220), m * CFrame.new(-(CANAL_HALF - 1) + 1.03, LEDGE_Y + 0.6, 0), STONE_DARK:Lerp(RGB(40, 50, 40), 0.35), Enum.Material.Limestone)
		for z = -100, 100, 20 do
			local nearBridge = math.abs(z) < 12 or math.abs(math.abs(z) - 80) < 8
			local nearStairs = (z >= 26 and z <= 50) or (z >= -79 and z <= -56)
			if not nearBridge and not nearStairs then
				Kit.cylinder("Bollard", 1.4, 1, m * CFrame.new(-(CANAL_HALF - 1), 0.7, z), RGB(40, 42, 46), Enum.Material.Metal, nil, true)
				Kit.ball("BollardCap", 1.3, m * CFrame.new(-(CANAL_HALF - 1), 1.45, z), RGB(40, 42, 46), Enum.Material.Metal, true)
			end
		end
		Kit.manhole(m * V(-75, 0, -30))
		Kit.manhole(m * V(-115, 0, 50))
	end)
	block("CanalFloor", V(16, 1, 220), CFrame.new(0, -14, 0), RGB(60, 70, 60), Enum.Material.Mud)
	workspace.Terrain:FillBlock(CFrame.new(0, (WATER_Y - 14) / 2, 0), V(16, WATER_Y + 14, 222), Enum.Material.Water)
	-- Barca amarrada en el canal
	Kit.boat(CFrame.new(-1, WATER_Y, -40))

	---------------------------------------------------------------------------
	-- Puentes
	---------------------------------------------------------------------------
	local function bridge(z, width)
		block("Bridge", V(CANAL_HALF * 2 + 4, 1.5, width), CFrame.new(0, -0.75, z), STONE, Enum.Material.Cobblestone)
		-- Arco de piedra decorativo bajo el puente
		for _, x in { -6, 0, 6 } do
			deco("Arch", V(4, 1.2, width + 0.2), CFrame.new(x, -2.1 + math.abs(x) * 0.05, z), STONE_DARK, Enum.Material.Limestone)
		end
		for _, side in { -1, 1 } do
			Kit.railing(V(-(CANAL_HALF + 2), 0, z + side * (width / 2 - 0.3)), V(CANAL_HALF + 2, 0, z + side * (width / 2 - 0.3)), 3, RGB(90, 70, 50))
		end
	end
	bridge(0, 18)
	bridge(80, 9)
	bridge(-80, 9)

	---------------------------------------------------------------------------
	-- Torre de control (centro, sobre el puente)
	---------------------------------------------------------------------------
	local towerColor = RGB(200, 185, 160)
	for _, x in { -7, 7 } do
		for _, z in { -7, 7 } do
			block("TowerLeg", V(2.4, 24, 2.4), CFrame.new(x, 12, z), towerColor, Enum.Material.Limestone)
		end
	end
	-- Primer piso (con hueco para la escalera de mano)
	block("TowerFloor1", V(17, 1, 7), CFrame.new(0, 10.5, -5), STONE, Enum.Material.WoodPlanks)
	block("TowerFloor1", V(17, 1, 7), CFrame.new(0, 10.5, 5), STONE, Enum.Material.WoodPlanks)
	block("TowerFloor1", V(6, 1, 3), CFrame.new(-5.5, 10.5, 0), STONE, Enum.Material.WoodPlanks)
	block("TowerFloor1", V(6, 1, 3), CFrame.new(5.5, 10.5, 0), STONE, Enum.Material.WoodPlanks)
	-- Azotea de la torre (con hueco en el centro para la escalera de mano)
	for _, s in { -1, 1 } do
		block("TowerParapet", V(17, 2.6, 1), CFrame.new(0, 24.3, s * 8), towerColor, Enum.Material.Limestone)
		block("TowerParapet", V(1, 2.6, 15), CFrame.new(s * 8, 24.3, 0), towerColor, Enum.Material.Limestone)
		Kit.railing(V(-8.5, 11, s * 8.3), V(8.5, 11, s * 8.3), 3, RGB(90, 70, 50))
	end
	-- Escalera de mano (TrussPart: se puede trepar) del primer piso a la azotea
	local truss = Instance.new("TrussPart")
	truss.Name = "TowerLadder"
	truss.Anchored = true
	truss.Size = V(2, 12, 2)
	truss.CFrame = CFrame.new(0, 16.5, 0)
	truss.Color = RGB(110, 85, 60)
	truss.Parent = folder
	block("TowerTop", V(17, 1, 7.5), CFrame.new(0, 22.5, -4.75), towerColor, Enum.Material.Limestone)
	block("TowerTop", V(17, 1, 7.5), CFrame.new(0, 22.5, 4.75), towerColor, Enum.Material.Limestone)
	block("TowerTop", V(7, 1, 2), CFrame.new(-5, 22.5, 0), towerColor, Enum.Material.Limestone)
	block("TowerTop", V(7, 1, 2), CFrame.new(5, 22.5, 0), towerColor, Enum.Material.Limestone)
	-- Antena y radar
	Kit.cylinder("TowerMast", 10, 0.5, CFrame.new(5, 28, 5), C.Metal, Enum.Material.Metal, nil, true)
	local dish = deco("RadarDish", V(0.4, 4, 4), CFrame.new(-5, 27, -5) * CFrame.Angles(0, math.rad(35), math.rad(70)), RGB(230, 230, 235), Enum.Material.Metal)
	dish.Shape = Enum.PartType.Cylinder
	dish:SetAttribute("Spin", 30)
	Kit.ball("TowerBeacon", 1, CFrame.new(5, 33.5, 5), RGB(255, 40, 40), Enum.Material.Neon, true):SetAttribute("Blink", 1.2)
	-- Estandartes de la torre (neutros)
	for _, s in { -1, 1 } do
		Kit.banner(CFrame.new(0, 21, s * 8.7) * (s > 0 and CFrame.Angles(0, math.pi, 0) or CFrame.new()), 6, 8, RGB(240, 190, 40), C.White)
	end

	---------------------------------------------------------------------------
	-- Mitad simétrica: A (rojo) y B (azul)
	---------------------------------------------------------------------------
	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(200, 45, 40) or RGB(45, 100, 210)

		-- Rampa a la torre desde la orilla
		Kit.stairs(m * V(-32, 0, -3.5), m * V(-8.5, 11, -3.5), 4, STONE)

		-- Casas con azoteas (A1 con escalera exterior; A2 alta, comunicada con A1 por una pasarela)
		Kit.house(m * CFrame.new(-60, 0, 55), V(24, 10, 18), RGB(255, 222, 165), teamColor, { Vines = true, OpenSides = true })
		Kit.stairs(m * V(-45.5, 0, 68), m * V(-45.5, 10, 50), 4, STONE)
		Kit.house(m * CFrame.new(-100, 0, 72), V(20, 15, 16), RGB(255, 196, 180), teamColor, { Vines = true, OpenSides = true })
		Kit.ramp(m * V(-72, 10, 60), m * V(-90, 15, 68), 4, RGB(120, 90, 60), Enum.Material.WoodPlanks)
		Kit.house(m * CFrame.new(-78, 0, -58), V(22, 10, 20), RGB(200, 226, 240), teamColor, { DoorX = -4, OpenSides = true })
		Kit.stairs(m * V(-64.5, 0, -45), m * V(-64.5, 10, -61), 4, STONE)
		Kit.house(m * CFrame.new(-128, 0, -78), V(18, 12, 16), RGB(240, 235, 215), teamColor)

		-- Macetas en las azoteas y guirnaldas sobre el mercado
		Kit.flowerPot(m * CFrame.new(-68, 10, 50), RGB(255, 80, 120))
		Kit.flowerPot(m * CFrame.new(-52, 10, 60), RGB(255, 200, 60))
		Kit.flowerPot(m * CFrame.new(-104, 15, 76), RGB(255, 120, 200))
		Kit.flowerPot(m * CFrame.new(-84, 10, -54), RGB(120, 160, 255))
		-- Flores al pie de las casas y hierba alta en los rincones
		for i, p in { V(-50, 0, 44), V(-88, 0, 62), V(-70, 0, -46), V(-122, 0, -88), V(-140, 0, 72) } do
			Kit.flowers(m * p, 3, i * 11)
		end
		for i, p in { V(-30, 0, 60), V(-125, 0, -60), V(-148, 0, 96), V(-60, 0, -98) } do
			Kit.grassTuft(m * p, 1, i * 5)
		end
		Kit.stringLights(m * V(-44, 9, 12), m * V(-30, 9, 36))
		Kit.stringLights(m * V(-30, 9, 12), m * V(-44, 9, 36))

		-- Estandartes del equipo en las fachadas que miran al centro
		Kit.banner(m * CFrame.new(-55, 9.5, 45.6), 5, 7, teamColor, C.White)
		Kit.banner(m * CFrame.new(-82, 9.5, -47.4), 5, 7, teamColor, C.White)

		-- Mercado con toldos
		for i, z in { 18, 30 } do
			block("Stall", V(8, 3, 5), m * CFrame.new(-38, 1.5, z), RGB(150, 110, 70), Enum.Material.WoodPlanks)
			for _, x in { -3.7, 3.7 } do
				deco("StallPost", V(0.4, 6, 0.4), m * CFrame.new(-38 + x, 3, z - 2.2), RGB(110, 80, 50), Enum.Material.Wood)
			end
			Kit.awning(m * CFrame.new(-38, 6.2, z + 2), 9, 6, i == 1 and teamColor or RGB(240, 160, 40))
			Kit.crate(m * CFrame.new(-33, 0, z + 1), 2.5)
		end

		-- Contenedores y cajas de cobertura
		Kit.container(m * CFrame.new(-32, 0, -32) * CFrame.Angles(0, math.rad(90), 0), side == "A" and C.Red or C.Blue)
		Kit.container(m * CFrame.new(-112, 0, 22), side == "A" and C.Blue or C.Red)
		Kit.crate(m * CFrame.new(-25, 0, 8))
		Kit.crate(m * CFrame.new(-25, 0, 12.5))
		Kit.crate(m * CFrame.new(-25, 4, 10), 3.5)
		Kit.crate(m * CFrame.new(-55, 0, -20), 5)
		Kit.crate(m * CFrame.new(-90, 0, 40))
		Kit.crate(m * CFrame.new(-90, 0, 35), 3)
		Kit.crate(m * CFrame.new(-140, 0, 60), 4)
		Kit.barrel(m * CFrame.new(-50, 0, 10), RGB(40, 90, 180))
		Kit.barrel(m * CFrame.new(-48, 0, 12.5), RGB(180, 50, 40))
		Kit.barrel(m * CFrame.new(-100, 0, -30), RGB(40, 90, 180))
		-- Muros bajos de piedra
		block("StoneWall", V(2, 4, 14), m * CFrame.new(-45, 2, -8), STONE_DARK, Enum.Material.Cobblestone)
		block("StoneWall", V(12, 4, 2), m * CFrame.new(-95, 2, 0), STONE_DARK, Enum.Material.Cobblestone)
		block("StoneWall", V(2, 3, 18), m * CFrame.new(-120, 1.5, -40), STONE_DARK, Enum.Material.Cobblestone)

		-- Palmeras y farolas
		for _, p in { V(-20, 0, 45), V(-20, 0, -55), V(-70, 0, 20), V(-130, 0, 95), V(-55, 0, -95), V(-110, 0, -10) } do
			Kit.palm(m * CFrame.new(p) * CFrame.Angles(0, (p.X + p.Z) % 6, 0), 13 + (math.abs(p.Z) % 4))
		end
		for _, p in { V(-18, 0, 20), V(-18, 0, -30), V(-60, 0, 90), V(-90, 0, -95) } do
			Kit.streetLamp(m * CFrame.new(p) * CFrame.Angles(0, math.rad(90), 0), RGB(255, 225, 170))
		end
	end)

	---------------------------------------------------------------------------
	-- Spawns, banderas, bordes
	---------------------------------------------------------------------------
	local spawnStyle = { Floor = RGB(230, 215, 185), FloorMaterial = Enum.Material.CeramicTiles, Roof = RGB(200, 90, 60), RoofMaterial = Enum.Material.ClayRoofTiles }
	Kit.spawnArea(teams[1], CFrame.new(-145, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-145, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-118, 0, 12))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-118, 0, 12))
	Kit.bounds(320, 220, 60)

	-- Malecón con barandilla hacia el mar (lado +Z) y fachadas al otro lado (lado -Z)
	block("SeaWall", V(320, 3, 3), CFrame.new(0, 1.5, 111.5), STONE_DARK, Enum.Material.Limestone)
	Kit.railing(V(-160, 3, 111.5), V(160, 3, 111.5), 2.5, RGB(240, 240, 245))
	for x = -150, 150, 30 do
		local h = 18 + (math.abs(x) % 4) * 4
		block("BackHouse", V(28, h, 10), CFrame.new(x, h / 2, -116), (x / 30) % 2 == 0 and PLASTER or RGB(240, 210, 180), Enum.Material.Plaster)
		deco("BackRoof", V(29, 1.5, 11), CFrame.new(x, h + 0.75, -116), RGB(200, 90, 60), Enum.Material.ClayRoofTiles)
		for wx = -9, 9, 6 do
			deco("BackWindow", V(2.4, 3, 0.2), CFrame.new(x + wx, h * 0.6, -110.9), RGB(60, 70, 90), Enum.Material.Glass)
		end
	end
	for z = -90, 90, 30 do
		for _, sx in { -1, 1 } do
			block("SideHouse", V(10, 22, 28), CFrame.new(sx * 167, 11, z), PLASTER, Enum.Material.Plaster)
			deco("SideRoof", V(11, 1.5, 29), CFrame.new(sx * 167, 22.75, z), RGB(200, 90, 60), Enum.Material.ClayRoofTiles)
		end
	end

	-- Mar, isla del faro y barco (fondo)
	workspace.Terrain:FillBlock(CFrame.new(0, -12, 322), V(900, 20, 420), Enum.Material.Water)
	Kit.lighthouse(V(120, 0, 300))
	Kit.ship(CFrame.new(-140, -2, 250) * CFrame.Angles(0, math.rad(10), 0), 110)
	Kit.crane(CFrame.new(-60, 0, 150), 42)
	Kit.crane(CFrame.new(40, 0, 160) * CFrame.Angles(0, math.rad(20), 0), 38)

	---------------------------------------------------------------------------
	-- Modos: puntos libres y zonas
	---------------------------------------------------------------------------
	for _, p in {
		V(-130, 0.5, 45), V(-90, 0.5, -15), V(-50, 0.5, 30), V(-40, 0.5, -70), V(-100, 15.5, 72),
		V(-60, 10.5, 55), V(-10, LEDGE_Y + 0.5, 60), V(-70, 0.5, 90), V(-150, 0.5, -60), V(-25, 0.5, -10),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, 0, 0), 9, 1)
	Kit.zone(V(-60, 10, 55), 10, 2)
	Kit.zone(V(60, 10, -55), 10, 3)
	Kit.zone(V(-40, 0, -45), 12, 4)
	Kit.zone(V(40, 0, 45), 12, 5)
	-- Realismo: polvo y polen flotando a contraluz sobre el mercado y el puente
	Kit.dustMotes(CFrame.new(0, 7, 0), Vector3.new(120, 12, 60), Color3.fromRGB(255, 245, 215), 16)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">HauntedManor</string>
              <string name="Source"><![CDATA[-- MANSIÓN ENCANTADA (mapa de Halloween): de noche, con luna grande y niebla violeta. Mansión en el
-- centro con planta baja de lado a lado y azotea con almenas (escaleras por fuera), cementerios con
-- lápidas como cobertura, criptas, árboles secos, calabazas, faroles naranjas y un caldero de bruja.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)

local Map = {
	Id = "HauntedManor",
	Name = "Mansión Encantada",
	Icon = "🎃",
	Description = "Halloween · noche · mansión y cementerios",
}

Map.Lighting = {
	CartoonNeutral = { Hue = 0.76, Sat = 0.2 }, -- grises violetas
	ClockTime = 0.2,
	Brightness = 1.2,
	Exposure = 0.3,
	Ambient = Color3.fromRGB(60, 45, 85),
	OutdoorAmbient = Color3.fromRGB(85, 70, 120),
	Atmosphere = { Density = 0.38, Offset = 0.1, Color = Color3.fromRGB(110, 80, 150), Decay = Color3.fromRGB(60, 35, 90), Glare = 0, Haze = 2.4 },
	Color = { Saturation = 0.25, Contrast = 0.15, Brightness = 0.04, Tint = Color3.fromRGB(245, 235, 255) },
	Bloom = { Intensity = 0.9, Size = 26, Threshold = 1.4 },
	Clouds = 0.4,
	CloudColor = Color3.fromRGB(90, 70, 120),
	SunRays = 0,
	Stars = 4000,
	MoonSize = 22,
	TerrainColors = {
		Grass = Color3.fromRGB(70, 90, 70),
		LeafyGrass = Color3.fromRGB(60, 80, 65),
	},
}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad

local GRASS = RGB(70, 95, 75)
local STONE = RGB(120, 115, 135)
local STONE_DARK = RGB(85, 80, 100)
local WOOD = RGB(90, 60, 45)
local ROOF = RGB(70, 40, 90)
local ORANGE = RGB(255, 140, 40)
local GLOW = RGB(255, 190, 90)

local LENGTH, WIDTH = 190, 130

local function wall(name, cf, size, color)
	local part = Kit.block(name, size, cf * CFrame.new(0, size.Y / 2, 0), color or STONE, Enum.Material.SmoothPlastic)
	Kit.deco(name .. "Cap", V(size.X + 0.4, 0.6, size.Z + 0.4), cf * CFrame.new(0, size.Y + 0.3, 0), STONE_DARK, Enum.Material.SmoothPlastic)
	return part
end

-- Lápida (cobertura baja): losa con parte de arriba redondeada
local function gravestone(cf, w)
	w = w or 2.4
	Kit.block("Gravestone", V(w, 2.6, 0.7), cf * CFrame.new(0, 1.3, 0), STONE, Enum.Material.SmoothPlastic)
	-- Medio disco arriba: cilindro con el eje hacia delante (Z), del mismo grosor que la losa
	local top = Kit.cylinder("GravestoneTop", 0.7, w, cf * CFrame.new(0, 2.6, 0) * CFrame.Angles(rad(90), 0, 0), STONE, Enum.Material.SmoothPlastic)
	top.CastShadow = false
	Kit.deco("GravestoneCross", V(0.2, 0.9, 0.05), cf * CFrame.new(0, 1.7, -0.37), STONE_DARK, Enum.Material.SmoothPlastic)
	Kit.deco("GravestoneCrossBar", V(0.6, 0.18, 0.05), cf * CFrame.new(0, 1.9, -0.37), STONE_DARK, Enum.Material.SmoothPlastic)
end

-- Árbol seco retorcido (decoración, se atraviesa por las ramas)
local function deadTree(position, scale, seed)
	local rng = Random.new(seed)
	local h = 10 * scale
	Kit.cylinder("DeadTrunk", h, 1.2 * scale, CFrame.new(position + V(0, h / 2, 0)) * CFrame.Angles(0, 0, rad(rng:NextNumber(-6, 6))), WOOD, Enum.Material.SmoothPlastic)
	for i = 1, 4 do
		local y = h * (0.45 + i * 0.12)
		local a = rng:NextNumber(0, math.pi * 2)
		local len = rng:NextNumber(3, 5) * scale
		local dir = V(math.cos(a), 0.6, math.sin(a)).Unit
		local mid = position + V(0, y, 0) + dir * len / 2
		Kit.deco("DeadBranch", V(0.45 * scale, 0.45 * scale, len), CFrame.lookAt(mid, mid + dir), WOOD, Enum.Material.SmoothPlastic)
	end
end

-- Farol de hierro con luz naranja
local function lamp(position)
	Kit.cylinder("LampPost", 7, 0.35, CFrame.new(position + V(0, 3.5, 0)), RGB(30, 28, 36), Enum.Material.SmoothPlastic, nil, true)
	local glass = Kit.deco("LampGlow", V(0.9, 1.1, 0.9), CFrame.new(position + V(0, 7.4, 0)), GLOW, Enum.Material.Neon)
	Kit.deco("LampCap", V(1.3, 0.3, 1.3), CFrame.new(position + V(0, 8.1, 0)), RGB(30, 28, 36), Enum.Material.SmoothPlastic)
	Kit.light(glass, "PointLight", ORANGE, 16, 1.2)
end

-- Cripta pequeña (cobertura grande con puerta oscura)
local function crypt(cf)
	Kit.block("Crypt", V(8, 6, 6), cf * CFrame.new(0, 3, 0), STONE_DARK, Enum.Material.SmoothPlastic)
	Kit.block("CryptRoof", V(9, 1, 7), cf * CFrame.new(0, 6.5, 0), ROOF, Enum.Material.SmoothPlastic)
	Kit.deco("CryptDoor", V(2.6, 4, 0.2), cf * CFrame.new(0, 2, -3.05), RGB(20, 15, 25), Enum.Material.SmoothPlastic)
	Kit.deco("CryptCross", V(0.4, 2, 0.4), cf * CFrame.new(0, 8, 0), STONE, Enum.Material.SmoothPlastic)
	Kit.deco("CryptCrossBar", V(1.4, 0.4, 0.4), cf * CFrame.new(0, 8.4, 0), STONE, Enum.Material.SmoothPlastic)
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	Kit.applyLighting(Map.Lighting)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Suelo de hierba oscura y camino de piedra central
	block("Floor", V(LENGTH + 40, 2, WIDTH + 40), CFrame.new(0, -1, 0), GRASS, Enum.Material.SmoothPlastic)
	block("Path", V(LENGTH - 20, 0.2, 12), CFrame.new(0, 0.1, 0), STONE_DARK, Enum.Material.SmoothPlastic)

	-- Muro perimetral con verja
	for _, z in { -1, 1 } do
		wall("OuterWall", CFrame.new(0, 0, z * (WIDTH / 2 + 1.5)), V(LENGTH + 6, 16, 3))
	end
	for _, x in { -1, 1 } do
		wall("OuterWall", CFrame.new(x * (LENGTH / 2 + 1.5), 0, 0), V(3, 16, WIDTH + 6))
	end

	-- Mansión central: planta baja de lado a lado (puertas en ±X), ventanas y azotea con almenas
	local w, d, h, t = 36, 24, 10, 1.6
	for _, z in { -1, 1 } do
		-- Paredes largas con ventanas (tres huecos a media altura)
		block("ManorWallLow", V(w, 3.5, t), CFrame.new(0, 1.75, z * (d / 2 - t / 2)), STONE, Enum.Material.SmoothPlastic)
		block("ManorWallHigh", V(w, h - 6.5, t), CFrame.new(0, 6.5 + (h - 6.5) / 2, z * (d / 2 - t / 2)), STONE, Enum.Material.SmoothPlastic)
		for _, x in { -15.5, -5.5, 5.5, 15.5 } do
			block("ManorWallMid", V(5, 3, t), CFrame.new(x, 5, z * (d / 2 - t / 2)), STONE, Enum.Material.SmoothPlastic)
		end
		for _, x in { -10.5, 0, 10.5 } do
			deco("ManorWindowGlow", V(4.6, 0.3, t + 0.1), CFrame.new(x, 6.4, z * (d / 2 - t / 2)), GLOW, Enum.Material.Neon)
		end
	end
	for _, x in { -1, 1 } do
		-- Paredes cortas con puerta grande en el centro
		local side = (d - 2 * t - 6) / 2
		for _, s in { -1, 1 } do
			block("ManorWallEnd", V(t, h, side), CFrame.new(x * (w / 2 - t / 2), h / 2, s * (3 + side / 2)), STONE, Enum.Material.SmoothPlastic)
		end
		block("ManorLintel", V(t, h - 7, 6), CFrame.new(x * (w / 2 - t / 2), 7 + (h - 7) / 2, 0), STONE, Enum.Material.SmoothPlastic)
		deco("ManorDoorFrame", V(t + 0.2, 0.5, 6.4), CFrame.new(x * (w / 2 - t / 2), 7.2, 0), ORANGE, Enum.Material.SmoothPlastic)
	end
	block("ManorRoof", V(w, 1, d), CFrame.new(0, h + 0.5, 0), ROOF, Enum.Material.SmoothPlastic)
	for _, z in { -1, 1 } do
		for x = -15, 15, 6 do
			block("Battlement", V(3, 1.6, 0.8), CFrame.new(x, h + 1.8, z * (d / 2 - 0.4)), STONE_DARK, Enum.Material.SmoothPlastic)
		end
	end
	-- Torreones con tejado puntiagudo y ventana iluminada en dos esquinas de la azotea (simétricos)
	Kit.symmetric(function(m)
		Kit.cylinder("Turret", 6, 4, m * CFrame.new(-14, h + 4, -8), STONE_DARK, Enum.Material.SmoothPlastic)
		Kit.deco("TurretRoof", V(4.6, 3, 4.6), m * CFrame.new(-14, h + 8.5, -8) * CFrame.Angles(0, rad(45), 0), ROOF, Enum.Material.SmoothPlastic)
		Kit.deco("TurretWindow", V(1, 1.4, 0.2), m * CFrame.new(-14, h + 4.5, -10.05), GLOW, Enum.Material.Neon)
	end)
	-- Lámpara de araña dentro
	local chandelier = deco("Chandelier", V(3, 0.4, 3), CFrame.new(0, h - 1.2, 0), GLOW, Enum.Material.Neon)
	Kit.light(chandelier, "PointLight", ORANGE, 18, 1.2)

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(255, 90, 90) or RGB(90, 150, 255)
		-- Escalera exterior a la azotea (pegada a la pared larga)
		Kit.stairs((m * CFrame.new(-w / 2 - 6, 0, -(d / 2 + 3))).Position, (m * CFrame.new(4, h + 1, -(d / 2 + 3))).Position, 5, STONE_DARK, Enum.Material.SmoothPlastic)
		block("StairLanding", V(6, 1, 6), m * CFrame.new(7, h + 0.5, -(d / 2 + 3)), STONE_DARK, Enum.Material.SmoothPlastic)

		-- Cementerio: lápidas en filas
		for row = 0, 2 do
			for col = 0, 3 do
				local x = -40 - col * 6.5 + (row % 2) * 3
				local z = 24 + row * 9
				gravestone(m * CFrame.new(x, 0, z) * CFrame.Angles(0, rad((col * 7 + row * 3) % 12 - 6), 0))
			end
		end
		crypt(m * CFrame.new(-36, 0, -36))
		crypt(m * CFrame.new(-70, 0, 44) * CFrame.Angles(0, rad(90), 0))

		-- Coberturas sueltas: tapias de piedra rotas y ataúdes
		wall("BrokenWall", m * CFrame.new(-30, 0, 10), V(10, 4, 1.5))
		wall("BrokenWall", m * CFrame.new(-52, 0, -14) * CFrame.Angles(0, rad(90), 0), V(9, 3.5, 1.5))
		block("Coffin", V(2.4, 1.6, 6), m * CFrame.new(-20, 0.8, -24) * CFrame.Angles(0, rad(20), 0), WOOD, Enum.Material.SmoothPlastic)
		Kit.deco("CoffinCross", V(0.3, 0.05, 2), m * CFrame.new(-20, 1.62, -24) * CFrame.Angles(0, rad(20), 0), ORANGE, Enum.Material.SmoothPlastic)

		-- Caldero de bruja con líquido verde brillante
		local cauldron = m * CFrame.new(-24, 0, 36)
		Kit.cylinder("Cauldron", 3, 4.2, cauldron * CFrame.new(0, 1.5, 0), RGB(25, 22, 30), Enum.Material.SmoothPlastic)
		local goo = Kit.cylinder("CauldronGoo", 0.3, 3.6, cauldron * CFrame.new(0, 3.05, 0), RGB(120, 255, 90), Enum.Material.Neon, nil, true)
		Kit.light(goo, "PointLight", RGB(120, 255, 90), 14, 1.2)

		-- Árboles secos, faroles y calabazas
		deadTree((m * CFrame.new(-74, 0, -48)).Position, 1.1, 3)
		deadTree((m * CFrame.new(-58, 0, 50)).Position, 1.3, 7)
		deadTree((m * CFrame.new(-12, 0, -46)).Position, 1, 11)
		for _, p in { V(-26, 0, -6), V(-62, 0, 8), V(-40, 0, 52), V(-86, 0, -40) } do
			lamp((m * CFrame.new(p)).Position)
		end
		for i, p in { V(-34, 0, 22), V(-60, 0, -28), V(-16, 0, 16), V(-48, 0, -48) } do
			Kit.pumpkin(m * CFrame.new(p) * CFrame.Angles(0, rad(i * 70), 0), 1 + (i % 2) * 0.3)
		end
		_ = teamColor
	end)

	-- Bases y banderas
	local spawnStyle = { Floor = STONE_DARK, Roof = ROOF }
	Kit.spawnArea(teams[1], CFrame.new(-80, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-80, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-56, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-56, 0, 0))

	-- Fondo: árboles secos y colinas oscuras
	Kit.bounds(LENGTH, WIDTH, 45)
	local n = 0
	for x = -130, 130, 24 do
		for _, z in { -1, 1 } do
			n += 1
			deadTree(V(x + z * 8, 0, z * (WIDTH / 2 + 14 + (n % 3) * 7)), 1.4 + (n % 3) * 0.2, n)
		end
	end
	for x = -180, 180, 70 do
		for _, z in { -1, 1 } do
			Kit.naturalHill(V(x, -18, z * 125), 48, Enum.Material.Grass, { Inward = V(0, 0, -z), Top = Enum.Material.LeafyGrass, RockCount = 1 })
		end
	end
	for _, sx in { -1, 1 } do
		for _, z in { -50, 20 } do
			Kit.naturalHill(V(sx * 150, -18, z), 48, Enum.Material.Grass, { Inward = V(-sx, 0, 0), Top = Enum.Material.LeafyGrass, RockCount = 1 })
		end
	end

	-- Modos
	for _, p in {
		V(-66, 0.5, 14), V(-66, 0.5, -14), V(-40, 0.5, 0), V(-30, 0.5, 30), V(-44, 0.5, -30),
		V(-12, 0.5, 0), V(-24, 0.5, -16), V(-6, h + 1.5, 4), V(-56, 0.5, 34), V(-80, 0.5, -46),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, h + 1, 0), 6, 1)
	Kit.zone(V(0, 0.2, 0), 6, 2)
	Kit.zone(V(-40, 0, 32), 6, 3)
	Kit.zone(V(40, 0, -32), 6, 4)
	Kit.zone(V(-28, 0, -36), 5, 5)
	Kit.dustMotes(CFrame.new(0, 8, 0), V(120, 14, 80), Color3.fromRGB(190, 150, 255), 14)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">JungleTemple</string>
              <string name="Source"><![CDATA[-- JUNGLE TEMPLE: ruinas en la selva. Pirámide escalonada en el centro con un santuario y una gema
-- que gira, rodeada por un foso de agua; salones de columnas en ruinas, plataformas de piedra con
-- enredaderas, cabezas de piedra gigantes, antorchas, árboles enormes y cascadas al fondo.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)

local Map = {
	Id = "JungleTemple",
	Name = "Jungle Temple",
	Icon = "🌴",
	Description = "Selva · mediodía · pirámide y cascadas",
}

Map.Lighting = {
	CartoonNeutral = { Hue = 0.2, Sat = 0.17 }, -- tono de los grises en estilo Cartoon
	ClockTime = 13.2,
	Brightness = 2.8,
	Exposure = 0.05,
	Ambient = Color3.fromRGB(55, 62, 48),
	OutdoorAmbient = Color3.fromRGB(115, 128, 100),
	Atmosphere = { Density = 0.36, Offset = 0.2, Color = Color3.fromRGB(195, 220, 185), Decay = Color3.fromRGB(110, 140, 100), Glare = 0.3, Haze = 2 },
	Color = { Saturation = 0.14, Contrast = 0.16, Brightness = 0.01, Tint = Color3.fromRGB(255, 250, 235) },
	Bloom = { Intensity = 0.5, Size = 24, Threshold = 2 },
	Clouds = 0.6,
	SunRays = 0.14,
	Wind = Vector3.new(3, 0, 1.5),
	Water = { Color = Color3.fromRGB(40, 115, 95), Reflectance = 0.6, Transparency = 0.55, WaveSize = 0.05, WaveSpeed = 6 },
	TerrainColors = {
		Grass = Color3.fromRGB(88, 140, 58),
		LeafyGrass = Color3.fromRGB(70, 125, 50),
		Mud = Color3.fromRGB(105, 80, 52),
		Ground = Color3.fromRGB(110, 92, 62),
		Rock = Color3.fromRGB(120, 116, 100),
	},
}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad

local STONE = RGB(150, 145, 125)
local STONE_DARK = RGB(110, 108, 92)
local MOSS = RGB(95, 130, 70)
local JADE = RGB(40, 255, 140)
local GRASS = RGB(85, 135, 60)

-- Árbol de la selva: tronco alto y copa de varias bolas de hojas
local function jungleTree(position, scale)
	scale = scale or 1
	Kit.cylinder("JungleTrunk", 16 * scale, 2.2 * scale, CFrame.new(position + V(0, 8 * scale, 0)), RGB(100, 75, 50), Enum.Material.Wood)
	for i, spec in { { V(0, 17, 0), 12 }, { V(4, 15.5, 2), 9 }, { V(-4, 16, -2.5), 9.5 }, { V(1, 20, -1), 8 } } do
		local leaf = Kit.ball("Canopy" .. i, spec[2] * scale, CFrame.new(position + spec[1] * scale), i % 2 == 0 and RGB(45, 120, 50) or RGB(60, 145, 55), Enum.Material.LeafyGrass, true)
		leaf.CastShadow = true
	end
	-- Lianas que cuelgan de la copa
	for i = 0, 2 do
		local angle = i * 2.1 + position.X * 0.13
		local length = (4 + (i * 1.7 + position.Z * 0.1) % 3) * scale
		local top = position + V(math.cos(angle) * 3.4, 12.5, math.sin(angle) * 3.4) * scale
		Kit.deco("Liana", V(0.25, length, 0.25) * V(scale, 1, scale), CFrame.new(top - V(0, length / 2, 0)), RGB(62, 105, 48), Enum.Material.LeafyGrass)
	end
	for i = 0, 3 do
		local angle = i * math.pi / 2 + 0.4
		Kit.deco("Root", V(1, 1.4, 4.5) * scale, CFrame.new(position + V(math.cos(angle) * 2.2, 0.5, math.sin(angle) * 2.2) * scale) * CFrame.Angles(0, -angle + math.pi / 2, rad(-15)), RGB(90, 68, 45), Enum.Material.Wood)
	end
end

-- Helecho (decoración del suelo)
local function fern(position)
	for i = 0, 4 do
		local angle = i * math.pi * 2 / 5
		Kit.deco("Fern", V(0.8, 0.15, 3.5), CFrame.new(position) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0.6, -1.5) * CFrame.Angles(rad(25), 0, 0), RGB(70, 155, 60), Enum.Material.Grass)
	end
end

-- Antorcha con fuego de verdad
local function torch(cf)
	Kit.cylinder("TorchPost", 5, 0.7, cf * CFrame.new(0, 2.5, 0), RGB(95, 70, 45), Enum.Material.Wood)
	local bowl = Kit.cylinder("TorchBowl", 0.8, 1.6, cf * CFrame.new(0, 5.2, 0), STONE_DARK, Enum.Material.Slate, nil, true)
	local fire = Instance.new("Fire")
	fire.Size = 3
	fire.Heat = 6
	fire.Color = RGB(255, 140, 40)
	fire.SecondaryColor = RGB(255, 220, 80)
	fire.Parent = bowl
	Kit.light(bowl, "PointLight", RGB(255, 160, 70), 18, 1.6)
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	Kit.applyLighting(Map.Lighting)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Suelo de terreno con hierba 3D animada y caminos de barro (sin hierba)
	Kit.terrainFloor(Enum.Material.Grass, 340, 240)
	for _, z in { -60, 60 } do
		Kit.terrainPatch(CFrame.new(0, 0, z), V(260, 4, 8), Enum.Material.Mud)
	end
	Kit.terrainPatch(CFrame.new(0, 0, 0), V(260, 4, 8), Enum.Material.Mud)
	-- Tierra bajo las bases, salones y plataformas (para que la hierba no atraviese los suelos)
	for _, cf in { CFrame.new(-145, 0, 0), Kit.MIRROR * CFrame.new(-145, 0, 0) } do
		Kit.terrainPatch(cf, V(36, 4, 76), Enum.Material.Ground)
	end
	for _, cf in { CFrame.new(-112, 0, 10), Kit.MIRROR * CFrame.new(-112, 0, 10) } do
		Kit.terrainPatch(cf, V(20, 4, 20), Enum.Material.Ground)
	end

	-- Foso de agua alrededor de la pirámide (poco profundo) y puentes de piedra
	workspace.Terrain:FillCylinder(CFrame.new(0, 0.6, 0), 1.2, 31, Enum.Material.Water)
	for _, angle in { 0, 90 } do
		block("MoatBridge", V(66, 0.8, 7), CFrame.new(0, 0.4, 0) * CFrame.Angles(0, rad(angle), 0), STONE, Enum.Material.Cobblestone)
	end

	-- Pirámide escalonada con escaleras en dos lados
	for i, size in { 30, 24, 18, 12 } do
		local y = 1.5 + (i - 1) * 3
		block("PyramidTier", V(size, 3, size), CFrame.new(0, y, 0), i % 2 == 0 and STONE or STONE_DARK, Enum.Material.Slate)
		deco("PyramidMoss", V(size + 0.1, 0.4, size + 0.1), CFrame.new(0, y + 1.3, 0), MOSS, Enum.Material.LeafyGrass)
	end
	-- Santuario en la cima con la gema
	for _, x in { -4.5, 4.5 } do
		for _, z in { -4.5, 4.5 } do
			block("ShrineColumn", V(1.6, 7, 1.6), CFrame.new(x, 15.5, z), STONE, Enum.Material.Slate)
		end
	end
	block("ShrineRoof", V(12, 1.2, 12), CFrame.new(0, 19.6, 0), STONE_DARK, Enum.Material.Slate)
	block("ShrineRoofTop", V(7, 1.2, 7), CFrame.new(0, 20.8, 0), STONE, Enum.Material.Slate)
	local gem = deco("JadeGem", V(1.8, 2.6, 1.8), CFrame.new(0, 16, 0) * CFrame.Angles(0, 0, rad(45)), JADE, Enum.Material.Neon)
	gem:SetAttribute("Spin", 60)
	gem:SetAttribute("Bob", 0.4)
	Kit.light(gem, "PointLight", JADE, 22, 2.5)
	block("GemAltar", V(3, 1.6, 3), CFrame.new(0, 12.8, 0), STONE_DARK, Enum.Material.Slate)

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(255, 60, 80) or RGB(60, 140, 255)

		-- Escalinata de la pirámide (desde el puente)
		Kit.stairs(m * V(-27, 0.8, 0), m * V(-6, 12, 0), 6, STONE, Enum.Material.Cobblestone)

		-- Salón de columnas en ruinas
		local hall = m * CFrame.new(-78, 0, -55)
		Kit.terrainPatch(hall, V(32, 4, 24), Enum.Material.Ground)
		block("HallFloor", V(28, 1, 20), hall * CFrame.new(0, 0.5, 0), STONE, Enum.Material.Cobblestone)
		for i, x in { -12, -4, 4, 12 } do
			for _, z in { -8, 8 } do
				local broken = (i + (z > 0 and 1 or 0)) % 3 == 0
				local h = broken and 6 or 12
				Kit.cylinder("HallColumn", h, 2.4, hall * CFrame.new(x, 1 + h / 2, z), STONE, Enum.Material.Slate)
				deco("ColumnMoss", V(2.6, 1, 2.6), hall * CFrame.new(x, 1.5, z), MOSS, Enum.Material.LeafyGrass)
			end
		end
		block("HallRoof", V(16, 1.6, 20), hall * CFrame.new(-6, 13.8, 0), STONE_DARK, Enum.Material.Slate)
		Kit.vines(hall * CFrame.new(-6, 13, -10.2), 14, 6)
		Kit.vines(hall * CFrame.new(-6, 13, 10.2), 14, 6)
		block("Rubble", V(5, 2.5, 4), hall * CFrame.new(8, 2.25, 2) * CFrame.Angles(0, rad(20), rad(8)), STONE_DARK, Enum.Material.Slate)
		block("Rubble", V(3, 2, 3), hall * CFrame.new(5, 2, -3) * CFrame.Angles(0, rad(-35), 0), STONE, Enum.Material.Slate)
		torch(hall * CFrame.new(16, 0, -11))
		torch(hall * CFrame.new(16, 0, 11))

		-- Plataforma de piedra elevada (puesto de tirador) con parapetos y enredaderas
		local plat = m * CFrame.new(-70, 0, 50)
		block("Platform", V(20, 10, 16), plat * CFrame.new(0, 5, 0), STONE_DARK, Enum.Material.Slate)
		deco("PlatformMoss", V(20.2, 0.4, 16.2), plat * CFrame.new(0, 9.9, 0), MOSS, Enum.Material.LeafyGrass)
		block("Parapet", V(20, 1.4, 1), plat * CFrame.new(0, 10.7, -7.5), STONE, Enum.Material.Slate)
		block("Parapet", V(20, 1.4, 1), plat * CFrame.new(0, 10.7, 7.5), STONE, Enum.Material.Slate)
		block("Parapet", V(1, 1.4, 14), plat * CFrame.new(-9.5, 10.7, 0), STONE, Enum.Material.Slate)
		block("Parapet", V(1, 1.4, 4), plat * CFrame.new(9.5, 10.7, -5), STONE, Enum.Material.Slate)
		Kit.stairs(m * V(-48, 0, 53), m * V(-60.2, 10, 53), 5, STONE, Enum.Material.Cobblestone)
		Kit.vines(plat * CFrame.new(0, 10, -8.2), 18, 7)
		Kit.vines(plat * CFrame.new(0, 10, 8.2) * CFrame.Angles(0, math.pi, 0), 18, 7)
		local glyph = deco("Glyph", V(0.3, 3, 3), plat * CFrame.new(10.05, 5, -3), teamColor, Enum.Material.Neon)
		glyph.Transparency = 0.2
		torch(plat * CFrame.new(12, 0, -10))

		-- Cabeza de piedra gigante mirando al centro (cobertura)
		local head = m * CFrame.new(-38, 0, -12)
		block("StoneHead", V(8, 9, 8), head * CFrame.new(0, 4.5, 0), RGB(125, 130, 112), Enum.Material.Slate)
		block("StoneHelmet", V(8.6, 2, 8.6), head * CFrame.new(0, 9.5, 0), STONE_DARK, Enum.Material.Slate)
		for _, z in { -1.8, 1.8 } do
			deco("StoneEye", V(0.3, 1, 1.6), head * CFrame.new(4.05, 6, z), JADE, Enum.Material.Neon)
		end
		deco("StoneNose", V(1, 2, 1.4), head * CFrame.new(4.4, 4.6, 0), RGB(115, 120, 102), Enum.Material.Slate)
		deco("StoneMouth", V(0.3, 0.8, 3.6), head * CFrame.new(4.05, 2.6, 0), RGB(60, 60, 52), Enum.Material.Slate)

		-- Muros en ruinas como cobertura
		block("RuinWall", V(2, 5, 12), m * CFrame.new(-28, 2.5, 32), STONE, Enum.Material.Cobblestone)
		block("RuinWall", V(12, 4, 2), m * CFrame.new(-55, 2, 15), STONE, Enum.Material.Cobblestone)
		block("RuinWall", V(2, 6, 14), m * CFrame.new(-100, 3, -22), STONE, Enum.Material.Cobblestone)
		block("RuinWall", V(10, 3, 2), m * CFrame.new(-22, 1.5, -40), STONE_DARK, Enum.Material.Cobblestone)
		for _, p in { V(-28, 5.2, 28), V(-100, 6.2, -18) } do
			deco("WallMoss", V(2.2, 0.5, 5), m * CFrame.new(p), MOSS, Enum.Material.LeafyGrass)
		end
		torch(m * CFrame.new(-45, 0, -30))
		torch(m * CFrame.new(-95, 0, 25))

		-- Árboles y vegetación
		for i, p in { V(-120, 0, 72), V(-98, 0, 96), V(-58, 0, 94), V(-30, 0, -84), V(-112, 0, -82), V(-135, 0, -58), V(-24, 0, 88) } do
			jungleTree(m * p, 0.9 + (i % 3) * 0.15)
		end
		for _, p in { V(-35, 0, 45), V(-88, 0, 10), V(-60, 0, -10), V(-15, 0, -70), V(-120, 0, 30) } do
			fern(m * p)
		end
		Kit.palm(m * CFrame.new(-50, 0, 80), 15)
		Kit.palm(m * CFrame.new(-128, 0, -95), 13)
		-- Sotobosque: arbustos densos junto a los bordes y las ruinas, más helechos, troncos caídos
		-- (cobertura baja) y rocas medio enterradas
		for i, p in {
			V(-140, 0, 100), V(-118, 0, 101), V(-78, 0, 101), V(-40, 0, 99), V(-8, 0, 101),
			V(-150, 0, -100), V(-100, 0, -101), V(-70, 0, -99), V(-48, 0, -101),
			V(-155, 0, 62), V(-155, 0, -62), V(-31, 0, 41), V(-96, 0, -64), V(-60, 0, -67), V(-84, 0, 42),
		} do
			Kit.bush(m * p, 0.9 + (i % 3) * 0.2)
		end
		for _, p in { V(-130, 0, 62), V(-82, 0, -30), V(-52, 0, 66), V(-8, 0, -84), V(-138, 0, -74), V(-92, 0, 84) } do
			fern(m * p)
		end
		Kit.log(m * CFrame.new(-90, 0, -38) * CFrame.Angles(0, rad(30), 0), 10, 2.2)
		Kit.log(m * CFrame.new(-36, 0, 70) * CFrame.Angles(0, rad(-20), 0), 9, 2)
		Kit.rockCluster(m * V(-150, 0, -82), 4)
		Kit.rockCluster(m * V(-62, 0, -102), 5)
		Kit.rockCluster(m * V(-132, 0, 104), 4)
		Kit.rockCluster(m * V(-26, 0, 101), 4)
		-- Flores y matas de hierba alta (estilo cartoon)
		for i, p in { V(-42, 0, 52), V(-90, 0, 18), V(-66, 0, -14), V(-22, 0, -76), V(-112, 0, 36), V(-130, 0, -40), V(-104, 0, 90) } do
			Kit.flowers(m * p, 3, i * 13)
		end
		for i, p in { V(-28, 0, 24), V(-56, 0, 18), V(-100, 0, -30), V(-80, 0, 40), V(-35, 0, -38), V(-120, 0, -60), V(-60, 0, 62), V(-14, 0, 30) } do
			Kit.grassTuft(m * p, 1 + (i % 3) * 0.2, i * 7)
		end

		-- Cascada al fondo con poza
		local fall = m * CFrame.new(-20, 0, -108)
		local water = deco("Waterfall", V(16, 46, 1), fall * CFrame.new(0, 23, 0), RGB(150, 210, 240), Enum.Material.Glass)
		water.Transparency = 0.35
		local foam = deco("WaterfallFoam", V(18, 1.5, 6), fall * CFrame.new(0, 0.8, 3), RGB(240, 250, 255), Enum.Material.SmoothPlastic)
		foam.Transparency = 0.4
		local mist = Instance.new("ParticleEmitter")
		mist.Texture = "rbxasset://textures/particles/smoke_main.dds"
		mist.Color = ColorSequence.new(Color3.new(1, 1, 1))
		mist.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 8) })
		mist.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) })
		mist.Lifetime = NumberRange.new(2, 3)
		mist.Speed = NumberRange.new(2, 5)
		mist.SpreadAngle = Vector2.new(50, 50)
		mist.Rate = 12
		mist.EmissionDirection = Enum.NormalId.Top
		mist.Parent = foam
		workspace.Terrain:FillBlock(fall * CFrame.new(0, 0.5, 7), V(26, 1, 10), Enum.Material.Water)
		-- Acantilado de roca con hierba por encima (de donde cae el agua)
		for i, x in { -30, -16, 0, 16, 30 } do
			local h = 18 + (i % 2) * 6
			workspace.Terrain:FillBall((fall * CFrame.new(x, h, -22)).Position, 20, Enum.Material.Rock)
			workspace.Terrain:FillBall((fall * CFrame.new(x * 0.9, h + 16, -26)).Position, 15, Enum.Material.Grass)
		end
	end)

	-- Hojas que caen lentamente sobre el mapa
	local sky = deco("FallingLeaves", V(320, 1, 220), CFrame.new(0, 45, 0), GRASS, Enum.Material.SmoothPlastic)
	sky.Transparency = 1
	local leaves = Instance.new("ParticleEmitter")
	leaves.Name = "Leaves"
	leaves.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	leaves.Color = ColorSequence.new(RGB(150, 210, 90), RGB(230, 210, 90))
	leaves.Size = NumberSequence.new(0.35)
	leaves.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.9, 0.2), NumberSequenceKeypoint.new(1, 1) })
	leaves.Lifetime = NumberRange.new(12, 15)
	leaves.Speed = NumberRange.new(2.5, 4)
	leaves.SpreadAngle = Vector2.new(25, 25)
	leaves.RotSpeed = NumberRange.new(-90, 90)
	leaves.Acceleration = V(0.3, 0, 0.15)
	leaves.Rate = 20
	leaves.EmissionDirection = Enum.NormalId.Bottom
	leaves.WindAffectsDrag = true
	leaves.Parent = sky

	-- Spawns y banderas
	local spawnStyle = { Floor = RGB(160, 150, 125), FloorMaterial = Enum.Material.Cobblestone, Roof = RGB(120, 95, 65), RoofMaterial = Enum.Material.WoodPlanks }
	Kit.spawnArea(teams[1], CFrame.new(-145, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-145, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-112, 0, 10))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-112, 0, 10))

	-- Límites, colinas y selva de fondo
	Kit.bounds(320, 220, 60)
	for x = -240, 240, 60 do
		for _, z in { -1, 1 } do
			-- Colinas irregulares con salientes de roca y manchas de selva (LeafyGrass) en la cima
			Kit.naturalHill(V(x - z * 20, -22, z * (170 + (math.abs(x) % 40))), 55 + (math.abs(x) % 3) * 10, Enum.Material.Grass, {
				Inward = V(0, 0, -z),
				Top = Enum.Material.LeafyGrass,
				TopCount = 6,
				RockCount = 2,
			})
		end
	end
	for z = -150, 150, 60 do
		for _, sx in { -1, 1 } do
			Kit.naturalHill(V(sx * 225, -20, z), 58, Enum.Material.Grass, { Inward = V(-sx, 0, 0), Top = Enum.Material.LeafyGrass, RockCount = 2 })
		end
	end
	for x = -150, 150, 24 do
		for _, z in { -1, 1 } do
			if math.abs(x - z * 20) > 14 then -- deja ver las cascadas
				jungleTree(V(x, 0, z * (124 + (math.abs(x) % 11))), 1.2)
			end
		end
	end

	-- Modos
	for _, p in {
		V(-130, 0.5, 45), V(-100, 0.5, -5), V(-70, 10.5, 50), V(-78, 1.5, -55), V(-45, 0.5, 8),
		V(-20, 0.5, -55), V(-110, 0.5, 80), V(-60, 0.5, -25), V(-12, 0.5, 55), V(-125, 0.5, -90),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, 12, 0), 6, 1)
	Kit.zone(V(-78, 1, -55), 9, 2)
	Kit.zone(V(78, 1, 55), 9, 3)
	Kit.zone(V(-45, 0, 32), 9, 4)
	Kit.zone(V(45, 0, -32), 9, 5)
	-- Realismo: motas de polen en la luz alrededor de la pirámide
	Kit.dustMotes(CFrame.new(0, 10, 0), Vector3.new(90, 18, 90), Color3.fromRGB(240, 255, 200), 18)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">MoonBase</string>
              <string name="Source"><![CDATA[-- BASE LUNAR: base espacial de dibujos animados en la Luna, de noche con la Tierra enorme en el
-- cielo. En el centro, un cohete en su plataforma de lanzamiento con una pasarela a media altura;
-- cúpulas de los módulos, paneles solares, un rover, cajas de carga y cráteres. Plataformas con
-- propulsores (plataformas de salto) a los lados. Simétrico (rojo contra azul).
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)

local Map = {
	Id = "MoonBase",
	Name = "Base Lunar",
	Icon = "🚀",
	Description = "Espacio · cohete central · cúpulas y cráteres",
}

Map.Lighting = {
	CartoonNeutral = { Hue = 0.62, Sat = 0.1 }, -- grises lunares algo azulados
	ClockTime = 23.5,
	Brightness = 1.6,
	Exposure = 0.35,
	Ambient = Color3.fromRGB(80, 85, 115),
	OutdoorAmbient = Color3.fromRGB(120, 125, 160),
	Atmosphere = { Density = 0.12, Offset = 0, Color = Color3.fromRGB(70, 80, 130), Decay = Color3.fromRGB(30, 30, 70), Glare = 0, Haze = 0 },
	Color = { Saturation = 0.25, Contrast = 0.12, Brightness = 0.04, Tint = Color3.fromRGB(240, 245, 255) },
	Bloom = { Intensity = 0.8, Size = 24, Threshold = 1.5 },
	Clouds = 0,
	SunRays = 0,
	Stars = 6000,
	MoonSize = 0.1, -- (estamos en la Luna: la que se ve es la Tierra)
	ShadowSoftness = 0.15,
	Wind = Vector3.new(0, 0, 0),
	TerrainColors = {
		Rock = Color3.fromRGB(150, 150, 165),
		Basalt = Color3.fromRGB(120, 120, 135),
		Slate = Color3.fromRGB(135, 135, 150),
	},
}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad

local MOON = RGB(185, 185, 198) -- suelo lunar
local MOON_DARK = RGB(150, 150, 165)
local HULL = RGB(240, 242, 248) -- blanco de las naves y módulos
local TRIM = RGB(255, 170, 40)
local GLOW = RGB(90, 220, 255)
local PANEL = RGB(40, 70, 160)

local LENGTH, WIDTH = 200, 130

-- Cráter: anillo de borde y fondo un poco más oscuro (decoración plana, se puede pisar)
local function crater(position, size)
	Kit.cylinder("CraterRim", 0.5, size, CFrame.new(position + V(0, 0.15, 0)), MOON:Lerp(Color3.new(1, 1, 1), 0.25), Enum.Material.SmoothPlastic, nil, true)
	Kit.cylinder("Crater", 0.55, size * 0.8, CFrame.new(position + V(0, 0.18, 0)), MOON_DARK, Enum.Material.SmoothPlastic, nil, true)
end

-- Cúpula de un módulo habitable (media esfera sólida) con anillo, puerta y ventanas iluminadas
local function dome(cf, size, accent)
	Kit.ball("Dome", size, cf, HULL, Enum.Material.SmoothPlastic)
	Kit.cylinder("DomeRing", 1.2, size + 0.8, cf * CFrame.new(0, 0.6, 0), accent, Enum.Material.SmoothPlastic, nil, true)
	Kit.block("DomeDoor", V(4, 6, 2.5), cf * CFrame.new(0, 3, -size / 2 + 1), RGB(70, 75, 95), Enum.Material.SmoothPlastic)
	Kit.deco("DomeDoorGlow", V(4.4, 0.4, 2.7), cf * CFrame.new(0, 6.2, -size / 2 + 1), GLOW, Enum.Material.Neon)
	for _, angle in { -50, 50, 140, 220 } do
		local window = cf * CFrame.Angles(0, rad(angle), 0) * CFrame.new(0, size * 0.22, -size * 0.43) * CFrame.Angles(rad(-25), 0, 0)
		Kit.deco("DomeWindow", V(2.2, 1.4, 0.3), window, GLOW, Enum.Material.Neon)
	end
end

-- Panel solar inclinado sobre un poste (cobertura baja)
local function solarPanel(cf)
	Kit.block("SolarPost", V(0.8, 3, 0.8), cf * CFrame.new(0, 1.5, 0), RGB(160, 165, 180), Enum.Material.SmoothPlastic)
	local panel = cf * CFrame.new(0, 3.4, 0) * CFrame.Angles(rad(30), 0, 0)
	Kit.block("SolarPanel", V(9, 0.4, 5), panel, PANEL, Enum.Material.SmoothPlastic)
	for i = -1, 1 do
		Kit.deco("SolarCellLine", V(0.12, 0.42, 5), panel * CFrame.new(i * 3, 0, 0), RGB(200, 210, 230), Enum.Material.SmoothPlastic)
	end
	Kit.deco("SolarCellLine", V(9, 0.42, 0.12), panel, RGB(200, 210, 230), Enum.Material.SmoothPlastic)
end

-- Rover lunar (cobertura): carrocería, cabina, seis ruedas y antena
local function rover(cf, color)
	Kit.block("RoverBody", V(10, 2.2, 5.5), cf * CFrame.new(0, 2.4, 0), HULL, Enum.Material.SmoothPlastic)
	Kit.block("RoverCab", V(4, 2.4, 4.6), cf * CFrame.new(-2.5, 4.7, 0), color, Enum.Material.SmoothPlastic)
	Kit.deco("RoverWindow", V(0.3, 1.4, 3.6), cf * CFrame.new(-4.55, 4.9, 0), GLOW, Enum.Material.Neon)
	for _, x in { -3.6, 0, 3.6 } do
		for _, z in { -1, 1 } do
			Kit.cylinder("RoverWheel", 1, 2.6, cf * CFrame.new(x, 1.3, z * 3.1) * CFrame.Angles(rad(90), 0, 0), RGB(50, 52, 62), Enum.Material.SmoothPlastic, nil, true)
		end
	end
	Kit.cylinder("RoverAntenna", 3, 0.2, cf * CFrame.new(3, 5, 1.5), RGB(200, 200, 210), Enum.Material.SmoothPlastic, nil, true)
	Kit.ball("RoverAntennaTip", 0.6, cf * CFrame.new(3, 6.6, 1.5), TRIM, Enum.Material.Neon, true)
end

-- Antena parabólica (decoración de fondo)
local function dish(cf, scale)
	Kit.cylinder("DishPost", 8 * scale, 1.2 * scale, cf * CFrame.new(0, 4 * scale, 0), RGB(170, 175, 190), Enum.Material.SmoothPlastic, nil, true)
	local head = cf * CFrame.new(0, 8.5 * scale, 0) * CFrame.Angles(rad(-35), 0, 0)
	Kit.cylinder("Dish", 0.8 * scale, 9 * scale, head * CFrame.Angles(rad(90), 0, 0), HULL, Enum.Material.SmoothPlastic, nil, true)
	Kit.cylinder("DishFeed", 3 * scale, 0.3 * scale, head * CFrame.new(0, 0, -1.6 * scale) * CFrame.Angles(rad(90), 0, 0), RGB(170, 175, 190), Enum.Material.SmoothPlastic, nil, true)
	Kit.ball("DishLight", 0.8 * scale, head * CFrame.new(0, 0, -3.2 * scale), RGB(255, 80, 80), Enum.Material.Neon, true)
end

-- Cohete en el centro (decoración salvo la plataforma): cuerpo blanco con franjas, alerones y punta
local function rocket(base)
	local height = 34
	Kit.cylinder("RocketBody", height, 7, base * CFrame.new(0, height / 2 + 2, 0), HULL, Enum.Material.SmoothPlastic, nil, true)
	for _, y in { 8, 20, 30 } do
		Kit.cylinder("RocketStripe", 1.4, 7.15, base * CFrame.new(0, y, 0), RGB(230, 60, 60), Enum.Material.SmoothPlastic, nil, true)
	end
	Kit.cylinder("RocketWindowRing", 0.3, 3, base * CFrame.new(0, 25, -3.45) * CFrame.Angles(rad(90), 0, 0), TRIM, Enum.Material.SmoothPlastic, nil, true)
	Kit.cylinder("RocketWindow", 0.35, 2.3, base * CFrame.new(0, 25, -3.5) * CFrame.Angles(rad(90), 0, 0), GLOW, Enum.Material.Neon, nil, true)
	Kit.cylinder("RocketNoseBase", 4, 6, base * CFrame.new(0, height + 4, 0), RGB(230, 60, 60), Enum.Material.SmoothPlastic, nil, true)
	Kit.ball("RocketNose", 5.4, base * CFrame.new(0, height + 6.6, 0), RGB(230, 60, 60), Enum.Material.SmoothPlastic, true)
	for i = 0, 3 do
		local fin = base * CFrame.Angles(0, rad(45 + i * 90), 0) * CFrame.new(0, 5, -4.6)
		Kit.deco("RocketFin", V(0.8, 8, 4), fin * CFrame.Angles(rad(-12), 0, 0), RGB(230, 60, 60), Enum.Material.SmoothPlastic)
	end
	Kit.cylinder("RocketEngine", 2, 5, base * CFrame.new(0, 1.6, 0), RGB(80, 85, 100), Enum.Material.SmoothPlastic, nil, true)
end

-- La Tierra en el cielo: esfera azul con continentes verdes
local function earth(position, size)
	Kit.ball("Earth", size, CFrame.new(position), RGB(60, 130, 230), Enum.Material.SmoothPlastic, true)
	local rng = Random.new(7)
	for _ = 1, 9 do
		local dir = V(rng:NextNumber(-1, 1), rng:NextNumber(-0.6, 1), rng:NextNumber(0.2, 1)).Unit
		local patch = rng:NextNumber(0.22, 0.38) * size
		Kit.ball("EarthLand", patch, CFrame.new(position + dir * (size / 2 - patch * 0.42)), RGB(90, 190, 90), Enum.Material.SmoothPlastic, true)
	end

end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	Kit.applyLighting(Map.Lighting)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Suelo lunar con cráteres
	block("Floor", V(LENGTH + 40, 2, WIDTH + 40), CFrame.new(0, -1, 0), MOON, Enum.Material.SmoothPlastic)
	for _, c in { { V(-30, 0, 34), 12 }, { V(-60, 0, -20), 9 }, { V(-14, 0, -46), 10 }, { V(-78, 0, 50), 8 } } do
		crater(c[1], c[2])
		crater(Kit.MIRROR * c[1], c[2])
	end
	crater(V(0, 0, 50), 7)
	crater(V(0, 0, -50), 7)

	-- Plataforma de lanzamiento: base octogonal alta (cobertura) y pasarela alrededor del cohete
	local deckY = 8
	Kit.cylinder("LaunchPad", 2, 26, CFrame.new(0, 1, 0), RGB(120, 125, 145), Enum.Material.SmoothPlastic)
	Kit.cylinder("LaunchPadStripe", 2.05, 22, CFrame.new(0, 1.02, 0), TRIM, Enum.Material.SmoothPlastic, nil, true)
	rocket(CFrame.new(0, 2, 0))
	-- Pasarela (gantry) en forma de anillo cuadrado con barandillas
	for _, s in { -1, 1 } do
		block("Gantry", V(22, 1, 5), CFrame.new(0, deckY - 0.5, s * 8.5), RGB(150, 155, 175), Enum.Material.Metal)
		block("Gantry", V(5, 1, 12), CFrame.new(s * 8.5, deckY - 0.5, 0), RGB(150, 155, 175), Enum.Material.Metal)
		deco("GantryGlow", V(22, 0.2, 0.3), CFrame.new(0, deckY + 0.05, s * 10.9), GLOW, Enum.Material.Neon)
		for _, x in { -10, 10 } do
			block("GantryPillar", V(1.2, deckY - 1, 1.2), CFrame.new(x, (deckY - 1) / 2, s * 10), RGB(120, 125, 145), Enum.Material.Metal)
		end
		Kit.railing(V(-11, deckY, s * 11), V(11, deckY, s * 11), 2.5, RGB(220, 220, 230))
	end

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(235, 70, 70) or RGB(60, 130, 240)
		-- Rampa a la pasarela
		Kit.stairs((m * CFrame.new(-30, 0, 0)).Position, (m * CFrame.new(-11, deckY, 0)).Position, 5, RGB(150, 155, 175), Enum.Material.Metal)

		-- Cúpulas de los módulos (cobertura grande)
		dome(m * CFrame.new(-50, 0, 32) * CFrame.Angles(0, rad(200), 0), 18, teamColor)
		dome(m * CFrame.new(-34, 0, -38) * CFrame.Angles(0, rad(-20), 0), 14, teamColor)

		-- Plataforma elevada con propulsor (plataforma de salto) para subir
		local platY = 9
		block("LandingPlatform", V(18, 1.2, 12), m * CFrame.new(-60, platY - 0.6, -(WIDTH / 2 - 10)), RGB(170, 175, 195), Enum.Material.Metal)
		deco("LandingGlow", V(18.4, 0.3, 0.3), m * CFrame.new(-60, platY, -(WIDTH / 2 - 16.2)), teamColor, Enum.Material.Neon)
		for _, x in { -67, -53 } do
			for _, z in { -(WIDTH / 2 - 5), -(WIDTH / 2 - 15) } do
				block("LandingLeg", V(1.2, platY - 1.2, 1.2), m * CFrame.new(x, (platY - 1.2) / 2, z), RGB(120, 125, 145), Enum.Material.Metal)
			end
		end
		Kit.jumpPad((m * CFrame.new(-60, 0, -(WIDTH / 2 - 26))).Position, 72, teamColor)

		-- Paneles solares (cobertura baja)
		solarPanel(m * CFrame.new(-22, 0, 22) * CFrame.Angles(0, rad(90), 0))
		solarPanel(m * CFrame.new(-22, 0, 34) * CFrame.Angles(0, rad(90), 0))
		solarPanel(m * CFrame.new(-74, 0, -6) * CFrame.Angles(0, rad(15), 0))

		-- Rover y cajas de carga
		rover(m * CFrame.new(-42, 0, 4) * CFrame.Angles(0, rad(-10), 0), teamColor)
		Kit.metalCrate(m * CFrame.new(-16, 0, -18), 5, HULL, GLOW)
		Kit.metalCrate(m * CFrame.new(-20, 0, -24), 4, TRIM, GLOW)
		Kit.metalCrate(m * CFrame.new(-66, 0, 22), 5, HULL, teamColor)
		Kit.metalCrate(m * CFrame.new(-28, 0, 52), 4, HULL, GLOW)
		Kit.metalCrate(m * CFrame.new(-23, 0, 53), 4, TRIM, GLOW)

		-- Rocas lunares (cobertura natural de terreno)
		Kit.rockCluster((m * CFrame.new(-48, 0, -52)).Position, 3.5, Enum.Material.Basalt)
		Kit.rockCluster((m * CFrame.new(-10, 0, 28)).Position, 3, Enum.Material.Basalt)
		Kit.rockCluster((m * CFrame.new(-82, 0, -44)).Position, 3, Enum.Material.Basalt)

		-- Bandera de su "país" plantada (decoración)
		Kit.cylinder("FlagPole", 9, 0.3, m * CFrame.new(-80, 4.5, 30), RGB(220, 220, 230), Enum.Material.SmoothPlastic, nil, true)
		deco("PlantedFlag", V(0.2, 3, 5), m * CFrame.new(-80, 7.4, 32.6), teamColor, Enum.Material.SmoothPlastic)

		-- Muro bajo del módulo de aterrizaje (protege la salida de la base)
		block("BaseWall", V(2, 4, 16), m * CFrame.new(-72, 2, 18), HULL, Enum.Material.SmoothPlastic)
		deco("BaseWallGlow", V(2.2, 0.3, 16.2), m * CFrame.new(-72, 4.1, 18), teamColor, Enum.Material.Neon)
		block("BaseWall", V(2, 4, 16), m * CFrame.new(-72, 2, -26), HULL, Enum.Material.SmoothPlastic)
		deco("BaseWallGlow", V(2.2, 0.3, 16.2), m * CFrame.new(-72, 4.1, -26), teamColor, Enum.Material.Neon)
	end)

	-- Bases y banderas
	local spawnStyle = { Floor = RGB(225, 228, 238), Roof = HULL }
	Kit.spawnArea(teams[1], CFrame.new(-85, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-85, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-62, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-62, 0, 0))

	-- Fondo: colinas de roca lunar, antenas y la Tierra
	Kit.bounds(LENGTH, WIDTH, 60)
	for x = -200, 200, 60 do
		for _, z in { -1, 1 } do
			Kit.naturalHill(V(x, -16, z * 140), 42, Enum.Material.Rock, { Inward = V(0, 0, -z), Top = Enum.Material.Basalt, RockCount = 2 })
		end
	end
	for _, sx in { -1, 1 } do
		for z = -80, 80, 55 do
			Kit.naturalHill(V(sx * 160, -16, z), 42, Enum.Material.Rock, { Inward = V(-sx, 0, 0), Top = Enum.Material.Basalt, RockCount = 2 })
		end
	end
	dish(CFrame.new(-30, 0, WIDTH / 2 + 22) * CFrame.Angles(0, rad(160), 0), 1.4)
	dish(CFrame.new(30, 0, -(WIDTH / 2 + 22)) * CFrame.Angles(0, rad(-20), 0), 1.4)
	earth(V(-60, 150, -380), 110)

	-- Modos
	for _, p in {
		V(-76, 0.5, 8), V(-76, 0.5, -16), V(-50, 0.5, 10), V(-40, 0.5, -20), V(-24, 0.5, 40),
		V(-16, 0.5, -34), V(-30, 0.5, 18), V(-60, 9.5, -(WIDTH / 2 - 10)), V(-6, deckY + 0.5, 8), V(-84, 0.5, 44),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, deckY, 8.5), 4, 1)
	Kit.zone(V(-40, 0, -14), 6, 2)
	Kit.zone(V(40, 0, 14), 6, 3)
	Kit.zone(V(-60, 9, -(WIDTH / 2 - 10)), 5, 4)
	Kit.zone(V(60, 9, WIDTH / 2 - 10), 5, 5)
	Kit.dustMotes(CFrame.new(0, 6, 0), V(140, 10, 90), Color3.fromRGB(200, 220, 255), 10)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">NeonFoundry</string>
              <string name="Source"><![CDATA[-- NEON FOUNDRY: fundición de noche. Horno central con metal fundido, canales de lava (hacen daño),
-- puentes metálicos, cintas con lingotes, pasarelas y rótulos de neón.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)

local Map = {
	Id = "NeonFoundry",
	Name = "Neon Foundry",
	Icon = "🔥",
	Description = "Industrial · noche · lava y neón",
}

Map.Lighting = {
	CartoonNeutral = { Hue = 0.75, Sat = 0.18 }, -- tono de los grises en estilo Cartoon
	ClockTime = 0.3,
	Brightness = 1,
	Exposure = 0.2,
	Ambient = Color3.fromRGB(35, 30, 50),
	OutdoorAmbient = Color3.fromRGB(55, 50, 80),
	Atmosphere = { Density = 0.4, Offset = 0.1, Color = Color3.fromRGB(90, 70, 130), Decay = Color3.fromRGB(50, 30, 80), Glare = 0, Haze = 2.8 },
	Color = { Saturation = 0.2, Contrast = 0.2, Brightness = 0.02, Tint = Color3.fromRGB(240, 232, 255) },
	Bloom = { Intensity = 1, Size = 28, Threshold = 1.3 },
	Clouds = 0.35,
	CloudColor = Color3.fromRGB(80, 60, 110),
	SunRays = 0,
	Stars = 5000, -- cielo nocturno estrellado
	MoonSize = 16,
}

local V = Vector3.new
local RGB = Color3.fromRGB
local C = Kit.C

local FLOOR = RGB(58, 60, 72)
local WALL = RGB(70, 72, 84)
local ORANGE = RGB(255, 130, 30)
local LAVA_X = 32 -- canales de lava en x = ±32

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	Kit.applyLighting(Map.Lighting)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Suelo de placas con líneas de neón
	-- Hormigón húmedo (con los charcos refleja el neón)
	block("Floor", V(340, 2, 240), CFrame.new(0, -1, 0), FLOOR, Enum.Material.Concrete)
	for _, z in { -45, 45 } do
		deco("FloorNeon", V(250, 0.06, 0.5), CFrame.new(0, 0.04, z), C.Cyan, Enum.Material.Neon)
	end
	for _, x in { -95, 95 } do
		deco("FloorNeon", V(0.5, 0.06, 200), CFrame.new(x, 0.04, 0), C.Pink, Enum.Material.Neon)
	end

	-- Horno central con metal fundido cayendo a una piscina de lava
	Kit.cylinder("Furnace", 34, 20, CFrame.new(0, 17, 0), RGB(75, 70, 80), Enum.Material.CorrodedMetal)
	for i, y in { 8, 18, 28 } do
		Kit.cylinder("FurnaceBand", 1.4, 20.6, CFrame.new(0, y, 0), i == 2 and ORANGE or RGB(45, 45, 52), i == 2 and Enum.Material.Neon or Enum.Material.Metal, nil, true)
	end
	local emblemPlate = deco("FurnaceEmblem", V(8, 8, 0.5), CFrame.new(0, 22, -10.3), RGB(40, 40, 48), Enum.Material.Metal)
	Kit.sign(emblemPlate, Enum.NormalId.Front, "⚡", ORANGE)
	local emblemBack = deco("FurnaceEmblem", V(8, 8, 0.5), CFrame.new(0, 22, 10.3), RGB(40, 40, 48), Enum.Material.Metal)
	Kit.sign(emblemBack, Enum.NormalId.Back, "⚡", ORANGE)
	for _, s in { -1, 1 } do
		local pour = deco("MoltenPour", V(3, 14, 1.2), CFrame.new(0, 7, s * 10.6), RGB(255, 150, 40), Enum.Material.Neon)
		Kit.light(pour, "PointLight", ORANGE, 30, 3)
		-- Chispas del metal fundido
		local sparks = Instance.new("ParticleEmitter")
		sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		sparks.Color = ColorSequence.new(RGB(255, 230, 150), ORANGE)
		sparks.LightEmission = 1
		sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
		sparks.Lifetime = NumberRange.new(0.6, 1.2)
		sparks.Speed = NumberRange.new(8, 16)
		sparks.SpreadAngle = Vector2.new(70, 70)
		sparks.Acceleration = V(0, -35, 0)
		sparks.Rate = 25
		sparks.EmissionDirection = Enum.NormalId.Top
		sparks.Parent = pour
		Kit.lava(V(12, 1, 6), CFrame.new(0, -0.3, s * 14))
		Kit.railing(V(-7, 0, s * 17.5), V(7, 0, s * 17.5), 3, ORANGE)
	end
	Kit.cylinder("FurnaceCap", 3, 14, CFrame.new(0, 35.5, 0), RGB(50, 50, 58), Enum.Material.Metal, nil, true)
	Kit.smokestack(V(0, 37, 0), 18)

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(255, 60, 80) or RGB(60, 140, 255)

		-- Canal de lava a lo largo de Z con tres puentes
		Kit.lava(V(10, 1, 210), m * CFrame.new(-LAVA_X, -0.4, 0))
		for _, bz in { -70, 5, 70 } do
			block("LavaBridge", V(14, 1, 10), m * CFrame.new(-LAVA_X, 0.5, bz), RGB(80, 82, 95), Enum.Material.DiamondPlate)
			for _, s in { -1, 1 } do
				Kit.railing(m * V(-LAVA_X - 7, 1, bz + s * 4.8), m * V(-LAVA_X + 7, 1, bz + s * 4.8), 2.5, ORANGE)
			end
		end

		-- Plataforma elevada con cinta transportadora
		block("ConveyorDeck", V(14, 8, 46), m * CFrame.new(-62, 4, -60), WALL, Enum.Material.CorrodedMetal)
		deco("DeckNeon", V(14.2, 0.4, 46.2), m * CFrame.new(-62, 7.9, -60), teamColor, Enum.Material.Neon)
		Kit.conveyor(m * V(-62, 8.5, -80), m * V(-62, 8.5, -40), 5)
		Kit.stairs(m * V(-62, 0, -100), m * V(-62, 8, -83), 6, RGB(90, 92, 105))
		Kit.stairs(m * V(-43, 0, -45), m * V(-55.5, 8, -45), 5, RGB(90, 92, 105))
		Kit.railing(m * V(-69, 8, -83), m * V(-69, 8, -37), 3, C.Yellow)

		-- Edificio del rótulo de neón (lado del equipo, con pasarela)
		block("Factory", V(30, 22, 26), m * CFrame.new(-95, 11, 75), WALL, Enum.Material.CorrodedMetal)
		deco("FactoryTrim", V(30.4, 1, 26.4), m * CFrame.new(-95, 21.8, 75), RGB(40, 40, 50), Enum.Material.Metal)
		for i, x in { -104, -95, -86 } do
			local win = deco("FactoryWindow", V(5, 4, 0.3), m * CFrame.new(x, 8, 61.9), i == 2 and ORANGE or RGB(255, 190, 80), Enum.Material.Neon)
			win.Transparency = 0.25
		end
		Kit.neonSign(m * CFrame.new(-95, 16, 61.6), 22, 6, side == "A" and "NEON FOUNDRY" or "FOUNDRY 02", side == "A" and C.Cyan or C.Pink, side == "A" and C.Pink or C.Cyan)
		block("FactoryWalk", V(8, 1, 40), m * CFrame.new(-76, 9.5, 75), RGB(80, 82, 95), Enum.Material.DiamondPlate)
		Kit.railing(m * V(-72.2, 10, 56), m * V(-72.2, 10, 94), 3, C.Cyan)
		Kit.stairs(m * V(-76, 0, 38), m * V(-76, 10, 55), 6, RGB(90, 92, 105))

		-- Cajas metálicas con brillo, tuberías y cobertura
		Kit.metalCrate(m * CFrame.new(-50, 0, 10), 5, RGB(70, 75, 90), teamColor)
		Kit.metalCrate(m * CFrame.new(-50, 0, 15.2), 5, RGB(70, 75, 90), teamColor)
		Kit.metalCrate(m * CFrame.new(-50, 5, 12.6), 4, RGB(70, 75, 90), C.Cyan)
		Kit.metalCrate(m * CFrame.new(-18, 0, 35), 5, RGB(80, 70, 70), ORANGE)
		Kit.metalCrate(m * CFrame.new(-18, 0, -35), 5, RGB(80, 70, 70), ORANGE)
		Kit.metalCrate(m * CFrame.new(-80, 0, 15), 6, RGB(70, 75, 90), C.Pink)
		Kit.metalCrate(m * CFrame.new(-110, 0, -40), 5, RGB(70, 75, 90), teamColor)
		Kit.metalCrate(m * CFrame.new(-110, 0, -34.8), 5, RGB(70, 75, 90), teamColor)
		Kit.container(m * CFrame.new(-82, 0, -15) * CFrame.Angles(0, math.rad(90), 0), RGB(140, 40, 60), "FOUNDRY")
		Kit.barrier(V(2, 4, 14), m * CFrame.new(-20, 0, 0))
		Kit.barrier(V(14, 4, 2), m * CFrame.new(-60, 0, 40))
		Kit.pipeRun(m * V(-140, 14, -96), m * V(-20, 14, -96), 2.4, RGB(110, 100, 120))
		Kit.pipeRun(m * V(-140, 18, -100), m * V(-40, 18, -100), 1.6, RGB(160, 80, 60))
		for _, x in { -130, -100, -70, -40 } do
			block("PipeSupport", V(1.2, 18, 1.2), m * CFrame.new(x, 9, -98), RGB(45, 45, 55), Enum.Material.Metal)
		end

		-- Grúa con caja colgando (decoración)
		deco("CraneArm", V(2, 2, 40), m * CFrame.new(-45, 34, 30), C.Yellow, Enum.Material.Metal)
		deco("CraneMast", V(2, 34, 2), m * CFrame.new(-45, 17, 50), C.Yellow, Enum.Material.Metal)
		deco("CraneCable", V(0.3, 10, 0.3), m * CFrame.new(-45, 28, 14), RGB(20, 20, 20), Enum.Material.Metal)
		Kit.metalCrate(m * CFrame.new(-45, 19, 14), 5, RGB(90, 90, 100), C.Yellow)

		-- Focos que barren el cielo
		local beam = deco("SkyBeam", V(1.5, 120, 1.5), m * CFrame.new(-120, 60, 100) * CFrame.Angles(math.rad(-15), 0, math.rad(12)), side == "A" and C.Cyan or C.Pink, Enum.Material.Neon)
		beam.Transparency = 0.75
		beam:SetAttribute("Sweep", 18)
	end)

	-- Pórticos de neón sobre los carriles con lámparas colgantes
	for _, z in { -45, 45 } do
		block("NeonGantry", V(2, 2, 2), CFrame.new(-60, 1, z), RGB(45, 45, 55), Enum.Material.Metal)
		block("NeonGantry", V(2, 2, 2), CFrame.new(60, 1, z), RGB(45, 45, 55), Enum.Material.Metal)
		deco("GantryPostA", V(1.4, 24, 1.4), CFrame.new(-60, 12, z), RGB(50, 50, 60), Enum.Material.Metal)
		deco("GantryPostB", V(1.4, 24, 1.4), CFrame.new(60, 12, z), RGB(50, 50, 60), Enum.Material.Metal)
		deco("GantryBeam", V(122, 1.6, 1.6), CFrame.new(0, 24, z), RGB(50, 50, 60), Enum.Material.Metal)
		deco("GantryNeon", V(122, 0.4, 1.7), CFrame.new(0, 23, z), z < 0 and C.Pink or C.Cyan, Enum.Material.Neon)
		for x = -45, 45, 30 do
			deco("LampCable", V(0.15, 6, 0.15), CFrame.new(x, 20, z), RGB(20, 20, 20), Enum.Material.Metal)
			local lamp = deco("HangingLamp", V(2.4, 0.8, 2.4), CFrame.new(x, 16.6, z), RGB(255, 210, 150), Enum.Material.Neon)
			Kit.lightCone(V(x, 16.2, z), 15, 1.2, 6, RGB(255, 205, 140))
			Kit.light(lamp, "SpotLight", RGB(255, 200, 140), 28, 2, Enum.NormalId.Bottom).Angle = 100
		end
	end

	-- Spawns y banderas
	local spawnStyle = { Floor = RGB(50, 52, 62), FloorMaterial = Enum.Material.DiamondPlate, Roof = RGB(45, 46, 56), RoofMaterial = Enum.Material.Metal }
	Kit.spawnArea(teams[1], CFrame.new(-145, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-145, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-112, 0, 10))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-112, 0, 10))

	-- Límites: muros de fábrica alrededor y chimeneas de fondo
	Kit.bounds(320, 220, 60)
	for x = -150, 150, 30 do
		for _, z in { -1, 1 } do
			local h = 26 + (math.abs(x) % 3) * 6
			block("BackFactory", V(30, h, 12), CFrame.new(x, h / 2, z * 117), WALL:Lerp(Color3.new(0, 0, 0), (math.abs(x) % 2) * 0.15), Enum.Material.CorrodedMetal)
			local stripe = deco("BackStripe", V(30.2, 0.6, 0.3), CFrame.new(x, h - 3, z * 110.9), (x / 30) % 2 == 0 and C.Cyan or C.Pink, Enum.Material.Neon)
			stripe.Transparency = 0.1
			deco("BackVertical", V(0.6, h - 6, 0.3), CFrame.new(x + 14, (h - 6) / 2, z * 110.9), (x / 30) % 2 == 0 and C.Pink or C.Cyan, Enum.Material.Neon)
			local window = deco("BackWindow", V(10, 4, 0.3), CFrame.new(x - 5, h * 0.45, z * 110.9), RGB(255, 180, 80), Enum.Material.Neon)
			window.Transparency = 0.35
		end
	end
	for z = -90, 90, 30 do
		for _, sx in { -1, 1 } do
			block("SideFactory", V(12, 30, 30), CFrame.new(sx * 168, 15, z), WALL, Enum.Material.CorrodedMetal)
		end
	end
	for i, p in { V(-120, 0, 160), V(-40, 0, 190), V(60, 0, 170), V(150, 0, 200), V(-160, 0, -170), V(20, 0, -190), V(130, 0, -160) } do
		Kit.smokestack(p, 50 + (i % 3) * 15)
	end

	-- Modos
	for _, p in {
		V(-130, 0.5, 45), V(-100, 0.5, -15), V(-60, 8.5, -60), V(-76, 10.5, 75), V(-45, 0.5, 30),
		V(-20, 0.5, -60), V(-110, 0.5, 85), V(-60, 0.5, 20), V(-15, 0.5, 60), V(-125, 0.5, -80),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, 0, 25), 9, 1)
	Kit.zone(V(-62, 8, -60), 9, 2)
	Kit.zone(V(62, 8, 60), 9, 3)
	Kit.zone(V(0, 0, -25), 9, 4)
	Kit.zone(V(-50, 0, 25), 10, 5)
	-- Realismo: suelo mojado con charcos que reflejan el neón, vapor y brasas en el aire
	for _, p in { Vector3.new(-56, 0, 24), Vector3.new(-40, 0, 34), Vector3.new(-11, 0, 64), Vector3.new(-16, 0, -56), Vector3.new(-121, 0, -76), Vector3.new(-126, 0, 49) } do
		Kit.puddle(p, 5.5)
		Kit.puddle(Kit.MIRROR * p, 5.5)
	end
	for _, p in { Vector3.new(-26, 0, -66), Vector3.new(-105, 0, -20), Vector3.new(-90, 0, 40) } do
		Kit.steamVent(CFrame.new(p), 1.4)
		Kit.steamVent(Kit.MIRROR * CFrame.new(p), 1.4)
	end
	Kit.dustMotes(CFrame.new(0, 12, 0), Vector3.new(70, 22, 70), Color3.fromRGB(255, 150, 60), 25)
	-- Losas de hormigón industrial con juntas, grietas y manchas de aceite de la maquinaria
	Kit.floorJoints(CFrame.new(), 300, 210, 12, Color3.fromRGB(38, 38, 42))
	Kit.symmetric(function(m)
		for i, spec in { { Vector3.new(-84, 0, -8), 9 }, { Vector3.new(-35, 0, -30), 8 }, { Vector3.new(-115, 0, 66), 10 } } do
			Kit.crack(m * spec[1], spec[2], i * 31)
		end
		for _, p in { Vector3.new(-66, 0, -34), Vector3.new(-100, 0, 30), Vector3.new(-30, 0, 80) } do
			Kit.oilStain(m * p, 3.2)
		end
		Kit.manhole(m * Vector3.new(-48, 0, -12))
	end)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">PastelPlaza</string>
              <string name="Source"><![CDATA[-- PASTEL PLAZA: arena compacta al estilo de los shooters más jugados de Roblox. Paredes lavanda con
-- pilares rosas, naranjas y amarillos, bordes naranjas, suelo de hierba, torre central de dos alturas,
-- casas laterales con azotea, muros en L, plataformas de hierba y pinos de dibujo animado.
-- Hecho para el estilo "Cartoon" y la textura de cuadrícula (ver assets/textures/LEEME.md).
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)

local Map = {
	Id = "PastelPlaza",
	Name = "Pastel Plaza",
	Icon = "🏰",
	Description = "Arena · mediodía · torre central y azoteas",
}

Map.Lighting = {
	ClockTime = 13.8,
	Brightness = 3.2,
	Exposure = 0.05,
	Ambient = Color3.fromRGB(120, 118, 140),
	OutdoorAmbient = Color3.fromRGB(165, 165, 185),
	Atmosphere = { Density = 0.22, Offset = 0.2, Color = Color3.fromRGB(205, 225, 255), Decay = Color3.fromRGB(120, 150, 210), Glare = 0, Haze = 0.4 },
	Color = { Saturation = 0.2, Contrast = 0.06, Brightness = 0.03, Tint = Color3.fromRGB(255, 252, 248) },
	Bloom = { Intensity = 0.35, Size = 22, Threshold = 2 },
	Clouds = 0.55,
	SunRays = 0.04,
	ShadowSoftness = 0.3,
	Wind = Vector3.new(3, 0, 1),
}

local V = Vector3.new
local RGB = Color3.fromRGB

local WALL = RGB(168, 162, 208) -- lavanda
local WALL_DARK = RGB(140, 134, 186)
local TRIM = RGB(255, 165, 50) -- naranja de los bordes
local PILLARS = { RGB(236, 92, 124), RGB(255, 170, 60), RGB(255, 214, 70) }
local GRASS = RGB(96, 206, 98)
local PLAZA = RGB(210, 205, 235)

local LENGTH, WIDTH = 240, 150

-- Muro con borde naranja encima
local function wall(name, cf, size, color)
	local part = Kit.block(name, size, cf * CFrame.new(0, size.Y / 2, 0), color or WALL, Enum.Material.SmoothPlastic)
	Kit.deco(name .. "Cap", V(size.X + 0.4, 0.7, size.Z + 0.4), cf * CFrame.new(0, size.Y + 0.35, 0), TRIM, Enum.Material.SmoothPlastic)
	return part
end

local function pillar(cf, height, color)
	Kit.block("Pillar", V(3.2, height, 3.2), cf * CFrame.new(0, height / 2, 0), color, Enum.Material.SmoothPlastic)
	Kit.deco("PillarCap", V(3.8, 0.8, 3.8), cf * CFrame.new(0, height + 0.4, 0), TRIM, Enum.Material.SmoothPlastic)
end

-- Cobertura baja con borde naranja
local function cover(cf, size)
	wall("Cover", cf, size, WALL_DARK)
end

-- Plataforma de hierba elevada (lados lavanda y tapa verde) con un escalón para subir
local function grassPlatform(cf, size, height, stepSide)
	Kit.block("PlatformBase", V(size.X, height, size.Z), cf * CFrame.new(0, height / 2, 0), WALL, Enum.Material.SmoothPlastic)
	Kit.block("PlatformTop", V(size.X + 0.6, 0.5, size.Z + 0.6), cf * CFrame.new(0, height + 0.1, 0), GRASS, Enum.Material.SmoothPlastic)
	Kit.block("PlatformStep", V(4, height / 2, 6), cf * CFrame.new(stepSide * (size.X / 2 + 2), height / 4, 0), WALL_DARK, Enum.Material.SmoothPlastic)
end

-- Casa con puerta hacia el centro, ventanas, azotea con murete y escalera exterior
local function house(m, cf)
	local w, d, h, t = 22, 16, 11, 1.4
	-- Paredes: la de +X (hacia el centro) con puerta; la de -Z (hacia la calle) con dos ventanas
	wall("HouseWall", cf * CFrame.new(0, 0, d / 2 - t / 2), V(w, h, t))
	wall("HouseWall", cf * CFrame.new(-w / 2 + t / 2, 0, 0), V(t, h, d - 2 * t))
	-- Pared con puerta (hueco de 5 de ancho y 7 de alto)
	local sideLen = (d - 2 * t - 5) / 2
	for _, s in { -1, 1 } do
		Kit.block("HouseWall", V(t, h, sideLen), cf * CFrame.new(w / 2 - t / 2, h / 2, s * (2.5 + sideLen / 2)), WALL, Enum.Material.SmoothPlastic)
	end
	Kit.block("HouseLintel", V(t, h - 7, 5), cf * CFrame.new(w / 2 - t / 2, 7 + (h - 7) / 2, 0), WALL, Enum.Material.SmoothPlastic)
	-- Pared con ventanas (de 4 de ancho, entre y=4 y y=7)
	local front = cf * CFrame.new(0, 0, -d / 2 + t / 2)
	Kit.block("HouseWallLow", V(w, 4, t), front * CFrame.new(0, 2, 0), WALL, Enum.Material.SmoothPlastic)
	Kit.block("HouseWallHigh", V(w, h - 7, t), front * CFrame.new(0, 7 + (h - 7) / 2, 0), WALL, Enum.Material.SmoothPlastic)
	for _, x in { -w / 2 + 2.5, 0, w / 2 - 2.5 } do
		Kit.block("HouseWallMid", V(x == 0 and 5 or 5, 3, t), front * CFrame.new(x, 5.5, 0), WALL, Enum.Material.SmoothPlastic)
	end
	-- Esquinas de color, tejado y murete
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			pillar(cf * CFrame.new(x * (w / 2), 0, z * (d / 2)), h + 0.5, PILLARS[(x + z) % 3 + 1])
		end
	end
	Kit.block("HouseRoof", V(w, 1, d), cf * CFrame.new(0, h + 0.5, 0), WALL_DARK, Enum.Material.SmoothPlastic)
	for _, z in { -1, 1 } do
		wall("RoofParapet", cf * CFrame.new(0, h + 1, z * (d / 2 - 0.4)), V(w - 4, 1.4, 0.8), WALL)
	end
	-- Escalera exterior por el lado de fuera hasta la azotea
	Kit.stairs((cf * CFrame.new(-w / 2 - 3, 0, -d / 2 + 1)).Position, (cf * CFrame.new(-w / 2 - 3, h + 1, d / 2 - 3)).Position, 5, WALL_DARK, Enum.Material.SmoothPlastic)
	Kit.crate(cf * CFrame.new(-4, 0, 3), 4)
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	Kit.applyLighting(Map.Lighting)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Suelo de hierba, plaza central y caminos
	block("Floor", V(LENGTH + 40, 2, WIDTH + 40), CFrame.new(0, -1, 0), GRASS, Enum.Material.SmoothPlastic)
	block("Plaza", V(84, 0.2, 64), CFrame.new(0, 0.1, 0), PLAZA, Enum.Material.SmoothPlastic)

	-- Muro perimetral con pilares de colores y borde naranja
	for _, z in { -1, 1 } do
		wall("OuterWall", CFrame.new(0, 0, z * (WIDTH / 2 + 1.5)), V(LENGTH + 6, 22, 3))
		for i, x in { -108, -78, -48, -18, 18, 48, 78, 108 } do
			pillar(CFrame.new(x, 0, z * (WIDTH / 2)), 23, PILLARS[i % 3 + 1])
		end
	end
	for _, x in { -1, 1 } do
		wall("OuterWall", CFrame.new(x * (LENGTH / 2 + 1.5), 0, 0), V(3, 22, WIDTH + 6))
		for i, z in { -55, -20, 20, 55 } do
			pillar(CFrame.new(x * (LENGTH / 2), 0, z), 23, PILLARS[i % 3 + 1])
		end
	end

	-- Torre central: plataforma a 10 de altura sobre cuatro pilares, con muretes
	local deckY = 10
	block("TowerDeck", V(24, 1.2, 24), CFrame.new(0, deckY, 0), WALL_DARK, Enum.Material.SmoothPlastic)
	deco("TowerDeckTrim", V(24.6, 0.5, 24.6), CFrame.new(0, deckY - 0.75, 0), TRIM, Enum.Material.SmoothPlastic)
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			pillar(CFrame.new(x * 10.5, 0, z * 10.5), deckY - 0.6, PILLARS[(x + z) % 3 + 1])
		end
	end
	cover(CFrame.new(0, 0, 0), V(8, 3.5, 2))
	Kit.symmetric(function(m)
		-- Muretes de la torre (con hueco donde llega la escalera)
		wall("TowerParapet", m * CFrame.new(0, deckY + 0.6, -11.6), V(24, 1.4, 0.8))
		wall("TowerParapet", m * CFrame.new(-11.6, deckY + 0.6, 3.75), V(0.8, 1.4, 16.5))
		wall("TowerParapet", m * CFrame.new(-11.6, deckY + 0.6, -10.75), V(0.8, 1.4, 2.5))
		Kit.stairs((m * CFrame.new(-28, 0, -7)).Position, (m * CFrame.new(-12.5, deckY + 0.6, -7)).Position, 5, WALL_DARK, Enum.Material.SmoothPlastic)
	end)

	Kit.symmetric(function(m, side)
		-- Camino de baldosas desde la base al centro
		block("Path", V(52, 0.2, 10), m * CFrame.new(-66, 0.1, 0), PLAZA, Enum.Material.SmoothPlastic)

		house(m, m * CFrame.new(-55, 0, 45))

		-- Muro en L y coberturas bajas
		wall("LWall", m * CFrame.new(-62, 0, -25), V(2, 8, 16))
		wall("LWall", m * CFrame.new(-55, 0, -32), V(12, 8, 2))
		cover(m * CFrame.new(-30, 0, -13), V(10, 3.5, 2))
		cover(m * CFrame.new(-48, 0, 8), V(2, 3.5, 10))
		cover(m * CFrame.new(-75, 0, 20), V(8, 3.5, 2))
		cover(m * CFrame.new(-22, 0, -38), V(2, 3.5, 8))
		cover(m * CFrame.new(-86, 0, -52), V(8, 3.5, 2))

		-- Plataformas de hierba elevadas
		grassPlatform(m * CFrame.new(-35, 0, 32), V(14, 0, 14), 3, 1)
		grassPlatform(m * CFrame.new(-78, 0, -40), V(12, 0, 12), 3, 1)

		-- Barriles, cajas y vegetación
		Kit.barrel(m * CFrame.new(-40, 0, -55), side == "A" and RGB(235, 80, 90) or RGB(70, 140, 255))
		Kit.barrel(m * CFrame.new(-42.5, 0, -52.5), RGB(255, 190, 60))
		Kit.crate(m * CFrame.new(-58, 0, 22), 4)
		Kit.crate(m * CFrame.new(-86, 0, 32), 4)
		Kit.crate(m * CFrame.new(-86, 0, 36.5), 3)
		for _, p in { V(-100, 0, 60), V(-15, 0, 64), V(-60, 0, -66) } do
			Kit.bush(m * p, 1.1, RGB(70, 190, 80))
		end
		for i, p in { V(-30, 0, 55), V(-75, 0, -62), V(-10, 0, -34), V(-96, 0, 44), V(-44, 0, 26) } do
			Kit.flowers(m * p, 3, i * 19)
		end
		for i, p in { V(-50, 0, -62), V(-85, 0, 62), V(-25, 0, 20), V(-68, 0, 8) } do
			Kit.grassTuft(m * p, 1.1, i * 3)
		end
		for _, p in { V(-110, 0, 64), V(-62, 0, 66), V(-22, 0, -66) } do
			Kit.cartoonPine(m * p, 1)
		end
	end)

	-- Bases y banderas
	local spawnStyle = { Floor = PLAZA, Roof = WALL_DARK }
	Kit.spawnArea(teams[1], CFrame.new(-105, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-105, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-80, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-80, 0, 0))

	-- Límites y fondo: pinos y colinas verdes detrás de los muros
	Kit.bounds(LENGTH, WIDTH, 50)
	for x = -150, 150, 26 do
		for _, z in { -1, 1 } do
			Kit.cartoonPine(V(x + z * 9, 0, z * (92 + (math.abs(x) % 17))), 1.4 + (math.abs(x) % 3) * 0.15, true)
		end
	end
	for x = -200, 200, 70 do
		for _, z in { -1, 1 } do
			Kit.naturalHill(V(x, -18, z * 150), 50, Enum.Material.Grass, { Inward = V(0, 0, -z), Top = Enum.Material.LeafyGrass, RockCount = 1 })
		end
	end
	for _, sx in { -1, 1 } do
		for z = -100, 100, 70 do
			Kit.naturalHill(V(sx * 190, -18, z), 52, Enum.Material.Grass, { Inward = V(-sx, 0, 0), Top = Enum.Material.LeafyGrass, RockCount = 1 })
		end
	end

	-- Modos
	for _, p in {
		V(-100, 0.5, 50), V(-80, 0.5, -20), V(-60, 0.5, 0), V(-40, 0.5, 20), V(-25, 0.5, -25),
		V(-55, 0.5, 45), V(-35, 3.85, 32), V(-12, 0.5, 50), V(-92, 0.5, -64), V(-3, deckY + 1.1, -5),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, deckY + 0.6, 0), 7, 1)
	Kit.zone(V(-55, 0, 45), 6, 2)
	Kit.zone(V(55, 0, -45), 6, 3)
	Kit.zone(V(-35, 3.35, 32), 6, 4)
	Kit.zone(V(35, 3.35, -32), 6, 5)
	Kit.dustMotes(CFrame.new(0, 8, 0), V(120, 14, 80), Color3.fromRGB(150, 230, 255), 16)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">SakuraGarden</string>
              <string name="Source"><![CDATA[-- JARDÍN SAKURA: arena compacta en un jardín japonés de estilo cartoon. Pagoda central jugable de dos
-- plantas, toriis rojos en las entradas, estanques con nenúfares y puentes de madera, cerezos en flor
-- con pétalos cayendo, linternas de piedra, bambú, casas de té y una montaña nevada de fondo.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)

local Map = {
	Id = "SakuraGarden",
	Name = "Jardín Sakura",
	Icon = "🌸",
	Description = "Jardín japonés · tarde · pagoda y estanques",
}

Map.Lighting = {
	ClockTime = 16.3,
	Brightness = 3,
	Exposure = 0.05,
	Ambient = Color3.fromRGB(125, 112, 130),
	OutdoorAmbient = Color3.fromRGB(170, 158, 175),
	Atmosphere = { Density = 0.24, Offset = 0.2, Color = Color3.fromRGB(255, 220, 230), Decay = Color3.fromRGB(200, 150, 190), Glare = 0, Haze = 0.6 },
	Color = { Saturation = 0.18, Contrast = 0.06, Brightness = 0.03, Tint = Color3.fromRGB(255, 244, 246) },
	Bloom = { Intensity = 0.35, Size = 24, Threshold = 2 },
	Clouds = 0.5,
	CloudColor = Color3.fromRGB(255, 236, 242),
	SunRays = 0.05,
	ShadowSoftness = 0.3,
	Wind = Vector3.new(4, 0, 1.5),
	TerrainColors = {
		Grass = Color3.fromRGB(110, 190, 90),
		LeafyGrass = Color3.fromRGB(240, 150, 190),
		Snow = Color3.fromRGB(245, 248, 255),
		Rock = Color3.fromRGB(120, 115, 130),
	},
}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad

local GRASS = RGB(120, 196, 96)
local STONE = RGB(196, 192, 205)
local STONE_DARK = RGB(150, 146, 160)
local PLASTER = RGB(246, 240, 232)
local WOOD = RGB(150, 98, 60)
local WOOD_DARK = RGB(100, 64, 42)
local TILE = RGB(60, 110, 120) -- tejas verde azulado
local RED = RGB(220, 50, 45)
local PINK = { RGB(255, 170, 205), RGB(250, 140, 185), RGB(255, 182, 212) } -- (saturación > 0,22: el estilo Cartoon no los vuelve lavanda)
local WATER = RGB(70, 170, 210)

local LENGTH, WIDTH = 230, 150

-- Cerezo: tronco inclinado y copa de bolas rosas
local function cherryTree(position, scale, seed)
	local rng = Random.new(seed or 1)
	scale = scale or 1
	local lean = CFrame.Angles(rad(rng:NextNumber(-8, 8)), 0, rad(rng:NextNumber(-8, 8)))
	Kit.cylinder("CherryTrunk", 8 * scale, 1.3 * scale, CFrame.new(position) * lean * CFrame.new(0, 4 * scale, 0), WOOD_DARK, Enum.Material.Wood)
	for i = 1, 4 do
		local offset = V(rng:NextNumber(-2.5, 2.5), 8.5 + rng:NextNumber(-0.5, 2), rng:NextNumber(-2.5, 2.5)) * scale
		local leaf = Kit.ball("Blossom", rng:NextNumber(5, 7.5) * scale, CFrame.new(position + offset), PINK[(i % 3) + 1], Enum.Material.SmoothPlastic, true)
		leaf.CastShadow = true
	end
end

-- Torii: dos pilares rojos, viga superior curvada y viga intermedia
local function torii(cf)
	for _, s in { -1, 1 } do
		Kit.cylinder("ToriiPillar", 13, 1.4, cf * CFrame.new(s * 6, 6.5, 0), RED, Enum.Material.SmoothPlastic)
		Kit.cylinder("ToriiFoot", 1, 1.9, cf * CFrame.new(s * 6, 0.5, 0), RGB(40, 36, 40), Enum.Material.SmoothPlastic, nil, true)
	end
	Kit.deco("ToriiKasagi", V(17, 1.2, 2), cf * CFrame.new(0, 13.6, 0), RGB(40, 36, 40), Enum.Material.SmoothPlastic)
	Kit.deco("ToriiShimaki", V(16, 1, 1.6), cf * CFrame.new(0, 12.6, 0), RED, Enum.Material.SmoothPlastic)
	for _, s in { -1, 1 } do
		Kit.deco("ToriiTip", V(2, 0.8, 2), cf * CFrame.new(s * 8.5, 14.3, 0) * CFrame.Angles(0, 0, rad(s * 12)), RGB(40, 36, 40), Enum.Material.SmoothPlastic)
	end
	Kit.deco("ToriiNuki", V(15, 0.8, 1), cf * CFrame.new(0, 10.4, 0), RED, Enum.Material.SmoothPlastic)
end

-- Linterna de piedra con luz cálida
local function lantern(cf)
	Kit.block("LanternBase", V(1.8, 1, 1.8), cf * CFrame.new(0, 0.5, 0), STONE_DARK, Enum.Material.SmoothPlastic)
	Kit.cylinder("LanternPost", 2.4, 0.8, cf * CFrame.new(0, 2.2, 0), STONE, Enum.Material.SmoothPlastic)
	local box = Kit.block("LanternBox", V(1.5, 1.3, 1.5), cf * CFrame.new(0, 4, 0), STONE, Enum.Material.SmoothPlastic)
	local glow = Kit.deco("LanternGlow", V(1.55, 0.7, 1.55), cf * CFrame.new(0, 4, 0), RGB(255, 210, 140), Enum.Material.Neon)
	Kit.light(glow, "PointLight", RGB(255, 200, 130), 12, 1)
	Kit.deco("LanternRoof", V(2.6, 0.5, 2.6), cf * CFrame.new(0, 4.9, 0) * CFrame.Angles(0, rad(45), 0), STONE_DARK, Enum.Material.SmoothPlastic)
	Kit.ball("LanternTop", 0.6, cf * CFrame.new(0, 5.4, 0), STONE_DARK, Enum.Material.SmoothPlastic, true)
	return box
end

-- Grupo de bambú (decorativo, se atraviesa)
local function bamboo(position, seed)
	local rng = Random.new(seed or 2)
	for i = 1, 5 do
		local h = rng:NextNumber(9, 15)
		local offset = V(rng:NextNumber(-1.5, 1.5), 0, rng:NextNumber(-1.5, 1.5))
		local stalk = Kit.cylinder("Bamboo", h, 0.45, CFrame.new(position + offset + V(0, h / 2, 0)), RGB(120, 190, 80):Lerp(RGB(90, 160, 60), i / 5), Enum.Material.SmoothPlastic, nil, true)
		stalk.CastShadow = false
		Kit.deco("BambooLeaf", V(0.1, 0.5, 2.2), CFrame.new(position + offset + V(0, h - 0.5, 0)) * CFrame.Angles(rad(30), i, 0), RGB(100, 180, 70), Enum.Material.SmoothPlastic)
	end
end

-- Estanque con borde de piedras, nenúfares y peces
local function pond(position, radius, seed)
	local rng = Random.new(seed or 3)
	local water = Kit.cylinder("Pond", 0.3, radius * 2, CFrame.new(position + V(0, 0.08, 0)), WATER, Enum.Material.SmoothPlastic, nil, true)
	water.Reflectance = 0.25
	local rim = Kit.cylinder("PondRim", 0.2, radius * 2 + 2, CFrame.new(position + V(0, 0.05, 0)), STONE_DARK, Enum.Material.SmoothPlastic, nil, true)
	rim.CastShadow = false
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
		local s = rng:NextNumber(1.2, 2.2)
		Kit.block("PondStone", V(s, s * 0.6, s), CFrame.new(position + V(math.cos(a) * (radius + 0.8), s * 0.25, math.sin(a) * (radius + 0.8))) * CFrame.Angles(0, a, 0), STONE, Enum.Material.SmoothPlastic)
	end
	for _ = 1, 4 do
		local p = position + V(rng:NextNumber(-0.6, 0.6) * radius, 0.26, rng:NextNumber(-0.6, 0.6) * radius)
		Kit.cylinder("LilyPad", 0.06, rng:NextNumber(1.4, 2.2), CFrame.new(p), RGB(90, 180, 80), Enum.Material.SmoothPlastic, nil, true)
		if rng:NextNumber() < 0.5 then
			Kit.ball("LilyFlower", 0.5, CFrame.new(p + V(0, 0.2, 0)), RGB(255, 190, 220), Enum.Material.SmoothPlastic, true)
		end
	end
	for _ = 1, 3 do
		local p = position + V(rng:NextNumber(-0.5, 0.5) * radius, 0.25, rng:NextNumber(-0.5, 0.5) * radius)
		local fish = Kit.deco("Koi", V(0.5, 0.1, 1.4), CFrame.new(p) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), rng:NextNumber() < 0.5 and RGB(255, 130, 40) or RGB(255, 245, 240), Enum.Material.SmoothPlastic)
		fish.CastShadow = false
	end
end

-- Casa de té: paredes de madera y papel, tejado de tejas, dos puertas
local function teaHouse(cf)
	local w, d, h = 18, 14, 9
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			Kit.block("TeaPost", V(1.2, h, 1.2), cf * CFrame.new(x * w / 2, h / 2, z * d / 2), WOOD_DARK, Enum.Material.Wood)
		end
	end
	-- Paredes largas (con puerta en el centro de la que mira al centro del mapa)
	for _, z in { -1, 1 } do
		local face = cf * CFrame.new(0, 0, z * d / 2)
		for _, x in { -1, 1 } do
			Kit.block("TeaWall", V(w / 2 - 2.5, h, 0.6), face * CFrame.new(x * (w / 4 + 1.25), h / 2, 0), PLASTER, Enum.Material.SmoothPlastic)
			Kit.deco("TeaBeam", V(w / 2 - 2.5, 0.4, 0.7), face * CFrame.new(x * (w / 4 + 1.25), 3.5, 0), WOOD, Enum.Material.Wood)
		end
		Kit.block("TeaLintel", V(5, h - 6.5, 0.6), face * CFrame.new(0, 6.5 + (h - 6.5) / 2, 0), PLASTER, Enum.Material.SmoothPlastic)
	end
	for _, x in { -1, 1 } do
		Kit.block("TeaWall", V(0.6, h, d), cf * CFrame.new(x * w / 2, h / 2, 0), PLASTER, Enum.Material.SmoothPlastic)
		for _, z in { -3, 3 } do
			Kit.deco("PaperWindow", V(0.7, 2.6, 3), cf * CFrame.new(x * w / 2, 5, z), RGB(255, 250, 230), Enum.Material.SmoothPlastic)
		end
	end
	Kit.block("TeaFloor", V(w, 0.6, d), cf * CFrame.new(0, 0.3, 0), WOOD, Enum.Material.WoodPlanks)
	-- Tejado de dos aguas en voladizo
	for _, s in { -1, 1 } do
		Kit.deco("TeaRoof", V(w + 4, 0.8, d / 2 + 3), cf * CFrame.new(0, h + 1.6, s * (d / 4 + 0.6)) * CFrame.Angles(rad(s * 22), 0, 0), TILE, Enum.Material.SmoothPlastic)
	end
	Kit.deco("TeaRidge", V(w + 4.4, 0.8, 1.2), cf * CFrame.new(0, h + 3.2, 0), RGB(40, 70, 80), Enum.Material.SmoothPlastic)
	Kit.block("TeaCeiling", V(w, 0.6, d), cf * CFrame.new(0, h + 0.3, 0), WOOD, Enum.Material.Wood)
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	Kit.applyLighting(Map.Lighting)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	block("Floor", V(LENGTH + 40, 2, WIDTH + 40), CFrame.new(0, -1, 0), GRASS, Enum.Material.SmoothPlastic)
	block("CenterGravel", V(60, 0.2, 60), CFrame.new(0, 0.1, 0), RGB(226, 222, 214), Enum.Material.SmoothPlastic)

	-- Muro de jardín blanco con tejadillo de tejas
	for _, z in { -1, 1 } do
		block("GardenWall", V(LENGTH + 4, 14, 2.5), CFrame.new(0, 7, z * (WIDTH / 2 + 1.25)), PLASTER, Enum.Material.SmoothPlastic)
		deco("GardenWallTile", V(LENGTH + 8, 1, 4.5), CFrame.new(0, 14.5, z * (WIDTH / 2 + 1.25)), TILE, Enum.Material.SmoothPlastic)
		deco("GardenWallBase", V(LENGTH + 4.4, 2.5, 2.9), CFrame.new(0, 1.25, z * (WIDTH / 2 + 1.25)), STONE_DARK, Enum.Material.SmoothPlastic)
	end
	for _, x in { -1, 1 } do
		block("GardenWall", V(2.5, 14, WIDTH + 4), CFrame.new(x * (LENGTH / 2 + 1.25), 7, 0), PLASTER, Enum.Material.SmoothPlastic)
		deco("GardenWallTile", V(4.5, 1, WIDTH + 8), CFrame.new(x * (LENGTH / 2 + 1.25), 14.5, 0), TILE, Enum.Material.SmoothPlastic)
	end

	-- Pagoda central: planta baja abierta con columnas rojas y núcleo; segunda planta a 10 de altura
	block("PagodaBase", V(26, 1.4, 26), CFrame.new(0, 0.7, 0), STONE, Enum.Material.SmoothPlastic)
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			Kit.cylinder("PagodaColumn", 9, 1.6, CFrame.new(x * 10, 5.9, z * 10), RED, Enum.Material.SmoothPlastic)
		end
	end
	block("PagodaCore", V(6, 9, 6), CFrame.new(0, 5.9, 0), PLASTER, Enum.Material.SmoothPlastic)
	block("PagodaDeck", V(24, 1, 24), CFrame.new(0, 10.9, 0), WOOD, Enum.Material.WoodPlanks)
	deco("PagodaRoof1", V(32, 0.8, 32), CFrame.new(0, 10.1, 0), TILE, Enum.Material.SmoothPlastic)
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			Kit.cylinder("PagodaColumn2", 8, 1.2, CFrame.new(x * 9, 15.4, z * 9), RED, Enum.Material.SmoothPlastic)
		end
	end
	block("PagodaRoof2", V(24, 1, 24), CFrame.new(0, 19.9, 0), TILE, Enum.Material.SmoothPlastic)
	deco("PagodaRoof2Top", V(14, 2, 14), CFrame.new(0, 21.4, 0), TILE, Enum.Material.SmoothPlastic)
	Kit.cylinder("PagodaSpire", 6, 0.6, CFrame.new(0, 25, 0), RGB(230, 180, 60), Enum.Material.SmoothPlastic, nil, true)
	for i = 1, 3 do
		Kit.cylinder("SpireRing", 0.3, 1.6 - i * 0.3, CFrame.new(0, 22.6 + i * 1.2, 0), RGB(230, 180, 60), Enum.Material.SmoothPlastic, nil, true)
	end
	Kit.symmetric(function(m)
		-- Barandilla de la segunda planta (con hueco para la escalera) y escalera
		Kit.railing((m * CFrame.new(-11.5, 11.4, 11.5)).Position, (m * CFrame.new(11.5, 11.4, 11.5)).Position, 2.6, RED)
		Kit.railing((m * CFrame.new(-11.5, 11.4, -11.5)).Position, (m * CFrame.new(-11.5, 11.4, 1.5)).Position, 2.6, RED)
		Kit.railing((m * CFrame.new(-11.5, 11.4, 7.5)).Position, (m * CFrame.new(-11.5, 11.4, 11.5)).Position, 2.6, RED)
		Kit.stairs((m * CFrame.new(-28, 0, 4.5)).Position, (m * CFrame.new(-12.5, 11.4, 4.5)).Position, 5, WOOD, Enum.Material.WoodPlanks)
		lantern(m * CFrame.new(-15, 0, -15))
	end)

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(235, 70, 80) or RGB(70, 140, 255)
		-- Camino de piedra desde la base
		block("StonePath", V(46, 0.2, 8), m * CFrame.new(-66, 0.1, 0), STONE, Enum.Material.SmoothPlastic)
		for i = 0, 5 do
			deco("SteppingStone", V(3, 0.25, 3), m * CFrame.new(-40 + i * 4.5, 0.15, -20 - (i % 2) * 2) * CFrame.Angles(0, i, 0), STONE, Enum.Material.SmoothPlastic)
		end
		torii(m * CFrame.new(-80, 0, 0) * CFrame.Angles(0, rad(90), 0))

		-- Estanque con puente de madera
		pond(m * V(-45, 0, 38), 11, side == "A" and 5 or 6)
		block("Bridge", V(4, 0.6, 26), m * CFrame.new(-45, 0.9, 38), WOOD, Enum.Material.WoodPlanks)
		for _, x in { -2.2, 2.2 } do
			Kit.railing((m * CFrame.new(-45 + x, 1.2, 26)).Position, (m * CFrame.new(-45 + x, 1.2, 50)).Position, 1.8, RED)
		end

		-- Casa de té y coberturas de piedra con tejadillo
		teaHouse(m * CFrame.new(-62, 0, -42))
		for _, spec in { { V(-28, 0, -12), V(10, 3.5, 2) }, { V(-50, 0, 10), V(2, 3.5, 10) }, { V(-75, 0, 28), V(8, 3.5, 2) }, { V(-24, 0, 30), V(2, 3.5, 8) }, { V(-90, 0, -55), V(8, 3.5, 2) } } do
			local p, size = spec[1], spec[2]
			block("StoneWall", size, m * CFrame.new(p + V(0, size.Y / 2, 0)), STONE_DARK, Enum.Material.SmoothPlastic)
			deco("StoneWallTile", V(size.X + 0.8, 0.5, size.Z + 0.8), m * CFrame.new(p + V(0, size.Y + 0.25, 0)), TILE, Enum.Material.SmoothPlastic)
		end
		Kit.crate(m * CFrame.new(-36, 0, -40), 4)
		Kit.crate(m * CFrame.new(-36, 0, -35.5), 3)
		Kit.barrel(m * CFrame.new(-84, 0, 40), teamColor)

		-- Vegetación: cerezos, bambú, flores y linternas
		for i, p in { V(-100, 0, 58), V(-28, 0, 62), V(-70, 0, 62), V(-98, 0, -62), V(-20, 0, -62) } do
			cherryTree(m * p, 1 + (i % 2) * 0.2, i + (side == "A" and 0 or 10))
		end
		bamboo(m * V(-108, 0, 30), side == "A" and 8 or 9)
		bamboo(m * V(-30, 0, -50), side == "A" and 10 or 11)
		for i, p in { V(-56, 0, 22), V(-30, 0, 46), V(-80, 0, -30), V(-12, 0, -44) } do
			Kit.flowers(m * p, 3, i * 7 + (side == "A" and 0 or 50))
		end
		lantern(m * CFrame.new(-72, 0, 8))
		lantern(m * CFrame.new(-72, 0, -8))
		lantern(m * CFrame.new(-56, 0, 50))
	end)

	-- Pétalos de cerezo cayendo sobre todo el jardín
	local sky = deco("FallingPetals", V(LENGTH, 1, WIDTH), CFrame.new(0, 34, 0), RGB(255, 190, 220), Enum.Material.SmoothPlastic)
	sky.Transparency = 1
	sky.CastShadow = false
	local petals = Instance.new("ParticleEmitter")
	petals.Name = "Petals"
	petals.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	petals.Color = ColorSequence.new(RGB(255, 180, 210), RGB(255, 230, 240))
	petals.Size = NumberSequence.new(0.3)
	petals.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.9, 0.1), NumberSequenceKeypoint.new(1, 1) })
	petals.Lifetime = NumberRange.new(10, 13)
	petals.Speed = NumberRange.new(2.5, 3.5)
	petals.SpreadAngle = Vector2.new(25, 25)
	petals.RotSpeed = NumberRange.new(-120, 120)
	petals.Acceleration = V(0.4, 0, 0.1)
	petals.Rate = 28
	petals.WindAffectsDrag = true
	petals.EmissionDirection = Enum.NormalId.Bottom
	petals.Parent = sky

	-- Bases y banderas
	local spawnStyle = { Floor = STONE, Roof = TILE }
	Kit.spawnArea(teams[1], CFrame.new(-100, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-100, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-70, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-70, 0, 0))

	-- Límites y fondo: cerezos fuera del muro, colinas en flor y montaña nevada
	Kit.bounds(LENGTH, WIDTH, 50)
	for x = -140, 140, 28 do
		for _, z in { -1, 1 } do
			local position = V(x + z * 10, 0, z * (90 + (math.abs(x) % 13)))
			Kit.cylinder("CherryTrunk", 7, 1.4, CFrame.new(position + V(0, 3.5, 0)), WOOD_DARK, Enum.Material.Wood)
			local crown = Kit.ball("Blossom", 9, CFrame.new(position + V(0, 9, 0)), PINK[(math.abs(x) // 28) % 3 + 1], Enum.Material.SmoothPlastic, true)
			crown.CastShadow = false
		end
	end
	for x = -200, 200, 70 do
		for _, z in { -1, 1 } do
			Kit.naturalHill(V(x, -18, z * 150), 50, Enum.Material.Grass, { Inward = V(0, 0, -z), Top = Enum.Material.LeafyGrass, TopCount = 6, RockCount = 1 })
		end
	end
	Kit.naturalHill(V(260, -40, 120), 95, Enum.Material.Rock, { Inward = V(-1, 0, 0), Top = Enum.Material.Snow, TopCount = 6, Rock = Enum.Material.Slate })
	for _, sx in { -1, 1 } do
		for z = -100, 100, 70 do
			Kit.naturalHill(V(sx * 185, -18, z), 50, Enum.Material.Grass, { Inward = V(-sx, 0, 0), Top = Enum.Material.LeafyGrass, RockCount = 1 })
		end
	end

	-- Modos
	for _, p in {
		V(-98, 0.5, 50), V(-80, 0.5, -20), V(-58, 0.5, 0), V(-38, 0.5, 18), V(-26, 0.5, -26),
		V(-62, 1.1, -42), V(-45, 1.7, 30), V(-12, 0.5, 52), V(-92, 0.5, -64), V(-4, 11.9, -6),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, 11.4, 0), 7, 1)
	Kit.zone(V(-62, 0.6, -42), 6, 2)
	Kit.zone(V(62, 0.6, 42), 6, 3)
	Kit.zone(V(-45, 1.2, 38), 6, 4)
	Kit.zone(V(45, 1.2, -38), 6, 5)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">TikiBeach</string>
              <string name="Source"><![CDATA[-- PLAYA TIKI: isla tropical de estilo cartoon rodeada de mar. Torre de socorrista jugable en el centro,
-- chozas tiki con techo de paja, palmeras, sombrillas y toallas, tablas de surf, laguna turquesa,
-- antorchas tiki, sacos de arena y un muelle con barcas.
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)

local Map = {
	Id = "TikiBeach",
	Name = "Playa Tiki",
	Icon = "🏝",
	Description = "Isla tropical · mediodía · torre y chozas",
}

Map.Lighting = {
	ClockTime = 14.4,
	Brightness = 3.3,
	Exposure = 0.05,
	Ambient = Color3.fromRGB(125, 122, 130),
	OutdoorAmbient = Color3.fromRGB(175, 170, 175),
	Atmosphere = { Density = 0.22, Offset = 0.2, Color = Color3.fromRGB(200, 230, 255), Decay = Color3.fromRGB(110, 170, 220), Glare = 0, Haze = 0.5 },
	Color = { Saturation = 0.2, Contrast = 0.06, Brightness = 0.03, Tint = Color3.fromRGB(255, 250, 240) },
	Bloom = { Intensity = 0.35, Size = 22, Threshold = 2 },
	Clouds = 0.45,
	SunRays = 0.05,
	ShadowSoftness = 0.3,
	Wind = Vector3.new(5, 0, 2),
	Water = { Color = Color3.fromRGB(30, 170, 190), Reflectance = 0.7, Transparency = 0.5, WaveSize = 0.18, WaveSpeed = 9 },
	TerrainColors = {
		Sand = Color3.fromRGB(240, 215, 150),
		Rock = Color3.fromRGB(150, 135, 120),
		Grass = Color3.fromRGB(110, 200, 90),
		LeafyGrass = Color3.fromRGB(70, 170, 80),
	},
}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad

local SAND = RGB(244, 218, 150)
local WOOD = RGB(170, 115, 65)
local WOOD_DARK = RGB(120, 78, 45)
local THATCH = RGB(222, 182, 98)
local LAGOON = RGB(60, 210, 220)
local STRIPES = { RGB(255, 80, 90), RGB(60, 150, 255), RGB(255, 200, 50), RGB(80, 210, 120) }

local LENGTH, WIDTH = 230, 150

-- Techo de paja a cuatro aguas (cuatro faldones inclinados y una punta)
local function thatchRoof(cf, w, d)
	for _, s in { -1, 1 } do
		Kit.deco("Thatch", V(w + 3, 0.8, d / 2 + 2.5), cf * CFrame.new(0, 0, s * (d / 4 + 0.4)) * CFrame.Angles(rad(s * 28), 0, 0), THATCH, Enum.Material.SmoothPlastic)
		Kit.deco("ThatchSide", V(w / 2 + 1, 0.8, d + 1), cf * CFrame.new(s * (w / 4 + 0.6), -0.4, 0) * CFrame.Angles(0, 0, rad(-s * 28)), THATCH:Lerp(RGB(180, 140, 70), 0.3), Enum.Material.SmoothPlastic)
	end
	Kit.deco("ThatchTop", V(2.4, 1.6, d * 0.4), cf * CFrame.new(0, d / 4 + 0.6, 0), THATCH:Lerp(RGB(150, 110, 50), 0.3), Enum.Material.SmoothPlastic)
end

-- Antorcha tiki con fuego
local function tikiTorch(cf)
	Kit.cylinder("TikiPole", 6, 0.5, cf * CFrame.new(0, 3, 0), WOOD_DARK, Enum.Material.Wood)
	local cup = Kit.cylinder("TikiCup", 1, 1, cf * CFrame.new(0, 6.3, 0), RGB(90, 60, 40), Enum.Material.Wood, nil, true)
	local fire = Instance.new("Fire")
	fire.Size = 2.5
	fire.Heat = 5
	fire.Color = RGB(255, 140, 40)
	fire.SecondaryColor = RGB(255, 220, 80)
	fire.Parent = cup
	Kit.light(cup, "PointLight", RGB(255, 170, 80), 14, 1.2)
end

-- Sombrilla de rayas con toalla
local function umbrella(cf, colorA, colorB)
	Kit.cylinder("UmbrellaPole", 7, 0.25, cf * CFrame.new(0, 3.5, 0), RGB(240, 240, 240), Enum.Material.SmoothPlastic, nil, true)
	for i = 0, 7 do
		Kit.deco("UmbrellaCloth", V(2.6, 0.2, 4.4), cf * CFrame.Angles(0, i * math.pi / 4, 0) * CFrame.new(0, 6.5, -2) * CFrame.Angles(rad(-18), 0, 0), i % 2 == 0 and colorA or colorB, Enum.Material.SmoothPlastic)
	end
	Kit.deco("Towel", V(3, 0.08, 6), cf * CFrame.new(2.5, 0.05, 1) * CFrame.Angles(0, rad(15), 0), colorB, Enum.Material.SmoothPlastic)
	Kit.deco("TowelStripe", V(3.02, 0.09, 0.8), cf * CFrame.new(2.5, 0.05, 1) * CFrame.Angles(0, rad(15), 0), colorA, Enum.Material.SmoothPlastic)
end

-- Tabla de surf clavada en la arena
local function surfboard(cf, color)
	Kit.deco("Surfboard", V(1.8, 6.5, 0.3), cf * CFrame.new(0, 3, 0) * CFrame.Angles(rad(8), 0, 0), color, Enum.Material.SmoothPlastic)
	Kit.deco("SurfStripe", V(0.4, 6.4, 0.32), cf * CFrame.new(0, 3, 0) * CFrame.Angles(rad(8), 0, 0), RGB(255, 255, 255), Enum.Material.SmoothPlastic)
end

-- Choza tiki: suelo elevado de madera, paredes de bambú con puerta y ventana, techo de paja
local function hut(cf)
	local w, d, h = 16, 12, 7
	Kit.block("HutFloor", V(w + 2, 1, d + 2), cf * CFrame.new(0, 0.5, 0), WOOD, Enum.Material.WoodPlanks)
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			Kit.cylinder("HutPost", h + 1, 0.9, cf * CFrame.new(x * w / 2, 1 + h / 2, z * d / 2), WOOD_DARK, Enum.Material.Wood)
		end
	end
	-- Pared trasera completa, laterales con ventana y frontal con puerta (mira a +X)
	Kit.block("HutWall", V(0.6, h, d), cf * CFrame.new(-w / 2, 1 + h / 2, 0), RGB(200, 170, 100), Enum.Material.SmoothPlastic)
	for _, z in { -1, 1 } do
		local face = cf * CFrame.new(0, 0, z * d / 2)
		Kit.block("HutWallLow", V(w, 3, 0.6), face * CFrame.new(0, 2.5, 0), RGB(200, 170, 100), Enum.Material.SmoothPlastic)
		Kit.block("HutWallHigh", V(w, 1.5, 0.6), face * CFrame.new(0, 1 + h - 0.75, 0), RGB(200, 170, 100), Enum.Material.SmoothPlastic)
		for _, x in { -1, 1 } do
			Kit.block("HutWallSide", V(4, h - 4.5, 0.6), face * CFrame.new(x * (w / 2 - 2), 4 + (h - 4.5) / 2, 0), RGB(200, 170, 100), Enum.Material.SmoothPlastic)
		end
	end
	for _, z in { -1, 1 } do
		Kit.block("HutDoorSide", V(0.6, h, (d - 5) / 2), cf * CFrame.new(w / 2, 1 + h / 2, z * (2.5 + (d - 5) / 4)), RGB(200, 170, 100), Enum.Material.SmoothPlastic)
	end
	Kit.block("HutLintel", V(0.6, 1.5, 5), cf * CFrame.new(w / 2, 1 + h - 0.75, 0), RGB(200, 170, 100), Enum.Material.SmoothPlastic)
	Kit.block("HutCeiling", V(w, 0.5, d), cf * CFrame.new(0, 1 + h + 0.25, 0), WOOD, Enum.Material.Wood)
	thatchRoof(cf * CFrame.new(0, 1 + h + 1.6, 0), w, d)
	Kit.block("HutStep", V(3, 0.5, 5), cf * CFrame.new(w / 2 + 2, 0.25, 0), WOOD, Enum.Material.WoodPlanks)
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	Kit.applyLighting(Map.Lighting)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Isla de arena y mar alrededor
	block("Sand", V(LENGTH + 20, 2, WIDTH + 20), CFrame.new(0, -1, 0), SAND, Enum.Material.Sand)
	workspace.Terrain:FillBlock(CFrame.new(0, -6, 0), V(900, 10, 700), Enum.Material.Water)
	workspace.Terrain:FillBlock(CFrame.new(0, -12, 0), V(900, 2, 700), Enum.Material.Sand)
	-- Orilla mojada alrededor de la isla
	for _, z in { -1, 1 } do
		deco("WetSand", V(LENGTH + 24, 0.1, 6), CFrame.new(0, 0.02, z * (WIDTH / 2 + 8)), RGB(215, 185, 120), Enum.Material.SmoothPlastic)
	end

	-- Laguna central y torre de socorrista
	local lagoon = Kit.cylinder("Lagoon", 0.3, 34, CFrame.new(0, 0.12, 0), LAGOON, Enum.Material.SmoothPlastic, nil, true)
	lagoon.Reflectance = 0.25
	Kit.cylinder("LagoonRim", 0.2, 37, CFrame.new(0, 0.08, 0), RGB(230, 200, 140), Enum.Material.SmoothPlastic, nil, true)
	local deckY = 9
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			Kit.cylinder("TowerStilt", deckY, 1.4, CFrame.new(x * 8, deckY / 2, z * 8), WOOD_DARK, Enum.Material.Wood)
		end
	end
	block("TowerDeck", V(20, 1, 20), CFrame.new(0, deckY + 0.5, 0), WOOD, Enum.Material.WoodPlanks)
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			Kit.cylinder("TowerRoofPost", 7, 0.7, CFrame.new(x * 8.5, deckY + 4.5, z * 8.5), WOOD_DARK, Enum.Material.Wood, nil, true)
		end
	end
	block("TowerRoof", V(22, 0.6, 22), CFrame.new(0, deckY + 8.2, 0), WOOD, Enum.Material.Wood)
	thatchRoof(CFrame.new(0, deckY + 9.2, 0), 20, 20)
	local flag = deco("LifeguardFlag", V(0.2, 3, 4), CFrame.new(0, deckY + 15, 2), RGB(255, 60, 60), Enum.Material.Fabric)
	flag.CastShadow = false
	Kit.cylinder("FlagPole", 6, 0.25, CFrame.new(0, deckY + 13.5, 0), RGB(240, 240, 240), Enum.Material.SmoothPlastic, nil, true)
	Kit.symmetric(function(m)
		Kit.railing((m * CFrame.new(-10, deckY + 1, 10)).Position, (m * CFrame.new(10, deckY + 1, 10)).Position, 2.4, RGB(255, 255, 255))
		Kit.railing((m * CFrame.new(-10, deckY + 1, -10)).Position, (m * CFrame.new(-10, deckY + 1, 1)).Position, 2.4, RGB(255, 255, 255))
		Kit.railing((m * CFrame.new(-10, deckY + 1, 7)).Position, (m * CFrame.new(-10, deckY + 1, 10)).Position, 2.4, RGB(255, 255, 255))
		Kit.stairs((m * CFrame.new(-25, 0, 4)).Position, (m * CFrame.new(-10.5, deckY + 1, 4)).Position, 5, WOOD, Enum.Material.WoodPlanks)
	end)

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and RGB(255, 80, 90) or RGB(60, 150, 255)
		-- Pasarela de madera desde la base
		block("Boardwalk", V(44, 0.4, 7), m * CFrame.new(-64, 0.2, 0), WOOD, Enum.Material.WoodPlanks)
		for i = 0, 9 do
			deco("BoardGap", V(0.15, 0.42, 7.05), m * CFrame.new(-84 + i * 4.4, 0.2, 0), WOOD_DARK, Enum.Material.Wood)
		end

		hut(m * CFrame.new(-55, 0, 42))
		hut(m * CFrame.new(-55, 0, -42) * CFrame.Angles(0, 0, 0))

		-- Sacos de arena (cobertura baja) y cajas
		for _, spec in { { V(-30, 0, -10), 0 }, { V(-45, 0, 12), 90 }, { V(-80, 0, 26), 0 }, { V(-26, 0, 30), 90 }, { V(-88, 0, -50), 0 } } do
			local cf = m * CFrame.new(spec[1]) * CFrame.Angles(0, rad(spec[2]), 0)
			for row = 0, 1 do
				for i = -1, 1 do
					block("Sandbag", V(3.2, 1.6, 2), cf * CFrame.new(i * 3 + row * 1.5 - 0.75, 0.8 + row * 1.5, 0), RGB(200, 180, 130), Enum.Material.SmoothPlastic)
				end
			end
		end
		Kit.crate(m * CFrame.new(-38, 0, -30), 4)
		Kit.crate(m * CFrame.new(-34, 0, -30), 3)
		Kit.barrel(m * CFrame.new(-82, 0, 44), teamColor)

		-- Playa: palmeras, sombrillas, tablas de surf, pelotas y antorchas
		for i, p in { V(-100, 0, 58), V(-70, 0, 64), V(-20, 0, 62), V(-100, 0, -58), V(-25, 0, -64), V(-62, 0, 20) } do
			Kit.palm(m * CFrame.new(p) * CFrame.Angles(0, i * 1.3, 0), 13 + (i % 3) * 2)
		end
		umbrella(m * CFrame.new(-34, 0, 52), STRIPES[1], STRIPES[3])
		umbrella(m * CFrame.new(-82, 0, -64), STRIPES[2], STRIPES[4])
		surfboard(m * CFrame.new(-44, 0, 60) * CFrame.Angles(0, rad(10), 0), STRIPES[2])
		surfboard(m * CFrame.new(-47, 0, 60) * CFrame.Angles(0, rad(-12), 0), STRIPES[1])
		Kit.ball("BeachBall", 2, m * CFrame.new(-30, 1, 44), STRIPES[(side == "A" and 3 or 4)], Enum.Material.SmoothPlastic, true)
		for _, p in { V(-74, 0, 7), V(-74, 0, -7), V(-14, 0, 22), V(-40, 0, 26) } do
			tikiTorch(m * CFrame.new(p))
		end
		Kit.rockCluster(m * V(-112, 0, -30), 4, Enum.Material.Rock)
		Kit.rockCluster(m * V(-10, 0, 70), 4, Enum.Material.Rock)

		-- Muelle con barca en el mar
		block("Pier", V(8, 0.6, 26), m * CFrame.new(-60, 0.3, -WIDTH / 2 - 14), WOOD, Enum.Material.WoodPlanks)
		for _, z in { -24, -16, -8 } do
			for _, x in { -3.5, 3.5 } do
				Kit.cylinder("PierPost", 6, 0.7, m * CFrame.new(-60 + x, -2.5, -WIDTH / 2 + z), WOOD_DARK, Enum.Material.Wood, nil, true)
			end
		end
		Kit.boat(m * CFrame.new(-48, -1.2, -WIDTH / 2 - 22) * CFrame.Angles(0, rad(15), 0))
	end)

	-- Bases y banderas
	local spawnStyle = { Floor = RGB(250, 230, 175), Roof = THATCH }
	Kit.spawnArea(teams[1], CFrame.new(-100, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-100, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-72, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-72, 0, 0))

	-- Límites invisibles (la isla acaba en el agua) e islas lejanas
	Kit.bounds(LENGTH, WIDTH, 50)
	for i, spec in { { V(-260, 0, -220), 40 }, { V(240, 0, 240), 55 }, { V(330, 0, -60), 35 }, { V(-320, 0, 160), 45 } } do
		Kit.naturalHill(spec[1] + V(0, -spec[2] * 0.55, 0), spec[2], Enum.Material.Sand, { Top = Enum.Material.LeafyGrass, TopCount = 5, RockCount = 2, Seed = i * 7 })
	end

	-- Modos
	for _, p in {
		V(-98, 0.5, 50), V(-80, 0.5, -20), V(-58, 0.5, 6), V(-38, 0.5, 18), V(-26, 0.5, -24),
		V(-55, 1.5, 42), V(-55, 1.5, -42), V(-12, 0.5, 50), V(-94, 0.5, -64), V(-3, deckY + 1.5, -5),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, deckY + 1, 0), 7, 1)
	Kit.zone(V(-55, 1, 42), 6, 2)
	Kit.zone(V(55, 1, -42), 6, 3)
	Kit.zone(V(-30, 0, 0), 8, 4)
	Kit.zone(V(30, 0, 0), 8, 5)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">ToyBox</string>
              <string name="Source"><![CDATA[-- CAJA DE JUGUETES: eres del tamaño de un juguete dentro del cuarto de un niño. Castillo de bloques
-- en el centro con pasarela elevada, ladrillos de construcción gigantes y cubos con letras como
-- cobertura, tren de juguete, plataformas de ladrillos en los laterales, ceras de colores como
-- pilares y un osito de peluche gigante. Simétrico (rojo contra azul).
local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)
local Kit = require(script.Parent.Parent.MapKit)

local Map = {
	Id = "ToyBox",
	Name = "Caja de Juguetes",
	Icon = "🧸",
	Description = "Cuarto de juegos · castillo de bloques · ladrillos gigantes",
}

Map.Lighting = {
	ClockTime = 15.2,
	Brightness = 3,
	Exposure = 0.06,
	Ambient = Color3.fromRGB(130, 122, 140),
	OutdoorAmbient = Color3.fromRGB(170, 165, 185),
	Atmosphere = { Density = 0.24, Offset = 0.2, Color = Color3.fromRGB(235, 225, 255), Decay = Color3.fromRGB(150, 140, 210), Glare = 0, Haze = 0.5 },
	Color = { Saturation = 0.22, Contrast = 0.06, Brightness = 0.03, Tint = Color3.fromRGB(255, 250, 245) },
	Bloom = { Intensity = 0.35, Size = 22, Threshold = 2 },
	Clouds = 0.45,
	SunRays = 0.04,
	ShadowSoftness = 0.3,
	Wind = Vector3.new(2, 0, 1),
}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad

local WOOD = RGB(222, 168, 110) -- suelo de madera
local WALL = RGB(150, 200, 255) -- paredes azul cielo
local TRIM = RGB(255, 200, 60)
local BRICKS = { RGB(235, 60, 60), RGB(50, 130, 240), RGB(255, 205, 40), RGB(60, 200, 90), RGB(255, 140, 40), RGB(170, 90, 230) }

local LENGTH, WIDTH = 200, 130

local function wall(name, cf, size, color)
	local part = Kit.block(name, size, cf * CFrame.new(0, size.Y / 2, 0), color or WALL, Enum.Material.SmoothPlastic)
	Kit.deco(name .. "Cap", V(size.X + 0.4, 0.7, size.Z + 0.4), cf * CFrame.new(0, size.Y + 0.35, 0), TRIM, Enum.Material.SmoothPlastic)
	return part
end

-- Ladrillo de construcción con tetones (de pie sobre cf). size = ancho x alto x fondo
local function brick(cf, size, color, studs)
	Kit.block("ToyBrick", size, cf * CFrame.new(0, size.Y / 2, 0), color, Enum.Material.SmoothPlastic)
	local nx, nz = studs and studs.X or math.max(1, math.floor(size.X / 3)), studs and studs.Y or math.max(1, math.floor(size.Z / 3))
	for i = 1, nx do
		for j = 1, nz do
			local x = -size.X / 2 + (i - 0.5) * size.X / nx
			local z = -size.Z / 2 + (j - 0.5) * size.Z / nz
			Kit.cylinder("BrickStud", 0.6, math.min(size.X / nx, size.Z / nz) * 0.62, cf * CFrame.new(x, size.Y + 0.3, z), color, Enum.Material.SmoothPlastic, nil, true)
		end
	end
end

-- Cubo de madera con letras de colores en dos caras
local function letterBlock(cf, size, color, letterA, letterB)
	local block = Kit.block("LetterBlock", V(size, size, size), cf * CFrame.new(0, size / 2, 0), color, Enum.Material.SmoothPlastic)
	Kit.sign(block, Enum.NormalId.Front, letterA, Color3.new(1, 1, 1))
	Kit.sign(block, Enum.NormalId.Back, letterB, Color3.new(1, 1, 1))
	Kit.sign(block, Enum.NormalId.Left, letterB, Color3.new(1, 1, 1))
	Kit.sign(block, Enum.NormalId.Right, letterA, Color3.new(1, 1, 1))
	return block
end

-- Cera de colores gigante de pie (pilar): cuerpo, envoltorio de papel y punta
local function crayon(cf, height, color)
	Kit.cylinder("Crayon", height, 3.2, cf * CFrame.new(0, height / 2, 0), color, Enum.Material.SmoothPlastic)
	Kit.cylinder("CrayonWrap", height * 0.55, 3.3, cf * CFrame.new(0, height * 0.42, 0), color:Lerp(Color3.new(1, 1, 1), 0.55), Enum.Material.SmoothPlastic, nil, true)
	Kit.cylinder("CrayonBand", 0.4, 3.35, cf * CFrame.new(0, height * 0.7, 0), color:Lerp(Color3.new(0, 0, 0), 0.3), Enum.Material.SmoothPlastic, nil, true)
	Kit.cylinder("CrayonTipBase", 1.2, 2.4, cf * CFrame.new(0, height + 0.6, 0), color, Enum.Material.SmoothPlastic, nil, true)
	Kit.ball("CrayonTip", 1.6, cf * CFrame.new(0, height + 1.3, 0), color, Enum.Material.SmoothPlastic, true)
end

-- Tren de juguete (cobertura larga): locomotora y dos vagones con ruedas
local function train(cf, colors)
	local function wheels(at, length)
		for _, x in { -length / 2 + 1, length / 2 - 1 } do
			for _, z in { -1.7, 1.7 } do
				Kit.cylinder("TrainWheel", 0.5, 1.8, at * CFrame.new(x, 0.9, z) * CFrame.Angles(rad(90), 0, 0), RGB(40, 40, 46), Enum.Material.SmoothPlastic, nil, true)
			end
		end
	end
	-- Locomotora
	Kit.block("TrainCab", V(5, 5, 3.4), cf * CFrame.new(-6, 3.3, 0), colors[1], Enum.Material.SmoothPlastic)
	Kit.block("TrainRoof", V(5.6, 0.6, 4), cf * CFrame.new(-6, 6.1, 0), colors[2], Enum.Material.SmoothPlastic)
	Kit.cylinder("TrainBoiler", 5, 3, cf * CFrame.new(-1.5, 2.7, 0) * CFrame.Angles(0, 0, rad(90)), colors[2], Enum.Material.SmoothPlastic)
	Kit.cylinder("TrainChimney", 2, 1.2, cf * CFrame.new(0, 5, 0), RGB(40, 40, 46), Enum.Material.SmoothPlastic, nil, true)
	wheels(cf * CFrame.new(-3.5, 0, 0), 9)
	-- Vagones
	for i, color in { colors[3], colors[4] } do
		local at = cf * CFrame.new(3.5 + i * 7, 0, 0)
		Kit.block("TrainCar", V(6, 2.6, 3.4), at * CFrame.new(0, 2.1, 0), color, Enum.Material.SmoothPlastic)
		Kit.block("TrainCargo", V(2.4, 2.4, 2.4), at * CFrame.new(-1.3, 4.6, 0) * CFrame.Angles(0, rad(12), 0), BRICKS[(i + 2) % #BRICKS + 1], Enum.Material.SmoothPlastic)
		wheels(at, 6)
	end
end

-- Osito de peluche gigante sentado (decoración de fondo)
local function teddy(position, scale, facing)
	local cf = CFrame.new(position) * CFrame.Angles(0, facing, 0)
	local fur, light = RGB(176, 118, 70), RGB(230, 190, 140)
	Kit.ball("TeddyBody", 14 * scale, cf * CFrame.new(0, 7 * scale, 0), fur, Enum.Material.SmoothPlastic, true)
	Kit.ball("TeddyBelly", 9 * scale, cf * CFrame.new(0, 6.5 * scale, -3.4 * scale), light, Enum.Material.SmoothPlastic, true)
	Kit.ball("TeddyHead", 10 * scale, cf * CFrame.new(0, 17 * scale, 0), fur, Enum.Material.SmoothPlastic, true)
	Kit.ball("TeddySnout", 4 * scale, cf * CFrame.new(0, 16 * scale, -4.4 * scale), light, Enum.Material.SmoothPlastic, true)
	Kit.ball("TeddyNose", 1.4 * scale, cf * CFrame.new(0, 16.8 * scale, -6.2 * scale), RGB(40, 30, 30), Enum.Material.SmoothPlastic, true)
	for _, s in { -1, 1 } do
		Kit.ball("TeddyEar", 4 * scale, cf * CFrame.new(s * 4 * scale, 21.5 * scale, 0), fur, Enum.Material.SmoothPlastic, true)
		Kit.ball("TeddyEye", 1.2 * scale, cf * CFrame.new(s * 1.8 * scale, 18.6 * scale, -4.4 * scale), RGB(30, 25, 25), Enum.Material.SmoothPlastic, true)
		Kit.ball("TeddyArm", 5 * scale, cf * CFrame.new(s * 7.5 * scale, 9 * scale, -2 * scale), fur, Enum.Material.SmoothPlastic, true)
		Kit.ball("TeddyFoot", 6 * scale, cf * CFrame.new(s * 4.5 * scale, 2.4 * scale, -6 * scale), fur, Enum.Material.SmoothPlastic, true)
	end
	Kit.block("TeddyBow", V(6 * scale, 2 * scale, 1.4 * scale), cf * CFrame.new(0, 12.5 * scale, -4.5 * scale), RGB(235, 60, 90), Enum.Material.SmoothPlastic)
end

function Map.Build()
	local folder = Kit.Begin(Map.Name)
	Kit.applyLighting(Map.Lighting)
	local block, deco = Kit.block, Kit.deco
	local teams = GameConfig.Teams

	-- Suelo de madera con tablas, alfombra redonda en el centro
	block("Floor", V(LENGTH + 40, 2, WIDTH + 40), CFrame.new(0, -1, 0), WOOD, Enum.Material.SmoothPlastic)
	for z = -WIDTH / 2, WIDTH / 2, 10 do
		deco("FloorBoardLine", V(LENGTH, 0.05, 0.3), CFrame.new(0, 0.02, z), WOOD:Lerp(Color3.new(0, 0, 0), 0.15), Enum.Material.SmoothPlastic)
	end
	Kit.cylinder("Rug", 0.2, 64, CFrame.new(0, 0.1, 0), RGB(120, 200, 255), Enum.Material.SmoothPlastic)
	Kit.cylinder("RugRing", 0.22, 52, CFrame.new(0, 0.11, 0), RGB(255, 230, 120), Enum.Material.SmoothPlastic, nil, true)
	Kit.cylinder("RugCenter", 0.24, 38, CFrame.new(0, 0.12, 0), RGB(255, 150, 190), Enum.Material.SmoothPlastic, nil, true)

	-- Paredes con ceras de colores
	for _, z in { -1, 1 } do
		wall("OuterWall", CFrame.new(0, 0, z * (WIDTH / 2 + 1.5)), V(LENGTH + 6, 20, 3))
		for i, x in { -84, -56, -28, 0, 28, 56, 84 } do
			crayon(CFrame.new(x, 0, z * (WIDTH / 2 - 1)), 18, BRICKS[(i + (z > 0 and 3 or 0)) % #BRICKS + 1])
		end
	end
	for _, x in { -1, 1 } do
		wall("OuterWall", CFrame.new(x * (LENGTH / 2 + 1.5), 0, 0), V(3, 20, WIDTH + 6))
	end

	-- Castillo central de bloques: cuatro torres de cubos y una pasarela en cruz a 8 de altura
	local deckY = 8
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			local base = CFrame.new(x * 11, 0, z * 11)
			for level = 0, 2 do
				local color = BRICKS[(level + (x + z) / 2 + 2) % #BRICKS + 1]
				block("CastleBlock", V(6, 4, 6), base * CFrame.new(0, level * 4 + 2, 0) * CFrame.Angles(0, rad(level * 8 * x), 0), color, Enum.Material.SmoothPlastic)
			end
			Kit.cylinder("CastleTop", 2, 4.4, base * CFrame.new(0, 13, 0), RGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, true)
			Kit.ball("CastleTopBall", 2.2, base * CFrame.new(0, 14.4, 0), BRICKS[1], Enum.Material.SmoothPlastic, true)
		end
	end
	block("CastleDeck", V(16, 1, 6), CFrame.new(0, deckY - 0.5, 0), BRICKS[3], Enum.Material.SmoothPlastic)
	block("CastleDeck", V(6, 1, 16), CFrame.new(0, deckY - 0.5, 0), BRICKS[3], Enum.Material.SmoothPlastic)
	for _, s in { -1, 1 } do
		for _, x in { -1, 1 } do
			-- Almenas bajas a los lados del brazo largo (sin cortar el cruce)
			block("Battlement", V(5, 1.6, 0.8), CFrame.new(x * 5.5, deckY + 0.8, s * 2.6), BRICKS[2], Enum.Material.SmoothPlastic)
		end
	end

	Kit.symmetric(function(m, side)
		local teamColor = side == "A" and BRICKS[1] or BRICKS[2]
		-- Escalera del castillo (sube por el lado de cada equipo)
		Kit.stairs((m * CFrame.new(-26, 0, 0)).Position, (m * CFrame.new(-8, deckY, 0)).Position, 5, BRICKS[4], Enum.Material.SmoothPlastic)

		-- Plataforma lateral de ladrillos (a 6 de altura) con escalera
		local platY = 6
		brick(m * CFrame.new(-41, 0, -(WIDTH / 2 - 8)), V(22, platY, 12), teamColor, Vector2.new(4, 2))
		Kit.stairs((m * CFrame.new(-62, 0, -(WIDTH / 2 - 8))).Position, (m * CFrame.new(-52, platY, -(WIDTH / 2 - 8))).Position, 5, BRICKS[5], Enum.Material.SmoothPlastic)

		-- Ladrillos gigantes como cobertura
		brick(m * CFrame.new(-36, 0, 18), V(9, 4, 4.5), BRICKS[3])
		brick(m * CFrame.new(-54, 0, -14) * CFrame.Angles(0, rad(90), 0), V(9, 4, 4.5), BRICKS[4])
		brick(m * CFrame.new(-22, 0, -30), V(6, 5, 6), BRICKS[6])
		brick(m * CFrame.new(-70, 0, 40), V(9, 4, 4.5), BRICKS[5])
		brick(m * CFrame.new(-46, 0, 46) * CFrame.Angles(0, rad(25), 0), V(6, 7, 3), BRICKS[1])

		-- Cubos con letras
		letterBlock(m * CFrame.new(-30, 0, -10) * CFrame.Angles(0, rad(15), 0), 5, BRICKS[2], "A", "B")
		letterBlock(m * CFrame.new(-62, 0, 20), 5, BRICKS[4], "C", "D")
		letterBlock(m * CFrame.new(-14, 0, 40), 4.5, BRICKS[5], "E", "F")
		letterBlock(m * CFrame.new(-14, 4.5, 40) * CFrame.Angles(0, rad(30), 0), 3.5, BRICKS[6], "G", "H")

		-- Tren de juguete en la banda lateral (cobertura larga)
		train(m * CFrame.new(-28, 0, 52), { RGB(235, 60, 60), RGB(40, 120, 230), RGB(255, 200, 40), RGB(60, 200, 90) })

		-- Pelota de goma (decoración, se atraviesa)
		local ball = Kit.ball("ToyBall", 5, m * CFrame.new(-80, 2.5, -48), RGB(255, 90, 90), Enum.Material.SmoothPlastic, true)
		ball.CastShadow = true
		Kit.cylinder("ToyBallStripe", 5.1, 1.2, m * CFrame.new(-80, 2.5, -48) * CFrame.Angles(0, 0, rad(90)), RGB(255, 255, 255), Enum.Material.SmoothPlastic, nil, true)
	end)

	-- Bases y banderas
	local spawnStyle = { Floor = RGB(255, 240, 210), Roof = WALL }
	Kit.spawnArea(teams[1], CFrame.new(-85, 0, 0), spawnStyle)
	Kit.spawnArea(teams[2], Kit.MIRROR * CFrame.new(-85, 0, 0), spawnStyle)
	Kit.flagBase(teams[1], CFrame.new(-62, 0, 0))
	Kit.flagBase(teams[2], Kit.MIRROR * CFrame.new(-62, 0, 0))

	-- Fondo: pilas de bloques gigantes, ositos y colinas
	Kit.bounds(LENGTH, WIDTH, 50)
	teddy(V(-40, 0, WIDTH / 2 + 30), 1.6, math.pi)
	teddy(V(40, 0, -(WIDTH / 2 + 30)), 1.6, 0)
	local n = 0
	for x = -140, 140, 35 do
		for _, z in { -1, 1 } do
			n += 1
			if math.abs(x - z * -40) > 25 then
				local base = V(x, 0, z * (WIDTH / 2 + 20 + (n % 3) * 8))
				local size = 12 + (n % 3) * 3
				for level = 0, n % 3 do
					deco("BigBlock", V(size, size, size), CFrame.new(base + V((level % 2) * 3, size / 2 + level * size, 0)) * CFrame.Angles(0, rad(level * 17 + n * 9), 0), BRICKS[(n + level) % #BRICKS + 1], Enum.Material.SmoothPlastic)
				end
			end
		end
	end
	for x = -200, 200, 70 do
		for _, z in { -1, 1 } do
			Kit.naturalHill(V(x, -18, z * 150), 50, Enum.Material.Grass, { Inward = V(0, 0, -z), Top = Enum.Material.LeafyGrass, RockCount = 0 })
		end
	end
	for _, sx in { -1, 1 } do
		for z = -90, 90, 60 do
			Kit.naturalHill(V(sx * 165, -18, z), 50, Enum.Material.Grass, { Inward = V(-sx, 0, 0), Top = Enum.Material.LeafyGrass, RockCount = 0 })
		end
	end

	-- Modos
	for _, p in {
		V(-74, 0.5, 16), V(-74, 0.5, -16), V(-48, 0.5, 2), V(-40, 0.5, 30), V(-44, 0.5, -34),
		V(-22, 0.5, 16), V(-12, 0.5, -20), V(-40, 6.5, -57), V(-1.5, deckY + 0.5, -5), V(-78, 0.5, -36),
	} do
		Kit.ffaSpawn(p)
		Kit.ffaSpawn(Kit.MIRROR * p)
	end
	Kit.zone(V(0, deckY, 0), 5, 1)
	Kit.zone(V(-40, 0, 30), 6, 2)
	Kit.zone(V(40, 0, -30), 6, 3)
	Kit.zone(V(-40, 6, -57), 5, 4)
	Kit.zone(V(40, 6, 57), 5, 5)
	Kit.dustMotes(CFrame.new(0, 8, 0), V(120, 14, 80), Color3.fromRGB(255, 240, 200), 14)
	return folder
end

return Map
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">MapKit</string>
            <string name="Source"><![CDATA[-- Kit de construcción de mapas: piezas reutilizables (contenedores, edificios, palmeras, grúas...),
-- iluminación por mapa y puntos especiales (spawns, bandera, zonas, spawns libres).
local Lighting = game:GetService("Lighting")

local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)

local Kit = {}

Kit.folder = nil -- carpeta del mapa actual (la crea Begin)

-- Rotación de 180° alrededor del centro: la mitad Azul es espejo de la Roja
Kit.MIRROR = CFrame.Angles(0, math.pi, 0)

function Kit.symmetric(fn)
	fn(CFrame.new(), "A")
	fn(Kit.MIRROR, "B")
end

local rad = math.rad
local V = Vector3.new
local RGB = Color3.fromRGB

Kit.C = {
	Metal = RGB(60, 62, 70),
	Yellow = RGB(255, 205, 50),
	White = RGB(245, 245, 250),
	Wood = RGB(176, 124, 70),
	WoodDark = RGB(120, 80, 45),
	Leaf = RGB(80, 180, 80),
	LeafDark = RGB(50, 140, 60),
	Pink = RGB(255, 80, 170),
	Cyan = RGB(0, 220, 255),
	Red = RGB(210, 50, 45),
	Blue = RGB(45, 110, 220),
}
local C = Kit.C

-- Realismo: el plástico liso parece de juguete. Las piezas grandes pasan a materiales PBR reales
-- (yeso pintado si tienen color, hormigón si son oscuras o son suelos); lo pequeño (conos, flores,
-- carteles) se queda como está. Lo usan Kit.block y los mapas con su propia función de piezas.
function Kit.realisticMaterial(size, color, material)
	material = material or Enum.Material.SmoothPlastic
	if material ~= Enum.Material.SmoothPlastic and material ~= Enum.Material.Plastic then
		return material
	end
	local volume = size.X * size.Y * size.Z
	local flatFloor = size.Y <= 0.6 and size.X * size.Z >= 60
	if volume < 30 and not flatFloor then
		return material
	end
	local luminance = color.R * 0.3 + color.G * 0.59 + color.B * 0.11
	if flatFloor or luminance < 0.22 then
		return Enum.Material.Concrete
	end
	return Enum.Material.Plaster
end

-- Estilo Cartoon: los materiales "realistas" pasan a plástico liso y los colores ganan viveza; los
-- grises claros tiran a lavanda (paredes tipo shooter de Roblox). Los detalles de suelo no cambian.
Kit.Cartoon = GameConfig.VisualStyle ~= "Realista"
local CARTOON_FLAT = {}
for _, name in {
	"Plaster", "Concrete", "Brick", "Limestone", "Cobblestone", "Slate", "Pavement", "Asphalt", "Granite", "Marble",
	"Sandstone", "Pebble", "CorrodedMetal", "DiamondPlate", "Rock", "Basalt", "Plastic", "Grass", "LeafyGrass",
	"ClayRoofTiles", "CeramicTiles", "Fabric",
} do
	local ok, material = pcall(function()
		return (Enum.Material :: any)[name]
	end)
	if ok and material then
		CARTOON_FLAT[material] = true
	end
end
local KEEP_LOOK = {
	ContactShadow = true, OilStain = true, Crack = true, Joint = true, TireMark = true, Puddle = true,
	-- Nata y caramelo blanco de Arena Caramelo (si no, el blanco se volvería lavanda)
	CandyWhite = true, CakeFrosting = true, FrostingDrip = true, GumdropShine = true,
	LollipopStick = true, LollipopSwirl = true, CottonStick = true,
	CastleTop = true, JumpPadRing = true, -- blancos de Caja de Juguetes y de las plataformas de salto
}

-- Tono de los grises en estilo Cartoon (cada mapa puede tener el suyo: Lighting.CartoonNeutral)
Kit.Neutral = { Hue = 0.68, Sat = 0.16 } -- lavanda por defecto

function Kit.vivid(color)
	local h, s, v = color:ToHSV()
	if s < 0.22 then
		local neutral = Kit.Neutral
		if v >= 0.45 then
			-- piedra, yeso, gris claro → pastel del tono del mapa (lavanda por defecto)
			return Color3.fromHSV(neutral.Hue, neutral.Sat, math.min(1, v * 1.02 + 0.05))
		elseif v >= 0.2 then
			-- asfalto, hormigón oscuro → gris con un toque del mismo tono
			return Color3.fromHSV(neutral.Hue, math.min(0.35, neutral.Sat + 0.08), math.min(1, v * 1.12))
		end
		return color -- negros
	end
	return Color3.fromHSV(h, math.clamp(s * 1.45, 0, 0.95), math.clamp(v * 1.1 + 0.04, 0, 1))
end

function Kit.applyStyle(part)
	if not Kit.Cartoon or KEEP_LOOK[part.Name] or part.Material == Enum.Material.Neon then
		return
	end
	if CARTOON_FLAT[part.Material] then
		part.Material = Enum.Material.SmoothPlastic
	end
	-- Textura de cuadrícula (MaterialVariant "Grid" en MaterialService, ver assets/textures/LEEME.md).
	-- Si la variante no existe todavía, Roblox usa el plástico liso normal: no rompe nada.
	if part.Material == Enum.Material.SmoothPlastic then
		part.MaterialVariant = "Grid"
	end
	part.Color = Kit.vivid(part.Color)
end

function Kit.block(name, size, cf, color, material, parent)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = Kit.realisticMaterial(size, color, material)
	if part.Material == Enum.Material.Glass then
		part.Reflectance = 0.15 -- los cristales reflejan un poco el cielo
	end
	Kit.applyStyle(part)
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent or Kit.folder
	return part
end
local block = Kit.block

-- Pieza decorativa: no choca, no bloquea disparos y no hace sombra
function Kit.deco(name, size, cf, color, material, parent)
	local part = block(name, size, cf, color, material, parent)
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	-- Realismo con coste medio: solo lo grande (grúas, tejados, barcos, copas) proyecta sombra
	part.CastShadow = size.X * size.Y * size.Z >= 20 and part.Material ~= Enum.Material.Neon and part.Material ~= Enum.Material.Glass
	return part
end
local deco = Kit.deco

-- Cilindro de pie (el eje del cilindro en Roblox es X; lo giramos para que sea vertical)
function Kit.cylinder(name, height, diameter, cf, color, material, parent, decorative)
	local fn = decorative and deco or block
	local part = fn(name, V(height, diameter, diameter), cf * CFrame.Angles(0, 0, math.pi / 2), color, material, parent)
	part.Shape = Enum.PartType.Cylinder
	return part
end
local cylinder = Kit.cylinder

-- Cilindro tumbado a lo largo del eje X local
function Kit.pipe(name, length, diameter, cf, color, material, decorative)
	local fn = decorative and deco or block
	local part = fn(name, V(length, diameter, diameter), cf, color, material)
	part.Shape = Enum.PartType.Cylinder
	return part
end

function Kit.ball(name, diameter, cf, color, material, decorative)
	local fn = decorative and deco or block
	local part = fn(name, V(diameter, diameter, diameter), cf, color, material)
	part.Shape = Enum.PartType.Ball
	return part
end

-- Texto pegado a una cara de una pieza (carteles, rótulos de neón...)
function Kit.sign(part, face, text, color, strokeColor)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeColor3 = strokeColor or Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0
	label.Parent = gui
	return gui
end
local sign = Kit.sign

function Kit.light(part, kind, color, range, brightness, face)
	local light = Instance.new(kind or "PointLight")
	light.Color = color
	light.Range = range or 12
	light.Brightness = brightness or 1.5
	if face and (light:IsA("SpotLight") or light:IsA("SurfaceLight")) then
		light.Face = face
	end
	-- Los focos (farolas, lámparas) proyectan sombras reales; el menú Ajustes las apaga en Baja/Media
	if light:IsA("SpotLight") then
		light.Shadows = true
		light:SetAttribute("QualityShadow", true)
	end
	light.Parent = part
	return light
end

-- Rampa inclinada desde "bottom" hasta "top" (posiciones de la superficie)
function Kit.ramp(bottom, top, width, color, material)
	local mid = (bottom + top) / 2
	local length = (top - bottom).Magnitude
	local cf = CFrame.lookAt(mid, top) * CFrame.new(0, -0.5, 0)
	local part = block("Ramp", V(width, 1, length + 1), cf, color or RGB(150, 152, 165), material or Enum.Material.DiamondPlate)
	for _, side in { -1, 1 } do
		deco("RampEdge", V(0.4, 0.1, length + 1), cf * CFrame.new(side * (width / 2 - 0.3), 0.52, 0), C.Yellow, Enum.Material.SmoothPlastic)
	end
	return part
end

-- Escalera de piedra (rampa con escalones decorativos)
function Kit.stairs(bottom, top, width, color, material)
	local part = Kit.ramp(bottom, top, width, color, material or Enum.Material.Concrete)
	local steps = math.max(3, math.floor((top - bottom).Magnitude / 1.6))
	local stepColor = (color or RGB(200, 190, 170)):Lerp(Color3.new(0, 0, 0), 0.12)
	for i = 0, steps - 1 do
		local p = bottom:Lerp(top, (i + 0.5) / steps)
		local dir = (top - bottom)
		local flat = V(dir.X, 0, dir.Z).Unit
		deco("Step", V(width, 0.3, 0.3), CFrame.lookAt(p, p + flat) * CFrame.new(0, 0.05, 0), stepColor, Enum.Material.Concrete)
	end
	return part
end

-- Barandilla entre dos puntos (altura h)
function Kit.railing(a, b, h, color)
	h = h or 3
	color = color or C.Metal
	local length = (b - a).Magnitude
	local mid = (a + b) / 2
	local cf = CFrame.lookAt(mid, b)
	deco("Handrail", V(0.25, 0.25, length), cf * CFrame.new(0, h, 0), color, Enum.Material.Metal)
	deco("MidRail", V(0.15, 0.15, length), cf * CFrame.new(0, h * 0.5, 0), color, Enum.Material.Metal)
	local posts = math.max(2, math.floor(length / 4))
	for i = 0, posts do
		local p = a:Lerp(b, i / posts)
		deco("RailPost", V(0.25, h, 0.25), CFrame.new(p + V(0, h / 2, 0)), color, Enum.Material.Metal)
	end
	-- colisión invisible para no caerse
	local wall = block("RailCollider", V(0.4, h, length), cf * CFrame.new(0, h / 2, 0), color)
	wall.Transparency = 1
	wall.CanQuery = false
	wall.CastShadow = false
end

---------------------------------------------------------------------------
-- Piezas
---------------------------------------------------------------------------

-- Sombra de contacto (oclusión ambiental falsa): dos láminas oscuras semitransparentes algo más
-- grandes que la base, para que lo que está en el suelo parezca apoyado y no flotando. Solo a ras
-- de suelo (encima de otro objeto no hace falta). Material rugoso: el plástico liso brillaba con el
-- cielo y la sombra se veía más clara que el suelo.
function Kit.contactShadow(cf, sizeX, sizeZ, round, parent)
	local pos = cf.Position
	if math.abs(pos.Y) > 0.6 then
		return
	end
	local yaw = cf - pos
	for i, spec in { { 0.45, 0.7 }, { 1.2, 0.86 } } do
		local grow = spec[1] * 2
		local shadow
		if round then
			local d = math.max(sizeX, sizeZ) + grow
			shadow = deco("ContactShadow", V(0.02, d, d), CFrame.new(pos + V(0, 0.012 + i * 0.003, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.new(0, 0, 0), Enum.Material.Concrete, parent)
			shadow.Shape = Enum.PartType.Cylinder
		else
			shadow = deco("ContactShadow", V(sizeX + grow, 0.02, sizeZ + grow), CFrame.new(pos + V(0, 0.012 + i * 0.003, 0)) * yaw, Color3.new(0, 0, 0), Enum.Material.Concrete, parent)
		end
		shadow.Transparency = spec[2]
		shadow.CastShadow = false
	end
end

local CARGO_NAMES = { "HYPER CARGO", "NEXO LINE", "FROST CO.", "TURBO SHIP", "BLAZE LOG.", "VOLT MARINE" }
local cargoIndex = 0

function Kit.container(cf, color, labelText)
	local model = Instance.new("Model")
	model.Name = "Container"
	model.Parent = Kit.folder
	local size = V(20, 8.5, 8)
	local body = block("Body", size, cf * CFrame.new(0, size.Y / 2, 0), color, Enum.Material.CorrodedMetal, model)
	Kit.contactShadow(cf, size.X, size.Z, false, model)
	local dark = color:Lerp(Color3.new(0, 0, 0), 0.35)
	-- Nervios, techo y marco van pegados al cuerpo: su sombra ya la da el cuerpo (sin sombra propia)
	for i = -4, 4, 2 do
		deco("Rib", V(0.4, 8.2, 8.3), cf * CFrame.new(i * 2.2, 4.25, 0), dark, Enum.Material.Metal, model).CastShadow = false
	end
	block("Roof", V(20.2, 0.3, 8.2), cf * CFrame.new(0, 8.6, 0), dark, Enum.Material.Metal, model).CastShadow = false
	deco("DoorFrame", V(0.3, 8.6, 8.4), cf * CFrame.new(10.1, 4.25, 0), dark, Enum.Material.Metal, model).CastShadow = false
	for _, z in { -2, 2 } do
		deco("LockBar", V(0.3, 7.6, 0.25), cf * CFrame.new(10.3, 4.25, z), RGB(200, 200, 205), Enum.Material.Metal, model)
	end
	deco("DoorSplit", V(0.35, 8, 0.15), cf * CFrame.new(10.3, 4.25, 0), RGB(30, 30, 30), Enum.Material.Metal, model)
	-- Desgaste: chorretones de óxido que bajan desde el techo en los dos laterales largos
	local rust = color:Lerp(RGB(105, 58, 34), 0.6)
	for i, x in { -7.7, 3.3, 5.5 } do
		local side = i % 2 == 0 and 1 or -1
		local length = 2 + ((cargoIndex + i) % 3) * 1.4
		deco("RustStreak", V(0.9, length, 0.06), cf * CFrame.new(x, 8.45 - length / 2, side * 4.04), rust, Enum.Material.CorrodedMetal, model)
	end
	cargoIndex = cargoIndex % #CARGO_NAMES + 1
	local text = labelText or CARGO_NAMES[cargoIndex]
	sign(body, Enum.NormalId.Front, text, Color3.new(1, 1, 1), dark)
	sign(body, Enum.NormalId.Back, text, Color3.new(1, 1, 1), dark)
	return model
end

function Kit.crate(cf, size, color)
	size = size or 4
	local core = block("Crate", V(size, size, size), cf * CFrame.new(0, size / 2, 0), color or C.Wood, Enum.Material.WoodPlanks)
	Kit.contactShadow(cf, size, size)
	for _, y in { 0.12, 0.88 } do
		deco("CrateBand", V(size + 0.15, size * 0.12, size + 0.15), cf * CFrame.new(0, size * y, 0), C.WoodDark, Enum.Material.Wood)
	end
	deco("CrateCross", V(size + 0.1, size * 0.1, size * 1.3), cf * CFrame.new(0, size / 2, 0) * CFrame.Angles(rad(45), 0, 0), C.WoodDark, Enum.Material.Wood)
	return core
end

-- Caja metálica con chevron (estilo industrial)
function Kit.metalCrate(cf, size, color, glow)
	size = size or 5
	local core = block("MetalCrate", V(size, size, size), cf * CFrame.new(0, size / 2, 0), color or RGB(70, 75, 90), Enum.Material.DiamondPlate)
	Kit.contactShadow(cf, size, size)
	deco("CrateRim", V(size + 0.2, 0.3, size + 0.2), cf * CFrame.new(0, size - 0.15, 0), RGB(40, 42, 50), Enum.Material.Metal)
	deco("CrateRimB", V(size + 0.2, 0.3, size + 0.2), cf * CFrame.new(0, 0.15, 0), RGB(40, 42, 50), Enum.Material.Metal)
	if glow then
		deco("CrateGlow", V(size + 0.05, 0.2, size * 0.6), cf * CFrame.new(0, size * 0.5, 0), glow, Enum.Material.Neon)
	end
	return core
end

function Kit.barrel(cf, color)
	cylinder("Barrel", 3, 2, cf * CFrame.new(0, 1.5, 0), color or RGB(40, 90, 180), Enum.Material.Metal)
	Kit.contactShadow(cf, 2, 2, true)
	cylinder("BarrelRing", 0.2, 2.06, cf * CFrame.new(0, 0.8, 0), RGB(40, 40, 45), Enum.Material.Metal, nil, true)
	cylinder("BarrelRing", 0.2, 2.06, cf * CFrame.new(0, 2.2, 0), RGB(40, 40, 45), Enum.Material.Metal, nil, true)
end

function Kit.cone(cf)
	cylinder("ConeBase", 0.2, 1.4, cf * CFrame.new(0, 0.1, 0), RGB(255, 120, 20), Enum.Material.SmoothPlastic, nil, true)
	cylinder("Cone", 1.4, 0.8, cf * CFrame.new(0, 0.8, 0), RGB(255, 120, 20), Enum.Material.SmoothPlastic, nil, true)
	cylinder("ConeStripe", 0.25, 0.85, cf * CFrame.new(0, 0.9, 0), C.White, Enum.Material.SmoothPlastic, nil, true)
end

function Kit.barrier(size, cf)
	local part = block("Barrier", size, cf * CFrame.new(0, size.Y / 2, 0), RGB(225, 225, 230), Enum.Material.Concrete)
	Kit.contactShadow(cf, size.X, size.Z)
	local long = size.X >= size.Z
	local length = long and size.X or size.Z
	local count = math.max(2, math.floor(length / 3))
	for i = 0, count - 1 do
		local offset = -length / 2 + (i + 0.5) * (length / count)
		local color = i % 2 == 0 and RGB(230, 50, 50) or RGB(250, 250, 250)
		local stripeSize = long and V(length / count, 1, size.Z + 0.1) or V(size.X + 0.1, 1, length / count)
		local pos = long and CFrame.new(offset, size.Y - 1.2, 0) or CFrame.new(0, size.Y - 1.2, offset)
		deco("Stripe", stripeSize, cf * pos, color, Enum.Material.SmoothPlastic)
	end
	return part
end

function Kit.streetLamp(cf, color)
	cylinder("Pole", 14, 0.6, cf * CFrame.new(0, 7, 0), C.Metal, Enum.Material.Metal)
	cylinder("Base", 1, 1.2, cf * CFrame.new(0, 0.5, 0), C.Metal, Enum.Material.Metal)
	deco("Arm", V(0.4, 0.4, 4), cf * CFrame.new(0, 13.8, -1.8), C.Metal, Enum.Material.Metal)
	deco("Lamp", V(1.6, 0.5, 2.2), cf * CFrame.new(0, 13.4, -3.6), C.Metal, Enum.Material.Metal)
	local bulb = deco("Bulb", V(1.2, 0.2, 1.8), cf * CFrame.new(0, 13.1, -3.6), color or RGB(255, 240, 200), Enum.Material.Neon)
	Kit.light(bulb, "SpotLight", color or RGB(255, 235, 200), 26, 1.5, Enum.NormalId.Bottom).Angle = 100
end

function Kit.tree(cf)
	block("Planter", V(5, 1.6, 5), cf * CFrame.new(0, 0.8, 0), RGB(200, 200, 208), Enum.Material.Concrete)
	deco("Soil", V(4.4, 0.2, 4.4), cf * CFrame.new(0, 1.65, 0), RGB(90, 60, 40), Enum.Material.Ground)
	cylinder("Trunk", 7, 0.9, cf * CFrame.new(0, 5, 0), RGB(110, 75, 45), Enum.Material.Wood)
	for i, spec in {
		{ V(0, 9.5, 0), 6.5, C.Leaf },
		{ V(1.6, 8.4, 1), 4.5, C.LeafDark },
		{ V(-1.5, 8.8, -1.2), 4.8, C.Leaf },
		{ V(0.3, 11.6, -0.4), 4, C.LeafDark },
	} do
		local leaf = deco("Leaves" .. i, V(spec[2], spec[2], spec[2]), cf * CFrame.new(spec[1]), spec[3], Enum.Material.LeafyGrass)
		leaf.Shape = Enum.PartType.Ball
		leaf.CastShadow = true
	end
end

-- Palmera: tronco inclinado por segmentos y hojas largas
function Kit.palm(cf, height)
	height = height or 14
	local segments = 6
	local lean = rad(8)
	local pos = cf
	for i = 1, segments do
		local seg = height / segments
		local piece = cylinder("PalmTrunk", seg + 0.2, 1.1 - i * 0.07, pos * CFrame.new(0, seg / 2, 0), RGB(140, 105, 70), Enum.Material.Wood, nil, i > 2)
		piece.CanCollide = i <= 2
		deco("TrunkRing", V(0.25, 1.2 - i * 0.07, 1.2 - i * 0.07), pos * CFrame.new(0, seg, 0) * CFrame.Angles(0, 0, math.pi / 2), RGB(110, 80, 50), Enum.Material.Wood).Shape = Enum.PartType.Cylinder
		pos = pos * CFrame.new(0, seg, 0) * CFrame.Angles(lean / segments * 2, 0, 0)
	end
	local top = pos
	for i = 0, 6 do
		local angle = i * math.pi * 2 / 7
		local frond = deco(
			"Frond",
			V(1.6, 0.25, 7),
			top * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0.2, -3.2) * CFrame.Angles(rad(-20), 0, 0),
			i % 2 == 0 and RGB(70, 170, 70) or RGB(50, 140, 55),
			Enum.Material.Grass
		)
		frond.CastShadow = true
	end
	Kit.ball("Coconuts", 1.4, top * CFrame.new(0, -0.4, 0), RGB(110, 80, 40), Enum.Material.Wood, true)
end

-- Enredadera colgando de una pared (cara mirando en la dirección `normal`)
function Kit.vines(cf, width, height)
	for i = 0, math.floor(width / 1.5) do
		local h = height * (0.5 + ((i * 37) % 10) / 20)
		deco("Vine", V(1.2, h, 0.3), cf * CFrame.new(-width / 2 + i * 1.5, -h / 2, 0), (i % 2 == 0) and RGB(70, 150, 60) or RGB(90, 175, 70), Enum.Material.LeafyGrass)
	end
end

-- Estandarte de tela con emblema (cuelga de una pared, cara -Z)
function Kit.banner(cf, width, height, color, emblemColor)
	local cloth = deco("Banner", V(width, height, 0.15), cf * CFrame.new(0, -height / 2, 0), color, Enum.Material.Fabric)
	deco("BannerRod", V(width + 1, 0.3, 0.3), cf, C.Metal, Enum.Material.Metal)
	-- Emblema tipo chevron
	for _, s in { -1, 1 } do
		deco("Emblem", V(width * 0.12, height * 0.35, 0.05), cf * CFrame.new(s * width * 0.13, -height * 0.45, -0.1) * CFrame.Angles(0, 0, rad(35 * s)), emblemColor or C.White, Enum.Material.SmoothPlastic)
	end
	deco("BannerTip", V(width * 0.7, width * 0.7, 0.14), cf * CFrame.new(0, -height, 0) * CFrame.Angles(0, 0, rad(45)), color, Enum.Material.Fabric)
	return cloth
end

-- Toldo inclinado
function Kit.awning(cf, width, depth, color)
	for i = 0, math.floor(width / 1.5) - 1 do
		deco("Awning", V(1.5, 0.25, depth), cf * CFrame.new(-width / 2 + 0.75 + i * 1.5, 0, -depth / 2) * CFrame.Angles(rad(-18), 0, 0), i % 2 == 0 and color or C.White, Enum.Material.Fabric)
	end
end

-- Edificio mediterráneo: estuco, cornisa, ventanas, puerta, azotea transitable con murete
function Kit.house(cf, size, color, accent, options)
	options = options or {}
	local model = Instance.new("Model")
	model.Name = "House"
	model.Parent = Kit.folder
	local trim = color:Lerp(Color3.new(0, 0, 0), 0.18)
	block("Walls", size, cf * CFrame.new(0, size.Y / 2, 0), color, Enum.Material.Plaster, model)
	deco("Base", V(size.X + 0.4, 1.4, size.Z + 0.4), cf * CFrame.new(0, 0.7, 0), trim, Enum.Material.Limestone, model)
	Kit.contactShadow(cf, size.X + 0.4, size.Z + 0.4, false, model)
	deco("Cornice", V(size.X + 0.8, 0.8, size.Z + 0.8), cf * CFrame.new(0, size.Y - 0.4, 0), accent or RGB(200, 70, 50), Enum.Material.Plaster, model)
	-- Murete de la azotea (cobertura)
	local h = 2.6
	for _, z in { -1, 1 } do
		block("Parapet", V(size.X, h, 1), cf * CFrame.new(0, size.Y + h / 2, z * (size.Z / 2 - 0.5)), color, Enum.Material.Plaster, model)
	end
	if not options.OpenSides then
		for _, x in { -1, 1 } do
			block("Parapet", V(1, h, size.Z - 2), cf * CFrame.new(x * (size.X / 2 - 0.5), size.Y + h / 2, 0), color, Enum.Material.Plaster, model)
		end
	end
	-- Ventanas con contraventanas
	local floors = math.max(1, math.floor(size.Y / 7))
	for f = 1, floors do
		local y = (f - 0.5) * size.Y / floors + 0.6
		for _, face in { -1, 1 } do
			for i = 1, math.max(1, math.floor(size.X / 9)) do
				local x = -size.X / 2 + (i - 0.5) * size.X / math.max(1, math.floor(size.X / 9))
				local p = cf * CFrame.new(x, y, face * (size.Z / 2 + 0.1))
				deco("Window", V(2.4, 3.2, 0.2), p, RGB(60, 70, 90), Enum.Material.Glass, model) -- opaco (más barato que semitransparente)
				deco("Sill", V(3, 0.3, 0.6), p * CFrame.new(0, -1.75, 0), trim, Enum.Material.Limestone, model)
				for _, s in { -1, 1 } do
					deco("Shutter", V(1.1, 3.2, 0.15), p * CFrame.new(s * 1.85, 0, face * 0.1), accent or RGB(60, 120, 170), Enum.Material.Wood, model)
				end
			end
		end
	end
	-- Puerta con luz
	local doorCf = cf * CFrame.new(options.DoorX or 0, 3.3, -(size.Z / 2 + 0.12))
	deco("Door", V(3.6, 6.6, 0.25), doorCf, RGB(100, 65, 40), Enum.Material.WoodPlanks, model)
	deco("DoorArch", V(4.6, 0.8, 0.4), doorCf * CFrame.new(0, 3.6, 0), trim, Enum.Material.Limestone, model)
	local lamp = deco("DoorLamp", V(0.6, 0.8, 0.6), doorCf * CFrame.new(2.8, 2.5, -0.3), RGB(255, 210, 140), Enum.Material.Neon, model)
	Kit.light(lamp, "PointLight", RGB(255, 200, 120), 12, 1.2)
	if options.Vines then
		Kit.vines(cf * CFrame.new(size.X * 0.25, size.Y - 0.5, -(size.Z / 2 + 0.25)), 6, 8)
	end
	return model
end

-- Grúa pórtico decorativa (para fondos de puerto)
function Kit.crane(cf, height, color)
	color = color or RGB(240, 190, 40)
	height = height or 40
	for _, x in { -6, 6 } do
		for _, z in { -3, 3 } do
			deco("CraneLeg", V(1.2, height, 1.2), cf * CFrame.new(x, height / 2, z), color, Enum.Material.Metal)
		end
	end
	deco("CraneTop", V(14, 2, 8), cf * CFrame.new(0, height, 0), color, Enum.Material.Metal)
	deco("CraneBoom", V(2, 2, 50), cf * CFrame.new(0, height + 2, -14), color, Enum.Material.Metal)
	deco("CraneCab", V(4, 3, 4), cf * CFrame.new(0, height - 2.5, -6), RGB(230, 230, 235), Enum.Material.SmoothPlastic)
	deco("Cable", V(0.2, 12, 0.2), cf * CFrame.new(0, height - 5, -30), RGB(30, 30, 30), Enum.Material.Metal)
	local beacon = Kit.ball("CraneBeacon", 1, cf * CFrame.new(0, height + 3.5, -38), RGB(255, 40, 40), Enum.Material.Neon, true)
	beacon:SetAttribute("Blink", 1)
end

-- Barco de carga decorativo
function Kit.ship(cf, length)
	length = length or 90
	deco("Hull", V(length, 10, 18), cf * CFrame.new(0, 3, 0), RGB(40, 50, 70), Enum.Material.Metal)
	deco("HullStripe", V(length + 0.2, 1.5, 18.2), cf * CFrame.new(0, -1, 0), RGB(200, 40, 40), Enum.Material.Metal)
	deco("Bridge", V(10, 12, 14), cf * CFrame.new(length / 2 - 8, 14, 0), C.White, Enum.Material.SmoothPlastic)
	local colors = { C.Red, C.Blue, RGB(240, 150, 30), RGB(60, 170, 90) }
	local i = 0
	for x = -length / 2 + 8, length / 2 - 18, 9 do
		for row = 0, 1 do
			i += 1
			deco("Cargo", V(8.5, 4, 8), cf * CFrame.new(x, 10 + row * 4, (i % 2 == 0) and -4.2 or 4.2), colors[i % #colors + 1], Enum.Material.CorrodedMetal)
		end
	end
end

-- Faro sobre una isla de roca (fondo)
function Kit.lighthouse(position)
	local terrain = workspace.Terrain
	terrain:FillBall(position + V(0, -6, 0), 26, Enum.Material.Rock)
	terrain:FillBall(position + V(14, -10, 8), 18, Enum.Material.Rock)
	terrain:FillBall(position + V(-10, -2, -6), 14, Enum.Material.Grass)
	local base = position + V(0, 12, 0)
	cylinder("LighthouseTower", 26, 7, CFrame.new(base + V(0, 13, 0)), C.White, Enum.Material.Plaster, nil, true)
	for i = 0, 2 do
		cylinder("LighthouseStripe", 2.5, 7.1, CFrame.new(base + V(0, 6 + i * 8, 0)), C.Red, Enum.Material.Plaster, nil, true)
	end
	cylinder("LighthouseTop", 3, 5, CFrame.new(base + V(0, 27.5, 0)), RGB(255, 245, 200), Enum.Material.Neon, nil, true)
	cylinder("LighthouseRoof", 2, 6, CFrame.new(base + V(0, 30, 0)), C.Red, Enum.Material.Plaster, nil, true)
end

-- Tubería industrial con soportes
function Kit.pipeRun(a, b, diameter, color)
	local length = (b - a).Magnitude
	local cf = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, rad(90), 0)
	Kit.pipe("Pipe", length, diameter, cf, color or RGB(90, 95, 110), Enum.Material.Metal, true)
	local rings = math.floor(length / 8)
	for i = 1, rings do
		local p = a:Lerp(b, i / (rings + 1))
		Kit.pipe("PipeRing", 0.5, diameter + 0.3, CFrame.lookAt(p, b) * CFrame.Angles(0, rad(90), 0), RGB(50, 52, 60), Enum.Material.Metal, true)
	end
end

-- Canal de lava (daña al tocarla; ver Hazards)
function Kit.lava(size, cf)
	local lava = block("Lava", size, cf, RGB(255, 100, 20), Enum.Material.CrackedLava)
	lava:SetAttribute("Hazard", "Lava")
	local glow = deco("LavaGlow", V(size.X, 0.1, size.Z), cf * CFrame.new(0, size.Y / 2 + 0.05, 0), RGB(255, 140, 30), Enum.Material.Neon)
	glow.Transparency = 0.4
	Kit.light(glow, "SurfaceLight", RGB(255, 120, 30), 16, 1.2, Enum.NormalId.Top)
	return lava
end

-- Cinta transportadora con lingotes
function Kit.conveyor(a, b, width)
	local length = (b - a).Magnitude
	local cf = CFrame.lookAt((a + b) / 2, b)
	block("Conveyor", V(width, 1, length), cf, RGB(40, 42, 48), Enum.Material.DiamondPlate)
	for _, s in { -1, 1 } do
		deco("ConveyorSide", V(0.4, 1.2, length), cf * CFrame.new(s * (width / 2 + 0.2), 0.3, 0), RGB(255, 170, 30), Enum.Material.Metal)
	end
	for i = 1, math.floor(length / 4) do
		local bar = deco("GoldBar", V(1.6, 0.6, 2.4), cf * CFrame.new(0, 0.8, -length / 2 + i * 4), RGB(255, 200, 60), Enum.Material.Foil)
		bar.CastShadow = true
	end
end

-- Chimenea industrial con luz roja
function Kit.smokestack(position, height)
	cylinder("Smokestack", height, 6, CFrame.new(position + V(0, height / 2, 0)), RGB(70, 65, 70), Enum.Material.Concrete, nil, true)
	for i = 1, 3 do
		cylinder("StackStripe", 1.2, 6.1, CFrame.new(position + V(0, height * i / 4, 0)), RGB(200, 60, 40), Enum.Material.Concrete, nil, true)
	end
	local light = Kit.ball("StackLight", 1.2, CFrame.new(position + V(0, height + 0.8, 0)), RGB(255, 40, 40), Enum.Material.Neon, true)
	light:SetAttribute("Blink", 1.5)
	-- Humo saliendo de la chimenea
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Color = ColorSequence.new(RGB(120, 110, 130), RGB(60, 55, 70))
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 16) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
	smoke.Lifetime = NumberRange.new(5, 8)
	smoke.Speed = NumberRange.new(4, 7)
	smoke.SpreadAngle = Vector2.new(12, 12)
	smoke.Acceleration = V(2, 1, 0)
	smoke.Rate = 4
	smoke.EmissionDirection = Enum.NormalId.Top
	smoke.Parent = light
end

-- Guirnalda de bombillas entre dos puntos (cuelga un poco por el centro)
function Kit.stringLights(a, b, color)
	local count = math.max(4, math.floor((b - a).Magnitude / 2.5))
	for i = 0, count do
		local t = i / count
		local p = a:Lerp(b, t) - V(0, math.sin(t * math.pi) * 1.5, 0)
		local bulb = Kit.ball("Bulb", 0.45, CFrame.new(p), (i % 3 == 0) and RGB(255, 120, 120) or (color or RGB(255, 220, 140)), Enum.Material.Neon, true)
		bulb.CastShadow = false
	end
	local mid = (a + b) / 2 - V(0, 0.75, 0)
	deco("LightWire", V(0.08, 0.08, (b - a).Magnitude), CFrame.lookAt(mid, b), RGB(30, 30, 30), Enum.Material.SmoothPlastic)
end

-- Maceta con flores
function Kit.flowerPot(cf, flowerColor)
	block("Pot", V(2, 1.6, 2), cf * CFrame.new(0, 0.8, 0), RGB(190, 100, 60), Enum.Material.Plaster)
	Kit.ball("Bush", 2.4, cf * CFrame.new(0, 2.1, 0), RGB(70, 160, 70), Enum.Material.Grass, true)
	for i = 0, 2 do
		Kit.ball("Flower", 0.6, cf * CFrame.new(math.cos(i * 2.1) * 0.8, 2.9, math.sin(i * 2.1) * 0.8), flowerColor or RGB(255, 90, 140), Enum.Material.SmoothPlastic, true)
	end
end

-- Parche de flores (tulipanes de colores con tallo y hoja), decorativo: se atraviesa
local TULIP_COLORS = { RGB(235, 50, 60), RGB(255, 200, 40), RGB(255, 110, 170), RGB(250, 250, 255), RGB(160, 90, 255) }
function Kit.flowers(position, count, seed)
	local rng = Random.new(seed or math.floor(position.X * 17 + position.Z * 29))
	count = count or 3
	for _ = 1, count do
		local offset = V(rng:NextNumber(-1.6, 1.6), 0, rng:NextNumber(-1.6, 1.6))
		local h = rng:NextNumber(0.9, 1.5)
		local base = CFrame.new(position + offset) * CFrame.Angles(rng:NextNumber(-0.15, 0.15), rng:NextNumber(0, 6.28), rng:NextNumber(-0.15, 0.15))
		deco("FlowerStem", V(0.1, h, 0.1), base * CFrame.new(0, h / 2, 0), RGB(60, 160, 60), Enum.Material.SmoothPlastic)
		local color = TULIP_COLORS[rng:NextInteger(1, #TULIP_COLORS)]
		local bloom = deco("FlowerBloom", V(0.34, 0.42, 0.34), base * CFrame.new(0, h + 0.15, 0), color, Enum.Material.SmoothPlastic)
		bloom.CastShadow = false
		for k = 0, 2 do
			deco("FlowerPetal", V(0.18, 0.3, 0.06), base * CFrame.Angles(0, k * 2.09, 0) * CFrame.new(0, h + 0.24, 0.16) * CFrame.Angles(rad(-20), 0, 0), color, Enum.Material.SmoothPlastic)
		end
	end
end

-- Pino cartoon (pisos redondos cada vez más estrechos, verde vivo). far = menos pisos (fondo)
function Kit.cartoonPine(position, scale, far)
	scale = scale or 1
	cylinder("PineTrunk", 4 * scale, 1.2 * scale, CFrame.new(position + V(0, 2 * scale, 0)), RGB(120, 80, 50), Enum.Material.Wood)
	local tiers = far and 3 or 5
	for i = 1, tiers do
		local t = (i - 1) / (tiers - 1)
		local d = (9 - 6.5 * t) * scale
		local y = (3.5 + t * 9) * scale
		local h = (12 / tiers + 0.8) * scale
		local tier = cylinder("PineTier", h, d, CFrame.new(position + V(0, y, 0)), RGB(60, 190, 90):Lerp(RGB(40, 150, 70), (i % 2) * 0.5), Enum.Material.SmoothPlastic, nil, true)
		tier.CastShadow = not far
	end
end

-- Mata de hierba alta (hojas finas inclinadas en abanico)
function Kit.grassTuft(position, scale, seed)
	local rng = Random.new(seed or math.floor(position.X * 23 + position.Z * 7))
	scale = scale or 1
	for i = 0, 3 do
		local h = rng:NextNumber(1.1, 1.9) * scale
		local angle = i * 1.57 + rng:NextNumber(-0.3, 0.3)
		local tilt = rad(rng:NextNumber(12, 30))
		local blade = deco("GrassBlade", V(0.16 * scale, h, 0.05), CFrame.new(position) * CFrame.Angles(0, angle, 0) * CFrame.Angles(tilt, 0, 0) * CFrame.new(0, h / 2, 0), RGB(70, 190, 70):Lerp(RGB(40, 140, 50), rng:NextNumber()), Enum.Material.SmoothPlastic)
		blade.CastShadow = false
	end
end

-- Cartel de neón grande con texto
function Kit.neonSign(cf, width, height, text, color, frameColor)
	local board = deco("NeonBoard", V(width, height, 0.6), cf, RGB(20, 20, 30), Enum.Material.SmoothPlastic)
	sign(board, Enum.NormalId.Front, text, color, frameColor or color:Lerp(Color3.new(1, 1, 1), 0.5))
	for _, y in { -1, 1 } do
		deco("NeonFrame", V(width + 0.6, 0.35, 0.7), cf * CFrame.new(0, y * height / 2, 0), frameColor or color, Enum.Material.Neon)
	end
	for _, x in { -1, 1 } do
		deco("NeonFrame", V(0.35, height, 0.7), cf * CFrame.new(x * width / 2, 0, 0), frameColor or color, Enum.Material.Neon)
	end
	Kit.light(board, "SurfaceLight", color, 18, 1.5, Enum.NormalId.Front)
	return board
end

-- Carretilla elevadora decorativa
function Kit.forklift(cf)
	block("ForkBody", V(4, 3, 6), cf * CFrame.new(0, 2, 0), RGB(250, 190, 30), Enum.Material.SmoothPlastic)
	deco("ForkCab", V(3.6, 3, 0.3), cf * CFrame.new(0, 5, 1.5), RGB(40, 40, 45), Enum.Material.Metal)
	deco("ForkRoof", V(4, 0.3, 4), cf * CFrame.new(0, 6.6, 0), RGB(40, 40, 45), Enum.Material.Metal)
	deco("ForkMast", V(3, 6, 0.4), cf * CFrame.new(0, 3.5, -3.2), RGB(40, 40, 45), Enum.Material.Metal)
	for _, x in { -1, 1 } do
		deco("Fork", V(0.4, 0.3, 3), cf * CFrame.new(x * 1, 0.6, -4.8), RGB(40, 40, 45), Enum.Material.Metal)
		for _, z in { -2, 2 } do
			Kit.pipe("Wheel", 0.8, 1.6, cf * CFrame.new(x * 2.1, 0.8, z), RGB(25, 25, 28), Enum.Material.Rubber, true)
		end
	end
end

-- Barca decorativa en el agua
function Kit.boat(cf)
	deco("BoatHull", V(6, 2, 14), cf * CFrame.new(0, 0.5, 0), C.White, Enum.Material.SmoothPlastic)
	deco("BoatStripe", V(6.1, 0.6, 14.1), cf * CFrame.new(0, 0.2, 0), C.Red, Enum.Material.SmoothPlastic)
	deco("BoatCabin", V(4.4, 3, 5), cf * CFrame.new(0, 3, 1), RGB(230, 230, 235), Enum.Material.SmoothPlastic)
	deco("BoatRoof", V(5, 0.4, 6), cf * CFrame.new(0, 4.7, 1), C.Red, Enum.Material.SmoothPlastic)
	deco("BoatWindow", V(4.5, 1, 0.2), cf * CFrame.new(0, 3.3, -1.5), RGB(60, 120, 180), Enum.Material.Glass)
end

---------------------------------------------------------------------------
-- Detalles realistas
---------------------------------------------------------------------------

-- Charco: manchas planas de agua que reflejan el cielo y las luces (formas irregulares)
function Kit.puddle(position, size, seed)
	local rng = Random.new(seed or math.floor(position.X * 7 + position.Z * 13))
	for i = 1, 3 do
		local d = size * (i == 1 and 1 or rng:NextNumber(0.45, 0.75))
		local offset = i == 1 and V(0, 0, 0) or V(rng:NextNumber(-0.4, 0.4) * size, 0, rng:NextNumber(-0.4, 0.4) * size)
		local water = deco("Puddle", V(0.04, d, d), CFrame.new(position + offset + V(0, 0.03 + i * 0.002, 0)) * CFrame.Angles(0, 0, math.pi / 2), RGB(38, 44, 52), Enum.Material.Glass)
		water.Shape = Enum.PartType.Cylinder
		water.Transparency = 0.25
		water.Reflectance = 0.45
	end
end

-- Cono de luz volumétrica bajo una lámpara: discos casi transparentes cada vez más anchos (se ve
-- el haz en el aire, sobre todo con niebla). `top` es la posición de la lámpara.
function Kit.lightCone(top, height, topRadius, bottomRadius, color)
	local segments = 5
	local step = height / segments
	for i = 1, segments do
		local t = (i - 0.5) / segments
		local radius = topRadius + (bottomRadius - topRadius) * t
		local disc = deco("LightCone", V(step, radius * 2, radius * 2), CFrame.new(top - V(0, step * (i - 0.5), 0)) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.Material.Neon)
		disc.Shape = Enum.PartType.Cylinder
		disc.Transparency = 0.93 + 0.01 * i
		disc.CastShadow = false
	end
end

-- Vapor que sale de una rejilla del suelo
function Kit.steamVent(cf, strength)
	strength = strength or 1
	local grate = deco("VentGrate", V(3, 0.1, 3), cf * CFrame.new(0, 0.05, 0), RGB(40, 42, 48), Enum.Material.DiamondPlate)
	for i = -1, 1 do
		deco("VentSlot", V(2.6, 0.12, 0.25), cf * CFrame.new(0, 0.06, i * 0.8), RGB(15, 15, 18), Enum.Material.Metal)
	end
	local steam = Instance.new("ParticleEmitter")
	steam.Name = "Steam"
	steam.Texture = "rbxasset://textures/particles/smoke_main.dds"
	steam.Color = ColorSequence.new(RGB(235, 238, 245))
	steam.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 6) })
	steam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.75), NumberSequenceKeypoint.new(0.3, 0.6), NumberSequenceKeypoint.new(1, 1) })
	steam.Lifetime = NumberRange.new(2.5, 4)
	steam.Speed = NumberRange.new(3, 6)
	steam.SpreadAngle = Vector2.new(12, 12)
	steam.Acceleration = V(0, 0.8, 0)
	steam.RotSpeed = NumberRange.new(-20, 20)
	steam.Rotation = NumberRange.new(0, 360)
	steam.Rate = 6 * strength
	steam.LightInfluence = 1
	steam.EmissionDirection = Enum.NormalId.Top
	steam.WindAffectsDrag = true
	steam.Parent = grate
	return grate
end

-- Polvo flotando en el aire (se ve a contraluz): una caja invisible que emite motas lentas
function Kit.dustMotes(cf, size, color, rate)
	local volume = deco("DustVolume", size, cf, RGB(255, 255, 255), Enum.Material.SmoothPlastic)
	volume.Transparency = 1
	local dust = Instance.new("ParticleEmitter")
	dust.Name = "Dust"
	dust.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	dust.Color = ColorSequence.new(color or RGB(255, 245, 220))
	dust.LightEmission = 0.4
	dust.LightInfluence = 0.6
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.12), NumberSequenceKeypoint.new(1, 0) })
	dust.Transparency = NumberSequence.new(0.3)
	dust.Lifetime = NumberRange.new(5, 8)
	dust.Speed = NumberRange.new(0.2, 0.6)
	dust.SpreadAngle = Vector2.new(180, 180)
	dust.RotSpeed = NumberRange.new(-30, 30)
	dust.Rate = rate or 12
	dust.WindAffectsDrag = true
	dust.Shape = Enum.ParticleEmitterShape.Box
	dust.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	dust.Parent = volume
	return volume
end

-- Colina natural de fondo (terreno): una bola grande deformada con bultos, salientes de roca y,
-- si se pide, manchas de otro material por encima (selva, nieve...). Nada de bolas perfectas.
-- `inward` (vector horizontal hacia el centro del mapa) evita que los bultos invadan la zona de juego.
function Kit.naturalHill(center, radius, material, options)
	options = options or {}
	local terrain = workspace.Terrain
	local rng = Random.new(options.Seed or math.floor(center.X * 3 + center.Z * 7))
	local inward = options.Inward
	local function away(offset)
		if inward and offset:Dot(inward) > 0 then
			return offset - inward * (2 * offset:Dot(inward))
		end
		return offset
	end
	-- Dirección sobre la superficie que queda por encima del suelo (y > 3)
	local function surfaceDir(minUp, maxUp)
		local low = math.asin(math.clamp((3 - center.Y) / radius, -1, 1))
		local elevation = math.max(low, minUp) + rng:NextNumber(0, 1) * math.max(0, maxUp - math.max(low, minUp))
		local angle = rng:NextNumber(0, math.pi * 2)
		return V(math.cos(angle) * math.cos(elevation), math.sin(elevation), math.sin(angle) * math.cos(elevation))
	end
	terrain:FillBall(center, radius, material)
	for _ = 1, 4 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local dist = rng:NextNumber(0.35, 0.7) * radius
		local offset = away(V(math.cos(angle) * dist, rng:NextNumber(-0.25, 0.05) * radius, math.sin(angle) * dist))
		terrain:FillBall(center + offset, radius * rng:NextNumber(0.45, 0.65), material)
	end
	-- Salientes de roca en la ladera
	for _ = 1, options.RockCount or 3 do
		local dir = surfaceDir(0.15, 1.1)
		terrain:FillBall(center + dir * radius * 0.94, radius * rng:NextNumber(0.1, 0.18), options.Rock or Enum.Material.Rock)
	end
	-- Manchas en la cima (copas de árboles con LeafyGrass, nieve en una montaña de roca...)
	if options.Top then
		for _ = 1, options.TopCount or 5 do
			local dir = surfaceDir(0.5, 1.4)
			terrain:FillBall(center + dir * radius * 0.92, radius * rng:NextNumber(0.18, 0.3), options.Top)
		end
	end
end

-- Grupo de rocas de terreno medio enterradas (una grande y dos pequeñas al lado)
function Kit.rockCluster(position, size, material, seed)
	local rng = Random.new(seed or math.floor(position.X * 5 + position.Z * 11))
	material = material or Enum.Material.Rock
	local terrain = workspace.Terrain
	terrain:FillBall(position - V(0, size * 0.35, 0), size, material)
	for _ = 1, 2 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local r = size * rng:NextNumber(0.45, 0.65)
		terrain:FillBall(position + V(math.cos(angle) * size * 0.9, -r * 0.4, math.sin(angle) * size * 0.9), r, material)
	end
end

-- Arbusto: tres bolas de hojas con tonos distintos (decorativo: se atraviesa)
function Kit.bush(position, scale, color)
	scale = scale or 1
	local rng = Random.new(math.floor(position.X * 11 + position.Z * 5))
	local base = color or RGB(58, 112, 46)
	for _ = 1, 3 do
		local d = scale * rng:NextNumber(2.4, 3.6)
		local offset = V(rng:NextNumber(-1, 1) * scale, d * 0.3, rng:NextNumber(-1, 1) * scale)
		local leaf = Kit.ball("Bush", d, CFrame.new(position + offset), base:Lerp(Color3.new(0, 0, 0), rng:NextNumber(0, 0.25)), Enum.Material.LeafyGrass, true)
		leaf.CastShadow = d >= 3
	end
end

-- Tronco caído con musgo por encima y los cortes claros (sirve de cobertura baja)
function Kit.log(cf, length, diameter)
	local y = diameter * 0.42
	Kit.pipe("Log", length, diameter, cf * CFrame.new(0, y, 0), RGB(92, 70, 50), Enum.Material.Wood)
	Kit.deco("LogMoss", V(length * 0.7, 0.2, diameter * 0.5), cf * CFrame.new(length * 0.05, y + diameter * 0.42, 0), RGB(78, 118, 52), Enum.Material.LeafyGrass)
	for _, side in { -1, 1 } do
		Kit.pipe("LogEnd", 0.1, diameter * 0.9, cf * CFrame.new(side * length / 2, y, 0), RGB(168, 132, 92), Enum.Material.Wood, true)
	end
end

-- Coche aparcado (sedán): carrocería de pintura brillante, cabina de cristal, ruedas de goma con
-- tapacubos, faros y pilotos. La carrocería y la cabina son cobertura; el resto es decorativo.
-- Largo en el eje X local (el morro mira a -X). options.Snow = true le pone nieve encima.
function Kit.car(cf, color, options)
	options = options or {}
	local model = Instance.new("Model")
	model.Name = "Car"
	model.Parent = Kit.folder
	local function paint(part)
		part.Material = Enum.Material.SmoothPlastic -- pintura lisa con brillo (no yeso)
		part.MaterialVariant = "" -- sin cuadrícula: es pintura de coche
		part.Reflectance = 0.12
		return part
	end
	paint(block("CarBody", V(9, 1.5, 4.2), cf * CFrame.new(0, 1.25, 0), color, nil, model))
	paint(block("CarHood", V(2.6, 0.35, 4.1), cf * CFrame.new(-3.1, 2.15, 0), color, nil, model))
	paint(block("CarTrunk", V(1.6, 0.35, 4.1), cf * CFrame.new(3.6, 2.15, 0), color, nil, model))
	local cabin = block("CarCabin", V(4.6, 1.35, 3.8), cf * CFrame.new(0.2, 2.65, 0), RGB(28, 34, 44), Enum.Material.Glass, model)
	cabin.Reflectance = 0.35
	cabin.Transparency = 0.15
	paint(deco("CarRoof", V(3.4, 0.22, 3.86), cf * CFrame.new(0.3, 3.42, 0), color, nil, model))
	-- Parabrisas y luna trasera inclinados (cuñas de cristal)
	for _, spec in { { -2.6, 1, math.pi / 2 }, { 2.9, 0.8, -math.pi / 2 } } do
		local glass = Instance.new("WedgePart")
		glass.Name = "CarWindshield"
		glass.Anchored = true
		glass.CanCollide = false
		glass.CanQuery = false
		glass.CanTouch = false
		glass.CastShadow = false
		glass.Size = V(3.8, 1.35, spec[2])
		glass.CFrame = cf * CFrame.new(spec[1], 2.65, 0) * CFrame.Angles(0, spec[3], 0)
		glass.Color = RGB(28, 34, 44)
		glass.Material = Enum.Material.Glass
		glass.Reflectance = 0.35
		glass.Transparency = 0.15
		glass.Parent = model
	end
	for _, x in { -2.15, 2.5 } do
		paint(deco("CarPillar", V(0.3, 1.35, 3.86), cf * CFrame.new(x, 2.65, 0), color, nil, model))
	end
	-- Ruedas y tapacubos
	for _, x in { -2.9, 2.9 } do
		for _, z in { -1.85, 1.85 } do
			local wheel = deco("Wheel", V(1.75, 1.75, 0.7), cf * CFrame.new(x, 0.875, z) * CFrame.Angles(0, math.pi / 2, 0), RGB(24, 24, 26), Enum.Material.Rubber, model)
			wheel.Shape = Enum.PartType.Cylinder
			local hub = deco("Hubcap", V(0.08, 0.95, 0.95), cf * CFrame.new(x, 0.875, z + (z > 0 and 0.36 or -0.36)) * CFrame.Angles(0, math.pi / 2, 0), RGB(190, 192, 198), Enum.Material.Metal, model)
			hub.Shape = Enum.PartType.Cylinder
		end
	end
	-- Parachoques, faros y pilotos
	for _, x in { -4.6, 4.6 } do
		deco("Bumper", V(0.3, 0.5, 4.3), cf * CFrame.new(x, 0.85, 0), RGB(35, 35, 38), Enum.Material.Plastic, model)
	end
	for _, z in { -1.5, 1.5 } do
		deco("Headlight", V(0.12, 0.35, 0.8), cf * CFrame.new(-4.52, 1.55, z), RGB(250, 248, 235), Enum.Material.Neon, model)
		deco("Taillight", V(0.12, 0.3, 0.7), cf * CFrame.new(4.52, 1.6, z), RGB(200, 25, 25), Enum.Material.Neon, model)
	end
	deco("Plate", V(0.08, 0.35, 1.1), cf * CFrame.new(4.62, 1.05, 0), RGB(235, 235, 225), Enum.Material.SmoothPlastic, model)
	if options.Snow then
		local snow = RGB(240, 245, 252)
		deco("CarSnow", V(3.2, 0.35, 3.6), cf * CFrame.new(0.3, 3.7, 0), snow, Enum.Material.Snow, model)
		deco("CarSnow", V(2.3, 0.25, 3.8), cf * CFrame.new(-3.2, 2.45, 0), snow, Enum.Material.Snow, model)
		deco("CarSnow", V(1.4, 0.25, 3.8), cf * CFrame.new(3.6, 2.45, 0), snow, Enum.Material.Snow, model)
	end
	Kit.contactShadow(cf, 9, 4.2, false, model)
	return model
end

-- Tapa de alcantarilla de hierro fundido
function Kit.manhole(position)
	Kit.cylinder("ManholeRim", 0.05, 3.5, CFrame.new(position + V(0, 0.025, 0)), RGB(72, 70, 66), Enum.Material.Metal, nil, true)
	Kit.cylinder("Manhole", 0.07, 3, CFrame.new(position + V(0, 0.035, 0)), RGB(46, 44, 42), Enum.Material.DiamondPlate, nil, true)
end

-- Rejilla de desagüe junto a un bordillo
function Kit.drain(cf)
	Kit.deco("DrainFrame", V(3.2, 0.06, 1.6), cf * CFrame.new(0, 0.03, 0), RGB(60, 58, 55), Enum.Material.Metal)
	for i = -3, 3 do
		Kit.deco("DrainSlot", V(0.18, 0.07, 1.2), cf * CFrame.new(i * 0.4, 0.036, 0), RGB(14, 14, 16), Enum.Material.Metal)
	end
end

-- Mancha de aceite: discos oscuros semitransparentes con un brillo leve
function Kit.oilStain(position, size, seed)
	local rng = Random.new(seed or math.floor(position.X * 13 + position.Z * 3))
	for i = 1, 3 do
		local d = size * (i == 1 and 1 or rng:NextNumber(0.4, 0.7))
		local offset = i == 1 and V(0, 0, 0) or V(rng:NextNumber(-0.35, 0.35) * size, 0, rng:NextNumber(-0.35, 0.35) * size)
		local stain = Kit.cylinder("OilStain", 0.02, d, CFrame.new(position + offset + V(0, 0.012 + i * 0.002, 0)), RGB(18, 18, 20), Enum.Material.SmoothPlastic, nil, true)
		stain.Transparency = 0.55 + i * 0.08
		stain.Reflectance = 0.08
	end
end

-- Grieta en el suelo: segmentos finos en zigzag
function Kit.crack(position, length, seed)
	local rng = Random.new(seed or math.floor(position.X * 7 + position.Z * 17))
	local heading = rng:NextNumber(0, math.pi * 2)
	local point = position
	local segments = math.max(3, math.floor(length / 2.5))
	for i = 1, segments do
		heading += rng:NextNumber(-0.7, 0.7)
		local seg = length / segments
		local dir = V(math.cos(heading), 0, math.sin(heading))
		local width = 0.16 * (1 - i / (segments + 1)) + 0.05
		Kit.deco("Crack", V(seg + 0.1, 0.03, width), CFrame.lookAt(point + dir * (seg / 2) + V(0, 0.015, 0), point + dir * seg + V(0, 0.015, 0)) * CFrame.Angles(0, math.pi / 2, 0), RGB(28, 28, 30), Enum.Material.SmoothPlastic)
		point += dir * seg
	end
end

-- Juntas de dilatación de una losa de hormigón o asfalto: líneas oscuras cada `spacing` studs
function Kit.floorJoints(cf, length, width, spacing, color)
	color = color or RGB(40, 40, 42)
	for x = -length / 2 + spacing, length / 2 - spacing / 2, spacing do
		Kit.deco("Joint", V(0.15, 0.03, width), cf * CFrame.new(x, 0.015, 0), color, Enum.Material.SmoothPlastic)
	end
	for z = -width / 2 + spacing, width / 2 - spacing / 2, spacing do
		Kit.deco("Joint", V(length, 0.03, 0.15), cf * CFrame.new(0, 0.015, z), color, Enum.Material.SmoothPlastic)
	end
end

-- Marcas de neumático: dos franjas oscuras paralelas que hacen una curva suave
function Kit.tireMarks(cf, length, bend)
	bend = bend or 0.3
	local segments = 6
	local seg = length / segments
	local pose = cf
	for _ = 1, segments do
		pose = pose * CFrame.Angles(0, bend / segments, 0)
		for _, side in { -1.1, 1.1 } do
			local mark = Kit.deco("TireMark", V(0.7, 0.02, seg + 0.05), pose * CFrame.new(side, 0.011, -seg / 2), RGB(20, 20, 22), Enum.Material.SmoothPlastic)
			mark.Transparency = 0.6
		end
		pose = pose * CFrame.new(0, 0, -seg)
	end
end

---------------------------------------------------------------------------
-- Puntos especiales del modo de juego
---------------------------------------------------------------------------

-- Zona de reaparición del equipo con techo, muretes y SpawnLocations
function Kit.spawnArea(team, cf, style)
	style = style or {}
	local teamColor = team.Color.Color
	local light = teamColor:Lerp(Color3.new(1, 1, 1), 0.55)
	local floorColor = style.Floor or light
	block(team.Name .. "SpawnFloor", V(30, 0.4, 70), cf * CFrame.new(0, 0.2, 0), floorColor, style.FloorMaterial or Enum.Material.SmoothPlastic)
	for z = -30, 30, 10 do
		deco("FloorLine", V(30, 0.05, 0.3), cf * CFrame.new(0, 0.42, z), teamColor, Enum.Material.SmoothPlastic)
	end
	local roofColor = style.Roof or RGB(235, 235, 240)
	block(team.Name .. "SpawnRoof", V(30, 1, 70), cf * CFrame.new(0, 16, 0), roofColor, style.RoofMaterial or Enum.Material.Concrete)
	deco("RoofTrim", V(0.6, 0.5, 70.2), cf * CFrame.new(15, 15.4, 0), teamColor, Enum.Material.Neon)
	local banner = block("TeamBanner", V(0.6, 4, 28), cf * CFrame.new(15.2, 18.6, 0), teamColor, Enum.Material.SmoothPlastic)
	sign(banner, Enum.NormalId.Right, "EQUIPO " .. string.upper(team.Name), Color3.new(1, 1, 1))
	sign(banner, Enum.NormalId.Left, "EQUIPO " .. string.upper(team.Name), Color3.new(1, 1, 1))
	for _, z in { -34, 34 } do
		block("Pillar", V(2, 16, 2), cf * CFrame.new(14, 8, z), roofColor, Enum.Material.Concrete)
		deco("PillarStripe", V(2.1, 1, 2.1), cf * CFrame.new(14, 12, z), teamColor, Enum.Material.Neon)
	end
	for _, z in { -24, 0, 24 } do
		block("Cover", V(2, 4, 10), cf * CFrame.new(14, 2, z), teamColor, Enum.Material.SmoothPlastic)
		deco("CoverTop", V(2.1, 0.3, 10.1), cf * CFrame.new(14, 4.05, z), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
	end
	for i, z in { -24, -8, 8, 24 } do
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = team.Name .. "Spawn" .. i
		spawn.Anchored = true
		spawn.Size = V(6, 1, 6)
		spawn.CFrame = cf * CFrame.new(-4, 0.5, z) * CFrame.Angles(0, -math.pi / 2, 0)
		spawn.TeamColor = team.Color
		spawn.BrickColor = team.Color
		spawn.Material = Enum.Material.Neon
		spawn.Neutral = false
		spawn.AllowTeamChangeOnTouch = false
		spawn.Duration = GameConfig.SpawnProtection
		spawn.Parent = Kit.folder
		local decal = spawn:FindFirstChildOfClass("Decal")
		if decal then
			decal:Destroy()
		end
	end
	local lamp = deco("SpawnLight", V(20, 0.2, 60), cf * CFrame.new(0, 15.4, 0), teamColor:Lerp(Color3.new(1, 1, 1), 0.7), Enum.Material.Neon)
	Kit.light(lamp, "SurfaceLight", teamColor:Lerp(Color3.new(1, 1, 1), 0.5), 16, 0.8, Enum.NormalId.Bottom)
end

-- Base de la bandera (Captura la bandera). Flags busca piezas "FlagBase" con el atributo Team.
function Kit.flagBase(team, cf)
	local teamColor = team.Color.Color
	local ring = deco("FlagBaseRing", V(0.3, 13, 13), cf * CFrame.new(0, 0.15, 0) * CFrame.Angles(0, 0, math.pi / 2), teamColor, Enum.Material.Neon)
	ring.Shape = Enum.PartType.Cylinder
	local pad = block("FlagBase", V(0.4, 11, 11), cf * CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.pi / 2), RGB(235, 235, 240), Enum.Material.Concrete)
	pad.Shape = Enum.PartType.Cylinder
	pad:SetAttribute("Team", team.Name)
	local inner = deco("FlagBaseInner", V(0.45, 4, 4), cf * CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.pi / 2), teamColor, Enum.Material.Neon)
	inner.Shape = Enum.PartType.Cylinder
	for i = 0, 3 do
		local angle = i * math.pi / 2 + math.pi / 4
		local offset = CFrame.new(math.cos(angle) * 7.5, 0, math.sin(angle) * 7.5)
		cylinder("Pylon", 2, 0.7, cf * offset * CFrame.new(0, 1, 0), RGB(230, 230, 235), Enum.Material.SmoothPlastic, nil, true)
		Kit.ball("PylonLight", 0.8, cf * offset * CFrame.new(0, 2.3, 0), teamColor, Enum.Material.Neon, true)
	end
	Kit.light(inner, "PointLight", teamColor, 16, 1.5)
	return pad
end

-- Calabaza de Halloween con cara iluminada (decoración del evento; se atraviesa)
function Kit.pumpkin(cf, scale)
	scale = scale or 1
	-- Esferas achatadas: una Ball de Roblox siempre es redonda, así que se usa una malla de esfera
	local function squashed(part)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = part
	end
	local body = deco("Pumpkin", V(3 * scale, 2.4 * scale, 3 * scale), cf * CFrame.new(0, 1.2 * scale, 0), RGB(255, 130, 20), Enum.Material.SmoothPlastic)
	squashed(body)
	for _, a in { 0, 60, 120 } do
		local rib = deco("PumpkinRib", V(0.6 * scale, 2.3 * scale, 3.06 * scale), cf * CFrame.new(0, 1.2 * scale, 0) * CFrame.Angles(0, rad(a), 0), RGB(230, 100, 10), Enum.Material.SmoothPlastic)
		squashed(rib)
	end
	Kit.cylinder("PumpkinStem", 0.6 * scale, 0.35 * scale, cf * CFrame.new(0, 2.5 * scale, 0), RGB(80, 120, 40), Enum.Material.SmoothPlastic, nil, true)
	-- Ojos y boca brillantes (hacia -Z del cf)
	for _, s in { -1, 1 } do
		deco("PumpkinEye", V(0.45 * scale, 0.4 * scale, 0.2 * scale), cf * CFrame.new(s * 0.5 * scale, 1.5 * scale, -1.42 * scale) * CFrame.Angles(0, 0, rad(s * 20)), RGB(255, 220, 90), Enum.Material.Neon)
	end
	local mouth = deco("PumpkinMouth", V(1.1 * scale, 0.25 * scale, 0.2 * scale), cf * CFrame.new(0, 0.85 * scale, -1.45 * scale), RGB(255, 220, 90), Enum.Material.Neon)
	Kit.light(mouth, "PointLight", RGB(255, 160, 60), 8 * scale, 0.8)
	return body
end

-- Plataforma de salto: al pisarla te lanza hacia arriba (el cliente lo hace, ver JumpPads).
-- power = velocidad vertical (75 ≈ 14 studs de altura). Para subir a cornisas y a lo alto.
function Kit.jumpPad(position, power, color)
	color = color or RGB(80, 230, 255)
	local ring = Kit.cylinder("JumpPadRing", 0.4, 7.6, CFrame.new(position + V(0, 0.2, 0)), RGB(250, 250, 255), Enum.Material.SmoothPlastic)
	ring:SetAttribute("JumpPad", power or 75) -- también lanza si pisas el borde
	local pad = Kit.cylinder("JumpPad", 0.5, 6, CFrame.new(position + V(0, 0.3, 0)), color, Enum.Material.Neon)
	pad:SetAttribute("JumpPad", power or 75)
	local sparks = Instance.new("ParticleEmitter")
	sparks.Name = "JumpPadSparks"
	sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparks.Color = ColorSequence.new(color)
	sparks.LightEmission = 1
	sparks.Size = NumberSequence.new(0.6, 0)
	sparks.Lifetime = NumberRange.new(0.6, 1)
	sparks.Rate = 8
	sparks.Speed = NumberRange.new(8, 12)
	sparks.SpreadAngle = Vector2.new(12, 12)
	sparks.EmissionDirection = Enum.NormalId.Right -- el eje X del cilindro es el vertical: suben
	sparks.Parent = pad
	return pad
end

-- Punto de aparición para "Todos contra todos" y "Escalada" (invisible)
function Kit.ffaSpawn(position)
	local p = deco("FFASpawn", V(2, 1, 2), CFrame.new(position + V(0, 0.5, 0)), C.White, Enum.Material.SmoothPlastic)
	p.Transparency = 1
	return p
end

-- Zona de control (modo "Zona"). order = orden de rotación.
function Kit.zone(position, radius, order)
	local z = deco("HardpointZone", V(0.3, radius * 2, radius * 2), CFrame.new(position + V(0, 0.15, 0)) * CFrame.Angles(0, 0, math.pi / 2), C.White, Enum.Material.SmoothPlastic)
	z.Shape = Enum.PartType.Cylinder
	z.Transparency = 1
	z:SetAttribute("Order", order)
	z:SetAttribute("Radius", radius)
	return z
end

-- Muros exteriores invisibles (y techo) para que nadie se salga
-- Muros y techo invisibles. Van en la carpeta Map.Boundary, que los disparos ignoran
-- (CanQuery = false no sirve en piezas que colisionan, así que se excluyen en cada raycast).
function Kit.bounds(length, width, height)
	local folder = Kit.folder:FindFirstChild("Boundary") or Instance.new("Folder")
	folder.Name = "Boundary"
	folder.Parent = Kit.folder
	local function wall(size, cf)
		local w = block("Boundary", size, cf, Color3.new(1, 1, 1), nil, folder)
		w.Transparency = 1
		w.CastShadow = false
	end
	wall(V(length, height, 4), CFrame.new(0, height / 2, width / 2 + 2))
	wall(V(length, height, 4), CFrame.new(0, height / 2, -width / 2 - 2))
	wall(V(4, height, width), CFrame.new(length / 2 + 2, height / 2, 0))
	wall(V(4, height, width), CFrame.new(-length / 2 - 2, height / 2, 0))
	wall(V(length, 1, width), CFrame.new(0, height, 0))
end

---------------------------------------------------------------------------
-- Iluminación por mapa
---------------------------------------------------------------------------

-- Colores por defecto de los materiales del terreno (se restauran al cambiar de mapa)
local TERRAIN_DEFAULTS = {
	Grass = RGB(106, 127, 63),
	LeafyGrass = RGB(115, 132, 74),
	Mud = RGB(58, 46, 36),
	Ground = RGB(102, 92, 59),
	Snow = RGB(195, 199, 218),
	Glacier = RGB(101, 176, 234),
	Rock = RGB(102, 108, 111),
	Sand = RGB(143, 126, 95),
	Slate = RGB(63, 127, 107),
}

-- Hierba y hojas más vivas en estilo Cartoon
local CARTOON_TERRAIN = {
	Grass = RGB(80, 175, 70),
	LeafyGrass = RGB(66, 150, 58),
	Ground = RGB(150, 120, 80),
}

local function ensure(className, parent)
	parent = parent or Lighting
	local inst = parent:FindFirstChildOfClass(className)
	if not inst then
		inst = Instance.new(className)
		inst.Parent = parent
	end
	return inst
end

-- Estilo Cartoon: luz más suave y clara (sombras rellenas), menos neblina, sin deslumbramiento y
-- más saturación; el ambiente de cada mapa (hora, color del cielo) se mantiene
local function cartoonize(preset)
	local p = table.clone(preset)
	local clock = p.ClockTime or 14
	local night = clock < 6 or clock > 18.6
	p.Ambient = (p.Ambient or RGB(60, 62, 72)):Lerp(night and RGB(70, 70, 105) or RGB(125, 125, 145), 0.55)
	p.OutdoorAmbient = (p.OutdoorAmbient or RGB(125, 128, 140)):Lerp(night and RGB(90, 90, 135) or RGB(170, 170, 190), 0.55)
	p.ShadowSoftness = 0.3
	if not night then
		p.Brightness = math.max(p.Brightness or 3, 3)
	end
	local a = table.clone(p.Atmosphere or {})
	a.Density = math.min(a.Density or 0.3, 0.26)
	a.Haze = math.min(a.Haze or 1.4, 0.6)
	a.Glare = 0
	p.Atmosphere = a
	local c = table.clone(p.Color or {})
	c.Saturation = (c.Saturation or 0.1) + 0.12
	c.Contrast = 0.06
	c.Brightness = (c.Brightness or 0.02) + 0.02
	p.Color = c
	local b = table.clone(p.Bloom or {})
	b.Intensity = math.min(b.Intensity or 0.8, 0.45)
	p.Bloom = b
	p.Clouds = math.max(p.Clouds or 0.55, 0.6)
	p.SunRays = math.min(p.SunRays or 0.06, 0.05)
	local terrain = {}
	for name, color in TERRAIN_DEFAULTS do
		terrain[name] = Kit.vivid((p.TerrainColors and p.TerrainColors[name]) or CARTOON_TERRAIN[name] or color)
	end
	p.TerrainColors = terrain
	return p
end

-- preset: tabla con ClockTime, Brightness, Ambient, OutdoorAmbient, Atmosphere{...}, Color{...}, Bloom{...}, Clouds
function Kit.applyLighting(preset)
	-- Tono de los grises de este mapa (se usa al crear las piezas, que van después)
	local neutral = preset.CartoonNeutral
	Kit.Neutral = type(neutral) == "table" and { Hue = neutral.Hue or 0.68, Sat = neutral.Sat or 0.16 } or { Hue = 0.68, Sat = 0.16 }
	if Kit.Cartoon then
		preset = cartoonize(preset)
	end
	Lighting.ClockTime = preset.ClockTime or 14
	Lighting.GeographicLatitude = preset.Latitude or 35
	Lighting.Brightness = preset.Brightness or 3
	Lighting.ExposureCompensation = preset.Exposure or 0
	Lighting.Ambient = preset.Ambient or RGB(60, 62, 72)
	Lighting.OutdoorAmbient = preset.OutdoorAmbient or RGB(125, 128, 140)
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = preset.ShadowSoftness or 0.12 -- sombras de sol nítidas pero no duras
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = Kit.Cartoon and 0.5 or 1 -- en Cartoon, menos brillo de plástico
	-- Viento: mueve la hierba del terreno, las nubes y las partículas con WindAffectsDrag
	workspace.GlobalWind = preset.Wind or V(4, 0, 2)

	local a = preset.Atmosphere or {}
	local atmosphere = ensure("Atmosphere")
	atmosphere.Density = a.Density or 0.3
	atmosphere.Offset = a.Offset or 0.25
	atmosphere.Color = a.Color or RGB(199, 220, 255)
	atmosphere.Decay = a.Decay or RGB(106, 120, 150)
	atmosphere.Glare = a.Glare or 0.3
	atmosphere.Haze = a.Haze or 1.4

	local c = preset.Color or {}
	local cc = ensure("ColorCorrectionEffect")
	cc.Saturation = c.Saturation or 0.1
	cc.Contrast = c.Contrast or 0.15
	cc.Brightness = c.Brightness or 0.02
	cc.TintColor = c.Tint or RGB(255, 250, 245)

	local b = preset.Bloom or {}
	local bloom = ensure("BloomEffect")
	bloom.Intensity = b.Intensity or 0.8
	bloom.Size = b.Size or 24
	bloom.Threshold = b.Threshold or 2

	local rays = ensure("SunRaysEffect")
	rays.Intensity = preset.SunRays or 0.06
	rays.Spread = 0.6

	local sky = ensure("Sky")
	sky.StarCount = preset.Stars or 3000
	sky.SunAngularSize = preset.SunSize or 21
	sky.MoonAngularSize = preset.MoonSize or 11
	sky.CelestialBodiesShown = true

	local clouds = ensure("Clouds", workspace.Terrain)
	clouds.Cover = preset.Clouds or 0.55
	clouds.Density = Kit.Cartoon and 0.72 or 0.6 -- nubes más esponjosas en Cartoon
	clouds.Color = preset.CloudColor or RGB(255, 255, 255)

	-- Agua del terreno: color, reflejo, transparencia y olas de cada mapa
	local w = preset.Water or {}
	local terrain = workspace.Terrain
	terrain.WaterColor = w.Color or RGB(12, 84, 92)
	terrain.WaterReflectance = w.Reflectance or 1
	terrain.WaterTransparency = w.Transparency or 0.3
	terrain.WaterWaveSize = w.WaveSize or 0.15
	terrain.WaterWaveSpeed = w.WaveSpeed or 10

	-- Colores de los materiales del terreno (hierba, nieve, roca...) según el mapa
	for name, color in TERRAIN_DEFAULTS do
		local custom = preset.TerrainColors and preset.TerrainColors[name]
		pcall(function()
			terrain:SetMaterialColor(Enum.Material[name], custom or color)
		end)
	end
end

-- Suelo de terreno (en vez de una pieza): con Grass sale hierba 3D animada (Terrain.Decoration,
-- activada en default.project.json). La superficie queda exactamente en y = 0.
function Kit.terrainFloor(material, length, width)
	workspace.Terrain:FillBlock(CFrame.new(0, -2, 0), V(length, 4, width), material)
end

-- Cambia el material del terreno del suelo en una zona (caminos de barro, suelo bajo edificios...)
function Kit.terrainPatch(cf, size, material)
	workspace.Terrain:FillBlock(cf * CFrame.new(0, -2, 0), V(size.X, 4, size.Z), material)
end

-- Empieza un mapa nuevo: borra el anterior (y el agua/roca de Terrain)
function Kit.Begin(name)
	local old = workspace:FindFirstChild("Map")
	if old then
		old:Destroy()
	end
	workspace.Terrain:Clear()
	local folder = Instance.new("Folder")
	folder.Name = "Map"
	folder:SetAttribute("Generated", true)
	folder:SetAttribute("MapName", name)
	folder.Parent = workspace
	Kit.folder = folder
	return folder
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">PlayerData</string>
            <string name="Source"><![CDATA[-- Datos persistentes del jugador (nivel, XP, monedas, skins, trajes, armas) guardados con DataStore,
-- y toda la economía: tienda con monedas, compras con Robux, VIP, recompensa diaria, cajas,
-- retos diarios y maestría de armas.
-- En Studio activa: Game Settings > Security > "Enable Studio Access to API Services".
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.GameConfig)
local Skins = require(Shared.Skins)
local Weapons = require(Shared.Weapons)
local Outfits = require(Shared.Outfits)
local Ranks = require(Shared.Ranks)
local Shop = require(Shared.Shop)
local Friends = require(script.Parent.Friends)
local Badges = require(script.Parent.Badges)
local Challenges = require(Shared.Challenges)
local Mastery = require(Shared.Mastery)
local KillEffects = require(Shared.KillEffects)
local Remotes = require(Shared.Remotes)

local PlayerData = {}

-- Callbacks que otros módulos pueden asignar
PlayerData.OnSkinChanged = nil -- function(player, skinId)
PlayerData.OnOutfitChanged = nil -- function(player, outfitId)
PlayerData.OnLeaving = nil :: ((player: Player) -> ())? -- justo antes del guardado final al salir

local store
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("ShooterRobData_v1")
	end)
	if ok then
		store = result
	else
		warn("[PlayerData] DataStore no disponible, el progreso no se guardará:", result)
	end
end

local profiles = {}
local noSave = {} -- jugadores cuya carga falló: no sobrescribimos sus datos
local cratesRestricted = {} -- países donde no se permiten objetos aleatorios de pago

local STARTING_COINS = 250
local MAX_PURCHASE_LOG = 60
-- Bloqueo de sesión: un servidor "reserva" los datos del jugador mientras está dentro, para que otro
-- servidor no lea datos viejos y los sobrescriba (por ejemplo al cambiar rápido de servidor).
local LOCK_TIMEOUT = 600 -- si el servidor que tenía el bloqueo se cayó, a los 10 min se puede quitar
local LOCK_WAIT = 25 -- segundos máximos esperando a que el otro servidor suelte los datos
local SAVE_COOLDOWN = 7 -- Roblox permite ~1 escritura por clave cada 6 s

local saving = {} -- jugadores con un guardado en curso
local dirty = {} -- jugadores con cambios pendientes de guardar
local saveScheduled = {}

local function defaults()
	return {
		Level = 1,
		XP = 0,
		Coins = STARTING_COINS,
		Skins = { Default = true },
		EquippedSkin = "Default",
		Primary = "ARX27",
		Secondary = "Viper",
		Melee = "Knife", -- arma cuerpo a cuerpo elegida (Weapons.Melees)
		OwnedWeapons = {},
		Outfits = { Default = true },
		EquippedOutfit = "Default",
		ClaimedFree = {},
		ClaimedPremium = {},
		TotalKills = 0,
		Wins = 0,
		TotalDeaths = 0, -- estadísticas del perfil
		Matches = 0,
		BestStreak = 0,
		Headshots = 0,
		RankPoints = 0, -- puntos de rango competitivo (ver Ranks)
		RankBest = 1, -- rango más alto alcanzado (sus premios ya se dieron)
		Premium = false,
		DailyStreak = 0,
		LastDailyDay = -1,
		FreeCrates = 0,
		Purchases = {},
		KillEffects = { Default = true }, -- efectos de eliminación comprados
		EquippedKillEffect = "Default",
		WeaponKills = {}, -- bajas con cada arma (maestría)
		WeaponCamos = {}, -- camuflaje de maestría elegido para cada arma
		Challenges = { Day = -1, List = {}, Rerolls = 0, Bonus = false },
		StarterPack = false, -- ya compró el pack de inicio
		TutorialDone = false, -- ya vio la tarjeta de controles de la primera partida
		EventProgress = { Id = "", Count = 0 }, -- caramelos del evento de temporada (ver Event)
		Revives = GameConfig.StartingRevives, -- "Revivir instantáneo" disponibles
		Gifts = { Day = -1, Claimed = 0, Seconds = 0 }, -- regalos por tiempo jugado de hoy (ver Gifts)
		WheelDay = -1, -- último día con giro gratis de la ruleta usado
		WheelSpins = 0, -- giros de ruleta comprados sin usar
		Settings = table.clone(GameConfig.DefaultSettings),
	}
end

---------------------------------------------------------------------------
-- Retos diarios
---------------------------------------------------------------------------

-- Reparte retos nuevos si ha cambiado el día
local function ensureChallenges(player, data)
	local today = Shop.DayNumber()
	local state = data.Challenges
	if type(state) ~= "table" or state.Day ~= today or type(state.List) ~= "table" then
		local list = {}
		for _, id in Challenges.Pick(today, player.UserId, data.Level, Challenges.PerDay) do
			table.insert(list, { Id = id, Progress = 0, Done = false })
		end
		state = { Day = today, List = list, Rerolls = 0, Bonus = false }
		data.Challenges = state
	end
	return state
end

local function challengesView(player, data)
	local state = ensureChallenges(player, data)
	local list = {}
	for _, entry in state.List do
		local def = Challenges.Get(entry.Id)
		if def then
			table.insert(list, {
				Id = entry.Id,
				Text = def.Text,
				Goal = def.Goal,
				Progress = math.min(entry.Progress, def.Goal),
				Done = entry.Done,
				Coins = def.Coins,
				XP = def.XP,
			})
		end
	end
	return {
		List = list,
		RerollsLeft = math.max(0, Challenges.RerollsPerDay - (state.Rerolls or 0)),
		Bonus = state.Bonus == true,
		BonusCrates = Challenges.BonusCrates,
	}
end

-- Skin con la que se ve un arma: el camuflaje de maestría elegido para ella (si lo tiene) o la skin general
function PlayerData.SkinFor(data, weaponName)
	if not data then
		return "Default"
	end
	local camo = data.WeaponCamos and data.WeaponCamos[weaponName]
	if camo and Mastery.HasCamo(data.WeaponKills and data.WeaponKills[weaponName] or 0, camo) then
		return camo
	end
	return data.EquippedSkin or "Default"
end

local function key(player)
	return "u_" .. player.UserId
end

local function publicView(player, data)
	return {
		Level = data.Level,
		XP = data.XP,
		XPPerLevel = GameConfig.XPPerLevel,
		Coins = data.Coins,
		Skins = data.Skins,
		EquippedSkin = data.EquippedSkin,
		Primary = data.Primary,
		Secondary = data.Secondary,
		Melee = data.Melee,
		OwnedWeapons = data.OwnedWeapons,
		Outfits = data.Outfits,
		EquippedOutfit = data.EquippedOutfit,
		TotalKills = data.TotalKills,
		Wins = data.Wins,
		TotalDeaths = data.TotalDeaths,
		Matches = data.Matches,
		BestStreak = data.BestStreak,
		Headshots = data.Headshots,
		RankPoints = data.RankPoints,
		Premium = data.Premium,
		VIP = player:GetAttribute("VIP") == true,
		DailyStreak = data.DailyStreak,
		DailyAvailable = data.LastDailyDay ~= Shop.DayNumber(),
		FreeCrates = data.FreeCrates,
		CratesRestricted = cratesRestricted[player] == true,
		Day = Shop.DayNumber(),
		WeaponKills = data.WeaponKills,
		WeaponCamos = data.WeaponCamos,
		KillEffects = data.KillEffects,
		EquippedKillEffect = data.EquippedKillEffect,
		Settings = data.Settings,
		Revives = data.Revives,
		WheelFree = data.WheelDay ~= Shop.DayNumber(),
		WheelSpins = data.WheelSpins,
		-- (si sus datos no se guardan, no se le enseña el tutorial: probablemente ya lo vio)
		TutorialDone = data.TutorialDone == true or noSave[player] == true,
		EventCandy = (type(data.EventProgress) == "table" and data.EventProgress.Id == GameConfig.Event.Id) and data.EventProgress.Count or 0,
		StarterPackAvailable = Shop.StarterPack.ProductId ~= 0 and not data.StarterPack and data.Level <= Shop.StarterPack.MaxLevel,
		Challenges = challengesView(player, data),
	}
end

local function sendUpdate(player)
	local data = profiles[player]
	if data then
		Remotes.DataUpdate:FireClient(player, publicView(player, data))
	end
end
PlayerData.SendUpdate = sendUpdate

function PlayerData.GetLeaderstats(player)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		for _, name in { "Bajas", "Muertes", "Nivel" } do
			local value = Instance.new("IntValue")
			value.Name = name
			value.Parent = stats
		end
		stats.Parent = player
	end
	return stats
end

local function grant(player, data, reward)
	if not reward then
		return
	end
	if reward.Type == "Skin" then
		data.Skins[reward.Id] = true
		Remotes.Notify:FireClient(player, "Unlock", "¡Skin desbloqueada: " .. Skins.Get(reward.Id).Name .. "!")
	elseif reward.Type == "Outfit" then
		data.Outfits[reward.Id] = true
		Remotes.Notify:FireClient(player, "Unlock", "¡Traje desbloqueado: " .. Outfits.Get(reward.Id).Name .. "!")
	elseif reward.Type == "Crate" then
		data.FreeCrates += reward.Amount or 1
	elseif reward.Type == "Coins" then
		data.Coins += reward.Amount
	end
end

-- Entrega todas las recompensas del pase hasta el nivel actual que aún no se hayan reclamado
local function grantTierRewards(player)
	local data = profiles[player]
	if not data then
		return
	end
	local maxTier = math.min(data.Level, #GameConfig.BattlePass)
	for tier = 1, maxTier do
		local t = GameConfig.BattlePass[tier]
		local k = tostring(tier)
		if not data.ClaimedFree[k] then
			data.ClaimedFree[k] = true
			grant(player, data, t.Free)
		end
		if data.Premium and not data.ClaimedPremium[k] then
			data.ClaimedPremium[k] = true
			grant(player, data, t.Premium)
		end
	end
end

local function ownsPass(player, passId)
	if not passId or passId == 0 then
		return false
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
	end)
	return ok and owns
end

local function checkPolicy(player)
	local ok, info = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(player)
	end)
	-- Si no podemos comprobarlo, por seguridad tratamos las cajas de pago como restringidas
	cratesRestricted[player] = not ok or (info and info.ArePaidRandomItemsRestricted == true)
end

local function load(player)
	local data
	if store then
		local loaded, result = false, nil
		local started = os.clock()
		local attempt = 0
		while player.Parent do
			attempt += 1
			local locked = false
			local force = os.clock() - started > LOCK_WAIT
			loaded, result = pcall(function()
				return store:UpdateAsync(key(player), function(old)
					local lock = type(old) == "table" and old.SessionLock
					if type(lock) == "table" and lock.Job ~= game.JobId and not force and os.time() - (lock.Time or 0) < LOCK_TIMEOUT then
						locked = true
						return nil -- otro servidor aún tiene los datos: no tocamos nada
					end
					old = type(old) == "table" and old or {}
					old.SessionLock = { Job = game.JobId, Time = os.time() }
					return old
				end)
			end)
			if loaded and not locked then
				break
			end
			if not loaded and attempt >= 3 then
				break
			end
			task.wait(loaded and 3 or attempt)
		end
		if loaded then
			data = result
		else
			warn("[PlayerData] No se pudieron cargar los datos de", player.Name, result)
			noSave[player] = true
		end
	end

	local merged = defaults()
	local isNew = type(data) ~= "table" or data.Level == nil
	if not isNew then
		for k, v in data do
			merged[k] = v
		end
		if data.Coins == nil then
			merged.Coins = 0
		end
	end
	if type(merged.WeaponKills) ~= "table" then
		merged.WeaponKills = {}
	end
	if type(merged.WeaponCamos) ~= "table" then
		merged.WeaponCamos = {}
	end
	if type(merged.Revives) ~= "number" or merged.Revives ~= merged.Revives then
		merged.Revives = GameConfig.StartingRevives
	end
	if type(merged.Settings) ~= "table" then
		merged.Settings = table.clone(GameConfig.DefaultSettings)
	end
	if type(merged.Gifts) ~= "table" or type(merged.Gifts.Claimed) ~= "number" or type(merged.Gifts.Seconds) ~= "number" then
		merged.Gifts = { Day = -1, Claimed = 0, Seconds = 0 }
	end
	-- Antes la calidad por defecto era "Alta" (daba lag en equipos modestos): pasa a "Auto" una vez
	if merged.Settings.QualityVersion ~= GameConfig.DefaultSettings.QualityVersion then
		merged.Settings.Quality = "Auto"
		merged.Settings.QualityVersion = GameConfig.DefaultSettings.QualityVersion
	end
	if type(merged.KillEffects) ~= "table" then
		merged.KillEffects = { Default = true }
	end
	if not KillEffects.List[merged.EquippedKillEffect] or not merged.KillEffects[merged.EquippedKillEffect] then
		merged.EquippedKillEffect = "Default"
	end
	-- Nombres de armas antiguos -> nuevos
	merged.Primary = Weapons.Legacy[merged.Primary] or merged.Primary
	merged.Secondary = Weapons.Legacy[merged.Secondary] or merged.Secondary
	if not Skins.List[merged.EquippedSkin] or not merged.Skins[merged.EquippedSkin] then
		merged.EquippedSkin = "Default"
	end
	if not Outfits.List[merged.EquippedOutfit] or not merged.Outfits[merged.EquippedOutfit] then
		merged.EquippedOutfit = "Default"
	end
	if not table.find(Weapons.Primaries, merged.Primary) or not Weapons.IsUnlocked(merged.Primary, merged) then
		merged.Primary = "ARX27"
	end
	if not table.find(Weapons.Secondaries, merged.Secondary) or not Weapons.IsUnlocked(merged.Secondary, merged) then
		merged.Secondary = Weapons.Secondary
	end
	if not table.find(Weapons.Melees, merged.Melee) or not Weapons.IsUnlocked(merged.Melee, merged) then
		merged.Melee = Weapons.Melee
	end
	if type(merged.RankPoints) ~= "number" or merged.RankPoints ~= merged.RankPoints then
		merged.RankPoints = 0
	end
	if type(merged.WheelSpins) ~= "number" or merged.WheelSpins < 0 then
		merged.WheelSpins = 0
	end
	if type(merged.WheelDay) ~= "number" then
		merged.WheelDay = -1
	end
	if type(merged.RankBest) ~= "number" then
		merged.RankBest = Ranks.Index(merged.RankPoints)
	end
	if type(merged.EventProgress) ~= "table" or type(merged.EventProgress.Count) ~= "number" then
		merged.EventProgress = { Id = "", Count = 0 }
	end
	-- Quien ya jugaba antes de existir el tutorial no lo ve
	if not isNew and data.TutorialDone == nil and ((merged.Level or 1) > 1 or (merged.TotalKills or 0) > 0) then
		merged.TutorialDone = true
	end
	merged.Premium = merged.Premium or ownsPass(player, GameConfig.PremiumPassId)
	player:SetAttribute("VIP", ownsPass(player, Shop.VIPPassId))
	checkPolicy(player)

	if not player.Parent then
		noSave[player] = nil
		cratesRestricted[player] = nil
		return
	end
	profiles[player] = merged
	Badges.Check(player, merged)
	PlayerData.GetLeaderstats(player).Nivel.Value = merged.Level
	player:SetAttribute("Rank", Ranks.Index(merged.RankPoints))
	grantTierRewards(player)
	sendUpdate(player)
end

-- Guarda los datos. release = true al salir el jugador: suelta el bloqueo de sesión.
local function save(player, release)
	local data = profiles[player]
	if not data or not store or noSave[player] then
		return false
	end
	-- Espera a que acabe otro guardado de este jugador (no pisar escrituras)
	local waited = 0
	while saving[player] and waited < 15 do
		task.wait(0.5)
		waited += 0.5
	end
	saving[player] = true
	dirty[player] = nil
	local stolen = false
	local ok, err = pcall(function()
		store:UpdateAsync(key(player), function(old)
			local lock = type(old) == "table" and old.SessionLock
			if type(lock) == "table" and lock.Job ~= game.JobId then
				stolen = true
				return nil -- otro servidor tiene ahora los datos: no los sobrescribimos
			end
			data.SessionLock = if release then nil else { Job = game.JobId, Time = os.time() }
			return data
		end)
	end)
	saving[player] = nil
	if not ok then
		warn("[PlayerData] Error al guardar", player.Name, err)
		dirty[player] = true
	elseif stolen then
		warn("[PlayerData] Otro servidor tiene los datos de", player.Name, "- no se guardan aquí")
		noSave[player] = true
		return false
	end
	return ok
end

-- Pide un guardado pronto, agrupando varios cambios seguidos en una sola escritura
local function requestSave(player)
	dirty[player] = true
	if saveScheduled[player] then
		return
	end
	saveScheduled[player] = true
	task.delay(SAVE_COOLDOWN, function()
		saveScheduled[player] = nil
		if dirty[player] and player.Parent then
			save(player)
		end
	end)
end

function PlayerData.Get(player)
	return profiles[player]
end

-- Espera a que los datos del jugador estén cargados (máx. timeout segundos)
function PlayerData.WaitFor(player, timeout)
	local start = os.clock()
	while not profiles[player] and player.Parent and os.clock() - start < (timeout or 15) do
		task.wait(0.1)
	end
	return profiles[player]
end

-- VIP (x2) y bonus de amigos en el servidor (+10% por amigo, ver Friends)
local function multiplier(player)
	local vip = player:GetAttribute("VIP") and Shop.VIPMultiplier or 1
	return vip * Friends.Multiplier(player)
end

-- Envía los datos al cliente (cambios hechos desde fuera, p. ej. el evento)
function PlayerData.SendUpdate(player)
	sendUpdate(player)
end

-- Da una skin (premios de evento); devuelve true si es nueva
function PlayerData.GiveSkin(player, skinId)
	local data = profiles[player]
	if not data or not Skins.List[skinId] or data.Skins[skinId] then
		return false
	end
	data.Skins[skinId] = true
	dirty[player] = true
	sendUpdate(player)
	return true
end

-- Da un traje (recompensas de evento). Devuelve false si ya lo tenía
function PlayerData.GiveOutfit(player, outfitId)
	local data = profiles[player]
	if not data or not Outfits.List[outfitId] or data.Outfits[outfitId] then
		return false
	end
	data.Outfits[outfitId] = true
	dirty[player] = true
	sendUpdate(player)
	return true
end

-- Marca los datos para guardarlos en el próximo guardado automático (cambios hechos desde fuera)
function PlayerData.MarkDirty(player)
	if profiles[player] then
		dirty[player] = true
	end
end

-- Da revivir instantáneos (regalos por tiempo jugado)
function PlayerData.AddRevives(player, amount)
	local data = profiles[player]
	if not data or amount <= 0 then
		return
	end
	data.Revives = (data.Revives or 0) + amount
	dirty[player] = true
	sendUpdate(player)
end

-- Gasta un "Revivir instantáneo". Devuelve false si no le quedan.
function PlayerData.UseRevive(player)
	local data = profiles[player]
	if not data or (data.Revives or 0) <= 0 then
		return false
	end
	data.Revives -= 1
	dirty[player] = true
	sendUpdate(player)
	return true
end

-- Lo ganado en la partida actual (para el resumen del final de la ronda)
local match = {} -- [player] = { XP, Coins, StartLevel, StartXP }

local function matchOf(player, data)
	local entry = match[player]
	if not entry then
		entry = { XP = 0, Coins = 0, StartLevel = data.Level, StartXP = data.XP, StartRank = data.RankPoints }
		match[player] = entry
	end
	return entry
end

-- Empieza una partida: se pone a cero lo ganado
function PlayerData.StartMatch(player)
	match[player] = nil
	local data = profiles[player]
	if data then
		matchOf(player, data)
	end
end

-- Resumen de lo ganado desde StartMatch
function PlayerData.MatchSummary(player)
	local data = profiles[player]
	if not data then
		return nil
	end
	local entry = matchOf(player, data)
	return {
		XP = entry.XP,
		Coins = entry.Coins,
		StartLevel = entry.StartLevel,
		StartXP = entry.StartXP,
		Level = data.Level,
		LevelXP = data.XP,
		XPPerLevel = GameConfig.XPPerLevel,
		StartRank = entry.StartRank or data.RankPoints,
		RankPoints = data.RankPoints,
	}
end

-- Suma (o resta) puntos de rango al acabar una partida; nunca baja del inicio del rango actual
function PlayerData.AddRankPoints(player, delta)
	local data = profiles[player]
	if not data or delta == 0 then
		return 0
	end
	matchOf(player, data) -- (el resumen de la partida guarda el rango de antes)
	local before = data.RankPoints
	data.RankPoints = Ranks.Apply(before, delta)
	local index = Ranks.Index(data.RankPoints)
	player:SetAttribute("Rank", index)
	-- Premios de los rangos alcanzados por primera vez
	while (data.RankBest or 1) < index do
		data.RankBest = (data.RankBest or 1) + 1
		local tier = Ranks.Tiers[data.RankBest]
		local reward = tier.Reward or {}
		local text = tier.Icon .. " ¡Rango " .. tier.Name .. "!"
		if reward.Coins then
			data.Coins += reward.Coins
			text ..= "  +" .. reward.Coins .. " 🪙"
		end
		if reward.Crates then
			data.FreeCrates += reward.Crates
			text ..= "  +" .. reward.Crates .. (reward.Crates == 1 and " caja" or " cajas")
		end
		Remotes.Notify:FireClient(player, "Challenge", text)
	end
	Badges.Check(player, data)
	dirty[player] = true
	sendUpdate(player)
	return data.RankPoints - before
end

function PlayerData.AddXP(player, amount, reason)
	local data = profiles[player]
	if not data or amount <= 0 then
		return
	end
	amount = math.floor(amount * multiplier(player))
	matchOf(player, data).XP += amount
	data.XP += amount
	Remotes.Notify:FireClient(player, "XP", "+" .. amount .. " XP  " .. (reason or ""))
	local leveled = false
	while data.XP >= GameConfig.XPPerLevel do
		data.XP -= GameConfig.XPPerLevel
		data.Level += 1
		leveled = true
	end
	if leveled then
		Badges.Check(player, data)
		PlayerData.GetLeaderstats(player).Nivel.Value = data.Level
		Remotes.Notify:FireClient(player, "LevelUp", data.Level)
		-- ¿Desbloquea alguna arma este nivel?
		for name, def in Weapons.List do
			if def.UnlockLevel == data.Level and not def.Hidden then
				Remotes.Notify:FireClient(player, "Unlock", "¡Arma desbloqueada: " .. def.DisplayName .. "!")
			end
		end
		grantTierRewards(player)
	end
	sendUpdate(player)
end

-- earned = true para monedas ganadas jugando (el VIP las duplica)
function PlayerData.AddCoins(player, amount, earned)
	local data = profiles[player]
	if data then
		if earned ~= false then
			amount = math.floor(amount * multiplier(player))
			matchOf(player, data).Coins += amount
		end
		data.Coins += amount
		sendUpdate(player)
		return amount -- lo que se ha sumado de verdad (con VIP y amigos)
	end
	return 0
end

function PlayerData.Increment(player, field, amount)
	local data = profiles[player]
	if data and type(data[field]) == "number" then
		data[field] += amount or 1
		if field == "TotalKills" or field == "Wins" then
			Badges.Check(player, data)
		end
	end
end

-- Guarda un récord (por ejemplo la mejor racha de bajas) si lo supera
function PlayerData.SetBest(player, field, value)
	local data = profiles[player]
	if data and type(data[field]) == "number" and value > data[field] then
		data[field] = value
		dirty[player] = true
	end
end

-- Progreso de los retos diarios. stat: ver Challenges.luau. Para "Streak" amount es la racha actual.
function PlayerData.Track(player, stat, amount, weaponName)
	local data = profiles[player]
	if not data then
		return
	end
	local state = ensureChallenges(player, data)
	local changed = false
	for _, entry in state.List do
		local def = Challenges.Get(entry.Id)
		if def and not entry.Done and Challenges.Matches(def, stat, weaponName) then
			if stat == "Streak" then
				entry.Progress = math.max(entry.Progress, amount or 0)
			else
				entry.Progress += amount or 1
			end
			if entry.Progress >= def.Goal then
				entry.Done = true
				changed = true
				Remotes.Notify:FireClient(player, "Challenge", "¡RETO COMPLETADO! +" .. def.Coins .. " 🪙")
				PlayerData.AddCoins(player, def.Coins, false)
				PlayerData.AddXP(player, def.XP, "Reto diario")
			end
		end
	end
	if changed and not state.Bonus then
		local all = #state.List > 0
		for _, entry in state.List do
			all = all and entry.Done
		end
		if all then
			state.Bonus = true
			data.FreeCrates += Challenges.BonusCrates
			Remotes.Notify:FireClient(player, "Unlock", "¡Todos los retos de hoy completados! Caja gratis 🎁")
		end
	end
	if changed then
		sendUpdate(player)
	end
end

-- Cuenta una baja con un arma y entrega la maestría al subir de nivel
function PlayerData.AddWeaponKill(player, weaponName)
	local data = profiles[player]
	if not data or type(weaponName) ~= "string" or not Weapons.List[weaponName] or Weapons.List[weaponName].Hidden then
		return -- (las garras de zombi no tienen maestría)
	end
	local before = data.WeaponKills[weaponName] or 0
	local after = before + 1
	data.WeaponKills[weaponName] = after
	local oldLevel, newLevel = Mastery.Level(before), Mastery.Level(after)
	if newLevel > oldLevel then
		local tier = Mastery.Tiers[newLevel]
		-- Equipa el camuflaje nuevo automáticamente: ¡que se vea!
		data.WeaponCamos[weaponName] = tier.Camo
		Remotes.Notify:FireClient(player, "Mastery", "MAESTRÍA " .. string.upper(tier.Name) .. ": " .. Weapons.List[weaponName].DisplayName)
		PlayerData.AddCoins(player, tier.Coins, false)
		if PlayerData.OnSkinChanged then
			PlayerData.OnSkinChanged(player)
		end
		sendUpdate(player)
	end
end

---------------------------------------------------------------------------
-- Tienda
---------------------------------------------------------------------------

local function buyItem(player, kind, id)
	local data = profiles[player]
	if not data or type(kind) ~= "string" or type(id) ~= "string" then
		return false, "Datos no cargados"
	end
	local price
	if kind == "Weapon" then
		local def = Weapons.List[id]
		if not def or not def.Price then
			return false, "No está a la venta"
		end
		if Weapons.IsUnlocked(id, data) then
			return false, "Ya la tienes"
		end
		price = def.Price
	elseif kind == "Skin" then
		if not Skins.List[id] then
			return false, "No existe"
		end
		if data.Skins[id] then
			return false, "Ya la tienes"
		end
		price = Shop.GetPrice("Skin", id)
	elseif kind == "Outfit" then
		if not Outfits.List[id] then
			return false, "No existe"
		end
		if data.Outfits[id] then
			return false, "Ya lo tienes"
		end
		price = Shop.GetPrice("Outfit", id)
	elseif kind == "KillEffect" then
		if not KillEffects.List[id] then
			return false, "No existe"
		end
		if data.KillEffects[id] then
			return false, "Ya lo tienes"
		end
		price = Shop.GetPrice("KillEffect", id)
	end
	if not price then
		return false, "No está a la venta"
	end
	if data.Coins < price then
		return false, "Te faltan " .. (price - data.Coins) .. " monedas"
	end
	data.Coins -= price
	if kind == "Weapon" then
		data.OwnedWeapons[id] = true
	elseif kind == "Skin" then
		data.Skins[id] = true
	elseif kind == "KillEffect" then
		data.KillEffects[id] = true
		data.EquippedKillEffect = id -- se equipa al comprarlo
	else
		data.Outfits[id] = true
	end
	sendUpdate(player)
	requestSave(player)
	return true, "¡Comprado!"
end

local function claimDaily(player)
	local data = profiles[player]
	if not data then
		return false
	end
	local today = Shop.DayNumber()
	if data.LastDailyDay == today then
		return false
	end
	local streak = (data.LastDailyDay == today - 1) and data.DailyStreak + 1 or 1
	if streak > #Shop.DailyRewards then
		streak = 1
	end
	data.DailyStreak = streak
	data.LastDailyDay = today
	local coins = Shop.DailyRewards[streak]
	PlayerData.AddCoins(player, coins, true)
	local crate = streak == Shop.DailyCrateDay
	if crate then
		data.FreeCrates += 1
	end
	if player:GetAttribute("VIP") then
		data.FreeCrates += 1 -- caja diaria extra del VIP
	end
	sendUpdate(player)
	return true, { Streak = streak, Coins = math.floor(coins * multiplier(player)), Crate = crate }
end

-- Ruleta: gasta el giro gratis de hoy (o uno comprado) y da un premio al azar según su peso.
-- Devuelve el índice del premio para que el cliente pare la ruleta en él.
local lastSpin = {} -- [player] = os.clock() (no más de un giro cada 3 s: dura la animación)
local function spinWheel(player)
	local data = profiles[player]
	if not data then
		return false, "Cargando..."
	end
	if os.clock() - (lastSpin[player] or 0) < 3 then
		return false, "Espera a que pare la ruleta"
	end
	local today = Shop.DayNumber()
	if data.WheelDay ~= today then
		data.WheelDay = today
	elseif data.WheelSpins > 0 then
		data.WheelSpins -= 1
	else
		return false, "Vuelve mañana para otro giro gratis"
	end
	lastSpin[player] = os.clock()
	local prizes = Shop.Wheel.Prizes
	local total = 0
	for _, prize in prizes do
		total += prize.Weight
	end
	local roll = math.random() * total
	local index = #prizes
	for i, prize in prizes do
		roll -= prize.Weight
		if roll <= 0 then
			index = i
			break
		end
	end
	local prize = prizes[index]
	-- (premio fijo: no lo multiplica el VIP)
	if prize.Kind == "Coins" then
		data.Coins += prize.Amount
	elseif prize.Kind == "Revives" then
		data.Revives += prize.Amount
	elseif prize.Kind == "Crate" then
		data.FreeCrates += prize.Amount
	elseif prize.Kind == "XP" then
		PlayerData.AddXP(player, prize.Amount, "Ruleta")
	end
	sendUpdate(player)
	requestSave(player)
	return true, index
end
Players.PlayerRemoving:Connect(function(player)
	lastSpin[player] = nil
end)

-- Abre una caja. Devuelve lo que ha tocado para la animación del cliente.
local function openCrate(player, crateId, useFree)
	local data = profiles[player]
	local crate = Shop.Crates[crateId]
	if not data or not crate then
		return false, "No existe"
	end
	if useFree then
		if data.FreeCrates <= 0 then
			return false, "No tienes cajas gratis"
		end
		data.FreeCrates -= 1
	else
		if cratesRestricted[player] then
			return false, "Las cajas de pago no están disponibles en tu región"
		end
		if data.Coins < crate.Price then
			return false, "Te faltan " .. (crate.Price - data.Coins) .. " monedas"
		end
		data.Coins -= crate.Price
	end

	-- Rareza según probabilidades
	local total = 0
	for _, entry in crate.Odds do
		total += entry.Weight
	end
	local roll = math.random() * total
	local rarity = crate.Odds[#crate.Odds].Rarity
	for _, entry in crate.Odds do
		roll -= entry.Weight
		if roll <= 0 then
			rarity = entry.Rarity
			break
		end
	end
	-- Objeto aleatorio de esa rareza (skins y trajes)
	local pool = {}
	for id, skin in Skins.List do
		if id ~= "Default" and not skin.Mastery and not skin.Event and skin.Rarity == rarity then
			table.insert(pool, { Kind = "Skin", Id = id })
		end
	end
	for id, outfit in Outfits.List do
		if id ~= "Default" and not outfit.Event and outfit.Rarity == rarity then
			table.insert(pool, { Kind = "Outfit", Id = id })
		end
	end
	if #pool == 0 then
		for id, skin in Skins.List do
			if id ~= "Default" and not skin.Mastery and not skin.Event then
				table.insert(pool, { Kind = "Skin", Id = id })
			end
		end
	end
	local prize = pool[math.random(1, #pool)]
	local owned
	if prize.Kind == "Skin" then
		owned = data.Skins[prize.Id] == true
	else
		owned = data.Outfits[prize.Id] == true
	end
	local refund = 0
	if owned then
		refund = math.floor(crate.Price * crate.DuplicateRefund)
		data.Coins += refund
	elseif prize.Kind == "Skin" then
		data.Skins[prize.Id] = true
	else
		data.Outfits[prize.Id] = true
	end
	sendUpdate(player)
	requestSave(player)
	return true, { Kind = prize.Kind, Id = prize.Id, Rarity = rarity, Duplicate = owned, Refund = refund }
end

-- Compras con Robux (Developer Products). Idempotente: cada PurchaseId se entrega una sola vez.
local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = PlayerData.WaitFor(player, 20)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(data.Purchases, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	-- Qué se entrega: un pack de monedas, de revivir o el pack de inicio
	local revivePack
	for _, p in Shop.RevivePacks do
		if p.ProductId ~= 0 and p.ProductId == receipt.ProductId then
			revivePack = p
		end
	end
	local grant, undo, message
	local starter = Shop.StarterPack
	local wheel = Shop.Wheel
	if wheel.SpinProductId ~= 0 and receipt.ProductId == wheel.SpinProductId then
		grant = function()
			data.WheelSpins += wheel.SpinsPerPurchase
		end
		undo = function()
			data.WheelSpins -= wheel.SpinsPerPurchase
		end
		message = "+" .. wheel.SpinsPerPurchase .. " GIROS DE RULETA"
	elseif starter.ProductId ~= 0 and receipt.ProductId == starter.ProductId and data.StarterPack then
		-- Ya lo tenía (compra repetida): Roblox ya cobró, así que se entregan solo las monedas
		grant = function()
			data.Coins += starter.Coins
		end
		undo = function()
			data.Coins -= starter.Coins
		end
		message = "+" .. starter.Coins .. " MONEDAS"
	elseif starter.ProductId ~= 0 and receipt.ProductId == starter.ProductId then
		-- Al deshacer solo se quita lo que se dio (no se vuelve a un saldo antiguo:
		-- mientras se guardaba pudo ganar o gastar monedas)
		local had = {
			Outfit = data.Outfits[starter.Outfit] == true,
			Skin = data.Skins[starter.Skin] == true,
			Effect = data.KillEffects[starter.KillEffect] == true,
		}
		grant = function()
			data.Coins += starter.Coins
			data.Outfits[starter.Outfit] = true
			data.Skins[starter.Skin] = true
			data.KillEffects[starter.KillEffect] = true
			data.StarterPack = true
		end
		undo = function()
			data.Coins -= starter.Coins
			if not had.Outfit then
				data.Outfits[starter.Outfit] = nil
			end
			if not had.Skin then
				data.Skins[starter.Skin] = nil
			end
			if not had.Effect then
				data.KillEffects[starter.KillEffect] = nil
			end
			data.StarterPack = false
		end
		message = "¡PACK DE INICIO DESBLOQUEADO!"
	elseif revivePack then
		local pack = revivePack
		grant = function()
			data.Revives += pack.Revives
		end
		undo = function()
			data.Revives -= pack.Revives
		end
		message = "+" .. pack.Revives .. " REVIVIR INSTANTÁNEO"
	else
		local pack
		for _, p in Shop.CoinPacks do
			if p.ProductId ~= 0 and p.ProductId == receipt.ProductId then
				pack = p
			end
		end
		if not pack then
			warn("[PlayerData] Producto desconocido:", receipt.ProductId)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		grant = function()
			data.Coins += pack.Coins
		end
		undo = function()
			data.Coins -= pack.Coins
		end
		message = "+" .. pack.Coins .. " MONEDAS"
	end
	grant()
	table.insert(data.Purchases, receipt.PurchaseId)
	while #data.Purchases > MAX_PURCHASE_LOG do
		table.remove(data.Purchases, 1)
	end
	if not store or noSave[player] or not save(player) then
		-- No se pudo guardar: deshacemos y Roblox lo reintentará más tarde (así nunca se pierden Robux)
		undo()
		local index = table.find(data.Purchases, receipt.PurchaseId)
		if index then
			table.remove(data.Purchases, index)
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	Remotes.Notify:FireClient(player, "Big", message)
	sendUpdate(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

---------------------------------------------------------------------------

function PlayerData.Init()
	Players.PlayerAdded:Connect(function(player)
		PlayerData.GetLeaderstats(player)
		load(player)
	end)
	for _, player in Players:GetPlayers() do
		PlayerData.GetLeaderstats(player)
		task.spawn(load, player)
	end

	local pending = 0
	Players.PlayerRemoving:Connect(function(player)
		pending += 1
		-- Últimos cambios de otros módulos antes del guardado final (p. ej. el tiempo de los regalos)
		if PlayerData.OnLeaving then
			pcall(PlayerData.OnLeaving, player)
		end
		save(player, true)
		pending -= 1
		profiles[player] = nil
		Badges.Forget(player)
		noSave[player] = nil
		match[player] = nil
		cratesRestricted[player] = nil
		dirty[player] = nil
		saveScheduled[player] = nil
	end)

	-- Al cerrar el servidor espera a que terminen todos los guardados (máx. ~25 s)
	game:BindToClose(function()
		for _, player in Players:GetPlayers() do
			if PlayerData.OnLeaving then
				pcall(PlayerData.OnLeaving, player)
			end
			pending += 1
			task.spawn(function()
				save(player, true)
				pending -= 1
			end)
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < 25 do
			task.wait(0.2)
		end
	end)

	-- Autoguardado
	task.spawn(function()
		while true do
			task.wait(120)
			for _, player in Players:GetPlayers() do
				task.spawn(save, player)
			end
		end
	end)

	Remotes.GetData.OnServerInvoke = function(player)
		local data = PlayerData.WaitFor(player, 20)
		return data and publicView(player, data)
	end

	Remotes.EquipSkin.OnServerEvent:Connect(function(player, skinId)
		local data = profiles[player]
		if not data or type(skinId) ~= "string" or not Skins.List[skinId] or not data.Skins[skinId] then
			return
		end
		if Skins.List[skinId].Mastery then
			return
		end
		data.EquippedSkin = skinId
		if PlayerData.OnSkinChanged then
			PlayerData.OnSkinChanged(player)
		end
		sendUpdate(player)
	end)

	Remotes.EquipOutfit.OnServerEvent:Connect(function(player, outfitId)
		local data = profiles[player]
		if not data or type(outfitId) ~= "string" or not Outfits.List[outfitId] or not data.Outfits[outfitId] then
			return
		end
		data.EquippedOutfit = outfitId
		if PlayerData.OnOutfitChanged then
			PlayerData.OnOutfitChanged(player, outfitId)
		end
		sendUpdate(player)
	end)

	local function setWeapon(player, weaponName, field, list)
		local data = profiles[player]
		if not data or type(weaponName) ~= "string" or not table.find(list, weaponName) then
			return
		end
		if not Weapons.IsUnlocked(weaponName, data) then
			return
		end
		data[field] = weaponName
		Remotes.Notify:FireClient(player, "Info", Weapons.Get(weaponName).DisplayName .. " equipada (al reaparecer)")
		sendUpdate(player)
	end
	Remotes.SetPrimary.OnServerEvent:Connect(function(player, weaponName)
		setWeapon(player, weaponName, "Primary", Weapons.Primaries)
	end)
	Remotes.SetSecondary.OnServerEvent:Connect(function(player, weaponName)
		setWeapon(player, weaponName, "Secondary", Weapons.Secondaries)
	end)
	Remotes.TutorialDone.OnServerEvent:Connect(function(player)
		local data = profiles[player]
		if data and not data.TutorialDone then
			data.TutorialDone = true
			dirty[player] = true
			sendUpdate(player)
		end
	end)
	Remotes.SetMelee.OnServerEvent:Connect(function(player, weaponName)
		setWeapon(player, weaponName, "Melee", Weapons.Melees)
	end)

	-- Ajustes del jugador: se validan y se guardan con su progreso
	Remotes.SaveSettings.OnServerEvent:Connect(function(player, settings)
		local data = profiles[player]
		if not data or type(settings) ~= "table" then
			return
		end
		local clean = table.clone(data.Settings)
		if type(settings.Quality) == "string" and table.find(GameConfig.QualityLevels, settings.Quality) then
			clean.Quality = settings.Quality
		end
		for key, limits in GameConfig.SettingsLimits do
			local value = settings[key]
			if type(value) == "number" and value == value then
				clean[key] = math.clamp(math.floor(value * 100 + 0.5) / 100, limits[1], limits[2])
			end
		end
		data.Settings = clean
		dirty[player] = true
	end)

	Remotes.EquipKillEffect.OnServerEvent:Connect(function(player, effectId)
		local data = profiles[player]
		if not data or type(effectId) ~= "string" or not KillEffects.List[effectId] or not data.KillEffects[effectId] then
			return
		end
		data.EquippedKillEffect = effectId
		sendUpdate(player)
	end)

	-- Camuflaje de maestría para un arma ("Default" = usar la skin general)
	Remotes.SetCamo.OnServerEvent:Connect(function(player, weaponName, camoId)
		local data = profiles[player]
		if not data or type(weaponName) ~= "string" or not Weapons.List[weaponName] or type(camoId) ~= "string" then
			return
		end
		if camoId == "Default" then
			data.WeaponCamos[weaponName] = nil
		elseif Mastery.HasCamo(data.WeaponKills[weaponName] or 0, camoId) then
			data.WeaponCamos[weaponName] = camoId
		else
			return
		end
		if PlayerData.OnSkinChanged then
			PlayerData.OnSkinChanged(player)
		end
		sendUpdate(player)
	end)

	-- Cambiar un reto diario sin completar por otro (1 al día)
	Remotes.RerollChallenge.OnServerInvoke = function(player, index)
		local data = profiles[player]
		if not data or type(index) ~= "number" then
			return false
		end
		local state = ensureChallenges(player, data)
		local entry = state.List[index]
		if not entry or entry.Done or (state.Rerolls or 0) >= Challenges.RerollsPerDay then
			return false
		end
		local exclude = {}
		for _, e in state.List do
			exclude[e.Id] = true
		end
		state.Rerolls = (state.Rerolls or 0) + 1
		local new = Challenges.Pick(state.Day, player.UserId, data.Level, 1, exclude, state.Rerolls)[1]
		if not new then
			return false
		end
		state.List[index] = { Id = new, Progress = 0, Done = false }
		sendUpdate(player)
		return true
	end

	Remotes.BuyItem.OnServerInvoke = buyItem
	Remotes.ClaimDaily.OnServerInvoke = claimDaily
	Remotes.SpinWheel.OnServerInvoke = spinWheel
	Remotes.OpenCrate.OnServerInvoke = openCrate
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local data = profiles[player]
		if not data then
			return
		end
		if passId == GameConfig.PremiumPassId and GameConfig.PremiumPassId ~= 0 then
			data.Premium = true
			Remotes.Notify:FireClient(player, "Big", "¡PASE PREMIUM ACTIVADO!")
			grantTierRewards(player)
		elseif passId == Shop.VIPPassId and Shop.VIPPassId ~= 0 then
			player:SetAttribute("VIP", true)
			Remotes.Notify:FireClient(player, "Big", "¡VIP ACTIVADO! x2 XP y monedas")
		end
		sendUpdate(player)
		save(player)
	end)
end

return PlayerData
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">Respawn</string>
            <string name="Source"><![CDATA[-- Reaparición controlada por el juego (Players.CharacterAutoLoads = false en default.project.json):
--   * Al morir se reaparece solo tras GameConfig.RespawnTime segundos
--   * "Regenerar ahora": a partir de GameConfig.RespawnNowDelay se puede reaparecer antes
--   * "Revivir instantáneo": gasta un revivir (data.Revives) y vuelve justo donde moriste
-- Round llama a Respawn.ApplyRevive al aparecer el personaje para colocarlo en ese punto.
-- En plena ronda de Eliminación (atributo NoRespawn) no hay reaparición: se espera a la siguiente ronda.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)

local PlayerData = require(script.Parent.PlayerData)

local Respawn = {}

local deaths = {} -- [player] = { Time = os.clock(), Position = Vector3?, Character = Model }
local revivePoints = {} -- [player] = Vector3 donde debe aparecer tras revivir
local loading = {} -- [player] = true mientras se carga un personaje (evita cargas dobles)

local function noRespawn()
	return ReplicatedStorage:GetAttribute("NoRespawn") == true
end

local function isDead(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return character == nil or humanoid == nil or humanoid.Health <= 0
end

local function load(player)
	if loading[player] or not player.Parent then
		return
	end
	loading[player] = true
	local ok, err = pcall(player.LoadCharacter, player)
	loading[player] = nil
	if ok then
		deaths[player] = nil
	else
		-- Sin CharacterAutoLoads nadie más lo reintentaría: se queda muerto. Reintento en un segundo.
		-- (deaths se conserva para que "Regenerar ahora" siga funcionando mientras tanto)
		warn("[Respawn] No se pudo cargar el personaje:", err)
		revivePoints[player] = nil
		task.delay(1, function()
			if player.Parent and isDead(player) then
				load(player)
			end
		end)
	end
end
Respawn.Load = load

-- ¿Se está cargando su personaje ahora mismo? (Eliminación lo cuenta como vivo)
function Respawn.IsLoading(player)
	return loading[player] == true
end

local function watch(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end
	humanoid.Died:Connect(function()
		local root = character:FindFirstChild("HumanoidRootPart")
		deaths[player] = { Time = os.clock(), Position = root and root.Position, Character = character }
		task.delay(GameConfig.RespawnTime, function()
			-- Solo si sigue con el mismo personaje muerto (no ha usado "Regenerar" ni "Revivir")
			if player.Parent and player.Character == character and not noRespawn() then
				load(player)
			end
		end)
	end)
end

-- Llamada por Round al aparecer: si el jugador acaba de revivir, lo pone donde murió.
-- Devuelve true si lo ha colocado (y entonces no se usa el punto de aparición normal).
function Respawn.ApplyRevive(player, character)
	local point = revivePoints[player]
	if not point then
		return false
	end
	revivePoints[player] = nil
	local root = character:WaitForChild("HumanoidRootPart", 5)
	if not root then
		return false
	end
	task.wait()
	character:PivotTo(CFrame.new(point + Vector3.new(0, 3, 0)) * (root.CFrame - root.Position))
	-- Protección breve al revivir (se pierde al disparar, como la de reaparición)
	local shield = Instance.new("ForceField")
	shield.Name = "SpawnShield"
	shield.Visible = true
	shield.Parent = character
	task.delay(GameConfig.ReviveShieldTime, function()
		if shield.Parent then
			shield:Destroy()
		end
	end)
	return true
end

-- Comprueba si se puede revivir ahora mismo; devuelve el punto o nil y el motivo
local function reviveCheck(player)
	local death = deaths[player]
	if not death or not isDead(player) then
		return nil, "Solo al morir"
	end
	if os.clock() - death.Time > GameConfig.RespawnTime + 0.5 then
		return nil, "Demasiado tarde"
	end
	if ReplicatedStorage:GetAttribute("State") ~= "Playing" then
		return nil, "La ronda no está en juego"
	end
	if noRespawn() then
		return nil, "Una sola vida por ronda"
	end
	-- Infección: un superviviente que cae ya es zombi (no vuelve como humano)
	if ReplicatedStorage:GetAttribute("Infection") == "On" and player.Team and player.Team.Name == ReplicatedStorage:GetAttribute("TeamA") then
		return nil, "¡Te han infectado!"
	end
	if ReplicatedStorage:GetAttribute("Frozen") or loading[player] then
		return nil, "Ya estás reapareciendo"
	end
	local point = death.Position
	if not point or point.Y < -20 then
		return nil, "No se puede revivir aquí"
	end
	-- Tiene que haber suelo debajo (no en el aire sobre un hueco) y no puede ser lava
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(point + Vector3.new(0, 2, 0), Vector3.new(0, -14, 0), params)
	if not hit then
		return nil, "No hay suelo aquí"
	end
	if hit.Instance:GetAttribute("Hazard") or hit.Material == Enum.Material.CrackedLava then
		return nil, "No se puede revivir en la lava"
	end
	return hit.Position
end

function Respawn.Init()
	Players.CharacterAutoLoads = false -- también en default.project.json; aquí por si se usa otro lugar
	Remotes.RespawnNow.OnServerEvent:Connect(function(player)
		local death = deaths[player]
		if death and isDead(player) and os.clock() - death.Time >= GameConfig.RespawnNowDelay and not noRespawn() then
			load(player)
		end
	end)

	Remotes.InstantRevive.OnServerInvoke = function(player)
		local point, reason = reviveCheck(player)
		if not point then
			return false, reason
		end
		if not PlayerData.UseRevive(player) then
			return false, "Sin revivir"
		end
		revivePoints[player] = point
		task.spawn(load, player)
		return true
	end

	local function onPlayer(player)
		player.CharacterAdded:Connect(function(character)
			task.spawn(watch, player, character)
		end)
		if player.Character then
			task.spawn(watch, player, player.Character)
		else
			-- Primera aparición (CharacterAutoLoads está desactivado)
			task.defer(load, player)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		deaths[player] = nil
		revivePoints[player] = nil
		loading[player] = nil
	end)
end

return Respawn
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">Round</string>
            <string name="Source"><![CDATA[-- Rondas, modos de juego, votación de mapa/modo, equipos, marcador, rachas y recompensas.
-- Modos: TDM (duelo por equipos), CTF (captura la bandera), KOTH (zona de control),
--        FFA (todos contra todos), GUN (escalada de armas) y ELIM (eliminación: rondas de una vida).
--
-- Estado publicado en ReplicatedStorage para la interfaz:
--   State ("Intermission" | "Playing" | "Ended"), Mode, ModeName, TeamMode, TimeLeft, ScoreToWin,
--   Score_<Equipo>, LeaderName, LeaderScore, MapName,
--   NoRespawn (true en plena ronda de Eliminación), AliveA / AliveB (vivos de cada equipo en Eliminación),
--   VoteN_Map, VoteN_Mode, VoteN_Count (N = 1..3) durante el descanso
-- En cada jugador: atributo Score (bajas en FFA / nivel en Escalada), Streak, Captures, GunLevel
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.GameConfig)
local Weapons = require(Shared.Weapons)
local Remotes = require(Shared.Remotes)
local Ranks = require(Shared.Ranks)

local PlayerData = require(script.Parent.PlayerData)
local Flags = require(script.Parent.Flags)
local Hardpoint = require(script.Parent.Hardpoint)
local MapBuilder = require(script.Parent.MapBuilder)
local Loadout = require(script.Parent.Loadout)
local Killstreaks = require(script.Parent.Killstreaks)
local Grenades = require(script.Parent.Grenades)
local Respawn = require(script.Parent.Respawn)
local Bots = require(script.Parent.Bots)
local Zombie = require(script.Parent.Zombie)

local Round = {}

local teams = {}
local roundOver = false
local currentMode = "TDM"
local votes = {} -- [player] = índice
local voteOptions = {}

local onInfectionDeath -- (Infección: quien cae ante los zombis se convierte; ver más abajo)

-- ¿Ha ganado la partida este jugador? En Infección, si ganan los zombis solo cuentan como ganadores
-- los que ya eran zombis al empezar (los supervivientes convertidos han perdido)
local function wonTeam(player, winner)
	if winner == nil or player.Team ~= winner then
		return false
	end
	if currentMode == "INF" and winner == teams[2] then
		return player:GetAttribute("InfZombieStart") == true
	end
	return true
end

local STREAK_ANNOUNCE = { [3] = true, [5] = true, [7] = true, [10] = true, [15] = true, [20] = true }

local function setState(state)
	ReplicatedStorage:SetAttribute("State", state)
end

local function settings(mode)
	return GameConfig.ModeSettings[mode or currentMode]
end

local function isTeamMode(mode)
	return settings(mode).Teams ~= false
end

local function getScore(teamName)
	return ReplicatedStorage:GetAttribute("Score_" .. teamName) or 0
end

local function setupTeams()
	for _, cfg in GameConfig.Teams do
		local team = Teams:FindFirstChild(cfg.Name)
		if not team then
			team = Instance.new("Team")
			team.Name = cfg.Name
			team.TeamColor = cfg.Color
			team.AutoAssignable = false
			team.Parent = Teams
		end
		table.insert(teams, team)
		ReplicatedStorage:SetAttribute("Score_" .. cfg.Name, 0)
	end
	ReplicatedStorage:SetAttribute("TeamA", teams[1].Name)
	ReplicatedStorage:SetAttribute("TeamB", teams[2].Name)
end

local function addScore(team, amount)
	if ReplicatedStorage:GetAttribute("State") ~= "Playing" or not team then
		return
	end
	local score = getScore(team.Name) + amount
	ReplicatedStorage:SetAttribute("Score_" .. team.Name, score)
	if score >= (ReplicatedStorage:GetAttribute("ScoreToWin") or math.huge) then
		roundOver = true
	end
end

-- Líder individual (modos sin equipos). Puede ser un bot (tabla de Bots, con Name y Score).
local function updateLeader(leaving)
	local best, bestScore = nil, -1
	for _, player in Players:GetPlayers() do
		local score = player:GetAttribute("Score") or 0
		if player ~= leaving and score > bestScore then
			best, bestScore = player, score
		end
	end
	for _, agent in Bots.Agents do
		if (agent.Score or 0) > bestScore then
			best, bestScore = agent, agent.Score or 0
		end
	end
	ReplicatedStorage:SetAttribute("LeaderName", best and best.Name or "")
	ReplicatedStorage:SetAttribute("LeaderScore", math.max(bestScore, 0))
	return best, bestScore
end

local function addPlayerScore(player, amount)
	local score = (player:GetAttribute("Score") or 0) + amount
	player:SetAttribute("Score", score)
	updateLeader()
	if ReplicatedStorage:GetAttribute("State") == "Playing" and score >= (ReplicatedStorage:GetAttribute("ScoreToWin") or math.huge) then
		roundOver = true
	end
end

---------------------------------------------------------------------------
-- Equipos
---------------------------------------------------------------------------

local function smallestTeam(exclude)
	local best, bestCount = nil, math.huge
	for _, team in teams do
		local count = 0
		for _, p in team:GetPlayers() do
			if p ~= exclude then
				count += 1
			end
		end
		if count < bestCount or (count == bestCount and math.random() < 0.5) then
			best, bestCount = team, count
		end
	end
	return best
end

local function assignTeam(player)
	-- Infección: quien entra antes de la infección es superviviente; después, zombi
	local infection = ReplicatedStorage:GetAttribute("Infection")
	if infection then
		player.Neutral = false
		player.Team = infection == "On" and teams[2] or teams[1]
		if infection == "On" then
			player:SetAttribute("InfZombieStart", true)
		end
		return
	end
	if isTeamMode() then
		player.Neutral = false
		player.Team = smallestTeam(player)
	else
		player.Team = nil
		player.Neutral = true
	end
end

local function balanceTeams()
	-- Infección: todos empiezan como supervivientes
	if ReplicatedStorage:GetAttribute("Infection") then
		for _, player in Players:GetPlayers() do
			player.Neutral = false
			player.Team = teams[1]
		end
		return
	end
	if not isTeamMode() then
		for _, player in Players:GetPlayers() do
			player.Team = nil
			player.Neutral = true
		end
		return
	end
	for _, player in Players:GetPlayers() do
		if not player.Team then
			player.Neutral = false
			player.Team = smallestTeam(player)
		end
	end
	local a, b = teams[1], teams[2]
	while math.abs(#a:GetPlayers() - #b:GetPlayers()) > 1 do
		local big = #a:GetPlayers() > #b:GetPlayers() and a or b
		local small = big == a and b or a
		local list = big:GetPlayers()
		list[math.random(1, #list)].Team = small
	end
end

local function resetStats()
	for _, player in Players:GetPlayers() do
		local stats = PlayerData.GetLeaderstats(player)
		stats.Bajas.Value = 0
		stats.Muertes.Value = 0
		player:SetAttribute("Streak", 0)
		player:SetAttribute("BestStreak", 0)
		player:SetAttribute("Captures", 0)
		player:SetAttribute("Score", 0)
		player:SetAttribute("GunLevel", 1)
		-- Participación para el rango: desde cuándo juega esta partida (Loadout lo pone al salir del menú)
		player:SetAttribute("MatchJoinedAt", if player:GetAttribute("InMenu") then nil else workspace:GetServerTimeNow())
		player:SetAttribute("ElimPlayed", nil)
		player:SetAttribute("InfZombieStart", nil)
		PlayerData.StartMatch(player)
	end
	Killstreaks.Reset()
	Grenades.Reset()
	for _, team in teams do
		ReplicatedStorage:SetAttribute("Score_" .. team.Name, 0)
	end
	updateLeader()
end

---------------------------------------------------------------------------
-- Escalada de armas
---------------------------------------------------------------------------

local function gunGameWeapons(player)
	local order = Weapons.GunGameOrder
	local level = math.clamp(player:GetAttribute("GunLevel") or 1, 1, #order)
	local weapon = order[level]
	if weapon == Weapons.Melee then
		return { weapon }
	end
	return { weapon, Weapons.Melee }
end

local function gunGameKill(killer, victim, weaponName)
	local order = Weapons.GunGameOrder
	local level = (killer:GetAttribute("GunLevel") or 1) + 1
	killer:SetAttribute("GunLevel", level)
	killer:SetAttribute("Score", level - 1)
	updateLeader()
	if level > #order then
		roundOver = true
		return
	end
	Remotes.Notify:FireClient(killer, "Info", "Nueva arma: " .. Weapons.Get(order[level]).DisplayName)
	Loadout.Give(killer, gunGameWeapons(killer))
	-- Humillación: una baja con cuchillo hace bajar un nivel a la víctima
	if victim and weaponName == Weapons.Melee then
		local vLevel = math.max(1, (victim:GetAttribute("GunLevel") or 1) - 1)
		victim:SetAttribute("GunLevel", vLevel)
		victim:SetAttribute("Score", vLevel - 1)
		Remotes.Notify:FireClient(victim, "Info", "¡Te han bajado de nivel con el cuchillo!")
	end
end

---------------------------------------------------------------------------
-- Bajas
---------------------------------------------------------------------------

-- killerBot / victimBot: el bot (ver Bots) cuando quien hace la baja o quien muere es un bot
function Round.RegisterKill(killer, victim, victimName, weaponName, headshot, position, killerBot, victimBot)
	if victim then
		PlayerData.GetLeaderstats(victim).Muertes.Value += 1
		PlayerData.Increment(victim, "TotalDeaths", 1)
		victim:SetAttribute("Streak", 0)
	end
	local playing = ReplicatedStorage:GetAttribute("State") == "Playing"

	local killerColor, victimColor = Color3.new(1, 1, 1), Color3.new(1, 1, 1)
	if victim and victim.Team then
		victimColor = victim.TeamColor.Color
	elseif victimBot and victimBot.Team then
		victimColor = victimBot.Team.TeamColor.Color
	end

	if victimBot then
		Bots.AddStat(victimBot, "Deaths", 1)
	end
	-- Un bot hace una baja: punto para su equipo (en equipos) o para él (todos contra todos)
	if killerBot then
		Bots.AddStat(killerBot, "Kills", 1)
		if killerBot.Team then
			killerColor = killerBot.Team.TeamColor.Color
			if playing and currentMode == "TDM" then
				addScore(killerBot.Team, 1)
			end
		elseif playing and currentMode == "FFA" then
			killerBot.Score = (killerBot.Score or 0) + 1
			Bots.AddStat(killerBot, "Score", 1)
			updateLeader()
			if killerBot.Score >= (ReplicatedStorage:GetAttribute("ScoreToWin") or math.huge) then
				roundOver = true
			end
		end
	end

	if killer and killer ~= victim then
		if killer.Team then
			killerColor = killer.TeamColor.Color
		end
		if victim or victimBot then
			-- Contra bots: misma emoción (marcador, racha, retos, maestría) pero menos XP y monedas,
			-- y no cuentan para la clasificación global
			local botScale = victimBot and GameConfig.Bots.RewardScale or 1
			PlayerData.GetLeaderstats(killer).Bajas.Value += 1
			local streak = (killer:GetAttribute("Streak") or 0) + 1
			killer:SetAttribute("Streak", streak)
			if streak > (killer:GetAttribute("BestStreak") or 0) then
				killer:SetAttribute("BestStreak", streak)
			end

			if playing then
				if currentMode == "TDM" then
					addScore(killer.Team, 1)
				elseif currentMode == "FFA" then
					addPlayerScore(killer, 1)
				elseif currentMode == "GUN" and victim then
					gunGameKill(killer, victim, weaponName)
				end
			end

			local xp = GameConfig.XP.Kill + GameConfig.XP.StreakBonus * (streak - 1)
			if headshot then
				xp += GameConfig.XP.Headshot
			end
			PlayerData.AddXP(killer, math.floor(xp * botScale), headshot and "Disparo a la cabeza" or "Eliminación")
			PlayerData.AddCoins(killer, math.max(1, math.floor(GameConfig.Coins.Kill * botScale)))
			if victim then
				PlayerData.Increment(killer, "TotalKills", 1)
			end
			PlayerData.AddWeaponKill(killer, weaponName)
			PlayerData.Track(killer, "Kill", 1, weaponName)
			PlayerData.Track(killer, "Streak", streak)
			PlayerData.SetBest(killer, "BestStreak", streak)
			if headshot then
				PlayerData.Increment(killer, "Headshots", 1)
				PlayerData.Track(killer, "Headshot", 1, weaponName)
			end

			if STREAK_ANNOUNCE[streak] then
				Remotes.Notify:FireAllClients("Streak", killer.Name .. " tiene una racha de " .. streak .. " bajas")
			end
			Killstreaks.OnStreak(killer, streak)
		end
	end

	-- Efecto de eliminación: el que tenga equipado quien ha hecho la baja (o el normal)
	if typeof(position) == "Vector3" then
		local effect = "Default"
		local killerData = killer and killer ~= victim and PlayerData.Get(killer)
		if killerData and killerData.EquippedKillEffect then
			effect = killerData.EquippedKillEffect
		end
		-- Los muñecos (sin jugador ni equipo) estallan en amarillo, como antes
		local burstColor = (victim or (victimBot and victimBot.Team)) and victimColor or Color3.fromRGB(255, 200, 60)
		Remotes.KillFX:FireAllClients(position, effect, burstColor)
	end

	local weapon = weaponName and Weapons.Get(weaponName)
	Remotes.KillFeed:FireAllClients({
		Killer = (killer and killer.Name) or (killerBot and killerBot.Name) or nil,
		KillerColor = killerColor,
		Victim = victimName,
		VictimColor = victimColor,
		Weapon = weapon and weapon.DisplayName or "",
		Headshot = headshot,
	})
	-- Infección: el superviviente que cae se convierte en zombi en el acto (antes de que pueda revivir)
	if ReplicatedStorage:GetAttribute("Infection") == "On" and onInfectionDeath then
		onInfectionDeath(victim, victimBot)
	end
end

---------------------------------------------------------------------------
-- Aparición libre (FFA / Escalada): el punto más alejado de los demás
---------------------------------------------------------------------------

local ffaCache = { Map = nil, Points = {} }

local function ffaSpawnFor(player, character)
	if isTeamMode() then
		return
	end
	local map = workspace:FindFirstChild("Map")
	if not map then
		return
	end
	-- Puntos libres del mapa (se guardan mientras no cambie el mapa)
	if ffaCache.Map ~= map then
		ffaCache.Map, ffaCache.Points = map, {}
		for _, d in map:GetDescendants() do
			if d:IsA("BasePart") and d.Name == "FFASpawn" then
				table.insert(ffaCache.Points, d)
			end
		end
	end
	local points = ffaCache.Points
	if #points == 0 then
		return
	end
	-- Lejos de los demás jugadores y de los bots
	local others = {}
	for _, p in Players:GetPlayers() do
		local root = p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if root then
			table.insert(others, root.Position)
		end
	end
	for _, agent in Bots.Agents do
		if agent.Root and agent.Root.Parent then
			table.insert(others, agent.Root.Position)
		end
	end
	local best, bestDistance = points[math.random(1, #points)], -1
	for _, point in points do
		local nearest = math.huge
		for _, pos in others do
			nearest = math.min(nearest, (pos - point.Position).Magnitude)
		end
		nearest += math.random() * 10 -- un poco de azar entre puntos parecidos
		if nearest > bestDistance then
			best, bestDistance = point, nearest
		end
	end
	local root = character:WaitForChild("HumanoidRootPart", 5)
	if root then
		task.wait()
		character:PivotTo(CFrame.new(best.Position + Vector3.new(0, 3, 0)) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	end
end

---------------------------------------------------------------------------
-- Votación de mapa + modo
---------------------------------------------------------------------------

local function availableModes(mapId)
	local list = {}
	for _, mode in GameConfig.Modes do
		if GameConfig.ModeSettings[mode] then
			table.insert(list, mode)
		end
	end
	_ = mapId
	return list
end

local function makeVoteOptions()
	local maps = table.clone(MapBuilder.Order)
	if MapBuilder.IsCustom() then
		maps = { "Custom" }
	end
	-- Prioriza mapas distintos al actual
	for i = #maps, 2, -1 do
		local j = math.random(1, i)
		maps[i], maps[j] = maps[j], maps[i]
	end
	table.sort(maps, function(a, b)
		return (a ~= MapBuilder.Current and 0 or 1) < (b ~= MapBuilder.Current and 0 or 1)
	end)
	local options = {}
	local usedModes = {}
	for i = 1, 3 do
		local mapId = maps[((i - 1) % #maps) + 1]
		local modes = availableModes(mapId)
		local mode = modes[math.random(1, #modes)]
		for _ = 1, 6 do
			if not usedModes[mode] then
				break
			end
			mode = modes[math.random(1, #modes)]
		end
		usedModes[mode] = true
		table.insert(options, { Map = mapId, Mode = mode })
	end
	return options
end

local function publishVotes()
	local counts = { 0, 0, 0 }
	for _, choice in votes do
		counts[choice] = (counts[choice] or 0) + 1
	end
	for i, option in voteOptions do
		local def = MapBuilder.Get(option.Map)
		ReplicatedStorage:SetAttribute("Vote" .. i .. "_Map", def and ((def.Icon and def.Icon .. " " or "") .. def.Name) or "Mapa propio")
		ReplicatedStorage:SetAttribute("Vote" .. i .. "_Mode", GameConfig.ModeSettings[option.Mode].Name)
		ReplicatedStorage:SetAttribute("Vote" .. i .. "_Count", counts[i])
	end
	return counts
end

local function clearVotes()
	for i = 1, 3 do
		ReplicatedStorage:SetAttribute("Vote" .. i .. "_Map", nil)
		ReplicatedStorage:SetAttribute("Vote" .. i .. "_Mode", nil)
		ReplicatedStorage:SetAttribute("Vote" .. i .. "_Count", nil)
	end
end

---------------------------------------------------------------------------
-- Ciclo de rondas
---------------------------------------------------------------------------

local function countdown(seconds, stopWhen)
	for t = seconds, 0, -1 do
		ReplicatedStorage:SetAttribute("TimeLeft", t)
		if stopWhen and stopWhen() then
			return
		end
		task.wait(1)
	end
end

local function respawnAll()
	for _, player in Players:GetPlayers() do
		task.spawn(Respawn.Load, player) -- con la protección contra cargas dobles
	end
end

local function isDeadPlayer(player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	return not humanoid or humanoid.Health <= 0
end

---------------------------------------------------------------------------
-- Infección (INF): supervivientes (equipo A) contra zombis (equipo B)
---------------------------------------------------------------------------

-- Los zombis solo llevan garras; los supervivientes, sus armas de siempre
local function infectionLoadout(player)
	if ReplicatedStorage:GetAttribute("Infection") == "On" and player.Team == teams[2] then
		return { "Claws" }
	end
	return nil
end

-- Aspecto de zombi al aparecer (después de cargar la ropa del avatar, que si no lo taparía)
local function zombify(player, character)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid or player.Character ~= character then
		return
	end
	Zombie.Apply(character, settings("INF").ZombieHealth)
	local started = os.clock()
	while not player:HasAppearanceLoaded() and os.clock() - started < 5 do
		task.wait(0.2)
	end
	if player.Character == character then
		Zombie.Apply(character, nil)
	end
end

-- Convierte en zombi a un jugador. Si sigue vivo (paciente cero) reaparece ya como zombi.
local function infectPlayer(player, announce)
	if player.Team == teams[2] then
		return
	end
	player.Neutral = false
	player.Team = teams[2]
	player:SetAttribute("Airstrikes", 0) -- (los zombis no tienen recompensas por racha)
	if announce then
		Remotes.Notify:FireAllClients("Streak", "🧟 " .. player.Name .. " se ha convertido en zombi")
	end
	if not isDeadPlayer(player) and not player:GetAttribute("InMenu") then
		task.spawn(Respawn.Load, player)
	end
end

local function infectionCounts()
	local survivors, zombies = 0, 0
	for _, player in Players:GetPlayers() do
		if not player:GetAttribute("InMenu") then
			if player.Team == teams[1] then
				local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
				if Respawn.IsLoading(player) or (humanoid and humanoid.Health > 0) then
					survivors += 1
				end
			elseif player.Team == teams[2] then
				zombies += 1
			end
		end
	end
	for _, agent in Bots.Agents do
		if agent.Team == teams[1] then
			if agent.Spawning or (agent.Humanoid and agent.Humanoid.Health > 0) then
				survivors += 1
			end
		elseif agent.Team == teams[2] then
			zombies += 1
		end
	end
	return survivors, zombies
end

-- Elige pacientes cero al azar entre los supervivientes (jugadores fuera del menú y bots)
local function infectRandom(count)
	local pool = {}
	for _, player in Players:GetPlayers() do
		if player.Team == teams[1] and not player:GetAttribute("InMenu") then
			table.insert(pool, player)
		end
	end
	for _, agent in Bots.Agents do
		if agent.Team == teams[1] and agent.Humanoid then
			table.insert(pool, agent)
		end
	end
	local infected = 0
	for _ = 1, math.min(count, #pool - 1) do
		local chosen = table.remove(pool, math.random(1, #pool))
		infected += 1
		if typeof(chosen) == "Instance" then
			chosen:SetAttribute("InfZombieStart", true)
			infectPlayer(chosen, true)
		else
			Bots.Infect(chosen, teams[2])
			Remotes.Notify:FireAllClients("Streak", "🧟 " .. chosen.Name .. " se ha convertido en zombi")
		end
	end
	return infected
end

onInfectionDeath = function(victim, victimBot)
	if victim and victim.Team == teams[1] then
		infectPlayer(victim, true)
	elseif victimBot and victimBot.Team == teams[1] then
		Bots.Infect(victimBot, teams[2])
		Remotes.Notify:FireAllClients("Streak", "🧟 " .. victimBot.Name .. " se ha convertido en zombi")
	end
end

local function infectionRound(s)
	local a, b = teams[1], teams[2]
	-- Preparación: todos son supervivientes y se reparten por el mapa
	for t = s.PrepTime, 1, -1 do
		ReplicatedStorage:SetAttribute("TimeLeft", t)
		if t == s.PrepTime or t <= 3 then
			Remotes.Notify:FireAllClients("Big", "🧟 La infección empieza en " .. t .. "…")
		end
		local survivors = infectionCounts()
		ReplicatedStorage:SetAttribute("AliveA", survivors)
		ReplicatedStorage:SetAttribute("AliveB", 0)
		task.wait(1)
	end
	ReplicatedStorage:SetAttribute("Infection", "On")
	-- Quien sigue en la pantalla de inicio no es superviviente: si entra, lo hará como zombi
	for _, player in Players:GetPlayers() do
		if player.Team == a and player:GetAttribute("InMenu") then
			player.Team = b
			player:SetAttribute("InfZombieStart", true)
		end
	end
	local survivors = infectionCounts()
	if infectRandom(math.max(1, math.floor(survivors / (s.ZombieRatio or 5)))) == 0 then
		Remotes.Notify:FireAllClients("Big", "Hacen falta al menos 2 jugadores para la infección")
		task.wait(2)
		return
	end
	Remotes.Notify:FireAllClients("Big", "🧟 ¡HAN LLEGADO LOS ZOMBIS! ¡Sobrevive!")
	local roundEnd = os.clock() + s.RoundTime
	local winner
	local lastAnnounced = false
	while not roundOver do
		-- Los supervivientes que caen (por lo que sea) se convierten en zombis; quien vuelve al menú
		-- deja de ser superviviente
		for _, player in Players:GetPlayers() do
			if player.Team == a then
				if player:GetAttribute("InMenu") then
					infectPlayer(player, false)
				elseif not Respawn.IsLoading(player) and isDeadPlayer(player) then
					infectPlayer(player, true)
				end
			end
		end
		for _, agent in table.clone(Bots.Agents) do
			if agent.Team == a and not agent.Humanoid and not agent.Spawning then
				Bots.Infect(agent, b)
			end
		end
		local alive, zombies = infectionCounts()
		-- ¡Último superviviente! Se anuncia y recibe más vida para el final
		if alive == 1 and not lastAnnounced then
			lastAnnounced = true
			for _, player in Players:GetPlayers() do
				local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
				if player.Team == a and not player:GetAttribute("InMenu") and humanoid and humanoid.Health > 0 then
					humanoid.MaxHealth = 150
					humanoid.Health = 150
					Remotes.Notify:FireAllClients("Big", "🧑 ¡" .. string.upper(player.Name) .. " ES EL ÚLTIMO SUPERVIVIENTE!")
				end
			end
			for _, agent in Bots.Agents do
				if agent.Team == a and agent.Humanoid and agent.Humanoid.Health > 0 then
					agent.Humanoid.MaxHealth = 150
					agent.Humanoid.Health = 150
					Remotes.Notify:FireAllClients("Big", "🧑 ¡" .. string.upper(agent.Name) .. " ES EL ÚLTIMO SUPERVIVIENTE!")
				end
			end
		end
		ReplicatedStorage:SetAttribute("AliveA", alive)
		ReplicatedStorage:SetAttribute("AliveB", zombies)
		ReplicatedStorage:SetAttribute("TimeLeft", math.max(0, math.ceil(roundEnd - os.clock())))
		if alive == 0 then
			winner = b
			break
		elseif zombies == 0 and alive >= 2 then
			-- Se fueron todos los zombis: nuevo paciente cero
			infectRandom(1)
		end
		if os.clock() >= roundEnd then
			winner = a
			break
		end
		task.wait(0.25)
	end
	if winner then
		addScore(winner, 1)
		Remotes.Notify:FireAllClients("Big", winner == a and "🧑 ¡GANAN LOS SUPERVIVIENTES!" or "🧟 ¡GANAN LOS ZOMBIS!")
		task.wait(2)
	end
end

-- Limpia el estado de Infección (al acabar o si la ronda falla)
local function clearInfection()
	ReplicatedStorage:SetAttribute("Infection", nil)
	ReplicatedStorage:SetAttribute("AliveA", nil)
	ReplicatedStorage:SetAttribute("AliveB", nil)
end

---------------------------------------------------------------------------
-- Eliminación (ELIM)
---------------------------------------------------------------------------

-- Vivos y participantes de un equipo (jugadores fuera del menú + bots)
-- Vivos y participantes de un equipo. Solo cuentan los jugadores que empezaron la ronda (atributo
-- ElimIn) y los bots; un bot que aún se está creando cuenta como vivo.
local function aliveCount(team)
	local alive, members = 0, 0
	for _, player in team:GetPlayers() do
		if player:GetAttribute("ElimIn") then
			members += 1
			-- Quien vuelve al menú no cuenta como vivo (si no, su equipo no se podría eliminar);
			-- quien está reapareciendo justo al empezar, sí
			local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if not player:GetAttribute("InMenu") and (Respawn.IsLoading(player) or (humanoid and humanoid.Health > 0)) then
				alive += 1
			end
		end
	end
	for _, agent in Bots.Agents do
		if agent.Team == team then
			members += 1
			if agent.Spawning or (agent.Humanoid and agent.Humanoid.Health > 0) then
				alive += 1
			end
		end
	end
	return alive, members
end

-- Limpia el estado de Eliminación (al acabar o si la ronda falla)
local function clearElimination()
	ReplicatedStorage:SetAttribute("NoRespawn", false)
	ReplicatedStorage:SetAttribute("Frozen", false)
	ReplicatedStorage:SetAttribute("AliveA", nil)
	ReplicatedStorage:SetAttribute("AliveB", nil)
	for _, player in Players:GetPlayers() do
		player:SetAttribute("ElimIn", nil)
	end
end

-- Rondas de una vida hasta que un equipo llegue a ScoreToWin rondas ganadas (o se acabe el tiempo total)
local MIN_SUBROUND = 20 -- no se empieza una ronda si quedan menos segundos que esto (más la preparación)
local function eliminationRounds(s)
	local deadline = os.clock() + s.RoundTime
	local number = 0
	local a, b = teams[1], teams[2]
	while not roundOver and deadline - os.clock() >= s.PrepTime + MIN_SUBROUND do
		number += 1
		-- Preparación: todos vuelven a su base con la vida llena y quietos (no se puede disparar)
		ReplicatedStorage:SetAttribute("Frozen", true)
		ReplicatedStorage:SetAttribute("NoRespawn", false)
		for _, player in Players:GetPlayers() do
			player:SetAttribute("ElimIn", nil)
		end
		-- (sin contador de vivos durante la preparación)
		ReplicatedStorage:SetAttribute("AliveA", nil)
		ReplicatedStorage:SetAttribute("AliveB", nil)
		respawnAll()
		Bots.RespawnAll()
		Remotes.Notify:FireAllClients("Big", "RONDA " .. number .. " · ¡Una sola vida!")
		countdown(s.PrepTime)
		-- Que nadie empiece muerto (p. ej. un bot que aún se estaba creando o alguien que cayó en la preparación)
		local waitUntil = os.clock() + 5
		while os.clock() < waitUntil do
			local spawning = false
			for _, agent in Bots.Agents do
				spawning = spawning or agent.Spawning == true
			end
			if not spawning then
				break
			end
			task.wait(0.2)
		end
		for _, player in Players:GetPlayers() do
			if not player:GetAttribute("InMenu") then
				if isDeadPlayer(player) then
					task.spawn(Respawn.Load, player)
				end
				player:SetAttribute("ElimIn", true) -- participa en esta ronda
				player:SetAttribute("ElimPlayed", true)
			end
		end
		Bots.RespawnDead()
		ReplicatedStorage:SetAttribute("NoRespawn", true)
		ReplicatedStorage:SetAttribute("Frozen", false)
		Remotes.Notify:FireAllClients("Big", "¡YA!")
		task.wait(0.5)

		local roundEnd = math.min(os.clock() + s.SubRoundTime, deadline)
		local winner, decided = nil, false
		while not roundOver do
			local aliveA, membersA = aliveCount(a)
			local aliveB, membersB = aliveCount(b)
			ReplicatedStorage:SetAttribute("AliveA", aliveA)
			ReplicatedStorage:SetAttribute("AliveB", aliveB)
			ReplicatedStorage:SetAttribute("TimeLeft", math.max(0, math.ceil(roundEnd - os.clock())))
			local contest = membersA > 0 and membersB > 0
			-- Solo hay ronda si los dos equipos tienen a alguien
			if contest and (aliveA == 0 or aliveB == 0) then
				winner = (aliveA > 0 and a) or (aliveB > 0 and b) or nil
				decided = true
				break
			end
			if os.clock() >= roundEnd then
				-- Se acaba el tiempo: gana el equipo con más supervivientes (sin rival no gana nadie)
				winner = contest and ((aliveA > aliveB and a) or (aliveB > aliveA and b)) or nil
				decided = true
				break
			end
			task.wait(0.25)
		end
		if decided then
			if winner then
				addScore(winner, 1)
				Remotes.Notify:FireAllClients("Big", "¡RONDA PARA " .. string.upper(winner.Name) .. "!")
			else
				Remotes.Notify:FireAllClients("Big", "RONDA EMPATADA")
			end
			task.wait(3)
		end
	end
	clearElimination()
	-- Nadie se queda muerto durante la pantalla final
	respawnAll()
end

local function endRound()
	-- El líder se calcula antes de cambiar de estado (al cambiar, los bots se quitan)
	local leader, leaderScore = updateLeader()
	setState("Ended")
	local teamMode = isTeamMode()
	local a, b = teams[1], teams[2]
	local scoreA, scoreB = getScore(a.Name), getScore(b.Name)
	local winner = nil
	if teamMode then
		if scoreA > scoreB then
			winner = a
		elseif scoreB > scoreA then
			winner = b
		end
	end

	-- MVP = más bajas (en CTF cada captura cuenta como 3 bajas)
	local mvp, mvpKills, mvpScore = nil, 0, -1
	for _, player in Players:GetPlayers() do
		local kills = PlayerData.GetLeaderstats(player).Bajas.Value
		local score = kills + (player:GetAttribute("Captures") or 0) * 3
		if score > mvpScore then
			mvp, mvpKills, mvpScore = player, kills, score
		end
	end

	-- Contra bots (menos de 2 jugadores de verdad) la victoria da menos premio y no cuenta para
	-- la clasificación global de victorias
	local humans = 0
	for _, player in Players:GetPlayers() do
		local stats = PlayerData.GetLeaderstats(player)
		-- Ha jugado: está fuera del menú o tiene alguna baja o muerte en esta partida
		if not player:GetAttribute("InMenu") or stats.Bajas.Value + stats.Muertes.Value > 0 then
			humans += 1
		end
	end
	local soloMatch = humans < 2
	-- Por equipos, si todos los jugadores de verdad están en el mismo equipo, es contra bots
	-- (para el rango: dos amigos juntos contra bots no suben como en una partida de verdad)
	local botsOnly = soloMatch
	if teamMode and not soloMatch then
		local humansA, humansB = 0, 0
		for _, player in Players:GetPlayers() do
			if player:GetAttribute("MatchJoinedAt") then
				if player.Team == a then
					humansA += 1
				elseif player.Team == b then
					humansB += 1
				end
			end
		end
		botsOnly = humansA == 0 or humansB == 0
	end
	-- Rango: solo para quien ha jugado de verdad (lleva un rato en la partida, ha tenido bajas o
	-- muertes, o ha jugado alguna ronda de Eliminación). También si ha vuelto al menú (no se esquiva
	-- la derrota así). Empate (por equipos, o nadie puntúa en todos contra todos) = sin cambios.
	local now = workspace:GetServerTimeNow()
	local elim = currentMode == "ELIM"
	for _, player in Players:GetPlayers() do
		local joined = player:GetAttribute("MatchJoinedAt")
		local stats = PlayerData.GetLeaderstats(player)
		local active = stats.Bajas.Value + stats.Muertes.Value > 0
		local played = joined ~= nil
			and (active or (if elim then player:GetAttribute("ElimPlayed") == true else now - joined >= 60))
		if played then
			PlayerData.Increment(player, "Matches", 1)
			local won
			if teamMode then
				won = wonTeam(player, winner)
			else
				won = leader == player and leaderScore > 0
			end
			local draw = (teamMode and winner == nil) or (not teamMode and leaderScore <= 0)
			local result = won and "Win" or (draw and "Draw" or "Loss")
			PlayerData.AddRankPoints(player, Ranks.Delta(result, not teamMode, botsOnly, mvp == player and mvpScore > 0))
		end
	end
	local winScale = soloMatch and GameConfig.Bots.RewardScale or 1

	-- Premios solo para quien ha jugado (no para quien sigue en la pantalla de inicio)
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("InMenu") then
			continue
		end
		local won
		if teamMode then
			won = wonTeam(player, winner)
		else
			won = leader == player and leaderScore > 0
		end
		if won then
			PlayerData.AddXP(player, math.floor(GameConfig.XP.Win * winScale), "Victoria")
			PlayerData.AddCoins(player, math.floor(GameConfig.Coins.Win * winScale))
			-- Racha de victorias (en esta sesión): cada victoria seguida da un poco más
			local winStreak = (player:GetAttribute("WinStreak") or 0) + 1
			player:SetAttribute("WinStreak", winStreak)
			local extra = math.floor((GameConfig.Coins.WinStreak or 0) * math.min(winStreak - 1, GameConfig.Coins.WinStreakMax or 5) * winScale)
			if extra > 0 then
				local given = PlayerData.AddCoins(player, extra)
				Remotes.Notify:FireClient(player, "Challenge", "🔥 ¡" .. winStreak .. " victorias seguidas!  +" .. given .. " 🪙")
			end
			if not soloMatch then
				PlayerData.Increment(player, "Wins", 1)
			end
			PlayerData.Track(player, "Win", 1)
			if currentMode == "INF" and winner == teams[1] then
				PlayerData.Track(player, "Survive", 1)
			end
		else
			player:SetAttribute("WinStreak", 0)
			PlayerData.AddXP(player, GameConfig.XP.Loss, "Partida completada")
		end
		PlayerData.Track(player, "Match", 1)
	end

	Remotes.RoundEnd:FireAllClients({
		TeamMode = teamMode,
		Winner = if teamMode then (winner and winner.Name) else (leader and leader.Name),
		WinnerColor = winner and winner.TeamColor.Color or Color3.fromRGB(255, 200, 60),
		ScoreA = scoreA,
		ScoreB = scoreB,
		LeaderScore = leaderScore,
		MVP = mvp and mvp.Name or nil,
		MVPKills = mvpKills,
		MVPCaptures = mvp and mvp:GetAttribute("Captures") or 0,
	})
	-- Resumen personal: lo ganado en esta partida (el cliente lo anima: barra de nivel, monedas...)
	for _, player in Players:GetPlayers() do
		local summary = not player:GetAttribute("InMenu") and PlayerData.MatchSummary(player)
		if summary then
			local stats = PlayerData.GetLeaderstats(player)
			summary.Kills = stats.Bajas.Value
			summary.Deaths = stats.Muertes.Value
			summary.BestStreak = player:GetAttribute("BestStreak") or 0
			summary.Captures = player:GetAttribute("Captures") or 0
			summary.WinStreak = player:GetAttribute("WinStreak") or 0
			Remotes.MatchSummary:FireClient(player, summary)
		end
	end
	task.wait(GameConfig.EndScreenTime)
end

local function startMode(mode)
	currentMode = mode
	local s = settings(mode)
	local scoreToWin = s.ScoreToWin
	if mode == "GUN" then
		scoreToWin = #Weapons.GunGameOrder
	end
	ReplicatedStorage:SetAttribute("Mode", mode)
	ReplicatedStorage:SetAttribute("ModeName", s.Name)
	ReplicatedStorage:SetAttribute("TeamMode", s.Teams ~= false)
	ReplicatedStorage:SetAttribute("ScoreToWin", scoreToWin)
	-- (antes de empezar: así los bots que entran al empezar ya son supervivientes)
	ReplicatedStorage:SetAttribute("Infection", if mode == "INF" then "Prep" else nil)
	if mode == "GUN" then
		Loadout.Override = gunGameWeapons
	elseif mode == "INF" then
		Loadout.Override = infectionLoadout
	else
		Loadout.Override = nil
	end
end

-- Una ronda completa: descanso con votación, partida y pantalla final
local function playRound()
	do
		-- Descanso con votación
		setState("Intermission")
		table.clear(votes)
		voteOptions = makeVoteOptions()
		publishVotes()
		countdown(GameConfig.IntermissionTime)
		while #Players:GetPlayers() < GameConfig.MinPlayers do
			ReplicatedStorage:SetAttribute("TimeLeft", 0)
			task.wait(1)
		end

		-- Resultado de la votación (empate = al azar entre los empatados)
		local counts = publishVotes()
		local bestCount = -1
		local ties = {}
		for i = 1, #voteOptions do
			local c = counts[i] or 0
			if c > bestCount then
				bestCount = c
				ties = { i }
			elseif c == bestCount then
				table.insert(ties, i)
			end
		end
		local choice = voteOptions[ties[math.random(1, #ties)]]
		clearVotes()

		local mode = choice.Mode
		-- Comprueba que el mapa soporta el modo
		if choice.Map ~= "Custom" and choice.Map ~= MapBuilder.Current then
			Remotes.Notify:FireAllClients("Big", "Cargando " .. MapBuilder.Get(choice.Map).Name .. "...")
			Flags.Stop()
			Hardpoint.Stop()
			MapBuilder.Build(choice.Map)
		end
		if mode == "CTF" and not Flags.IsAvailable() then
			mode = "TDM"
		elseif mode == "KOTH" and not Hardpoint.IsAvailable() then
			mode = "TDM"
		end
		startMode(mode)

		roundOver = false
		balanceTeams()
		resetStats()
		setState("Playing")
		if mode == "CTF" then
			Flags.Start()
		elseif mode == "KOTH" then
			Hardpoint.Start()
		end
		if mode ~= "ELIM" then
			respawnAll() -- (Eliminación reaparece a todos al empezar cada ronda)
		end
		local s = settings(mode)
		local goal = ReplicatedStorage:GetAttribute("ScoreToWin")
		local intro = {
			TDM = "¡A LUCHAR! Primero a " .. goal .. " bajas",
			CTF = "¡CAPTURA LA BANDERA! Primero a " .. goal,
			KOTH = "¡ZONA DE CONTROL! Primero a " .. goal .. " puntos",
			FFA = "¡TODOS CONTRA TODOS! Primero a " .. goal .. " bajas",
			GUN = "¡ESCALADA DE ARMAS! Una baja con cada arma",
			ELIM = "¡ELIMINACIÓN! Una vida por ronda · primero a " .. goal .. " rondas",
			INF = "🧟 ¡INFECCIÓN! Escóndete y prepárate",
		}
		Remotes.Notify:FireAllClients("Big", intro[mode] or s.Name)
		if mode == "ELIM" then
			task.wait(2)
			eliminationRounds(s)
		elseif mode == "INF" then
			infectionRound(s)
		else
			countdown(s.RoundTime, function()
				return roundOver
			end)
		end
		Flags.Stop()
		Hardpoint.Stop()
		Loadout.Override = nil
		if mode == "INF" then
			clearInfection()
			-- Fuera de la Infección todos vuelven a ser normales (los zombis reaparecen)
			respawnAll()
		end
		if mode == "GUN" then
			-- Fuera de la Escalada cada uno recupera sus armas
			for _, player in Players:GetPlayers() do
				Loadout.GiveDefault(player)
			end
		end
		endRound()
	end
end

local function gameLoop()
	while true do
		-- Si algo falla en una ronda, el servidor no se queda colgado: se limpia y empieza otra
		local ok, err = xpcall(playRound, debug.traceback)
		if not ok then
			warn("[Round] Error en la ronda, se reinicia:", err)
			pcall(Flags.Stop)
			pcall(Hardpoint.Stop)
			clearElimination()
			clearInfection()
			pcall(respawnAll)
			Loadout.Override = nil
			roundOver = true
			task.wait(3)
		end
	end
end

function Round.Init()
	Players.RespawnTime = GameConfig.RespawnTime
	setupTeams()
	startMode("TDM")
	setState("Intermission")
	ReplicatedStorage:SetAttribute("TimeLeft", GameConfig.IntermissionTime)
	Flags.OnCapture = function(_, team)
		addScore(team, 1)
	end
	Hardpoint.OnScore = function(team, amount)
		addScore(team, amount)
	end

	Remotes.VoteMap.OnServerEvent:Connect(function(player, index)
		if ReplicatedStorage:GetAttribute("State") ~= "Intermission" then
			return
		end
		if type(index) ~= "number" or not voteOptions[index] then
			return
		end
		votes[player] = index
		publishVotes()
	end)

	local function onPlayer(player)
		assignTeam(player)
		player.CharacterAdded:Connect(function(character)
			task.spawn(function()
				-- Revivir instantáneo: aparece donde murió; si no, punto normal (FFA)
				if not Respawn.ApplyRevive(player, character) then
					ffaSpawnFor(player, character)
				end
				if ReplicatedStorage:GetAttribute("Infection") == "On" and player.Team == teams[2] then
					zombify(player, character)
				end
			end)
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	Players.PlayerRemoving:Connect(function(player)
		votes[player] = nil
		updateLeader(player)
	end)
	for _, player in Players:GetPlayers() do
		if not player.Team then
			onPlayer(player)
			Respawn.Load(player)
		end
	end

	task.spawn(gameLoop)
end

return Round
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Zombie</string>
            <string name="Source"><![CDATA[-- Aspecto y vida de los zombis del modo Infección (jugadores y bots): piel verde, ojos rojos
-- brillantes y más vida. Las garras y la velocidad vienen del arma (Weapons.Claws).
local Zombie = {}

Zombie.Skin = Color3.fromRGB(110, 165, 80)
local EYE = Color3.fromRGB(255, 40, 30)
local SKIN_PARTS = {
	"Head",
	"LeftHand",
	"RightHand",
	"LeftLowerArm",
	"RightLowerArm",
	"LeftUpperArm",
	"RightUpperArm",
	"Left Arm",
	"Right Arm",
}

local function eye(head, x)
	local part = Instance.new("Part")
	part.Name = "ZombieEye"
	part.Size = Vector3.new(0.2, 0.12, 0.05)
	part.Color = EYE
	part.Material = Enum.Material.Neon
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
	part.CFrame = head.CFrame * CFrame.new(x * head.Size.X, head.Size.Y * 0.12, -head.Size.Z * 0.5)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = part
	weld.Parent = part
	part.Parent = head
end

-- Pinta al personaje de zombi y le da la vida indicada
function Zombie.Apply(character, health)
	character:SetAttribute("Zombie", true)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and health then
		humanoid.MaxHealth = health
		humanoid.Health = health
	end
	local bodyColors = character:FindFirstChildOfClass("BodyColors")
	if bodyColors then
		bodyColors.HeadColor3 = Zombie.Skin
		bodyColors.LeftArmColor3 = Zombie.Skin
		bodyColors.RightArmColor3 = Zombie.Skin
	end
	for _, name in SKIN_PARTS do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			part.Color = Zombie.Skin
		end
	end
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") and not head:FindFirstChild("ZombieEye") then
		eye(head, -0.17)
		eye(head, 0.17)
	end
end

return Zombie
]]></string>
