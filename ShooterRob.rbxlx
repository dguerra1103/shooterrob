-- Revólver de cañón largo con cachas de madera
function Classic.HandCannon(pt)
	local o = { Aim = pt.AimPoint, Right = pt.RightHand, Muzzle = pt.Muzzle }
	local p = { B("Handle", 0, 0, 0, 0.18, 0.18, 0.18, "Body") }
	bevel(p, "Frame", 0, 0.04, 0.1, 0.24, 0.38, 0.62, "Body", 0.05)
	table.insert(p, C("Cylinder", 0, 0.02, -0.06, 0.4, 0.46, "Body"))
	for i = 0, 5 do
		local a = rad(i * 60)
		table.insert(p, C("CylinderFlute", math.sin(a) * 0.2, 0.02 + math.cos(a) * 0.2, -0.06, 0.3, 0.08, "Dark"))
	end
	bevel(p, "Barrel", 0, 0.08, -0.82, 0.18, 0.22, 1.1, "Body", 0.04)
	table.insert(p, B("TopRib", 0, 0.205, -0.82, 0.09, 0.05, 1.1, "Body"))
	table.insert(p, C("EjectorHousing", 0, -0.08, -0.62, 0.7, 0.1, "Body"))
	table.insert(p, C("Bore", 0, o.Muzzle.Y, o.Muzzle.Z + 0.02, 0.04, 0.12, "Dark"))
	table.insert(p, B("Hammer", 0, 0.17, 0.4, 0.07, 0.12, 0.1, "Metal", -25, 0, 0))
	triggerGroup(p, -0.15, o.Right.Z - 0.32)
	pistolGrip(p, o.Right, "Panel", V(0.22, 0.6, 0.3), 22)
	for _, s in { -1, 1 } do
		table.insert(p, B("RearSightPost", s * 0.055, o.Aim.Y - 0.02, 0.3, 0.04, 0.08, 0.05, "Dark"))
	end
	table.insert(p, B("FrontSightPost", 0, (0.23 + o.Aim.Y - 0.04) / 2, -1.3, 0.04, o.Aim.Y - 0.04 - 0.23, 0.08, "Dark"))
	table.insert(p, B("FrontSightBead", 0, o.Aim.Y - 0.02, -1.3, 0.03, 0.05, 0.06, "Accent"))
	return p
end

-- Marcadora de paintball: cuerpo de color, depósito de bolas arriba a la izquierda (deja libre la
-- línea de mira), cañón largo con bandas, botella de aire detrás y empuñadura delantera
function Classic.SplatX(pt)
	local o = { Aim = pt.AimPoint, Right = pt.RightHand, Left = pt.LeftHand, Muzzle = pt.Muzzle }
	local y = o.Muzzle.Y
	local p = { B("Handle", 0, 0, 0, 0.2, 0.2, 0.2, "Body") }
	bevel(p, "Body", 0, 0.05, 0.05, 0.26, 0.34, 0.9, "Body", 0.06)
	table.insert(p, B("BodyStripe", 0, 0.05, 0.05, 0.27, 0.06, 0.92, "Accent"))
	table.insert(p, C("Barrel", 0, y, (o.Muzzle.Z - 0.4) / 2, -o.Muzzle.Z - 0.4, 0.13, "Dark"))
	for i = 0, 2 do
		table.insert(p, C("BarrelBand", 0, y, -0.65 - i * 0.28, 0.06, 0.16, "Panel"))
	end
	table.insert(p, C("BarrelTip", 0, y, o.Muzzle.Z + 0.06, 0.12, 0.17, "Accent"))
	-- Depósito de bolas con cuello inclinado y bolas asomando
	-- (más a la izquierda y más bajo para no tapar media pantalla al apuntar)
	table.insert(p, B("FeedNeck", -0.24, 0.27, -0.1, 0.1, 0.3, 0.12, "Dark", 0, 0, 50))
	table.insert(p, Ball("Hopper", -0.46, 0.4, -0.1, 0.46, "Accent2"))
	table.insert(p, CY("HopperRing", -0.46, 0.4, -0.1, 0.08, 0.48, "Dark"))
	table.insert(p, CY("HopperLid", -0.46, 0.61, -0.1, 0.06, 0.28, "Dark"))
	-- Bolas de pintura asomando por arriba
	for i, off in { V(-0.07, 0, 0.06), V(0.07, 0.01, -0.03), V(-0.01, 0.03, -0.09) } do
		table.insert(p, Ball("PaintBall" .. i, -0.46 + off.X, 0.68 + off.Y, -0.1 + off.Z, 0.12, "Accent"))
	end
	-- Botella de aire detrás (hace de culata)
	table.insert(p, C("AirTank", 0, -0.02, 0.85, 0.66, 0.26, "Panel"))
	table.insert(p, C("AirTankCap", 0, -0.02, 1.2, 0.06, 0.2, "Metal"))
	table.insert(p, C("Regulator", 0, -0.02, 0.5, 0.12, 0.18, "Metal"))
	triggerGroup(p, -0.12, o.Right.Z - 0.3)
	pistolGrip(p, o.Right, "Rubber")
	-- Empuñadura delantera
	bevelY(p, "Foregrip", 0, (-0.12 + o.Left.Y - 0.1) / 2, o.Left.Z, 0.15, -0.12 - (o.Left.Y - 0.1), 0.17, "Rubber")
	table.insert(p, B("ForegripMount", 0, -0.08, o.Left.Z, 0.12, 0.1, 0.3, "Dark"))
	ironSights(p, o.Aim, 0.3, -1.25, y + 0.065)
	return p
end

-- Katana: mango largo con cinta, tsuba redonda y hoja larga con una leve curva (hacia -Z)
function Classic.Katana(_pt)
	local p = { B("Handle", 0, 0, 0.1, 0.16, 0.2, 0.9, "Rubber") }
	for i = 0, 4 do
		table.insert(p, B("Wrap" .. i, 0, 0, 0.42 - i * 0.16, 0.17, 0.21, 0.05, "Panel", 0, 0, 45))
	end
	table.insert(p, B("Pommel", 0, 0, 0.58, 0.18, 0.22, 0.06, "Dark"))
	table.insert(p, C("Tsuba", 0, 0, -0.38, 0.06, 0.46, "Dark"))
	table.insert(p, B("Habaki", 0, 0.01, -0.45, 0.08, 0.2, 0.1, "Metal"))
	-- Hoja de acero claro (Accent) y filo metálico
	table.insert(p, B("Blade", 0, 0.02, -1.3, 0.05, 0.2, 1.7, "Accent"))
	table.insert(p, B("BladeTip", 0, 0.07, -2.38, 0.05, 0.18, 0.5, "Accent", 8, 0, 0))
	table.insert(p, B("Point", 0, 0.12, -2.68, 0.05, 0.1, 0.18, "Accent", 30, 0, 0))
	table.insert(p, B("Edge", 0, -0.06, -1.3, 0.055, 0.04, 1.66, "Metal"))
	return p
end

-- Martillo de juguete (de los que pitan): mango de rayas y cabeza grande de colores
function Classic.ToyHammer(_pt)
	local p = { B("Handle", 0, 0, 0.0, 0.18, 0.18, 1.0, "Panel") }
	for i = 0, 2 do
		table.insert(p, C("HandleStripe" .. i, 0, 0, 0.3 - i * 0.3, 0.1, 0.2, "Accent2"))
	end
	table.insert(p, C("Grip", 0, 0, 0.45, 0.3, 0.22, "Rubber"))
	table.insert(p, CX("Head", 0, 0, -0.75, 1.0, 0.62, "Body"))
	for _, x in { -0.52, 0.52 } do
		table.insert(p, CX("HeadCap", x, 0, -0.75, 0.08, 0.66, "Accent"))
	end
	table.insert(p, CX("HeadBand", 0, 0, -0.75, 0.16, 0.64, "Accent2"))
	return p
end

-- Garras de zombi (modo Infección): mano verde con tres uñas de hueso largas y curvas
function Classic.Claws(_pt)
	local p = {
		B("Handle", 0, 0, 0.15, 0.34, 0.26, 0.5, "Body"),
		B("Wrist", 0, -0.02, 0.48, 0.3, 0.24, 0.2, "Dark"),
		B("Knuckles", 0, 0.06, -0.12, 0.4, 0.2, 0.16, "Body"),
	}
	for i, x in { -0.13, 0, 0.13 } do
		local spread = (i - 2) * 6
		table.insert(p, B("ClawBase" .. i, x, 0.06, -0.38, 0.07, 0.09, 0.4, "Accent", -6, spread, 0))
		table.insert(p, B("ClawTip" .. i, x * 1.25, 0.0, -0.72, 0.05, 0.07, 0.34, "Accent", -22, spread, 0))
		table.insert(p, B("Blood" .. i, x * 1.3, -0.04, -0.86, 0.055, 0.06, 0.1, "Accent2", -22, spread, 0))
	end
	return p
end

-- Puntos que cambian respecto al diseño original (el lanzacohetes se coge por el tubo, no por el cohete)
Classic.Points = {
	NovaLauncher = { LeftHand = V(0, -0.4, -0.7) },
}

return Classic
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">WeaponModels</string>
          <string name="Source"><![CDATA[-- Construye los modelos de las armas a partir de las piezas de WeaponDesigns.
-- Lo usan el servidor (Tool que ven los demás) y el cliente (viewmodel e iconos 3D).
--
-- Colores: con la skin "Default" cada arma usa su propia paleta de fábrica (def.Palette);
-- con cualquier otra skin, todas las armas usan los colores de esa skin.
local Weapons = require(script.Parent.Weapons)
local Skins = require(script.Parent.Skins)

local WeaponModels = {}

-- Texturas de partículas que vienen incluidas con Roblox
local SPARKLE_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE_TEXTURE = "rbxasset://textures/particles/fire_main.dds"

local WHITE = Color3.new(1, 1, 1)

-- Paleta efectiva para un arma y una skin
function WeaponModels.GetPalette(weaponName, skinId)
	local def = Weapons.Get(weaponName)
	if (skinId == nil or skinId == "Default") and def and def.Palette then
		return def.Palette
	end
	return Skins.Get(skinId)
end

-- Camuflaje con imagen: solo si su MaterialVariant existe (si no, se usan los colores de respaldo)
local MaterialService = game:GetService("MaterialService")
local function camoVariant(pal)
	if not pal.Camo then
		return nil
	end
	local name = "Camo" .. pal.Camo
	return MaterialService:FindFirstChild(name) and name or nil
end

-- Skins arcoíris (pal.Rainbow = { Accent = true, ... }): las piezas de esos papeles llevan la etiqueta
-- "RainbowSkin" y el cliente (SkinFX) les va cambiando el color. Las etiquetas se replican.
local rainbowPhase = 0
local function setRainbow(part, role, pal)
	if pal.Rainbow and pal.Rainbow[role or "Body"] then
		rainbowPhase = (rainbowPhase + 0.09) % 1
		part:SetAttribute("RainbowPhase", rainbowPhase)
		part:SetAttribute("RainbowSat", pal.RainbowSat or 1)
		part:SetAttribute("RainbowVal", pal.RainbowVal or 1)
		part:AddTag("RainbowSkin")
	elseif part:HasTag("RainbowSkin") then
		part:RemoveTag("RainbowSkin")
	end
end

local function paint(part, role, pal)
	setRainbow(part, role, pal)
	part.Transparency = 0
	part.Reflectance = 0
	part.MaterialVariant = ""
	if role == "Accent" then
		part.Color = pal.Accent
		part.Material = pal.AccentMaterial or Enum.Material.Neon
	elseif role == "Accent2" then
		part.Color = pal.Accent2 or pal.Accent
		part.Material = pal.Accent2Material or Enum.Material.Neon
	elseif role == "Panel" then
		part.Color = pal.Panel or (pal.Accent2 or pal.Body:Lerp(WHITE, 0.6))
		part.Material = pal.PanelMaterial or Enum.Material.Plastic
	elseif role == "Dark" then
		part.Color = pal.Dark
		part.Material = Enum.Material.Metal
	elseif role == "Metal" then
		part.Color = Color3.fromRGB(200, 202, 210)
		part.Material = Enum.Material.Metal
		part.Reflectance = 0.15
	elseif role == "Rubber" then
		part.Color = pal.Rubber or Color3.fromRGB(28, 28, 32)
		part.Material = Enum.Material.Rubber -- empuñaduras y culatas de goma
	elseif role == "Gold" then
		part.Color = Color3.fromRGB(240, 180, 60)
		part.Material = Enum.Material.Foil
	elseif role == "Shell" then
		part.Color = Color3.fromRGB(200, 30, 35)
		part.Material = Enum.Material.SmoothPlastic
	elseif role == "Core" then
		part.Color = (pal.Accent2 or pal.Accent):Lerp(pal.Accent, 0.5)
		part.Material = Enum.Material.Neon
		part.Transparency = 0.15
	elseif role == "Reticle" then
		-- Punto rojo de las miras: siempre brilla
		part.Color = Color3.fromRGB(255, 40, 40)
		part.Material = Enum.Material.Neon
	elseif role == "Lens" then
		part.Color = pal.Lens or pal.Accent:Lerp(WHITE, 0.35)
		part.Material = Enum.Material.Glass
		part.Transparency = 0.45
		part.Reflectance = 0.3
	else
		part.Color = pal.Body
		-- Polímero con textura fina (el plástico liso parecía de juguete)
		part.Material = pal.BodyMaterial or Enum.Material.Plastic
	end
	-- Cuerpo y paneles con la imagen del camuflaje (el color blanco no la tiñe)
	if role == "Body" or role == "Panel" or role == nil then
		local variant = camoVariant(pal)
		if variant then
			part.Material = Enum.Material.Plastic
			part.MaterialVariant = variant
			part.Color = role == "Panel" and Color3.fromRGB(205, 205, 205) or WHITE
		end
	end
end

-- Partículas de la skin (destellos o llamas) alrededor del arma
local function applyEffects(container, pal)
	for _, inst in container:GetDescendants() do
		if inst:IsA("ParticleEmitter") and inst.Name == "SkinFX" then
			inst:Destroy()
		end
	end
	local handle = container:FindFirstChild("Handle")
	if not handle or not pal.Effect then
		return
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "SkinFX"
	emitter.LockedToPart = true
	emitter.LightEmission = 1
	emitter.SpreadAngle = Vector2.new(180, 180)
	if pal.Effect == "Flame" then
		emitter.Texture = FIRE_TEXTURE
		emitter.Color = ColorSequence.new(pal.Accent, pal.Accent2 or pal.Accent)
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0) })
		emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
		emitter.Lifetime = NumberRange.new(0.25, 0.45)
		emitter.Speed = NumberRange.new(0.3, 0.8)
		emitter.Acceleration = Vector3.new(0, 2.5, 0)
		emitter.Rate = 14
	else
		emitter.Texture = SPARKLE_TEXTURE
		emitter.Color = ColorSequence.new(pal.Accent, pal.Accent2 or WHITE)
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.3, 0.16),
			NumberSequenceKeypoint.new(1, 0),
		})
		emitter.Lifetime = NumberRange.new(0.4, 0.8)
		emitter.Speed = NumberRange.new(0.1, 0.4)
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.RotSpeed = NumberRange.new(-90, 90)
		emitter.Rate = 7
	end
	emitter.Parent = handle
end

-- Texto (nombre del arma) en los dos costados de una pieza
local function addLabel(part, text, pal)
	for _, face in { Enum.NormalId.Right, Enum.NormalId.Left } do
		local gui = Instance.new("SurfaceGui")
		gui.Name = "Label"
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 300
		gui.LightInfluence = 0.3
		gui.Parent = part
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.Text = text
		label.TextColor3 = Color3.fromRGB(240, 240, 245)
		label.TextStrokeTransparency = 0.6
		label.Parent = gui
	end
end

-- Pinta todas las piezas de un arma (Model o Tool) con la skin indicada.
function WeaponModels.ApplySkin(container, skinId, weaponName)
	weaponName = weaponName or container:GetAttribute("Weapon") or container.Name
	local pal = WeaponModels.GetPalette(weaponName, skinId)
	for _, part in container:GetDescendants() do
		if part:IsA("BasePart") then
			local role = part:GetAttribute("Role")
			if role then
				paint(part, role, pal)
			end
		end
	end
	applyEffects(container, pal)
end

-- Devuelve un Model con PrimaryPart = Handle. Las piezas van soldadas al Handle.
-- withEffects = false para no añadir partículas (por ejemplo en iconos).
function WeaponModels.Build(weaponName, skinId, withEffects)
	local def = Weapons.Get(weaponName)
	assert(def, "Arma desconocida: " .. tostring(weaponName))
	local pal = WeaponModels.GetPalette(weaponName, skinId)

	local model = Instance.new("Model")
	model.Name = weaponName

	local handle
	local created = {}
	for _, spec in def.Parts do
		local part = Instance.new("Part")
		part.Name = spec.Name
		part.Size = spec.Size
		if spec.Shape == "Cylinder" then
			part.Shape = Enum.PartType.Cylinder
		elseif spec.Shape == "Ball" then
			part.Shape = Enum.PartType.Ball
		end
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.Massless = true
		part.CastShadow = false
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part:SetAttribute("Role", spec.Role)
		paint(part, spec.Role, pal)
		if spec.Text then
			addLabel(part, spec.Text, pal)
		end
		if spec.Name == "Handle" then
			handle = part
		end
		part.Parent = model
		table.insert(created, { Part = part, Spec = spec })
	end

	-- Coloca y suelda cada pieza al Handle (que está en el origen del diseño)
	for _, entry in created do
		entry.Part.CFrame = entry.Spec.CFrame
		if entry.Part ~= handle then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = entry.Part
			weld.Parent = entry.Part
		end
	end
	local function attach(name, position)
		local a = Instance.new("Attachment")
		a.Name = name
		a.Position = position
		a.Parent = handle
		return a
	end
	if def.Muzzle then
		attach("Muzzle", def.Muzzle)
	end
	if def.AimPoint then
		attach("AimPoint", def.AimPoint)
	end
	attach("Eject", def.Eject or Vector3.new(0.22, 0.08, 0))

	model:SetAttribute("Weapon", weaponName)
	model.PrimaryPart = handle
	if withEffects ~= false then
		applyEffects(model, pal)
	end
	return model
end

return WeaponModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Weapons</string>
          <string name="Source"><![CDATA[-- Arsenal: estadísticas, paleta de fábrica, desbloqueo y posiciones (manos, mira, cañón) de cada arma.
-- El modelo 3D de cada arma está en WeaponDesigns.
local Designs = require(script.Parent.WeaponDesigns)
local Classic = require(script.Parent.WeaponDesignsClassic)

local Weapons = {}

local rad = math.rad
local V = Vector3.new
local RGB = Color3.fromRGB

-- Paletas de fábrica (el aspecto "Default" de cada arma, como en el arte conceptual)
local Palettes = {
	Pulse = { Body = RGB(34, 36, 42), Panel = RGB(226, 229, 236), Accent = RGB(0, 140, 255), Accent2 = RGB(90, 210, 255), Dark = RGB(18, 18, 22) },
	Havoc = { Body = RGB(36, 32, 32), Panel = RGB(235, 50, 25), Accent = RGB(255, 85, 0), Accent2 = RGB(255, 150, 20), Dark = RGB(20, 18, 18) },
	Specter = { Body = RGB(28, 28, 34), Panel = RGB(236, 236, 242), Accent = RGB(255, 40, 200), Accent2 = RGB(0, 220, 255), Dark = RGB(16, 16, 20) },
	Signal = { Body = RGB(24, 26, 30), Panel = RGB(232, 234, 240), Accent = RGB(0, 170, 255), Accent2 = RGB(120, 220, 255), Dark = RGB(14, 14, 18) },
	Volt = { Body = RGB(30, 30, 32), Panel = RGB(255, 190, 30), Accent = RGB(255, 210, 40), Accent2 = RGB(0, 220, 255), Dark = RGB(18, 18, 20) },
	Vortex = { Body = RGB(26, 28, 36), Panel = RGB(222, 226, 234), Accent = RGB(20, 120, 255), Accent2 = RGB(70, 200, 255), Dark = RGB(14, 15, 20) },
	Raptor = { Body = RGB(38, 42, 34), Panel = RGB(105, 135, 70), Accent = RGB(140, 255, 80), Accent2 = RGB(255, 255, 255), Dark = RGB(20, 22, 18) },
	Nova = { Body = RGB(40, 40, 46), Panel = RGB(255, 125, 20), Accent = RGB(255, 220, 0), Accent2 = RGB(0, 220, 255), Dark = RGB(18, 18, 22) },
	Viper = { Body = RGB(30, 30, 34), Panel = RGB(220, 40, 45), Accent = RGB(255, 60, 60), Accent2 = RGB(255, 255, 255), Dark = RGB(16, 16, 18) },
	Gold = { Body = RGB(30, 26, 24), Panel = RGB(235, 175, 50), Accent = RGB(255, 200, 60), Accent2 = RGB(255, 255, 255), Dark = RGB(20, 18, 16), PanelMaterial = Enum.Material.Foil },
	Grind = { Body = RGB(38, 36, 32), Panel = RGB(170, 165, 152), Accent = RGB(255, 180, 0), Accent2 = RGB(255, 205, 30), Dark = RGB(18, 17, 15), PanelMaterial = Enum.Material.Metal },
	Tempest = { Body = RGB(36, 32, 32), Panel = RGB(205, 30, 28), Accent = RGB(255, 90, 0), Accent2 = RGB(255, 200, 70), Dark = RGB(18, 16, 16) },
	Drift = { Body = RGB(30, 26, 36), Panel = RGB(238, 234, 242), Accent = RGB(255, 40, 220), Accent2 = RGB(0, 200, 255), Dark = RGB(16, 14, 20) },
	Breach = { Body = RGB(34, 32, 34), Panel = RGB(150, 148, 150), Accent = RGB(255, 70, 10), Accent2 = RGB(255, 170, 40), Dark = RGB(22, 20, 22), PanelMaterial = Enum.Material.Metal },
	Ghost = { Body = RGB(26, 28, 26), Panel = RGB(228, 230, 226), Accent = RGB(70, 255, 40), Accent2 = RGB(180, 255, 120), Dark = RGB(14, 16, 14) },
	Phantom = { Body = RGB(30, 28, 38), Panel = RGB(232, 230, 240), Accent = RGB(160, 70, 255), Accent2 = RGB(50, 140, 255), Dark = RGB(16, 14, 22) },
	Fang = { Body = RGB(30, 30, 36), Panel = RGB(230, 232, 238), Accent = RGB(0, 220, 255), Accent2 = RGB(255, 255, 255), Dark = RGB(60, 64, 72) },
}
Weapons.Palettes = Palettes

Weapons.List = {
	ARX27 = {
		DisplayName = "ARX-27 Pulse",
		Category = "Fusil de asalto",
		Description = "Fiable a cualquier distancia. El arma de todo operador.",
		Slot = 1,
		Type = "Gun",
		Palette = Palettes.Pulse,
		Parts = Designs.ARX27(),
		UnlockLevel = 1,
		Damage = 24,
		MinDamage = 16,
		FalloffStart = 120,
		FalloffEnd = 350,
		HeadshotMultiplier = 1.6,
		FireRate = 10,
		Automatic = true,
		MagSize = 30,
		ReserveAmmo = 150,
		ReloadTime = 1.9,
		Range = 600,
		Spread = 1.6,
		AimSpread = 0.25,
		Pellets = 1,
		Recoil = 0.8,
		AimFOV = 60,
		ViewOffset = CFrame.new(0.8, -0.85, -2.0),
		AimDistance = 1.0,
		RightHand = V(0, -0.48, 0.44),
		LeftHand = V(0, -0.26, -1.0),
		AimPoint = V(0, 0.62, 0.35),
		Muzzle = V(0, 0.06, -2.5),
	},

	HavocPump = {
		DisplayName = "Havoc Pump",
		Category = "Escopeta",
		Description = "Arrasa a corta distancia. Un disparo, una baja.",
		Slot = 1,
		Type = "Gun",
		Palette = Palettes.Havoc,
		Parts = Designs.HavocPump(),
		UnlockLevel = 1,
		Damage = 12,
		MinDamage = 3,
		FalloffStart = 25,
		FalloffEnd = 70,
		HeadshotMultiplier = 1.3,
		FireRate = 1.4,
		Automatic = false,
		MagSize = 6,
		ReserveAmmo = 36,
		ReloadTime = 2.4,
		Range = 160,
		Spread = 6,
		AimSpread = 4.5,
		Pellets = 8,
		Recoil = 4,
		AimFOV = 65,
		ViewOffset = CFrame.new(0.8, -0.85, -1.9),
		AimDistance = 1.0,
		RightHand = V(0, -0.48, 0.55),
		LeftHand = V(0, -0.38, -1.15),
		AimPoint = V(0, 0.43, 0.75),
		Muzzle = V(0, 0.12, -2.38),
	},

	Specter9 = {
		DisplayName = "Specter-9",
		Category = "Subfusil",
		Description = "Muévete rápido, golpea fuerte, desaparece.",
		Slot = 1,
		Type = "Gun",
		Palette = Palettes.Specter,
		Parts = Designs.Specter9(),
		UnlockLevel = 1,
		Damage = 18,
		MinDamage = 11,
		FalloffStart = 50,
		FalloffEnd = 160,
		HeadshotMultiplier = 1.4,
		FireRate = 14,
		Automatic = true,
		MagSize = 32,
		ReserveAmmo = 160,
		ReloadTime = 1.6,
		Range = 400,
		Spread = 2.2,
		AimSpread = 0.6,
		Pellets = 1,
		Recoil = 0.55,
		AimFOV = 65,
		WalkSpeedMultiplier = 1.08,
		ViewOffset = CFrame.new(0.75, -0.78, -1.7),
		AimDistance = 1.1,
		RightHand = V(0, -0.45, 0.32),
		LeftHand = V(0, -0.26, -0.65),
		AimPoint = V(0, 0.53, 0.45),
		Muzzle = V(0, 0, -1.52),
	},

	Signal7 = {
		DisplayName = "Signal-7",
		Category = "Francotirador",
		Description = "Un tiro a la cabeza desde el otro lado del mapa.",
		Slot = 1,
		Type = "Gun",
		Palette = Palettes.Signal,
		Parts = Designs.Signal7(),
		UnlockLevel = 3,
		Price = 500,
		Damage = 90,
		MinDamage = 90,
		FalloffStart = 2000,
		FalloffEnd = 2000,
		HeadshotMultiplier = 2,
		FireRate = 0.9,
		Automatic = false,
		MagSize = 5,
		ReserveAmmo = 25,
		ReloadTime = 2.8,
		Range = 2000,
		Spread = 6,
		AimSpread = 0,
		Pellets = 1,
		Recoil = 5,
		AimFOV = 20,
		Scope = true, -- muestra mira telescópica al apuntar
		ViewOffset = CFrame.new(0.8, -0.85, -2.2),
		AimDistance = 1.0,
		RightHand = V(0, -0.45, 0.62),
		LeftHand = V(0, -0.2, -1.4),
		AimPoint = V(0, 0.52, 1.0),
		Muzzle = V(0, 0.05, -3.78),
	},

	VortexBR = {
		DisplayName = "Vortex AR-9",
		Category = "Fusil de energía",
		Description = "Ráfagas de 3 disparos de energía. Letal a media distancia.",
		Slot = 1,
		Type = "Gun",
		Palette = Palettes.Vortex,
		Parts = Designs.VortexBR(),
		UnlockLevel = 4,
		Price = 750,
		Damage = 30,
		MinDamage = 20,
		FalloffStart = 100,
		FalloffEnd = 300,
		HeadshotMultiplier = 1.5,
		FireRate = 14, -- dentro de la ráfaga
		Burst = 3,
		BurstCooldown = 0.32,
		Automatic = false,
		MagSize = 24,
		ReserveAmmo = 120,
		ReloadTime = 2.0,
		Range = 600,
