-- Ballesta (estilo cazador de Halloween): lenta, sin cargador, mucho daño y mata de un tiro a la cabeza
do
	local crossbow = {
		DisplayName = "Ballesta",
		Category = "Ballesta",
		Description = "Un virote cada vez. A la cabeza, no perdona.",
		Slot = 1,
		Type = "Gun",
		Palette = {
			Body = RGB(120, 78, 45),
			BodyMaterial = Enum.Material.Wood,
			Panel = RGB(70, 72, 80),
			PanelMaterial = Enum.Material.Metal,
			Dark = RGB(30, 28, 30),
			Accent = RGB(220, 40, 45),
			Accent2 = RGB(230, 180, 60),
			Lens = RGB(70, 120, 175),
		},
		UnlockLevel = 9,
		Price = 2000,
		Damage = 85,
		MinDamage = 70,
		FalloffStart = 150,
		FalloffEnd = 400,
		HeadshotMultiplier = 2,
		FireRate = 1.1,
		Automatic = false,
		MagSize = 1,
		ReserveAmmo = 20,
		ReloadTime = 1.1,
		Range = 700,
		Spread = 1.2,
		AimSpread = 0.05,
		Pellets = 1,
		Recoil = 1.6,
		AimFOV = 50,
		ViewOffset = CFrame.new(0.8, -0.85, -1.9),
		AimDistance = 1.1,
		RightHand = V(0, -0.42, 0.4),
		LeftHand = V(0, -0.18, -0.9),
		AimPoint = V(0, 0.3, 0.4),
		Muzzle = V(0, 0.06, -1.6),
	}
	crossbow.Parts = Classic.Crossbow(crossbow)
	Weapons.List.Crossbow = crossbow
end

-- Armas que el jugador puede elegir
Weapons.Primaries = {
	"ARX27",
	"HavocPump",
	"Specter9",
	"Signal7",
	"VortexBR",
	"NovaDrift",
	"RaptorDMR",
	"BreachHammer",
	"TitanLMG",
	"GhostlineXR",
	"NovaLauncher",
	"Calabazooka",
	"SplatX",
	"Crossbow",
}
Weapons.Secondaries = { "Viper", "HandCannon", "PhantomSidewind" }
Weapons.Secondary = "Viper" -- secundaria por defecto
Weapons.Melee = "Knife" -- cuerpo a cuerpo por defecto (y el de la Escalada de armas)
Weapons.Melees = { "Knife", "ToyHammer", "Katana", "Scythe" } -- los que se pueden elegir

-- Orden del modo "Escalada de armas": cada baja te da la siguiente
Weapons.GunGameOrder = {
	"ARX27",
	"NovaDrift",
	"VortexBR",
	"Specter9",
	"BreachHammer",
	"TitanLMG",
	"RaptorDMR",
	"GhostlineXR",
	"Signal7",
	"NovaLauncher",
	"HavocPump",
	"PhantomSidewind",
	"HandCannon",
	"Viper",
	"Knife",
}

-- Nombres antiguos guardados en DataStore -> nombres nuevos
Weapons.Legacy = { Rifle = "ARX27", Shotgun = "HavocPump", Sniper = "Signal7", Pistol = "Viper" }

-- Granada de fragmentación (tecla G). No ocupa hueco: cada jugador tiene una que se recarga sola.
Weapons.Grenade = {
	DisplayName = "Granada",
	Type = "Grenade",
	Pellets = 1,
	Damage = 110,
	Explosive = { Radius = 16, Damage = 110, MinDamage = 25 },
	Cooldown = 15, -- segundos hasta tener otra
	Fuse = 2.2, -- segundos hasta explotar
	ThrowSpeed = 80,
}

-- Ataque aéreo (recompensa por racha de 5 bajas, ver Killstreaks)
Weapons.Airstrike = {
	DisplayName = "Ataque aéreo",
	Type = "Streak",
	Pellets = 1,
	Damage = 95,
	Explosive = { Radius = 13, Damage = 95, MinDamage = 30 },
}

-- Estilo de las armas: "Clasico" (siluetas reales, madera y metal, como los shooters más jugados de
-- Roblox) o "SciFi" (el concept pack original con neón). Las skins de la tienda siguen poniendo neón.
Weapons.Style = "Clasico"

local MAT = Enum.Material
-- Sheen / DarkSheen: brillo (Reflectance) del cuerpo y de las piezas de metal oscuro; TrimAccent: los
-- ribetes llevan el color de acento también con el acabado de fábrica. Las skins no los usan.
local CLASSIC_PALETTES = {
	-- Polímero negro azulado con muebles color arena y ribetes naranjas
	Black = { Sheen = 0.02, DarkSheen = 0.1, TrimAccent = true, Body = RGB(40, 42, 46), Panel = RGB(190, 156, 106), Dark = RGB(26, 27, 31), Accent = RGB(255, 140, 40), Accent2 = RGB(120, 84, 50), Lens = RGB(70, 120, 175), AccentMaterial = MAT.SmoothPlastic, Accent2Material = MAT.Wood },
	-- Metal pavonado y madera
	Wood = { Sheen = 0.04, DarkSheen = 0.1, BodyMaterial = MAT.Metal, Body = RGB(50, 52, 56), Panel = RGB(140, 84, 44), Dark = RGB(30, 30, 33), Accent = RGB(255, 140, 40), Accent2 = RGB(122, 78, 44), Lens = RGB(70, 120, 175), AccentMaterial = MAT.SmoothPlastic, PanelMaterial = MAT.Wood, Accent2Material = MAT.Wood },
	-- Color arena (desierto)
	Tan = { Sheen = 0.02, DarkSheen = 0.1, TrimAccent = true, Body = RGB(196, 164, 112), Panel = RGB(40, 41, 46), Dark = RGB(32, 32, 34), Accent = RGB(255, 140, 40), Accent2 = RGB(120, 84, 50), Lens = RGB(70, 120, 175), AccentMaterial = MAT.SmoothPlastic, Accent2Material = MAT.Wood },
	-- Verde oliva militar
	Olive = { Sheen = 0.02, DarkSheen = 0.1, TrimAccent = true, Body = RGB(74, 88, 52), Panel = RGB(112, 124, 78), Dark = RGB(32, 33, 30), Accent = RGB(255, 140, 40), Accent2 = RGB(128, 84, 48), Lens = RGB(70, 120, 175), AccentMaterial = MAT.SmoothPlastic, Accent2Material = MAT.Wood },
	-- Acero inoxidable y cachas de madera
	Steel = { Sheen = 0.12, DarkSheen = 0.1, Body = RGB(186, 190, 198), Panel = RGB(130, 76, 38), Dark = RGB(60, 62, 66), Accent = RGB(255, 140, 40), Accent2 = RGB(118, 72, 40), Lens = RGB(70, 120, 175), BodyMaterial = MAT.Metal, PanelMaterial = MAT.Wood, AccentMaterial = MAT.SmoothPlastic },
	-- Dos tonos: corredera negra y armazón arena
	TwoTone = { Sheen = 0.02, DarkSheen = 0.1, Body = RGB(190, 160, 112), Panel = RGB(44, 46, 52), Dark = RGB(30, 30, 33), Accent = RGB(255, 140, 40), Accent2 = RGB(120, 84, 50), Lens = RGB(70, 120, 175), PanelMaterial = MAT.Metal, AccentMaterial = MAT.SmoothPlastic },
	-- Cuchillo: hoja de acero, mango negro
	Knife = { Body = RGB(40, 40, 44), Panel = RGB(150, 152, 158), Dark = RGB(170, 172, 178), Accent = RGB(120, 122, 128), Accent2 = RGB(200, 200, 205), Lens = RGB(70, 120, 175), PanelMaterial = MAT.Metal, AccentMaterial = MAT.Metal },
}
Weapons.ClassicPalettes = CLASSIC_PALETTES
local CLASSIC_LOOK = {
	ARX27 = "Black", HavocPump = "Wood", Specter9 = "Black", Signal7 = "Wood", VortexBR = "Tan",
	NovaDrift = "Olive", RaptorDMR = "Wood", BreachHammer = "Black", TitanLMG = "Olive", GhostlineXR = "Tan",
	NovaLauncher = "Olive", Viper = "Black", HandCannon = "Steel", PhantomSidewind = "TwoTone", Knife = "Knife",
}
if Weapons.Style == "Clasico" then
	for name, def in Weapons.List do
		for key, value in Classic.Points[name] or {} do
			def[key] = value
		end
		local build = Classic[name]
		if build then
			def.Parts = build(def)
			-- Nombres únicos (las piezas repetidas del bisel se numeran: Edge, Edge2, Edge3...)
			local seen = {}
			for _, part in def.Parts do
				local count = (seen[part.Name] or 0) + 1
				seen[part.Name] = count
				if count > 1 then
					part.Name ..= count
				end
			end
		end
		local look = CLASSIC_LOOK[name]
		if look then
			def.Palette = CLASSIC_PALETTES[look]
		end
	end
end

function Weapons.Get(name)
	if name == "Grenade" then
		return Weapons.Grenade
	elseif name == "Airstrike" then
		return Weapons.Airstrike
	end
	return Weapons.List[name] or Weapons.List[Weapons.Legacy[name] or ""]
end

-- Recarga táctica (como en los shooters realistas): si aún quedan balas en el cargador no hay que
-- montar el arma, así que es más rápida; con el cargador vacío dura el ReloadTime completo
Weapons.TacticalReload = 0.8
function Weapons.ReloadDuration(def, empty)
	local base = def.ReloadTime or 2
	return empty and base or base * Weapons.TacticalReload
end

-- ¿Puede el jugador usar esta arma? (nivel alcanzado o comprada con monedas)
function Weapons.IsUnlocked(name, data)
	local def = Weapons.List[name]
	if not def then
		return false
	end
	if (def.UnlockLevel or 1) <= 1 then
		return true
	end
	if not data then
		return false
	end
	return (data.Level or 1) >= def.UnlockLevel or (data.OwnedWeapons ~= nil and data.OwnedWeapons[name] == true)
end

return Weapons
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="40">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="41">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="42">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Punto de entrada del servidor: inicia todos los sistemas en orden.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

require(ReplicatedStorage.Shared.Remotes) -- crea los RemoteEvents antes que nada

local Modules = script.Parent.Modules
local MapBuilder = require(Modules.MapBuilder)
local PlayerData = require(Modules.PlayerData)
local Loadout = require(Modules.Loadout)
local Combat = require(Modules.Combat)
local Round = require(Modules.Round)
local Dummies = require(Modules.Dummies)
local Hazards = require(Modules.Hazards)
local Grenades = require(Modules.Grenades)
local Leaderboard = require(Modules.Leaderboard)
local Killstreaks = require(Modules.Killstreaks)
local Respawn = require(Modules.Respawn)
local Abilities = require(Modules.Abilities)
local Bots = require(Modules.Bots)
local Gifts = require(Modules.Gifts)
local Friends = require(Modules.Friends)
local Event = require(Modules.Event)
local Graffiti = require(Modules.Graffiti)
local HealthRegen = require(Modules.HealthRegen)
local QAServer = require(Modules.QAServer)


-- Arranca cada sistema por separado: si uno falla, se avisa en Output y los demás siguen
local function start(name, fn, ...)
	local ok, err = xpcall(fn, debug.traceback, ...)
	if not ok then
		warn("[Arranque] " .. name .. " falló: " .. tostring(err))
	end
end

start("MapBuilder", MapBuilder.Build) -- primer mapa de la rotación (o tu mapa propio si existe workspace.Map)
start("PlayerData", PlayerData.Init)
start("Loadout", Loadout.Init)
start("Combat", Combat.Init)
Combat.OnKill = Round.RegisterKill
Combat.OnAssist = Round.RegisterAssist
start("Round", Round.Init)
start("Respawn", Respawn.Init) -- reaparición propia (CharacterAutoLoads desactivado): después de Round
start("Dummies", Dummies.Init)
start("Hazards", Hazards.Init)
start("Grenades", Grenades.Init)
start("Leaderboard", Leaderboard.Init)
start("Killstreaks", Killstreaks.Init)
start("Abilities", Abilities.Init)
start("Bots", Bots.Init)
start("Gifts", Gifts.Init)
start("Friends", Friends.Init)
start("Event", Event.Init)
start("Graffiti", Graffiti.Init)
start("HealthRegen", HealthRegen.Init)
start("QAServer", QAServer.Init) -- modo QA: solo en Studio con GameConfig.QA.Enabled (si no, no hace nada)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="43">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Abilities</string>
            <string name="Source"><![CDATA[-- Habilidades: Impulso (E) y Supersalto (Z) se mueven en el cliente (el personaje es suyo en la
-- física); el servidor solo valida la Poción (X), que cura con el tiempo, y avisa a los demás para
-- que vean el efecto.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)

local Abilities = {}

local lastPotion = {} -- [player] = os.clock()

local function healEffect(character)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "PotionFX"
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(90, 255, 120), Color3.fromRGB(200, 255, 140))
	emitter.LightEmission = 0.8
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	emitter.Lifetime = NumberRange.new(0.8, 1.2)
	emitter.Speed = NumberRange.new(2, 4)
	emitter.SpreadAngle = Vector2.new(40, 40)
	emitter.Acceleration = Vector3.new(0, 4, 0)
	emitter.Rate = 30
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Parent = root
	task.delay(GameConfig.Abilities.Potion.Duration, function()
		emitter.Enabled = false
		task.wait(1.2)
		emitter:Destroy()
	end)
end

-- Cura poco a poco; se corta si el jugador muere
local function usePotion(player)
	local config = GameConfig.Abilities.Potion
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or player:GetAttribute("InMenu") then
		return false
	end
	local now = os.clock()
	if lastPotion[player] and now - lastPotion[player] < config.Cooldown - 0.25 then
		return false
	end
	lastPotion[player] = now
	healEffect(character)
	local steps = 10
	task.spawn(function()
		for _ = 1, steps do
			task.wait(config.Duration / steps)
			if humanoid.Parent == nil or humanoid.Health <= 0 then
				return
			end
			humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + config.Heal / steps)
		end
	end)
	return true
end
Abilities.UsePotion = usePotion

function Abilities.Init()
	Remotes.UsePotion.OnServerInvoke = usePotion
	Players.PlayerRemoving:Connect(function(player)
		lastPotion[player] = nil
	end)
end

return Abilities
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Analytics</string>
            <string name="Source"><![CDATA[-- Analítica de la tienda y del pase con AnalyticsService de Roblox (eventos propios y de economía).
-- Solo nombres de evento y datos del juego (ids de objetos, precios, pestañas): nada personal (ni
-- nombres, ni chat, ni datos de la cuenta). Si AnalyticsService falla o no existe, no pasa nada.
-- El cliente solo puede mandar los eventos de MonetizationConfig.Analytics.ClientEvents (lo que ve:
-- abrir la tienda, previsualizar...) y con límite por minuto; lo que de verdad pasa (compras,
-- reclamar el pase) lo manda solo el servidor.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Remotes = require(Shared.Remotes)
local MonetizationConfig = require(Shared.Economy.MonetizationConfig)

local Analytics = {}
Analytics.Counts = {} -- [evento] = veces (para las pruebas y para depurar)
Analytics.Recent = {} -- últimos eventos { Name, Fields } (como mucho 50)

local config = MonetizationConfig.Analytics
local service
pcall(function()
	service = game:GetService("AnalyticsService")
end)

-- Datos permitidos: hasta 3 valores cortos (texto o número). Nada de tablas ni instancias.
local function clean(fields)
	local out = {}
	if type(fields) ~= "table" then
		return out
	end
	local count = 0
	for key, value in fields do
		if count >= 3 then
			break
		end
		if type(key) == "string" and #key <= 24 and (type(value) == "string" or type(value) == "number") then
			local text = tostring(value)
			if #text <= 40 then
				out[key] = text
				count += 1
			end
		end
	end
	return out
end

local function customFields(fields)
	local out = {}
	local i = 0
	local keys = {}
	for key in fields do
		table.insert(keys, key)
	end
	table.sort(keys)
	for _, key in keys do
		i += 1
		local ok, enumKey = pcall(function()
			return (Enum :: any).AnalyticsCustomFieldKeys["CustomField0" .. i].Name
		end)
		out[ok and enumKey or ("CustomField0" .. i)] = key .. " - " .. fields[key]
	end
	return out
end

-- Evento propio (store_open, purchase_success...). Devuelve true si se registró.
function Analytics.Event(player, name, fields)
	if not config.Enabled or type(name) ~= "string" then
		return false
	end
	if not (config.ClientEvents[name] or config.ServerEvents[name]) then
		return false
	end
	local cleaned = clean(fields)
	Analytics.Counts[name] = (Analytics.Counts[name] or 0) + 1
	table.insert(Analytics.Recent, { Name = name, Fields = cleaned })
	if #Analytics.Recent > 50 then
		table.remove(Analytics.Recent, 1)
	end
	if service and player then
		pcall(function()
			(service :: any):LogCustomEvent(player, name, 1, customFields(cleaned))
		end)
	end
	return true
end

-- Movimiento de monedas (Source = entran, Sink = salen) para ver la inflación de la economía
function Analytics.Economy(player, flow, amount, balance, transaction, sku)
	if not config.Enabled or not service or not player or (tonumber(amount) or 0) <= 0 then
		return
	end
	pcall(function()
		(service :: any):LogEconomyEvent(
			player,
			(Enum :: any).AnalyticsEconomyFlowType[flow],
			"Monedas",
			math.floor(amount),
			math.floor(tonumber(balance) or 0),
			transaction,
			sku
		)
	end)
end

local budget = {} -- [player] = { Start, Count }

function Analytics.Init()
	Remotes.Track.OnServerEvent:Connect(function(player, name, fields)
		if type(name) ~= "string" or not config.ClientEvents[name] then
			return
		end
		local now = os.clock()
		local entry = budget[player]
		if not entry or now - entry.Start > 60 then
			entry = { Start = now, Count = 0 }
			budget[player] = entry
		end
		entry.Count += 1
		if entry.Count > config.ClientPerMinute then
			return
		end
		Analytics.Event(player, name, fields)
	end)
	Players.PlayerRemoving:Connect(function(player)
		budget[player] = nil
	end)
end

return Analytics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Badges</string>
            <string name="Source"><![CDATA[-- Insignias de Roblox (BadgeService). Se dan solas al cumplir cada logro. Con ID 0 no se da
-- (créalas en el Creator Hub → tu experiencia → Insignias y pega los ID en GameConfig.Badges).
local BadgeService = game:GetService("BadgeService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local Ranks = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Ranks"))

local Badges = {}

local awarded = {} -- [player] = { [nombre] = true } (para no repetir llamadas en la sesión)

-- Logros: nombre en GameConfig.Badges -> condición sobre los datos del jugador
local RULES = {
	{ Name = "Welcome", Check = function(_data)
		return true
	end },
	{ Name = "FirstKill", Check = function(data)
		return (data.TotalKills or 0) >= 1
	end },
	{ Name = "Kills100", Check = function(data)
		return (data.TotalKills or 0) >= 100
	end },
	{ Name = "FirstWin", Check = function(data)
		return (data.Wins or 0) >= 1
	end },
	{ Name = "Level10", Check = function(data)
		return (data.Level or 1) >= 10
	end },
	{ Name = "RankGold", Check = function(data)
		return math.max(data.RankBest or 1, Ranks.Index(data.RankPoints)) >= 3
	end },
	{ Name = "RankDiamond", Check = function(data)
		return math.max(data.RankBest or 1, Ranks.Index(data.RankPoints)) >= 5
	end },
	{ Name = "RankChampion", Check = function(data)
		return math.max(data.RankBest or 1, Ranks.Index(data.RankPoints)) >= 6
	end },
}

local function award(player, name)
	local id = GameConfig.Badges and GameConfig.Badges[name]
	if type(id) ~= "number" or id == 0 then
		return
	end
	awarded[player] = awarded[player] or {}
	if awarded[player][name] then
		return
	end
	awarded[player][name] = "pending"
	task.spawn(function()
		local ok, has = pcall(BadgeService.UserHasBadgeAsync, BadgeService, player.UserId, id)
		local done = ok and has
		if ok and not has and player.Parent then
			done = pcall(BadgeService.AwardBadge, BadgeService, player.UserId, id)
		end
		-- Si falló (p. ej. demasiadas peticiones), se reintenta la próxima vez que se compruebe
		if awarded[player] then
			awarded[player][name] = done and true or nil
		end
	end)
end

-- Revisa los logros con los datos actuales (lo llama PlayerData al cargar y cuando cambian)
function Badges.Check(player, data)
	if not data then
		return
	end
	for _, rule in RULES do
		if rule.Check(data) then
			award(player, rule.Name)
		end
	end
end

function Badges.Forget(player)
	awarded[player] = nil
end

return Badges
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">BattlePass</string>
            <string name="Source"><![CDATA[-- Pase de batalla (servidor): XP del pase, niveles, reclamar recompensas, misiones de temporada y
-- cambio de temporada. Funciones sobre los datos del jugador (PlayerData las llama y se encarga de
-- avisar al cliente y guardar). Config en Shared/Economy/BattlePassConfig.
--
-- data.Pass = { Season, XP, Free = { ["n"] = true }, Premium = { ["n"] = true }, HasPremium,
--               Missions = { [Id] = progreso }, Done = { [Id] = true } }
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.GameConfig)
local Config = require(Shared.Economy.BattlePassConfig)
local Catalog = require(Shared.Economy.CosmeticCatalog)

local BattlePass = {}

local function sameReward(a, b)
	if a == nil or b == nil then
		return a == b
	end
	return a.Type == b.Type and a.Id == b.Id and a.Amount == b.Amount
end

local function emptyPass(seasonId)
	return { Season = seasonId, XP = 0, Free = {}, Premium = {}, HasPremium = false, Missions = {}, Done = {} }
end

-- Da una recompensa (monedas u objeto). Devuelve una ficha para la interfaz.
function BattlePass.GrantReward(data, reward)
	if not reward then
		return nil
	end
	if reward.Type == "Coins" then
		data.Coins += reward.Amount
		return { Type = "Coins", Amount = reward.Amount }
	elseif reward.Type == "Crate" then
		data.FreeCrates = (data.FreeCrates or 0) + (reward.Amount or 1) -- (temporadas antiguas)
		return { Type = "Crate", Amount = reward.Amount or 1 }
	elseif Catalog.Exists(reward.Type, reward.Id) then
		local new = Catalog.Grant(data, reward.Type, reward.Id)
		local item = Catalog.Item(reward.Type, reward.Id)
		-- (si ya lo tenía, monedas a cambio: lo ganado no se pierde)
		local coins = 0
		if not new then
			coins = math.min(Catalog.Compensation(reward.Type, reward.Id), 1500)
			data.Coins += coins
		end
		return { Type = reward.Type, Id = reward.Id, Name = item and item.Name, Rarity = item and item.Rarity, Duplicate = not new, Coins = coins }
	end
	return nil
end

function BattlePass.Tier(data)
	local pass = data.Pass
	return Config.TierFor(pass and pass.XP or 0)
end

-- ¿Puede reclamar? (nivel alcanzado, no reclamado, premium si es de la vía premium)
local function canClaim(pass, season, tier, track)
	local entry = season.Tiers[tier]
	local reward = entry and entry[track]
	if not reward then
		return false
	end
	if tier > Config.TierFor(pass.XP) then
		return false
	end
	if track == "Premium" and not pass.HasPremium then
		return false
	end
	return not pass[track][tostring(tier)]
end

-- Prepara el pase de la temporada en curso. Si cambió de temporada, entrega sola lo que quedó sin
-- reclamar de la anterior. Devuelve la lista de lo entregado así (para avisar) o nil.
function BattlePass.Ensure(data, now)
	local season = Config.Current(now)
	local pass = data.Pass
	if type(pass) ~= "table" or type(pass.Season) ~= "string" then
		pass = nil
	end
	if not season then
		return nil -- (entre temporadas el pase anterior se queda como está)
	end
	if pass and pass.Season == season.Id then
		pass.XP = math.max(0, tonumber(pass.XP) or 0)
		for _, field in { "Free", "Premium", "Missions", "Done" } do
			if type(pass[field]) ~= "table" then
				pass[field] = {}
			end
		end
		return nil
	end
	local granted
	if pass then
		local old = Config.Get(pass.Season)
		if old then
			granted = {}
			for tier = 1, Config.TierFor(pass.XP) do
				for _, track in { "Free", "Premium" } do
					if canClaim(pass, old, tier, track) then
						pass[track][tostring(tier)] = true
						table.insert(granted, BattlePass.GrantReward(data, old.Tiers[tier][track]))
					end
				end
			end
		end
	end
	local fresh = emptyPass(season.Id)
	if season.LegacyPremium and data.Premium == true then
		fresh.HasPremium = true
	end
	-- Primera vez con pase por temporadas: el de antes iba por nivel de cuenta. Empieza en el nivel
	-- que tenía y lo que ya le dio el pase antiguo cuenta como reclamado (si es lo mismo)
	if not pass and season.MigrateFromLevel and (tonumber(data.Level) or 1) > 1 then
		local level = math.min(tonumber(data.Level) or 1, Config.Tiers)
		fresh.XP = Config.XPFor(level)
		for tier = 1, level do
			local old = GameConfig.BattlePass[tier] or {}
			local new = season.Tiers[tier]
			local k = tostring(tier)
			if type(data.ClaimedFree) == "table" and data.ClaimedFree[k] and sameReward(old.Free, new.Free) then
				fresh.Free[k] = true
			end
			if type(data.ClaimedPremium) == "table" and data.ClaimedPremium[k] and sameReward(old.Premium, new.Premium) then
				fresh.Premium[k] = true
			end
		end
	end
	data.Pass = fresh
	return granted
end

-- Suma XP del pase. Devuelve nivel antes y después.
function BattlePass.AddXP(data, amount, now)
	local season = Config.Current(now)
	local pass = data.Pass
	if not season or type(pass) ~= "table" or pass.Season ~= season.Id or (tonumber(amount) or 0) <= 0 then
		local tier = pass and Config.TierFor(pass.XP) or 1
		return tier, tier, 0
	end
	local before = Config.TierFor(pass.XP)
	local maxXP = Config.MaxXP()
	local added = math.max(0, math.min(math.floor(amount), maxXP - pass.XP))
	pass.XP += added
	return before, Config.TierFor(pass.XP), added
end

-- Reclama una recompensa. track = "Free" | "Premium"
function BattlePass.Claim(data, tier, track)
	local pass = data.Pass
	local season = pass and Config.Get(pass.Season)
	if not season or type(tier) ~= "number" or tier ~= tier or (track ~= "Free" and track ~= "Premium") then
		return nil, "No existe"
	end
	tier = math.floor(tier)
	if tier > Config.TierFor(pass.XP) then
		return nil, "Aún no has llegado a ese nivel"
	end
	if track == "Premium" and not pass.HasPremium then
		return nil, "Es del pase premium"
	end
	if not canClaim(pass, season, tier, track) then
		return nil, "Ya está reclamado"
	end
	pass[track][tostring(tier)] = true
	local granted = BattlePass.GrantReward(data, season.Tiers[tier][track])
	if granted then
		granted.Tier = tier
		granted.Track = track
	end
	return granted
end

-- Reclama todo lo que se pueda
function BattlePass.ClaimAll(data)
	local list = {}
	local pass = data.Pass
	local season = pass and Config.Get(pass.Season)
	if not season then
		return list
	end
	for tier = 1, Config.TierFor(pass.XP) do
		for _, track in { "Free", "Premium" } do
			if canClaim(pass, season, tier, track) then
				local granted = BattlePass.Claim(data, tier, track)
				if granted then
					table.insert(list, granted)
				end
			end
		end
	end
	return list
end

-- Cuántas recompensas hay por reclamar (para el punto rojo)
function BattlePass.Claimable(data)
	local pass = data.Pass
	local season = pass and Config.Get(pass.Season)
	if not season then
		return 0
	end
	local count = 0
	for tier = 1, Config.TierFor(pass.XP) do
		for _, track in { "Free", "Premium" } do
			if canClaim(pass, season, tier, track) then
				count += 1
			end
		end
	end
	return count
end

-- Progreso de las misiones de temporada. Devuelve las completadas ahora (ya suman su XP).
function BattlePass.Track(data, stat, amount, now)
	local season = Config.Current(now)
	local pass = data.Pass
	local done = {}
	if not season or type(pass) ~= "table" or pass.Season ~= season.Id then
		return done
	end
	for _, mission in season.Missions or {} do
		if mission.Stat == stat and not pass.Done[mission.Id] then
			local progress = tonumber(pass.Missions[mission.Id]) or 0
			if stat == "Streak" then
				progress = math.max(progress, tonumber(amount) or 0)
			else
				progress += tonumber(amount) or 1
			end
			pass.Missions[mission.Id] = math.min(progress, mission.Goal)
			if progress >= mission.Goal then
				pass.Done[mission.Id] = true
				BattlePass.AddXP(data, mission.XP, now)
				table.insert(done, mission)
			end
		end
	end
	return done
end

-- Lo que ve el cliente
function BattlePass.View(data, now)
	local pass = data.Pass
	local season = pass and Config.Get(pass.Season)
	if not season then
		return nil
	end
	now = now or os.time()
	local missions = {}
	for _, mission in season.Missions or {} do
		table.insert(missions, {
			Id = mission.Id,
			Text = mission.Text,
			Goal = mission.Goal,
			XP = mission.XP,
			Progress = math.min(tonumber(pass.Missions[mission.Id]) or 0, mission.Goal),
			Done = pass.Done[mission.Id] == true,
		})
	end
	return {
		Season = season.Id,
		Name = season.Name,
		Title = season.Title,
		EndsAt = season.EndsAt,
		Active = now >= season.StartsAt and now < season.EndsAt,
		XP = pass.XP,
		Tier = Config.TierFor(pass.XP),
		XPPerTier = Config.XPPerTier,
		Tiers = Config.Tiers,
		HasPremium = pass.HasPremium == true,
		Free = pass.Free,
		Premium = pass.Premium,
		Claimable = BattlePass.Claimable(data),
		Missions = missions,
	}
end

return BattlePass
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Bomb</string>
            <string name="Source"><![CDATA[-- Buscar y destruir: la bomba de cada ronda. Los atacantes la plantan quedándose dentro de un sitio
-- (A o B, en la mitad de los defensores) PLANT_TIME segundos; los defensores la desactivan quedándose
-- junto a ella DEFUSE_TIME segundos antes de que explote (BOMB_TIME). Round decide la ronda con
-- Bomb.Result ("Exploded" / "Defused") y Bomb.Planted.
--
-- Estado para la interfaz (atributos de ReplicatedStorage):
--   Bomb_Attackers / Bomb_Defenders (nombres de equipo), Bomb_A_Position / Bomb_B_Position,
--   Bomb_State ("Idle" | "Planted" | "Exploded" | "Defused"), Bomb_Site (letra), Bomb_Timer (s),
--   Bomb_Action ("Planting" | "Defusing" | ""), Bomb_Progress (0..1),
--   Bomb_Carrier (nombre de quien lleva la bomba), Bomb_Dropped (Vector3 si está en el suelo)
-- Como en los shooters: solo un atacante lleva la bomba y solo él puede plantarla. Si cae, la bomba
-- se queda en el suelo y cualquier atacante la recoge pasando por encima.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Remotes = require(Shared.Remotes)
local GameConfig = require(Shared.GameConfig)

local PlayerData = require(script.Parent.PlayerData)

local Bomb = {}

local STEP = 0.25

local active = false
local sites = {} -- { Letter, Position, Radius, Visual }
local PICKUP_RADIUS = 5
local carrier -- { Model, Player, Name, LastPosition }
local droppedAt -- Vector3: la bomba está en el suelo
local droppedTime = 0
local RETURN_TIME = 20 -- si nadie la recoge en este tiempo (p. ej. cayó al agua), vuelve a un atacante
local droppedVisual
local thread
local visuals = {}

Bomb.Result = nil
Bomb.Planted = false
Bomb.Site = nil

local function settings()
	return GameConfig.ModeSettings.SND or {}
end

local function findSites(defenderIndex)
	local list = {}
	local map = workspace:FindFirstChild("Map")
	if map then
		for _, d in map:GetDescendants() do
			if d:IsA("BasePart") and d.Name == "BombSite" and (defenderIndex == nil or d:GetAttribute("Defender") == defenderIndex) then
				table.insert(list, d)
			end
		end
	end
	table.sort(list, function(a, b)
		return (a:GetAttribute("Letter") or "") < (b:GetAttribute("Letter") or "")
	end)
	return list
end

-- ¿Tiene el mapa sitios para los dos equipos?
function Bomb.IsAvailable()
	return #findSites(1) >= 1 and #findSites(2) >= 1
end

local function makeVisual(site, color)
	local model = Instance.new("Model")
	model.Name = "BombSite_" .. site.Letter
	local ring = Instance.new("Part")
	ring.Name = "Ring"
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.3, site.Radius * 2, site.Radius * 2)
	ring.CFrame = CFrame.new(site.Position + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	ring.Material = Enum.Material.ForceField
	ring.Color = color
	ring.Transparency = 0.2
	ring.Parent = model
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(60, 60)
	billboard.StudsOffset = Vector3.new(0, 6, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = 1500
	billboard.Parent = ring
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextStrokeTransparency = 0.2
	label.Text = "💣" .. site.Letter
	label.TextColor3 = color
	label.Parent = billboard
	model.Parent = workspace
	table.insert(visuals, model)
	return model
end

-- Vivos de un equipo dentro de un radio: { jugadores } y cuántos (los bots cuentan, sin lista)
local function inside(team, position, radius)
	local players, count = {}, 0
	local function check(root)
		local offset = root.Position - position
		return Vector3.new(offset.X, 0, offset.Z).Magnitude <= radius and math.abs(offset.Y) < 8
	end
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if player.Team == team and humanoid and humanoid.Health > 0 and root and not player:GetAttribute("InMenu") and check(root) then
			table.insert(players, player)
			count += 1
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart")
			if model:GetAttribute("Team") == team.Name and humanoid and humanoid.Health > 0 and root and check(root) then
				count += 1
			end
		end
	end
	return players, count
end

local function explode(site)
	local position = site.Position + Vector3.new(0, 1, 0)
	Remotes.ExplosionFX:FireAllClients(position, 26)
	-- La explosión elimina a quien esté muy cerca (sin baja para nadie)
	local victims = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(victims, player.Character)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			table.insert(victims, model)
		end
	end
	for _, model in victims do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local root = model:FindFirstChild("HumanoidRootPart")
		if humanoid and root and humanoid.Health > 0 and (root.Position - position).Magnitude < 22 then
			humanoid:SetAttribute("LastAttacker", nil)
			humanoid:SetAttribute("LastBot", nil)
			humanoid:TakeDamage(500)
		end
	end
end

local function setAttr(name, value)
	ReplicatedStorage:SetAttribute("Bomb_" .. name, value)
end

-- Miembros vivos de un equipo (jugadores y bots): { Model, Player, Name, Root }
local function aliveMembers(team)
	local list = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if player.Team == team and humanoid and humanoid.Health > 0 and root and not player:GetAttribute("InMenu") then
			table.insert(list, { Model = character, Player = player, Name = player.Name, Root = root })
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart")
			if model:GetAttribute("Team") == team.Name and humanoid and humanoid.Health > 0 and root then
				table.insert(list, { Model = model, Name = model.Name, Root = root })
			end
		end
	end
	return list
end

-- Raíz del portador si sigue vivo (si murió o reapareció con otro cuerpo, nil)
local function carrierRoot()
	if not carrier then
		return nil
	end
	local model = carrier.Model
	if not model or not model.Parent or (carrier.Player and carrier.Player.Character ~= model) then
		return nil
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and root then
		return root
	end
	return nil
end

local function clearDropped()
	droppedAt = nil
	if droppedVisual then
		droppedVisual:Destroy()
		droppedVisual = nil
	end
	setAttr("Dropped", nil)
end

local function setCarrier(member)
	clearDropped()
	carrier = member and { Model = member.Model, Player = member.Player, Name = member.Name, LastPosition = member.Root.Position } or nil
	setAttr("Carrier", member and member.Name or nil)
	if member and member.Player then
		Remotes.Notify:FireClient(member.Player, "Big", "💣 ¡LLEVAS LA BOMBA! Plántala en A o B")
	end
end

-- Suelo bajo el punto donde cayó el portador (ignorando personajes): nil si no hay suelo o si es
-- agua o lava (ahí no se podría recoger)
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
local function groundBelow(position)
	local ignore = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(ignore, player.Character)
		end
	end
	for _, name in { "Bots", "Grenades", "ClientFX" } do
		local folder = workspace:FindFirstChild(name)
		if folder then
			table.insert(ignore, folder)
		end
	end
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	groundParams.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(position + Vector3.new(0, 1, 0), Vector3.new(0, -60, 0), groundParams)
	if not hit then
		return nil
	end
	local bad = hit.Material == Enum.Material.Water or hit.Material == Enum.Material.CrackedLava
		or hit.Instance:GetAttribute("Hazard") ~= nil
	return not bad and hit.Position or nil
end

-- El portador cae: la bomba se queda en el suelo (a la vista de todos, pero el aviso en pantalla y en
-- el minimapa es solo para los atacantes). Si cae donde no se puede recoger, pasa a otro atacante.
local function dropBomb(position, attackers)
	carrier = nil
	setAttr("Carrier", nil)
	local ground = groundBelow(position)
	if not ground then
		local members = aliveMembers(attackers)
		if #members > 0 then
			setCarrier(members[math.random(1, #members)])
		end
		return
	end
	droppedAt = ground + Vector3.new(0, 3, 0) -- (a la altura de la cadera de quien la recoge)
	droppedTime = os.clock()
	setAttr("Dropped", droppedAt)
	local part = Instance.new("Part")
	part.Name = "DroppedBomb"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Size = Vector3.new(1.4, 0.8, 1)
	part.Color = Color3.fromRGB(60, 60, 55)
	part.Material = Enum.Material.Metal
	part.CFrame = CFrame.new(ground + Vector3.new(0, 0.4, 0))
	part.Parent = workspace
	droppedVisual = part
	for _, player in Players:GetPlayers() do
		if player.Team == attackers then
			Remotes.Notify:FireClient(player, "Info", "💣 ¡La bomba está en el suelo! Recógela")
		end
	end
end

-- Cada paso sin plantar: quién lleva la bomba (si su portador cae, se queda en el suelo)
-- Devuelve true si cambia de manos (el progreso de plantar no pasa al nuevo portador)
local function updateCarrier(attackers)
	if carrier then
		local root = carrierRoot()
		if root then
			carrier.LastPosition = root.Position
			return false
		end
		dropBomb(carrier.LastPosition, attackers)
		if carrier then
			return true -- (cayó donde no se podía recoger: ya la lleva otro)
		end
	end
	local members = aliveMembers(attackers)
	if droppedAt then
		for _, member in members do
			local offset = member.Root.Position - droppedAt
			if Vector3.new(offset.X, 0, offset.Z).Magnitude <= PICKUP_RADIUS and math.abs(offset.Y) < 6 then
				setCarrier(member)
				return true
			end
		end
		if os.clock() - droppedTime > RETURN_TIME and #members > 0 then
			setCarrier(members[math.random(1, #members)])
			return true
		end
	elseif #members > 0 then
		setCarrier(members[math.random(1, #members)])
		return true
	end
	return false
end

-- ¿Está el portador dentro del sitio?
local function carrierIn(site)
	local root = carrierRoot()
	if not root then
		return false
	end
	local offset = root.Position - site.Position
	return Vector3.new(offset.X, 0, offset.Z).Magnitude <= site.Radius and math.abs(offset.Y) < 8
end

-- La bomba plantada en el suelo (caja con panel y una luz roja; el cliente la hace parpadear y pitar,
-- ver BombHUD). Va en visuals: se quita con Stop
local plantedModel
local function placeBomb(site)
	local ground = groundBelow(site.Position + Vector3.new(0, 3, 0)) or site.Position
	local model = Instance.new("Model")
	model.Name = "PlantedBomb"
	local function piece(name, size, offset, color, material)
		local part = Instance.new("Part")
		part.Name = name
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Size = size
		part.CFrame = CFrame.new(ground + offset)
		part.Color = color
		part.Material = material
		part.Parent = model
		return part
	end
	piece("Case", Vector3.new(1.8, 0.7, 1.2), Vector3.new(0, 0.35, 0), Color3.fromRGB(58, 60, 52), Enum.Material.Metal)
	piece("Panel", Vector3.new(0.9, 0.08, 0.6), Vector3.new(-0.3, 0.74, 0), Color3.fromRGB(30, 34, 30), Enum.Material.SmoothPlastic)
	piece("Wires", Vector3.new(0.15, 0.1, 0.9), Vector3.new(0.55, 0.74, 0), Color3.fromRGB(170, 40, 30), Enum.Material.SmoothPlastic)
	local light = piece("BombLight", Vector3.new(0.22, 0.22, 0.22), Vector3.new(0.4, 0.82, 0.3), Color3.fromRGB(255, 40, 30), Enum.Material.Neon)
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 50, 40)
	glow.Range = 6
	glow.Brightness = 2
	glow.Parent = light
	model.Parent = workspace
	table.insert(visuals, model)
	plantedModel = model
end

-- Empieza una ronda: attackers plantan en los sitios de la mitad de defenders
function Bomb.Start(attackers, defenders)
	Bomb.Stop()
	local defenderIndex = 1
	for i, cfg in GameConfig.Teams do
		if cfg.Name == defenders.Name then
			defenderIndex = i
		end
	end
	sites = {}
	for _, part in findSites(defenderIndex) do
		local site = { Letter = part:GetAttribute("Letter") or "A", Position = part.Position, Radius = part:GetAttribute("Radius") or 7 }
		site.Visual = makeVisual(site, Color3.fromRGB(255, 200, 60))
		setAttr(site.Letter .. "_Position", site.Position)
		table.insert(sites, site)
	end
	if #sites == 0 then
		return false
	end
	local s = settings()
	local plantTime, defuseTime, bombTime = s.PlantTime or 4, s.DefuseTime or 6, s.BombTime or 35
	Bomb.Result, Bomb.Planted, Bomb.Site = nil, false, nil
	carrier = nil
	clearDropped()
	setAttr("Carrier", nil)
	setAttr("Attackers", attackers.Name)
	setAttr("Defenders", defenders.Name)
	setAttr("State", "Idle")
	setAttr("Action", "")
	setAttr("Progress", 0)
	setAttr("Site", nil)
	setAttr("Timer", nil)
	active = true
	thread = task.spawn(function()
		local progress, site, explodeAt = 0, nil, nil
		while active do
			-- (el progreso con el tiempo de verdad: con el servidor cargado la espera dura más)
			local dt = task.wait(STEP)
			if not Bomb.Planted then
				-- Plantar: el portador de la bomba, vivo dentro de un sitio y sin salir de él
				if updateCarrier(attackers) then
					progress, site = 0, nil
				end
				local here, players = nil, {}
				if site and carrierIn(site) then
					here = site
				end
				for _, candidate in sites do
					if here then
						break
					end
					if carrierIn(candidate) then
						here = candidate
					end
				end
				if here and carrier and carrier.Player then
					players = { carrier.Player }
				end
				if here and (site == nil or site == here) then
					site = here
					progress += dt / plantTime
					setAttr("Action", "Planting")
					setAttr("Site", site.Letter)
					if progress >= 1 then
						Bomb.Planted, Bomb.Site = true, site.Letter
						local placed, placeError = pcall(placeBomb, site)
						if not placed then
							warn("[Bomba] no se pudo colocar la bomba:", placeError)
						end
						carrier = nil
						setAttr("Carrier", nil)
						explodeAt = os.clock() + bombTime
						progress = 0
						setAttr("State", "Planted")
						setAttr("Action", "")
						Remotes.Notify:FireAllClients("Big", "💣 ¡BOMBA PLANTADA EN " .. site.Letter .. "!")
						for _, player in players do
							task.spawn(PlayerData.AddXP, player, 50, "💣 Bomba plantada")
						end
						for _, visual in visuals do
							if visual.Name ~= "BombSite_" .. site.Letter and visual.Name ~= "PlantedBomb" then
								visual:Destroy()
							end
						end
						local ring = site.Visual and site.Visual:FindFirstChild("Ring")
						if ring then
							ring.Color = Color3.fromRGB(255, 50, 40)
						end
					end
				else
					progress, site = 0, nil
					setAttr("Action", "")
					setAttr("Site", nil)
				end
				setAttr("Progress", math.floor(progress * 100 + 0.5) / 100)
			else
				local remaining = explodeAt - os.clock()
				setAttr("Timer", math.max(0, math.ceil(remaining)))
				-- Desactivar: algún defensor vivo junto a la bomba
				local players, count = inside(defenders, site.Position, site.Radius)
				if count > 0 then
					progress += dt / defuseTime
					setAttr("Action", "Defusing")
					if progress >= 1 then
						Bomb.Result = "Defused"
						setAttr("State", "Defused")
						setAttr("Action", "")
						Remotes.Notify:FireAllClients("Big", "✅ ¡BOMBA DESACTIVADA!")
						for _, player in players do
							task.spawn(PlayerData.AddXP, player, 60, "✅ Bomba desactivada")
						end
						active = false
					end
				else
					progress = 0
					setAttr("Action", "")
				end
				setAttr("Progress", math.floor(progress * 100 + 0.5) / 100)
				if active and remaining <= 0 then
					Bomb.Result = "Exploded"
					setAttr("State", "Exploded")
					setAttr("Action", "")
					explode(site)
					if plantedModel then
						plantedModel:Destroy() -- (ha volado)
						plantedModel = nil
					end
					Remotes.Notify:FireAllClients("Big", "💥 ¡LA BOMBA HA EXPLOTADO!")
					active = false
				end
			end
		end
	end)
	return true
end

-- Para los bots: los sitios de esta ronda
function Bomb.Sites()
	return sites
end

function Bomb.Stop()
	active = false
	if thread and coroutine.status(thread) ~= "dead" and thread ~= coroutine.running() then
		pcall(task.cancel, thread)
	end
	thread = nil
	for _, visual in visuals do
		visual:Destroy()
	end
	visuals = {}
	sites = {}
	plantedModel = nil
	carrier = nil
	clearDropped()
	for _, name in { "Attackers", "Defenders", "A_Position", "B_Position", "State", "Site", "Timer", "Action", "Progress", "Carrier" } do
		setAttr(name, nil)
	end
end

return Bomb
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Bots</string>
            <string name="Source"><![CDATA[-- Bots: rellenan la partida cuando hay pocos jugadores (GameConfig.Bots). Llevan un arma de verdad
-- (los demás ven trazadoras, fogonazo y sonido como con un jugador), recorren el mapa con
-- PathfindingService, buscan enemigos con línea de visión y fallan más cuanto más lejos disparan.
-- Cuentan para el marcador por equipos y dan algo de XP y monedas, pero no para la clasificación global.
-- Solo durante la ronda; en "Escalada de armas" no hay bots. En Eliminación (NoRespawn) no reaparecen
-- hasta la ronda siguiente (Round llama a Bots.RespawnAll).
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Weapons = require(Shared.Weapons)
local Remotes = require(Shared.Remotes)

local Combat = require(script.Parent.Combat)
local Pumpkins = require(script.Parent.Pumpkins)
local Loadout = require(script.Parent.Loadout)
local Zombie = require(script.Parent.Zombie)
local Grenades = require(script.Parent.Grenades)
local SpawnPicker = require(script.Parent.SpawnPicker)
local Domination = require(script.Parent.Domination)
local Bomb = require(script.Parent.Bomb)
local Outfits = require(Shared.Outfits)
local Shop = require(Shared.Shop)

-- Trajes que pueden llevar los bots (los de la tienda: así se ven en partida)
local BOT_OUTFITS = {}
for id in Shop.OutfitPrices do
	if Outfits.List[id] and not Outfits.List[id].Event then
		table.insert(BOT_OUTFITS, id)
	end
end
table.sort(BOT_OUTFITS)
-- Skins de arma que pueden llevar (las de la tienda)
local BOT_SKINS = {}
for id in Shop.SkinPrices do
	table.insert(BOT_SKINS, id)
end
table.sort(BOT_SKINS)
-- Colgantes de arma que pueden llevar
local Charms = require(Shared.Charms)
local BOT_CHARMS = {}
for id, charm in Charms.List do
	if charm.Price then
		table.insert(BOT_CHARMS, id)
	end
end
table.sort(BOT_CHARMS)

local Bots = {}
Bots.QAFillTo = nil :: number? -- (modo QA de Studio: total de jugadores + bots; nil = GameConfig.Bots.FillTo)

local CONFIG = GameConfig.Bots
local NAMES = { "Tito", "Luna", "Max", "Kira", "Rocco", "Nova", "Pipo", "Zara", "Dante", "Mia", "Toby", "Vega", "Bruno", "Sofi", "Leo", "Iris", "Hugo", "Nala", "Thor", "Cleo" }

local folder
local statsFolder -- ReplicatedStorage.BotStats: una carpeta por bot con Team, Kills, Deaths y Score (marcador)
local agents = {} -- lista de bots activos
local nameIndex = 0

local function state()
	return ReplicatedStorage:GetAttribute("State")
end

local function noRespawn()
	return ReplicatedStorage:GetAttribute("NoRespawn") == true
end

-- Cuenta atrás de Eliminación: todos quietos y sin disparar
local function frozen()
	return ReplicatedStorage:GetAttribute("Frozen") == true
end

local function teamMode()
	return ReplicatedStorage:GetAttribute("TeamMode") == true
end

-- ¿Cuántos bots hacen falta ahora mismo?
local function desiredCount()
	-- (en la Escalada de armas también: son rivales para subir de arma, aunque ellos no suben)
	if not CONFIG.Enabled or state() ~= "Playing" then
		return 0
	end
	-- (Bots.QAFillTo: solo el modo QA de Studio lo cambia para poner o quitar bots; nil = lo normal)
	return math.max(0, (Bots.QAFillTo or CONFIG.FillTo) - #Players:GetPlayers())
end

-- Equipo con menos miembros (jugadores + bots)
local function pickTeam()
	if not teamMode() then
		return nil
	end
	-- Infección: antes de la infección, superviviente (equipo A); después, zombi (equipo B)
	local infection = ReplicatedStorage:GetAttribute("Infection")
	if infection then
		return Teams:FindFirstChild(ReplicatedStorage:GetAttribute(infection == "On" and "TeamB" or "TeamA") or "")
	end
	local best, bestCount = nil, math.huge
	for _, team in Teams:GetTeams() do
		local count = #team:GetPlayers()
		for _, agent in agents do
			if agent.Team == team then
				count += 1
			end
		end
		if count < bestCount then
			best, bestCount = team, count
		end
	end
	return best
end

-- Puntos del mapa (se guardan hasta que cambia el mapa: recorrer todas las piezas es caro)
local cachedMap, spawnsByColor, ffaPoints, botSpots = nil, {}, {}, {}
local function refreshPoints()
	local map = workspace:FindFirstChild("Map")
	if map == cachedMap and map ~= nil and map.Parent ~= nil then
		return
	end
	cachedMap, spawnsByColor, ffaPoints, botSpots = map, {}, {}, {}
	if not map then
		return
	end
	for _, d in map:GetDescendants() do
		if d:IsA("SpawnLocation") then
			local key = d.TeamColor.Name
			spawnsByColor[key] = spawnsByColor[key] or {}
			table.insert(spawnsByColor[key], d.Position)
		elseif d:IsA("BasePart") and d.Name == "FFASpawn" then
			table.insert(ffaPoints, d.Position)
		elseif d:IsA("BasePart") and d.Name == "BotSpot" then
			table.insert(botSpots, { Position = d.Position, Look = d:GetAttribute("Look") })
		end
	end
end

local function spawnPoint(team)
	refreshPoints()
	local points = team and spawnsByColor[team.TeamColor.Name] or {}
	if #points == 0 then
		points = ffaPoints
	end
	if #points == 0 then
		return Vector3.new(0, 10, 0)
	end
	return points[math.random(1, #points)] + Vector3.new(0, 4, 0)
end

-- Pinta al bot con los colores de su equipo (o de color aleatorio en todos contra todos)
local function makeDescription(team, zombie)
	local description = Instance.new("HumanoidDescription")
	local shirt = team and team.TeamColor.Color or Color3.fromHSV(math.random(), 0.6, 0.85)
	local skin = ({ Color3.fromRGB(255, 205, 160), Color3.fromRGB(200, 150, 110), Color3.fromRGB(140, 95, 65), Color3.fromRGB(255, 220, 190) })[math.random(1, 4)]
	if zombie then
		skin = Zombie.Skin
	end
	description.HeadColor = skin
	description.LeftArmColor = skin
	description.RightArmColor = skin
	description.TorsoColor = shirt
	description.LeftLegColor = Color3.fromRGB(45, 48, 60)
	description.RightLegColor = Color3.fromRGB(45, 48, 60)
	return description
end

local function isEnemyOf(agent, otherTeam)
	if not teamMode() then
		return true
	end
	return agent.Team ~= otherTeam
end

-- Objetivos posibles: jugadores vivos fuera del menú y sin escudo, y bots enemigos
local function candidates(agent)
	local list = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local head = character and character:FindFirstChild("Head")
		if humanoid and head and humanoid.Health > 0 and not player:GetAttribute("InMenu")
			and not character:FindFirstChildOfClass("ForceField") and isEnemyOf(agent, player.Team) then
			table.insert(list, { Model = character, Humanoid = humanoid, Head = head, Wanted = (player:GetAttribute("Bounty") or 0) > 0 })
		end
	end
	for _, other in agents do
		if other ~= agent and other.Humanoid and other.Humanoid.Health > 0 and isEnemyOf(agent, other.Team) then
			local head = other.Model:FindFirstChild("Head")
			if head then
				table.insert(list, { Model = other.Model, Humanoid = other.Humanoid, Head = head })
			end
		end
	end
	return list
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

-- ¿Se puede pisar ahí? (no agua ni lava). Sin nada debajo cuenta como sí (como antes): solo evita
-- que se tiren al agua del canal o a la lava persiguiendo o esquivando.
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
local function safeGround(position)
	local map = workspace:FindFirstChild("Map")
	if not map then
		return true
	end
	groundParams.FilterDescendantsInstances = { map, workspace.Terrain }
	local hit = workspace:Raycast(position + Vector3.new(0, 3, 0), Vector3.new(0, -9, 0), groundParams)
	return not hit or (hit.Material ~= Enum.Material.Water and hit.Material ~= Enum.Material.CrackedLava)
end

local function canSee(agent, target)
	local head = agent.Model:FindFirstChild("Head")
	if not head then
		return false
	end
	local ignore = { agent.Model }
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	rayParams.FilterDescendantsInstances = ignore
	local direction = target.Head.Position - head.Position
	local hit = workspace:Raycast(head.Position, direction, rayParams)
	return hit == nil or hit.Instance:IsDescendantOf(target.Model)
end

-- Visión: los bots no ven por la espalda. Se fijan en lo que tienen delante (cono de VISION_ANGLE
-- grados), en quien está muy cerca, en quien les acaba de disparar y en con quien ya peleaban.
-- Así flanquear y atacar por detrás funciona, como contra una persona.
local VISION_DOT = math.cos(math.rad(70)) -- 140° en total
local NOTICE_DISTANCE = 14

-- ¿Le ha disparado este objetivo hace poco?
local function hitBy(agent, target)
	local humanoid = agent.Humanoid
	local hitTime = humanoid and humanoid:GetAttribute("LastHitTime")
	if not hitTime or os.clock() - hitTime > 3 then
		return false
	end
	local attackerId = humanoid:GetAttribute("LastAttacker")
	if attackerId then
		local player = Players:GetPlayerFromCharacter(target.Model)
		return player ~= nil and player.UserId == attackerId
	end
	return humanoid:GetAttribute("LastBot") == target.Model.Name
end

local function notices(agent, target)
	if agent.Target == target.Model or target.Distance < NOTICE_DISTANCE then
		return true
	end
	local offset = target.Head.Position - agent.Root.Position
	if offset.Magnitude > 0 and agent.Root.CFrame.LookVector:Dot(offset.Unit) > VISION_DOT then
		return true
	end
	return hitBy(agent, target)
end

-- El enemigo visible más cercano: se ordenan por distancia y solo se lanzan rayos hasta encontrar
-- uno a la vista (antes se comprobaban todos)
local function findTarget(agent)
	local root = agent.Root
	local inRange = {}
	for _, target in candidates(agent) do
		local distance = (target.Head.Position - root.Position).Magnitude
		if distance < CONFIG.Range then
			target.Distance = distance
			table.insert(inRange, target)
		end
	end
	-- (el buscado, "SE BUSCA", atrae a los bots: cuenta como si estuviera más cerca)
	-- (y el que ya tenía en el punto de mira también: con dos enemigos a la misma distancia no salta
	-- de uno a otro en cada pasada, que reiniciaba la reacción y no llegaba a disparar)
	local function weight(t)
		return t.Distance * (t.Wanted and 0.6 or 1) * (t.Model == agent.Target and 0.8 or 1)
	end
	table.sort(inRange, function(x, y)
		return weight(x) < weight(y)
	end)
	for _, target in inRange do
		if notices(agent, target) and canSee(agent, target) then
			return target, target.Distance
		end
	end
	return nil, CONFIG.Range
end

-- Le han disparado y no ve a nadie: se gira hacia el disparo y va a ver qué pasa
local function checkAlert(agent, now)
	local humanoid, root = agent.Humanoid, agent.Root
	local hitTime = humanoid:GetAttribute("LastHitTime")
	if not hitTime or hitTime == agent.LastAlert or now - hitTime > 2 then
		return
	end
	agent.LastAlert = hitTime
	local source
	local attackerId = humanoid:GetAttribute("LastAttacker")
	if attackerId then
		local attacker = Players:GetPlayerByUserId(attackerId)
		source = attacker and attacker.Character and attacker.Character:FindFirstChild("HumanoidRootPart")
	else
		local other = Combat.BotsByName[humanoid:GetAttribute("LastBot") or ""]
		source = other and other.Root
	end
	if source and source.Parent then
		local look = Vector3.new(source.Position.X, root.Position.Y, source.Position.Z)
		if (look - root.Position).Magnitude > 0.5 then
			root.CFrame = CFrame.lookAt(root.Position, look)
		end
		agent.AlertPosition = source.Position
		agent.AlertTime = now
		agent.GoalDeadline = 0 -- (busca camino nuevo ya)
		agent.Waypoints = nil
		humanoid:MoveTo(root.Position) -- (se para a mirar)
	end
end

-- Captura la bandera: si lleva la bandera, a casa; si no, a devolver la suya caída, a perseguir a
-- quien se la lleva o a por la enemiga (ver Flags: FlagPos_/FlagHome_/FlagState_)
local function flagGoal(agent)
	if ReplicatedStorage:GetAttribute("Mode") ~= "CTF" or not agent.Team then
		return nil
	end
	local own = agent.Team.Name
	local enemy
	for _, team in Teams:GetTeams() do
		if team ~= agent.Team then
			enemy = team.Name
		end
	end
	if agent.CarryingFlag then
		return ReplicatedStorage:GetAttribute("FlagHome_" .. own)
	end
	local ownState = ReplicatedStorage:GetAttribute("FlagState_" .. own)
	if (ownState == "Dropped" or ownState == "Carried") and math.random() < 0.6 then
		return ReplicatedStorage:GetAttribute("FlagPos_" .. own)
	end
	if enemy and math.random() < 0.65 then
		return ReplicatedStorage:GetAttribute("FlagPos_" .. enemy)
	end
	return nil
end

local laneGoal, bestIntel, chooseRole -- (más abajo)
local sndPick = { Sites = nil, Index = 1 } -- sitio que atacan los bots en esta ronda de Buscar y destruir

-- Adónde ir: objetivo del modo, alerta, pista del equipo o su carril
local function pickGoal(agent)
	agent.SpotLook = nil -- (solo vale si el objetivo nuevo es un puesto de vigilancia)
	local flagTarget = flagGoal(agent)
	if typeof(flagTarget) == "Vector3" then
		return flagTarget, true
	end
	-- Le dispararon desde donde no veía: va hacia allí
	if agent.AlertPosition then
		local alert, fresh = agent.AlertPosition, os.clock() - (agent.AlertTime or 0) < 5
		agent.AlertPosition = nil
		if fresh then
			return alert, true
		end
	end
	-- Calabazas: casi siempre van a por la calabaza más cercana que haya
	if ReplicatedStorage:GetAttribute("Mode") == "CAL" and agent.Root and math.random() < 0.8 then
		local pumpkin = Pumpkins.Nearest(agent.Root.Position)
		if pumpkin then
			return pumpkin, true
		end
	end
	-- Dominio: defienden su bandera si se la están quitando; si no, a por las que no son suyas (casi
	-- siempre la más cercana; los agresivos, a veces la del fondo). El tirador a veces guarda su línea.
	if ReplicatedStorage:GetAttribute("Mode") == "DOM" and agent.Root and agent.Team then
		local flags = Domination.Points()
		local defend, targets = nil, {}
		for _, flag in flags do
			if flag.Owner == agent.Team and flag.Capturing and flag.Capturing ~= agent.Team then
				defend = flag
			elseif flag.Owner ~= agent.Team then
				table.insert(targets, flag)
			end
		end
		local chosen
		if defend and math.random() < 0.7 then
			chosen = defend
		elseif #targets > 0 and not (agent.Role == "Tirador" and math.random() < 0.5) then
			table.sort(targets, function(x, y)
				return (x.Position - agent.Root.Position).Magnitude < (y.Position - agent.Root.Position).Magnitude
			end)
			local aggressive = agent.Role == "Subfusil" or agent.Role == "Escopeta"
			chosen = (aggressive and math.random() < 0.35) and targets[#targets] or targets[1]
		end
		if chosen then
			local spread = chosen.Radius * 0.5
			return chosen.Position + Vector3.new((math.random() - 0.5) * spread, 0, (math.random() - 0.5) * spread), true
		end
	end
	-- Buscar y destruir: los atacantes van juntos al sitio elegido para la ronda y plantan; los
	-- defensores se reparten entre A y B. Con la bomba plantada, los defensores corren a
	-- desactivarla y los atacantes (casi todos) se quedan a protegerla.
	if ReplicatedStorage:GetAttribute("Mode") == "SND" and agent.Team then
		local sites = Bomb.Sites()
		if #sites > 0 then
			local attacking = ReplicatedStorage:GetAttribute("Bomb_Attackers") == agent.Team.Name
			local planted = ReplicatedStorage:GetAttribute("Bomb_State") == "Planted" and ReplicatedStorage:GetAttribute("Bomb_Site")
			if sndPick.Sites ~= sites then
				sndPick.Sites, sndPick.Index = sites, math.random(1, #sites)
			end
			local chosen
			if planted then
				for _, site in sites do
					if site.Letter == planted then
						chosen = site
					end
				end
				if attacking and math.random() < 0.3 then
					chosen = nil -- (alguno sale a cazar)
				end
			elseif attacking then
				-- La bomba en el suelo: van a recogerla (solo la puede plantar quien la lleve)
				local dropped = ReplicatedStorage:GetAttribute("Bomb_Dropped")
				if typeof(dropped) == "Vector3" then
					return dropped + Vector3.new((math.random() - 0.5) * 2, 0, (math.random() - 0.5) * 2), true
				end
				chosen = sites[sndPick.Index]
			elseif not (agent.Role == "Subfusil" and math.random() < 0.4) then
				chosen = sites[(agent.Lane or 0) >= 0 and 1 or math.min(2, #sites)]
			end
			if chosen then
				local spread = chosen.Radius * 0.6
				return chosen.Position + Vector3.new((math.random() - 0.5) * spread, 0, (math.random() - 0.5) * spread), true
			end
		end
	end
	-- En Zona de control, la mitad de las veces van a la zona activa
	local zone = ReplicatedStorage:GetAttribute("ZonePosition")
	if typeof(zone) == "Vector3" and math.random() < 0.75 then
		-- (objetivo de verdad: va con prisa y se recalcula antes, como en Dominio)
		return zone + Vector3.new(math.random(-5, 5), 0, math.random(-5, 5)), true
	end
	-- Pista del equipo: va a donde se ha visto u oído al enemigo (los agresivos casi siempre)
	local clue = bestIntel(agent, 10, 150)
	local chase = ({ Subfusil = 0.85, Escopeta = 0.85, Asalto = 0.55, Ametralladora = 0.35, Tirador = 0 })[agent.Role or "Asalto"] or 0.5
	if clue and math.random() < chase then
		return clue.Position + Vector3.new(math.random(-6, 6), 0, math.random(-6, 6)), true
	end
	-- Si no, patrulla su carril hasta donde le toca según su rol
	return laneGoal(agent)
end

local function computePath(agent, goal)
	agent.Waypoints = nil
	agent.WaypointIndex = 0
	local path = PathfindingService:CreatePath({
		AgentRadius = 2,
		AgentHeight = 5,
		AgentCanJump = true,
		WaypointSpacing = 6,
		Costs = { CrackedLava = math.huge, Water = math.huge }, -- nunca por la lava ni por el agua
	})
	local ok = pcall(function()
		path:ComputeAsync(agent.Root.Position, goal)
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		agent.Waypoints = path:GetWaypoints()
		agent.WaypointIndex = 1
	end
end

---------------------------------------------------------------------------
-- Comportamiento "de jugador": roles, carriles, información del equipo, oído y coberturas
---------------------------------------------------------------------------

-- Lo que sabe cada equipo de dónde está el enemigo (lo que ve u oye cualquier compañero).
-- En todos contra todos cada bot tiene lo suyo.
local intel = {} -- [clave] = { { Position, Time } }
local INTEL_TIME = 12

local function intelKey(agent)
	return (teamMode() and agent.Team) and agent.Team.Name or agent.Name
end

local function reportEnemy(agent, position)
	local key = intelKey(agent)
	local list = intel[key]
	if not list then
		list = {}
		intel[key] = list
	end
	local now = os.clock()
	for _, entry in list do
		if (entry.Position - position).Magnitude < 18 then
			entry.Position, entry.Time = position, now
			return
		end
	end
	table.insert(list, { Position = position, Time = now })
	if #list > 8 then
		table.remove(list, 1)
	end
end

-- La pista más reciente (y cercana) que tiene su equipo
bestIntel = function(agent, maxAge, maxDistance)
	local list = intel[intelKey(agent)]
	if not list or not agent.Root then
		return nil
	end
	local now = os.clock()
	local best, bestScore = nil, math.huge
	for _, entry in list do
		local age = now - entry.Time
		local distance = (entry.Position - agent.Root.Position).Magnitude
		if age < maxAge and distance < maxDistance then
			local score = distance + age * 12
			if score < bestScore then
				best, bestScore = entry, score
			end
		end
	end
	return best
end

-- Radar (racha de 3 de un bot o de un jugador de su equipo): mientras dure, el equipo sabe en
-- todo momento dónde está cada enemigo, como el radar de los jugadores
local radarUntil = {} -- [clave de intel] = os.clock() en que se acaba

function Bots.Radar(key, seconds)
	radarUntil[key] = os.clock() + seconds
end

function Bots.RadarKey(agent)
	return intelKey(agent)
end

local function radarSweep()
	local now = os.clock()
	for key, untilTime in radarUntil do
		if now > untilTime then
			radarUntil[key] = nil
			continue
		end
		for _, agent in agents do
			if agent.Humanoid and agent.Humanoid.Health > 0 and agent.Root and intelKey(agent) == key then
				for _, target in candidates(agent) do
					reportEnemy(agent, target.Head.Position)
				end
				break
			end
		end
	end
end

-- Oído: disparos recientes de enemigos a su alcance
local function hear(agent, now)
	local noise = Combat.Noise
	for i = #noise, 1, -1 do
		local n = noise[i]
		if now - n.Time > 1.2 then
			break -- (van en orden: los más nuevos al final)
		end
		local enemy = n.Model ~= agent.Model and (not teamMode() or n.Team ~= agent.Team)
		if enemy and n.Model and n.Model.Parent then
			local distance = (n.Position - agent.Root.Position).Magnitude
			if distance < n.Range * (CONFIG.Hearing or 1) then
				reportEnemy(agent, n.Position)
				return n.Position
			end
		end
	end
	return nil
end

-- Eje del mapa: de la base propia a la enemiga (para repartir carriles y saber hacia dónde avanzar)
local function mapAxis(agent)
	refreshPoints()
	local own, enemy
	if teamMode() and agent.Team then
		for _, team in Teams:GetTeams() do
			local points = spawnsByColor[team.TeamColor.Name]
			if points and #points > 0 then
				local sum = Vector3.zero
				for _, p in points do
					sum += p
				end
				if team == agent.Team then
					own = sum / #points
				else
					enemy = sum / #points
				end
			end
		end
	end
	if not own or not enemy or (enemy - own).Magnitude < 20 then
		return nil
	end
	return own, enemy
end

-- Punto de patrulla según su rol y su carril: los de subfusil y escopeta se meten hasta el fondo,
-- los de fusil por la mitad y el tirador se queda en su mitad, a ser posible en alto (ventanas).
local ROLE_DEPTH = {
	Asalto = { 0.3, 0.75 },
	Subfusil = { 0.45, 0.98 },
	Escopeta = { 0.45, 0.98 },
	Ametralladora = { 0.25, 0.6 },
	Tirador = { 0.12, 0.5 },
}

laneGoal = function(agent)
	refreshPoints()
	if #ffaPoints == 0 then
		return nil
	end
	local own, enemy = mapAxis(agent)
	if not own then
		return ffaPoints[math.random(1, #ffaPoints)]
	end
	local axis = Vector3.new(enemy.X - own.X, 0, enemy.Z - own.Z)
	local length = axis.Magnitude
	axis = axis.Unit
	local side = Vector3.new(-axis.Z, 0, axis.X)
	local middle = (own + enemy) / 2
	local maxSide = 1
	for _, p in ffaPoints do
		maxSide = math.max(maxSide, math.abs((p - middle):Dot(side)))
	end
	-- El tirador va a un puesto de vigilancia de su mitad (ventana, torre...) si el mapa los tiene
	if agent.Role == "Tirador" and #botSpots > 0 then
		local mine = {}
		for _, spot in botSpots do
			if (spot.Position - own):Dot(axis) / length < 0.55 then
				table.insert(mine, spot)
			end
		end
		if #mine > 0 then
			local spot = mine[math.random(1, #mine)]
			agent.SpotLook = typeof(spot.Look) == "Vector3" and spot.Look or nil
			return spot.Position
		end
	end
	local depth = ROLE_DEPTH[agent.Role or "Asalto"] or ROLE_DEPTH.Asalto
	local anyLane = math.random() < 0.2
	local good, high = {}, {}
	for _, p in ffaPoints do
		local progress = (p - own):Dot(axis) / length
		local lateral = (p - middle):Dot(side) / maxSide
		local lane = lateral < -0.33 and -1 or (lateral > 0.33 and 1 or 0)
		if progress >= depth[1] and progress <= depth[2] and (anyLane or lane == agent.Lane) then
			table.insert(good, p)
			if p.Y > own.Y + 4 then
				table.insert(high, p)
			end
		end
	end
	if agent.Role == "Tirador" and #high > 0 then
		return high[math.random(1, #high)]
	end
	if #good == 0 then
		return ffaPoints[math.random(1, #ffaPoints)]
	end
	return good[math.random(1, #good)]
end

-- Hacia dónde mira mientras espera en un sitio: hacia el lado enemigo (o la pista más reciente)
local function watchPoint(agent)
	local clue = bestIntel(agent, INTEL_TIME, 200)
	if clue then
		return clue.Position
	end
	local own, enemy = mapAxis(agent)
	if own then
		return agent.Root.Position + Vector3.new(enemy.X - own.X, 0, enemy.Z - own.Z).Unit * 50
	end
	return agent.Root.Position + agent.Root.CFrame.LookVector * 50
end

-- Cobertura: un punto cercano desde el que el enemigo no le ve (para retirarse con poca vida)
local function findCover(agent, target)
	local root = agent.Root
	local enemyHead = target.Head.Position
	local away = Vector3.new(root.Position.X - enemyHead.X, 0, root.Position.Z - enemyHead.Z)
	away = away.Magnitude > 0.1 and away.Unit or root.CFrame.LookVector * -1
	local ignore = { agent.Model, target.Model }
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	rayParams.FilterDescendantsInstances = ignore
	local best
	for _, angle in { 70, -70, 110, -110, 40, -40, 150, -150 } do
		local direction = CFrame.Angles(0, math.rad(angle), 0) * away
		for _, distance in { 9, 15 } do
			local point = root.Position + direction * distance
			-- Que se pueda llegar en línea recta y que desde el enemigo no se vea
			local path = workspace:Raycast(root.Position, direction * distance, rayParams)
			if not path and safeGround(point) then
				local seen = workspace:Raycast(enemyHead, (point + Vector3.new(0, 1.5, 0)) - enemyHead, rayParams)
				if seen then
					best = point
					break
				end
			end
		end
		if best then
			break
		end
	end
	return best
end

-- Daño de un arma a una distancia (cae entre FalloffStart y FalloffEnd)
local function damageAt(def, distance)
	local start, finish = def.FalloffStart or 100, def.FalloffEnd or 300
	if distance <= start then
		return def.Damage
	end
	local alpha = math.clamp((distance - start) / math.max(1, finish - start), 0, 1)
	return def.Damage + ((def.MinDamage or def.Damage) - def.Damage) * alpha
end

-- Recarga (los demás ven el arma recargando: atributo Reloading del Tool)
local function startReload(agent, def, now)
	local tool = agent.Tool
	local empty = (agent.Mag or 0) <= 0
	agent.Mag = def.MagSize
	-- (como los jugadores: con balas aún en el cargador, recarga táctica más rápida)
	agent.ReloadUntil = now + Weapons.ReloadDuration(def, empty) * (1.05 + math.random() * 0.2)
	if tool then
		tool:SetAttribute("Reloading", true)
		task.delay(agent.ReloadUntil - now, function()
			if tool.Parent then
				tool:SetAttribute("Reloading", false)
			end
		end)
	end
end

local function shoot(agent, target, distance, now)
	local tool = agent.Tool
	local def = Weapons.Get(agent.Weapon)
	if not tool or not tool.Parent or not def then
		return
	end
	-- Cargador de verdad: al vaciarlo recarga (y mientras tanto no dispara)
	if agent.Mag <= 0 then
		startReload(agent, def, now)
		return
	end
	agent.Mag -= 1
	-- Dificultad según el rango del jugador al que disparan (contra otros bots, normal)
	local targetPlayer = Players:GetPlayerFromCharacter(target.Model)
	local rankSkill = targetPlayer and CONFIG.SkillByRank and CONFIG.SkillByRank[targetPlayer:GetAttribute("Rank") or 1] or 1
	local skill = rankSkill * (agent.Skill or 1)
	-- La puntería se asienta: los primeros tiros sobre un objetivo nuevo fallan más
	local settle = math.clamp((now - (agent.AimStart or now)) / 0.9 + 0.35, 0.35, 1)
	local accuracy = math.min(0.95, CONFIG.Accuracy * skill) * settle
	-- (los fusiles de precisión apenas pierden puntería de lejos; las escopetas, mucha)
	local falloff = CONFIG.AccuracyFalloff * math.clamp((def.Spread or 1.6) / 1.6, 0.25, 3)
	local chance = math.clamp(accuracy - distance * falloff, 0.04, accuracy)
	if agent.Root.AssemblyLinearVelocity.Magnitude > 8 then
		chance *= 0.8 -- disparar andando
	end
	if agent.Crouched then
		chance = math.min(0.95, chance * 1.15) -- agachado apunta más estable
	end
	local targetRoot = target.Model:FindFirstChild("HumanoidRootPart")
	if targetRoot and targetRoot.AssemblyLinearVelocity.Magnitude > 12 then
		chance *= 0.7 -- cuesta más acertar a quien se mueve rápido
	end
	-- Solo asoma la cabeza (el cuerpo está detrás de algo): solo puede darle en la cabeza, que es
	-- un blanco más pequeño. Antes el 88 % de los aciertos dañaba el cuerpo a través de la caja.
	local headOnly = false
	local head = agent.Model:FindFirstChild("Head")
	if targetRoot and head then
		local ignore = { agent.Model }
		local map = workspace:FindFirstChild("Map")
		local boundary = map and map:FindFirstChild("Boundary")
		if boundary then
			table.insert(ignore, boundary)
		end
		rayParams.FilterDescendantsInstances = ignore
		local bodyHit = workspace:Raycast(head.Position, targetRoot.Position - head.Position, rayParams)
		headOnly = bodyHit ~= nil and not bodyHit.Instance:IsDescendantOf(target.Model)
	end
	if headOnly then
		chance *= 0.45
	end
	local pellets = math.max(1, def.Pellets or 1)
	local hits = 0
	for _ = 1, pellets do
		if math.random() < chance then
			hits += 1
		end
	end
	local endpoints = {}
	if hits > 0 then
		local headshot = headOnly or math.random() < 0.12 * skill
		local damage = damageAt(def, distance) * hits * CONFIG.DamageScale * rankSkill
		if headshot then
			damage *= def.HeadshotMultiplier or 1.5
			table.insert(endpoints, target.Head.Position)
		else
			table.insert(endpoints, target.Head.Position + Vector3.new(math.random() - 0.5, -0.8 - math.random() * 1.2, math.random() - 0.5))
		end
		Combat.BotDamage(agent, target.Humanoid, damage, agent.Weapon)
	end
	while #endpoints < math.min(3, pellets) or #endpoints == 0 do
		local miss = Vector3.new(math.random() - 0.5, math.random() - 0.3, math.random() - 0.5).Unit * (2 + math.random() * 3)
		table.insert(endpoints, target.Head.Position + miss)
	end
	Remotes.ShotFX:FireAllClients(tool, endpoints)
	if head then
		Combat.ReportNoise(head.Position, agent.Team, agent.Model, agent.Weapon)
	end
end

-- ¿Techo bajo encima? La granada va en parábola (sube ~9 studs a media distancia y hasta ~28 de lejos):
-- bajo techo chocaba y caía junto al bot
local function lowCeiling(agent, distance)
	local head = agent.Model:FindFirstChild("Head")
	if not head then
		return true
	end
	rayParams.FilterDescendantsInstances = { agent.Model }
	local need = distance > 27 and 30 or 12
	return workspace:Raycast(head.Position, Vector3.new(0, need, 0), rayParams) ~= nil
end

-- Granada al último sitio donde vio al enemigo (si se ha escondido detrás de algo)
local function throwGrenade(agent, position)
	local head = agent.Model:FindFirstChild("Head")
	if not head then
		return false
	end
	local grenadeDef = Weapons.Grenade
	return Grenades.BotThrow(agent.Model, head.Position + agent.Root.CFrame.LookVector * 2, position, function(blast)
		local info = grenadeDef.Explosive
		local ignore = { agent.Model }
		local map = workspace:FindFirstChild("Map")
		local boundary = map and map:FindFirstChild("Boundary")
		if boundary then
			table.insert(ignore, boundary)
		end
		for _, target in candidates(agent) do
			local root = target.Model:FindFirstChild("HumanoidRootPart")
			local distance = root and (root.Position - blast).Magnitude
			if distance and distance <= info.Radius then
				rayParams.FilterDescendantsInstances = ignore
				local hit = workspace:Raycast(blast, root.Position - blast, rayParams)
				if not hit or hit.Instance:IsDescendantOf(target.Model) then
					local damage = info.Damage + (info.MinDamage - info.Damage) * (distance / info.Radius)
					Combat.BotDamage(agent, target.Humanoid, damage * CONFIG.DamageScale, "Grenade")
				end
			end
		end
	end)
end

-- Zombi (Infección): persigue al superviviente más cercano (aunque no lo vea, con el buscador de
-- caminos) y le araña cuando lo tiene al alcance
local function zombieThink(agent, humanoid, root, now)
	local def = Weapons.Get("Claws")
	local best, bestDistance = nil, math.huge
	for _, target in candidates(agent) do
		local distance = (target.Head.Position - root.Position).Magnitude
		if distance < bestDistance then
			best, bestDistance = target, distance
		end
	end
	if not best then
		humanoid:MoveTo(root.Position)
		return
	end
	local targetRoot = best.Model:FindFirstChild("HumanoidRootPart") or best.Head
	if bestDistance <= def.Range + 1 and math.abs(targetRoot.Position.Y - root.Position.Y) < 4 and canSee(agent, best) then
		humanoid:MoveTo(targetRoot.Position)
		if now >= agent.NextShot then
			agent.NextShot = now + def.Cooldown + math.random() * 0.3
			local targetPlayer = Players:GetPlayerFromCharacter(best.Model)
			local skill = targetPlayer and CONFIG.SkillByRank and CONFIG.SkillByRank[targetPlayer:GetAttribute("Rank") or 1] or 1
			Combat.BotDamage(agent, best.Humanoid, def.Damage * CONFIG.DamageScale * 1.4 * skill, "Claws")
		end
		return
	end
	-- Cerca y a la vista: directo; si no, por el camino (se recalcula cada poco)
	if bestDistance < 30 and canSee(agent, best) then
		local flat = Vector3.new(targetRoot.Position.X - root.Position.X, 0, targetRoot.Position.Z - root.Position.Z)
		if flat.Magnitude < 0.1 or safeGround(root.Position + flat.Unit * 4) then
			agent.Waypoints = nil
			humanoid:MoveTo(targetRoot.Position)
			return
		end
		-- (hay agua o lava en medio: por el camino)
	end
	if not agent.Computing and (not agent.Waypoints or now > agent.GoalDeadline or agent.WaypointIndex > #agent.Waypoints) then
		agent.Computing = true
		agent.GoalDeadline = now + 2.5
		local goal = targetRoot.Position
		task.spawn(function()
			computePath(agent, goal)
			agent.Computing = false
			if not agent.Waypoints and agent.Humanoid then
				agent.Humanoid:MoveTo(goal)
			end
		end)
		return
	end
	local waypoints = agent.Waypoints
	if waypoints and waypoints[agent.WaypointIndex] then
		local waypoint = waypoints[agent.WaypointIndex]
		if (Vector3.new(waypoint.Position.X, root.Position.Y, waypoint.Position.Z) - root.Position).Magnitude < 3 then
			agent.WaypointIndex += 1
		else
			if waypoint.Action == Enum.PathWaypointAction.Jump then
				humanoid.Jump = true
			end
			humanoid:MoveTo(waypoint.Position)
		end
	end
end

local function lookAt(root, position)
	local look = Vector3.new(position.X, root.Position.Y, position.Z)
	if (look - root.Position).Magnitude > 0.5 then
		root.CFrame = CFrame.lookAt(root.Position, look)
	end
end

-- Inclinación del arma (los clientes la ven con RiflePose): hacia la cabeza del enemigo, o recta
local function aimPitch(agent, position)
	local head = agent.Model:FindFirstChild("Head")
	local pitch = 0
	if head and position then
		local offset = position - head.Position
		local flat = Vector3.new(offset.X, 0, offset.Z).Magnitude
		pitch = math.atan2(offset.Y, math.max(flat, 0.1))
	end
	pitch = math.floor(math.clamp(pitch, -1.3, 1.3) * 20 + 0.5) / 20
	if agent.Model:GetAttribute("AimPitch") ~= pitch then
		agent.Model:SetAttribute("AimPitch", pitch)
	end
end

-- Pelea con un enemigo a la vista: se mueve según su rol, se cubre si le queda poca vida y dispara
-- en ráfagas (a quemarropa, a todo lo que da el arma)
-- Agacharse (como los jugadores: baja la cadera, se ve y se le da peor). Se levanta solo al
-- pasar CrouchUntil (ver think)
local function setCrouch(agent, humanoid, on)
	if agent.BaseHip == nil then
		agent.BaseHip = humanoid.HipHeight
	end
	agent.Crouched = on
	local target = agent.BaseHip - (on and (GameConfig.CrouchDrop or 1.3) or 0)
	if math.abs(humanoid.HipHeight - target) > 0.01 then
		humanoid.HipHeight = target
	end
end

local function fight(agent, humanoid, root, target, distance, now)
	if agent.Target ~= target.Model then
		agent.Target = target.Model
		agent.AimStart = now + (agent.Reaction or CONFIG.Reaction)
		agent.NextShot = math.max(agent.NextShot, agent.AimStart)
		agent.BurstLeft = 0
	end
	agent.LastSeenPosition, agent.LastSeenTime = target.Head.Position, now
	agent.HoldUntil = 0
	reportEnemy(agent, target.Head.Position)
	humanoid.WalkSpeed = CONFIG.WalkSpeed
	humanoid.AutoRotate = false
	lookAt(root, target.Head.Position)
	aimPitch(agent, target.Head.Position)

	-- Con poca vida se retira a cubierto (la vida se recupera sola) y luego vuelve
	if humanoid.Health < humanoid.MaxHealth * 0.35 and agent.Role ~= "Escopeta" and now > (agent.NextRetreat or 0) then
		agent.NextRetreat = now + 11
		local cover = findCover(agent, target)
		if cover then
			-- (la vida empieza a recuperarse a los HealthRegen.Delay s: antes volvía a los 2,2 s sin curarse)
			agent.RetreatUntil = now + ((GameConfig.HealthRegen and GameConfig.HealthRegen.Delay or 4) + 1.5)
			setCrouch(agent, humanoid, false)
			humanoid.WalkSpeed = CONFIG.SprintSpeed or CONFIG.WalkSpeed
			humanoid.AutoRotate = true
			humanoid:MoveTo(cover)
			return
		end
	end

	-- Movimiento: cada rol pelea a su manera
	if now >= agent.NextStrafe then
		local role = agent.Role
		local dest
		local crouch = false
		if role == "Tirador" then
			-- Quieto para apuntar; de vez en cuando un paso al lado
			agent.NextStrafe = now + 2.5 + math.random() * 2
			if math.random() < 0.35 then
				dest = root.Position + root.CFrame.RightVector * (math.random() < 0.5 and -4 or 4)
			else
				dest = root.Position
				crouch = math.random() < 0.65 -- (quieto, casi siempre agachado)
			end
		elseif (role == "Asalto" or role == "Ametralladora") and distance > 45 and math.random() < 0.35 then
			-- De lejos, a veces se agacha y aguanta la posición
			agent.NextStrafe = now + 1.2 + math.random() * 1.3
			dest = root.Position
			crouch = true
		else
			agent.NextStrafe = now + 0.45 + math.random() * 0.7
			local strafe = (math.random() < 0.5 and -1 or 1) * (role == "Ametralladora" and 3 or 6)
			dest = root.Position + root.CFrame.RightVector * strafe
			-- Los de corta distancia se echan encima; todos se acercan si está muy lejos
			local close = (role == "Subfusil" and 18) or (role == "Escopeta" and 9) or 75
			if distance > close then
				dest += root.CFrame.LookVector * math.min(10, distance - close)
			end
		end
		if not safeGround(dest) then
			dest = root.Position - (dest - root.Position) -- (al otro lado, si no hay agua)
		end
		if safeGround(dest) then
			humanoid:MoveTo(dest)
		end
		setCrouch(agent, humanoid, crouch)
		agent.CrouchUntil = crouch and agent.NextStrafe + 0.2 or 0
		if not crouch and math.random() < CONFIG.JumpChance and role ~= "Tirador" then
			humanoid.Jump = true
		end
	end
	if agent.Crouched then
		humanoid.WalkSpeed = GameConfig.CrouchSpeed or 10
	end

	-- Disparo: ráfagas controladas de lejos con armas automáticas, a todo trapo de cerca
	if now < (agent.ReloadUntil or 0) then
		return
	end
	local def = Weapons.Get(agent.Weapon)
	local interval = 1 / math.min(def and def.FireRate or 6, CONFIG.MaxFireRate)
	local shots = 0
	while now >= agent.NextShot and shots < 2 do
		shots += 1
		if def and def.Automatic and distance > 35 then
			if agent.BurstLeft <= 0 then
				agent.BurstLeft = math.random(3, 6)
				agent.NextShot = now + 0.22 + math.random() * 0.3
				break
			end
			agent.BurstLeft -= 1
		end
		shoot(agent, target, distance, now)
		agent.NextShot = math.max(agent.NextShot + interval, now - interval) + math.random() * 0.04
		if now < (agent.ReloadUntil or 0) then
			break
		end
	end
end

-- Atascado contra algo: salta y, si sigue, busca otro camino
local function checkStuck(agent, humanoid, root, now)
	local moved = agent.StuckPosition and (root.Position - agent.StuckPosition).Magnitude or math.huge
	if moved > 1.5 then
		agent.StuckPosition, agent.StuckTime = root.Position, now
		return
	end
	local stuck = now - (agent.StuckTime or now)
	if stuck > 1.4 then
		humanoid.Jump = true
	end
	if stuck > 3 then
		agent.Waypoints, agent.GoalDeadline = nil, 0
		agent.StuckPosition, agent.StuckTime = root.Position, now
	end
end

-- Buscar y destruir: ¿está dentro de un sitio en el que tiene que plantar o desactivar? (entonces no
-- sale corriendo detrás de un ruido ni de alguien que ha perdido de vista)
local function sndBusy(agent, root)
	if ReplicatedStorage:GetAttribute("Mode") ~= "SND" or not agent.Team then
		return false
	end
	local attacking = ReplicatedStorage:GetAttribute("Bomb_Attackers") == agent.Team.Name
	local planted = ReplicatedStorage:GetAttribute("Bomb_State") == "Planted"
	for _, site in Bomb.Sites() do
		local offset = site.Position - root.Position
		if Vector3.new(offset.X, 0, offset.Z).Magnitude <= site.Radius then
			local carrying = agent.Model and ReplicatedStorage:GetAttribute("Bomb_Carrier") == agent.Model.Name
			if (attacking and not planted and carrying) or (not attacking and planted and ReplicatedStorage:GetAttribute("Bomb_Site") == site.Letter) then
				return true
			end
		end
	end
	return false
end

local function think(agent)
	local humanoid, root = agent.Humanoid, agent.Root
	if not humanoid or humanoid.Health <= 0 or not root or not root.Parent then
		return
	end
	if frozen() or (agent.Team and agent.Team.Name == ReplicatedStorage:GetAttribute("HeldTeam")) then
		humanoid:MoveTo(root.Position)
		return
	end
	local now = os.clock()
	if agent.Zombie then
		zombieThink(agent, humanoid, root, now)
		return
	end
	local target, distance = findTarget(agent)
	-- (se levanta al acabar su rato agachado o si deja de ver al enemigo)
	if agent.Crouched and (now > (agent.CrouchUntil or 0) or (not target and not agent.HoldCrouch)) then
		setCrouch(agent, humanoid, false)
	end
	local heard = hear(agent, now)
	if not target then
		checkAlert(agent, now)
	end
	-- Con la bandera a cuestas no se para a pelear: dispara mientras sigue su camino a casa
	if target and agent.CarryingFlag then
		-- (si lo había perdido de vista más de 1 s, vuelve a reaccionar como con uno nuevo)
		if agent.Target ~= target.Model or now - (agent.CarrierSeen or 0) > 1 then
			agent.Target = target.Model
			agent.AimStart = now + (agent.Reaction or CONFIG.Reaction)
			agent.NextShot = math.max(agent.NextShot, agent.AimStart)
		end
		agent.CarrierSeen = now
		reportEnemy(agent, target.Head.Position)
		if now >= agent.NextShot and now >= (agent.ReloadUntil or 0) then
			local def = Weapons.Get(agent.Weapon)
			agent.NextShot = now + 1 / math.min(def and def.FireRate or 6, CONFIG.MaxFireRate) + math.random() * 0.12
			shoot(agent, target, distance, now)
		end
		target = nil
	end
	-- Retirándose a cubierto: sigue hasta llegar (sin pararse a pelear)
	if now < (agent.RetreatUntil or 0) and not agent.CarryingFlag then
		-- (si se queda empujando algo, salta y, si no avanza, deja de retirarse)
		checkStuck(agent, humanoid, root, now)
		if now - (agent.StuckTime or now) < 2 then
			return
		end
		agent.RetreatUntil = 0
	end
	if target then
		fight(agent, humanoid, root, target, distance, now)
		return
	end
	-- (el portador de la bandera conserva su objetivo: si no, el retraso de reacción no acabaría nunca)
	if not agent.CarryingFlag then
		agent.Target = nil
	end
	humanoid.AutoRotate = true
	aimPitch(agent, nil)

	-- Recarga táctica cuando no hay nadie delante
	local def = Weapons.Get(agent.Weapon)
	if def and agent.Mag < def.MagSize * 0.4 and now >= (agent.ReloadUntil or 0) then
		startReload(agent, def, now)
	end

	-- Acaba de perder de vista al enemigo: granada si se ha escondido cerca; si no, mira hacia allí
	-- un momento (pre-apuntar) antes de ir a buscarle
	local busy = sndBusy(agent, root)
	if busy and (agent.HoldUntil or 0) <= now then
		agent.HoldUntil = now + 1 -- (sigue plantando o desactivando)
	end
	-- Plantando o desactivando: agachado y quieto, como un jugador
	agent.HoldCrouch = busy
	if busy and not target then
		setCrouch(agent, humanoid, true)
		agent.CrouchUntil = now + 0.5
		humanoid:MoveTo(root.Position)
	end
	local lostFor = agent.LastSeenTime and now - agent.LastSeenTime or math.huge
	if lostFor < 3 and agent.LastSeenPosition and not busy then
		local away = (agent.LastSeenPosition - root.Position).Magnitude
		if lostFor > 0.6 and away > 14 and away < 48 and now >= (agent.NextGrenade or 0) and math.random() < 0.3 and not lowCeiling(agent, away) then
			agent.NextGrenade = now + (CONFIG.GrenadeCooldown or 18) * (0.8 + math.random() * 0.4)
			lookAt(root, agent.LastSeenPosition)
			throwGrenade(agent, agent.LastSeenPosition)
		end
		if agent.Role ~= "Subfusil" and agent.Role ~= "Escopeta" and lostFor < 1.5 then
			humanoid.AutoRotate = false
			lookAt(root, agent.LastSeenPosition)
			humanoid:MoveTo(root.Position)
			return
		end
		if not agent.ChasedSeen then
			agent.ChasedSeen = true
			agent.AlertPosition, agent.AlertTime = agent.LastSeenPosition, now
			agent.Waypoints, agent.GoalDeadline, agent.HoldUntil = nil, 0, 0
		end
	else
		agent.ChasedSeen = false
	end
	-- Ha oído disparos cerca: deja lo que esté haciendo y va (el tirador solo se gira)
	if heard and not agent.CarryingFlag and not busy and now > (agent.NextHeard or 0) then
		agent.NextHeard = now + 4
		if agent.Role == "Tirador" and (agent.HoldUntil or 0) > now then
			agent.HoldLook = heard
		elseif (heard - root.Position).Magnitude > 12 then
			agent.AlertPosition, agent.AlertTime = heard, now
			agent.Waypoints, agent.GoalDeadline, agent.HoldUntil = nil, 0, 0
		end
	end

	-- Esperando en un sitio (el tirador vigila su línea; los demás echan un vistazo)
	if (agent.HoldUntil or 0) > now then
		humanoid:MoveTo(root.Position)
		humanoid.AutoRotate = false
		local look = agent.HoldLook or watchPoint(agent)
		local scan = math.sin(now * 0.7 + (agent.Seed or 0)) * math.rad(agent.Role == "Tirador" and 25 or 50)
		local direction = Vector3.new(look.X - root.Position.X, 0, look.Z - root.Position.Z)
		if direction.Magnitude > 0.5 then
			lookAt(root, root.Position + CFrame.Angles(0, scan, 0) * direction.Unit * 10)
		end
		return
	end

	-- Sin enemigos a la vista: seguir el camino o buscar uno nuevo
	local waypoints = agent.Waypoints
	if agent.Computing then
		return
	end
	if not waypoints or agent.WaypointIndex > #waypoints or now > agent.GoalDeadline then
		if now < agent.GoalDeadline and not waypoints then
			return -- sin camino: va en línea recta un rato antes de volver a intentarlo
		end
		-- Ha llegado: se para un momento a mirar (el tirador se aposta un buen rato)
		if waypoints and agent.WaypointIndex > #waypoints and not agent.Arrived then
			agent.Arrived = true
			-- (en un puesto de vigilancia, mira hacia donde manda el puesto)
			agent.HoldLook = (agent.SpotLook and agent.GoalPosition and (agent.GoalPosition - root.Position).Magnitude < 6) and agent.SpotLook or nil
			agent.HoldUntil = now + (agent.Role == "Tirador" and (12 + math.random() * 14) or (0.6 + math.random() * 1.6))
			-- (en Buscar y destruir, se queda a plantar o a desactivar)
			if ReplicatedStorage:GetAttribute("Mode") == "SND" then
				local attacking = ReplicatedStorage:GetAttribute("Bomb_Attackers") == (agent.Team and agent.Team.Name)
				local planted = ReplicatedStorage:GetAttribute("Bomb_State") == "Planted"
				for _, site in Bomb.Sites() do
					local offset = site.Position - root.Position
					if Vector3.new(offset.X, 0, offset.Z).Magnitude <= site.Radius then
						if attacking and not planted then
							agent.HoldUntil = now + 4.6
						elseif planted and ReplicatedStorage:GetAttribute("Bomb_Site") == site.Letter then
							agent.HoldUntil = now + (attacking and 6 or 6.6)
						end
					end
				end
			end
			-- (en Zona de control, dentro de la zona activa se queda a ocuparla en vez de irse enseguida)
			local zone = ReplicatedStorage:GetAttribute("ZonePosition")
			if ReplicatedStorage:GetAttribute("Mode") == "KOTH" and typeof(zone) == "Vector3" then
				local offset = zone - root.Position
				if Vector3.new(offset.X, 0, offset.Z).Magnitude <= 9 then
					agent.HoldUntil = now + 3
				end
			end
			-- (en una bandera de Dominio que no es suya, se queda a capturarla)
			if ReplicatedStorage:GetAttribute("Mode") == "DOM" then
				for _, flag in Domination.Points() do
					local offset = flag.Position - root.Position
					if flag.Owner ~= agent.Team and Vector3.new(offset.X, 0, offset.Z).Magnitude <= flag.Radius then
						agent.HoldUntil = now + 3
					end
				end
			end
			return
		end
		agent.Arrived = false
		local goal, objective = pickGoal(agent)
		-- (las banderas se mueven: el camino hacia ellas se recalcula antes)
		agent.GoalDeadline = now + (objective and 5 or 14)
		agent.GoalPosition = goal
		agent.Urgent = objective
		if goal then
			agent.Computing = true
			task.spawn(function()
				computePath(agent, goal)
				agent.Computing = false
				-- (si mientras tanto le dispararon, no se pisa la alerta: el siguiente turno va hacia allí)
				if not agent.Waypoints and agent.Humanoid and not agent.AlertPosition then
					agent.Humanoid:MoveTo(goal)
					agent.GoalDeadline = os.clock() + 3
				end
			end)
		else
			agent.GoalDeadline = now + 3
		end
		return
	end
	-- De camino: corre si no espera encontrarse a nadie; anda (y atento) cerca de donde hay enemigos
	local clue = bestIntel(agent, 6, 45)
	humanoid.WalkSpeed = (clue or agent.Role == "Tirador" and agent.Urgent) and CONFIG.WalkSpeed or (CONFIG.SprintSpeed or CONFIG.WalkSpeed)
	checkStuck(agent, humanoid, root, now)
	local waypoint = waypoints[agent.WaypointIndex]
	if (Vector3.new(waypoint.Position.X, root.Position.Y, waypoint.Position.Z) - root.Position).Magnitude < 3 then
		agent.WaypointIndex += 1
		return
	end
	if waypoint.Action == Enum.PathWaypointAction.Jump then
		humanoid.Jump = true
	end
	humanoid:MoveTo(waypoint.Position)
end

local spawnAgent, safeSpawn

-- Rol del bot (GameConfig.Bots.Roles): al azar según su peso, sin pasar del máximo por equipo, y el
-- carril con menos compañeros. Cada bot tiene además su puntería y sus reflejos.
chooseRole = function(agent)
	local roles = CONFIG.Roles
	agent.Skill = 0.85 + math.random() * 0.3
	agent.Reaction = CONFIG.Reaction * (0.75 + math.random() * 0.5) / agent.Skill
	agent.Seed = math.random() * 10
	local laneCount = { [-1] = 0, [0] = 0, [1] = 0 }
	local roleCount = {}
	for _, other in agents do
		if other ~= agent and other.Team == agent.Team then
			if other.Lane then
				laneCount[other.Lane] += 1
			end
			if other.Role then
				roleCount[other.Role] = (roleCount[other.Role] or 0) + 1
			end
		end
	end
	local lane, fewest = 0, math.huge
	for _, l in { 0, -1, 1 } do
		if laneCount[l] < fewest then
			lane, fewest = l, laneCount[l]
		end
	end
	agent.Lane = lane
	if not roles or #roles == 0 then
		agent.Role = "Asalto"
		return
	end
	local pool, total = {}, 0
	for _, role in roles do
		if not role.Max or (roleCount[role.Name] or 0) < role.Max then
			table.insert(pool, role)
			total += role.Weight or 1
		end
	end
	local pick = math.random() * total
	local chosen = pool[1] or roles[1]
	for _, role in pool do
		pick -= role.Weight or 1
		if pick <= 0 then
			chosen = role
			break
		end
	end
	agent.Role = chosen.Name
	local options = {}
	for _, name in chosen.Weapons do
		if Weapons.Get(name) then
			table.insert(options, name)
		end
	end
	agent.RoleWeapon = #options > 0 and options[math.random(1, #options)] or nil
end

-- Estadísticas del bot para el marcador (Tab) de los clientes
local function statsOf(agent)
	if not statsFolder or not table.find(agents, agent) then
		return nil
	end
	local entry = statsFolder:FindFirstChild(agent.Name)
	if not entry then
		entry = Instance.new("Folder")
		entry.Name = agent.Name
		entry:SetAttribute("Kills", 0)
		entry:SetAttribute("Deaths", 0)
		entry:SetAttribute("Score", 0)
		entry.Parent = statsFolder
	end
	entry:SetAttribute("Team", agent.Team and agent.Team.Name or "")
	return entry
end

-- Suma a una estadística del bot (Kills, Deaths o Score); lo llama Round al registrar bajas
function Bots.AddStat(agent, field, amount)
	local entry = agent and statsOf(agent)
	if entry then
		entry:SetAttribute(field, (entry:GetAttribute(field) or 0) + amount)
	end
end


-- Nombre que no lleve ya otro bot activo
local function nextName()
	for _ = 1, #NAMES do
		nameIndex = nameIndex % #NAMES + 1
		local name = "Bot " .. NAMES[nameIndex]
		if not Combat.BotsByName[name] then
			return name
		end
	end
	return "Bot " .. math.random(100, 999)
end

-- Animaciones R15 estándar de Roblox. El script Animate de los personajes es local y no corre en un
-- NPC, así que el servidor las reproduce (se replican a todos).
local ANIMS = {
	Idle = "rbxassetid://507766388",
	Run = "rbxassetid://507767714",
	Jump = "rbxassetid://507765000",
	Fall = "rbxassetid://507767968",
	Hold = "rbxassetid://507768375", -- brazo estirado sujetando el arma
}

local function animate(humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local tracks = {}
	for key, id in ANIMS do
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(animation)
		end)
		if ok and track then
			tracks[key] = track
		end
	end
	local current
	local function play(key, fade)
		local track = tracks[key]
		if track and current ~= track then
			if current then
				current:Stop(fade or 0.2)
			end
			current = track
			track.Looped = key ~= "Jump"
			track:Play(fade or 0.2)
		end
	end
	if tracks.Hold then
		tracks.Hold.Priority = Enum.AnimationPriority.Action
		tracks.Hold.Looped = true
		tracks.Hold:Play()
	end
	play("Idle")
	humanoid.Running:Connect(function(speed)
		play(speed > 0.5 and "Run" or "Idle")
		if tracks.Run then
			tracks.Run:AdjustSpeed(math.max(speed / 16, 0.5))
		end
	end)
	humanoid.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Jumping then
			play("Jump", 0.1)
		elseif new == Enum.HumanoidStateType.Freefall then
			play("Fall", 0.2)
		elseif new == Enum.HumanoidStateType.Landed then
			play("Idle", 0.1)
		end
	end)
end

spawnAgent = function(agent)
	if agent.Spawning then
		return false
	end
	agent.Team = agent.Team or pickTeam()
	if ReplicatedStorage:GetAttribute("Infection") == "On" and agent.Team and agent.Team.Name == ReplicatedStorage:GetAttribute("TeamB") then
		agent.Zombie = true
	end
	agent.Spawning = true
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescriptionAsync(makeDescription(agent.Team, agent.Zombie), Enum.HumanoidRigType.R15)
	end)
	if not ok then
		ok, model = pcall(function()
			return Players:CreateHumanoidModelFromDescription(makeDescription(agent.Team, agent.Zombie), Enum.HumanoidRigType.R15)
		end)
	end
	agent.Spawning = false
	if not ok or not model then
		warn("[Bots] No se pudo crear el bot:", model)
		return false
	end
	-- Lo quitaron (fin de ronda) mientras se creaba
	if not table.find(agents, agent) or not folder then
		model:Destroy()
		return false
	end
	local localAnimate = model:FindFirstChild("Animate")
	if localAnimate then
		localAnimate:Destroy()
	end
	model.Name = agent.Name
	model:SetAttribute("Bot", true)
	model:SetAttribute("Team", agent.Team and agent.Team.Name or "")
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	humanoid.DisplayName = agent.Name
	humanoid.MaxHealth = 100
	humanoid.Health = 100
	humanoid.WalkSpeed = CONFIG.WalkSpeed
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	-- Primera vez en la base; al reaparecer, en el punto más seguro (como los jugadores: SpawnPicker)
	local spawnAt = spawnPoint(agent.Team)
	if agent.HasSpawned and SpawnPicker.Enabled() then
		local picked = SpawnPicker.Pick(agent.Team, nil)
		if picked then
			spawnAt = picked + Vector3.new(0, 4, 0)
		end
	end
	agent.HasSpawned = true
	model:PivotTo(CFrame.new(spawnAt) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	model.Parent = folder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	agent.Model, agent.Humanoid, agent.Root = model, humanoid, root
	agent.BaseHip, agent.Crouched, agent.CrouchUntil = nil, false, 0
	statsOf(agent)
	animate(humanoid)
	if agent.Zombie then
		agent.Weapon = "Claws"
	else
		-- Rol y arma (los conserva al reaparecer), carril, puntería y reflejos propios
		if not agent.Role then
			chooseRole(agent)
		end
		agent.Weapon = agent.RoleWeapon or CONFIG.Weapons[math.random(1, #CONFIG.Weapons)]
	end
	model:SetAttribute("Role", not agent.Zombie and agent.Role or nil) -- (para el destello de la mira del tirador)
	-- Traje de operador al azar (cada bot conserva el suyo al reaparecer)
	if agent.Outfit == nil then
		agent.Outfit = (#BOT_OUTFITS > 0 and math.random() < (CONFIG.OutfitChance or 0)) and BOT_OUTFITS[math.random(1, #BOT_OUTFITS)] or false
	end
	-- En los mapas realistas (tipo shooter militar) van de soldado, con el color de su equipo
	local map = workspace:FindFirstChild("Map")
	local soldier = map ~= nil and map:GetAttribute("Realistic") == true and not agent.Zombie
	if soldier then
		pcall(Outfits.Apply, model, Outfits.Soldier(agent.Team and agent.Team.TeamColor.Color))
	elseif agent.Outfit and not agent.Zombie then
		pcall(Outfits.Apply, model, agent.Outfit)
	end
	if agent.Zombie then
		local claws = Weapons.Get("Claws")
		Zombie.Apply(model, GameConfig.ModeSettings.INF.ZombieHealth)
		humanoid.WalkSpeed = CONFIG.WalkSpeed * (claws.WalkSpeedMultiplier or 1)
	end
	if agent.Skin == nil then
		agent.Skin = (#BOT_SKINS > 0 and math.random() < 0.5) and BOT_SKINS[math.random(1, #BOT_SKINS)] or "Default"
	end
	if agent.Charm == nil then
		agent.Charm = (#BOT_CHARMS > 0 and math.random() < 0.3) and BOT_CHARMS[math.random(1, #BOT_CHARMS)] or false
	end
	agent.Tool = Loadout.MakeTool(agent.Weapon, (agent.Zombie or soldier) and "Default" or agent.Skin, (not soldier and agent.Charm) or nil)
	agent.Tool.Parent = model
	humanoid:EquipTool(agent.Tool)
	agent.Shots, agent.NextShot, agent.NextStrafe, agent.GoalDeadline = 0, 0, 0, 0
	agent.AlertPosition, agent.AlertTime = nil, nil
	agent.Waypoints, agent.Target = nil, nil
	local weaponDef = Weapons.Get(agent.Weapon)
	agent.Mag = weaponDef and weaponDef.MagSize or 30
	agent.ReloadUntil, agent.BurstLeft, agent.RetreatUntil, agent.HoldUntil = 0, 0, 0, 0
	agent.LastSeenPosition, agent.LastSeenTime, agent.Arrived = nil, nil, false
	agent.NextGrenade = os.clock() + 8 + math.random() * 10
	agent.StuckPosition, agent.StuckTime = nil, nil
	humanoid.WalkSpeed = agent.Zombie and humanoid.WalkSpeed or (CONFIG.SprintSpeed or CONFIG.WalkSpeed)

	Combat.WatchHumanoid(humanoid, nil, agent.Name, agent)
	humanoid.Died:Connect(function()
		agent.Humanoid = nil
		-- (el cuerpo queda unos segundos en el suelo como muñeco de trapo; ver Ragdoll)
		task.delay(4.5, function()
			model:Destroy()
		end)
		task.delay(GameConfig.RespawnTime + 1, function()
			if table.find(agents, agent) and not agent.Humanoid and desiredCount() >= #agents and not noRespawn() then
				safeSpawn(agent)
			end
		end)
	end)
	return true
end

local function removeAgent(agent)
	local index = table.find(agents, agent)
	if index then
		table.remove(agents, index)
	end
	if statsFolder then
		local entry = statsFolder:FindFirstChild(agent.Name)
		if entry then
			entry:Destroy()
		end
	end
	Combat.BotsByName[agent.Name] = nil
	if agent.Model then
		agent.Model:Destroy()
	end
end

-- Crea el bot sin que un error deje un hueco fantasma: si falla, el bot se quita de la lista
safeSpawn = function(agent)
	if agent.Spawning then
		return true -- ya se está creando
	end
	local ok, spawned = pcall(spawnAgent, agent)
	if not ok then
		warn("[Bots] spawn:", spawned)
		agent.Spawning = false
	end
	if not (ok and spawned) then
		if agent.Model and agent.Model.Parent and not agent.Humanoid then
			agent.Model:Destroy()
		end
		removeAgent(agent)
		return false
	end
	return true
end

-- Bot a quitar: del equipo con más miembros (jugadores + bots) para no desequilibrar
local function botToRemove()
	if not teamMode() then
		return agents[#agents]
	end
	local best, bestCount = nil, -1
	for _, team in Teams:GetTeams() do
		local count = #team:GetPlayers()
		local candidate
		for _, agent in agents do
			if agent.Team == team then
				count += 1
				candidate = agent
			end
		end
		if candidate and count > bestCount then
			best, bestCount = candidate, count
		end
	end
	return best or agents[#agents]
end

-- Ajusta el número de bots. En plena ronda de Eliminación no entran bots nuevos.
local function balance()
	local desired = desiredCount()
	while #agents < desired and not noRespawn() and state() == "Playing" do
		local agent = { Name = nextName() }
		table.insert(agents, agent)
		Combat.BotsByName[agent.Name] = agent
		if not safeSpawn(agent) then
			break
		end
		desired = desiredCount()
	end
	if #agents > desired then
		if not noRespawn() then
			removeAgent(botToRemove())
		else
			-- En plena ronda de Eliminación solo se quita un bot ya eliminado (no se le quita un luchador
			-- a un equipo a mitad de ronda); el resto se ajusta en la preparación de la siguiente
			for i = #agents, 1, -1 do
				if not agents[i].Humanoid and not agents[i].Spawning then
					removeAgent(agents[i])
					break
				end
			end
		end
	end
end

-- Nueva ronda de Eliminación: los muertos reaparecen y los vivos vuelven a su base con la vida llena
function Bots.RespawnAll()
	table.clear(intel)
	table.clear(radarUntil)
	for _, agent in table.clone(agents) do
		if agent.Humanoid and agent.Humanoid.Health > 0 and agent.Model then
			agent.Humanoid.Health = agent.Humanoid.MaxHealth
			agent.Model:PivotTo(CFrame.new(spawnPoint(agent.Team)) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
			agent.Waypoints, agent.Target, agent.Shots, agent.GoalDeadline = nil, nil, 0, 0
			agent.AlertPosition, agent.AlertTime = nil, nil
			-- (nada de la ronda anterior: cargador lleno y sin esperas ni pistas viejas)
			local weaponDef = Weapons.Get(agent.Weapon)
			agent.Mag = weaponDef and weaponDef.MagSize or agent.Mag
			agent.ReloadUntil, agent.RetreatUntil, agent.HoldUntil, agent.BurstLeft = 0, 0, 0, 0
			agent.HoldLook, agent.SpotLook, agent.Arrived = nil, nil, false
			agent.LastSeenPosition, agent.LastSeenTime = nil, nil
			agent.Streak = 0
		elseif not agent.Spawning then
			task.spawn(safeSpawn, agent)
		end
	end
end

-- Fin de la preparación de Eliminación: reaparece cualquier bot que siga muerto
function Bots.RespawnDead()
	for _, agent in table.clone(agents) do
		if not agent.Humanoid and not agent.Spawning then
			task.spawn(safeSpawn, agent)
		end
	end
end

-- Infección: el bot pasa a ser zombi (si está vivo, reaparece ya como zombi; si no, al reaparecer)
function Bots.Infect(agent, zombieTeam)
	if agent.Zombie then
		return
	end
	agent.Team = zombieTeam
	agent.Zombie = true
	local entry = statsOf(agent)
	if entry then
		entry:SetAttribute("Team", zombieTeam.Name)
	end
	if agent.Humanoid and agent.Humanoid.Health > 0 and agent.Model then
		-- Paciente cero: se cambia el cuerpo por uno de zombi (sin contar como muerte)
		local model = agent.Model
		agent.Humanoid = nil
		model:Destroy()
		task.spawn(safeSpawn, agent)
	end
end

-- Al cambiar de modo o de equipos, los bots vuelven a elegir equipo
function Bots.Reset()
	for i = #agents, 1, -1 do
		removeAgent(agents[i])
	end
	table.clear(intel) -- (lo que sabían del enemigo era de la ronda anterior)
	table.clear(radarUntil)
end

function Bots.Init()
	if not CONFIG.Enabled then
		return
	end
	folder = Instance.new("Folder")
	folder.Name = "Bots"
	folder.Parent = workspace
	statsFolder = Instance.new("Folder")
	statsFolder.Name = "BotStats"
	statsFolder.Parent = ReplicatedStorage
	ReplicatedStorage:GetAttributeChangedSignal("State"):Connect(function()
		if state() ~= "Playing" then
			Bots.Reset()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(balance)
			if not ok then
				warn("[Bots] balance:", err)
			end
			ok, err = pcall(radarSweep)
			if not ok then
				warn("[Bots] radar:", err)
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.15)
			for _, agent in table.clone(agents) do
				local ok, err = pcall(think, agent)
				if not ok then
					warn("[Bots] think:", err)
				end
			end
		end
	end)
end

Bots.Agents = agents
return Bots
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Bounty</string>
            <string name="Source"><![CDATA[-- "SE BUSCA" (GameConfig.Bounty): el jugador en racha lleva una recompensa por su cabeza. Se marca
-- con un cartel sobre la cabeza (los demás lo ven; él no) y quien lo elimine cobra las monedas.
-- El valor queda en el atributo "Bounty" del jugador (los bots lo usan para ir a por él).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)

local Bounty = {}

local TAG = "BountyTag"
local watched = {} -- jugadores a los que se les vuelve a poner el cartel al cambiar de personaje

local function config()
	return GameConfig.Bounty or {}
end

-- Monedas que vale una racha (0 si aún no llega)
function Bounty.Value(streak)
	local c = config()
	if not c.Enabled or streak < (c.Streak or math.huge) then
		return 0
	end
	return math.min((c.Base or 0) + (c.PerKill or 0) * (streak - c.Streak), c.Max or math.huge)
end

local function removeTag(player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local tag = head and head:FindFirstChild(TAG)
	if tag then
		tag:Destroy()
	end
end

-- Cartel sobre la cabeza (lo crea o actualiza el número)
local function showTag(player, value)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not head then
		return
	end
	local tag = head:FindFirstChild(TAG)
	if not tag then
		tag = Instance.new("BillboardGui")
		tag.Name = TAG
		tag.Size = UDim2.fromOffset(150, 44)
		tag.StudsOffset = Vector3.new(0, 2.8, 0)
		tag.MaxDistance = 140
		tag.LightInfluence = 0
		tag.PlayerToHideFrom = player
		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundColor3 = Color3.fromRGB(120, 20, 20)
		frame.BackgroundTransparency = 0.15
		frame.Parent = tag
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = frame
		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(255, 210, 60)
		stroke.Thickness = 2
		stroke.Parent = frame
		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(255, 225, 90)
		label.TextStrokeTransparency = 0.3
		label.Parent = frame
		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0, 6)
		padding.PaddingRight = UDim.new(0, 6)
		padding.PaddingTop = UDim.new(0, 3)
		padding.PaddingBottom = UDim.new(0, 3)
		padding.Parent = label
		tag.Parent = head
	end
	local label = tag:FindFirstChild("Text", true)
	if label then
		label.Text = "💰 SE BUSCA · " .. value .. " 💰"
	end
end

-- Si recibe un personaje nuevo sin haber muerto (rondas de Eliminación, paciente cero de la
-- Infección), sigue buscado: el cartel pasa al personaje nuevo
local function watch(player)
	if watched[player] then
		return
	end
	watched[player] = player.CharacterAdded:Connect(function(character)
		local head = character:WaitForChild("Head", 5)
		local value = player:GetAttribute("Bounty") or 0
		if head and value > 0 and player.Character == character then
			showTag(player, value)
		end
	end)
	player.AncestryChanged:Connect(function()
		if not player.Parent and watched[player] then
			watched[player]:Disconnect()
			watched[player] = nil
		end
	end)
end

-- Tras una baja de `player` con racha `streak`: sube (o pone) su recompensa
function Bounty.OnStreak(player, streak)
	local value = Bounty.Value(streak)
	if value <= 0 then
		return
	end
	watch(player)
	local before = player:GetAttribute("Bounty") or 0
	player:SetAttribute("Bounty", value)
	showTag(player, value)
	if before == 0 then
		Remotes.Notify:FireAllClients("Bounty", "SE BUSCA: " .. player.Name .. " · " .. value .. " 💰 por su cabeza")
		Remotes.Notify:FireClient(player, "Wanted", value)
	end
end

-- Muere `victim`: devuelve las monedas que valía su cabeza (0 si nada) y le quita la marca
function Bounty.Clear(victim)
	local value = victim:GetAttribute("Bounty") or 0
	victim:SetAttribute("Bounty", nil)
	removeTag(victim)
	return value
end

-- Anuncia quién cobró (o que se perdió) la recompensa
function Bounty.Announce(victimName, value, claimerName)
	if claimerName then
		Remotes.Notify:FireAllClients("Bounty", claimerName .. " cobró la recompensa de " .. victimName .. " (" .. value .. " 💰)")
	else
		Remotes.Notify:FireAllClients("Bounty", "La recompensa de " .. victimName .. " se ha perdido")
	end
end

-- Nueva ronda: nadie es buscado
function Bounty.Reset(player)
	player:SetAttribute("Bounty", nil)
	removeTag(player)
end

return Bounty
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Combat</string>
            <string name="Source"><![CDATA[-- Validación de disparos y daño en el servidor (anti-trampas básico).
-- El cliente calcula el impacto; el servidor comprueba cadencia, munición, distancia y línea de visión.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Weapons = require(Shared.Weapons)
local Remotes = require(Shared.Remotes)
local GameConfig = require(Shared.GameConfig)

local Ragdoll = require(script.Parent.Ragdoll)

local Combat = {}

-- Asignado desde Main: function(killer: Player?, victim: Player?, victimName, weaponName, headshot, position: Vector3?)
Combat.OnKill = nil
Combat.OnAssist = nil -- (jugadores que ayudaron, nombre de la víctima, bot víctima, jugador víctima)

-- Quién le ha quitado vida a cada Humanoid y cuándo (para las asistencias)
local ASSIST_WINDOW = 10
local ASSIST_MIN_DAMAGE = 20
local damageLog = setmetatable({}, { __mode = "k" }) -- [humanoid] = { [userId] = { Time, Damage } }

-- Cadencia: "cubo" de disparos por arma. Se rellena a FireRate por segundo y guarda hasta 3, así los
-- disparos legítimos que llegan juntos (lag) no se pierden, pero no se puede disparar más rápido.
local fireBudget = setmetatable({}, { __mode = "k" })
local FIRE_BURST_ALLOWANCE = 3
local reloadTokens = setmetatable({}, { __mode = "k" })
local lastMelee = {}

local function getCharacterFromPart(part)
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid then
			return model, humanoid
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil, nil
end

-- Bots activos por nombre (los registra Bots): para saber quién hizo una baja
Combat.BotsByName = {}

local function isEnemy(attacker, targetPlayer, targetChar)
	if not targetPlayer then
		-- Bots del mismo equipo no se dañan; muñecos de práctica y bots enemigos sí
		if targetChar and targetChar:GetAttribute("Bot") and ReplicatedStorage:GetAttribute("TeamMode") and attacker.Team then
			return targetChar:GetAttribute("Team") ~= attacker.Team.Name
		end
		return true
	end
	if attacker == targetPlayer then
		return false
	end
	if attacker.Neutral or targetPlayer.Neutral or not attacker.Team then
		return true
	end
	return attacker.Team ~= targetPlayer.Team
end

local function isHeadshot(part, character, position)
	if part.Name == "Head" then
		return true
	end
	return false
end

-- Los accesorios del avatar (sombreros, alas, mochilas) no reciben disparos: ni escudo ni cabeza gigante
local function ignoreAccessories(character)
	local function apply(inst)
		if inst:IsA("BasePart") and inst:FindFirstAncestorOfClass("Accessory") then
			inst.CanQuery = false
		end
	end
	for _, inst in character:GetDescendants() do
		apply(inst)
	end
	character.DescendantAdded:Connect(apply)
end

-- Vector3 válido: sin NaN ni infinitos (un NaN pasa por las comparaciones de distancia sin fallar)
local function finiteVector(v)
	return typeof(v) == "Vector3" and v.Magnitude == v.Magnitude and v.Magnitude < 1e6
end

-- Instrumentación de impactos (GameConfig.HitTelemetry): solo mide, no cambia ninguna decisión.
-- Holgura = distancia del punto de impacto del cliente a la superficie de la pieza (aprox.: al centro
-- menos media diagonal). Hoy se aceptan hasta 8 studs de holgura por la latencia.
local TELEMETRY_BUCKETS = { 0.5, 1, 2, 4, 6, 8 } -- límites superiores (studs); lo de más es rechazado
local telemetry = { Samples = 0, Accepted = 0, Rejected = 0, Headshots = 0, MaxSlack = 0, HeadMaxSlack = 0, Buckets = {}, LastReport = "" }
for i = 1, #TELEMETRY_BUCKETS + 1 do
	telemetry.Buckets[i] = 0
end
Combat.HitTelemetry = telemetry
-- (modo QA de Studio: recibe cada muestra para enseñarla en el panel; nil = nadie la recibe)
Combat.OnHitSample = nil

local function recordHit(part, position, accepted, headshot, player, weaponName, distance)
	local config = GameConfig.HitTelemetry
	if not config or not config.Enabled then
		return
	end
	local slack = math.max(0, (part.Position - position).Magnitude - part.Size.Magnitude / 2)
	if Combat.OnHitSample then
		pcall(Combat.OnHitSample, {
			Player = player,
			Weapon = weaponName,
			Distance = distance,
			Slack = slack,
			ReportedHead = part.Name == "Head",
			Headshot = headshot == true,
			Accepted = accepted == true,
		})
	end
	local bucket = #TELEMETRY_BUCKETS + 1
	for i, limit in TELEMETRY_BUCKETS do
		if slack <= limit then
			bucket = i
			break
		end
	end
	telemetry.Samples += 1
	telemetry.Buckets[bucket] += 1
	telemetry.MaxSlack = math.max(telemetry.MaxSlack, slack)
	if accepted then
		telemetry.Accepted += 1
	else
		telemetry.Rejected += 1
	end
	if headshot then
		telemetry.Headshots += 1
		telemetry.HeadMaxSlack = math.max(telemetry.HeadMaxSlack, slack)
	end
	if telemetry.Samples % (config.ReportEvery or 200) == 0 then
		local parts = {}
		for i, count in telemetry.Buckets do
			local limit = TELEMETRY_BUCKETS[i]
			table.insert(parts, (limit and ("≤" .. limit) or (">" .. TELEMETRY_BUCKETS[#TELEMETRY_BUCKETS])) .. ": " .. count)
		end
		-- (también queda en Combat.HitTelemetry.LastReport, para leerlo desde la barra de comandos)
		telemetry.LastReport = string.format(
			"[Combat] Holgura de impactos (%d): %s · aceptados %d, rechazados %d · máx %.2f · cabeza %d (máx %.2f)",
			telemetry.Samples, table.concat(parts, ", "), telemetry.Accepted, telemetry.Rejected,
			telemetry.MaxSlack, telemetry.Headshots, telemetry.HeadMaxSlack
		)
		print(telemetry.LastReport)
	end
end

local function hasLineOfSight(origin, target, ignore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	ignore = table.clone(ignore)
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary) -- muros invisibles del borde del mapa
	end
	params.FilterDescendantsInstances = ignore
	local offset = target - origin
	local distance = offset.Magnitude - 1.5
	if distance <= 0 then
		return true
	end
	return workspace:Raycast(origin, offset.Unit * distance, params) == nil
end

local function damageAtDistance(def, distance)
	if distance <= def.FalloffStart then
		return def.Damage
	end
	if distance >= def.FalloffEnd then
		return def.MinDamage
	end
	local alpha = (distance - def.FalloffStart) / (def.FalloffEnd - def.FalloffStart)
	return def.Damage + (def.MinDamage - def.Damage) * alpha
end

-- Al atacar se pierde cualquier escudo (el de reaparición y el de la pantalla de inicio)
local function removeSpawnShield(character)
	for _, child in character:GetChildren() do
		if child:IsA("ForceField") then
			child:Destroy()
		end
	end
	local player = Players:GetPlayerFromCharacter(character)
	if player then
		player:SetAttribute("InMenu", false)
	end
end

-- Aplica daño y deja la "etiqueta" del atacante. Devuelve daño real y si murió.
local function applyDamage(attacker, humanoid, damage, weaponName, headshot)
	if humanoid.Health <= 0 then
		return 0, false
	end
	humanoid:SetAttribute("LastAttacker", attacker.UserId)
	humanoid:SetAttribute("LastBot", nil)
	humanoid:SetAttribute("LastWeapon", weaponName)
	humanoid:SetAttribute("LastHeadshot", headshot)
	humanoid:SetAttribute("LastHitTime", os.clock())
	local before = humanoid.Health
	humanoid:TakeDamage(damage) -- respeta el ForceField de spawn
	local dealt = before - humanoid.Health
	if dealt > 0 then
		local log = damageLog[humanoid] or {}
		damageLog[humanoid] = log
		local entry = log[attacker.UserId]
		if entry and os.clock() - entry.Time < ASSIST_WINDOW then
			entry.Damage += dealt
		else
			entry = { Damage = dealt }
			log[attacker.UserId] = entry
		end
		entry.Time = os.clock()
	end
	return dealt, humanoid.Health <= 0
end

-- Daño de un bot (ver Bots): deja su nombre como atacante
-- Ruido de los disparos: los bots oyen los tiros cercanos (como el punto rojo del minimapa en los
-- shooters de móvil) y van a ver. Las armas con silenciador apenas se oyen.
Combat.Noise = {} -- { Position, Time, Team, Model, Range }
local NOISE_KEEP = 24
function Combat.ReportNoise(position, team, model, weaponName)
	local def = Weapons.Get(weaponName or "")
	local range = (def and def.Suppressed) and 25 or 110
	-- Ventaja "Fantasma": los bots le oyen la mitad de lejos
	local owner = model and Players:GetPlayerFromCharacter(model)
	if owner and owner:GetAttribute("Perk") == 3 then
		range *= 0.5
	end
	table.insert(Combat.Noise, { Position = position, Time = os.clock(), Team = team, Model = model, Range = range })
	if #Combat.Noise > NOISE_KEEP then
		table.remove(Combat.Noise, 1)
	end
end

function Combat.BotDamage(bot, humanoid, damage, weaponName)
	if humanoid.Health <= 0 then
		return 0, false
	end
	humanoid:SetAttribute("LastAttacker", nil)
	humanoid:SetAttribute("LastBot", bot.Name)
	humanoid:SetAttribute("LastWeapon", weaponName)
	humanoid:SetAttribute("LastHeadshot", false)
	humanoid:SetAttribute("LastHitTime", os.clock())
	local before = humanoid.Health
	humanoid:TakeDamage(damage)
	return before - humanoid.Health, humanoid.Health <= 0
end

-- Daño en área (cohetes). Afecta a enemigos y muñecos con línea de visión desde la explosión.
function Combat.Explode(attacker, position, def, weaponName)
	local info = def.Explosive
	local candidates = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(candidates, p.Character)
		end
	end
	for _, folderName in { "Dummies", "Bots" } do
		local npcs = workspace:FindFirstChild(folderName)
		if npcs then
			for _, d in npcs:GetChildren() do
				table.insert(candidates, d)
			end
		end
	end
	local totalDealt, anyKill, hitPosition, best = 0, false, nil, 0
	local attackerChar = attacker.Character
	for _, targetChar in candidates do
		local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
		local root = targetChar:FindFirstChild("HumanoidRootPart")
		if humanoid and root and humanoid.Health > 0 and targetChar ~= attackerChar then
			local targetPlayer = Players:GetPlayerFromCharacter(targetChar)
			local distance = (root.Position - position).Magnitude
			if distance <= info.Radius and isEnemy(attacker, targetPlayer, targetChar) then
				if hasLineOfSight(position, root.Position, { targetChar, attackerChar }) then
					local alpha = distance / info.Radius
					local damage = info.Damage + (info.MinDamage - info.Damage) * alpha
					local dealt, killed = applyDamage(attacker, humanoid, damage, weaponName, false)
					totalDealt += dealt
					anyKill = anyKill or killed
					if dealt > best then
						best, hitPosition = dealt, root.Position
					end
				end
			end
		end
	end
	if totalDealt > 0 then
		Remotes.HitConfirm:FireClient(attacker, math.floor(totalDealt + 0.5), false, anyKill, hitPosition)
	end
end

-- Detecta la muerte de un Humanoid y avisa a quien corresponda
-- victimBot: el bot (ver Bots) si el que muere es un bot
function Combat.WatchHumanoid(humanoid, victimPlayer, victimName, victimBot)
	Ragdoll.Prepare(humanoid) -- (que Roblox no rompa el cuerpo en piezas al morir)
	humanoid.Died:Connect(function()
		-- El cuerpo cae como un muñeco de trapo, con un empujón alejándose de quien le dio
		-- (mucho más fuerte con explosivos)
		pcall(function()
			local character = humanoid.Parent
			local victimRoot = character and character:FindFirstChild("HumanoidRootPart")
			local push
			local attackerId = humanoid:GetAttribute("LastAttacker")
			local attacker = attackerId and Players:GetPlayerByUserId(attackerId)
			local attackerModel = (attacker and attacker.Character)
				or (humanoid:GetAttribute("LastBot") and Combat.BotsByName[humanoid:GetAttribute("LastBot")] and Combat.BotsByName[humanoid:GetAttribute("LastBot")].Model)
			local attackerRoot = attackerModel and attackerModel:FindFirstChild("HumanoidRootPart")
			if victimRoot and attackerRoot then
				local away = victimRoot.Position - attackerRoot.Position
				away = Vector3.new(away.X, 0, away.Z)
				if away.Magnitude > 0.1 then
					local def = Weapons.Get(humanoid:GetAttribute("LastWeapon") or "")
					local strength = def and def.Explosive and 38 or 9
					push = away.Unit * strength + Vector3.new(0, def and def.Explosive and 22 or 3, 0)
				end
			end
			Ragdoll.Apply(character, push)
		end)
		local killer, killerBot
		local hitTime = humanoid:GetAttribute("LastHitTime")
		local recent = hitTime and os.clock() - hitTime < 10
		local attackerId = humanoid:GetAttribute("LastAttacker")
		if attackerId and recent then
			killer = Players:GetPlayerByUserId(attackerId)
		end
		local botName = humanoid:GetAttribute("LastBot")
		if botName and recent and not killer then
			killerBot = Combat.BotsByName[botName]
		end
		local weaponName = humanoid:GetAttribute("LastWeapon")
		local headshot = humanoid:GetAttribute("LastHeadshot") == true
		local character = humanoid.Parent
		local root = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head"))
		local position = root and root.Position
		if victimPlayer then
			-- Vida que le quedaba al que te eliminó (se enseña en la pantalla de muerte)
			local killerHumanoid = killer and killer.Character and killer.Character:FindFirstChildOfClass("Humanoid")
				or (killerBot and killerBot.Humanoid)
			local killerHealth = killerHumanoid and math.ceil(math.max(0, killerHumanoid.Health)) or nil
			local killerName = (killer and killer.Name) or (killerBot and killerBot.Name) or nil
			Remotes.Died:FireClient(victimPlayer, killerName, weaponName, killerHealth)
		end
		-- Espectador de Eliminación (entró a mitad de ronda): pantalla de muerte, pero sin baja ni muerte
		-- (el equipo del caído antes de que OnKill lo cambie: en Infección pasa a zombi)
		local victimTeamBefore = (victimPlayer and victimPlayer.Team) or (victimBot and victimBot.Team) or nil
		if Combat.OnKill and not humanoid:GetAttribute("Spectator") then
			Combat.OnKill(killer, victimPlayer, victimName, weaponName, headshot, position, killerBot, victimBot)
		end
		-- Asistencias: quien le quitó bastante vida hace poco y no es quien lo remató
		local log = damageLog[humanoid]
		damageLog[humanoid] = nil
		-- (solo contra jugadores y bots, no muñecos; y no si ahora es del mismo equipo, p. ej. en Infección)
		if log and Combat.OnAssist and (victimPlayer or victimBot) and not humanoid:GetAttribute("Spectator") then
			local victimTeam = victimTeamBefore
			local helpers = {}
			for userId, entry in log do
				local helper = Players:GetPlayerByUserId(userId)
				if helper and helper ~= killer and helper ~= victimPlayer and entry.Damage >= ASSIST_MIN_DAMAGE
					and os.clock() - entry.Time < ASSIST_WINDOW and not (victimTeam and helper.Team == victimTeam) then
					table.insert(helpers, helper)
				end
			end
			if #helpers > 0 then
				Combat.OnAssist(helpers, victimName, victimBot, victimPlayer)
			end
		end
	end)
end

local function frozen(player)
	if ReplicatedStorage:GetAttribute("Frozen") == true then -- cuenta atrás de Eliminación
		return true
	end
	-- (Buscar y destruir: los atacantes que aún esperan en su base no disparan)
	local held = ReplicatedStorage:GetAttribute("HeldTeam")
	return held ~= nil and player ~= nil and player.Team ~= nil and player.Team.Name == held
end

local function onFire(player, tool, origin, rays)
	if frozen(player) then
		return
	end
	if typeof(tool) ~= "Instance" or not tool:IsA("Tool") or not finiteVector(origin) or type(rays) ~= "table" then
		return
	end
	local character = player.Character
	if not character or tool.Parent ~= character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local head = character:FindFirstChild("Head")
	if not humanoid or humanoid.Health <= 0 or not head then
		return
	end
	local weaponName = tool:GetAttribute("Weapon")
	local def = Weapons.Get(weaponName)
	if not def or def.Type ~= "Gun" or tool:GetAttribute("Reloading") then
		return
	end
	local ammo = tool:GetAttribute("Ammo") or 0
	if ammo <= 0 then
		return
	end
	local now = os.clock()
	-- Armas lentas (escopetas, francotiradores) no acumulan: 1 disparo; las rápidas hasta 3
	local cap = math.clamp(def.FireRate * 0.2, 1, FIRE_BURST_ALLOWANCE)
	local budget = fireBudget[tool]
	if not budget then
		budget = { Time = now, Shots = cap }
		fireBudget[tool] = budget
	end
	budget.Shots = math.min(cap, budget.Shots + (now - budget.Time) * def.FireRate * 1.15)
	budget.Time = now
	if budget.Shots < 1 then
		return
	end
	-- El origen del disparo tiene que estar cerca de la cabeza y SIN pared en medio
	if (head.Position - origin).Magnitude > 12 or not hasLineOfSight(head.Position, origin, { character }) then
		return
	end
	budget.Shots -= 1
	tool:SetAttribute("Ammo", ammo - 1)
	removeSpawnShield(character)
	Combat.ReportNoise(head.Position, player.Team, character, weaponName)

	if def.Explosive then
		local ray = rays[1]
		if type(ray) ~= "table" or not finiteVector(ray.Position) then
			return
		end
		local position = ray.Position
		local reach = (position - origin).Magnitude
		if reach > def.Range + 5 or reach < 0.05 then -- (a 0 la dirección .Unit sería NaN)
			return
		end
		-- El cohete no puede atravesar paredes hasta el punto de impacto
		local back = (origin - position).Unit * 1.5
		if not hasLineOfSight(origin, position + back, { character }) then
			return
		end
		Combat.Explode(player, position + back * 0.5, def, tool:GetAttribute("Weapon"))
		for _, other in Players:GetPlayers() do
			if other ~= player then
				Remotes.ShotFX:FireClient(other, tool, { position })
			end
		end
		return
	end

	local endpoints = {}
	local perTarget = {}
	for i = 1, math.min(#rays, def.Pellets) do
		local ray = rays[i]
		if type(ray) == "table" and finiteVector(ray.Position) then
			local position = ray.Position
			local distance = (position - origin).Magnitude
			if distance <= def.Range + 5 then
				table.insert(endpoints, position)
				local part = ray.Part
				if typeof(part) == "Instance" and part:IsA("BasePart") and part:IsDescendantOf(workspace) then
					local targetChar, targetHum = getCharacterFromPart(part)
					if targetChar and targetChar ~= character and targetHum.Health > 0 then
						local targetPlayer = Players:GetPlayerFromCharacter(targetChar)
						local closeEnough = (part.Position - position).Magnitude <= part.Size.Magnitude / 2 + 8
						local valid = isEnemy(player, targetPlayer, targetChar)
							and closeEnough
							and hasLineOfSight(origin, position, { character, targetChar })
						recordHit(part, position, valid, valid and isHeadshot(part, targetChar, position), player, weaponName, distance)
						if valid then
							local headshot = isHeadshot(part, targetChar, position)
							local damage = damageAtDistance(def, distance)
								* (headshot and def.HeadshotMultiplier or 1)
							local entry = perTarget[targetHum]
							if not entry then
								entry = { Damage = 0, Headshot = false }
								perTarget[targetHum] = entry
							end
							entry.Damage += damage
							entry.Position = position
							entry.Headshot = entry.Headshot or headshot
						end
					end
				end
			end
		end
	end

	-- hitPosition: dónde se hizo más daño (el cliente pone ahí el número de daño)
	local totalDealt, anyHeadshot, anyKill, hitPosition, best = 0, false, false, nil, 0
	for targetHum, entry in perTarget do
		local dealt, killed = applyDamage(player, targetHum, entry.Damage, weaponName, entry.Headshot)
		if dealt > 0 then
			totalDealt += dealt
			anyHeadshot = anyHeadshot or entry.Headshot
			anyKill = anyKill or killed
			if dealt > best then
				best, hitPosition = dealt, entry.Position
			end
		end
	end
	if totalDealt > 0 then
		Remotes.HitConfirm:FireClient(player, math.floor(totalDealt + 0.5), anyHeadshot, anyKill, hitPosition)
	end

	for _, other in Players:GetPlayers() do
		if other ~= player then
			Remotes.ShotFX:FireClient(other, tool, endpoints)
		end
	end
end

local function onReload(player, tool)
	if typeof(tool) ~= "Instance" or not tool:IsA("Tool") then
		return
	end
	local character = player.Character
	if not character or tool.Parent ~= character then
		return
	end
	local def = Weapons.Get(tool:GetAttribute("Weapon"))
	if not def or def.Type ~= "Gun" or tool:GetAttribute("Reloading") then
		return
	end
	local ammo = tool:GetAttribute("Ammo") or 0
	local reserve = tool:GetAttribute("Reserve") or 0
	if ammo >= def.MagSize or reserve <= 0 then
		return
	end
	tool:SetAttribute("Reloading", true)
	local token = {}
	reloadTokens[tool] = token
	-- (con balas aún en el cargador, recarga táctica: más rápida)
	task.delay(Weapons.ReloadDuration(def, ammo <= 0), function()
		if reloadTokens[tool] ~= token then
			return
		end
		reloadTokens[tool] = nil
		-- Si cambió de arma la recarga ya se canceló (Reloading = false)
		if not tool:GetAttribute("Reloading") or tool.Parent ~= player.Character then
			tool:SetAttribute("Reloading", false)
			return
		end
		local currentAmmo = tool:GetAttribute("Ammo") or 0
		local currentReserve = tool:GetAttribute("Reserve") or 0
		local take = math.min(def.MagSize - currentAmmo, currentReserve)
		tool:SetAttribute("Ammo", currentAmmo + take)
		tool:SetAttribute("Reserve", currentReserve - take)
		tool:SetAttribute("Reloading", false)
	end)
end

-- Arma cuerpo a cuerpo que lleva el jugador (cuchillo, martillo o katana): su nombre
local function findMelee(player)
	for _, container in { player.Character, player:FindFirstChild("Backpack") } do
		if container then
			for _, tool in container:GetChildren() do
				local name = tool:IsA("Tool") and tool:GetAttribute("Weapon")
				local def = name and Weapons.Get(name)
				if def and def.Type == "Melee" then
					return name
				end
			end
		end
	end
	return nil
end

local function onMelee(player, part)
	if frozen(player) then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local meleeName = findMelee(player)
	if not humanoid or humanoid.Health <= 0 or not root or not meleeName then
		return
	end
	local def = Weapons.Get(meleeName)
	local now = os.clock()
	if now - (lastMelee[player] or 0) < def.Cooldown * 0.8 then
		return
	end
	lastMelee[player] = now
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") or not part:IsDescendantOf(workspace) then
		return
	end
	local targetChar, targetHum = getCharacterFromPart(part)
	if not targetChar or targetChar == character or targetHum.Health <= 0 then
		return
	end
	local targetRoot = targetChar:FindFirstChild("HumanoidRootPart") or part
	if (targetRoot.Position - root.Position).Magnitude > def.Range + 4 then
		return
	end
	if not isEnemy(player, Players:GetPlayerFromCharacter(targetChar), targetChar) then
		return
	end
	-- Nada de cuchillazos a través de paredes
	if not hasLineOfSight(root.Position, targetRoot.Position, { character, targetChar }) then
		return
	end
	removeSpawnShield(character)
	local dealt, killed = applyDamage(player, targetHum, def.Damage, meleeName, false)
	if dealt > 0 then
		Remotes.HitConfirm:FireClient(player, math.floor(dealt + 0.5), false, killed, targetRoot.Position)
	end
end

-- Hacia dónde mira cada jugador arriba/abajo (radianes): se guarda en su personaje (atributo AimPitch,
-- se replica) para que los demás le vean apuntar con el arma inclinada (RiflePose). Como mucho unas
-- 10 veces por segundo y redondeado (cambios pequeños no se mandan)
local lastPitch = setmetatable({}, { __mode = "k" }) -- [player] = os.clock()
local function onAimPitch(player, pitch)
	if type(pitch) ~= "number" or pitch ~= pitch then
		return
	end
	local now = os.clock()
	if now - (lastPitch[player] or 0) < 0.08 then
		return
	end
	lastPitch[player] = now
	local character = player.Character
	if character then
		character:SetAttribute("AimPitch", math.floor(math.clamp(pitch, -1.3, 1.3) * 20 + 0.5) / 20)
	end
end

-- Linterna del arma (de noche): los demás la ven si la llevas encendida
local lastFlashlight = setmetatable({}, { __mode = "k" }) -- [player] = { At, Want, Pending }
local function onFlashlight(player, on)
	if type(on) ~= "boolean" then
		return
	end
	-- (como mucho 5 veces por segundo; si llega otra antes, se aplica la última un poco después:
	-- así el servidor nunca se queda con una distinta de la del jugador)
	local entry = lastFlashlight[player]
	if not entry then
		entry = { At = 0, Want = on, Pending = false }
		lastFlashlight[player] = entry
	end
	entry.Want = on
	local function apply()
		entry.At = os.clock()
		if player.Character then
			player.Character:SetAttribute("Flashlight", entry.Want)
		end
	end
	local wait = 0.2 - (os.clock() - entry.At)
	if wait <= 0 then
		apply()
	elseif not entry.Pending then
		entry.Pending = true
		task.delay(wait, function()
			entry.Pending = false
			apply()
		end)
	end
end

function Combat.Init()
	Remotes.AimPitch.OnServerEvent:Connect(onAimPitch)
	Remotes.Flashlight.OnServerEvent:Connect(onFlashlight)
	Remotes.Fire.OnServerEvent:Connect(onFire)
	Remotes.Reload.OnServerEvent:Connect(onReload)
	Remotes.Melee.OnServerEvent:Connect(onMelee)

	local function onPlayer(player)
		player.CharacterAdded:Connect(function(character)
			ignoreAccessories(character)
			local humanoid = character:WaitForChild("Humanoid", 10)
			if humanoid then
				Combat.WatchHumanoid(humanoid, player, player.Name)
			end
		end)
		if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
			ignoreAccessories(player.Character)
			Combat.WatchHumanoid(player.Character:FindFirstChildOfClass("Humanoid"), player, player.Name)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastMelee[player] = nil
	end)
end

return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Domination</string>
            <string name="Source"><![CDATA[-- Modo "Dominio" (el clásico de los shooters de móvil): tres banderas A, B y C. A queda cerca de la
-- base del primer equipo, B en el centro y C cerca de la base del segundo. Se captura quedándose
-- dentro (~5 s; más rápido con más compañeros) sin enemigos; si hay de los dos equipos, la captura
-- se para. Cada bandera tuya suma 1 punto cada SCORE_EVERY segundos.
--
-- Estado para la interfaz (atributos de ReplicatedStorage), para cada letra L en A, B, C:
--   Dom_L_Position (Vector3), Dom_L_Owner ("" o equipo), Dom_L_Capturing ("" o equipo),
--   Dom_L_Progress (0..1, de la captura en curso), Dom_L_Contested (bool)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Teams = game:GetService("Teams")

local Shared = ReplicatedStorage.Shared
local Remotes = require(Shared.Remotes)

local PlayerData = require(script.Parent.PlayerData)

local Domination = {}

Domination.OnScore = nil -- function(team, amount)

local LETTERS = { "A", "B", "C" }
local CAPTURE_TIME = 5 -- segundos con una persona
local SCORE_EVERY = 3 -- segundos entre puntos de cada bandera
local STEP = 0.25

local active = false
local points = {} -- { Letter, Position, Radius, Owner (Team?), Capturing (Team?), Progress, Visual }
local thread

local function findZones()
	local list = {}
	local map = workspace:FindFirstChild("Map")
	if map then
		for _, d in map:GetDescendants() do
			if d:IsA("BasePart") and d.Name == "HardpointZone" then
				table.insert(list, d)
			end
		end
	end
	return list
end

local function teamSpawnCenter(team)
	local map = workspace:FindFirstChild("Map")
	local sum, count = Vector3.zero, 0
	if map then
		for _, d in map:GetDescendants() do
			if d:IsA("SpawnLocation") and d.TeamColor == team.TeamColor then
				sum += d.Position
				count += 1
			end
		end
	end
	return count > 0 and sum / count or nil
end

function Domination.IsAvailable()
	return #findZones() >= 3
end

-- A: la zona más cerca de la base del primer equipo; C: la más cerca de la del segundo; B: la más
-- centrada entre las dos (de las que quedan)
local function choosePoints()
	local zones = findZones()
	local teams = Teams:GetTeams()
	if #zones < 3 or #teams < 2 then
		return nil
	end
	local baseA, baseB = teamSpawnCenter(teams[1]), teamSpawnCenter(teams[2])
	if not baseA or not baseB then
		return { zones[1], zones[2], zones[3] }
	end
	local function closest(list, target, exclude)
		local best, bestDistance = nil, math.huge
		for _, zone in list do
			if not exclude[zone] then
				local distance = (zone.Position - target).Magnitude
				if distance < bestDistance then
					best, bestDistance = zone, distance
				end
			end
		end
		return best
	end
	local used = {}
	local middle = (baseA + baseB) / 2
	local b = closest(zones, middle, used)
	used[b] = true
	local a = closest(zones, baseA, used)
	used[a] = true
	local c = closest(zones, baseB, used)
	return { a, b, c }
end

local function makeVisual(point)
	local radius = point.Radius
	local model = Instance.new("Model")
	model.Name = "DomFlag_" .. point.Letter
	local function part(name, size, cf, material, transparency)
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Size = size
		p.CFrame = cf
		p.Material = material
		p.Transparency = transparency or 0
		p.Color = Color3.new(1, 1, 1)
		p.Parent = model
		return p
	end
	local base = point.Position
	local ring = part("Ring", Vector3.new(0.3, radius * 2 + 1, radius * 2 + 1), CFrame.new(base + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.pi / 2), Enum.Material.Neon)
	ring.Shape = Enum.PartType.Cylinder
	local fill = part("Fill", Vector3.new(0.32, radius * 2 - 1, radius * 2 - 1), CFrame.new(base + Vector3.new(0, 0.21, 0)) * CFrame.Angles(0, 0, math.pi / 2), Enum.Material.ForceField, 0.35)
	fill.Shape = Enum.PartType.Cylinder
	-- Mástil: en el centro si hay sitio; si hay algo justo encima (un monumento), hacia el borde de
	-- la zona; bajo techo (dentro de un edificio), más bajo
	local poleBase, poleHeight = base, 9
	local bestRoom = -1
	for _, offset in { Vector3.zero, Vector3.new(radius * 0.6, 0, 0), Vector3.new(0, 0, radius * 0.6), Vector3.new(-radius * 0.6, 0, 0), Vector3.new(0, 0, -radius * 0.6) } do
		local hit = workspace:Raycast(base + offset + Vector3.new(0, 1, 0), Vector3.new(0, 10, 0))
		local room = hit and hit.Distance or 10
		if room > bestRoom then
			bestRoom, poleBase = room, base + offset
		end
		if room >= 9 then
			break
		end
	end
	poleHeight = math.clamp(bestRoom + 1 - 0.6, 3, 9)
	local pole = part("Pole", Vector3.new(0.4, poleHeight, 0.4), CFrame.new(poleBase + Vector3.new(0, poleHeight / 2, 0)), Enum.Material.Metal)
	pole.Color = Color3.fromRGB(60, 60, 64)
	part("Flag", Vector3.new(0.15, math.min(2.4, poleHeight * 0.3), 3.6), CFrame.new(poleBase + Vector3.new(0, poleHeight - 1.4, 1.8)), Enum.Material.Fabric)
	local light = Instance.new("PointLight")
	light.Range = radius * 2
	light.Brightness = 1.5
	light.Parent = ring
	-- Letra visible a través de las paredes
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(60, 60)
	billboard.StudsOffset = Vector3.new(0, 11, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = 1500
	billboard.Parent = pole
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextStrokeTransparency = 0.2
	label.Text = point.Letter
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Parent = billboard
	model.Parent = workspace
	point.Visual = model
end

local function paint(point)
	local color = point.Owner and point.Owner.TeamColor.Color or Color3.new(1, 1, 1)
	if point.Contested then
		color = Color3.fromRGB(255, 200, 40)
	end
	if point.Painted == color or not point.Visual then
		return
	end
	point.Painted = color
	for _, p in point.Visual:GetDescendants() do
		if p:IsA("BasePart") and p.Name ~= "Pole" then
			p.Color = color
		elseif p:IsA("PointLight") then
			p.Color = color
		elseif p:IsA("TextLabel") then
			p.TextColor3 = color
		end
	end
end

-- Quién está dentro: { [Team] = { jugadores } } (los bots cuentan, sin lista de jugadores)
local function occupants(point)
	local byTeam, counts = {}, {}
	local function add(team, player, root)
		local offset = root.Position - point.Position
		if Vector3.new(offset.X, 0, offset.Z).Magnitude <= point.Radius and offset.Y > -3 and offset.Y < 10 then
			byTeam[team] = byTeam[team] or {}
			counts[team] = (counts[team] or 0) + 1
			if player then
				table.insert(byTeam[team], player)
			end
		end
	end
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if player.Team and humanoid and humanoid.Health > 0 and root and not player:GetAttribute("InMenu") then
			add(player.Team, player, root)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart")
			local team = Teams:FindFirstChild(model:GetAttribute("Team") or "")
			if team and team:IsA("Team") and humanoid and humanoid.Health > 0 and root then
				add(team, nil, root)
			end
		end
	end
	return byTeam, counts
end

local function publish(point)
	local prefix = "Dom_" .. point.Letter .. "_"
	ReplicatedStorage:SetAttribute(prefix .. "Owner", point.Owner and point.Owner.Name or "")
	ReplicatedStorage:SetAttribute(prefix .. "Capturing", point.Capturing and point.Capturing.Name or "")
	ReplicatedStorage:SetAttribute(prefix .. "Progress", math.floor(point.Progress * 100 + 0.5) / 100)
	ReplicatedStorage:SetAttribute(prefix .. "Contested", point.Contested == true)
end

local function update(point, dt)
	local byTeam, counts = occupants(point)
	local present = {}
	for team in byTeam do
		table.insert(present, team)
	end
	point.Contested = #present > 1
	if #present == 1 and present[1] ~= point.Owner then
		-- Capturando (si había otro equipo a medias, empieza de cero)
		local team = present[1]
		if point.Capturing ~= team then
			point.Capturing, point.Progress = team, 0
		end
		local speed = math.min(2, 1 + (counts[team] - 1) * 0.5) -- (más gente, más rápido)
		point.Progress = math.min(1, point.Progress + dt * speed / CAPTURE_TIME)
		if point.Progress >= 1 then
			local previous = point.Owner
			point.Owner, point.Capturing, point.Progress = team, nil, 0
			Remotes.Notify:FireAllClients("Flag", "🚩 " .. team.Name .. " captura " .. point.Letter .. (previous and " (era de " .. previous.Name .. ")" or ""))
			for _, player in byTeam[team] do
				PlayerData.AddXP(player, 50, "Captura " .. point.Letter)
				PlayerData.Track(player, "ZoneTime", 5)
			end
		end
	elseif #present == 1 and present[1] == point.Owner and point.Capturing then
		-- Los dueños vuelven a su bandera: deshacen la captura enemiga a medias
		point.Progress = math.max(0, point.Progress - dt * 2 / CAPTURE_TIME)
		if point.Progress <= 0 then
			point.Capturing = nil
		end
	elseif #present == 0 and point.Capturing then
		-- Nadie dentro: la captura a medias se va perdiendo
		point.Progress = math.max(0, point.Progress - dt / CAPTURE_TIME)
		if point.Progress <= 0 then
			point.Capturing = nil
		end
	end
	paint(point)
	publish(point)
end

function Domination.Start()
	Domination.Stop()
	local zones = choosePoints()
	if not zones then
		return false
	end
	points = {}
	for i, zone in zones do
		local point = {
			Letter = LETTERS[i],
			Position = zone.Position,
			Radius = math.max(8, zone:GetAttribute("Radius") or 10),
			Owner = nil,
			Capturing = nil,
			Progress = 0,
		}
		ReplicatedStorage:SetAttribute("Dom_" .. point.Letter .. "_Position", point.Position)
		makeVisual(point)
		publish(point)
		table.insert(points, point)
	end
	active = true
	thread = task.spawn(function()
		local scoreClock = 0
		while active do
			task.wait(STEP)
			scoreClock += STEP
			local ok, err = pcall(function()
				for _, point in points do
					update(point, STEP)
				end
				if scoreClock >= SCORE_EVERY then
					scoreClock = 0
					for _, point in points do
						if point.Owner and Domination.OnScore then
							Domination.OnScore(point.Owner, 1)
						end
					end
				end
			end)
			if not ok then
				warn("[Domination] Error en el bucle de puntos:", err)
			end
		end
	end)
	return true
end

-- Para los bots: las banderas con su estado
function Domination.Points()
	return points
end

function Domination.Stop()
	active = false
	if thread then
		pcall(task.cancel, thread)
		thread = nil
	end
	for _, point in points do
		if point.Visual then
			point.Visual:Destroy()
		end
	end
	points = {}
	for _, letter in LETTERS do
		for _, field in { "Position", "Owner", "Capturing", "Progress", "Contested" } do
			ReplicatedStorage:SetAttribute("Dom_" .. letter .. "_" .. field, nil)
		end
	end
end

return Domination
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Dummies</string>
            <string name="Source"><![CDATA[-- Muñecos de práctica para probar las armas en Studio (desactívalos en GameConfig.TrainingDummies).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Combat = require(script.Parent.Combat)

local Dummies = {}

local SPOTS = {
	Vector3.new(-20, 4, -60),
	Vector3.new(20, 4, 60),
	Vector3.new(-50, 4, 30),
	Vector3.new(50, 4, -30),
	Vector3.new(0, 11, 0),
}

local folder

-- Un punto libre del mapa actual (puntos FFASpawn) o uno de los fijos si no hay
local function randomSpot(fallback)
	local map = workspace:FindFirstChild("Map")
	local points = {}
	if map then
		for _, d in map:GetDescendants() do
			if d:IsA("BasePart") and d.Name == "FFASpawn" then
				table.insert(points, d.Position + Vector3.new(0, 3, 0))
			end
		end
	end
	if #points > 0 then
		return points[math.random(1, #points)]
	end
	return fallback
end

local function spawnDummy(position)
	position = randomSpot(position)
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = Color3.fromRGB(255, 200, 80)
	description.TorsoColor = Color3.fromRGB(80, 80, 90)
	description.LeftArmColor = Color3.fromRGB(255, 200, 80)
	description.RightArmColor = Color3.fromRGB(255, 200, 80)
	description.LeftLegColor = Color3.fromRGB(60, 60, 70)
	description.RightLegColor = Color3.fromRGB(60, 60, 70)

	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescriptionAsync(description, Enum.HumanoidRigType.R15)
	end)
	if not ok then
		ok, model = pcall(function()
			return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
		end)
	end
	if not ok then
		warn("[Dummies] No se pudo crear el muñeco:", model)
		return
	end
	model.Name = "Muñeco"
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayName = "Muñeco"
	humanoid.MaxHealth = 100
	humanoid.Health = 100
	model:PivotTo(CFrame.new(position) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	model.Parent = folder

	Combat.WatchHumanoid(humanoid, nil, "Muñeco")
	humanoid.Died:Connect(function()
		task.wait(4)
		model:Destroy()
		spawnDummy(position)
	end)
end

function Dummies.Init()
	if not GameConfig.TrainingDummies then
		return
	end
	folder = Instance.new("Folder")
	folder.Name = "Dummies"
	folder.Parent = workspace
	-- (cada uno en su hilo: crear el modelo espera a la red y no debe frenar el arranque del servidor)
	for _, position in SPOTS do
		task.spawn(spawnDummy, position)
	end
end

return Dummies
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Entitlements</string>
            <string name="Source"><![CDATA[-- Qué entrega cada compra con Robux y cómo se deshace. PlayerData.processReceipt lo usa así:
--   local plan = Entitlements.Plan(data, Products.Resolve(receipt.ProductId), ctx)
--   local undo = Entitlements.Apply(data, plan)   -- se apunta el PurchaseId y se guarda
--   (si no se pudo guardar: undo() y Roblox reintentará el recibo más tarde)
-- El plan solo depende de los datos del servidor: el cliente nunca dice qué se ha comprado.
-- Nunca se entrega dos veces lo mismo: lo que ya tenías se devuelve en monedas (precio real).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Catalog = require(Shared.Economy.CosmeticCatalog)
local Products = require(Shared.Economy.Products)
local BattlePassConfig = require(Shared.Economy.BattlePassConfig)
local MonetizationConfig = require(Shared.Economy.MonetizationConfig)

local Entitlements = {}

local function robuxCompensation(robux)
	return math.floor((tonumber(robux) or 0) * MonetizationConfig.Bundles.CoinsPerRobux)
end

local function newPlan(kind, key)
	return {
		Type = kind,
		Key = key,
		Items = {}, -- { Kind, Id } que se dan
		Coins = 0, -- monedas que se dan (pack, o compensación por lo que ya tenía)
		Compensation = 0, -- (parte de Coins que es compensación)
		Add = {}, -- { Path = {"Campo"...}, Amount = n } números que se suman
		Flags = {}, -- { Path = {"Campo"...}, Value = v }
		Reveal = { Items = {} }, -- lo que enseña la escena de compra
		Message = nil,
		Event = "purchase_success",
	}
end

local function addItems(plan, data, list, isVIP)
	for _, item in list do
		if Catalog.Exists(item.Kind, item.Id) then
			if Catalog.Owns(data, item.Kind, item.Id, isVIP) then
				local coins = Catalog.Compensation(item.Kind, item.Id)
				plan.Coins += coins
				plan.Compensation += coins
			else
				table.insert(plan.Items, { Kind = item.Kind, Id = item.Id })
				table.insert(plan.Reveal.Items, { Kind = item.Kind, Id = item.Id })
			end
		end
	end
end

-- resolved = Products.Resolve(productId); ctx = { IsVIP = bool, Now = os.time() }
function Entitlements.Plan(data, resolved, ctx)
	if not resolved then
		return nil
	end
	ctx = ctx or {}
	local def = resolved.Def
	local plan = newPlan(resolved.Type, resolved.Key)
	if resolved.Type == "Coins" then
		plan.Coins = def.Coins
		plan.Message = "+" .. def.Coins .. " MONEDAS"
		plan.Event = "coin_purchase"
	elseif resolved.Type == "Booster" then
		table.insert(plan.Add, { Path = { def.Field }, Amount = def.Minutes * 60 })
		plan.Message = def.Icon .. " ¡" .. string.upper(def.Name) .. " " .. def.Minutes .. " MIN!"
		plan.Reveal.Title = string.upper(def.Name) .. " · " .. def.Minutes .. " MIN"
		plan.Reveal.Icon = def.Icon
	elseif resolved.Type == "Revives" then
		table.insert(plan.Add, { Path = { "Revives" }, Amount = def.Revives })
		plan.Message = "+" .. def.Revives .. " REVIVIR INSTANTÁNEO"
		plan.Reveal.Title = plan.Message
		plan.Reveal.Icon = "💖"
	elseif resolved.Type == "WheelSpins" then
		local shop = require(Shared.Shop)
		table.insert(plan.Add, { Path = { "WheelSpins" }, Amount = shop.Wheel.SpinsPerPurchase })
		plan.Message = "+" .. shop.Wheel.SpinsPerPurchase .. " GIROS"
	elseif resolved.Type == "Starter" then
		plan.Event = "starter_pack_purchase"
		plan.Coins = def.Coins
		if data.StarterPack then
			-- (compra repetida: Roblox ya cobró, se entregan solo las monedas)
			plan.Message = "+" .. def.Coins .. " MONEDAS"
		else
			addItems(plan, data, Products.BundleItems(def), ctx.IsVIP)
			table.insert(plan.Flags, { Path = { "StarterPack" }, Value = true })
			plan.Message = "¡PACK DE INICIO DESBLOQUEADO!"
			plan.Reveal.Title = "PACK DE INICIO"
		end
	elseif resolved.Type == "Bundle" then
		plan.Coins = def.Coins or 0
		if type(data.Bundles) == "table" and data.Bundles[def.Id] then
			-- (ya lo tenía: solo las monedas que traiga, o lo que vale en monedas si no trae)
			if plan.Coins == 0 then
				plan.Coins = robuxCompensation(def.Robux)
				plan.Compensation = plan.Coins
			end
			plan.Message = "+" .. plan.Coins .. " MONEDAS"
		else
			addItems(plan, data, Products.BundleItems(def), ctx.IsVIP)
			table.insert(plan.Flags, { Path = { "Bundles", def.Id }, Value = true })
			plan.Message = (def.Icon or "📦") .. " ¡" .. def.Name .. " DESBLOQUEADO!"
			plan.Reveal.Title = def.Name
			plan.Reveal.Premium = def.Premium == true
		end
	elseif resolved.Type == "Item" then
		local kind, id = Catalog.ParseKey(resolved.Key)
		addItems(plan, data, { { Kind = kind, Id = id } }, ctx.IsVIP)
		if #plan.Items == 0 then
			-- (lo compró en otro sitio a la vez: lo pagado vuelve en monedas)
			plan.Coins = robuxCompensation(def.Robux)
			plan.Compensation = plan.Coins
		end
		local item = Catalog.Item(kind, id)
		plan.Message = item and ("¡" .. string.upper(item.Name) .. "!") or "¡COMPRA COMPLETADA!"
	elseif resolved.Type == "PassPremium" then
		plan.Event = "battlepass_purchase"
		local pass = data.Pass
		local season = BattlePassConfig.Current(ctx.Now)
		if season and season.Id == resolved.Key and type(pass) == "table" and pass.Season == season.Id and not pass.HasPremium then
			table.insert(plan.Flags, { Path = { "Pass", "HasPremium" }, Value = true })
			plan.Message = "🎖️ ¡PASE PREMIUM ACTIVADO!"
			plan.Reveal.Title = "PASE PREMIUM"
			plan.Reveal.Pass = true
		else
			plan.Coins = robuxCompensation(def.Robux)
			plan.Compensation = plan.Coins
			plan.Message = "+" .. plan.Coins .. " MONEDAS"
		end
	elseif resolved.Type == "TierSkip" then
		plan.Event = "battlepass_purchase"
		local pass = data.Pass
		local season = BattlePassConfig.Current(ctx.Now)
		local room = type(pass) == "table" and season and pass.Season == season.Id and (BattlePassConfig.MaxXP() - pass.XP) or 0
		local amount = math.min(room, (def.Tiers or 1) * BattlePassConfig.XPPerTier)
		if amount > 0 then
			table.insert(plan.Add, { Path = { "Pass", "XP" }, Amount = amount })
			plan.Message = "🎖️ +" .. (def.Tiers or 1) .. " NIVEL DEL PASE"
			plan.Reveal.Title = "NIVEL DEL PASE"
			plan.Reveal.Pass = true
		else
			plan.Coins = robuxCompensation(def.Robux)
			plan.Compensation = plan.Coins
			plan.Message = "+" .. plan.Coins .. " MONEDAS"
		end
	else
		return nil
	end
	-- Bonus de la primera compra con Robux: una tarjeta exclusiva (una vez)
	local bonus = MonetizationConfig.FirstPurchaseBonus
	if bonus and not data.FirstPurchase then
		table.insert(plan.Flags, { Path = { "FirstPurchase" }, Value = true })
		if Catalog.Exists(bonus.Kind, bonus.Id) and not Catalog.Owns(data, bonus.Kind, bonus.Id) then
			table.insert(plan.Items, { Kind = bonus.Kind, Id = bonus.Id })
			plan.Reveal.Bonus = { Kind = bonus.Kind, Id = bonus.Id }
		end
	end
	plan.Reveal.Coins = plan.Coins
	plan.Reveal.Compensation = plan.Compensation
	plan.Reveal.Type = plan.Type
	plan.Reveal.Key = plan.Key
	return plan
end

local function walk(data, path, create)
	local t = data
	for i = 1, #path - 1 do
		local key = path[i]
		if type(t[key]) ~= "table" then
			if not create then
				return nil, nil
			end
			t[key] = {}
		end
		t = t[key]
	end
	return t, path[#path]
end

-- Aplica el plan. Devuelve la función que lo deshace (solo lo que este plan cambió).
function Entitlements.Apply(data, plan)
	local log = {}
	for _, item in plan.Items do
		if Catalog.Grant(data, item.Kind, item.Id) then
			table.insert(log, function()
				Catalog.Revoke(data, item.Kind, item.Id)
			end)
		end
	end
	if plan.Coins ~= 0 then
		data.Coins = (tonumber(data.Coins) or 0) + plan.Coins
		table.insert(log, function()
			data.Coins -= plan.Coins
		end)
	end
	for _, add in plan.Add do
		local t, key = walk(data, add.Path, true)
		t[key] = (tonumber(t[key]) or 0) + add.Amount
		table.insert(log, function()
			local current, k = walk(data, add.Path, false)
			if current then
				current[k] = math.max(0, (tonumber(current[k]) or 0) - add.Amount)
			end
		end)
	end
	for _, flag in plan.Flags do
		local t, key = walk(data, flag.Path, true)
		local before = t[key]
		t[key] = flag.Value
		table.insert(log, function()
			local current, k = walk(data, flag.Path, false)
			if current then
				current[k] = before
			end
		end)
	end
	return function()
		for i = #log, 1, -1 do
			log[i]()
		end
	end
end

return Entitlements
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">Event</string>
            <string name="Source"><![CDATA[-- Evento de temporada (GameConfig.Event: el de las fechas de hoy, ver GameConfig.Events): durante
-- las rondas van apareciendo objetos del evento por el mapa (caramelos en Halloween, regalos en
-- Navidad) en los puntos de aparición libres. Al tocar uno: monedas y +1 al contador del evento (se
-- guarda); hay premios por el camino (Milestones) y al llegar a Goal se gana la skin exclusiva.
-- También decora los mapas (calabazas o muñecos de nieve; Event.Decorate lo llama MapBuilder).
-- Los bots no recogen objetos.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Skins = require(Shared.Skins)
local Outfits = require(Shared.Outfits)
local Weapons = require(Shared.Weapons)

local PlayerData = require(script.Parent.PlayerData)
local Kit = require(script.Parent.MapKit)

local Event = {}

-- El evento que toca (GameConfig.Event); con el servidor encendido mucho tiempo se cambia solo al
-- siguiente cuando acaba uno (ver useEvent en el bucle de Init)
local CONFIG, CANDY_COLORS, ICON, ITEM_ICON, ITEMS
local function useEvent(event)
	CONFIG = event
	GameConfig.Event = event
	CANDY_COLORS = event and event.ItemColors or { Color3.fromRGB(255, 130, 20) }
	ICON = event and event.Icon or "🎉"
	ITEM_ICON = event and event.ItemIcon or "⭐"
	ITEMS = event and event.Items or "objetos"
end
useEvent(GameConfig.Event)

local folder
local candies = {}
local lastPickup = {} -- [player] = os.clock() (límite de recogida)
local LIFETIME = 60 -- segundos que dura un caramelo sin recoger
local PICKUP_RANGE = 9 -- distancia máxima real al caramelo (contra trampas de "toque" a distancia)

local function enabled()
	return GameConfig.EventActive(CONFIG)
end

-- Puntos libres del mapa actual (FFASpawn); se guardan mientras no cambie el mapa
local cachedMap, cachedPoints = nil, {}
local function spawnPoints()
	local map = workspace:FindFirstChild("Map")
	if map ~= cachedMap then
		cachedMap, cachedPoints = map, {}
		if map then
			for _, d in map:GetDescendants() do
				if d:IsA("BasePart") and d.Name == "FFASpawn" then
					table.insert(cachedPoints, d.Position)
				end
			end
		end
	end
	return cachedPoints
end

local function clear()
	for _, candy in candies do
		candy:Destroy()
	end
	table.clear(candies)
end

-- Clave de un premio por el camino en la lista de reclamados. Los de arma llevan una clave propia:
-- ese premio antes eran monedas, y quien ya las cobró también debe recibir el arma.
local function milestoneKey(milestone)
	return "m" .. milestone.Count .. (milestone.Weapon and "w" or "")
end

local addProgress -- (definida justo después)

local function collect(player, candy)
	if not candy.Parent or candy:GetAttribute("Taken") then
		return
	end
	-- Comprobaciones del servidor: de verdad cerca y no demasiado seguido
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - candy.Position).Magnitude > PICKUP_RANGE then
		return
	end
	if os.clock() - (lastPickup[player] or 0) < 0.25 then
		return
	end
	lastPickup[player] = os.clock()
	candy:SetAttribute("Taken", true)
	local index = table.find(candies, candy)
	if index then
		table.remove(candies, index)
	end
	candy:Destroy()
	addProgress(player, 1, true)
end

-- Suma objetos del evento al contador del jugador y da los premios por el camino.
-- pickup = true: recogido en el mapa (da monedas y avisa con el contador)
addProgress = function(player, amount, pickup)
	local data = PlayerData.Get(player)
	if not data then
		return
	end
	if type(data.EventProgress) ~= "table" or data.EventProgress.Id ~= CONFIG.Id then
		data.EventProgress = { Id = CONFIG.Id, Count = 0 }
	end
	if type(data.EventProgress.Claimed) ~= "table" then
		-- Premios por el camino ya dados ("m25" = true). Los que ya se pasaron antes de existir esta
		-- lista se dieron al llegar justo a su número: se marcan como dados para no pagarlos dos veces
		local claimed = {}
		for _, milestone in CONFIG.Milestones or {} do
			if data.EventProgress.Count >= milestone.Count and not milestone.Weapon then
				claimed[milestoneKey(milestone)] = true
			end
		end
		data.EventProgress.Claimed = claimed
	end
	data.EventProgress.Count += amount
	local count = data.EventProgress.Count
	PlayerData.MarkDirty(player)
	if pickup then
		local coins = PlayerData.AddCoins(player, CONFIG.CandyCoins) -- (envía los datos al cliente, contador incluido)
		local itemName = CONFIG.Item or "objeto"
		Remotes.Notify:FireClient(player, "XP", ITEM_ICON .. " " .. string.upper(string.sub(itemName, 1, 1)) .. string.sub(itemName, 2) .. "  +" .. coins .. " 💰  (" .. math.min(count, CONFIG.Goal) .. "/" .. CONFIG.Goal .. ")")
	else
		PlayerData.SendUpdate(player)
		Remotes.Notify:FireClient(player, "Challenge", ITEM_ICON .. " +" .. amount .. " " .. ITEMS .. " de regalo  (" .. math.min(count, CONFIG.Goal) .. "/" .. CONFIG.Goal .. ")")
	end
	-- Premios por el camino (también los que quedaron atrás si el premio se añadió con el evento empezado)
	local claimed = data.EventProgress.Claimed
	for _, milestone in CONFIG.Milestones or {} do
		local key = milestoneKey(milestone)
		if count >= milestone.Count and milestone.Count < CONFIG.Goal and not claimed[key] then
			claimed[key] = true
			if milestone.Outfit and PlayerData.GiveOutfit(player, milestone.Outfit) then
				local outfit = Outfits.Get(milestone.Outfit)
				Remotes.Notify:FireClient(player, "Challenge", ICON .. " ¡" .. milestone.Count .. " " .. ITEMS .. "! Traje " .. outfit.Name .. " desbloqueado")
			elseif milestone.Weapon and PlayerData.GiveWeapon(player, milestone.Weapon) then
				Remotes.Notify:FireClient(player, "Challenge", ICON .. " ¡" .. milestone.Count .. " " .. ITEMS .. "! Arma " .. Weapons.Get(milestone.Weapon).DisplayName .. " desbloqueada")
			else
				local amount = milestone.Coins or milestone.Compensate or 0
				if amount > 0 then
					PlayerData.AddCoins(player, amount, false) -- premio fijo (no lo dobla el VIP)
					Remotes.Notify:FireClient(player, "Challenge", ICON .. " ¡" .. milestone.Count .. " " .. ITEMS .. "! +" .. amount .. " 💰")
				end
			end
		end
	end
	if count >= CONFIG.Goal and PlayerData.GiveSkin(player, CONFIG.RewardSkin) then
		local skin = Skins.Get(CONFIG.RewardSkin)
		Remotes.Notify:FireClient(player, "Challenge", ICON .. " ¡Skin " .. skin.Name .. " desbloqueada!")
	end
end

-- Raycast solo contra el mapa (ni jugadores ni bots)
local mapParams = RaycastParams.new()
mapParams.FilterType = Enum.RaycastFilterType.Include

local function groundAt(position, up, down)
	local map = workspace:FindFirstChild("Map")
	if not map then
		return nil
	end
	mapParams.FilterDescendantsInstances = { map, workspace.Terrain }
	local hit = workspace:Raycast(position + Vector3.new(0, up, 0), Vector3.new(0, -(up + down), 0), mapParams)
	return hit and hit.Instance.CanCollide and hit.Position or nil
end

local function spawnCandy()
	local points = spawnPoints()
	if #points == 0 then
		return
	end
	local base = points[math.random(1, #points)]
	-- Cerca del punto, sobre el suelo y sin meterse en paredes (si no, en el propio punto)
	local position = base + Vector3.new(0, 2.2, 0)
	for _ = 1, 4 do
		local candidate = base + Vector3.new(math.random(-40, 40) / 10, 0, math.random(-40, 40) / 10)
		local floor = groundAt(candidate, 2, 4)
		if floor and math.abs(floor.Y - base.Y) < 1.5 then
			local mapFolder = workspace:FindFirstChild("Map")
			local overlap = OverlapParams.new()
			overlap.FilterType = Enum.RaycastFilterType.Include
			overlap.FilterDescendantsInstances = { mapFolder }
			local blocking = false
			for _, part in workspace:GetPartBoundsInRadius(floor + Vector3.new(0, 2.2, 0), 0.9, overlap) do
				if part.CanCollide then
					blocking = true
					break
				end
			end
			if not blocking then
				position = floor + Vector3.new(0, 2.2, 0)
				break
			end
		end
	end
	local candy = Instance.new("Part")
	candy.Name = "Candy"
	-- (bola en Halloween; caja de regalo en Navidad)
	candy.Shape = CONFIG.ItemShape == "Block" and Enum.PartType.Block or Enum.PartType.Ball
	candy.Size = CONFIG.ItemShape == "Block" and Vector3.new(1.4, 1.4, 1.4) or Vector3.new(1.6, 1.6, 1.6)
	candy.Color = CANDY_COLORS[math.random(1, #CANDY_COLORS)]
	candy.Material = Enum.Material.SmoothPlastic
	candy.Anchored = true
	candy.CanCollide = false
	candy.CanQuery = false
	candy.CanTouch = true
	candy.CastShadow = false
	candy.CFrame = CFrame.new(position)
	candy:SetAttribute("Bob", 0.5) -- flota (lo anima WorldFX en el cliente)
	local light = Instance.new("PointLight")
	light.Color = candy.Color
	light.Range = 8
	light.Brightness = 1
	light.Parent = candy
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(candy.Color)
	sparkle.LightEmission = 1
	sparkle.Size = NumberSequence.new(0.4, 0)
	sparkle.Lifetime = NumberRange.new(0.5, 0.8)
	sparkle.Rate = 5
	sparkle.Speed = NumberRange.new(1, 2)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.Parent = candy
	candy.Touched:Connect(function(hit)
		local character = hit.Parent
		local player = character and Players:GetPlayerFromCharacter(character)
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if player and humanoid and humanoid.Health > 0 and not player:GetAttribute("InMenu") then
			collect(player, candy)
		end
	end)
	candy.Parent = folder
	table.insert(candies, candy)
	-- Si nadie lo coge, desaparece (y deja sitio a otro)
	task.delay(LIFETIME, function()
		if candy.Parent then
			local index = table.find(candies, candy)
			if index then
				table.remove(candies, index)
			end
			candy:Destroy()
		end
	end)
end

-- Decoración junto a algunos puntos libres del mapa (determinista: siempre en los mismos sitios):
-- calabazas (Decoration = "Pumpkin") o muñecos de nieve ("Snowman")
function Event.Decorate()
	if not enabled() or not CONFIG.Decoration then
		return
	end
	local points = spawnPoints()
	local rng = Random.new(#points * 7 + 3)
	for i, point in points do
		if i % 3 == 1 then
			local offset = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1))
			if offset.Magnitude < 0.1 then
				offset = Vector3.xAxis
			end
			-- Sobre el suelo que haya debajo (si el punto está en una plataforma, que no flote en el aire)
			local ground = groundAt(point + offset.Unit * 5, 3, 4)
			if ground then
				local cf = CFrame.new(ground) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
				if CONFIG.Decoration == "Snowman" then
					Kit.snowman(cf, rng:NextNumber(0.8, 1.2))
				else
					Kit.pumpkin(cf, rng:NextNumber(0.8, 1.3))
				end
			end
		end
	end
end

-- Enciende o apaga el evento (al empezar el servidor o cuando llega su fecha con el servidor en marcha)
local active = false
local function setActive(on)
	if on == active then
		return
	end
	active = on
	if on then
		folder = folder or Instance.new("Folder")
		folder.Name = "EventCandies"
		folder.Parent = workspace
		ReplicatedStorage:SetAttribute("EventId", CONFIG.Id)
		ReplicatedStorage:SetAttribute("EventName", CONFIG.Name)
		ReplicatedStorage:SetAttribute("EventGoal", CONFIG.Goal)
	else
		clear()
		ReplicatedStorage:SetAttribute("EventId", nil)
		ReplicatedStorage:SetAttribute("EventName", nil)
	end
end

-- Mientras haya evento, la recompensa diaria regala también unos cuantos objetos del evento
Event.DailyBonus = GameConfig.EventDailyBonus or 0

function Event.Init()
	PlayerData.OnDailyClaimed = function(player)
		if active and CONFIG and (Event.DailyBonus or 0) > 0 then
			addProgress(player, Event.DailyBonus, false)
		end
	end
	if not CONFIG or not GameConfig.Events then
		return
	end
	setActive(enabled())
	Players.PlayerRemoving:Connect(function(player)
		lastPickup[player] = nil
	end)
	ReplicatedStorage:GetAttributeChangedSignal("State"):Connect(function()
		if ReplicatedStorage:GetAttribute("State") ~= "Playing" then
			clear()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(CONFIG.SpawnEvery or 12)
			-- Llega o se acaba la fecha del evento con el servidor encendido (y si se acabó, se pasa al
			-- siguiente que toque: Halloween → Navidad)
			local okEvent, errEvent = pcall(function()
				if not active then
					local upcoming = GameConfig.PickEvent()
					if upcoming ~= CONFIG then
						useEvent(upcoming)
					end
				end
				setActive(enabled())
			end)
			if not okEvent then
				warn("[Event] cambio de evento:", errEvent)
			end
			local playing = ReplicatedStorage:GetAttribute("State") == "Playing" and not ReplicatedStorage:GetAttribute("Frozen")
			if active and playing and #candies < CONFIG.MaxCandies then
				local ok, err = pcall(spawnCandy)
				if not ok then
					warn("[Event] objeto del evento:", err)
				end
			end
		end
	end)
end

Event.Collect = collect -- (para las pruebas)
return Event
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">Flags</string>
            <string name="Source"><![CDATA[-- Modo Captura la bandera.
-- Cada equipo tiene una bandera en su base. Coge la enemiga (acércate a ella) y llévala a tu base
-- mientras tu bandera siga allí para puntuar. Si matan al portador la bandera cae al suelo:
-- sus dueños la devuelven tocándola y si nadie la toca vuelve sola.
--
-- Estado publicado en ReplicatedStorage para la interfaz:
--   FlagState_<Equipo>   = "Home" | "Carried" | "Dropped"
--   FlagCarrier_<Equipo> = nombre del portador ("" si nadie)
--   FlagPos_<Equipo>     = dónde está la bandera ahora (los bots van a por ella)
--   FlagHome_<Equipo>    = su base
-- y en el jugador: atributo CarryingFlag = true/false.
-- Los bots también cogen, llevan, capturan y devuelven banderas (el portador puede ser un jugador o
-- un bot: tabla de Bots con Name, Team, Model, Root y Humanoid).
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)

local PlayerData = require(script.Parent.PlayerData)
local Bots = require(script.Parent.Bots)

local Flags = {}

-- Asignado por Round: function(player, team) que suma el punto
Flags.OnCapture = nil

local SETTINGS = GameConfig.Flag
local POLE_HEIGHT = 8

local folder
local flags = {} -- [teamName] = flag
local active = false
local heartbeat

local function findBases()
	local bases = {}
	for _, inst in workspace:GetDescendants() do
		if inst:IsA("BasePart") and inst.Name == "FlagBase" then
			local team = inst:GetAttribute("Team")
			if type(team) == "string" then
				bases[team] = inst
			end
		end
	end
	return bases
end

-- ¿El mapa tiene una base para cada equipo?
function Flags.IsAvailable()
	local bases = findBases()
	for _, cfg in GameConfig.Teams do
		if not bases[cfg.Name] then
			return false
		end
	end
	return true
end

local function publish(flag)
	ReplicatedStorage:SetAttribute("FlagState_" .. flag.Team.Name, flag.State)
	ReplicatedStorage:SetAttribute("FlagPos_" .. flag.Team.Name, flag.Position)
	ReplicatedStorage:SetAttribute("FlagCarrier_" .. flag.Team.Name, flag.Carrier and flag.Carrier.Name or "")
	local text = "BANDERA " .. string.upper(flag.Team.Name)
	if flag.State == "Carried" then
		text ..= "\n¡ROBADA!"
	elseif flag.State == "Dropped" then
		text ..= "\nCAÍDA"
	end
	flag.Label.Text = text
end

local function buildFlag(team)
	local model = Instance.new("Model")
	model.Name = "Flag_" .. team.Name

	local function part(name, size, color, material, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.Material = material
		p.Shape = shape or Enum.PartType.Block
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false -- no bloquea disparos
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = false
		p.Parent = model
		return p
	end

	local pole = part("Pole", Vector3.new(0.3, POLE_HEIGHT, 0.3), Color3.fromRGB(220, 220, 225), Enum.Material.Metal)
	local cloth = part("Cloth", Vector3.new(0.15, 2.4, 3.6), team.TeamColor.Color, Enum.Material.Neon)
	cloth.CFrame = pole.CFrame * CFrame.new(0, POLE_HEIGHT / 2 - 1.4, 1.8)
	local tip = part("Tip", Vector3.new(0.6, 0.6, 0.6), Color3.fromRGB(255, 200, 40), Enum.Material.Neon, Enum.PartType.Ball)
	tip.CFrame = pole.CFrame * CFrame.new(0, POLE_HEIGHT / 2 + 0.3, 0)
	for _, p in { cloth, tip } do
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = pole
		weld.Part1 = p
		weld.Parent = p
	end
	model.PrimaryPart = pole

	local light = Instance.new("PointLight")
	light.Color = team.TeamColor.Color
	light.Range = 14
	light.Brightness = 2
	light.Parent = cloth

	-- Destellos del color del equipo
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkles.Color = ColorSequence.new(team.TeamColor.Color, Color3.new(1, 1, 1))
	sparkles.LightEmission = 1
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
	sparkles.Lifetime = NumberRange.new(0.6, 1.2)
	sparkles.Speed = NumberRange.new(0.5, 1.5)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Rate = 8
	sparkles.Parent = cloth

	-- Marcador visible a través de las paredes
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Marker"
	billboard.Size = UDim2.fromOffset(160, 56)
	billboard.StudsOffset = Vector3.new(0, POLE_HEIGHT / 2 + 2.5, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = 1000
	billboard.Parent = pole
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextSize = 18
	label.TextColor3 = team.TeamColor.Color:Lerp(Color3.new(1, 1, 1), 0.25)
	label.TextStrokeTransparency = 0.2
	label.Text = ""
	label.Parent = billboard

	model.Parent = folder
	return model, label
end

local function setAnchored(flag, anchored)
	for _, p in flag.Model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = anchored
		end
	end
end

-- Coloca la bandera de pie en una posición del suelo
local function placeAt(flag, groundPosition)
	if flag.Weld then
		flag.Weld:Destroy()
		flag.Weld = nil
	end
	setAnchored(flag, true)
	flag.Model:PivotTo(CFrame.new(groundPosition + Vector3.new(0, POLE_HEIGHT / 2, 0)))
	flag.Position = groundPosition
end

local function homePosition(flag)
	-- Superficie de la base (sirve para piezas giradas o cilindros)
	return flag.Base.Position + Vector3.new(0, flag.Base.ExtentsSize.Y / 2, 0)
end

-- ¿El personaje (su HumanoidRootPart) está junto a un punto del suelo?
local function isNear(rootPosition, groundPosition, radius)
	local offset = rootPosition - groundPosition
	return Vector3.new(offset.X, 0, offset.Z).Magnitude <= radius and offset.Y > -2 and offset.Y < 8
end

local function isPlayer(entity)
	return typeof(entity) == "Instance"
end

local function setCarrying(entity, value)
	if isPlayer(entity) then
		entity:SetAttribute("CarryingFlag", value)
	elseif entity then
		entity.CarryingFlag = value
		-- Los bots con la bandera van algo más lentos, como los jugadores
		if entity.Humanoid then
			entity.Humanoid.WalkSpeed = GameConfig.Bots.WalkSpeed * (value and SETTINGS.CarrierSpeedMultiplier or 1)
		end
	end
end

local function setCarrier(flag, player)
	if flag.Carrier then
		setCarrying(flag.Carrier, false)
	end
	flag.Carrier = player
	if player then
		setCarrying(player, true)
	end
end

local function returnHome(flag, returner, silent)
	setCarrier(flag, nil)
	flag.State = "Home"
	flag.CarrierHumanoid = nil
	placeAt(flag, homePosition(flag))
	publish(flag)
	if silent then
		return
	elseif returner then
		Remotes.Notify:FireAllClients("Flag", returner.Name .. " devolvió la bandera " .. flag.Team.Name)
		if isPlayer(returner) then
			PlayerData.AddXP(returner, GameConfig.XP.FlagReturn, "Bandera devuelta")
		end
	else
		Remotes.Notify:FireAllClients("Flag", "La bandera " .. flag.Team.Name .. " volvió a su base")
	end
end

local function groundBelow(position, ignore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	ignore = table.clone(ignore)
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	params.FilterDescendantsInstances = ignore
	local result = workspace:Raycast(position + Vector3.new(0, 2, 0), Vector3.new(0, -60, 0), params)
	return result and result.Position or position - Vector3.new(0, 3, 0)
end

local function drop(flag)
	local carrier = flag.Carrier
	local humanoid = flag.CarrierHumanoid
	local root = flag.Model.PrimaryPart
	local ignore = { folder }
	local carrierModel = carrier and (isPlayer(carrier) and carrier.Character or carrier.Model)
	if carrierModel then
		table.insert(ignore, carrierModel)
	end
	local position = groundBelow(flag.LastCarrierPosition or root.Position, ignore)

	-- Recompensa a quien eliminó al portador
	if humanoid then
		local attackerId = humanoid:GetAttribute("LastAttacker")
		local hitTime = humanoid:GetAttribute("LastHitTime")
		local killer = attackerId and Players:GetPlayerByUserId(attackerId)
		if killer and hitTime and os.clock() - hitTime < 10 and humanoid.Health <= 0 then
			PlayerData.AddXP(killer, GameConfig.XP.CarrierKill, "Portador eliminado")
		end
	end

	setCarrier(flag, nil)
	flag.CarrierHumanoid = nil
	flag.State = "Dropped"
	flag.DroppedAt = os.clock()
	placeAt(flag, position)
	publish(flag)
	Remotes.Notify:FireAllClients("Flag", "¡La bandera " .. flag.Team.Name .. " ha caído!")
end

local function pickup(flag, player, character)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	setCarrier(flag, player)
	flag.CarrierHumanoid = character:FindFirstChildOfClass("Humanoid")
	flag.State = "Carried"
	flag.LastCarrierPosition = root.Position

	-- Soldada a la espalda del portador
	setAnchored(flag, false)
	flag.Model:PivotTo(root.CFrame * CFrame.new(0, 1.2, 1) * CFrame.Angles(math.rad(-15), 0, 0))
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = flag.Model.PrimaryPart
	weld.Parent = flag.Model.PrimaryPart
	flag.Weld = weld

	publish(flag)
	Remotes.Notify:FireAllClients("Flag", player.Name .. " tiene la bandera " .. flag.Team.Name .. "!")
end

local function capture(flag, player)
	local team = player.Team
	returnHome(flag, nil, true)
	Remotes.Notify:FireAllClients("Big", "¡" .. string.upper(player.Name) .. " CAPTURÓ LA BANDERA!")
	if isPlayer(player) then
		PlayerData.AddXP(player, GameConfig.XP.Capture, "Captura")
		PlayerData.AddCoins(player, GameConfig.Coins.Capture)
		PlayerData.Track(player, "Capture", 1)
		player:SetAttribute("Captures", (player:GetAttribute("Captures") or 0) + 1)
	end
	if Flags.OnCapture then
		Flags.OnCapture(player, team)
	end
end

local function aliveCharacter(player)
	if not isPlayer(player) then
		-- Bot
		if player.Humanoid and player.Humanoid.Health > 0 and player.Model and player.Root then
			return player.Model, player.Root
		end
		return nil, nil
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then
		return character, root
	end
	return nil, nil
end

local function isCarrying(player)
	for _, flag in flags do
		if flag.Carrier == player then
			return true
		end
	end
	return false
end

local lastTick = 0
local function step()
	if not active or os.clock() - lastTick < 0.1 then
		return
	end
	lastTick = os.clock()

	for _, flag in flags do
		if flag.State == "Carried" then
			local carrier = flag.Carrier
			local character, root = nil, nil
			if carrier and (not isPlayer(carrier) or carrier.Parent) then
				character, root = aliveCharacter(carrier)
			end
			if
				not character
				or flag.CarrierHumanoid == nil
				or character:FindFirstChildOfClass("Humanoid") ~= flag.CarrierHumanoid
				or carrier.Team == flag.Team
			then
				drop(flag)
			else
				flag.LastCarrierPosition = root.Position
				ReplicatedStorage:SetAttribute("FlagPos_" .. flag.Team.Name, root.Position)
				-- ¿Ha llegado a su base con su propia bandera en casa?
				local ownFlag = carrier.Team and flags[carrier.Team.Name]
				if
					ownFlag
					and ownFlag.State == "Home"
					and isNear(root.Position, homePosition(ownFlag), SETTINGS.CaptureRadius)
				then
					capture(flag, carrier)
				end
			end
		else
			if flag.State == "Dropped" and os.clock() - flag.DroppedAt >= SETTINGS.AutoReturnTime then
				returnHome(flag, nil)
			end
			-- Jugadores y bots que tocan la bandera
			local touchers = Players:GetPlayers()
			for _, agent in Bots.Agents do
				table.insert(touchers, agent)
			end
			for _, player in touchers do
				-- Quien sigue en la pantalla de inicio (invulnerable) no puede coger ni devolver banderas
				local inMenu = isPlayer(player) and player:GetAttribute("InMenu")
				-- ni quien acaba de revivir donde cayó (si no, recuperaría al instante la bandera que soltó)
				local revived = isPlayer(player) and os.clock() - (player:GetAttribute("RevivedAt") or -math.huge) < 5
				if player.Team and flag.State ~= "Carried" and not inMenu and not revived then
					local character, root = aliveCharacter(player)
					if character and isNear(root.Position, flag.Position, SETTINGS.PickupRadius) then
						if player.Team == flag.Team then
							if flag.State == "Dropped" then
								returnHome(flag, player)
							end
						elseif not isCarrying(player) then
							pickup(flag, player, character)
						end
					end
				end
			end
		end
	end
end

-- Crea las banderas en sus bases (inicio de una ronda de CTF)
function Flags.Start()
	Flags.Stop()
	local bases = findBases()
	folder = Instance.new("Folder")
	folder.Name = "Flags"
	folder.Parent = workspace
	for _, team in Teams:GetTeams() do
		local base = bases[team.Name]
		if base then
			local flag = { Team = team, Base = base, State = "Home" }
			flag.Model, flag.Label = buildFlag(team)
			placeAt(flag, homePosition(flag))
			ReplicatedStorage:SetAttribute("FlagHome_" .. team.Name, homePosition(flag))
			flags[team.Name] = flag
			publish(flag)
		end
	end
	active = true
	heartbeat = RunService.Heartbeat:Connect(step)
end

-- Quita las banderas (fin de la ronda)
function Flags.Stop()
	active = false
	if heartbeat then
		heartbeat:Disconnect()
		heartbeat = nil
	end
	for teamName, flag in flags do
		setCarrier(flag, nil)
		ReplicatedStorage:SetAttribute("FlagState_" .. teamName, nil)
		ReplicatedStorage:SetAttribute("FlagCarrier_" .. teamName, nil)
		ReplicatedStorage:SetAttribute("FlagPos_" .. teamName, nil)
		ReplicatedStorage:SetAttribute("FlagHome_" .. teamName, nil)
	end
	table.clear(flags)
	if folder then
		folder:Destroy()
		folder = nil
	end
	for _, player in Players:GetPlayers() do
		player:SetAttribute("CarryingFlag", false)
	end
end

return Flags
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Friends</string>
            <string name="Source"><![CDATA[-- Bonus de amigos: +10% de XP y monedas por cada amigo de Roblox que esté en el mismo servidor
-- (hasta +30%). Anima a invitar a amigos. Atributo del jugador: FriendsHere (cuántos hay).
-- PlayerData lo aplica en su multiplicador de premios.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local Friends = {}

Friends.BonusPerFriend = 0.1
Friends.MaxFriends = 3

local friendsOf = {} -- [player] = { [otherPlayer] = true }

-- Lo llama Round para juntar a los amigos en el mismo equipo (nuevo jugador, su amigo)
Friends.OnFriendship = nil :: ((Player, Player) -> ())?

local function publish(player)
	local count = 0
	for other in friendsOf[player] or {} do
		if other.Parent then
			count += 1
		end
	end
	player:SetAttribute("FriendsHere", count)
end

-- ¿Son amigos de Roblox (y están los dos en este servidor)? Round lo usa para ponerlos en el mismo equipo
function Friends.AreFriends(a, b)
	return friendsOf[a] ~= nil and friendsOf[a][b] == true
end

-- Multiplicador por amigos (1 = sin bonus)
function Friends.Multiplier(player)
	return 1 + Friends.BonusPerFriend * math.min(Friends.MaxFriends, player:GetAttribute("FriendsHere") or 0)
end

local function onPlayer(player)
	friendsOf[player] = friendsOf[player] or {}
	publish(player)
	for _, other in Players:GetPlayers() do
		if other ~= player then
			task.spawn(function()
				local ok, isFriend = pcall(player.IsFriendsWith, player, other.UserId)
				if ok and isFriend and player.Parent and other.Parent then
					if friendsOf[player][other] then
						return -- ya contados (y avisados)
					end
					friendsOf[player][other] = true
					friendsOf[other] = friendsOf[other] or {}
					friendsOf[other][player] = true
					publish(player)
					publish(other)
					-- (Round pone juntos a los amigos si el reparto lo permite)
					if Friends.OnFriendship then
						task.spawn(Friends.OnFriendship, player, other)
					end
					local bonus = math.floor(Friends.BonusPerFriend * 100)
					Remotes.Notify:FireClient(other, "Info", "👥 Tu amigo " .. player.DisplayName .. " ha entrado: +" .. bonus .. "% XP y monedas")
					Remotes.Notify:FireClient(player, "Info", "👥 Juegas con tu amigo " .. other.DisplayName .. ": +" .. bonus .. "% XP y monedas")
				end
			end)
		end
	end
end

function Friends.Init()
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayer, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		for other in friendsOf[player] or {} do
			if friendsOf[other] then
				friendsOf[other][player] = nil
				if other.Parent then
					publish(other)
				end
			end
		end
		friendsOf[player] = nil
	end)
end

return Friends
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">Gifts</string>
            <string name="Source"><![CDATA[-- Regalos por tiempo jugado (GameConfig.PlaytimeGifts): cada pocos minutos de sesión hay un regalo
-- que se recoge con el botón 🎁 (monedas, XP o revivir instantáneos). El servidor cuenta el tiempo.
-- El progreso del día (regalos recogidos y tiempo jugado) se guarda con el resto de datos, así que
-- salir y volver a entrar no reinicia la cuenta: al día siguiente empieza de cero.
-- Atributos del jugador para la interfaz: GiftStart (hora del servidor equivalente al inicio de la
-- cuenta) y GiftsClaimed.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Shop = require(Shared.Shop)

local PlayerData = require(script.Parent.PlayerData)

local Gifts = {}

local started = {} -- [player] = os.clock() equivalente al inicio de la cuenta de hoy
local claimed = {} -- [player] = regalos recogidos hoy
local days = {} -- [player] = día (Shop.DayNumber) al que corresponde la cuenta
local restored = {} -- [player] = true cuando ya se ha leído el progreso guardado (antes no se guarda ni se reclama)

local function publish(player)
	player:SetAttribute("GiftStart", workspace:GetServerTimeNow() - (os.clock() - started[player]))
	player:SetAttribute("GiftsClaimed", claimed[player] or 0)
end

-- Si ha cambiado el día (la sesión cruzó la medianoche UTC), la cuenta empieza de cero
local function checkDay(player)
	local today = Shop.DayNumber()
	if started[player] and days[player] ~= today then
		days[player] = today
		started[player] = os.clock()
		claimed[player] = 0
		publish(player)
	end
end

-- Copia el progreso a los datos guardados
local function persist(player)
	local data = PlayerData.Get(player)
	if data and started[player] and restored[player] then
		checkDay(player)
		data.Gifts = { Day = days[player], Claimed = claimed[player] or 0, Seconds = math.floor(os.clock() - started[player]) }
		PlayerData.MarkDirty(player)
	end
end

local function describe(gift)
	local parts = {}
	if gift.Coins then
		table.insert(parts, "+" .. gift.Coins .. " 💰")
	end
	if gift.XP then
		table.insert(parts, "+" .. gift.XP .. " XP")
	end
	if gift.Revives then
		table.insert(parts, "+" .. gift.Revives .. " 💖 revivir")
	end
	return table.concat(parts, "  ")
end
Gifts.Describe = describe

local function claim(player)
	checkDay(player)
	local index = (claimed[player] or 0) + 1
	local gift = GameConfig.PlaytimeGifts[index]
	if not gift or not started[player] then
		return false, "No hay más regalos hoy"
	end
	if os.clock() - started[player] < gift.Minutes * 60 - 1 then
		return false, "Todavía no"
	end
	if not PlayerData.Get(player) or not restored[player] then
		return false, "Cargando tus datos"
	end
	claimed[player] = index
	player:SetAttribute("GiftsClaimed", index)
	persist(player)
	if gift.Coins then
		PlayerData.AddCoins(player, gift.Coins, false)
	end
	if gift.XP then
		PlayerData.AddXP(player, gift.XP, "Regalo")
	end
	if gift.Revives then
		PlayerData.AddRevives(player, gift.Revives)
	end
	Remotes.Notify:FireClient(player, "Challenge", "🎁 Regalo: " .. describe(gift))
	return true, index
end

function Gifts.Init()
	Remotes.ClaimGift.OnServerInvoke = claim
	local function onPlayer(player)
		started[player] = os.clock()
		claimed[player] = 0
		days[player] = Shop.DayNumber()
		publish(player)
		-- Recupera el progreso de hoy (si ya jugó hoy en otro servidor o antes de salir). Espera lo que
		-- haga falta: hasta entonces no se guarda nada (si no, se borraría el progreso guardado)
		task.spawn(function()
			local data
			while player.Parent and started[player] and not data do
				data = PlayerData.WaitFor(player, 5)
			end
			if not data or not player.Parent or not started[player] then
				return
			end
			local saved = data.Gifts
			if type(saved) == "table" and saved.Day == days[player] then
				claimed[player] = math.max(claimed[player], saved.Claimed or 0)
				started[player] = math.min(started[player], os.clock() - (saved.Seconds or 0))
				publish(player)
			end
			restored[player] = true
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	-- Antes del guardado final (al salir o al cerrar el servidor); después se olvida al jugador
	PlayerData.OnLeaving = function(player)
		persist(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		-- Se limpia un poco después para que el guardado final lo encuentre (el orden de los
		-- eventos de salida no está garantizado)
		task.delay(5, function()
			started[player] = nil
			claimed[player] = nil
			days[player] = nil
			restored[player] = nil
		end)
	end)
	-- Guarda el tiempo jugado de vez en cuando (por si el servidor se cierra de golpe)
	task.spawn(function()
		while true do
			task.wait(30)
			for player in started do
				if player.Parent then
					local ok, err = pcall(persist, player)
					if not ok then
						warn("[Gifts] No se pudo guardar el tiempo jugado de", player.Name, err)
					end
				end
			end
		end
	end)
end

return Gifts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">Graffiti</string>
            <string name="Source"><![CDATA[-- Grafitis (Sprays): el cliente dice dónde quiere pintar y el servidor lo comprueba (que esté vivo y
-- jugando, que el punto esté a su alcance y a la vista, recarga) y pinta el grafiti equipado. Uno por
-- jugador: el nuevo borra el anterior. Van dentro del mapa, así que se borran al cambiar de mapa.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Sprays = require(Shared.Sprays)

local PlayerData = require(script.Parent.PlayerData)

local Graffiti = {}

local lastSpray = {}
local lastTry = {} -- (freno a peticiones seguidas, aunque fallen)
local current = {}

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function finite(v)
	return typeof(v) == "Vector3" and v.X == v.X and v.Y == v.Y and v.Z == v.Z
		and math.abs(v.X) < 1e5 and math.abs(v.Y) < 1e5 and math.abs(v.Z) < 1e5
end

-- Personajes (jugadores y bots) para que el rayo no pinte encima de nadie
local function characters()
	local list = {}
	for _, other in Players:GetPlayers() do
		if other.Character then
			table.insert(list, other.Character)
		end
	end
	for _, model in workspace:GetChildren() do
		if model:IsA("Model") and model:FindFirstChildOfClass("Humanoid") then
			table.insert(list, model)
		end
	end
	return list
end

function Graffiti.Paint(player, position)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local head = character and character:FindFirstChild("Head")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not (humanoid and head and root) or humanoid.Health <= 0 or player:GetAttribute("InMenu") then
		return false
	end
	if not finite(position) then
		return false
	end
	local now = os.clock()
	if lastSpray[player] and now - lastSpray[player] < Sprays.Cooldown then
		return false
	end
	if lastTry[player] and now - lastTry[player] < 0.25 then
		return false
	end
	lastTry[player] = now
	local offset = position - head.Position
	if offset.Magnitude > Sprays.Range + 3 or offset.Magnitude < 0.5 then
		return false
	end
	-- El servidor mira lo que hay de verdad en ese punto (y usa su superficie)
	rayParams.FilterDescendantsInstances = characters()
	local hit = workspace:Raycast(head.Position, offset.Unit * (offset.Magnitude + 1), rayParams)
	if not hit or (hit.Position - position).Magnitude > 2 or not hit.Instance.Anchored or hit.Instance.Transparency > 0.6 then
		return false
	end
	lastSpray[player] = now

	local normal = hit.Normal
	local up = math.abs(normal.Y) > 0.9 and root.CFrame.LookVector or Vector3.yAxis
	local origin = hit.Position + normal * 0.04
	local part = Instance.new("Part")
	part.Name = "Spray_" .. player.UserId
	part.Size = Vector3.new(Sprays.Size, Sprays.Size, 0.05)
	part.CFrame = CFrame.lookAt(origin, origin + normal, up)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0.6
	gui.MaxDistance = 200
	gui.Parent = part
	local data = PlayerData.Get(player)
	local sprayId = data and data.EquippedSpray or "Default"
	if not Sprays.Owns(data and data.Sprays, sprayId, player:GetAttribute("VIP") == true) then
		sprayId = "Default" -- (p. ej. el de VIP si ya no lo es)
	end
	Sprays.Draw(sprayId, gui)

	if current[player] then
		current[player]:Destroy()
	end
	current[player] = part
	part.Parent = workspace:FindFirstChild("Map") or workspace
	return true
end

function Graffiti.Init()
	Remotes.Spray.OnServerEvent:Connect(Graffiti.Paint)
	Players.PlayerRemoving:Connect(function(player)
		if current[player] then
			current[player]:Destroy()
		end
		current[player] = nil
		lastSpray[player] = nil
		lastTry[player] = nil
	end)
end

return Graffiti
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">Grenades</string>
            <string name="Source"><![CDATA[-- Granadas: el servidor crea la granada con física, la deja rebotar y la hace explotar.
-- Cada jugador tiene una, que se recarga sola (atributo GrenadeReadyAt = hora del servidor).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Weapons = require(Shared.Weapons)
local Remotes = require(Shared.Remotes)

local Combat = require(script.Parent.Combat)

local Grenades = {}

local DEF = Weapons.Grenade

local folder

local function now()
	return workspace:GetServerTimeNow()
end

local function makeGrenade(cf)
	local ball = Instance.new("Part")
	ball.Name = "Grenade"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(0.9, 0.9, 0.9)
	ball.Color = Color3.fromRGB(60, 70, 50)
	ball.Material = Enum.Material.Metal
	ball.CFrame = cf
	ball.CanCollide = true
	ball.CanQuery = false
	ball.CanTouch = false
	ball.CustomPhysicalProperties = PhysicalProperties.new(2, 0.7, 0.35, 1, 1)
	local band = Instance.new("Part")
	band.Name = "Band"
	band.Shape = Enum.PartType.Cylinder
	band.Size = Vector3.new(0.2, 0.95, 0.95)
	band.Color = Color3.fromRGB(255, 50, 40)
	band.Material = Enum.Material.Neon
	band.CanCollide = false
	band.CanQuery = false
	band.CanTouch = false
	band.Massless = true
	band.CFrame = cf
	band.Parent = ball
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = ball
	weld.Part1 = band
	weld.Parent = band
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 60, 40)
	light.Range = 8
	light.Brightness = 2
	light.Parent = band
	return ball, light
end

local pins = setmetatable({}, { __mode = "k" }) -- [Player] = now() al quitar la anilla

local function pullPin(player)
	pins[player] = now()
end

-- cook: segundos que el jugador la tuvo cocinándose en la mano (sale con menos mecha)
local function throw(player, direction, cook)
	if typeof(direction) ~= "Vector3" then
		return
	end
	-- (como mucho hasta que le quede un pelín de mecha; también descarta NaN). Y nunca más de lo que el
	-- servidor vio que la tuvo sin anilla (más un poco por la latencia)
	local pinAt = pins[player]
	pins[player] = nil
	local held = pinAt and (now() - pinAt + 0.15) or 0
	cook = (type(cook) == "number" and cook == cook) and math.clamp(cook, 0, math.min(DEF.Fuse - 0.2, held)) or 0
	local length = direction.Magnitude
	if not (length >= 0.5 and length <= 1.5) then -- también descarta NaN
		return
	end
	if player:GetAttribute("InMenu") or ReplicatedStorage:GetAttribute("Mode") == "GUN" or ReplicatedStorage:GetAttribute("Frozen") then
		return
	end
	if player.Team and player.Team.Name == ReplicatedStorage:GetAttribute("HeldTeam") then
		return -- (Buscar y destruir: atacantes aún en la base)
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local head = character and character:FindFirstChild("Head")
	-- (los zombis de la Infección solo arañan)
	if not humanoid or humanoid.Health <= 0 or not head or character:GetAttribute("Zombie") then
		return
	end
	if now() < (player:GetAttribute("GrenadeReadyAt") or 0) then
		return
	end
	player:SetAttribute("GrenadeReadyAt", now() + DEF.Cooldown)
	-- Lanzar quita la protección de aparición, como disparar
	for _, child in character:GetChildren() do
		if child:IsA("ForceField") then
			child:Destroy()
		end
	end

	direction = direction.Unit
	-- Nunca aparece al otro lado de una pared: si hay algo delante, se queda de este lado
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, folder }
	local hit = workspace:Raycast(head.Position, direction * 2.5, params)
	local start = hit and (hit.Position - direction * 0.6) or (head.Position + direction * 2)
	local grenade, light = makeGrenade(CFrame.new(start))
	-- (para el aviso de granada cercana del cliente: no avisa de las propias ni de las del equipo)
	grenade:SetAttribute("Thrower", player.Name)
	grenade:SetAttribute("Team", player.Team and player.Team.Name or "")
	-- No choca con quien la lanza (si mira hacia abajo no sale rebotada de su cuerpo)
	for _, part in character:GetDescendants() do
		if part:IsA("BasePart") then
			local noCollide = Instance.new("NoCollisionConstraint")
			noCollide.Part0 = grenade
			noCollide.Part1 = part
			noCollide.Parent = grenade
		end
	end
	grenade.Parent = folder
	grenade:SetNetworkOwner(nil)
	grenade.AssemblyLinearVelocity = direction * DEF.ThrowSpeed + Vector3.new(0, 14, 0)
	grenade.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 20

	task.spawn(function()
		-- Parpadeo cada vez más rápido (con la mecha que le quede si se cocinó)
		local fuseEnd = os.clock() + DEF.Fuse - cook
		while os.clock() < fuseEnd and grenade.Parent do
			light.Enabled = not light.Enabled
			task.wait(math.max(0.06, (fuseEnd - os.clock()) * 0.15))
		end
		if not grenade.Parent then
			return
		end
		local position = grenade.Position + Vector3.new(0, 0.6, 0)
		grenade:Destroy()
		Remotes.ExplosionFX:FireAllClients(position, DEF.Explosive.Radius)
		if player.Parent then
			Combat.Explode(player, position, DEF, "Grenade")
		end
	end)
end

-- Granada lanzada por un bot hacia un punto (tiro parabólico). onExplode(position) se encarga del
-- daño (los bots no son jugadores: ver Bots).
function Grenades.BotThrow(model, from, target, onExplode)
	if not folder or ReplicatedStorage:GetAttribute("Frozen") then
		return false
	end
	-- Nunca al otro lado de una pared: si hay algo entre la cabeza y el punto de salida, se queda de este lado
	local head = model:FindFirstChild("Head")
	if head then
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { model, folder }
		local offset = from - head.Position
		local hit = offset.Magnitude > 0.05 and workspace:Raycast(head.Position, offset, params)
		if hit then
			from = hit.Position - offset.Unit * 0.6
		end
	end
	local flight = math.clamp((target - from).Magnitude / 45, 0.6, 1.3)
	local gravity = Vector3.new(0, -workspace.Gravity, 0)
	local velocity = (target - from) / flight - gravity * flight / 2
	local grenade, light = makeGrenade(CFrame.new(from))
	grenade:SetAttribute("Thrower", model.Name)
	grenade:SetAttribute("Team", model:GetAttribute("Team") or "")
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			local noCollide = Instance.new("NoCollisionConstraint")
			noCollide.Part0 = grenade
			noCollide.Part1 = part
			noCollide.Parent = grenade
		end
	end
	grenade.Parent = folder
	pcall(function()
		grenade:SetNetworkOwner(nil)
	end)
	grenade.AssemblyLinearVelocity = velocity
	task.spawn(function()
		local fuseEnd = os.clock() + DEF.Fuse
		while os.clock() < fuseEnd and grenade.Parent do
			light.Enabled = not light.Enabled
			task.wait(math.max(0.06, (fuseEnd - os.clock()) * 0.15))
		end
		if not grenade.Parent then
			return
		end
		local position = grenade.Position + Vector3.new(0, 0.6, 0)
		grenade:Destroy()
		Remotes.ExplosionFX:FireAllClients(position, DEF.Explosive.Radius)
		onExplode(position)
	end)
	return true
end

function Grenades.Init()
	folder = Instance.new("Folder")
	folder.Name = "Grenades"
	folder.Parent = workspace
	Remotes.ThrowGrenade.OnServerEvent:Connect(throw)
	Remotes.GrenadePin.OnServerEvent:Connect(pullPin)
end

-- Al empezar una ronda todos tienen la granada lista (reaparecer no la recarga: evita abusar)
function Grenades.Reset()
	for _, player in Players:GetPlayers() do
		player:SetAttribute("GrenadeReadyAt", 0)
	end
end

return Grenades
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">Hardpoint</string>
            <string name="Source"><![CDATA[-- Modo "Zona de control": una zona activa que cambia de sitio cada minuto. El equipo que la ocupa
-- (sin enemigos dentro) suma 1 punto por segundo. Si hay jugadores de los dos equipos, está disputada.
--
-- Estado para la interfaz (atributos de ReplicatedStorage):
--   ZoneOwner = "" | nombre del equipo | "Contested",  ZoneMoveIn = segundos hasta que cambie,
--   ZonePosition = Vector3
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Teams = game:GetService("Teams")

local Shared = ReplicatedStorage.Shared
local Remotes = require(Shared.Remotes)

local PlayerData = require(script.Parent.PlayerData)

local Hardpoint = {}

Hardpoint.OnScore = nil -- function(team, amount)

local ROTATE_TIME = 60
local XP_INTERVAL = 5

local active = false
local zones = {}
local index = 0
local visual
local thread

local function findZones()
	local list = {}
	local map = workspace:FindFirstChild("Map")
	if map then
		for _, d in map:GetDescendants() do
			if d:IsA("BasePart") and d.Name == "HardpointZone" then
				table.insert(list, d)
			end
		end
	end
	table.sort(list, function(a, b)
		return (a:GetAttribute("Order") or 0) < (b:GetAttribute("Order") or 0)
	end)
	return list
end

function Hardpoint.IsAvailable()
	return #findZones() > 0
end

local function makeVisual(zone)
	if visual then
		visual:Destroy()
	end
	local radius = zone:GetAttribute("Radius") or 10
	local model = Instance.new("Model")
	model.Name = "ActiveZone"
	local function part(name, size, cf, material, transparency)
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Size = size
		p.CFrame = cf
		p.Material = material
		p.Transparency = transparency or 0
		p.Color = Color3.new(1, 1, 1)
		p.Parent = model
		return p
	end
	local base = zone.Position
	local ring = part("Ring", Vector3.new(0.3, radius * 2 + 1, radius * 2 + 1), CFrame.new(base + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.pi / 2), Enum.Material.Neon)
	ring.Shape = Enum.PartType.Cylinder
	local inner = part("Fill", Vector3.new(0.32, radius * 2 - 1, radius * 2 - 1), CFrame.new(base + Vector3.new(0, 0.21, 0)) * CFrame.Angles(0, 0, math.pi / 2), Enum.Material.ForceField, 0.3)
	inner.Shape = Enum.PartType.Cylinder
	local beam = part("Beam", Vector3.new(80, radius * 0.6, radius * 0.6), CFrame.new(base + Vector3.new(0, 40, 0)) * CFrame.Angles(0, 0, math.pi / 2), Enum.Material.Neon, 0.8)
	beam.Shape = Enum.PartType.Cylinder
	local light = Instance.new("PointLight")
	light.Range = radius * 2
	light.Brightness = 2
	light.Parent = ring
	-- Marcador visible a través de las paredes
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(140, 50)
	billboard.StudsOffset = Vector3.new(0, 8, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = 1500
	billboard.Parent = ring
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextStrokeTransparency = 0.2
	label.Text = "◆ ZONA"
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Parent = billboard
	model.Parent = workspace
	visual = model
end

local paintedVisual, paintedColor -- (solo se repinta si cambia el color o la zona)
local function paint(color)
	if not visual or (visual == paintedVisual and color == paintedColor) then
		return
	end
	paintedVisual, paintedColor = visual, color
	for _, p in visual:GetDescendants() do
		if p:IsA("BasePart") then
			p.Color = color
		elseif p:IsA("PointLight") then
			p.Color = color
		elseif p:IsA("TextLabel") then
			p.TextColor3 = color
		end
	end
end

local function playersInZone(zone)
	local radius = zone:GetAttribute("Radius") or 10
	local center = zone.Position
	local byTeam = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if player.Team and humanoid and humanoid.Health > 0 and root and not player:GetAttribute("InMenu") then
			local offset = root.Position - center
			if Vector3.new(offset.X, 0, offset.Z).Magnitude <= radius and offset.Y > -3 and offset.Y < 10 then
				byTeam[player.Team] = byTeam[player.Team] or {}
				table.insert(byTeam[player.Team], player)
			end
		end
	end
	-- Los bots también ocupan y disputan la zona (sin XP: su lista queda vacía)
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart")
			local team = Teams:FindFirstChild(model:GetAttribute("Team") or "")
			if team and team:IsA("Team") and humanoid and humanoid.Health > 0 and root then
				local offset = root.Position - center
				if Vector3.new(offset.X, 0, offset.Z).Magnitude <= radius and offset.Y > -3 and offset.Y < 10 then
					byTeam[team] = byTeam[team] or {}
				end
			end
		end
	end
	return byTeam
end

local function moveTo(i)
	index = i
	local zone = zones[index]
	makeVisual(zone)
	ReplicatedStorage:SetAttribute("ZonePosition", zone.Position)
	Remotes.Notify:FireAllClients("Flag", "¡La zona se ha movido!")
end

function Hardpoint.Start()
	Hardpoint.Stop()
	zones = findZones()
	if #zones == 0 then
		return false
	end
	active = true
	moveTo(1)
	thread = task.spawn(function()
		local moveAt = os.clock() + ROTATE_TIME
		local tick = 0
		while active do
			task.wait(1)
			tick += 1
			local ok, err = pcall(function()
				local remaining = math.max(0, math.ceil(moveAt - os.clock()))
				ReplicatedStorage:SetAttribute("ZoneMoveIn", remaining)
				if remaining <= 0 then
					moveAt = os.clock() + ROTATE_TIME
					moveTo(index % #zones + 1)
				end
				local byTeam = playersInZone(zones[index])
				local owner, count = nil, 0
				for team in byTeam do
					count += 1
					owner = team
				end
				if count == 0 then
					ReplicatedStorage:SetAttribute("ZoneOwner", "")
					paint(Color3.new(1, 1, 1))
				elseif count > 1 then
					ReplicatedStorage:SetAttribute("ZoneOwner", "Contested")
					paint(Color3.fromRGB(255, 200, 40))
				else
					ReplicatedStorage:SetAttribute("ZoneOwner", owner.Name)
					paint(owner.TeamColor.Color)
					if Hardpoint.OnScore then
						Hardpoint.OnScore(owner, 1)
					end
					for _, player in byTeam[owner] do
						PlayerData.Track(player, "ZoneTime", 1)
					end
					if tick % XP_INTERVAL == 0 then
						for _, player in byTeam[owner] do
							PlayerData.AddXP(player, 20, "Zona")
						end
					end
				end
			end)
			if not ok then
				warn("[Hardpoint] Error en el bucle de la zona:", err)
			end
		end
	end)
	return true
end

function Hardpoint.Stop()
	active = false
	if thread then
		pcall(task.cancel, thread)
		thread = nil
	end
	if visual then
		visual:Destroy()
		visual = nil
	end
	ReplicatedStorage:SetAttribute("ZoneOwner", nil)
	ReplicatedStorage:SetAttribute("ZonePosition", nil)
	ReplicatedStorage:SetAttribute("ZoneMoveIn", nil)
end

return Hardpoint
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">Hazards</string>
            <string name="Source"><![CDATA[-- Peligros del mapa: pisar lava quita vida cada cuarto de segundo.
-- Se detecta de dos formas, por si una falla en el servidor: el material del suelo (CrackedLava)
-- y un rayo hacia abajo contra las piezas marcadas con el atributo Hazard = "Lava".
local Players = game:GetService("Players")

local Hazards = {}

local LAVA_DAMAGE = 10 -- por cada 0.25 s
local RAY_LENGTH = 4.5 -- desde el centro del personaje hasta un poco por debajo de los pies

local cachedMap, lavaParts = nil, {}
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Include

local function refreshLava()
	local map = workspace:FindFirstChild("Map")
	if map == cachedMap then
		return
	end
	cachedMap = map
	lavaParts = {}
	if map then
		for _, d in map:GetDescendants() do
			if d:IsA("BasePart") and d:GetAttribute("Hazard") == "Lava" then
				table.insert(lavaParts, d)
			end
		end
	end
	params.FilterDescendantsInstances = lavaParts
end

local function onLava(humanoid, root)
	if humanoid.FloorMaterial == Enum.Material.CrackedLava then
		return true
	end
	if #lavaParts == 0 then
		return false
	end
	return workspace:Raycast(root.Position, Vector3.new(0, -RAY_LENGTH, 0), params) ~= nil
end

function Hazards.Init()
	task.spawn(function()
		while true do
			task.wait(0.25)
			local ok, err = pcall(function()
				refreshLava()
				-- Jugadores y bots
				local characters = {}
				for _, player in Players:GetPlayers() do
					if player.Character then
						table.insert(characters, player.Character)
					end
				end
				local bots = workspace:FindFirstChild("Bots")
				if bots then
					for _, model in bots:GetChildren() do
						table.insert(characters, model)
					end
				end
				for _, character in characters do
					local humanoid = character:FindFirstChildOfClass("Humanoid")
					local root = character:FindFirstChild("HumanoidRootPart")
					if humanoid and root and humanoid.Health > 0 and onLava(humanoid, root) then
						-- La lava no es una baja de nadie
						humanoid:SetAttribute("LastAttacker", nil)
						humanoid:SetAttribute("LastBot", nil)
						humanoid:SetAttribute("LastWeapon", nil)
						humanoid:SetAttribute("LastHitTime", os.clock()) -- (la vida no se recupera dentro)
						humanoid:TakeDamage(LAVA_DAMAGE)
					end
				end
			end)
			if not ok then
				warn("[Hazards] Error en el bucle:", err)
			end
		end
	end)
end

return Hazards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">HealthRegen</string>
            <string name="Source"><![CDATA[-- Vida que se recupera sola, como en los shooters de móvil: tras GameConfig.HealthRegen.Delay
-- segundos sin recibir daño, la vida sube deprisa hasta llenarse. Para jugadores y bots.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local HealthRegen = {}

local STEP = 0.25

-- perk: la ventaja "Persistente" (GameConfig.Perks) empieza antes y recupera más deprisa
local function regen(humanoid, now, config, perk)
	if humanoid.Health <= 0 or humanoid.Health >= humanoid.MaxHealth then
		return
	end
	local hitTime = humanoid:GetAttribute("LastHitTime") or 0
	if now - hitTime < ((perk and perk.RegenDelay) or config.Delay) then
		return
	end
	humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + config.PerSecond * ((perk and perk.RegenMultiplier) or 1) * STEP)
end

local function perkOf(player)
	local id = player:GetAttribute("Perk")
	for _, perk in GameConfig.Perks or {} do
		if perk.Id == id then
			return perk
		end
	end
	return nil
end

function HealthRegen.Init()
	local config = GameConfig.HealthRegen
	if not config or not config.Enabled then
		return
	end
	task.spawn(function()
		while true do
			task.wait(STEP)
			local ok, err = pcall(function()
				local now = os.clock()
				for _, player in Players:GetPlayers() do
					local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
					if humanoid then
						regen(humanoid, now, config, perkOf(player))
					end
				end
				local bots = workspace:FindFirstChild("Bots")
				if bots then
					for _, model in bots:GetChildren() do
						local humanoid = model:FindFirstChildOfClass("Humanoid")
						if humanoid then
							regen(humanoid, now, config)
						end
					end
				end
			end)
			if not ok then
				warn("[HealthRegen] Error en el bucle:", err)
			end
		end
	end)
end

return HealthRegen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">Killstreaks</string>
            <string name="Source"><![CDATA[-- Recompensas por racha de bajas (sin morir):
--   3 bajas: RADAR. Durante unos segundos tu equipo (o tú, en Todos contra todos) ve a los
--            enemigos a través de las paredes. Atributo de jugador RadarUntil = hora del servidor.
--            Los bots también lo consiguen (BotRadar): sus compañeros humanos lo ven y los rivales
--            reciben el aviso, como el radar enemigo de los shooters de móvil.
--   5 bajas: ATAQUE AÉREO. Se guarda (atributo Airstrikes) y se lanza con la tecla T: marca el
--            punto al que apuntas y caen 5 explosiones en línea.
-- No hay recompensas en Escalada de armas.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Weapons = require(Shared.Weapons)
local Remotes = require(Shared.Remotes)

local Combat = require(script.Parent.Combat)

local Killstreaks = {}

Killstreaks.RadarStreak = 3
Killstreaks.AirstrikeStreak = 5
local RADAR_TIME = 12
Killstreaks.RadarTime = RADAR_TIME
local MAX_RANGE = 600
local STRIKE_DELAY = 1.6 -- segundos de aviso antes de que caigan las bombas
local STRIKES = 5
local SPACING = 9

local function now()
	return workspace:GetServerTimeNow()
end

local function enabled()
	return ReplicatedStorage:GetAttribute("Mode") ~= "GUN"
end

-- Radar de un equipo (Radar_<equipo> en ReplicatedStorage = hasta cuándo): el minimapa del rival
-- se pone rojo mientras dura, como el radar enemigo de los shooters
local function markTeamRadar(team, untilTime)
	if team and ReplicatedStorage:GetAttribute("TeamMode") ~= false then
		local key = "Radar_" .. team.Name
		ReplicatedStorage:SetAttribute(key, math.max(ReplicatedStorage:GetAttribute(key) or 0, untilTime))
	end
end

local function activateRadar(player)
	local untilTime = now() + RADAR_TIME
	markTeamRadar(player.Team, untilTime)
	for _, other in Players:GetPlayers() do
		local ally = other == player or (player.Team ~= nil and other.Team == player.Team and ReplicatedStorage:GetAttribute("TeamMode") ~= false)
		if other == player then
			other:SetAttribute("RadarUntil", untilTime)
			Remotes.Notify:FireClient(other, "Big", "📡 ¡RADAR ACTIVADO!")
		elseif ally then
			other:SetAttribute("RadarUntil", untilTime)
			Remotes.Notify:FireClient(other, "Info", "📡 Radar activado por " .. player.Name)
		else
			Remotes.Notify:FireClient(other, "Info", "📡 ¡El enemigo tiene radar!")
		end
	end
end

-- Un bot llega a la racha del radar: lo comparten los jugadores de su equipo y se avisa al rival
-- (los bots de su equipo lo reciben en Bots.Radar, que llama Round)
function Killstreaks.OnBotStreak(botName, team, streak)
	if not enabled() or streak ~= Killstreaks.RadarStreak then
		return false
	end
	local untilTime = now() + RADAR_TIME
	markTeamRadar(team, untilTime)
	local teamMode = ReplicatedStorage:GetAttribute("TeamMode") ~= false
	for _, other in Players:GetPlayers() do
		if team ~= nil and teamMode and other.Team == team then
			other:SetAttribute("RadarUntil", math.max(other:GetAttribute("RadarUntil") or 0, untilTime))
			Remotes.Notify:FireClient(other, "Info", "📡 Radar activado por " .. botName)
		else
			Remotes.Notify:FireClient(other, "Info", "📡 ¡El enemigo tiene radar!")
		end
	end
	return true
end

-- Lo llama Round cada vez que alguien suma una baja a su racha
function Killstreaks.OnStreak(player, streak)
	-- (los zombis de la Infección no tienen recompensas por racha)
	if not enabled() or (player.Character and player.Character:GetAttribute("Zombie")) then
		return
	end
	if streak == Killstreaks.RadarStreak then
		activateRadar(player)
	elseif streak == Killstreaks.AirstrikeStreak then
		player:SetAttribute("Airstrikes", (player:GetAttribute("Airstrikes") or 0) + 1)
		Remotes.Notify:FireClient(player, "Big", "✈ ¡ATAQUE AÉREO LISTO! Pulsa T")
	end
end

-- Al empezar una ronda nadie conserva recompensas
function Killstreaks.Reset()
	for name in ReplicatedStorage:GetAttributes() do
		if string.sub(name, 1, 6) == "Radar_" then
			ReplicatedStorage:SetAttribute(name, nil)
		end
	end
	for _, player in Players:GetPlayers() do
		player:SetAttribute("Airstrikes", 0)
		player:SetAttribute("RadarUntil", 0)
	end
end

-- Punto del suelo bajo una posición (ignorando personajes, granadas y muros invisibles)
local function ground(position)
	local ignore = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	for _, name in { "Dummies", "Bots", "Grenades", "ClientFX" } do
		local f = workspace:FindFirstChild(name)
		if f then
			table.insert(ignore, f)
		end
	end
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	-- Desde una altura fija: las bombas siempre caen sobre el primer techo (no dentro de edificios)
	local result = workspace:Raycast(Vector3.new(position.X, 200, position.Z), Vector3.new(0, -260, 0), params)
	return result and result.Position + Vector3.new(0, 1, 0) or position
end

local function callAirstrike(player, target)
	if typeof(target) ~= "Vector3" or target ~= target then
		return
	end
	if not enabled() or player:GetAttribute("InMenu") or (player:GetAttribute("Airstrikes") or 0) <= 0 then
		return
	end
	if player.Character and player.Character:GetAttribute("Zombie") then
		return
	end
	if ReplicatedStorage:GetAttribute("State") ~= "Playing" or ReplicatedStorage:GetAttribute("Frozen") then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root then
		return
	end
	local offset = target - root.Position
	if offset.Magnitude > MAX_RANGE or offset.Y < -100 or offset.Y > 150 then
		return
	end
	player:SetAttribute("Airstrikes", player:GetAttribute("Airstrikes") - 1)

	-- 5 puntos en línea, en la dirección en la que mira el jugador
	local flat = Vector3.new(offset.X, 0, offset.Z)
	local direction = flat.Magnitude > 1 and flat.Unit or Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit
	local points = {}
	for i = 1, STRIKES do
		local along = (i - (STRIKES + 1) / 2) * SPACING
		table.insert(points, ground(target + direction * along))
	end
	Remotes.AirstrikeMark:FireAllClients(points, STRIKE_DELAY)
	Remotes.Notify:FireAllClients("Streak", "✈ ¡ATAQUE AÉREO de " .. player.Name .. "!")

	task.delay(STRIKE_DELAY, function()
		for _, point in points do
			if ReplicatedStorage:GetAttribute("State") ~= "Playing" then
				return -- la ronda terminó durante el aviso
			end
			Remotes.ExplosionFX:FireAllClients(point, Weapons.Airstrike.Explosive.Radius)
			if player.Parent then
				Combat.Explode(player, point, Weapons.Airstrike, "Airstrike")
			end
			task.wait(0.18)
		end
	end)
end

function Killstreaks.Init()
	Remotes.CallAirstrike.OnServerEvent:Connect(callAirstrike)
end

return Killstreaks
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">Leaderboard</string>
            <string name="Source"><![CDATA[-- Clasificación global (todos los servidores): top 10 de bajas, de victorias y de rango (mejor RP).
-- Se guarda en OrderedDataStores y se publica a los clientes como texto JSON en atributos de
-- ReplicatedStorage ("Leaderboard_Kills", "Leaderboard_Wins", "Leaderboard_Rank") para la pantalla de inicio.
-- La de rango es de la temporada en curso (Ranks.Seasons): cada temporada empieza una tabla nueva.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PlayerData = require(script.Parent.PlayerData)
local Ranks = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Ranks"))

local Leaderboard = {}

local REFRESH = 90 -- segundos entre actualizaciones (los DataStores tienen límite de peticiones)
local TOP = 10

local BOARDS = {
	{ Id = "Kills", Store = "TopBajas_v1", Field = "TotalKills" },
	{ Id = "Wins", Store = "TopVictorias_v1", Field = "Wins" },
	{ Id = "Rank", Store = "TopRango_v1", Field = "RankPoints", Seasonal = true },
}

local stores = {} -- [board.Id] = OrderedDataStore
local storeNames = {} -- [board.Id] = nombre del almacén abierto (cambia con la temporada)

-- Nombre del almacén: el de rango lleva la temporada (la primera conserva el nombre de siempre)
local function storeName(board)
	if not board.Seasonal then
		return board.Store
	end
	local season = Ranks.CurrentSeason()
	return season.Id == Ranks.Seasons[1].Id and board.Store or (board.Store .. "_" .. season.Id)
end

local function openStores()
	for _, board in BOARDS do
		local name = storeName(board)
		if storeNames[board.Id] ~= name then
			local ok, store = pcall(function()
				return DataStoreService:GetOrderedDataStore(name)
			end)
			if ok then
				stores[board.Id] = store
				storeNames[board.Id] = name
			end
		end
	end
end
local pushed = {} -- [userId .. ":" .. tabla] = último valor enviado
local names = {} -- caché de nombres por UserId

local function nameOf(userId)
	if names[userId] then
		return names[userId]
	end
	local online = Players:GetPlayerByUserId(userId)
	if online then
		names[userId] = online.Name
		return online.Name
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and type(name) == "string" then
		names[userId] = name
		return name
	end
	return "Jugador"
end

-- Sube los números de un jugador (solo si han cambiado)
local function push(player)
	local data = PlayerData.Get(player)
	if not data then
		return
	end
	for _, board in BOARDS do
		local store = stores[board.Id]
		local value = math.floor(tonumber(data[board.Field]) or 0)
		-- (tampoco si aún no se pudo abrir la tabla de la temporada nueva: irían a la anterior)
		if board.Seasonal and (data.RankSeason ~= Ranks.CurrentSeason().Id or (tonumber(data.SeasonBest) or 0) <= 0 or storeNames[board.Id] ~= storeName(board)) then
			value = 0 -- (RP de la temporada anterior, o aún no ha jugado de rango en esta: no sale en el top)
		end
		local k = player.UserId .. ":" .. (storeNames[board.Id] or board.Id)
		if store and value > 0 and pushed[k] ~= value then
			-- Nunca baja un récord (por ejemplo si sus datos no cargaron y empieza de 0)
			local ok, err = pcall(function()
				store:UpdateAsync(tostring(player.UserId), function(old)
					return math.max(tonumber(old) or 0, value)
				end)
			end)
			if ok then
				pushed[k] = value
			else
				warn("[Leaderboard] No se pudo subir", board.Id, "de", player.Name, err)
			end
		end
	end
end

local function fetch()
	for _, board in BOARDS do
		local store = stores[board.Id]
		if store then
			local ok, page = pcall(function()
				return store:GetSortedAsync(false, TOP):GetCurrentPage()
			end)
			if ok and type(page) == "table" then
				local rows = {}
				for rank, entry in page do
					local userId = tonumber(entry.key)
					if userId then
						table.insert(rows, { Rank = rank, UserId = userId, Name = nameOf(userId), Value = entry.value })
					end
				end
				ReplicatedStorage:SetAttribute("Leaderboard_" .. board.Id, HttpService:JSONEncode(rows))
			end
		end
	end
end

function Leaderboard.Init()
	openStores()
	if next(stores) == nil then
		warn("[Leaderboard] Sin acceso a DataStores: no hay clasificación global")
		return
	end
	Players.PlayerRemoving:Connect(function(player)
		local ok, err = pcall(push, player)
		if not ok then
			warn("[Leaderboard] Error al salir", player.Name, err)
		end
		-- (lo ya subido de quien se fue no hace falta recordarlo: la tabla no crece toda la sesión)
		local prefix = player.UserId .. ":"
		for k in pushed do
			if string.sub(k, 1, #prefix) == prefix then
				pushed[k] = nil
			end
		end
	end)
	task.spawn(function()
		task.wait(10)
		while true do
			-- (un fallo en una pasada no para la clasificación para siempre)
			local ok, err = pcall(function()
				openStores() -- (si ha empezado otra temporada, la tabla de rango es otra)
				for _, player in Players:GetPlayers() do
					push(player)
				end
				fetch()
			end)
			if not ok then
				warn("[Leaderboard] Error al actualizar:", err)
			end
			task.wait(REFRESH)
		end
	end)
end

return Leaderboard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">LightingVariants</string>
            <string name="Source"><![CDATA[-- Versiones de luz y clima que cualquier mapa exterior puede usar (Map.LightingVariants): en cada
-- partida, a veces, el mapa sale al atardecer, con tormenta y lluvia, con niebla de primera hora o con
-- ventisca. Solo cambian la luz y el tiempo; los colores del terreno, el agua y el cielo del mapa se
-- quedan. Kit.pickLighting elige una (o ninguna) y el cliente pone la lluvia, el viento y los truenos.
local RGB = Color3.fromRGB

local Variants = {}

-- Atardecer: sol bajo y anaranjado, sombras largas y cielo cálido
function Variants.Sunset(chance)
	return {
		Name = "Atardecer",
		Chance = chance or 0.25,
		ClockTime = 17.65,
		Brightness = 2.1,
		Exposure = 0.05,
		Ambient = RGB(84, 70, 64),
		OutdoorAmbient = RGB(158, 126, 108),
		Atmosphere = { Density = 0.34, Offset = 0.12, Color = RGB(236, 196, 160), Decay = RGB(150, 104, 86), Glare = 0.45, Haze = 1.8 },
		Color = { Saturation = 0.02, Contrast = 0.14, Brightness = 0, Tint = RGB(255, 236, 216) },
		Clouds = 0.45,
		CloudColor = RGB(255, 214, 186),
		SunRays = 0.09,
	}
end

-- Tormenta: cielo cubierto, luz gris, lluvia, viento y truenos
function Variants.Storm(chance)
	return {
		Name = "Tormenta",
		Chance = chance or 0.25,
		Weather = "Rain",
		ClockTime = 15.5,
		Brightness = 1.2,
		Exposure = -0.05,
		Ambient = RGB(62, 66, 72),
		OutdoorAmbient = RGB(104, 110, 118),
		Atmosphere = { Density = 0.42, Offset = 0.08, Color = RGB(152, 158, 166), Decay = RGB(92, 98, 108), Glare = 0, Haze = 2.6 },
		Color = { Saturation = -0.2, Contrast = 0.12, Brightness = 0, Tint = RGB(226, 232, 240) },
		Bloom = { Intensity = 0.3, Size = 20, Threshold = 2.4 },
		Clouds = 1,
		CloudColor = RGB(122, 126, 132),
		SunRays = 0,
		Wind = Vector3.new(14, 0, -6),
	}
end

-- Niebla de primera hora: luz blanca y suave, se ve menos de lejos
function Variants.Fog(chance)
	return {
		Name = "Niebla",
		Chance = chance or 0.2,
		ClockTime = 7.6,
		Brightness = 1.9,
		Ambient = RGB(82, 88, 94),
		OutdoorAmbient = RGB(142, 150, 158),
		Atmosphere = { Density = 0.5, Offset = 0.05, Color = RGB(206, 213, 220), Decay = RGB(150, 160, 170), Glare = 0, Haze = 3 },
		Color = { Saturation = -0.15, Contrast = 0.1, Brightness = 0.02, Tint = RGB(236, 242, 250) },
		Clouds = 0.85,
		SunRays = 0.02,
	}
end

-- Ventisca (mapas de nieve): viento fuerte, nieve que cae de lado y poca visibilidad
function Variants.Blizzard(chance)
	return {
		Name = "Ventisca",
		Chance = chance or 0.3,
		Weather = "Snowstorm",
		ClockTime = 14,
		Brightness = 1.6,
		Ambient = RGB(86, 92, 104),
		OutdoorAmbient = RGB(150, 158, 172),
		Atmosphere = { Density = 0.5, Offset = 0.06, Color = RGB(214, 222, 232), Decay = RGB(160, 172, 190), Glare = 0, Haze = 3.2 },
		Color = { Saturation = -0.15, Contrast = 0.1, Brightness = 0.02, Tint = RGB(236, 242, 255) },
		Clouds = 1,
		CloudColor = RGB(214, 220, 228),
		SunRays = 0,
		Wind = Vector3.new(22, 0, 8),
	}
end

return Variants
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">Loadout</string>
            <string name="Source"><![CDATA[-- Entrega las armas (Tools) a cada jugador cuando aparece.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Weapons = require(Shared.Weapons)
local WeaponModels = require(Shared.WeaponModels)
local Remotes = require(Shared.Remotes)
local Outfits = require(Shared.Outfits)
local GameConfig = require(Shared.GameConfig)

local PlayerData = require(script.Parent.PlayerData)

local Loadout = {}

-- Los modos de juego pueden cambiar las armas: function(player) -> { "Arma1", "Arma2", ... } o nil
Loadout.Override = nil

function Loadout.MakeTool(weaponName, skinId, charmId)
	local def = Weapons.Get(weaponName)
	local tool = Instance.new("Tool")
	tool.Name = def.DisplayName
	tool.ToolTip = def.DisplayName
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	-- La mano derecha agarra la empuñadura del arma. El arma del mundo va a escala de una persona (la de
	-- primera persona, el viewmodel, se construye aparte a tamaño completo)
	local scale = GameConfig.WorldWeaponScale or 1
	tool.Grip = CFrame.new((def.RightHand or Vector3.zero) * scale)
	tool:SetAttribute("WorldScale", scale)
	tool:SetAttribute("Weapon", weaponName)
	tool:SetAttribute("Skin", skinId)
	tool:SetAttribute("Slot", def.Slot)
	if def.Type == "Gun" then
		tool:SetAttribute("Ammo", def.MagSize)
		tool:SetAttribute("Reserve", def.ReserveAmmo)
		tool:SetAttribute("Reloading", false)
		tool.Unequipped:Connect(function()
			tool:SetAttribute("Reloading", false) -- cambiar de arma cancela la recarga
		end)
	end

	local model = WeaponModels.Build(weaponName, skinId, nil, charmId, scale)
	tool:SetAttribute("Charm", charmId or "Default")
	for _, child in model:GetChildren() do
		child.Parent = tool
	end
	model:Destroy()
	return tool
end

-- Sin traje comprado, en los mapas realistas: uniforme militar con el color del equipo en el
-- brazalete (como los bots), salvo que el jugador prefiera su avatar (Ajustes → Uniforme). nil = nada
function Loadout.UniformFor(player, data)
	local map = workspace:FindFirstChild("Map")
	if GameConfig.SoldierUniform == false or not map or map:GetAttribute("Realistic") ~= true then
		return nil
	end
	local settings = data and data.Settings
	if type(settings) == "table" and settings.Uniform == 0 then
		return nil
	end
	return Outfits.Soldier(player.Team and player.Team.TeamColor.Color or nil)
end

local function giveLoadout(player, character)
	local data = PlayerData.WaitFor(player, 15)
	if player.Character ~= character then
		return
	end
	local list = Loadout.Override and Loadout.Override(player) or Loadout.DefaultList(data)

	-- Traje de operador (solo R15)
	-- (los zombis de la Infección no llevan traje: taparía la piel verde y los ojos)
	local zombie = ReplicatedStorage:GetAttribute("Infection") == "On" and player.Team ~= nil
		and player.Team.Name == ReplicatedStorage:GetAttribute("TeamB")
	local outfit = nil
	if data and data.EquippedOutfit ~= "Default" and not zombie then
		outfit = data.EquippedOutfit
	elseif not zombie then
		outfit = Loadout.UniformFor(player, data)
	end
	if outfit then
		character:WaitForChild("UpperTorso", 5)
		-- Espera a que cargue la ropa del avatar: si no, sus BodyColors y camisa taparían el traje
		local started = os.clock()
		while not player:HasAppearanceLoaded() and os.clock() - started < 5 do
			task.wait(0.1)
		end
		if player.Character ~= character then
			return
		end
		Outfits.Apply(character, outfit)
	end

	Loadout.Give(player, list)
end

-- Armas elegidas por el jugador (principal, secundaria y cuchillo)
function Loadout.DefaultList(data)
	local primary = data and data.Primary or "ARX27"
	local secondary = data and data.Secondary or Weapons.Secondary
	local melee = data and data.Melee or Weapons.Melee
	return { primary, secondary, melee }
end

-- Devuelve sus armas de siempre a un jugador vivo (por ejemplo al acabar la Escalada)
function Loadout.GiveDefault(player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		Loadout.Give(player, Loadout.DefaultList(PlayerData.Get(player)))
	end
end

-- Da al jugador exactamente estas armas (y equipa la primera).
-- Cada arma lleva su camuflaje de maestría si lo tiene elegido, o la skin general.
function Loadout.Give(player, list)
	local character = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not character or not backpack then
		return
	end
	local data = PlayerData.Get(player)
	for _, container in { backpack, character } do
		for _, child in container:GetChildren() do
			if child:IsA("Tool") then
				child:Destroy()
			end
		end
	end
	local first
	for _, weaponName in list do
		if Weapons.Get(weaponName) then
			local tool = Loadout.MakeTool(weaponName, PlayerData.SkinFor(data, weaponName), data and data.EquippedCharm)
			tool.Parent = backpack
			first = first or tool
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if first and humanoid and humanoid.Health > 0 then
		humanoid:EquipTool(first)
	end
end

local function onOutfitChanged(player, outfitId)
	local character = player.Character
	if character then
		if outfitId == "Default" then
			-- Para quitar el traje del todo hay que reaparecer (recupera la ropa original); en los mapas
			-- realistas, en su lugar el uniforme
			local uniform = Loadout.UniformFor(player, PlayerData.Get(player))
			if uniform then
				Outfits.Apply(character, uniform)
			else
				Outfits.Remove(character)
			end
		else
			Outfits.Apply(character, outfitId)
		end
	end
end

-- Vuelve a pintar las armas que lleva encima (skin general o camuflaje de maestría)
local function onSkinChanged(player)
	local data = PlayerData.Get(player)
	local containers = { player:FindFirstChild("Backpack"), player.Character }
	for _, container in containers do
		if container then
			for _, tool in container:GetChildren() do
				local weaponName = tool:IsA("Tool") and tool:GetAttribute("Weapon")
				if weaponName then
					local skinId = PlayerData.SkinFor(data, weaponName)
					if tool:GetAttribute("Skin") ~= skinId then
						WeaponModels.ApplySkin(tool, skinId, weaponName)
						tool:SetAttribute("Skin", skinId)
					end
				end
			end
		end
	end
end

-- Mientras el jugador está en la pantalla de inicio es invulnerable (escudo invisible)
local function addMenuShield(player, character)
	if player:GetAttribute("InMenu") and not character:FindFirstChild("MenuShield") then
		local shield = Instance.new("ForceField")
		shield.Name = "MenuShield"
		shield.Visible = false
		shield.Parent = character
	end
end

local spawnedAt = {} -- [player] = os.clock() de su última aparición

-- En plena ronda de Eliminación, quien no la empezó (y ya salió del menú) entra como espectador hasta
-- la siguiente: si no, podría aparecer de refresco a mitad de ronda. No cuenta como muerte.
local function makeSpectatorIfLate(player, character)
	if not ReplicatedStorage:GetAttribute("NoRespawn") or player:GetAttribute("ElimIn") or player:GetAttribute("InMenu") then
		return
	end
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid:SetAttribute("Spectator", true)
		humanoid.Health = 0
	end
end

local joinOrder = 0
local function onPlayer(player)
	player:SetAttribute("InMenu", true)
	-- Orden de llegada al servidor (el primero de una escuadra es su líder en la interfaz)
	joinOrder += 1
	player:SetAttribute("JoinOrder", joinOrder)
	player.CharacterAdded:Connect(function(character)
		spawnedAt[player] = os.clock()
		addMenuShield(player, character)
		-- (personaje que llega tarde a una ronda de Eliminación ya empezada)
		task.defer(function()
			character:WaitForChild("Humanoid", 5)
			makeSpectatorIfLate(player, character)
		end)
		giveLoadout(player, character)
	end)
	if player.Character then
		addMenuShield(player, player.Character)
		task.spawn(giveLoadout, player, player.Character)
	end
end

-- Clase elegida: en el menú o durante el despliegue antes de la partida se cambian las armas ya
-- mismo; en plena partida, al reaparecer
local function onClassApplied(player)
	local data = PlayerData.Get(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local deploying = ReplicatedStorage:GetAttribute("Deploy") ~= nil
	if humanoid and humanoid.Health > 0 and (player:GetAttribute("InMenu") or deploying) and not Loadout.Override then
		Loadout.Give(player, Loadout.DefaultList(data))
	elseif not player:GetAttribute("InMenu") then
		Remotes.Notify:FireClient(player, "Info", "Clase equipada (al reaparecer)")
	end
end

function Loadout.Init()
	PlayerData.OnClassApplied = onClassApplied
	PlayerData.OnSkinChanged = onSkinChanged
	PlayerData.OnOutfitChanged = onOutfitChanged
	-- "Volver al menú": vuelve a ser invulnerable y queda fuera de los objetivos
	Remotes.EnterMenu.OnServerEvent:Connect(function(player)
		-- Solo desde la pantalla de muerte: si no, cualquiera podría volverse invulnerable en plena pelea
		-- (o justo al reaparecer: el clic pudo llegar después de la reaparición automática, y ese
		-- personaje aún tiene la protección de aparición, así que no se gana nada haciendo trampa)
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		local justSpawned = os.clock() - (spawnedAt[player] or -math.huge) < 1.5
		-- (fuera de la partida, p. ej. en la pantalla final, se puede volver siempre: no hay pelea)
		local playing = ReplicatedStorage:GetAttribute("State") == "Playing"
		if humanoid and humanoid.Health > 0 and not justSpawned and playing then
			return
		end
		player:SetAttribute("InMenu", true)
		player:SetAttribute("Ready", nil)
		if player.Character then
			addMenuShield(player, player.Character)
		end
	end)
	Remotes.LeaveMenu.OnServerEvent:Connect(function(player)
		player:SetAttribute("InMenu", false)
		player:SetAttribute("Ready", nil)
		-- Desde cuándo juega esta partida (para el rango; Round lo pone a cero al empezar cada una)
		if not player:GetAttribute("MatchJoinedAt") then
			player:SetAttribute("MatchJoinedAt", workspace:GetServerTimeNow())
		end
		local shield = player.Character and player.Character:FindFirstChild("MenuShield")
		if shield then
			shield:Destroy()
		end
		-- En plena ronda de Eliminación quien no la empezó entra como espectador hasta la siguiente
		-- (si no, podría aparecer de refresco a mitad de ronda)
		makeSpectatorIfLate(player, player.Character)
	end)
	Players.PlayerAdded:Connect(onPlayer)
	Players.PlayerRemoving:Connect(function(player)
		spawnedAt[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
end

return Loadout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">Loot</string>
            <string name="Source"><![CDATA[-- Botín: a veces el enemigo que eliminas suelta un paquete de suministros con un rayo de luz del
-- color de su rareza (como el botín de los juegos de disparos con saqueo). Solo lo puede recoger
-- quien hizo la baja, pasando por encima, y desaparece a los LIFETIME segundos. Dentro hay monedas
-- (y XP en los mejores): como nunca sabes qué toca, cada baja tiene su pequeña emoción.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local PlayerData = require(script.Parent.PlayerData)

local Loot = {}

Loot.Chance = 0.1 -- probabilidad de que una baja a otro jugador suelte botín
Loot.BotChance = 0.06 -- (contra bots, menos, y con los premios a la mitad: que no salga a cuenta "granjear" bots)
Loot.LIFETIME = 15
local RADIUS = 5

-- Rarezas: peso (probabilidad relativa), monedas, XP y color del rayo
Loot.Tiers = {
-- (de media, unas 23 monedas por paquete: un extra, no una segunda fuente de ingresos)
	{ Name = "Común", Weight = 62, Coins = 10, XP = 0, Color = Color3.fromRGB(200, 200, 200) },
	{ Name = "Raro", Weight = 26, Coins = 25, XP = 0, Color = Color3.fromRGB(70, 160, 255) },
	{ Name = "Épico", Weight = 10, Coins = 60, XP = 100, Color = Color3.fromRGB(190, 80, 255) },
	{ Name = "Legendario", Weight = 2, Coins = 200, XP = 250, Color = Color3.fromRGB(255, 180, 30) },
}

local active = {} -- { Model, Position, Owner, Tier, Expires }
local folder
local loopRunning = false

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

-- Suelo bajo el punto (si cae al vacío o a la lava, no hay botín)
local function groundBelow(position)
	local map = workspace:FindFirstChild("Map")
	if not map then
		return position
	end
	rayParams.FilterDescendantsInstances = { map, workspace.Terrain }
	local hit = workspace:Raycast(position + Vector3.new(0, 2, 0), Vector3.new(0, -60, 0), rayParams)
	if not hit then
		return nil
	end
	if hit.Instance:GetAttribute("Hazard") or hit.Instance.Name == "Lava" or hit.Material == Enum.Material.CrackedLava then
		return nil
	end
	return hit.Position
end

function Loot.RollTier(roll)
	local total = 0
	for _, tier in Loot.Tiers do
		total += tier.Weight
	end
	local pick = (roll or math.random()) * total
	for _, tier in Loot.Tiers do
		pick -= tier.Weight
		if pick <= 0 then
			return tier
		end
	end
	return Loot.Tiers[1]
end

local function build(position, tier)
	local model = Instance.new("Model")
	model.Name = "LootDrop"
	model:SetAttribute("Rarity", tier.Name)
	local function part(name, size, cf, color, material)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Parent = model
		return p
	end
	local base = CFrame.new(position)
	-- Paquete del color de la rareza (flota y gira en el cliente, con WorldFX)
	local box = part("LootBox", Vector3.new(1.6, 1.1, 1.1), base * CFrame.new(0, 1.4, 0), tier.Color, Enum.Material.SmoothPlastic)
	box:SetAttribute("Bob", 0.3)
	box:SetAttribute("Spin", 90)
	-- Rayo de luz que se ve desde lejos (más alto cuanto mejor el botín)
	local height = 10 + 4 * (table.find(Loot.Tiers, tier) or 1)
	local beam = part("LootBeam", Vector3.new(0.5, height, 0.5), base * CFrame.new(0, height / 2, 0), tier.Color, Enum.Material.Neon)
	beam.Transparency = 0.45
	local light = Instance.new("PointLight")
	light.Color = tier.Color
	light.Range = 10
	light.Brightness = 1.5
	light.Parent = box
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(tier.Color)
	sparkle.LightEmission = 1
	sparkle.Size = NumberSequence.new(0.35, 0)
	sparkle.Lifetime = NumberRange.new(0.6, 1)
	sparkle.Speed = NumberRange.new(2, 4)
	sparkle.SpreadAngle = Vector2.new(60, 60)
	sparkle.Rate = 8
	sparkle.Parent = box
	model.PrimaryPart = box
	return model
end

local function collect(entry, player)
	local tier = entry.Tier
	local scale = entry.Scale or 1
	local coins = PlayerData.AddCoins(player, math.max(1, math.floor(tier.Coins * scale)))
	local xp = math.floor(tier.XP * scale)
	if xp > 0 then
		PlayerData.AddXP(player, xp, "Botín " .. tier.Name)
	end
	Remotes.Notify:FireClient(player, "Loot", { Rarity = tier.Name, Coins = coins, XP = xp, Color = tier.Color })
end

local function step()
	local now = os.clock()
	for i = #active, 1, -1 do
		local entry = active[i]
		local owner = entry.Owner
		local character = owner.Parent and owner.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local alive = humanoid and humanoid.Health > 0
		if root and alive and (root.Position - entry.Position).Magnitude <= RADIUS then
			table.remove(active, i)
			entry.Model:Destroy()
			collect(entry, owner)
		elseif now >= entry.Expires or not owner.Parent or not entry.Model.Parent then
			table.remove(active, i)
			entry.Model:Destroy()
		end
	end
end

local function ensureLoop()
	if loopRunning then
		return
	end
	loopRunning = true
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.15 or #active == 0 then
			return
		end
		elapsed = 0
		step()
	end)
end

-- Tras una baja: a veces suelta botín para quien la hizo. roll (opcional, para pruebas)
function Loot.MaybeDrop(position, killer, againstBot, roll)
	if typeof(position) ~= "Vector3" or not killer or not killer:IsA("Player") then
		return nil
	end
	if (roll or math.random()) > (againstBot and Loot.BotChance or Loot.Chance) then
		return nil
	end
	local ground = groundBelow(position)
	if not ground then
		return nil
	end
	if not folder or not folder.Parent then
		folder = Instance.new("Folder")
		folder.Name = "Loot"
		folder.Parent = workspace
	end
	local tier = Loot.RollTier()
	local model = build(ground, tier)
	model:SetAttribute("Owner", killer.UserId)
	model.Parent = folder
	-- (contra bots, el premio se escala como las bajas a bots: GameConfig.Bots.RewardScale)
	local scale = againstBot and (GameConfig.Bots and GameConfig.Bots.RewardScale or 0.5) or 1
	table.insert(active, { Model = model, Position = ground, Owner = killer, Tier = tier, Scale = scale, Expires = os.clock() + Loot.LIFETIME })
	ensureLoop()
	-- Solo quien lo ha ganado ve el aviso
	Remotes.Notify:FireClient(killer, "LootDrop", tier.Name)
	return model, tier
end

-- Al acabar la partida o cambiar de mapa, fuera todo el botín
function Loot.Clear()
	for _, entry in active do
		entry.Model:Destroy()
	end
	table.clear(active)
end

Loot.Step = step
Loot.Active = active
Players.PlayerRemoving:Connect(function(player)
	for i = #active, 1, -1 do
		if active[i].Owner == player then
			active[i].Model:Destroy()
			table.remove(active, i)
		end
	end
end)

return Loot
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[-- Registro de mapas: construye el mapa elegido y publica su nombre para la interfaz.
-- Si construyes tu propio mapa en Studio dentro de workspace.Map (sin el atributo "Generated"),
-- se usará ese y no habrá rotación de mapas.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))

local MapBuilder = {}

MapBuilder.Defs = {}
for _, module in script.Parent.MapDefs:GetChildren() do
	local def = require(module)
	MapBuilder.Defs[def.Id] = def
end

-- Orden de rotación (también son las opciones de la votación)
MapBuilder.Order = { "Construction", "Coastal", "Terminal", "MallRush", "RooftopDistrict", "MetroYard", "DesertBase", "Dockyard", "IndustrialYard" }

MapBuilder.Current = nil

-- ¿Puede salir este mapa ahora? Los de temporada (Season = nombre del evento) solo con su evento
-- en marcha (atributo EventName que pone Event)
function MapBuilder.InSeason(id)
	local def = MapBuilder.Defs[id]
	return def == nil or def.Season == nil or ReplicatedStorage:GetAttribute("EventName") == def.Season
end

-- (la pantalla de inicio dice cuántos mapas hay: los de siempre)
local permanent = 0
for _, id in MapBuilder.Order do
	if MapBuilder.Defs[id] and not MapBuilder.Defs[id].Season then
		permanent += 1
	end
end
ReplicatedStorage:SetAttribute("MapCount", permanent)

-- Mapa destacado del día (GameConfig.FeaturedMap): rota por los de siempre, uno cada día (UTC).
-- Se publica en el atributo FeaturedMap (su nombre) para la votación y el bonus de XP.
function MapBuilder.FeaturedId(day)
	local list = {}
	for _, id in MapBuilder.Order do
		if MapBuilder.Defs[id] and not MapBuilder.Defs[id].Season then
			table.insert(list, id)
		end
	end
	if #list == 0 then
		return nil
	end
	day = day or (os.time() // 86400)
	return list[(day % #list) + 1]
end

function MapBuilder.UpdateFeatured()
	local id = GameConfig.FeaturedMap and MapBuilder.FeaturedId()
	local def = id and MapBuilder.Defs[id]
	ReplicatedStorage:SetAttribute("FeaturedMap", def and def.Name or nil)
end
MapBuilder.UpdateFeatured()

-- ¿Hay un mapa hecho a mano en Studio?
function MapBuilder.IsCustom()
	local map = workspace:FindFirstChild("Map")
	return map ~= nil and not map:GetAttribute("Generated")
end

function MapBuilder.Get(id)
	return MapBuilder.Defs[id]
end

function MapBuilder.Build(id)
	if MapBuilder.IsCustom() then
		ReplicatedStorage:SetAttribute("MapName", "Mapa propio")
		return nil
	end
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end
	local def = MapBuilder.Defs[id or MapBuilder.Order[1]] or MapBuilder.Defs[MapBuilder.Order[1]]
	MapBuilder.UpdateFeatured() -- (cambia a medianoche: se revisa con cada mapa)
	def.Build()
	-- Gravedad del mapa (la Base Lunar tiene menos: se salta más y las granadas vuelan más)
	workspace.Gravity = def.Gravity or 196.2
	-- Decoración del evento de temporada (calabazas en Halloween)
	local ok, err = pcall(function()
		require(script.Parent.Event).Decorate()
	end)
	if not ok then
		warn("[MapBuilder] decoración del evento:", err)
	end
	MapBuilder.Current = def.Id
	ReplicatedStorage:SetAttribute("MapName", def.Name)
	ReplicatedStorage:SetAttribute("MapId", def.Id)
	-- (para la presentación del mapa en el cliente)
	ReplicatedStorage:SetAttribute("MapDescription", def.Description or "")
	ReplicatedStorage:SetAttribute("MapIcon", def.Icon or "")
	return def
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="70">
          <Properties>
            <string name="Name">MapDefs</string>
          </Properties>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">Coastal</string>
              <string name="Source"><![CDATA[-- COSTA (5v5 · Duelo por equipos · Buscar y destruir): pueblo costero mediterráneo. Iglesia con
-- campanario y plaza con fuente en el centro; la parte alta (sitio A, ayuntamiento con balcón y
-- lona roja) y el puerto (sitio B en el espigón, lonja con azotea y lona azul). Reconstruido de la
-- hoja de referencia: minimapa (bases arriba/abajo, A a la izquierda, B a la derecha, muelle al
-- sur), imagen principal (plaza, fuente, puestos, escaleras, muelle con bolardos y barcas, faro) y
-- paneles (calle principal, pasarela superior, variante nocturna).
--
-- Archivos: Lighting (luz y variantes), Geometry (blockout jugable), Props (cobertura y decorado),
-- Dressing (acabados de la Fase 14: suelo por zonas, buganvillas, banderines).
local T = require(script.Parent.Parent.TacKit)
local Lighting = require(script.Lighting)
local Geometry = require(script.Geometry)
local Props = require(script.Props)
local Dressing = require(script.Dressing)

local Map = {
	Id = "Coastal",
	Name = "Costa",
	Icon = "⛵",
	Description = "Pueblo costero · plaza y puerto · 5 contra 5",
	Realistic = true,
	Bomb = true,
	Palette = "Coastal",
	Ambience = "Coast",
	Modes = { "TDM", "SND" },
	RecommendedPlayers = 10,
	Bounds = Vector3.new(300, 60, 260),
}

Map.Lighting = Lighting.Default
Map.LightingVariants = Lighting.Variants

local V = Vector3.new
local CF = CFrame.new
local UP = 6

function Map.Build()
	local folder = T.begin(Map)
	Geometry.build(T)
	Props.build(T)
	Dressing.build(T) -- (Fase 14: acabados; solo decorado)

	-- Bases
	local redBase = CFrame.lookAt(V(-134, 0, 0), V(-100, 0, 0))
	T.spawnZone(1, redBase, { Size = Vector2.new(36, 22), Floor = Color3.fromRGB(176, 164, 144) })
	T.spawnZone(2, T.mirrorCFrame(redBase), { Size = Vector2.new(36, 22), Floor = Color3.fromRGB(176, 164, 144) })
	T.flagBase(1, CF(-140, 0, 32))
	T.flagBase(2, CF(140, 0, 32))
	local teams = require(game:GetService("ReplicatedStorage").Shared.GameConfig).Teams
	for i, x in { -148.6, 148.6 } do
		for _, z in { -14, 14 } do
			local look = { teams[i].Color.Color, Enum.Material.Fabric }
			T.G.deco("TeamBanner", V(0.3, 8, 5), CF(x, 6.5, z), look).Color = look[1]
		end
	end

	-- Sitios
	T.site(V(0, UP, -97), "A")
	T.site(V(0, 0, 97), "B", { Color = Color3.fromRGB(46, 110, 220) })

	-- Zonas: centro (sur de la fuente), A, B y una por lado en la calle mayor
	T.zone(V(0, 0, 22), 8, 1)
	T.zone(V(0, 0, 97), 9, 2)
	T.zone(V(-80, 0, -2), 8, 3)
	T.zone(V(0, UP, -97), 9, 4)
	T.zone(V(80, 0, -2), 8, 5)

	-- Nombres de zona
	T.callout("PLAZA", CF(0, 8, 0), V(60, 20, 60))
	T.callout("CAMPANARIO", CF(0, 6, -25), V(12, 14, 12))
	T.callout("IGLESIA", CF(0, 7, -46), V(28, 14, 32))
	T.callout("ÁBSIDE", CF(0, UP + 5, -71), V(28, 10, 18))
	T.callout("PLAZA ALTA", CF(0, UP + 6, -98), V(92, 16, 36))
	T.callout("AYUNTAMIENTO", CF(0, UP + 8, -121), V(60, 16, 18))
	T.callout("BALCÓN", CF(0, UP + 11, -109), V(42, 6, 8))
	T.callout("LONJA", CF(0, 4, 70), V(36, 8, 16))
	T.callout("AZOTEA DE LA LONJA", CF(0, 11, 70), V(46, 6, 18))
	T.callout("ESPIGÓN", CF(0, 6, 98), V(80, 16, 40))
	T.callout("MUELLE", CF(0, 4, 124), V(10, 8, 12))
	T.callout("CALLE DEL PUERTO", CF(0, 6, 46), V(36, 14, 32))
	for _, m in { 1, -1 } do
		local function at(x, y, z)
			return CF(m * x, y, z)
		end
		T.callout("CALLEJÓN", at(76, 8, -35), V(72, 18, 22))
		T.callout("CALLE MAYOR", at(72, 8, -2), V(76, 18, 16))
		T.callout("TABERNA", at(66, 5, -17), V(16, 10, 14))
		T.callout("ARCO", at(33, 5, 2), V(6, 10, 8))
		T.callout("PASEO", at(76, 8, 62), V(72, 18, 46))
		T.callout("MIRADOR", at(47, UP + 6, -71), V(66, 14, 18))
		T.callout("PLAZUELA", at(27, 6, -44), V(26, 14, 36))
		T.callout("ESCALINATA", at(23, 4, -56), V(10, 10, 12))
	end

	-- Puntos libres
	for _, p in {
		V(-124, 0.5, -36), V(-124, 0.5, 36), V(-100, 0.5, -30), V(-70, 0.5, -38), V(-50, 0.5, -30),
		V(-96, 0.5, -4), V(-50, 0.5, -2), V(-20, 0.5, 12), V(-62, 0.5, 20), V(-88, 0.5, 58),
		V(-50, 0.5, 74), V(-28, 0.5, 96), V(-34, 0.5, 64), V(-30, 0.5, -48), V(-60, UP + 0.5, -70),
		V(-30, UP + 0.5, -104), V(-8, UP + 8.5, -110), V(-10, 9, 72), V(-8, 0.5, -36),
	} do
		T.ffa(p)
		T.ffa(T.mirrorPoint(p))
	end
	-- Puestos de los bots
	for _, spot in {
		{ V(-12, UP + 8, -109), V(-20, UP + 4, -85) }, -- balcón del ayuntamiento, sobre la plaza alta
		{ V(-10, 8.5, 74), V(-10, 4, 100) }, -- azotea de la lonja, al espigón
		{ V(-40, UP, -66), V(-20, 4, -10) }, -- mirador, sobre la plaza
		{ V(-34, UP, -104), V(0, UP + 4, -90) }, -- plaza alta, junto al puesto
		{ V(-30, 0, 104), V(0, 4, 90) }, -- espigón, tras la barca
	} do
		T.botSpot(spot[1], spot[2])
		T.botSpot(T.mirrorPoint(spot[1]), T.mirrorPoint(spot[2]))
	end

	T.Kit.bounds(Map.Bounds.X, Map.Bounds.Z, Map.Bounds.Y)
	return folder
end

return Map
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="72">
              <Properties>
                <string name="Name">Dressing</string>
                <string name="Source"><![CDATA[-- COSTA · acabados (Fase 14, pulido visual sin tocar el juego). Todo es decorado: no choca ni para
-- balas.
--
--   * Suelo por zonas: adoquín cálido en la calle mayor y el callejón, piedra arenisca en la plaza de
--     la fuente con un marco de azulejo de barro, barro cocido en la plaza alta (sitio A, cálido),
--     paseo marítimo claro con franja de azulejo azul junto a la barandilla, borde de azulejo azul en
--     el espigón (sitio B, azul) y arena en el patio de las bases.
--   * Buganvillas en las fachadas de las calles (el magenta del pueblo mediterráneo).
--   * Banderines de fiesta sobre la calle mayor y la plaza (por encima de la cabeza).
--   (Las casas encaladas llevan además zócalo pintado azul u ocre: Geometry, opción Plinth.)
local Dressing = {}

local V = Vector3.new
local CF = CFrame.new
local RGB = Color3.fromRGB

local UP = 6
local FLAGS = { RGB(214, 52, 46), RGB(246, 196, 48), RGB(40, 96, 170), RGB(244, 240, 230) }

function Dressing.build(T)
	local F = T.F

	---------------------------------------------------------------------------
	-- Suelo del centro (plaza, plaza alta, espigón)
	---------------------------------------------------------------------------
	F.groundZone(CF(0, 0, 2), 64, 56, "PlazaStone", "PlazaStone")
	F.zoneEdge(CF(0, 0, 8), 36, 36, "TileTerracotta", 1)
	F.zoneEdge(CF(0, 0, 2), 64, 56, "StoneDark", 0.6)
	F.groundZone(CF(0, UP, -97), 92, 34, "UpperPaving", "UpperPaving")
	F.zoneEdge(CF(0, UP, -97), 92, 34, "StoneDark", 0.6)
	F.zoneEdge(CF(0, 0, 98), 78, 38, "TileBlue", 1)

	-- Banderines: cruzan la plaza en diagonal y la calle del puerto (alto, sin tocar el campanario)
	F.bunting(V(-30, 11, -26), V(30, 11, 28), FLAGS)
	F.bunting(V(30, 11, -26), V(-30, 11, 28), FLAGS)
	F.bunting(V(-17, 9.5, 40), V(17, 9.5, 40), FLAGS)

	---------------------------------------------------------------------------
	-- Mitad en espejo: calles, paseo, base, buganvillas y banderines de la calle mayor
	---------------------------------------------------------------------------
	T.mirrored("CoastalDressing", function()
		F.groundZone(CF(-74, 0, -2), 76, 16, "StreetCobble", "StreetCobble")
		F.groundZone(CF(-76, 0, -35), 72, 22, "StreetCobble", "StreetCobble")
		F.groundZone(CF(-95, 0, 68), 110, 32, "Promenade", "Promenade")
		F.groundZone(CF(-95, 0, 83.4), 110, 1.4, "TileBlue", "PromenadeTiles")
		F.groundZone(CF(-131, 0, 0), 37, 88, "BaseSand", "BaseSand")
		-- Buganvillas en las esquinas entre casas (calle mayor, callejón y manzana de la taberna)
		for _, spec in {
			{ CF(-94, 5.5, 5.7), 3.4, 6 }, { CF(-66.4, 6.5, 5.7), 3, 5 },
			{ CF(-95, 6, -45.7) * CFrame.Angles(0, math.pi, 0), 3.4, 6 },
			{ CF(-82, 5.5, -24.3), 3, 5 },
			{ CF(-79, 5, 52.3) * CFrame.Angles(0, math.pi, 0), 3, 5 },
		} do
			F.climber(spec[1], spec[2], spec[3], "Bougainvillea")
		end
		-- Banderines sobre la calle mayor (de fachada a fachada)
		for _, x in { -96, -80, -60 } do
			F.bunting(V(x, 9.5, -9.6), V(x + 4, 9.5, 5.6), FLAGS)
		end
	end)
end

return Dressing
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="73">
              <Properties>
                <string name="Name">Geometry</string>
                <string name="Source"><![CDATA[-- COSTA · geometría jugable (blockout). Pueblo costero en una isla:
--
--   z -130 ┌──── casas ──── AYUNTAMIENTO (balcón, lona A) ──── casas ────┐  parte alta (y = 6)
--          │                 PLAZA ALTA (sitio A)                        │
--   z  -80 │── casas ─ arco ─┬─ ábside ─┬─ arco ─ casas ──────────────────│
--          │   MIRADOR       │ IGLESIA  │        MIRADOR                │
--   z  -62 ├─escalera─ PLAZUELA (escalinata) │ (escalinata) PLAZUELA ─escalera─┤  muro de contención
--   BASE ──┤ CALLEJÓN  │       campanario       │  CALLEJÓN ├── BASE
--   ROJA   │ CALLE MAYOR ─ ARCO ─ PLAZA (fuente) ─ ARCO ─ CALLE MAYOR │  AZUL
--   (muralla│ PASEO MARÍTIMO   │ calle del puerto │   PASEO MARÍTIMO │ muralla)
--   z   62 │   (mar)          │ LONJA (azotea)    │          (mar)   │
--   z  118 │                  │ ESPIGÓN (sitio B) │                  │
--          └──────────────────┴── muelle de madera ┴─────────────────┘
--
-- Simétrico en X = 0 (cada equipo tiene lo mismo); la mitad A (alta, cálida) y la B (puerto, azul)
-- son distintas. Alturas: calle 0, parte alta 6, balcón del ayuntamiento 14, azotea de la lonja 8.
local Geometry = {}

local V = Vector3.new
local CF = CFrame.new

local UP = 6 -- altura de la parte alta

function Geometry.build(T)
	local G = T.G
	local door, window = G.door, G.window
	local M = Enum.Material

	---------------------------------------------------------------------------
	-- Terreno: mar alrededor, la isla y la ladera del norte
	---------------------------------------------------------------------------
	workspace.Terrain:FillBlock(CF(0, -11, 0), V(1600, 16, 1600), M.Water)
	T.terrain(M.Rock, 340, 250, CF(0, -0.3, -40))
	T.terrain(M.Rock, 84, 36, CF(0, -0.3, 102))
	T.terrain(M.Sand, 60, 20, CF(-95, -2.6, 96))
	T.terrain(M.Sand, 60, 20, CF(95, -2.6, 96))

	---------------------------------------------------------------------------
	-- Suelos: pueblo bajo (0), parte alta (6, con su muro de contención), espigón y muelle
	---------------------------------------------------------------------------
	G.floor(CF(0, 0, 11.5), 300, 147, "Paving")
	G.box("UpperTown", V(300, 7, 73), CF(0, 2.5, -98.5), "Stone")
	G.floor(CF(0, 0, 98), 80, 40, "Quay")
	G.floor(CF(0, 0.3, 124), 10, 12, "Deck", 0.6)
	-- Paramento del muelle hasta el agua
	G.deco("Seawall", V(82, 4, 1), CF(0, -2, 118.5), "StoneDark")
	for _, s in { -1, 1 } do
		G.deco("Seawall", V(1, 4, 40), CF(s * 40.5, -2, 98), "StoneDark")
		G.deco("Seawall", V(110, 4, 1), CF(s * 95, -2, 85.5), "StoneDark")
		G.deco("PierPost", V(0.8, 5, 0.8), CF(s * 4.6, -2, 129.6), "Deck")
	end

	---------------------------------------------------------------------------
	-- IGLESIA (eje): nave en la calle, ábside en la parte alta y escalera dentro que las une.
	-- Campanario delante, con paso por su base. Corta las líneas de un lado a otro de la plaza.
	---------------------------------------------------------------------------
	G.shell(CF(0, 0, -46), 28, 32, 14, "Whitewash", {
		Front = { door(0, 6, 8, UP) }, -- (cara norte, z -62: al ábside, en la parte alta)
		Back = { door(0, 6, 9) }, -- (cara sur, z -30: la puerta principal, tras el campanario)
		Left = { door(2, 6, 8) },
		Right = { door(2, 6, 8) },
	}, { Frame = "Stone" })
	G.stairs(V(0, 0, -47), V(0, UP, -59), 6, "Stone", { Rails = "Both", RailLook = "Iron" })
	G.floor(CF(0, UP, -60.5), 8, 3, "Stone")
	T.gableRoof(CF(0, 14, -46) * CFrame.Angles(0, math.pi / 2, 0), 32, 28, 6, "RoofTile")
	T.gable(CF(0, 14, -30.3) * CFrame.Angles(0, math.pi / 2, 0), 28, 6, "Whitewash")
	T.gable(CF(0, 14, -61.7) * CFrame.Angles(0, math.pi / 2, 0), 28, 6, "Whitewash")
	-- Techo de madera de la nave (el tejado de teja es decorado)
	T.cap(G.floor(CF(0, 14.6, -46), 28, 32, "Deck", 0.6))
	-- Ábside en la parte alta
	G.shell(CF(0, UP, -71), 28, 18, 9, "Whitewash", {
		Front = { door(0, 6, 8) }, -- (cara norte, z -80: a la plaza alta)
		Left = { door(-1) },
		Right = { door(-1) },
	}, { Frame = "Stone", Skip = { Back = true } })
	T.cap(G.floor(CF(0, UP + 9.6, -71), 30, 20, "RoofTile", 0.6))
	-- Campanario (base con paso de 5 y techo; arriba, campanas detrás de arcos: decorado)
	G.shell(CF(0, 0, -25), 10, 10, 9, "Sand", {
		Front = { door(0, 5, 7.5) },
		Back = { door(0, 5, 7.5) },
	}, { Frame = "Stone" })
	G.floor(CF(0, 9, -25), 10, 10, "Stone")
	local tower = G.box("BellTower", V(10, 26, 10), CF(0, 9 + 13, -25), "Whitewash")
	T.cap(tower)
	-- (Fase 3: hito de la plaza. Torre encalada con esquinas de piedra y una franja de azulejo azul bajo
	-- la cornisa: se reconoce desde cualquier calle)
	for _, corner in { V(-4.85, 0, -4.85), V(4.85, 0, -4.85), V(-4.85, 0, 4.85), V(4.85, 0, 4.85) } do
		G.deco("TowerQuoin", V(0.9, 26, 0.9), CF(V(0, 9 + 13, -25) + corner), "Stone")
	end
	G.deco("TowerTileBand", V(10.3, 1, 10.3), CF(0, 33.8, -25), { Color3.fromRGB(40, 96, 170), M.CeramicTiles })
	for _, face in { { V(0, 0, -5.1), 0 }, { V(0, 0, 5.1), math.pi }, { V(-5.1, 0, 0), math.pi / 2 }, { V(5.1, 0, 0), -math.pi / 2 } } do
		local at = CF(V(0, 29, -25) + face[1]) * CFrame.Angles(0, face[2], 0)
		G.deco("Belfry", V(4, 5, 0.3), at, { Color3.fromRGB(40, 36, 34), M.SmoothPlastic })
		T.archCorners(at * CF(0, 2.5, -0.1), 4, 1.4, "Sand", 0.5)
		G.deco("BelfrySill", V(5, 0.4, 0.8), at * CF(0, -2.6, 0), "Stone")
	end
	G.deco("TowerCornice", V(11, 0.8, 11), CF(0, 35.2, -25), "Stone")
	T.gableRoof(CF(0, 35.6, -25), 10, 10, 4, "RoofTile")
	T.gableRoof(CF(0, 35.6, -25) * CFrame.Angles(0, math.pi / 2, 0), 10, 10, 4, "RoofTile")
	local bell = T.Kit.ball("Bell", 2.6, CF(0, 29, -25), Color3.fromRGB(170, 130, 60), M.Metal, true)
	bell.CastShadow = false
	local clock = T.Kit.cylinder("TowerClock", 0.4, 4, CF(0, 20, -19.8) * CFrame.Angles(math.pi / 2, 0, 0), Color3.fromRGB(240, 236, 224), M.SmoothPlastic, nil, true)
	clock.CastShadow = false
	T.Kit.cylinder("TowerClockRing", 0.3, 4.6, CF(0, 20, -19.85) * CFrame.Angles(math.pi / 2, 0, 0), Color3.fromRGB(40, 96, 170), M.CeramicTiles, nil, true).CastShadow = false
	G.deco("ClockHand", V(0.25, 1.5, 0.1), CF(0, 20.6, -19.55), "Iron").CastShadow = false
	G.deco("ClockHand", V(1.1, 0.25, 0.1), CF(0.45, 20, -19.55), "Iron").CastShadow = false

	---------------------------------------------------------------------------
	-- AYUNTAMIENTO (sitio A, parte alta): dos plantas, balcón con la lona A
	---------------------------------------------------------------------------
	local a = CF(0, UP, -121) * CFrame.Angles(0, math.pi, 0)
	G.shell(a, 60, 18, 8, "Terracotta", {
		Front = { door(-10, 6, 7), door(10, 6, 7), window(-22, 3, 4, 3.5), window(22, 3, 4, 3.5) },
	}, { Frame = "Stone" })
	G.shell(a * CF(0, 8, 0), 60, 18, 8, "Terracotta", {
		Front = { door(-10, 5, 7), door(10, 5, 7), window(-22, 2.5, 4, 3.5), window(22, 2.5, 4, 3.5) },
	}, { Frame = "Stone" })
	G.slab(CF(0, UP + 8, -121), 58, 16, "Stone", { { -25, -2, 4.4, 12 }, { 25, -2, 4.4, 12 } })
	T.cap(G.floor(CF(0, UP + 16.6, -121), 61, 19, "Stone", 0.6))
	G.deco("TownHallCornice", V(61, 0.8, 19), CF(0, UP + 16, -121), "Stone")
	for _, s in { -1, 1 } do
		G.stairs(V(s * 25, UP, -127), V(s * 25, UP + 8, -115), 4, "Stone", { Rails = s > 0 and "Right" or "Left", RailLook = "Iron" })
		G.railing(V(s * 22.8, UP + 8, -122), V(s * 22.8, UP + 8, -115.2), "Iron")
	end
	-- Balcón corrido delante de la primera planta
	G.floor(CF(0, UP + 8, -109), 40, 6, "Stone", 1)
	G.railing(V(-20, UP + 8, -106.3), V(20, UP + 8, -106.3), "Iron")
	for _, s in { -1, 1 } do
		G.railing(V(s * 19.8, UP + 8, -112), V(s * 19.8, UP + 8, -106.3), "Iron")
		G.beam(V(s * 18, 0, -106.8) + V(0, UP, 0), V(s * 18, UP + 7.4, -106.8), 0.8, 0.8, "Stone")
	end

	---------------------------------------------------------------------------
	-- LONJA (puerto, sur de la plaza): soportales de paso y azotea con dos escaleras
	---------------------------------------------------------------------------
	G.shell(CF(0, 0, 70), 36, 16, 8, "Stone", {
		Front = { door(-12, 6, 6.5), door(0, 6, 6.5), door(12, 6, 6.5) },
		Back = { door(-12, 6, 6.5), door(0, 6, 6.5), door(12, 6, 6.5) },
	}, { Frame = "StoneDark" })
	for _, z in { 62, 78 } do
		for _, x in { -12, 0, 12 } do
			T.archCorners(CF(x, 6.5, z) * (z > 70 and CFrame.Angles(0, math.pi, 0) or CFrame.new()), 6, 1.6, "Stone")
		end
	end
	G.floor(CF(0, 8.5, 70), 36, 16, "Paving", 1)
	G.deco("LonjaCeiling", V(34, 0.3, 14), CF(0, 7.35, 70), "Deck")
	for _, s in { -1, 1 } do
		G.stairs(V(s * 20.5, 0, 77), V(s * 20.5, 8.5, 64), 4, "Stone", { Rails = s > 0 and "Right" or "Left", RailLook = "Iron" })
		G.floor(CF(s * 20.2, 8.5, 62.5), 4.6, 3, "Stone", 0.5)
		-- Pretil de la azotea (cobertura baja con hueco donde llega la escalera)
		G.box("LonjaParapet", V(0.8, 2.6, 13), CF(s * 17.6, 8.5 + 1.3, 71.5), "Stone")
		G.railing(V(s * 22.6, 8.5, 61), V(s * 22.6, 8.5, 64), "Iron")
		G.railing(V(s * 18.4, 8.5, 61.2), V(s * 22.6, 8.5, 61.2), "Iron")
	end
	G.box("LonjaParapet", V(36, 2.6, 0.8), CF(0, 8.5 + 1.3, 77.6), "Stone")
	G.box("LonjaParapet", V(28, 2.6, 0.8), CF(0, 8.5 + 1.3, 62.4), "Stone")

	T.mirrored("CoastalHalf", function()
		Geometry.half(T)
	end)
end

-- Mitad del Rojo (X < 0)
function Geometry.half(T)
	local G = T.G
	local door = G.door

	-- (Fase 3: paleta de la referencia, blanco + arena + terracota + azul. Más casas encaladas y
	-- contraventanas azules: el pueblo se lee mediterráneo y luminoso)
	local looks = { "Whitewash", "Sand", "Terracotta", "Whitewash", "Ochre", "Whitewash", "Sand" }
	local shutters = { Color3.fromRGB(40, 96, 170), Color3.fromRGB(36, 128, 168), Color3.fromRGB(70, 120, 92) }
	local plinths = { Color3.fromRGB(58, 104, 168), Color3.fromRGB(200, 150, 78), Color3.fromRGB(70, 132, 160) }
	local count = 0
	-- Manzana de casas macizas: tramos de ~14 con alturas, colores y tejados distintos
	local function row(x0, x1, z0, z1, h, opts)
		opts = opts or {}
		local alongX = (x1 - x0) >= (z1 - z0)
		local length = alongX and (x1 - x0) or (z1 - z0)
		local pieces = math.max(1, math.floor(length / (opts.Piece or 14) + 0.5))
		for k = 0, pieces - 1 do
			count += 1
			local a0 = (alongX and x0 or z0) + k * length / pieces
			local a1 = a0 + length / pieces
			local cx = alongX and (a0 + a1) / 2 or (x0 + x1) / 2
			local cz = alongX and (z0 + z1) / 2 or (a0 + a1) / 2
			local w = alongX and (a1 - a0) or (x1 - x0)
			local d = alongX and (z1 - z0) or (a1 - a0)
			local height = h + ((count * 5) % 3) * 2
			-- (la cara con ventanas mira a la calle: opts.Face = dirección de la calle)
			local face = opts.Face or V(0, 0, 1)
			local yaw = math.atan2(-face.X, -face.Z)
			local turned = math.abs(face.X) > 0.5
			local cf = CF(cx, opts.Y or 0, cz) * CFrame.Angles(0, yaw, 0)
			local look = looks[(count % #looks) + 1]
			T.cap(T.house(cf, turned and d or w, turned and w or d, height, look, {
				Roof = (count % 3 == 0) and "Flat" or "Tile",
				Shutter = shutters[(count % #shutters) + 1],
				-- (Fase 14: las encaladas, con zócalo pintado azul u ocre)
				Plinth = look == "Whitewash" and plinths[(count % #plinths) + 1] or nil,
				Back = opts.Back,
				Balcony = count % 4 == 1,
				Door = opts.Door,
			}))
		end
	end

	------------------------------------------------------------------
	-- BASE: patio tras la muralla, tres puertas (norte, centro, sur)
	------------------------------------------------------------------
	local wallH = 10
	T.cap(G.wall(CF(-112, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0), 90, wallH, "StoneDark", {
		door(-34, 8, 8), door(-7, 6, 8), door(37, 10, 8),
	}, { T = 2, Frame = "Stone" }))
	T.cap(G.wall(CF(-150, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0), 90, 12, "StoneDark", {}, { T = 2 }))
	-- Almenas de la muralla y arcos de las puertas
	for z = -44, 44, 4 do
		if not ((z > -39 and z < -29) or (z > -11 and z < -3) or (z > 31 and z < 43)) then
			G.deco("Merlon", V(2.2, 1.6, 2), CF(-112, wallH + 0.8, z), "StoneDark")
		end
	end
	for _, gate in { { -34, 8 }, { -7, 6 }, { 37, 10 } } do
		T.archCorners(CF(-111, 8, gate[1]) * CFrame.Angles(0, -math.pi / 2, 0), gate[2], 1.6, "StoneDark", 2.2)
	end
	-- Mamparas: las salidas norte y sur quedan en L; la central, tras un crucero de piedra
	T.cap(G.wall(CF(-119, 0, -28) * CFrame.Angles(0, -math.pi / 2, 0), 16, 8, "Stone"))
	T.cap(G.wall(CF(-119, 0, 29) * CFrame.Angles(0, -math.pi / 2, 0), 18, 8, "Stone"))
	T.cap(G.solid("StoneCross", V(3, 6, 10), CF(-117.5, 0, -4), "Stone"))
	G.deco("CrossShaft", V(0.8, 5, 0.8), CF(-117.5, 8.5, -4), "Stone")
	G.deco("CrossArm", V(0.8, 0.8, 3), CF(-117.5, 10, -4), "Stone")
	-- Casas a los lados de la base
	row(-150, -112, -62, -46, 12, { Face = V(0, 0, 1) })
	row(-150, -112, 46, 90, 12, { Face = V(0, 0, -1) })

	------------------------------------------------------------------
	-- CALLEJÓN (norte): casas a los dos lados, escalera a la parte alta y arcos con parra
	------------------------------------------------------------------
	row(-112, -78, -62, -46, 12, { Face = V(0, 0, 1) })
	row(-66, -40, -62, -46, 12, { Face = V(0, 0, 1) })
	G.stairs(V(-72, 0, -50), V(-72, UP, -62), 6, "Stone", { Rails = "Both", RailLook = "Iron" })
	for _, x in { -77.4, -66.6 } do
		G.solid("StairWall", V(1.2, UP + 1, 12), CF(x, 0, -56), "StoneDark")
	end
	-- Manzana entre el callejón y la calle mayor, con la TABERNA (se cruza de una calle a otra)
	row(-110, -74, -24, -10, 11, { Face = V(0, 0, -1), Back = true })
	row(-58, -30, -24, -10, 12, { Face = V(0, 0, -1), Back = true })
	G.shell(CF(-66, 0, -17), 16, 14, 9, "Ochre", {
		Front = { door(-3) },
		Back = { door(3) },
	}, { Frame = "Stone" })
	T.cap(G.floor(CF(-66, 9.5, -17), 17, 15, "RoofTile", 0.5))
	T.gableRoof(CF(-66, 9.8, -17), 16, 14, 3.5, "RoofTile")

	------------------------------------------------------------------
	-- CALLE MAYOR (centro) y el ARCO que da a la plaza (desplazado de la puerta de la base)
	------------------------------------------------------------------
	row(-108, -66, 6, 32, 12, { Face = V(0, 0, -1), Back = true })
	row(-58, -36, 6, 30, 12, { Face = V(0, 0, -1) })
	-- Arco de la villa: casa sobre un paso de 8 (z -2..6)
	T.cap(G.wall(CF(-33, 0, -2) * CFrame.Angles(0, -math.pi / 2, 0), 16, 13, "Rose", { door(4, 8, 8) }, { T = 6, Frame = "Stone" }))
	T.archCorners(CF(-36.1, 8, 2) * CFrame.Angles(0, -math.pi / 2, 0), 8, 2, "Stone", 0.4)
	T.gableRoof(CF(-33, 13, -2) * CFrame.Angles(0, math.pi / 2, 0), 16, 6, 2.5, "RoofTile")
	T.cap(G.solid("ArchPier", V(6, 12, 8), CF(-33, 0, 14), "Rose"))

	------------------------------------------------------------------
	-- PASEO MARÍTIMO (sur): casas frente al mar, barandilla del muelle
	------------------------------------------------------------------
	row(-100, -58, 40, 52, 11, { Face = V(0, 0, 1) })
	row(-30, -18, 30, 60, 11, { Face = V(1, 0, 0) })
	G.railing(V(-150, 0, 84.6), V(-40, 0, 84.6), "Iron")
	G.railing(V(-40.4, 0, 84.6), V(-40.4, 0, 117.6), "Iron")
	G.railing(V(-40.4, 0, 117.6), V(-5, 0, 117.6), "Iron")
	G.railing(V(-5, 0.6, 118), V(-5, 0.6, 129.6), "Iron")
	G.railing(V(-5, 0.6, 129.6), V(0, 0.6, 129.6), "Iron")
	-- Cierre del paseo junto a la base (baluarte)
	T.cap(G.wall(CF(-112, 0, 66) * CFrame.Angles(0, -math.pi / 2, 0), 38, 8, "StoneDark", {}, { T = 2 }))

	------------------------------------------------------------------
	-- PARTE ALTA: casas, mirador sobre el muro de contención, escalinata y arcos a la plaza alta
	------------------------------------------------------------------
	row(-112, -80, -130, -62, 12, { Face = V(1, 0, 0), Y = UP })
	row(-80, -46, -130, -90, 12, { Face = V(0, 0, 1), Y = UP })
	-- Fila entre el mirador y la plaza alta, con un arco de paso (x -30..-24)
	row(-46, -30, -90, -80, 10, { Face = V(0, 0, 1), Y = UP, Back = true })
	row(-24, -14, -90, -80, 10, { Face = V(0, 0, 1), Y = UP, Back = true })
	G.deco("ArchBridge", V(6, 2.2, 10), CF(-27, UP + 8.6, -85), "Ochre")
	T.archCorners(CF(-27, UP + 7.5, -80.2), 6, 1.5, "Ochre", 0.6)
	-- Escalinata de la plazuela a la parte alta
	G.stairs(V(-23, 0, -50), V(-23, UP, -62), 9, "Stone", { Rails = "Both", RailLook = "Iron" })
	-- Balaustrada del mirador (cobertura baja) salvo donde llegan las escaleras
	for _, seg in { { -80, -75.6 }, { -68.4, -27.8 }, { -18.2, -14 } } do
		G.box("Balustrade", V(seg[2] - seg[1], 3, 0.8), CF((seg[1] + seg[2]) / 2, UP + 1.5, -62.6), "Stone")
	end
	-- Pequeño bloque en la esquina de la plaza alta
	row(-46, -30, -130, -112, 13, { Face = V(1, 0, 0), Y = UP })
end

return Geometry
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="74">
              <Properties>
                <string name="Name">Lighting</string>
                <string name="Source"><![CDATA[-- COSTA · luz. Por defecto, tarde soleada de verano como la referencia (cielo azul, mar intenso,
-- sombras cálidas y cortas). Variantes: atardecer dorado y noche con faroles y el faro encendido.
local RGB = Color3.fromRGB
local V = Vector3.new

local Lighting = {}

Lighting.Default = {
	ClockTime = 15.6,
	Latitude = 36,
	Brightness = 3.1,
	Exposure = 0,
	-- (Fase 3: el mapa más luminoso. Ambiente más alto para que callejones, iglesia y taberna no
	-- queden en penumbra, y neblina más ligera: el faro y el mar se ven nítidos y nada tapa a un enemigo)
	Ambient = RGB(124, 118, 112),
	OutdoorAmbient = RGB(166, 162, 156),
	ShadowSoftness = 0.12,
	Atmosphere = { Density = 0.2, Offset = 0.08, Color = RGB(206, 226, 242), Decay = RGB(130, 160, 196), Glare = 0.2, Haze = 0.6 },
	Color = { Saturation = 0.14, Contrast = 0.12, Brightness = 0.01, Tint = RGB(255, 248, 236) },
	Bloom = { Intensity = 0.35, Size = 22, Threshold = 2.1 },
	Clouds = 0.32,
	CloudColor = RGB(255, 255, 255),
	SunRays = 0.06,
	Wind = V(8, 0, 4),
	Water = { Color = RGB(20, 96, 150), Reflectance = 0.6, Transparency = 0.45, WaveSize = 0.18, WaveSpeed = 12 },
	TerrainColors = { Rock = RGB(150, 138, 120), Sand = RGB(214, 194, 150), Grass = RGB(110, 140, 70), Ground = RGB(150, 130, 100) },
}

Lighting.Variants = {
	{
		Name = "Atardecer",
		Chance = 0.3,
		ClockTime = 18.1,
		Brightness = 2.4,
		Exposure = 0.05,
		Ambient = RGB(110, 86, 82),
		OutdoorAmbient = RGB(160, 126, 112),
		Atmosphere = { Density = 0.26, Offset = 0.08, Color = RGB(250, 190, 150), Decay = RGB(170, 110, 110), Glare = 0.6, Haze = 1.3 },
		Color = { Saturation = 0.12, Contrast = 0.12, Brightness = 0.01, Tint = RGB(255, 232, 210) },
		CloudColor = RGB(255, 190, 160),
		SunRays = 0.12,
		Water = { Color = RGB(40, 80, 120), Reflectance = 0.8, Transparency = 0.4, WaveSize = 0.15, WaveSpeed = 10 },
	},
	{
		Name = "Noche",
		Chance = 0.25,
		ClockTime = 21.4,
		Brightness = 1.1,
		Exposure = 0.35,
		Ambient = RGB(66, 70, 98),
		OutdoorAmbient = RGB(80, 90, 126),
		Atmosphere = { Density = 0.26, Offset = 0.06, Color = RGB(60, 70, 110), Decay = RGB(26, 30, 56), Glare = 0, Haze = 1 },
		Color = { Saturation = 0.06, Contrast = 0.14, Brightness = 0.03, Tint = RGB(214, 222, 255) },
		Bloom = { Intensity = 0.5, Size = 24, Threshold = 1.5 },
		Clouds = 0.25,
		CloudColor = RGB(70, 76, 104),
		SunRays = 0,
		Water = { Color = RGB(14, 30, 60), Reflectance = 1, Transparency = 0.3, WaveSize = 0.15, WaveSpeed = 8 },
	},
}

return Lighting
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="75">
              <Properties>
                <string name="Name">Props</string>
                <string name="Source"><![CDATA[-- COSTA · props: cobertura con propósito (fuente y puestos en la plaza, barcas varadas y cajas de
-- pescado en el espigón, carros y cajas en el callejón, pozos y carro en la plaza alta) y el
-- decorado que da la personalidad (parras, ropa tendida, faroles, macetas, palmeras, barcas en el
-- agua, el faro en su islote y la ladera con casas).
local Props = {}

local V = Vector3.new
local CF = CFrame.new
local RGB = Color3.fromRGB
local rad = math.rad
local M = Enum.Material

local UP = 6

-- Velero fondeado (decorado): casco, mástil y vela triangular
local function sailboat(T, cf, scale)
	scale = scale or 1
	local G = T.G
	G.deco("SailHull", V(4 * scale, 2 * scale, 14 * scale), cf * CF(0, 0.6 * scale, 0), { RGB(240, 240, 236), M.SmoothPlastic })
	G.deco("SailStripe", V(4.1 * scale, 0.5 * scale, 14.1 * scale), cf * CF(0, 1.2 * scale, 0), { RGB(40, 90, 170), M.SmoothPlastic })
	G.deco("SailMast", V(0.3, 14 * scale, 0.3), cf * CF(0, 8 * scale, -1 * scale), "Iron")
	T.wedge("Sail", V(0.15, 12 * scale, 7 * scale), cf * CF(0, 8 * scale, 2.6 * scale), { RGB(250, 248, 240), M.Fabric })
end

-- Ropa tendida entre dos puntos (decorado)
local function laundry(T, a, b)
	local G = T.G
	G.beam(a, b, 0.08, 0.08, "Iron", true)
	local colors = { RGB(220, 70, 60), RGB(250, 250, 245), RGB(70, 130, 200), RGB(240, 200, 70) }
	for i = 1, 4 do
		local p = a:Lerp(b, i / 5) - V(0, 0.9, 0)
		G.deco("Cloth", V(1.4, 1.6, 0.08), CFrame.lookAt(p, p + (b - a)) * CFrame.Angles(0, math.pi / 2, 0), { colors[i], M.Fabric })
	end
end

-- Arco sobre una calle (decorado): puente de casa a casa con parra colgando
local function streetArch(T, x, z0, z1, h, look)
	local G = T.G
	local cf = CF(x, h, (z0 + z1) / 2)
	G.deco("StreetArch", V(3, 2.4, z1 - z0), cf * CF(0, 1.2, 0), look)
	T.archCorners(cf * CFrame.Angles(0, math.pi / 2, 0), z1 - z0, 2, look, 3)
	-- Parra colgando (tiras finas y de largos distintos)
	for k = 0, math.floor((z1 - z0) * 0.6 / 1.2) do
		local len = 1.4 + (k * 37 % 10) / 6
		local z = z0 + (z1 - z0) * 0.2 + k * 1.2
		G.deco("Vine", V(0.5, len, 0.5), CF(x + 1.6, h - len / 2, z), { k % 2 == 0 and RGB(70, 140, 60) or RGB(96, 160, 70), M.LeafyGrass })
	end
end

function Props.build(T)
	local G = T.G
	local night = T.isNight()

	---------------------------------------------------------------------------
	-- Cobertura en el eje (sirve igual a los dos equipos)
	---------------------------------------------------------------------------
	T.fountain(CF(0, 0, 8), 12, RGB(40, 96, 170))
	-- Plaza alta: carro con cajas delante del ayuntamiento (cobertura del sitio A)
	G.solid("Cart", V(4, 2.4, 7), CF(0, UP + 0.6, -104), "Crate")
	for _, x in { -2.2, 2.2 } do
		T.Kit.pipe("CartWheel", 0.4, 2.6, CF(x, UP + 1.3, -104), RGB(90, 64, 40), M.Wood, true)
	end
	T.crate(CF(0.4, UP + 3, -105) * CFrame.Angles(0, rad(12), 0), 3)
	-- Espigón: cajas de pescado que cortan el paseo de punta a punta y el sitio B
	T.crateStack(CF(0, 0, 83) * CFrame.Angles(0, rad(90), 0), "Wall")
	T.crateStack(CF(0, 0, 112), "L")
	-- Lonja (dentro): mostradores de pescado (cobertura baja)
	for _, x in { -6, 6 } do
		G.box("FishCounter", V(4, 3, 8), CF(x, 1.5, 70), "Stone")
		G.deco("FishIce", V(3.6, 0.3, 7.6), CF(x, 3.1, 70), { RGB(220, 236, 244), M.Ice })
	end
	-- Bancos de la iglesia (cobertura baja) a los dos lados del pasillo central
	for _, z in { -34, -38, -42 } do
		for _, s in { -1, 1 } do
			G.box("Pew", V(8, 2.4, 1.4), CF(s * 8.5, 1.2, z), "Deck")
			G.deco("PewBack", V(8, 1.6, 0.3), CF(s * 8.5, 3.2, z + 0.6), "Deck")
		end
	end

	T.mirrored("CoastalProps", function()
		Props.half(T)
	end)

	---------------------------------------------------------------------------
	-- Lonas de los sitios y rótulos
	---------------------------------------------------------------------------
	T.letterBanner(CF(0, UP + 12, -111.4) * CFrame.Angles(0, math.pi, 0), "A", "Red", 7, 8)
	T.letterBanner(CF(0, 6, 61.3), "B", "Blue", 7, 6)
	T.letterBanner(CF(0, 4.6, 78.7) * CFrame.Angles(0, math.pi, 0), "B", "Blue", 5, 4.4)
	T.sign(CF(0, UP + 15, -111.6) * CFrame.Angles(0, math.pi, 0), "AYUNTAMIENTO", 16, 1.6, RGB(236, 226, 206), RGB(120, 60, 40), { PPS = 18 })
	T.sign(CF(0, 7.6, 61.2), "LONJA", 9, 1.4, RGB(236, 226, 206), RGB(40, 70, 120), { PPS = 18 })

	---------------------------------------------------------------------------
	-- Luz: faroles en las fachadas, farolas en la plaza y el paseo
	---------------------------------------------------------------------------
	for _, x in { -20, 20 } do
		T.streetLight(CF(x, 0, 24))
		T.streetLight(CF(x, 0, -14))
	end
	T.lantern(CF(-6, UP + 6.5, -111.6) * CFrame.Angles(0, math.pi, 0))
	T.lantern(CF(6, UP + 6.5, -111.6) * CFrame.Angles(0, math.pi, 0))
	T.lantern(CF(-9, 5.5, 61.2))
	T.lantern(CF(9, 5.5, 61.2))

	---------------------------------------------------------------------------
	-- Fondo: ladera con casas al norte, el faro en su islote, islas, veleros y sierra
	---------------------------------------------------------------------------
	local houseColors = { RGB(238, 232, 220), RGB(226, 204, 164), RGB(204, 112, 80), RGB(216, 168, 96), RGB(222, 176, 160) }
	-- (la isla sube por detrás del pueblo y la sierra queda lejos, azulada por la neblina)
	for _, spec in { { V(0, -40, -300), 90 }, { V(-170, -40, -280), 80 }, { V(170, -40, -290), 84 }, { V(-420, -60, -380), 150 }, { V(380, -70, -420), 160 } } do
		T.Kit.naturalHill(spec[1], spec[2], M.Rock, { Top = M.Grass, TopCount = 4 })
	end
	local i = 0
	for x = -230, 230, 22 do
		for _, zBase in { -150, -172, -194 } do
			i += 1
			local z = zBase + (i * 7) % 9
			local terrace = (zBase + 150) * -0.45 + 6
			local w, d, h = 14 + (i * 5) % 6, 12 + (i * 3) % 5, 9 + (i * 7) % 8
			local color = houseColors[(i % #houseColors) + 1]
			local body = G.deco("HillHouse", V(w, h, d), CF(x + (i % 3) * 3, terrace + h / 2, z), { color, M.Plaster })
			body.CastShadow = false
			local roof = G.deco("HillRoof", V(w + 1, 1, d + 1), CF(x + (i % 3) * 3, terrace + h + 0.4, z), i % 3 == 0 and { color:Lerp(Color3.new(0, 0, 0), 0.15), M.Plaster } or "RoofTile")
			roof.CastShadow = false
			if night and i % 2 == 0 then
				G.deco("HillWindow", V(2, 1.6, 0.1), CF(x + (i % 3) * 3, terrace + h * 0.55, z + d / 2 + 0.05), { RGB(230, 180, 110), M.Neon }).CastShadow = false
			end
		end
	end
	-- (Fase 3: el faro, más cerca y más alto: hito visible desde el paseo y el espigón)
	T.Kit.lighthouse(V(120, 0, 230), 1.3)
	T.Kit.naturalHill(V(-200, -40, 420), 90, M.Rock, { Top = M.Grass })
	T.Kit.naturalHill(V(300, -50, 260), 80, M.Rock)
	T.Kit.naturalHill(V(-420, -60, 120), 110, M.Rock, { Top = M.Grass })
	T.Kit.naturalHill(V(440, -60, -40), 120, M.Rock, { Top = M.Grass })
	sailboat(T, CF(-60, -3, 230) * CFrame.Angles(0, rad(30), 0), 1.4)
	sailboat(T, CF(80, -3, 190) * CFrame.Angles(0, rad(-60), 0), 1.1)
	sailboat(T, CF(230, -3, 120) * CFrame.Angles(0, rad(10), 0), 1.2)
	-- (de noche el faro alumbra)
	if night then
		local beam = G.deco("LighthouseGlow", V(2, 2, 2), CF(120, 48, 230), { RGB(255, 240, 200), M.Neon })
		T.Kit.light(beam, "PointLight", RGB(255, 236, 190), 60, 2)
	end
end

-- Mitad del Rojo (X < 0): se copia en espejo para el Azul
function Props.half(T)
	local G = T.G

	------------------------------------------------------------------
	-- BASE: naranjos, bancos, farol
	------------------------------------------------------------------
	T.tree(CF(-144, 0, -36))
	T.tree(CF(-144, 0, 36))
	T.lantern(CF(-113.2, 7, -20) * CFrame.Angles(0, math.pi / 2, 0))
	T.lantern(CF(-113.2, 7, 20) * CFrame.Angles(0, math.pi / 2, 0))

	------------------------------------------------------------------
	-- CALLEJÓN: carro, cajas, barriles, macetas, arcos con parra y ropa tendida
	------------------------------------------------------------------
	G.solid("Cart", V(4, 2.4, 7), CF(-92, 0.6, -36) * CFrame.Angles(0, rad(80), 0), "Crate")
	T.crate(CF(-90.5, 3, -36) * CFrame.Angles(0, rad(20), 0), 3)
	T.crateStack(CF(-56, 0, -40) * CFrame.Angles(0, rad(-8), 0), "L")
	T.barrel(CF(-82, 0, -27), { RGB(120, 84, 52), M.Wood })
	T.barrel(CF(-80.4, 0, -28.2), { RGB(120, 84, 52), M.Wood })
	T.Kit.flowerPot(CF(-104, 0, -44.5), RGB(230, 60, 90))
	T.Kit.flowerPot(CF(-62, 0, -44.5), RGB(250, 200, 70))
	T.Kit.flowerPot(CF(-48, 0, -25.5), RGB(230, 60, 90))
	streetArch(T, -96, -46, -24, 9, "Sand")
	streetArch(T, -46, -46, -24, 9.5, "Ochre")
	laundry(T, V(-84, 10, -46.2), V(-84, 9.6, -24.2))
	laundry(T, V(-60, 10.5, -46.2), V(-60, 10, -24.2))
	T.lantern(CF(-100, 7, -45.6) * CFrame.Angles(0, math.pi, 0))
	T.lantern(CF(-70, 7, -24.4))

	------------------------------------------------------------------
	-- Suelo: adoquín en el callejón y la calle mayor, juntas de losa en la plaza y el espigón
	------------------------------------------------------------------
	G.deco("Cobbles", V(72, 0.05, 22), CF(-76, 0.03, -35), "Cobble").CastShadow = false
	G.deco("Cobbles", V(76, 0.05, 16), CF(-74, 0.03, -2), "Cobble").CastShadow = false
	T.Kit.floorJoints(CF(-15, 0, 0), 30, 60, 5, RGB(176, 164, 144))
	T.Kit.floorJoints(CF(-20, 0, 98), 40, 40, 4, RGB(132, 126, 116))

	------------------------------------------------------------------
	-- CALLE MAYOR: terrazas, puesto y toldos
	------------------------------------------------------------------
	T.cafeTable(CF(-84, 0, -5), RGB(200, 60, 50))
	T.cafeTable(CF(-76, 0, 2), RGB(60, 110, 170))
	T.stall(CF(-98, 0, 3) * CFrame.Angles(0, rad(180), 0), RGB(200, 60, 50), 6)
	T.Kit.awning(CF(-90, 8, 5.6) * CFrame.Angles(0, math.pi, 0), 9, 3, RGB(200, 60, 50))
	T.Kit.awning(CF(-48, 8, 5.6) * CFrame.Angles(0, math.pi, 0), 9, 3, RGB(40, 120, 90))
	T.Kit.flowerPot(CF(-62, 0, -8.5), RGB(230, 60, 90))
	T.lantern(CF(-70, 7, 5.6) * CFrame.Angles(0, math.pi, 0))

	------------------------------------------------------------------
	-- PLAZA: puestos con toldo a rayas, mesas de café, palmeras y bancos
	------------------------------------------------------------------
	T.stall(CF(-16, 0, -6) * CFrame.Angles(0, rad(-90), 0), RGB(200, 60, 50), 6)
	T.stall(CF(-18, 0, 20) * CFrame.Angles(0, rad(-90), 0), RGB(40, 110, 180), 6)
	T.cafeTable(CF(-24, 0, 6), RGB(240, 200, 70))
	T.palm(CF(-26, 0, -24), 15)
	T.palm(CF(-26, 0, 27), 13)
	G.box("Bench", V(5, 1.4, 1.6), CF(-10, 0.7, 26), "Deck")
	-- Plazuela: olivo en su alcorque y un banco
	T.planter(CF(-34, 0, -38) * CFrame.Angles(0, rad(90), 0), 6, 3)
	G.box("Bench", V(1.6, 1.4, 5), CF(-38, 0.7, -52), "Deck")

	------------------------------------------------------------------
	-- PASEO MARÍTIMO: palmeras, bancos, quiosco, redes y barcas
	------------------------------------------------------------------
	for x = -104, -48, 14 do
		T.palm(CF(x, 0, 80), 13 + (x % 3))
		G.box("Bench", V(5, 1.4, 1.6), CF(x + 7, 0.7, 82), "Deck")
		T.bollard(CF(x + 3, 0, 84))
		T.tire(CF(x + 3, -1.2, 85.4))
	end
	T.cap(G.solid("Kiosk", V(5, 7, 5), CF(-78, 0, 64), "Shutter"))
	G.deco("KioskRoof", V(6.4, 0.6, 6.4), CF(-78, 7.3, 64), "RoofTile")
	T.crateStack(CF(-60, 0, 70) * CFrame.Angles(0, rad(15), 0), "L")
	G.deco("Nets", V(4, 0.8, 3), CF(-94, 0.4, 66), { RGB(70, 90, 70), M.Fabric })
	T.barrel(CF(-90, 0, 70), { RGB(40, 90, 160), M.Metal })
	T.rowboat(CF(-90, -2.6, 100) * CFrame.Angles(0, rad(20), 0), RGB(240, 240, 236))
	T.rowboat(CF(-68, -2.6, 104) * CFrame.Angles(0, rad(-30), 0), RGB(70, 130, 190))
	T.Kit.boat(CF(-80, -3.4, 116) * CFrame.Angles(0, rad(80), 0))
	T.streetLight(CF(-96, 0, 83))
	T.streetLight(CF(-62, 0, 83))

	------------------------------------------------------------------
	-- ESPIGÓN (mitad oeste): barca varada sobre calzos (cobertura alta), cajas, redes, bolardos
	------------------------------------------------------------------
	local boat = CF(-22, 0, 104) * CFrame.Angles(0, rad(8), 0)
	T.cap(G.solid("DryBoat", V(5, 4.6, 13), boat * CF(0, 0.8, 0), "Deck"))
	G.deco("DryBoatStripe", V(5.1, 0.6, 13.1), boat * CF(0, 4.6, 0), "Red")
	for _, z in { -4, 4 } do
		G.deco("BoatChock", V(4, 0.8, 1), boat * CF(0, 0.4, z), "WoodDark")
	end
	T.crateStack(CF(-12, 0, 112) * CFrame.Angles(0, rad(5), 0), "Tower")
	T.crate(CF(-30, 0, 92) * CFrame.Angles(0, rad(25), 0), 4)
	T.barrel(CF(-34, 0, 100), { RGB(40, 90, 160), M.Metal })
	G.deco("Nets", V(5, 0.7, 3), CF(-30, 0.35, 114), { RGB(80, 100, 70), M.Fabric })
	for z = 90, 114, 8 do
		T.bollard(CF(-38.6, 0, z))
		T.tire(CF(-41, -1.2, z) * CFrame.Angles(0, rad(90), 0))
	end
	T.bollard(CF(-20, 0, 116.4))

	------------------------------------------------------------------
	-- Entre la plaza y el puerto
	------------------------------------------------------------------
	T.crateStack(CF(-25, 0, 70) * CFrame.Angles(0, rad(90), 0), "L")
	T.barrel(CF(-36, 0, 56), { RGB(120, 84, 52), M.Wood })
	T.Kit.flowerPot(CF(-31, 0, 40), RGB(230, 60, 90))

	------------------------------------------------------------------
	-- PARTE ALTA: macetas y bancos del mirador, pozo y puesto en la plaza alta, ropa tendida
	------------------------------------------------------------------
	G.box("Bench", V(5, 1.4, 1.6), CF(-52, UP + 0.7, -64.6), "Deck")
	T.Kit.flowerPot(CF(-38, UP, -65), RGB(230, 60, 90))
	T.Kit.flowerPot(CF(-62, UP, -78), RGB(250, 200, 70))
	T.palm(CF(-40, UP, -76), 12)
	-- Pozo (cobertura baja y redonda)
	T.Kit.cylinder("Well", 2.6, 5, CF(-18, UP + 1.3, -100), RGB(186, 174, 152), M.Limestone)
	for _, s in { -1, 1 } do
		G.deco("WellPost", V(0.4, 5, 0.4), CF(-18 + s * 2, UP + 4, -100), "WoodDark")
	end
	G.deco("WellBeam", V(4.6, 0.4, 0.4), CF(-18, UP + 6.4, -100), "WoodDark")
	T.stall(CF(-38, UP, -100) * CFrame.Angles(0, rad(90), 0), RGB(240, 200, 70), 6)
	T.crateStack(CF(-28, UP, -94) * CFrame.Angles(0, rad(30), 0), "L")
	T.planter(CF(-36, UP, -110), 6, 3)
	laundry(T, V(-46.2, UP + 9, -100), V(-46.2, UP + 9, -92))
end

return Props
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">Construction</string>
              <string name="Source"><![CDATA[-- CONSTRUCCIÓN (5v5 · Duelo por equipos · Buscar y destruir): obra en construcción vertical, con
-- la torre de hormigón y la grúa en el centro, el edificio A (lona roja, terraza) y el edificio B
-- (lona azul, sitio interior, estructura roja encima). Reconstruido de la hoja de referencia del
-- mapa: distribución del minimapa, volúmenes y colores de la imagen principal y detalles de los
-- paneles (vista desde A/B, zona central, interior, pasarela superior, variante nocturna).
--
-- Archivos: Lighting (luz y variantes), Geometry (blockout jugable), Props (cobertura y decorado),
-- Dressing (acabados de la Fase 14: suelo por zonas, identidad A/B, fondo industrial).
-- Tamaño jugable: 300 x 260 en cruz; de base a sitio ~7 s corriendo, de base a base ~13 s.
local T = require(script.Parent.Parent.TacKit)
local Lighting = require(script.Lighting)
local Geometry = require(script.Geometry)
local Props = require(script.Props)
local Dressing = require(script.Dressing)

local Map = {
	Id = "Construction",
	Name = "Construcción",
	Icon = "🏗️",
	Description = "Obra vertical · torre central · 5 contra 5",
	Realistic = true, -- (5v5 táctico: sale siempre en la votación con TDM, Dominio o Buscar y destruir)
	Bomb = true, -- tiene sitios A y B
	Palette = "Construction",
	Ambience = "Base",
	Modes = { "TDM", "SND" }, -- (pensado para estos; funciona con todos)
	RecommendedPlayers = 10,
	Bounds = Vector3.new(300, 60, 260),
}

Map.Lighting = Lighting.Default
Map.LightingVariants = Lighting.Variants

local V = Vector3.new
local CF = CFrame.new
local L = 10

function Map.Build()
	local folder = T.begin(Map)
	Geometry.build(T)
	Props.build(T)
	Dressing.build(T) -- (Fase 14: acabados; solo decorado)

	---------------------------------------------------------------------------
	-- Puntos de juego
	---------------------------------------------------------------------------
	-- Bases: el Rojo en -X mirando al centro; el Azul, su reflejo
	local redBase = CFrame.lookAt(V(-131, 0, 0), V(-100, 0, 0))
	T.spawnZone(1, redBase, { Size = Vector2.new(36, 22) })
	T.spawnZone(2, T.mirrorCFrame(redBase), { Size = Vector2.new(36, 22) })
	T.flagBase(1, CF(-143, 0, 0))
	T.flagBase(2, CF(143, 0, 0))
	-- Lonas del equipo en el muro del fondo de cada base
	local teams = require(game:GetService("ReplicatedStorage").Shared.GameConfig).Teams
	for i, x in { -149.4, 149.4 } do
		for _, z in { -18, 18 } do
			local look = { teams[i].Color.Color, Enum.Material.Fabric }
			T.G.deco("TeamBanner", V(0.3, 9, 6), CF(x, 7, z), look).Color = look[1]
		end
	end

	-- Sitios de la bomba (sirven a los dos equipos): A en la plaza, B en el atrio
	T.site(V(0, 0, -88), "A")
	T.site(V(0, 0, 96), "B", { Color = Color3.fromRGB(46, 110, 220) })

	-- Zonas (Dominio: la más cercana a cada base y la del centro; Zona de control: en orden)
	T.zone(V(0, 0, -27), 9, 1)
	T.zone(V(0, 0, 96), 9, 2)
	T.zone(V(-78, 0, -8), 9, 3)
	T.zone(V(0, 0, -88), 9, 4)
	T.zone(V(78, 0, -8), 9, 5)

	-- Nombres de zona (los callouts que se dicen en partida)
	T.callout("TORRE", CF(0, 15, 0), V(34, 32, 34))
	T.callout("SEGUNDA DE LA TORRE", CF(0, 25, 0), V(34, 10, 34))
	T.callout("ESTRUCTURA", CF(0, 5, -54), V(36, 10, 32))
	T.callout("FORJADO", CF(0, 15, -54), V(38, 10, 34))
	T.callout("PASARELA", CF(0, 13, -27), V(8, 6, 22))
	T.callout("PASARELA", CF(0, 13, -86), V(8, 6, 32))
	T.callout("PASARELA B", CF(0, 13, 46), V(8, 6, 60))
	T.callout("PLAZA A", CF(0, 6, -88), V(70, 16, 38))
	T.callout("TERRAZA A", CF(0, 14, -105), V(76, 8, 8))
	T.callout("OFICINAS A", CF(0, 10, -119), V(60, 20, 22))
	T.callout("NAVE B", CF(0, 5, 100), V(72, 10, 48))
	T.callout("ENTREPLANTA B", CF(0, 15, 100), V(72, 10, 48))
	T.callout("PATIO B", CF(0, 8, 57), V(70, 20, 38))
	T.callout("PATIO", CF(0, 8, 0), V(120, 20, 76))
	for _, m in { 1, -1 } do
		local function at(x, y, z)
			return CF(m * x, y, z)
		end
		T.callout("ALMACÉN", at(77.5, 8, 0), V(35, 16, 40))
		T.callout("CONTENEDORES", at(68, 10, -45), V(55, 24, 50))
		T.callout("ANDAMIOS", at(53, 8, -89), V(36, 18, 38))
		T.callout("ACOPIO", at(66, 10, 48), V(60, 24, 56))
		T.callout("MUELLE", at(56, 10, 98), V(40, 24, 44))
		T.callout("PASILLO A", at(26.5, 8, -54), V(17, 18, 32))
	end

	-- Puntos libres (todos contra todos, reapariciones dinámicas): repartidos y a cubierto
	for _, p in {
		V(-120, 0.5, -34), V(-120, 0.5, 34), V(-90, 0.5, -60), V(-82, 0.5, -10), V(-70, 0.5, 26),
		V(-66, 0.5, -36), V(-74, 0.5, 58), V(-55, 0.5, -84), V(-56, 0.5, 110), V(-40, 0.5, 12),
		V(-26, 0.5, -64), V(-24, 0.5, -90), V(-28, 0.5, 112), V(-30, 0.5, 56), V(-6, L + 0.5, -66.5),
		V(-30, L + 0.5, 116), V(-8, L + 0.5, -7),
	} do
		T.ffa(p)
		T.ffa(T.mirrorPoint(p))
	end
	-- Puestos de los bots tiradores (miran hacia donde llega el enemigo)
	for _, spot in {
		{ V(-20, L, -105), V(-20, 4, -75) }, -- terraza A, sobre la plaza
		{ V(-14.5, L, -67.5), V(-30, 4, -30) }, -- forjado de la ESTRUCTURA
		{ V(-14, L, -8), V(-60, 4, -8) }, -- ventanal de la primera de la torre, al patio
		{ V(-30, L, 98), V(-30, 4, 60) }, -- entreplanta B, lado oeste
		{ V(-10, 2 * L, 12), V(-40, 4, 40) }, -- segunda de la torre
		{ V(-100, 0, -33), V(-60, 4, -40) }, -- salida norte de la base
	} do
		T.botSpot(spot[1], spot[2])
		T.botSpot(T.mirrorPoint(spot[1]), T.mirrorPoint(spot[2]))
	end

	-- Muros y techo invisibles del borde
	T.Kit.bounds(Map.Bounds.X, Map.Bounds.Z, Map.Bounds.Y)
	return folder
end

return Map
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="77">
              <Properties>
                <string name="Name">Dressing</string>
                <string name="Source"><![CDATA[-- CONSTRUCCIÓN · acabados (Fase 14, pulido visual sin tocar el juego). Todo es decorado: no choca
-- ni para balas, así que rutas, coberturas, sitios y líneas de tiro son los de siempre.
--
--   * Suelo por zonas: la plaza A con adoquín cálido, el patio central de hormigón gastado, el patio B
--     de hormigón frío, grava en las bases y asfalto en los dos carriles. El mapa deja de ser una
--     losa gris y cada zona se reconoce por el suelo.
--   * Torre (hito central): lonas de la promotora en las caras de la planta baja que dan a los
--     sitios, zócalo oscuro y encofrado de madera en los pilares de la última planta (obra en curso).
--   * Identidad A / B: el edificio A con remates terracota (cálido, como su lona roja) y el B con
--     remates azul acero (frío, como su lona azul).
--   * Fondo: ciudad industrial (chimeneas, gasómetros y un esqueleto de edificio con su grúa).
--   * Señalética de salida dentro de cada base (sin flechas: vale igual en el espejo).
local Dressing = {}

local V = Vector3.new
local CF = CFrame.new
local RGB = Color3.fromRGB
local rad = math.rad

local L = 10

function Dressing.build(T)
	local F = T.F

	---------------------------------------------------------------------------
	-- Suelo por zonas (centro del mapa; las bases y carriles van en la mitad en espejo)
	---------------------------------------------------------------------------
	F.groundZone(CF(0, 0, -87), 70, 32, "Pavers", "PlazaPavers")
	F.zoneEdge(CF(0, 0, -87), 70, 32, "ConcreteDark", 0.5)
	F.groundZone(CF(0, 0, 0), 120, 76, "ConcreteWorn", "PatioSlab")
	F.groundZone(CF(0, 0, 57), 70, 38, "ConcreteCool", "PatioBSlab")
	F.zoneEdge(CF(0, 0, 57), 70, 38, "ConcreteDark", 0.5)

	---------------------------------------------------------------------------
	-- TORRE: lonas en las caras que miran a los sitios, zócalo y encofrados arriba
	---------------------------------------------------------------------------
	local yellow, ink = RGB(246, 194, 40), RGB(28, 28, 32)
	-- (dos lonas por cara, a los lados de los pilares de la pasarela, que caen en el centro)
	for _, face in { { -16.3, 0 }, { 16.3, math.pi } } do
		for _, spec in { { -9.6, "ROBUILD" }, { 9.6, "TORRE 05" } } do
			local x = face[2] == 0 and spec[1] or -spec[1]
			F.banner(CF(x, 5, face[1]) * CFrame.Angles(0, face[2], 0), 11, 6, spec[2], yellow, ink, { Stripe = ink, TextScale = 0.5 })
		end
	end
	-- (y en las caras que miran a las bases, junto a la puerta: lo primero que se ve al salir)
	for _, s in { -1, 1 } do
		F.banner(CF(s * 16.3, 5, 5) * CFrame.Angles(0, -s * math.pi / 2, 0), 13, 6, "OBRA 05", yellow, ink, { Stripe = ink, TextScale = 0.5 })
	end
	for _, spec in { { V(-16, 0, -16), V(16, 0, -16), V(0, 0, -1) }, { V(-16, 0, 16), V(16, 0, 16), V(0, 0, 1) } } do
		F.band(spec[1], spec[2], 0, 1.2, 0.3, "ConcreteDark", spec[3], "Plinth")
	end
	for _, p in { V(-15.6, 0, -15.6), V(15.6, 0, -15.6), V(-15.6, 0, 15.6), V(15.6, 0, 15.6) } do
		F.formwork(CF(p + V(0, 4 * L + 1, 0)), 2.6, 4.5)
	end

	---------------------------------------------------------------------------
	-- EDIFICIO A (fachada a la plaza en z -108): cornisa y esquinas terracota, zócalo oscuro
	---------------------------------------------------------------------------
	local facadeA, outA = -107.95, V(0, 0, 1)
	F.band(V(-30.4, 0, facadeA), V(30.4, 0, facadeA), 26.4, 1.1, 0.7, "Terracotta", outA, "Cornice")
	F.pilasters(V(-30, 0, facadeA), V(30, 0, facadeA), 60, 0, 27.5, 1.6, 0.6, "Terracotta", outA, nil, "CornerPier")
	for _, seg in { { -29.2, -15.6 }, { -8.4, 8.4 }, { 15.6, 29.2 } } do
		F.band(V(seg[1], 0, facadeA), V(seg[2], 0, facadeA), 0, 1.3, 0.3, "ConcreteDark", outA, "Plinth")
	end

	---------------------------------------------------------------------------
	-- EDIFICIO B (fachada al patio B en z 76): remate azul acero en el borde de la cubierta y
	-- esquinas, zócalo oscuro (sin tapar el portón ni las ventanas)
	---------------------------------------------------------------------------
	local facadeB, outB = 75.95, V(0, 0, -1)
	F.band(V(-36.4, 0, facadeB), V(36.4, 0, facadeB), 21.9, 1.1, 0.7, "SteelBlue", outB, "Cornice")
	F.pilasters(V(-36, 0, facadeB), V(36, 0, facadeB), 72, 0, 23, 1.6, 0.6, "SteelBlue", outB, nil, "CornerPier")
	for _, seg in { { -35.2, -27.4 }, { -20.6, -7.6 }, { 7.6, 20.6 }, { 27.4, 35.2 } } do
		F.band(V(seg[1], 0, facadeB), V(seg[2], 0, facadeB), 0, 1.3, 0.3, "ConcreteDark", outB, "Plinth")
	end

	---------------------------------------------------------------------------
	-- Mitad en espejo: bases (grava y carteles de salida) y carriles de asfalto
	---------------------------------------------------------------------------
	T.mirrored("ConstructionDressing", function()
		F.groundZone(CF(-131, 0, 0), 38, 100, "Gravel", "BaseGravel")
		F.groundZone(CF(-86, 0, -33), 52, 10, "Asphalt", "LaneAsphalt")
		F.groundZone(CF(-86, 0, 31), 52, 10, "Asphalt", "LaneAsphalt")
		-- Carteles en la cara interior de las mamparas de la base (los ven los que salen; nombran el
		-- sitio, no la dirección, así que valen igual en la base reflejada)
		T.sign(CF(-118.6, 6, -24) * CFrame.Angles(0, math.pi / 2, 0), "SALIDA NORTE · A", 9, 1.6, RGB(196, 46, 38), RGB(255, 255, 255), { PPS = 20 })
		T.sign(CF(-118.6, 6, 24) * CFrame.Angles(0, math.pi / 2, 0), "SALIDA SUR · B", 9, 1.6, RGB(40, 92, 190), RGB(255, 255, 255), { PPS = 20 })
	end)

	---------------------------------------------------------------------------
	-- Fondo industrial: chimeneas, gasómetros y un esqueleto de edificio bajo la grúa del sureste
	---------------------------------------------------------------------------
	for _, spec in { { V(318, 0, 120), 82, 9 }, { V(-330, 0, -140), 92, 10 }, { V(140, 0, 330), 74, 8 } } do
		local stack = T.chimney(CF(spec[1]), spec[2], spec[3])
		stack.CastShadow = false
	end
	F.gasHolder(CF(-300, 0, 210), 40, 34, "Steel")
	F.gasHolder(CF(336, 0, -80), 34, 30, { RGB(150, 112, 96), Enum.Material.Metal })
	F.skeleton(CF(196, 0, -284) * CFrame.Angles(0, rad(40), 0), 30, 24, 6, 8, "Concrete")
end

return Dressing
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="78">
              <Properties>
                <string name="Name">Geometry</string>
                <string name="Source"><![CDATA[-- CONSTRUCCIÓN · geometría jugable (blockout): suelos, edificios, escaleras, pasarelas y bordes.
-- Plano (X = de base a base, el Rojo en -X; Z = de sitio a sitio, A en -Z):
--
--   z -130 ┌──────── EDIFICIO A (terraza en la 1ª planta, lona A) ────────┐
--          │ ANDAMIOS │            PLAZA A  (sitio A)             │ ANDAMIOS│
--   z  -70 │──────────┴─────── ESTRUCTURA (forjado en la 1ª) ──────┴─────────│
--          │ CONTENEDORES           │                    │      CONTENEDORES │
--   BASE ──┤ ALMACÉN ─── PATIO ── TORRE (3 alturas + grúa) ── PATIO ─── ALMACÉN ├── BASE
--   ROJA   │ ACOPIO                 │                    │            ACOPIO │  AZUL
--   z   76 │──────── MUELLE ───┬──────── PATIO B ────────┬───── MUELLE ──────│
--          │                   │  EDIFICIO B (sitio B dentro, entreplanta)  │
--   z  130 └────────────────────────────────────────────────────────────────┘
--
-- Alturas: suelo (0), primera (10: torre, ESTRUCTURA, terraza A, entreplanta B y las pasarelas
-- que las unen) y la segunda de la torre (20, posición alta expuesta). Simétrico en X = 0.
local Geometry = {}

local V = Vector3.new
local CF = CFrame.new

local L = 10 -- altura de planta

function Geometry.build(T)
	local G = T.G
	local door, window = G.door, G.window

	---------------------------------------------------------------------------
	-- Suelo
	---------------------------------------------------------------------------
	T.terrain(Enum.Material.Concrete, 1100, 1100, CF(0, -0.3, 0))
	G.floor(CF(0, 0, 0), 300, 260, "Ground", 1)

	---------------------------------------------------------------------------
	-- TORRE central (32 x 32): planta baja de paso (puertas este/oeste), primera con las pasarelas
	-- norte y sur, segunda abierta con barandillas y el remate de hormigón con la grúa encima.
	-- El hueco del ascensor (8 x 8) corta las líneas de tiro de lado a lado.
	---------------------------------------------------------------------------
	local tower = CF(0, 0, 0)
	G.solid("TowerShaft", V(8, 31, 8), tower, "ConcreteDark")
	-- Planta baja: muros con puertas al este y al oeste
	G.shell(tower, 32, 32, L, "Concrete", {
		Left = { door(-9) },
		Right = { door(-9) },
	}, { Frame = "ConcreteDark" })
	-- Primera: puertas a las pasarelas (norte y sur) y ventanales sobre el patio (este y oeste)
	G.shell(tower * CF(0, L, 0), 32, 32, L, "Concrete", {
		Front = { door(0, 6, 8) },
		Back = { door(0, 6, 8) },
		Left = { window(-7, 3, 6, 4), window(7, 3, 6, 4) },
		Right = { window(-7, 3, 6, 4), window(7, 3, 6, 4) },
	}, { Frame = "ConcreteDark" })
	-- Forjados: primera (hueco sobre las escaleras de subida), segunda (huecos de las de arriba) y
	-- cubierta
	G.slab(tower * CF(0, L, 0), 30, 30, "Slab", {
		{ -13, -1, 4, 10 }, { 13, -1, 4, 10 },
	})
	G.slab(tower * CF(0, 2 * L, 0), 32, 32, "Slab", {
		{ -5.2, -12, 8.4, 4.2 }, { 5.2, -12, 8.4, 4.2 },
	})
	T.cap(G.floor(tower * CF(0, 3 * L + 1, 0), 34, 34, "Concrete", 1))
	-- Escaleras: de la baja a la primera por los laterales; de la primera a la segunda, dos tramos
	-- por el lado norte que suben hacia el centro
	for _, s in { -1, 1 } do
		G.stairs(V(s * 13, 0, 10), V(s * 13, L, -6), 4, "Concrete", { Rails = s < 0 and "Right" or "Left" })
		G.stairs(V(s * 15, L, -12), V(s * 1.2, 2 * L, -12), 4, "Concrete", {})
	end
	-- Segunda: abierta, pilares en las esquinas y en el centro de cada cara y barandilla
	for _, p in { V(-15.2, 0, -15.2), V(15.2, 0, -15.2), V(-15.2, 0, 15.2), V(15.2, 0, 15.2), V(0, 0, 15.2), V(-15.2, 0, 0), V(15.2, 0, 0) } do
		G.column(tower * CF(p + V(0, 2 * L, 0)), L + 1, 1.6, "Concrete")
	end
	G.column(tower * CF(-6, 2 * L, -15.2), L + 1, 1.6, "Concrete")
	G.column(tower * CF(6, 2 * L, -15.2), L + 1, 1.6, "Concrete")
	local y2 = 2 * L
	G.railing(V(-15.6, y2, -15.6), V(15.6, y2, -15.6))
	G.railing(V(-15.6, y2, 15.6), V(15.6, y2, 15.6))
	G.railing(V(-15.6, y2, -15.6), V(-15.6, y2, 15.6))
	G.railing(V(15.6, y2, -15.6), V(15.6, y2, 15.6))
	-- Obra vista: pilares en las esquinas, cantos de forjado y dos plantas más sin terminar encima
	-- (pilares, forjado y barandilla, decorado) para la silueta alta de la referencia
	for _, p in { V(-15.6, 0, -15.6), V(15.6, 0, -15.6), V(-15.6, 0, 15.6), V(15.6, 0, 15.6) } do
		G.box("TowerPier", V(2.4, 3 * L + 1, 2.4), CF(p + V(0, (3 * L + 1) / 2, 0)), "Concrete")
		for _, y in { 3 * L + 1, 4 * L + 1 } do
			G.deco("UpperColumn", V(1.6, L, 1.6), CF(p + V(0, y + L / 2, 0)), "Concrete")
		end
	end
	-- (Fase 3: canto de cada forjado en amarillo de seguridad: la torre, hito central, se lee por
	-- plantas desde cualquier punto del mapa)
	-- (solo el perímetro: cuatro franjas por fuera de los muros, nada coplanar con los suelos)
	local function slabEdge(y, thickness)
		for _, spec in { { V(33.4, thickness, 1), V(0, 0, -16.2) }, { V(33.4, thickness, 1), V(0, 0, 16.2) }, { V(1, thickness, 31.4), V(-16.2, 0, 0) }, { V(1, thickness, 31.4), V(16.2, 0, 0) } } do
			G.deco("SlabEdge", spec[1], CF(V(0, y, 0) + spec[2]), "YellowPaint").CastShadow = false
		end
	end
	for _, y in { L, 2 * L } do
		slabEdge(y - 0.45, 0.9)
	end
	G.deco("UpperSlab", V(33, 0.8, 33), CF(0, 4 * L + 0.6, 0), "Slab")
	G.deco("UpperSlab", V(20, 0.8, 33), CF(-6.5, 5 * L + 0.6, 0), "Slab")
	slabEdge(4 * L + 0.6, 0.9)
	-- Red de seguridad roja en las dos plantas sin terminar (decorado, por encima de las alturas de
	-- juego): la silueta de la torre se reconoce como obra de lejos
	for _, face in { { V(0, 0, -16.2), 0 }, { V(0, 0, 16.2), 0 }, { V(-16.2, 0, 0), math.pi / 2 }, { V(16.2, 0, 0), math.pi / 2 } } do
		local net = G.deco("SafetyNet", V(30, L - 2, 0.15), CF(V(0, 3 * L + 1 + (L - 2) / 2 + 1, 0) + face[1]) * CFrame.Angles(0, face[2], 0), "SafetyNet")
		net.CastShadow = false
	end
	for _, y in { 4 * L + 1, 5 * L + 1 } do
		G.deco("UpperRail", V(33, 0.3, 0.3), CF(0, y + 3, -16.4), "Yellow")
		G.deco("UpperRail", V(33, 0.3, 0.3), CF(0, y + 3, 16.4), "Yellow")
	end
	T.hoist(CF(-19, 0, 8), 4 * L + 4)
	-- Barandillas de los huecos de la primera (para no caer por el hueco de la escalera)
	for _, s in { -1, 1 } do
		G.railing(V(s * 11, L, -6), V(s * 11, L, 4))
		G.railing(V(s * 1.2, 2 * L, -10), V(s * 9.4, 2 * L, -10))
	end

	---------------------------------------------------------------------------
	-- ESTRUCTURA (36 x 32, entre la torre y la plaza A): obra de hormigón sin terminar. Abajo,
	-- paso con pilares y núcleo de escalera macizo; arriba, el forjado que une las pasarelas.
	---------------------------------------------------------------------------
	local est = CF(0, 0, -54)
	T.cap(G.solid("EstCore", V(6, 18, 10), est * CF(0, 0, -7), "ConcreteDark"))
	G.shell(est, 36, 32, L - 1, "Concrete", {
		Front = { door(-9, 6, 8), door(9, 6, 8) }, -- (cara sur, a la plaza)
		Back = { door(-9, 6, 8), door(9, 6, 8) }, -- (cara norte, al patio)
		Left = { door(-8, 6, 8) },
		Right = { door(-8, 6, 8) },
	}, { Frame = "ConcreteDark" })
	G.slab(est * CF(0, L, 0), 36, 32, "Slab", {
		{ -15, 2, 4.2, 12 }, { 15, 2, 4.2, 12 },
	})
	for _, s in { -1, 1 } do
		G.stairs(V(s * 15, 0, -42), V(s * 15, L, -58), 4, "Concrete", { Rails = s < 0 and "Right" or "Left" })
	end
	-- Pilares que siguen hacia arriba (obra a medias) y barandilla del forjado
	for _, x in { -17.4, -6, 6, 17.4 } do
		for _, z in { -69.4, -54, -38.6 } do
			T.cap(G.column(CF(x, L, z), 8, 1.4, "Concrete"))
			for i = 0, 2 do
				G.deco("Rebar", V(0.18, 2.4, 0.18), CF(x - 0.4 + i * 0.4, L + 9.1, z), { Color3.fromRGB(120, 66, 42), Enum.Material.CorrodedMetal })
			end
		end
	end
	for _, s in { -1, 1 } do
		G.railing(V(s * 18, L, -38.4), V(s * 3.2, L, -38.4))
		G.railing(V(s * 18, L, -69.6), V(s * 3.2, L, -69.6))
		G.railing(V(s * 17.6, L, -69.6), V(s * 17.6, L, -38.4))
		-- (borde del hueco de la escalera)
		G.railing(V(s * 12.8, L, -46), V(s * 12.8, L, -58))
		G.railing(V(s * 12.8, L, -45.8), V(s * 17.4, L, -45.8))
	end

	---------------------------------------------------------------------------
	-- Pasarelas de la primera: torre ↔ ESTRUCTURA ↔ terraza A y torre ↔ edificio B
	---------------------------------------------------------------------------
	G.walkway(V(0, L, -16), V(0, L, -38), 6, { Supports = 11 })
	G.walkway(V(0, L, -70), V(0, L, -102), 6, { Supports = 11 })
	G.walkway(V(0, L, 16), V(0, L, 76), 6, { Supports = 15 })

	---------------------------------------------------------------------------
	-- EDIFICIO A (60 x 22, al fondo de la plaza): oficinas abajo, primera con puertas a la terraza
	-- y una planta más (cerrada) arriba. Terraza de 6 de fondo a lo largo de la fachada.
	---------------------------------------------------------------------------
	local a = CF(0, 0, -119) * CFrame.Angles(0, math.pi, 0) -- (la "cara" mira a la plaza, +Z)
	G.shell(a, 60, 22, L, "ConcreteWarm", {
		Front = { door(-12), door(12), window(-22, 3.5, 4, 3.5), window(22, 3.5, 4, 3.5) },
	}, { Frame = "ConcreteDark" })
	G.shell(a * CF(0, L, 0), 60, 22, L, "ConcreteWarm", {
		Front = { door(-12, 6, 8), door(12, 6, 8), window(-22, 3, 4, 4), window(22, 3, 4, 4) },
	}, { Frame = "ConcreteDark" })
	G.shell(a * CF(0, 2 * L, 0), 60, 22, 7, "ConcreteWarm", {
		Front = { window(-22, 2, 4, 3), window(-12, 2, 4, 3), window(12, 2, 4, 3), window(22, 2, 4, 3) },
	}, { Frame = "ConcreteDark" })
	G.slab(CF(0, L, -119), 58, 20, "Slab", { { -25, 5, 4.4, 10 }, { 25, 5, 4.4, 10 } })
	G.floor(CF(0, 2 * L, -119), 58, 20, "Slab")
	T.cap(G.floor(CF(0, 2 * L + 7.5, -119), 61, 23, "ConcreteDark", 1))
	for _, s in { -1, 1 } do
		-- (sube hacia la fachada; arriba se sale de lado a la primera)
		G.stairs(V(s * 25, 0, -125), V(s * 25, L, -110), 4, "Concrete", { Rails = s > 0 and "Right" or "Left" })
		G.railing(V(s * 22.8, L, -119), V(s * 22.8, L, -111.2))
	end
	-- Terraza (primera) delante de la fachada, más ancha que el edificio: llegan las escaleras de
	-- los lados y la pasarela de la ESTRUCTURA
	G.floor(CF(0, L, -105), 72, 6, "Slab", 0.8)
	for _, s in { -1, 1 } do
		G.railing(V(s * 36, L, -101.8), V(s * 3.2, L, -101.8))
		G.deco("TerraceBeam", V(1, 1, 6), CF(s * 34, L - 1.3, -105), "ConcreteDark")
		G.column(CF(s * 34, 0, -102.6), L - 0.8, 1.2, "ConcreteDark", "TerraceColumn")
	end

	---------------------------------------------------------------------------
	-- EDIFICIO B (72 x 48): sitio B dentro, en un atrio de dos alturas; entreplanta en U alrededor
	-- (lados y fondo) y pasillo delantero donde llega la pasarela de la torre.
	---------------------------------------------------------------------------
	local b = CF(0, 0, 100)
	G.shell(b, 72, 48, L, "Concrete", {
		Front = { door(0, 14, 8), window(-24, 3.5, 6, 3.5), window(24, 3.5, 6, 3.5) },
		Back = { window(-20, 4, 6, 3), window(20, 4, 6, 3) },
		Left = { door(16) },
		Right = { door(16) },
	}, { Frame = "ConcreteDark" })
	G.shell(b * CF(0, L, 0), 72, 48, 12, "Concrete", {
		Front = { door(0, 6, 8), window(-12, 3, 5, 4), window(12, 3, 5, 4), window(-27, 3, 5, 4), window(27, 3, 5, 4) },
		Back = { window(-20, 3, 6, 4), window(0, 3, 6, 4), window(20, 3, 6, 4) },
		Left = { door(4, 6, 8), window(-12, 3, 4, 4) },
		Right = { door(4, 6, 8), window(-12, 3, 4, 4) },
	}, { Frame = "ConcreteDark" })
	-- Entreplanta (primera): lados, fondo y pasillo delantero; el atrio queda abierto
	for _, s in { -1, 1 } do
		G.floor(CF(s * 29.5, L, 100), 11, 46, "Slab")
		G.railing(V(s * 24, L, 81), V(s * 24, L, 108))
		G.stairs(V(s * 18, 0, 91), V(s * 18, L, 107.6), 5, "Concrete", { Rails = "Both" })
		G.railing(V(s * 20.7, L, 108), V(s * 24, L, 108))
	end
	G.railing(V(-24, L, 81), V(24, L, 81))
	G.railing(V(-15.3, L, 108), V(15.3, L, 108)) -- (entre las dos escaleras)
	G.floor(CF(0, L, 116), 48, 16, "Slab")
	G.floor(CF(0, L, 79), 48, 4, "Slab")
	-- Cubierta con lucernario sobre el atrio
	T.cap(G.slab(CF(0, 2 * L + 2, 100), 72, 48, "ConcreteDark", { { 0, -4, 40, 22 } }))
	for i = -2, 2 do
		local pane = G.deco("Skylight", V(7.6, 0.3, 21.6), CF(i * 8, 2 * L + 1.7, 96), "Glass")
		pane.Transparency = 0.55
		G.deco("SkylightBar", V(0.4, 0.5, 22), CF(i * 8 + 4, 2 * L + 1.8, 96), "SteelDark")
	end
	-- Pilares del atrio
	for _, x in { -12, 12 } do
		for _, z in { 88, 112 } do
			G.column(CF(x, 0, z), L, 1.4, "ConcreteDark")
			-- (franja de peligro en la base del pilar: se ven al entrar y cortan el gris de la nave)
			G.deco("HazardStripe", V(1.6, 1.4, 1.6), CF(x, 0.9, z), "YellowPaint").CastShadow = false
		end
	end
	-- Interior de la nave B: calle de carretillas pintada alrededor del atrio y una "B" grande en el
	-- muro del fondo (se sabe dónde se está sin mirar el minimapa)
	G.paintLine(V(-22, 0, 83), V(22, 0, 83), 0.5)
	G.paintLine(V(-22, 0, 83), V(-22, 0, 106), 0.5)
	G.paintLine(V(22, 0, 83), V(22, 0, 106), 0.5)
	local hallB = T.sign(CF(0, 6, 123.3), "B", 6, 6, Color3.fromRGB(40, 92, 190), Color3.fromRGB(255, 255, 255), { PPS = 20, Back = true })
	hallB.CastShadow = false

	---------------------------------------------------------------------------
	-- Una mitad (la del Rojo) que se copia en espejo para el Azul
	---------------------------------------------------------------------------
	T.mirrored("ConstructionHalf", function()
		Geometry.half(T)
	end)
end

-- Mitad del Rojo (X < 0): base, almacén, carriles, andamios, muelle y bordes
function Geometry.half(T)
	local G = T.G
	local door = G.door
	-- (vallas, tapias y bloques del borde no se pisan: se tapan por arriba)
	local function hoarding(a, b, h)
		return T.cap(G.hoarding(a, b, h))
	end

	------------------------------------------------------------------
	-- BASE: recinto de obra con casetas; tres salidas (norte, centro en zigzag y sur)
	------------------------------------------------------------------
	hoarding(V(-150, 0, -50), V(-150, 0, 50), 14)
	hoarding(V(-150, 0, -50), V(-95, 0, -50), 12)
	hoarding(V(-150, 0, 50), V(-95, 0, 50), 12)
	-- Frente de la base (x = -112): huecos en z ±(26..40) y en el centro (z ±4)
	hoarding(V(-112, 0, -26), V(-112, 0, -4), 10)
	hoarding(V(-112, 0, 4), V(-112, 0, 26), 10)
	hoarding(V(-112, 0, -50), V(-112, 0, -40), 10)
	hoarding(V(-112, 0, 40), V(-112, 0, 50), 10)
	-- Mamparas dentro de la base: las salidas laterales quedan en L y desde fuera no se ve el
	-- suelo de la base en diagonal (pasillo de 6 entre mampara y frente)
	hoarding(V(-118, 0, -32), V(-118, 0, -15), 10)
	hoarding(V(-118, 0, 15), V(-118, 0, 32), 10)

	------------------------------------------------------------------
	-- ALMACÉN (35 x 40): nave de paso entre la base y el patio, sin subir al tejado
	------------------------------------------------------------------
	local wh = CF(-77.5, 0, 0)
	G.shell(wh, 35, 40, 15, "Corrugated", {
		Front = { door(7.5) }, -- (cara norte, al carril A: X del edificio)
		Back = { door(-6.5) }, -- (cara sur, al acopio)
		Left = { door(-10), door(10) }, -- (oeste, a la base)
		Right = { door(8, 8, 9), door(-16) }, -- (este, al patio)
	}, { Frame = "Concrete" })
	T.cap(G.floor(wh * CF(0, 15.8, 0), 36, 41, "Hoarding", 0.8))
	G.deco("RoofEdge", V(36.2, 0.6, 41.2), wh * CF(0, 15.1, 0), "SteelDark")

	------------------------------------------------------------------
	-- Bordes de los carriles y de las plazas
	------------------------------------------------------------------
	-- Pared oeste de la plaza A (con la entrada principal en z -100..-88) y cierre norte
	T.cap(G.wall(CF(-35, 0, -104) * CFrame.Angles(0, -math.pi / 2, 0), 8, 8, "Concrete"))
	T.cap(G.wall(CF(-35, 0, -79) * CFrame.Angles(0, -math.pi / 2, 0), 18, 8, "Concrete"))
	T.cap(G.wall(CF(-26.5, 0, -70), 17, 8, "Concrete"))
	-- Túnel de andamios (ANDAMIOS): de los contenedores a la entrada de la plaza A
	hoarding(V(-70, 0, -70), V(-62, 0, -70), 10)
	T.cap(G.box("TunnelRoof", V(15, 0.6, 28), CF(-55, 8.3, -86), "Plywood"))
	for _, z in { -72, -79, -86, -93, -100 } do
		for _, x in { -62.2, -47.8 } do
			G.column(CF(x, 0, z), 8, 0.5, "Yellow", "TunnelPole")
		end
		G.deco("TunnelBeam", V(15, 0.5, 0.5), CF(-55, 7.8, z), "Yellow")
	end
	-- Escalera de la plaza A a la terraza (sube hacia el este pegada al edificio A)
	G.stairs(V(-52, 0, -105), V(-36, L, -105), 5, "Concrete", { Rails = "Right" })
	-- Pared entre el acopio y el patio B (con un paso en z 50..58)
	hoarding(V(-35, 0, 38), V(-35, 0, 50), 8)
	hoarding(V(-35, 0, 58), V(-35, 0, 76), 8)

	------------------------------------------------------------------
	-- MUELLE (lado oeste del edificio B): escalera exterior a la entreplanta
	------------------------------------------------------------------
	G.stairs(V(-39, 0, 84), V(-39, L, 100), 5, "Concrete", { Rails = "Right" })
	G.floor(CF(-39, L, 104.5), 5, 9, "Slab", 0.8)
	G.railing(V(-41.3, L, 100), V(-41.3, L, 109))
	G.railing(V(-41.3, L, 109), V(-36.4, L, 109))
	G.beam(V(-41, 0, 108.6), V(-41, L - 0.8, 108.6), 0.7, 0.7, "SteelDark")
	hoarding(V(-75, 0, 120), V(-36, 0, 120), 10)

	------------------------------------------------------------------
	-- Edificios del borde (macizos): cierran el mapa en forma de cruz
	------------------------------------------------------------------
	-- Bloques de borde: tramos de ~26 con alturas y colores distintos (manzana de ciudad)
	local looks = { "BuildingSand", "BuildingGray", "BuildingRose", "ConcreteWarm", "BuildingBrick" }
	local count = 0
	local function filler(x0, x1, z0, z1, h)
		local alongX = (x1 - x0) >= (z1 - z0)
		local length = alongX and (x1 - x0) or (z1 - z0)
		local pieces = math.max(1, math.floor(length / 26 + 0.5))
		for k = 0, pieces - 1 do
			count += 1
			local a0 = (alongX and x0 or z0) + k * length / pieces
			local a1 = a0 + length / pieces
			local cx = alongX and (a0 + a1) / 2 or (x0 + x1) / 2
			local cz = alongX and (z0 + z1) / 2 or (a0 + a1) / 2
			local sx = alongX and (a1 - a0) or (x1 - x0)
			local sz = alongX and (z1 - z0) or (a1 - a0)
			local height = h + ((count * 7) % 5 - 2) * 2.5
			T.cap(T.facadeBlock(CF(cx, 0, cz), sx, sz, height, looks[(count % #looks) + 1], { Lit = T.isNight(), Roof = count % 2 == 0 }))
		end
	end
	filler(-162, -150.3, -50, 50, 24)
	filler(-150.3, -95, -140, -50.3, 22)
	filler(-150.3, -95, 50.3, 140, 26)
	filler(-95, -70, -140, -70, 18)
	filler(-70, -30, -140, -108.5, 14)
	filler(-95, -75, 76, 140, 20)
	filler(-75, -36, 120.3, 140, 12)
	filler(-36, 0, 124.5, 140, 13)
	filler(-30, 0, -140, -130.2, 17)
end

return Geometry
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="79">
              <Properties>
                <string name="Name">Lighting</string>
                <string name="Source"><![CDATA[-- CONSTRUCCIÓN · luz. Por defecto, atardecer como la referencia (sol bajo naranja, cielo malva y
-- neblina cálida que difumina el horizonte de la ciudad). Variantes: mediodía y noche (ventanas de
-- la ciudad encendidas, focos de obra). Bloom muy moderado: los enemigos tienen que destacar.
local RGB = Color3.fromRGB
local V = Vector3.new

local Lighting = {}

Lighting.Default = {
	ClockTime = 17.55,
	Latitude = 22,
	Brightness = 2.6,
	Exposure = 0.05,
	-- (Fase 3: interiores de la nave y el almacén menos oscuros y neblina algo más ligera: el horizonte
	-- sigue cálido pero un enemigo al otro lado del mapa no se pierde en la bruma)
	Ambient = RGB(112, 98, 106),
	OutdoorAmbient = RGB(158, 136, 146),
	ShadowSoftness = 0.1,
	Atmosphere = { Density = 0.25, Offset = 0.08, Color = RGB(236, 180, 164), Decay = RGB(128, 96, 140), Glare = 0.45, Haze = 1 },
	Color = { Saturation = 0.1, Contrast = 0.12, Brightness = 0.01, Tint = RGB(255, 238, 226) },
	Bloom = { Intensity = 0.4, Size = 22, Threshold = 2 },
	Clouds = 0.28,
	CloudColor = RGB(255, 196, 176),
	SunRays = 0.1,
	Wind = V(5, 0, 2),
	TerrainColors = { Ground = RGB(128, 112, 92), Rock = RGB(112, 100, 108), Pavement = RGB(150, 146, 140) },
}

Lighting.Variants = {
	{
		Name = "Mediodía",
		Chance = 0.3,
		ClockTime = 13.2,
		Brightness = 3,
		Exposure = -0.05,
		Ambient = RGB(92, 92, 100),
		OutdoorAmbient = RGB(146, 146, 156),
		Atmosphere = { Density = 0.26, Offset = 0.1, Color = RGB(206, 214, 226), Decay = RGB(120, 132, 150), Glare = 0.2, Haze = 1.1 },
		Color = { Saturation = 0.1, Contrast = 0.12, Brightness = 0, Tint = RGB(255, 250, 244) },
		CloudColor = RGB(255, 255, 255),
		Clouds = 0.4,
		SunRays = 0.05,
	},
	{
		-- Noche: luz de luna fría y focos de obra cálidos (las ventanas de la ciudad, encendidas)
		Name = "Noche",
		Chance = 0.25,
		ClockTime = 21.2,
		Brightness = 1.2,
		Exposure = 0.35,
		Ambient = RGB(66, 70, 96),
		OutdoorAmbient = RGB(84, 92, 128),
		Atmosphere = { Density = 0.26, Offset = 0.06, Color = RGB(64, 72, 110), Decay = RGB(30, 30, 58), Glare = 0, Haze = 1 },
		Color = { Saturation = 0.04, Contrast = 0.14, Brightness = 0.03, Tint = RGB(214, 222, 255) },
		Bloom = { Intensity = 0.5, Size = 24, Threshold = 1.5 },
		Clouds = 0.3,
		CloudColor = RGB(70, 74, 100),
		SunRays = 0,
	},
}

return Lighting
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="80">
              <Properties>
                <string name="Name">Props</string>
                <string name="Source"><![CDATA[-- CONSTRUCCIÓN · props: coberturas con propósito (cada una corta una línea de tiro, protege una
-- salida o da dónde plantar) y decorado que da escala e identidad (grúa, estructuras rojas,
-- contenedores, palés de bloques, focos de obra). Lo que afecta al juego va en la mitad en espejo;
-- lo puramente decorativo puede ser asimétrico.
local Props = {}

local V = Vector3.new
local CF = CFrame.new
local RGB = Color3.fromRGB
local rad = math.rad
local M = Enum.Material

local L = 10
local ALONG_Z = CFrame.Angles(0, math.pi / 2, 0) -- (contenedores y casetas a lo largo de Z)

function Props.build(T)
	local G = T.G
	local night = T.isNight()

	---------------------------------------------------------------------------
	-- Cobertura en el eje (sirve igual a los dos equipos)
	---------------------------------------------------------------------------
	-- Plaza A: palé entre las dos salidas de la ESTRUCTURA y cajas detrás del sitio
	T.blockPallet(CF(0, 0, -77), 3)
	T.crateStack(CF(0, 0, -100) * CFrame.Angles(0, rad(180), 0), "L")
	-- Atrio B: fila de cajas que corta la vista desde el portón y cajas altas al fondo
	T.crateStack(CF(0, 0, 84), "Wall")
	T.crateStack(CF(0, 0, 106), "Tower")
	-- Entre la torre y la ESTRUCTURA: hormigonera (cobertura en el centro del paso)
	T.cementMixer(CF(0, 0, -30) * CFrame.Angles(0, rad(90), 0))
	-- Patio B, bajo la pasarela: tubos de hormigón
	T.pipeStack(CF(0, 0, 46) * ALONG_Z, 8)
	-- Tejado del ascensor: nada; segunda de la torre: palés como cobertura alta-baja
	T.blockPallet(CF(-8, 2 * L, 8), 2)
	T.blockPallet(CF(8, 2 * L, 8), 2)

	T.mirrored("ConstructionProps", function()
		Props.half(T)
	end)

	---------------------------------------------------------------------------
	-- Hitos: grúa torre sobre la torre, estructuras de acero rojo y lonas A / B
	---------------------------------------------------------------------------
	T.towerCrane(CF(0, 3 * L + 1, 0) * CFrame.Angles(0, rad(-30), 0), 50, { Jib = 60, Counter = 20, Drop = 38 })
	-- Remate de la torre: barandilla amarilla en la cubierta y foco de obra
	for _, p in { { V(-17, 31, -17), V(17, 31, -17) }, { V(-17, 31, 17), V(17, 31, 17) }, { V(-17, 31, -17), V(-17, 31, 17) }, { V(17, 31, -17), V(17, 31, 17) } } do
		G.railing(p[1], p[2], "Yellow", 2.6, { NoToe = true })
	end
	-- Estructura de acero roja sobre el edificio A (a un lado, como en la referencia)
	G.steelFrame(CF(-16, 2 * L + 8, -119), 3, 2, 8, 2, 7, "RedSteel", { Deco = true })
	for _, z in { -127, -111 } do
		G.railing(V(-28, 2 * L + 15, z), V(-4, 2 * L + 15, z), "Yellow", 2.6, { NoToe = true })
	end
	G.floor(CF(-16, 2 * L + 15, -119), 24, 16, "Plywood", 0.4).CanCollide = false
	-- Estructura roja más alta sobre el edificio B
	G.steelFrame(CF(18, 2 * L + 2, 100), 3, 3, 9, 2, 8, "RedSteel", { Deco = true })
	for _, lv in { 8, 16 } do
		G.railing(V(4.5, 2 * L + 2 + lv, 86.5), V(31.5, 2 * L + 2 + lv, 86.5), "Yellow", 2.6, { NoToe = true })
	end
	G.floor(CF(18, 2 * L + 10, 100), 27, 27, "Plywood", 0.4).CanCollide = false
	-- Lonas de los sitios en las fachadas (A roja, B azul) y letras grandes en las estructuras
	T.letterBanner(CF(0, 15, -107.3) * CFrame.Angles(0, math.pi, 0), "A", "Red", 9, 9)
	T.letterBanner(CF(-16, 2 * L + 14, -110.4) * CFrame.Angles(0, math.pi, 0), "A", "Red", 8, 9)
	T.letterBanner(CF(19.7, 16, 75.4), "B", "Blue", 8, 10)
	T.letterBanner(CF(18, 2 * L + 13, 85.9), "B", "Blue", 9, 10)
	-- Rótulos de la obra (la constructora y el número de licencia, sin marcas reales)
	T.sign(CF(0, 2 * L + 4, -107.3) * CFrame.Angles(0, math.pi, 0), "ROBUILD · OBRA 05", 14, 2.2, RGB(240, 186, 30), RGB(30, 30, 34), { PPS = 18 })
	T.sign(CF(0, 2 * L + 0.6, 75.4), "NUEVAS OFICINAS · 2027", 18, 2.4, RGB(36, 44, 60), RGB(244, 190, 40), { PPS = 18 })

	-- Azoteas: máquinas, depósitos, barandilla amarilla y un contenedor rojo en la nave B
	for _, x in { -22, 22 } do
		T.hvac(CF(x, 2 * L + 8, -124))
		T.hvac(CF(x * 0.5, 2 * L + 2, 118) * CFrame.Angles(0, rad(90), 0))
	end
	T.waterTank(CF(10, 2 * L + 8, -122))
	G.railing(V(-30, 2 * L + 8, -108.5), V(30, 2 * L + 8, -108.5), "Yellow", 2.6, { NoToe = true })
	local roofBox = T.container(CF(-20, 2 * L + 2, 116), "ContainerRed")
	for _, part in roofBox:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
		end
	end
	T.hvac(CF(-78, 15.8, -8) * CFrame.Angles(0, rad(90), 0))
	T.hvac(CF(78, 15.8, 8) * CFrame.Angles(0, rad(90), 0))

	---------------------------------------------------------------------------
	-- Luz: focos de obra en patios y sitios, tubos fríos en el atrio B y cálidos en el A
	---------------------------------------------------------------------------
	T.floodTower(CF(-26, 0, -60) * CFrame.Angles(0, rad(150), 0), 16)
	T.floodTower(CF(26, 0, 60) * CFrame.Angles(0, rad(-30), 0), 16)
	for _, x in { -14, 14 } do
		local tube = G.deco("CeilingTube", V(0.5, 0.25, 10), CF(x, L - 0.4, -119), { RGB(255, 226, 180), M.Neon })
		T.Kit.light(tube, "PointLight", RGB(255, 214, 160), 16, 0.9)
	end
	for _, x in { -16, 0, 16 } do
		local tube = G.deco("AtriumTube", V(0.5, 0.25, 12), CF(x, 2 * L + 1.4, 112), { RGB(214, 236, 255), M.Neon })
		T.Kit.light(tube, "PointLight", RGB(200, 226, 255), 22, 1.1)
	end
	for _, z in { -8, 8 } do
		local tube = G.deco("TowerTube", V(10, 0.25, 0.5), CF(0, L - 0.4, z * 1.4), { RGB(255, 226, 180), M.Neon })
		T.Kit.light(tube, "PointLight", RGB(255, 214, 160), 14, 0.8)
	end

	---------------------------------------------------------------------------
	-- Suelo: rutas pintadas (amarillo, como el minimapa de la referencia) y franjas de peligro
	---------------------------------------------------------------------------
	for _, seg in {
		{ V(-110, 0, -33), V(-60, 0, -33) }, { V(-60, 0, -33), V(-55, 0, -70) },
		{ V(110, 0, -33), V(60, 0, -33) }, { V(60, 0, -33), V(55, 0, -70) },
		{ V(-110, 0, 33), V(-60, 0, 30) }, { V(110, 0, 33), V(60, 0, 30) },
		{ V(-60, 0, 30), V(-56, 0, 76) }, { V(60, 0, 30), V(56, 0, 76) },
		{ V(-45, 0, -12), V(45, 0, -12) }, { V(-24, 0, -20), V(-24, 0, 36) }, { V(24, 0, -20), V(24, 0, 36) },
	} do
		G.paintLine(seg[1] + V(0, 0, 0), seg[2], 0.6)
	end
	G.hazardStripes(CF(0, 0, 76.5), 14, 1.2)

	---------------------------------------------------------------------------
	-- Fondo: ciudad (bloques sin interior), sierra y otra grúa lejos
	---------------------------------------------------------------------------
	-- (Fase 14: ciudad industrial: hormigón, gris azulado y ladrillo, menos rosas pastel)
	local palette = { RGB(178, 176, 170), RGB(146, 152, 160), RGB(160, 112, 92), RGB(198, 188, 172), RGB(122, 128, 136) }
	-- (tres anillos: la manzana de alrededor baja, la ciudad media y unas pocas torres lejos)
	T.skylineRing(V(0, 0, 0), 205, 0, 355, 10, palette, { Lit = night, MinH = 16, VarH = 18, TowerEvery = 100, FloorH = 6 })
	T.skylineRing(V(0, 0, 0), 270, 4, 356, 12, palette, { Lit = night, MinH = 26, VarH = 34, TowerEvery = 5, TowerExtra = 40, FloorH = 8 })
	T.skylineRing(V(0, 0, 0), 380, 8, 352, 16, palette, { Lit = night, MinH = 40, VarH = 50, TowerEvery = 3, TowerExtra = 80, FloorH = 12 })
	-- Sierra lejana (la neblina la vuelve malva al atardecer)
	for _, spec in { { V(-520, -70, -380), 170 }, { V(120, -80, -640), 200 }, { V(640, -70, 120), 180 }, { V(-580, -80, 300), 190 }, { V(260, -60, 620), 160 } } do
		T.Kit.naturalHill(spec[1], spec[2], M.Rock)
	end
	T.towerCrane(CF(230, 0, -260) * CFrame.Angles(0, rad(40), 0), 90, { Jib = 60, Load = false, Brand = "ROBUILD" })
	T.towerCrane(CF(-280, 0, 220) * CFrame.Angles(0, rad(200), 0), 80, { Jib = 50, Load = false, Brand = "ROBUILD" })
end

-- Mitad del Rojo (X < 0): se copia en espejo para el Azul
function Props.half(T)
	local G = T.G

	------------------------------------------------------------------
	-- BASE: escudo de contenedores delante de la salida central, casetas y focos
	------------------------------------------------------------------
	T.container(CF(-103, 0, 0) * ALONG_Z, "ContainerGray", "ROBUILD · 05")
	T.cap(T.container(CF(-103, 8.8, 0.6) * CFrame.Angles(0, math.pi / 2 + rad(3), 0), "ContainerRed"))
	T.portacabin(CF(-136, 0, -40) * CFrame.Angles(0, math.pi, 0), nil, { Sign = "OFICINA DE OBRA" })
	T.cap(T.portacabin(CF(-136, 9.3, -40.4) * CFrame.Angles(0, math.pi + rad(1.5), 0), nil, {}))
	T.cap(T.portacabin(CF(-136, 0, 40), nil, { Sign = "VESTUARIOS" }))
	T.workLight(CF(-146, 0, -24) * CFrame.Angles(0, rad(-110), 0))
	T.workLight(CF(-146, 0, 24) * CFrame.Angles(0, rad(-70), 0))
	T.cones(V(-109, 0, -38), V(-109, 0, -28), 3)
	T.cones(V(-109, 0, 28), V(-109, 0, 38), 3)

	------------------------------------------------------------------
	-- CONTENEDORES (carril A): muro de contenedores que tapa la salida norte de la base, uno
	-- tumbado en medio (dos caminos) y otro que separa el carril del paso a la ESTRUCTURA
	------------------------------------------------------------------
	T.container(CF(-88, 0, -40) * ALONG_Z, "ContainerRed")
	T.cap(T.container(CF(-88, 8.8, -41) * CFrame.Angles(0, math.pi / 2 - rad(2), 0), "ContainerGray"))
	T.container(CF(-70, 0, -57), "ContainerRed")
	T.container(CF(-44, 0, -58) * ALONG_Z, "ContainerTan")
	T.crateStack(CF(-78, 0, -28) * CFrame.Angles(0, rad(8), 0), "L")
	T.crateStack(CF(-58, 0, -30) * CFrame.Angles(0, rad(90), 0), "Wall")
	T.blockPallet(CF(-76, 0, -66), 3)
	T.blockPallet(CF(-71.4, 0, -66), 2)
	T.barrel(CF(-92, 0, -66))
	T.barrel(CF(-90, 0, -67.5), { RGB(200, 60, 40), M.Metal })
	T.skip(CF(-62, 0, -44) * CFrame.Angles(0, rad(90), 0))
	T.sackPallet(CF(-80, 0, -24))
	T.cableSpool(CF(-92, 0, -24) * CFrame.Angles(0, rad(20), 0))
	-- Suelo del carril: asfalto de acceso con rodadas y manchas
	G.deco("AccessRoad", V(30, 0.05, 12), CF(-80, 0.03, -63), "Asphalt").CastShadow = false
	T.Kit.tireMarks(CF(-94, 0, -62) * CFrame.Angles(0, rad(-90), 0), 26, 0.2)
	T.Kit.oilStain(V(-74, 0, -45), 3)

	------------------------------------------------------------------
	-- ALMACÉN (fuera): chapa ondulada sobre zócalo de hormigón, portón con cajón de persiana y
	-- franjas de peligro, rótulo y apliques sobre las puertas
	------------------------------------------------------------------
	local function ribbedFace(a, b, outward, openings)
		local length = (b - a).Magnitude
		local dir = (b - a).Unit
		G.deco("Plinth", V(0.3, 2.4, length), CFrame.lookAt((a + b) / 2, b) * CF(0, 1.2, 0) + outward * 0.15, "ConcreteDark").CastShadow = false
		for d = 1.2, length - 1.2, 2.4 do
			local blocked = false
			for _, o in openings do
				if d > o[1] - 0.5 and d < o[2] + 0.5 then
					blocked = true
				end
			end
			if not blocked then
				local p = a + dir * d + outward * 0.2
				G.deco("WallRib", V(0.35, 12.6, 0.35), CF(p + V(0, 2.4 + 6.3, 0)), "SteelDark").CastShadow = false
			end
		end
	end
	ribbedFace(V(-95, 0, -20), V(-60, 0, -20), V(0, 0, -1), { { 22, 28 } })
	ribbedFace(V(-95, 0, 20), V(-60, 0, 20), V(0, 0, 1), { { 8, 14 } })
	ribbedFace(V(-95, 0, -20), V(-95, 0, 20), V(-1, 0, 0), { { 7, 13 }, { 27, 33 } })
	ribbedFace(V(-60, 0, -20), V(-60, 0, 20), V(1, 0, 0), { { 1, 7 }, { 24, 32 } })
	-- Portón (lado del patio): cajón de la persiana, persiana a medio subir y franjas en las jambas
	G.deco("ShutterBox", V(1.4, 1.6, 9.4), CF(-59.4, 9.8, 8), "SteelDark")
	G.deco("Shutter", V(0.25, 1.4, 8), CF(-59.6, 8.3, 8), "Corrugated")
	for _, z in { 3.6, 12.4 } do
		for k = 0, 3 do
			G.deco("JambStripe", V(0.5, 1, 0.9), CF(-59.6, 0.5 + k * 2, z), k % 2 == 0 and "YellowPaint" or "Black").CastShadow = false
		end
	end
	T.sign(CF(-59.6, 12.2, 8) * CFrame.Angles(0, -math.pi / 2, 0), "ALMACÉN · NAVE 2", 10, 1.6, RGB(36, 44, 60), RGB(244, 190, 40), { PPS = 18 })
	T.wallLamp(CF(-59.5, 7.6, -16) * CFrame.Angles(0, -math.pi / 2, 0))
	T.wallLamp(CF(-70, 8.6, -20.5))
	T.wallLamp(CF(-95.5, 8.6, 10) * CFrame.Angles(0, math.pi / 2, 0))
	T.wallLamp(CF(-95.5, 8.6, -10) * CFrame.Angles(0, math.pi / 2, 0))

	------------------------------------------------------------------
	-- ALMACÉN (dentro): cajas y palés que rompen la vista de puerta a puerta, carretilla y luz
	------------------------------------------------------------------
	T.crateStack(CF(-86, 0, -2), "Tower")
	T.crateStack(CF(-72, 0, -6) * CFrame.Angles(0, rad(90), 0), "L")
	T.blockPallet(CF(-80, 0, 12), 3)
	T.blockPallet(CF(-75.6, 0, 12), 2)
	T.Kit.forklift(CF(-68, 0, 14) * CFrame.Angles(0, rad(200), 0))
	G.scaffold(CF(-88, 0, -17), 8, 4, 2, 5, {})
	for _, z in { -10, 10 } do
		local tube = G.deco("WarehouseTube", V(12, 0.25, 0.5), CF(-77.5, 14.4, z), { RGB(255, 230, 190), M.Neon })
		T.Kit.light(tube, "PointLight", RGB(255, 220, 170), 18, 0.9)
	end

	------------------------------------------------------------------
	-- PATIO central: barrera junto al portón del almacén, palés y cajas (cobertura de paso)
	------------------------------------------------------------------
	T.jersey(CF(-46, 0, 2), 8)
	T.blockPallet(CF(-30, 0, -24), 3)
	T.blockPallet(CF(-25.6, 0, -24.4), 2)
	T.crateStack(CF(-32, 0, 14) * CFrame.Angles(0, rad(-10), 0), "L")
	T.rebarBundle(CF(-48, 0, 26) * CFrame.Angles(0, rad(80), 0), 10)
	T.cementMixer(CF(-52, 0, -24) * CFrame.Angles(0, rad(30), 0))
	T.cones(V(-20, 0, -18), V(-20, 0, -14), 2)
	T.sackPallet(CF(-38, 0, -30) * CFrame.Angles(0, rad(15), 0))
	T.cableSpool(CF(-24, 0, 24) * CFrame.Angles(0, rad(70), 0), 3.4)
	T.Kit.floorJoints(CF(-38, 0, 0), 44, 76, 8, RGB(132, 128, 120))
	T.Kit.crack(V(-36, 0, -6), 9, 4)
	T.Kit.oilStain(V(-50, 0, 12), 2.6)

	------------------------------------------------------------------
	-- PASILLO A y ESTRUCTURA: palés abajo, cajas y palés arriba (cobertura en la primera)
	------------------------------------------------------------------
	T.blockPallet(CF(-26, 0, -52), 3)
	T.crateStack(CF(-8, 0, -50) * CFrame.Angles(0, rad(90), 0), "L")
	T.blockPallet(CF(-10, L, -46), 2)
	T.crateStack(CF(-11, L, -62) * CFrame.Angles(0, rad(90), 0), "Wall")
	T.blockPallet(CF(-14, L, -40.5), 2)
	for _, z in { -46, -62 } do
		G.column(CF(-6, 0, z), L - 1, 1.4, "Concrete")
	end

	------------------------------------------------------------------
	-- ANDAMIOS: andamio en la fachada del bloque, cajas a la salida del túnel
	------------------------------------------------------------------
	G.scaffold(CF(-67, 0, -86) * ALONG_Z, 28, 4, 3, 5, {})
	T.cap(G.solid("Shed", V(13, 9, 18), CF(-41.5, 0, -79), "Plywood"))
	G.deco("ShedRoof", V(14, 0.5, 19), CF(-41.5, 9.2, -79), "SteelDark")
	T.blockPallet(CF(-66, 0, -104), 3)
	T.crate(CF(-42, 0, -96) * CFrame.Angles(0, rad(15), 0), 4)
	T.workLight(CF(-62, 0, -104) * CFrame.Angles(0, rad(-45), 0))

	------------------------------------------------------------------
	-- PLAZA A: contenedor rojo a cada lado del sitio (tres caminos) y palés junto a las paredes
	------------------------------------------------------------------
	T.container(CF(-16, 0, -86) * ALONG_Z, "ContainerRed")
	T.blockPallet(CF(-28, 0, -78), 3)
	T.crateStack(CF(-29, 0, -97), "Tower")
	T.barrel(CF(-33, 0, -84))
	T.cones(V(-24, 0, -100), V(-20, 0, -100), 2)
	T.Kit.floorJoints(CF(-17.5, 0, -88), 35, 36, 6, RGB(150, 144, 134))
	T.sackPallet(CF(-30, 0, -90) * CFrame.Angles(0, rad(-10), 0))
	T.wallLamp(CF(-12, 7.6, -107.5) * CFrame.Angles(0, math.pi, 0))

	------------------------------------------------------------------
	-- ACOPIO (carril B): palés de bloques en hileras, vigas, tubos, ferralla y silo
	------------------------------------------------------------------
	for i, p in { V(-74, 0, 40), V(-69.4, 0, 40), V(-74, 0, 44.6), V(-78.6, 0, 40) } do
		T.blockPallet(CF(p), i == 1 and 3 or 2)
	end
	T.beamStack(CF(-62, 0, 56) * ALONG_Z, 14)
	T.pipeStack(CF(-84, 0, 60), 8)
	T.rebarBundle(CF(-50, 0, 46), 10)
	T.rebarBundle(CF(-48.6, 0, 46.4), 9)
	T.crateStack(CF(-70, 0, 70) * CFrame.Angles(0, rad(-5), 0), "L")
	T.blockPallet(CF(-46, 0, 66), 3)
	T.skip(CF(-86, 0, 44))
	T.sackPallet(CF(-56, 0, 32))
	T.sackPallet(CF(-51.4, 0, 32.4) * CFrame.Angles(0, rad(8), 0))
	T.cableSpool(CF(-66, 0, 38))
	-- Suelo de tierra del acopio (el material se descarga aquí)
	G.deco("DirtPatch", V(40, 0.06, 34), CF(-72, 0.03, 56), "Dirt").CastShadow = false
	T.Kit.tireMarks(CF(-92, 0, 50) * CFrame.Angles(0, rad(-80), 0), 30, 0.3)
	-- Silo de cemento (decorado alto en la esquina)
	local siloShape = G.solid("SiloShape", V(7, 24, 7), CF(-90, 0, 70), "Steel")
	T.cap(siloShape)
	siloShape:Destroy()
	T.Kit.cylinder("Silo", 22, 7, CF(-90, 13, 70), RGB(220, 220, 216), M.Metal)
	T.Kit.cylinder("SiloLegs", 2, 7.2, CF(-90, 1, 70), RGB(90, 92, 98), M.Metal, nil, true)
	G.deco("SiloCone", V(4, 2, 4), CF(-90, 1.4, 70), "SteelDark")

	------------------------------------------------------------------
	-- MUELLE (oeste del B): camión de obra aparcado (cobertura alta) y cajas
	------------------------------------------------------------------
	G.solid("TruckBed", V(6, 4, 14), CF(-58, 0, 100), { RGB(220, 160, 30), M.Metal })
	G.solid("TruckCab", V(6, 6, 5), CF(-58, 0, 89.5), { RGB(220, 160, 30), M.Metal })
	G.deco("TruckGlass", V(5, 2, 0.2), CF(-58, 4.6, 86.9), { RGB(50, 64, 76), M.Glass })
	for _, z in { 90, 98, 104 } do
		for _, x in { -61.2, -54.8 } do
			T.Kit.pipe("TruckWheel", 0.9, 2.4, CF(x, 1.2, z), RGB(28, 28, 30), M.SmoothPlastic, true)
		end
	end
	T.crateStack(CF(-48, 0, 112), "L")
	T.blockPallet(CF(-66, 0, 114), 3)

	------------------------------------------------------------------
	-- EDIFICIO B (dentro, mitad oeste): palés bajo la entreplanta, cajas junto al sitio
	------------------------------------------------------------------
	T.crateStack(CF(-10, 0, 98) * CFrame.Angles(0, rad(90), 0), "L")
	T.blockPallet(CF(-29, 0, 92), 3)
	T.blockPallet(CF(-29, 0, 84), 2)
	T.crateStack(CF(-30, 0, 104), "Tower")
	T.blockPallet(CF(-30, L, 92), 2)
	T.crateStack(CF(-12, L, 116), "Wall")

	------------------------------------------------------------------
	-- PATIO B: carretilla y palés
	------------------------------------------------------------------
	T.Kit.forklift(CF(-22, 0, 60) * CFrame.Angles(0, rad(30), 0))
	T.blockPallet(CF(-28, 0, 44), 3)
	T.crateStack(CF(-14, 0, 68) * CFrame.Angles(0, rad(10), 0), "Wall")
	T.Kit.floorJoints(CF(-17.5, 0, 57), 35, 38, 8, RGB(140, 134, 126))
	T.skip(CF(-30, 0, 70) * CFrame.Angles(0, rad(90), 0))
	T.wallLamp(CF(-10, 7.6, 75.5))
end

return Props
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">DesertBase</string>
              <string name="Source"><![CDATA[-- DESERT BASE (5v5 · Duelo por equipos · Buscar y destruir): base militar en el desierto. El sitio
-- A está en el parque de vehículos (marquesina al norte) y el B dentro del almacén (sur). En medio,
-- el patio de armas con el cuartel general (azotea a 9 con antena) y la torre de agua; por los
-- lados, los barracones (norte), las torres de vigilancia y el depósito de combustible (sur).
local T = require(script.Parent.Parent.TacKit)
local Lighting = require(script.Lighting)
local Geometry = require(script.Geometry)
local Props = require(script.Props)

local Map = {
	Id = "DesertBase",
	Name = "Desert Base",
	Icon = "🏜️",
	Description = "Base militar en el desierto · 5 contra 5",
	Realistic = true,
	Bomb = true,
	Palette = "DesertBase",
	Ambience = "Desert",
	Modes = { "TDM", "SND" },
	RecommendedPlayers = 10,
	Bounds = Vector3.new(300, 70, 240),
}

Map.Lighting = Lighting.Default
Map.LightingVariants = Lighting.Variants

local V = Vector3.new
local CF = CFrame.new

function Map.Build()
	local folder = T.begin(Map)
	Geometry.build(T)
	Props.build(T)

	local redBase = CFrame.lookAt(V(-140, 0, 0), V(-100, 0, 0))
	local points = { V(-8, 0, 2), V(-4, 0, -3), V(0, 0, 2), V(4, 0, -3), V(8, 0, 2) }
	T.spawnZone(1, redBase, { Size = Vector2.new(24, 14), Points = points })
	T.spawnZone(2, T.mirrorCFrame(redBase), { Size = Vector2.new(24, 14), Points = points })
	T.flagBase(1, CF(-136, 0, -34))
	T.flagBase(2, CF(136, 0, -34))

	T.site(V(0, 0, -78), "A")
	T.site(V(0, 0, 80), "B", { Color = Color3.fromRGB(46, 110, 220) })

	T.zone(V(0, 0, -25), 8, 1)
	T.zone(V(0, 0, 80), 9, 2)
	T.zone(V(-76, 0, -6), 8, 3)
	T.zone(V(0, 0, -78), 9, 4)
	T.zone(V(76, 0, -6), 8, 5)

	T.callout("PARQUE DE VEHÍCULOS", CF(0, 6, -80), V(76, 12, 44))
	T.callout("ALMACÉN", CF(0, 7, 82), V(76, 14, 52))
	T.callout("CUARTEL", CF(0, 4, 0), V(28, 9, 32))
	T.callout("AZOTEA DEL CUARTEL", CF(0, 12, 0), V(28, 8, 32))
	T.callout("TORRE DE AGUA", CF(0, 4, -44), V(16, 10, 16))
	T.callout("HELIPUERTO", CF(0, 4, 36), V(24, 10, 24))
	for _, m in { -1, 1 } do
		local function at(x, y, z)
			return CF(m * x, y, z)
		end
		T.callout("PATIO", at(60, 4, 4), V(60, 10, 70))
		T.callout("BARRACONES", at(78, 4, -84), V(50, 10, 54))
		T.callout("TORRE", at(54, 14, -44), V(8, 8, 8))
		T.callout("COMBUSTIBLE", at(78, 4, 84), V(50, 10, 60))
		T.callout("CONTROL", at(110, 4, 0), V(20, 10, 90))
	end

	for _, p in {
		V(-136, 0.5, -34), V(-110, 0.5, -60), V(-110, 0.5, 60), V(-80, 0.5, -84), V(-74, 0.5, -70),
		V(-54, 12.5, -44), V(-60, 0.5, 0), V(-40, 0.5, -40), V(-40, 0.5, 40), V(-26, 0.5, -74),
		V(-8, 9.5, -12), V(-24, 0.5, 90), V(-74, 6.5, 70), V(-60, 0.5, 62), V(-20, 0.5, 8),
	} do
		T.ffa(p)
		T.ffa(T.mirrorPoint(p))
	end
	for _, spot in {
		{ V(-54, 12, -44), V(0, 0, -70) }, -- torre, al parque de vehículos
		{ V(-10, 9, 10), V(0, 0, 40) }, -- azotea del cuartel, al helipuerto
		{ V(-74, 6, 70), V(-38, 0, 80) }, -- pasarela del combustible, a la puerta del almacén
		{ V(-60, 0, -4), V(0, 0, 0) }, -- patio, al cuartel
	} do
		T.botSpot(spot[1], spot[2])
		T.botSpot(T.mirrorPoint(spot[1]), T.mirrorPoint(spot[2]))
	end

	T.Kit.bounds(Map.Bounds.X, Map.Bounds.Z, Map.Bounds.Y)
	return folder
end

return Map
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="82">
              <Properties>
                <string name="Name">Geometry</string>
                <string name="Source"><![CDATA[-- DESERT BASE · geometría jugable (blockout). Base militar vallada en el desierto:
--
--   z -116 ═══════════════════════ muro de hormigón (T-wall) ═══════════════════════════════
--          BARRACONES (oeste)  ┌── PARQUE DE VEHÍCULOS (marquesina, sitio A) ──┐  BARRACONES (este)
--   z  -58 torre ▲             └───────────────────────────────────────────────┘          ▲ torre
--  BASE    control ─ HESCO ─ PATIO DE ARMAS ── torre de agua ── HQ (azotea 9, antena) ── ... BASE
--  ROJA    calle interior                         helipuerto                               AZUL
--   z   56 DEPÓSITO DE         ┌──────────────── ALMACÉN (sitio B) ──────────────┐   DEPÓSITO DE
--          COMBUSTIBLE         │                                                 │   COMBUSTIBLE
--   z  116 ═════════════════════════════════════════════════════════════════════════════════
--
-- Simétrico en X = 0. Alturas: suelo 0, azotea del cuartel general 9, plataforma del depósito de
-- combustible 6 y torres de vigilancia 12.
local Geometry = {}

local V = Vector3.new
local CF = CFrame.new

local HQ_TOP = 9
local TOWER = 12
local GANTRY = 6

function Geometry.build(T)
	local G = T.G
	local M = Enum.Material
	local door = G.door

	T.terrain(M.Sand, 1400, 1400, CF(0, 0, 0))
	G.floor(CF(0, 0, 0), 304, 244, "Sand", 1)
	-- Losas: parque de vehículos, patio de armas y almacén
	G.deco("MotorPoolPad", V(80, 0.12, 50), CF(0, 0.06, -80), "Pad").CastShadow = false
	G.deco("ParadePad", V(120, 0.1, 100), CF(0, 0.05, 0), "Asphalt").CastShadow = false
	for _, x in { -40, -20, 20, 40 } do
		G.paintLine(V(x, 0.1, -46), V(x, 0.1, 46), 0.4, "Paint")
	end
	-- Helipuerto (pintado) entre el cuartel y el almacén
	G.deco("Helipad", V(0.1, 22, 22), CF(0, 0.12, 36) * CFrame.Angles(0, 0, math.pi / 2), "Paint").Shape = Enum.PartType.Cylinder
	G.deco("HelipadInner", V(0.1, 20.4, 20.4), CF(0, 0.13, 36) * CFrame.Angles(0, 0, math.pi / 2), "Asphalt").Shape = Enum.PartType.Cylinder
	for _, spec in { { -2.4, 0, 0.8, 8 }, { 2.4, 0, 0.8, 8 }, { 0, 0, 4, 0.8 } } do
		G.deco("HelipadH", V(spec[3], 0.05, spec[4]), CF(spec[1], 0.16, 36 + spec[2]), "Paint").CastShadow = false
	end

	---------------------------------------------------------------------------
	-- CUARTEL GENERAL (HQ): dos salas, puertas desplazadas, azotea a 9 con antena
	---------------------------------------------------------------------------
	G.shell(CF(0, 0, 0), 28, 32, HQ_TOP, "Building", {
		Front = { door(-8, 4, 7), door(8, 4, 7) },
		Back = { door(-8, 4, 7), door(8, 4, 7) },
		Left = { door(-8, 4, 7), door(8, 4, 7) },
		Right = { door(-8, 4, 7), door(8, 4, 7) },
	}, { Frame = "MilGreenDark" })
	G.wall(CF(0, 0, 0), 26.2, HQ_TOP, "Tan", { door(0, 4, 7) })
	-- Consolas (cortan la línea de puerta a puerta en cada sala)
	for _, z in { -8, 8 } do
		G.solid("Console", V(4, 5.4, 7), CF(0, 0, z), "MilGreenDark")
		G.deco("ConsoleScreen", V(4.1, 1.4, 6), CF(0, 4.2, z), { Color3.fromRGB(80, 200, 120), M.Neon }).CastShadow = false
	end
	G.floor(CF(0, HQ_TOP, 0), 28, 32, "Roof", 1)
	G.deco("HQFloor", V(27, 0.1, 31), CF(0, 0.05, 0), "Concrete").CastShadow = false
	-- Pretil de sacos en la azotea (hueco al oeste y al este donde llegan las escaleras)
	T.cap(T.sandbags(V(-13, HQ_TOP, -15), V(13, HQ_TOP, -15), 2.2))
	T.cap(T.sandbags(V(-13, HQ_TOP, 15), V(13, HQ_TOP, 15), 2.2))
	for _, x in { -13, 13 } do
		T.cap(T.sandbags(V(x, HQ_TOP, -14), V(x, HQ_TOP, -4.6), 2.2))
		T.cap(T.sandbags(V(x, HQ_TOP, 0.6), V(x, HQ_TOP, 14), 2.2))
	end
	T.cap(T.radioMast(CF(0, HQ_TOP, 0), 26))
	T.cap(G.solid("RoofHut", V(6, 4.5, 4), CF(0, HQ_TOP, -8), "Building"))
	T.cap(G.solid("RoofHut", V(6, 4.5, 4), CF(0, HQ_TOP, 8), "Building"))

	---------------------------------------------------------------------------
	-- PARQUE DE VEHÍCULOS (A): marquesina sobre pilares
	---------------------------------------------------------------------------
	T.cap(G.box("MotorPoolRoof", V(76, 0.8, 44), CF(0, 10.4, -80), "Roof"))
	G.deco("MotorPoolFascia", V(76.4, 1.4, 0.4), CF(0, 9.6, -57.8), "MilGreenDark")
	for _, x in { -36, -12, 12, 36 } do
		for _, z in { -100, -60 } do
			G.column(CF(x, 0, z), 10, 1.2, "SteelDark")
		end
	end

	---------------------------------------------------------------------------
	-- ALMACÉN (B): nave con portones al norte, puertas laterales y lucernarios
	---------------------------------------------------------------------------
	G.shell(CF(0, 0, 82), 76, 52, 14, "Tan", {
		Front = { door(-20, 8, 9), door(20, 8, 9) },
		Back = {},
		Left = { door(-2, 8, 9) },
		Right = { door(-2, 8, 9) },
	}, { Frame = "MilGreenDark" })
	G.deco("WarehouseFloor", V(75, 0.1, 51), CF(0, 0.05, 82), "Concrete").CastShadow = false
	T.cap(G.slab(CF(0, 14.5, 82), 76, 52, "Roof", { { -18, 0, 10, 34 }, { 18, 0, 10, 34 } }))
	for _, x in { -18, 18 } do
		local sky = G.deco("WarehouseSkylight", V(10, 0.3, 34), CF(x, 14.8, 82), "Glass")
		sky.Transparency = 0.4
		T.cap(sky)
	end

	---------------------------------------------------------------------------
	-- Torre de agua (centro norte): corta la línea entre las dos torres de vigilancia
	---------------------------------------------------------------------------
	-- Búnker de comunicaciones con la torre de agua encima: corta la línea norte del patio y, con el
	-- depósito, la de torre de vigilancia a torre de vigilancia
	T.cap(G.solid("CommsBunker", V(12, 6, 27), CF(0, 0, -41.5), "Concrete"))
	G.deco("BunkerBand", V(12.2, 0.8, 27.2), CF(0, 5, -41.5), "MilGreenDark").CastShadow = false
	G.deco("BunkerDoor", V(4, 4.6, 0.2), CF(0, 2.3, -27.95), "SteelDark")
	T.cap(T.waterTower(CF(0, 6, -44), 8, 9))
	-- Taller del parque de vehículos (fondo de A): de lado a lado no se ve por detrás de A
	T.cap(G.solid("Workshop", V(4, 7.5, 27.4), CF(0, 0, -102.7), "Building"))
	G.deco("WorkshopBand", V(4.2, 0.8, 27.6), CF(0, 6.6, -102.7), "Red").CastShadow = false
	T.cap(G.solid("Generator", V(8, 5.6, 13), CF(0, 0, -62.5), "MilGreen"))
	-- Helicóptero en el helipuerto (corta la línea sur del patio)
	T.cap(T.helicopter(CF(0, 0, 33)))

	-- Muros perimetrales norte y sur
	for _, z in { -117, 117 } do
		T.cap(T.tWall(V(-150, 0, z), V(150, 0, z), 9))
	end

	T.mirrored("DesertHalf", function()
		Geometry.half(T)
	end)
end

-- Mitad del Rojo (X < 0)
function Geometry.half(T)
	local G = T.G

	------------------------------------------------------------------
	-- BASE: caseta cerrada (barracón de entrada) y muro trasero
	------------------------------------------------------------------
	T.spawnHouse({ Back = -150, Front = -122.5, Half = 24, Height = 9, Look = "Building", RoofLook = "Roof", Stripe = "Red" })
	for _, seg in { { -117, -24 }, { 24, 117 } } do
		T.cap(T.tWall(V(-149.4, 0, seg[1]), V(-149.4, 0, seg[2]), 9))
	end

	------------------------------------------------------------------
	-- Escalera a la azotea del cuartel general (por el oeste)
	------------------------------------------------------------------
	G.stairs(V(-30, 0, -2), V(-14, HQ_TOP, -2), 4.4, "Concrete", { Rails = "Both", Cap = true, Closed = true })

	------------------------------------------------------------------
	-- BARRACONES (norte): dos barracones que se cruzan por dentro
	------------------------------------------------------------------
	T.barrack(T, CF(-80, 0, -98), 30, 12)
	T.barrack(T, CF(-74, 0, -70), 30, 12, { Awning = false })

	------------------------------------------------------------------
	-- TORRE DE VIGILANCIA (norte, junto al patio): escalera desde el sur
	------------------------------------------------------------------
	local _, roof, walls = T.watchtower(CF(-54, 0, -44), TOWER, "Back")
	T.cap(roof)
	T.cap(walls)
	G.stairs(V(-54, 0, -24.6), V(-54, TOWER, -40.6), 3.6, "Wood", { Rails = "Both", Cap = true, RailLook = "WoodDark" })

	------------------------------------------------------------------
	-- DEPÓSITO DE COMBUSTIBLE (sur): pasarela de carga a 6 con escalera
	------------------------------------------------------------------
	G.floor(CF(-74, GANTRY, 70), 16, 6, "Deck", 1.4)
	for _, x in { -81.5, -66.5 } do
		for _, z in { 67.5, 72.5 } do
			G.column(CF(x, 0, z), GANTRY - 1.4, 0.6, "SteelDark")
		end
	end
	G.railing(V(-82, GANTRY, 72.8), V(-66, GANTRY, 72.8), "Yellow", 3.2, { Cap = true })
	G.railing(V(-82, GANTRY, 67.2), V(-66, GANTRY, 67.2), "Yellow", 3.2, { Cap = true })
	G.railing(V(-81.8, GANTRY, 67.2), V(-81.8, GANTRY, 72.8), "Yellow", 3.2, { Cap = true })
	G.stairs(V(-56, 0, 69), V(-66, GANTRY, 69), 3.6, "Steel", { Rails = "Both", Cap = true })
end

return Geometry
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="83">
              <Properties>
                <string name="Name">Lighting</string>
                <string name="Source"><![CDATA[-- DESERT BASE · luz. Sol alto y seco (sombras marcadas, cielo pálido con calima); variantes de
-- atardecer anaranjado y de noche (focos del patio encendidos).
local RGB = Color3.fromRGB
local V = Vector3.new

local Lighting = {}

Lighting.Default = {
	ClockTime = 13.4,
	Latitude = 28,
	Brightness = 3.2,
	Exposure = -0.05,
	Ambient = RGB(120, 108, 92),
	OutdoorAmbient = RGB(170, 156, 136),
	ShadowSoftness = 0.12,
	Atmosphere = { Density = 0.34, Offset = 0.15, Color = RGB(232, 214, 184), Decay = RGB(176, 150, 112), Glare = 0.3, Haze = 1.8 },
	Color = { Saturation = 0.06, Contrast = 0.14, Brightness = 0.01, Tint = RGB(255, 246, 232) },
	Bloom = { Intensity = 0.35, Size = 22, Threshold = 2 },
	Clouds = 0.1,
	CloudColor = RGB(255, 248, 236),
	SunRays = 0.08,
	Wind = V(14, 0, 4),
	TerrainColors = { Sand = RGB(214, 188, 140), Sandstone = RGB(176, 128, 92) },
}

Lighting.Variants = {
	{
		Name = "Atardecer",
		Chance = 0.3,
		ClockTime = 17.9,
		Brightness = 2.4,
		Ambient = RGB(124, 92, 80),
		OutdoorAmbient = RGB(180, 128, 106),
		Atmosphere = { Density = 0.36, Offset = 0.1, Color = RGB(250, 172, 120), Decay = RGB(170, 96, 80), Glare = 0.7, Haze = 1.8 },
		Color = { Saturation = 0.14, Contrast = 0.14, Brightness = 0.01, Tint = RGB(255, 226, 200) },
		CloudColor = RGB(255, 180, 130),
		SunRays = 0.14,
	},
	{
		Name = "Noche",
		Chance = 0.25,
		ClockTime = 22,
		Brightness = 1.1,
		Exposure = 0.35,
		Ambient = RGB(72, 74, 96),
		OutdoorAmbient = RGB(88, 92, 120),
		Atmosphere = { Density = 0.3, Offset = 0.06, Color = RGB(64, 70, 100), Decay = RGB(30, 30, 50), Glare = 0, Haze = 1 },
		Color = { Saturation = 0.06, Contrast = 0.14, Brightness = 0.03, Tint = RGB(220, 226, 255) },
		Bloom = { Intensity = 0.6, Size = 24, Threshold = 1.5 },
		Clouds = 0.1,
		CloudColor = RGB(70, 76, 100),
		SunRays = 0,
	},
}

return Lighting
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="84">
              <Properties>
                <string name="Name">Props</string>
                <string name="Source"><![CDATA[-- DESERT BASE · props: camiones y todoterrenos (A), estanterías y carretilla (B), barreras HESCO y
-- sacos terreros (cobertura del patio), depósitos de combustible, control de acceso, palmeras,
-- focos y montañas de arenisca alrededor.
local Props = {}

local V = Vector3.new
local CF = CFrame.new
local RGB = Color3.fromRGB
local rad = math.rad
local M = Enum.Material

local ALONG_X = CFrame.Angles(0, math.pi / 2, 0)

function Props.build(T)
	local G = T.G

	---------------------------------------------------------------------------
	-- Centro: mástil con bandera, letras A y B, contenedor del almacén
	---------------------------------------------------------------------------
	G.box("FlagBase", V(3, 1, 3), CF(0, 0.5, -21), "Concrete")
	G.deco("FlagPole", V(0.4, 18, 0.4), CF(0, 9.5, -21), "Steel")
	G.deco("Flag", V(0.15, 3, 5), CF(0, 16.5, -18.4), "Red").CastShadow = false
	T.letterBanner(CF(0, 8.4, -57.6) * CFrame.Angles(0, math.pi, 0), "A", "Red", 5, 5.4)
	T.letterBanner(CF(0, 9, 55.6), "B", "Blue", 5, 5.4)
	T.cap(T.container(CF(0, 0, 102) * ALONG_X, "ContainerGreen", "ARMORY"))
	T.sign(CF(0, 12, 55.4), "ALMACÉN · DEPOT 7", 22, 2.6, RGB(92, 104, 68), RGB(240, 232, 210), { PPS = 16 })
	T.sign(CF(0, 7.4, -15.6), "MANDO · HQ", 10, 1.6, RGB(92, 104, 68), RGB(240, 232, 210))
	T.sign(CF(0, 7.4, 15.6) * CFrame.Angles(0, math.pi, 0), "MANDO · HQ", 10, 1.6, RGB(92, 104, 68), RGB(240, 232, 210))

	T.mirrored("DesertProps", function()
		Props.half(T)
	end)

	---------------------------------------------------------------------------
	-- Fondo: montañas de arenisca y dunas
	---------------------------------------------------------------------------
	for _, spec in {
		{ V(-120, -40, -330), 120 }, { V(140, -50, -360), 140 }, { V(380, -50, -120), 130 },
		{ V(400, -60, 180), 150 }, { V(80, -50, 360), 130 }, { V(-260, -50, 330), 140 },
		{ V(-420, -60, 60), 150 }, { V(-360, -50, -220), 120 },
	} do
		T.Kit.naturalHill(spec[1], spec[2], M.Sandstone, { Top = M.Sand, TopCount = 3 })
	end
	for _, spec in { { V(-220, -6, -170), 26 }, { V(230, -6, 160), 30 }, { V(200, -6, -190), 24 }, { V(-210, -6, 190), 28 } } do
		workspace.Terrain:FillBall(spec[1], spec[2], M.Sand)
	end
end

-- Mitad del Rojo (X < 0)
function Props.half(T)
	local G = T.G
	local night = T.isNight()

	------------------------------------------------------------------
	-- PARQUE DE VEHÍCULOS (A)
	------------------------------------------------------------------
	T.cap(T.truck(CF(-24, 0, -86)))
	T.cap(T.jeep(CF(-14, 0, -67) * ALONG_X))
	for i, p in { V(-10, 0, -96), V(-12.6, 0, -96.4), V(-11, 0, -93.6) } do
		T.barrel(CF(p) * CFrame.Angles(0, rad(i * 30), 0), "MilGreen")
	end
	T.cap(T.crateStack(CF(-33, 0, -66), "L"))
	T.cap(T.hesco(CF(-24, 0, -54), 2, 3.4))
	T.cap(T.sandbags(V(-8, 0, -104), V(-18, 0, -104), 2.6))

	------------------------------------------------------------------
	-- PATIO DE ARMAS (centro de cada mitad)
	------------------------------------------------------------------
	T.cap(T.hesco(CF(-76, 0, 10) * ALONG_X, 3, 4))
	T.cap(T.hesco(CF(-58, 0, -16), 3, 4))
	T.cap(T.container(CF(-64, 0, 28) * ALONG_X, "ContainerTan", "SUPPLY"))
	T.cap(T.jeep(CF(-92, 0, -8)))
	-- Barreras escalonadas: cada franja del patio queda cortada en algún punto (ver longlines)
	T.cap(T.hesco(CF(-40, 0, 20.4) * ALONG_X, 3, 5.4))
	T.cap(T.hesco(CF(-30, 0, -22.5) * ALONG_X, 3, 5.4))
	T.cap(T.hesco(CF(-34, 0, -72) * ALONG_X, 2, 5.4))
	T.cap(T.tWall(V(-46, 0, 42.5), V(-46, 0, 56), 6))
	T.cap(T.sandbags(V(-50, 0, -50), V(-50, 0, -40), 2.6))
	for _, z in { -22, 22 } do
		T.palm(CF(-20, 0, z), 15)
	end
	T.cap(T.crateStack(CF(-34, 0, -30) * CFrame.Angles(0, rad(10), 0), "Wall"))

	------------------------------------------------------------------
	-- CONTROL DE ACCESO (calle interior) y entrada de la base
	------------------------------------------------------------------
	T.barrierGate(CF(-112, 0, -36), 14)
	T.barrierGate(CF(-112, 0, 36), 14)
	T.cap(G.solid("GuardBooth", V(4, 7, 4), CF(-102, 0, -40), "Building"))
	G.deco("GuardWindow", V(4.1, 1.6, 3), CF(-102, 4.6, -40), { RGB(60, 70, 80), M.Glass }).CastShadow = false
	T.cap(G.solid("GuardBooth", V(4, 7, 4), CF(-102, 0, 40), "Building"))
	G.deco("GuardWindow", V(4.1, 1.6, 3), CF(-102, 4.6, 40), { RGB(60, 70, 80), M.Glass }).CastShadow = false
	G.deco("InnerRoad", V(16, 0.1, 230), CF(-112, 0.05, 0), "Asphalt").CastShadow = false
	for _, z in { -30, 30 } do
		T.palm(CF(-119, 0, z), 14)
	end
	local lamp = G.deco("BaseLight", V(14, 0.3, 1.2), CF(-136, 9.1, 0), { RGB(255, 240, 210), M.Neon })
	T.Kit.light(lamp, "PointLight", RGB(255, 236, 200), 20, 0.8)
	T.cap(T.crateStack(CF(-145, 0, -14), "L"))

	------------------------------------------------------------------
	-- BARRACONES (norte)
	------------------------------------------------------------------
	T.cap(T.truck(CF(-104, 0, -82)))
	T.campNet(CF(-104, 0, -82), 10, 24, 9)
	T.cap(T.crateStack(CF(-62, 0, -88) * CFrame.Angles(0, rad(-12), 0), "Wall"))
	T.cap(T.sandbags(V(-96, 0, -56), V(-86, 0, -56), 2.6))
	T.barrel(CF(-58, 0, -100), "Red")
	T.barrel(CF(-56, 0, -102), "MilGreen")

	------------------------------------------------------------------
	-- DEPÓSITO DE COMBUSTIBLE (sur)
	------------------------------------------------------------------
	T.cap(T.fuelTank(CF(-94, 0, 98), 12, 10))
	T.cap(T.fuelTank(CF(-72, 0, 102), 10, 9))
	T.cap(T.container(CF(-56, 0, 92), "ContainerGreen", "FUEL · 07"))
	T.cap(T.hesco(CF(-94, 0, 84), 3, 3.4))
	T.fuelTruck(CF(-90, 0, 60) * ALONG_X)
	T.cap(T.crateStack(CF(-64, 0, 52), "Wall"))

	------------------------------------------------------------------
	-- ALMACÉN (B, mitad): estanterías, carretilla, palés
	------------------------------------------------------------------
	T.cap(G.solid("Rack", V(3, 8, 10), CF(-30, 0, 80), "MilGreenDark"))
	for _, y in { 2.6, 5.2 } do
		G.deco("RackShelf", V(3.2, 0.2, 10.2), CF(-30, y, 80), "Wood").CastShadow = false
	end
	T.cap(T.crateStack(CF(-20, 0, 66) * CFrame.Angles(0, rad(-8), 0), "L"))
	T.Kit.forklift(CF(-14, 0, 96) * CFrame.Angles(0, math.pi, 0))
	T.cap(G.solid("PalletStack", V(6, 3.4, 6), CF(-12, 0, 74), "Wood"))
	T.cap(G.solid("Rack", V(14, 8, 3), CF(-26, 0, 103), "MilGreenDark"))
	for _, x in { -18 } do
		local panel = G.deco("WarehouseLight", V(10, 0.2, 2), CF(x, 13.6, 70), { RGB(255, 240, 214), M.Neon })
		panel.CastShadow = false
		T.Kit.light(panel, "PointLight", RGB(255, 236, 206), 30, 1)
	end

	------------------------------------------------------------------
	-- Focos (de noche iluminan el patio)
	------------------------------------------------------------------
	for _, p in { V(-100, 0, -48), V(-50, 0, 50), V(-120, 0, 100) } do
		T.floodTower(CF(p), 14, night and RGB(255, 236, 200) or nil)
	end
end

return Props
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">Dockyard</string>
              <string name="Source"><![CDATA[-- DOCKYARD (5v5 · Duelo por equipos · Buscar y destruir): terminal de contenedores. El sitio A
-- está en el muelle, junto al buque y entre las grúas pórtico; el B dentro del tinglado de
-- tránsito, a la altura del andén de carga. En medio, la playa de contenedores: bloques de dos de
-- alto en rojo, azul y amarillo que forman calles (no un laberinto) y la carretilla pórtico en el
-- centro. A los lados, el control del puerto (azotea a 9) y la puerta de camiones.
local T = require(script.Parent.Parent.TacKit)
local Lighting = require(script.Lighting)
local Geometry = require(script.Geometry)
local Props = require(script.Props)

local Map = {
	Id = "Dockyard",
	Name = "Dockyard",
	Icon = "⚓",
	Description = "Muelle, contenedores y tinglado · 5 contra 5",
	Realistic = true,
	Bomb = true,
	Palette = "Dockyard",
	Ambience = "Coast",
	Modes = { "TDM", "SND" },
	RecommendedPlayers = 10,
	Bounds = Vector3.new(300, 70, 244),
}

Map.Lighting = Lighting.Default
Map.LightingVariants = Lighting.Variants

local V = Vector3.new
local CF = CFrame.new

function Map.Build()
	local folder = T.begin(Map)
	Geometry.build(T)
	Props.build(T)

	local redBase = CFrame.lookAt(V(-140, 0, 0), V(-100, 0, 0))
	local points = { V(-8, 0, 2), V(-4, 0, -3), V(0, 0, 2), V(4, 0, -3), V(8, 0, 2) }
	T.spawnZone(1, redBase, { Size = Vector2.new(24, 14), Points = points })
	T.spawnZone(2, T.mirrorCFrame(redBase), { Size = Vector2.new(24, 14), Points = points })
	T.flagBase(1, CF(-136, 0, -34))
	T.flagBase(2, CF(136, 0, -34))

	T.site(V(0, 0, -84), "A")
	T.site(V(0, 4, 84), "B", { Color = Color3.fromRGB(46, 110, 220) })

	T.zone(V(0, 0, -24), 8, 1)
	T.zone(V(0, 4, 84), 9, 2)
	T.zone(V(-86, 0, 18), 8, 3)
	T.zone(V(0, 0, -84), 9, 4)
	T.zone(V(86, 0, 18), 8, 5)

	T.callout("MUELLE", CF(0, 5, -82), V(300, 10, 44))
	T.callout("TINGLADO", CF(0, 10, 85), V(86, 14, 44))
	T.callout("ANDÉN DE CARGA", CF(0, 7, 58), V(88, 6, 8))
	T.callout("CARRETILLA", CF(0, 6, 0), V(14, 12, 22))
	T.callout("PLAYA DE CONTENEDORES", CF(0, 6, -4), V(150, 12, 96))
	for _, m in { -1, 1 } do
		local function at(x, y, z)
			return CF(m * x, y, z)
		end
		T.callout("CONTROL DEL PUERTO", at(92, 5, -74), V(24, 9, 16))
		T.callout("AZOTEA DEL CONTROL", at(92, 12, -74), V(24, 6, 16))
		T.callout("GRÚA", at(30, 6, -90), V(20, 12, 24))
		T.callout("PUERTA DE CAMIONES", at(96, 5, 80), V(46, 10, 60))
		T.callout("CALLE", at(112, 5, 0), V(16, 10, 210))
	end

	for _, p in {
		V(-136, 0.5, -34), V(-110, 0.5, -70), V(-110, 0.5, 70), V(-92, 0.5, -74), V(-92, 9.5, -72),
		V(-60, 0.5, -76), V(-52, 0.5, -20), V(-52, 0.5, 20), V(-30, 0.5, -60), V(-8, 0.5, -40),
		V(-8, 0.5, 30), V(-30, 4.5, 58), V(-24, 4.5, 84), V(-66, 0.5, 96), V(-86, 0.5, 0),
	} do
		T.ffa(p)
		T.ffa(T.mirrorPoint(p))
	end
	for _, spot in {
		{ V(-96, 9, -79), V(-40, 0, -100) }, -- azotea del control, al muelle
		{ V(-36, 4, 57), V(0, 0, 30) }, -- andén de carga, a la playa de contenedores
		{ V(-34, 0, -64), V(0, 0, -84) }, -- borde del muelle, al sitio A
		{ V(-86, 0, 0), V(0, 0, 0) }, -- calle, a la carretilla pórtico
	} do
		T.botSpot(spot[1], spot[2])
		T.botSpot(T.mirrorPoint(spot[1]), T.mirrorPoint(spot[2]))
	end

	T.Kit.bounds(Map.Bounds.X, Map.Bounds.Z, Map.Bounds.Y)
	return folder
end

return Map
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="86">
              <Properties>
                <string name="Name">Geometry</string>
                <string name="Source"><![CDATA[-- DOCKYARD · geometría jugable (blockout). Terminal de contenedores:
--
--   agua      ~~~~~~~~~~~~~~~~~~~~ buque amarrado (decorado) ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
--   z -104 ═══ canto del muelle ════════════════════════════════════════════════════════════
--          CONTROL DEL PUERTO  grúa ║      MUELLE (sitio A)      ║ grúa   CONTROL DEL PUERTO
--   z  -60 (azotea 9)        ┌ bloque N ┐  contenedor   ┌ bloque N ┐         (azotea 9)
--  BASE    calle   ───────── │ (2 alto) │ ─── carretilla pórtico ── │          │ ─────── calle  BASE
--  ROJA    interior          └──────────┘    (centro)               └──────────┘          AZUL
--          PUERTA DE         ┌ bloque S ┐                           ┌ bloque S ┐    PUERTA DE
--   z   54 CAMIONES          └──────────┘  ═══ ANDÉN DE CARGA (4) ═══          CAMIONES
--   z  108                         TINGLADO DE TRÁNSITO (interior a 4, sitio B)
--
-- Simétrico en X = 0. Alturas: suelo 0, andén y tinglado 4, azotea del control del puerto 9.
-- Las pilas de contenedores llevan clip encima (no se sube nadie): son paredes de las calles.
local Geometry = {}

local V = Vector3.new
local CF = CFrame.new

local DOCK = 4
local OFFICE = 9
local QUAY = -104
local ALONG_Z = CFrame.Angles(0, math.pi / 2, 0)

-- Pila de contenedores (layers de alto) con clip encima; cf = centro de la base, a lo largo de X
local function stack(T, cf, layers, looks)
	for layer = 0, layers - 1 do
		local look = looks[(layer % #looks) + 1]
		local c = T.container(cf * CF(0, layer * 8.75, 0), look)
		if layer == layers - 1 then
			T.cap(c)
		end
	end
end
Geometry.stack = stack

function Geometry.build(T)
	local G = T.G
	local M = Enum.Material
	local door = G.door

	-- Suelo (hasta el canto del muelle), agua y muro del muelle
	T.terrain(M.Asphalt, 1400, 1400, CF(0, 0, 400))
	workspace.Terrain:FillBlock(CF(0, -9, QUAY - 300), V(1400, 14, 600), M.Water)
	G.floor(CF(0, 0, (QUAY + 122) / 2), 304, 122 - QUAY, "Asphalt", 1)
	G.box("QuayWall", V(304, 10, 2), CF(0, -5, QUAY - 1), "QuayDark")
	G.deco("QuayApron", V(304, 0.1, 44), CF(0, 0.05, QUAY + 22), "Quay").CastShadow = false
	G.deco("QuayEdge", V(304, 0.6, 1.2), CF(0, 0.3, QUAY + 0.6), "YellowPaint")
	T.boundaryWall(V(-152, 0, QUAY - 0.4), V(152, 0, QUAY - 0.4), 60)
	for x = -140, 140, 20 do
		T.fender(CF(x, -2.4, QUAY - 2.2))
	end
	-- Carriles de las grúas
	for _, z in { -101, -79 } do
		G.paintLine(V(-150, 0.1, z), V(150, 0.1, z), 0.6, "SteelDark")
	end

	---------------------------------------------------------------------------
	-- MUELLE (A): contenedor en carga bajo el centro y grúas pórtico (en cada mitad)
	---------------------------------------------------------------------------
	T.cap(T.container(CF(0, 0, -99), "ContainerYellow"))

	---------------------------------------------------------------------------
	-- PLAYA DE CONTENEDORES (centro): contenedor bajo la carretilla pórtico
	---------------------------------------------------------------------------
	stack(T, CF(0, 0, 0) * ALONG_Z, 2, { "ContainerRed", "ContainerBlue" })
	T.cap(T.straddleCarrier(CF(0, 0, 0)))

	---------------------------------------------------------------------------
	-- TINGLADO DE TRÁNSITO (B): interior a la altura del andén de carga
	---------------------------------------------------------------------------
	G.solid("ShedFloor", V(86, DOCK, 44), CF(0, 0, 85), "Concrete")
	G.solid("LoadingDock", V(88, DOCK, 8), CF(0, 0, 58), "ConcreteDark")
	G.deco("DockEdge", V(88, 0.4, 0.6), CF(0, DOCK + 0.02, 54.3), "YellowPaint").CastShadow = false
	for x = -40, 40, 8 do
		G.deco("DockBumper", V(1.4, 1.6, 0.6), CF(x, DOCK - 1.2, 53.7), { Color3.fromRGB(30, 30, 32), M.SmoothPlastic })
	end
	G.shell(CF(0, 0, 85), 88, 46, 16, "Shed", {
		Front = { door(-20, 8, 8, DOCK), door(20, 8, 8, DOCK) },
		Back = {},
		Left = { door(1, 6, 8, DOCK) },
		Right = { door(1, 6, 8, DOCK) },
	}, { Frame = "SteelDark" })
	T.cap(G.slab(CF(0, 16.5, 85), 88, 46, "Roof", { { -20, 0, 10, 30 }, { 20, 0, 10, 30 } }))
	for _, x in { -20, 20 } do
		local sky = G.deco("ShedSkylight", V(10, 0.3, 30), CF(x, 16.8, 85), "Glass")
		sky.Transparency = 0.4
		T.cap(sky)
		local panel = G.deco("ShedLight", V(10, 0.2, 2), CF(x, 15.7, 72), { Color3.fromRGB(255, 240, 214), M.Neon })
		panel.CastShadow = false
		T.Kit.light(panel, "PointLight", Color3.fromRGB(255, 236, 206), 30, 1)
	end
	G.deco("ShedBand", V(88.4, 1.4, 46.4), CF(0, 13.4, 85), "Blue").CastShadow = false

	T.mirrored("DockHalf", function()
		Geometry.half(T)
	end)
end

-- Mitad del Rojo (X < 0)
function Geometry.half(T)
	local G = T.G
	local door, window = G.door, G.window

	------------------------------------------------------------------
	-- BASE: caseta cerrada y muro trasero
	------------------------------------------------------------------
	T.spawnHouse({ Back = -150, Front = -122.5, Half = 24, Height = 9, Look = "Building", RoofLook = "Roof", Stripe = "Red" })
	for _, seg in { { QUAY, -24 }, { 24, 122 } } do
		T.cap(G.wall(CF(-150.5, 0, (seg[1] + seg[2]) / 2) * CFrame.Angles(0, -math.pi / 2, 0), seg[2] - seg[1], 8, "QuayDark"))
	end

	------------------------------------------------------------------
	-- Grúa pórtico del muelle
	------------------------------------------------------------------
	T.cap(T.stsCrane(CF(-30, 0, -90), { Span = 18, Gauge = 22, Look = "CraneRed" }))

	------------------------------------------------------------------
	-- CONTROL DEL PUERTO: oficina con azotea a 9 (escalera por el este)
	------------------------------------------------------------------
	G.shell(CF(-92, 0, -74), 24, 16, OFFICE, "Building", {
		Front = { window(-6, 3.5, 5, 3), window(6, 3.5, 5, 3) },
		Back = { door(-4, 4, 7) },
		Left = { door(2, 4, 7) },
		Right = { door(-3, 4, 7) },
	}, { Frame = "Blue" })
	G.floor(CF(-92, OFFICE, -74), 24, 16, "Roof", 1)
	G.deco("OfficeFloor", V(23, 0.1, 15), CF(-92, 0.05, -74), "Concrete").CastShadow = false
	-- Pretiles bajos al norte (al muelle), al oeste y al sur (hueco de la escalera); al este, la
	-- caseta de maquinaria con el letrero: desde la azotea no se ve la otra azotea de lado a lado
	T.cap(G.parapet(V(-103.6, OFFICE, -81.6), V(-84, OFFICE, -81.6), 3, "Building", 0.8))
	T.cap(G.parapet(V(-103.6, OFFICE, -81.6), V(-103.6, OFFICE, -66.4), 3, "Building", 0.8))
	T.cap(G.parapet(V(-103.6, OFFICE, -66.4), V(-94.2, OFFICE, -66.4), 3, "Building", 0.8))
	T.cap(G.parapet(V(-89.8, OFFICE, -66.4), V(-84, OFFICE, -66.4), 3, "Building", 0.8))
	T.cap(G.solid("RoofPlant", V(4, 6, 16), CF(-82, OFFICE, -74), "Building"))
	T.sign(CF(-79.9, OFFICE + 3, -74) * CFrame.Angles(0, -math.pi / 2, 0), "PORT CONTROL", 12, 2.2, Color3.fromRGB(40, 96, 190), Color3.new(1, 1, 1))
	G.stairs(V(-92, 0, -54), V(-92, OFFICE, -66.4), 4.2, "Steel", { Rails = "Both", Cap = true, Closed = true })

	------------------------------------------------------------------
	-- PLAYA DE CONTENEDORES: bloques de 2 de alto que forman las calles
	------------------------------------------------------------------
	for _, z in { -48, -40, -32 } do
		for _, x in { -62, -42 } do
			stack(T, CF(x, 0, z), 2, z == -40 and { "ContainerBlue", "ContainerYellow" } or { "ContainerRed", "ContainerGray" })
		end
	end
	for _, z in { 34, 42 } do
		for _, x in { -62, -42 } do
			stack(T, CF(x, 0, z), 2, z == 34 and { "ContainerYellow", "ContainerRed" } or { "ContainerBlue", "ContainerGray" })
		end
	end
	-- Contenedores sueltos (a lo largo de Z) a los lados del centro
	stack(T, CF(-20, 0, -20) * CFrame.Angles(0, math.pi / 2, 0), 1, { "ContainerBlue" })
	stack(T, CF(-20, 0, 20) * CFrame.Angles(0, math.pi / 2, 0), 2, { "ContainerRed", "ContainerYellow" })
	stack(T, CF(-24, 0, -56), 1, { "ContainerGray" })
	stack(T, CF(-50, 0, 50), 1, { "ContainerYellow" })
	stack(T, CF(-14, 0, -70) * CFrame.Angles(0, math.pi / 2, 0), 1, { "ContainerRed" })

	------------------------------------------------------------------
	-- ANDÉN DE CARGA y TINGLADO (mitad): escaleras al andén y a la puerta oeste
	------------------------------------------------------------------
	G.stairs(V(-32, 0, 47), V(-32, DOCK, 54), 5, "ConcreteDark", { Rails = "Both", Cap = true, Closed = true })
	G.stairs(V(-56, 0, 58), V(-44, DOCK, 58), 5, "ConcreteDark", { Rails = "Both", Cap = true, Closed = true })
	G.stairs(V(-56, 0, 86), V(-44, DOCK, 86), 5, "ConcreteDark", { Rails = "Both", Cap = true, Closed = true })
	T.rollerDoor(CF(-20, DOCK + 8, 61.4), 8, 4)
	-- Cierre detrás del tinglado (no hay paso por detrás)
	T.cap(G.wall(CF(-44.5, 0, 115) * CFrame.Angles(0, -math.pi / 2, 0), 14, 8, "QuayDark"))
end

return Geometry
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="87">
              <Properties>
                <string name="Name">Lighting</string>
                <string name="Source"><![CDATA[-- DOCKYARD · luz. Mañana despejada junto al mar (luz fría, algo de bruma sobre el agua);
-- variantes de atardecer y de noche (focos del puerto encendidos).
local RGB = Color3.fromRGB
local V = Vector3.new

local Lighting = {}

Lighting.Default = {
	ClockTime = 10.6,
	Latitude = 42,
	Brightness = 3,
	Exposure = -0.02,
	Ambient = RGB(104, 110, 122),
	OutdoorAmbient = RGB(150, 160, 176),
	ShadowSoftness = 0.15,
	Atmosphere = { Density = 0.33, Offset = 0.12, Color = RGB(200, 216, 232), Decay = RGB(120, 142, 172), Glare = 0.2, Haze = 1.6 },
	Color = { Saturation = 0.1, Contrast = 0.12, Brightness = 0.01, Tint = RGB(246, 250, 255) },
	Bloom = { Intensity = 0.35, Size = 22, Threshold = 2 },
	Clouds = 0.4,
	CloudColor = RGB(250, 252, 255),
	SunRays = 0.06,
	Wind = V(12, 0, 6),
	TerrainColors = { Asphalt = RGB(76, 78, 82), Water = RGB(40, 82, 110) },
}

Lighting.Variants = {
	{
		Name = "Atardecer",
		Chance = 0.3,
		ClockTime = 18,
		Brightness = 2.3,
		Ambient = RGB(118, 94, 96),
		OutdoorAmbient = RGB(172, 132, 124),
		Atmosphere = { Density = 0.34, Offset = 0.08, Color = RGB(248, 180, 140), Decay = RGB(160, 100, 112), Glare = 0.6, Haze = 1.6 },
		Color = { Saturation = 0.14, Contrast = 0.12, Brightness = 0.01, Tint = RGB(255, 230, 212) },
		CloudColor = RGB(255, 186, 150),
		SunRays = 0.12,
	},
	{
		Name = "Noche",
		Chance = 0.25,
		ClockTime = 21.8,
		Brightness = 1.1,
		Exposure = 0.35,
		Ambient = RGB(70, 76, 100),
		OutdoorAmbient = RGB(84, 94, 126),
		Atmosphere = { Density = 0.3, Offset = 0.06, Color = RGB(62, 72, 106), Decay = RGB(26, 30, 54), Glare = 0, Haze = 1 },
		Color = { Saturation = 0.08, Contrast = 0.14, Brightness = 0.03, Tint = RGB(214, 224, 255) },
		Bloom = { Intensity = 0.6, Size = 24, Threshold = 1.5 },
		Clouds = 0.3,
		CloudColor = RGB(70, 78, 106),
		SunRays = 0,
	},
}

return Lighting
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="88">
              <Properties>
                <string name="Name">Props</string>
                <string name="Source"><![CDATA[-- DOCKYARD · props: buque amarrado y grúas lejanas (fondo), bitas y tapas de escotilla en el
-- muelle, camiones con contenedor en la puerta de camiones, interior del tinglado (contenedores
-- frigoríficos, estanterías, palés, carretillas), focos y señalética A/B.
local Props = {}

local V = Vector3.new
local CF = CFrame.new
local RGB = Color3.fromRGB
local rad = math.rad
local M = Enum.Material

local ALONG_Z = CFrame.Angles(0, math.pi / 2, 0)

function Props.build(T)
	local G = T.G

	---------------------------------------------------------------------------
	-- Centro: letras, carteles, buque
	---------------------------------------------------------------------------
	T.letterBanner(CF(0, 9.5, 61.4) * CFrame.Angles(0, math.pi, 0), "B", "Blue", 5, 5.4)
	T.sign(CF(0, 13.5, 61.4) * CFrame.Angles(0, math.pi, 0), "TINGLADO 3 · TRANSIT SHED", 30, 2.6, RGB(40, 96, 190), RGB(255, 255, 255), { PPS = 16 })
	T.cap(G.solid("DockLeveler", V(6, 3, 5), CF(0, 4, 58), "SteelDark"))
	local aSign = T.sign(CF(0, 7, -94.9) * CFrame.Angles(0, math.pi, 0), "A", 3, 3, RGB(200, 54, 42), RGB(255, 255, 255))
	aSign.CastShadow = false
	T.ship(CF(0, -4, -140), 220)
	-- Puerto al fondo: grúas y pilas de contenedores lejanas (decorado)
	for _, x in { -260, -200, 200, 260 } do
		T.stsCrane(CF(x, 0, -150), { Span = 18, Gauge = 22, Look = x < 0 and "CraneBlue" or "CraneRed", Height = 30 })
	end
	local palette = { RGB(150, 156, 164), RGB(120, 132, 150), RGB(184, 186, 190), RGB(100, 110, 128) }
	T.skylineRing(V(0, 0, 60), 260, 30, 330, 14, palette, { Lit = T.isNight(), MinH = 20, VarH = 30, TowerEvery = 5, TowerExtra = 30, FloorH = 6 })

	T.mirrored("DockProps", function()
		Props.half(T)
	end)
end

-- Mitad del Rojo (X < 0)
function Props.half(T)
	local G = T.G
	local night = T.isNight()

	------------------------------------------------------------------
	-- MUELLE (A): bitas, tapas de escotilla, bobinas
	------------------------------------------------------------------
	for x = -140, -10, 20 do
		T.mooringBollard(CF(x, 0, -102.2))
	end
	T.cap(G.solid("HatchCover", V(8, 5.4, 17), CF(-30, 0, -87.5), "Hull"))
	G.deco("HatchStripe", V(8.1, 0.6, 17.1), CF(-30, 4.6, -87.5), "YellowPaint").CastShadow = false
	T.cableSpool(CF(-46, 0, -66))
	T.cap(T.crateStack(CF(-60, 0, -92), "Wall"))
	T.cap(G.solid("LashingCage", V(6, 3.2, 4), CF(-8, 0, -66), "SteelDark"))

	------------------------------------------------------------------
	-- PUERTA DE CAMIONES (suroeste): camiones con contenedor y casetas
	------------------------------------------------------------------
	T.cap(T.containerTruck(CF(-96, 0, 74), "ContainerBlue"))
	T.cap(T.containerTruck(CF(-80, 0, 98) * CFrame.Angles(0, math.pi, 0), "ContainerRed"))
	T.cap(G.solid("GateBooth", V(4, 7, 4), CF(-108, 0, 50), "Building"))
	G.deco("GateBoothWindow", V(4.1, 1.6, 3), CF(-108, 4.6, 50), { RGB(60, 70, 80), M.Glass }).CastShadow = false
	T.barrierGate(CF(-112, 0, 42), 14)
	G.deco("InnerRoad", V(16, 0.1, 210), CF(-112, 0.05, 10), "ConcreteDark").CastShadow = false

	------------------------------------------------------------------
	-- PLAYA DE CONTENEDORES: barreras y bidones en las calles
	------------------------------------------------------------------
	T.jersey(CF(-84, 0, -6) * ALONG_Z, 8)
	T.jersey(CF(-84, 0, 8) * ALONG_Z, 8)
	T.cap(T.crateStack(CF(-30, 0, 4), "L"))
	T.barrel(CF(-74, 0, 18), "Red")
	T.barrel(CF(-72.4, 0, 19.6), "Blue")
	T.cap(T.crateStack(CF(-90, 0, -40) * CFrame.Angles(0, rad(10), 0), "Wall"))

	------------------------------------------------------------------
	-- TINGLADO (B, mitad): contenedor frigorífico, estanterías, palés, carretilla
	------------------------------------------------------------------
	T.cap(T.container(CF(-28, 4, 96), "ContainerYellow", "REEFER"))
	T.cap(G.solid("Rack", V(3, 8, 14), CF(-34, 4, 80), "SteelDark"))
	for _, y in { 2.6, 5.2 } do
		G.deco("RackShelf", V(3.2, 0.2, 14.2), CF(-34, 4 + y, 80), "Wood").CastShadow = false
	end
	T.cap(G.solid("PalletStack", V(6, 3.4, 6), CF(-14, 4, 76), "Wood"))
	T.cap(G.solid("PalletStack", V(5, 4, 6), CF(-36, 4, 90), "Wood"))
	T.cap(T.crateStack(CF(-16, 4, 92), "L"))
	T.Kit.forklift(CF(-22, 4, 70) * CFrame.Angles(0, rad(90), 0))

	------------------------------------------------------------------
	-- Base y focos
	------------------------------------------------------------------
	local lamp = G.deco("BaseLight", V(14, 0.3, 1.2), CF(-136, 9.1, 0), { RGB(255, 240, 210), M.Neon })
	T.Kit.light(lamp, "PointLight", RGB(255, 236, 200), 20, 0.8)
	T.cap(T.crateStack(CF(-145, 0, -14), "L"))
	for _, p in { V(-118, 0, -60), V(-100, 0, 30), V(-60, 0, 58) } do
		T.floodTower(CF(p), 16, night and RGB(255, 236, 200) or nil)
	end
end

return Props
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="89">
            <Properties>
              <string name="Name">IndustrialYard</string>
              <string name="Source"><![CDATA[-- INDUSTRIAL YARD (5v5 · Duelo por equipos · Buscar y destruir): planta industrial al atardecer.
-- El sitio A está en la planta de proceso (norte), entre depósitos y bajo la pasarela; el B dentro
-- de la nave de producción (sur), entre máquinas y con la entreplanta encima. En el centro, la sala
-- de calderas con la chimenea (el hito que se ve desde todo el mapa). A los lados, los montones
-- de grava (norte), la caseta de bombas (centro) y el patio de almacenaje (sur).
local T = require(script.Parent.Parent.TacKit)
local Lighting = require(script.Lighting)
local Geometry = require(script.Geometry)
local Props = require(script.Props)

local Map = {
	Id = "IndustrialYard",
	Name = "Industrial Yard",
	Icon = "🏭",
	Description = "Planta industrial al atardecer · 5 contra 5",
	Realistic = true,
	Bomb = true,
	Palette = "IndustrialYard",
	Ambience = "Factory",
	Modes = { "TDM", "SND" },
	RecommendedPlayers = 10,
	Bounds = Vector3.new(300, 70, 240),
}

Map.Lighting = Lighting.Default
Map.LightingVariants = Lighting.Variants

local V = Vector3.new
local CF = CFrame.new

function Map.Build()
	local folder = T.begin(Map)
	Geometry.build(T)
	Props.build(T)

	local redBase = CFrame.lookAt(V(-140, 0, 0), V(-100, 0, 0))
	local points = { V(-8, 0, 2), V(-4, 0, -3), V(0, 0, 2), V(4, 0, -3), V(8, 0, 2) }
	T.spawnZone(1, redBase, { Size = Vector2.new(24, 14), Points = points })
	T.spawnZone(2, T.mirrorCFrame(redBase), { Size = Vector2.new(24, 14), Points = points })
	T.flagBase(1, CF(-136, 0, -34))
	T.flagBase(2, CF(136, 0, -34))

	T.site(V(0, 0, -82), "A")
	T.site(V(0, 0, 80), "B", { Color = Color3.fromRGB(46, 110, 220) })

	T.zone(V(0, 0, -27), 6, 1)
	T.zone(V(0, 0, 80), 9, 2)
	T.zone(V(-72, 0, 22), 8, 3)
	T.zone(V(0, 0, -82), 9, 4)
	T.zone(V(72, 0, 22), 8, 5)

	T.callout("PLANTA", CF(0, 6, -84), V(100, 12, 52))
	T.callout("PASARELA", CF(0, 11, -106), V(96, 6, 4))
	T.callout("CALDERAS", CF(0, 6, 0), V(24, 12, 24))
	T.callout("NAVE", CF(0, 8, 83), V(90, 16, 52))
	T.callout("ENTREPLANTA", CF(0, 11, 104.5), V(90, 6, 9))
	for _, m in { -1, 1 } do
		local function at(x, y, z)
			return CF(m * x, y, z)
		end
		T.callout("GRAVA", at(84, 5, -80), V(50, 10, 60))
		T.callout("BOMBAS", at(72, 4, 0), V(16, 8, 20))
		T.callout("ALMACENAJE", at(84, 5, 80), V(50, 10, 60))
		T.callout("DEPÓSITOS", at(22, 7, -80), V(14, 14, 44))
		T.callout("CALLE", at(112, 5, 0), V(16, 10, 230))
	end

	for _, p in {
		V(-136, 0.5, -34), V(-110, 0.5, -60), V(-110, 0.5, 60), V(-72, 0.5, -6), V(-30, 8.5, -106),
		V(-50, 0.5, -90), V(-60, 0.5, -30), V(-50, 0.5, 30), V(-14, 0.5, -76), V(-8, 0.5, -30),
		V(-16, 0.5, 26), V(-30, 0.5, 86), V(-24, 8.5, 104), V(-80, 0.5, 86), V(-6, 0.5, -9),
	} do
		T.ffa(p)
		T.ffa(T.mirrorPoint(p))
	end
	for _, spot in {
		{ V(-30, 8, -106), V(0, 0, -82) }, -- pasarela, al sitio A
		{ V(-24, 8, 104), V(0, 0, 80) }, -- entreplanta, al sitio B
		{ V(-60, 0, -30), V(0, 0, -24) }, -- frente a las calderas
		{ V(-86, 0, 18), V(0, 0, 20) }, -- calle central
	} do
		T.botSpot(spot[1], spot[2])
		T.botSpot(T.mirrorPoint(spot[1]), T.mirrorPoint(spot[2]))
	end

	T.Kit.bounds(Map.Bounds.X, Map.Bounds.Z, Map.Bounds.Y)
	return folder
end

return Map
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="90">
              <Properties>
                <string name="Name">Geometry</string>
                <string name="Source"><![CDATA[-- INDUSTRIAL YARD · geometría jugable (blockout). Planta industrial al atardecer:
--
--   z -117 ══════════════════ muro ═══ pasarela de la planta (8) ═══ muro ═══════════════════
--          MONTONES DE GRAVA   depósito  ║  PLANTA DE PROCESO (sitio A)  ║  depósito   GRAVA
--   z  -60 (cinta, pala)       depósito  ║   unidad de refrigeración     ║  depósito
--  BASE    calle   CASETA DE BOMBAS ───── SALA DE CALDERAS (chimenea) ───── CASETA DE BOMBAS  BASE
--  ROJA            (interior)              depósito horizontal                (interior)    AZUL
--   z   56 PATIO DE ALMACENAJE  ┌──────────── NAVE DE PRODUCCIÓN (sitio B) ─────────┐ ALMACENAJE
--   z  110                      └────── entreplanta (8) al fondo ───────────────────┘
--
-- Simétrico en X = 0. Alturas: suelo 0; pasarela de la planta y entreplanta de la nave a 8.
local Geometry = {}

local V = Vector3.new
local CF = CFrame.new

local UP = 8

function Geometry.build(T)
	local G = T.G
	local M = Enum.Material
	local door = G.door

	T.terrain(M.Ground, 1400, 1400, CF(0, 0, 0))
	G.floor(CF(0, 0, 0), 304, 244, "Ground", 1)
	G.deco("PlantPad", V(100, 0.1, 56), CF(0, 0.05, -88), "Concrete").CastShadow = false
	G.deco("CentralRoad", V(220, 0.1, 14), CF(0, 0.05, 20), "Asphalt").CastShadow = false
	G.paintLine(V(-110, 0.12, 20), V(110, 0.12, 20), 0.4, "YellowPaint")
	for _, z in { -117, 117 } do
		T.cap(G.box("PerimeterWall", V(304, 8, 1.2), CF(0, 4, z), "ConcreteDark"))
	end

	---------------------------------------------------------------------------
	-- SALA DE CALDERAS (centro): puertas desplazadas, caldera en medio, chimenea
	---------------------------------------------------------------------------
	G.shell(CF(0, 0, 0), 24, 24, 12, "Brick", {
		Front = { door(-5, 4, 7), door(5, 4, 7) },
		Back = { door(-5, 4, 7), door(5, 4, 7) },
		Left = { door(-5, 4, 7), door(5, 4, 7) },
		Right = { door(-5, 4, 7), door(5, 4, 7) },
	}, { Frame = "SteelDark" })
	G.deco("BoilerFloor", V(23, 0.1, 23), CF(0, 0.05, 0), "Concrete").CastShadow = false
	T.Kit.cylinder("Boiler", 9, 14, CF(0, 4.5, 0), Color3.fromRGB(150, 84, 52), M.CorrodedMetal)
	T.Kit.cylinder("BoilerTop", 1, 10, CF(0, 9.5, 0), Color3.fromRGB(64, 66, 70), M.Metal, nil, true)
	T.cap(G.box("BoilerRoof", V(25, 0.8, 25), CF(0, 12.4, 0), "Roof"))
	T.chimney(CF(0, 12.8, 0), 52, 6)
	for _, s in { -1, 1 } do
		G.deco("BoilerWindow", V(16, 2, 0.2), CF(0, 9.6, s * 12.1), "Glass")
	end
	local lamp = G.deco("BoilerLight", V(8, 0.2, 1), CF(0, 11.6, -8), { Color3.fromRGB(255, 220, 170), M.Neon })
	T.Kit.light(lamp, "PointLight", Color3.fromRGB(255, 214, 160), 22, 0.9)

	---------------------------------------------------------------------------
	-- PLANTA DE PROCESO (A): pasarela a 8 por el norte, unidad de refrigeración al sur
	---------------------------------------------------------------------------
	G.floor(CF(0, UP, -106), 96, 4, "Deck", 0.8)
	for x = -40, 40, 16 do
		G.column(CF(x, 0, -106), UP - 0.8, 0.8, "Steel")
	end
	G.railing(V(-48, UP, -107.8), V(48, UP, -107.8), "Yellow", 3.2, { Cap = true })
	G.railing(V(-43.6, UP, -104.2), V(43.6, UP, -104.2), "Yellow", 3.2, { Cap = true })
	T.cap(G.solid("CoolingUnit", V(10, 7, 14), CF(0, 0, -40), "Steel"))
	for _, s in { -1, 1 } do
		G.deco("CoolingFan", V(0.2, 5, 5), CF(s * 5.05, 3.8, -40), "SteelDark")
	end

	---------------------------------------------------------------------------
	-- Transformador (norte de las calderas) y armario de carga (frente a la nave)
	T.cap(G.solid("Transformer", V(6, 6, 7), CF(0, 0, -16.5), "PipeGreen"))
	G.deco("TransformerFins", V(6.2, 3, 7.2), CF(0, 3.5, -16.5), "SteelDark")
	T.cap(G.solid("ChargingCabinet", V(8, 6, 8), CF(0, 0, 50), "Blue"))
	-- Depósito horizontal (centro sur)
	---------------------------------------------------------------------------
	T.cap(T.horizontalTank(CF(0, 0, 36), 16, 6))

	---------------------------------------------------------------------------
	-- NAVE DE PRODUCCIÓN (B): portones al norte, puertas laterales, entreplanta al fondo
	---------------------------------------------------------------------------
	G.shell(CF(0, 0, 83), 92, 54, 16, "Shed", {
		Front = { door(-22, 8, 9), door(22, 8, 9) },
		Back = {},
		Left = { door(-3, 6, 8) },
		Right = { door(-3, 6, 8) },
	}, { Frame = "Orange" })
	G.deco("HallFloor", V(91, 0.1, 53), CF(0, 0.05, 83), "Concrete").CastShadow = false
	T.cap(G.slab(CF(0, 16.5, 83), 92, 54, "Roof", { { -22, -4, 10, 30 }, { 22, -4, 10, 30 } }))
	for _, x in { -22, 22 } do
		local sky = G.deco("HallSkylight", V(10, 0.3, 30), CF(x, 16.8, 79), "Glass")
		sky.Transparency = 0.4
		T.cap(sky)
		local panel = G.deco("HallLight", V(10, 0.2, 2), CF(x, 15.7, 70), { Color3.fromRGB(255, 236, 206), M.Neon })
		panel.CastShadow = false
		T.Kit.light(panel, "PointLight", Color3.fromRGB(255, 232, 200), 30, 1)
	end
	G.floor(CF(0, UP, 104.5), 90, 9, "Deck", 1)
	G.railing(V(-36, UP, 100.2), V(36, UP, 100.2), "Yellow", 3.2, { Cap = true })
	G.deco("CraneRail", V(90, 0.8, 0.8), CF(0, 14.6, 62), "SteelDark")
	G.deco("CraneRail", V(90, 0.8, 0.8), CF(0, 14.6, 98), "SteelDark")
	G.deco("OverheadCrane", V(1.4, 1.6, 36), CF(-10, 13.8, 80), "Orange")

	T.mirrored("IndustrialHalf", function()
		Geometry.half(T)
	end)
end

-- Mitad del Rojo (X < 0)
function Geometry.half(T)
	local G = T.G
	local door, window = G.door, G.window

	------------------------------------------------------------------
	-- BASE y muro oeste
	------------------------------------------------------------------
	T.spawnHouse({ Back = -150, Front = -122.5, Half = 24, Height = 9, Look = "Building", RoofLook = "Roof", Stripe = "Orange" })
	for _, seg in { { -117, -24 }, { 24, 117 } } do
		T.cap(G.wall(CF(-150.5, 0, (seg[1] + seg[2]) / 2) * CFrame.Angles(0, -math.pi / 2, 0), seg[2] - seg[1], 8, "ConcreteDark"))
	end

	------------------------------------------------------------------
	-- PLANTA (A, mitad): depósitos verticales, rack de tuberías, escalera a la pasarela
	------------------------------------------------------------------
	T.cap(T.fuelTank(CF(-22, 0, -94), 10, 14))
	T.cap(T.fuelTank(CF(-22, 0, -66), 9, 11))
	T.cap(T.pipeRack(V(-40, 0, -100), V(-40, 0, -58), 9, 6))
	G.stairs(V(-46, 0, -92), V(-46, UP, -104), 4, "Steel", { Rails = "Both", Cap = true, Closed = true })
	G.railing(V(-48, UP, -104.2), V(-48, UP, -107.8), "Yellow", 3.2, { Cap = true })

	------------------------------------------------------------------
	-- CASETA DE BOMBAS (centro de cada mitad): se cruza por dentro, puertas desplazadas
	------------------------------------------------------------------
	G.shell(CF(-72, 0, 0), 16, 20, 8, "Building", {
		Front = { window(0, 3.5, 6, 2.5) },
		Back = { window(0, 3.5, 6, 2.5) },
		Left = { door(-5, 4, 7) },
		Right = { door(5, 4, 7) },
	}, { Frame = "Orange" })
	T.cap(G.box("PumpHouseRoof", V(17, 0.6, 21), CF(-72, 8.3, 0), "Roof"))
	G.solid("Pump", V(5, 4, 6), CF(-72, 0, 0), "PipeBlue")
	G.deco("PumpMotor", V(3, 2, 3), CF(-72, 5, 0), "SteelDark")

	------------------------------------------------------------------
	-- NAVE (B, mitad): escalera a la entreplanta
	------------------------------------------------------------------
	G.stairs(V(-40, 0, 88), V(-40, UP, 100), 4, "Steel", { Rails = "Both", Cap = true, Closed = true })
	-- Cierres detrás de la planta y de la nave (no hay paso por detrás)
	T.cap(G.wall(CF(-50.5, 0, -110.5) * CFrame.Angles(0, -math.pi / 2, 0), 13, 8, "ConcreteDark"))
	T.cap(G.wall(CF(-46.5, 0, 113.5) * CFrame.Angles(0, -math.pi / 2, 0), 7, 8, "ConcreteDark"))
	G.railing(V(-45, UP, 100.2), V(-42.2, UP, 100.2), "Yellow", 3.2, { Cap = true })
	G.railing(V(-37.8, UP, 100.2), V(-36, UP, 100.2), "Yellow", 3.2, { Cap = true })
end

return Geometry
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="91">
              <Properties>
                <string name="Name">Lighting</string>
                <string name="Source"><![CDATA[-- INDUSTRIAL YARD · luz. Atardecer por defecto (sol bajo naranja que alarga las sombras de los
-- depósitos y la chimenea, cielo cálido con algo de humo); variantes de día y de noche.
local RGB = Color3.fromRGB
local V = Vector3.new

local Lighting = {}

Lighting.Default = {
	ClockTime = 17.7,
	Latitude = 36,
	Brightness = 2.5,
	Exposure = 0,
	Ambient = RGB(118, 98, 92),
	OutdoorAmbient = RGB(176, 140, 120),
	ShadowSoftness = 0.2,
	Atmosphere = { Density = 0.36, Offset = 0.1, Color = RGB(244, 178, 132), Decay = RGB(160, 100, 96), Glare = 0.6, Haze = 1.8 },
	Color = { Saturation = 0.14, Contrast = 0.14, Brightness = 0.01, Tint = RGB(255, 230, 208) },
	Bloom = { Intensity = 0.4, Size = 22, Threshold = 1.9 },
	Clouds = 0.45,
	CloudColor = RGB(255, 190, 150),
	SunRays = 0.14,
	Wind = V(8, 0, 4),
	TerrainColors = { Ground = RGB(120, 116, 110) },
}

Lighting.Variants = {
	{
		Name = "Día",
		Chance = 0.3,
		ClockTime = 13,
		Brightness = 3,
		Ambient = RGB(106, 108, 116),
		OutdoorAmbient = RGB(154, 156, 166),
		Atmosphere = { Density = 0.32, Offset = 0.12, Color = RGB(206, 210, 218), Decay = RGB(130, 136, 150), Glare = 0.2, Haze = 1.5 },
		Color = { Saturation = 0.08, Contrast = 0.12, Brightness = 0.01, Tint = RGB(255, 250, 244) },
		CloudColor = RGB(244, 246, 250),
		SunRays = 0.06,
	},
	{
		Name = "Noche",
		Chance = 0.25,
		ClockTime = 21.6,
		Brightness = 1.1,
		Exposure = 0.35,
		Ambient = RGB(72, 72, 94),
		OutdoorAmbient = RGB(88, 90, 118),
		Atmosphere = { Density = 0.32, Offset = 0.06, Color = RGB(70, 68, 96), Decay = RGB(30, 28, 48), Glare = 0, Haze = 1.2 },
		Color = { Saturation = 0.08, Contrast = 0.14, Brightness = 0.03, Tint = RGB(222, 222, 255) },
		Bloom = { Intensity = 0.6, Size = 24, Threshold = 1.5 },
		Clouds = 0.35,
		CloudColor = RGB(74, 74, 100),
		SunRays = 0,
	},
}

return Lighting
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="92">
              <Properties>
                <string name="Name">Props</string>
                <string name="Source"><![CDATA[-- INDUSTRIAL YARD · props: máquinas y palés de la nave (B), bombas y válvulas de la planta (A),
-- montones de grava con cinta y pala cargadora, patio de almacenaje con contenedores, focos y la
-- zona industrial alrededor (naves y torres de refrigeración al fondo).
local Props = {}

local V = Vector3.new
local CF = CFrame.new
local RGB = Color3.fromRGB
local rad = math.rad
local M = Enum.Material

local ALONG_Z = CFrame.Angles(0, math.pi / 2, 0)

function Props.build(T)
	local night = T.isNight()

	---------------------------------------------------------------------------
	-- Centro: letras, carteles
	---------------------------------------------------------------------------
	T.letterBanner(CF(0, 10, 55.4) * CFrame.Angles(0, math.pi, 0), "B", "Blue", 5, 5.4)
	T.sign(CF(0, 13.6, 55.4) * CFrame.Angles(0, math.pi, 0), "NAVE 2 · PRODUCCIÓN", 26, 2.6, RGB(226, 120, 36), RGB(255, 255, 255), { PPS = 16 })
	T.letterBanner(CF(0, 4.4, -104) * CFrame.Angles(0, math.pi, 0), "A", "Red", 5, 5.4)
	T.sign(CF(0, 7.6, -12.4) * CFrame.Angles(0, math.pi, 0), "CALDERAS", 10, 1.6, RGB(64, 66, 70), RGB(255, 200, 120))
	T.sign(CF(0, 7.6, 12.4), "CALDERAS", 10, 1.6, RGB(64, 66, 70), RGB(255, 200, 120))

	T.mirrored("IndustrialProps", function()
		Props.half(T)
	end)

	---------------------------------------------------------------------------
	-- Fondo: naves industriales y torres de refrigeración
	---------------------------------------------------------------------------
	local palette = { RGB(150, 140, 128), RGB(120, 112, 104), RGB(170, 164, 152), RGB(132, 96, 78), RGB(100, 104, 110) }
	T.skylineRing(V(0, 0, 0), 240, 0, 355, 12, palette, { Lit = night, MinH = 14, VarH = 18, TowerEvery = 6, TowerExtra = 20, FloorH = 6 })
	for _, spec in { { V(-190, 0, -260), 46 }, { V(-120, 0, -290), 40 }, { V(260, 0, 200), 44 } } do
		local tower = T.Kit.cylinder("CoolingTower", 60, spec[2], CF(spec[1] + V(0, 30, 0)), RGB(186, 182, 172), M.Concrete, nil, true)
		tower.CastShadow = false
		T.Kit.cylinder("CoolingTowerRim", 3, spec[2] * 0.82, CF(spec[1] + V(0, 61.5, 0)), RGB(150, 146, 138), M.Concrete, nil, true).CastShadow = false
	end
	for _, x in { -230, 230 } do
		T.chimney(CF(x, 0, -200), 70, 7)
	end
end

-- Mitad del Rojo (X < 0)
function Props.half(T)
	local G = T.G
	local night = T.isNight()

	------------------------------------------------------------------
	-- PLANTA (A): bombas, válvulas, depósito pequeño
	------------------------------------------------------------------
	T.cap(G.solid("PumpSkid", V(6, 3.6, 4), CF(-10, 0, -98), "PipeBlue"))
	T.cap(G.solid("ValveManifold", V(3, 5.4, 8), CF(-34, 0, -80), "PipeGreen"))
	-- Filtros verticales a los lados de A (cortan la línea de lado a lado por la planta)
	for _, z in { -88, -73 } do
		T.cap(T.fuelTank(CF(-12, 0, z), 4, 7))
	end
	T.cap(T.horizontalTank(CF(-12, 0, -64), 10, 5))
	T.cap(T.horizontalTank(CF(-30, 0, -52), 12, 5))
	T.barrel(CF(-30, 0, -70), "Orange")
	T.barrel(CF(-31.6, 0, -71.6), "Rust")
	T.cap(T.crateStack(CF(-56, 0, -76) * CFrame.Angles(0, rad(12), 0), "Wall"))

	------------------------------------------------------------------
	-- GRAVA (noroeste): montones, cinta y pala cargadora
	------------------------------------------------------------------
	T.heap(CF(-86, 0, -98), 22, 12, 8)
	T.heap(CF(-80, 0, -58) * ALONG_Z, 16, 10, 6, "Rust")
	T.conveyor(V(-62, 1, -98), V(-80, 10, -98), 3)
	T.cap(T.wheelLoader(CF(-104, 0, -74) * CFrame.Angles(0, rad(20), 0)))

	------------------------------------------------------------------
	-- Centro de cada mitad: contenedores y barreras
	------------------------------------------------------------------
	T.cap(T.container(CF(-34, 0, -30) * ALONG_Z, "ContainerRed"))
	T.cap(T.container(CF(-38, 0, 22.4) * ALONG_Z, "ContainerBlue"))
	T.jersey(CF(-50, 0, -20) * ALONG_Z, 8)
	T.cap(T.crateStack(CF(-28, 0, 10) * CFrame.Angles(0, rad(-8), 0), "L"))
	T.cap(T.horizontalTank(CF(-96, 0, -24), 12, 5))

	------------------------------------------------------------------
	-- ALMACENAJE (suroeste): contenedores, palés, contenedor de escombros, carretilla
	------------------------------------------------------------------
	T.cap(T.container(CF(-96, 0, 70) * ALONG_Z, "ContainerYellow"))
	T.cap(T.container(CF(-96, 8.75, 70) * ALONG_Z, "ContainerGray"))
	T.cap(T.container(CF(-72, 0, 98), "ContainerRed"))
	T.cap(G.solid("PalletStack", V(6, 3.6, 6), CF(-62, 0, 64), "Wood"))
	T.cap(G.solid("PalletStack", V(6, 5.4, 6), CF(-80, 0, 48), "Wood"))
	T.skip(CF(-112, 0, 96))
	T.Kit.forklift(CF(-68, 0, 80) * CFrame.Angles(0, rad(-60), 0))

	------------------------------------------------------------------
	-- NAVE (B, mitad): máquinas, palés, cinta
	------------------------------------------------------------------
	T.cap(T.machine(CF(-30, 0, 76), 6, 8, 7))
	T.cap(T.machine(CF(-14, 0, 92), 5, 5, 6))
	T.cap(T.machine(CF(-37, 0, 84), 5, 6, 6.4))
	T.cap(G.solid("PalletStack", V(5, 4, 6), CF(-38, 0, 64), "Wood"))
	T.cap(T.crateStack(CF(-12, 0, 66), "L"))
	G.box("ConveyorTable", V(14, 2.6, 3), CF(-28, 1.3, 98), "SteelDark")

	------------------------------------------------------------------
	-- Base y focos
	------------------------------------------------------------------
	local lamp = G.deco("BaseLight", V(14, 0.3, 1.2), CF(-136, 9.1, 0), { RGB(255, 240, 210), M.Neon })
	T.Kit.light(lamp, "PointLight", RGB(255, 236, 200), 20, 0.8)
	T.cap(T.crateStack(CF(-145, 0, -14), "L"))
	G.deco("InnerRoad", V(16, 0.1, 230), CF(-112, 0.05, 0), "Asphalt").CastShadow = false
	for _, p in { V(-118, 0, -50), V(-118, 0, 50), V(-56, 0, 0) } do
		T.floodTower(CF(p), 16, night and RGB(255, 226, 180) or nil)
	end
end

return Props
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="93">
            <Properties>
              <string name="Name">MallRush</string>
              <string name="Source"><![CDATA[-- MALL RUSH (5v5 · Duelo por equipos · Buscar y destruir): centro comercial compacto de dos
-- plantas. Atrio central con cúpula, fuente, escaleras mecánicas y puente superior; patios a cada
-- lado con el sitio de cada equipo (como en la referencia: el A junto a la base A y el B junto a
-- la B); zona de comida al norte, entrada principal al sur, pasillo de servicio y tiendas grandes
-- como flancos. Reconstruido de la hoja de referencia (vista superior, vista general, atrio,
-- tiendas laterales, puente superior, pasillo de servicio y zona de comida).
local T = require(script.Parent.Parent.TacKit)
local Lighting = require(script.Lighting)
local Geometry = require(script.Geometry)
local Props = require(script.Props)
local Dressing = require(script.Dressing)

local Map = {
	Id = "MallRush",
	Name = "Mall Rush",
	Icon = "🛍️",
	Description = "Centro comercial · dos plantas · 5 contra 5",
	Realistic = true,
	Bomb = true,
	Palette = "MallRush",
	Ambience = "Factory",
	Modes = { "TDM", "SND" },
	RecommendedPlayers = 10,
	Bounds = Vector3.new(300, 40, 180),
}

Map.Lighting = Lighting.Default
Map.LightingVariants = Lighting.Variants

local V = Vector3.new
local CF = CFrame.new
local L = 12

function Map.Build()
	local folder = T.begin(Map)
	Geometry.build(T)
	Props.build(T)
	Dressing.build(T) -- (Fase 14: acabados; solo decorado)

	-- Bases: el aparcamiento de cada lado
	local redBase = CFrame.lookAt(V(-143, 0, 0), V(-100, 0, 0))
	local points = { V(-10, 0, 1), V(-5, 0, -3), V(0, 0, 1), V(5, 0, -3), V(10, 0, 1) }
	T.spawnZone(1, redBase, { Size = Vector2.new(32, 14), Floor = Color3.fromRGB(84, 86, 92), Points = points })
	T.spawnZone(2, T.mirrorCFrame(redBase), { Size = Vector2.new(32, 14), Floor = Color3.fromRGB(84, 86, 92), Points = points })
	T.flagBase(1, CF(-140, 0, 30))
	T.flagBase(2, CF(140, 0, 30))

	-- Sitios: cada equipo defiende el de su mitad (A el Rojo, B el Azul)
	T.site(V(-50, 0, 0), "A", { Defender = 1 })
	T.site(V(50, 0, 0), "B", { Defender = 2, Color = Color3.fromRGB(46, 110, 220) })

	-- Zonas
	T.zone(V(0, 0, -28), 9, 1)
	T.zone(V(-50, 0, 0), 8, 2)
	T.zone(V(0, 0, -58), 9, 3)
	T.zone(V(50, 0, 0), 8, 4)
	T.zone(V(0, 0, 54), 9, 5)

	-- Nombres de zona
	T.callout("ATRIO", CF(0, 6, 0), V(72, 12, 72))
	T.callout("FUENTE", CF(0, 5, 0), V(14, 10, 14))
	T.callout("PUENTE", CF(0, L + 3, -12), V(44, 6, 6))
	T.callout("ANILLO", CF(0, L + 4, 0), V(76, 8, 72))
	T.callout("ZONA DE COMIDA", CF(0, 8, -58), V(80, 16, 44))
	T.callout("ENTRADA", CF(0, 8, 58), V(40, 16, 44))
	for _, m in { -1, 1 } do
		local function at(x, y, z)
			return CF(m * x, y, z)
		end
		T.callout(m < 0 and "PATIO A" or "PATIO B", at(50, 6, 0), V(28, 12, 40))
		T.callout("GALERÍA", at(91, 6, 0), V(54, 12, 40))
		T.callout("PLANTA ALTA", at(78, L + 4, 0), V(84, 8, 72))
		T.callout(m < 0 and "BLOX MART" or "MEGA TOYS", at(95, 6, -46), V(46, 12, 52))
		T.callout(m < 0 and "PIXEL WEAR" or "SPORT HUB", at(95, 6, 46), V(46, 12, 52))
		T.callout("PASILLO DE SERVICIO", at(79, 5, -76), V(78, 10, 8))
		T.callout("PASAJE", at(68, 5, -46), V(8, 10, 52))
		T.callout("PASILLO NORTE", at(50, 5, -28), V(28, 10, 16))
		T.callout("PASILLO SUR", at(54, 5, 28), V(36, 10, 16))
		T.callout("APARCAMIENTO", at(134, 6, 0), V(32, 14, 120))
	end

	-- Puntos libres
	for _, p in {
		V(-140, 0.5, -30), V(-120, 0.5, 30), V(-110, 0.5, -14), V(-88, 0.5, 8), V(-100, 0.5, -64),
		V(-84, 0.5, 60), V(-68, 0.5, -50), V(-60, 0.5, -76), V(-50, 0.5, 28), V(-30, 0.5, -28),
		V(-28, 0.5, 20), V(-34, 0.5, -60), V(-46, 0.5, 72), V(-90, L + 0.5, 0), V(-64, L + 0.5, -28),
		V(-30, L + 0.5, 28), V(-8, 0.5, 58),
	} do
		T.ffa(p)
		T.ffa(T.mirrorPoint(p))
	end
	-- Puestos de los bots
	for _, spot in {
		{ V(-64, L, -18), V(-50, 4, 0) }, -- anillo del patio, sobre el sitio
		{ V(-26, L, -28), V(10, 4, -50) }, -- anillo del atrio, sobre la zona de comida
		{ V(-8, L, -12), V(-40, 4, 0) }, -- puente
		{ V(-86, L, -10), V(-60, L + 4, 0) }, -- galería alta
	} do
		T.botSpot(spot[1], spot[2])
		T.botSpot(T.mirrorPoint(spot[1]), T.mirrorPoint(spot[2]))
	end

	T.Kit.bounds(Map.Bounds.X, Map.Bounds.Z, Map.Bounds.Y)
	return folder
end

return Map
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="94">
              <Properties>
                <string name="Name">Dressing</string>
                <string name="Source"><![CDATA[-- MALL RUSH · acabados (Fase 14, pulido visual sin tocar el juego). Todo es decorado: no choca ni
-- para balas.
--
--   * Suelo por zonas: el atrio de granito con marco cian alrededor de la fuente, la zona de comida
--     en azulejo cálido, el pasillo de servicio de hormigón y los patios de los sitios con un marco
--     de su color (A rojo, B azul: se sabe en qué patio se está sin mirar el minimapa).
--   * Frentes de forjado de la planta alta en los huecos del patio y del atrio: frente blanco con una
--     línea de luz de color (naranja en los patios, cian en el atrio). Es lo que más se ve desde
--     abajo y da la energía de centro comercial; solo neón, sin luces nuevas.
--   * Rótulos: «FOOD COURT» en el fondo de la zona de comida y «NIVEL 2» sobre cada escalera
--     mecánica.
--   * Fachadas norte y sur con lamas verticales (la caja blanca deja de ser una caja).
--   * Fondo: vallas publicitarias de marcas ficticias (NOVA, BYTE, FLUX) junto a las calles.
local Dressing = {}

local V = Vector3.new
local CF = CFrame.new
local RGB = Color3.fromRGB

local L = 12
local TOP = 24
local CYAN, ORANGE = RGB(0, 186, 214), RGB(250, 140, 30)

function Dressing.build(T)
	local F = T.F

	---------------------------------------------------------------------------
	-- Suelo del centro: atrio y zona de comida; marco de color de cada sitio (fuera del espejo)
	---------------------------------------------------------------------------
	F.groundZone(CF(0, 0, 0), 44, 44, "AtriumStone", "AtriumStone")
	F.zoneEdge(CF(0, 0, 0), 40, 40, "TileAccent", 0.8)
	F.groundZone(CF(0, 0, -58), 76, 40, "FoodFloor", "FoodFloor")
	F.zoneEdge(CF(0, 0, -58), 76, 40, "Orange", 0.6)
	F.zoneEdge(CF(-50, 0, 0), 24, 32, "Red", 0.9)
	F.zoneEdge(CF(50, 0, 0), 24, 32, "Blue", 0.9)

	-- Rótulo de la zona de comida en el muro del fondo (cara al sur)
	local food = T.sign(CF(0, 17, -79.7) * CFrame.Angles(0, math.pi, 0), "FOOD COURT", 30, 4, ORANGE, RGB(255, 255, 255), { PPS = 12 })
	food.CastShadow = false

	-- Fondo urbano: vallas publicitarias de marcas ficticias junto a las calles (se ven desde los
	-- aparcamientos y en la presentación del mapa; fuera del límite jugable)
	T.billboardScreen(CF(-172, 0, -36) * CFrame.Angles(0, -math.pi / 2, 0), 16, 7, "NOVA", RGB(0, 150, 190))
	T.billboardScreen(CF(172, 0, 36) * CFrame.Angles(0, math.pi / 2, 0), 16, 7, "BYTE", RGB(200, 40, 130))
	T.billboardScreen(CF(40, 0, -126) * CFrame.Angles(0, math.pi, 0), 16, 7, "FLUX", RGB(230, 120, 30))

	T.mirrored("MallDressing", function()
		Dressing.half(T)
	end)
end

-- Mitad del Rojo (X < 0)
function Dressing.half(T)
	local F = T.F

	-- Pasillo de servicio: hormigón
	F.groundZone(CF(-79, 0, -76), 78, 8, "ServiceFloor", "ServiceFloor")

	-- Frentes de forjado (frente blanco y línea de luz debajo) en los bordes de los huecos
	local function fascia(a, b, inward, glow)
		F.band(a, b, L - 1.1, 1.2, 0.3, "Fascia", inward, "Fascia")
		F.band(a, b, L - 1.35, 0.25, 0.4, { glow, Enum.Material.Neon }, inward, "FasciaGlow")
	end
	-- Hueco del patio (x -60..-40, z -14..14)
	fascia(V(-60, 0, -14), V(-60, 0, 14), V(1, 0, 0), ORANGE)
	fascia(V(-40, 0, -14), V(-40, 0, 14), V(-1, 0, 0), ORANGE)
	fascia(V(-60, 0, -14), V(-40, 0, -14), V(0, 0, 1), ORANGE)
	fascia(V(-60, 0, 14), V(-40, 0, 14), V(0, 0, -1), ORANGE)
	-- Hueco del atrio (x -22..0 en esta mitad, z -22..22) y los lados del puente (z -15 y -9)
	fascia(V(-22, 0, -22), V(-22, 0, 22), V(1, 0, 0), CYAN)
	fascia(V(-22, 0, -22), V(0, 0, -22), V(0, 0, 1), CYAN)
	fascia(V(-22, 0, 22), V(0, 0, 22), V(0, 0, -1), CYAN)
	fascia(V(-22, 0, -15), V(0, 0, -15), V(0, 0, -1), CYAN)
	fascia(V(-22, 0, -9), V(0, 0, -9), V(0, 0, 1), CYAN)

	-- «NIVEL 2» colgado bajo el puente, mirando al arranque de la escalera mecánica
	T.sign(CF(-14, 10.1, -8.8) * CFrame.Angles(0, math.pi, 0), "NIVEL 2", 5, 1.3, RGB(36, 40, 52), RGB(255, 255, 255), { PPS = 24, Back = true })

	-- Fachadas norte y sur: lamas verticales gris oscuro cada 12 (no en la entrada principal)
	for x = -112, -16, 12 do
		for _, spec in { { -81, V(0, 0, -1) }, { 81, V(0, 0, 1) } } do
			local fin = T.G.deco("FacadeFin", V(1, TOP - 2, 1.4), CF(x, (TOP - 2) / 2 + 0.4, spec[1] + spec[2].Z * 0.2), "FacadeDark")
			fin.CastShadow = false
		end
	end
end

return Dressing
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="95">
              <Properties>
                <string name="Name">Geometry</string>
                <string name="Source"><![CDATA[-- MALL RUSH · geometría jugable (blockout). Centro comercial de dos plantas (suelo 0, planta alta 12):
--
--   z -80 ┌─ PASILLO DE SERVICIO ──────────┬──── ZONA DE COMIDA (doble altura) ────┬─ ... ─┐
--         │ BLOX MART      │ pasaje │ tienda│                                       │       │
--   z -36 │ (tienda grande)│        ├ PASILLO NORTE ┬──────── ATRIO ─────────┬─────┤       │
--  APARCA-│ VESTÍBULO ─── GALERÍA ─ PATIO A (sitio A) │ fuente, escaleras,  │ PATIO B │ ... APARCA-
--  MIENTO │ (escalera)     │        ├ PASILLO SUR   ┤ puente arriba       ├─────┤       MIENTO
--  (base  │ PIXEL WEAR     │ tiendas│ tienda│              ENTRADA (vestíbulo)          │  (base
--   roja) │ (tienda grande)├─ pasillo sur B ────────┴──────────────────────────────────┘   azul)
--   z  80 └──────────────────────────────────────────────────────────────────────────────┘
--
-- Como en la referencia, cada sitio está en la mitad de un equipo: el Rojo defiende el A y el Azul
-- el B. Simétrico en X = 0. Planta alta: galería sobre el vestíbulo, anillo sobre los patios y el
-- atrio y un puente que cruza el atrio (escaleras mecánicas desde la fuente).
local Geometry = {}

local V = Vector3.new
local CF = CFrame.new

local L = 12 -- planta alta
local TOP = 24 -- techo

function Geometry.build(T)
	local G = T.G
	local M = Enum.Material

	T.terrain(M.Grass, 1200, 1200, CF(0, -0.3, 0))
	G.floor(CF(0, 0, 0), 236, 160, "Floor")
	-- Cúpula sobre el atrio y lucernario de la zona de comida
	T.glassDome(CF(0, TOP + 1, 0), 44, 12)
	for _, x in { -20, 20 } do
		local sky = G.deco("FoodSkylight", V(20, 0.3, 24), CF(x, TOP + 0.6, -58), "Glass")
		sky.Transparency = 0.45
	end
	-- Puertas de cristal de la entrada principal (cerradas: el exterior sur no se juega)
	local doors = G.deco("EntranceGlass", V(24, 9, 0.3), CF(0, 4.5, 80.2), "Glass")
	doors.Transparency = 0.4
	G.box("EntranceStop", V(24, 12, 1), CF(0, 6, 80.5), "Facade").Transparency = 1
	G.wall(CF(0, 9, 80.5), 24, TOP - 9, "Facade")

	T.mirrored("MallHalf", function()
		Geometry.half(T)
	end)
end

function Geometry.half(T)
	local G = T.G
	local door, window = G.door, G.window

	------------------------------------------------------------------
	-- Fachadas (oeste con 4 puertas; norte y sur) y aparcamiento
	------------------------------------------------------------------
	T.cap(G.wall(CF(-118.5, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0), 162, TOP, "Facade", {
		door(-76, 6, 8), door(-9, 6, 8), door(9, 6, 8), door(68, 6, 8),
	}, { Frame = "FacadeDark" }))
	T.cap(G.wall(CF(-59.5, 0, -80.5), 119, TOP, "Facade"))
	T.cap(G.wall(CF(-65.5, 0, 80.5), 107, TOP, "Facade"))
	G.floor(CF(-134, 0, 0), 32, 120, "Parking", 1)
	-- Marquesina del aparcamiento (la base): paredes a los lados y techo; delante, aparcados, el
	-- camión y la furgoneta (ver Props) tapan las puertas del centro comercial
	for _, z in { -24.5, 24.5 } do
		T.cap(G.wall(CF(-141, 0, z), 22, 8, "FacadeDark"))
		G.column(CF(-130.4, 0, z), 8.6, 1, "Steel")
	end
	T.cap(G.floor(CF(-141, 9, 0), 23, 50, "FacadeDark", 0.8))
	G.deco("CarportStripe", V(0.4, 1, 50), CF(-129.8, 8.4, 0), "Magenta")
	G.box("ParkingCurb", V(32, 0.8, 1), CF(-134, 0.4, -60.5), "Concrete")
	G.box("ParkingCurb", V(32, 0.8, 1), CF(-134, 0.4, 60.5), "Concrete")
	T.cap(G.hoarding(V(-150, 0, -61), V(-150, 0, 61), 10, "FacadeDark", { Stripe = "Magenta" }))
	T.cap(G.hoarding(V(-150, 0, -61), V(-119, 0, -61), 6, "FacadeDark", { Stripe = "Magenta" }))
	T.cap(G.hoarding(V(-150, 0, 61), V(-119, 0, 61), 6, "FacadeDark", { Stripe = "Magenta" }))

	------------------------------------------------------------------
	-- Tiendas grandes con interior: BLOX MART (norte) y PIXEL WEAR (sur)
	------------------------------------------------------------------
	G.wall(CF(-95, 0, -72), 46, L, "WallGray")
	G.wall(CF(-72, 0, -46) * CFrame.Angles(0, -math.pi / 2, 0), 52, L, "WallGray", { door(6) })
	G.wall(CF(-95, 0, -20), 46, L, "Wall", { door(-13, 8, 8), window(7, 1, 10, 7) })
	G.box("BloxUpper", V(46, L, 52), CF(-95, L + L / 2, -46), "Wall")
	G.wall(CF(-95, 0, 20), 46, L, "Wall", { door(5, 8, 8), window(-11, 1, 10, 7) })
	G.wall(CF(-72, 0, 46) * CFrame.Angles(0, -math.pi / 2, 0), 52, L, "WallGray", { door(-18), door(24) })
	G.box("PixelUpper", V(46, L, 52), CF(-95, L + L / 2, 46), "Wall")

	------------------------------------------------------------------
	-- Pasillo de servicio (norte), pasaje al patio y pasillo sur B: techos bajos (10)
	------------------------------------------------------------------
	G.box("ServiceUpper", V(78, 14, 8), CF(-79, 17, -76), "Service")
	G.box("PassageUpper", V(8, 14, 36), CF(-68, 17, -54), "Service")
	T.cap(G.wall(CF(-40, 0, -76) * CFrame.Angles(0, -math.pi / 2, 0), 8, 10, "Service", { door(0) }))
	G.box("SouthCorridorUpper", V(52, 14, 14), CF(-46, 17, 73), "Wall")

	------------------------------------------------------------------
	-- Bloques de tiendas macizos (dos plantas)
	------------------------------------------------------------------
	G.solid("ShopN2", V(24, TOP, 36), CF(-52, 0, -54), "Wall")
	G.solid("ShopS2", V(36, TOP, 30), CF(-54, 0, 51), "Wall")
	G.solid("ShopS4", V(16, TOP, 30), CF(-28, 0, 51), "Wall")

	------------------------------------------------------------------
	-- Planta alta: galería (con la escalera del vestíbulo), anillo del patio y del atrio, puente
	------------------------------------------------------------------
	G.slab(CF(-94.5, L, 0), 45, 40, "Floor", { { -5.5, -3, 4.8, 11 } })
	G.stairs(V(-100, 0, 12), V(-100, L, -8), 4.4, "WallGray", { Rails = "Both", RailLook = "Steel" })
	-- Vestíbulo-esclusa: pared interior con las puertas desplazadas respecto a las de la fachada
	-- (desde dentro no se ve el aparcamiento de la base)
	T.cap(G.wall(CF(-110, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0), 40, L, "Wall", { door(-15, 6, 8), door(15, 6, 8) }, { Frame = "FacadeDark" }))
	G.slab(CF(-54, L, 0), 36, 72, "Floor", { { 4, 0, 20, 28 } })
	G.slab(CF(-18, L, 0), 36, 72, "Floor", { { 7, 0, 22, 44 } })
	G.floor(CF(-11, L, -12), 22, 6, "Floor")
	-- Barandillas de cristal: hueco del patio, hueco del atrio, puente y bordes sobre la comida y
	-- la entrada (los bordes con tiendas tienen la pared de la tienda)
	T.glassRail(V(-60, L, -14), V(-60, L, 14))
	T.glassRail(V(-40, L, -14), V(-40, L, 14))
	T.glassRail(V(-60, L, -14), V(-40, L, -14))
	T.glassRail(V(-60, L, 14), V(-40, L, 14))
	T.glassRail(V(-22, L, -22), V(-22, L, -15.2))
	T.glassRail(V(-22, L, -8.8), V(-22, L, 22))
	T.glassRail(V(-22, L, -22), V(0, L, -22))
	T.glassRail(V(-22, L, 22), V(-16.6, L, 22))
	T.glassRail(V(-11.4, L, 22), V(0, L, 22))
	T.glassRail(V(-22, L, -15), V(0, L, -15))
	T.glassRail(V(-22, L, -9), V(0, L, -9))
	T.glassRail(V(-40, L, -36), V(0, L, -36))
	T.glassRail(V(-20, L, 36), V(0, L, 36))
	T.glassRail(V(-97.8, L, 2.6), V(-102.2, L, 2.6))
	-- Falsos techos blancos bajo la planta alta (el interior se ve claro)
	for _, spec in { { -94.5, 0, 44, 39 }, { -54, -28, 35, 15 }, { -54, 28, 35, 15 }, { -66, 0, 11, 26 }, { -29, 0, 13, 71 }, { -11, -29, 21, 13 }, { -11, 29, 21, 13 } } do
		local panel = G.deco("CeilingPanel", V(spec[3], 0.15, spec[4]), CF(spec[1], L - 1.1, spec[2]), "Ceiling")
		panel.CastShadow = false
	end
	-- Escalera mecánica del atrio (sube hacia el sur, hasta el anillo)
	T.escalator(V(-14, 0, 0), V(-14, L, 22), 4.4)

	------------------------------------------------------------------
	-- Techo (con huecos: patio, atrio y lucernario de la comida)
	------------------------------------------------------------------
	T.cap(G.slab(CF(-59, TOP + 0.5, 0), 118, 160, "RoofTop", {
		{ 9, 0, 20, 28 },
		{ 48, 0, 22, 44 },
		{ 39, -58, 20, 24 },
	}))
	local sky = G.deco("CourtSkylight", V(20, 0.3, 28), CF(-50, TOP + 0.6, 0), "Glass")
	sky.Transparency = 0.45
	T.cap(sky)
end

return Geometry
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="96">
              <Properties>
                <string name="Name">Lighting</string>
                <string name="Source"><![CDATA[-- MALL RUSH · luz. Día luminoso por dentro (ambiente alto: el centro comercial está iluminado) y
-- variantes de tarde y de noche (las tiendas encendidas; fuera, la ciudad con ventanas).
local RGB = Color3.fromRGB
local V = Vector3.new

local Lighting = {}

Lighting.Default = {
	ClockTime = 14.2,
	Latitude = 30,
	Brightness = 2.8,
	Exposure = 0.05,
	Ambient = RGB(150, 150, 160),
	OutdoorAmbient = RGB(160, 160, 170),
	ShadowSoftness = 0.2,
	Atmosphere = { Density = 0.22, Offset = 0.1, Color = RGB(206, 220, 236), Decay = RGB(130, 150, 176), Glare = 0.15, Haze = 0.8 },
	Color = { Saturation = 0.16, Contrast = 0.1, Brightness = 0.02, Tint = RGB(255, 250, 248) },
	Bloom = { Intensity = 0.4, Size = 22, Threshold = 1.9 },
	Clouds = 0.35,
	CloudColor = RGB(255, 255, 255),
	SunRays = 0.06,
	Wind = V(4, 0, 2),
	TerrainColors = { Grass = RGB(96, 146, 72) },
}

Lighting.Variants = {
	{
		Name = "Atardecer",
		Chance = 0.3,
		ClockTime = 17.9,
		Brightness = 2.2,
		Ambient = RGB(150, 130, 136),
		OutdoorAmbient = RGB(170, 140, 130),
		Atmosphere = { Density = 0.26, Offset = 0.08, Color = RGB(250, 190, 160), Decay = RGB(160, 110, 130), Glare = 0.5, Haze = 1.2 },
		Color = { Saturation = 0.16, Contrast = 0.1, Brightness = 0.02, Tint = RGB(255, 238, 226) },
		CloudColor = RGB(255, 196, 170),
		SunRays = 0.1,
	},
	{
		Name = "Noche",
		Chance = 0.25,
		ClockTime = 21.5,
		Brightness = 1.2,
		Exposure = 0.3,
		Ambient = RGB(120, 120, 150),
		OutdoorAmbient = RGB(80, 88, 124),
		Atmosphere = { Density = 0.26, Offset = 0.06, Color = RGB(62, 70, 108), Decay = RGB(26, 30, 56), Glare = 0, Haze = 1 },
		Color = { Saturation = 0.12, Contrast = 0.12, Brightness = 0.03, Tint = RGB(230, 232, 255) },
		Bloom = { Intensity = 0.5, Size = 24, Threshold = 1.5 },
		Clouds = 0.25,
		CloudColor = RGB(70, 76, 104),
		SunRays = 0,
	},
}

return Lighting
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="97">
              <Properties>
                <string name="Name">Props</string>
                <string name="Source"><![CDATA[-- MALL RUSH · props: identidad de color (escaparates con rótulos cian, magenta, naranja y morado,
-- banderolas del atrio, puestos de comida), cobertura de interior (quioscos, mesas, jardineras,
-- estanterías, mostradores) y el aparcamiento de cada base. Los rótulos se ponen fuera del espejo
-- para que cada lado tenga sus tiendas.
local Props = {}

local V = Vector3.new
local CF = CFrame.new
local RGB = Color3.fromRGB
local rad = math.rad
local M = Enum.Material

local L = 12
local TOP = 24

local CYAN, MAGENTA, ORANGE, PURPLE = RGB(0, 186, 214), RGB(226, 40, 140), RGB(250, 140, 30), RGB(130, 70, 200)

function Props.build(T)
	local G = T.G
	local night = T.isNight()

	---------------------------------------------------------------------------
	-- Atrio: fuente, palmeras, jardineras y banderolas (MALL RUSH en el centro)
	---------------------------------------------------------------------------
	T.mallFountain(CF(0, 0, 0), 10, CYAN)
	for _, s in { -1, 1 } do
		T.palmPlanter(CF(s * 7, 0, 15), 11)
		T.planter(CF(s * 6, 0, -6) * CFrame.Angles(0, rad(90), 0), 5, 2.6)
	end
	T.hangingBanner(CF(-10, TOP - 1, -21.4), 4.6, 9, CYAN, nil)
	T.hangingBanner(CF(0, TOP - 1, -21.4), 5.4, 9, MAGENTA, "MALL RUSH")
	T.hangingBanner(CF(10, TOP - 1, -21.4), 4.6, 9, ORANGE, nil)
	for _, z in { -12, 12 } do
		local lamp = G.deco("AtriumLight", V(2, 0.4, 2), CF(0, TOP - 0.6, z), { RGB(255, 248, 236), M.Neon })
		T.Kit.light(lamp, "PointLight", RGB(255, 246, 230), 30, 1)
	end

	---------------------------------------------------------------------------
	-- Zona de comida: puestos al fondo, mesas y una palmera en medio
	---------------------------------------------------------------------------
	for i, spec in { { -28, "BITES", ORANGE }, { -10, "SODA", MAGENTA }, { 10, "PIZZA", RGB(214, 50, 40) }, { 28, "NOODLE", CYAN } } do
		T.foodStall(CF(spec[1], 0, -70) * CFrame.Angles(0, math.pi, 0), spec[2], spec[3], 12)
	end
	for _, x in { -30, -18, -6, 6, 18, 30 } do
		for _, z in { -58, -47 } do
			T.tableSet(CF(x, 0, z) * CFrame.Angles(0, rad((x + z) % 30), 0), ({ ORANGE, CYAN, MAGENTA })[((x // 12) % 3) + 1])
		end
	end
	T.palmPlanter(CF(0, 0, -52), 12)
	for _, x in { -20, 20 } do
		local lamp = G.deco("FoodLight", V(14, 0.4, 2), CF(x, TOP - 0.6, -46), { RGB(255, 244, 226), M.Neon })
		T.Kit.light(lamp, "PointLight", RGB(255, 240, 220), 30, 1)
	end

	---------------------------------------------------------------------------
	-- Entrada principal (vestíbulo sur): jardineras, directorio y el rótulo de fuera
	---------------------------------------------------------------------------
	for _, s in { -1, 1 } do
		T.palmPlanter(CF(s * 12, 0, 70), 10)
	end
	T.sign(CF(0, 6, 44) , "DIRECTORIO · PLANTA BAJA Y ALTA", 10, 1.6, RGB(36, 40, 52), RGB(255, 255, 255), { PPS = 18, Back = true })
	G.box("DirectoryStand", V(10, 4.6, 1), CF(0, 2.3, 44), "WallGray")
	-- (el centro comercial se llama como el mapa: antes ponía «SUNRISE MALL»)
	local entrance = T.sign(CF(0, 15, 81.2) * CFrame.Angles(0, math.pi, 0), "MALL RUSH", 30, 4, RGB(30, 32, 40), RGB(255, 214, 90), { PPS = 12 })
	entrance.CastShadow = false
	-- Rótulo en la azotea (se lee en la presentación del mapa y desde los aparcamientos)
	local roofSign = T.sign(CF(0, TOP + 5, -30), "MALL RUSH", 34, 6, MAGENTA, RGB(255, 255, 255), { PPS = 10, Back = true })
	roofSign.CastShadow = false
	G.deco("RoofSignFrame", V(35, 0.6, 1), CF(0, TOP + 1.7, -30), "Steel")
	for _, x in { -14, 0, 14 } do
		G.deco("RoofSignLeg", V(0.5, 2.6, 0.5), CF(x, TOP + 1.8, -30), "Steel")
	end

	---------------------------------------------------------------------------
	-- Rótulos, escaparates y lonas de cada lado (fuera del espejo: nombres distintos)
	---------------------------------------------------------------------------
	local names = {
		[-1] = { North = "NEXUS", South = "STYLE", Trend = "TREND", Lobby = "PIXEL", Upper = "GAME ZONE", Big = "BLOX MART", Big2 = "PIXEL WEAR", Facade = "BLOX MART" },
		[1] = { North = "VOLTA", South = "URBAN", Trend = "ARCADE", Lobby = "BEATS", Upper = "SKATE CO.", Big = "MEGA TOYS", Big2 = "SPORT HUB", Facade = "LOADING BAY" },
	}
	for _, s in { -1, 1 } do
		local n = names[s]
		local turnIn = s < 0 and CFrame.Angles(0, -math.pi / 2, 0) or CFrame.Angles(0, math.pi / 2, 0)
		T.storefront(CF(s * 52, 0, -35.6) * CFrame.Angles(0, math.pi, 0), 18, 8, n.North, CYAN, { Depth = 0.7, Shallow = true })
		T.storefront(CF(s * 54, 0, 35.6), 20, 8, n.South, ORANGE, { Depth = 0.7, Shallow = true })
		T.storefront(CF(s * 28, 0, 35.6), 12, 8, n.Trend, MAGENTA, { Depth = 0.7, Shallow = true })
		T.storefront(CF(s * 19.6, 0, 51) * turnIn, 22, 8, n.Lobby, PURPLE, { Depth = 0.7, Shallow = true })
		-- Planta alta
		T.storefront(CF(s * 95, L, -19.6) * CFrame.Angles(0, math.pi, 0), 30, 8, n.Upper, PURPLE, { Depth = 0.7, Shallow = true })
		T.storefront(CF(s * 95, L, 19.6), 30, 8, n.Big2, ORANGE, { Depth = 0.7, Shallow = true })
		T.storefront(CF(s * 52, L, -35.6) * CFrame.Angles(0, math.pi, 0), 18, 8, n.North .. " +", MAGENTA, { Depth = 0.7, Shallow = true })
		T.storefront(CF(s * 54, L, 35.6), 20, 8, n.South .. " +", CYAN, { Depth = 0.7, Shallow = true })
		-- Rótulos de las tiendas grandes (sobre sus escaparates de la galería)
		T.sign(CF(s * 88, 9.4, -19.4) * CFrame.Angles(0, math.pi, 0), n.Big, 10, 1.8, s < 0 and RGB(30, 110, 200) or RGB(214, 50, 40), RGB(255, 255, 255), { PPS = 18 })
		T.sign(CF(s * 106, 9.4, 19.4), n.Big2, 10, 1.8, ORANGE, RGB(255, 255, 255), { PPS = 18 })
		-- Fachada exterior (sobre las puertas del aparcamiento)
		local facade = T.sign(CF(s * 119.2, 16, 0) * turnIn * CFrame.Angles(0, math.pi, 0), n.Facade, 26, 4, s < 0 and RGB(30, 110, 200) or RGB(36, 40, 52), RGB(255, 255, 255), { PPS = 12 })
		facade.CastShadow = false
		-- Lona del sitio colgando sobre el patio y letrero del pasillo de servicio
		local letter = s < 0 and "A" or "B"
		T.hangingBanner(CF(s * 50, TOP - 1, -13.4), 6, 8, s < 0 and RGB(214, 50, 60) or RGB(40, 120, 220), letter)
		T.sign(CF(s * 64.4, 5, -60) * turnIn * CFrame.Angles(0, math.pi, 0), letter .. " →", 3, 1.4, s < 0 and RGB(214, 50, 60) or RGB(40, 120, 220), RGB(255, 255, 255), { PPS = 30 })
	end

	T.mirrored("MallProps", function()
		Props.half(T)
	end)

	-- Fondo: árboles y calles alrededor del centro comercial, ciudad baja
	for x = -140, 140, 28 do
		for _, z in { -96, 96 } do
			T.tree(CF(x + (z > 0 and 10 or 0), 0, z))
		end
	end
	G.deco("Street", V(600, 0.1, 18), CF(0, 0.05, 112), "Parking").CastShadow = false
	G.deco("Street", V(600, 0.1, 18), CF(0, 0.05, -112), "Parking").CastShadow = false
	T.skylineRing(V(0, 0, 0), 230, 0, 355, 12, { RGB(214, 206, 196), RGB(190, 196, 206), RGB(224, 214, 200), RGB(200, 184, 176) }, { Lit = night, MinH = 18, VarH = 30, TowerEvery = 5, TowerExtra = 40, FloorH = 7 })
end

-- Mitad del Rojo (X < 0)
function Props.half(T)
	local G = T.G

	------------------------------------------------------------------
	-- Vestíbulo: mostrador de información delante de las puertas (tapa la vista desde fuera)
	------------------------------------------------------------------
	G.box("InfoDesk", V(3, 3.4, 8), CF(-114, 1.7, 0), "WallGray")
	G.deco("InfoStripe", V(3.1, 0.8, 8.1), CF(-114, 2.6, 0), "Magenta")
	T.planter(CF(-114, 0, -16), 5, 2.6)
	T.planter(CF(-114, 0, 16), 5, 2.6)
	G.box("Bench", V(6, 1.6, 2), CF(-84, 0.8, 14), "WallGray")
	G.box("Bench", V(6, 1.6, 2), CF(-84, 0.8, -14), "WallGray")
	for _, x in { -104, -84 } do
		local lamp = G.deco("HallLight", V(10, 0.4, 2), CF(x, L - 0.6, 0), { RGB(255, 248, 236), M.Neon })
		if x == -84 then
			T.Kit.light(lamp, "PointLight", RGB(255, 246, 230), 26, 0.9)
		end
	end

	------------------------------------------------------------------
	-- Suelo y techo de la galería: franjas de mármol cálido a lo largo del eje (guían la vista hacia
	-- el patio y el atrio) y tiras de luz en el techo de doble altura (solo neón: sin luces nuevas)
	------------------------------------------------------------------
	for _, spec in { { -91, 44 }, { -31, 16 } } do
		for _, z in { -6.5, 6.5 } do
			G.deco("FloorInlay", V(spec[2], 0.04, 0.9), CF(spec[1], 0.02, z), "Inlay").CastShadow = false
		end
	end
	for _, spec in { { -95, 0, 42, true }, { -47, -25, 46, false }, { -47, 25, 46, false } } do
		local size = spec[4] and V(1.2, 0.2, spec[3]) or V(spec[3], 0.2, 1.2)
		local strip = G.deco("CeilingLight", size, CF(spec[1], TOP - 0.15, spec[2]), { Color3.fromRGB(255, 250, 240), Enum.Material.Neon })
		strip.CastShadow = false
	end

	------------------------------------------------------------------
	-- Patio (sitio): quioscos que cortan la galería, jardineras y bancos
	------------------------------------------------------------------
	T.kiosk(CF(-50, 0, -10), RGB(0, 186, 214), "CAFÉ")
	T.kiosk(CF(-50, 0, 11), RGB(250, 140, 30), "ZUMOS")
	T.planter(CF(-62, 0, 0) * CFrame.Angles(0, rad(90), 0), 6, 2.6)
	T.planter(CF(-38, 0, -18), 6, 2.6)
	T.planter(CF(-38, 0, 18), 6, 2.6)
	local courtLamp = G.deco("CourtLight", V(2, 0.4, 2), CF(-50, TOP - 0.6, 0), { RGB(255, 248, 236), M.Neon })
	T.Kit.light(courtLamp, "PointLight", RGB(255, 246, 230), 30, 1)

	------------------------------------------------------------------
	-- BLOX MART: estanterías en hileras (cobertura alta con pasillos) y cajas registradoras
	------------------------------------------------------------------
	for _, z in { -34, -46, -58 } do
		for _, seg in { { -114, -96 }, { -92, -78 } } do
			G.box("Shelf", V(seg[2] - seg[1], 6, 2.4), CF((seg[1] + seg[2]) / 2, 3, z), "WallGray")
			G.deco("ShelfGoods", V(seg[2] - seg[1] - 0.4, 4.6, 2.6), CF((seg[1] + seg[2]) / 2, 3.4, z), { z == -46 and RGB(230, 120, 40) or RGB(40, 140, 200), M.SmoothPlastic })
		end
	end
	for _, x in { -112, -104 } do
		G.box("Checkout", V(3, 3, 6), CF(x, 1.5, -25), "Wall")
	end
	local bloxLamp = G.deco("StoreLight", V(30, 0.4, 2), CF(-95, L - 0.6, -46), { RGB(255, 252, 244), M.Neon })
	T.Kit.light(bloxLamp, "PointLight", RGB(255, 250, 240), 30, 0.9)

	------------------------------------------------------------------
	-- PIXEL WEAR: percheros, mesas de exposición y maniquíes
	------------------------------------------------------------------
	for _, spec in { { -108, 32 }, { -92, 32 }, { -108, 48 }, { -84, 50 }, { -100, 62 } } do
		G.box("DisplayTable", V(8, 2.6, 4), CF(spec[1], 1.3, spec[2]), "Wall")
		G.deco("Clothes", V(7, 0.6, 3.4), CF(spec[1], 2.9, spec[2]), { RGB(226, 40, 140), M.Fabric })
	end
	for _, z in { 30, 42, 54, 66 } do
		G.box("ClothesRack", V(1, 5, 7), CF(-78, 2.5, z), "Steel")
	end
	local pixelLamp = G.deco("StoreLight", V(30, 0.4, 2), CF(-95, L - 0.6, 46), { RGB(255, 252, 244), M.Neon })
	T.Kit.light(pixelLamp, "PointLight", RGB(255, 250, 240), 30, 0.9)

	------------------------------------------------------------------
	-- Pasillo de servicio: cajas, carro y luz fría
	------------------------------------------------------------------
	T.crateStack(CF(-96, 0, -76) * CFrame.Angles(0, rad(90), 0), "L")
	T.crateStack(CF(-56, 0, -76) * CFrame.Angles(0, rad(90), 0), "Wall")
	T.crate(CF(-68, 0, -64), 4)
	T.crate(CF(-68.4, 0, -28) * CFrame.Angles(0, rad(10), 0), 3.6)
	local serviceLamp = G.deco("ServiceLight", V(1.2, 0.3, 12), CF(-68, 9.7, -46), { RGB(220, 236, 255), M.Neon })
	T.Kit.light(serviceLamp, "PointLight", RGB(210, 230, 255), 18, 0.7)

	------------------------------------------------------------------
	-- Pasillos sur, zona de la escalera mecánica y jardineras del anillo
	------------------------------------------------------------------
	G.box("Bench", V(6, 1.6, 2), CF(-50, 0.8, 28), "WallGray")
	T.planter(CF(-40, 0, 72), 6, 2.6)
	T.planter(CF(-30, L, -30), 6, 2.6)
	T.planter(CF(-66, L, -30), 6, 2.6)
	T.planter(CF(-30, L, 30), 6, 2.6)

	------------------------------------------------------------------
	-- Exterior: azotea con máquinas y pretil blanco; fachada con paneles de color y cristal
	------------------------------------------------------------------
	for _, spec in { { -100, -60 }, { -84, -40 }, { -100, 40 }, { -76, 64 }, { -56, -60 }, { -40, 50 } } do
		T.hvac(CF(spec[1], TOP + 1, spec[2]) * CFrame.Angles(0, rad(spec[1] % 90), 0))
	end
	G.deco("RoofEdge", V(1.2, 1.4, 162), CF(-118.2, TOP + 1.2, 0), "Wall")
	G.deco("RoofEdge", V(118, 1.4, 1.2), CF(-59, TOP + 1.2, -80.2), "Wall")
	G.deco("RoofEdge", V(118, 1.4, 1.2), CF(-59, TOP + 1.2, 80.2), "Wall")
	-- Franja de color bajo el pretil (la identidad del centro comercial se lee desde lejos y en la
	-- presentación del mapa: magenta a los lados de los aparcamientos, cian al norte, naranja al sur)
	G.deco("RoofBand", V(0.5, 1.2, 162), CF(-118.95, TOP - 0.4, 0), "Magenta").CastShadow = false
	G.deco("RoofBand", V(118, 1.2, 0.5), CF(-59, TOP - 0.4, -80.95), "Cyan").CastShadow = false
	G.deco("RoofBand", V(118, 1.2, 0.5), CF(-59, TOP - 0.4, 80.95), "Orange").CastShadow = false
	for _, spec in { { -40, "Cyan" }, { -24, "Orange" }, { 24, "Magenta" }, { 40, "Cyan" } } do
		G.deco("FacadePanel", V(0.6, TOP - 2, 8), CF(-118.9, (TOP - 2) / 2 + 1, spec[1]), spec[2]).CastShadow = false
	end
	local glass = G.deco("FacadeGlass", V(0.4, 9, 30), CF(-118.9, 15, 0), "Glass")
	glass.Transparency = 0.3

	------------------------------------------------------------------
	-- Aparcamiento (base): camión de reparto, coches, carros de la compra, árboles y farolas
	------------------------------------------------------------------
	-- (camión y furgoneta a lo largo de la fachada: pasillo de 6 entre ellos y las puertas)
	local truck = CF(-127, 0, -6)
	T.cap(G.solid("BoxTruck", V(6, 7, 15), truck * CF(0, 0.8, 2), "Wall"))
	G.solid("TruckCab", V(6, 5.6, 4.6), truck * CF(0, 0.8, -8), "Magenta")
	G.deco("TruckLogo", V(6.1, 3, 8), truck * CF(0, 5, 2), "Cyan")
	for _, z in { -8, 0, 6 } do
		for _, x in { -2.9, 2.9 } do
			T.Kit.pipe("TruckWheel", 0.9, 2.2, truck * CF(x, 1.1, z), RGB(24, 24, 26), M.Rubber, true)
		end
	end
	T.cap(T.van(CF(-127, 0, 14), RGB(226, 40, 140)))
	-- Tótem publicitario entre el camión y la furgoneta
	T.cap(G.box("AdTotem", V(2.6, 9, 4), CF(-127, 4.5, 5.5), "Magenta"))
	T.sign(CF(-125.6, 6, 5.5) * CFrame.Angles(0, -math.pi / 2, 0), "SALE -50%", 3.6, 5, RGB(226, 40, 140), RGB(255, 255, 255), { PPS = 20 })
	T.Kit.car(CF(-142, 0, 40) * CFrame.Angles(0, rad(90), 0), RGB(40, 120, 220))
	T.Kit.car(CF(-142, 0, -42) * CFrame.Angles(0, rad(-90), 0), RGB(240, 240, 244))
	for z = -54, 54, 12 do
		G.paintLine(V(-150, 0, z), V(-138, 0, z), 0.4, "Paint")
	end
	T.lampPost(CF(-122, 0, -30) * CFrame.Angles(0, rad(90), 0))
	T.lampPost(CF(-122, 0, 30) * CFrame.Angles(0, rad(90), 0))
	for i = 0, 2 do
		G.deco("ShoppingCart", V(2, 2.4, 3), CF(-121, 1.2, 30 + i * 1.2), "Steel")
	end
end

return Props
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">MetroYard</string>
              <string name="Source"><![CDATA[-- METRO YARD (5v5 · Duelo por equipos · Buscar y destruir): estación de metro con su playa de vías.
-- El sitio A está en el vestíbulo de la estación (norte) y el B en las cocheras (sur, el taller).
-- En medio, las vías van en dos zanjas a −3 con trenes aparcados (cobertura alta y divisoria) y un
-- andén central con marquesina; por encima cruza la pasarela (10) de la estación a las cocheras.
-- Cada equipo sale de una cochera de autobuses junto a la calle, con el túnel de las vías delante
-- (por dentro: interior; por arriba: posición alta sobre la playa de vías).
local T = require(script.Parent.Parent.TacKit)
local Lighting = require(script.Lighting)
local Geometry = require(script.Geometry)
local Props = require(script.Props)

local Map = {
	Id = "MetroYard",
	Name = "Metro Yard",
	Icon = "🚇",
	Description = "Estación, vías y cocheras · 5 contra 5",
	Realistic = true,
	Bomb = true,
	Palette = "MetroYard",
	Ambience = "Breeze",
	Modes = { "TDM", "SND" },
	RecommendedPlayers = 10,
	Bounds = Vector3.new(300, 70, 220),
}

Map.Lighting = Lighting.Default
Map.LightingVariants = Lighting.Variants

local V = Vector3.new
local CF = CFrame.new

function Map.Build()
	local folder = T.begin(Map)
	Geometry.build(T)
	Props.build(T)

	local redBase = CFrame.lookAt(V(-140, 0, 0), V(-100, 0, 0))
	local points = { V(-8, 0, 2), V(-4, 0, -3), V(0, 0, 2), V(4, 0, -3), V(8, 0, 2) }
	T.spawnZone(1, redBase, { Size = Vector2.new(24, 14), Points = points })
	T.spawnZone(2, T.mirrorCFrame(redBase), { Size = Vector2.new(24, 14), Points = points })
	T.flagBase(1, CF(-138, 0, -34))
	T.flagBase(2, CF(138, 0, -34))

	T.site(V(0, 0, -78), "A")
	T.site(V(0, 0, 74), "B", { Color = Color3.fromRGB(46, 110, 220) })

	T.zone(V(0, 10, -22), 7, 1)
	T.zone(V(0, 0, 74), 9, 2)
	T.zone(V(-74, 0, 0), 8, 3)
	T.zone(V(0, 0, -78), 9, 4)
	T.zone(V(74, 0, 0), 8, 5)

	T.callout("ESTACIÓN", CF(0, 10, -70), V(98, 20, 58))
	T.callout("ENTREPLANTA", CF(0, 14, -46), V(98, 8, 11))
	T.callout("TORNIQUETES", CF(0, 3, -60), V(80, 6, 6))
	T.callout("COCHERAS", CF(0, 8, 72), V(98, 16, 54))
	T.callout("GALERÍA", CF(0, 14, 48), V(28, 8, 8))
	T.callout("PASARELA", CF(0, 14, 2), V(6, 8, 84))
	T.callout("ANDÉN CENTRAL", CF(0, 4, 0), V(120, 8, 10))
	T.callout("ANDÉN NORTE", CF(0, 4, -35), V(180, 8, 10))
	T.callout("ANDÉN SUR", CF(0, 4, 37), V(180, 8, 14))
	T.callout("VÍAS NORTE", CF(0, 1, -17.5), V(120, 8, 25))
	T.callout("VÍAS SUR", CF(0, 1, 17.5), V(120, 8, 25))
	for _, m in { -1, 1 } do
		local function at(x, y, z)
			return CF(m * x, y, z)
		end
		T.callout("TÚNEL", at(75, 3, 0), V(30, 12, 60))
		T.callout("TECHO DEL TÚNEL", at(75, 13, 0), V(30, 8, 62))
		T.callout("CALLE", at(105, 4, 0), V(30, 10, 220))
		T.callout("PLAZA", at(85, 4, -72), V(70, 10, 60))
		T.callout("PATIO", at(85, 4, 76), V(70, 10, 64))
	end

	for _, p in {
		V(-140, 0.5, -32), V(-105, 0.5, -40), V(-100, 0.5, 40), V(-72, 0.5, 0), V(-75, 10.5, -10),
		V(-40, 0.5, -35), V(-40, 0.5, 35), V(-30, -2.5, -15), V(-30, -2.5, 20), V(-30, 0.5, -80),
		V(-36, 10.5, -46), V(-30, 0.5, 60), V(-90, 0.5, -60), V(-80, 0.5, 86), V(-48, 0.5, 2.5),
	} do
		T.ffa(p)
		T.ffa(T.mirrorPoint(p))
	end
	for _, spot in {
		{ V(-64, 10, -20), V(0, 0, -35) }, -- techo del túnel, al andén norte
		{ V(-36, 10, -46), V(0, 0, -78) }, -- entreplanta, al sitio A
		{ V(-10, 10, 48), V(0, 0, 74) }, -- galería de las cocheras, al sitio B
		{ V(-74, 0, 0), V(0, 0, 0) }, -- boca del túnel, a la playa de vías
	} do
		T.botSpot(spot[1], spot[2])
		T.botSpot(T.mirrorPoint(spot[1]), T.mirrorPoint(spot[2]))
	end

	T.Kit.bounds(Map.Bounds.X, Map.Bounds.Z, Map.Bounds.Y)
	return folder
end

return Map
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="99">
              <Properties>
                <string name="Name">Geometry</string>
                <string name="Source"><![CDATA[-- METRO YARD · geometría jugable (blockout). Estación de metro con su playa de vías:
--
--   z -100 ┌──────────────────── ESTACIÓN (vestíbulo, sitio A; entreplanta a 10) ─────────────────┐
--  PLAZA   │  puerta oeste      torniquetes                                       puerta este      │ PLAZA
--   z  -40 └──── puerta ────────────────── pasarela ──────────────────── puerta ─────────────────┘
--  CALLE  ═ ANDÉN NORTE ═══════════════════════╪═══════════════════════════════ ANDÉN NORTE ═  CALLE
--  BASE   [TÚNEL] zanja (−3): vías 1 y 2, tren  │ pasarela (10) con escaleras al andén central [TÚNEL] BASE
--  ROJA   [ (10) ] ANDÉN CENTRAL (marquesina) ═ núcleo ═ ANDÉN CENTRAL                  [ (10) ] AZUL
--         [TÚNEL] zanja (−3): vías 3 y 4, tren  │                                         [TÚNEL]
--  CALLE  ═ ANDÉN SUR ═════════════════════════╪═══════════════════════════════ ANDÉN SUR ══  CALLE
--   z   44 ┌──── puerta ────────────────── galería ───────────────────── puerta ─────────────────┐
--  PATIO   │                     COCHERAS (taller, sitio B)                                      │ PATIO
--   z  100 └─────────────────────────────────────────────────────────────────────────────────────┘
--
-- Simétrico en X = 0. Alturas: suelo 0, zanjas de las vías −3, y a 10 la entreplanta de la
-- estación, la pasarela, la galería de las cocheras y el techo de los túneles.
local Geometry = {}

local V = Vector3.new
local CF = CFrame.new

local TRENCH = -3
local UP = 10

-- Losa de suelo (de TRENCH a 0) en el rectángulo dado: los lados de las losas son las paredes de
-- las zanjas de las vías
local function plate(G, x0, x1, z0, z1, look)
	return G.box("Ground", V(x1 - x0, -TRENCH + 0.3, z1 - z0), CF((x0 + x1) / 2, (TRENCH - 0.3) / 2, (z0 + z1) / 2), look)
end
Geometry.plate = plate

function Geometry.build(T)
	local G = T.G
	local M = Enum.Material
	local door = G.door

	T.terrain(M.Asphalt, 1200, 1200, CF(0, TRENCH - 0.6, 0))

	---------------------------------------------------------------------------
	-- Suelo: losas a 0 y fondo de las zanjas a −3 (con las vías)
	---------------------------------------------------------------------------
	plate(G, -152, 152, -112, -30, "Concrete")
	plate(G, -152, 152, 30, 112, "Concrete")
	plate(G, -90, 90, -5, 5, "Platform")
	G.floor(CF(0, TRENCH, 0), 180, 60, "Ballast", 1)
	for _, z in { -24, -11, 11, 24 } do
		T.track(V(-90, TRENCH, z), V(90, TRENCH, z))
	end
	-- Bordes de andén: línea amarilla y franja de botones
	for _, z in { -30.4, -5.4, 5.4, 30.4 } do
		G.paintLine(V(-90, 0, z), V(90, 0, z), 0.5, "YellowPaint")
	end

	---------------------------------------------------------------------------
	-- ESTACIÓN (vestíbulo de doble altura con entreplanta al sur; sitio A dentro)
	---------------------------------------------------------------------------
	G.shell(CF(0, 0, -70), 100, 60, 20, "Wall", {
		Front = {},
		Back = { door(-26, 8, 9), door(26, 8, 9), door(0, 6, 7.5, UP) },
		Left = { door(-4, 8, 9) },
		Right = { door(-4, 8, 9) },
	}, { Frame = "WallBlue" })
	G.deco("HallFloor", V(99, 0.1, 59), CF(0, 0.05, -70), "Tile").CastShadow = false
	G.slab(CF(0, UP, -46), 99, 11, "Tile")
	T.cap(G.slab(CF(0, 20.5, -70), 100, 60, "ConcreteDark", { { 0, -6, 60, 10 } }))
	local sky = G.deco("HallSkylight", V(60, 0.3, 10), CF(0, 20.8, -76), "Glass")
	sky.Transparency = 0.4
	T.cap(sky)
	-- Luces del techo del vestíbulo
	for _, x in { -30, 0, 30 } do
		local panel = G.deco("HallLight", V(14, 0.2, 2), CF(x, 19.8, -66), { Color3.fromRGB(240, 246, 255), Enum.Material.Neon })
		panel.CastShadow = false
		T.Kit.light(panel, "PointLight", Color3.fromRGB(236, 242, 255), 34, 1.1)
	end
	-- (cabina central de la línea de torniquetes)
	G.box("GateBooth", V(3, 4, 3), CF(0, 2, -60), "WallBlue")

	---------------------------------------------------------------------------
	-- COCHERAS (taller con dos coches en mantenimiento; sitio B dentro)
	---------------------------------------------------------------------------
	G.shell(CF(0, 0, 72), 100, 56, 16, "Shed", {
		Front = { door(-24, 10, 12), door(24, 10, 12), door(0, 6, 5.5, UP) },
		Back = {},
		Left = { door(-2, 8, 9) },
		Right = { door(-2, 8, 9) },
	}, { Frame = "Orange" })
	for _, x in { -30, 0, 30 } do
		local panel = G.deco("ShedLight", V(12, 0.2, 2), CF(x, 15.7, 70), { Color3.fromRGB(255, 240, 214), Enum.Material.Neon })
		panel.CastShadow = false
		T.Kit.light(panel, "PointLight", Color3.fromRGB(255, 236, 206), 32, 1.1)
	end
	G.deco("ShedFloor", V(99, 0.1, 55), CF(0, 0.05, 72), "ConcreteDark").CastShadow = false
	T.cap(G.slab(CF(0, 16.5, 72), 100, 56, "Shed", { { -24, 2, 12, 36 }, { 24, 2, 12, 36 } }))
	for _, x in { -24, 24 } do
		local roofLight = G.deco("ShedSkylight", V(12, 0.3, 36), CF(x, 16.8, 74), "Glass")
		roofLight.Transparency = 0.4
		T.cap(roofLight)
	end
	G.floor(CF(0, UP, 48), 28, 7.8, "Deck")
	G.railing(V(-14, UP, 51.8), V(14, UP, 51.8), "Yellow", 3.2, { Cap = true })

	---------------------------------------------------------------------------
	-- PASARELA (10) de la estación a las cocheras, cubierta, con escaleras al andén central
	---------------------------------------------------------------------------
	G.floor(CF(0, UP, 2), 6, 84, "Deck", 0.8)
	for _, s in { -1, 1 } do
		for _, seg in { { -40, -2.4 }, { 2.4, 44 } } do
			G.railing(V(s * 2.8, UP, seg[1]), V(s * 2.8, UP, seg[2]), "Yellow", 3.2, { Cap = true })
		end
		local glass = G.deco("BridgeGlass", V(0.2, 6.6, 84), CF(s * 3.05, UP + 3.6, 2), "Glass")
		glass.Transparency = 0.6
		glass.CastShadow = false
		G.stairs(V(s * 17, 0, 0), V(s * 3, UP, 0), 4, "Steel", { Rails = "Both", Cap = true, Closed = true })
	end
	T.cap(G.deco("BridgeRoof", V(7, 0.4, 82), CF(0, UP + 7.2, 2), "SteelDark"))
	-- Faldón opaco a los lados de la pasarela por encima de la barandilla: corta la línea entre
	-- los techos de los dos túneles (de pie no se ven por encima de la playa de vías)
	for _, s in { -1, 1 } do
		G.box("BridgeCladding", V(0.4, 4.2, 79), CF(s * 3.2, UP + 5.3, 2), "WallBlue")
	end
	for _, z in { -30, -18, 18, 30 } do
		G.deco("BridgeFrame", V(6.6, 0.5, 0.5), CF(0, UP + 6.9, z), "Orange")
	end
	-- Bajo la pasarela: núcleos en los andenes norte y sur, el del ascensor en el andén central y
	-- una pila-muro en las zanjas. Con las casetas de relés de cada mitad forman una chicana: se
	-- pasa de un lado al otro, pero no hay línea de vista de túnel a túnel por ninguna zanja
	-- (sin clip encima: la pasarela los cubre de lado a lado)
	G.solid("NorthCore", V(6, UP - 0.8, 10), CF(0, 0, -35), "WallBlue")
	G.solid("SouthCore", V(6, UP - 0.8, 13.5), CF(0, 0, 37.25), "WallBlue")
	G.solid("LiftCore", V(6, UP - 0.8, 10), CF(0, 0, 0), "WallBlue")
	G.solid("BridgePier", V(3.2, UP - 0.8 - TRENCH, 30), CF(0, TRENCH, 0), "Concrete")
	T.relayCabinet(CF(0, TRENCH, -28.6), 9.4)
	T.glassRail(V(-3.2, UP, -51.6), V(3.2, UP, -51.6))
	for _, z in { -35, 37 } do
		for _, s in { -1, 1 } do
			T.sign(CF(s * 3.15, 6.5, z) * CFrame.Angles(0, -s * math.pi / 2, 0), "M", 3, 3, Color3.fromRGB(40, 96, 196), Color3.new(1, 1, 1))
		end
	end

	T.mirrored("MetroHalf", function()
		Geometry.half(T)
	end)
end

-- Mitad del Rojo (X < 0)
function Geometry.half(T)
	local G = T.G
	local door = G.door

	------------------------------------------------------------------
	-- BASE: cocheras de autobús cerradas (frente ciego, puertas norte y sur con vestíbulo en L)
	------------------------------------------------------------------
	for _, z in { -24, 24 } do
		T.cap(G.wall(CF(-136.25, 0, z), 27.5, 9, "Wall", { door(10.75, 5, 7.4) }))
		T.cap(G.wall(CF(-127.75, 0, z * 0.81), 10.5, 9, "Wall"))
	end
	T.cap(G.wall(CF(-122.5, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0), 48.6, 9, "Wall"))
	T.cap(G.wall(CF(-149.5, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0), 48.6, 9, "Wall"))
	T.cap(G.floor(CF(-136, 9.6, 0), 28, 49, "SteelDark", 0.6))
	G.deco("BaseStripe", V(0.3, 1.2, 40), CF(-122.1, 6.5, 0), "Orange")

	------------------------------------------------------------------
	-- TÚNEL (x −90 a −60): zanjas y andén central cubiertos; techo transitable a 10
	------------------------------------------------------------------
	for _, z in { -30.5, 30.5 } do
		G.box("TunnelWall", V(30, UP + 0.5, 1), CF(-75, UP / 2 - 0.25, z), "Tunnel")
	end
	-- Muro oeste: puerta al andén central desde la calle
	G.wall(CF(-90.5, TRENCH, 0) * CFrame.Angles(0, -math.pi / 2, 0), 60, UP - TRENCH, "Tunnel", { door(0, 8, 8, -TRENCH) })
	plate(G, -152, -91, -30, 30, "Concrete")
	G.floor(CF(-75, UP, 0), 31, 62, "Tunnel", 1)
	G.deco("PortalFrame", V(1.2, 2, 62), CF(-60.4, UP - 1, 0), "Orange")
	for _, x in { -84, -76, -68 } do
		for _, z in { -4.4, 4.4 } do
			G.column(CF(x, 0, z), UP - 1, 1.2, "Concrete")
		end
	end
	for _, z in { -24, -11, 11, 24 } do
		T.bufferStop(CF(-88.4, TRENCH, z) * CFrame.Angles(0, -math.pi / 2, 0))
	end
	-- Pretiles del techo del túnel (hueco donde llegan las escaleras de la calle)
	T.cap(G.parapet(V(-60.5, UP, -31), V(-60.5, UP, 31), 3.2, "Concrete", 1))
	T.cap(G.parapet(V(-90, UP, -30.5), V(-60, UP, -30.5), 3.2, "Concrete", 1))
	T.cap(G.parapet(V(-90, UP, 30.5), V(-60, UP, 30.5), 3.2, "Concrete", 1))
	for _, seg in { { -31, -24.5 }, { -19.5, 19.5 }, { 24.5, 31 } } do
		T.cap(G.parapet(V(-89.6, UP, seg[1]), V(-89.6, UP, seg[2]), 3.2, "Concrete", 1))
	end
	for _, z in { -22, 22 } do
		G.stairs(V(-104, 0, z), V(-90, UP, z), 5, "Concrete", { Rails = "Both", Cap = true, Closed = true })
	end

	------------------------------------------------------------------
	-- Vallas entre las plazas y los andenes (con puerta)
	------------------------------------------------------------------
	for _, z in { -40.5, 40.5 } do
		T.cap(G.hoarding(V(-90, 0, z), V(-74, 0, z), 3.4, "WallBlue", { Stripe = "Orange" }))
		T.cap(G.hoarding(V(-66, 0, z), V(-50, 0, z), 3.4, "WallBlue", { Stripe = "Orange" }))
	end

	------------------------------------------------------------------
	-- ESTACIÓN (mitad): escalera a la entreplanta, torniquetes, barandilla de cristal
	------------------------------------------------------------------
	G.stairs(V(-44, 0, -68), V(-44, UP, -52), 5, "TileDark", { Rails = "Both", RailLook = "Steel", Cap = true, Closed = true })
	T.glassRail(V(-41.4, UP, -51.6), V(-3.2, UP, -51.6))
	T.glassRail(V(-49.4, UP, -51.6), V(-46.6, UP, -51.6))
	T.cap(T.turnstiles(CF(-19.5, 0, -60), 7))

	-- Taquilla delante de la puerta oeste (desde la puerta no se ve el vestíbulo de lado a lado)
	T.cap(G.solid("TicketOffice", V(3, 7.5, 10), CF(-40, 0, -74), "WallBlue"))
	G.deco("TicketOfficeTop", V(3.2, 0.6, 10.2), CF(-40, 7.2, -74), "Orange").CastShadow = false

	-- Muros de cierre detrás de la estación y de las cocheras (no hay paso por detrás)
	for _, z in { -100, 100 } do
		T.cap(G.wall(CF(-50.5, 0, z + (z < 0 and -6 or 6)) * CFrame.Angles(0, -math.pi / 2, 0), 12, 9, "Concrete"))
	end

	------------------------------------------------------------------
	-- COCHERAS (mitad): escalera de la galería
	------------------------------------------------------------------
	G.stairs(V(-28, 0, 48), V(-14, UP, 48), 4, "Steel", { Rails = "Both", Cap = true, Closed = true })

	------------------------------------------------------------------
	-- Casetas de relés de la chicana central de las zanjas
	------------------------------------------------------------------
	for _, spec in { { -16.4, 8.8 }, { 21, 18 } } do
		T.cap(G.solid("RelayHut", V(3, 9, spec[2]), CF(-7, TRENCH, spec[1]), "ConcreteDark"))
		G.deco("RelayHutStripe", V(3.1, 0.6, spec[2] + 0.1), CF(-7, TRENCH + 8.2, spec[1]), "Orange").CastShadow = false
	end
end

return Geometry
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="100">
              <Properties>
                <string name="Name">Lighting</string>
                <string name="Source"><![CDATA[-- METRO YARD · luz. Tarde urbana templada (sol bajo que entra por la playa de vías, cielo algo
-- velado); variantes de atardecer naranja y de noche (marquesinas, túnel y ciudad encendidos).
local RGB = Color3.fromRGB
local V = Vector3.new

local Lighting = {}

Lighting.Default = {
	ClockTime = 15.2,
	Latitude = 38,
	Brightness = 2.8,
	Exposure = 0,
	Ambient = RGB(104, 106, 116),
	OutdoorAmbient = RGB(150, 152, 164),
	ShadowSoftness = 0.2,
	Atmosphere = { Density = 0.32, Offset = 0.1, Color = RGB(206, 212, 224), Decay = RGB(130, 140, 162), Glare = 0.2, Haze = 1.5 },
	Color = { Saturation = 0.08, Contrast = 0.12, Brightness = 0.01, Tint = RGB(255, 250, 244) },
	Bloom = { Intensity = 0.35, Size = 22, Threshold = 2 },
	Clouds = 0.55,
	CloudColor = RGB(240, 242, 246),
	SunRays = 0.06,
	Wind = V(8, 0, 3),
	TerrainColors = { Asphalt = RGB(70, 72, 76) },
}

Lighting.Variants = {
	{
		Name = "Atardecer",
		Chance = 0.3,
		ClockTime = 17.9,
		Brightness = 2.2,
		Ambient = RGB(112, 92, 96),
		OutdoorAmbient = RGB(168, 132, 124),
		Atmosphere = { Density = 0.32, Offset = 0.08, Color = RGB(250, 184, 140), Decay = RGB(156, 104, 112), Glare = 0.6, Haze = 1.4 },
		Color = { Saturation = 0.14, Contrast = 0.12, Brightness = 0.01, Tint = RGB(255, 232, 214) },
		CloudColor = RGB(255, 188, 150),
		SunRays = 0.12,
	},
	{
		Name = "Noche",
		Chance = 0.25,
		ClockTime = 21.5,
		Brightness = 1.1,
		Exposure = 0.35,
		Ambient = RGB(70, 74, 98),
		OutdoorAmbient = RGB(84, 92, 124),
		Atmosphere = { Density = 0.3, Offset = 0.06, Color = RGB(62, 70, 104), Decay = RGB(28, 30, 52), Glare = 0, Haze = 1 },
		Color = { Saturation = 0.08, Contrast = 0.14, Brightness = 0.03, Tint = RGB(216, 224, 255) },
		Bloom = { Intensity = 0.65, Size = 24, Threshold = 1.5 },
		Clouds = 0.3,
		CloudColor = RGB(72, 78, 104),
		SunRays = 0,
	},
}

return Lighting
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="101">
              <Properties>
                <string name="Name">Props</string>
                <string name="Source"><![CDATA[-- METRO YARD · props: trenes (la gran cobertura y el hito), marquesina del andén central, mobiliario
-- de estación (torniquetes, máquinas, bancos, paneles), taller de las cocheras, patio de servicio
-- con contenedores, plaza de la estación y la ciudad con un viaducto de metro al fondo.
local Props = {}

local V = Vector3.new
local CF = CFrame.new
local RGB = Color3.fromRGB
local rad = math.rad
local M = Enum.Material

local TRENCH = -3
local UP = 10
local ALONG_X = CFrame.Angles(0, math.pi / 2, 0)

-- Autobús articulado de la calle (choca: cobertura alta). Mira a -Z
local function bus(T, cf)
	local G = T.G
	local body = G.box("Bus", V(8, 8.4, 26), cf * CF(0, 4.6, 0), { RGB(230, 232, 236), M.SmoothPlastic })
	for _, s in { -1, 1 } do
		G.deco("BusWindows", V(0.12, 2.6, 23), cf * CF(s * 4.02, 5.8, 0.5), { RGB(34, 42, 54), M.Glass }).CastShadow = false
		G.deco("BusStripe", V(0.12, 0.8, 26), cf * CF(s * 4.02, 3.2, 0), "Orange").CastShadow = false
		for _, z in { -8, 8 } do
			Kit_wheel(T, cf * CF(s * 3.6, 1.2, z))
		end
	end
	G.deco("BusFront", V(7, 3, 0.12), cf * CF(0, 6, -13.06), { RGB(34, 42, 54), M.Glass }).CastShadow = false
	return body
end

function Kit_wheel(T, cf)
	T.Kit.cylinder("Wheel", 1, 2.4, cf * CFrame.Angles(0, 0, rad(90)), RGB(30, 30, 34), M.SmoothPlastic, nil, true)
end

function Props.build(T)
	local G = T.G
	local night = T.isNight()

	---------------------------------------------------------------------------
	-- ESTACIÓN (centro): letrero, kiosco de información, panel de salidas, letra A
	---------------------------------------------------------------------------
	T.sign(CF(0, 15, -39.3) * CFrame.Angles(0, math.pi, 0), "METRO · CENTRAL", 30, 3.2, RGB(40, 96, 196), RGB(255, 255, 255), { PPS = 16 })
	T.letterBanner(CF(0, 9, -99.2), "A", "Red", 6, 6.4)
	T.cap(G.solid("InfoBooth", V(8, 4, 4), CF(0, 0, -94), "WallBlue"))
	T.sign(CF(0, 5.2, -91.9) * CFrame.Angles(0, math.pi, 0), "INFO", 4, 1, RGB(240, 128, 36), RGB(255, 255, 255))
	T.departureBoard(CF(0, 7, -60), "M2 CENTRO  2 min")
	for _, x in { -30, 30 } do
		T.departureBoard(CF(x, UP + 6, -51.6), "M1 PUERTO  4 min")
	end

	---------------------------------------------------------------------------
	-- COCHERAS (centro): letrero, letra B, puente grúa
	---------------------------------------------------------------------------
	T.sign(CF(0, 13.2, 43.4), "COCHERAS · DEPOT", 26, 3, RGB(240, 128, 36), RGB(255, 255, 255), { PPS = 16 })
	T.letterBanner(CF(0, 8, 99.2) * CFrame.Angles(0, math.pi, 0), "B", "Blue", 6, 6.4)
	for _, z in { 60, 90 } do
		G.deco("CraneRail", V(98, 0.8, 0.8), CF(0, 14.4, z), "SteelDark")
	end
	G.deco("CraneBridge", V(1.2, 1.4, 30), CF(-20, 13.4, 75), "Orange")
	G.deco("CraneBridge", V(1.2, 1.4, 30), CF(20, 13.4, 75), "Orange")

	---------------------------------------------------------------------------
	-- Pasarela: carteles de dirección
	---------------------------------------------------------------------------
	T.sign(CF(0, UP + 5.6, -30) , "A ESTACIÓN ↑   B COCHERAS ↓", 5.6, 0.9, RGB(30, 34, 40), RGB(255, 200, 120), { Back = true, PPS = 30 })

	T.mirrored("MetroProps", function()
		Props.half(T)
	end)

	---------------------------------------------------------------------------
	-- Fondo: ciudad y viaducto de metro (decorado)
	---------------------------------------------------------------------------
	local palette = { RGB(170, 172, 176), RGB(120, 136, 160), RGB(196, 194, 188), RGB(150, 96, 76), RGB(98, 108, 124) }
	T.skylineRing(V(0, 0, 0), 230, 0, 355, 10, palette, { Lit = night, MinH = 30, VarH = 40, TowerEvery = 4, TowerExtra = 40, FloorH = 6 })
	for _, z in { -170 } do
		for x = -240, 240, 40 do
			G.deco("ViaductPier", V(4, 20, 4), CF(x, 10, z), "Concrete").CastShadow = false
		end
		G.deco("Viaduct", V(500, 3, 12), CF(0, 21.5, z), "Concrete").CastShadow = false
		for _, x in { -70, -48.5, -27 } do
			local car = G.deco("ViaductCar", V(21, 7.6, 6.4), CF(x, 27, z), "Train")
			car.CastShadow = false
			G.deco("ViaductStripe", V(21, 0.7, 6.5), CF(x, 25.8, z), "Orange").CastShadow = false
		end
	end
end

-- Mitad del Rojo (X < 0)
function Props.half(T)
	local G = T.G
	local night = T.isNight()

	------------------------------------------------------------------
	-- Trenes: dos coches en la vía 1 (norte), uno en la 3 y otro aparcado en el túnel (vía 4);
	-- carro de mantenimiento en la vía 2
	------------------------------------------------------------------
	T.cap(T.train(CF(-31, TRENCH, -24) * ALONG_X, 2, 20, { Label = "M2 · CENTRO" }))
	T.cap(T.metroCar(CF(-28, TRENCH, 11) * ALONG_X, 20, { Cab = "Both", Label = "M1 · PUERTO", Stripe = "Blue" }))
	T.cap(T.metroCar(CF(-76, TRENCH, 24) * ALONG_X, 20, { Cab = "Both", Label = "FUERA DE SERVICIO" }))
	T.cap(T.trolley(CF(-48, TRENCH, -11) * ALONG_X))
	for _, x in { -28, -56 } do
		for _, z in { -17.5, 17.5 } do
			T.gantry(CF(x, TRENCH, z) * ALONG_X, 25, 11)
		end
	end

	------------------------------------------------------------------
	-- Andén central: marquesina, bancos, máquina de bebidas, panel
	------------------------------------------------------------------
	for _, x in { -54, -42, -30, -22 } do
		G.column(CF(x, 0, 0), 8.2, 0.8, "Steel")
	end
	T.cap(G.box("PlatformCanopy", V(38, 0.5, 11), CF(-38, 8.45, 0), "SteelDark"))
	G.deco("CanopyEdge", V(38, 0.6, 0.3), CF(-38, 8.1, -5.6), "Orange").CastShadow = false
	G.deco("CanopyEdge", V(38, 0.6, 0.3), CF(-38, 8.1, 5.6), "Orange").CastShadow = false
	local strip = G.deco("CanopyLight", V(30, 0.2, 0.8), CF(-38, 8.1, 0), { RGB(236, 244, 255), M.Neon })
	strip.CastShadow = false
	T.Kit.light(strip, "PointLight", RGB(236, 244, 255), 22, night and 1.2 or 0.5)
	T.bench(CF(-26, 0, 3.4))
	T.bench(CF(-46, 0, -3.4) * CFrame.Angles(0, math.pi, 0))
	T.vending(CF(-36, 0, 3.6) * CFrame.Angles(0, math.pi, 0))
	T.departureBoard(CF(-38, 6, 0) * ALONG_X, "M2 CENTRO  2 min")
	-- Andén dentro del túnel: luces y bancos
	for _, z in { -17, 17 } do
		local lamp = G.deco("TunnelLamp", V(10, 0.3, 0.8), CF(-75, UP - 1.2, z), { RGB(255, 226, 170), M.Neon })
		lamp.CastShadow = false
		T.Kit.light(lamp, "PointLight", RGB(255, 220, 160), 24, night and 1.4 or 0.9)
	end
	T.bench(CF(-80, 0, 3.4))

	------------------------------------------------------------------
	-- Andenes norte y sur
	------------------------------------------------------------------
	T.cap(G.solid("NewsKiosk", V(7, 6, 6), CF(-30, 0, -37), "Orange"))
	T.sign(CF(-30, 6.8, -33.9) * CFrame.Angles(0, math.pi, 0), "PRENSA", 5, 1, RGB(40, 96, 196), RGB(255, 255, 255))
	T.vending(CF(-52, 0, -31.4) * CFrame.Angles(0, math.pi, 0), RGB(40, 96, 196))
	T.bench(CF(-14, 0, -31.4))
	T.ticketMachine(CF(-70, 0, -38.8) * CFrame.Angles(0, math.pi, 0))
	T.ticketMachine(CF(-66.6, 0, -38.8) * CFrame.Angles(0, math.pi, 0))
	-- Andén sur (delante de las cocheras): palés, carro y vallas
	T.cap(T.crateStack(CF(-30, 0, 38) * CFrame.Angles(0, rad(8), 0), "Wall"))
	T.jersey(CF(-52, 0, 33) * ALONG_X, 6)
	T.cableSpool(CF(-14, 0, 34))
	T.workLight(CF(-62, 0, 41))

	------------------------------------------------------------------
	-- ESTACIÓN (mitad): pilares, máquinas de billetes, bancos, jardinera
	------------------------------------------------------------------
	for _, z in { -66, -88 } do
		G.column(CF(-16, 0, z), 20, 2.2, "Wall", "HallColumn")
		G.deco("ColumnBand", V(2.4, 1, 2.4), CF(-16, 8, z), "WallBlue")
	end
	for _, z in { -84, -88.4, -92.8 } do
		T.ticketMachine(CF(-48, 0, z) * CFrame.Angles(0, -math.pi / 2, 0))
	end
	T.vending(CF(-32, 0, -97.6))
	T.bench(CF(-11.5, 0, -84) * CFrame.Angles(0, rad(90), 0))
	T.cap(T.planter(CF(-30, 0, -74), 8, 3))
	T.ticketMachine(CF(-10, 0, -70))
	T.ticketMachine(CF(-7.4, 0, -70))
	T.departureBoard(CF(-26, 7, -60), "M1 PUERTO  4 min")
	-- Toldo sobre la puerta oeste
	T.cap(G.box("EntranceCanopy", V(5, 0.5, 14), CF(-52.6, 10.2, -74), "Orange"))

	------------------------------------------------------------------
	-- COCHERAS (mitad): coche en mantenimiento, banco de trabajo, estanterías
	------------------------------------------------------------------
	T.track(V(-49, 0, 84), V(-6, 0, 84), { Step = 4 })
	T.cap(T.metroCar(CF(-30, 0.4, 84) * ALONG_X, 20, { Cab = "Front", Label = "TALLER" }))
	for _, x in { -36, -24 } do
		G.deco("Jack", V(1.6, 1, 1.6), CF(x, 0.5, 80), "YellowPaint")
	end
	T.cap(G.solid("WorkBench", V(8, 3.4, 2.6), CF(-26, 0, 72), "SteelDark"))
	T.cap(T.crateStack(CF(-12, 0, 66) * CFrame.Angles(0, rad(-12), 0), "L"))
	T.cableSpool(CF(-11, 0, 84))
	for _, x in { -40, -24 } do
		T.cap(G.solid("PartsRack", V(12, 8, 2.6), CF(x, 0, 97.6), "Orange"))
	end
	T.trolley(CF(-44, 0, 64))

	------------------------------------------------------------------
	-- BASE (cochera de autobuses): interior y calle
	------------------------------------------------------------------
	local lamp = G.deco("BaseLight", V(16, 0.3, 1.2), CF(-136, 9.2, 0), { RGB(240, 246, 255), M.Neon })
	T.Kit.light(lamp, "PointLight", RGB(236, 244, 255), 20, 0.8)
	T.cap(T.crateStack(CF(-146, 0, -14), "L"))
	T.cap(bus(T, CF(-110, 0, 64)))
	T.Kit.car(CF(-112, 0, -58), RGB(240, 200, 40))
	T.Kit.car(CF(-98, 0, 92) * CFrame.Angles(0, math.pi, 0), RGB(200, 60, 50))
	for _, z in { -96, -40, 40, 96 } do
		T.streetLight(CF(-121, 0, z))
	end
	for _, z in { -60, 0, 60 } do
		G.paintLine(V(-105, 0.02, z - 12), V(-105, 0.02, z + 12), 0.5, "YellowPaint")
	end
	G.deco("Sidewalk", V(4, 0.3, 220), CF(-122, 0.15, 0), "Sidewalk").CastShadow = false
	G.deco("Street", V(28, 0.1, 220), CF(-105, 0.05, 0), "Asphalt").CastShadow = false
	G.deco("PlazaPaving", V(38, 0.1, 58), CF(-69, 0.05, -71), "Tile").CastShadow = false

	------------------------------------------------------------------
	-- PLAZA DE LA ESTACIÓN (norte)
	------------------------------------------------------------------
	T.metroTotem(CF(-58, 0, -88))
	T.cap(T.planter(CF(-80, 0, -64), 8, 3))
	T.cap(T.planter(CF(-70, 0, -92) * ALONG_X, 8, 3))
	T.tree(CF(-80, 0, -64))
	T.tree(CF(-70, 0, -92))
	T.cap(T.kiosk(CF(-96, 0, -80), RGB(240, 128, 36), "CAFÉ"))
	for _, x in { -64, -88 } do
		T.bollard(CF(x, 0, -44))
	end

	------------------------------------------------------------------
	-- PATIO DE SERVICIO (sur): contenedores, traviesas, focos
	------------------------------------------------------------------
	T.cap(T.container(CF(-82, 0, 70) * ALONG_X, "ContainerBlue", "METRO"))
	T.cap(T.container(CF(-66, 0, 92), "ContainerGray"))
	T.cap(T.portacabin(CF(-104, 0, 100), "Wall"))
	T.beamStack(CF(-96, 0, 56), 12, "Sleeper")
	T.pipeStack(CF(-70, 0, 52) * ALONG_X, 12)
	T.floodTower(CF(-118, 0, 108), 16)
	T.cap(T.crateStack(CF(-60, 0, 80), "Wall"))
end

return Props
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="102">
            <Properties>
              <string name="Name">RooftopDistrict</string>
              <string name="Source"><![CDATA[-- ROOFTOP DISTRICT (5v5 · Duelo por equipos · Buscar y destruir): azoteas de una manzana unidas
-- por puentes, con la calle muy abajo. La azotea A (roja) al norte y la B (lucernarios, azul) al
-- sur; en el centro, la azotea de la pantalla gigante a la que se llega por el puente de cristal.
-- Reconstruido de la hoja de referencia: vista superior (bases a los lados, A arriba, B abajo,
-- flancos por las esquinas con zonas altas), vista general, azotea A, puente central, interior con
-- escaleras y la calle exterior.
local T = require(script.Parent.Parent.TacKit)
local Lighting = require(script.Lighting)
local Geometry = require(script.Geometry)
local Props = require(script.Props)

local Map = {
	Id = "RooftopDistrict",
	Name = "Rooftop District",
	Icon = "🏙️",
	Description = "Azoteas y puentes · 5 contra 5",
	Realistic = true,
	Bomb = true,
	Palette = "RooftopDistrict",
	Ambience = "Wind",
	Modes = { "TDM", "SND" },
	RecommendedPlayers = 10,
	Bounds = Vector3.new(300, 70, 200),
}

Map.Lighting = Lighting.Default
Map.LightingVariants = Lighting.Variants

local V = Vector3.new
local CF = CFrame.new

function Map.Build()
	local folder = T.begin(Map)
	Geometry.build(T)
	Props.build(T)

	local redBase = CFrame.lookAt(V(-136, 0, 0), V(-100, 0, 0))
	local points = { V(-8, 0, 2), V(-4, 0, -3), V(0, 0, 2), V(4, 0, -3), V(8, 0, 2) }
	T.spawnZone(1, redBase, { Size = Vector2.new(24, 16), Points = points })
	T.spawnZone(2, T.mirrorCFrame(redBase), { Size = Vector2.new(24, 16), Points = points })
	T.flagBase(1, CF(-138, 0, -24))
	T.flagBase(2, CF(138, 0, -24))

	T.site(V(0, 4, -78), "A")
	T.site(V(0, 0, 78), "B", { Color = Color3.fromRGB(46, 110, 220) })

	T.zone(V(0, 6, 18), 8, 1)
	T.zone(V(0, 0, 78), 9, 2)
	T.zone(V(-98, 0, -10), 8, 3)
	T.zone(V(0, 4, -78), 9, 4)
	T.zone(V(98, 0, -10), 8, 5)

	T.callout("CENTRO", CF(0, 12, 0), V(80, 14, 60))
	T.callout("PANTALLA", CF(0, 12, 0), V(6, 14, 28))
	T.callout("AZOTEA A", CF(0, 10, -77), V(120, 14, 46))
	T.callout("AZOTEA B", CF(0, 6, 77), V(120, 14, 46))
	T.callout("PASARELA NORTE", CF(0, 9, -42), V(10, 10, 24))
	T.callout("PASARELA SUR", CF(0, 7, 42), V(10, 10, 24))
	for _, m in { -1, 1 } do
		local function at(x, y, z)
			return CF(m * x, y, z)
		end
		T.callout("PUENTE DE CRISTAL", at(53, 10, 0), V(26, 10, 10))
		T.callout("PLATAFORMA", at(75, 10, 0), V(18, 10, 28))
		T.callout(m < 0 and "OESTE" or "ESTE", at(87, 6, 0), V(42, 14, 72))
		T.callout("TORRE", at(90, 12, -75), V(36, 14, 50))
		T.callout("ANTENA", at(95, 18, -87), V(14, 10, 14))
		T.callout("DEPÓSITO", at(90, 6, 75), V(36, 14, 50))
	end

	for _, p in {
		V(-140, 0.5, -26), V(-140, 0.5, 26), V(-96, 0.5, -10), V(-80, 0.5, 30), V(-100, 0.5, 30),
		V(-90, 6.5, -70), V(-80, 6.5, -90), V(-96, 0.5, 70), V(-80, 0.5, 92), V(-40, 4.5, -64),
		V(-24, 4.5, -92), V(-40, 0.5, 66), V(-24, 0.5, 96), V(-26, 6.5, -8), V(-30, 6.5, 22),
		V(-76, 6.5, 10),
	} do
		T.ffa(p)
		T.ffa(T.mirrorPoint(p))
	end
	for _, spot in {
		{ V(-95, 14, -84), V(-40, 6, -78) }, -- plataforma alta de la torre, a la azotea A
		{ V(-95, 8, 84), V(-40, 4, 78) }, -- depósito, a la azotea B
		{ V(-30, 6, -24), V(0, 6, -50) }, -- centro, a la pasarela norte
		{ V(-74, 6, -10), V(-40, 8, 0) }, -- plataforma, al puente de cristal
	} do
		T.botSpot(spot[1], spot[2])
		T.botSpot(T.mirrorPoint(spot[1]), T.mirrorPoint(spot[2]))
	end

	T.Kit.bounds(Map.Bounds.X, Map.Bounds.Z, Map.Bounds.Y)
	return folder
end

return Map
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="103">
              <Properties>
                <string name="Name">Geometry</string>
                <string name="Source"><![CDATA[-- ROOFTOP DISTRICT · geometría jugable (blockout). Azoteas de una manzana de ciudad unidas por
-- puentes, con la calle 40 studs más abajo (decorado: no se puede caer, todos los bordes tienen
-- pretil y por encima un clip):
--
--   z -100 ┌ TORRE NO (alta 14) ┐ ─puente─ ┌──── AZOTEA A (4, sitio A) ────┐ ─puente─ ┌ TORRE NE ┐
--          │   (6)              │          │                                │          │  (6)     │
--   z  -50 └────── rampa ───────┘          └──── pasarela norte ────────────┘          └──────────┘
--   BASE ═══ OESTE (0) ═ escalera ═ PLATAFORMA (6) ═ PUENTE DE CRISTAL ═ CENTRO (6) ═ ... ═ BASE
--   ROJA   (tres puentes)                                                 (pantalla)         AZUL
--   z   50 ┌────── puente ──────┐          ┌──── pasarela sur ──────────────┐          ┌──────────┐
--          │ SUROESTE (0, depósito 8)      │ AZOTEA B (0, lucernarios: sitio B)          │ SURESTE  │
--   z  100 └────────────────────┘ ─puente─ └────────────────────────────────┘ ─puente─ └──────────┘
--
-- Simétrico en X = 0. Alturas: azoteas 0, 4 y 6; plataformas altas de las esquinas 14 y 8.
local Geometry = {}

local V = Vector3.new
local CF = CFrame.new

local STREET = -40
local PARAPET = 3.2

-- Manzana con azotea: el edificio entero (desde la calle) y pretiles en los bordes. edges = { N, S,
-- W, E } (N = lado -Z, S = +Z, W = -X, E = +X): false = sin pretil (pegado a otra azotea), o una
-- lista de huecos { desde, hasta } a lo largo del borde (de -X a +X o de -Z a +Z)
local function roof(T, x0, x1, z0, z1, top, look, edges)
	local G = T.G
	local body = G.solid("Building", V(x1 - x0, top - STREET, z1 - z0), CF((x0 + x1) / 2, STREET, (z0 + z1) / 2), look)
	G.deco("RoofSurface", V(x1 - x0 - 0.4, 0.1, z1 - z0 - 0.4), CF((x0 + x1) / 2, top + 0.05, (z0 + z1) / 2), "Roof").CastShadow = false
	-- Bandas de ventanas de las fachadas (decorado; se ven desde los puentes y al asomarse)
	for y = top - 6, STREET + 6, -6 do
		G.deco("FacadeWindows", V(x1 - x0 + 0.2, 1.8, z1 - z0 + 0.2), CF((x0 + x1) / 2, y, (z0 + z1) / 2), { Color3.fromRGB(56, 70, 90), Enum.Material.Glass }).CastShadow = false
	end
	local function edge(a, b, openings)
		if openings == false then
			return
		end
		local dir = (b - a).Unit
		local length = (b - a).Magnitude
		local cuts = {}
		for _, o in openings or {} do
			table.insert(cuts, o)
		end
		table.sort(cuts, function(p, q)
			return p[1] < q[1]
		end)
		local start = 0
		local function piece(t0, t1)
			if t1 - t0 > 0.3 then
				local p0, p1 = a + dir * t0, a + dir * t1
				T.cap(G.parapet(p0, p1, PARAPET, "Parapet", 1))
			end
		end
		local along = math.abs(dir.X) > 0.5 and "X" or "Z"
		for _, c in cuts do
			local t0 = math.abs(c[1] - a[along])
			local t1 = math.abs(c[2] - a[along])
			piece(start, math.min(t0, t1))
			start = math.max(t0, t1)
		end
		piece(start, length)
	end
	local y = top
	local inset = 0.5
	edge(V(x0, y, z0 + inset), V(x1, y, z0 + inset), edges.N)
	edge(V(x0, y, z1 - inset), V(x1, y, z1 - inset), edges.S)
	edge(V(x0 + inset, y, z0), V(x0 + inset, y, z1), edges.W)
	edge(V(x1 - inset, y, z0), V(x1 - inset, y, z1), edges.E)
	return body
end
Geometry.roof = roof

-- Puente abierto entre dos azoteas (a, b = puntos de la superficie en los dos bordes)
local function bridge(T, a, b, width)
	T.G.walkway(a, b, width or 6, { Look = "Deck", EdgeLook = "SteelDark", Cap = true })
end

function Geometry.build(T)
	local G = T.G
	local M = Enum.Material

	T.terrain(M.Asphalt, 1200, 1200, CF(0, STREET - 0.3, 0))
	G.deco("Street", V(600, 0.2, 600), CF(0, STREET + 0.1, 0), "Street").CastShadow = false

	---------------------------------------------------------------------------
	-- CENTRO (6): azotea con la gran pantalla en medio (corta la vista de lado a lado)
	---------------------------------------------------------------------------
	roof(T, -40, 40, -30, 30, 6, "BuildingBlue", {
		N = { { -4, 4 } }, S = { { -4, 4 } }, W = { { -4, 4 } }, E = { { -4, 4 } },
	})
	-- Pantalla gigante sobre una estructura (choca: es la cobertura alta del centro)
	T.cap(G.box("ScreenFrame", V(2, 14, 26), CF(0, 6 + 7, 0), "SteelDark"))
	for _, s in { -1, 1 } do
		local screen = G.deco("Screen", V(0.3, 11, 23), CF(s * 1.2, 6 + 7.5, 0), "Screen")
		screen.CastShadow = false
		local gui = T.Kit.sign(screen, s < 0 and Enum.NormalId.Left or Enum.NormalId.Right, "ROOFTOP · DISTRICT", Color3.fromRGB(220, 240, 255), Color3.fromRGB(30, 80, 170))
		gui.LightInfluence = 0.2
	end

	---------------------------------------------------------------------------
	-- AZOTEA A (4) y AZOTEA B (0), sitios; pasarelas desde el centro
	---------------------------------------------------------------------------
	roof(T, -60, 60, -100, -54, 4, "Building", {
		N = {}, S = { { -4, 4 } }, W = { { -82, -74 } }, E = { { -82, -74 } },
	})
	roof(T, -60, 60, 54, 100, 0, "BuildingLight", {
		N = { { -4, 4 } }, S = {}, W = { { 74, 82 } }, E = { { 74, 82 } },
	})
	-- Franja de color bajo la azotea: A roja, B azul (se reconocen desde los puentes)
	G.deco("SiteBand", V(120.6, 1.4, 46.6), CF(0, 4 - 2, -77), "Red").CastShadow = false
	G.deco("SiteBand", V(120.6, 1.4, 46.6), CF(0, 0 - 2, 77), "Blue").CastShadow = false
	bridge(T, V(0, 6, -30), V(0, 4, -54), 8)
	bridge(T, V(0, 6, 30), V(0, 0, 54), 8)

	T.mirrored("RooftopHalf", function()
		Geometry.half(T)
	end)
end

-- Mitad del Rojo (X < 0)
function Geometry.half(T)
	local G = T.G

	------------------------------------------------------------------
	-- BASE (0) y OESTE (0): tres puentes sobre el callejón
	------------------------------------------------------------------
	roof(T, -150, -114, -32, 32, 0, "BuildingBlue", {
		N = {}, S = {}, W = {}, E = { { -26, -20 }, { -3, 3 }, { 20, 26 } },
	})
	for _, z in { -23, 0, 23 } do
		bridge(T, V(-114, 0, z), V(-108, 0, z), 6)
	end
	-- Caseta de la base (marquesina cerrada): frente ciego hacia el mapa, una puerta a cada lado
	-- (norte y sur) que da a un vestíbulo en L; desde las azoteas y los puentes no se ve dentro
	local door = G.door
	for _, z in { -18.5, 18.5 } do
		T.cap(G.wall(CF(-134.75, 0, z), 26.5, 9, "BuildingLight", { door(10.25, 5, 7.4) }))
		T.cap(G.wall(CF(-127.25, 0, z * 0.76), 11.5, 9, "BuildingLight"))
	end
	T.cap(G.wall(CF(-121.5, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0), 37.6, 9, "BuildingLight"))
	T.cap(G.floor(CF(-134.5, 9.6, 0), 27.6, 38, "SteelDark", 0.6))
	G.deco("CanopyEdge", V(0.6, 1, 38), CF(-120.9, 9.1, 0), "Red")
	G.deco("CanopyStripe", V(0.3, 1.2, 26), CF(-121.1, 6.5, 0), "Red")
	for _, z in { -18.5, 18.5 } do
		G.deco("DoorSign", V(5, 0.8, 0.2), CF(-124.5, 8, z + (z < 0 and -0.35 or 0.35)), "Red")
	end
	roof(T, -108, -66, -36, 36, 0, "Building", {
		N = { { -93, -87 } }, S = { { -93, -87 } }, W = { { -26, -20 }, { -3, 3 }, { 20, 26 } }, E = {},
	})
	-- Plataforma (6) al este del bloque oeste, con escalera y cuarto de escalera; puente de cristal
	G.solid("Platform", V(18, 6, 28), CF(-75, 0, 0), "BuildingBlue")
	for _, seg in { { V(-84, 6, -14), V(-66, 6, -14) }, { V(-84, 6, 14), V(-66, 6, 14) } } do
		T.cap(G.parapet(seg[1] + V(0, 0, seg[1].Z < 0 and 0.5 or -0.5), seg[2] + V(0, 0, seg[1].Z < 0 and 0.5 or -0.5), PARAPET, "Parapet", 1))
	end
	G.stairs(V(-96, 0, 0), V(-84, 6, 0), 6, "RoofDark", { Rails = "Both", Cap = true })
	-- (borde este de la plataforma: da al vacío; hueco donde llega el puente de cristal)
	T.cap(G.parapet(V(-66.5, 6, -14), V(-66.5, 6, -4), PARAPET, "Parapet", 1))
	T.cap(G.parapet(V(-66.5, 6, 4), V(-66.5, 6, 14), PARAPET, "Parapet", 1))
	-- (cuarto de escalera: tapa la línea del puente de cristal hasta la base)
	T.cap(G.solid("StairHouse", V(8, 8, 12), CF(-76, 6, 0), "BuildingLight"))
	G.deco("StairHouseDoor", V(3, 6.4, 0.2), CF(-76, 6 + 3.2, -6.1), "SteelDark")
	G.deco("StairHouseDoor", V(3, 6.4, 0.2), CF(-76, 6 + 3.2, 6.1), "SteelDark")
	-- Puente de cristal (cubierto) hasta el centro
	G.walkway(V(-66, 6, 0), V(-40, 6, 0), 8, { Look = "Deck", EdgeLook = "SteelDark", Cap = true })
	for _, s in { -1, 1 } do
		local glass = G.deco("BridgeGlass", V(26, 6, 0.2), CF(-53, 6 + 3.6, s * 3.9), "Glass")
		glass.Transparency = 0.55
		glass.CastShadow = false
		for _, x in { -64, -53, -42 } do
			G.deco("BridgeFrame", V(0.4, 7.2, 0.4), CF(x, 6 + 3.6, s * 3.9), "SteelDark")
		end
	end
	T.cap(G.deco("BridgeRoof", V(26, 0.5, 8.6), CF(-53, 6 + 7.4, 0), "Glass"))

	------------------------------------------------------------------
	-- TORRE NO (6, con plataforma alta de 14 y antena) y SUROESTE (0, con depósito en 8)
	------------------------------------------------------------------
	roof(T, -108, -72, -100, -50, 6, "BuildingLight", {
		N = {}, S = { { -93, -87 } }, W = {}, E = { { -82, -74 } },
	})
	G.stairs(V(-90, 0, -36), V(-90, 6, -50), 6, "RoofDark", { Rails = "Both", Cap = true })
	G.solid("HighDeck", V(14, 8, 14), CF(-95, 6, -87), "Building")
	T.cap(G.parapet(V(-102, 14, -93.5), V(-88, 14, -93.5), 2.4, "Parapet", 0.8))
	T.cap(G.parapet(V(-101.5, 14, -94), V(-101.5, 14, -80), 2.4, "Parapet", 0.8))
	G.stairs(V(-76, 6, -84), V(-88, 14, -84), 4, "RoofDark", { Rails = "Both", Cap = true })
	roof(T, -108, -72, 50, 100, 0, "BuildingBrick", {
		N = { { -93, -87 } }, S = {}, W = {}, E = { { 74, 82 } },
	})
	bridge(T, V(-90, 0, 36), V(-90, 0, 50), 6)
	G.solid("TankDeck", V(14, 8, 14), CF(-95, 0, 87), "BuildingLight")
	G.stairs(V(-76, 0, 84), V(-88, 8, 84), 4, "RoofDark", { Rails = "Both", Cap = true })
	T.cap(G.parapet(V(-102, 8, 93.5), V(-88, 8, 93.5), 2.4, "Parapet", 0.8))
	T.cap(G.parapet(V(-101.5, 8, 94), V(-101.5, 8, 80), 2.4, "Parapet", 0.8))
	-- Puentes de las esquinas a los sitios
	bridge(T, V(-72, 6, -78), V(-60, 4, -78), 6)
	bridge(T, V(-72, 0, 78), V(-60, 0, 78), 6)
end

return Geometry
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="104">
              <Properties>
                <string name="Name">Lighting</string>
                <string name="Source"><![CDATA[-- ROOFTOP DISTRICT · luz. Día claro y frío como la referencia (cielo azul, ciudad con neblina azul
-- al fondo); variantes de atardecer y de noche (pantallas y ventanas encendidas).
local RGB = Color3.fromRGB
local V = Vector3.new

local Lighting = {}

Lighting.Default = {
	ClockTime = 11.5,
	Latitude = 40,
	Brightness = 3,
	Exposure = -0.02,
	Ambient = RGB(100, 106, 120),
	OutdoorAmbient = RGB(148, 156, 172),
	ShadowSoftness = 0.15,
	Atmosphere = { Density = 0.3, Offset = 0.12, Color = RGB(196, 214, 236), Decay = RGB(116, 140, 176), Glare = 0.15, Haze = 1.3 },
	Color = { Saturation = 0.1, Contrast = 0.12, Brightness = 0.01, Tint = RGB(244, 248, 255) },
	Bloom = { Intensity = 0.35, Size = 22, Threshold = 2 },
	Clouds = 0.45,
	CloudColor = RGB(255, 255, 255),
	SunRays = 0.05,
	Wind = V(10, 0, 4),
	TerrainColors = { Asphalt = RGB(66, 68, 72) },
}

Lighting.Variants = {
	{
		Name = "Atardecer",
		Chance = 0.3,
		ClockTime = 18,
		Brightness = 2.3,
		Ambient = RGB(110, 90, 100),
		OutdoorAmbient = RGB(160, 130, 130),
		Atmosphere = { Density = 0.3, Offset = 0.08, Color = RGB(246, 180, 150), Decay = RGB(150, 100, 120), Glare = 0.6, Haze = 1.3 },
		Color = { Saturation = 0.12, Contrast = 0.12, Brightness = 0.01, Tint = RGB(255, 234, 220) },
		CloudColor = RGB(255, 190, 160),
		SunRays = 0.12,
	},
	{
		Name = "Noche",
		Chance = 0.25,
		ClockTime = 21.5,
		Brightness = 1.1,
		Exposure = 0.35,
		Ambient = RGB(66, 72, 100),
		OutdoorAmbient = RGB(80, 90, 128),
		Atmosphere = { Density = 0.28, Offset = 0.06, Color = RGB(60, 70, 110), Decay = RGB(26, 30, 56), Glare = 0, Haze = 1 },
		Color = { Saturation = 0.08, Contrast = 0.14, Brightness = 0.03, Tint = RGB(214, 222, 255) },
		Bloom = { Intensity = 0.65, Size = 24, Threshold = 1.5 },
		Clouds = 0.25,
		CloudColor = RGB(70, 76, 104),
		SunRays = 0,
	},
}

return Lighting
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="105">
              <Properties>
                <string name="Name">Props</string>
                <string name="Source"><![CDATA[-- ROOFTOP DISTRICT · props: máquinas de aire, depósitos, antenas, placas solares, lucernarios y
-- pantallas (cobertura e identidad de azotea), la azotea A en rojo y la B en azul, y la ciudad.
local Props = {}

local V = Vector3.new
local CF = CFrame.new
local RGB = Color3.fromRGB
local rad = math.rad
local M = Enum.Material

local STREET = -40

function Props.build(T)
	local G = T.G
	local night = T.isNight()
	local RED, BLUE = RGB(200, 52, 48), RGB(40, 104, 210)

	---------------------------------------------------------------------------
	-- AZOTEA A (4): cuarto de escalera con toldo rojo, máquinas rojas y cajas junto al sitio
	---------------------------------------------------------------------------
	T.cap(G.solid("StairHouseA", V(12, 8, 8), CF(0, 4, -94), "BuildingLight"))
	T.Kit.awning(CF(0, 4 + 6.4, -89.9), 12, 3, RED)
	T.letterBanner(CF(0, 4 + 4.2, -89.8), "A", "Red", 5, 5.4)
	for _, s in { -1, 1 } do
		T.hvac(CF(s * 12, 4, -70) * CFrame.Angles(0, rad(90), 0), { RED, M.Metal })
		T.hvac(CF(s * 30, 4, -88), { RGB(196, 198, 200), M.Metal })
		T.cap(T.crateStack(CF(s * 22, 4, -64) * CFrame.Angles(0, rad(s * 15), 0), "L"))
		T.planter(CF(s * 44, 4, -66) * CFrame.Angles(0, rad(90), 0), 6, 3)
		T.dish(CF(s * 50, 4, -94))
	end
	T.blockPallet(CF(0, 4, -66), 2)

	---------------------------------------------------------------------------
	-- AZOTEA B (0): lucernarios (cobertura baja), depósito y máquinas azules
	---------------------------------------------------------------------------
	for _, s in { -1, 1 } do
		T.skylight(CF(s * 14, 0, 72), 8)
		T.skylight(CF(s * 14, 0, 88), 8)
		T.hvac(CF(s * 34, 0, 66), { BLUE, M.Metal })
		T.solarRow(CF(s * 40 - 4, 0, 92), 2)
		T.crateStack(CF(s * 28, 0, 82) * CFrame.Angles(0, rad(s * -10), 0), "Wall")
	end
	T.cap(G.solid("StairHouseB", V(12, 8, 8), CF(0, 0, 95), "BuildingLight"))
	T.letterBanner(CF(0, 4.6, 90.8), "B", "Blue", 5, 5.4)
	T.waterTank(CF(0, 8, 95))

	---------------------------------------------------------------------------
	-- CENTRO (6): máquinas a los lados de la pantalla
	---------------------------------------------------------------------------
	for _, s in { -1, 1 } do
		for _, z in { -18, 18 } do
			T.hvac(CF(s * 18, 6, z) * CFrame.Angles(0, rad(90), 0))
		end
		T.planter(CF(s * 32, 6, 0) * CFrame.Angles(0, rad(90), 0), 6, 3)
	end

	T.mirrored("RooftopProps", function()
		Props.half(T)
	end)

	---------------------------------------------------------------------------
	-- Calle de abajo, ciudad alrededor y grúa lejana
	---------------------------------------------------------------------------
	for _, z in { -46, 46 } do
		G.paintLine(V(-300, STREET + 0.2, z), V(300, STREET + 0.2, z), 0.5, "Paint")
	end
	T.van(CF(-20, STREET + 0.2, -42) * CFrame.Angles(0, rad(90), 0), RGB(214, 50, 40))
	T.Kit.car(CF(30, STREET + 0.2, 44) * CFrame.Angles(0, rad(-90), 0), RGB(40, 104, 210))
	local palette = { RGB(160, 168, 180), RGB(96, 122, 160), RGB(196, 198, 204), RGB(84, 92, 106), RGB(150, 88, 72), RGB(120, 140, 170) }
	T.skylineRing(V(0, STREET, 0), 200, 0, 355, 9, palette, { Lit = night, MinH = 60, VarH = 40, TowerEvery = 4, TowerExtra = 60, FloorH = 7 })
	T.skylineRing(V(0, STREET, 0), 300, 4, 356, 12, palette, { Lit = night, MinH = 80, VarH = 60, TowerEvery = 3, TowerExtra = 80, FloorH = 10 })
	T.towerCrane(CF(-150, STREET, -220) * CFrame.Angles(0, rad(150), 0), 120, { Jib = 60, Load = false })
end

-- Mitad del Rojo (X < 0)
function Props.half(T)
	local G = T.G
	local RED = RGB(200, 52, 48)

	-- Base: cajas y jardineras bajo la marquesina
	T.cap(T.crateStack(CF(-146, 0, -26), "L"))
	T.planter(CF(-120, 0, -30), 6, 3)
	T.planter(CF(-120, 0, 30), 6, 3)
	local lamp = G.deco("CanopyLight", V(16, 0.3, 1.2), CF(-135, 9.2, 0), { RGB(240, 246, 255), M.Neon })
	T.Kit.light(lamp, "PointLight", RGB(236, 244, 255), 20, 0.8)

	-- Bloque oeste: máquinas, placas solares, parabólica, cajas (cobertura de paso)
	T.hvac(CF(-100, 0, -20))
	T.hvac(CF(-100, 0, 22) * CFrame.Angles(0, rad(90), 0))
	T.solarRow(CF(-104, 0, -30), 3)
	T.dish(CF(-70, 0, 30))
	T.cap(T.crateStack(CF(-80, 0, -26) * CFrame.Angles(0, rad(12), 0), "L"))
	T.crateStack(CF(-86, 0, 26), "Wall")
	T.planter(CF(-104, 0, 8) * CFrame.Angles(0, rad(90), 0), 6, 3)

	-- Torre NO: antena en la plataforma alta, depósito, pantalla mirando al norte del mapa
	T.cap(T.antennaTower(CF(-97, 14, -90), 22))
	T.waterTank(CF(-80, 6, -96))
	T.hvac(CF(-100, 6, -60))
	T.cap(T.crateStack(CF(-80, 6, -62), "L"))
	T.cap(T.billboardScreen(CF(-90, 6, -98) * CFrame.Angles(0, math.pi, 0), 14, 7, "NEXT DROP 07.25", RGB(30, 80, 170)))

	-- Suroeste: depósito sobre su plataforma, máquinas, pantalla roja
	T.waterTank(CF(-95, 8, 87))
	T.hvac(CF(-100, 0, 60))
	T.cap(T.crateStack(CF(-80, 0, 64) * CFrame.Angles(0, rad(-20), 0), "L"))
	T.solarRow(CF(-106, 0, 70), 2)
	T.cap(T.billboardScreen(CF(-90, 0, 98), 14, 7, "CITY LIGHTS", RED))

	-- Pantallas en las fachadas (se ven desde los puentes)
	local facade = G.deco("FacadeScreen", V(0.3, 14, 20), CF(-71.7, -10, -78), "Screen")
	T.Kit.sign(facade, Enum.NormalId.Right, "ROOFTOP", RGB(230, 244, 255), RGB(30, 80, 170)).LightInfluence = 0.2
	local facade2 = G.deco("FacadeScreen", V(0.3, 12, 18), CF(-65.7, -14, 0), "Red")
	T.Kit.sign(facade2, Enum.NormalId.Right, "DISTRICT", RGB(255, 236, 230), RED).LightInfluence = 0.2
end

return Props
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="106">
            <Properties>
              <string name="Name">Terminal</string>
              <string name="Source"><![CDATA[-- TERMINAL (5v5 · Duelo por equipos · Buscar y destruir): aeropuerto al atardecer. El avión parte la
-- plataforma por la mitad; el sitio A está en la plataforma delante de la terminal (cristalera y
-- pasarelas de embarque encima) y el B bajo la marquesina de carga (furgonetas, contenedores y
-- muelle). Reconstruido de la hoja de referencia: minimapa (bases arriba/abajo, avión en el centro,
-- A junto a la terminal, B en la carga), imagen principal (avión, torre de control, terminal de
-- cristal, contenedores rojos y azules, furgonetas, conos, torres de focos) y paneles (interior de
-- la terminal, zona inferior cubierta, variante nocturna).
local T = require(script.Parent.Parent.TacKit)
local Lighting = require(script.Lighting)
local Geometry = require(script.Geometry)
local Props = require(script.Props)

local Map = {
	Id = "Terminal",
	Name = "Terminal",
	Icon = "✈️",
	Description = "Aeropuerto · avión en el centro · 5 contra 5",
	Realistic = true,
	Bomb = true,
	Palette = "Terminal",
	Ambience = "Base",
	Modes = { "TDM", "SND" },
	RecommendedPlayers = 10,
	Bounds = Vector3.new(300, 60, 260),
}

Map.Lighting = Lighting.Default
Map.LightingVariants = Lighting.Variants

local V = Vector3.new
local CF = CFrame.new
local L = 10

function Map.Build()
	local folder = T.begin(Map)
	Geometry.build(T)
	Props.build(T)

	-- Bases (dentro de los hangares)
	local redBase = CFrame.lookAt(V(-136, 0, 0), V(-100, 0, 0))
	T.spawnZone(1, redBase, { Size = Vector2.new(34, 20) })
	T.spawnZone(2, T.mirrorCFrame(redBase), { Size = Vector2.new(34, 20) })
	T.flagBase(1, CF(-128, 0, 30))
	T.flagBase(2, CF(128, 0, 30))
	local teams = require(game:GetService("ReplicatedStorage").Shared.GameConfig).Teams
	for i, x in { -149.3, 149.3 } do
		for _, z in { -12, 12 } do
			local look = { teams[i].Color.Color, Enum.Material.Fabric }
			T.G.deco("TeamBanner", V(0.3, 10, 6), CF(x, 9, z), look).Color = look[1]
		end
	end

	-- Sitios
	T.site(V(0, 0, -64), "A")
	T.site(V(0, 0, 98), "B", { Color = Color3.fromRGB(46, 110, 220) })

	-- Zonas
	T.zone(V(0, 0, 50), 8, 1)
	T.zone(V(0, 0, 98), 9, 2)
	T.zone(V(-80, 0, 2), 9, 3)
	T.zone(V(0, 0, -64), 9, 4)
	T.zone(V(80, 0, 2), 9, 5)

	-- Nombres de zona
	T.callout("TERMINAL", CF(0, 5, -106), V(140, 10, 48))
	T.callout("SALIDAS", CF(0, 15, -106), V(140, 10, 48))
	T.callout("PLATAFORMA A", CF(0, 6, -62), V(90, 14, 40))
	T.callout("AVIÓN", CF(0, 8, -2), V(80, 20, 70))
	T.callout("MORRO", CF(0, 6, -38), V(24, 14, 12))
	T.callout("COLA", CF(0, 6, 34), V(30, 14, 18))
	T.callout("CARGA", CF(0, 5, 98), V(80, 12, 40))
	T.callout("MUELLE DE CARGA", CF(0, 8, 113), V(62, 8, 10))
	for _, m in { 1, -1 } do
		local function at(x, y, z)
			return CF(m * x, y, z)
		end
		T.callout("PASARELA", at(22, 14, -66), V(8, 8, 36))
		T.callout("HANGAR", at(131, 10, 0), V(38, 22, 80))
		T.callout("MUELLE CUBIERTO", at(91, 6, -113), V(42, 12, 34))
		T.callout("CARRETERA", at(91, 6, -68), V(42, 12, 56))
		T.callout("PLATAFORMA", at(76, 6, 0), V(72, 14, 80))
		T.callout("CATERING", at(76, 6, 100), V(72, 14, 50))
		T.callout("ALA", at(24, 6, 6), V(30, 10, 22))
	end

	-- Puntos libres
	for _, p in {
		V(-124, 0.5, -30), V(-124, 0.5, 30), V(-100, 0.5, -60), V(-96, 0.5, -120), V(-70, 0.5, -54),
		V(-60, 0.5, -10), V(-90, 0.5, 6), V(-40, 0.5, 30), V(-56, 0.5, 74), V(-90, 0.5, 90),
		V(-30, 0.5, 104), V(-30, 0.5, -56), V(-40, 0.5, -110), V(-60, L + 0.5, -112), V(-6, L + 0.5, -112),
		V(-12, 4.5, 112), V(-26, 0.5, 46),
	} do
		T.ffa(p)
		T.ffa(T.mirrorPoint(p))
	end
	-- Puestos de los bots
	for _, spot in {
		{ V(-12, L, -84), V(-10, 4, -60) }, -- cristalera de salidas, sobre la plataforma A
		{ V(-22, L, -72), V(-40, 4, -40) }, -- pasarela de embarque
		{ V(-16, 4, 112), V(-10, 4, 84) }, -- muelle de carga, al sitio B
		{ V(-100, 0, -40), V(-50, 4, -10) }, -- carretera, a la plataforma
	} do
		T.botSpot(spot[1], spot[2])
		T.botSpot(T.mirrorPoint(spot[1]), T.mirrorPoint(spot[2]))
	end

	T.Kit.bounds(Map.Bounds.X, Map.Bounds.Z, Map.Bounds.Y)
	return folder
end

return Map
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="107">
              <Properties>
                <string name="Name">Geometry</string>
                <string name="Source"><![CDATA[-- TERMINAL · geometría jugable (blockout). Aeropuerto con el avión en el centro de la plataforma:
--
--   z -130 ┌ OFICINAS ┬──── TERMINAL: vestíbulo abajo, salidas arriba (cristalera) ────┬ OFICINAS ┐
--          │ MUELLE   │   pasarela          PLATAFORMA A (sitio A)          pasarela  │  MUELLE  │
--   z  -82 │ CUBIERTO ├──────────────────────── morro ─────────────────────────────────┤ CUBIERTO │
--   HANGAR │ carretera│                       ╔═ AVIÓN ═╗                             │carretera │ HANGAR
--   (base  │ PLATAFORMA (furgonetas, cisterna, ║ alas   ║  contenedores)      PLATAFORMA │  (base
--   roja)  │          │                       ╚═ cola ══╝                             │  azul)
--   z   78 │ CATERING ├──────────── CARGA: marquesina con el sitio B y el muelle ─────┤ CATERING │
--   z  130 └──────────┴──────────────────────────────────────────────────────────────┴──────────┘
--
-- El avión parte la plataforma en dos (no se pasa por debajo del fuselaje): se cruza por el morro
-- (lado A) o por la cola (lado B). Alturas: suelo 0, salidas de la terminal y pasarelas 10,
-- muelle de carga 4. Simétrico en X = 0.
local Geometry = {}

local V = Vector3.new
local CF = CFrame.new

local L = 10

-- Cristalera: cristal (decorado) y un panel invisible que choca pero no para las balas
local function glazing(T, cf, w, h)
	local G = T.G
	local pane = G.deco("Glazing", V(w, h, 0.2), cf, "Glass")
	pane.Transparency = 0.55
	pane.CastShadow = false
	local stop = T.Kit.block("GlassCollider", V(w, h, 0.4), cf, Color3.new(1, 1, 1), nil, T.Kit.shootThroughFolder())
	stop.Transparency = 1
	stop.CastShadow = false
	G.deco("Mullion", V(0.3, h, 0.35), cf, "TerminalDark")
end

function Geometry.build(T)
	local G = T.G
	local door, window = G.door, G.window
	local M = Enum.Material

	T.terrain(M.Grass, 1400, 1400, CF(0, -0.3, 0))
	G.floor(CF(0, 0, 0), 300, 260, "Apron")

	---------------------------------------------------------------------------
	-- TERMINAL (140 x 48): vestíbulo con mostradores abajo; salidas arriba con cristalera a la
	-- plataforma; dos pasarelas de embarque bajan a la plataforma A
	---------------------------------------------------------------------------
	local t = CF(0, 0, -106) * CFrame.Angles(0, math.pi, 0) -- (la cara mira a la plataforma, +Z)
	local front0 = { door(-12, 8, 8), door(12, 8, 8), door(-40), door(40) }
	for _, x in { -56, -26, 26, 56 } do
		table.insert(front0, window(x, 2.5, 10, 5))
	end
	G.shell(t, 140, 48, L, "TerminalWall", { Front = front0, Left = { door(0, 8, 8) }, Right = { door(0, 8, 8) } }, { Frame = "TerminalDark" })
	local front1 = { door(-22, 6, 8), door(22, 6, 8) }
	local windows1 = { -60, -48, -36, -10, 0, 10, 36, 48, 60 }
	for _, x in windows1 do
		table.insert(front1, window(x, 2.5, 8, 6))
	end
	G.shell(t * CF(0, L, 0), 140, 48, L, "TerminalWall", {
		Front = front1,
		Left = { window(0, 3, 10, 4) },
		Right = { window(0, 3, 10, 4) },
	}, { Frame = "TerminalDark" })
	-- Cristales de los huecos de la fachada (las ventanas de la planta baja y las de arriba)
	for _, x in { -56, -26, 26, 56 } do
		glazing(T, CF(x, 5, -82.5), 10, 5)
	end
	for _, x in windows1 do
		glazing(T, CF(x, L + 5.5, -82.5), 8, 6)
	end
	G.slab(CF(0, L, -106), 138, 46, "Tile", { { -30, 4.5, 5.4, 10 }, { 30, 4.5, 5.4, 10 } })
	for _, s in { -1, 1 } do
		G.stairs(V(s * 30, 0, -90), V(s * 30, L, -106), 5, "TerminalPanel", { Rails = "Both" })
		G.railing(V(s * 27.2, L, -96.4), V(s * 32.8, L, -96.4))
		-- Pilares del vestíbulo (dos alturas)
		for _, x in { 14, 46 } do
			G.column(CF(s * x, 0, -112), 2 * L, 1.8, "TerminalWall")
		end
	end
	T.cap(G.floor(CF(0, 2 * L + 0.8, -106), 142, 50, "TerminalPanel", 0.8))
	-- Marquesina sobre la fachada y rótulo
	G.deco("Canopy", V(142, 0.8, 8), CF(0, 2 * L + 0.6, -78), "TerminalPanel")
	G.deco("CanopyFascia", V(142, 1.6, 0.6), CF(0, 2 * L, -74.2), "TerminalDark")

	-- Pasarelas de embarque: de la puerta de la primera a una escalera que baja a la plataforma
	for _, s in { -1, 1 } do
		G.walkway(V(s * 22, L, -82), V(s * 22, L, -64), 6, { Look = "TerminalPanel", EdgeLook = "TerminalDark", Supports = 9 })
		G.deco("BridgeRoof", V(6.6, 0.5, 18.4), CF(s * 22, L + 7.6, -73), "TerminalPanel")
		for _, side in { -1, 1 } do
			G.deco("BridgeGlass", V(0.2, 3.6, 18), CF(s * 22 + side * 3.1, L + 5.2, -73), "Glass").Transparency = 0.5
			G.deco("BridgeFrame", V(0.3, 7.6, 0.3), CF(s * 22 + side * 3.1, L + 3.8, -64.2), "TerminalDark")
		end
		G.stairs(V(s * 22, 0, -48), V(s * 22, L, -64), 5, "TerminalPanel", { Rails = "Both" })
	end

	---------------------------------------------------------------------------
	-- CARGA (sitio B): marquesina de 80 x 40 sobre columnas, muro del fondo y muelle de carga
	---------------------------------------------------------------------------
	T.cap(G.floor(CF(0, L + 0.8, 98), 82, 42, "TerminalPanel", 0.8))
	G.deco("CargoFascia", V(82, 2, 0.6), CF(0, L - 0.2, 77.2), "TerminalDark")
	for _, x in { -40, -20, 20, 40 } do
		G.column(CF(x, 0, 78), L, 1.4, "TerminalDark")
	end
	for _, x in { -40, 40 } do
		G.column(CF(x, 0, 98), L, 1.4, "TerminalDark")
	end
	G.wall(CF(0, 0, 118.5), 82, L, "HangarWall")
	for _, s in { -1, 1 } do
		G.wall(CF(s * 40.5, 0, 108.5) * CFrame.Angles(0, -math.pi / 2, 0), 21, L, "HangarWall")
		-- Rampa del muelle
		G.stairs(V(s * 37.5, 0, 113), V(s * 30.5, 4, 113), 6, "Concrete", {})
	end
	G.box("CargoDock", V(61, 4, 10), CF(0, 2, 113), "Concrete")
	G.railing(V(-22, 4, 108.2), V(-30, 4, 108.2))
	G.railing(V(22, 4, 108.2), V(30, 4, 108.2))

	T.mirrored("TerminalHalf", function()
		Geometry.half(T)
	end)
end

-- Mitad del Rojo (X < 0): hangar (base), muelle cubierto, catering y bordes
function Geometry.half(T)
	local G = T.G
	local door = G.door

	------------------------------------------------------------------
	-- HANGAR (base): tres portones; mamparas para que las salidas laterales queden en L
	------------------------------------------------------------------
	local hg = CF(-131, 0, 0)
	G.shell(hg, 38, 80, 22, "HangarWall", {
		Right = { door(-29, 10, 12), door(0, 10, 12), door(29, 10, 12) },
	}, { Frame = "TerminalDark" })
	T.cap(G.floor(hg * CF(0, 22.6, 0), 39, 81, "HangarWall", 0.6))
	T.gableRoof(hg * CF(0, 22.6, 0) * CFrame.Angles(0, math.pi / 2, 0), 80, 38, 5, "HangarWall")
	T.gable(hg * CF(0, 22.6, -39.7) * CFrame.Angles(0, math.pi / 2, 0), 38, 5, "HangarWall")
	T.gable(hg * CF(0, 22.6, 39.7) * CFrame.Angles(0, math.pi / 2, 0), 38, 5, "HangarWall")
	for _, z in { -17, 17 } do
		T.cap(G.wall(CF(-118, 0, z + (z < 0 and -10.5 or 10.5)) * CFrame.Angles(0, -math.pi / 2, 0), 21, 10, "HangarWall"))
	end
	-- (y frente al portón central: se sale rodeándola por los pasillos de las laterales)
	T.cap(G.wall(CF(-120, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0), 18, 10, "HangarWall"))

	------------------------------------------------------------------
	-- MUELLE CUBIERTO (norte, junto a la terminal): techo sobre pilares, muro con persianas
	------------------------------------------------------------------
	T.cap(G.floor(CF(-91, L + 0.8, -113), 42, 34, "TerminalPanel", 0.8))
	for _, x in { -110, -91, -72 } do
		G.column(CF(x, 0, -97), L, 1.2, "TerminalDark")
	end
	G.wall(CF(-91, 0, -130.5), 42, L, "HangarWall")
	G.wall(CF(-112.5, 0, -113) * CFrame.Angles(0, -math.pi / 2, 0), 34, L, "HangarWall")

	------------------------------------------------------------------
	-- Bordes: oficinas y taller (macizos), catering, vallas
	------------------------------------------------------------------
	T.cap(T.facadeBlock(CF(-131, 0, -85), 38, 90, 16, "TerminalWall", { Lit = T.isNight(), Windows = Color3.fromRGB(70, 110, 150) }))
	T.cap(T.facadeBlock(CF(-131, 0, 85), 38, 90, 14, "TerminalPanel", { Lit = T.isNight(), Windows = Color3.fromRGB(70, 110, 150) }))
	T.cap(T.facadeBlock(CF(-81, 0, 68), 38, 24, 12, "TerminalWall", { Lit = T.isNight(), Windows = Color3.fromRGB(70, 110, 150), Roof = false }))
	G.meshFence(V(-112, 0, 126), V(-41, 0, 126), 8)
	G.meshFence(V(-112, 0, -40), V(-112, 0, -96), 8)
end

return Geometry
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="108">
              <Properties>
                <string name="Name">Lighting</string>
                <string name="Source"><![CDATA[-- TERMINAL · luz. Por defecto, atardecer naranja con el sol bajo sobre la pista, como la
-- referencia (cristales azulados encendidos, focos de plataforma). Variantes: día y noche.
local RGB = Color3.fromRGB
local V = Vector3.new

local Lighting = {}

Lighting.Default = {
	ClockTime = 17.7,
	Latitude = 30,
	Brightness = 2.5,
	Exposure = 0.05,
	Ambient = RGB(100, 84, 84),
	OutdoorAmbient = RGB(156, 130, 120),
	ShadowSoftness = 0.1,
	Atmosphere = { Density = 0.3, Offset = 0.08, Color = RGB(250, 184, 140), Decay = RGB(150, 96, 110), Glare = 0.6, Haze = 1.3 },
	Color = { Saturation = 0.12, Contrast = 0.12, Brightness = 0.01, Tint = RGB(255, 236, 218) },
	Bloom = { Intensity = 0.42, Size = 22, Threshold = 1.9 },
	Clouds = 0.3,
	CloudColor = RGB(255, 186, 150),
	SunRays = 0.12,
	Wind = V(6, 0, 2),
	TerrainColors = { Grass = RGB(104, 128, 70), Ground = RGB(120, 106, 84), Asphalt = RGB(80, 82, 86) },
}

Lighting.Variants = {
	{
		Name = "Mediodía",
		Chance = 0.3,
		ClockTime = 13,
		Brightness = 3,
		Exposure = -0.05,
		Ambient = RGB(92, 94, 100),
		OutdoorAmbient = RGB(150, 152, 160),
		Atmosphere = { Density = 0.26, Offset = 0.1, Color = RGB(206, 216, 230), Decay = RGB(124, 140, 160), Glare = 0.2, Haze = 1 },
		Color = { Saturation = 0.1, Contrast = 0.12, Brightness = 0, Tint = RGB(255, 250, 246) },
		CloudColor = RGB(255, 255, 255),
		Clouds = 0.4,
		SunRays = 0.05,
	},
	{
		Name = "Noche",
		Chance = 0.25,
		ClockTime = 21.3,
		Brightness = 1.1,
		Exposure = 0.35,
		Ambient = RGB(66, 72, 98),
		OutdoorAmbient = RGB(82, 92, 126),
		Atmosphere = { Density = 0.28, Offset = 0.06, Color = RGB(62, 70, 108), Decay = RGB(26, 30, 56), Glare = 0, Haze = 1 },
		Color = { Saturation = 0.05, Contrast = 0.14, Brightness = 0.03, Tint = RGB(214, 222, 255) },
		Bloom = { Intensity = 0.65, Size = 24, Threshold = 1.5 },
		Clouds = 0.25,
		CloudColor = RGB(70, 76, 104),
		SunRays = 0,
	},
}

return Lighting
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="109">
              <Properties>
                <string name="Name">Props</string>
                <string name="Source"><![CDATA[-- TERMINAL · props: el avión (hito y gran divisor del centro), cobertura de plataforma (contenedores
-- de carga aérea, trenes de equipaje, cisterna, furgonetas, escalerilla), interior de la terminal
-- (mostradores, asientos, cintas) y el decorado (torre de control, pista, focos, pintura).
local Props = {}

local V = Vector3.new
local CF = CFrame.new
local RGB = Color3.fromRGB
local rad = math.rad
local M = Enum.Material

local L = 10
local ALONG_Z = CFrame.Angles(0, math.pi / 2, 0)

function Props.build(T)
	local G = T.G
	local night = T.isNight()

	---------------------------------------------------------------------------
	-- Avión en el centro (morro hacia la terminal); las piezas que chocan se tapan por arriba
	---------------------------------------------------------------------------
	T.cap(T.airliner(CF(0, 0, -6), { Stripe = RGB(40, 92, 190), Length = 84, Diameter = 11, Span = 40, Bottom = 3 }))
	-- Servicio del avión: grupo de energía, cinta cargadora y escalerilla trasera
	for _, s in { -1, 1 } do
		T.gpu(CF(s * 10, 0, -30) * CFrame.Angles(0, rad(s * 20), 0))
		T.beltLoader(CF(s * 9.5, 0, 22) * CFrame.Angles(0, rad(s * 12), 0))
	end

	---------------------------------------------------------------------------
	-- Cobertura en el eje
	---------------------------------------------------------------------------
	-- Plataforma A: escalerilla delante del morro y contenedores a los lados del sitio
	T.airstairs(CF(0, 0, -47))
	for _, s in { -1, 1 } do
		T.uld(CF(s * 12, 0, -72) * CFrame.Angles(0, rad(s * 8), 0), s < 0 and "ContainerBlue" or "ContainerRed")
		T.baggageCart(CF(s * 7, 0, -56), RGB(60, 90, 140))
	end
	-- Detrás de la cola: tren de equipaje a lo largo (corta la línea de un lado a otro)
	T.baggageTrain(CF(0, 0, 46) * CFrame.Angles(0, math.pi, 0), 2)
	-- Carga (sitio B): furgoneta delante del sitio y contenedores apilados
	T.van(CF(0, 0, 86), RGB(40, 92, 190))
	for _, s in { -1, 1 } do
		T.uld(CF(s * 16, 0, 90), "ContainerBlue")
		T.uld(CF(s * 25, 0, 103) * CFrame.Angles(0, rad(90), 0), "ContainerGray")
		T.uld(CF(s * 25, 5.4, 103) * CFrame.Angles(0, rad(90), 0), "ContainerYellow")
		T.crateStack(CF(s * 12, 4, 114), "Wall")
		local tube = G.deco("CanopyLight", V(1.2, 0.3, 30), CF(s * 14, L - 0.3, 98), { RGB(236, 244, 255), M.Neon })
		tube.CastShadow = false
		T.Kit.light(tube, "PointLight", RGB(230, 240, 255), 26, 1)
	end
	-- Terminal (dentro): mostradores de facturación, cintas, asientos y paneles
	for _, s in { -1, 1 } do
		for _, x in { 18, 52 } do
			G.box("CheckIn", V(10, 3.4, 2.4), CF(s * x, 1.7, -100), "TerminalWall")
			G.deco("CheckInStripe", V(10.1, 0.6, 2.5), CF(s * x, 2.6, -100), x == 18 and "Red" or "Blue")
			G.deco("CheckInSign", V(10, 1.4, 0.3), CF(s * x, 8, -103), "Blue")
		end
		G.box("BagBelt", V(16, 1.4, 4), CF(s * 50, 0.7, -120), "TerminalDark")
		for _, x in { 10, 44 } do
			for _, z in { -96, -102 } do
				G.box("SeatRow", V(10, 1.6, 1.6), CF(s * x, L + 0.8, z), "Carpet")
				G.deco("SeatBack", V(10, 1.6, 0.3), CF(s * x, L + 2.4, z + 0.7), "Carpet")
			end
		end
	end
	-- Suelo de baldosa, luces de techo y plantas
	G.deco("HallTiles", V(138, 0.06, 46), CF(0, 0.03, -106), "Tile").CastShadow = false
	T.Kit.floorJoints(CF(0, 0.02, -106), 138, 46, 6, RGB(170, 172, 178))
	for _, x in { -54, -30, -6, 18, 42 } do
		for _, level in { 0, L } do
			local tube = G.deco("CeilingLight", V(14, 0.3, 1.2), CF(x + 6, level + L - 0.25, -106), { RGB(240, 246, 255), M.Neon })
			tube.CastShadow = false
			if x == -30 or x == 18 then
				T.Kit.light(tube, "PointLight", RGB(236, 244, 255), 26, 0.9)
			end
		end
	end
	for _, s in { -1, 1 } do
		T.planter(CF(s * 6, 0, -124), 6, 3)
		T.planter(CF(s * 60, L, -110) * CFrame.Angles(0, rad(90), 0), 6, 3)
	end
	local board = T.sign(CF(0, L + 7, -129.3), "SALIDAS · PUERTAS A1 – A8", 30, 3, RGB(18, 22, 30), RGB(255, 200, 60), { PPS = 16, Glow = true })
	board.CastShadow = false
	T.sign(CF(0, 4, -129.3), "LLEGADAS · RECOGIDA DE EQUIPAJE", 26, 2.2, RGB(18, 22, 30), RGB(240, 240, 240), { PPS = 16, Glow = true })

	T.mirrored("TerminalProps", function()
		Props.half(T)
	end)

	---------------------------------------------------------------------------
	-- Lonas A / B, rótulos
	---------------------------------------------------------------------------
	T.letterBanner(CF(0, L + 5.5, -81.6) * CFrame.Angles(0, math.pi, 0), "A", "Red", 8, 9)
	T.letterBanner(CF(0, 6.4, 77.4), "B", "Blue", 6, 5)
	T.sign(CF(0, 2 * L + 0.2, -73.8) * CFrame.Angles(0, math.pi, 0), "TERMINAL 1", 20, 1.6, RGB(36, 44, 60), RGB(250, 250, 250), { PPS = 18, Glow = true })
	T.sign(CF(-24, L - 0.2, 76.8), "CARGA · CARGO", 14, 1.4, RGB(36, 44, 60), RGB(244, 190, 40), { PPS = 18 })

	---------------------------------------------------------------------------
	-- Suelo: línea de rodaje amarilla, marcas de los puestos, franjas de seguridad
	---------------------------------------------------------------------------
	G.paintLine(V(0, 0, -78), V(0, 0, 76), 0.7)
	for _, s in { -1, 1 } do
		G.paintLine(V(s * 46, 0, -40), V(s * 46, 0, 40), 0.5)
		G.paintLine(V(s * 46, 0, -40), V(s * 112, 0, -40), 0.5)
		G.paintLine(V(s * 46, 0, 40), V(s * 112, 0, 40), 0.5)
		G.paintLine(V(s * 70, 0, -82), V(s * 70, 0, -40), 0.5)
	end
	G.paintLine(V(-46, 0, -80), V(46, 0, -80), 0.5, "Red")
	G.hazardStripes(CF(0, 0, 76), 80, 1.2)

	---------------------------------------------------------------------------
	-- Fondo: torre de control tras la terminal, pista con marcas, hangares lejanos y focos
	---------------------------------------------------------------------------
	T.controlTower(CF(-46, 0, -178), 70)
	G.deco("Runway", V(1400, 0.1, 60), CF(0, 0.05, 230), "Tarmac").CastShadow = false
	for x = -640, 640, 40 do
		G.deco("RunwayDash", V(16, 0.12, 1.2), CF(x, 0.06, 230), "Paint").CastShadow = false
	end
	G.deco("Taxiway", V(1400, 0.08, 24), CF(0, 0.04, 170), "Tarmac").CastShadow = false
	for _, x in { -300, -200, 220, 330 } do
		T.cityBlock(CF(x, 0, -200), 50, 40, 22, RGB(196, 200, 206), { Lit = night, Roof = true })
	end
	for _, spec in { { V(-600, -60, 500), 200 }, { V(500, -70, 560), 220 }, { V(700, -60, -300), 200 } } do
		T.Kit.naturalHill(spec[1], spec[2], M.Rock)
	end
	T.skylineRing(V(0, 0, -480), 260, 200, 340, 9, { RGB(170, 160, 168), RGB(150, 146, 156), RGB(190, 176, 170) }, { Lit = night, MinH = 30, VarH = 50, TowerEvery = 4, TowerExtra = 50, FloorH = 10 })
end

-- Mitad del Rojo (X < 0)
function Props.half(T)
	local G = T.G

	------------------------------------------------------------------
	-- HANGAR (base): contenedores delante del portón central, banco de trabajo y un tractor
	------------------------------------------------------------------
	T.uld(CF(-104, 0, -3) * ALONG_Z, "ContainerGray")
	T.uld(CF(-104, 0, 3) * ALONG_Z, "ContainerGray")
	G.box("Workbench", V(3, 3, 10), CF(-147, 1.5, -30), "TerminalDark")
	T.tug(CF(-142, 0, 30) * CFrame.Angles(0, rad(90), 0))
	T.sign(CF(-112.2, 15.5, 0) * CFrame.Angles(0, -math.pi / 2, 0), "HANGAR 2", 12, 2.4, RGB(36, 44, 60), RGB(250, 250, 250), { PPS = 16 })
	for _, z in { -24, 0, 24 } do
		local lamp = G.deco("HangarLamp", V(4, 0.4, 4), CF(-131, 21.2, z), { RGB(255, 240, 210), M.Neon })
		T.Kit.light(lamp, "PointLight", RGB(255, 236, 200), 26, 1)
	end

	------------------------------------------------------------------
	-- CARRETERA DE SERVICIO (norte): furgoneta, barreras, contenedor y conos
	------------------------------------------------------------------
	T.van(CF(-88, 0, -62) * CFrame.Angles(0, rad(90), 0), RGB(220, 120, 30))
	T.jersey(CF(-100, 0, -84) * ALONG_Z, 8)
	T.container(CF(-82, 0, -46), "ContainerRed")
	T.cones(V(-74, 0, -76), V(-74, 0, -66), 4)
	-- Muelle cubierto (dentro): furgoneta, contenedores y persianas
	T.van(CF(-102, 0, -114), RGB(40, 92, 190))
	T.uld(CF(-84, 0, -122), "ContainerRed")
	T.uld(CF(-78, 0, -106) * CFrame.Angles(0, rad(20), 0), "ContainerBlue")
	T.crateStack(CF(-92, 0, -104), "L")
	for _, x in { -104, -91, -78 } do
		G.deco("RollerDoor", V(9, 7, 0.3), CF(x, 3.5, -129.8), "TerminalPanel")
	end
	local dockLamp = G.deco("DockLamp", V(16, 0.3, 0.6), CF(-91, L - 0.3, -113), { RGB(220, 236, 255), M.Neon })
	T.Kit.light(dockLamp, "PointLight", RGB(210, 230, 255), 22, 1)

	------------------------------------------------------------------
	-- PLATAFORMA A (mitad oeste): tren de equipaje y contenedor
	------------------------------------------------------------------
	T.baggageTrain(CF(-56, 0, -70) * CFrame.Angles(0, rad(-90), 0), 2)
	T.uld(CF(-36, 0, -46), "ContainerYellow")

	------------------------------------------------------------------
	-- PLATAFORMA (centro oeste): cisterna, contenedores, carros y focos
	------------------------------------------------------------------
	T.fuelTruck(CF(-58, 0, 10))
	T.uld(CF(-80, 0, -24), "ContainerBlue")
	T.uld(CF(-80, 5.4, -24) * CFrame.Angles(0, rad(6), 0), "ContainerGray")
	T.baggageCart(CF(-84, 0, 20) * CFrame.Angles(0, rad(90), 0), RGB(150, 60, 50))
	T.baggageCart(CF(-34, 0, -24) * CFrame.Angles(0, rad(10), 0), RGB(60, 90, 140))
	T.cones(V(-46, 0, -14), V(-46, 0, 14), 5)
	-- Deflectores de chorro delante del hangar (cortan la vista larga de la plataforma)
	T.blastFence(CF(-90, 0, -14) * CFrame.Angles(0, rad(90), 0), 14)
	T.blastFence(CF(-90, 0, 18) * CFrame.Angles(0, rad(90), 0), 10)
	T.baggageTrain(CF(-70, 0, 26) * CFrame.Angles(0, rad(-90), 0), 1)
	T.gpu(CF(-66, 0, -8))
	T.uld(CF(-50, 0, -32), "ContainerGray")
	T.apronLight(CF(-100, 0, -36) * CFrame.Angles(0, rad(-120), 0), 24)
	T.apronLight(CF(-100, 0, 36) * CFrame.Angles(0, rad(-60), 0), 24)

	------------------------------------------------------------------
	-- Sur: catering, contenedores y la valla del borde
	------------------------------------------------------------------
	T.van(CF(-52, 0, 62) * CFrame.Angles(0, rad(-10), 0), RGB(200, 60, 50))
	T.uld(CF(-76, 0, 96), "ContainerRed")
	T.uld(CF(-62, 0, 110) * CFrame.Angles(0, rad(30), 0), "ContainerBlue")
	T.container(CF(-92, 0, 106), "ContainerTan")
	T.cones(V(-66, 0, 84), V(-56, 0, 84), 4)
	T.sign(CF(-81, 9.5, 79.8) * CFrame.Angles(0, math.pi, 0), "CATERING", 10, 1.6, RGB(36, 44, 60), RGB(250, 250, 250), { PPS = 18 })
end

return Props
]]></string>
              </Properties>
            </Item>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="110">
          <Properties>
            <string name="Name">MapKit</string>
            <string name="Source"><![CDATA[-- Kit de construcción de mapas: piezas reutilizables (contenedores, edificios, palmeras, grúas...),
-- iluminación por mapa y puntos especiales (spawns, bandera, zonas, spawns libres).
local Lighting = game:GetService("Lighting")

local GameConfig = require(game:GetService("ReplicatedStorage").Shared.GameConfig)

local Kit = {}

Kit.folder = nil -- carpeta del mapa actual (la crea Begin)

-- Rotación de 180° alrededor del centro: la mitad Azul es espejo de la Roja
Kit.MIRROR = CFrame.Angles(0, math.pi, 0)

function Kit.symmetric(fn)
	fn(CFrame.new(), "A")
	fn(Kit.MIRROR, "B")
end

local rad = math.rad
local V = Vector3.new
local RGB = Color3.fromRGB

Kit.C = {
	Metal = RGB(60, 62, 70),
	Yellow = RGB(255, 205, 50),
	White = RGB(245, 245, 250),
	Wood = RGB(176, 124, 70),
	WoodDark = RGB(120, 80, 45),
	Leaf = RGB(80, 180, 80),
	LeafDark = RGB(50, 140, 60),
	Pink = RGB(255, 80, 170),
	Cyan = RGB(0, 220, 255),
	Red = RGB(210, 50, 45),
	Blue = RGB(45, 110, 220),
}
local C = Kit.C

-- Realismo: el plástico liso parece de juguete. Las piezas grandes pasan a materiales PBR reales
-- (yeso pintado si tienen color, hormigón si son oscuras o son suelos); lo pequeño (conos, flores,
-- carteles) se queda como está. Lo usan Kit.block y los mapas con su propia función de piezas.
function Kit.realisticMaterial(size, color, material)
	material = material or Enum.Material.SmoothPlastic
	if material ~= Enum.Material.SmoothPlastic and material ~= Enum.Material.Plastic then
		return material
	end
	local volume = size.X * size.Y * size.Z
	local flatFloor = size.Y <= 0.6 and size.X * size.Z >= 60
	if volume < 30 and not flatFloor then
		return material
	end
	local luminance = color.R * 0.3 + color.G * 0.59 + color.B * 0.11
	if flatFloor or luminance < 0.22 then
		return Enum.Material.Concrete
	end
	return Enum.Material.Plaster
end

-- Estilo Cartoon: los materiales "realistas" pasan a plástico liso y los colores ganan viveza; los
-- grises claros tiran a lavanda (paredes tipo shooter de Roblox). Los detalles de suelo no cambian.
-- (Táctico y Realista usan los materiales de verdad; solo cambia la luz: ver tacticalize y realize)
local function realMaterials()
	return GameConfig.VisualStyle == "Realista" or GameConfig.VisualStyle == "Tactico"
end
Kit.Cartoon = not realMaterials()
Kit.Designed = false -- (mapa hecho ya realista: ver Kit.Begin)
local CARTOON_FLAT = {}
for _, name in {
	"Plaster", "Concrete", "Brick", "Limestone", "Cobblestone", "Slate", "Pavement", "Asphalt", "Granite", "Marble",
	"Sandstone", "Pebble", "CorrodedMetal", "DiamondPlate", "Rock", "Basalt", "Plastic", "Grass", "LeafyGrass",
	"ClayRoofTiles", "CeramicTiles", "Fabric",
} do
	local ok, material = pcall(function()
		return (Enum.Material :: any)[name]
	end)
	if ok and material then
		CARTOON_FLAT[material] = true
	end
end
local KEEP_LOOK = {
	ContactShadow = true, OilStain = true, Crack = true, Joint = true, TireMark = true, Puddle = true,
	-- Nata y caramelo blanco de Arena Caramelo (si no, el blanco se volvería lavanda)
	CandyWhite = true, CakeFrosting = true, FrostingDrip = true, GumdropShine = true,
	LollipopStick = true, LollipopSwirl = true, CottonStick = true,
	CastleTop = true, JumpPadRing = true, -- blancos de Caja de Juguetes y de las plataformas de salto
}

-- Tono de los grises en estilo Cartoon (cada mapa puede tener el suyo: Lighting.CartoonNeutral)
Kit.Neutral = { Hue = 0.68, Sat = 0.16 } -- lavanda por defecto

function Kit.vivid(color)
	local h, s, v = color:ToHSV()
	if s < 0.22 then
		local neutral = Kit.Neutral
		if v >= 0.45 then
			-- piedra, yeso, gris claro → pastel del tono del mapa (lavanda por defecto)
			return Color3.fromHSV(neutral.Hue, neutral.Sat, math.min(1, v * 1.02 + 0.05))
		elseif v >= 0.2 then
			-- asfalto, hormigón oscuro → gris con un toque del mismo tono
			return Color3.fromHSV(neutral.Hue, math.min(0.35, neutral.Sat + 0.08), math.min(1, v * 1.12))
		end
		return color -- negros
	end
	return Color3.fromHSV(h, math.clamp(s * 1.45, 0, 0.95), math.clamp(v * 1.1 + 0.04, 0, 1))
end

-- Estilo realista en mapas pensados para Cartoon: los colores muy vivos pasan a pintura de verdad
-- (menos saturados y no tan claros); los grises y los marrones casi no cambian
function Kit.natural(color)
	local h, s, v = color:ToHSV()
	if s < 0.25 then
		return color
	end
	return Color3.fromHSV(h, s * (s > 0.6 and 0.78 or 0.88), v > 0.85 and v * 0.93 or v)
end

function Kit.applyStyle(part)
	if KEEP_LOOK[part.Name] or part.Material == Enum.Material.Neon then
		return
	end
	if not Kit.Cartoon then
		-- (los mapas hechos ya realistas, como los de TacKit, tienen sus colores pensados)
		if not Kit.Designed then
			part.Color = Kit.natural(part.Color)
		end
		return
	end
	if CARTOON_FLAT[part.Material] then
		part.Material = Enum.Material.SmoothPlastic
	end
	-- Textura de cuadrícula (MaterialVariant "Grid" en MaterialService, ver assets/textures/LEEME.md).
	-- Si la variante no existe todavía, Roblox usa el plástico liso normal: no rompe nada.
	if part.Material == Enum.Material.SmoothPlastic then
		part.MaterialVariant = "Grid"
	end
	part.Color = Kit.vivid(part.Color)
end

function Kit.block(name, size, cf, color, material, parent)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = Kit.realisticMaterial(size, color, material)
	if part.Material == Enum.Material.Glass then
		part.Reflectance = 0.15 -- los cristales reflejan un poco el cielo
	end
	Kit.applyStyle(part)
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent or Kit.folder
	return part
end
local block = Kit.block

-- Pieza decorativa: no choca, no bloquea disparos y no hace sombra
function Kit.deco(name, size, cf, color, material, parent)
	local part = block(name, size, cf, color, material, parent)
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	-- Realismo con coste medio: solo lo grande (grúas, tejados, barcos, copas) proyecta sombra
	part.CastShadow = size.X * size.Y * size.Z >= 20 and part.Material ~= Enum.Material.Neon and part.Material ~= Enum.Material.Glass
	return part
end
local deco = Kit.deco

-- Cilindro de pie (el eje del cilindro en Roblox es X; lo giramos para que sea vertical)
function Kit.cylinder(name, height, diameter, cf, color, material, parent, decorative)
	local fn = decorative and deco or block
	local part = fn(name, V(height, diameter, diameter), cf * CFrame.Angles(0, 0, math.pi / 2), color, material, parent)
	part.Shape = Enum.PartType.Cylinder
	return part
end
local cylinder = Kit.cylinder

-- Cilindro tumbado a lo largo del eje X local
function Kit.pipe(name, length, diameter, cf, color, material, decorative)
	local fn = decorative and deco or block
	local part = fn(name, V(length, diameter, diameter), cf, color, material)
	part.Shape = Enum.PartType.Cylinder
	return part
end

function Kit.ball(name, diameter, cf, color, material, decorative)
	local fn = decorative and deco or block
	local part = fn(name, V(diameter, diameter, diameter), cf, color, material)
	part.Shape = Enum.PartType.Ball
	return part
end

-- Texto pegado a una cara de una pieza (carteles, rótulos de neón...)
function Kit.sign(part, face, text, color, strokeColor)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeColor3 = strokeColor or Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0
	label.Parent = gui
	return gui
end
local sign = Kit.sign

function Kit.light(part, kind, color, range, brightness, face)
	local light = Instance.new(kind or "PointLight")
	light.Color = color
	light.Range = range or 12
	light.Brightness = brightness or 1.5
	if face and (light:IsA("SpotLight") or light:IsA("SurfaceLight")) then
		light.Face = face
	end
	-- Los focos (farolas, lámparas) proyectan sombras reales; el menú Ajustes las apaga en Baja/Media
	if light:IsA("SpotLight") then
		light.Shadows = true
		light:SetAttribute("QualityShadow", true)
	end
	light.Parent = part
	return light
end

-- Rampa inclinada desde "bottom" hasta "top" (posiciones de la superficie)
function Kit.ramp(bottom, top, width, color, material)
	local mid = (bottom + top) / 2
	local length = (top - bottom).Magnitude
	local cf = CFrame.lookAt(mid, top) * CFrame.new(0, -0.5, 0)
	local part = block("Ramp", V(width, 1, length + 1), cf, color or RGB(150, 152, 165), material or Enum.Material.DiamondPlate)
	for _, side in { -1, 1 } do
		deco("RampEdge", V(0.4, 0.1, length + 1), cf * CFrame.new(side * (width / 2 - 0.3), 0.52, 0), C.Yellow, Enum.Material.SmoothPlastic)
	end
	return part
end

-- Escalera de piedra (rampa con escalones decorativos)
function Kit.stairs(bottom, top, width, color, material)
	local part = Kit.ramp(bottom, top, width, color, material or Enum.Material.Concrete)
	local steps = math.max(3, math.floor((top - bottom).Magnitude / 1.6))
	local stepColor = (color or RGB(200, 190, 170)):Lerp(Color3.new(0, 0, 0), 0.12)
	for i = 0, steps - 1 do
		local p = bottom:Lerp(top, (i + 0.5) / steps)
		local dir = (top - bottom)
		local flat = V(dir.X, 0, dir.Z).Unit
		deco("Step", V(width, 0.3, 0.3), CFrame.lookAt(p, p + flat) * CFrame.new(0, 0.05, 0), stepColor, Enum.Material.Concrete)
	end
	return part
end

-- Barandilla entre dos puntos (altura h)
function Kit.railing(a, b, h, color)
	h = h or 3
	color = color or C.Metal
	local length = (b - a).Magnitude
	local mid = (a + b) / 2
	local cf = CFrame.lookAt(mid, b)
	deco("Handrail", V(0.25, 0.25, length), cf * CFrame.new(0, h, 0), color, Enum.Material.Metal)
	deco("MidRail", V(0.15, 0.15, length), cf * CFrame.new(0, h * 0.5, 0), color, Enum.Material.Metal)
	local posts = math.max(2, math.floor(length / 4))
	for i = 0, posts do
		local p = a:Lerp(b, i / posts)
		deco("RailPost", V(0.25, h, 0.25), CFrame.new(p + V(0, h / 2, 0)), color, Enum.Material.Metal)
	end
	-- colisión invisible para no caerse (en la carpeta Boundary: las balas y la vista la atraviesan)
	local wall = block("RailCollider", V(0.4, h, length), cf * CFrame.new(0, h / 2, 0), color, nil, Kit.shootThroughFolder())
	wall.Transparency = 1
	wall.CastShadow = false
end

-- Carpeta para lo que choca pero no para las balas ni la vista (barandillas, alambradas): es la de
-- los muros del borde (Map.Boundary), que todos los raycasts del juego excluyen. CanQuery = false
-- no sirve en piezas que colisionan.
function Kit.shootThroughFolder()
	local folder = Kit.folder:FindFirstChild("Boundary")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Boundary"
		folder.Parent = Kit.folder
	end
	return folder
end

---------------------------------------------------------------------------
-- Piezas
---------------------------------------------------------------------------

-- Sombra de contacto (oclusión ambiental falsa): dos láminas oscuras semitransparentes algo más
-- grandes que la base, para que lo que está en el suelo parezca apoyado y no flotando. Solo a ras
-- de suelo (encima de otro objeto no hace falta). Material rugoso: el plástico liso brillaba con el
-- cielo y la sombra se veía más clara que el suelo.
function Kit.contactShadow(cf, sizeX, sizeZ, round, parent)
	local pos = cf.Position
	if math.abs(pos.Y) > 0.6 then
		return
	end
	local yaw = cf - pos
	for i, spec in { { 0.45, 0.7 }, { 1.2, 0.86 } } do
		local grow = spec[1] * 2
		local shadow
		if round then
			local d = math.max(sizeX, sizeZ) + grow
			shadow = deco("ContactShadow", V(0.02, d, d), CFrame.new(pos + V(0, 0.012 + i * 0.003, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.new(0, 0, 0), Enum.Material.Concrete, parent)
			shadow.Shape = Enum.PartType.Cylinder
		else
			shadow = deco("ContactShadow", V(sizeX + grow, 0.02, sizeZ + grow), CFrame.new(pos + V(0, 0.012 + i * 0.003, 0)) * yaw, Color3.new(0, 0, 0), Enum.Material.Concrete, parent)
		end
		shadow.Transparency = spec[2]
		shadow.CastShadow = false
	end
end

local CARGO_NAMES = { "HYPER CARGO", "NEXO LINE", "FROST CO.", "TURBO SHIP", "BLAZE LOG.", "VOLT MARINE" }
local cargoIndex = 0

function Kit.container(cf, color, labelText)
	local model = Instance.new("Model")
	model.Name = "Container"
	model.Parent = Kit.folder
	local size = V(20, 8.5, 8)
	local body = block("Body", size, cf * CFrame.new(0, size.Y / 2, 0), color, Enum.Material.CorrodedMetal, model)
	Kit.contactShadow(cf, size.X, size.Z, false, model)
	local dark = color:Lerp(Color3.new(0, 0, 0), 0.35)
	-- Nervios, techo y marco van pegados al cuerpo: su sombra ya la da el cuerpo (sin sombra propia)
	for i = -4, 4, 2 do
		deco("Rib", V(0.4, 8.2, 8.3), cf * CFrame.new(i * 2.2, 4.25, 0), dark, Enum.Material.Metal, model).CastShadow = false
	end
	block("Roof", V(20.2, 0.3, 8.2), cf * CFrame.new(0, 8.6, 0), dark, Enum.Material.Metal, model).CastShadow = false
	deco("DoorFrame", V(0.3, 8.6, 8.4), cf * CFrame.new(10.1, 4.25, 0), dark, Enum.Material.Metal, model).CastShadow = false
	for _, z in { -2, 2 } do
		deco("LockBar", V(0.3, 7.6, 0.25), cf * CFrame.new(10.3, 4.25, z), RGB(200, 200, 205), Enum.Material.Metal, model)
	end
	deco("DoorSplit", V(0.35, 8, 0.15), cf * CFrame.new(10.3, 4.25, 0), RGB(30, 30, 30), Enum.Material.Metal, model)
	-- Desgaste: chorretones de óxido que bajan desde el techo en los dos laterales largos
	local rust = color:Lerp(RGB(105, 58, 34), 0.6)
	for i, x in { -7.7, 3.3, 5.5 } do
		local side = i % 2 == 0 and 1 or -1
		local length = 2 + ((cargoIndex + i) % 3) * 1.4
		deco("RustStreak", V(0.9, length, 0.06), cf * CFrame.new(x, 8.45 - length / 2, side * 4.04), rust, Enum.Material.CorrodedMetal, model)
	end
	cargoIndex = cargoIndex % #CARGO_NAMES + 1
	local text = labelText or CARGO_NAMES[cargoIndex]
	sign(body, Enum.NormalId.Front, text, Color3.new(1, 1, 1), dark)
	sign(body, Enum.NormalId.Back, text, Color3.new(1, 1, 1), dark)
	return model
end

function Kit.crate(cf, size, color)
	size = size or 4
	local core = block("Crate", V(size, size, size), cf * CFrame.new(0, size / 2, 0), color or C.Wood, Enum.Material.WoodPlanks)
	Kit.contactShadow(cf, size, size)
	for _, y in { 0.12, 0.88 } do
		deco("CrateBand", V(size + 0.15, size * 0.12, size + 0.15), cf * CFrame.new(0, size * y, 0), C.WoodDark, Enum.Material.Wood)
	end
	deco("CrateCross", V(size + 0.1, size * 0.1, size * 1.3), cf * CFrame.new(0, size / 2, 0) * CFrame.Angles(rad(45), 0, 0), C.WoodDark, Enum.Material.Wood)
	return core
end

-- Caja metálica con chevron (estilo industrial)
function Kit.metalCrate(cf, size, color, glow)
	size = size or 5
	local core = block("MetalCrate", V(size, size, size), cf * CFrame.new(0, size / 2, 0), color or RGB(70, 75, 90), Enum.Material.DiamondPlate)
	Kit.contactShadow(cf, size, size)
	deco("CrateRim", V(size + 0.2, 0.3, size + 0.2), cf * CFrame.new(0, size - 0.15, 0), RGB(40, 42, 50), Enum.Material.Metal)
	deco("CrateRimB", V(size + 0.2, 0.3, size + 0.2), cf * CFrame.new(0, 0.15, 0), RGB(40, 42, 50), Enum.Material.Metal)
	if glow then
		deco("CrateGlow", V(size + 0.05, 0.2, size * 0.6), cf * CFrame.new(0, size * 0.5, 0), glow, Enum.Material.Neon)
	end
	return core
end

function Kit.barrel(cf, color)
	cylinder("Barrel", 3, 2, cf * CFrame.new(0, 1.5, 0), color or RGB(40, 90, 180), Enum.Material.Metal)
	Kit.contactShadow(cf, 2, 2, true)
	cylinder("BarrelRing", 0.2, 2.06, cf * CFrame.new(0, 0.8, 0), RGB(40, 40, 45), Enum.Material.Metal, nil, true)
	cylinder("BarrelRing", 0.2, 2.06, cf * CFrame.new(0, 2.2, 0), RGB(40, 40, 45), Enum.Material.Metal, nil, true)
end

function Kit.cone(cf)
	cylinder("ConeBase", 0.2, 1.4, cf * CFrame.new(0, 0.1, 0), RGB(255, 120, 20), Enum.Material.SmoothPlastic, nil, true)
	cylinder("Cone", 1.4, 0.8, cf * CFrame.new(0, 0.8, 0), RGB(255, 120, 20), Enum.Material.SmoothPlastic, nil, true)
	cylinder("ConeStripe", 0.25, 0.85, cf * CFrame.new(0, 0.9, 0), C.White, Enum.Material.SmoothPlastic, nil, true)
end

function Kit.barrier(size, cf)
	local part = block("Barrier", size, cf * CFrame.new(0, size.Y / 2, 0), RGB(225, 225, 230), Enum.Material.Concrete)
	Kit.contactShadow(cf, size.X, size.Z)
	local long = size.X >= size.Z
	local length = long and size.X or size.Z
	local count = math.max(2, math.floor(length / 3))
	for i = 0, count - 1 do
		local offset = -length / 2 + (i + 0.5) * (length / count)
		local color = i % 2 == 0 and RGB(230, 50, 50) or RGB(250, 250, 250)
		local stripeSize = long and V(length / count, 1, size.Z + 0.1) or V(size.X + 0.1, 1, length / count)
		local pos = long and CFrame.new(offset, size.Y - 1.2, 0) or CFrame.new(0, size.Y - 1.2, offset)
		deco("Stripe", stripeSize, cf * pos, color, Enum.Material.SmoothPlastic)
	end
	return part
end

function Kit.streetLamp(cf, color)
	cylinder("Pole", 14, 0.6, cf * CFrame.new(0, 7, 0), C.Metal, Enum.Material.Metal)
	cylinder("Base", 1, 1.2, cf * CFrame.new(0, 0.5, 0), C.Metal, Enum.Material.Metal)
	deco("Arm", V(0.4, 0.4, 4), cf * CFrame.new(0, 13.8, -1.8), C.Metal, Enum.Material.Metal)
	deco("Lamp", V(1.6, 0.5, 2.2), cf * CFrame.new(0, 13.4, -3.6), C.Metal, Enum.Material.Metal)
	local bulb = deco("Bulb", V(1.2, 0.2, 1.8), cf * CFrame.new(0, 13.1, -3.6), color or RGB(255, 240, 200), Enum.Material.Neon)
	Kit.light(bulb, "SpotLight", color or RGB(255, 235, 200), 26, 1.5, Enum.NormalId.Bottom).Angle = 100
end

function Kit.tree(cf)
	block("Planter", V(5, 1.6, 5), cf * CFrame.new(0, 0.8, 0), RGB(200, 200, 208), Enum.Material.Concrete)
	deco("Soil", V(4.4, 0.2, 4.4), cf * CFrame.new(0, 1.65, 0), RGB(90, 60, 40), Enum.Material.Ground)
	cylinder("Trunk", 7, 0.9, cf * CFrame.new(0, 5, 0), RGB(110, 75, 45), Enum.Material.Wood)
	for i, spec in {
		{ V(0, 9.5, 0), 6.5, C.Leaf },
		{ V(1.6, 8.4, 1), 4.5, C.LeafDark },
		{ V(-1.5, 8.8, -1.2), 4.8, C.Leaf },
		{ V(0.3, 11.6, -0.4), 4, C.LeafDark },
	} do
		local leaf = deco("Leaves" .. i, V(spec[2], spec[2], spec[2]), cf * CFrame.new(spec[1]), spec[3], Enum.Material.LeafyGrass)
		leaf.Shape = Enum.PartType.Ball
		leaf.CastShadow = true
	end
end

-- Palmera: tronco inclinado por segmentos y hojas largas
function Kit.palm(cf, height)
	height = height or 14
	local segments = 6
	local lean = rad(8)
	local pos = cf
	for i = 1, segments do
		local seg = height / segments
		local piece = cylinder("PalmTrunk", seg + 0.2, 1.1 - i * 0.07, pos * CFrame.new(0, seg / 2, 0), RGB(140, 105, 70), Enum.Material.Wood, nil, i > 2)
		piece.CanCollide = i <= 2
		deco("TrunkRing", V(0.25, 1.2 - i * 0.07, 1.2 - i * 0.07), pos * CFrame.new(0, seg, 0) * CFrame.Angles(0, 0, math.pi / 2), RGB(110, 80, 50), Enum.Material.Wood).Shape = Enum.PartType.Cylinder
		pos = pos * CFrame.new(0, seg, 0) * CFrame.Angles(lean / segments * 2, 0, 0)
	end
	local top = pos
	for i = 0, 6 do
		local angle = i * math.pi * 2 / 7
		local frond = deco(
			"Frond",
			V(1.6, 0.25, 7),
			top * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0.2, -3.2) * CFrame.Angles(rad(-20), 0, 0),
			i % 2 == 0 and RGB(70, 170, 70) or RGB(50, 140, 55),
			Enum.Material.Grass
		)
		frond.CastShadow = true
	end
	Kit.ball("Coconuts", 1.4, top * CFrame.new(0, -0.4, 0), RGB(110, 80, 40), Enum.Material.Wood, true)
end

-- Enredadera colgando de una pared (cara mirando en la dirección `normal`)
function Kit.vines(cf, width, height)
	for i = 0, math.floor(width / 1.5) do
		local h = height * (0.5 + ((i * 37) % 10) / 20)
		deco("Vine", V(1.2, h, 0.3), cf * CFrame.new(-width / 2 + i * 1.5, -h / 2, 0), (i % 2 == 0) and RGB(70, 150, 60) or RGB(90, 175, 70), Enum.Material.LeafyGrass)
	end
end

-- Estandarte de tela con emblema (cuelga de una pared, cara -Z)
function Kit.banner(cf, width, height, color, emblemColor)
	local cloth = deco("Banner", V(width, height, 0.15), cf * CFrame.new(0, -height / 2, 0), color, Enum.Material.Fabric)
	deco("BannerRod", V(width + 1, 0.3, 0.3), cf, C.Metal, Enum.Material.Metal)
	-- Emblema tipo chevron
	for _, s in { -1, 1 } do
		deco("Emblem", V(width * 0.12, height * 0.35, 0.05), cf * CFrame.new(s * width * 0.13, -height * 0.45, -0.1) * CFrame.Angles(0, 0, rad(35 * s)), emblemColor or C.White, Enum.Material.SmoothPlastic)
	end
	deco("BannerTip", V(width * 0.7, width * 0.7, 0.14), cf * CFrame.new(0, -height, 0) * CFrame.Angles(0, 0, rad(45)), color, Enum.Material.Fabric)
	return cloth
end

-- Toldo inclinado
function Kit.awning(cf, width, depth, color)
	for i = 0, math.floor(width / 1.5) - 1 do
		deco("Awning", V(1.5, 0.25, depth), cf * CFrame.new(-width / 2 + 0.75 + i * 1.5, 0, -depth / 2) * CFrame.Angles(rad(-18), 0, 0), i % 2 == 0 and color or C.White, Enum.Material.Fabric)
	end
end

-- Edificio mediterráneo: estuco, cornisa, ventanas, puerta, azotea transitable con murete
function Kit.house(cf, size, color, accent, options)
	options = options or {}
	local model = Instance.new("Model")
	model.Name = "House"
	model.Parent = Kit.folder
	local trim = color:Lerp(Color3.new(0, 0, 0), 0.18)
	block("Walls", size, cf * CFrame.new(0, size.Y / 2, 0), color, Enum.Material.Plaster, model)
	deco("Base", V(size.X + 0.4, 1.4, size.Z + 0.4), cf * CFrame.new(0, 0.7, 0), trim, Enum.Material.Limestone, model)
	Kit.contactShadow(cf, size.X + 0.4, size.Z + 0.4, false, model)
	deco("Cornice", V(size.X + 0.8, 0.8, size.Z + 0.8), cf * CFrame.new(0, size.Y - 0.4, 0), accent or RGB(200, 70, 50), Enum.Material.Plaster, model)
	-- Murete de la azotea (cobertura)
	local h = 2.6
	for _, z in { -1, 1 } do
		block("Parapet", V(size.X, h, 1), cf * CFrame.new(0, size.Y + h / 2, z * (size.Z / 2 - 0.5)), color, Enum.Material.Plaster, model)
	end
	if not options.OpenSides then
		for _, x in { -1, 1 } do
			block("Parapet", V(1, h, size.Z - 2), cf * CFrame.new(x * (size.X / 2 - 0.5), size.Y + h / 2, 0), color, Enum.Material.Plaster, model)
		end
	end
	-- Ventanas con contraventanas
	local floors = math.max(1, math.floor(size.Y / 7))
	for f = 1, floors do
		local y = (f - 0.5) * size.Y / floors + 0.6
		for _, face in { -1, 1 } do
			for i = 1, math.max(1, math.floor(size.X / 9)) do
				local x = -size.X / 2 + (i - 0.5) * size.X / math.max(1, math.floor(size.X / 9))
				local p = cf * CFrame.new(x, y, face * (size.Z / 2 + 0.1))
				deco("Window", V(2.4, 3.2, 0.2), p, RGB(60, 70, 90), Enum.Material.Glass, model) -- opaco (más barato que semitransparente)
				deco("Sill", V(3, 0.3, 0.6), p * CFrame.new(0, -1.75, 0), trim, Enum.Material.Limestone, model)
				for _, s in { -1, 1 } do
					deco("Shutter", V(1.1, 3.2, 0.15), p * CFrame.new(s * 1.85, 0, face * 0.1), accent or RGB(60, 120, 170), Enum.Material.Wood, model)
				end
			end
		end
	end
	-- Puerta con luz
	local doorCf = cf * CFrame.new(options.DoorX or 0, 3.3, -(size.Z / 2 + 0.12))
	deco("Door", V(3.6, 6.6, 0.25), doorCf, RGB(100, 65, 40), Enum.Material.WoodPlanks, model)
	deco("DoorArch", V(4.6, 0.8, 0.4), doorCf * CFrame.new(0, 3.6, 0), trim, Enum.Material.Limestone, model)
	local lamp = deco("DoorLamp", V(0.6, 0.8, 0.6), doorCf * CFrame.new(2.8, 2.5, -0.3), RGB(255, 210, 140), Enum.Material.Neon, model)
	Kit.light(lamp, "PointLight", RGB(255, 200, 120), 12, 1.2)
	if options.Vines then
		Kit.vines(cf * CFrame.new(size.X * 0.25, size.Y - 0.5, -(size.Z / 2 + 0.25)), 6, 8)
	end
	return model
end

-- Grúa pórtico decorativa (para fondos de puerto)
function Kit.crane(cf, height, color)
	color = color or RGB(240, 190, 40)
	height = height or 40
	for _, x in { -6, 6 } do
		for _, z in { -3, 3 } do
			deco("CraneLeg", V(1.2, height, 1.2), cf * CFrame.new(x, height / 2, z), color, Enum.Material.Metal)
		end
	end
	deco("CraneTop", V(14, 2, 8), cf * CFrame.new(0, height, 0), color, Enum.Material.Metal)
	deco("CraneBoom", V(2, 2, 50), cf * CFrame.new(0, height + 2, -14), color, Enum.Material.Metal)
	deco("CraneCab", V(4, 3, 4), cf * CFrame.new(0, height - 2.5, -6), RGB(230, 230, 235), Enum.Material.SmoothPlastic)
	deco("Cable", V(0.2, 12, 0.2), cf * CFrame.new(0, height - 5, -30), RGB(30, 30, 30), Enum.Material.Metal)
	local beacon = Kit.ball("CraneBeacon", 1, cf * CFrame.new(0, height + 3.5, -38), RGB(255, 40, 40), Enum.Material.Neon, true)
	beacon:SetAttribute("Blink", 1)
end

-- Barco de carga decorativo
function Kit.ship(cf, length)
	length = length or 90
	deco("Hull", V(length, 10, 18), cf * CFrame.new(0, 3, 0), RGB(40, 50, 70), Enum.Material.Metal)
	deco("HullStripe", V(length + 0.2, 1.5, 18.2), cf * CFrame.new(0, -1, 0), RGB(200, 40, 40), Enum.Material.Metal)
	deco("Bridge", V(10, 12, 14), cf * CFrame.new(length / 2 - 8, 14, 0), C.White, Enum.Material.SmoothPlastic)
	local colors = { C.Red, C.Blue, RGB(240, 150, 30), RGB(60, 170, 90) }
	local i = 0
	for x = -length / 2 + 8, length / 2 - 18, 9 do
		for row = 0, 1 do
			i += 1
			deco("Cargo", V(8.5, 4, 8), cf * CFrame.new(x, 10 + row * 4, (i % 2 == 0) and -4.2 or 4.2), colors[i % #colors + 1], Enum.Material.CorrodedMetal)
		end
	end
end

-- Faro sobre una isla de roca (fondo)
function Kit.lighthouse(position, scale)
	scale = scale or 1
	local terrain = workspace.Terrain
	terrain:FillBall(position + V(0, -6, 0), 26 * scale, Enum.Material.Rock)
	terrain:FillBall(position + V(14, -10, 8) * scale, 18 * scale, Enum.Material.Rock)
	terrain:FillBall(position + V(-10, -2, -6) * scale, 14 * scale, Enum.Material.Grass)
	local base = position + V(0, 12, 0)
	local s = scale
	cylinder("LighthouseTower", 26 * s, 7 * s, CFrame.new(base + V(0, 13 * s, 0)), C.White, Enum.Material.Plaster, nil, true)
	for i = 0, 2 do
		cylinder("LighthouseStripe", 2.5 * s, 7.1 * s, CFrame.new(base + V(0, (6 + i * 8) * s, 0)), C.Red, Enum.Material.Plaster, nil, true)
	end
	cylinder("LighthouseGallery", 0.6 * s, 8.4 * s, CFrame.new(base + V(0, 26.2 * s, 0)), RGB(36, 36, 40), Enum.Material.Metal, nil, true)
	cylinder("LighthouseTop", 3 * s, 5 * s, CFrame.new(base + V(0, 27.5 * s, 0)), RGB(255, 245, 200), Enum.Material.Neon, nil, true)
	cylinder("LighthouseRoof", 2 * s, 6 * s, CFrame.new(base + V(0, 30 * s, 0)), C.Red, Enum.Material.Plaster, nil, true)
end

-- Tubería industrial con soportes
function Kit.pipeRun(a, b, diameter, color)
	local length = (b - a).Magnitude
	local cf = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, rad(90), 0)
	Kit.pipe("Pipe", length, diameter, cf, color or RGB(90, 95, 110), Enum.Material.Metal, true)
	local rings = math.floor(length / 8)
	for i = 1, rings do
		local p = a:Lerp(b, i / (rings + 1))
		Kit.pipe("PipeRing", 0.5, diameter + 0.3, CFrame.lookAt(p, b) * CFrame.Angles(0, rad(90), 0), RGB(50, 52, 60), Enum.Material.Metal, true)
	end
end

-- Canal de lava (daña al tocarla; ver Hazards)
function Kit.lava(size, cf)
	local lava = block("Lava", size, cf, RGB(255, 100, 20), Enum.Material.CrackedLava)
	lava:SetAttribute("Hazard", "Lava")
	local glow = deco("LavaGlow", V(size.X, 0.1, size.Z), cf * CFrame.new(0, size.Y / 2 + 0.05, 0), RGB(255, 140, 30), Enum.Material.Neon)
	glow.Transparency = 0.4
	Kit.light(glow, "SurfaceLight", RGB(255, 120, 30), 16, 1.2, Enum.NormalId.Top)
	return lava
end

-- Cinta transportadora con lingotes
function Kit.conveyor(a, b, width)
	local length = (b - a).Magnitude
	local cf = CFrame.lookAt((a + b) / 2, b)
	block("Conveyor", V(width, 1, length), cf, RGB(40, 42, 48), Enum.Material.DiamondPlate)
	for _, s in { -1, 1 } do
		deco("ConveyorSide", V(0.4, 1.2, length), cf * CFrame.new(s * (width / 2 + 0.2), 0.3, 0), RGB(255, 170, 30), Enum.Material.Metal)
	end
	for i = 1, math.floor(length / 4) do
		local bar = deco("GoldBar", V(1.6, 0.6, 2.4), cf * CFrame.new(0, 0.8, -length / 2 + i * 4), RGB(255, 200, 60), Enum.Material.Foil)
		bar.CastShadow = true
	end
end

-- Chimenea industrial con luz roja
function Kit.smokestack(position, height)
	cylinder("Smokestack", height, 6, CFrame.new(position + V(0, height / 2, 0)), RGB(70, 65, 70), Enum.Material.Concrete, nil, true)
	for i = 1, 3 do
		cylinder("StackStripe", 1.2, 6.1, CFrame.new(position + V(0, height * i / 4, 0)), RGB(200, 60, 40), Enum.Material.Concrete, nil, true)
	end
	local light = Kit.ball("StackLight", 1.2, CFrame.new(position + V(0, height + 0.8, 0)), RGB(255, 40, 40), Enum.Material.Neon, true)
	light:SetAttribute("Blink", 1.5)
	-- Humo saliendo de la chimenea
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Color = ColorSequence.new(RGB(120, 110, 130), RGB(60, 55, 70))
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 16) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
	smoke.Lifetime = NumberRange.new(5, 8)
	smoke.Speed = NumberRange.new(4, 7)
	smoke.SpreadAngle = Vector2.new(12, 12)
	smoke.Acceleration = V(2, 1, 0)
	smoke.Rate = 4
	smoke.EmissionDirection = Enum.NormalId.Top
	smoke.Parent = light
end

-- Guirnalda de bombillas entre dos puntos (cuelga un poco por el centro)
function Kit.stringLights(a, b, color)
	local count = math.max(4, math.floor((b - a).Magnitude / 2.5))
	for i = 0, count do
		local t = i / count
		local p = a:Lerp(b, t) - V(0, math.sin(t * math.pi) * 1.5, 0)
		local bulb = Kit.ball("Bulb", 0.45, CFrame.new(p), (i % 3 == 0) and RGB(255, 120, 120) or (color or RGB(255, 220, 140)), Enum.Material.Neon, true)
		bulb.CastShadow = false
	end
	local mid = (a + b) / 2 - V(0, 0.75, 0)
	deco("LightWire", V(0.08, 0.08, (b - a).Magnitude), CFrame.lookAt(mid, b), RGB(30, 30, 30), Enum.Material.SmoothPlastic)
end

-- Maceta con flores
function Kit.flowerPot(cf, flowerColor)
	block("Pot", V(2, 1.6, 2), cf * CFrame.new(0, 0.8, 0), RGB(190, 100, 60), Enum.Material.Plaster)
	Kit.ball("Bush", 2.4, cf * CFrame.new(0, 2.1, 0), RGB(70, 160, 70), Enum.Material.Grass, true)
	for i = 0, 2 do
		Kit.ball("Flower", 0.6, cf * CFrame.new(math.cos(i * 2.1) * 0.8, 2.9, math.sin(i * 2.1) * 0.8), flowerColor or RGB(255, 90, 140), Enum.Material.SmoothPlastic, true)
	end
end

-- Parche de flores (tulipanes de colores con tallo y hoja), decorativo: se atraviesa
local TULIP_COLORS = { RGB(235, 50, 60), RGB(255, 200, 40), RGB(255, 110, 170), RGB(250, 250, 255), RGB(160, 90, 255) }
function Kit.flowers(position, count, seed)
	local rng = Random.new(seed or math.floor(position.X * 17 + position.Z * 29))
	count = count or 3
	for _ = 1, count do
		local offset = V(rng:NextNumber(-1.6, 1.6), 0, rng:NextNumber(-1.6, 1.6))
		local h = rng:NextNumber(0.9, 1.5)
		local base = CFrame.new(position + offset) * CFrame.Angles(rng:NextNumber(-0.15, 0.15), rng:NextNumber(0, 6.28), rng:NextNumber(-0.15, 0.15))
		deco("FlowerStem", V(0.1, h, 0.1), base * CFrame.new(0, h / 2, 0), RGB(60, 160, 60), Enum.Material.SmoothPlastic)
		local color = TULIP_COLORS[rng:NextInteger(1, #TULIP_COLORS)]
		local bloom = deco("FlowerBloom", V(0.34, 0.42, 0.34), base * CFrame.new(0, h + 0.15, 0), color, Enum.Material.SmoothPlastic)
		bloom.CastShadow = false
		for k = 0, 2 do
			deco("FlowerPetal", V(0.18, 0.3, 0.06), base * CFrame.Angles(0, k * 2.09, 0) * CFrame.new(0, h + 0.24, 0.16) * CFrame.Angles(rad(-20), 0, 0), color, Enum.Material.SmoothPlastic)
		end
	end
end

-- Pino cartoon (pisos redondos cada vez más estrechos, verde vivo). far = menos pisos (fondo)
function Kit.cartoonPine(position, scale, far)
	scale = scale or 1
	cylinder("PineTrunk", 4 * scale, 1.2 * scale, CFrame.new(position + V(0, 2 * scale, 0)), RGB(120, 80, 50), Enum.Material.Wood)
	local tiers = far and 3 or 5
	for i = 1, tiers do
		local t = (i - 1) / (tiers - 1)
		local d = (9 - 6.5 * t) * scale
		local y = (3.5 + t * 9) * scale
		local h = (12 / tiers + 0.8) * scale
		local tier = cylinder("PineTier", h, d, CFrame.new(position + V(0, y, 0)), RGB(60, 190, 90):Lerp(RGB(40, 150, 70), (i % 2) * 0.5), Enum.Material.SmoothPlastic, nil, true)
		tier.CastShadow = not far
	end
end

-- Mata de hierba alta (hojas finas inclinadas en abanico)
function Kit.grassTuft(position, scale, seed)
	local rng = Random.new(seed or math.floor(position.X * 23 + position.Z * 7))
	scale = scale or 1
	for i = 0, 3 do
		local h = rng:NextNumber(1.1, 1.9) * scale
		local angle = i * 1.57 + rng:NextNumber(-0.3, 0.3)
		local tilt = rad(rng:NextNumber(12, 30))
		local blade = deco("GrassBlade", V(0.16 * scale, h, 0.05), CFrame.new(position) * CFrame.Angles(0, angle, 0) * CFrame.Angles(tilt, 0, 0) * CFrame.new(0, h / 2, 0), RGB(70, 190, 70):Lerp(RGB(40, 140, 50), rng:NextNumber()), Enum.Material.SmoothPlastic)
		blade.CastShadow = false
	end
end

-- Cartel de neón grande con texto
function Kit.neonSign(cf, width, height, text, color, frameColor)
	local board = deco("NeonBoard", V(width, height, 0.6), cf, RGB(20, 20, 30), Enum.Material.SmoothPlastic)
	sign(board, Enum.NormalId.Front, text, color, frameColor or color:Lerp(Color3.new(1, 1, 1), 0.5))
	for _, y in { -1, 1 } do
		deco("NeonFrame", V(width + 0.6, 0.35, 0.7), cf * CFrame.new(0, y * height / 2, 0), frameColor or color, Enum.Material.Neon)
	end
	for _, x in { -1, 1 } do
		deco("NeonFrame", V(0.35, height, 0.7), cf * CFrame.new(x * width / 2, 0, 0), frameColor or color, Enum.Material.Neon)
	end
	Kit.light(board, "SurfaceLight", color, 18, 1.5, Enum.NormalId.Front)
	return board
end

-- Carretilla elevadora decorativa
function Kit.forklift(cf)
	block("ForkBody", V(4, 3, 6), cf * CFrame.new(0, 2, 0), RGB(250, 190, 30), Enum.Material.SmoothPlastic)
	deco("ForkCab", V(3.6, 3, 0.3), cf * CFrame.new(0, 5, 1.5), RGB(40, 40, 45), Enum.Material.Metal)
	deco("ForkRoof", V(4, 0.3, 4), cf * CFrame.new(0, 6.6, 0), RGB(40, 40, 45), Enum.Material.Metal)
	deco("ForkMast", V(3, 6, 0.4), cf * CFrame.new(0, 3.5, -3.2), RGB(40, 40, 45), Enum.Material.Metal)
	for _, x in { -1, 1 } do
		deco("Fork", V(0.4, 0.3, 3), cf * CFrame.new(x * 1, 0.6, -4.8), RGB(40, 40, 45), Enum.Material.Metal)
		for _, z in { -2, 2 } do
			Kit.pipe("Wheel", 0.8, 1.6, cf * CFrame.new(x * 2.1, 0.8, z), RGB(25, 25, 28), Enum.Material.Rubber, true)
		end
	end
end

-- Barca decorativa en el agua
function Kit.boat(cf)
	deco("BoatHull", V(6, 2, 14), cf * CFrame.new(0, 0.5, 0), C.White, Enum.Material.SmoothPlastic)
	deco("BoatStripe", V(6.1, 0.6, 14.1), cf * CFrame.new(0, 0.2, 0), C.Red, Enum.Material.SmoothPlastic)
	deco("BoatCabin", V(4.4, 3, 5), cf * CFrame.new(0, 3, 1), RGB(230, 230, 235), Enum.Material.SmoothPlastic)
	deco("BoatRoof", V(5, 0.4, 6), cf * CFrame.new(0, 4.7, 1), C.Red, Enum.Material.SmoothPlastic)
	deco("BoatWindow", V(4.5, 1, 0.2), cf * CFrame.new(0, 3.3, -1.5), RGB(60, 120, 180), Enum.Material.Glass)
end

---------------------------------------------------------------------------
-- Detalles realistas
---------------------------------------------------------------------------

-- Charco: manchas planas de agua que reflejan el cielo y las luces (formas irregulares)
function Kit.puddle(position, size, seed)
	local rng = Random.new(seed or math.floor(position.X * 7 + position.Z * 13))
	for i = 1, 3 do
		local d = size * (i == 1 and 1 or rng:NextNumber(0.45, 0.75))
		local offset = i == 1 and V(0, 0, 0) or V(rng:NextNumber(-0.4, 0.4) * size, 0, rng:NextNumber(-0.4, 0.4) * size)
		local water = deco("Puddle", V(0.04, d, d), CFrame.new(position + offset + V(0, 0.03 + i * 0.002, 0)) * CFrame.Angles(0, 0, math.pi / 2), RGB(38, 44, 52), Enum.Material.Glass)
		water.Shape = Enum.PartType.Cylinder
		water.Transparency = 0.25
		water.Reflectance = 0.45
	end
end

-- Cono de luz volumétrica bajo una lámpara: discos casi transparentes cada vez más anchos (se ve
-- el haz en el aire, sobre todo con niebla). `top` es la posición de la lámpara.
function Kit.lightCone(top, height, topRadius, bottomRadius, color)
	local segments = 5
	local step = height / segments
	for i = 1, segments do
		local t = (i - 0.5) / segments
		local radius = topRadius + (bottomRadius - topRadius) * t
		local disc = deco("LightCone", V(step, radius * 2, radius * 2), CFrame.new(top - V(0, step * (i - 0.5), 0)) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.Material.Neon)
		disc.Shape = Enum.PartType.Cylinder
		disc.Transparency = 0.93 + 0.01 * i
		disc.CastShadow = false
	end
end

-- Vapor que sale de una rejilla del suelo
function Kit.steamVent(cf, strength)
	strength = strength or 1
	local grate = deco("VentGrate", V(3, 0.1, 3), cf * CFrame.new(0, 0.05, 0), RGB(40, 42, 48), Enum.Material.DiamondPlate)
	for i = -1, 1 do
		deco("VentSlot", V(2.6, 0.12, 0.25), cf * CFrame.new(0, 0.06, i * 0.8), RGB(15, 15, 18), Enum.Material.Metal)
	end
	local steam = Instance.new("ParticleEmitter")
	steam.Name = "Steam"
	steam.Texture = "rbxasset://textures/particles/smoke_main.dds"
	steam.Color = ColorSequence.new(RGB(235, 238, 245))
	steam.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 6) })
	steam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.75), NumberSequenceKeypoint.new(0.3, 0.6), NumberSequenceKeypoint.new(1, 1) })
	steam.Lifetime = NumberRange.new(2.5, 4)
	steam.Speed = NumberRange.new(3, 6)
	steam.SpreadAngle = Vector2.new(12, 12)
	steam.Acceleration = V(0, 0.8, 0)
	steam.RotSpeed = NumberRange.new(-20, 20)
	steam.Rotation = NumberRange.new(0, 360)
	steam.Rate = 6 * strength
	steam.LightInfluence = 1
	steam.EmissionDirection = Enum.NormalId.Top
	steam.WindAffectsDrag = true
	steam.Parent = grate
	return grate
end

-- Polvo flotando en el aire (se ve a contraluz): una caja invisible que emite motas lentas
function Kit.dustMotes(cf, size, color, rate)
	local volume = deco("DustVolume", size, cf, RGB(255, 255, 255), Enum.Material.SmoothPlastic)
	volume.Transparency = 1
	local dust = Instance.new("ParticleEmitter")
	dust.Name = "Dust"
	dust.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	dust.Color = ColorSequence.new(color or RGB(255, 245, 220))
	dust.LightEmission = 0.4
	dust.LightInfluence = 0.6
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.12), NumberSequenceKeypoint.new(1, 0) })
	dust.Transparency = NumberSequence.new(0.3)
	dust.Lifetime = NumberRange.new(5, 8)
	dust.Speed = NumberRange.new(0.2, 0.6)
	dust.SpreadAngle = Vector2.new(180, 180)
	dust.RotSpeed = NumberRange.new(-30, 30)
	dust.Rate = rate or 12
	dust.WindAffectsDrag = true
	dust.Shape = Enum.ParticleEmitterShape.Box
	dust.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	dust.Parent = volume
	return volume
end

-- Colina natural de fondo (terreno): una bola grande deformada con bultos, salientes de roca y,
-- si se pide, manchas de otro material por encima (selva, nieve...). Nada de bolas perfectas.
-- `inward` (vector horizontal hacia el centro del mapa) evita que los bultos invadan la zona de juego.
function Kit.naturalHill(center, radius, material, options)
	options = options or {}
	local terrain = workspace.Terrain
	local rng = Random.new(options.Seed or math.floor(center.X * 3 + center.Z * 7))
	local inward = options.Inward
	local function away(offset)
		if inward and offset:Dot(inward) > 0 then
			return offset - inward * (2 * offset:Dot(inward))
		end
		return offset
	end
	-- Dirección sobre la superficie que queda por encima del suelo (y > 3)
	local function surfaceDir(minUp, maxUp)
		local low = math.asin(math.clamp((3 - center.Y) / radius, -1, 1))
		local elevation = math.max(low, minUp) + rng:NextNumber(0, 1) * math.max(0, maxUp - math.max(low, minUp))
		local angle = rng:NextNumber(0, math.pi * 2)
		return V(math.cos(angle) * math.cos(elevation), math.sin(elevation), math.sin(angle) * math.cos(elevation))
	end
	terrain:FillBall(center, radius, material)
	for _ = 1, 4 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local dist = rng:NextNumber(0.35, 0.7) * radius
		local offset = away(V(math.cos(angle) * dist, rng:NextNumber(-0.25, 0.05) * radius, math.sin(angle) * dist))
		terrain:FillBall(center + offset, radius * rng:NextNumber(0.45, 0.65), material)
	end
	-- Salientes de roca en la ladera
	for _ = 1, options.RockCount or 3 do
		local dir = surfaceDir(0.15, 1.1)
		terrain:FillBall(center + dir * radius * 0.94, radius * rng:NextNumber(0.1, 0.18), options.Rock or Enum.Material.Rock)
	end
	-- Manchas en la cima (copas de árboles con LeafyGrass, nieve en una montaña de roca...)
	if options.Top then
		for _ = 1, options.TopCount or 5 do
			local dir = surfaceDir(0.5, 1.4)
			terrain:FillBall(center + dir * radius * 0.92, radius * rng:NextNumber(0.18, 0.3), options.Top)
		end
	end
end

-- Grupo de rocas de terreno medio enterradas (una grande y dos pequeñas al lado)
function Kit.rockCluster(position, size, material, seed)
	local rng = Random.new(seed or math.floor(position.X * 5 + position.Z * 11))
	material = material or Enum.Material.Rock
	local terrain = workspace.Terrain
	terrain:FillBall(position - V(0, size * 0.35, 0), size, material)
	for _ = 1, 2 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local r = size * rng:NextNumber(0.45, 0.65)
		terrain:FillBall(position + V(math.cos(angle) * size * 0.9, -r * 0.4, math.sin(angle) * size * 0.9), r, material)
	end
end

-- Arbusto: tres bolas de hojas con tonos distintos (decorativo: se atraviesa)
function Kit.bush(position, scale, color)
	scale = scale or 1
	local rng = Random.new(math.floor(position.X * 11 + position.Z * 5))
	local base = color or RGB(58, 112, 46)
	for _ = 1, 3 do
		local d = scale * rng:NextNumber(2.4, 3.6)
		local offset = V(rng:NextNumber(-1, 1) * scale, d * 0.3, rng:NextNumber(-1, 1) * scale)
		local leaf = Kit.ball("Bush", d, CFrame.new(position + offset), base:Lerp(Color3.new(0, 0, 0), rng:NextNumber(0, 0.25)), Enum.Material.LeafyGrass, true)
		leaf.CastShadow = d >= 3
	end
end

-- Tronco caído con musgo por encima y los cortes claros (sirve de cobertura baja)
function Kit.log(cf, length, diameter)
	local y = diameter * 0.42
	Kit.pipe("Log", length, diameter, cf * CFrame.new(0, y, 0), RGB(92, 70, 50), Enum.Material.Wood)
	Kit.deco("LogMoss", V(length * 0.7, 0.2, diameter * 0.5), cf * CFrame.new(length * 0.05, y + diameter * 0.42, 0), RGB(78, 118, 52), Enum.Material.LeafyGrass)
	for _, side in { -1, 1 } do
		Kit.pipe("LogEnd", 0.1, diameter * 0.9, cf * CFrame.new(side * length / 2, y, 0), RGB(168, 132, 92), Enum.Material.Wood, true)
	end
end

-- Coche aparcado (sedán): carrocería de pintura brillante, cabina de cristal, ruedas de goma con
-- tapacubos, faros y pilotos. La carrocería y la cabina son cobertura; el resto es decorativo.
-- Largo en el eje X local (el morro mira a -X). options.Snow = true le pone nieve encima.
function Kit.car(cf, color, options)
	options = options or {}
	local model = Instance.new("Model")
	model.Name = "Car"
	model.Parent = Kit.folder
	local function paint(part)
		part.Material = Enum.Material.SmoothPlastic -- pintura lisa con brillo (no yeso)
		part.MaterialVariant = "" -- sin cuadrícula: es pintura de coche
		part.Reflectance = 0.12
		return part
	end
	paint(block("CarBody", V(9, 1.5, 4.2), cf * CFrame.new(0, 1.25, 0), color, nil, model))
	paint(block("CarHood", V(2.6, 0.35, 4.1), cf * CFrame.new(-3.1, 2.15, 0), color, nil, model))
	paint(block("CarTrunk", V(1.6, 0.35, 4.1), cf * CFrame.new(3.6, 2.15, 0), color, nil, model))
	local cabin = block("CarCabin", V(4.6, 1.35, 3.8), cf * CFrame.new(0.2, 2.65, 0), RGB(28, 34, 44), Enum.Material.Glass, model)
	cabin.Reflectance = 0.35
	cabin.Transparency = 0.15
	paint(deco("CarRoof", V(3.4, 0.22, 3.86), cf * CFrame.new(0.3, 3.42, 0), color, nil, model))
	-- Parabrisas y luna trasera inclinados (cuñas de cristal)
	for _, spec in { { -2.6, 1, math.pi / 2 }, { 2.9, 0.8, -math.pi / 2 } } do
		local glass = Instance.new("WedgePart")
		glass.Name = "CarWindshield"
		glass.Anchored = true
		glass.CanCollide = false
		glass.CanQuery = false
		glass.CanTouch = false
		glass.CastShadow = false
		glass.Size = V(3.8, 1.35, spec[2])
		glass.CFrame = cf * CFrame.new(spec[1], 2.65, 0) * CFrame.Angles(0, spec[3], 0)
		glass.Color = RGB(28, 34, 44)
		glass.Material = Enum.Material.Glass
		glass.Reflectance = 0.35
		glass.Transparency = 0.15
		glass.Parent = model
	end
	for _, x in { -2.15, 2.5 } do
		paint(deco("CarPillar", V(0.3, 1.35, 3.86), cf * CFrame.new(x, 2.65, 0), color, nil, model))
	end
	-- Ruedas y tapacubos
	for _, x in { -2.9, 2.9 } do
		for _, z in { -1.85, 1.85 } do
			local wheel = deco("Wheel", V(1.75, 1.75, 0.7), cf * CFrame.new(x, 0.875, z) * CFrame.Angles(0, math.pi / 2, 0), RGB(24, 24, 26), Enum.Material.Rubber, model)
			wheel.Shape = Enum.PartType.Cylinder
			local hub = deco("Hubcap", V(0.08, 0.95, 0.95), cf * CFrame.new(x, 0.875, z + (z > 0 and 0.36 or -0.36)) * CFrame.Angles(0, math.pi / 2, 0), RGB(190, 192, 198), Enum.Material.Metal, model)
			hub.Shape = Enum.PartType.Cylinder
		end
	end
	-- Parachoques, faros y pilotos
	for _, x in { -4.6, 4.6 } do
		deco("Bumper", V(0.3, 0.5, 4.3), cf * CFrame.new(x, 0.85, 0), RGB(35, 35, 38), Enum.Material.Plastic, model)
	end
	for _, z in { -1.5, 1.5 } do
		deco("Headlight", V(0.12, 0.35, 0.8), cf * CFrame.new(-4.52, 1.55, z), RGB(250, 248, 235), Enum.Material.Neon, model)
		deco("Taillight", V(0.12, 0.3, 0.7), cf * CFrame.new(4.52, 1.6, z), RGB(200, 25, 25), Enum.Material.Neon, model)
	end
	deco("Plate", V(0.08, 0.35, 1.1), cf * CFrame.new(4.62, 1.05, 0), RGB(235, 235, 225), Enum.Material.SmoothPlastic, model)
	if options.Snow then
		local snow = RGB(240, 245, 252)
		deco("CarSnow", V(3.2, 0.35, 3.6), cf * CFrame.new(0.3, 3.7, 0), snow, Enum.Material.Snow, model)
		deco("CarSnow", V(2.3, 0.25, 3.8), cf * CFrame.new(-3.2, 2.45, 0), snow, Enum.Material.Snow, model)
		deco("CarSnow", V(1.4, 0.25, 3.8), cf * CFrame.new(3.6, 2.45, 0), snow, Enum.Material.Snow, model)
	end
	Kit.contactShadow(cf, 9, 4.2, false, model)
	return model
end

-- Tapa de alcantarilla de hierro fundido
function Kit.manhole(position)
	Kit.cylinder("ManholeRim", 0.05, 3.5, CFrame.new(position + V(0, 0.025, 0)), RGB(72, 70, 66), Enum.Material.Metal, nil, true)
	Kit.cylinder("Manhole", 0.07, 3, CFrame.new(position + V(0, 0.035, 0)), RGB(46, 44, 42), Enum.Material.DiamondPlate, nil, true)
end

-- Rejilla de desagüe junto a un bordillo
function Kit.drain(cf)
	Kit.deco("DrainFrame", V(3.2, 0.06, 1.6), cf * CFrame.new(0, 0.03, 0), RGB(60, 58, 55), Enum.Material.Metal)
	for i = -3, 3 do
		Kit.deco("DrainSlot", V(0.18, 0.07, 1.2), cf * CFrame.new(i * 0.4, 0.036, 0), RGB(14, 14, 16), Enum.Material.Metal)
	end
end

-- Mancha de aceite: discos oscuros semitransparentes con un brillo leve
function Kit.oilStain(position, size, seed)
	local rng = Random.new(seed or math.floor(position.X * 13 + position.Z * 3))
	for i = 1, 3 do
		local d = size * (i == 1 and 1 or rng:NextNumber(0.4, 0.7))
		local offset = i == 1 and V(0, 0, 0) or V(rng:NextNumber(-0.35, 0.35) * size, 0, rng:NextNumber(-0.35, 0.35) * size)
		local stain = Kit.cylinder("OilStain", 0.02, d, CFrame.new(position + offset + V(0, 0.012 + i * 0.002, 0)), RGB(18, 18, 20), Enum.Material.SmoothPlastic, nil, true)
		stain.Transparency = 0.55 + i * 0.08
		stain.Reflectance = 0.08
	end
end

-- Grieta en el suelo: segmentos finos en zigzag
function Kit.crack(position, length, seed)
	local rng = Random.new(seed or math.floor(position.X * 7 + position.Z * 17))
	local heading = rng:NextNumber(0, math.pi * 2)
	local point = position
	local segments = math.max(3, math.floor(length / 2.5))
	for i = 1, segments do
		heading += rng:NextNumber(-0.7, 0.7)
		local seg = length / segments
		local dir = V(math.cos(heading), 0, math.sin(heading))
		local width = 0.16 * (1 - i / (segments + 1)) + 0.05
		Kit.deco("Crack", V(seg + 0.1, 0.03, width), CFrame.lookAt(point + dir * (seg / 2) + V(0, 0.015, 0), point + dir * seg + V(0, 0.015, 0)) * CFrame.Angles(0, math.pi / 2, 0), RGB(28, 28, 30), Enum.Material.SmoothPlastic)
		point += dir * seg
	end
end

-- Juntas de dilatación de una losa de hormigón o asfalto: líneas oscuras cada `spacing` studs
function Kit.floorJoints(cf, length, width, spacing, color)
	color = color or RGB(40, 40, 42)
	for x = -length / 2 + spacing, length / 2 - spacing / 2, spacing do
		Kit.deco("Joint", V(0.15, 0.03, width), cf * CFrame.new(x, 0.015, 0), color, Enum.Material.SmoothPlastic)
	end
	for z = -width / 2 + spacing, width / 2 - spacing / 2, spacing do
		Kit.deco("Joint", V(length, 0.03, 0.15), cf * CFrame.new(0, 0.015, z), color, Enum.Material.SmoothPlastic)
	end
end

-- Marcas de neumático: dos franjas oscuras paralelas que hacen una curva suave
function Kit.tireMarks(cf, length, bend)
	bend = bend or 0.3
	local segments = 6
	local seg = length / segments
	local pose = cf
	for _ = 1, segments do
		pose = pose * CFrame.Angles(0, bend / segments, 0)
		for _, side in { -1.1, 1.1 } do
			local mark = Kit.deco("TireMark", V(0.7, 0.02, seg + 0.05), pose * CFrame.new(side, 0.011, -seg / 2), RGB(20, 20, 22), Enum.Material.SmoothPlastic)
			mark.Transparency = 0.6
		end
		pose = pose * CFrame.new(0, 0, -seg)
	end
end

---------------------------------------------------------------------------
-- Puntos especiales del modo de juego
---------------------------------------------------------------------------

-- Zona de reaparición del equipo con techo, muretes y SpawnLocations
function Kit.spawnArea(team, cf, style)
	style = style or {}
	local teamColor = team.Color.Color
	local light = teamColor:Lerp(Color3.new(1, 1, 1), 0.55)
	local floorColor = style.Floor or light
	-- (los colores del equipo se quedan puros, también en el estilo realista: así casan con los neones
	-- y las zonas de aparición y se reconoce de un vistazo de qué equipo es la base)
	local floor = block(team.Name .. "SpawnFloor", V(30, 0.4, 70), cf * CFrame.new(0, 0.2, 0), floorColor, style.FloorMaterial or Enum.Material.SmoothPlastic)
	-- (zona con nombre: «BASE ROJO»; un poco más grande que el tejado)
	-- («base» es femenino: ROJO → ROJA; AZUL se queda igual)
	Kit.callout("BASE " .. (string.gsub(string.upper(team.Name), "O$", "A")), cf * CFrame.new(0, 12, 0), V(44, 30, 84))
	floor.Color = floorColor
	for z = -30, 30, 10 do
		deco("FloorLine", V(30, 0.05, 0.3), cf * CFrame.new(0, 0.42, z), teamColor, Enum.Material.SmoothPlastic).Color = teamColor
	end
	local roofColor = style.Roof or RGB(235, 235, 240)
	local roof = block(team.Name .. "SpawnRoof", V(30, 1, 70), cf * CFrame.new(0, 16, 0), roofColor, style.RoofMaterial or Enum.Material.Concrete)
	-- (no se puede pisar: con el supersalto alguien podría subirse a acampar encima de la base enemiga;
	-- las balas sí lo siguen chocando)
	roof.CanCollide = false
	deco("RoofTrim", V(0.6, 0.5, 70.2), cf * CFrame.new(15, 15.4, 0), teamColor, Enum.Material.Neon)
	local banner = block("TeamBanner", V(0.6, 4, 28), cf * CFrame.new(15.2, 18.6, 0), teamColor, Enum.Material.SmoothPlastic)
	banner.Color = teamColor
	sign(banner, Enum.NormalId.Right, "EQUIPO " .. string.upper(team.Name), Color3.new(1, 1, 1))
	sign(banner, Enum.NormalId.Left, "EQUIPO " .. string.upper(team.Name), Color3.new(1, 1, 1))
	for _, z in { -34, 34 } do
		block("Pillar", V(2, 16, 2), cf * CFrame.new(14, 8, z), roofColor, Enum.Material.Concrete)
		deco("PillarStripe", V(2.1, 1, 2.1), cf * CFrame.new(14, 12, z), teamColor, Enum.Material.Neon)
	end
	for _, z in { -24, 0, 24 } do
		block("Cover", V(2, 4, 10), cf * CFrame.new(14, 2, z), teamColor, Enum.Material.SmoothPlastic).Color = teamColor
		deco("CoverTop", V(2.1, 0.3, 10.1), cf * CFrame.new(14, 4.05, z), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
	end
	for i, z in { -24, -8, 8, 24 } do
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = team.Name .. "Spawn" .. i
		spawn.Anchored = true
		spawn.Size = V(6, 1, 6)
		spawn.CFrame = cf * CFrame.new(-4, 0.5, z) * CFrame.Angles(0, -math.pi / 2, 0)
		spawn.TeamColor = team.Color
		spawn.BrickColor = team.Color
		spawn.Material = Enum.Material.Neon
		spawn.Neutral = false
		spawn.AllowTeamChangeOnTouch = false
		spawn.Duration = GameConfig.SpawnProtection
		spawn.Parent = Kit.folder
		local decal = spawn:FindFirstChildOfClass("Decal")
		if decal then
			decal:Destroy()
		end
	end
	local lamp = deco("SpawnLight", V(20, 0.2, 60), cf * CFrame.new(0, 15.4, 0), teamColor:Lerp(Color3.new(1, 1, 1), 0.7), Enum.Material.Neon)
	Kit.light(lamp, "SurfaceLight", teamColor:Lerp(Color3.new(1, 1, 1), 0.5), 16, 0.8, Enum.NormalId.Bottom)
end

-- Base de la bandera (Captura la bandera). Flags busca piezas "FlagBase" con el atributo Team.
function Kit.flagBase(team, cf)
	local teamColor = team.Color.Color
	local ring = deco("FlagBaseRing", V(0.3, 13, 13), cf * CFrame.new(0, 0.15, 0) * CFrame.Angles(0, 0, math.pi / 2), teamColor, Enum.Material.Neon)
	ring.Shape = Enum.PartType.Cylinder
	local pad = block("FlagBase", V(0.4, 11, 11), cf * CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.pi / 2), RGB(235, 235, 240), Enum.Material.Concrete)
	pad.Shape = Enum.PartType.Cylinder
	pad:SetAttribute("Team", team.Name)
	local inner = deco("FlagBaseInner", V(0.45, 4, 4), cf * CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.pi / 2), teamColor, Enum.Material.Neon)
	inner.Shape = Enum.PartType.Cylinder
	for i = 0, 3 do
		local angle = i * math.pi / 2 + math.pi / 4
		local offset = CFrame.new(math.cos(angle) * 7.5, 0, math.sin(angle) * 7.5)
		cylinder("Pylon", 2, 0.7, cf * offset * CFrame.new(0, 1, 0), RGB(230, 230, 235), Enum.Material.SmoothPlastic, nil, true)
		Kit.ball("PylonLight", 0.8, cf * offset * CFrame.new(0, 2.3, 0), teamColor, Enum.Material.Neon, true)
	end
	Kit.light(inner, "PointLight", teamColor, 16, 1.5)
	return pad
end

-- Calabaza de Halloween con cara iluminada (decoración del evento; se atraviesa)
function Kit.pumpkin(cf, scale)
	scale = scale or 1
	-- Esferas achatadas: una Ball de Roblox siempre es redonda, así que se usa una malla de esfera
	local function squashed(part)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = part
	end
	local body = deco("Pumpkin", V(3 * scale, 2.4 * scale, 3 * scale), cf * CFrame.new(0, 1.2 * scale, 0), RGB(255, 130, 20), Enum.Material.SmoothPlastic)
	squashed(body)
	for _, a in { 0, 60, 120 } do
		local rib = deco("PumpkinRib", V(0.6 * scale, 2.3 * scale, 3.06 * scale), cf * CFrame.new(0, 1.2 * scale, 0) * CFrame.Angles(0, rad(a), 0), RGB(230, 100, 10), Enum.Material.SmoothPlastic)
		squashed(rib)
	end
	Kit.cylinder("PumpkinStem", 0.6 * scale, 0.35 * scale, cf * CFrame.new(0, 2.5 * scale, 0), RGB(80, 120, 40), Enum.Material.SmoothPlastic, nil, true)
	-- Ojos y boca brillantes (hacia -Z del cf)
	for _, s in { -1, 1 } do
		deco("PumpkinEye", V(0.45 * scale, 0.4 * scale, 0.2 * scale), cf * CFrame.new(s * 0.5 * scale, 1.5 * scale, -1.42 * scale) * CFrame.Angles(0, 0, rad(s * 20)), RGB(255, 220, 90), Enum.Material.Neon)
	end
	local mouth = deco("PumpkinMouth", V(1.1 * scale, 0.25 * scale, 0.2 * scale), cf * CFrame.new(0, 0.85 * scale, -1.45 * scale), RGB(255, 220, 90), Enum.Material.Neon)
	Kit.light(mouth, "PointLight", RGB(255, 160, 60), 8 * scale, 0.8)
	return body
end

-- Muñeco de nieve (decoración del evento de Navidad): tres bolas, ojos de carbón, nariz de
-- zanahoria, bufanda y sombrero de copa
function Kit.snowman(cf, scale)
	scale = scale or 1
	local snow = RGB(245, 248, 255)
	Kit.ball("SnowmanBase", 3.2 * scale, cf * CFrame.new(0, 1.5 * scale, 0), snow, Enum.Material.SmoothPlastic, true)
	Kit.ball("SnowmanBody", 2.4 * scale, cf * CFrame.new(0, 3.4 * scale, 0), snow, Enum.Material.SmoothPlastic, true)
	local headCf = cf * CFrame.new(0, 4.95 * scale, 0)
	Kit.ball("SnowmanHead", 1.7 * scale, headCf, snow, Enum.Material.SmoothPlastic, true)
	for _, s in { -1, 1 } do
		Kit.ball("SnowmanEye", 0.22 * scale, headCf * CFrame.new(s * 0.3 * scale, 0.2 * scale, -0.75 * scale), RGB(25, 25, 30), Enum.Material.SmoothPlastic, true)
	end
	deco("SnowmanNose", V(0.18 * scale, 0.18 * scale, 0.7 * scale), headCf * CFrame.new(0, 0, -1.05 * scale), RGB(255, 130, 30), Enum.Material.SmoothPlastic)
	for i = 1, 3 do
		Kit.ball("SnowmanButton", 0.22 * scale, cf * CFrame.new(0, (2.8 + i * 0.4) * scale, -1.12 * scale), RGB(25, 25, 30), Enum.Material.SmoothPlastic, true)
	end
	Kit.cylinder("SnowmanScarf", 0.35 * scale, 1.75 * scale, cf * CFrame.new(0, 4.25 * scale, 0), RGB(220, 40, 50), Enum.Material.Fabric, nil, true)
	deco("SnowmanScarfTail", V(0.35 * scale, 1 * scale, 0.12 * scale), cf * CFrame.new(0.45 * scale, 3.8 * scale, -0.8 * scale), RGB(220, 40, 50), Enum.Material.Fabric)
	Kit.cylinder("SnowmanHatBrim", 0.12 * scale, 1.9 * scale, headCf * CFrame.new(0, 0.75 * scale, 0), RGB(25, 25, 30), Enum.Material.SmoothPlastic, nil, true)
	Kit.cylinder("SnowmanHat", 1 * scale, 1.15 * scale, headCf * CFrame.new(0, 1.3 * scale, 0), RGB(25, 25, 30), Enum.Material.SmoothPlastic, nil, true)
	Kit.cylinder("SnowmanHatBand", 0.2 * scale, 1.18 * scale, headCf * CFrame.new(0, 0.95 * scale, 0), RGB(220, 40, 50), Enum.Material.SmoothPlastic, nil, true)
end

-- Plataforma de salto: al pisarla te lanza hacia arriba (el cliente lo hace, ver JumpPads).
-- power = velocidad vertical (75 ≈ 14 studs de altura). Para subir a cornisas y a lo alto.
function Kit.jumpPad(position, power, color)
	color = color or RGB(80, 230, 255)
	local ring = Kit.cylinder("JumpPadRing", 0.4, 7.6, CFrame.new(position + V(0, 0.2, 0)), RGB(250, 250, 255), Enum.Material.SmoothPlastic)
	ring:SetAttribute("JumpPad", power or 75) -- también lanza si pisas el borde
	local pad = Kit.cylinder("JumpPad", 0.5, 6, CFrame.new(position + V(0, 0.3, 0)), color, Enum.Material.Neon)
	pad:SetAttribute("JumpPad", power or 75)
	local sparks = Instance.new("ParticleEmitter")
	sparks.Name = "JumpPadSparks"
	sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparks.Color = ColorSequence.new(color)
	sparks.LightEmission = 1
	sparks.Size = NumberSequence.new(0.6, 0)
	sparks.Lifetime = NumberRange.new(0.6, 1)
	sparks.Rate = 8
	sparks.Speed = NumberRange.new(8, 12)
	sparks.SpreadAngle = Vector2.new(12, 12)
	sparks.EmissionDirection = Enum.NormalId.Right -- el eje X del cilindro es el vertical: suben
	sparks.Parent = pad
	return pad
end

-- Punto de aparición para "Todos contra todos" y "Escalada" (invisible)
function Kit.ffaSpawn(position)
	local p = deco("FFASpawn", V(2, 1, 2), CFrame.new(position + V(0, 0.5, 0)), C.White, Enum.Material.SmoothPlastic)
	p.Transparency = 1
	return p
end

-- Puesto de vigilancia para los bots tiradores (ventana, azotea, torre): se apostan ahí mirando
-- hacia look. No es un punto de aparición.
function Kit.botSpot(position, look)
	local p = deco("BotSpot", V(1, 1, 1), CFrame.new(position + V(0, 0.5, 0)), C.White, Enum.Material.SmoothPlastic)
	p.Transparency = 1
	p:SetAttribute("Look", look)
	return p
end

-- Sitio de la bomba (Buscar y destruir): letra "A" o "B" y qué equipo lo defiende (1 o 2, el de
-- GameConfig.Teams). Cada equipo defiende los dos sitios de su mitad.
function Kit.bombSite(position, letter, defender)
	local p = deco("BombSite", V(1, 1, 1), CFrame.new(position + V(0, 0.5, 0)), C.White, Enum.Material.SmoothPlastic)
	p.Transparency = 1
	p:SetAttribute("Letter", letter)
	p:SetAttribute("Defender", defender)
	p:SetAttribute("Radius", 7)
	-- (zona con nombre: «SITIO A · ROJO», el equipo que lo defiende)
	local defenderTeam = GameConfig.Teams[defender]
	local siteBox = Kit.callout("SITIO " .. letter .. (defenderTeam and (" · " .. string.upper(defenderTeam.Name)) or ""), CFrame.new(position + V(0, 6, 0)), V(7 * 2 + 12, 18, 7 * 2 + 12))
	siteBox:SetAttribute("Site", true) -- (el cliente solo lo nombra en Buscar y destruir)
	-- La letra pintada en el suelo, como en los mapas de los shooters (se ve en todos los modos)
	local floorY = position.Y
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { Kit.folder, workspace.Terrain }
	local hit = workspace:Raycast(position + V(0, 2, 0), V(0, -5, 0), params)
	if hit then
		floorY = hit.Position.Y
	end
	local paint = deco("SiteLetter", V(7, 0.05, 7), CFrame.new(position.X, floorY + 0.04, position.Z), C.White, Enum.Material.SmoothPlastic)
	paint.Transparency = 1
	paint.CastShadow = false
	local gui = sign(paint, Enum.NormalId.Top, letter, Color3.fromRGB(205, 58, 40), Color3.fromRGB(205, 58, 40))
	gui.LightInfluence = 1
	local label = gui:FindFirstChildOfClass("TextLabel")
	if label then
		label.Font = Enum.Font.GothamBlack
		label.TextTransparency = 0.12
		label.TextStrokeTransparency = 1
	end
	return p
end

-- Zona de control (modo "Zona"). order = orden de rotación.
function Kit.zone(position, radius, order)
	local z = deco("HardpointZone", V(0.3, radius * 2, radius * 2), CFrame.new(position + V(0, 0.15, 0)) * CFrame.Angles(0, 0, math.pi / 2), C.White, Enum.Material.SmoothPlastic)
	z.Shape = Enum.PartType.Cylinder
	z.Transparency = 1
	z:SetAttribute("Order", order)
	z:SetAttribute("Radius", radius)
	return z
end

-- Nombre de una zona del mapa (callout, como en los shooters por equipos): una caja invisible; el
-- cliente dice en el HUD en qué zona estás («HOTEL CENTRAL», «AVENIDA»). Si varias se solapan, gana
-- la más pequeña (un edificio dentro de un carril). cf: centro de la caja; size: su tamaño
function Kit.callout(name, cf, size)
	local folder = Kit.folder:FindFirstChild("Callouts")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Callouts"
		folder.Parent = Kit.folder
	end
	local box = Instance.new("Part")
	box.Name = "Callout"
	box.Anchored = true
	box.CanCollide = false
	box.CanQuery = false
	box.CanTouch = false
	box.CastShadow = false
	box.Transparency = 1
	box.Size = size
	box.CFrame = typeof(cf) == "Vector3" and CFrame.new(cf) or cf
	box:SetAttribute("Callout", name)
	box.Parent = folder
	return box
end

-- Muros exteriores invisibles (y techo) para que nadie se salga
-- Muros y techo invisibles. Van en la carpeta Map.Boundary, que los disparos ignoran
-- (CanQuery = false no sirve en piezas que colisionan, así que se excluyen en cada raycast).
function Kit.bounds(length, width, height)
	local folder = Kit.folder:FindFirstChild("Boundary") or Instance.new("Folder")
	folder.Name = "Boundary"
	folder.Parent = Kit.folder
	local function wall(size, cf)
		local w = block("Boundary", size, cf, Color3.new(1, 1, 1), nil, folder)
		w.Transparency = 1
		w.CastShadow = false
	end
	wall(V(length, height, 4), CFrame.new(0, height / 2, width / 2 + 2))
	wall(V(length, height, 4), CFrame.new(0, height / 2, -width / 2 - 2))
	wall(V(4, height, width), CFrame.new(length / 2 + 2, height / 2, 0))
	wall(V(4, height, width), CFrame.new(-length / 2 - 2, height / 2, 0))
	wall(V(length, 1, width), CFrame.new(0, height, 0))
end

---------------------------------------------------------------------------
-- Iluminación por mapa
---------------------------------------------------------------------------

-- Colores por defecto de los materiales del terreno (se restauran al cambiar de mapa)
local TERRAIN_DEFAULTS = {
	Grass = RGB(106, 127, 63),
	LeafyGrass = RGB(115, 132, 74),
	Mud = RGB(58, 46, 36),
	Ground = RGB(102, 92, 59),
	Snow = RGB(195, 199, 218),
	Glacier = RGB(101, 176, 234),
	Rock = RGB(102, 108, 111),
	Sand = RGB(143, 126, 95),
	Sandstone = RGB(137, 90, 71),
	Slate = RGB(63, 127, 107),
	Pavement = RGB(148, 148, 140),
}

-- Hierba y hojas más vivas en estilo Cartoon
local CARTOON_TERRAIN = {
	Grass = RGB(80, 175, 70),
	LeafyGrass = RGB(66, 150, 58),
	Ground = RGB(150, 120, 80),
}

local function ensure(className, parent)
	parent = parent or Lighting
	local inst = parent:FindFirstChildOfClass(className)
	if not inst then
		inst = Instance.new(className)
		inst.Parent = parent
	end
	return inst
end

-- Estilo Cartoon: luz más suave y clara (sombras rellenas), menos neblina, sin deslumbramiento y
-- más saturación; el ambiente de cada mapa (hora, color del cielo) se mantiene
local function cartoonize(preset)
	local p = table.clone(preset)
	local clock = p.ClockTime or 14
	local night = clock < 6 or clock > 18.6
	p.Ambient = (p.Ambient or RGB(60, 62, 72)):Lerp(night and RGB(70, 70, 105) or RGB(125, 125, 145), 0.55)
	p.OutdoorAmbient = (p.OutdoorAmbient or RGB(125, 128, 140)):Lerp(night and RGB(90, 90, 135) or RGB(170, 170, 190), 0.55)
	p.ShadowSoftness = 0.3
	if not night then
		p.Brightness = math.max(p.Brightness or 3, 3)
	end
	local a = table.clone(p.Atmosphere or {})
	a.Density = math.min(a.Density or 0.3, 0.26)
	a.Haze = math.min(a.Haze or 1.4, 0.6)
	a.Glare = 0
	p.Atmosphere = a
	local c = table.clone(p.Color or {})
	c.Saturation = (c.Saturation or 0.1) + 0.12
	c.Contrast = 0.06
	c.Brightness = (c.Brightness or 0.02) + 0.02
	p.Color = c
	local b = table.clone(p.Bloom or {})
	b.Intensity = math.min(b.Intensity or 0.8, 0.45)
	p.Bloom = b
	p.Clouds = math.max(p.Clouds or 0.55, 0.6)
	p.SunRays = math.min(p.SunRays or 0.06, 0.05)
	local terrain = {}
	for name, color in TERRAIN_DEFAULTS do
		terrain[name] = Kit.vivid((p.TerrainColors and p.TerrainColors[name]) or CARTOON_TERRAIN[name] or color)
	end
	p.TerrainColors = terrain
	return p
end

-- Estilo realista en mapas pensados para Cartoon: luz más contrastada (sombras más oscuras y nítidas),
-- color natural (menos tono pastel en el ambiente y la neblina), neblina y brillo del sol de verdad,
-- y hierba y tierra de colores naturales. Se respeta el carácter de cada mapa: la hora, las sombras
-- azuladas de la nieve, el aire limpio de la Luna, los pétalos rosas, la nieve blanca y el brillo de
-- los neones de noche (que además se aclara un poco para que se vea bien en el móvil).
local function neutralize(color, amount)
	local h, s, v = color:ToHSV()
	return Color3.fromHSV(h, s * (1 - amount), v)
end

-- Que el color tenga al menos este brillo (el canal más alto), sin cambiar su tono
local function atLeast(color, minimum)
	local top = math.max(color.R, color.G, color.B) * 255
	if top >= minimum or top <= 0 then
		return color
	end
	local k = minimum / top
	return Color3.new(math.min(1, color.R * k), math.min(1, color.G * k), math.min(1, color.B * k))
end

local SNOWY = { Snow = true, Ice = true, Glacier = true }

local function realize(preset)
	local p = table.clone(preset)
	local clock = p.ClockTime or 14
	-- (el atardecer y el anochecer cuentan como noche: sin brillo del sol forzado)
	local night = clock < 6.2 or clock > 17.8
	p.Ambient = neutralize(p.Ambient or RGB(60, 62, 72), 0.35)
		:Lerp(night and RGB(44, 46, 60) or RGB(70, 72, 82), night and 0.25 or 0.3)
	p.OutdoorAmbient = neutralize(p.OutdoorAmbient or RGB(125, 128, 140), 0.35)
		:Lerp(night and RGB(70, 74, 98) or RGB(120, 122, 132), night and 0.25 or 0.3)
	if night then
		p.Ambient = atLeast(p.Ambient, 50)
		p.OutdoorAmbient = atLeast(p.OutdoorAmbient, 80)
	end
	p.ShadowSoftness = math.min(p.ShadowSoftness or 0.12, 0.15)
	local a = table.clone(p.Atmosphere or {})
	-- (si el mapa pide un aire muy limpio, como la Luna, se respeta)
	local thin = (a.Density or 0.3) < 0.2
	if not thin then
		a.Density = math.max(a.Density or 0.3, 0.3)
		a.Haze = math.max(a.Haze or 1.4, 1.2)
	end
	-- (de noche, sin aire o con el cielo cubierto —tormenta, niebla— no hay brillo de sol)
	local overcast = (p.Clouds or 0) >= 0.85
	a.Glare = (night or thin or overcast) and (a.Glare or 0) or math.max(a.Glare or 0.3, 0.25)
	if a.Color then
		a.Color = neutralize(a.Color, 0.4)
	end
	if a.Decay then
		a.Decay = neutralize(a.Decay, 0.4)
	end
	p.Atmosphere = a
	local c = table.clone(p.Color or {})
	c.Saturation = math.min(c.Saturation or 0.05, night and 0.12 or 0.05)
	c.Contrast = math.max(c.Contrast or 0.12, 0.12)
	c.Brightness = math.min(c.Brightness or 0, 0.02)
	if c.Tint then
		c.Tint = neutralize(c.Tint, 0.5)
	end
	p.Color = c
	-- Brillo: de día contenido (el sol no deslumbra como en un dibujo); de noche se deja que los
	-- neones brillen
	local b = table.clone(p.Bloom or {})
	b.Intensity = math.min(b.Intensity or 0.6, night and 0.9 or 0.6)
	b.Threshold = math.max(b.Threshold or 1.6, night and 1.35 or 1.6)
	p.Bloom = b
	-- Terreno: los verdes muy vivos van hacia el tono natural; lo demás pensado a propósito (pétalos,
	-- arena, roca) solo se apaga un poco, y la nieve y el hielo se quedan como están
	local terrain = {}
	for name, color in TERRAIN_DEFAULTS do
		local custom = p.TerrainColors and p.TerrainColors[name]
		if not custom then
			terrain[name] = color
		elseif SNOWY[name] then
			terrain[name] = custom
		else
			local h, sat = custom:ToHSV()
			if sat > 0.25 and h > 0.12 and h < 0.45 then
				terrain[name] = neutralize(custom, 0.3):Lerp(color, 0.35)
			else
				terrain[name] = Kit.natural(custom)
			end
		end
	end
	p.TerrainColors = terrain
	return p
end
Kit.realize = realize

-- Estilo Táctico (estilizado): materiales de verdad pero luz limpia y legible, como los shooters de
-- Roblox modernos. Color un poco vivo (cada mapa conserva su tinte), contraste moderado, sombras
-- limpias sin zonas negras, neblina que da profundidad sin tapar a nadie y un brillo contenido (solo
-- brillan las luces y los neones, no las paredes al sol). Lo importante es ver al enemigo.
-- designed: mapa ya pensado con su luz (Kit.Begin con Realistic): solo se le ponen los límites de
-- legibilidad (ni muy oscuro, ni mucha niebla, ni mucho brillo)
local function tacticalize(preset, designed)
	local p = table.clone(preset)
	local clock = p.ClockTime or 14
	local night = clock < 6.2 or clock > 17.8
	if designed then
		p.Ambient = atLeast(p.Ambient or RGB(60, 62, 72), night and 55 or 66)
		p.OutdoorAmbient = atLeast(p.OutdoorAmbient or RGB(125, 128, 140), night and 85 or 112)
	else
		p.Ambient = neutralize(p.Ambient or RGB(60, 62, 72), 0.15)
			:Lerp(night and RGB(54, 58, 78) or RGB(82, 84, 96), 0.25)
		p.OutdoorAmbient = neutralize(p.OutdoorAmbient or RGB(125, 128, 140), 0.15)
			:Lerp(night and RGB(78, 84, 112) or RGB(138, 140, 152), 0.25)
		p.Ambient = atLeast(p.Ambient, night and 55 or 70)
		p.OutdoorAmbient = atLeast(p.OutdoorAmbient, night and 88 or 120)
		p.ShadowSoftness = 0.2
	end
	local a = table.clone(p.Atmosphere or {})
	local thin = (a.Density or 0.3) < 0.2
	if not thin then
		local maxDensity = designed and 0.38 or 0.34
		a.Density = math.clamp(a.Density or 0.3, designed and 0.2 or 0.24, maxDensity)
		a.Haze = math.clamp(a.Haze or 1.4, 0.4, designed and 1.4 or 1.1)
	end
	local overcast = (p.Clouds or 0) >= 0.85
	if not designed then
		a.Glare = (night or thin or overcast) and math.min(a.Glare or 0, 0.1) or 0.15
		if a.Color then
			a.Color = neutralize(a.Color, 0.2)
		end
		if a.Decay then
			a.Decay = neutralize(a.Decay, 0.2)
		end
	else
		a.Glare = math.min(a.Glare or 0.3, 0.3)
	end
	p.Atmosphere = a
	local c = table.clone(p.Color or {})
	if designed then
		c.Saturation = math.max(c.Saturation or 0.05, 0.09) -- (ligeramente vivo: no un mapa gris)
		c.Contrast = math.min(c.Contrast or 0.12, 0.16)
	else
		c.Saturation = math.clamp(c.Saturation or 0.1, 0.08, night and 0.14 or 0.16)
		c.Contrast = math.clamp(c.Contrast or 0.12, 0.08, 0.13)
		c.Brightness = math.clamp(c.Brightness or 0.02, 0, 0.03)
		if c.Tint then
			c.Tint = neutralize(c.Tint, 0.3) -- (el tinte del mapa se nota, pero sin teñirlo todo)
		end
	end
	p.Color = c
	local b = table.clone(p.Bloom or {})
	b.Intensity = math.min(b.Intensity or 0.6, night and 0.75 or 0.5)
	b.Threshold = math.max(b.Threshold or 1.8, night and 1.4 or 1.8)
	b.Size = math.min(b.Size or 22, 24)
	p.Bloom = b
	p.SunRays = math.min(p.SunRays or 0.05, 0.05)
	if not designed then
		-- Terreno: los colores del mapa se respetan; solo los verdes chillones bajan un poco
		local terrain = {}
		for name, color in TERRAIN_DEFAULTS do
			local custom = p.TerrainColors and p.TerrainColors[name]
			if not custom or SNOWY[name] then
				terrain[name] = custom or color
			else
				local h, sat = custom:ToHSV()
				terrain[name] = (sat > 0.5 and h > 0.12 and h < 0.45) and neutralize(custom, 0.18) or custom
			end
		end
		p.TerrainColors = terrain
	end
	return p
end
Kit.tacticalize = tacticalize

-- Luz de esta partida: a veces sale otra hora del día del mapa (como las versiones de los mapas en
-- los shooters de móvil). map.LightingVariants = { { Name = "Atardecer", Chance = 0.3, ...cambios } }.
-- Deja el nombre de la variante en Kit.Variant (y el mapa lo guarda en su atributo Variant).
function Kit.pickLighting(map)
	Kit.Variant, Kit.Weather = nil, nil
	for _, variant in map.LightingVariants or {} do
		if math.random() < (variant.Chance or 0.3) then
			local preset = table.clone(map.Lighting)
			for key, value in variant do
				if key ~= "Name" and key ~= "Chance" and key ~= "Weather" then
					preset[key] = value
				end
			end
			Kit.Variant = variant.Name
			Kit.Weather = variant.Weather -- ("Rain": lluvia y truenos en el cliente, ver Ambience)
			return preset
		end
	end
	return map.Lighting
end

-- preset: tabla con ClockTime, Brightness, Ambient, OutdoorAmbient, Atmosphere{...}, Color{...}, Bloom{...}, Clouds
function Kit.applyLighting(preset)
	-- Tono de los grises de este mapa (se usa al crear las piezas, que van después)
	local neutral = preset.CartoonNeutral
	Kit.Neutral = type(neutral) == "table" and { Hue = neutral.Hue or 0.68, Sat = neutral.Sat or 0.16 } or { Hue = 0.68, Sat = 0.16 }
	if Kit.Cartoon then
		preset = cartoonize(preset)
	elseif GameConfig.VisualStyle == "Tactico" then
		preset = tacticalize(preset, Kit.Designed)
	elseif not Kit.Designed then
		preset = realize(preset)
	end
	Lighting.ClockTime = preset.ClockTime or 14
	Lighting.GeographicLatitude = preset.Latitude or 35
	Lighting.Brightness = preset.Brightness or 3
	Lighting.ExposureCompensation = preset.Exposure or 0
	Lighting.Ambient = preset.Ambient or RGB(60, 62, 72)
	Lighting.OutdoorAmbient = preset.OutdoorAmbient or RGB(125, 128, 140)
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = preset.ShadowSoftness or 0.12 -- sombras de sol nítidas pero no duras
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = Kit.Cartoon and 0.5 or 1 -- en Cartoon, menos brillo de plástico
	-- Viento: mueve la hierba del terreno, las nubes y las partículas con WindAffectsDrag
	workspace.GlobalWind = preset.Wind or V(4, 0, 2)

	local a = preset.Atmosphere or {}
	local atmosphere = ensure("Atmosphere")
	atmosphere.Density = a.Density or 0.3
	atmosphere.Offset = a.Offset or 0.25
	atmosphere.Color = a.Color or RGB(199, 220, 255)
	atmosphere.Decay = a.Decay or RGB(106, 120, 150)
	atmosphere.Glare = a.Glare or 0.3
	atmosphere.Haze = a.Haze or 1.4

	local c = preset.Color or {}
	local cc = ensure("ColorCorrectionEffect")
	cc.Saturation = c.Saturation or 0.1
	cc.Contrast = c.Contrast or 0.15
	cc.Brightness = c.Brightness or 0.02
	cc.TintColor = c.Tint or RGB(255, 250, 245)

	local b = preset.Bloom or {}
	local bloom = ensure("BloomEffect")
	bloom.Intensity = b.Intensity or 0.8
	bloom.Size = b.Size or 24
	bloom.Threshold = b.Threshold or 2

	local rays = ensure("SunRaysEffect")
	rays.Intensity = preset.SunRays or 0.06
	rays.Spread = 0.6

	local sky = ensure("Sky")
	sky.StarCount = preset.Stars or 3000
	sky.SunAngularSize = preset.SunSize or 21
	sky.MoonAngularSize = preset.MoonSize or 11
	sky.CelestialBodiesShown = true

	local clouds = ensure("Clouds", workspace.Terrain)
	clouds.Cover = preset.Clouds or 0.55
	clouds.Density = Kit.Cartoon and 0.72 or 0.6 -- nubes más esponjosas en Cartoon
	clouds.Color = preset.CloudColor or RGB(255, 255, 255)

	-- Agua del terreno: color, reflejo, transparencia y olas de cada mapa
	local w = preset.Water or {}
	local terrain = workspace.Terrain
	terrain.WaterColor = w.Color or RGB(12, 84, 92)
	terrain.WaterReflectance = w.Reflectance or 1
	terrain.WaterTransparency = w.Transparency or 0.3
	terrain.WaterWaveSize = w.WaveSize or 0.15
	terrain.WaterWaveSpeed = w.WaveSpeed or 10

	-- Colores de los materiales del terreno (hierba, nieve, roca...) según el mapa
	for name, color in TERRAIN_DEFAULTS do
		local custom = preset.TerrainColors and preset.TerrainColors[name]
		pcall(function()
			terrain:SetMaterialColor(Enum.Material[name], custom or color)
		end)
	end
end

-- Suelo de terreno (en vez de una pieza): con Grass sale hierba 3D animada (Terrain.Decoration,
-- activada en default.project.json). La superficie queda exactamente en y = 0.
function Kit.terrainFloor(material, length, width)
	workspace.Terrain:FillBlock(CFrame.new(0, -2, 0), V(length, 4, width), material)
end

-- Cambia el material del terreno del suelo en una zona (caminos de barro, suelo bajo edificios...)
function Kit.terrainPatch(cf, size, material)
	workspace.Terrain:FillBlock(cf * CFrame.new(0, -2, 0), V(size.X, 4, size.Z), material)
end

-- Empieza un mapa nuevo: borra el anterior (y el agua/roca de Terrain). options.Realistic: este
-- mapa usa materiales y luz realistas aunque el juego esté en estilo Cartoon (mapas tipo CoD)
function Kit.Begin(name, options)
	Kit.Cartoon = not realMaterials() and not (options and options.Realistic)
	-- (mapa hecho ya realista: su luz y sus colores se respetan tal cual)
	Kit.Designed = options ~= nil and options.Realistic == true
	local old = workspace:FindFirstChild("Map")
	if old then
		old:Destroy()
	end
	workspace.Terrain:Clear()
	local folder = Instance.new("Folder")
	folder.Name = "Map"
	folder:SetAttribute("Generated", true)
	folder:SetAttribute("MapName", name)
	folder:SetAttribute("Realistic", Kit.Cartoon == false or nil)
	folder.Parent = workspace
	Kit.folder = folder
	return folder
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="111">
          <Properties>
            <string name="Name">PlayerData</string>
            <string name="Source"><![CDATA[-- Datos persistentes del jugador (nivel, XP, monedas, skins, trajes, armas) guardados con DataStore,
-- y toda la economía: tienda con monedas, compras con Robux, VIP, recompensa diaria, cajas,
-- retos diarios y maestría de armas.
-- En Studio activa: Game Settings > Security > "Enable Studio Access to API Services".
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local PolicyService = game:GetService("PolicyService")
local GroupService = game:GetService("GroupService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.GameConfig)
local MobileHUD = require(Shared.MobileHUD)
local Skins = require(Shared.Skins)
local Weapons = require(Shared.Weapons)
local Outfits = require(Shared.Outfits)
local Ranks = require(Shared.Ranks)
local Shop = require(Shared.Shop)
local Friends = require(script.Parent.Friends)
local Badges = require(script.Parent.Badges)
local Challenges = require(Shared.Challenges)
local Mastery = require(Shared.Mastery)
local KillEffects = require(Shared.KillEffects)
local Charms = require(Shared.Charms)
local Sprays = require(Shared.Sprays)
local Titles = require(Shared.Titles)
local Remotes = require(Shared.Remotes)
local Poses = require(Shared.Poses)
local PlayerCards = require(Shared.PlayerCards)
local Catalog = require(Shared.Economy.CosmeticCatalog)
local Products = require(Shared.Economy.Products)
local MonetizationConfig = require(Shared.Economy.MonetizationConfig)
local BattlePassConfig = require(Shared.Economy.BattlePassConfig)
local BattlePass = require(script.Parent.BattlePass)
local Entitlements = require(script.Parent.Entitlements)
local Analytics = require(script.Parent.Analytics)

local Rules = MonetizationConfig.Rules

local PlayerData = {}

-- Callbacks que otros módulos pueden asignar
PlayerData.OnSkinChanged = nil -- function(player, skinId)
PlayerData.OnOutfitChanged = nil -- function(player, outfitId)
PlayerData.OnLeaving = nil :: ((player: Player) -> ())? -- justo antes del guardado final al salir
PlayerData.OnClassApplied = nil :: ((player: Player) -> ())? -- al equipar una clase (Loadout cambia las armas si toca)

local store
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("ShooterRobData_v1")
	end)
	if ok then
		store = result
	else
		warn("[PlayerData] DataStore no disponible, el progreso no se guardará:", result)
	end
end

local profiles = {}
local noSave = {} -- jugadores cuya carga falló: no sobrescribimos sus datos
local cratesRestricted = {} -- países donde no se permiten objetos aleatorios de pago

local STARTING_COINS = 250
local MAX_PURCHASE_LOG = 60
-- Bloqueo de sesión: un servidor "reserva" los datos del jugador mientras está dentro, para que otro
-- servidor no lea datos viejos y los sobrescriba (por ejemplo al cambiar rápido de servidor).
local LOCK_TIMEOUT = 600 -- si el servidor que tenía el bloqueo se cayó, a los 10 min se puede quitar
local LOCK_WAIT = 25 -- segundos máximos esperando a que el otro servidor suelte los datos
local SAVE_COOLDOWN = 7 -- Roblox permite ~1 escritura por clave cada 6 s

local saving = {} -- jugadores con un guardado en curso
local dirty = {} -- jugadores con cambios pendientes de guardar
local pendingPerk = {} -- [jugador] = true: la ventaja cambiada se aplica al reaparecer

-- La ventaja (Settings.Perk) pasa al atributo Perk que leen los demás sistemas: ya mismo si está en
-- el menú, muerto o en el despliegue antes de la partida; si no, al reaparecer (no se cambia a
-- mitad de un tiroteo)
local function applyPerk(player)
	local data = profiles and profiles[player]
	if not data then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local deploying = game:GetService("ReplicatedStorage"):GetAttribute("Deploy") ~= nil
	if player:GetAttribute("InMenu") or deploying or not humanoid or humanoid.Health <= 0 then
		player:SetAttribute("Perk", math.floor(data.Settings.Perk or 0))
	elseif not pendingPerk[player] then
		pendingPerk[player] = true
		player.CharacterAdded:Once(function()
			pendingPerk[player] = nil
			local current = profiles[player]
			player:SetAttribute("Perk", math.floor((current and current.Settings.Perk) or 0))
		end)
	end
end
local saveScheduled = {}

local function defaults()
	return {
		Level = 1,
		XP = 0,
		Coins = STARTING_COINS,
		Skins = { Default = true },
		EquippedSkin = "Default",
		Primary = "ARX27",
		Secondary = "Viper",
		Melee = "Knife", -- arma cuerpo a cuerpo elegida (Weapons.Melees)
		OwnedWeapons = {},
		Outfits = { Default = true },
		EquippedOutfit = "Default",
		ClaimedFree = {},
		ClaimedPremium = {},
		TotalKills = 0,
		Wins = 0,
		TotalDeaths = 0, -- estadísticas del perfil
		Matches = 0,
		BestStreak = 0,
		BestMatchKills = 0, -- récord de bajas en una partida (al batirlo, celebración en el resumen)
		Headshots = 0,
		RankPoints = 0, -- puntos de rango competitivo (ver Ranks)
		RankBest = 1, -- rango más alto alcanzado (sus premios ya se dieron)
		Premium = false,
		DailyStreak = 0,
		LastDailyDay = -1,
		LastPlayDay = -1,
		FirstWinDay = -1, -- día de la última "primera victoria del día"
		BonusLevel = 0, -- último nivel revisado para los premios de después del pase (0 = sin empezar)
		CratePity = 0, -- partidas seguidas sin caja sorpresa -- último día (Shop.DayNumber) en que entró: para el premio de regreso
		FreeCrates = 0,
		Purchases = {},
		KillEffects = { Default = true }, -- efectos de eliminación comprados
		EquippedKillEffect = "Default",
		Charms = { Default = true }, -- colgantes de arma comprados
		EquippedCharm = "Default",
		Sprays = { Default = true }, -- grafitis comprados (tecla J)
		EquippedSpray = "Default",
		Assists = 0, -- asistencias (ver Combat)
		RankSeason = "", -- temporada de rango de sus RP (ver Ranks.Seasons)
		SeasonBest = 0, -- mejor rango alcanzado en esta temporada (0 = aún no ha jugado de rango)
		ReferredBy = 0, -- quién le invitó (UserId), ver GameConfig.Referral
		Referrals = 0, -- amigos nuevos que entraron con su invitación y le dieron premio
		Titles = {}, -- títulos comprados (los ganados jugando salen de las estadísticas)
		EquippedTitle = "Novato",
		WeaponKills = {}, -- bajas con cada arma (maestría)
		WeaponCamos = {}, -- camuflaje de maestría elegido para cada arma
		Challenges = { Day = -1, List = {}, Rerolls = 0, Bonus = false },
		WeeklyChallenges = { Week = -1, List = {}, Bonus = false }, -- retos semanales
		StarterPack = false, -- ya compró el pack de inicio
		Bundles = {}, -- packs de temporada comprados ([Id] = true, ver Shop.Bundles)
		TutorialDone = false, -- ya vio la tarjeta de controles de la primera partida
		NewsSeen = 0, -- última versión de las novedades que ha visto (GameConfig.News)
		Achievements = {}, -- logros reclamados ([Id] = true)
		GroupReward = false, -- ya reclamó el premio del grupo (GameConfig.Group)
		EventProgress = { Id = "", Count = 0 }, -- caramelos del evento de temporada (ver Event)
		Revives = GameConfig.StartingRevives, -- "Revivir instantáneo" disponibles
		BoostXP = 0, -- segundos de juego que quedan de XP doble (Shop.Boosters)
		BoostCoins = 0, -- segundos de juego que quedan de monedas dobles
		Gifts = { Day = -1, Claimed = 0, Seconds = 0 }, -- regalos por tiempo jugado de hoy (ver Gifts)
		WheelDay = -1, -- último día con giro gratis de la ruleta usado
		WheelSpins = 0, -- giros de ruleta comprados sin usar
		Poses = { [Poses.Default] = true }, -- poses de victoria (pantalla final)
		EquippedPose = Poses.Default,
		MVPIntros = { [Poses.DefaultIntro] = true }, -- intros de MVP
		EquippedMVPIntro = Poses.DefaultIntro,
		Cards = { [PlayerCards.Default] = true }, -- tarjetas de jugador
		EquippedCard = PlayerCards.Default,
		Pass = nil, -- pase de batalla por temporadas (ver BattlePass); se crea al cargar
		SeenItems = {}, -- novedades de la tienda ya vistas (["Tipo:Id"] = true): sin etiqueta NUEVO
		FirstPurchase = false, -- ya hizo su primera compra con Robux (bonus: tarjeta PRIMER GOLPE)
		StarterSeen = false, -- ya vio la tarjeta grande del pack de inicio (no se repite)
		Settings = table.clone(GameConfig.DefaultSettings),
	}
end

---------------------------------------------------------------------------
-- Retos diarios
---------------------------------------------------------------------------

-- Reparte retos nuevos si ha cambiado el día
local function ensureChallenges(player, data)
	local today = Shop.DayNumber()
	local state = data.Challenges
	if type(state) ~= "table" or state.Day ~= today or type(state.List) ~= "table" then
		local list = {}
		for _, id in Challenges.Pick(today, player.UserId, data.Level, Challenges.PerDay) do
			table.insert(list, { Id = id, Progress = 0, Done = false })
		end
		state = { Day = today, List = list, Rerolls = 0, Bonus = false }
		data.Challenges = state
	end
	return state
end

-- Reparte retos semanales nuevos si ha empezado otra semana
local function ensureWeekly(player, data)
	local week = Challenges.WeekNumber(Shop.DayNumber())
	local state = data.WeeklyChallenges
	if type(state) ~= "table" or state.Week ~= week or type(state.List) ~= "table" then
		local list = {}
		for _, id in Challenges.Pick(week, player.UserId, data.Level, Challenges.WeeklyCount, nil, 17, Challenges.WeeklyPool) do
			table.insert(list, { Id = id, Progress = 0, Done = false })
		end
		state = { Week = week, List = list, Bonus = false }
		data.WeeklyChallenges = state
	end
	return state
end

local function entriesView(entries)
	local list = {}
	for _, entry in entries do
		local def = Challenges.Get(entry.Id)
		if def then
			table.insert(list, {
				Id = entry.Id,
				Text = def.Text,
				Goal = def.Goal,
				Progress = math.min(entry.Progress, def.Goal),
				Done = entry.Done,
				Coins = def.Coins,
				XP = def.XP,
			})
		end
	end
	return list
end

local function challengesView(player, data)
	local state = ensureChallenges(player, data)
	local weekly = ensureWeekly(player, data)
	local list = entriesView(state.List)
	return {
		List = list,
		RerollsLeft = math.max(0, Challenges.RerollsPerDay - (state.Rerolls or 0)),
		Bonus = state.Bonus == true,
		BonusCrates = Challenges.BonusCrates,
		Weekly = {
			List = entriesView(weekly.List),
			Bonus = weekly.Bonus == true,
			BonusCrates = Challenges.WeeklyBonusCrates,
			EndsAt = Challenges.WeekEndsAt(weekly.Week),
		},
	}
end

-- Skin con la que se ve un arma: el camuflaje de maestría elegido para ella (si lo tiene) o la skin general
function PlayerData.SkinFor(data, weaponName)
	if not data then
		return "Default"
	end
	local camo = data.WeaponCamos and data.WeaponCamos[weaponName]
	if camo and Mastery.HasCamo(data.WeaponKills and data.WeaponKills[weaponName] or 0, camo) then
		return camo
	end
	return data.EquippedSkin or "Default"
end

local function key(player)
	return "u_" .. player.UserId
end

local function publicView(player, data)
	-- (la temporada en curso; tras la última de Ranks.Seasons no se muestra)
	local season = Ranks.CurrentSeason()
	local seasonView = os.time() < season.EndsAt and data.RankSeason == season.Id and season or nil
	return {
		Level = data.Level,
		XP = data.XP,
		XPPerLevel = GameConfig.XPPerLevel,
		Coins = data.Coins,
		Skins = data.Skins,
		EquippedSkin = data.EquippedSkin,
		Primary = data.Primary,
		Secondary = data.Secondary,
		Melee = data.Melee,
		Classes = data.Classes,
		ActiveClass = data.ActiveClass,
		OwnedWeapons = data.OwnedWeapons,
		Outfits = data.Outfits,
		EquippedOutfit = data.EquippedOutfit,
		TotalKills = data.TotalKills,
		Wins = data.Wins,
		TotalDeaths = data.TotalDeaths,
		Assists = data.Assists,
		Matches = data.Matches,
		BestStreak = data.BestStreak,
		Headshots = data.Headshots,
		RankPoints = data.RankPoints,
		Premium = data.Premium,
		VIP = player:GetAttribute("VIP") == true,
		DailyStreak = data.DailyStreak,
		DailyAvailable = data.LastDailyDay ~= Shop.DayNumber(),
		-- Día que tocaría al reclamar hoy (si se saltó un día, la racha vuelve al 1)
		DailyNext = (data.LastDailyDay == Shop.DayNumber() - 1) and (data.DailyStreak % #Shop.DailyRewards + 1) or 1,
		FirstWinAvailable = data.FirstWinDay ~= Shop.DayNumber(),
		FreeCrates = data.FreeCrates,
		CratesRestricted = cratesRestricted[player] == true,
		Day = Shop.DayNumber(),
		WeaponKills = data.WeaponKills,
		WeaponCamos = data.WeaponCamos,
		KillEffects = data.KillEffects,
		EquippedKillEffect = data.EquippedKillEffect,
		Charms = data.Charms,
		EquippedCharm = data.EquippedCharm,
		Sprays = data.Sprays,
		EquippedSpray = data.EquippedSpray,
		Titles = data.Titles,
		EquippedTitle = data.EquippedTitle,
		Settings = data.Settings,
		Revives = data.Revives,
		BoostXP = data.BoostXP,
		BoostCoins = data.BoostCoins,
		WheelFree = data.WheelDay ~= Shop.DayNumber(),
		WheelSpins = data.WheelSpins,
		-- (si sus datos no se guardan, no se le enseña el tutorial: probablemente ya lo vio)
		TutorialDone = data.TutorialDone == true or noSave[player] == true,
		NewsSeen = data.NewsSeen,
		Achievements = data.Achievements,
		GroupReward = data.GroupReward == true,
		RankBest = data.RankBest,
		RankSeasonName = seasonView and seasonView.Name or nil,
		RankSeasonEndsAt = seasonView and seasonView.EndsAt or nil,
		EventCandy = (type(data.EventProgress) == "table" and data.EventProgress.Id == GameConfig.Event.Id) and data.EventProgress.Count or 0,
		StarterPackAvailable = Products.Enabled(Shop.StarterPack) and not data.StarterPack and data.Level <= MonetizationConfig.StarterPack.MaxLevel,
		StarterPackEligible = not data.StarterPack and data.Level <= MonetizationConfig.StarterPack.MaxLevel,
		StarterPack = data.StarterPack == true,
		StarterSeen = data.StarterSeen == true,
		Bundles = data.Bundles,
		Poses = data.Poses,
		EquippedPose = data.EquippedPose,
		MVPIntros = data.MVPIntros,
		EquippedMVPIntro = data.EquippedMVPIntro,
		Cards = data.Cards,
		EquippedCard = data.EquippedCard,
		SeenItems = data.SeenItems,
		FirstPurchase = data.FirstPurchase == true,
		Pass = BattlePass.View(data),
		BundlesAvailable = (function()
			local list = {}
			for _, bundle in Shop.Bundles do
				if Shop.BundleOnSale(bundle) and not data.Bundles[bundle.Id] then
					table.insert(list, bundle.Id)
				end
			end
			return list
		end)(),
		Challenges = challengesView(player, data),
	}
end

local function sendUpdate(player)
	local data = profiles[player]
	if data then
		Remotes.DataUpdate:FireClient(player, publicView(player, data))
	end
end
PlayerData.SendUpdate = sendUpdate

-- Límite de peticiones de equipamiento/ajustes por jugador (cubo de fichas): "EQUIPAR TODO" manda
-- varias seguidas, pero un cliente modificado no puede inundar el servidor de DataUpdate
local REQUEST_BURST, REQUEST_RATE = 20, 6 -- fichas máximas y fichas por segundo
local requestBuckets = setmetatable({}, { __mode = "k" })
local function allowRequest(player)
	local now = os.clock()
	local bucket = requestBuckets[player]
	if not bucket then
		bucket = { Tokens = REQUEST_BURST, Time = now }
		requestBuckets[player] = bucket
	end
	bucket.Tokens = math.min(REQUEST_BURST, bucket.Tokens + (now - bucket.Time) * REQUEST_RATE)
	bucket.Time = now
	if bucket.Tokens < 1 then
		return false
	end
	bucket.Tokens -= 1
	return true
end

function PlayerData.GetLeaderstats(player)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		for _, name in { "Bajas", "Muertes", "Nivel" } do
			local value = Instance.new("IntValue")
			value.Name = name
			value.Parent = stats
		end
		stats.Parent = player
	end
	return stats
end

-- Lo ganado en la partida actual (para el resumen del final de la ronda). Además de la XP y las
-- monedas de jugar: monedas extra (retos, pase, maestría), cajas, retos completados y desbloqueos,
-- para que la pantalla final enseñe exactamente lo que se ha dado
local match = {} -- [player] = { XP, Coins, BonusCoins, Crates, StartLevel, StartXP, StartRank, Challenges, Unlocks }

local function matchOf(player, data)
	local entry = match[player]
	if not entry then
		entry = {
			XP = 0,
			Coins = 0,
			BonusCoins = 0,
			Crates = 0,
			StartLevel = data.Level,
			StartXP = data.XP,
			StartRank = data.RankPoints,
			Challenges = {},
			Unlocks = {},
			PassXP = 0, -- XP del pase ganada en la partida
			PassStartXP = type(data.Pass) == "table" and data.Pass.XP or 0,
			WeaponKills = {}, -- bajas con cada arma en la partida (oferta de después: "DOMINASTE CON...")
		}
		match[player] = entry
	end
	return entry
end

-- Apunta en el resumen de la partida algo que se ha dado (solo si hay partida en marcha)
local function noteMatch(player, data, field, value)
	local entry = matchOf(player, data)
	if field == "BonusCoins" or field == "Crates" or field == "PassXP" then
		entry[field] += value
	elseif #entry[field] < 8 then
		table.insert(entry[field], value)
	end
end

-- XP del pase (con aviso al subir de nivel y apuntada en el resumen de la partida)
local function addPassXP(player, data, amount)
	local before, after, added = BattlePass.AddXP(data, amount)
	if added <= 0 then
		return 0
	end
	if match[player] then
		noteMatch(player, data, "PassXP", added)
	end
	if after > before then
		Remotes.Notify:FireClient(player, "Unlock", "🎖️ ¡NIVEL " .. after .. " DEL PASE! Reclama tus recompensas en PASE")
	end
	dirty[player] = true
	return added
end
PlayerData.AddPassXP = function(player, amount)
	local data = profiles[player]
	if data then
		local added = addPassXP(player, data, amount)
		PlayerData.SendUpdate(player)
		return added
	end
	return 0
end

-- Premios por nivel de cuenta después del nivel 50 (GameConfig.PostPassRewards). El pase de batalla
-- ya no va por nivel de cuenta: tiene su propia XP y sus recompensas se reclaman (ver BattlePass).
local function grantTierRewards(player)
	local data = profiles[player]
	if not data then
		return
	end
	-- Tras el pase: premio cada pocos niveles (GameConfig.PostPassRewards). BonusLevel = último nivel
	-- ya revisado; 0 = sin empezar (los que ya estaban por encima del pase empiezan a contar desde ahora)
	local bonus = GameConfig.PostPassRewards
	local passLevels = #GameConfig.BattlePass
	if bonus then
		local checked = tonumber(data.BonusLevel) or 0
		if checked <= 0 then
			data.BonusLevel = math.max(data.Level, passLevels)
		elseif data.Level > checked then
			for level = checked + 1, data.Level do
				if level > passLevels and (level - passLevels) % bonus.Every == 0 then
					data.Coins += bonus.Coins
					data.FreeCrates += bonus.Crates
					Remotes.Notify:FireClient(player, "Challenge", "⭐ ¡Nivel " .. level .. "! +" .. bonus.Coins .. " 💰 y " .. bonus.Crates .. (bonus.Crates == 1 and " caja" or " cajas"))
				end
			end
			data.BonusLevel = data.Level
		end
	end
end

local function ownsPass(player, passId)
	if not passId or passId == 0 then
		return false
	end
	-- (un fallo puntual de Roblox no debe dejar sin su pase a quien lo compró: se reintenta y se avisa)
	local ok, owns
	for attempt = 1, 2 do
		ok, owns = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
		end)
		if ok then
			break
		end
		if attempt == 1 then
			task.wait(1)
		end
	end
	if not ok then
		warn("[PlayerData] No se pudo comprobar el Game Pass", passId, "de", player.Name, owns)
	end
	return ok and owns == true
end

local function checkPolicy(player)
	local ok, info = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(player)
	end)
	-- Si no podemos comprobarlo, por seguridad tratamos las cajas de pago como restringidas
	cratesRestricted[player] = not ok or (info and info.ArePaidRandomItemsRestricted == true)
end

local function load(player)
	local data
	if store then
		local loaded, result = false, nil
		local started = os.clock()
		local attempt = 0
		while player.Parent do
			attempt += 1
			local locked = false
			local force = os.clock() - started > LOCK_WAIT
			loaded, result = pcall(function()
				return store:UpdateAsync(key(player), function(old)
					local lock = type(old) == "table" and old.SessionLock
					if type(lock) == "table" and lock.Job ~= game.JobId and not force and os.time() - (lock.Time or 0) < LOCK_TIMEOUT then
						locked = true
						return nil -- otro servidor aún tiene los datos: no tocamos nada
					end
					old = type(old) == "table" and old or {}
					old.SessionLock = { Job = game.JobId, Time = os.time() }
					return old
				end)
			end)
			if loaded and not locked then
				break
			end
			if not loaded and attempt >= 3 then
				break
			end
			task.wait(loaded and 3 or attempt)
		end
		if loaded then
			data = result
		else
			warn("[PlayerData] No se pudieron cargar los datos de", player.Name, result)
			noSave[player] = true
		end
	end

	local merged = defaults()
	local isNew = type(data) ~= "table" or data.Level == nil
	if not isNew then
		for k, v in data do
			merged[k] = v
		end
		if data.Coins == nil then
			merged.Coins = 0
		end
	end
	if type(merged.WeaponKills) ~= "table" then
		merged.WeaponKills = {}
	end
	if type(merged.WeaponCamos) ~= "table" then
		merged.WeaponCamos = {}
	end
	if type(merged.Revives) ~= "number" or merged.Revives ~= merged.Revives then
		merged.Revives = GameConfig.StartingRevives
	end
	if type(merged.Settings) ~= "table" then
		merged.Settings = table.clone(GameConfig.DefaultSettings)
	end
	if type(merged.Gifts) ~= "table" or type(merged.Gifts.Claimed) ~= "number" or type(merged.Gifts.Seconds) ~= "number" then
		merged.Gifts = { Day = -1, Claimed = 0, Seconds = 0 }
	end
	-- Antes la calidad por defecto era "Alta" (daba lag en equipos modestos): pasa a "Auto" una vez
	if merged.Settings.QualityVersion ~= GameConfig.DefaultSettings.QualityVersion then
		merged.Settings.Quality = "Auto"
		merged.Settings.QualityVersion = GameConfig.DefaultSettings.QualityVersion
	end
	-- Disposición de los controles táctiles de una versión anterior (Fase 15): se migra sin borrar lo
	-- del jugador (MobileHUD.MigrateLayout: si no la había personalizado, usa la nueva; si sí, la suya)
	if merged.Settings.HudLayoutVersion ~= MobileHUD.LayoutVersion then
		merged.Settings.HudLayout, merged.Settings.HudLayoutVersion = MobileHUD.MigrateLayout(merged.Settings.HudLayout, merged.Settings.HudLayoutVersion)
	end
	-- Ajustes nuevos que aún no tenía guardados (después de la migración de calidad)
	for key, value in GameConfig.DefaultSettings do
		if merged.Settings[key] == nil then
			merged.Settings[key] = type(value) == "table" and table.clone(value) or value
		end
	end
	-- (la disposición de los controles táctiles siempre limpia, aunque venga de un guardado viejo)
	merged.Settings.HudLayout = MobileHUD.Validate(merged.Settings.HudLayout)
	if type(merged.KillEffects) ~= "table" then
		merged.KillEffects = { Default = true }
	end
	if not KillEffects.List[merged.EquippedKillEffect] or not merged.KillEffects[merged.EquippedKillEffect] then
		merged.EquippedKillEffect = "Default"
	end
	-- Nombres de armas antiguos -> nuevos
	merged.Primary = Weapons.Legacy[merged.Primary] or merged.Primary
	merged.Secondary = Weapons.Legacy[merged.Secondary] or merged.Secondary
	if not Skins.List[merged.EquippedSkin] or not merged.Skins[merged.EquippedSkin] then
		merged.EquippedSkin = "Default"
	end
	if not Outfits.List[merged.EquippedOutfit] or not merged.Outfits[merged.EquippedOutfit] then
		merged.EquippedOutfit = "Default"
	end
	if not table.find(Weapons.Primaries, merged.Primary) or not Weapons.IsUnlocked(merged.Primary, merged) then
		merged.Primary = "ARX27"
	end
	if not table.find(Weapons.Secondaries, merged.Secondary) or not Weapons.IsUnlocked(merged.Secondary, merged) then
		merged.Secondary = Weapons.Secondary
	end
	if not table.find(Weapons.Melees, merged.Melee) or not Weapons.IsUnlocked(merged.Melee, merged) then
		merged.Melee = Weapons.Melee
	end
	-- Clases (5 huecos: principal, secundaria y ventaja). La primera vez, la clase 1 es lo que ya
	-- llevaba equipado (no cambia nada para quien ya jugaba); las demás, las de partida
	local hadClasses = type(merged.Classes) == "table"
	local classes = hadClasses and merged.Classes or {}
	merged.Classes = {}
	for i = 1, GameConfig.ClassCount do
		local default = GameConfig.DefaultClasses[i]
		local class = type(classes[i]) == "table" and classes[i] or {}
		if not hadClasses and i == 1 then
			class = { Primary = merged.Primary, Secondary = merged.Secondary, Perk = merged.Settings.Perk }
		end
		local perk = class.Perk
		merged.Classes[i] = {
			Name = default.Name,
			Primary = (type(class.Primary) == "string" and table.find(Weapons.Primaries, class.Primary)) and class.Primary or default.Primary,
			Secondary = (type(class.Secondary) == "string" and table.find(Weapons.Secondaries, class.Secondary)) and class.Secondary or default.Secondary,
			Perk = (type(perk) == "number" and perk == perk and perk >= 0 and perk <= #GameConfig.Perks) and math.floor(perk) or default.Perk,
		}
	end
	if type(merged.ActiveClass) ~= "number" or not merged.Classes[merged.ActiveClass] then
		merged.ActiveClass = 1
	end
	if type(merged.RankPoints) ~= "number" or merged.RankPoints ~= merged.RankPoints then
		merged.RankPoints = 0
	end
	if type(merged.Charms) ~= "table" then
		merged.Charms = { Default = true }
	end
	if not Charms.List[merged.EquippedCharm] or not merged.Charms[merged.EquippedCharm] then
		merged.EquippedCharm = "Default"
	end
	if type(merged.Achievements) ~= "table" then
		merged.Achievements = {}
	end
	if type(merged.Bundles) ~= "table" then
		merged.Bundles = {}
	end
	if merged.HalloweenBundle == true then
		merged.Bundles.Halloween = true -- (antes se guardaba aparte)
	end
	merged.HalloweenBundle = nil
	if type(merged.Titles) ~= "table" then
		merged.Titles = {}
	end
	if not Titles.List[merged.EquippedTitle] then
		merged.EquippedTitle = "Novato"
	end
	if type(merged.Sprays) ~= "table" then
		merged.Sprays = { Default = true }
	end
	-- (el de VIP se comprueba al pintar: el atributo VIP aún no está puesto al cargar)
	local equippedSpray = Sprays.List[merged.EquippedSpray]
	if not equippedSpray or not (merged.Sprays[merged.EquippedSpray] or equippedSpray.VIPOnly) then
		merged.EquippedSpray = "Default"
	end
	merged.GroupReward = merged.GroupReward == true
	if type(merged.WheelSpins) ~= "number" or merged.WheelSpins < 0 then
		merged.WheelSpins = 0
	end
	if type(merged.WheelDay) ~= "number" then
		merged.WheelDay = -1
	end
	-- Cosméticos nuevos (poses, intros de MVP, tarjetas): lo básico siempre, y lo equipado debe existir
	for _, kind in { "Pose", "MVPIntro", "Card" } do
		local spec = Catalog.Kinds[kind]
		if type(merged[spec.Owned]) ~= "table" then
			merged[spec.Owned] = {}
		end
		merged[spec.Owned][spec.Default] = true
		if not Catalog.Owns(merged, kind, merged[spec.Equipped]) then
			merged[spec.Equipped] = spec.Default
		end
	end
	if type(merged.SeenItems) ~= "table" then
		merged.SeenItems = {}
	end
	merged.FirstPurchase = merged.FirstPurchase == true
	merged.StarterSeen = merged.StarterSeen == true
	-- (los guardados de antes de existir RankBest: su rango actual)
	if type(merged.RankBest) ~= "number" or (not isNew and type(data) == "table" and data.RankBest == nil) then
		merged.RankBest = math.max(type(merged.RankBest) == "number" and merged.RankBest or 1, Ranks.Index(merged.RankPoints))
	end
	if type(merged.EventProgress) ~= "table" or type(merged.EventProgress.Count) ~= "number" then
		merged.EventProgress = { Id = "", Count = 0 }
	end
	-- Quien ya jugaba antes de existir el tutorial no lo ve
	-- Los nuevos no ven las novedades (ven la tarjeta de controles)
	if isNew or type(merged.NewsSeen) ~= "number" then
		merged.NewsSeen = isNew and GameConfig.ActiveNews().Version or 0
	end
	if not isNew and data.TutorialDone == nil and ((merged.Level or 1) > 1 or (merged.TotalKills or 0) > 0) then
		merged.TutorialDone = true
	end
	merged.Premium = merged.Premium or ownsPass(player, GameConfig.PremiumPassId)
	-- Pase de batalla de la temporada (la primera vez se pasa del pase por nivel de antes)
	local leftovers = BattlePass.Ensure(merged)
	player:SetAttribute("VIP", ownsPass(player, Shop.VIPPassId))
	PlayerData.UpdatePremium(player)
	checkPolicy(player)

	if not player.Parent then
		-- Se fue mientras cargaba: se suelta el bloqueo de sesión que se acaba de poner (si no, al
		-- volver tendría que esperar LOCK_WAIT). Solo se quita el bloqueo, sin tocar sus datos.
		if store and not noSave[player] then
			local ok, err = pcall(function()
				store:UpdateAsync(key(player), function(old)
					local lock = type(old) == "table" and old.SessionLock
					if type(lock) == "table" and lock.Job == game.JobId then
						old.SessionLock = nil
						return old
					end
					return nil
				end)
			end)
			if not ok then
				warn("[PlayerData] No se pudo soltar el bloqueo de", player.Name, err)
			end
		end
		noSave[player] = nil
		cratesRestricted[player] = nil
		return
	end
	-- Temporada de rango (premio de la que acabó mientras no jugaba; el aviso, cuando ya ve la pantalla)
	local seasonText = PlayerData.RollSeason(merged)
	if seasonText then
		task.delay(8, function()
			if player.Parent then
				Remotes.Notify:FireClient(player, "Big", seasonText)
			end
		end)
	end
	-- Premio de regreso (tras unos días sin jugar)
	local comebackText = PlayerData.RollComeback(merged)
	if comebackText then
		task.delay(seasonText and 12 or 8, function()
			if player.Parent then
				Remotes.Notify:FireClient(player, "Big", comebackText)
			end
		end)
	end
	profiles[player] = merged
	PlayerData.PublishCosmetics(player)
	if leftovers and #leftovers > 0 then
		task.delay(10, function()
			if player.Parent then
				Remotes.Notify:FireClient(player, "Big", "🎖️ Fin de temporada: te entregamos " .. #leftovers .. " recompensas del pase que no habías reclamado")
			end
		end)
	end
	Badges.Check(player, merged)
	PlayerData.GetLeaderstats(player).Nivel.Value = merged.Level
	player:SetAttribute("Rank", Ranks.Index(merged.RankPoints))
	player:SetAttribute("Perk", math.floor((merged.Settings and merged.Settings.Perk) or 0)) -- (ventaja: la leen los demás sistemas)
	PlayerData.PublishTitle(player)
	grantTierRewards(player)
	if isNew and not noSave[player] then -- (si no se pudieron cargar sus datos, quizá no es nuevo)
		PlayerData.HandleReferral(player)
	end
	sendUpdate(player)
end

-- Invitación de un amigo (GameConfig.Referral): la invitación lleva "ref:<UserId>" en LaunchData.
-- Solo para jugadores nuevos y una vez; el que invitó cobra si está en este servidor.
function PlayerData.HandleReferral(player)
	local data = profiles[player]
	local config = GameConfig.Referral
	if not data or not config or (data.ReferredBy or 0) ~= 0 then
		return
	end
	local ok, joinData = pcall(player.GetJoinData, player)
	local launch = ok and type(joinData) == "table" and joinData.LaunchData
	local inviterId = type(launch) == "string" and tonumber(string.match(launch, "^ref:(%d+)$"))
	if not inviterId or inviterId == player.UserId or inviterId <= 0 then
		return
	end
	data.ReferredBy = inviterId
	dirty[player] = true
	local inviter = Players:GetPlayerByUserId(inviterId)
	local given = PlayerData.AddCoins(player, config.NewPlayerCoins or 0, false)
	Remotes.Notify:FireClient(player, "Big", "👥 ¡Te invitó " .. (inviter and inviter.DisplayName or "un amigo") .. "! +" .. given .. " 💰")
	local inviterData = inviter and profiles[inviter]
	-- (cuentas recién creadas no dan premio al que invita: así no se abusa con cuentas de usar y tirar)
	if inviterData and (inviterData.Referrals or 0) < (config.MaxRewards or 0) and (player.AccountAge or 0) >= (config.MinAccountAge or 0) then
		inviterData.Referrals = (inviterData.Referrals or 0) + 1
		local bonus = PlayerData.AddCoins(inviter, config.InviterCoins or 0, false)
		dirty[inviter] = true
		Remotes.Notify:FireClient(inviter, "Big", "👥 ¡" .. player.DisplayName .. " entró con tu invitación! +" .. bonus .. " 💰")
	end
end

-- Guarda los datos. release = true al salir el jugador: suelta el bloqueo de sesión.
local function save(player, release)
	local data = profiles[player]
	if not data or not store or noSave[player] then
		return false
	end
	-- Espera a que acabe otro guardado de este jugador (no pisar escrituras)
	local waited = 0
	while saving[player] and waited < 15 do
		task.wait(0.5)
		waited += 0.5
	end
	saving[player] = true
	dirty[player] = nil
	local stolen = false
	local ok, err = pcall(function()
		store:UpdateAsync(key(player), function(old)
			local lock = type(old) == "table" and old.SessionLock
			if type(lock) == "table" and lock.Job ~= game.JobId then
				stolen = true
				return nil -- otro servidor tiene ahora los datos: no los sobrescribimos
			end
			data.SessionLock = if release then nil else { Job = game.JobId, Time = os.time() }
			return data
		end)
	end)
	saving[player] = nil
	if not ok then
		warn("[PlayerData] Error al guardar", player.Name, err)
		dirty[player] = true
	elseif stolen then
		warn("[PlayerData] Otro servidor tiene los datos de", player.Name, "- no se guardan aquí")
		noSave[player] = true
		return false
	end
	return ok
end

-- Pide un guardado pronto, agrupando varios cambios seguidos en una sola escritura
local function requestSave(player)
	dirty[player] = true
	if saveScheduled[player] then
		return
	end
	saveScheduled[player] = true
	task.delay(SAVE_COOLDOWN, function()
		saveScheduled[player] = nil
		if dirty[player] and player.Parent then
			save(player)
		end
	end)
end

function PlayerData.Get(player)
	return profiles[player]
end

-- Espera a que los datos del jugador estén cargados (máx. timeout segundos)
function PlayerData.WaitFor(player, timeout)
	local start = os.clock()
	while not profiles[player] and player.Parent and os.clock() - start < (timeout or 15) do
		task.wait(0.1)
	end
	return profiles[player]
end

-- Potenciador comprado activo (Shop.Boosters) para "XP" o "Coins"
-- (solo cuenta en partida: lo que se reclama desde la portada, como la recompensa diaria, no se dobla)
local function boosterMultiplier(player, data, kind)
	if player:GetAttribute("InMenu") ~= false then
		return 1
	end
	for _, booster in Shop.Boosters do
		if booster.Kind == kind and (tonumber(data[booster.Field]) or 0) > 0 then
			return booster.Multiplier
		end
	end
	return 1
end

-- VIP (x2), Roblox Premium (x1,2) y bonus de amigos en el servidor (+10% por amigo, ver Friends)
local featuredBonus -- (definida más abajo, junto a xpBoost)
local function multiplier(player)
	local vip = player:GetAttribute("VIP") and Shop.VIPMultiplier or 1
	local premium = player:GetAttribute("RobloxPremium") and GameConfig.RobloxPremium and GameConfig.RobloxPremium.Multiplier or 1
	return vip * premium * Friends.Multiplier(player)
end

-- XP extra de hoy (GameConfig.XPBoost: fin de semana de XP doble)
local function xpBoost()
	local boost = GameConfig.XPBoost
	if not boost or not boost.Enabled then
		return 1
	end
	local today = os.date("!*t").wday
	return table.find(boost.Days, today) and boost.Multiplier or 1
end
PlayerData.XPBoost = xpBoost

-- Bonus de XP del mapa destacado del día (mientras se juega en él)
featuredBonus = function()
	local config = GameConfig.FeaturedMap
	local featured = ReplicatedStorage:GetAttribute("FeaturedMap")
	if config and featured and ReplicatedStorage:GetAttribute("State") == "Playing" and ReplicatedStorage:GetAttribute("MapName") == featured then
		return config.XPBonus or 1
	end
	return 1
end

-- Lo pone Event: se llama al recoger la recompensa diaria
PlayerData.OnDailyClaimed = nil :: ((Player) -> ())?

-- Roblox Premium (atributo RobloxPremium: lo leen el multiplicador y la Tienda)
function PlayerData.UpdatePremium(player)
	local ok, premium = pcall(function()
		return player.MembershipType == Enum.MembershipType.Premium
	end)
	player:SetAttribute("RobloxPremium", ok and premium == true)
end

-- Envía los datos al cliente (cambios hechos desde fuera, p. ej. el evento)
function PlayerData.SendUpdate(player)
	sendUpdate(player)
end

-- Da una skin (premios de evento); devuelve true si es nueva
function PlayerData.GiveSkin(player, skinId)
	local data = profiles[player]
	if not data or not Skins.List[skinId] or data.Skins[skinId] then
		return false
	end
	data.Skins[skinId] = true
	dirty[player] = true
	sendUpdate(player)
	return true
end

-- Da un traje (recompensas de evento). Devuelve false si ya lo tenía
function PlayerData.GiveOutfit(player, outfitId)
	local data = profiles[player]
	if not data or not Outfits.List[outfitId] or data.Outfits[outfitId] then
		return false
	end
	data.Outfits[outfitId] = true
	dirty[player] = true
	sendUpdate(player)
	return true
end

-- Da un arma (premios de evento). Devuelve false si ya la tenía
function PlayerData.GiveWeapon(player, weaponName)
	local data = profiles[player]
	if not data or not Weapons.List[weaponName] or data.OwnedWeapons[weaponName] then
		return false
	end
	data.OwnedWeapons[weaponName] = true
	dirty[player] = true
	sendUpdate(player)
	return true
end

-- Marca los datos para guardarlos en el próximo guardado automático (cambios hechos desde fuera)
function PlayerData.MarkDirty(player)
	if profiles[player] then
		dirty[player] = true
	end
end

-- Da revivir instantáneos (regalos por tiempo jugado)
function PlayerData.AddRevives(player, amount)
	local data = profiles[player]
	if not data or amount <= 0 then
		return
	end
	data.Revives = (data.Revives or 0) + amount
	dirty[player] = true
	sendUpdate(player)
end

-- Gasta un "Revivir instantáneo". Devuelve false si no le quedan.
function PlayerData.UseRevive(player)
	local data = profiles[player]
	if not data or (data.Revives or 0) <= 0 then
		return false
	end
	data.Revives -= 1
	dirty[player] = true
	sendUpdate(player)
	return true
end

-- Empieza una partida: se pone a cero lo ganado
function PlayerData.StartMatch(player)
	match[player] = nil
	local data = profiles[player]
	if data then
		matchOf(player, data)
	end
end

-- Resumen de lo ganado desde StartMatch
function PlayerData.MatchSummary(player)
	local data = profiles[player]
	if not data then
		return nil
	end
	local entry = matchOf(player, data)
	local topWeapon, topKills = nil, 0
	for weaponName, kills in entry.WeaponKills do
		if kills > topKills or (kills == topKills and topWeapon and weaponName < topWeapon) then
			topWeapon, topKills = weaponName, kills
		end
	end
	return {
		XP = entry.XP,
		Coins = entry.Coins,
		StartLevel = entry.StartLevel,
		StartXP = entry.StartXP,
		Level = data.Level,
		LevelXP = data.XP,
		XPPerLevel = GameConfig.XPPerLevel,
		StartRank = entry.StartRank or data.RankPoints,
		RankPoints = data.RankPoints,
		BonusCoins = entry.BonusCoins,
		Crates = entry.Crates,
		Challenges = entry.Challenges,
		Unlocks = entry.Unlocks,
		-- Pase de batalla: XP ganada y dónde estaba / está
		PassXP = entry.PassXP,
		PassStartXP = entry.PassStartXP,
		PassNowXP = type(data.Pass) == "table" and data.Pass.XP or 0,
		PassXPPerTier = BattlePassConfig.XPPerTier,
		PassTiers = BattlePassConfig.Tiers,
		PassClaimable = BattlePass.Claimable(data),
		-- El arma con la que más bajas hizo (para la oferta pequeña de después de la partida)
		TopWeapon = topWeapon,
		TopWeaponKills = topKills,
		Matches = data.Matches,
	}
end

-- Cambio de temporada de rango: premio por el mejor rango de la anterior y RP a la mitad.
-- Devuelve el texto del aviso (o nil si no tocaba).
function PlayerData.RollSeason(data)
	local season = Ranks.CurrentSeason()
	if data.RankSeason == season.Id then
		return nil
	end
	if type(data.RankSeason) ~= "string" or data.RankSeason == "" then
		-- (jugador nuevo o guardado de antes de las temporadas: empieza en la actual sin premio)
		data.RankSeason = season.Id
		data.SeasonBest = 0
		return nil
	end
	-- (SeasonBest = 0: no jugó ninguna partida de rango esa temporada, así que no hay premio)
	local best = math.clamp(math.floor(tonumber(data.SeasonBest) or 0), 0, #Ranks.Tiers)
	local coins = best > 0 and Ranks.SeasonRewards[best] or 0
	local finished = Ranks.SeasonName(data.RankSeason)
	data.Coins += coins
	data.RankPoints = math.floor((data.RankPoints or 0) * Ranks.SeasonCarry)
	data.RankSeason = season.Id
	data.SeasonBest = 0
	if best == 0 then
		return "🏁 ¡Empieza la " .. season.Name .. "! Tus RP pasan a la mitad: juega para subir"
	end
	local tier = Ranks.Tiers[best]
	return "🏁 ¡Fin de la " .. finished .. "! Llegaste a " .. tier.Icon .. " " .. tier.Name .. ": +" .. coins .. " 💰. Empieza la " .. season.Name
end

-- Premio de regreso (GameConfig.Comeback): se apunta el día de hoy; si hacía Days días o más que no
-- entraba, monedas y cajas gratis. Los guardados sin LastPlayDay (nuevos o de antes) solo se apuntan.
function PlayerData.RollComeback(data, today)
	today = today or Shop.DayNumber()
	local last = tonumber(data.LastPlayDay) or -1
	data.LastPlayDay = today
	local config = GameConfig.Comeback
	if not config or last < 0 or today - last < config.Days then
		return nil
	end
	data.Coins += config.Coins
	data.FreeCrates = (data.FreeCrates or 0) + config.Crates
	data.BoostXP = (tonumber(data.BoostXP) or 0) + (config.BoostXPMinutes or 0) * 60
	return "👋 ¡BIENVENIDO DE VUELTA! Regalo por volver: +" .. config.Coins .. " 💰"
		.. (config.Crates > 0 and (", " .. config.Crates .. (config.Crates == 1 and " caja gratis" or " cajas gratis")) or "")
		.. ((config.BoostXPMinutes or 0) > 0 and (" y ⚡ XP doble " .. config.BoostXPMinutes .. " min") or "")
end

-- Primera victoria del día (GameConfig.FirstWinOfDay): premio extra una vez al día (hora UTC).
-- Devuelve las monedas dadas (o nil si ya la tuvo hoy).
function PlayerData.ClaimFirstWin(player, scale)
	local data = profiles[player]
	local config = GameConfig.FirstWinOfDay
	if not data or not config then
		return nil
	end
	local today = Shop.DayNumber()
	if data.FirstWinDay == today then
		return nil
	end
	data.FirstWinDay = today
	dirty[player] = true
	scale = scale or 1
	PlayerData.AddXP(player, math.floor(config.XP * scale), "Primera victoria del día")
	return PlayerData.AddCoins(player, math.floor(config.Coins * scale))
end

-- Caja sorpresa (GameConfig.SurpriseCrate): al acabar una partida jugada, una probabilidad pequeña de
-- una caja gratis; tras Pity partidas sin ninguna, sale seguro. Devuelve true si toca.
function PlayerData.RollSurpriseCrate(player, roll)
	local data = profiles[player]
	local config = GameConfig.SurpriseCrate
	if not data or not config then
		return false
	end
	data.CratePity = (tonumber(data.CratePity) or 0) + 1
	local chance = config.Chance * ((Rules.VIPCrates and player:GetAttribute("VIP")) and (config.VIPMultiplier or 1) or 1)
	if (roll or math.random()) >= chance and data.CratePity < config.Pity then
		return false
	end
	data.CratePity = 0
	data.FreeCrates += 1
	noteMatch(player, data, "Crates", 1)
	dirty[player] = true
	sendUpdate(player)
	return true
end

-- Cambia de temporada a un jugador conectado (al acabar una partida o desde el bucle del servidor).
-- Devuelve true si ha cambiado.
function PlayerData.CheckSeason(player)
	local data = profiles[player]
	if not data then
		return false
	end
	local text = PlayerData.RollSeason(data)
	if not text then
		return false
	end
	player:SetAttribute("Rank", Ranks.Index(data.RankPoints))
	-- (el resumen de la partida compara con los RP ya recortados: el recorte no es de la partida)
	if match[player] then
		match[player].StartRank = data.RankPoints
	end
	Remotes.Notify:FireClient(player, "Big", text)
	dirty[player] = true
	sendUpdate(player)
	return true
end

-- Suma (o resta) puntos de rango al acabar una partida; nunca baja del inicio del rango actual
function PlayerData.AddRankPoints(player, delta)
	local data = profiles[player]
	if not data or delta == 0 then
		return 0
	end
	matchOf(player, data) -- (el resumen de la partida guarda el rango de antes)
	-- (si la temporada acabó con el servidor encendido, se cambia antes de sumar)
	PlayerData.CheckSeason(player)
	local before = data.RankPoints
	data.RankPoints = Ranks.Apply(before, delta)
	local index = Ranks.Index(data.RankPoints)
	data.SeasonBest = math.max(tonumber(data.SeasonBest) or 0, index)
	player:SetAttribute("Rank", index)
	-- Premios de los rangos alcanzados por primera vez
	while (data.RankBest or 1) < index do
		data.RankBest = (data.RankBest or 1) + 1
		local tier = Ranks.Tiers[data.RankBest]
		local reward = tier.Reward or {}
		local text = tier.Icon .. " ¡Rango " .. tier.Name .. "!"
		if reward.Coins then
			data.Coins += reward.Coins
			text ..= "  +" .. reward.Coins .. " 💰"
		end
		if reward.Crates then
			data.FreeCrates += reward.Crates
			text ..= "  +" .. reward.Crates .. (reward.Crates == 1 and " caja" or " cajas")
		end
		Remotes.Notify:FireClient(player, "Challenge", text)
	end
	Badges.Check(player, data)
	dirty[player] = true
	sendUpdate(player)
	return data.RankPoints - before
end

-- fixed = true: premio fijo (no lo multiplican VIP ni amigos y no cuenta en el resumen de la partida)
function PlayerData.AddXP(player, amount, reason, fixed)
	local data = profiles[player]
	if not data or amount <= 0 then
		return
	end
	-- XP del pase: parte de la XP de jugar (BattlePassConfig.MatchXPRate), sin lo que se paga (VIP,
	-- potenciadores) ni los amigos
	local rate = BattlePassConfig.MatchXPRate or 1
	local passAmount = math.floor(amount * rate)
	if not fixed then
		local free = xpBoost() * featuredBonus()
		passAmount = math.floor(amount * rate * (Rules.PassXPFromPaidBoosts and free * multiplier(player) * boosterMultiplier(player, data, "XP") or free))
		amount = math.floor(amount * multiplier(player) * xpBoost() * boosterMultiplier(player, data, "XP") * featuredBonus())
		matchOf(player, data).XP += amount
	end
	addPassXP(player, data, passAmount)
	data.XP += amount
	Remotes.Notify:FireClient(player, "XP", "+" .. amount .. " XP  " .. (reason or ""))
	local leveled = false
	while data.XP >= GameConfig.XPPerLevel do
		data.XP -= GameConfig.XPPerLevel
		data.Level += 1
		leveled = true
	end
	if leveled then
		Badges.Check(player, data)
		PlayerData.GetLeaderstats(player).Nivel.Value = data.Level
		Remotes.Notify:FireClient(player, "LevelUp", data.Level)
		-- ¿Desbloquea alguna arma este nivel?
		for name, def in Weapons.List do
			if def.UnlockLevel == data.Level and not def.Hidden then
				Remotes.Notify:FireClient(player, "Unlock", "¡Arma desbloqueada: " .. def.DisplayName .. "!")
				noteMatch(player, data, "Unlocks", { Kind = "Weapon", Id = name, Name = def.DisplayName, Sub = string.upper(def.Category or "ARMA") })
			end
		end
		grantTierRewards(player)
	end
	sendUpdate(player)
end

-- earned = true para monedas ganadas jugando (el VIP las duplica)
-- noBoost = true: le aplican VIP y amigos pero no los potenciadores (p. ej. la recompensa diaria)
function PlayerData.AddCoins(player, amount, earned, noBoost)
	local data = profiles[player]
	if data then
		if earned ~= false then
			amount = math.floor(amount * multiplier(player) * (noBoost and 1 or boosterMultiplier(player, data, "Coins")))
			matchOf(player, data).Coins += amount
		end
		data.Coins += amount
		sendUpdate(player)
		return amount -- lo que se ha sumado de verdad (con VIP y amigos)
	end
	return 0
end

function PlayerData.Increment(player, field, amount)
	local data = profiles[player]
	if data and type(data[field]) == "number" then
		data[field] += amount or 1
		if field == "TotalKills" or field == "Wins" then
			Badges.Check(player, data)
		end
	end
end

-- Guarda un récord (por ejemplo la mejor racha de bajas) si lo supera
function PlayerData.SetBest(player, field, value)
	local data = profiles[player]
	if data and type(data[field]) == "number" and value > data[field] then
		data[field] = value
		dirty[player] = true
	end
end

-- Título que ven los demás (atributos Title y TitleColor). Si ya no lo tiene (p. ej. el de VIP), Novato.
function PlayerData.PublishTitle(player)
	local data = profiles[player]
	if not data then
		return
	end
	local id = data.EquippedTitle
	if not Titles.Owns(data, id, player:GetAttribute("VIP") == true) then
		id = "Novato"
	end
	local title = Titles.Get(id)
	player:SetAttribute("Title", id ~= "Novato" and title.Name or nil)
	player:SetAttribute("TitleColor", title.Color)
end

-- Cosméticos que ven los demás (tarjeta, pose de victoria e intro de MVP): atributos del jugador que
-- leen la escuadra, el marcador y la pantalla final
function PlayerData.PublishCosmetics(player)
	local data = profiles[player]
	if not data then
		return
	end
	player:SetAttribute("Card", data.EquippedCard ~= PlayerCards.Default and data.EquippedCard or nil)
	player:SetAttribute("Pose", data.EquippedPose ~= Poses.Default and data.EquippedPose or nil)
	player:SetAttribute("MVPIntro", data.EquippedMVPIntro ~= Poses.DefaultIntro and data.EquippedMVPIntro or nil)
end

-- Progreso de los retos diarios. stat: ver Challenges.luau. Para "Streak" amount es la racha actual.
function PlayerData.Track(player, stat, amount, weaponName)
	local data = profiles[player]
	if not data then
		return
	end
	local state = ensureChallenges(player, data)
	local changed = false
	for _, entry in state.List do
		local def = Challenges.Get(entry.Id)
		if def and not entry.Done and Challenges.Matches(def, stat, weaponName) then
			if stat == "Streak" then
				entry.Progress = math.max(entry.Progress, amount or 0)
			else
				entry.Progress += amount or 1
			end
			if entry.Progress >= def.Goal then
				entry.Done = true
				changed = true
				Remotes.Notify:FireClient(player, "Challenge", "¡RETO COMPLETADO! +" .. def.Coins .. " 💰")
				PlayerData.AddCoins(player, def.Coins, false)
				noteMatch(player, data, "BonusCoins", def.Coins)
				noteMatch(player, data, "Challenges", { Text = def.Text, Goal = def.Goal, Coins = def.Coins, XP = def.XP })
				PlayerData.AddXP(player, def.XP, "Reto diario")
				addPassXP(player, data, BattlePassConfig.DailyMissionXP)
			end
		end
	end
	if changed and not state.Bonus then
		local all = #state.List > 0
		for _, entry in state.List do
			all = all and entry.Done
		end
		if all then
			state.Bonus = true
			data.FreeCrates += Challenges.BonusCrates
			noteMatch(player, data, "Crates", Challenges.BonusCrates)
			Remotes.Notify:FireClient(player, "Unlock", "¡Todos los retos de hoy completados! Caja gratis 🎁")
		end
	end
	-- Retos semanales
	local weekly = ensureWeekly(player, data)
	local weeklyChanged = false
	for _, entry in weekly.List do
		local def = Challenges.Get(entry.Id)
		if def and not entry.Done and Challenges.Matches(def, stat, weaponName) then
			if stat == "Streak" then
				entry.Progress = math.max(entry.Progress, amount or 0)
			else
				entry.Progress += amount or 1
			end
			if entry.Progress >= def.Goal then
				entry.Done = true
				weeklyChanged = true
				Remotes.Notify:FireClient(player, "Challenge", "¡RETO SEMANAL COMPLETADO! +" .. def.Coins .. " 💰")
				PlayerData.AddCoins(player, def.Coins, false)
				noteMatch(player, data, "BonusCoins", def.Coins)
				noteMatch(player, data, "Challenges", { Text = def.Text, Goal = def.Goal, Coins = def.Coins, XP = def.XP, Weekly = true })
				PlayerData.AddXP(player, def.XP, "Reto semanal")
				addPassXP(player, data, BattlePassConfig.WeeklyMissionXP)
			end
		end
	end
	if weeklyChanged and not weekly.Bonus then
		local all = #weekly.List > 0
		for _, entry in weekly.List do
			all = all and entry.Done
		end
		if all then
			weekly.Bonus = true
			data.FreeCrates += Challenges.WeeklyBonusCrates
			noteMatch(player, data, "Crates", Challenges.WeeklyBonusCrates)
			Remotes.Notify:FireClient(player, "Unlock", "¡Retos de la semana completados! " .. Challenges.WeeklyBonusCrates .. " cajas gratis 🎁")
		end
	end
	-- Misiones de temporada del pase
	local seasonDone = BattlePass.Track(data, stat, amount)
	for _, mission in seasonDone do
		Remotes.Notify:FireClient(player, "Challenge", "🎖️ ¡MISIÓN DE TEMPORADA! " .. mission.Text .. "  +" .. mission.XP .. " XP del pase")
		if match[player] then
			noteMatch(player, data, "PassXP", mission.XP)
			noteMatch(player, data, "Challenges", { Text = mission.Text, Goal = mission.Goal, Coins = 0, XP = mission.XP, Season = true })
		end
		dirty[player] = true
	end
	if changed or weeklyChanged or #seasonDone > 0 then
		sendUpdate(player)
	end
end

-- Cuenta una baja con un arma y entrega la maestría al subir de nivel
function PlayerData.AddWeaponKill(player, weaponName)
	local data = profiles[player]
	if not data or type(weaponName) ~= "string" or not Weapons.List[weaponName] or Weapons.List[weaponName].Hidden then
		return -- (las garras de zombi no tienen maestría)
	end
	local before = data.WeaponKills[weaponName] or 0
	local after = before + 1
	data.WeaponKills[weaponName] = after
	if match[player] then
		local kills = match[player].WeaponKills
		kills[weaponName] = (kills[weaponName] or 0) + 1
	end
	local oldLevel, newLevel = Mastery.Level(before), Mastery.Level(after)
	if newLevel > oldLevel then
		local tier = Mastery.Tiers[newLevel]
		-- Equipa el camuflaje nuevo automáticamente: ¡que se vea!
		data.WeaponCamos[weaponName] = tier.Camo
		Remotes.Notify:FireClient(player, "Mastery", "MAESTRÍA " .. string.upper(tier.Name) .. ": " .. Weapons.List[weaponName].DisplayName)
		PlayerData.AddCoins(player, tier.Coins, false)
		noteMatch(player, data, "BonusCoins", tier.Coins)
		noteMatch(player, data, "Unlocks", { Kind = "Camo", Id = weaponName, Skin = tier.Camo, Name = Weapons.List[weaponName].DisplayName, Sub = "CAMUFLAJE: " .. string.upper(Skins.Get(tier.Camo).Name) })
		if PlayerData.OnSkinChanged then
			PlayerData.OnSkinChanged(player)
		end
		sendUpdate(player)
	else
		-- "¡Ya casi!": con 3 bajas o menos para el siguiente camuflaje, un aviso en cada baja
		local nextTier = Mastery.Tiers[newLevel + 1]
		local left = nextTier and nextTier.Kills - after
		if left and left > 0 and left <= 3 then
			Remotes.Notify:FireClient(player, "XP", "🎯 " .. Weapons.List[weaponName].DisplayName .. ": " .. (left == 1 and "¡1 baja" or ("¡" .. left .. " bajas")) .. " para el camuflaje " .. nextTier.Name .. "!")
		end
	end
end

---------------------------------------------------------------------------
-- Tienda
---------------------------------------------------------------------------

-- Compra con monedas. Lo que se vende con Robux no se puede comprar con monedas (y al revés), y las
-- armas se desbloquean solo por nivel (MonetizationConfig.Rules.WeaponsForCoins).
local AUTO_EQUIP = { KillEffect = true, Charm = true, Spray = true, Title = true } -- (como siempre)
local function buyItem(player, kind, id)
	local data = profiles[player]
	if not data or type(kind) ~= "string" or type(id) ~= "string" then
		return false, "Datos no cargados"
	end
	if kind == "Weapon" then
		local def = Weapons.List[id]
		if not Rules.WeaponsForCoins then
			return false, def and def.UnlockLevel and ("Se desbloquea en el nivel " .. def.UnlockLevel) or "No está a la venta"
		end
		if not def or not def.Price then
			return false, "No está a la venta"
		end
		if Weapons.IsUnlocked(id, data) then
			return false, "Ya la tienes"
		end
		if data.Coins < def.Price then
			return false, "Te faltan " .. (def.Price - data.Coins) .. " monedas"
		end
		data.Coins -= def.Price
		data.OwnedWeapons[id] = true
		sendUpdate(player)
		requestSave(player)
		return true, "¡Comprado!"
	end
	if not Catalog.Kinds[kind] or not Catalog.Exists(kind, id) then
		return false, "No existe"
	end
	if Catalog.Owns(data, kind, id, player:GetAttribute("VIP") == true) then
		return false, "Ya lo tienes"
	end
	if Products.Item(kind, id) then
		return false, "Se compra con Robux"
	end
	local price = Catalog.CoinPrice(kind, id)
	if not price then
		return false, "No está a la venta"
	end
	if data.Coins < price then
		return false, "Te faltan " .. (price - data.Coins) .. " monedas"
	end
	data.Coins -= price
	Catalog.Grant(data, kind, id)
	local equipped = false
	if AUTO_EQUIP[kind] then
		data[Catalog.Kinds[kind].Equipped] = id
		equipped = true
		if kind == "Title" then
			PlayerData.PublishTitle(player)
		end
	end
	sendUpdate(player)
	requestSave(player)
	Analytics.Event(player, "purchase_success", { item = Catalog.Key(kind, id), coins = price })
	Analytics.Economy(player, "Sink", price, data.Coins, "Shop", Catalog.Key(kind, id))
	Remotes.PurchaseGranted:FireClient(player, { Type = "CoinItem", Items = { { Kind = kind, Id = id } }, Equipped = equipped, Price = price })
	return true, "¡Comprado!"
end

local function claimDaily(player)
	local data = profiles[player]
	if not data then
		return false
	end
	local today = Shop.DayNumber()
	if data.LastDailyDay == today then
		return false
	end
	local streak = (data.LastDailyDay == today - 1) and data.DailyStreak + 1 or 1
	if streak > #Shop.DailyRewards then
		streak = 1
	end
	data.DailyStreak = streak
	data.LastDailyDay = today
	local coins = Shop.DailyRewards[streak]
	local given = PlayerData.AddCoins(player, coins, true, true)
	local crate = streak == Shop.DailyCrateDay
	if crate then
		data.FreeCrates += 1
	end
	if player:GetAttribute("VIP") then
		-- (antes una caja: el azar no va ligado a un pase de pago; ahora monedas)
		if Rules.VIPCrates then
			data.FreeCrates += 1
		else
			data.Coins += Rules.VIPDailyCoins or 0
			given += Rules.VIPDailyCoins or 0
		end
	end
	sendUpdate(player)
	-- (el evento en marcha regala también unos objetos; lo pone Event)
	if PlayerData.OnDailyClaimed then
		task.spawn(PlayerData.OnDailyClaimed, player)
	end
	return true, { Streak = streak, Coins = given, Crate = crate }
end

local pendingReceipt = {} -- [player] = true mientras se guarda una compra con Robux

-- Ruleta: gasta el giro gratis de hoy (o uno comprado) y da un premio al azar según su peso.
-- Devuelve el índice del premio para que el cliente pare la ruleta en él.
local lastSpin = {} -- [player] = os.clock() (no más de un giro cada 3 s: dura la animación)
local function spinWheel(player)
	local data = profiles[player]
	if not data then
		return false, "Cargando..."
	end
	if not Rules.Wheel then
		return false, "No disponible"
	end
	if os.clock() - (lastSpin[player] or 0) < 3 then
		return false, "Espera a que pare la ruleta"
	end
	local today = Shop.DayNumber()
	if data.WheelDay ~= today then
		data.WheelDay = today
	elseif Rules.PaidWheelSpins and data.WheelSpins > 0 and not cratesRestricted[player] and not pendingReceipt[player] then
		-- (los giros comprados son premios al azar de pago: no donde no se permiten; y no mientras se
		-- guarda una compra, por si hay que deshacerla)
		data.WheelSpins -= 1
	else
		return false, "Vuelve mañana para otro giro gratis"
	end
	lastSpin[player] = os.clock()
	local prizes = Shop.Wheel.Prizes
	local total = 0
	for _, prize in prizes do
		total += prize.Weight
	end
	local roll = math.random() * total
	local index = #prizes
	for i, prize in prizes do
		roll -= prize.Weight
		if roll <= 0 then
			index = i
			break
		end
	end
	local prize = prizes[index]
	-- (premio fijo: no lo multiplica el VIP)
	if prize.Kind == "Coins" then
		data.Coins += prize.Amount
	elseif prize.Kind == "Revives" then
		data.Revives += prize.Amount
	elseif prize.Kind == "Crate" then
		data.FreeCrates += prize.Amount
	elseif prize.Kind == "XP" then
		PlayerData.AddXP(player, prize.Amount, "Ruleta", true)
	elseif prize.Kind == "Boost" then
		data[prize.Field] = (tonumber(data[prize.Field]) or 0) + prize.Amount * 60
	end
	sendUpdate(player)
	requestSave(player)
	return true, index
end
Players.PlayerRemoving:Connect(function(player)
	lastSpin[player] = nil
	pendingPerk[player] = nil
end)

-- Abre una caja. Devuelve lo que ha tocado para la animación del cliente.
local function openCrate(player, crateId, useFree)
	local data = profiles[player]
	local crate = Shop.Crates[crateId]
	if not data or not crate then
		return false, "No existe"
	end
	if useFree then
		if data.FreeCrates <= 0 then
			return false, "No tienes cajas gratis"
		end
		data.FreeCrates -= 1
	else
		-- (con monedas no: las monedas se venden con Robux y sería azar de pago)
		if not Rules.CoinCrates then
			return false, "Las cajas solo se consiguen jugando"
		end
		if cratesRestricted[player] then
			return false, "Las cajas de pago no están disponibles en tu región"
		end
		if data.Coins < crate.Price then
			return false, "Te faltan " .. (crate.Price - data.Coins) .. " monedas"
		end
		data.Coins -= crate.Price
	end

	-- Rareza según probabilidades
	local total = 0
	for _, entry in crate.Odds do
		total += entry.Weight
	end
	local roll = math.random() * total
	local rarity = crate.Odds[#crate.Odds].Rarity
	for _, entry in crate.Odds do
		roll -= entry.Weight
		if roll <= 0 then
			rarity = entry.Rarity
			break
		end
	end
	-- Objeto aleatorio de esa rareza (skins y trajes)
	local pool = {}
	for id, skin in Skins.List do
		if id ~= "Default" and not skin.Mastery and not skin.Event and skin.Rarity == rarity and not Products.Item("Skin", id) then
			table.insert(pool, { Kind = "Skin", Id = id })
		end
	end
	for id, outfit in Outfits.List do
		if id ~= "Default" and not outfit.Event and outfit.Rarity == rarity and not Products.Item("Outfit", id) then
			table.insert(pool, { Kind = "Outfit", Id = id })
		end
	end
	if #pool == 0 then
		for id, skin in Skins.List do
			if id ~= "Default" and not skin.Mastery and not skin.Event and not Products.Item("Skin", id) then
				table.insert(pool, { Kind = "Skin", Id = id })
			end
		end
	end
	local prize = pool[math.random(1, #pool)]
	local owned
	if prize.Kind == "Skin" then
		owned = data.Skins[prize.Id] == true
	else
		owned = data.Outfits[prize.Id] == true
	end
	local refund = 0
	if owned then
		refund = math.floor(crate.Price * crate.DuplicateRefund)
		data.Coins += refund
	elseif prize.Kind == "Skin" then
		data.Skins[prize.Id] = true
	else
		data.Outfits[prize.Id] = true
	end
	sendUpdate(player)
	requestSave(player)
	return true, { Kind = prize.Kind, Id = prize.Id, Rarity = rarity, Duplicate = owned, Refund = refund }
end

-- Compras con Robux (Developer Products). Las decide SOLO el servidor a partir del recibo de Roblox:
--   · Idempotente: cada PurchaseId se entrega una vez (data.Purchases). Un recibo repetido se confirma
--     sin volver a entregar.
--   · Una compra por jugador a la vez (receiptBusy): dos recibos seguidos no se pisan.
--   · Se entrega, se guarda y SOLO si el guardado sale bien se confirma a Roblox. Si el DataStore
--     falla, se deshace lo entregado y Roblox lo reintenta más tarde (en este servidor o en otro, al
--     volver a entrar): nunca se pierden Robux ni se entrega dos veces.
--   · Si el jugador no está (se desconectó), no se confirma: se entrega cuando vuelva.
local receiptBusy = {} -- [UserId] = true mientras se procesa un recibo suyo
local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = PlayerData.WaitFor(player, 20)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local waited = 0
	while receiptBusy[receipt.PlayerId] and waited < 30 do
		task.wait(0.1)
		waited += 0.1
	end
	if receiptBusy[receipt.PlayerId] or profiles[player] ~= data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(data.Purchases, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local resolved = Products.Resolve(receipt.ProductId)
	if not resolved then
		warn("[PlayerData] Producto desconocido:", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	receiptBusy[receipt.PlayerId] = true
	pendingReceipt[player] = true
	-- (la temporada del pase al día antes de entregar algo del pase)
	BattlePass.Ensure(data)
	local plan = Entitlements.Plan(data, resolved, { IsVIP = player:GetAttribute("VIP") == true, Now = os.time() })
	if not plan then
		receiptBusy[receipt.PlayerId] = nil
		pendingReceipt[player] = nil
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local undo = Entitlements.Apply(data, plan)
	table.insert(data.Purchases, receipt.PurchaseId)
	while #data.Purchases > MAX_PURCHASE_LOG do
		table.remove(data.Purchases, 1)
	end
	local saved = store and not noSave[player] and save(player)
	pendingReceipt[player] = nil
	receiptBusy[receipt.PlayerId] = nil
	if not saved then
		-- No se pudo guardar: deshacemos y Roblox lo reintentará más tarde (así nunca se pierden Robux)
		undo()
		local index = table.find(data.Purchases, receipt.PurchaseId)
		if index then
			table.remove(data.Purchases, index)
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	PlayerData.PublishCosmetics(player)
	Remotes.Notify:FireClient(player, "Big", plan.Message)
	Remotes.PurchaseGranted:FireClient(player, plan.Reveal)
	sendUpdate(player)
	local robux = resolved.Def and resolved.Def.Robux or 0
	Analytics.Event(player, plan.Event, { product = resolved.Type, key = resolved.Key, robux = robux })
	if plan.Event ~= "purchase_success" then
		Analytics.Event(player, "purchase_success", { product = resolved.Type, key = resolved.Key, robux = robux })
	end
	if plan.Coins > 0 then
		Analytics.Economy(player, "Source", plan.Coins, data.Coins, "IAP", resolved.Type .. ":" .. tostring(resolved.Key))
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

---------------------------------------------------------------------------

function PlayerData.Init()
	-- Publica si hay XP extra hoy (la pantalla de inicio lo anuncia); se revisa cada minuto
	-- Potenciadores: su tiempo corre solo mientras se juega (no en la portada)
	local STEP = 5
	local function tickBoosters(player, data)
		if player:GetAttribute("InMenu") ~= false then
			return -- (en la portada o aún sin entrar en partida)
		end
		local changed, update = false, false
		for _, booster in Shop.Boosters do
			local left = tonumber(data[booster.Field]) or 0
			if left > 0 then
				data[booster.Field] = math.max(0, left - STEP)
				changed = true
				if data[booster.Field] == 0 then
					Remotes.Notify:FireClient(player, "Challenge", booster.Icon .. " Se acabó tu " .. booster.Name)
					update = true
				elseif data[booster.Field] % 60 < STEP then
					update = true -- (el cliente cuenta los segundos; se corrige cada minuto)
				end
			end
		end
		if changed then
			dirty[player] = true
		end
		if update then
			sendUpdate(player)
		end
	end
	-- (la temporada de rango y la del pase pueden acabar con el servidor encendido)
	local function tickSeasons(player, data)
		PlayerData.CheckSeason(player)
		local before = type(data.Pass) == "table" and data.Pass.Season
		local leftovers = BattlePass.Ensure(data)
		if type(data.Pass) == "table" and data.Pass.Season ~= before then
			dirty[player] = true
			sendUpdate(player)
			if leftovers and #leftovers > 0 then
				Remotes.Notify:FireClient(player, "Big", "🎖️ ¡Nueva temporada! Te entregamos " .. #leftovers .. " recompensas del pase que no habías reclamado")
			end
		end
	end
	-- Cada jugador por separado y protegido: un perfil raro no para el bucle para todo el servidor
	task.spawn(function()
		while true do
			task.wait(STEP)
			for player, data in table.clone(profiles) do
				local ok, err = pcall(tickBoosters, player, data)
				if not ok then
					warn("[PlayerData] potenciadores de", player.Name, err)
				end
			end
		end
	end)
	task.spawn(function()
		while true do
			pcall(function()
				ReplicatedStorage:SetAttribute("XPBoost", xpBoost())
			end)
			for player, data in table.clone(profiles) do
				local ok, err = pcall(tickSeasons, player, data)
				if not ok then
					warn("[PlayerData] temporada de", player.Name, err)
				end
			end
			task.wait(60)
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		PlayerData.GetLeaderstats(player)
		load(player)
	end)
	for _, player in Players:GetPlayers() do
		PlayerData.GetLeaderstats(player)
		task.spawn(load, player)
	end
	-- Se hace Premium sin salir del juego (botón de la Tienda)
	pcall(function()
		Players.PlayerMembershipChanged:Connect(function(player)
			PlayerData.UpdatePremium(player)
			local config = GameConfig.RobloxPremium
			if player:GetAttribute("RobloxPremium") and config then
				Remotes.Notify:FireClient(player, "Big", utf8.char(0xE001) .. " ¡ROBLOX PREMIUM! +" .. math.floor((config.Multiplier - 1) * 100 + 0.5) .. "% monedas y XP")
			end
			if profiles[player] then
				sendUpdate(player) -- (la Tienda se vuelve a dibujar con el bonus activo)
			end
		end)
	end)

	local pending = 0
	Players.PlayerRemoving:Connect(function(player)
		pending += 1
		-- Últimos cambios de otros módulos antes del guardado final (p. ej. el tiempo de los regalos)
		if PlayerData.OnLeaving then
			local ok, err = pcall(PlayerData.OnLeaving, player)
			if not ok then
				warn("[PlayerData] OnLeaving de", player.Name, err)
			end
		end
		save(player, true)
		pending -= 1
		profiles[player] = nil
		Badges.Forget(player)
		noSave[player] = nil
		match[player] = nil
		cratesRestricted[player] = nil
		dirty[player] = nil
		saveScheduled[player] = nil
	end)

	-- Al cerrar el servidor espera a que terminen todos los guardados (máx. ~25 s)
	game:BindToClose(function()
		for _, player in Players:GetPlayers() do
			if PlayerData.OnLeaving then
				local ok, err = pcall(PlayerData.OnLeaving, player)
				if not ok then
					warn("[PlayerData] OnLeaving de", player.Name, err)
				end
			end
			pending += 1
			task.spawn(function()
				save(player, true)
				pending -= 1
			end)
		end
		local start = os.clock()
		while pending > 0 and os.clock() - start < 25 do
			task.wait(0.2)
		end
	end)

	-- Autoguardado
	task.spawn(function()
		while true do
			task.wait(120)
			for _, player in Players:GetPlayers() do
				task.spawn(save, player)
			end
		end
	end)

	Remotes.GetData.OnServerInvoke = function(player)
		local data = PlayerData.WaitFor(player, 20)
		return data and publicView(player, data)
	end

	Remotes.EquipSkin.OnServerEvent:Connect(function(player, skinId)
		if not allowRequest(player) then
			return
		end
		local data = profiles[player]
		if not data or type(skinId) ~= "string" or not Skins.List[skinId] or not data.Skins[skinId] then
			return
		end
		if Skins.List[skinId].Mastery then
			return
		end
		data.EquippedSkin = skinId
		if PlayerData.OnSkinChanged then
			PlayerData.OnSkinChanged(player)
		end
		sendUpdate(player)
	end)

	Remotes.EquipOutfit.OnServerEvent:Connect(function(player, outfitId)
		if not allowRequest(player) then
			return
		end
		local data = profiles[player]
		if not data or type(outfitId) ~= "string" or not Outfits.List[outfitId] or not data.Outfits[outfitId] then
			return
		end
		data.EquippedOutfit = outfitId
		if PlayerData.OnOutfitChanged then
			PlayerData.OnOutfitChanged(player, outfitId)
		end
		sendUpdate(player)
	end)

	local function setWeapon(player, weaponName, field, list)
		local data = profiles[player]
		if not data or type(weaponName) ~= "string" or not table.find(list, weaponName) then
			return
		end
		if not Weapons.IsUnlocked(weaponName, data) then
			return
		end
		data[field] = weaponName
		Remotes.Notify:FireClient(player, "Info", Weapons.Get(weaponName).DisplayName .. " equipada (al reaparecer)")
		sendUpdate(player)
	end
	Remotes.SetPrimary.OnServerEvent:Connect(function(player, weaponName)
		if not allowRequest(player) then
			return
		end
		setWeapon(player, weaponName, "Primary", Weapons.Primaries)
	end)
	Remotes.SetSecondary.OnServerEvent:Connect(function(player, weaponName)
		if not allowRequest(player) then
			return
		end
		setWeapon(player, weaponName, "Secondary", Weapons.Secondaries)
	end)
	Remotes.TutorialDone.OnServerEvent:Connect(function(player)
		local data = profiles[player]
		if data and not data.TutorialDone then
			data.TutorialDone = true
			dirty[player] = true
			sendUpdate(player)
		end
	end)
	Remotes.NewsSeen.OnServerEvent:Connect(function(player)
		local data = profiles[player]
		local version = GameConfig.ActiveNews().Version
		if data and (data.NewsSeen or 0) < version then
			data.NewsSeen = version
			dirty[player] = true
			sendUpdate(player)
		end
	end)
	Remotes.SetMelee.OnServerEvent:Connect(function(player, weaponName)
		if not allowRequest(player) then
			return
		end
		setWeapon(player, weaponName, "Melee", Weapons.Melees)
	end)

	-- Ajustes del jugador: se validan y se guardan con su progreso
	Remotes.SaveSettings.OnServerEvent:Connect(function(player, settings)
		if not allowRequest(player) then
			return
		end
		local data = profiles[player]
		if not data or type(settings) ~= "table" then
			return
		end
		local clean = table.clone(data.Settings)
		if type(settings.Quality) == "string" and table.find(GameConfig.QualityLevels, settings.Quality) then
			clean.Quality = settings.Quality
		end
		for key, limits in GameConfig.SettingsLimits do
			local value = settings[key]
			if type(value) == "number" and value == value then
				clean[key] = math.clamp(math.floor(value * 100 + 0.5) / 100, limits[1], limits[2])
			end
		end
		-- Disposición de los controles táctiles: solo controles conocidos y números en su rango
		if settings.HudLayout ~= nil then
			clean.HudLayout = MobileHUD.Validate(settings.HudLayout)
		end
		data.Settings = clean
		applyPerk(player)
		dirty[player] = true
	end)

	-- Clases: elegir una (se equipa su principal, secundaria y ventaja) o cambiar una pieza
	local function applyClass(player, data, index)
		local class = data.Classes[index]
		if not class then
			return
		end
		data.ActiveClass = index
		if Weapons.IsUnlocked(class.Primary, data) then
			data.Primary = class.Primary
		end
		if Weapons.IsUnlocked(class.Secondary, data) then
			data.Secondary = class.Secondary
		end
		data.Settings.Perk = class.Perk
		applyPerk(player)
		dirty[player] = true
		if PlayerData.OnClassApplied then
			PlayerData.OnClassApplied(player)
		end
		sendUpdate(player)
	end
	Remotes.SelectClass.OnServerEvent:Connect(function(player, index)
		if not allowRequest(player) then
			return
		end
		local data = profiles[player]
		if data and type(index) == "number" and data.Classes[index] then
			applyClass(player, data, index)
		end
	end)
	Remotes.EditClass.OnServerEvent:Connect(function(player, index, field, value)
		if not allowRequest(player) then
			return
		end
		local data = profiles[player]
		local class = data and type(index) == "number" and data.Classes[index]
		if not class then
			return
		end
		if field == "Primary" or field == "Secondary" then
			local list = field == "Primary" and Weapons.Primaries or Weapons.Secondaries
			if type(value) ~= "string" or not table.find(list, value) or not Weapons.IsUnlocked(value, data) then
				return
			end
			class[field] = value
		elseif field == "Perk" then
			if type(value) ~= "number" or value ~= value or value < 0 or value > #GameConfig.Perks then
				return
			end
			class.Perk = math.floor(value)
		else
			return
		end
		if index == data.ActiveClass then
			applyClass(player, data, index)
		else
			dirty[player] = true
			sendUpdate(player)
		end
	end)
	-- Listo para jugar (buscando partida): lo ve su escuadra
	Remotes.SetReady.OnServerEvent:Connect(function(player, ready)
		if not allowRequest(player) then
			return
		end
		player:SetAttribute("Ready", ready == true and player:GetAttribute("InMenu") == true or nil)
	end)

	Remotes.EquipCharm.OnServerEvent:Connect(function(player, charmId)
		if not allowRequest(player) then
			return
		end
		local data = profiles[player]
		if not data or type(charmId) ~= "string" or not Charms.List[charmId] or not data.Charms[charmId] then
			return
		end
		data.EquippedCharm = charmId
		dirty[player] = true
		sendUpdate(player)
	end)

	Remotes.EquipTitle.OnServerEvent:Connect(function(player, titleId)
		if not allowRequest(player) then
			return
		end
		local data = profiles[player]
		if not data or type(titleId) ~= "string" or not Titles.Owns(data, titleId, player:GetAttribute("VIP") == true) then
			return
		end
		data.EquippedTitle = titleId
		dirty[player] = true
		PlayerData.PublishTitle(player)
		sendUpdate(player)
	end)

	Remotes.EquipSpray.OnServerEvent:Connect(function(player, sprayId)
		if not allowRequest(player) then
			return
		end
		local data = profiles[player]
		if not data or type(sprayId) ~= "string" or not Sprays.Owns(data.Sprays, sprayId, player:GetAttribute("VIP") == true) then
			return
		end
		data.EquippedSpray = sprayId
		dirty[player] = true
		sendUpdate(player)
	end)

	Remotes.EquipKillEffect.OnServerEvent:Connect(function(player, effectId)
		if not allowRequest(player) then
			return
		end
		local data = profiles[player]
		if not data or type(effectId) ~= "string" or not KillEffects.List[effectId] or not data.KillEffects[effectId] then
			return
		end
		data.EquippedKillEffect = effectId
		sendUpdate(player)
	end)

	-- Camuflaje de maestría para un arma ("Default" = usar la skin general)
	Remotes.SetCamo.OnServerEvent:Connect(function(player, weaponName, camoId)
		if not allowRequest(player) then
			return
		end
		local data = profiles[player]
		if not data or type(weaponName) ~= "string" or not Weapons.List[weaponName] or type(camoId) ~= "string" then
			return
		end
		if camoId == "Default" then
			data.WeaponCamos[weaponName] = nil
		elseif Mastery.HasCamo(data.WeaponKills[weaponName] or 0, camoId) then
			data.WeaponCamos[weaponName] = camoId
		else
			return
		end
		if PlayerData.OnSkinChanged then
			PlayerData.OnSkinChanged(player)
		end
		sendUpdate(player)
	end)

	-- Cambiar un reto diario sin completar por otro (1 al día)
	Remotes.RerollChallenge.OnServerInvoke = function(player, index)
		local data = profiles[player]
		if not data or type(index) ~= "number" then
			return false
		end
		local state = ensureChallenges(player, data)
		local entry = state.List[index]
		if not entry or entry.Done or (state.Rerolls or 0) >= Challenges.RerollsPerDay then
			return false
		end
		local exclude = {}
		for _, e in state.List do
			exclude[e.Id] = true
		end
		state.Rerolls = (state.Rerolls or 0) + 1
		local new = Challenges.Pick(state.Day, player.UserId, data.Level, 1, exclude, state.Rerolls)[1]
		if not new then
			return false
		end
		state.List[index] = { Id = new, Progress = 0, Done = false }
		sendUpdate(player)
		return true
	end

	Remotes.BuyItem.OnServerInvoke = buyItem
	Remotes.ClaimDaily.OnServerInvoke = claimDaily
	Remotes.SpinWheel.OnServerInvoke = spinWheel
	-- Logros: se reclaman si el dato llega a la meta y no se habían reclamado
	Remotes.ClaimAchievement.OnServerInvoke = function(player, id)
		local data = profiles[player]
		if not data or type(id) ~= "string" then
			return false, "No se pudo reclamar"
		end
		for _, achievement in GameConfig.Achievements do
			if achievement.Id == id then
				if data.Achievements[id] then
					return false, "Ya lo tienes"
				end
				if (tonumber(data[achievement.Stat]) or 0) < achievement.Goal then
					return false, "Aún no lo has conseguido"
				end
				data.Achievements[id] = true
				data.Coins += achievement.Coins
				dirty[player] = true
				sendUpdate(player)
				return true, achievement.Coins
			end
		end
		return false, "No existe"
	end
	-- Premio por unirse al grupo (una vez). IsInGroup se guarda en caché en el servidor, así que si
	-- dice que no se pregunta también a GroupService (por si se acaba de unir sin salir del juego)
	local groupChecked = {}
	Remotes.ClaimGroup.OnServerInvoke = function(player)
		local data = profiles[player]
		local group = GameConfig.Group
		if not data or not group or group.Id == 0 then
			return false, "No disponible"
		end
		if data.GroupReward then
			return false, "Ya lo tienes"
		end
		local now = os.clock()
		if groupChecked[player] and now - groupChecked[player] < 3 then
			return false, "Espera un momento"
		end
		groupChecked[player] = now
		local ok, member = pcall(player.IsInGroup, player, group.Id)
		if not (ok and member) then
			local found, groups = pcall(GroupService.GetGroupsAsync, GroupService, player.UserId)
			member = false
			if found and type(groups) == "table" then
				for _, info in groups do
					if info.Id == group.Id then
						member = true
					end
				end
			end
		end
		if not member or profiles[player] ~= data or data.GroupReward then
			return false, "NotMember"
		end
		data.GroupReward = true
		data.Coins += group.Coins
		dirty[player] = true
		sendUpdate(player)
		return true, group.Coins
	end
	Players.PlayerRemoving:Connect(function(player)
		groupChecked[player] = nil
	end)
	Remotes.OpenCrate.OnServerInvoke = openCrate
	MarketplaceService.ProcessReceipt = processReceipt

	-- Equipar cualquier cosmético (tarjeta, pose, intro de MVP... y también los de siempre). El
	-- servidor comprueba que lo tienes; si no, no hace nada.
	Remotes.EquipCosmetic.OnServerEvent:Connect(function(player, kind, id)
		if not allowRequest(player) then
			return
		end
		local data = profiles[player]
		if not data or type(kind) ~= "string" or type(id) ~= "string" or not Catalog.Kinds[kind] then
			return
		end
		if not Catalog.Equippable(kind, id) or not Catalog.Owns(data, kind, id, player:GetAttribute("VIP") == true) then
			return
		end
		data[Catalog.Kinds[kind].Equipped] = id
		dirty[player] = true
		if kind == "Skin" and PlayerData.OnSkinChanged then
			PlayerData.OnSkinChanged(player)
		elseif kind == "Outfit" and PlayerData.OnOutfitChanged then
			PlayerData.OnOutfitChanged(player, id)
		elseif kind == "Title" then
			PlayerData.PublishTitle(player)
		end
		PlayerData.PublishCosmetics(player)
		sendUpdate(player)
	end)

	-- Ya vio novedades de la tienda (quita NUEVO) o la tarjeta del pack de inicio ("Starter")
	Remotes.MarkSeen.OnServerEvent:Connect(function(player, keys)
		if not allowRequest(player) then
			return
		end
		local data = profiles[player]
		if not data or type(keys) ~= "table" then
			return
		end
		local changed = false
		for i, key in keys do
			if i > 60 then
				break
			end
			if key == "Starter" then
				changed = changed or not data.StarterSeen
				data.StarterSeen = true
			elseif type(key) == "string" and Catalog.IsNewItem(key) and not data.SeenItems[key] then
				data.SeenItems[key] = true
				changed = true
			end
		end
		if changed then
			dirty[player] = true
			sendUpdate(player)
		end
	end)

	-- Reclamar recompensas del pase: (nivel, "Free"|"Premium") o ("All")
	local lastClaim = {}
	Remotes.ClaimPass.OnServerInvoke = function(player, tier, track)
		local data = profiles[player]
		if not data then
			return false, "Cargando..."
		end
		local now = os.clock()
		if now - (lastClaim[player] or 0) < 0.25 then
			return false, "Espera un momento"
		end
		lastClaim[player] = now
		BattlePass.Ensure(data)
		local granted
		if tier == "All" then
			granted = BattlePass.ClaimAll(data)
			if #granted == 0 then
				return false, "No hay nada por reclamar"
			end
		else
			local one, err = BattlePass.Claim(data, tier, track)
			if not one then
				return false, err
			end
			granted = { one }
		end
		dirty[player] = true
		requestSave(player)
		PlayerData.PublishCosmetics(player)
		sendUpdate(player)
		Analytics.Event(player, "battlepass_claim", { count = #granted, tier = BattlePass.Tier(data) })
		return true, granted
	end
	Players.PlayerRemoving:Connect(function(player)
		lastClaim[player] = nil
	end)
	Analytics.Init()

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local data = profiles[player]
		if not data then
			return
		end
		-- Pase premium antiguo (Game Pass): da el premium de la temporada que lo admita (LegacyPremium)
		if passId == GameConfig.PremiumPassId and GameConfig.PremiumPassId ~= 0 and ownsPass(player, passId) then
			data.Premium = true
			local season = BattlePassConfig.Current()
			if season and season.LegacyPremium and type(data.Pass) == "table" and data.Pass.Season == season.Id then
				data.Pass.HasPremium = true
			end
			Remotes.Notify:FireClient(player, "Big", "¡PASE PREMIUM ACTIVADO!")
		elseif passId == Shop.VIPPassId and Shop.VIPPassId ~= 0 and ownsPass(player, passId) then
			-- (el servidor comprueba que de verdad es suyo: no se fía del aviso)
			player:SetAttribute("VIP", true)
			PlayerData.PublishTitle(player)
			Remotes.Notify:FireClient(player, "Big", "¡VIP ACTIVADO! x2 XP y monedas")
		end
		sendUpdate(player)
		save(player)
	end)
end

return PlayerData
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="112">
          <Properties>
            <string name="Name">Pumpkins</string>
            <string name="Source"><![CDATA[-- Modo Calabazas (como "Kill Confirmed"): quien cae suelta una calabaza con el color de su equipo.
-- Si la recoge el equipo contrario, punto para ellos (baja confirmada); si la recoge un compañero del
-- caído, la baja no cuenta (recuperada). Las calabazas desaparecen a los LIFETIME segundos.
-- Round decide qué pasa al recoger (OnCollect) y quién puede recoger (Collectors).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Pumpkins = {}

Pumpkins.OnCollect = nil -- function(collector, confirmed, pumpkinTeam)
Pumpkins.Collectors = nil -- function() -> { { Position, Team, Player?, Bot? } }

local LIFETIME = 30
local RADIUS = 4.5

local running = false
local generation = 0 -- (cada Start tiene su propio bucle; el de una partida anterior se para solo)
local active = {} -- { Model, Position, Team, Expires }
local folder

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

-- Suelo bajo el punto (quien cae en el aire suelta la calabaza en el suelo). nil si debajo no hay
-- suelo o es lava (nadie podría recogerla y los bots se lanzarían a por ella)
local function groundBelow(position)
	local map = workspace:FindFirstChild("Map")
	if not map then
		return position
	end
	rayParams.FilterDescendantsInstances = { map, workspace.Terrain } -- (algunos mapas tienen suelo de terreno)
	local hit = workspace:Raycast(position + Vector3.new(0, 2, 0), Vector3.new(0, -60, 0), rayParams)
	if not hit then
		return nil
	end
	local part = hit.Instance
	if part:GetAttribute("Hazard") or hit.Material == Enum.Material.CrackedLava or part.Name == "Lava" then
		return nil
	end
	return hit.Position
end

-- Fuera de Halloween el modo es "Baja confirmada": en vez de calabazas, placas de identificación
-- (se decide al empezar la partida: si Halloween empieza o acaba a mitad, no cambia)
local tagsThisMatch = nil
function Pumpkins.Tags()
	if tagsThisMatch ~= nil then
		return tagsThisMatch
	end
	return ReplicatedStorage:GetAttribute("EventName") ~= "Halloween"
end

local function build(position, team)
	local tags = Pumpkins.Tags()
	local model = Instance.new("Model")
	model.Name = "Pumpkin"
	local body = Instance.new("Part")
	body.Name = "PumpkinBody"
	if tags then
		-- Placa metálica colgando (con el color del equipo en el anillo del suelo)
		body.Size = Vector3.new(1.3, 1.9, 0.2)
		body.Color = Color3.fromRGB(205, 208, 214)
		body.Material = Enum.Material.Metal
	else
		body.Shape = Enum.PartType.Ball
		body.Size = Vector3.new(2.4, 2.4, 2.4)
		body.Color = Color3.fromRGB(255, 130, 20)
		body.Material = Enum.Material.SmoothPlastic
	end
	body.CFrame = CFrame.new(position + Vector3.new(0, 1.7, 0))
	body.Anchored = true
	body.CanCollide = false
	body.CanQuery = false
	body.CanTouch = false
	body.CastShadow = false
	-- (WorldFX la hace flotar en el cliente)
	body:SetAttribute("Bob", 0.35)
	local light = Instance.new("PointLight")
	light.Color = tags and Color3.fromRGB(230, 236, 255) or Color3.fromRGB(255, 160, 60)
	light.Range = 8
	light.Brightness = 1
	light.Parent = body
	local face = Instance.new("BillboardGui")
	face.Size = UDim2.fromOffset(46, 46)
	face.AlwaysOnTop = false
	face.LightInfluence = 0
	face.MaxDistance = 120
	face.Parent = body
	local icon = Instance.new("TextLabel")
	icon.Size = UDim2.fromScale(1, 1)
	icon.BackgroundTransparency = 1
	icon.Text = tags and "🏷️" or "🎃"
	icon.TextScaled = true
	icon.Parent = face
	body.Parent = model
	-- Anillo en el suelo con el color del equipo del caído
	local ring = Instance.new("Part")
	ring.Name = "PumpkinRing"
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.2, 4.5, 4.5)
	ring.CFrame = CFrame.new(position + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	ring.Color = team and team.TeamColor.Color or Color3.new(1, 1, 1)
	ring.Material = Enum.Material.Neon
	ring.Transparency = 0.35
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Parent = model
	model.Parent = folder
	return model
end

-- Suelta una calabaza donde cayó alguien del equipo `team`. victimId: UserId del caído (nunca puede
-- recoger la suya); fromBot: el caído era un bot (premia menos)
function Pumpkins.Drop(position, team, victimId, fromBot)
	if not running or typeof(position) ~= "Vector3" or not team then
		return
	end
	local ground = groundBelow(position)
	if not ground then
		return
	end
	table.insert(active, { Model = build(ground, team), Position = ground, Team = team, Expires = os.clock() + LIFETIME, VictimId = victimId, FromBot = fromBot })
end

-- La calabaza más cercana a un punto (para los bots); nil si no hay
function Pumpkins.Nearest(position)
	local best, bestDistance = nil, math.huge
	for _, pumpkin in active do
		local distance = (pumpkin.Position - position).Magnitude
		if distance < bestDistance then
			best, bestDistance = pumpkin.Position, distance
		end
	end
	return best, bestDistance
end

function Pumpkins.Count()
	return #active
end

local function step()
	local now = os.clock()
	local collectors = Pumpkins.Collectors and Pumpkins.Collectors() or {}
	for i = #active, 1, -1 do
		local pumpkin = active[i]
		if now > pumpkin.Expires or not pumpkin.Model.Parent then
			pumpkin.Model:Destroy()
			table.remove(active, i)
		else
			for _, collector in collectors do
				local own = collector.Player and collector.Player.UserId == pumpkin.VictimId
				local revived = collector.Player and now - (collector.Player:GetAttribute("RevivedAt") or -math.huge) < 5
				if collector.Team and not own and not revived and (collector.Position - pumpkin.Position).Magnitude <= RADIUS then
					pumpkin.Model:Destroy()
					table.remove(active, i)
					if Pumpkins.OnCollect then
						task.spawn(Pumpkins.OnCollect, collector, collector.Team ~= pumpkin.Team, pumpkin.Team, pumpkin.FromBot)
					end
					break
				end
			end
		end
	end
end

function Pumpkins.Start()
	Pumpkins.Stop()
	tagsThisMatch = ReplicatedStorage:GetAttribute("EventName") ~= "Halloween"
	running = true
	generation += 1
	local mine = generation
	folder = Instance.new("Folder")
	folder.Name = "Pumpkins"
	folder.Parent = workspace
	task.spawn(function()
		while running and generation == mine do
			local ok, err = pcall(step)
			if not ok then
				warn("[Pumpkins] Error en el bucle:", err)
			end
			task.wait(0.1)
		end
	end)
end

function Pumpkins.Stop()
	tagsThisMatch = nil
	running = false
	for _, pumpkin in active do
		pumpkin.Model:Destroy()
	end
	table.clear(active)
	if folder then
		folder:Destroy()
		folder = nil
	end
end

return Pumpkins
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="113">
          <Properties>
            <string name="Name">QAServer</string>
            <string name="Source"><![CDATA[-- Modo QA (Fase 8): comandos de prueba para Roblox Studio. Solo existe si Shared/QA dice que está activo
-- (GameConfig.QA.Enabled Y RunService:IsStudio()). Fuera de eso Init no hace nada: no se crea el
-- RemoteEvent y no hay forma de mandar comandos. Además, cada comando vuelve a comprobarlo.
--
-- Comandos (cliente -> servidor, por el RemoteEvent QA.RemoteName):
--   NextMatch { Map, Mode, Now }   siguiente partida en ese mapa y modo (Now = acabar el descanso ya)
--   StartNow                       acabar el descanso ya (con lo votado)
--   EndMatch { Winner = 1|2|nil }  terminar la partida (gana el equipo A, el B, o como vaya)
--   Respawn                        reaparecer
--   Bots { Delta = n | Set = n }   más o menos bots (total de jugadores + bots, de 0 a 16)
--   Weapon { Id }                  equipar esa arma principal (con la secundaria y el cuchillo de siempre)
--   Ammo                           cargadores y reserva llenos
--   HitTelemetry { On }            medir los impactos (GameConfig.HitTelemetry) y mandar cada muestra
--   BotRoutes { On }               dibujar la ruta de cada bot (piezas sin colisión, se ven en Studio)
--   Snapshot                       contadores del servidor (para la prueba de 5 partidas)
-- Respuestas (servidor -> cliente, el mismo RemoteEvent): ("Ack", texto), ("Hit", muestra),
-- ("Snapshot", tabla), ("Error", texto).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Weapons = require(Shared.Weapons)
local QA = require(Shared.QA)

local Modules = script.Parent
local Round = require(Modules.Round)
local Bots = require(Modules.Bots)
local Combat = require(Modules.Combat)
local Loadout = require(Modules.Loadout)
local Respawn = require(Modules.Respawn)
local PlayerData = require(Modules.PlayerData)
local MapBuilder = require(Modules.MapBuilder)

local QAServer = {}

local MAX_FILL = 16
local remote = nil
local routesOn = false
local snapshots = 0

local function reply(player, kind, payload)
	if remote then
		remote:FireClient(player, kind, payload)
	end
end

local function totalBots()
	local folder = workspace:FindFirstChild("Bots")
	return folder and #folder:GetChildren() or 0
end

-- Rutas de los bots: una bolita por punto del camino que siguen (se rehace cada segundo)
local function drawRoutes()
	local folder = workspace:FindFirstChild("QABotRoutes")
	if folder then
		folder:Destroy()
	end
	if not routesOn then
		return
	end
	folder = Instance.new("Folder")
	folder.Name = "QABotRoutes"
	for _, agent in Bots.Agents do
		local waypoints = agent.Waypoints
		if type(waypoints) == "table" then
			for i, waypoint in waypoints do
				if i > 40 then
					break
				end
				local dot = Instance.new("Part")
				dot.Name = "QARoute"
				dot.Shape = Enum.PartType.Ball
				dot.Size = Vector3.new(0.6, 0.6, 0.6)
				dot.Anchored = true
				dot.CanCollide = false
				dot.CanQuery = false
				dot.CanTouch = false
				dot.Material = Enum.Material.Neon
				dot.Color = (i >= (agent.WaypointIndex or 1)) and Color3.fromRGB(80, 220, 255) or Color3.fromRGB(90, 90, 110)
				dot.Position = waypoint.Position + Vector3.new(0, 0.5, 0)
				dot.Parent = folder
			end
		end
	end
	folder.Parent = workspace
end

local function snapshot()
	snapshots += 1
	local maps = 0
	for _, child in workspace:GetChildren() do
		if child.Name == "Map" then
			maps += 1
		end
	end
	local memory = nil
	local okStats, stats = pcall(function()
		return game:GetService("Stats")
	end)
	if okStats and stats then
		local okMemory, value = pcall(function()
			return stats:GetTotalMemoryUsageMb()
		end)
		memory = okMemory and value or nil
	end
	return {
		N = snapshots,
		State = ReplicatedStorage:GetAttribute("State"),
		Map = ReplicatedStorage:GetAttribute("MapName"),
		Mode = ReplicatedStorage:GetAttribute("Mode"),
		Maps = maps,
		BotAgents = #Bots.Agents,
		BotModels = totalBots(),
		Players = #Players:GetPlayers(),
		WorkspaceInstances = #workspace:GetDescendants(),
		MemoryMb = memory,
	}
end

local COMMANDS = {}

function COMMANDS.NextMatch(player, args)
	local map, mode = args.Map, args.Mode
	if type(map) ~= "string" or not MapBuilder.Defs[map] then
		reply(player, "Error", "Mapa desconocido: " .. tostring(map))
		return
	end
	if not QA.IsMode(mode) then
		reply(player, "Error", "Modo desconocido: " .. tostring(mode))
		return
	end
	Round.QANext = { Map = map, Mode = mode }
	local now = args.Now == true and Round.QAStartNow()
	reply(player, "Ack", "Siguiente partida: " .. map .. " · " .. mode .. (now and " (empieza ya)" or " (al acabar la actual)"))
end

function COMMANDS.StartNow(player)
	reply(player, "Ack", Round.QAStartNow() and "El descanso termina ya" or "No hay descanso en curso")
end

function COMMANDS.EndMatch(player, args)
	local winner = args.Winner
	if winner ~= nil and winner ~= 1 and winner ~= 2 then
		reply(player, "Error", "Ganador no válido")
		return
	end
	local ok = Round.QAEnd(winner)
	reply(player, "Ack", ok and ("Partida terminada" .. (winner and (" · gana el equipo " .. (winner == 1 and "A" or "B")) or "")) or "No hay partida en juego")
end

function COMMANDS.Respawn(player)
	task.spawn(Respawn.Load, player)
	reply(player, "Ack", "Reapareciendo")
end

function COMMANDS.Bots(player, args)
	local current = Bots.QAFillTo or GameConfig.Bots.FillTo
	local target
	if args.Set ~= nil then
		target = tonumber(args.Set)
	else
		local delta = tonumber(args.Delta)
		target = delta and current + delta
	end
	if not target or target ~= target then
		reply(player, "Error", "Cantidad no válida")
		return
	end
	Bots.QAFillTo = math.clamp(math.floor(target), 0, MAX_FILL)
	reply(player, "Ack", string.format("Jugadores + bots: %d (ahora %d bots; tardan ~1 s en entrar o salir)", Bots.QAFillTo, totalBots()))
end

function COMMANDS.Weapon(player, args)
	local id = args.Id
	local def = type(id) == "string" and Weapons.Get(id)
	if not def or def.Type ~= "Gun" then
		reply(player, "Error", "Arma desconocida: " .. tostring(id))
		return
	end
	local list = Loadout.DefaultList(PlayerData.Get(player))
	list[1] = id
	Loadout.Give(player, list)
	reply(player, "Ack", "Equipada: " .. (def.DisplayName or id))
end

function COMMANDS.Ammo(player)
	local count = 0
	for _, container in { player:FindFirstChildOfClass("Backpack"), player.Character } do
		if container then
			for _, tool in container:GetChildren() do
				local def = tool:IsA("Tool") and Weapons.Get(tool:GetAttribute("Weapon") or "")
				if def and def.MagSize then
					tool:SetAttribute("Ammo", def.MagSize)
					tool:SetAttribute("Reserve", def.ReserveAmmo)
					count += 1
				end
			end
		end
	end
	reply(player, "Ack", "Munición llena (" .. count .. " armas)")
end

function COMMANDS.HitTelemetry(player, args)
	GameConfig.HitTelemetry.Enabled = args.On == true
	reply(player, "Ack", "Telemetría de impactos: " .. (GameConfig.HitTelemetry.Enabled and "ENCENDIDA" or "apagada"))
end

function COMMANDS.BotRoutes(player, args)
	routesOn = args.On == true
	drawRoutes()
	reply(player, "Ack", "Rutas de bots: " .. (routesOn and "visibles" or "ocultas"))
end

function COMMANDS.Snapshot(player)
	local data = snapshot()
	print(string.format(
		"[QA] Foto servidor #%d · estado %s · %s · %s · mapas en workspace %d · bots %d (modelos %d) · jugadores %d · instancias %d · memoria %s",
		data.N, tostring(data.State), tostring(data.Map), tostring(data.Mode), data.Maps, data.BotAgents, data.BotModels,
		data.Players, data.WorkspaceInstances, data.MemoryMb and string.format("%.0f MB", data.MemoryMb) or "no disponible"
	))
	reply(player, "Snapshot", data)
end

-- Ejecuta un comando (también lo usan las pruebas). Devuelve false si se rechaza.
function QAServer.Handle(player, command, args)
	-- (doble cerrojo: aunque el RemoteEvent existiera, fuera de Studio o con QA apagado no se hace nada)
	if not QA.IsActive() then
		warn("[QA] Comando rechazado (el modo QA no está activo):", tostring(command))
		return false
	end
	local handler = type(command) == "string" and COMMANDS[command]
	if not handler then
		return false
	end
	local ok, err = pcall(handler, player, type(args) == "table" and args or {})
	if not ok then
		warn("[QA] " .. command .. ":", err)
		reply(player, "Error", command .. ": " .. tostring(err))
	end
	return ok
end

function QAServer.Init()
	if not QA.IsActive() then
		return -- (producción: nada)
	end
	warn("[QA] MODO QA ACTIVO (solo Studio). Abre el panel con F8, \\ o el botón QA.")
	remote = Instance.new("RemoteEvent")
	remote.Name = QA.RemoteName
	remote.Parent = ReplicatedStorage
	remote.OnServerEvent:Connect(QAServer.Handle)
	-- Cada impacto medido, a quien disparó (con su latencia aproximada según Roblox)
	Combat.OnHitSample = function(sample)
		local player = sample.Player
		if typeof(player) ~= "Instance" or not player:IsA("Player") then
			return
		end
		local okPing, ping = pcall(function()
			return player:GetNetworkPing()
		end)
		reply(player, "Hit", {
			Weapon = sample.Weapon,
			Distance = sample.Distance,
			Slack = sample.Slack,
			ReportedHead = sample.ReportedHead,
			Headshot = sample.Headshot,
			Accepted = sample.Accepted,
			PingMs = okPing and type(ping) == "number" and ping * 1000 or nil,
		})
	end
	task.spawn(function()
		while true do
			task.wait(1)
			if routesOn then
				pcall(drawRoutes)
			end
		end
	end)
end

return QAServer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="114">
          <Properties>
            <string name="Name">Ragdoll</string>
            <string name="Source"><![CDATA[-- Muñeco de trapo al morir (como en los shooters): en vez de romperse en piezas, las articulaciones
-- pasan a ser rótulas sueltas con límites y el cuerpo cae de forma natural. Sirve para jugadores y
-- bots (R15). Prepare antes de morir (para que Roblox no rompa las uniones) y Apply al morir.
local Ragdoll = {}

-- Límites de giro de cada articulación (grados): cuello y cintura poco, hombros y caderas más
local LIMITS = {
	Neck = { 35, 20 },
	Waist = { 25, 15 },
	Root = { 20, 10 },
	LeftShoulder = { 80, 40 },
	RightShoulder = { 80, 40 },
	LeftElbow = { 70, 10 },
	RightElbow = { 70, 10 },
	LeftWrist = { 30, 10 },
	RightWrist = { 30, 10 },
	LeftHip = { 60, 25 },
	RightHip = { 60, 25 },
	LeftKnee = { 70, 8 },
	RightKnee = { 70, 8 },
	LeftAnkle = { 25, 8 },
	RightAnkle = { 25, 8 },
}

Ragdoll.SettleTime = 2.5

function Ragdoll.Prepare(humanoid)
	if humanoid and humanoid:IsA("Humanoid") then
		humanoid.BreakJointsOnDeath = false
	end
end

-- push (opcional): empujón inicial del cuerpo (p. ej. alejándose de una explosión)
function Ragdoll.Apply(character, push)
	if not character or character:GetAttribute("Ragdolled") then
		return false
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	-- Uniones del personaje: Motor6D en los de siempre; en los personajes con las uniones nuevas de
	-- Roblox son AnimationConstraint (entre dos Attachment), y casi todas traen ya su rótula
	-- (BallSocketConstraint) preparada para cuando se apagan
	local motors = {}
	local sockets = {} -- [Attachment] = rótula que ya trae el personaje
	for _, d in character:GetDescendants() do
		if d:IsA("Motor6D") and d.Part0 and d.Part1 then
			table.insert(motors, { Joint = d, Part0 = d.Part0, Part1 = d.Part1, C0 = d.C0, C1 = d.C1 })
		elseif d:IsA("AnimationConstraint") and d.Attachment0 and d.Attachment1 then
			local part0, part1 = d.Attachment0.Parent, d.Attachment1.Parent
			if part0 and part1 and part0:IsA("BasePart") and part1:IsA("BasePart") then
				table.insert(motors, {
					Joint = d, Part0 = part0, Part1 = part1,
					C0 = d.Attachment0.CFrame, C1 = d.Attachment1.CFrame, Attachment0 = d.Attachment0,
				})
			end
		elseif d:IsA("BallSocketConstraint") then
			if d.Attachment0 then
				sockets[d.Attachment0] = d
			end
			if d.Attachment1 then
				sockets[d.Attachment1] = d
			end
		end
	end
	if #motors == 0 then
		return false
	end
	character:SetAttribute("Ragdolled", true)
	-- (el cuerpo de un jugador lo mueve su propio cliente: el servidor se lo queda para que el
	-- empujón y la caída se vean igual para todos)
	for _, part in character:GetDescendants() do
		if part:IsA("BasePart") and not part.Anchored then
			pcall(part.SetNetworkOwner, part, nil)
		end
	end
	-- El eje X de la rótula va a lo largo del hueso (en R15 los miembros van en Y): así UpperAngle
	-- limita cuánto se dobla y los límites de giro, cuánto rota sobre sí mismo
	local alongBone = CFrame.Angles(0, 0, math.pi / 2)
	for _, motor in motors do
		local own = motor.Attachment0 and sockets[motor.Attachment0]
		if own then
			-- (unión nueva con su rótula ya puesta: basta con apagar la unión)
			local apart = Instance.new("NoCollisionConstraint")
			apart.Part0 = motor.Part0
			apart.Part1 = motor.Part1
			apart.Parent = motor.Part1
			own.Enabled = true
			motor.Joint.Enabled = false
			continue
		end
		local a0 = Instance.new("Attachment")
		a0.Name = "RagdollA0"
		a0.CFrame = motor.C0 * alongBone
		a0.Parent = motor.Part0
		local a1 = Instance.new("Attachment")
		a1.Name = "RagdollA1"
		a1.CFrame = motor.C1 * alongBone
		a1.Parent = motor.Part1
		-- Las piezas unidas se solapan en la articulación: que no choquen entre sí (temblarían)
		local noCollide = Instance.new("NoCollisionConstraint")
		noCollide.Part0 = motor.Part0
		noCollide.Part1 = motor.Part1
		noCollide.Parent = motor.Part1
		local socket = Instance.new("BallSocketConstraint")
		socket.Name = "RagdollSocket"
		socket.Attachment0 = a0
		socket.Attachment1 = a1
		local limit = LIMITS[motor.Joint.Name] or { 45, 15 }
		socket.LimitsEnabled = true
		socket.UpperAngle = limit[1]
		socket.TwistLimitsEnabled = true
		socket.TwistLowerAngle = -limit[2]
		socket.TwistUpperAngle = limit[2]
		socket.Parent = motor.Part1
		motor.Joint.Enabled = false
	end
	-- Las piezas del cuerpo chocan con el suelo (si no, atravesarían el suelo); la raíz no
	for _, part in character:GetChildren() do
		if part:IsA("BasePart") then
			part.CanCollide = part ~= root
			if part == root then
				part.Massless = true
			end
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.PlatformStand = true
		humanoid.AutoRotate = false
	end
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if torso and torso:IsA("BasePart") and typeof(push) == "Vector3" then
		torso.AssemblyLinearVelocity += push
	end
	-- Cuando ya ha caído, se queda quieto y sin colisión: no estorba en puertas ni escaleras (en
	-- Eliminación y Buscar y destruir el cuerpo dura toda la ronda) y no gasta física
	task.delay(Ragdoll.SettleTime, function()
		if not character.Parent then
			return
		end
		for _, part in character:GetDescendants() do
			if part:IsA("BasePart") then
				part.Anchored = true
				part.CanCollide = false
			end
		end
	end)
	return true
end

return Ragdoll
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="115">
          <Properties>
            <string name="Name">Respawn</string>
            <string name="Source"><![CDATA[-- Reaparición controlada por el juego (Players.CharacterAutoLoads = false en default.project.json):
--   * Al morir se reaparece solo tras GameConfig.RespawnTime segundos
--   * "Regenerar ahora": a partir de GameConfig.RespawnNowDelay se puede reaparecer antes
--   * "Revivir instantáneo": gasta un revivir (data.Revives) y vuelve justo donde moriste
-- Round llama a Respawn.ApplyRevive al aparecer el personaje para colocarlo en ese punto.
-- En plena ronda de Eliminación (atributo NoRespawn) no hay reaparición: se espera a la siguiente ronda.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)

local PlayerData = require(script.Parent.PlayerData)

local Respawn = {}

local deaths = {} -- [player] = { Time = os.clock(), Position = Vector3?, Character = Model }
local revivePoints = {} -- [player] = Vector3 donde debe aparecer tras revivir
local loading = {} -- [player] = true mientras se carga un personaje (evita cargas dobles)

local function noRespawn()
	return ReplicatedStorage:GetAttribute("NoRespawn") == true
end

local function isDead(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return character == nil or humanoid == nil or humanoid.Health <= 0
end

local function load(player)
	if loading[player] or not player.Parent then
		return
	end
	loading[player] = true
	local ok, err = pcall(player.LoadCharacter, player)
	loading[player] = nil
	if ok then
		deaths[player] = nil
	else
		-- Sin CharacterAutoLoads nadie más lo reintentaría: se queda muerto. Reintento en un segundo.
		-- (deaths se conserva para que "Regenerar ahora" siga funcionando mientras tanto)
		warn("[Respawn] No se pudo cargar el personaje:", err)
		revivePoints[player] = nil
		task.delay(1, function()
			if player.Parent and isDead(player) then
				load(player)
			end
		end)
	end
end
Respawn.Load = load

-- ¿Se está cargando su personaje ahora mismo? (Eliminación lo cuenta como vivo)
function Respawn.IsLoading(player)
	return loading[player] == true
end

local function watch(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end
	humanoid.Died:Connect(function()
		local root = character:FindFirstChild("HumanoidRootPart")
		deaths[player] = { Time = os.clock(), Position = root and root.Position, Character = character }
		task.delay(GameConfig.RespawnTime, function()
			-- Solo si sigue con el mismo personaje muerto (no ha usado "Regenerar" ni "Revivir")
			if player.Parent and player.Character == character and not noRespawn() then
				load(player)
			end
		end)
	end)
end

-- Llamada por Round al aparecer: si el jugador acaba de revivir, lo pone donde murió.
-- Devuelve true si lo ha colocado (y entonces no se usa el punto de aparición normal).
function Respawn.ApplyRevive(player, character)
	local point = revivePoints[player]
	if not point then
		return false
	end
	revivePoints[player] = nil
	local root = character:WaitForChild("HumanoidRootPart", 5)
	if not root then
		return false
	end
	task.wait()
	character:PivotTo(CFrame.new(point + Vector3.new(0, 3, 0)) * (root.CFrame - root.Position))
	-- Protección breve al revivir (se pierde al disparar, como la de reaparición)
	local shield = Instance.new("ForceField")
	shield.Name = "SpawnShield"
	shield.Visible = true
	shield.Parent = character
	task.delay(GameConfig.ReviveShieldTime, function()
		if shield.Parent then
			shield:Destroy()
		end
	end)
	return true
end

-- Comprueba si se puede revivir ahora mismo; devuelve el punto o nil y el motivo
local function reviveCheck(player)
	local death = deaths[player]
	if not death or not isDead(player) then
		return nil, "Solo al morir"
	end
	if os.clock() - death.Time > GameConfig.RespawnTime + 0.5 then
		return nil, "Demasiado tarde"
	end
	if ReplicatedStorage:GetAttribute("State") ~= "Playing" then
		return nil, "La ronda no está en juego"
	end
	if noRespawn() then
		return nil, "Una sola vida por ronda"
	end
	-- Infección: un superviviente que cae ya es zombi (no vuelve como humano)
	if ReplicatedStorage:GetAttribute("Infection") == "On" and player.Team and player.Team.Name == ReplicatedStorage:GetAttribute("TeamA") then
		return nil, "¡Te han infectado!"
	end
	if ReplicatedStorage:GetAttribute("Frozen") or loading[player] then
		return nil, "Ya estás reapareciendo"
	end
	local point = death.Position
	if not point or point.Y < -20 then
		return nil, "No se puede revivir aquí"
	end
	-- Tiene que haber suelo debajo (no en el aire sobre un hueco) y no puede ser lava
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(point + Vector3.new(0, 2, 0), Vector3.new(0, -14, 0), params)
	if not hit then
		return nil, "No hay suelo aquí"
	end
	if hit.Instance:GetAttribute("Hazard") or hit.Material == Enum.Material.CrackedLava then
		return nil, "No se puede revivir en la lava"
	end
	return hit.Position
end

function Respawn.Init()
	Players.CharacterAutoLoads = false -- también en default.project.json; aquí por si se usa otro lugar
	Remotes.RespawnNow.OnServerEvent:Connect(function(player)
		local death = deaths[player]
		if death and isDead(player) and os.clock() - death.Time >= GameConfig.RespawnNowDelay and not noRespawn() then
			load(player)
		end
	end)

	Remotes.InstantRevive.OnServerInvoke = function(player)
		local point, reason = reviveCheck(player)
		if not point then
			return false, reason
		end
		if not PlayerData.UseRevive(player) then
			return false, "Sin revivir"
		end
		revivePoints[player] = point
		-- (al revivir no se puede coger enseguida la bandera ni las calabazas de donde caíste)
		player:SetAttribute("RevivedAt", os.clock())
		task.spawn(load, player)
		return true
	end

	local function onPlayer(player)
		player.CharacterAdded:Connect(function(character)
			task.spawn(watch, player, character)
		end)
		if player.Character then
			task.spawn(watch, player, player.Character)
		else
			-- Primera aparición (CharacterAutoLoads está desactivado)
			task.defer(load, player)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		deaths[player] = nil
		revivePoints[player] = nil
		loading[player] = nil
	end)
end

return Respawn
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="116">
          <Properties>
            <string name="Name">ResultsCast</string>
            <string name="Source"><![CDATA[-- Reparto de la pantalla final: al acabar la partida, una copia visual de cada participante (jugadores
-- y bots) en ReplicatedStorage.ResultsCast, para que los clientes monten la escena de resultados con
-- los avatares reales (traje incluido). Se hace JUSTO antes de pasar a "Ended": después los bots se
-- quitan. Las copias no tienen scripts, sonidos ni herramientas (el arma la pone el cliente) y nunca
-- están en el mundo: solo sirven de plantilla. Quien está muerto o sin personaje sale de su
-- HumanoidDescription con su traje. Se borra todo al empezar la siguiente partida.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Outfits = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Outfits"))

local ResultsCast = {}

local folder

local function getFolder()
	if not folder or not folder.Parent then
		folder = Instance.new("Folder")
		folder.Name = "ResultsCast"
		folder.Parent = ReplicatedStorage
	end
	return folder
end

-- Deja solo lo visual: piezas, uniones, ropa, accesorios y caras
local function sanitize(model)
	for _, d in model:GetDescendants() do
		if d:IsA("BaseScript") or d:IsA("ModuleScript") or d:IsA("Sound") or d:IsA("BillboardGui")
			or d:IsA("SurfaceGui") or d:IsA("ForceField") or d:IsA("Tool") or d:IsA("Highlight")
			or d:IsA("BodyMover") or d:IsA("Constraint") and not d:IsA("WeldConstraint") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
			d.Anchored = false
		end
	end
	-- (el muñeco de trapo cambia los Motor6D por rótulas: si faltan uniones, mejor no usarlo)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
end

local function usable(model)
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	local root = model and model:FindFirstChild("HumanoidRootPart")
	local torso = model and model:FindFirstChild("UpperTorso")
	local waist = torso and torso:FindFirstChild("Waist")
	return humanoid ~= nil and root ~= nil and humanoid.Health > 0 and waist ~= nil and (waist:IsA("Motor6D") or waist:IsA("AnimationConstraint"))
end

local function copy(model)
	local archivable = model.Archivable
	model.Archivable = true
	local ok, clone = pcall(function()
		return model:Clone()
	end)
	model.Archivable = archivable
	if not ok or not clone then
		return nil
	end
	sanitize(clone)
	return clone
end

local function store(id, clone)
	if not clone then
		return
	end
	clone.Name = id
	clone:SetAttribute("CastId", id)
	local old = getFolder():FindFirstChild(id)
	if old then
		old:Destroy()
	end
	clone.Parent = getFolder()
end

-- Avatar de Roblox desde su descripción (para quien estaba muerto al acabar), con su traje
local function fromDescription(id, userId, outfitId)
	task.spawn(function()
		local ok, model = pcall(function()
			local description = Players:GetHumanoidDescriptionFromUserId(userId)
			return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
		end)
		if not ok or not model then
			return
		end
		if outfitId and outfitId ~= "Default" then
			pcall(Outfits.Apply, model, outfitId)
		end
		sanitize(model)
		if folder and folder.Parent then
			store(id, model)
		end
	end)
end

-- entries = { { Id, Model = personaje (puede ser nil), UserId?, Outfit? } }
function ResultsCast.Capture(entries)
	ResultsCast.Clear()
	getFolder()
	for _, entry in entries do
		if usable(entry.Model) then
			store(entry.Id, copy(entry.Model))
		elseif entry.UserId and entry.UserId > 0 then
			fromDescription(entry.Id, entry.UserId, entry.Outfit)
		end
	end
end

function ResultsCast.Clear()
	if folder then
		folder:ClearAllChildren()
	end
end

return ResultsCast
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="117">
          <Properties>
            <string name="Name">Round</string>
            <string name="Source"><![CDATA[-- Rondas, modos de juego, votación de mapa/modo, equipos, marcador, rachas y recompensas.
-- Modos: TDM (duelo por equipos), CTF (captura la bandera), KOTH (zona de control),
--        FFA (todos contra todos), GUN (escalada de armas) y ELIM (eliminación: rondas de una vida).
--
-- Estado publicado en ReplicatedStorage para la interfaz:
--   State ("Intermission" | "Playing" | "Ended"), Mode, ModeName, TeamMode, TimeLeft, ScoreToWin,
--   Score_<Equipo>, LeaderName, LeaderScore, MapName,
--   NoRespawn (true en plena ronda de Eliminación), AliveA / AliveB (vivos de cada equipo en Eliminación),
--   VoteN_Map, VoteN_Mode, VoteN_Count (N = 1..3) durante el descanso
-- En cada jugador: atributo Score (bajas en FFA / nivel en Escalada), Streak, Captures, GunLevel
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.GameConfig)
local Weapons = require(Shared.Weapons)
local Remotes = require(Shared.Remotes)
local Ranks = require(Shared.Ranks)

local PlayerData = require(script.Parent.PlayerData)
local Flags = require(script.Parent.Flags)
local Hardpoint = require(script.Parent.Hardpoint)
local Domination = require(script.Parent.Domination)
local Bomb = require(script.Parent.Bomb)
local MapBuilder = require(script.Parent.MapBuilder)
local Loadout = require(script.Parent.Loadout)
local Killstreaks = require(script.Parent.Killstreaks)
local Grenades = require(script.Parent.Grenades)
local Respawn = require(script.Parent.Respawn)
local Bots = require(script.Parent.Bots)
local SpawnPicker = require(script.Parent.SpawnPicker)
local Zombie = require(script.Parent.Zombie)
local Bounty = require(script.Parent.Bounty)
local Pumpkins = require(script.Parent.Pumpkins)
local Loot = require(script.Parent.Loot)
local Combat = require(script.Parent.Combat)
local Friends = require(script.Parent.Friends)
local ResultsCast = require(script.Parent.ResultsCast)
local MatchResults = require(Shared.MatchResults)

local Round = {}

local teams = {}
local roundOver = false
local currentMode = "TDM"
local votes = {} -- [player] = índice
local voteOptions = {}
-- Modo QA (Fase 8, solo Studio; lo usa QAServer): mapa y modo de la siguiente partida y empezar ya.
-- Sin el modo QA nadie los toca y la ronda va como siempre.
Round.QANext = nil -- { Map = id del mapa, Mode = "TDM"... }
local qaStartNow = false

local onInfectionDeath -- (Infección: quien cae ante los zombis se convierte; ver más abajo)

-- ¿Ha ganado la partida este jugador? En Infección, si ganan los zombis solo cuentan como ganadores
-- los que ya eran zombis al empezar (los supervivientes convertidos han perdido)
local function wonTeam(player, winner)
	if winner == nil or player.Team ~= winner then
		return false
	end
	if currentMode == "INF" and winner == teams[2] then
		return player:GetAttribute("InfZombieStart") == true
	end
	return true
end

-- Rivales distintos eliminados en la racha actual (para SE BUSCA: matar al mismo amigo varias veces
-- no cuenta como "racha contra jugadores")
local streakVictims = {} -- [player] = { [UserId] = true }
local firstBlood = false -- ya hubo la primera baja de la partida (medalla Primera sangre)
local lastKill = nil -- { Killer, Victim, Weapon, Time }: la última baja (para la killcam final)
local aceRound = nil -- ronda de Eliminación en juego: { Kills = { [nombre] = n }, Members = { [equipo] = n }, Done }
local maxDeficit = {} -- [equipo] = la mayor desventaja que llegó a tener en la partida (para la remontada)
local decidingKill = nil -- la baja que cerró la partida (desde ahí todo queda congelado hasta su repetición)
local lastRoundHow = nil -- cómo acabó la última ronda de Eliminación / Buscar y destruir (motivo de la pantalla final)

local STREAK_ANNOUNCE = { [3] = true, [5] = true, [7] = true, [10] = true, [15] = true, [20] = true }

local function setState(state)
	ReplicatedStorage:SetAttribute("State", state)
	if state ~= "Playing" then
		-- (por si una partida se corta en pleno despliegue)
		ReplicatedStorage:SetAttribute("Deploy", nil)
		ReplicatedStorage:SetAttribute("CountdownAt", nil)
		ReplicatedStorage:SetAttribute("DeployEndsAt", nil)
	end
end

local function settings(mode)
	return GameConfig.ModeSettings[mode or currentMode]
end

-- Nombre del modo para la interfaz (Calabazas es "Baja confirmada" fuera de Halloween)
local function modeName(mode)
	if mode == "CAL" and Pumpkins.Tags() then
		return "Baja confirmada"
	end
	return GameConfig.ModeSettings[mode].Name
end

local function isTeamMode(mode)
	return settings(mode).Teams ~= false
end

local function getScore(teamName)
	return ReplicatedStorage:GetAttribute("Score_" .. teamName) or 0
end

local function setupTeams()
	for _, cfg in GameConfig.Teams do
		local team = Teams:FindFirstChild(cfg.Name)
		if not team then
			team = Instance.new("Team")
			team.Name = cfg.Name
			team.TeamColor = cfg.Color
			team.AutoAssignable = false
			team.Parent = Teams
		end
		table.insert(teams, team)
		ReplicatedStorage:SetAttribute("Score_" .. cfg.Name, 0)
	end
	ReplicatedStorage:SetAttribute("TeamA", teams[1].Name)
	ReplicatedStorage:SetAttribute("TeamB", teams[2].Name)
end

local function addScore(team, amount)
	if ReplicatedStorage:GetAttribute("State") ~= "Playing" or not team then
		return
	end
	local score = getScore(team.Name) + amount
	ReplicatedStorage:SetAttribute("Score_" .. team.Name, score)
	-- (cuánto iba perdiendo cada equipo como mucho: si gana después, es una remontada)
	for _, other in teams do
		if other ~= team then
			local behind = score - getScore(other.Name)
			maxDeficit[other.Name] = math.max(maxDeficit[other.Name] or 0, behind)
		end
	end
	if score >= (ReplicatedStorage:GetAttribute("ScoreToWin") or math.huge) then
		roundOver = true
	end
end

-- Líder individual (modos sin equipos). Puede ser un bot (tabla de Bots, con Name y Score).
local function updateLeader(leaving)
	local best, bestScore = nil, -1
	for _, player in Players:GetPlayers() do
		local score = player:GetAttribute("Score") or 0
		if player ~= leaving and score > bestScore then
			best, bestScore = player, score
		end
	end
	for _, agent in Bots.Agents do
		if (agent.Score or 0) > bestScore then
			best, bestScore = agent, agent.Score or 0
		end
	end
	ReplicatedStorage:SetAttribute("LeaderName", best and best.Name or "")
	ReplicatedStorage:SetAttribute("LeaderScore", math.max(bestScore, 0))
	return best, bestScore
end

local function addPlayerScore(player, amount)
	local score = (player:GetAttribute("Score") or 0) + amount
	player:SetAttribute("Score", score)
	updateLeader()
	if ReplicatedStorage:GetAttribute("State") == "Playing" and score >= (ReplicatedStorage:GetAttribute("ScoreToWin") or math.huge) then
		roundOver = true
	end
end

---------------------------------------------------------------------------
-- Equipos
---------------------------------------------------------------------------

-- Amigos de Roblox de player que hay en ese equipo
local function friendsIn(team, player)
	local count = 0
	for _, p in team:GetPlayers() do
		if p ~= player and Friends.AreFriends(player, p) then
			count += 1
		end
	end
	return count
end

-- El equipo con menos jugadores (sin contar a exclude). Si empatan, el que tiene amigos suyos
-- (los amigos juegan juntos) y si no, al azar.
local function smallestTeam(exclude)
	local best, bestCount, bestFriends = nil, math.huge, -1
	for _, team in teams do
		local count = 0
		for _, p in team:GetPlayers() do
			if p ~= exclude then
				count += 1
			end
		end
		local friends = exclude and friendsIn(team, exclude) or 0
		if count < bestCount or (count == bestCount and (friends > bestFriends or (friends == bestFriends and math.random() < 0.5))) then
			best, bestCount, bestFriends = team, count, friends
		end
	end
	return best
end

local function assignTeam(player)
	-- Infección: quien entra antes de la infección es superviviente; después, zombi
	local infection = ReplicatedStorage:GetAttribute("Infection")
	if infection then
		player.Neutral = false
		player.Team = infection == "On" and teams[2] or teams[1]
		if infection == "On" then
			player:SetAttribute("InfZombieStart", true)
		end
		return
	end
	if isTeamMode() then
		player.Neutral = false
		player.Team = smallestTeam(player)
	else
		player.Team = nil
		player.Neutral = true
	end
end

local function balanceTeams()
	-- Infección: todos empiezan como supervivientes
	if ReplicatedStorage:GetAttribute("Infection") then
		for _, player in Players:GetPlayers() do
			player.Neutral = false
			player.Team = teams[1]
		end
		return
	end
	if not isTeamMode() then
		for _, player in Players:GetPlayers() do
			player.Team = nil
			player.Neutral = true
		end
		return
	end
	for _, player in Players:GetPlayers() do
		if not player.Team then
			player.Neutral = false
			player.Team = smallestTeam(player)
		end
	end
	local a, b = teams[1], teams[2]
	-- Amigos separados: se intercambian con alguien del otro equipo que no tenga amigos allí (los
	-- tamaños no cambian)
	for _, p in Players:GetPlayers() do
		local mine = p.Team
		local other = mine == a and b or (mine == b and a or nil)
		if other and friendsIn(mine, p) == 0 and friendsIn(other, p) > 0 then
			for _, q in other:GetPlayers() do
				if not Friends.AreFriends(q, p) and friendsIn(other, q) == 0 then
					p.Team, q.Team = other, mine
					break
				end
			end
		end
	end
	while math.abs(#a:GetPlayers() - #b:GetPlayers()) > 1 do
		local big = #a:GetPlayers() > #b:GetPlayers() and a or b
		local small = big == a and b or a
		-- (se cambia preferiblemente a quien tiene menos amigos en su equipo)
		local list = big:GetPlayers()
		local pick, pickFriends = nil, math.huge
		for _, p in list do
			local friends = friendsIn(big, p) - friendsIn(small, p) + math.random() * 0.5
			if friends < pickFriends then
				pick, pickFriends = p, friends
			end
		end
		pick.Team = small
	end
end

local function resetStats()
	for _, player in Players:GetPlayers() do
		local stats = PlayerData.GetLeaderstats(player)
		stats.Bajas.Value = 0
		stats.Muertes.Value = 0
		player:SetAttribute("Streak", 0)
		player:SetAttribute("StreakPlayers", 0)
		streakVictims[player] = nil
		player:SetAttribute("BestStreak", 0)
		Bounty.Reset(player)
		player:SetAttribute("Captures", 0)
		player:SetAttribute("Score", 0)
		player:SetAttribute("GunLevel", 1)
		-- Participación para el rango: desde cuándo juega esta partida (Loadout lo pone al salir del menú)
		player:SetAttribute("MatchJoinedAt", if player:GetAttribute("InMenu") then nil else workspace:GetServerTimeNow())
		player:SetAttribute("ElimPlayed", nil)
		player:SetAttribute("InfZombieStart", nil)
		player:SetAttribute("LastKiller", nil)
		player:SetAttribute("MatchAssists", 0)
		PlayerData.StartMatch(player)
	end
	Killstreaks.Reset()
	Grenades.Reset()
	firstBlood = false
	lastKill = nil
	decidingKill = nil
	aceRound = nil
	table.clear(maxDeficit)
	lastRoundHow = nil
	ResultsCast.Clear()
	for _, team in teams do
		ReplicatedStorage:SetAttribute("Score_" .. team.Name, 0)
	end
	updateLeader()
end

---------------------------------------------------------------------------
-- Escalada de armas
---------------------------------------------------------------------------

local function gunGameWeapons(player)
	local order = Weapons.GunGameOrder
	local level = math.clamp(player:GetAttribute("GunLevel") or 1, 1, #order)
	local weapon = order[level]
	if weapon == Weapons.Melee then
		return { weapon }
	end
	return { weapon, Weapons.Melee }
end

local function gunGameKill(killer, victim, weaponName)
	local order = Weapons.GunGameOrder
	local level = (killer:GetAttribute("GunLevel") or 1) + 1
	killer:SetAttribute("GunLevel", level)
	killer:SetAttribute("Score", level - 1)
	updateLeader()
	if level > #order then
		roundOver = true
		return
	end
	Remotes.Notify:FireClient(killer, "Info", "Nueva arma: " .. Weapons.Get(order[level]).DisplayName)
	Loadout.Give(killer, gunGameWeapons(killer))
	-- Humillación: una baja con cuchillo hace bajar un nivel a la víctima
	if victim and weaponName == Weapons.Melee then
		local vLevel = math.max(1, (victim:GetAttribute("GunLevel") or 1) - 1)
		victim:SetAttribute("GunLevel", vLevel)
		victim:SetAttribute("Score", vLevel - 1)
		Remotes.Notify:FireClient(victim, "Info", "¡Te han bajado de nivel con el cuchillo!")
	end
end

---------------------------------------------------------------------------
-- Bajas
---------------------------------------------------------------------------

-- killerBot / victimBot: el bot (ver Bots) cuando quien hace la baja o quien muere es un bot
-- Medalla de baja: aviso y XP (scale: menos contra bots)
local function medal(player, id, scale)
	local def = GameConfig.Medals and GameConfig.Medals[id]
	if def then
		Remotes.Notify:FireClient(player, "Medal", def.Text)
		PlayerData.AddXP(player, math.max(1, math.floor(def.XP * scale)), def.Name)
	end
end

-- Medallas que gana un jugador con esta baja
local function awardMedals(killer, victimName, victimStreak, weaponName, position, scale)
	local medals = GameConfig.Medals or {}
	if not firstBlood then
		firstBlood = true
		medal(killer, "FirstBlood", scale)
	end
	-- (no en un intercambio: si los dos caen a la vez no es venganza)
	if victimName and killer:GetAttribute("LastKiller") == victimName and os.clock() - (killer:GetAttribute("LastKilledAt") or 0) >= 1 then
		killer:SetAttribute("LastKiller", nil)
		medal(killer, "Revenge", scale)
	end
	if medals.StreakEnder and victimStreak >= medals.StreakEnder.Streak then
		medal(killer, "StreakEnder", scale)
	end
	local character = killer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 then
		medal(killer, "Afterlife", scale)
	elseif root and typeof(position) == "Vector3" and medals.LongShot then
		local weapon = weaponName and Weapons.Get(weaponName)
		if weapon and not weapon.Explosive and weapon.Type ~= "Melee" and (root.Position - position).Magnitude >= medals.LongShot.Distance then
			medal(killer, "LongShot", scale)
		end
	end
end

function Round.RegisterKill(killer, victim, victimName, weaponName, headshot, position, killerBot, victimBot)
	local wasOver = roundOver
	local bounty = 0
	-- (la racha que llevaba el caído, antes de ponerla a 0: para la medalla Cazarrachas)
	local victimStreak = (victim and victim:GetAttribute("Streak")) or (victimBot and victimBot.Streak) or 0
	-- Para la medalla Venganza: quién eliminó a este jugador la última vez
	if victim then
		local by = (killer and killer ~= victim and killer.Name) or (killerBot and killerBot.Name) or nil
		victim:SetAttribute("LastKiller", by)
		victim:SetAttribute("LastKilledAt", os.clock())
	end
	if victim then
		PlayerData.GetLeaderstats(victim).Muertes.Value += 1
		PlayerData.Increment(victim, "TotalDeaths", 1)
		bounty = Bounty.Clear(victim)
		-- (si casi toda la racha fue contra bots, la recompensa vale menos: no se puede inflar
		-- matando bots para que un amigo la cobre)
		if bounty > 0 and (victim:GetAttribute("StreakPlayers") or 0) < 3 then
			bounty = math.max(1, math.floor(bounty * GameConfig.Bots.RewardScale))
		end
		victim:SetAttribute("Streak", 0)
		victim:SetAttribute("StreakPlayers", 0)
		streakVictims[victim] = nil
	end
	local playing = ReplicatedStorage:GetAttribute("State") == "Playing"

	local killerColor, victimColor = Color3.new(1, 1, 1), Color3.new(1, 1, 1)
	if victim and victim.Team then
		victimColor = victim.TeamColor.Color
	elseif victimBot and victimBot.Team then
		victimColor = victimBot.Team.TeamColor.Color
	end

	if victimBot then
		Bots.AddStat(victimBot, "Deaths", 1)
		victimBot.Streak = 0
	end
	-- Racha del bot (sin morir): con 3 bajas su equipo tiene radar (no los zombis)
	if killerBot and killerBot ~= victimBot and playing and not killerBot.Zombie then
		killerBot.Streak = (killerBot.Streak or 0) + 1
		if Killstreaks.OnBotStreak(killerBot.Name, killerBot.Team, killerBot.Streak) then
			Bots.Radar(Bots.RadarKey(killerBot), Killstreaks.RadarTime)
		end
	end
	-- Un bot hace una baja: punto para su equipo (en equipos) o para él (todos contra todos)
	if killerBot then
		Bots.AddStat(killerBot, "Kills", 1)
		if playing then
			firstBlood = true -- (la primera sangre de un bot cuenta: ya no la gana nadie más)
		end
		if killerBot.Team then
			killerColor = killerBot.Team.TeamColor.Color
			if playing and currentMode == "TDM" then
				addScore(killerBot.Team, 1)
			end
		elseif playing and currentMode == "FFA" then
			killerBot.Score = (killerBot.Score or 0) + 1
			Bots.AddStat(killerBot, "Score", 1)
			updateLeader()
			if killerBot.Score >= (ReplicatedStorage:GetAttribute("ScoreToWin") or math.huge) then
				roundOver = true
			end
		end
	end

	if killer and killer ~= victim then
		if killer.Team then
			killerColor = killer.TeamColor.Color
		end
		if victim or victimBot then
			-- Contra bots: misma emoción (marcador, racha, retos, maestría) pero menos XP y monedas,
			-- y no cuentan para la clasificación global
			local botScale = victimBot and GameConfig.Bots.RewardScale or 1
			PlayerData.GetLeaderstats(killer).Bajas.Value += 1
			local streak = (killer:GetAttribute("Streak") or 0) + 1
			killer:SetAttribute("Streak", streak)
			if victim then
				local seen = streakVictims[killer] or {}
				streakVictims[killer] = seen
				if not seen[victim.UserId] then
					seen[victim.UserId] = true
					killer:SetAttribute("StreakPlayers", (killer:GetAttribute("StreakPlayers") or 0) + 1)
				end
			end
			if streak > (killer:GetAttribute("BestStreak") or 0) then
				killer:SetAttribute("BestStreak", streak)
			end

			if playing then
				if currentMode == "TDM" then
					addScore(killer.Team, 1)
				elseif currentMode == "FFA" then
					addPlayerScore(killer, 1)
				elseif currentMode == "GUN" then
					-- (también cuentan las bajas a bots: así se puede jugar solo)
					gunGameKill(killer, victim, weaponName)
				end
			end

			local xp = GameConfig.XP.Kill + GameConfig.XP.StreakBonus * (streak - 1)
			if headshot then
				xp += GameConfig.XP.Headshot
			end
			PlayerData.AddXP(killer, math.floor(xp * botScale), headshot and "Disparo a la cabeza" or "Eliminación")
			if playing then
				awardMedals(killer, victimName, victimStreak, weaponName, position, botScale)
			end
			PlayerData.AddCoins(killer, math.max(1, math.floor(GameConfig.Coins.Kill * botScale)))
			if victim then
				PlayerData.Increment(killer, "TotalKills", 1)
			end
			PlayerData.AddWeaponKill(killer, weaponName)
			PlayerData.Track(killer, "Kill", 1, weaponName)
			PlayerData.Track(killer, "Streak", streak)
			PlayerData.SetBest(killer, "BestStreak", streak)
			if headshot then
				PlayerData.Increment(killer, "Headshots", 1)
				PlayerData.Track(killer, "Headshot", 1, weaponName)
			end

			if STREAK_ANNOUNCE[streak] then
				Remotes.Notify:FireAllClients("Streak", killer.Name .. " tiene una racha de " .. streak .. " bajas")
			end
			Killstreaks.OnStreak(killer, streak)
			-- (el radar de un jugador también lo usan los bots de su equipo)
			if streak == Killstreaks.RadarStreak and killer.Team and isTeamMode()
				and currentMode ~= "GUN" and not (killer.Character and killer.Character:GetAttribute("Zombie")) then
				Bots.Radar(killer.Team.Name, Killstreaks.RadarTime)
			end
			-- (los zombis de la Infección no tienen recompensa por su cabeza)
			if not (ReplicatedStorage:GetAttribute("Infection") == "On" and killer.Team == teams[2]) then
				Bounty.OnStreak(killer, streak)
			end
		end
	end

	-- "SE BUSCA": quien elimina al buscado cobra su recompensa (si lo mata un bot o muere solo, se pierde)
	if bounty > 0 and victim then
		if killer and killer ~= victim then
			local given = PlayerData.AddCoins(killer, bounty, false) -- (premio fijo: no lo multiplican VIP ni amigos)
			PlayerData.AddXP(killer, GameConfig.Bounty.XP or 0, "Recompensa cobrada")
			Remotes.Notify:FireClient(killer, "BountyClaimed", given)
			Bounty.Announce(victim.Name, bounty, killer.Name)
		else
			Bounty.Announce(victim.Name, bounty, nil)
		end
	end

	-- Efecto de eliminación: el que tenga equipado quien ha hecho la baja (o el normal)
	if typeof(position) == "Vector3" then
		local effect = "Default"
		local killerData = killer and killer ~= victim and PlayerData.Get(killer)
		if killerData and killerData.EquippedKillEffect then
			effect = killerData.EquippedKillEffect
		end
		-- Los muñecos (sin jugador ni equipo) estallan en amarillo, como antes
		local burstColor = (victim or (victimBot and victimBot.Team)) and victimColor or Color3.fromRGB(255, 200, 60)
		Remotes.KillFX:FireAllClients(position, effect, burstColor)
	end

	-- La última baja de verdad (de alguien a otro): si cierra la partida o la ronda, se repite para todos
	local killerName = (killer and killer ~= victim and killer.Name) or (killerBot and killerBot.Name) or nil
	if killerName and victimName and killerName ~= victimName then
		lastKill = { Killer = killerName, Victim = victimName, Weapon = weaponName, Time = os.clock() }
		-- (si esta baja cierra la partida, se guarda tal cual y se congela todo ya: ninguna baja de
		-- después, hasta que la ronda se dé cuenta, la sustituye en la repetición)
		if roundOver and not wasOver and not decidingKill and GameConfig.FinalKillcam ~= false then
			decidingKill = lastKill
			ReplicatedStorage:SetAttribute("Frozen", true)
		end
		-- ACE: en una ronda de Eliminación, eliminar tú solo a todo el equipo rival (de 3 o más)
		local killerTeam = (killer and killer.Team) or (killerBot and killerBot.Team) or nil
		local victimTeam = (victim and victim.Team) or (victimBot and victimBot.Team) or nil
		if aceRound and playing and killerTeam and victimTeam and killerTeam ~= victimTeam then
			local count = (aceRound.Kills[killerName] or 0) + 1
			aceRound.Kills[killerName] = count
			if victimBot then
				aceRound.BotVictims = true
			end
			local members = aceRound.Members[victimTeam.Name] or 0
			if members >= 3 and count >= members and not aceRound.Done then
				aceRound.Done = true
				aceRound.AceBy = killerName
				Remotes.Notify:FireAllClients("Ace", killerName)
				if killer then
					-- (contra bots vale menos, como las demás bajas a bots)
					local xp = GameConfig.XP.Ace
					if aceRound.BotVictims then
						xp = math.max(1, math.floor(xp * GameConfig.Bots.RewardScale))
					end
					PlayerData.AddXP(killer, xp, "¡ACE!")
				end
			end
		end
	end
	local weapon = weaponName and Weapons.Get(weaponName)
	Remotes.KillFeed:FireAllClients({
		Killer = (killer and killer.Name) or (killerBot and killerBot.Name) or nil,
		KillerColor = killerColor,
		Victim = victimName,
		VictimColor = victimColor,
		Weapon = weapon and weapon.DisplayName or "",
		WeaponId = weapon and weaponName or nil, -- (el cliente dibuja la silueta del arma)
		Headshot = headshot,
	})
	-- Botín: a veces el caído suelta un paquete para quien le eliminó (no en Calabazas: ya sueltan algo)
	-- (solo bajas a jugadores o bots de verdad: los muñecos de práctica no cuentan)
	if playing and currentMode ~= "CAL" and killer and killer ~= victim and (victim or victimBot) and typeof(position) == "Vector3" then
		Loot.MaybeDrop(position, killer, victimBot ~= nil)
	end
	-- Calabazas: el caído suelta una calabaza con el color de su equipo
	-- (solo si alguien le eliminó: caerse o la lava no regala puntos al rival)
	if playing and currentMode == "CAL" and typeof(position) == "Vector3" and ((killer and killer ~= victim) or killerBot) then
		local team = (victim and victim.Team) or (victimBot and victimBot.Team)
		Pumpkins.Drop(position, team, victim and victim.UserId or nil, victimBot ~= nil)
	end
	-- Infección: el superviviente que cae se convierte en zombi en el acto (antes de que pueda revivir)
	if ReplicatedStorage:GetAttribute("Infection") == "On" and onInfectionDeath then
		onInfectionDeath(victim, victimBot)
	end
end

-- Asistencias (ver Combat): XP y monedas a quien ayudó a eliminar (menos si la víctima era un bot)
function Round.RegisterAssist(helpers, victimName, victimBot, victimPlayer)
	if not victimBot and not victimPlayer then
		return -- (los muñecos de práctica no dan asistencias)
	end
	local scale = victimBot and GameConfig.Bots.RewardScale or 1
	for _, helper in helpers do
		PlayerData.AddXP(helper, math.floor((GameConfig.XP.Assist or 0) * scale), "Asistencia")
		PlayerData.AddCoins(helper, math.max(1, math.floor((GameConfig.Coins.Assist or 0) * scale)))
		PlayerData.Increment(helper, "Assists", 1)
		helper:SetAttribute("MatchAssists", (helper:GetAttribute("MatchAssists") or 0) + 1)
		Remotes.Notify:FireClient(helper, "Assist", tostring(victimName or ""))
	end
end

---------------------------------------------------------------------------
-- Aparición libre (FFA / Escalada): el punto más alejado de los demás
---------------------------------------------------------------------------

local ffaCache = { Map = nil, Points = {} }
local spawnedThisRound = {} -- [player] = true: ya apareció en esta ronda (la siguiente vez, dinámica)

local function ffaSpawnFor(player, character)
	if isTeamMode() then
		-- Por equipos: la primera vez en la base; al reaparecer, en el punto más seguro (SpawnPicker)
		local first = not spawnedThisRound[player]
		if ReplicatedStorage:GetAttribute("State") == "Playing" then
			spawnedThisRound[player] = true
		end
		if first or not SpawnPicker.Enabled() then
			return
		end
		local point = SpawnPicker.Pick(player.Team, character)
		local root = point and character:WaitForChild("HumanoidRootPart", 5)
		if root then
			task.wait()
			character:PivotTo(CFrame.new(point + Vector3.new(0, 3, 0)) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
		end
		return
	end
	local map = workspace:FindFirstChild("Map")
	if not map then
		return
	end
	-- Puntos libres del mapa (se guardan mientras no cambie el mapa)
	if ffaCache.Map ~= map then
		ffaCache.Map, ffaCache.Points = map, {}
		for _, d in map:GetDescendants() do
			if d:IsA("BasePart") and d.Name == "FFASpawn" then
				table.insert(ffaCache.Points, d)
			end
		end
	end
	local points = ffaCache.Points
	if #points == 0 then
		return
	end
	-- Lejos de los demás jugadores y de los bots
	local others = {}
	for _, p in Players:GetPlayers() do
		local root = p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if root then
			table.insert(others, root.Position)
		end
	end
	for _, agent in Bots.Agents do
		if agent.Root and agent.Root.Parent then
			table.insert(others, agent.Root.Position)
		end
	end
	local best, bestDistance = points[math.random(1, #points)], -1
	for _, point in points do
		local nearest = math.huge
		for _, pos in others do
			nearest = math.min(nearest, (pos - point.Position).Magnitude)
		end
		nearest += math.random() * 10 -- un poco de azar entre puntos parecidos
		if nearest > bestDistance then
			best, bestDistance = point, nearest
		end
	end
	local root = character:WaitForChild("HumanoidRootPart", 5)
	if root then
		task.wait()
		character:PivotTo(CFrame.new(best.Position + Vector3.new(0, 3, 0)) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	end
end

---------------------------------------------------------------------------
-- Votación de mapa + modo
---------------------------------------------------------------------------

local function availableModes(mapId)
	local list = {}
	local def = MapBuilder.Get(mapId)
	for _, mode in GameConfig.Modes do
		-- (Buscar y destruir, solo en los mapas con sitios para la bomba)
		if GameConfig.ModeSettings[mode] and (mode ~= "SND" or (def and def.Bomb)) then
			table.insert(list, mode)
		end
	end
	if #list == 0 then
		table.insert(list, GameConfig.Modes[1] or "TDM")
	end
	return list
end

local function makeVoteOptions()
	local maps = {}
	for _, id in MapBuilder.Order do
		if MapBuilder.InSeason(id) then -- (los mapas de temporada, solo en su evento)
			table.insert(maps, id)
		end
	end
	if MapBuilder.IsCustom() then
		maps = { "Custom" }
	end
	-- Prioriza mapas distintos al actual
	for i = #maps, 2, -1 do
		local j = math.random(1, i)
		maps[i], maps[j] = maps[j], maps[i]
	end
	table.sort(maps, function(a, b)
		return (a ~= MapBuilder.Current and 0 or 1) < (b ~= MapBuilder.Current and 0 or 1)
	end)
	-- Siempre hay un mapa de 5 contra 5 táctico (Construction, Coastal, Terminal...) en la
	-- votación, con Duelo por equipos o Dominio (GameConfig.VoteRealisticMap)
	local realisticFirst = false
	if GameConfig.VoteRealisticMap ~= false then
		for i, id in maps do
			local def = MapBuilder.Get(id)
			if def and def.Realistic then
				table.insert(maps, 1, table.remove(maps, i))
				realisticFirst = true
				break
			end
		end
	end
	local options = {}
	local usedModes = {}
	for i = 1, 3 do
		local mapId = maps[((i - 1) % #maps) + 1]
		local modes = availableModes(mapId)
		if i == 1 and realisticFirst then
			local classic = {}
			for _, mode in modes do
				if mode == "TDM" or mode == "DOM" or mode == "SND" then
					table.insert(classic, mode)
				end
			end
			if #classic > 0 then
				modes = classic
			end
		end
		local mode = modes[math.random(1, #modes)]
		for _ = 1, 6 do
			if not usedModes[mode] then
				break
			end
			mode = modes[math.random(1, #modes)]
		end
		usedModes[mode] = true
		table.insert(options, { Map = mapId, Mode = mode })
	end
	return options
end

local function publishVotes()
	local counts = { 0, 0, 0 }
	for _, choice in votes do
		counts[choice] = (counts[choice] or 0) + 1
	end
	for i, option in voteOptions do
		local def = MapBuilder.Get(option.Map)
		ReplicatedStorage:SetAttribute("Vote" .. i .. "_Map", def and ((def.Icon and def.Icon .. " " or "") .. def.Name) or "Mapa propio")
		ReplicatedStorage:SetAttribute("Vote" .. i .. "_Mode", modeName(option.Mode))
		ReplicatedStorage:SetAttribute("Vote" .. i .. "_Count", counts[i])
	end
	return counts
end

local function clearVotes()
	for i = 1, 3 do
		ReplicatedStorage:SetAttribute("Vote" .. i .. "_Map", nil)
		ReplicatedStorage:SetAttribute("Vote" .. i .. "_Mode", nil)
		ReplicatedStorage:SetAttribute("Vote" .. i .. "_Count", nil)
	end
end

---------------------------------------------------------------------------
-- Ciclo de rondas
---------------------------------------------------------------------------

local function countdown(seconds, stopWhen)
	for t = seconds, 0, -1 do
		ReplicatedStorage:SetAttribute("TimeLeft", t)
		if stopWhen and stopWhen() then
			return
		end
		task.wait(1)
	end
end

local function respawnAll()
	for _, player in Players:GetPlayers() do
		task.spawn(Respawn.Load, player) -- con la protección contra cargas dobles
	end
end

local function isDeadPlayer(player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	return not humanoid or humanoid.Health <= 0
end

---------------------------------------------------------------------------
-- Infección (INF): supervivientes (equipo A) contra zombis (equipo B)
---------------------------------------------------------------------------

-- Los zombis solo llevan garras; los supervivientes, sus armas de siempre
local function infectionLoadout(player)
	if ReplicatedStorage:GetAttribute("Infection") == "On" and player.Team == teams[2] then
		return { "Claws" }
	end
	return nil
end

-- Aspecto de zombi al aparecer (después de cargar la ropa del avatar, que si no lo taparía)
local function zombify(player, character)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid or player.Character ~= character then
		return
	end
	Zombie.Apply(character, settings("INF").ZombieHealth)
	local started = os.clock()
	while not player:HasAppearanceLoaded() and os.clock() - started < 5 do
		task.wait(0.2)
	end
	if player.Character == character then
		Zombie.Apply(character, nil)
	end
end

-- Convierte en zombi a un jugador. Si sigue vivo (paciente cero) reaparece ya como zombi.
local function infectPlayer(player, announce)
	if player.Team == teams[2] then
		return
	end
	player.Neutral = false
	player.Team = teams[2]
	player:SetAttribute("Airstrikes", 0) -- (los zombis no tienen recompensas por racha)
	player:SetAttribute("Streak", 0)
	player:SetAttribute("StreakPlayers", 0)
	streakVictims[player] = nil
	player:SetAttribute("RadarUntil", 0)
	Bounty.Reset(player)
	if announce then
		Remotes.Notify:FireAllClients("Streak", "🧟 " .. player.Name .. " se ha convertido en zombi")
	end
	if not isDeadPlayer(player) and not player:GetAttribute("InMenu") then
		task.spawn(Respawn.Load, player)
	end
end

local function infectionCounts()
	local survivors, zombies = 0, 0
	for _, player in Players:GetPlayers() do
		if not player:GetAttribute("InMenu") then
			if player.Team == teams[1] then
				local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
				if Respawn.IsLoading(player) or (humanoid and humanoid.Health > 0) then
					survivors += 1
				end
			elseif player.Team == teams[2] then
				zombies += 1
			end
		end
	end
	for _, agent in Bots.Agents do
		if agent.Team == teams[1] then
			if agent.Spawning or (agent.Humanoid and agent.Humanoid.Health > 0) then
				survivors += 1
			end
		elseif agent.Team == teams[2] then
			zombies += 1
		end
	end
	return survivors, zombies
end

-- Elige pacientes cero al azar entre los supervivientes (jugadores fuera del menú y bots)
local function infectRandom(count)
	local pool = {}
	for _, player in Players:GetPlayers() do
		if player.Team == teams[1] and not player:GetAttribute("InMenu") then
			table.insert(pool, player)
		end
	end
	for _, agent in Bots.Agents do
		if agent.Team == teams[1] and agent.Humanoid then
			table.insert(pool, agent)
		end
	end
	local infected = 0
	for _ = 1, math.min(count, #pool - 1) do
		local chosen = table.remove(pool, math.random(1, #pool))
		infected += 1
		if typeof(chosen) == "Instance" then
			chosen:SetAttribute("InfZombieStart", true)
			infectPlayer(chosen, true)
		else
			Bots.Infect(chosen, teams[2])
			Remotes.Notify:FireAllClients("Streak", "🧟 " .. chosen.Name .. " se ha convertido en zombi")
		end
	end
	return infected
end

onInfectionDeath = function(victim, victimBot)
	if victim and victim.Team == teams[1] then
		infectPlayer(victim, true)
	elseif victimBot and victimBot.Team == teams[1] then
		Bots.Infect(victimBot, teams[2])
		Remotes.Notify:FireAllClients("Streak", "🧟 " .. victimBot.Name .. " se ha convertido en zombi")
	end
end

local function infectionRound(s)
	local a, b = teams[1], teams[2]
	-- Preparación: todos son supervivientes y se reparten por el mapa
	for t = s.PrepTime, 1, -1 do
		ReplicatedStorage:SetAttribute("TimeLeft", t)
		if t == s.PrepTime or t <= 3 then
			Remotes.Notify:FireAllClients("Big", "🧟 La infección empieza en " .. t .. "…")
		end
		local survivors = infectionCounts()
		ReplicatedStorage:SetAttribute("AliveA", survivors)
		ReplicatedStorage:SetAttribute("AliveB", 0)
		task.wait(1)
	end
	ReplicatedStorage:SetAttribute("Infection", "On")
	-- Quien sigue en la pantalla de inicio no es superviviente: si entra, lo hará como zombi
	for _, player in Players:GetPlayers() do
		if player.Team == a and player:GetAttribute("InMenu") then
			player.Team = b
			player:SetAttribute("InfZombieStart", true)
		end
	end
	local survivors = infectionCounts()
	if infectRandom(math.max(1, math.floor(survivors / (s.ZombieRatio or 5)))) == 0 then
		Remotes.Notify:FireAllClients("Big", "Hacen falta al menos 2 jugadores para la infección")
		task.wait(2)
		return
	end
	Remotes.Notify:FireAllClients("Big", "🧟 ¡HAN LLEGADO LOS ZOMBIS! ¡Sobrevive!")
	local roundEnd = os.clock() + s.RoundTime
	local winner
	local lastAnnounced = false
	while not roundOver do
		-- Los supervivientes que caen (por lo que sea) se convierten en zombis; quien vuelve al menú
		-- deja de ser superviviente
		for _, player in Players:GetPlayers() do
			if player.Team == a then
				if player:GetAttribute("InMenu") then
					infectPlayer(player, false)
				elseif not Respawn.IsLoading(player) and isDeadPlayer(player) then
					infectPlayer(player, true)
				end
			end
		end
		for _, agent in table.clone(Bots.Agents) do
			if agent.Team == a and not agent.Humanoid and not agent.Spawning then
				Bots.Infect(agent, b)
			end
		end
		local alive, zombies = infectionCounts()
		-- ¡Último superviviente! Se anuncia y recibe más vida para el final
		if alive == 1 and not lastAnnounced then
			lastAnnounced = true
			for _, player in Players:GetPlayers() do
				local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
				if player.Team == a and not player:GetAttribute("InMenu") and humanoid and humanoid.Health > 0 then
					humanoid.MaxHealth = 150
					humanoid.Health = 150
					Remotes.Notify:FireAllClients("Big", "🧑 ¡" .. string.upper(player.Name) .. " ES EL ÚLTIMO SUPERVIVIENTE!")
				end
			end
			for _, agent in Bots.Agents do
				if agent.Team == a and agent.Humanoid and agent.Humanoid.Health > 0 then
					agent.Humanoid.MaxHealth = 150
					agent.Humanoid.Health = 150
					Remotes.Notify:FireAllClients("Big", "🧑 ¡" .. string.upper(agent.Name) .. " ES EL ÚLTIMO SUPERVIVIENTE!")
				end
			end
		end
		ReplicatedStorage:SetAttribute("AliveA", alive)
		ReplicatedStorage:SetAttribute("AliveB", zombies)
		ReplicatedStorage:SetAttribute("TimeLeft", math.max(0, math.ceil(roundEnd - os.clock())))
		if alive == 0 then
			winner = b
			break
		elseif zombies == 0 and alive >= 2 then
			-- Se fueron todos los zombis: nuevo paciente cero
			infectRandom(1)
		end
		if os.clock() >= roundEnd then
			winner = a
			break
		end
		task.wait(0.25)
	end
	if winner then
		addScore(winner, 1)
		Remotes.Notify:FireAllClients("Big", winner == a and "🧑 ¡GANAN LOS SUPERVIVIENTES!" or "🧟 ¡GANAN LOS ZOMBIS!")
		task.wait(2)
	end
end

-- Limpia el estado de Infección (al acabar o si la ronda falla)
local function clearInfection()
	ReplicatedStorage:SetAttribute("Infection", nil)
	ReplicatedStorage:SetAttribute("AliveA", nil)
	ReplicatedStorage:SetAttribute("AliveB", nil)
end

---------------------------------------------------------------------------
-- Eliminación (ELIM)
---------------------------------------------------------------------------

-- Vivos y participantes de un equipo (jugadores fuera del menú + bots)
-- Vivos y participantes de un equipo. Solo cuentan los jugadores que empezaron la ronda (atributo
-- ElimIn) y los bots; un bot que aún se está creando cuenta como vivo.
local function aliveCount(team)
	local alive, members = 0, 0
	for _, player in team:GetPlayers() do
		if player:GetAttribute("ElimIn") then
			members += 1
			-- Quien vuelve al menú no cuenta como vivo (si no, su equipo no se podría eliminar);
			-- quien está reapareciendo justo al empezar, sí
			local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if not player:GetAttribute("InMenu") and (Respawn.IsLoading(player) or (humanoid and humanoid.Health > 0)) then
				alive += 1
			end
		end
	end
	for _, agent in Bots.Agents do
		if agent.Team == team then
			members += 1
			if agent.Spawning or (agent.Humanoid and agent.Humanoid.Health > 0) then
				alive += 1
			end
		end
	end
	return alive, members
end

-- Limpia el estado de Eliminación (al acabar o si la ronda falla)
local function clearElimination()
	Bomb.Stop()
	ReplicatedStorage:SetAttribute("NoRespawn", false)
	ReplicatedStorage:SetAttribute("Frozen", false)
	ReplicatedStorage:SetAttribute("HeldTeam", nil)
	ReplicatedStorage:SetAttribute("AliveA", nil)
	ReplicatedStorage:SetAttribute("AliveB", nil)
	for _, player in Players:GetPlayers() do
		player:SetAttribute("ElimIn", nil)
	end
end

-- Killcam final (como en los shooters): si la partida o la ronda la acaba de cerrar una baja, todos
-- ven la repetición desde los ojos de quien la hizo. Mientras, todo queda congelado (nadie dispara
-- ni se mueven los bots). Devuelve true si la hubo.
local function playFinalKillcam()
	-- La que cerró la partida; si no la hubo (p. ej. la ronda la decidió quién quedaba vivo), la última
	-- baja solo si fue justo antes (si se acabó el tiempo o por puntos de zona, no hay repetición)
	local kill = decidingKill
	if not kill and lastKill and os.clock() - lastKill.Time <= 1.2 then
		kill = lastKill
	end
	decidingKill = nil
	lastKill = nil
	if GameConfig.FinalKillcam == false or not kill or os.clock() - kill.Time > 4 then
		if kill then
			ReplicatedStorage:SetAttribute("Frozen", false)
		end
		return false
	end
	ReplicatedStorage:SetAttribute("Frozen", true)
	Remotes.FinalKillcam:FireAllClients({ Killer = kill.Killer, Victim = kill.Victim, Weapon = kill.Weapon })
	task.wait(GameConfig.FinalKillcamTime or 3.4)
	ReplicatedStorage:SetAttribute("Frozen", false)
	return true
end
Round.PlayFinalKillcam = playFinalKillcam -- (para las pruebas)
-- (para las pruebas: empieza una ronda de Eliminación con estos equipos para contar el ACE)
function Round.StartAceRound(members)
	aceRound = { Kills = {}, Members = members, Done = false }
end

-- Rondas de una vida hasta que un equipo llegue a ScoreToWin rondas ganadas (o se acabe el tiempo total)
local MIN_SUBROUND = 20 -- no se empieza una ronda si quedan menos segundos que esto (más la preparación)
-- Buscar y destruir (SND) usa las mismas rondas con la bomba: atacan y defienden por turnos
local function eliminationRounds(s)
	local deadline = os.clock() + s.RoundTime
	local number = 0
	local a, b = teams[1], teams[2]
	local snd = currentMode == "SND"
	while not roundOver and deadline - os.clock() >= s.PrepTime + MIN_SUBROUND do
		number += 1
		local attackers = number % 2 == 1 and a or b
		local defenders = attackers == a and b or a
		-- Preparación: todos vuelven a su base con la vida llena y quietos (no se puede disparar)
		ReplicatedStorage:SetAttribute("Frozen", true)
		ReplicatedStorage:SetAttribute("NoRespawn", false)
		for _, player in Players:GetPlayers() do
			player:SetAttribute("ElimIn", nil)
		end
		-- (sin contador de vivos durante la preparación)
		ReplicatedStorage:SetAttribute("AliveA", nil)
		ReplicatedStorage:SetAttribute("AliveB", nil)
		respawnAll()
		Bots.RespawnAll()
		Remotes.Notify:FireAllClients("Big", "RONDA " .. number .. " · ¡Una sola vida!")
		countdown(s.PrepTime)
		-- Que nadie empiece muerto (p. ej. un bot que aún se estaba creando o alguien que cayó en la preparación)
		local waitUntil = os.clock() + 5
		while os.clock() < waitUntil do
			local spawning = false
			for _, agent in Bots.Agents do
				spawning = spawning or agent.Spawning == true
			end
			if not spawning then
				break
			end
			task.wait(0.2)
		end
		for _, player in Players:GetPlayers() do
			-- (también quien pulsó JUGAR y está acabando la cuenta atrás en su pantalla: su cliente avisa
			-- de que sale del menú justo al terminarla, un instante después de este punto, y sin esto
			-- entraba siempre de espectador en la primera ronda)
			if not player:GetAttribute("InMenu") or player:GetAttribute("Ready") == true then
				if isDeadPlayer(player) then
					task.spawn(Respawn.Load, player)
				end
				player:SetAttribute("ElimIn", true) -- participa en esta ronda
				player:SetAttribute("ElimPlayed", true)
			end
		end
		Bots.RespawnDead()
		ReplicatedStorage:SetAttribute("NoRespawn", true)
		-- Buscar y destruir: los sitios están a la misma distancia de las dos bases, así que los
		-- atacantes salen unos segundos después para que los defensores puedan colocarse
		local map = workspace:FindFirstChild("Map")
		local sharedSites = map ~= nil and map:GetAttribute("SharedSites") == true
		local headStart = (snd and sharedSites) and (s.DefenderHeadStart or 0) or 0
		if headStart > 0 then
			ReplicatedStorage:SetAttribute("HeldTeam", attackers.Name)
			for _, player in Players:GetPlayers() do
				if player.Team == attackers then
					Remotes.Notify:FireClient(player, "Big", "Los defensores se colocan · salís en " .. headStart)
				end
			end
			task.delay(headStart, function()
				if ReplicatedStorage:GetAttribute("HeldTeam") == attackers.Name then
					ReplicatedStorage:SetAttribute("HeldTeam", nil)
				end
			end)
		end
		ReplicatedStorage:SetAttribute("Frozen", false)
		do
			local _, membersA = aliveCount(a)
			local _, membersB = aliveCount(b)
			aceRound = { Kills = {}, Members = { [a.Name] = membersA, [b.Name] = membersB }, Done = false }
		end
		if snd and Bomb.Start(attackers, defenders) then
			-- Cada equipo sabe qué le toca
			for _, player in Players:GetPlayers() do
				if player.Team == attackers then
					Remotes.Notify:FireClient(player, "Big", "💣 ATACAS: planta la bomba en A o B")
				elseif player.Team == defenders then
					Remotes.Notify:FireClient(player, "Big", "🛡️ DEFIENDES: protege A y B")
				end
			end
		else
			snd = false -- (sin sitios en el mapa: como Eliminación)
			Remotes.Notify:FireAllClients("Big", "¡YA!")
		end
		task.wait(0.5)

		local roundEnd = math.min(os.clock() + s.SubRoundTime, deadline)
		local winner, decided = nil, false
		while not roundOver do
			local aliveA, membersA = aliveCount(a)
			local aliveB, membersB = aliveCount(b)
			ReplicatedStorage:SetAttribute("AliveA", aliveA)
			ReplicatedStorage:SetAttribute("AliveB", aliveB)
			ReplicatedStorage:SetAttribute("TimeLeft", math.max(0, math.ceil(roundEnd - os.clock())))
			local contest = membersA > 0 and membersB > 0
			if snd then
				-- Bomba: explota = atacantes; desactivada = defensores. Sin bomba plantada, si caen todos
				-- los atacantes o se acaba el tiempo, ganan los defensores; si caen todos los defensores,
				-- los atacantes. Con la bomba plantada, los defensores tienen que desactivarla.
				local aliveAtt = attackers == a and aliveA or aliveB
				local aliveDef = attackers == a and aliveB or aliveA
				if Bomb.Planted then
					ReplicatedStorage:SetAttribute("TimeLeft", ReplicatedStorage:GetAttribute("Bomb_Timer") or 0)
				end
				local result = nil
				if Bomb.Result == "Exploded" then
					result = attackers
				elseif Bomb.Result == "Defused" then
					result = defenders
				elseif contest and aliveDef == 0 then
					result = attackers
				elseif contest and aliveAtt == 0 and not Bomb.Planted then
					result = defenders
				elseif not Bomb.Planted and os.clock() >= roundEnd then
					result = defenders
				elseif Bomb.Planted and os.clock() >= roundEnd + (s.BombTime or 35) + 5 then
					result = defenders -- (por si la bomba dejara de contar: la ronda nunca se queda colgada)
				end
				if result or (not contest and os.clock() >= roundEnd) then
					winner = contest and result or nil
					lastRoundHow = (Bomb.Result == "Defused" and "BombDefused") or (Bomb.Result == "Exploded" and "BombExploded")
						or ((contest and (aliveDef == 0 or aliveAtt == 0)) and "Eliminated") or "Time"
					decided = true
					break
				end
				task.wait(0.25)
				continue
			end
			-- Solo hay ronda si los dos equipos tienen a alguien
			if contest and (aliveA == 0 or aliveB == 0) then
				winner = (aliveA > 0 and a) or (aliveB > 0 and b) or nil
				lastRoundHow = "Eliminated"
				decided = true
				break
			end
			if os.clock() >= roundEnd then
				-- Se acaba el tiempo: gana el equipo con más supervivientes (sin rival no gana nadie)
				winner = contest and ((aliveA > aliveB and a) or (aliveB > aliveA and b)) or nil
				lastRoundHow = "Time"
				decided = true
				break
			end
			task.wait(0.25)
		end
		Bomb.Stop()
		local roundStats = aceRound
		aceRound = nil
		if decided then
			if winner then
				addScore(winner, 1)
			end
			-- Resultado de la ronda: cada cliente dice GANADA/PERDIDA, con el marcador y el mejor de la ronda
			local roundMVP, roundKills = nil, 0
			for name, kills in (roundStats and roundStats.Kills) or {} do
				if kills > roundKills then
					roundMVP, roundKills = name, kills
				end
			end
			-- (si la ronda la cerró una baja: primero su repetición, como en Buscar y destruir; durante la
			-- repetición el HUD no se ve, así que el resultado va después)
			playFinalKillcam()
			Remotes.Notify:FireAllClients("Round", {
				Winner = winner and winner.Name or nil,
				Number = number,
				ScoreA = getScore(a.Name),
				ScoreB = getScore(b.Name),
				MVP = roundMVP,
				MVPKills = roundKills,
				Ace = roundStats and roundStats.AceBy or nil,
			})
			-- (en la última ronda no hace falta esperar: ya sale la pantalla final)
			if not roundOver then
				task.wait(3)
			end
		end
	end
	clearElimination()
	-- Nadie se queda muerto durante la pantalla final
	respawnAll()
end

-- Los 3 mejores de la partida (jugadores y bots, por bajas y luego menos muertes), para el podio
-- de la pantalla final. Hay que calcularlo antes de cambiar de estado: al cambiar, los bots se quitan
local function topPlayers()
	local list = {}
	for _, player in Players:GetPlayers() do
		local stats = PlayerData.GetLeaderstats(player)
		local kills, deaths = stats.Bajas.Value, stats.Muertes.Value
		if not player:GetAttribute("InMenu") or kills + deaths > 0 then
			table.insert(list, { Name = tostring(player.DisplayName), Kills = kills, Deaths = deaths, Team = player.Team and player.Team.Name or nil })
		end
	end
	local botStats = ReplicatedStorage:FindFirstChild("BotStats")
	if botStats then
		for _, entry in botStats:GetChildren() do
			table.insert(list, {
				Name = entry.Name,
				Kills = entry:GetAttribute("Kills") or 0,
				Deaths = entry:GetAttribute("Deaths") or 0,
				Team = entry:GetAttribute("Team"),
				Bot = true,
			})
		end
	end
	table.sort(list, function(x, y)
		if x.Kills ~= y.Kills then
			return x.Kills > y.Kills
		end
		if x.Deaths ~= y.Deaths then
			return x.Deaths < y.Deaths
		end
		return x.Name < y.Name
	end)
	local top = {}
	for i = 1, math.min(3, #list) do
		top[i] = list[i]
	end
	return top
end

-- Todos los que han jugado la partida (jugadores y bots) con sus números y su arma, para la pantalla
-- final. Como el podio, antes de cambiar de estado (los bots se quitan al acabar)
local function matchParticipants()
	local list = {}
	for _, player in Players:GetPlayers() do
		local stats = PlayerData.GetLeaderstats(player)
		local kills, deaths = stats.Bajas.Value, stats.Muertes.Value
		if not player:GetAttribute("InMenu") or kills + deaths > 0 then
			local data = PlayerData.Get(player)
			local assists = player:GetAttribute("MatchAssists") or 0
			local captures = player:GetAttribute("Captures") or 0
			local weapon = data and data.Primary or nil
			local skin = nil
			if data and weapon then
				local camo = data.WeaponCamos and data.WeaponCamos[weapon]
				skin = (camo and camo ~= "Default") and camo or data.EquippedSkin
			end
			table.insert(list, {
				Id = "u" .. player.UserId,
				Name = tostring(player.DisplayName),
				UserId = player.UserId,
				Team = player.Team and player.Team.Name or nil,
				Kills = kills,
				Deaths = deaths,
				Assists = assists,
				Captures = captures,
				Points = MatchResults.Points(kills, assists, captures),
				Weapon = weapon,
				Skin = skin,
				Level = data and data.Level or nil,
				Outfit = data and data.EquippedOutfit or nil,
				-- Cosméticos de la pantalla final (tarjeta, pose de victoria, intro de MVP y colgante)
				Card = data and data.EquippedCard or nil,
				Pose = data and data.EquippedPose or nil,
				MVPIntro = data and data.EquippedMVPIntro or nil,
				Charm = data and data.EquippedCharm or nil,
				Model = player.Character,
			})
		end
	end
	local botStats = ReplicatedStorage:FindFirstChild("BotStats")
	for _, agent in Bots.Agents or {} do
		local entry = botStats and botStats:FindFirstChild(agent.Name)
		local kills = entry and entry:GetAttribute("Kills") or 0
		table.insert(list, {
			Id = "b" .. agent.Name,
			Name = agent.Name,
			Bot = true,
			Team = agent.Team and agent.Team.Name or (entry and entry:GetAttribute("Team")) or nil,
			Kills = kills,
			Deaths = entry and entry:GetAttribute("Deaths") or 0,
			Assists = 0,
			Captures = 0,
			Points = MatchResults.Points(kills, 0, 0),
			Weapon = agent.RoleWeapon or agent.Weapon,
			Model = agent.Model,
		})
	end
	table.sort(list, MatchResults.Better)
	return list
end

local function endRound()
	-- Antes de nada (al cambiar de estado se quitan los bots): la repetición de la baja final
	playFinalKillcam()
	-- El líder se calcula antes de cambiar de estado (al cambiar, los bots se quitan)
	local leader, leaderScore = updateLeader()
	-- (el podio es un extra: si fallara, la partida termina igual)
	local okTop, top = pcall(topPlayers)
	if not okTop then
		warn("[Round] podio:", top)
		top = nil
	end
	-- Pantalla final: todos los participantes y la copia de sus avatares (antes de que se vayan los bots)
	local okList, participants = pcall(matchParticipants)
	if not okList then
		warn("[Round] participantes:", participants)
		participants = {}
	end
	local okCast, castErr = pcall(ResultsCast.Capture, participants)
	if not okCast then
		warn("[Round] reparto de la pantalla final:", castErr)
	end
	for _, entry in participants do
		entry.Model = nil
		entry.Outfit = nil
	end
	setState("Ended")
	local teamMode = isTeamMode()
	local a, b = teams[1], teams[2]
	local scoreA, scoreB = getScore(a.Name), getScore(b.Name)
	local winner = nil
	if teamMode then
		if scoreA > scoreB then
			winner = a
		elseif scoreB > scoreA then
			winner = b
		end
	end

	-- MVP = más puntos de la partida (bajas, asistencias y objetivos: MatchResults.Points). Para el
	-- rango cuenta el mejor jugador; en la pantalla final, el mejor de todos (bots incluidos)
	local mvp, mvpKills, mvpScore = nil, 0, -1
	for _, player in Players:GetPlayers() do
		local kills = PlayerData.GetLeaderstats(player).Bajas.Value
		local score = MatchResults.Points(kills, player:GetAttribute("MatchAssists") or 0, player:GetAttribute("Captures") or 0)
		if score > mvpScore then
			mvp, mvpKills, mvpScore = player, kills, score
		end
	end

	-- Contra bots (menos de 2 jugadores de verdad) la victoria da menos premio y no cuenta para
	-- la clasificación global de victorias
	local humans = 0
	for _, player in Players:GetPlayers() do
		local stats = PlayerData.GetLeaderstats(player)
		-- Ha jugado: está fuera del menú o tiene alguna baja o muerte en esta partida
		if not player:GetAttribute("InMenu") or stats.Bajas.Value + stats.Muertes.Value > 0 then
			humans += 1
		end
	end
	local soloMatch = humans < 2
	-- Por equipos, si todos los jugadores de verdad están en el mismo equipo, es contra bots
	-- (para el rango: dos amigos juntos contra bots no suben como en una partida de verdad)
	local botsOnly = soloMatch
	-- (en Infección los equipos cambian durante la ronda: basta con que jueguen dos personas)
	if teamMode and not soloMatch and currentMode ~= "INF" then
		local humansA, humansB = 0, 0
		for _, player in Players:GetPlayers() do
			if player:GetAttribute("MatchJoinedAt") then
				if player.Team == a then
					humansA += 1
				elseif player.Team == b then
					humansB += 1
				end
			end
		end
		botsOnly = humansA == 0 or humansB == 0
	end
	-- Rango: solo para quien ha jugado de verdad (lleva un rato en la partida, ha tenido bajas o
	-- muertes, o ha jugado alguna ronda de Eliminación). También si ha vuelto al menú (no se esquiva
	-- la derrota así). Empate (por equipos, o nadie puntúa en todos contra todos) = sin cambios.
	local now = workspace:GetServerTimeNow()
	local elim = currentMode == "ELIM" or currentMode == "SND"
	local playedMatch = {} -- [player] = true si ha jugado de verdad (para la primera victoria del día y la caja sorpresa)
	for _, player in Players:GetPlayers() do
		local joined = player:GetAttribute("MatchJoinedAt")
		local stats = PlayerData.GetLeaderstats(player)
		local active = stats.Bajas.Value + stats.Muertes.Value > 0
		local played = joined ~= nil
			and (active or (if elim then player:GetAttribute("ElimPlayed") == true else now - joined >= 60))
		if played then
			playedMatch[player] = true
			PlayerData.Increment(player, "Matches", 1)
			local won
			if teamMode then
				won = wonTeam(player, winner)
			else
				won = leader == player and leaderScore > 0
			end
			local draw = (teamMode and winner == nil) or (not teamMode and leaderScore <= 0)
			local result = won and "Win" or (draw and "Draw" or "Loss")
			PlayerData.AddRankPoints(player, Ranks.Delta(result, not teamMode, botsOnly, mvp == player and mvpScore > 0))
		end
	end
	local winScale = soloMatch and GameConfig.Bots.RewardScale or 1

	-- Premios solo para quien ha jugado (no para quien sigue en la pantalla de inicio)
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("InMenu") then
			continue
		end
		local won
		if teamMode then
			won = wonTeam(player, winner)
		else
			won = leader == player and leaderScore > 0
		end
		if won then
			PlayerData.AddXP(player, math.floor(GameConfig.XP.Win * winScale), "Victoria")
			PlayerData.AddCoins(player, math.floor(GameConfig.Coins.Win * winScale))
			-- Racha de victorias (en esta sesión): cada victoria seguida da un poco más
			local winStreak = (player:GetAttribute("WinStreak") or 0) + 1
			player:SetAttribute("WinStreak", winStreak)
			local extra = math.floor((GameConfig.Coins.WinStreak or 0) * math.min(winStreak - 1, GameConfig.Coins.WinStreakMax or 5) * winScale)
			if extra > 0 then
				local given = PlayerData.AddCoins(player, extra)
				Remotes.Notify:FireClient(player, "Challenge", "🔥 ¡" .. winStreak .. " victorias seguidas!  +" .. given .. " 💰")
			end
			if not soloMatch then
				PlayerData.Increment(player, "Wins", 1)
			end
			if playedMatch[player] then
				-- (completa también contra bots: es una vez al día, no se puede abusar)
				local firstWin = PlayerData.ClaimFirstWin(player, 1)
				if firstWin then
					Remotes.Notify:FireClient(player, "Challenge", "🏆 ¡Primera victoria del día!  +" .. firstWin .. " 💰")
				end
			end
			PlayerData.Track(player, "Win", 1)
			-- (reto semanal: ganar en el mapa destacado del día)
			local featured = ReplicatedStorage:GetAttribute("FeaturedMap")
			if featured and featured == ReplicatedStorage:GetAttribute("MapName") then
				PlayerData.Track(player, "FeaturedWin", 1)
			end
			if currentMode == "INF" and winner == teams[1] then
				PlayerData.Track(player, "Survive", 1)
			end
		else
			player:SetAttribute("WinStreak", 0)
			PlayerData.AddXP(player, GameConfig.XP.Loss, "Partida completada")
		end
		PlayerData.Track(player, "Match", 1)
		if playedMatch[player] and PlayerData.RollSurpriseCrate(player) then
			task.delay(2.5, function()
				if player.Parent then
					Remotes.Notify:FireClient(player, "Big", "🎁 ¡CAJA SORPRESA! Tienes una caja gratis en la Tienda")
				end
			end)
		end
	end

	-- Resultado completo para la pantalla final (ver MatchResults)
	local goal = ReplicatedStorage:GetAttribute("ScoreToWin") or math.huge
	local hasWinner = if teamMode then winner ~= nil else (leader ~= nil and leaderScore > 0)
	local reachedGoal
	if currentMode == "INF" then
		reachedGoal = winner ~= nil and winner ~= teams[1]
	elseif teamMode then
		reachedGoal = winner ~= nil and math.max(scoreA, scoreB) >= goal
	else
		reachedGoal = leaderScore >= goal
	end
	local result = {
		Mode = currentMode,
		ModeName = ReplicatedStorage:GetAttribute("ModeName"),
		Map = ReplicatedStorage:GetAttribute("MapName"),
		TeamMode = teamMode,
		TeamA = a.Name,
		TeamB = b.Name,
		ScoreA = scoreA,
		ScoreB = scoreB,
		Winner = if teamMode then (winner and winner.Name) else (leader and leader.Name),
		Reason = MatchResults.ReasonFor(currentMode, hasWinner, reachedGoal, lastRoundHow),
		MVP = participants[1] and participants[1].Id or nil,
		Players = participants,
	}
	Remotes.RoundEnd:FireAllClients({
		Result = result,
		TeamMode = teamMode,
		Winner = if teamMode then (winner and winner.Name) else (leader and leader.Name),
		WinnerColor = winner and winner.TeamColor.Color or Color3.fromRGB(255, 200, 60),
		ScoreA = scoreA,
		ScoreB = scoreB,
		LeaderScore = leaderScore,
		MVP = mvp and mvp.Name or nil,
		MVPKills = mvpKills,
		MVPCaptures = mvp and mvp:GetAttribute("Captures") or 0,
		Top = top,
		-- Remontada: el ganador llegó a ir perdiendo por mucho (un 30 % de la meta, mínimo 2)
		Comeback = teamMode and winner ~= nil
			and (maxDeficit[winner.Name] or 0) >= math.max(2, math.ceil((ReplicatedStorage:GetAttribute("ScoreToWin") or 10) * 0.3))
			or nil,
	})
	-- Resumen personal: lo ganado en esta partida (el cliente lo anima: barra de nivel, monedas...)
	for _, player in Players:GetPlayers() do
		local summary = not player:GetAttribute("InMenu") and PlayerData.MatchSummary(player)
		if summary then
			local stats = PlayerData.GetLeaderstats(player)
			summary.Kills = stats.Bajas.Value
			summary.Deaths = stats.Muertes.Value
			summary.Assists = player:GetAttribute("MatchAssists") or 0
			summary.BestStreak = player:GetAttribute("BestStreak") or 0
			summary.Captures = player:GetAttribute("Captures") or 0
			summary.WinStreak = player:GetAttribute("WinStreak") or 0
			-- ¿Récord personal de bajas en una partida? (desde 5, para que no salte en las primeras)
			local data = PlayerData.Get(player)
			local record = data and data.BestMatchKills or 0
			if data and summary.Kills >= 5 and summary.Kills > record then
				summary.NewRecord = summary.Kills
				summary.PrevRecord = record
			end
			PlayerData.SetBest(player, "BestMatchKills", summary.Kills)
			Remotes.MatchSummary:FireClient(player, summary)
		end
	end
	task.wait(GameConfig.EndScreenTime)
end

local function startMode(mode)
	currentMode = mode
	local s = settings(mode)
	local scoreToWin = s.ScoreToWin
	if mode == "GUN" then
		scoreToWin = #Weapons.GunGameOrder
	end
	ReplicatedStorage:SetAttribute("Mode", mode)
	ReplicatedStorage:SetAttribute("ModeName", modeName(mode))
	ReplicatedStorage:SetAttribute("TeamMode", s.Teams ~= false)
	ReplicatedStorage:SetAttribute("ScoreToWin", scoreToWin)
	-- (antes de empezar: así los bots que entran al empezar ya son supervivientes)
	ReplicatedStorage:SetAttribute("Infection", if mode == "INF" then "Prep" else nil)
	if mode == "GUN" then
		Loadout.Override = gunGameWeapons
	elseif mode == "INF" then
		Loadout.Override = infectionLoadout
	else
		Loadout.Override = nil
	end
end

-- Una ronda completa: descanso con votación, partida y pantalla final
local function playRound()
	do
		-- Descanso con votación
		setState("Intermission")
		table.clear(votes)
		voteOptions = makeVoteOptions()
		publishVotes()
		countdown(GameConfig.IntermissionTime, function()
			return qaStartNow
		end)
		qaStartNow = false
		while #Players:GetPlayers() < GameConfig.MinPlayers do
			ReplicatedStorage:SetAttribute("TimeLeft", 0)
			task.wait(1)
		end

		-- Resultado de la votación (empate = al azar entre los empatados)
		local counts = publishVotes()
		local bestCount = -1
		local ties = {}
		for i = 1, #voteOptions do
			local c = counts[i] or 0
			if c > bestCount then
				bestCount = c
				ties = { i }
			elseif c == bestCount then
				table.insert(ties, i)
			end
		end
		local choice = voteOptions[ties[math.random(1, #ties)]]
		clearVotes()
		-- (QA: la partida que se pidió en el panel, en vez de la votada)
		if Round.QANext then
			choice = Round.QANext
			Round.QANext = nil
		end

		local mode = choice.Mode
		-- Comprueba que el mapa soporta el modo
		if choice.Map ~= "Custom" and choice.Map ~= MapBuilder.Current then
			-- Presentación del mapa en los clientes (ver Flow/Screens/MapIntro): se tapa la construcción del mapa
			ReplicatedStorage:SetAttribute("LoadingMap", MapBuilder.Get(choice.Map).Name)
			task.wait(0.6)
			Flags.Stop()
			Hardpoint.Stop()
			Domination.Stop()
			local built, buildError = pcall(MapBuilder.Build, choice.Map)
			task.wait(0.3)
			ReplicatedStorage:SetAttribute("LoadingMap", nil)
			if not built then
				error(buildError, 0)
			end
		end
		if mode == "CTF" and not Flags.IsAvailable() then
			mode = "TDM"
		elseif mode == "KOTH" and not Hardpoint.IsAvailable() then
			mode = "TDM"
		elseif mode == "DOM" and not Domination.IsAvailable() then
			mode = "TDM"
		elseif mode == "SND" and not Bomb.IsAvailable() then
			mode = "ELIM" -- (mapa sin sitios para la bomba)
		end
		startMode(mode)

		roundOver = false
		balanceTeams()
		resetStats()
		table.clear(spawnedThisRound)
		setState("Playing")
		-- Mapa destacado del día: aviso al empezar
		local featured = ReplicatedStorage:GetAttribute("FeaturedMap")
		if featured and featured == ReplicatedStorage:GetAttribute("MapName") and GameConfig.FeaturedMap then
			Remotes.Notify:FireAllClients("Big", "⭐ ¡MAPA DESTACADO DE HOY! +" .. math.floor((GameConfig.FeaturedMap.XPBonus - 1) * 100 + 0.5) .. "% XP")
		end
		if mode == "CTF" then
			Flags.Start()
		elseif mode == "KOTH" then
			Hardpoint.Start()
		elseif mode == "DOM" then
			Domination.Start()
		elseif mode == "CAL" then
			Pumpkins.Start()
		end
		if mode ~= "ELIM" and mode ~= "SND" then
			respawnAll() -- (Eliminación reaparece a todos al empezar cada ronda)
		end
		-- Despliegue: todos quietos y sin daño mientras se presentan los equipos, cada uno elige
		-- clase y cuenta atrás 3-2-1 (el cliente lo sincroniza con DeployEndsAt). En Eliminación y
		-- Buscar y destruir la cuenta atrás es la preparación de la primera ronda
		local deploy = GameConfig.Deploy
		if deploy and deploy.Enabled ~= false then
			local elimLike = mode == "ELIM" or mode == "SND"
			local now = workspace:GetServerTimeNow()
			ReplicatedStorage:SetAttribute("Frozen", true)
			ReplicatedStorage:SetAttribute("Deploy", "Lineup")
			ReplicatedStorage:SetAttribute("CountdownAt", now + deploy.LineupTime)
			ReplicatedStorage:SetAttribute("DeployEndsAt", now + deploy.LineupTime + (elimLike and 0 or deploy.CountdownTime))
			task.wait(deploy.LineupTime)
			if not elimLike then
				ReplicatedStorage:SetAttribute("Deploy", "Countdown")
				task.wait(deploy.CountdownTime)
			end
			ReplicatedStorage:SetAttribute("Deploy", nil)
			ReplicatedStorage:SetAttribute("Frozen", false)
		end
		local s = settings(mode)
		local goal = ReplicatedStorage:GetAttribute("ScoreToWin")
		local intro = {
			TDM = "¡A LUCHAR! Primero a " .. goal .. " bajas",
			CTF = "¡CAPTURA LA BANDERA! Primero a " .. goal,
			KOTH = "¡ZONA DE CONTROL! Primero a " .. goal .. " puntos",
			DOM = "🚩 ¡DOMINIO! Captura A, B y C · primero a " .. goal .. " puntos",
			FFA = "¡TODOS CONTRA TODOS! Primero a " .. goal .. " bajas",
			GUN = "¡ESCALADA DE ARMAS! Una baja con cada arma",
			ELIM = "¡ELIMINACIÓN! Una vida por ronda · primero a " .. goal .. " rondas",
			SND = "💣 ¡BUSCAR Y DESTRUIR! Una vida · planta o desactiva la bomba · primero a " .. goal .. " rondas",
			INF = "🧟 ¡INFECCIÓN! Escóndete y prepárate",
			CAL = Pumpkins.Tags() and ("🏷️ ¡BAJA CONFIRMADA! Recoge las placas de tus enemigos caídos · primero a " .. goal)
				or ("🎃 ¡CALABAZAS! Recoge las de tus enemigos caídos · primero a " .. goal),
		}
		Remotes.Notify:FireAllClients("Big", intro[mode] or s.Name)
		if mode == "ELIM" or mode == "SND" then
			task.wait(2)
			eliminationRounds(s)
		elseif mode == "INF" then
			infectionRound(s)
		else
			countdown(s.RoundTime, function()
				return roundOver
			end)
		end
		-- La repetición de la baja final, antes de limpiar el modo (en la Infección, por ejemplo, todos
		-- reaparecen al acabar y ya no estarían donde fue la baja)
		playFinalKillcam()
		Flags.Stop()
		Hardpoint.Stop()
		Domination.Stop()
		Pumpkins.Stop()
		Loot.Clear()
		Loadout.Override = nil
		if mode == "INF" then
			clearInfection()
			-- Fuera de la Infección todos vuelven a ser normales (los zombis reaparecen)
			respawnAll()
		end
		if mode == "GUN" then
			-- Fuera de la Escalada cada uno recupera sus armas
			for _, player in Players:GetPlayers() do
				Loadout.GiveDefault(player)
			end
		end
		endRound()
	end
end

local function gameLoop()
	while true do
		-- Si algo falla en una ronda, el servidor no se queda colgado: se limpia y empieza otra
		local ok, err = xpcall(playRound, debug.traceback)
		if not ok then
			warn("[Round] Error en la ronda, se reinicia:", err)
			pcall(Flags.Stop)
			pcall(Hardpoint.Stop)
			pcall(Domination.Stop)
			pcall(Pumpkins.Stop)
			pcall(Loot.Clear)
			pcall(clearElimination)
			pcall(clearInfection)
			-- (primero las armas normales: si no, tras un fallo en Escalada se quedarían las de esa ronda)
			Loadout.Override = nil
			for _, player in Players:GetPlayers() do
				pcall(Loadout.GiveDefault, player)
			end
			pcall(respawnAll)
			roundOver = true
			task.wait(3)
		end
	end
end

-- Amistad detectada (Friends tarda un poco al entrar alguien): si el que acaba de entrar sigue en
-- la portada y su amigo está en el otro equipo, se le cambia con él si el reparto sigue igualado
local function onFriendship(newcomer, friend)
	if not isTeamMode() or ReplicatedStorage:GetAttribute("Infection") then
		return
	end
	if not newcomer.Parent or not friend.Parent or newcomer:GetAttribute("InMenu") ~= true then
		return
	end
	local target = friend.Team
	local current = newcomer.Team
	if not target or target == current or not table.find(teams, target) then
		return
	end
	local after = #target:GetPlayers() + 1
	local left = current and (#current:GetPlayers() - 1) or 0
	if current == nil or math.abs(after - left) <= 1 then
		newcomer.Team = target
	end
end

-- QA: acabar el descanso ya (la partida empieza con la siguiente comprobación de la cuenta atrás)
function Round.QAStartNow()
	if ReplicatedStorage:GetAttribute("State") == "Intermission" then
		qaStartNow = true
		return true
	end
	return false
end

-- QA: terminar la partida en curso. winnerIndex 1 o 2 = gana ese equipo (se le pone un punto por
-- delante); nil = acaba con el marcador que haya. La partida termina por el camino normal (resultados,
-- premios y pantalla final incluidos). En Eliminación / Buscar y destruir acaba al terminar la ronda
-- corta en curso.
function Round.QAEnd(winnerIndex)
	if ReplicatedStorage:GetAttribute("State") ~= "Playing" then
		return false
	end
	local winner = winnerIndex and teams[winnerIndex]
	if winner and isTeamMode() then
		local other = teams[winnerIndex == 1 and 2 or 1]
		local lead = getScore(winner.Name) - getScore(other.Name)
		if lead <= 0 then
			addScore(winner, 1 - lead)
		end
	end
	roundOver = true
	return true
end

function Round.Init()
	Friends.OnFriendship = onFriendship
	Players.RespawnTime = GameConfig.RespawnTime
	setupTeams()
	startMode("TDM")
	setState("Intermission")
	ReplicatedStorage:SetAttribute("TimeLeft", GameConfig.IntermissionTime)
	Flags.OnCapture = function(_, team)
		addScore(team, 1)
	end
	Hardpoint.OnScore = function(team, amount)
		addScore(team, amount)
	end
	Domination.OnScore = function(team, amount)
		addScore(team, amount)
	end
	-- Calabazas: quién puede recogerlas (jugadores vivos en partida y bots) y qué pasa al recogerlas
	Pumpkins.Collectors = function()
		local list = {}
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and humanoid and humanoid.Health > 0 and player.Team and not player:GetAttribute("InMenu") then
				table.insert(list, { Position = root.Position, Team = player.Team, Player = player })
			end
		end
		for _, agent in Combat.BotsByName do
			if agent.Root and agent.Root.Parent and agent.Humanoid and agent.Humanoid.Health > 0 and agent.Team then
				table.insert(list, { Position = agent.Root.Position, Team = agent.Team, Bot = agent })
			end
		end
		return list
	end
	Pumpkins.OnCollect = function(collector, confirmed, _, fromBot)
		if confirmed then
			addScore(collector.Team, 1)
		end
		local player = collector.Player
		if player then
			Remotes.Notify:FireClient(player, "Pumpkin", confirmed)
			-- (la calabaza de un bot vale menos, como la baja)
			local scale = fromBot and GameConfig.Bots.RewardScale or 1
			if confirmed then
				PlayerData.AddXP(player, math.floor((GameConfig.XP.PumpkinConfirm or 0) * scale), Pumpkins.Tags() and "🏷️ Baja confirmada" or "🎃 Calabaza confirmada")
				PlayerData.AddCoins(player, math.max(1, math.floor((GameConfig.Coins.Pumpkin or 2) * scale)))
				PlayerData.Track(player, "Pumpkin", 1)
			else
				PlayerData.AddXP(player, math.floor((GameConfig.XP.PumpkinDeny or 0) * scale), Pumpkins.Tags() and "🏷️ Placa recuperada" or "🎃 Calabaza recuperada")
			end
		end
	end

	Remotes.VoteMap.OnServerEvent:Connect(function(player, index)
		if ReplicatedStorage:GetAttribute("State") ~= "Intermission" then
			return
		end
		if type(index) ~= "number" or not voteOptions[index] then
			return
		end
		if votes[player] == index then
			return -- (repetir el mismo voto no cambia nada: no se vuelve a publicar)
		end
		votes[player] = index
		publishVotes()
	end)

	local function onPlayer(player)
		assignTeam(player)
		player.CharacterAdded:Connect(function(character)
			task.spawn(function()
				-- Revivir instantáneo: aparece donde murió; si no, punto normal (FFA)
				if not Respawn.ApplyRevive(player, character) then
					ffaSpawnFor(player, character)
				end
				if ReplicatedStorage:GetAttribute("Infection") == "On" and player.Team == teams[2] then
					zombify(player, character)
				end
			end)
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	Players.PlayerRemoving:Connect(function(player)
		votes[player] = nil
		streakVictims[player] = nil
		spawnedThisRound[player] = nil
		updateLeader(player)
	end)
	for _, player in Players:GetPlayers() do
		if not player.Team then
			onPlayer(player)
			Respawn.Load(player)
		end
	end

	task.spawn(gameLoop)
end

return Round
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="118">
          <Properties>
            <string name="Name">SpawnPicker</string>
            <string name="Source"><![CDATA[-- Apariciones dinámicas en los modos por equipos (como en los shooters de móvil): al reaparecer
-- no se vuelve siempre a la base, sino al punto del mapa (FFASpawn o una salida del equipo) más
-- seguro: lejos de los enemigos y, a ser posible, cerca de los compañeros. La primera aparición de
-- cada ronda sigue siendo en la base. Lo usan Round (jugadores) y Bots.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local SpawnPicker = {}

local MODES = { TDM = true, KOTH = true, CAL = true, DOM = true } -- (en bandera y eliminación, siempre en la base)
local SAFE_DISTANCE = 40 -- un enemigo más cerca que esto descarta el punto

local cache = { Map = nil, Free = {}, ByColor = {} }

local function points()
	local map = workspace:FindFirstChild("Map")
	if cache.Map ~= map then
		cache.Map, cache.Free, cache.ByColor = map, {}, {}
		if map then
			for _, d in map:GetDescendants() do
				if d:IsA("SpawnLocation") then
					local key = d.TeamColor.Name
					cache.ByColor[key] = cache.ByColor[key] or {}
					table.insert(cache.ByColor[key], d.Position)
				elseif d:IsA("BasePart") and d.Name == "FFASpawn" then
					table.insert(cache.Free, d.Position)
				end
			end
		end
	end
	return cache
end

-- ¿Se usan apariciones dinámicas ahora mismo?
function SpawnPicker.Enabled()
	return GameConfig.DynamicSpawns ~= false
		and ReplicatedStorage:GetAttribute("TeamMode") == true
		and MODES[ReplicatedStorage:GetAttribute("Mode") or ""] == true
		and not ReplicatedStorage:GetAttribute("Infection")
end

-- Mejor punto para alguien del equipo team (selfModel = su propio personaje, que no cuenta)
function SpawnPicker.Pick(team, selfModel)
	if not team then
		return nil
	end
	local data = points()
	local candidates = table.clone(data.Free)
	for _, p in data.ByColor[team.TeamColor.Name] or {} do
		table.insert(candidates, p)
	end
	if #candidates == 0 then
		return nil
	end
	local enemies, friends = {}, {}
	local function add(model, modelTeam)
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local root = model:FindFirstChild("HumanoidRootPart")
		if model ~= selfModel and humanoid and humanoid.Health > 0 and root then
			table.insert(modelTeam == team.Name and friends or enemies, root.Position)
		end
	end
	for _, player in Players:GetPlayers() do
		if player.Character and player.Team and not player:GetAttribute("InMenu") then
			add(player.Character, player.Team.Name)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			add(model, model:GetAttribute("Team"))
		end
	end
	local best, bestScore = nil, -math.huge
	for _, point in candidates do
		local nearestEnemy, nearestFriend = math.huge, math.huge
		for _, p in enemies do
			nearestEnemy = math.min(nearestEnemy, (p - point).Magnitude)
		end
		for _, p in friends do
			nearestFriend = math.min(nearestFriend, (p - point).Magnitude)
		end
		local score = math.min(nearestEnemy, 140) - math.min(nearestFriend, 120) * 0.35 + math.random() * 12
		if nearestEnemy < SAFE_DISTANCE then
			score -= 1000 -- (solo si no queda otra)
		end
		if score > bestScore then
			best, bestScore = point, score
		end
	end
	return best
end

return SpawnPicker
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="119">
          <Properties>
            <string name="Name">TacKit</string>
            <string name="Source"><![CDATA[-- TacKit: kit modular de los mapas 5v5 (generación determinista por código, sin modelos de la
-- Toolbox). Junta la geometría (Geometry), los props (Props) y los materiales (Materials) y añade:
--   * Espejo exacto: TacKit.mirrored(fn) construye una mitad del mapa y la copia reflejada en
--     X = 0 (pieza a pieza: escaleras, huecos de puertas y carteles quedan bien). Así los dos equipos
--     tienen exactamente las mismas distancias a todo, y la mitad A y la B del mapa pueden ser
--     distintas (sitio A exterior y cálido, B interior y frío).
--   * Puntos de juego: zona de aparición integrada en el mapa (TacKit.spawnZone), sitios A y B que
--     sirven a los dos equipos (TacKit.site), puntos libres, puestos de bots, zonas y banderas.
-- Convención de los mapas nuevos: el equipo 1 (Rojo) sale en -X y el 2 (Azul) en +X; el sitio A
-- está en -Z y el B en +Z.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Kit = require(script.Parent.MapKit)
local Materials = require(script.Materials)
local Geometry = require(script.Geometry)
local Props = require(script.Props)
local Town = require(script.Town)
local Airport = require(script.Airport)
local Mall = require(script.Mall)
local Rail = require(script.Rail)
local Military = require(script.Military)
local Port = require(script.Port)
local Industrial = require(script.Industrial)
local Finish = require(script.Finish)

local T = {}
for k, v in Geometry do
	T[k] = v
end
for k, v in Props do
	T[k] = v
end
for k, v in Town do
	T[k] = v
end
for k, v in Airport do
	T[k] = v
end
for k, v in Mall do
	T[k] = v
end
for k, v in Rail do
	T[k] = v
end
for k, v in Military do
	T[k] = v
end
for k, v in Port do
	T[k] = v
end
for k, v in Industrial do
	T[k] = v
end
T.Kit = Kit
T.Materials = Materials
T.G = Geometry
T.P = Props
T.Town = Town
T.Airport = Airport
T.Mall = Mall
T.Rail = Rail
T.Military = Military
T.Port = Port
T.Industrial = Industrial
T.F = Finish -- (acabados de la Fase 14: zonas de suelo, remates de fachada, lonas, fondo)

local V = Vector3.new
local RGB = Color3.fromRGB

---------------------------------------------------------------------------
-- Empezar un mapa
---------------------------------------------------------------------------

-- Crea la carpeta del mapa, elige la luz (con sus variantes) y la paleta. def = la tabla del mapa
-- (Name, Lighting, LightingVariants, Palette, Ambience)
function T.begin(def)
	local folder = Kit.Begin(def.Name, { Realistic = true })
	Materials.use(def.Palette or def.Id)
	Kit.applyLighting(Kit.pickLighting(def))
	folder:SetAttribute("Variant", Kit.Variant)
	folder:SetAttribute("Weather", Kit.Weather)
	if def.Ambience then
		folder:SetAttribute("Ambience", def.Ambience) -- (sonido ambiente: ver Ambience en el cliente)
	end
	folder:SetAttribute("Kit", "TacKit")
	return folder
end

-- ¿Es de noche en esta partida? (ventanas encendidas, focos)
function T.isNight()
	return Kit.Variant == "Noche"
end

---------------------------------------------------------------------------
-- Espejo
---------------------------------------------------------------------------

-- Reflejo en el plano X = 0 de una posición y de un CFrame (la rotación R pasa a S·R·S, que para
-- una caja, un cilindro tumbado en X o una cuña es exactamente la pieza reflejada)
function T.mirrorPoint(p)
	return V(-p.X, p.Y, p.Z)
end

function T.mirrorCFrame(cf)
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	return CFrame.new(-x, y, z, r00, -r01, -r02, -r10, r11, r12, -r20, r21, r22)
end

local SWAP_FACE = {
	[Enum.NormalId.Left] = Enum.NormalId.Right,
	[Enum.NormalId.Right] = Enum.NormalId.Left,
}

local function mirrorInstance(inst)
	if inst:IsA("BasePart") then
		inst.CFrame = T.mirrorCFrame(inst.CFrame)
	elseif inst:IsA("SurfaceGui") or inst:IsA("SpotLight") or inst:IsA("SurfaceLight") or inst:IsA("Decal") or inst:IsA("Texture") then
		-- (las caras izquierda y derecha se cambian; el texto no sale al revés)
		local face = (inst :: any).Face
		if SWAP_FACE[face] then
			(inst :: any).Face = SWAP_FACE[face]
		end
	elseif inst:IsA("Attachment") then
		local p = inst.Position
		inst.Position = V(-p.X, p.Y, p.Z)
	end
	for _, name in { "Look", "OrbitCenter", "OrbitAxis", "OrbitAnchor" } do
		local value = inst:GetAttribute(name)
		if typeof(value) == "Vector3" then
			inst:SetAttribute(name, T.mirrorPoint(value))
		end
	end
	-- (los giros cambian de sentido en el reflejo)
	for _, name in { "Spin", "Orbit" } do
		local value = inst:GetAttribute(name)
		if type(value) == "number" then
			inst:SetAttribute(name, -value)
		end
	end
end

-- Mueve el contenido de las carpetas especiales (Callouts, Boundary) de una mitad a las del mapa
local SPECIAL = { Callouts = true, Boundary = true }
local function mergeSpecial(half, map)
	for _, child in half:GetChildren() do
		if child:IsA("Folder") and SPECIAL[child.Name] then
			local target = map:FindFirstChild(child.Name)
			if not target then
				target = Instance.new("Folder")
				target.Name = child.Name
				target.Parent = map
			end
			for _, item in child:GetChildren() do
				item.Parent = target
			end
			child:Destroy()
		end
	end
end

-- Construye con fn la mitad del equipo 1 (X < 0) y la copia reflejada para el equipo 2. fn no debe
-- tocar el terreno (eso no se copia): para eso, T.terrain fuera del espejo.
function T.mirrored(name, fn)
	local map = Kit.folder
	local half = Instance.new("Folder")
	half.Name = name .. "_Red"
	half.Parent = map
	Kit.folder = half
	local ok, err = pcall(fn)
	Kit.folder = map
	if not ok then
		error(err, 0)
	end
	local copy = half:Clone()
	copy.Name = name .. "_Blue"
	for _, inst in copy:GetDescendants() do
		mirrorInstance(inst)
	end
	copy.Parent = map
	mergeSpecial(half, map)
	mergeSpecial(copy, map)
	return half, copy
end

---------------------------------------------------------------------------
-- Puntos de juego
---------------------------------------------------------------------------

-- Zona de aparición del equipo (1 o 2) integrada en el mapa: suelo con el color del equipo, las
-- SpawnLocations y el nombre «BASE ROJA». cf = centro; -Z local mira hacia el mapa (los jugadores
-- aparecen mirando hacia ahí). opts: Size = Vector2 (X, Z), Points = { Vector3 locales }
function T.spawnZone(teamIndex, cf, opts)
	opts = opts or {}
	local team = GameConfig.Teams[teamIndex]
	local teamColor = team.Color.Color
	local size = opts.Size or Vector2.new(30, 22)
	local floor = Kit.block(team.Name .. "SpawnFloor", V(size.X, 0.3, size.Y), cf * CFrame.new(0, 0.15, 0), opts.Floor or RGB(150, 146, 140), Enum.Material.Concrete)
	floor.CastShadow = false
	-- Marco pintado del color del equipo
	for _, s in { -1, 1 } do
		Kit.deco("SpawnPaint", V(size.X, 0.05, 0.6), cf * CFrame.new(0, 0.32, s * (size.Y / 2 - 0.5)), teamColor, Enum.Material.SmoothPlastic).Color = teamColor
		Kit.deco("SpawnPaint", V(0.6, 0.05, size.Y), cf * CFrame.new(s * (size.X / 2 - 0.5), 0.32, 0), teamColor, Enum.Material.SmoothPlastic).Color = teamColor
	end
	Kit.callout("BASE " .. (string.gsub(string.upper(team.Name), "O$", "A")), cf * CFrame.new(0, 10, 0), V(size.X + 10, 26, size.Y + 10))
	local points = opts.Points or {
		V(-10, 0, 2), V(-5, 0, -3), V(0, 0, 2), V(5, 0, -3), V(10, 0, 2),
	}
	for i, p in points do
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = team.Name .. "Spawn" .. i
		spawn.Anchored = true
		spawn.Size = V(5, 0.4, 5)
		spawn.CFrame = cf * CFrame.new(p + V(0, 0.35, 0))
		spawn.TeamColor = team.Color
		spawn.BrickColor = team.Color
		spawn.Material = Enum.Material.SmoothPlastic
		spawn.Transparency = 0.35
		spawn.CastShadow = false
		spawn.Neutral = false
		spawn.AllowTeamChangeOnTouch = false
		spawn.Duration = GameConfig.SpawnProtection
		spawn.Parent = Kit.folder
		local decal = spawn:FindFirstChildOfClass("Decal")
		if decal then
			decal:Destroy()
		end
	end
	return floor
end

-- Sitio de la bomba que sirve a los dos equipos (el que defienda en cada ronda): letra pintada en
-- el suelo, nombre de zona «SITIO A» y un BombSite por equipo en el mismo sitio.
-- position = centro a ras de suelo
function T.site(position, letter, opts)
	opts = opts or {}
	local radius = opts.Radius or 7
	-- (opts.Defender: el sitio es solo de ese equipo, en su mitad del mapa; si no, lo defiende el
	-- equipo que defienda en cada ronda y los atacantes esperan unos segundos: ver Round)
	if not opts.Defender then
		Kit.folder:SetAttribute("SharedSites", true)
	end
	for defender = 1, 2 do
		if opts.Defender and defender ~= opts.Defender then
			continue
		end
		local p = Kit.deco("BombSite", V(1, 1, 1), CFrame.new(position + V(0, 0.5, 0)), Kit.C.White, Enum.Material.SmoothPlastic)
		p.Transparency = 1
		p:SetAttribute("Letter", letter)
		p:SetAttribute("Defender", defender)
		p:SetAttribute("Radius", radius)
	end
	local box = Kit.callout("SITIO " .. letter, CFrame.new(position + V(0, 6, 0)), opts.Callout or V(radius * 2 + 14, 18, radius * 2 + 14))
	box:SetAttribute("Site", true) -- (el cliente solo lo nombra en Buscar y destruir)
	-- Letra pintada en el suelo y círculo de la zona de plantado
	local paint = Kit.deco("SiteLetter", V(7, 0.05, 7), CFrame.new(position + V(0, 0.05, 0)) * (opts.Turn or CFrame.new()), Kit.C.White, Enum.Material.SmoothPlastic)
	paint.Transparency = 1
	paint.CastShadow = false
	local color = opts.Color or RGB(205, 58, 40)
	local gui = Kit.sign(paint, Enum.NormalId.Top, letter, color, color)
	gui.LightInfluence = 1
	local label = gui:FindFirstChildOfClass("TextLabel")
	if label then
		label.TextTransparency = 0.1
		label.TextStrokeTransparency = 1
	end
	for i = 0, 11, 2 do
		local a = math.rad(i * 30)
		local mark = Kit.deco("SiteRing", V(0.6, 0.05, radius * 0.5), CFrame.new(position + V(math.cos(a) * radius, 0.04, math.sin(a) * radius)) * CFrame.Angles(0, -a, 0), color, Enum.Material.SmoothPlastic)
		mark.Color = color
		mark.CastShadow = false
	end
	return box
end

-- Caseta de base cerrada para el equipo 1 (en -X; la del 2 sale con T.mirrored): frente ciego hacia
-- el mapa en x = Front, fondo en x = Back, laterales en z = ±Half con una puerta junto al frente y
-- un muro interior (vestíbulo en L) detrás de cada puerta. Así no se ve la base desde fuera.
-- opts: Back, Front, Half, Height, Look, RoofLook, Stripe
function T.spawnHouse(opts)
	local G = Geometry
	local back, front = opts.Back or -150, opts.Front or -122.5
	local half, h = opts.Half or 24, opts.Height or 9
	local look = opts.Look or "Building"
	local length = front - back
	for _, z in { -half, half } do
		T.cap(G.wall(CFrame.new((back + front) / 2, 0, z), length, h, look, { G.door(length / 2 - 3, 5, 7.4) }))
		T.cap(G.wall(CFrame.new(front - 5.25, 0, z * (half - 4.56) / half), 10.5, h, look))
	end
	T.cap(G.wall(CFrame.new(front, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0), half * 2 + 0.6, h, look))
	T.cap(G.wall(CFrame.new(back + 0.5, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0), half * 2 + 0.6, h, look))
	T.cap(G.floor(CFrame.new((back + front) / 2, h + 0.6, 0), length + 0.5, half * 2 + 1, opts.RoofLook or "SteelDark", 0.6))
	if opts.Stripe then
		G.deco("BaseStripe", V(0.3, 1.2, half * 2 - 8), CFrame.new(front + 0.4, h - 2.5, 0), opts.Stripe)
	end
end

T.ffa = Kit.ffaSpawn
T.botSpot = Kit.botSpot
T.zone = Kit.zone
T.callout = Kit.callout
T.flagBase = function(teamIndex, cf)
	return Kit.flagBase(GameConfig.Teams[teamIndex], cf)
end

-- Muro invisible de borde entre dos puntos (dentro de Map.Boundary: no para balas ni la vista)
function T.boundaryWall(a, b, h)
	h = h or 60
	local folder = Kit.shootThroughFolder()
	local mid = (a + b) / 2
	local length = (b - a).Magnitude
	local wall = Kit.block("Boundary", V(2, h, length), CFrame.lookAt(V(mid.X, h / 2, mid.Z), V(b.X, h / 2, b.Z)), Color3.new(1, 1, 1), nil, folder)
	wall.Transparency = 1
	wall.CastShadow = false
	return wall
end

-- Tejado o remate que no se debe pisar (el supersalto llega a ~17 studs): un volumen invisible
-- encima, del tamaño de la pieza y hasta el techo del mapa. Va en Map.Boundary (no para balas ni
-- la vista), así que solo lo nota quien intenta subirse. part = la pieza (o lista de piezas)
T.CEILING = 60
-- Pieza inclinada (barandilla de escalera o de rampa): el clip va en tramos verticales de 2 studs,
-- cada uno desde lo más alto de la pieza en ese tramo (un clip girado se tumbaría sobre la escalera)
local function capTilted(part, cf, size)
	local axes = { cf.RightVector * size.X, cf.UpVector * size.Y, cf.LookVector * size.Z }
	local long, best = 1, -1
	for i, a in axes do
		local hl = V(a.X, 0, a.Z).Magnitude
		if hl > best then
			long, best = i, hl
		end
	end
	local d = axes[long]
	local length = V(d.X, 0, d.Z).Magnitude
	if length < 0.5 then
		return nil
	end
	local dir = V(d.X, 0, d.Z) / length
	local perp = V(-dir.Z, 0, dir.X)
	local width, extra = 0, 0
	for i, a in axes do
		if i ~= long then
			width += math.abs(a:Dot(perp))
			extra += math.abs(a.Y) / 2
		end
	end
	local slope = d.Y / length
	local center = cf.Position
	local n = math.max(1, math.ceil(length / 2))
	local first
	for i = 0, n - 1 do
		local s0 = -length / 2 + length * i / n
		local s1 = -length / 2 + length * (i + 1) / n
		local top = center.Y + math.max(slope * s0, slope * s1) + extra
		if top < T.CEILING - 1 then
			local h = T.CEILING - top
			local mid = center + dir * ((s0 + s1) / 2)
			local flat = CFrame.lookAt(V(mid.X, top + h / 2, mid.Z), V(mid.X, top + h / 2, mid.Z) + dir)
			local clip = Kit.block("PlayerClip", V(width + 0.4, h, (s1 - s0) + 0.05), flat, Color3.new(1, 1, 1), nil, Kit.shootThroughFolder())
			clip.Transparency = 1
			clip.CastShadow = false
			first = first or clip
		end
	end
	return first
end

function T.cap(part)
	if typeof(part) == "table" then
		for _, p in part do
			T.cap(p)
		end
		return
	end
	if not part then
		return
	end
	if part:IsA("Model") then
		-- (contenedor: se tapa su cuerpo)
		return T.cap(part:FindFirstChild("Body"))
	end
	local cf, size = part.CFrame, part.Size
	if math.abs(cf.UpVector.Y) < 0.995 then
		return capTilted(part, cf, size)
	end
	-- Altura de la cara de arriba (piezas giradas solo en Y)
	local top = cf.Position.Y + math.abs(cf.UpVector.Y) * size.Y / 2
	if top >= T.CEILING - 1 then
		return
	end
	local h = T.CEILING - top
	local flat = CFrame.new(cf.Position.X, top + h / 2, cf.Position.Z) * (cf - cf.Position)
	local clip = Kit.block("PlayerClip", V(size.X + 0.4, h, size.Z + 0.4), flat, Color3.new(1, 1, 1), nil, Kit.shootThroughFolder())
	clip.Transparency = 1
	clip.CastShadow = false
	return clip
end

Mall.capHook = T.cap
Geometry.capHook = T.cap

-- Terreno: relleno bajo el mapa (para que nada flote) y colinas de fondo
function T.terrain(material, sx, sz, cf)
	workspace.Terrain:FillBlock((cf or CFrame.new()) * CFrame.new(0, -3, 0), V(sx, 6, sz), material)
end

return T
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="120">
            <Properties>
              <string name="Name">Airport</string>
              <string name="Source"><![CDATA[-- Piezas de aeropuerto (Terminal): avión de pasajeros estilizado, carros de equipaje con tractor,
-- furgoneta de servicio, contenedor de carga aérea (ULD), camión cisterna, escalerilla, torre de
-- focos de plataforma y torre de control (decorado). cf = centro de la base, "cara" hacia -Z.
local Kit = require(script.Parent.Parent.MapKit)
local Materials = require(script.Parent.Materials)
local G = require(script.Parent.Geometry)

local Airport = {}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad
local get = Materials.get
local M = Enum.Material

local WHITE = { RGB(240, 242, 246), M.SmoothPlastic }
local GRAY = { RGB(178, 184, 192), M.Metal }

-- Cilindro tumbado a lo largo de Z local (eje del fuselaje)
local function tube(name, length, d, cf, look, solid)
	look = get(look)
	local part = Kit.pipe(name, length, d, cf * CFrame.Angles(0, rad(90), 0), look[1], look[2], not solid)
	return part
end

-- Avión de pasajeros: el morro mira a -Z. Fuselaje (choca: es la gran cobertura del centro), alas
-- y motores (los motores chocan: cobertura baja-media), deriva con la franja azul. Devuelve las
-- piezas que chocan (para taparlas por arriba).
function Airport.airliner(cf, opts)
	opts = opts or {}
	local length = opts.Length or 64
	local d = opts.Diameter or 9
	local stripe = opts.Stripe or RGB(40, 92, 190)
	local bottom = opts.Bottom or 2.6
	local cy = bottom + d / 2
	local solids = {}
	-- Fuselaje (dos tramos: el central recto y la cola que se estrecha)
	table.insert(solids, tube("Fuselage", length * 0.72, d, cf * CFrame.new(0, cy, -length * 0.08), WHITE, true))
	for i, spec in { { 0.82, 0.62 }, { 0.62, 0.42 } } do
		local seg = length * 0.1
		tube("FuselageTail", seg, d * spec[1], cf * CFrame.new(0, cy + d * (1 - spec[1]) * 0.35 * i, length * 0.28 + (i - 0.5) * seg), WHITE)
	end
	-- Morro: media esfera y cabina
	local nose = Kit.ball("Nose", d, cf * CFrame.new(0, cy, -length * 0.44), WHITE[1], WHITE[2], false)
	table.insert(solids, nose)
	G.deco("Cockpit", V(d * 0.62, d * 0.16, 2.2), cf * CFrame.new(0, cy + d * 0.18, -length * 0.44 - d * 0.3) * CFrame.Angles(rad(-25), 0, 0), { RGB(30, 40, 52), M.Glass })
	-- Franja de ventanillas y franja azul inferior
	for _, s in { -1, 1 } do
		G.deco("Windows", V(0.2, 0.7, length * 0.6), cf * CFrame.new(s * (d / 2 - 0.05), cy + d * 0.12, -length * 0.08), { RGB(36, 44, 56), M.Glass }).CastShadow = false
		G.deco("Cheatline", V(0.2, 0.5, length * 0.68), cf * CFrame.new(s * (d / 2 - 0.1), cy - d * 0.12, -length * 0.08), { stripe, M.SmoothPlastic }).CastShadow = false
		G.deco("PlaneDoor", V(0.25, 4.2, 2.4), cf * CFrame.new(s * (d / 2), cy + 0.6, -length * 0.36), GRAY).CastShadow = false
	end
	-- Alas (barridas hacia atrás) con winglets; motores colgados
	for _, s in { -1, 1 } do
		local root = cf * CFrame.new(s * d * 0.45, bottom + d * 0.22, length * 0.02)
		local span = opts.Span or 34
		local wing = G.deco("Wing", V(span, 0.9, 9), root * CFrame.new(s * span / 2, 0, 3) * CFrame.Angles(0, s * rad(-22), 0) * CFrame.Angles(0, 0, s * rad(5)), WHITE)
		wing.CastShadow = true
		G.deco("Winglet", V(0.5, 4, 3), root * CFrame.new(s * (span - 1), 2.4, 3 + span * 0.4) * CFrame.Angles(0, s * rad(-22), 0), { stripe, M.SmoothPlastic })
		local engine = tube("Engine", 8, 4.6, cf * CFrame.new(s * (d * 0.45 + 10), bottom + 0.2 + 2.3 - 0.4, -length * 0.02), GRAY, true)
		table.insert(solids, engine)
		tube("EngineIntake", 0.6, 4.2, cf * CFrame.new(s * (d * 0.45 + 10), bottom + 2.1, -length * 0.02 - 4.2), { RGB(40, 42, 48), M.Metal })
		G.deco("Pylon", V(0.8, 2.4, 5), cf * CFrame.new(s * (d * 0.45 + 10), bottom + 4.8, length * 0.0), GRAY)
		-- Estabilizador horizontal de cola
		G.deco("Stabilizer", V(13, 0.6, 5), cf * CFrame.new(s * 7.5, cy + 1.6, length * 0.4) * CFrame.Angles(0, s * rad(-25), 0), WHITE)
	end
	-- Deriva (con el color de la compañía)
	G.deco("Fin", V(0.8, 13, 9), cf * CFrame.new(0, cy + d * 0.4 + 6, length * 0.42) * CFrame.Angles(rad(-28), 0, 0), { stripe, M.SmoothPlastic })
	-- Tren de aterrizaje
	G.deco("NoseGear", V(0.6, bottom + 0.4, 0.6), cf * CFrame.new(0, (bottom + 0.4) / 2, -length * 0.36), "SteelDark")
	tube("NoseWheel", 0.8, 1.6, cf * CFrame.new(0, 0.8, -length * 0.36) * CFrame.Angles(0, rad(90), 0), { RGB(24, 24, 26), M.Rubber })
	for _, s in { -1, 1 } do
		G.deco("MainGear", V(0.8, bottom + 1, 0.8), cf * CFrame.new(s * 4, (bottom + 1) / 2, length * 0.06), "SteelDark")
		for _, z in { -0.9, 0.9 } do
			Kit.pipe("MainWheel", 1, 2.2, cf * CFrame.new(s * 4, 1.1, length * 0.06 + z), RGB(24, 24, 26), M.Rubber, true)
		end
	end
	-- Balizas
	for _, p in { V(-38, bottom + 3, 6), V(38, bottom + 3, 6) } do
		local light = Kit.ball("NavLight", 0.6, cf * CFrame.new(p), p.X < 0 and RGB(255, 40, 40) or RGB(40, 255, 90), M.Neon, true)
		light:SetAttribute("Blink", 1)
	end
	return solids
end

-- Carro de equipaje (cobertura baja-media) con maletas y lona
function Airport.baggageCart(cf, tarp)
	local body = G.box("BagCart", V(4.4, 1, 7), cf * CFrame.new(0, 1.2, 0), "SteelDark")
	G.box("BagLoad", V(4, 2.6, 6.4), cf * CFrame.new(0, 3, 0), { tarp or RGB(60, 90, 140), M.Fabric })
	for _, x in { -2, 2 } do
		for _, z in { -2.6, 2.6 } do
			Kit.pipe("CartWheel", 0.5, 1.2, cf * CFrame.new(x, 0.6, z), RGB(24, 24, 26), M.Rubber, true)
		end
	end
	G.deco("CartBar", V(0.3, 0.3, 2), cf * CFrame.new(0, 1, -4.4), "SteelDark")
	return body
end

-- Tractor de remolque (amarillo)
function Airport.tug(cf)
	local body = G.box("Tug", V(4.6, 2.6, 6), cf * CFrame.new(0, 1.7, 0), { RGB(232, 180, 30), M.Metal })
	G.deco("TugSeat", V(3, 2.2, 2), cf * CFrame.new(0, 4, 1.2), "SteelDark")
	G.deco("TugRoof", V(4.2, 0.3, 3.2), cf * CFrame.new(0, 5.4, 1), "SteelDark")
	for _, x in { -2.3, 2.3 } do
		for _, z in { -2, 2 } do
			Kit.pipe("TugWheel", 0.8, 1.8, cf * CFrame.new(x, 0.9, z), RGB(24, 24, 26), M.Rubber, true)
		end
	end
	local beacon = Kit.ball("TugBeacon", 0.5, cf * CFrame.new(0, 5.8, 1), RGB(255, 160, 30), M.Neon, true)
	beacon:SetAttribute("Blink", 1)
	return body
end

-- Tren de carros detrás de un tractor (count carros)
function Airport.baggageTrain(cf, count)
	Airport.tug(cf)
	for i = 1, count do
		Airport.baggageCart(cf * CFrame.new(0, 0, 4 + i * 8.2), i % 2 == 0 and RGB(150, 60, 50) or RGB(60, 90, 140))
	end
end

-- Furgoneta de servicio (blanca, cobertura alta)
function Airport.van(cf, stripe)
	local body = G.box("Van", V(5.4, 5.4, 11), cf * CFrame.new(0, 3.3, 0.5), WHITE)
	G.box("VanCab", V(5.4, 3.6, 3), cf * CFrame.new(0, 2.4, -6.4), WHITE)
	G.deco("VanGlass", V(5, 1.6, 0.2), cf * CFrame.new(0, 4.6, -5.1), { RGB(40, 50, 62), M.Glass })
	G.deco("VanStripe", V(5.5, 0.6, 11.1), cf * CFrame.new(0, 2.6, 0.5), { stripe or RGB(220, 120, 30), M.SmoothPlastic })
	for _, x in { -2.5, 2.5 } do
		for _, z in { -5.4, 3.6 } do
			Kit.pipe("VanWheel", 0.8, 2, cf * CFrame.new(x, 1, z), RGB(24, 24, 26), M.Rubber, true)
		end
	end
	Kit.contactShadow(cf, 5.8, 14)
	return body
end

-- Contenedor de carga aérea (ULD): forma con el chaflán arriba (cobertura alta)
function Airport.uld(cf, look)
	look = get(look or "ContainerBlue")
	local body = G.box("ULD", V(6, 5.4, 5), cf * CFrame.new(0, 2.9, 0), look)
	G.deco("ULDBase", V(6.2, 0.4, 5.2), cf * CFrame.new(0, 0.2, 0), "SteelDark")
	G.deco("ULDDoor", V(5, 4, 0.1), cf * CFrame.new(0, 3, -2.55), { RGB(40, 44, 50), M.Fabric })
	G.deco("ULDRib", V(0.25, 5.4, 5.1), cf * CFrame.new(-1.5, 2.9, 0), { look[1]:Lerp(Color3.new(0, 0, 0), 0.3), M.Metal })
	G.deco("ULDRib", V(0.25, 5.4, 5.1), cf * CFrame.new(1.5, 2.9, 0), { look[1]:Lerp(Color3.new(0, 0, 0), 0.3), M.Metal })
	return body
end

-- Camión cisterna de combustible (cobertura alta y larga)
function Airport.fuelTruck(cf)
	G.box("FuelCab", V(5.2, 5, 4.4), cf * CFrame.new(0, 3, -7.6), WHITE)
	G.deco("FuelGlass", V(4.8, 1.6, 0.2), cf * CFrame.new(0, 4.4, -9.85), { RGB(40, 50, 62), M.Glass })
	local tank = tube("FuelTank", 12, 5, cf * CFrame.new(0, 4, 1.4), { RGB(226, 228, 232), M.Metal }, true)
	G.box("FuelChassis", V(4.6, 1.2, 17), cf * CFrame.new(0, 1.4, -1), "SteelDark")
	G.deco("FuelStripe", V(5.1, 0.8, 12.1), cf * CFrame.new(0, 3, 1.4), { RGB(214, 60, 40), M.SmoothPlastic })
	for _, x in { -2.3, 2.3 } do
		for _, z in { -7.5, 3, 6.4 } do
			Kit.pipe("FuelWheel", 0.9, 2.2, cf * CFrame.new(x, 1.1, z), RGB(24, 24, 26), M.Rubber, true)
		end
	end
	return tank
end

-- Torre de focos de plataforma (alta, luz cálida hacia -Z y abajo)
function Airport.apronLight(cf, h)
	h = h or 24
	G.column(cf, h, 1, "SteelDark", "ApronMast")
	G.deco("ApronHead", V(6, 1.4, 1.2), cf * CFrame.new(0, h + 0.7, -0.4), "SteelDark")
	for _, x in { -2, 0, 2 } do
		local lamp = G.deco("ApronLamp", V(1.6, 1, 0.3), cf * CFrame.new(x, h + 0.6, -1.1) * CFrame.Angles(rad(-30), 0, 0), { RGB(255, 236, 200), M.Neon })
		if x == 0 then
			Kit.light(lamp, "SpotLight", RGB(255, 228, 190), 60, 2, Enum.NormalId.Front).Angle = 90
		end
	end
end

-- Deflector de chorro: pantalla de rejilla inclinada sobre un murete (cobertura alta, cara -Z)
function Airport.blastFence(cf, length)
	length = length or 16
	local base = G.box("BlastBase", V(length, 3, 1.4), cf * CFrame.new(0, 1.5, 0), "Concrete")
	local panel = G.box("BlastPanel", V(length, 6, 0.5), cf * CFrame.new(0, 5.6, 1.2) * CFrame.Angles(rad(-22), 0, 0), { RGB(190, 196, 204), M.DiamondPlate })
	panel.CastShadow = true
	for x = -length / 2 + 1, length / 2 - 1, 4 do
		G.deco("BlastStrut", V(0.4, 7, 0.4), cf * CFrame.new(x, 4, 2.4) * CFrame.Angles(rad(30), 0, 0), "SteelDark")
	end
	return base
end

-- Grupo de energía de tierra (caja amarilla con ruedas: cobertura baja)
function Airport.gpu(cf)
	local body = G.box("GPU", V(3.4, 3, 5), cf * CFrame.new(0, 2, 0), { RGB(230, 180, 40), M.Metal })
	for _, x in { -1.6, 1.6 } do
		for _, z in { -1.8, 1.8 } do
			Kit.pipe("GPUWheel", 0.5, 1, cf * CFrame.new(x, 0.5, z), RGB(24, 24, 26), M.Rubber, true)
		end
	end
	G.deco("GPUCable", V(0.3, 0.3, 6), cf * CFrame.new(0, 0.3, -5.5), "Black")
	return body
end

-- Cinta cargadora de equipaje (camión bajo con cinta inclinada)
function Airport.beltLoader(cf)
	local body = G.box("BeltLoader", V(4, 2.2, 10), cf * CFrame.new(0, 1.6, 0), { RGB(230, 180, 40), M.Metal })
	G.deco("Belt", V(2.6, 0.5, 13), cf * CFrame.new(0, 4.4, -2) * CFrame.Angles(rad(18), 0, 0), "SteelDark")
	for _, x in { -2, 2 } do
		for _, z in { -3.5, 3.5 } do
			Kit.pipe("LoaderWheel", 0.6, 1.4, cf * CFrame.new(x, 0.7, z), RGB(24, 24, 26), M.Rubber, true)
		end
	end
	return body
end

-- Torre de control (decorado alto, fuera del área de juego): fuste, cabina octogonal de cristal
function Airport.controlTower(cf, h)
	h = h or 70
	Kit.cylinder("TowerShaft", h, 9, cf * CFrame.new(0, h / 2, 0), RGB(206, 208, 212), M.Concrete, nil, true)
	Kit.cylinder("TowerBand", 2, 11, cf * CFrame.new(0, h * 0.4, 0), RGB(150, 154, 160), M.Concrete, nil, true)
	Kit.cylinder("CabFloor", 2, 20, cf * CFrame.new(0, h + 1, 0), RGB(120, 124, 130), M.Concrete, nil, true)
	local cab = Kit.cylinder("CabGlass", 7, 19, cf * CFrame.new(0, h + 5.5, 0), RGB(70, 110, 140), M.Glass, nil, true)
	cab.Transparency = 0.15
	Kit.cylinder("CabRoof", 1.6, 21, cf * CFrame.new(0, h + 9.8, 0), RGB(80, 84, 90), M.Metal, nil, true)
	Kit.cylinder("Antenna", 8, 0.6, cf * CFrame.new(0, h + 14.6, 0), RGB(200, 60, 50), M.Metal, nil, true)
	local beacon = Kit.ball("TowerBeacon", 1, cf * CFrame.new(0, h + 19, 0), RGB(255, 40, 30), M.Neon, true)
	beacon:SetAttribute("Blink", 1)
	G.deco("TowerBalcony", V(24, 0.6, 24), cf * CFrame.new(0, h - 0.4, 0) * CFrame.Angles(0, rad(22.5), 0), "SteelDark")
end

-- Escalerilla de embarque (decorado con cuerpo que choca: cobertura)
function Airport.airstairs(cf)
	local body = G.box("StairTruck", V(4.6, 2, 9), cf * CFrame.new(0, 1.6, 0), WHITE)
	G.deco("StairFlight", V(3.6, 0.6, 11), cf * CFrame.new(0, 5, -0.5) * CFrame.Angles(rad(30), 0, 0), GRAY)
	for _, s in { -1, 1 } do
		G.deco("StairRail", V(0.2, 0.2, 11), cf * CFrame.new(s * 1.8, 6.6, -0.5) * CFrame.Angles(rad(30), 0, 0), "SteelDark")
	end
	return body
end

return Airport
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="121">
            <Properties>
              <string name="Name">Finish</string>
              <string name="Source"><![CDATA[-- Acabados de los mapas (Fase 14, pulido visual): piezas grandes y baratas que hacen que un mapa
-- parezca diseñado y no un bloque gris: zonas de suelo con material propio, remates y pilastras de
-- fachada (ritmo y profundidad en muros largos), encofrados de obra, lonas con texto, toldos,
-- macetas y siluetas de fondo (gasómetros, esqueletos de edificio). Todo es DECORADO: no choca ni
-- para balas (G.deco), así que no cambia rutas, coberturas ni líneas de tiro.
--
-- Nombres de pieza: los detalles finos usan nombres de Settings.HIDE_BELOW (se ocultan en calidad
-- Baja); lo que da forma al mapa (zonas de suelo, remates, fondo) se ve siempre.
local Kit = require(script.Parent.Parent.MapKit)
local Materials = require(script.Parent.Materials)
local G = require(script.Parent.Geometry)

local F = {}

local V = Vector3.new
local CF = CFrame.new
local M = Enum.Material
local get = Materials.get

---------------------------------------------------------------------------
-- Suelo
---------------------------------------------------------------------------

-- Zona de suelo (pavimento, grava, asfalto...) sobre el suelo del mapa: lámina de 0,02 que queda por
-- DEBAJO de juntas (0,03), líneas pintadas (0,04) y marcas de los sitios (0,05+), así todo eso se
-- sigue viendo encima. cf = centro a ras de suelo; gira con cf.
function F.groundZone(cf, sx, sz, look, name)
	local part = G.deco(name or "GroundZone", V(sx, 0.02, sz), cf * CF(0, 0.01, 0), look)
	part.CastShadow = false
	return part
end

-- Bordillo pintado de una zona (cuatro tiras finas en el perímetro): marca el cambio de suelo
function F.zoneEdge(cf, sx, sz, look, width)
	width = width or 0.35
	for _, spec in { { V(sx, 0.035, width), V(0, 0, -sz / 2) }, { V(sx, 0.035, width), V(0, 0, sz / 2) }, { V(width, 0.035, sz), V(-sx / 2, 0, 0) }, { V(width, 0.035, sz), V(sx / 2, 0, 0) } } do
		G.deco("ZoneEdge", spec[1], cf * CF(spec[2] + V(0, 0.0175, 0)), look).CastShadow = false
	end
end

---------------------------------------------------------------------------
-- Fachadas
---------------------------------------------------------------------------

-- Remate horizontal a lo largo de una fachada (cornisa, zócalo, franja de color): de a a b (puntos a
-- ras de la cara del muro, a la altura de su base), sobresale `depth` hacia `outward`.
function F.band(a, b, y, h, depth, look, outward, name)
	local length = (b - a).Magnitude
	local mid = (a + b) / 2 + outward * (depth / 2) + V(0, y + h / 2, 0)
	local part = G.deco(name or "FacadeBand", V(depth, h, length), CFrame.lookAt(mid, mid + (b - a)) , look)
	part.CastShadow = false
	return part
end

-- Pilastras (franjas verticales) cada `spacing` a lo largo de una fachada, sin tapar los huecos.
-- skip = { { d0, d1 } } tramos (distancia desde a) donde no se ponen (puertas, ventanas)
function F.pilasters(a, b, spacing, y0, h, width, depth, look, outward, skip, name)
	local length = (b - a).Magnitude
	local dir = (b - a).Unit
	local count = 0
	for d = 0, length + 0.01, spacing do
		local blocked = false
		for _, s in skip or {} do
			if d > s[1] - width and d < s[2] + width then
				blocked = true
			end
		end
		if not blocked then
			local p = a + dir * d + outward * (depth / 2) + V(0, y0 + h / 2, 0)
			local part = G.deco(name or "Pilaster", V(width, h, depth), CFrame.lookAt(p, p + outward), look)
			part.CastShadow = false
			count += 1
		end
	end
	return count
end

-- Toldo inclinado sobre una puerta o ventana (cara visible hacia `outward`)
function F.awning(cf, w, depth, look, stripe)
	local cloth = G.deco("Awning", V(w, 0.25, depth), cf * CF(0, 0, -depth / 2) * CFrame.Angles(math.rad(-16), 0, 0), { get(look)[1], M.Fabric })
	cloth.CastShadow = false
	if stripe then
		G.deco("AwningStripe", V(w, 0.6, 0.28), cf * CF(0, -depth * 0.28 - 0.3, -depth + 0.05), { get(stripe)[1], M.Fabric }).CastShadow = false
	end
	return cloth
end

---------------------------------------------------------------------------
-- Pueblo
---------------------------------------------------------------------------

-- Banderines entre dos puntos (cuerda con banderitas de colores colgando): fiesta de pueblo. Muy
-- por encima de la cabeza; la cuerda y las banderas se ocultan en calidad Baja.
function F.bunting(a, b, colors, spacing)
	spacing = spacing or 2.2
	local length = (b - a).Magnitude
	local mid = (a + b) / 2
	G.deco("Wire", V(0.08, 0.08, length), CFrame.lookAt(mid, b), "Iron").CastShadow = false
	local n = math.max(1, math.floor(length / spacing))
	for i = 1, n - 1 do
		local t = i / n
		-- (la cuerda cuelga un poco en el centro)
		local sag = 0.6 * math.sin(math.pi * t)
		local p = a:Lerp(b, t) - V(0, sag + 0.45, 0)
		local flag = G.deco("Bunting", V(0.9, 0.9, 0.05), CFrame.lookAt(p, p + (b - a):Cross(V(0, 1, 0))) * CFrame.Angles(0, 0, math.rad(45)), { colors[(i % #colors) + 1], M.Fabric })
		flag.CastShadow = false
	end
end

-- Trepadora (buganvilla, hiedra) pegada a una fachada: mancha de hojas con un par de ramilletes
-- que sobresalen. cf = centro de la mancha, -Z = hacia fuera de la fachada
function F.climber(cf, w, h, look)
	local leaves = G.deco("Bougainvillea", V(w, h, 0.6), cf, look)
	leaves.CastShadow = false
	for _, spec in { { -0.3, 0.25 }, { 0.25, -0.2 } } do
		Kit.ball("Bougainvillea", math.min(w, h) * 0.45, cf * CF(spec[1] * w, spec[2] * h, -0.3), get(look)[1], get(look)[2], true).CastShadow = false
	end
	return leaves
end

---------------------------------------------------------------------------
-- Obra
---------------------------------------------------------------------------

-- Encofrado de madera alrededor de un pilar sin terminar (cf = centro de la base del encofrado)
function F.formwork(cf, w, h)
	local box = G.deco("Formwork", V(w, h, w), cf * CF(0, h / 2, 0), "Plywood")
	for _, y in { 0.2, h - 0.4 } do
		G.deco("FormworkClamp", V(w + 0.3, 0.25, w + 0.3), cf * CF(0, y + 0.12, 0), "SteelDark").CastShadow = false
	end
	return box
end

-- Lona grande con texto (malla de obra, publicidad de la promotora). La cara visible es -Z de cf.
function F.banner(cf, w, h, text, bg, fg, opts)
	opts = opts or {}
	local cloth = G.deco("MeshBanner", V(w, h, 0.2), cf, { bg, M.Fabric })
	cloth.CastShadow = false
	if text and text ~= "" then
		local gui = Kit.sign(cloth, Enum.NormalId.Front, text, fg, bg:Lerp(Color3.new(0, 0, 0), 0.5))
		gui.LightInfluence = 0.8
		gui.PixelsPerStud = opts.PPS or 10
		local label = gui:FindFirstChildOfClass("TextLabel")
		if label then
			label.Size = UDim2.fromScale(0.9, opts.TextScale or 0.6)
			label.Position = UDim2.fromScale(0.05, (1 - (opts.TextScale or 0.6)) / 2)
		end
	end
	if opts.Stripe then
		for _, s in { -1, 1 } do
			G.deco("BannerStripe", V(w, h * 0.08, 0.24), cf * CF(0, s * h * 0.42, 0), { opts.Stripe, M.Fabric }).CastShadow = false
		end
	end
	return cloth
end

---------------------------------------------------------------------------
-- Fondo (lejos, sin colisión ni sombra)
---------------------------------------------------------------------------

-- Gasómetro / depósito industrial: cilindro con aros y cúpula baja (silueta industrial del fondo)
function F.gasHolder(cf, d, h, look)
	look = get(look or "Steel")
	local body = Kit.cylinder("GasHolder", h, d, cf * CF(0, h / 2, 0), look[1], look[2], nil, true)
	body.CastShadow = false
	for _, y in { h * 0.33, h * 0.66 } do
		Kit.cylinder("GasHolderRing", 1, d + 0.8, cf * CF(0, y, 0), look[1]:Lerp(Color3.new(0, 0, 0), 0.3), M.Metal, nil, true).CastShadow = false
	end
	local dome = Kit.cylinder("GasHolderTop", 2, d * 0.85, cf * CF(0, h + 1, 0), look[1]:Lerp(Color3.new(1, 1, 1), 0.15), look[2], nil, true)
	dome.CastShadow = false
	return body
end

-- Esqueleto de edificio en obra (fondo): pilares y forjados sin muros, con una grúa encima si se pide
function F.skeleton(cf, w, d, floors, floorH, look)
	look = look or "Concrete"
	for f = 0, floors - 1 do
		local y = f * floorH
		G.deco("SkeletonSlab", V(w, 0.8, d), cf * CF(0, y + floorH, 0), look).CastShadow = false
		for _, p in { V(-w / 2 + 1, 0, -d / 2 + 1), V(w / 2 - 1, 0, -d / 2 + 1), V(-w / 2 + 1, 0, d / 2 - 1), V(w / 2 - 1, 0, d / 2 - 1) } do
			G.deco("SkeletonColumn", V(1.4, floorH, 1.4), cf * CF(p + V(0, y + floorH / 2, 0)), look).CastShadow = false
		end
	end
end

return F
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="122">
            <Properties>
              <string name="Name">Geometry</string>
              <string name="Source"><![CDATA[-- Geometría modular de los mapas 5v5: suelos y forjados (con huecos de escalera), muros con huecos
-- de verdad (puertas y ventanas por las que se ve y se dispara), cascarones de edificio, pilares,
-- vigas, escaleras, barandillas, pasarelas, andamios, vallas de obra y marcas de suelo.
--
-- Convenciones (escala de personaje Roblox: 5 de alto, 2 de ancho):
--   * cf = centro de la BASE de la pieza (lo que apoya en el suelo), salvo que se diga otra cosa.
--   * Plantas cada G.LEVEL (10): planta baja en 0, primera en 10, segunda en 20.
--   * Puertas de 6 de ancho y 8 de alto; pasillos de 8 o más; cobertura baja 3, media 4,5, alta 7+.
--   * look = { color, material } o el nombre de uno de la paleta activa (ver Materials).
local Kit = require(script.Parent.Parent.MapKit)
local Materials = require(script.Parent.Materials)

local G = {}
G.capHook = function(_part) end -- (TacKit lo cambia por T.cap: tapar por arriba lo que no se pisa)

local V = Vector3.new
local get = Materials.get

G.LEVEL = 10 -- altura entre plantas (forjado de 1 incluido: quedan 9 libres)
G.WALL_T = 1 -- grosor de muro
G.DOOR_W, G.DOOR_H = 6, 8

-- Pieza que choca y para las balas
function G.box(name, size, cf, look)
	look = get(look)
	return Kit.block(name, size, cf, look[1], look[2])
end

-- Pieza decorativa: no choca ni para balas (detalle pequeño)
function G.deco(name, size, cf, look)
	look = get(look)
	return Kit.deco(name, size, cf, look[1], look[2])
end

-- Bloque macizo apoyado en el suelo (cf = centro de la base)
function G.solid(name, size, cf, look)
	return G.box(name, size, cf * CFrame.new(0, size.Y / 2, 0), look)
end

---------------------------------------------------------------------------
-- Suelos y forjados
---------------------------------------------------------------------------

-- Losa con la cara de arriba a la altura de cf (grosor t)
function G.floor(cf, sx, sz, look, t)
	t = t or 1
	return G.box("Floor", V(sx, t, sz), cf * CFrame.new(0, -t / 2, 0), look)
end

-- Forjado con huecos (escaleras, patios de luz): holes = { { X, Z, SX, SZ } } en coordenadas
-- locales. Se parte en rectángulos (rejilla por los bordes de los huecos, unidos por filas).
function G.slab(cf, sx, sz, look, holes, t)
	t = t or 1
	if not holes or #holes == 0 then
		return { G.floor(cf, sx, sz, look, t) }
	end
	local xs, zs = { -sx / 2, sx / 2 }, { -sz / 2, sz / 2 }
	for _, h in holes do
		table.insert(xs, math.clamp(h[1] - h[3] / 2, -sx / 2, sx / 2))
		table.insert(xs, math.clamp(h[1] + h[3] / 2, -sx / 2, sx / 2))
		table.insert(zs, math.clamp(h[2] - h[4] / 2, -sz / 2, sz / 2))
		table.insert(zs, math.clamp(h[2] + h[4] / 2, -sz / 2, sz / 2))
	end
	table.sort(xs)
	table.sort(zs)
	local function inHole(x, z)
		for _, h in holes do
			if math.abs(x - h[1]) < h[3] / 2 and math.abs(z - h[2]) < h[4] / 2 then
				return true
			end
		end
		return false
	end
	local parts = {}
	for j = 1, #zs - 1 do
		local z0, z1 = zs[j], zs[j + 1]
		if z1 - z0 > 0.05 then
			local runStart = nil
			for i = 1, #xs do
				local x0, x1 = xs[i], xs[i + 1]
				local filled = x1 ~= nil and x1 - x0 > 0.001 and not inHole((x0 + x1) / 2, (z0 + z1) / 2)
				local empty = x1 ~= nil and x1 - x0 <= 0.001
				if filled then
					runStart = runStart or x0
				elseif not empty then
					if runStart and x0 - runStart > 0.05 then
						table.insert(parts, G.box("Floor", V(x0 - runStart, t, z1 - z0), cf * CFrame.new((runStart + x0) / 2, -t / 2, (z0 + z1) / 2), look))
					end
					runStart = nil
				end
			end
		end
	end
	return parts
end

---------------------------------------------------------------------------
-- Muros
---------------------------------------------------------------------------

-- Huecos: puerta (x = centro) y ventana (y0 = alféizar)
function G.door(x, w, h, y0)
	return { X = x, W = w or G.DOOR_W, Y0 = y0 or 0, Y1 = (y0 or 0) + (h or G.DOOR_H) }
end

function G.window(x, y0, w, h)
	return { X = x, W = w or 4, Y0 = y0 or 3.5, Y1 = (y0 or 3.5) + (h or 3.5) }
end

-- Muro a lo largo de su X local con huecos de verdad. cf = centro de la base; openings = lista de
-- G.door / G.window (X local). opts: T (grosor), Frame (look del marco de los huecos)
function G.wall(cf, length, height, look, openings, opts)
	opts = opts or {}
	local t = opts.T or G.WALL_T
	openings = openings or {}
	local columns = {}
	for _, o in openings do
		local column
		for _, c in columns do
			if math.abs(c.X - o.X) < 0.01 and math.abs(c.W - o.W) < 0.01 then
				column = c
			end
		end
		if not column then
			column = { X = o.X, W = o.W, Holes = {} }
			table.insert(columns, column)
		end
		table.insert(column.Holes, o)
	end
	table.sort(columns, function(a, b)
		return a.X < b.X
	end)
	local parts = {}
	local function piece(x0, x1, y0, y1)
		if x1 - x0 > 0.05 and y1 - y0 > 0.05 then
			table.insert(parts, G.box("Wall", V(x1 - x0, y1 - y0, t), cf * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, 0), look))
		end
	end
	local x = -length / 2
	for _, column in columns do
		local x0, x1 = column.X - column.W / 2, column.X + column.W / 2
		piece(x, x0, 0, height)
		table.sort(column.Holes, function(a, b)
			return a.Y0 < b.Y0
		end)
		local y = 0
		for _, o in column.Holes do
			piece(x0, x1, y, o.Y0)
			y = math.min(o.Y1, height)
			if opts.Frame then
				-- Marco: dintel y jambas finas (no chocan)
				G.deco("Frame", V(o.W + 0.6, 0.4, t + 0.2), cf * CFrame.new(o.X, math.min(o.Y1, height) - 0.2, 0), opts.Frame)
				for _, s in { -1, 1 } do
					G.deco("Frame", V(0.3, o.Y1 - o.Y0, t + 0.2), cf * CFrame.new(o.X + s * (o.W / 2 + 0.15), (o.Y0 + o.Y1) / 2, 0), opts.Frame)
				end
				if o.Y0 > 0.5 then
					G.deco("Sill", V(o.W + 0.6, 0.3, t + 0.4), cf * CFrame.new(o.X, o.Y0 - 0.15, 0), opts.Frame)
				end
			end
		end
		piece(x0, x1, y, height)
		x = x1
	end
	piece(x, length / 2, 0, height)
	return parts
end

-- Cascarón de edificio: cuatro muros de altura height con huecos por cara. sides = { Front, Back,
-- Left, Right } (listas de huecos; Front/Back con X del edificio, Left/Right con Z del edificio).
-- Front es la cara -Z local. Las medidas son exteriores. opts: T, Frame, Skip = { Left = true }
function G.shell(cf, sx, sz, height, look, sides, opts)
	opts = opts or {}
	sides = sides or {}
	local t = opts.T or G.WALL_T
	local skip = opts.Skip or {}
	if not skip.Front then
		G.wall(cf * CFrame.new(0, 0, -sz / 2 + t / 2), sx, height, look, sides.Front, opts)
	end
	if not skip.Back then
		G.wall(cf * CFrame.new(0, 0, sz / 2 - t / 2), sx, height, look, sides.Back, opts)
	end
	-- (los laterales van entre el frontal y el trasero; su X local = Z del edificio)
	local function side(list, x)
		local shifted = {}
		for _, o in list or {} do
			table.insert(shifted, { X = o.X, W = o.W, Y0 = o.Y0, Y1 = o.Y1 })
		end
		G.wall(cf * CFrame.new(x, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0), sz - 2 * t, height, look, shifted, opts)
	end
	if not skip.Left then
		side(sides.Left, -sx / 2 + t / 2)
	end
	if not skip.Right then
		side(sides.Right, sx / 2 - t / 2)
	end
end

-- Pretil (muro bajo de azotea o de terraza) entre dos puntos de la base
function G.parapet(a, b, h, look, t)
	t = t or 0.8
	local mid = (a + b) / 2
	local length = (b - a).Magnitude
	return G.box("Parapet", V(t, h, length + t), CFrame.lookAt(mid, b) * CFrame.new(0, h / 2, 0), look)
end

---------------------------------------------------------------------------
-- Estructura
---------------------------------------------------------------------------

-- Pilar (cf = centro de la base)
function G.column(cf, h, w, look, name)
	w = w or 1.6
	return G.box(name or "Column", V(w, h, w), cf * CFrame.new(0, h / 2, 0), look)
end

-- Viga entre dos puntos (centros de los extremos). deco = sin colisión
function G.beam(a, b, w, h, look, deco)
	local mid = (a + b) / 2
	local length = (b - a).Magnitude
	local cf = CFrame.lookAt(mid, b)
	if math.abs((b - a).Unit.Y) > 0.99 then
		cf = CFrame.new(mid) * CFrame.Angles(math.pi / 2, 0, 0)
	end
	local fn = deco and G.deco or G.box
	return fn("Beam", V(w, h, length), cf, look)
end

-- Perfil de acero en I (ala arriba y abajo y alma): para estructuras metálicas vistas
function G.ibeam(a, b, depth, look, deco)
	depth = depth or 1.2
	local mid = (a + b) / 2
	local length = (b - a).Magnitude
	local dir = (b - a).Unit
	local cf
	if math.abs(dir.Y) > 0.99 then
		cf = CFrame.new(mid) * CFrame.Angles(math.pi / 2, 0, 0)
	else
		cf = CFrame.lookAt(mid, b)
	end
	local fn = deco and G.deco or G.box
	local web = fn("SteelWeb", V(0.25, depth, length), cf, look)
	G.deco("SteelFlange", V(depth * 0.8, 0.22, length), cf * CFrame.new(0, depth / 2 - 0.11, 0), look)
	G.deco("SteelFlange", V(depth * 0.8, 0.22, length), cf * CFrame.new(0, -depth / 2 + 0.11, 0), look)
	return web
end

-- Pórtico de acero: pilares en I en las esquinas de una rejilla y vigas por arriba en cada nivel
-- (estructura sin terminar). cf = centro de la base; nx, nz = vanos; bay = luz de cada vano
function G.steelFrame(cf, nx, nz, bay, levels, levelH, look, opts)
	opts = opts or {}
	local sx, sz = nx * bay, nz * bay
	for i = 0, nx do
		for j = 0, nz do
			local p = cf * V(-sx / 2 + i * bay, 0, -sz / 2 + j * bay)
			G.ibeam(p, p + V(0, levels * levelH, 0), 1.2, look, opts.Deco)
		end
	end
	for l = 1, levels do
		local y = l * levelH - 0.6
		for j = 0, nz do
			G.ibeam(cf * V(-sx / 2, y, -sz / 2 + j * bay), cf * V(sx / 2, y, -sz / 2 + j * bay), 1.2, look, true)
		end
		for i = 0, nx do
			G.ibeam(cf * V(-sx / 2 + i * bay, y, -sz / 2), cf * V(-sx / 2 + i * bay, y, sz / 2), 1.2, look, true)
		end
	end
end

---------------------------------------------------------------------------
-- Escaleras, barandillas y pasarelas
---------------------------------------------------------------------------

-- Barandilla entre dos puntos del suelo (altura h): postes, pasamanos, barra media y rodapié. Choca
-- pero no para las balas ni la vista (va en Map.Boundary, como las de Kit.railing)
function G.railing(a, b, look, h, opts)
	opts = opts or {}
	h = h or 3.2
	look = get(look or "Yellow")
	local length = (b - a).Magnitude
	if length < 0.5 then
		return
	end
	local mid = (a + b) / 2
	local cf = CFrame.lookAt(mid, b)
	G.deco("Handrail", V(0.3, 0.3, length), cf * CFrame.new(0, h, 0), look)
	G.deco("MidRail", V(0.2, 0.2, length), cf * CFrame.new(0, h * 0.5, 0), look)
	if not opts.NoToe then
		G.deco("ToeBoard", V(0.12, 0.45, length), cf * CFrame.new(0, 0.25, 0), look)
	end
	local posts = math.max(1, math.floor(length / 3.5 + 0.5))
	for i = 0, posts do
		local p = a:Lerp(b, i / posts)
		G.deco("RailPost", V(0.3, h, 0.3), CFrame.new(p + V(0, h / 2, 0)), look)
	end
	local collider = Kit.block("RailCollider", V(0.5, h + 0.6, length), cf * CFrame.new(0, (h + 0.6) / 2, 0), look[1], nil, Kit.shootThroughFolder())
	collider.Transparency = 1
	collider.CastShadow = false
	if opts.Cap then
		-- (borde de un vacío: nadie salta por encima, ni con el supersalto)
		G.capHook(collider)
	end
	return collider
end

-- Escalera recta: bottom y top son puntos de la superficie (centro de la escalera). Cuerpo de
-- hormigón (la rampa sobre la que se camina, también para los bots) y peldaños vistos encima.
-- opts: Rails = "Both" | "Left" | "Right", RailLook, StepLook, Closed (rellena por debajo)
function G.stairs(bottom, top, width, look, opts)
	opts = opts or {}
	look = get(look)
	local flatDir = V(top.X - bottom.X, 0, top.Z - bottom.Z)
	local run = flatDir.Magnitude
	local rise = top.Y - bottom.Y
	local mid = (bottom + top) / 2
	local slopeLength = (top - bottom).Magnitude
	local cf = CFrame.lookAt(mid, top)
	-- Rampa (se camina por su cara de arriba, a ras de la línea bottom-top)
	local body = G.box("StairBody", V(width, 1, slopeLength + 0.6), cf * CFrame.new(0, -0.5, 0), look)
	local steps = math.max(3, math.floor(rise / 0.75 + 0.5))
	local stepRun, stepRise = run / steps, rise / steps
	local face = CFrame.lookAt(bottom, bottom + flatDir)
	local stepLook = opts.StepLook and get(opts.StepLook) or { look[1]:Lerp(Color3.new(1, 1, 1), 0.08), look[2] }
	for i = 0, steps - 1 do
		-- (cada peldaño asoma por encima de la rampa: su arista delantera toca la línea)
		local y = (i + 1) * stepRise
		local z = (i + 0.5) * stepRun
		local p = face * CFrame.new(0, y - stepRise / 2 - 0.05, -z)
		G.deco("Step", V(width, stepRise + 0.1, stepRun + 0.02), p, stepLook)
		if i % 2 == 0 then
			G.deco("StepNosing", V(width, 0.08, 0.25), face * CFrame.new(0, y + 0.01, -(i * stepRun) - 0.12), opts.NosingLook or "YellowPaint")
		end
	end
	if opts.Closed then
		-- Relleno de debajo (escalera maciza contra un muro): bloque en cuña con piezas escalonadas
		local slices = 4
		for i = 1, slices do
			local h = rise * (i - 0.5) / slices
			local z0 = run * (i - 1) / slices
			G.box("StairFill", V(width, h, run / slices), face * CFrame.new(0, h / 2 - 0.02, -(z0 + run / slices / 2)), look)
		end
	end
	local rails = opts.Rails
	if rails then
		local right = face.RightVector * (width / 2 - 0.2)
		local ext = flatDir.Unit * 0.4
		if rails == "Both" or rails == "Left" then
			G.railing(bottom - right - ext, top - right + ext, opts.RailLook, 3.2, { NoToe = true, Cap = opts.Cap })
		end
		if rails == "Both" or rails == "Right" then
			G.railing(bottom + right - ext, top + right + ext, opts.RailLook, 3.2, { NoToe = true, Cap = opts.Cap })
		end
	end
	return body
end

-- Pasarela recta entre a y b (puntos de la superficie, a la misma altura): tablero, perfiles a los
-- lados y barandillas. opts: Rails = { Left = bool, Right = bool } (por defecto las dos), Look,
-- Supports = separación de los pilares hasta el suelo (y = 0), Roof = look de la cubierta
function G.walkway(a, b, width, opts)
	opts = opts or {}
	local look = opts.Look or "Plywood"
	local mid = (a + b) / 2
	local length = (b - a).Magnitude
	local cf = CFrame.lookAt(mid, b)
	local deck = G.box("Walkway", V(width, 0.8, length), cf * CFrame.new(0, -0.4, 0), look)
	local edge = opts.EdgeLook or "Steel"
	for _, s in { -1, 1 } do
		G.deco("WalkwayEdge", V(0.4, 1, length), cf * CFrame.new(s * (width / 2 - 0.1), -0.6, 0), edge)
	end
	local rails = opts.Rails or { Left = true, Right = true }
	for side, s in { Left = -1, Right = 1 } do
		if rails[side] then
			local offset = cf.RightVector * s * (width / 2 - 0.25)
			G.railing(a + offset, b + offset, opts.RailLook, 3.2, { Cap = opts.Cap })
		end
	end
	if opts.Supports and a.Y > 2 then
		local count = math.max(1, math.floor(length / opts.Supports))
		for i = 0, count do
			local p = a:Lerp(b, i / count)
			for _, s in { -1, 1 } do
				local foot = p + cf.RightVector * s * (width / 2 - 0.4)
				G.beam(V(foot.X, 0, foot.Z), V(foot.X, p.Y - 0.8, foot.Z), 0.7, 0.7, edge)
			end
		end
	end
	return deck
end

---------------------------------------------------------------------------
-- Obra: andamios y vallas
---------------------------------------------------------------------------

-- Andamio de tubos: cf = centro de la base, sx de largo (X), sz de fondo, levels plantas de levelH.
-- opts.Walkable: las plataformas chocan (si no, es decorado). opts.Look: color de los tubos
function G.scaffold(cf, sx, sz, levels, levelH, opts)
	opts = opts or {}
	local tube = opts.Look or "Yellow"
	local bays = math.max(1, math.floor(sx / 6 + 0.5))
	local bay = sx / bays
	local h = levels * levelH
	for i = 0, bays do
		for _, z in { -sz / 2, sz / 2 } do
			G.deco("ScaffoldPole", V(0.35, h + 1.2, 0.35), cf * CFrame.new(-sx / 2 + i * bay, (h + 1.2) / 2, z), tube)
		end
	end
	for l = 1, levels do
		local y = l * levelH
		for _, z in { -sz / 2, sz / 2 } do
			G.deco("ScaffoldLedger", V(sx, 0.25, 0.25), cf * CFrame.new(0, y - 0.1, z), tube)
			G.deco("ScaffoldGuard", V(sx, 0.2, 0.2), cf * CFrame.new(0, y + 1.6, z), tube)
		end
		local plank = opts.Walkable and G.box or G.deco
		plank("ScaffoldDeck", V(sx, 0.3, sz), cf * CFrame.new(0, y - 0.35, 0), opts.DeckLook or "Plywood")
		-- Diagonales en la cara delantera (una por vano y planta, alternando)
		for i = 0, bays - 1 do
			local x0 = -sx / 2 + i * bay
			local up = (i + l) % 2 == 0
			local p0 = cf * V(x0, y - levelH, -sz / 2)
			local p1 = cf * V(x0 + bay, y, -sz / 2)
			if not up then
				p0, p1 = cf * V(x0, y, -sz / 2), cf * V(x0 + bay, y - levelH, -sz / 2)
			end
			G.beam(p0, p1, 0.2, 0.2, tube, true)
		end
	end
end

-- Valla de obra (paneles de madera pintados con postes): muro opaco de altura h
function G.hoarding(a, b, h, look, opts)
	opts = opts or {}
	local mid = (a + b) / 2
	local length = (b - a).Magnitude
	local cf = CFrame.lookAt(mid, b)
	local panel = G.box("Hoarding", V(0.5, h, length), cf * CFrame.new(0, h / 2, 0), look or "Hoarding")
	local posts = math.max(1, math.floor(length / 8 + 0.5))
	for i = 0, posts do
		local p = a:Lerp(b, i / posts)
		G.deco("HoardingPost", V(0.6, h + 0.4, 0.6), CFrame.lookAt(p, p + (b - a)) * CFrame.new(0, (h + 0.4) / 2, 0), opts.PostLook or "SteelDark")
	end
	-- Franja de color arriba (identidad de la obra)
	G.deco("HoardingStripe", V(0.56, 0.8, length), cf * CFrame.new(0, h - 0.6, 0), opts.Stripe or "YellowPaint")
	return panel
end

-- Valla de malla: se ve y se dispara a través, pero no se pasa
function G.meshFence(a, b, h, look)
	look = get(look or "Steel")
	local mid = (a + b) / 2
	local length = (b - a).Magnitude
	local cf = CFrame.lookAt(mid, b)
	local mesh = G.deco("FenceMesh", V(0.1, h - 0.4, length), cf * CFrame.new(0, h / 2 + 0.2, 0), { look[1], Enum.Material.DiamondPlate })
	mesh.Transparency = 0.55
	G.deco("FenceTop", V(0.2, 0.2, length), cf * CFrame.new(0, h, 0), look)
	local posts = math.max(1, math.floor(length / 6 + 0.5))
	for i = 0, posts do
		local p = a:Lerp(b, i / posts)
		G.deco("FencePost", V(0.3, h, 0.3), CFrame.new(p + V(0, h / 2, 0)), look)
	end
	local collider = Kit.block("FenceCollider", V(0.5, h, length), cf * CFrame.new(0, h / 2, 0), look[1], nil, Kit.shootThroughFolder())
	collider.Transparency = 1
	collider.CastShadow = false
end

---------------------------------------------------------------------------
-- Suelo: pintura, bordillos y juntas
---------------------------------------------------------------------------

-- Línea pintada en el suelo entre dos puntos (y = superficie)
function G.paintLine(a, b, width, look)
	local mid = (a + b) / 2
	local length = (b - a).Magnitude
	local line = G.deco("PaintLine", V(width or 0.5, 0.04, length), CFrame.lookAt(mid, b) * CFrame.new(0, 0.02, 0), look or "YellowPaint")
	line.CastShadow = false
	return line
end

-- Franjas de peligro (amarillo/negro) en un rectángulo del suelo (cf = centro, a ras de suelo)
function G.hazardStripes(cf, sx, sz)
	local count = math.max(2, math.floor(sx / 1.2))
	G.deco("HazardBase", V(sx, 0.04, sz), cf * CFrame.new(0, 0.02, 0), "Black").CastShadow = false
	for i = 0, count - 1, 2 do
		local x = -sx / 2 + (i + 0.5) * sx / count
		G.deco("HazardStripe", V(sx / count, 0.05, sz), cf * CFrame.new(x, 0.03, 0), "YellowPaint").CastShadow = false
	end
end

-- Bordillo (choca: se pasa por encima andando)
function G.curb(a, b, look)
	local mid = (a + b) / 2
	local length = (b - a).Magnitude
	return G.box("Curb", V(0.8, 0.6, length), CFrame.lookAt(mid, b) * CFrame.new(0, 0.3, 0), look or "ConcreteDark")
end

return G
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="123">
            <Properties>
              <string name="Name">Industrial</string>
              <string name="Source"><![CDATA[-- Piezas de planta industrial (Industrial Yard): depósito horizontal sobre cunas, rack de tuberías,
-- chimenea, montón de grava, prensa/máquina, pala cargadora y cinta transportadora.
-- cf = centro de la base; la "cara" mira a -Z.
local Kit = require(script.Parent.Parent.MapKit)
local Materials = require(script.Parent.Materials)
local G = require(script.Parent.Geometry)

local Industrial = {}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad
local get = Materials.get
local M = Enum.Material

local TIRE = { RGB(32, 32, 34), M.SmoothPlastic }

-- Depósito horizontal (a lo largo de Z local) sobre dos cunas: cobertura alta
function Industrial.horizontalTank(cf, length, d)
	length, d = length or 16, d or 6
	local body = Kit.pipe("HTank", length, d, cf * CFrame.new(0, d / 2 + 1.2, 0) * CFrame.Angles(0, rad(90), 0), get("Tank")[1], get("Tank")[2])
	for _, z in { -length / 3, length / 3 } do
		G.box("TankSaddle", V(d * 0.8, 2, 1.2), cf * CFrame.new(0, 1, z), "ConcreteDark")
	end
	for _, z in { -length / 4, length / 4 } do
		G.deco("TankBand", V(d + 0.12, 0.5, 0.5), cf * CFrame.new(0, d / 2 + 1.2, z), "Rust").CastShadow = false
	end
	G.deco("TankHazard", V(0.2, 1.4, 3), cf * CFrame.new(d / 2 + 0.05, d / 2 + 1.2, 0), "Orange").CastShadow = false
	return body
end

-- Rack de tuberías de a a b (pilares que chocan cada 10 studs; vigas y tubos por encima de la
-- cabeza, decorado). h = altura de la viga
function Industrial.pipeRack(a, b, h, width)
	h, width = h or 9, width or 6
	local mid = (a + b) / 2
	local length = (b - a).Magnitude
	local cf = CFrame.lookAt(mid, b)
	local columns = {}
	local n = math.max(1, math.floor(length / 10))
	for i = 0, n do
		local z = -length / 2 + i * length / n
		for _, s in { -1, 1 } do
			table.insert(columns, G.box("RackColumn", V(0.8, h, 0.8), cf * CFrame.new(s * width / 2, h / 2, z), "Steel"))
		end
		G.deco("RackBeam", V(width + 0.8, 0.6, 0.6), cf * CFrame.new(0, h, z), "Steel")
	end
	for i, look in { "Rust", "PipeBlue", "Tank", "PipeGreen" } do
		local x = -width / 2 + 0.9 + (i - 1) * (width - 1.8) / 3
		local pipe = Kit.pipe("RackPipe", length, 0.9, cf * CFrame.new(x, h + 0.75, 0) * CFrame.Angles(0, rad(90), 0), get(look)[1], get(look)[2], true)
		pipe.CastShadow = i == 1
	end
	return columns
end

-- Chimenea de ladrillo (decorado por encima del tejado) con franjas blancas y rojas en la punta
function Industrial.chimney(cf, h, d)
	h, d = h or 50, d or 6
	local stack = Kit.cylinder("Chimney", h, d, cf * CFrame.new(0, h / 2, 0), get("Brick")[1], get("Brick")[2], nil, true)
	for i, y in { h - 6, h - 3 } do
		Kit.cylinder("ChimneyBand", 1.4, d + 0.2, cf * CFrame.new(0, y, 0), i == 1 and get("Red")[1] or get("Paint")[1], M.SmoothPlastic, nil, true)
	end
	Kit.cylinder("ChimneyLip", 0.8, d + 0.8, cf * CFrame.new(0, h, 0), get("ConcreteDark")[1], M.Concrete, nil, true)
	return stack
end

-- Montón de grava o carbón (bloque central y dos rampas): cobertura alta. Las rampas no se pueden
-- subir: un clip invisible cubre todo el montón desde 1,5 studs (deja pasar las balas)
function Industrial.heap(cf, w, d, h, look)
	look = look or "Gravel"
	local parts = {}
	table.insert(parts, G.box("HeapCore", V(w * 0.5, h, d), cf * CFrame.new(0, h / 2, 0), look))
	for _, s in { -1, 1 } do
		local wedge = G.box("HeapSide", V(d, h, w * 0.25), cf * CFrame.new(s * w * 0.375, h / 2, 0) * CFrame.Angles(0, -s * rad(90), 0), look)
		wedge.Shape = Enum.PartType.Wedge
		table.insert(parts, wedge)
	end
	local clip = Kit.block("PlayerClip", V(w, 60 - 1.5, d), cf * CFrame.new(0, 1.5 + (60 - 1.5) / 2, 0), Color3.new(1, 1, 1), nil, Kit.shootThroughFolder())
	clip.Transparency = 1
	clip.CastShadow = false
	return parts
end

-- Prensa o máquina de la nave (cobertura alta) con su panel de luces
function Industrial.machine(cf, w, d, h)
	w, d, h = w or 6, d or 5, h or 7
	local body = G.box("Machine", V(w, h, d), cf * CFrame.new(0, h / 2, 0), "MachineGreen")
	G.deco("MachineTop", V(w * 0.7, 1.6, d * 0.6), cf * CFrame.new(0, h + 0.8, 0), "SteelDark")
	G.deco("MachineStripe", V(w + 0.1, 0.5, d + 0.1), cf * CFrame.new(0, 1.2, 0), "Orange").CastShadow = false
	local panel = G.deco("MachinePanel", V(1.6, 1.2, 0.2), cf * CFrame.new(w * 0.25, h * 0.6, -d / 2 - 0.1), { RGB(120, 220, 140), M.Neon })
	panel.CastShadow = false
	return body
end

-- Pala cargadora (choca: cobertura media). Mira a -Z
function Industrial.wheelLoader(cf)
	local body = G.box("Loader", V(6, 4, 10), cf * CFrame.new(0, 3.2, 1), "Orange")
	G.deco("LoaderCab", V(4.4, 3.4, 4), cf * CFrame.new(0, 6.9, 2), { RGB(40, 48, 58), M.Glass })
	G.deco("LoaderBucket", V(7, 2.6, 2), cf * CFrame.new(0, 1.6, -5.4), "SteelDark")
	for _, s in { -1, 1 } do
		G.deco("LoaderArm", V(0.6, 0.6, 5), cf * CFrame.new(s * 2.4, 3.6, -2.6) * CFrame.Angles(rad(20), 0, 0), "SteelDark")
		for _, z in { -2.6, 4 } do
			Kit.cylinder("Wheel", 1.2, 3.2, cf * CFrame.new(s * 3.2, 1.6, z) * CFrame.Angles(0, 0, rad(90)), TIRE[1], TIRE[2], nil, true)
		end
	end
	return body
end

-- Cinta transportadora inclinada de a (abajo) a b (arriba): decorado sobre patas
function Industrial.conveyor(a, b, width)
	width = width or 3
	local mid = (a + b) / 2
	local length = (b - a).Magnitude
	local cf = CFrame.lookAt(mid, b)
	G.deco("ConveyorBelt", V(width, 0.6, length), cf, "SteelDark")
	G.deco("ConveyorCover", V(width + 0.4, 1.4, length), cf * CFrame.new(0, 0.9, 0), "Orange")
	local n = math.max(1, math.floor(length / 10))
	for i = 1, n do
		local p = a:Lerp(b, i / (n + 1))
		G.deco("ConveyorLeg", V(0.6, p.Y, 0.6), CFrame.new(p.X, p.Y / 2, p.Z), "Steel")
	end
end

return Industrial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="124">
            <Properties>
              <string name="Name">Mall</string>
              <string name="Source"><![CDATA[-- Piezas de centro comercial (Mall Rush): escalera mecánica, barandilla de cristal, escaparate con
-- rótulo, quiosco, puesto de comida, mesas, palmera en jardinera, banderola colgante y cúpula de
-- cristal. Colores fuertes pero con materiales de verdad (nada de neón por todas partes).
local Kit = require(script.Parent.Parent.MapKit)
local G = require(script.Parent.Geometry)

local Mall = {}
Mall.capHook = function(_part) end -- (lo sustituye TacKit por T.cap: tapar por arriba)

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad
local M = Enum.Material

-- Barandilla de cristal entre dos puntos del suelo: vidrio (decorado), pasamanos de acero y un panel
-- invisible que choca pero deja pasar balas y vista
function Mall.glassRail(a, b, h)
	h = h or 3.4
	local mid = (a + b) / 2
	local length = (b - a).Magnitude
	if length < 0.5 then
		return
	end
	local cf = CFrame.lookAt(mid, b)
	local glass = G.deco("RailGlass", V(0.15, h - 0.3, length), cf * CFrame.new(0, (h - 0.3) / 2, 0), { RGB(170, 220, 236), M.Glass })
	glass.Transparency = 0.6
	glass.CastShadow = false
	G.deco("RailTop", V(0.35, 0.25, length), cf * CFrame.new(0, h, 0), { RGB(210, 214, 220), M.Metal })
	G.deco("RailShoe", V(0.4, 0.3, length), cf * CFrame.new(0, 0.15, 0), { RGB(150, 154, 160), M.Metal })
	local stop = Kit.block("RailCollider", V(0.5, h + 0.4, length), cf * CFrame.new(0, (h + 0.4) / 2, 0), Color3.new(1, 1, 1), nil, Kit.shootThroughFolder())
	stop.Transparency = 1
	stop.CastShadow = false
	Mall.capHook(stop)
	return stop
end

-- Escalera mecánica de bottom a top (puntos del centro): peldaños metálicos, laterales de cristal
-- y pasamanos negros
function Mall.escalator(bottom, top, width)
	width = width or 4.4
	local body = G.stairs(bottom, top, width, { RGB(120, 124, 132), M.DiamondPlate }, { StepLook = { RGB(150, 154, 162), M.DiamondPlate }, NosingLook = { RGB(240, 200, 40), M.SmoothPlastic } })
	local flat = V(top.X - bottom.X, 0, top.Z - bottom.Z)
	local face = CFrame.lookAt(bottom, bottom + flat)
	local right = face.RightVector * (width / 2 + 0.3)
	for _, s in { -1, 1 } do
		local a, b = bottom + right * s, top + right * s
		local mid = (a + b) / 2
		local cf = CFrame.lookAt(mid, b)
		local side = G.deco("EscalatorSide", V(0.25, 3, (b - a).Magnitude), cf * CFrame.new(0, 1.2, 0), { RGB(170, 220, 236), M.Glass })
		side.Transparency = 0.55
		G.deco("EscalatorRail", V(0.4, 0.4, (b - a).Magnitude + 1), cf * CFrame.new(0, 3, 0), { RGB(24, 24, 28), M.Rubber })
		G.deco("EscalatorSkirt", V(0.35, 1.2, (b - a).Magnitude), cf * CFrame.new(0, -0.3, 0), { RGB(200, 204, 210), M.Metal })
		-- (franja de color en el costado: la escalera, pieza central del atrio, se reconoce de lejos)
		G.deco("EscalatorStripe", V(0.4, 0.35, (b - a).Magnitude), cf * CFrame.new(0, -0.75, 0), { RGB(0, 168, 196), M.SmoothPlastic }).CastShadow = false
		local stop = Kit.block("RailCollider", V(0.5, 3.6, (b - a).Magnitude), cf * CFrame.new(0, 1.8, 0), Color3.new(1, 1, 1), nil, Kit.shootThroughFolder())
		stop.Transparency = 1
	end
	-- Cuerpo inferior (la "caja" de la escalera)
	local run = flat.Magnitude
	local rise = top.Y - bottom.Y
	-- (macizo: tapa la vista por debajo y no se pasa por debajo de la escalera)
	for i = 2, 4 do
		local h = rise * (i - 1) / 4 - 0.6 -- (por debajo de la rampa en todo el tramo)
		G.box("EscalatorTruss", V(width + 0.6, h, run / 4), face * CFrame.new(0, h / 2, -(run * (i - 0.5) / 4)), { RGB(200, 204, 210), M.Metal })
	end
	return body
end

-- Escaparate: cristal en el hueco de una fachada de tienda (cara -Z), rótulo encima y un fondo de
-- color dentro (la tienda no se entra). cf = centro de la base del hueco; w = ancho
function Mall.storefront(cf, w, h, name, color, opts)
	opts = opts or {}
	h = h or 8
	local glass = G.deco("ShopGlass", V(w, h - 1, 0.2), cf * CFrame.new(0, (h - 1) / 2 + 0.2, 0), { RGB(180, 220, 236), M.Glass })
	glass.Transparency = 0.5
	glass.CastShadow = false
	local stop = Kit.block("GlassCollider", V(w, h, 0.4), cf * CFrame.new(0, h / 2, 0), Color3.new(1, 1, 1), nil, Kit.shootThroughFolder())
	stop.Transparency = 1
	stop.CastShadow = false
	-- Interior (fondo de color y estantes) para que el cristal tenga algo detrás
	G.deco("ShopBack", V(w, h, 0.4), cf * CFrame.new(0, h / 2, (opts.Depth or 6)), { color:Lerp(Color3.new(1, 1, 1), 0.35), M.SmoothPlastic })
	if not opts.Shallow then
		for i = -1, 1 do
			G.deco("ShopShelf", V(w * 0.22, 4, 1.4), cf * CFrame.new(i * w * 0.3, 2, (opts.Depth or 6) - 1.2), { color, M.SmoothPlastic })
		end
	else
		-- (escaparate sobre un bloque macizo: maniquíes y género pegados al fondo)
		for i = -1, 1, 2 do
			G.deco("Mannequin", V(1.2, 5, 0.4), cf * CFrame.new(i * w * 0.25, 2.7, 0.35), { RGB(236, 236, 240), M.SmoothPlastic })
		end
	end
	-- Rótulo de la tienda (franja de color con letras blancas)
	local board = G.deco("ShopSign", V(w, 1.8, 0.4), cf * CFrame.new(0, h + 1.1, -0.2), { color, M.SmoothPlastic })
	local gui = Kit.sign(board, Enum.NormalId.Front, name, RGB(255, 255, 255), color:Lerp(Color3.new(0, 0, 0), 0.3))
	gui.LightInfluence = 0.3
	gui.PixelsPerStud = 16
	local strip = G.deco("ShopLight", V(w, 0.2, 0.3), cf * CFrame.new(0, h + 2.1, -0.4), { RGB(255, 246, 230), M.Neon })
	strip.CastShadow = false
	return board
end

-- Quiosco (isla en medio del pasillo): mostrador redondo de color con techo (cobertura media)
function Mall.kiosk(cf, color, name)
	local body = Kit.cylinder("Kiosk", 3.6, 6, cf * CFrame.new(0, 1.8, 0), color, M.SmoothPlastic)
	Kit.cylinder("KioskTop", 0.4, 6.4, cf * CFrame.new(0, 3.8, 0), RGB(240, 240, 244), M.SmoothPlastic, nil, true)
	G.deco("KioskPole", V(0.4, 4, 0.4), cf * CFrame.new(0, 6, 0), { RGB(200, 204, 210), M.Metal })
	local roof = Kit.cylinder("KioskRoof", 0.5, 7, cf * CFrame.new(0, 8.2, 0), color, M.SmoothPlastic, nil, true)
	roof.CastShadow = true
	if name then
		local board = G.deco("KioskSign", V(5, 1.2, 0.2), cf * CFrame.new(0, 9.2, 0), { color, M.SmoothPlastic })
		Kit.sign(board, Enum.NormalId.Front, name, RGB(255, 255, 255)).LightInfluence = 0.3
		Kit.sign(board, Enum.NormalId.Back, name, RGB(255, 255, 255)).LightInfluence = 0.3
	end
	return body
end

-- Puesto de la zona de comida: mostrador, trasera alta con el nombre y menú (cobertura alta)
function Mall.foodStall(cf, name, color, w)
	w = w or 12
	local counter = G.box("FoodCounter", V(w, 3.4, 2.6), cf * CFrame.new(0, 1.7, 0), { RGB(240, 240, 244), M.SmoothPlastic })
	G.deco("CounterFront", V(w + 0.1, 1, 2.7), cf * CFrame.new(0, 2.2, 0), { color, M.SmoothPlastic })
	local back = G.box("FoodBack", V(w, 9, 1), cf * CFrame.new(0, 4.5, 5), { color:Lerp(Color3.new(1, 1, 1), 0.15), M.SmoothPlastic })
	Mall.capHook(back)
	local board = G.deco("FoodSign", V(w * 0.7, 2.4, 0.4), cf * CFrame.new(0, 10.4, 4.6), { color, M.SmoothPlastic })
	Kit.sign(board, Enum.NormalId.Front, name, RGB(255, 255, 255), color:Lerp(Color3.new(0, 0, 0), 0.35)).LightInfluence = 0.2
	for i = -1, 1 do
		G.deco("Menu", V(w * 0.22, 1.6, 0.1), cf * CFrame.new(i * w * 0.28, 7.2, 4.45), { RGB(30, 30, 36), M.SmoothPlastic })
	end
	G.deco("FoodCanopy", V(w + 1, 0.4, 3), cf * CFrame.new(0, 8.6, 3.2) * CFrame.Angles(rad(-15), 0, 0), { color, M.Fabric })
	return counter
end

-- Mesa con cuatro sillas (cobertura muy baja)
function Mall.tableSet(cf, color)
	G.box("Table", V(3.4, 2.6, 3.4), cf * CFrame.new(0, 1.3, 0), { RGB(236, 236, 240), M.SmoothPlastic })
	for i = 0, 3 do
		local seat = cf * CFrame.Angles(0, rad(i * 90), 0) * CFrame.new(0, 0, -2.8)
		G.deco("Chair", V(1.4, 1.6, 1.4), seat * CFrame.new(0, 0.8, 0), { color or RGB(240, 120, 40), M.SmoothPlastic })
		G.deco("ChairBack", V(1.4, 1.6, 0.25), seat * CFrame.new(0, 2.4, -0.6), { color or RGB(240, 120, 40), M.SmoothPlastic })
	end
end

-- Palmera en jardinera cuadrada (cobertura baja)
function Mall.palmPlanter(cf, h)
	local box = G.box("PalmPlanter", V(5, 2.4, 5), cf * CFrame.new(0, 1.2, 0), { RGB(70, 74, 82), M.Concrete })
	G.deco("PlanterSoil", V(4.4, 0.2, 4.4), cf * CFrame.new(0, 2.42, 0), { RGB(70, 52, 38), M.Ground })
	Kit.palm(cf * CFrame.new(0, 2.4, 0), h or 12)
	for _, p in { V(-1.4, 2.8, -1.4), V(1.4, 2.8, 1.2) } do
		Kit.ball("PlanterShrub", 1.6, cf * CFrame.new(p), RGB(60, 140, 70), M.Grass, true)
	end
	return box
end

-- Banderola colgante (cara -Z; la cuelga de cf, que es el centro de arriba)
function Mall.hangingBanner(cf, w, h, color, text)
	G.deco("BannerRod", V(w + 0.6, 0.3, 0.3), cf, { RGB(200, 204, 210), M.Metal })
	local cloth = G.deco("HangBanner", V(w, h, 0.15), cf * CFrame.new(0, -h / 2 - 0.2, 0), { color, M.Fabric })
	cloth.CastShadow = false
	if text then
		local gui = Kit.sign(cloth, Enum.NormalId.Front, text, RGB(255, 255, 255), color:Lerp(Color3.new(0, 0, 0), 0.3))
		gui.LightInfluence = 0.5
		local back = Kit.sign(cloth, Enum.NormalId.Back, text, RGB(255, 255, 255), color:Lerp(Color3.new(0, 0, 0), 0.3))
		back.LightInfluence = 0.5
	end
	G.deco("BannerCable", V(0.08, 8, 0.08), cf * CFrame.new(0, 4, 0), { RGB(40, 40, 44), M.Metal })
end

-- Fuente moderna de centro comercial: la misma colisión que la fuente de plaza (pilón de 2,4 y
-- columna central de 5: misma cobertura y navegación), pero de mármol blanco con una franja de
-- azulejo de color, dos platos de acero escalonados, chorros y un anillo de azulejo en el suelo que
-- la marca de lejos (hito del atrio).
function Mall.mallFountain(cf, d, accent)
	d = d or 10
	accent = accent or RGB(0, 168, 196)
	local white, steel = RGB(236, 236, 240), RGB(206, 210, 216)
	local basin = Kit.cylinder("FountainBasin", 2.4, d, cf * CFrame.new(0, 1.2, 0), white, M.Marble)
	Kit.cylinder("FountainTileBand", 1, d + 0.12, cf * CFrame.new(0, 1.3, 0), accent, M.CeramicTiles, nil, true)
	Kit.cylinder("FountainRim", 0.4, d + 0.8, cf * CFrame.new(0, 2.5, 0), RGB(248, 248, 250), M.Marble, nil, true)
	local water = Kit.cylinder("FountainWater", 0.2, d - 1.2, cf * CFrame.new(0, 2.1, 0), RGB(60, 168, 206), M.Glass, nil, true)
	water.Transparency = 0.2
	Kit.cylinder("FountainPedestal", 5, 3, cf * CFrame.new(0, 4.5, 0), white, M.Marble)
	Kit.cylinder("FountainBowl", 0.5, 6.4, cf * CFrame.new(0, 4.6, 0), steel, M.Metal, nil, true)
	Kit.cylinder("FountainBowl", 0.5, 4, cf * CFrame.new(0, 7.2, 0), steel, M.Metal, nil, true)
	Kit.cylinder("FountainCrown", 1.4, 1.4, cf * CFrame.new(0, 8.1, 0), accent, M.CeramicTiles, nil, true)
	-- Anillo de azulejo en el suelo (se ve desde la planta alta y en la presentación del mapa)
	Kit.cylinder("FountainFloorRing", 0.06, d + 6, cf * CFrame.new(0, 0.03, 0), accent, M.CeramicTiles, nil, true).CastShadow = false
	Kit.cylinder("FountainFloorInner", 0.06, d + 3.4, cf * CFrame.new(0, 0.045, 0), RGB(244, 244, 246), M.Marble, nil, true).CastShadow = false
	for _, spec in { { water, 30, 6 }, { nil, 16, 4 } } do
		local holder = spec[1]
		if not holder then
			holder = G.deco("FountainJet", V(0.4, 0.4, 0.4), cf * CFrame.new(0, 8.9, 0), { accent, M.CeramicTiles })
			holder.Transparency = 1
		end
		local drops = Instance.new("ParticleEmitter")
		drops.Name = "FountainSpray"
		drops.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		drops.Color = ColorSequence.new(RGB(220, 240, 255))
		drops.Size = NumberSequence.new(0.25, 0.1)
		drops.Transparency = NumberSequence.new(0.3, 1)
		drops.Lifetime = NumberRange.new(0.6, 0.9)
		drops.Rate = spec[2]
		drops.Speed = NumberRange.new(spec[3], spec[3] + 2)
		drops.SpreadAngle = Vector2.new(22, 22)
		drops.Acceleration = V(0, -30, 0)
		drops.Parent = holder
	end
	return basin
end

-- Cúpula de cristal (pirámide de paneles con nervios) sobre un hueco cuadrado de lado w
function Mall.glassDome(cf, w, h)
	h = h or w * 0.35
	local slope = math.sqrt((w / 2) ^ 2 + h * h)
	local angle = math.atan2(h, w / 2)
	for i = 0, 3 do
		local face = cf * CFrame.Angles(0, rad(i * 90), 0)
		local pane = G.deco("DomeGlass", V(w * 0.72, 0.3, slope), face * CFrame.new(0, h / 2, -w / 4) * CFrame.Angles(angle, 0, 0), { RGB(170, 220, 240), M.Glass })
		pane.Transparency = 0.45
		pane.CastShadow = false
		G.deco("DomeRib", V(0.4, 0.4, slope * 1.42), face * CFrame.Angles(0, rad(45), 0) * CFrame.new(0, h / 2, -w * 0.35) * CFrame.Angles(math.atan2(h, w * 0.707), 0, 0), { RGB(230, 234, 240), M.Metal })
	end
	G.deco("DomeFrame", V(w + 1, 0.8, w + 1), cf * CFrame.new(0, -0.2, 0), { RGB(230, 234, 240), M.Metal })
end

return Mall
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="125">
            <Properties>
              <string name="Name">Materials</string>
              <string name="Source"><![CDATA[-- Biblioteca de materiales de los mapas 5v5: cada "look" es { color, material } y cada mapa tiene
-- su paleta (identidad de color: Construcción = gris + amarillo + rojo...). Las piezas del kit
-- reciben un look (o el nombre de uno de la paleta activa) en vez de color y material sueltos, así
-- cambiar el tono de un mapa es tocar una línea.
local M = Enum.Material
local RGB = Color3.fromRGB

local Materials = {}

-- Comunes a todos los mapas
Materials.Common = {
	Steel = { RGB(118, 122, 128), M.Metal },
	SteelDark = { RGB(64, 66, 72), M.Metal },
	Glass = { RGB(150, 190, 210), M.Glass },
	Asphalt = { RGB(66, 66, 70), M.Asphalt },
	Paint = { RGB(236, 232, 220), M.SmoothPlastic }, -- líneas pintadas en el suelo
	Black = { RGB(30, 30, 34), M.SmoothPlastic },
	Wood = { RGB(176, 128, 80), M.WoodPlanks },
	WoodDark = { RGB(116, 80, 50), M.Wood },
	Fabric = { RGB(200, 60, 50), M.Fabric },
	Leaf = { RGB(70, 132, 62), M.Grass },
	Iron = { RGB(36, 36, 40), M.Metal },
	-- (genéricos que usan los props del kit; cada paleta puede cambiarlos)
	Concrete = { RGB(196, 192, 184), M.Concrete },
	ConcreteDark = { RGB(150, 147, 141), M.Concrete },
	Slab = { RGB(182, 178, 170), M.Concrete },
	Block = { RGB(168, 166, 160), M.Concrete },
	Plywood = { RGB(204, 168, 116), M.WoodPlanks },
	Hoarding = { RGB(72, 82, 96), M.WoodPlanks },
	Yellow = { RGB(244, 188, 30), M.Metal },
	YellowPaint = { RGB(246, 194, 40), M.SmoothPlastic },
	Red = { RGB(196, 46, 38), M.SmoothPlastic },
	Blue = { RGB(40, 92, 190), M.SmoothPlastic },
	RedSteel = { RGB(156, 40, 32), M.Metal },
	ContainerRed = { RGB(172, 46, 38), M.CorrodedMetal },
	ContainerGray = { RGB(112, 116, 120), M.CorrodedMetal },
	ContainerTan = { RGB(150, 126, 94), M.CorrodedMetal },
	ContainerBlue = { RGB(44, 86, 150), M.CorrodedMetal },
	ContainerYellow = { RGB(214, 168, 40), M.CorrodedMetal },
	ContainerGreen = { RGB(60, 110, 76), M.CorrodedMetal },
	Corrugated = { RGB(132, 138, 146), M.CorrodedMetal },
	Dirt = { RGB(138, 116, 90), M.Ground },
}

-- CONSTRUCCIÓN: hormigón claro, amarillo de seguridad y acero rojo
Materials.Construction = {
	Concrete = { RGB(198, 194, 186), M.Concrete },
	ConcreteDark = { RGB(150, 147, 141), M.Concrete },
