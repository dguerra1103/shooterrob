	},
	Atardecer = {
		Name = "Atardecer",
		Rarity = "Épico",
		Body = Color3.fromRGB(255, 140, 80),
		BodyMaterial = Enum.Material.SmoothPlastic,
		Accent = Color3.fromRGB(255, 60, 140),
