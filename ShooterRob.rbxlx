          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="61">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Punto de entrada del cliente.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local Modules = script.Parent:WaitForChild("Modules")
local ClientState = require(Modules.ClientState)
local WeaponController = require(Modules.WeaponController)
local Movement = require(Modules.Movement)
local HUD = require(Modules.HUD)
local Menu = require(Modules.Menu)
local MainMenu = require(Modules.MainMenu)
local WorldFX = require(Modules.WorldFX)
local VoteUI = require(Modules.VoteUI)
local GrenadeController = require(Modules.GrenadeController)
local KillstreakController = require(Modules.KillstreakController)
local Settings = require(Modules.Settings)
local Footprints = require(Modules.Footprints)
local DeathScreen = require(Modules.DeathScreen)
local QuestTracker = require(Modules.QuestTracker)
local Abilities = require(Modules.Abilities)
local Emotes = require(Modules.Emotes)
local Scoreboard = require(Modules.Scoreboard)
local PlaytimeGifts = require(Modules.PlaytimeGifts)
local SkinFX = require(Modules.SkinFX)
local JumpPads = require(Modules.JumpPads)
local Tutorial = require(Modules.Tutorial)
local EventHUD = require(Modules.EventHUD)
local ChatTags = require(Modules.ChatTags)
local InfectionFX = require(Modules.InfectionFX)

Remotes.DataUpdate.OnClientEvent:Connect(ClientState.SetData)
task.spawn(function()
	local ok, data = pcall(function()
		return Remotes.GetData:InvokeServer()
	end)
	if ok and data and not ClientState.Data then
		ClientState.SetData(data)
	end
end)

-- Arranca cada sistema por separado: si uno falla, se avisa en Output y los demás siguen
local function start(name, fn, ...)
	local ok, err = xpcall(fn, debug.traceback, ...)
	if not ok then
		warn("[Arranque] " .. name .. " falló: " .. tostring(err))
	end
end

start("Settings", Settings.Init)
start("HUD", HUD.Init)
start("Menu", Menu.Init)
start("Movement", Movement.Init)
start("WeaponController", WeaponController.Init)
start("WorldFX", WorldFX.Init)
start("Footprints", Footprints.Init)
start("DeathScreen", DeathScreen.Init)
start("QuestTracker", QuestTracker.Init)
start("Abilities", Abilities.Init)
start("Emotes", Emotes.Init)
start("Scoreboard", Scoreboard.Init)
start("PlaytimeGifts", PlaytimeGifts.Init)
start("SkinFX", SkinFX.Init)
start("JumpPads", JumpPads.Init)
start("Tutorial", Tutorial.Init)
start("EventHUD", EventHUD.Init)
start("ChatTags", ChatTags.Init)
start("InfectionFX", InfectionFX.Init)
start("VoteUI", VoteUI.Init)
start("GrenadeController", GrenadeController.Init)
start("KillstreakController", KillstreakController.Init)
start("MainMenu", MainMenu.Init) -- la última: muestra la pantalla de inicio
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="62">
          <Properties>
            <string name="Name">Modules</string>
          </Properties>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">Abilities</string>
              <string name="Source"><![CDATA[-- Habilidades con tiempo de recarga (iconos abajo en el centro, también se tocan en móvil):
--   E  Impulso    : acelerón corto hacia donde te mueves (o hacia donde miras)
--   Z  Supersalto : salto muy alto con un poco de impulso hacia delante
--   X  Poción     : cura con el tiempo (la valida el servidor)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Sounds = require(Shared.Sounds)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Abilities = {}

local CONFIG = GameConfig.Abilities
local readyAt = { Dash = 0, Jump = 0, Potion = 0 }
local slots = {} -- [nombre] = { Cover, Timer, Frame, WasReady }
local gui

local function getCharacter()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then
		return character, humanoid, root
	end
	return nil
end

local function canUse(name)
	return not ClientState.IsBlocked() and not ClientState.Frozen() and os.clock() >= readyAt[name]
end

-- Estela blanca breve detrás del personaje
local function burst(root, color, count, speed)
	local attachment = Instance.new("Attachment")
	attachment.Parent = root
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	emitter.Color = ColorSequence.new(color)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 3) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(0.3, 0.5)
	emitter.Speed = NumberRange.new(speed * 0.5, speed)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Enabled = false
	emitter.Parent = attachment
	emitter:Emit(count)
	task.delay(1, function()
		attachment:Destroy()
	end)
end

local function dash()
	if not canUse("Dash") or ClientState.Sliding then
		return
	end
	local _, humanoid, root = getCharacter()
	if not humanoid or not root then
		return
	end
	local config = CONFIG.Dash
	local direction = humanoid.MoveDirection
	if direction.Magnitude < 0.1 then
		direction = camera.CFrame.LookVector
	end
	direction = Vector3.new(direction.X, 0, direction.Z)
	if direction.Magnitude < 0.01 then
		return
	end
	direction = direction.Unit
	readyAt.Dash = os.clock() + config.Cooldown

	local attachment = Instance.new("Attachment")
	attachment.Name = "DashAttachment"
	attachment.Parent = root
	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	velocity.PrimaryTangentAxis = Vector3.xAxis
	velocity.SecondaryTangentAxis = Vector3.zAxis
	velocity.MaxForce = 120000
	velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z) * config.Speed
	velocity.Parent = root
	ClientState.Dashing = true
	task.delay(config.Duration, function()
		ClientState.Dashing = false
		velocity:Destroy()
		attachment:Destroy()
	end)
	ClientState.FovKick = 10
	Sounds.Play("Slide")
	burst(root, Color3.fromRGB(235, 245, 255), 14, 12)
end

local function superJump()
	if not canUse("Jump") then
		return
	end
	local _, humanoid, root = getCharacter()
	if not humanoid or not root or humanoid.FloorMaterial == Enum.Material.Air then
		return
	end
	local config = CONFIG.Jump
	readyAt.Jump = os.clock() + config.Cooldown
	local forward = humanoid.MoveDirection
	if forward.Magnitude < 0.1 then
		forward = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
	end
	if forward.Magnitude > 0.01 then
		forward = forward.Unit
	end
	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	local v = root.AssemblyLinearVelocity
	local launch = Vector3.new(v.X + forward.X * config.Forward, config.Power, v.Z + forward.Z * config.Forward)
	root.AssemblyLinearVelocity = launch
	-- Otra vez en el siguiente paso de física: el salto del Humanoid podría pisar la velocidad
	task.defer(function()
		local dt = RunService.Heartbeat:Wait()
		-- (lo esperado tras un paso es Power - gravedad·dt; solo se corrige si quedó muy por debajo)
		if root.Parent and humanoid.Health > 0 and root.AssemblyLinearVelocity.Y < config.Power - workspace.Gravity * dt - 8 then
			root.AssemblyLinearVelocity = launch
		end
	end)
	ClientState.FovKick = 6
	Sounds.Play("Swing")
	burst(root, Color3.fromRGB(170, 220, 255), 18, 8)
end

local function potion()
	if not canUse("Potion") then
		return
	end
	local _, humanoid = getCharacter()
	if not humanoid or humanoid.Health >= humanoid.MaxHealth then
		return
	end
	readyAt.Potion = os.clock() + CONFIG.Potion.Cooldown
	Sounds.Play("Kill")
	task.spawn(function()
		local ok, used = pcall(function()
			return Remotes.UsePotion:InvokeServer()
		end)
		if not ok or not used then
			readyAt.Potion = os.clock() + 1 -- el servidor no la aceptó: se puede reintentar enseguida
		end
	end)
end

local ACTIONS = {
	{ Name = "Dash", Key = "E", Icon = "💨", Use = dash, Color = Color3.fromRGB(70, 160, 255) },
	{ Name = "Jump", Key = "Z", Icon = "⏫", Use = superJump, Color = Color3.fromRGB(80, 200, 255) },
	{ Name = "Potion", Key = "X", Icon = "🧪", Use = potion, Color = Color3.fromRGB(80, 220, 120) },
}

local function build()
	gui = UI.new("ScreenGui", {
		Name = "Abilities",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local bar = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(3 * 78 + 2 * 12, 92),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 12),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local scale = UI.new("UIScale", { Parent = bar })
	local function rescale()
		local size = camera.ViewportSize
		scale.Scale = math.clamp(math.min(size.X / 1280, size.Y / 720), 0.65, 1)
	end
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()

	for i, action in ACTIONS do
		local button = UI.button({
			LayoutOrder = i,
			Size = UDim2.fromOffset(78, 78),
			Text = "",
			BackgroundColor3 = action.Color,
			AutoButtonColor = true,
			Parent = bar,
		}, { UI.stroke(Color3.new(1, 1, 1), 3, 0), UI.gloss() })
		UI.label({ Size = UDim2.fromScale(1, 1), Text = action.Icon, TextSize = 40, Parent = button })
		local cover = UI.new("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.fromScale(1, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.35,
			ZIndex = 2,
			Parent = button,
		}, { UI.corner(8) })
		local timer = UI.label({ Size = UDim2.fromScale(1, 1), Text = "", TextSize = 30, ZIndex = 3, Parent = button })
		local badge = UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 1, 2),
			Size = UDim2.fromOffset(30, 26),
			BackgroundColor3 = Color3.fromRGB(20, 22, 34),
			ZIndex = 4,
			Parent = button,
		}, { UI.corner(6), UI.stroke(Color3.new(1, 1, 1), 2, 0) })
		UI.label({ Size = UDim2.fromScale(1, 1), Text = action.Key, TextSize = 18, ZIndex = 5, Parent = badge })
		button.Activated:Connect(action.Use)
		slots[action.Name] = { Cover = cover, Timer = timer, Frame = button, WasReady = true }
	end
end

local function update()
	gui.Enabled = not ClientState.InMainMenu and not ClientState.Dead and not ClientState.MenuOpen and not ClientState.VotePanelVisible
	local now = os.clock()
	if not gui.Enabled then
		-- (oculto: solo se apunta si ya está lista, para que el salto no salga al volver a mostrarse)
		for _, action in ACTIONS do
			slots[action.Name].WasReady = readyAt[action.Name] - now <= 0
		end
		return
	end
	for _, action in ACTIONS do
		local slot = slots[action.Name]
		local left = readyAt[action.Name] - now
		local ready = left <= 0
		-- (solo se escribe cuando cambia: el contador va por segundos y la barra en pasos de 1/50)
		local fraction = ready and 0 or math.clamp(left / CONFIG[action.Name].Cooldown, 0, 1)
		local step = math.ceil(fraction * 50)
		if step ~= slot.LastStep then
			slot.LastStep = step
			slot.Cover.Size = UDim2.fromScale(1, step / 50)
		end
		local seconds = ready and 0 or math.ceil(left)
		if seconds ~= slot.LastSeconds then
			slot.LastSeconds = seconds
			slot.Timer.Text = ready and "" or tostring(seconds)
		end
		if ready and not slot.WasReady then
			-- Lista otra vez: pequeño salto del icono
			local s = slot.Frame:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = slot.Frame })
			s.Scale = 1.2
			TweenService:Create(s, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
		slot.WasReady = ready
	end
end

function Abilities.Init()
	build()
	local keys = {
		Dash = { Enum.KeyCode.E, Enum.KeyCode.DPadLeft },
		Jump = { Enum.KeyCode.Z, Enum.KeyCode.DPadDown },
		Potion = { Enum.KeyCode.X },
	}
	for _, action in ACTIONS do
		ContextActionService:BindAction("Ability" .. action.Name, function(_, state)
			if state == Enum.UserInputState.Begin then
				action.Use()
			end
			return Enum.ContextActionResult.Pass
		end, false, table.unpack(keys[action.Name]))
	end
	-- Al reaparecer, las recargas se mantienen (no se reinician gratis)
	RunService.RenderStepped:Connect(update)
end

return Abilities
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">ChatTags</string>
              <string name="Source"><![CDATA[-- Etiquetas en el chat: [VIP] dorada para quien tenga el pase VIP, el icono de su rango competitivo
-- y el nivel de cada jugador, con color según el nivel. Solo cambia cómo se ve el mensaje (TextChatService, chat nuevo de Roblox).
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Ranks = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Ranks"))

local ChatTags = {}

-- Color del nivel: gris, verde, azul, morado y dorado según se sube
local function levelColor(level)
	if level >= 40 then
		return "#FFC83C"
	elseif level >= 25 then
		return "#C064FF"
	elseif level >= 12 then
		return "#4AA8FF"
	elseif level >= 5 then
		return "#6EE06E"
	end
	return "#C8C8D2"
end

local function tagsFor(player)
	local tags = ""
	if player:GetAttribute("VIP") then
		tags ..= '<font color="#FFC83C">[VIP]</font> '
	end
	local rank = Ranks.Tiers[player:GetAttribute("Rank") or 0]
	if rank then
		tags ..= rank.Icon .. " "
	end
	local stats = player:FindFirstChild("leaderstats")
	local level = stats and stats:FindFirstChild("Nivel")
	if level and typeof(level.Value) == "number" then
		tags ..= string.format('<font color="%s">[Nv %d]</font> ', levelColor(level.Value), level.Value)
	end
	return tags
end

function ChatTags.Init()
	if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
		return -- chat antiguo: no se puede personalizar así
	end
	TextChatService.OnIncomingMessage = function(message)
		local properties = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		local player = source and Players:GetPlayerByUserId(source.UserId)
		if player then
			properties.PrefixText = tagsFor(player) .. message.PrefixText
		end
		return properties
	end
end

return ChatTags
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">ClientState</string>
              <string name="Source"><![CDATA[-- Estado compartido entre los módulos del cliente.
local ClientState = {
	Data = nil, -- datos de progreso (nivel, XP, skins...)
	Settings = nil :: { [string]: any }?, -- ajustes del jugador (los rellena Settings)
	EffectiveQuality = "Media", -- calidad real aplicada ("Auto" ya resuelto); la rellena Settings
	Dead = false, -- pantalla de muerte abierta (la rellena DeathScreen)
	Emoting = false, -- haciendo un emote (cámara en tercera persona, arma oculta)
	EmoteMenuOpen = false, -- menú de emotes abierto (N)
	TutorialOpen = false, -- tarjeta de controles de la primera partida en pantalla
	WheelOpen = false, -- ruleta diaria abierta
	FovKick = 0, -- empujón de campo de visión (habilidades); lo consume WeaponController
	Shake = 0, -- temblor de cámara pendiente (explosiones cercanas); lo consume WeaponController
	MenuOpen = false, -- menú del pase/tienda abierto
	VoteOpen = false, -- panel de votación con el ratón libre
	InMainMenu = true, -- pantalla de inicio visible
	Aiming = false,
	AimAlpha = 0, -- 0 = cadera, 1 = apuntando
	Sprinting = false,
	Sliding = false,
	CurrentTool = nil,
	CurrentDef = nil,
	Ammo = 0,
	Reloading = false,
	ReloadProgress = 0,
	LastShotTime = 0,
	LastHitPosition = nil :: Vector3?, -- dónde dio tu último disparo a un personaje (números de daño)
	LastHitTime = 0,
	VotePanelVisible = false, -- hay votación de mapa en pantalla (la V es para votar, no para inspeccionar)
	Dashing = false, -- impulso (E) en curso: no se puede deslizar a la vez
	MenuClosedAt = 0, -- cuándo se cerró la tienda (la B no revive justo después)
	Bloom = 0, -- apertura extra de la mira por disparos
	Spread = 0, -- dispersión actual (grados)

	DataChanged = Instance.new("BindableEvent"),
	WeaponChanged = Instance.new("BindableEvent"),
	ShotFired = Instance.new("BindableEvent"),
}

-- ¿Hay algún menú que impida jugar (disparar, moverse con el ratón...)?
function ClientState.IsBlocked()
	return ClientState.MenuOpen or ClientState.VoteOpen or ClientState.InMainMenu or ClientState.Dead or ClientState.EmoteMenuOpen or ClientState.TutorialOpen or ClientState.WheelOpen
end

-- Cuenta atrás de Eliminación: quietos y sin disparar (lo decide el servidor)
function ClientState.Frozen()
	return game:GetService("ReplicatedStorage"):GetAttribute("Frozen") == true
end

-- El cursor se ve siempre que haya algún menú abierto (cada menú llama a esto al abrirse o cerrarse)
function ClientState.UpdateMouse()
	local blocked = ClientState.IsBlocked()
	game:GetService("UserInputService").MouseIconEnabled = blocked
	-- Botones táctiles del juego: ocultos mientras hay un menú abierto
	local cas = game:GetService("ContextActionService")
	for _, name in { "Fire", "Aim", "Reload", "Melee", "SwapWeapon", "Sprint", "Slide", "Grenade", "Airstrike", "Emotes", "Scoreboard" } do
		local button = cas:GetButton(name)
		if button then
			button.Visible = not blocked
		end
	end
end

function ClientState.SetData(data)
	if type(data) ~= "table" then
		return
	end
	ClientState.Data = data
	ClientState.DataChanged:Fire(data)
end

return ClientState
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">DeathScreen</string>
              <string name="Source"><![CDATA[-- Pantalla de muerte (estilo shooters de Roblox):
--   * Observas al que te eliminó en tercera persona (clic / clic derecho cambia de jugador)
--   * VOLVER AL MENÚ, REVIVIR INSTANTÁNEO (B, gasta un revivir: vuelves donde caíste) y
--     REGENERAR AHORA (Espacio o F, a partir de GameConfig.RespawnNowDelay)
-- Sin revivir disponibles, el botón abre la compra del pack (si está configurado en Shop).
-- En plena ronda de Eliminación (NoRespawn) no hay revivir ni regenerar: se observa hasta la siguiente.
-- También se puede observar a los bots (modelos en workspace.Bots).
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Shop = require(Shared.Shop)
local Sounds = require(Shared.Sounds)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local MainMenu = require(script.Parent.MainMenu)
local Menu = require(script.Parent.Menu)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local DeathScreen = {}

local gui: any = nil
local refs: { [string]: any } = {}
local deathTime = 0
local targets = {} -- jugadores (Player) o bots (Model) que se pueden observar
local targetIndex = 0
local spectating = nil -- Player o bot observado
local reviving = false
local originalZoom = { 0.5, 400 } -- zoom de la cámara del jugador (se restaura al reaparecer)

local BLUE = Color3.fromRGB(40, 140, 255)
local PINK = Color3.fromRGB(255, 70, 200)
local GREEN = Color3.fromRGB(70, 220, 60)

-- Personaje de un objetivo: el Character de un jugador o el propio modelo de un bot
local function characterOf(target)
	if target:IsA("Player") then
		return target.Character
	end
	return target.Parent and target or nil
end

local function teamOf(target)
	if target:IsA("Player") then
		return target.Team
	end
	local name = target:GetAttribute("Team")
	local team = name and name ~= "" and Teams:FindFirstChild(name)
	return team and team:IsA("Team") and team or nil
end

local function alive(p)
	local character = characterOf(p)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0, humanoid
end

local function noRespawn()
	return ReplicatedStorage:GetAttribute("NoRespawn") == true
end

-- Cámara en tercera persona detrás del jugador observado
local function watch(target)
	spectating = target
	local ok, humanoid = alive(target)
	if not ok then
		return
	end
	player.CameraMode = Enum.CameraMode.Classic
	player.CameraMinZoomDistance = 10
	player.CameraMaxZoomDistance = 14
	camera.CameraType = Enum.CameraType.Custom
	camera.CameraSubject = humanoid
	refs.SpectateName.Text = target:IsA("Player") and (target.DisplayName .. " (" .. target.Name .. ")") or target.Name
	refs.SpectatePanel.Visible = true
end

local function stopWatching()
	spectating = nil
	refs.SpectatePanel.Visible = false
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

local function restoreCamera()
	player.CameraMinZoomDistance = originalZoom[1]
	player.CameraMaxZoomDistance = originalZoom[2]
	player.CameraMode = Enum.CameraMode.LockFirstPerson
end

-- En Eliminación solo se observa a compañeros (si no, se podría chivar dónde están los enemigos)
local function canWatch(target)
	if target:IsA("Player") and target:GetAttribute("InMenu") then
		return false
	end
	if noRespawn() and player.Team then
		return teamOf(target) == player.Team
	end
	return true
end

local function refreshTargets(firstChoice)
	targets = {}
	for _, p in Players:GetPlayers() do
		if p ~= player and alive(p) and canWatch(p) then
			table.insert(targets, p)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			if model:IsA("Model") and alive(model) and canWatch(model) then
				table.insert(targets, model)
			end
		end
	end
	-- Primero el que te eliminó, luego tus compañeros
	local function rank(p)
		if p == firstChoice then
			return 0
		end
		return (player.Team and teamOf(p) == player.Team) and 1 or 2
	end
	table.sort(targets, function(a, b)
		return rank(a) < rank(b)
	end)
end

local function cycle(step)
	refreshTargets(spectating)
	if #targets == 0 then
		stopWatching()
		return
	end
	local current = spectating and table.find(targets, spectating) or 0
	targetIndex = ((current - 1 + step) % #targets) + 1
	watch(targets[targetIndex])
end

local function revivesLeft()
	local data = ClientState.Data
	return data and data.Revives or 0
end

local function toast(text)
	refs.Toast.Text = text
	refs.Toast.Visible = true
	task.delay(2, function()
		if refs.Toast.Text == text then
			refs.Toast.Visible = false
		end
	end)
end

local function tryRevive()
	if not ClientState.Dead or reviving then
		return
	end
	if noRespawn() then
		toast("Una sola vida por ronda")
		return
	end
	if revivesLeft() <= 0 then
		local pack = Shop.RevivePacks[1]
		if pack and pack.ProductId ~= 0 then
			MarketplaceService:PromptProductPurchase(player, pack.ProductId)
		else
			toast("No te quedan revivir")
		end
		return
	end
	reviving = true
	Sounds.Play("Click")
	local ok, result, reason = pcall(function()
		return Remotes.InstantRevive:InvokeServer()
	end)
	reviving = false
	if not ok or not result then
		toast(reason or "No se pudo revivir")
	end
end

local function respawnNow()
	if ClientState.Dead and os.clock() - deathTime >= GameConfig.RespawnNowDelay and not noRespawn() then
		Sounds.Play("Click")
		Remotes.RespawnNow:FireServer()
	end
end

local function close()
	if not ClientState.Dead then
		return
	end
	ClientState.Dead = false
	gui.Enabled = false
	stopWatching()
	restoreCamera()
	ClientState.UpdateMouse()
end

local function open(killerName)
	ClientState.Dead = true
	-- La tienda se cierra al morir (si no, la B que iba a cerrarla gastaría un revivir)
	Menu.Close()
	deathTime = os.clock()
	gui.Enabled = true
	refs.Toast.Visible = false
	ClientState.UpdateMouse()
	local bots = workspace:FindFirstChild("Bots")
	local killer = killerName and (Players:FindFirstChild(killerName) or (bots and bots:FindFirstChild(killerName)))
	refreshTargets(killer)
	if killer and alive(killer) and canWatch(killer) then
		watch(killer)
	elseif #targets > 0 then
		watch(targets[1])
	else
		refs.SpectatePanel.Visible = false
	end
end

-- Botón grande con texto encima ("Presiona B") y barra debajo
local function actionButton(text, hint, color, x)
	local holder = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, x, 1, -150),
		Size = UDim2.fromOffset(280, 110),
		BackgroundTransparency = 1,
		Parent = refs.Bottom,
	})
	if hint then
		UI.label({
			Size = UDim2.new(1, 0, 0, 26),
			Text = hint,
			TextSize = 22,
			Parent = holder,
		})
	end
	local button = UI.button({
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, 58),
		Text = text,
		TextSize = 26,
		BackgroundColor3 = color,
		Parent = holder,
	}, { UI.stroke(Color3.new(1, 1, 1), 3, 0), UI.gloss() })
	local bar = UI.new("Frame", {
		Position = UDim2.fromOffset(6, 92),
		Size = UDim2.new(1, -12, 0, 14),
		BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.65),
		Parent = holder,
	}, { UI.corner(7) })
	local fill = UI.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = color,
		Parent = bar,
	}, { UI.corner(7) })
	return holder, button, fill
end

local function build()
	gui = UI.new("ScreenGui", {
		Name = "DeathScreen",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 3,
		Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- Libera el ratón aunque la cámara esté en primera persona
	UI.new("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true, Parent = gui })

	refs.Bottom = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
	local scale = UI.new("UIScale", { Parent = refs.Bottom })
	local function rescale()
		local size = camera.ViewportSize
		scale.Scale = math.clamp(math.min(size.X / 1280, size.Y / 720), 0.55, 1)
	end
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()

	local _, menuButton = actionButton("VOLVER AL MENÚ", nil, BLUE, -300)
	local reviveHolder, reviveButton, reviveFill = actionButton("REVIVIR INSTANTÁNEO", "Presiona B", PINK, 0)
	local respawnHolder, respawnButton, respawnFill = actionButton("REGENERAR AHORA", "Presiona Espacio o F", GREEN, 300)
	refs.ReviveButton, refs.ReviveFill, refs.RespawnButton, refs.RespawnFill = reviveButton, reviveFill, respawnButton, respawnFill
	refs.ReviveHolder, refs.RespawnHolder = reviveHolder, respawnHolder
	-- Eliminación: en lugar de revivir/regenerar, un aviso
	refs.WaitLabel = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 150, 1, -170),
		Size = UDim2.fromOffset(560, 60),
		Text = "UNA VIDA POR RONDA\nEspera a la siguiente ronda",
		TextSize = 26,
		TextColor3 = Color3.fromRGB(255, 220, 90),
		Visible = false,
		Parent = refs.Bottom,
	})

	-- Corazón con alas y "N restantes"
	refs.ReviveBadge = UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, -6, 0, 22),
		Size = UDim2.fromOffset(150, 30),
		Rotation = -14,
		Text = "",
		TextSize = 22,
		TextColor3 = Color3.new(1, 1, 1),
		Parent = reviveHolder,
	})
	UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, -2, 0, 58),
		Size = UDim2.fromOffset(60, 60),
		Text = "💖",
		TextSize = 48,
		Parent = reviveHolder,
	})

	menuButton.Activated:Connect(function()
		Sounds.Play("Click")
		close()
		MainMenu.Show()
	end)
	reviveButton.Activated:Connect(tryRevive)
	respawnButton.Activated:Connect(respawnNow)

	-- Panel de observar (izquierda)
	refs.SpectatePanel = UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 30, 0.5, 20),
		Size = UDim2.fromOffset(440, 220),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = refs.Bottom,
	})
	refs.SpectateName = UI.label({
		Size = UDim2.new(1, 0, 0, 40),
		Text = "",
		TextSize = 32,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = refs.SpectatePanel,
	})
	UI.label({
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(1, 0, 0, 26),
		Text = "Haz clic / clic derecho para cambiar",
		TextSize = 20,
		TextColor3 = Color3.fromRGB(215, 215, 230),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = refs.SpectatePanel,
	})
	local stop = UI.button({
		Position = UDim2.fromOffset(0, 90),
		Size = UDim2.fromOffset(230, 46),
		Text = "DEJAR DE OBSERVAR",
		TextSize = 20,
		BackgroundColor3 = Color3.fromRGB(230, 50, 60),
		Parent = refs.SpectatePanel,
	}, { UI.stroke(Color3.new(1, 1, 1), 2, 0), UI.gloss() })
	stop.Activated:Connect(function()
		Sounds.Play("Click")
		stopWatching()
	end)

	refs.Toast = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -270),
		Size = UDim2.fromOffset(500, 34),
		Text = "",
		TextSize = 26,
		TextColor3 = Color3.fromRGB(255, 120, 140),
		Visible = false,
		Parent = refs.Bottom,
	})
end

local function update()
	if not ClientState.Dead then
		return
	end
	local oneLife = noRespawn()
	refs.ReviveHolder.Visible = not oneLife
	refs.RespawnHolder.Visible = not oneLife
	refs.WaitLabel.Visible = oneLife
	local elapsed = os.clock() - deathTime
	-- Revivir: la barra se vacía mientras queda tiempo para usarlo
	local reviveWindow = math.clamp(1 - elapsed / GameConfig.RespawnTime, 0, 1)
	refs.ReviveFill.Size = UDim2.fromScale(reviveWindow, 1)
	local left = revivesLeft()
	refs.ReviveBadge.Text = left > 0 and (left .. " restantes") or "¡Consigue más!"
	refs.ReviveButton.AutoButtonColor = reviveWindow > 0
	-- Regenerar: la barra se llena hasta que se puede pulsar
	local charge = math.clamp(elapsed / GameConfig.RespawnNowDelay, 0, 1)
	refs.RespawnFill.Size = UDim2.fromScale(charge, 1)
	refs.RespawnButton.BackgroundTransparency = charge >= 1 and 0 or 0.35
	-- Si el observado muere o se va, pasa al siguiente
	if spectating and not alive(spectating) then
		cycle(1)
	end
end

function DeathScreen.Init()
	originalZoom = { player.CameraMinZoomDistance, player.CameraMaxZoomDistance }
	build()
	Remotes.Died.OnClientEvent:Connect(open)
	player.CharacterAdded:Connect(function(character)
		close()
		local humanoid = character:WaitForChild("Humanoid", 5)
		if humanoid and not ClientState.InMainMenu then
			camera.CameraType = Enum.CameraType.Custom
			camera.CameraSubject = humanoid
		end
	end)
	-- Las teclas B, F y Espacio están enlazadas con ContextActionService (menú, cuchillo, salto), así que
	-- llegan marcadas como "procesadas": solo se ignoran si se está escribiendo en el chat. Los clics sí se
	-- ignoran cuando caen sobre un botón de la interfaz.
	UserInputService.InputBegan:Connect(function(input, processed)
		if not ClientState.Dead or UserInputService:GetFocusedTextBox() then
			return
		end
		local isClick = input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2
		if isClick and processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.B or input.KeyCode == Enum.KeyCode.ButtonY then
			-- No gasta un revivir si la B era para cerrar la tienda
			if not ClientState.MenuOpen and os.clock() - ClientState.MenuClosedAt > 1 then
				tryRevive()
			end
		elseif input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.ButtonA then
			respawnNow()
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonR1 then
			cycle(1)
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 or input.KeyCode == Enum.KeyCode.ButtonL1 then
			cycle(-1)
		end
	end)
	RunService.RenderStepped:Connect(update)
	-- Muerto en Eliminación y de vuelta desde la pantalla de inicio: vuelve a la pantalla de muerte
	-- (se observa a los compañeros hasta la siguiente ronda en vez de quedarse mirando el cuerpo)
	RunService.Heartbeat:Connect(function()
		if ClientState.Dead or ClientState.InMainMenu or not noRespawn() then
			return
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health <= 0 then
			open(nil)
		end
	end)
end

return DeathScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[-- Efectos visuales (solo en el cliente): fogonazo, balas trazadoras, impactos, casquillos y bajas.
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local ClientState = require(script.Parent.ClientState)

local Effects = {}

-- Texturas de partículas incluidas con Roblox
local TEX = {
	Fire = "rbxasset://textures/particles/fire_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
}

local folder = Instance.new("Folder")
folder.Name = "ClientFX"
folder.Parent = workspace

local function fxPart(props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	for key, value in props do
		part[key] = value
	end
	part.Parent = folder
	return part
end

-- lookAt que no falla cuando la dirección es vertical (por ejemplo, impactos en el suelo)
local function safeLookAt(position, direction)
	local up = math.abs(direction.Unit.Y) > 0.99 and Vector3.zAxis or Vector3.yAxis
	return CFrame.lookAt(position, position + direction, up)
end

local function seq(a, b)
	return NumberSequence.new({ NumberSequenceKeypoint.new(0, a), NumberSequenceKeypoint.new(1, b) })
end

-- Pieza invisible que sirve de emisor; su +Y apunta hacia `direction`
local function emitterAnchor(position, direction, lifetime)
	direction = (direction and direction.Magnitude > 0.01) and direction.Unit or Vector3.yAxis
	local anchor = fxPart({
		Size = Vector3.new(0.1, 0.1, 0.1),
		Transparency = 1,
		CFrame = safeLookAt(position, direction) * CFrame.Angles(-math.pi / 2, 0, 0),
	})
	Debris:AddItem(anchor, lifetime or 2)
	return anchor
end

local function emit(parent, props, count)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Enabled = false
	emitter.EmissionDirection = Enum.NormalId.Top
	for key, value in props do
		emitter[key] = value
	end
	emitter.Parent = parent
	emitter:Emit(count)
	return emitter
end

-- Reutilización para los efectos de cada disparo: en un tiroteo se creaban decenas de piezas y
-- emisores por segundo (y cada uno avisaba a Settings). Ahora hay un juego de anclas que se van
-- turnando, cada una con sus emisores guardados por tipo; las partículas ya emitidas no se mueven
-- al recolocar el ancla (están en el mundo).
local ANCHOR_POOL = 24
local anchorPool, anchorIndex = {}, 0
local emitterCache = {} -- [ancla] = { [tipo] = ParticleEmitter }

local function pooledAnchor(position, direction)
	direction = (direction and direction.Magnitude > 0.01) and direction.Unit or Vector3.yAxis
	anchorIndex = anchorIndex % ANCHOR_POOL + 1
	local anchor = anchorPool[anchorIndex]
	if not anchor or not anchor.Parent then
		if anchor then
			emitterCache[anchor] = nil
		end
		anchor = fxPart({ Name = "FXAnchor", Size = Vector3.new(0.1, 0.1, 0.1), Transparency = 1 })
		anchorPool[anchorIndex] = anchor
		emitterCache[anchor] = {}
	end
	anchor.CFrame = safeLookAt(position, direction) * CFrame.Angles(-math.pi / 2, 0, 0)
	return anchor
end

-- Como emit, pero con el emisor guardado en el ancla (se crea la primera vez; el color se actualiza)
local function emitPooled(anchor, key, props, count)
	local cache = emitterCache[anchor]
	if not cache then
		return emit(anchor, props, count)
	end
	local emitter = cache[key]
	if not emitter then
		emitter = emit(anchor, props, 0)
		cache[key] = emitter
	elseif props.Color then
		emitter.Color = props.Color
	end
	emitter:Emit(count)
	return emitter
end

-- Piezas que se reutilizan por turnos (trazadoras y marcas de bala)
local function partRing(size)
	return { Parts = {}, Index = 0, Size = size, Tokens = {} }
end
local function ringPart(ring, props)
	ring.Index = ring.Index % ring.Size + 1
	local part = ring.Parts[ring.Index]
	if not part or not part.Parent then
		part = fxPart(props)
		ring.Parts[ring.Index] = part
	else
		for key, value in props do
			part[key] = value
		end
	end
	local token = (ring.Tokens[ring.Index] or 0) + 1
	ring.Tokens[ring.Index] = token
	return part, ring.Index, token
end
-- Oculta la pieza al acabar, si nadie la ha reutilizado mientras tanto
local function hideLater(ring, index, token, delay)
	task.delay(delay, function()
		local part = ring.Parts[index]
		if ring.Tokens[index] == token and part then
			part.Transparency = 1
		end
	end)
end
-- (las marcas duran 5 s: con 16 disparos por segundo hacen falta unas 80 para que no desaparezcan antes)
local bulletRing, trailRing, markRing, chipRing = partRing(30), partRing(30), partRing(80), partRing(80)

---------------------------------------------------------------------------

-- Bala trazadora que viaja desde el cañón hasta el impacto, con una estela tenue
function Effects.Tracer(from, to, color)
	local distance = (to - from).Magnitude
	if distance < 1 then
		return
	end
	color = color or Color3.fromRGB(255, 230, 120)
	local direction = safeLookAt(from, to - from)

	-- Estela fina que se desvanece
	local trail = ringPart(trailRing, {
		Color = color,
		Size = Vector3.new(0.03, 0.03, distance),
		CFrame = direction * CFrame.new(0, 0, -distance / 2),
		Transparency = 0.6,
	})
	TweenService:Create(trail, TweenInfo.new(0.1), { Transparency = 1 }):Play()

	-- La bala
	local length = math.min(6, distance)
	local travel = math.max(distance - length, 0.01)
	local duration = math.clamp(distance / 900, 0.02, 0.25)
	local bullet, index, token = ringPart(bulletRing, {
		Color = color,
		Size = Vector3.new(0.12, 0.12, length),
		CFrame = direction * CFrame.new(0, 0, -length / 2),
		Transparency = 0,
	})
	TweenService
		:Create(bullet, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = direction * CFrame.new(0, 0, -length / 2 - travel) })
		:Play()
	hideLater(bulletRing, index, token, duration + 0.02)
end

-- Fogonazo: estrella de luz, llamas y humo. remote = disparo de otro (más barato: sin luz ni estrella)
function Effects.MuzzleFlash(attachment, color, remote)
	if not attachment then
		return
	end
	color = color or Color3.fromRGB(255, 200, 90)
	local cf = attachment.WorldCFrame
	local spin = math.random() * math.pi
	for i = 0, remote and -1 or 1 do
		local star = fxPart({
			Color = color:Lerp(Color3.new(1, 1, 1), 0.4),
			Size = Vector3.new(0.08, 0.7, 0.3),
			CFrame = cf * CFrame.new(0, 0, -0.2) * CFrame.Angles(0, 0, spin + i * math.pi / 2),
		})
		Debris:AddItem(star, 0.04)
	end
	local core = fxPart({
		Color = Color3.fromRGB(255, 240, 200),
		Size = Vector3.new(0.3, 0.3, 0.3),
		Shape = Enum.PartType.Ball,
		CFrame = cf * CFrame.new(0, 0, -0.15),
	})
	if not remote then
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = 12
		light.Brightness = 4
		light.Parent = core
	end
	Debris:AddItem(core, 0.05)

	local anchor = pooledAnchor(cf.Position, cf.LookVector)
	emitPooled(anchor, "MuzzleFire", {
		Texture = TEX.Fire,
		Color = ColorSequence.new(Color3.fromRGB(255, 240, 180), color),
		LightEmission = 1,
		Size = seq(0.45, 0),
		Transparency = seq(0, 1),
		Lifetime = NumberRange.new(0.04, 0.08),
		Speed = NumberRange.new(4, 8),
		SpreadAngle = Vector2.new(12, 12),
	}, 5)
	emitPooled(anchor, "MuzzleSmoke", {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(Color3.fromRGB(220, 220, 220)),
		Size = seq(0.2, 0.9),
		Transparency = seq(0.6, 1),
		Lifetime = NumberRange.new(0.4, 0.8),
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(20, 20),
		Acceleration = Vector3.new(0, 1.5, 0),
	}, 2)
end

-- Tipo de superficie según el material: cambia la reacción al impacto (chispas en metal, astillas
-- en madera, polvo y esquirlas en piedra, tierra o nieve que saltan, salpicadura en agua)
local SURFACE = {}
for kind, materials in {
	Metal = { "Metal", "CorrodedMetal", "DiamondPlate", "Foil" },
	Wood = { "Wood", "WoodPlanks" },
	Stone = {
		"Concrete", "Brick", "Cobblestone", "Slate", "Granite", "Marble", "Pebble", "Rock", "Basalt", "Limestone",
		"Pavement", "Asphalt", "Plaster", "Sandstone", "CeramicTiles", "ClayRoofTiles", "CrackedLava",
	},
	Dirt = { "Grass", "LeafyGrass", "Ground", "Mud", "Sand" },
	Snow = { "Snow", "Ice", "Glacier" },
	Water = { "Water" },
	Glass = { "Glass" },
} do
	for _, name in materials do
		local ok, material = pcall(function()
			return (Enum.Material :: any)[name]
		end)
		if ok and material then
			SURFACE[material] = kind
		end
	end
end

local function surfaceColor(hitPart, material)
	if hitPart and hitPart:IsA("Terrain") then
		local ok, color = pcall(function()
			return workspace.Terrain:GetMaterialColor(material)
		end)
		return ok and color or Color3.fromRGB(150, 140, 120)
	end
	return hitPart and hitPart.Color or Color3.fromRGB(200, 200, 200)
end

-- Impacto: reacción según la superficie, polvo del color del material y marca de bala
-- Pintura (arma de paintball): gotas de un color al azar y, en superficies, una mancha plana que se
-- desvanece a los pocos segundos (como mucho MAX_SPLATS a la vez)
local PAINT_COLORS = {
	Color3.fromRGB(255, 60, 140),
	Color3.fromRGB(60, 200, 255),
	Color3.fromRGB(255, 220, 40),
	Color3.fromRGB(120, 230, 60),
	Color3.fromRGB(170, 90, 255),
	Color3.fromRGB(255, 140, 40),
}
local MAX_SPLATS = 40
local splats = {}

local function paintSplat(anchor, position, normal, isCharacter)
	local color = PAINT_COLORS[math.random(1, #PAINT_COLORS)]
	emitPooled(anchor, "Paint", {
		Texture = TEX.Sparkle,
		Color = ColorSequence.new(color),
		LightEmission = 0.2,
		Size = seq(0.4, 0.1),
		Lifetime = NumberRange.new(0.3, 0.55),
		Speed = NumberRange.new(8, 16),
		SpreadAngle = Vector2.new(55, 55),
		Acceleration = Vector3.new(0, -60, 0),
	}, isCharacter and 12 or 10)
	if isCharacter then
		return
	end
	normal = (normal and normal.Magnitude > 0.01) and normal.Unit or Vector3.yAxis
	local size = 1.2 + math.random() * 1.2
	-- Cilindro muy fino pegado a la superficie (su eje X apunta en la dirección de la normal)
	local splat = fxPart({
		Name = "PaintSplat",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.04, size, size),
		CFrame = safeLookAt(position + normal * 0.03, normal) * CFrame.Angles(0, math.pi / 2, 0),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
	})
	table.insert(splats, splat)
	if #splats > MAX_SPLATS then
		local oldest = table.remove(splats, 1)
		if oldest then
			oldest:Destroy()
		end
	end
	task.delay(5, function()
		if splat.Parent then
			TweenService:Create(splat, TweenInfo.new(1.5), { Transparency = 1 }):Play()
			task.delay(1.6, function()
				local index = table.find(splats, splat)
				if index then
					table.remove(splats, index)
				end
				splat:Destroy()
			end)
		end
	end)
end

-- style = "Paint" para las armas de paintball (def.ImpactStyle)
function Effects.Impact(position, normal, hitPart, material, style)
	local isCharacter = hitPart ~= nil
		and hitPart.Parent ~= nil
		and (hitPart.Parent:FindFirstChildOfClass("Humanoid") ~= nil or hitPart.Parent:IsA("Accessory"))
	local anchor = pooledAnchor(position + (normal or Vector3.yAxis) * 0.05, normal)
	if style == "Paint" then
		paintSplat(anchor, position, normal, isCharacter)
		return
	end

	if isCharacter then
		-- Destello de golpe (estilo cartoon, sin sangre)
		emitPooled(anchor, "Hit", {
			Texture = TEX.Sparkle,
			Color = ColorSequence.new(Color3.fromRGB(255, 90, 90), Color3.fromRGB(255, 220, 120)),
			LightEmission = 1,
			Size = seq(0.5, 0),
			Lifetime = NumberRange.new(0.15, 0.3),
			Speed = NumberRange.new(6, 12),
			SpreadAngle = Vector2.new(60, 60),
			Rotation = NumberRange.new(0, 360),
		}, 8)
		return
	end

	material = material or (hitPart and hitPart.Material) or Enum.Material.Plastic
	local kind = SURFACE[material] or "Plastic"
	local baseColor = surfaceColor(hitPart, material)

	if kind == "Water" then
		-- Salpicadura: gotas hacia arriba que caen y un poco de espuma
		emitPooled(anchor, "WaterDrops", {
			Texture = TEX.Sparkle,
			Color = ColorSequence.new(Color3.fromRGB(220, 240, 255)),
			LightEmission = 0.3,
			Size = seq(0.25, 0.05),
			Lifetime = NumberRange.new(0.4, 0.7),
			Speed = NumberRange.new(10, 18),
			SpreadAngle = Vector2.new(18, 18),
			Acceleration = Vector3.new(0, -50, 0),
		}, 12)
		emitPooled(anchor, "WaterFoam", {
			Texture = TEX.Smoke,
			Color = ColorSequence.new(Color3.fromRGB(240, 248, 255)),
			Size = seq(0.6, 2),
			Transparency = seq(0.4, 1),
			Lifetime = NumberRange.new(0.4, 0.6),
			Speed = NumberRange.new(1, 2),
			SpreadAngle = Vector2.new(70, 70),
		}, 3)
		return
	end

	-- Chispas: muchas en metal, pocas en piedra y cristal, ninguna en materiales blandos
	local sparks = (kind == "Metal" and 12) or ((kind == "Stone" or kind == "Glass" or kind == "Plastic") and 4) or 0
	if sparks > 0 then
		emitPooled(anchor, "Sparks" .. kind, {
			Texture = TEX.Sparkle,
			Color = ColorSequence.new(Color3.fromRGB(255, 230, 150), Color3.fromRGB(255, 150, 60)),
			LightEmission = 1,
			Size = seq(kind == "Metal" and 0.22 or 0.16, 0),
			Lifetime = NumberRange.new(0.15, kind == "Metal" and 0.5 or 0.3),
			Speed = NumberRange.new(10, 20),
			SpreadAngle = Vector2.new(50, 50),
			Acceleration = Vector3.new(0, -45, 0),
		}, sparks)
	end

	-- Esquirlas que saltan y caen (astillas de madera, trozos de piedra, terrones, cristal)
	if kind == "Wood" or kind == "Stone" or kind == "Dirt" or kind == "Glass" or kind == "Snow" then
		local chipColor = kind == "Glass" and Color3.fromRGB(220, 240, 255) or baseColor:Lerp(Color3.new(0, 0, 0), kind == "Wood" and 0.25 or 0.1)
		emitPooled(anchor, "Chips" .. kind, {
			Texture = TEX.Smoke,
			Color = ColorSequence.new(chipColor),
			LightInfluence = 1,
			Size = seq(kind == "Snow" and 0.35 or 0.22, 0.12),
			Lifetime = NumberRange.new(0.35, 0.6),
			Speed = NumberRange.new(8, 15),
			SpreadAngle = Vector2.new(40, 40),
			Acceleration = Vector3.new(0, -55, 0),
			Rotation = NumberRange.new(0, 360),
			RotSpeed = NumberRange.new(-300, 300),
		}, kind == "Wood" and 6 or 5)
	end

	-- Nube de polvo del color de la superficie (más grande en tierra y nieve)
	local soft = kind == "Dirt" or kind == "Snow"
	local dustColor = baseColor:Lerp(Color3.new(1, 1, 1), kind == "Snow" and 0.5 or 0.3)
	if kind ~= "Metal" and kind ~= "Glass" then
		emitPooled(anchor, soft and "DustSoft" or "Dust", {
			Texture = TEX.Smoke,
			Color = ColorSequence.new(dustColor),
			LightInfluence = 1,
			Size = seq(soft and 0.6 or 0.3, soft and 2.4 or 1.5),
			Transparency = seq(soft and 0.2 or 0.3, 1),
			Lifetime = NumberRange.new(soft and 0.7 or 0.45, soft and 1.1 or 0.8),
			Speed = NumberRange.new(soft and 3 or 1.5, soft and 6 or 3),
			SpreadAngle = Vector2.new(30, 30),
			Acceleration = Vector3.new(0, soft and -6 or 0.5, 0),
			WindAffectsDrag = true,
		}, soft and 5 or 3)
	end

	-- Marca de bala (no queda en nieve ni en tierra blanda)
	if soft then
		return
	end
	local markColor = (kind == "Metal" and Color3.fromRGB(70, 70, 76))
		or (kind == "Wood" and Color3.fromRGB(45, 30, 20))
		or (kind == "Glass" and Color3.fromRGB(230, 240, 250))
		or Color3.fromRGB(25, 25, 28)
	local mark = ringPart(markRing, {
		Color = markColor,
		Material = kind == "Metal" and Enum.Material.Metal or Enum.Material.SmoothPlastic,
		Size = Vector3.new(0.22, 0.22, 0.03),
		Shape = Enum.PartType.Block,
		CFrame = safeLookAt(position, normal or Vector3.yAxis) * CFrame.Angles(0, 0, math.random() * math.pi),
		Transparency = kind == "Glass" and 0.4 or 0.15,
	})
	if kind == "Stone" then
		-- Desconchón claro alrededor del agujero
		local chip = ringPart(chipRing, {
			Color = baseColor:Lerp(Color3.new(1, 1, 1), 0.25),
			Material = Enum.Material.SmoothPlastic,
			Size = Vector3.new(0.45, 0.45, 0.012),
			CFrame = mark.CFrame * CFrame.new(0, 0, -0.003) * CFrame.Angles(0, 0, 0.6),
			Transparency = 0.35,
		})
		TweenService:Create(chip, TweenInfo.new(5, Enum.EasingStyle.Linear), { Transparency = 1 }):Play()
	end
	TweenService:Create(mark, TweenInfo.new(5, Enum.EasingStyle.Linear), { Transparency = 1 }):Play()
end

-- Casquillo que sale disparado por la derecha del arma
local liveCasings = 0
local MAX_CASINGS = 8 -- con fuego automático no hace falta simular más a la vez

function Effects.ShellCasing(attachment, cameraCFrame, color)
	if not attachment or liveCasings >= MAX_CASINGS then
		return
	end
	liveCasings += 1
	task.delay(1.5, function()
		liveCasings -= 1
	end)
	local casing = Instance.new("Part")
	casing.Size = Vector3.new(0.06, 0.06, 0.16)
	casing.Color = color or Color3.fromRGB(230, 180, 60)
	casing.Material = Enum.Material.Metal
	casing.Reflectance = 0.2
	casing.CanCollide = true
	casing.CanQuery = false
	casing.CanTouch = false
	casing.CastShadow = false
	casing.Massless = true
	casing.CustomPhysicalProperties = PhysicalProperties.new(0.05, 0.3, 0.6)
	casing.CFrame = attachment.WorldCFrame
	casing.Parent = folder
	local right = cameraCFrame.RightVector
	local up = cameraCFrame.UpVector
	casing.AssemblyLinearVelocity = right * (6 + math.random() * 3) + up * (5 + math.random() * 3)
	casing.AssemblyAngularVelocity = Vector3.new(math.random(-20, 20), math.random(-20, 20), math.random(-20, 20))
	Debris:AddItem(casing, 1.5)
end

-- Explosión del cohete
function Effects.Explosion(position, radius, color)
	radius = radius or 12
	-- Temblor de cámara si la explosión es cercana (más fuerte cuanto más cerca)
	local camera = workspace.CurrentCamera
	if camera then
		local distance = (camera.CFrame.Position - position).Magnitude
		local strength = math.clamp(1 - distance / (radius * 4), 0, 1)
		if strength > 0 then
			ClientState.Shake = math.max(ClientState.Shake or 0, strength)
		end
	end
	color = color or Color3.fromRGB(255, 140, 30)
	local fireball = fxPart({
		Color = Color3.fromRGB(255, 200, 80),
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(2, 2, 2),
		CFrame = CFrame.new(position),
		Transparency = 0,
	})
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = radius * 2.5
	light.Brightness = 6
	light.Parent = fireball
	TweenService:Create(fireball, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Size = Vector3.one * radius * 1.2, Transparency = 1, Color = color }):Play()
	TweenService:Create(light, TweenInfo.new(0.5), { Brightness = 0 }):Play()
	Debris:AddItem(fireball, 0.55)

	-- Onda expansiva en el suelo
	local ring = fxPart({
		Color = color:Lerp(Color3.new(1, 1, 1), 0.4),
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 2, 2),
		CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2),
		Transparency = 0.2,
	})
	TweenService:Create(ring, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Size = Vector3.new(0.1, radius * 2.4, radius * 2.4), Transparency = 1 }):Play()
	Debris:AddItem(ring, 0.45)

	local anchor = emitterAnchor(position, Vector3.yAxis, 3)
	emit(anchor, {
		Texture = TEX.Fire,
		Color = ColorSequence.new(Color3.fromRGB(255, 230, 150), color),
		LightEmission = 1,
		Size = seq(3, 0.5),
		Transparency = seq(0, 1),
		Lifetime = NumberRange.new(0.3, 0.6),
		Speed = NumberRange.new(10, 22),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 3,
	}, 30)
	emit(anchor, {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(Color3.fromRGB(70, 65, 60)),
		Size = seq(2, 7),
		Transparency = seq(0.2, 1),
		Lifetime = NumberRange.new(1.2, 2.2),
		Speed = NumberRange.new(3, 8),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, 3, 0),
	}, 14)
	emit(anchor, {
		Texture = TEX.Sparkle,
		Color = ColorSequence.new(Color3.fromRGB(255, 220, 120)),
		LightEmission = 1,
		Size = seq(0.3, 0),
		Lifetime = NumberRange.new(0.5, 1),
		Speed = NumberRange.new(25, 45),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -60, 0),
	}, 20)

	-- Columna de humo negro que se queda unos segundos
	local smokeAnchor = emitterAnchor(position + Vector3.new(0, 1, 0), Vector3.yAxis, 6)
	emit(smokeAnchor, {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(Color3.fromRGB(40, 38, 36), Color3.fromRGB(90, 88, 85)),
		Size = seq(3, 10),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.5),
			NumberSequenceKeypoint.new(0.6, 0.7),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(3, 5),
		Speed = NumberRange.new(2, 4),
		SpreadAngle = Vector2.new(25, 25),
		Acceleration = Vector3.new(0.5, 2.5, 0),
		RotSpeed = NumberRange.new(-25, 25),
		Rotation = NumberRange.new(0, 360),
	}, 10)

	-- Escombros que salen despedidos
	for _ = 1, 8 do
		local chunk = fxPart({
			Size = Vector3.new(0.3 + math.random() * 0.4, 0.2 + math.random() * 0.3, 0.3 + math.random() * 0.4),
			Color = Color3.fromRGB(70, 66, 62),
			Material = Enum.Material.Slate,
			CFrame = CFrame.new(position + Vector3.new(0, 0.5, 0)) * CFrame.Angles(math.random() * 6, math.random() * 6, 0),
		})
		chunk.Anchored = false
		local dir = Vector3.new(math.random() - 0.5, 0.7 + math.random() * 0.6, math.random() - 0.5).Unit
		chunk.AssemblyLinearVelocity = dir * (25 + math.random() * 20)
		chunk.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 25
		TweenService:Create(chunk, TweenInfo.new(0.4, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 1.4), { Transparency = 1 }):Play()
		Debris:AddItem(chunk, 1.9)
	end

	-- Marca de quemado en el suelo (si hay suelo cerca)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { folder }
	local ground = workspace:Raycast(position + Vector3.new(0, 2, 0), Vector3.new(0, -8, 0), params)
	if ground and ground.Instance then
		local scorch = fxPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.05, radius * 0.9, radius * 0.9),
			Color = Color3.fromRGB(22, 20, 18),
			Material = Enum.Material.Slate,
			CFrame = safeLookAt(ground.Position + ground.Normal * 0.04, ground.Normal) * CFrame.Angles(0, math.pi / 2, 0),
			Transparency = 0.25,
		})
		TweenService:Create(scorch, TweenInfo.new(4, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 6), { Transparency = 1 }):Play()
		Debris:AddItem(scorch, 10.2)
	end
end

-- Cohete que vuela hasta `to` y explota al llegar
function Effects.Rocket(from, to, speed, color, radius)
	local distance = (to - from).Magnitude
	if distance < 0.5 then
		Effects.Explosion(to, radius, color)
		return
	end
	local direction = safeLookAt(from, to - from)
	local rocket = fxPart({
		Color = Color3.fromRGB(230, 230, 235),
		Material = Enum.Material.SmoothPlastic,
		Size = Vector3.new(0.35, 0.35, 1.3),
		CFrame = direction,
	})
	local tip = fxPart({
		Color = Color3.fromRGB(220, 40, 40),
		Material = Enum.Material.SmoothPlastic,
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.38, 0.38, 0.38),
		CFrame = direction * CFrame.new(0, 0, -0.65),
	})
	local flame = fxPart({
		Color = color or Color3.fromRGB(255, 160, 40),
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.45, 0.45, 0.45),
		CFrame = direction * CFrame.new(0, 0, 0.7),
	})
	local trail = Instance.new("ParticleEmitter")
	trail.Texture = TEX.Smoke
	trail.Color = ColorSequence.new(Color3.fromRGB(200, 200, 200))
	trail.Size = seq(0.4, 1.6)
	trail.Transparency = seq(0.3, 1)
	trail.Lifetime = NumberRange.new(0.5, 0.9)
	trail.Speed = NumberRange.new(0.5, 1)
	trail.Rate = 80
	trail.Parent = flame
	local duration = distance / speed
	for _, part in { rocket, tip, flame } do
		local offset = direction:ToObjectSpace(part.CFrame)
		local finalCF = direction * CFrame.new(0, 0, -distance) * offset
		TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = finalCF }):Play()
	end
	task.delay(duration, function()
		trail.Enabled = false
		rocket:Destroy()
		tip:Destroy()
		flame.Transparency = 1
		Debris:AddItem(flame, 1)
		Effects.Explosion(to, radius, color)
	end)
end

-- Explosión de partículas cuando alguien es eliminado
function Effects.DeathBurst(position, color)
	color = color or Color3.new(1, 1, 1)
	local anchor = emitterAnchor(position, Vector3.yAxis, 2.5)
	emit(anchor, {
		Texture = TEX.Sparkle,
		Color = ColorSequence.new(color, Color3.new(1, 1, 1)),
		LightEmission = 1,
		Size = seq(0.9, 0),
		Lifetime = NumberRange.new(0.5, 0.9),
		Speed = NumberRange.new(10, 20),
		SpreadAngle = Vector2.new(180, 180),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-180, 180),
		Drag = 4,
	}, 24)
	emit(anchor, {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.6)),
		Size = seq(1.5, 4),
		Transparency = seq(0.4, 1),
		Lifetime = NumberRange.new(0.8, 1.3),
		Speed = NumberRange.new(2, 5),
		SpreadAngle = Vector2.new(180, 180),
	}, 6)
	local flash = fxPart({
		Color = color,
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(position),
		Transparency = 0.2,
	})
	TweenService:Create(flash, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Size = Vector3.new(7, 7, 7), Transparency = 1 }):Play()
	Debris:AddItem(flash, 0.4)
end

---------------------------------------------------------------------------
-- Efectos de eliminación (ver KillEffects.luau)
---------------------------------------------------------------------------

-- Emoji o texto que flota en el mundo (BillboardGui) y se desvanece
local function floatingText(position, text, size, rise, duration, color)
	local anchor = fxPart({ Size = Vector3.new(0.1, 0.1, 0.1), Transparency = 1, CFrame = CFrame.new(position) })
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(size, size)
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = 400
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.Parent = gui
	TweenService:Create(anchor, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.new(position + rise) }):Play()
	TweenService:Create(label, TweenInfo.new(duration * 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, duration * 0.5), { TextTransparency = 1 }):Play()
	Debris:AddItem(anchor, duration + 0.1)
end

-- Piezas sueltas que salen disparadas con física (confeti, monedas, cristales)
local function debrisBurst(position, count, makePart, speed, lifetime)
	for _ = 1, count do
		local part = makePart()
		part.Anchored = false
		part.CanCollide = false -- no empujan a nadie; desaparecen antes de caer mucho
		part.CFrame = CFrame.new(position + Vector3.new(math.random() - 0.5, math.random() * 0.5, math.random() - 0.5))
			* CFrame.Angles(math.random() * 6.28, math.random() * 6.28, math.random() * 6.28)
		local dir = Vector3.new(math.random() - 0.5, 0.6 + math.random() * 0.8, math.random() - 0.5).Unit
		part.AssemblyLinearVelocity = dir * speed * (0.6 + math.random() * 0.6)
		part.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 20
		TweenService:Create(part, TweenInfo.new(0.4, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, lifetime - 0.4), { Transparency = 1 }):Play()
		Debris:AddItem(part, lifetime)
	end
end

local CONFETTI_COLORS = {
	Color3.fromRGB(255, 70, 90),
	Color3.fromRGB(255, 210, 40),
	Color3.fromRGB(60, 200, 255),
	Color3.fromRGB(120, 255, 120),
	Color3.fromRGB(200, 100, 255),
	Color3.fromRGB(255, 140, 30),
}

local function flashBall(position, color, size, duration)
	local flash = fxPart({ Color = color, Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(position), Transparency = 0.2 })
	TweenService:Create(flash, TweenInfo.new(duration, Enum.EasingStyle.Quad), { Size = Vector3.one * size, Transparency = 1 }):Play()
	Debris:AddItem(flash, duration + 0.05)
	return flash
end

local KILL_FX = {}

KILL_FX.Confeti = function(position)
	debrisBurst(position, 36, function()
		return fxPart({
			Size = Vector3.new(0.35, 0.05, 0.25),
			Color = CONFETTI_COLORS[math.random(1, #CONFETTI_COLORS)],
			Material = Enum.Material.SmoothPlastic,
		})
	end, 22, 1.6)
	flashBall(position, Color3.fromRGB(255, 230, 120), 5, 0.3)
