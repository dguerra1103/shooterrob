---------------------------------------------------------------------------
-- Ventanas encima (clasificación, clan, rachas)
---------------------------------------------------------------------------

local overlay
local function openOverlay(title, height)
	if overlay then
		overlay:Destroy()
	end
	overlay = C.new("Frame", { Name = "Overlay", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Size = UDim2.fromScale(1, 1), ZIndex = 40, Parent = screen })
	local blocker = C.new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 40, Parent = overlay })
	blocker.Activated:Connect(function()
		overlay:Destroy()
		overlay = nil
	end)
	local panel = C.panel({ Name = "Window", Anchor = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(440, height or 360), ZIndex = 41, Parent = overlay }, { Alpha = 0.05, StrokeColor = Colors.Yellow, StrokeAlpha = 0.5 })
	C.text({ Text = title, Role = "TitleItalic", TextSize = 28, Color = Colors.White, Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -70, 0, 34), ZIndex = 42, Parent = panel })
	local close = C.button({ Name = "Close", Text = "✕", Style = "Ghost", TextSize = 18, Anchor = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.fromOffset(36, 36), ZIndex = 43, Parent = panel, Sound = "Back", OnClick = function()
		if overlay then
			overlay:Destroy()
			overlay = nil
		end
	end })
	close.ZIndex = 43
	Transition.Pop(panel, 0.92, 0.18)
	local body = C.new("Frame", { Name = "Body", BackgroundTransparency = 1, Position = UDim2.fromOffset(16, 52), Size = UDim2.new(1, -32, 1, -64), ZIndex = 42, Parent = panel })
	return body
end

function Home.OpenLeaderboard()
	local body = openOverlay("CLASIFICACIÓN", 420)
	local tabs = C.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), ZIndex = 42, Parent = body }, { C.list(6, Enum.FillDirection.Horizontal) })
	local list = C.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 1, -42), ZIndex = 42, Parent = body }, { C.list(3) })
	local board = "Kills"
	local buttons = {}
	local function render()
		for _, child in list:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		for id, button in buttons do
			C.setSelected(button, id == board)
		end
		local raw = ReplicatedStorage:GetAttribute("Leaderboard_" .. board)
		local ok, rows = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		if type(raw) ~= "string" or not ok or type(rows) ~= "table" or #rows == 0 then
			C.text({ Text = "Aún no hay datos. ¡Sé el primero!", Role = "BodyBold", TextSize = 16, Color = Colors.TextDim, ZIndex = 43, Parent = list })
			return
		end
		for i, row in rows do
			if i > 10 then
				break
			end
			local me = row.UserId == player.UserId
			local line = C.new("Frame", { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 27), BackgroundColor3 = me and Colors.Yellow or Colors.PanelLight, BackgroundTransparency = me and 0.75 or 0.5, BorderSizePixel = 0, ZIndex = 42, Parent = list }, { C.corner(3) })
			C.text({ Text = "#" .. tostring(row.Rank or i), Role = "Number", TextSize = 16, Color = i <= 3 and Colors.YellowText or Colors.TextDim, Position = UDim2.fromOffset(8, 0), Size = UDim2.fromOffset(40, 27), ZIndex = 43, Parent = line })
			C.text({ Text = tostring(row.Name or "?"), Role = "BodyBold", TextSize = 15, Color = me and Colors.YellowText or Colors.White, Position = UDim2.fromOffset(50, 0), Size = UDim2.new(1, -140, 1, 0), ZIndex = 43, Parent = line })
			C.text({ Text = board == "Rank" and (Ranks.Get(tonumber(row.Value) or 0).Icon .. " " .. tostring(row.Value or 0)) or tostring(row.Value or 0), Role = "Number", TextSize = 16, Color = Colors.YellowText, AlignX = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 0), Size = UDim2.fromOffset(84, 27), ZIndex = 43, Parent = line })
		end
	end
	for i, info in { { "Kills", "BAJAS" }, { "Wins", "VICTORIAS" }, { "Rank", "RANGO" } } do
		buttons[info[1]] = C.button({ Text = info[2], Style = "Menu", TextSize = 15, Size = UDim2.fromOffset(120, 32), Order = i, ZIndex = 43, Parent = tabs, OnClick = function()
			board = info[1]
			render()
		end })
	end
	render()
end

-- Clan: invitar amigos (+monedas para los dos) y el grupo del juego (premio una vez)
function Home.OpenClan()
	local body = openOverlay("CLAN Y AMIGOS", 300)
	C.text({ Text = string.format("👥 Amigos en este servidor: %d  ·  +10%% XP y monedas por amigo", player:GetAttribute("FriendsHere") or 0), Role = "BodyBold", TextSize = 14, Color = Colors.TextDim, Wrap = true, Size = UDim2.new(1, 0, 0, 36), ZIndex = 43, Parent = body })
	local referral = (GameConfig.Referral and GameConfig.Referral.InviterCoins) or 0
	local invite
	invite = C.button({ Text = "INVITAR AMIGOS  +" .. referral .. " 💰", Icon = "✉", Style = "Primary", TextSize = 20, Position = UDim2.fromOffset(0, 46), Size = UDim2.new(1, 0, 0, 52), ZIndex = 43, Parent = body, OnClick = function()
		local ok, canInvite = pcall(SocialService.CanSendGameInviteAsync, SocialService, player)
		if ok and canInvite then
			pcall(function()
				local options = Instance.new("ExperienceInviteOptions")
				options.LaunchData = "ref:" .. player.UserId
				options.PromptMessage = "¡Juega conmigo a " .. tostring(GameConfig.GameTitle) .. " y nos llevamos monedas los dos!"
				SocialService:PromptGameInvite(player, options)
			end)
		else
			UISound.Play("Error")
		end
	end })
	if GameConfig.Group and GameConfig.Group.Id ~= 0 then
		local label = "ÚNETE AL GRUPO  +" .. GameConfig.Group.Coins .. " 💰"
		local groupButton
		groupButton = C.button({ Text = label, Icon = "⭐", Style = "Ghost", TextSize = 18, Position = UDim2.fromOffset(0, 108), Size = UDim2.new(1, 0, 0, 48), ZIndex = 43, Parent = body, OnClick = function()
			local function claim()
				local ok, success, result = pcall(function()
					return Remotes.ClaimGroup:InvokeServer()
				end)
				return ok and success, result
			end
			local done, result = claim()
			if not done and result == "NotMember" then
				local prompted = pcall(function()
					(GroupService :: any):PromptJoinAsync(GameConfig.Group.Id)
				end)
				if prompted then
					task.wait(3.2)
					done, result = claim()
				end
			end
			local labelNode = groupButton:FindFirstChild("Label", true)
			if labelNode then
				labelNode.Text = done and ("¡+" .. tostring(result) .. " 💰! GRACIAS") or tostring(result == "NotMember" and "ÚNETE EN LA PÁGINA DEL JUEGO" or (result or "NO SE PUDO"))
			end
			UISound.Play(done and "Reward" or "Error")
		end })
		groupButton.Visible = not (ClientState.Data and ClientState.Data.GroupReward)
	end
	local _ = invite
end

-- Rachas de puntos (fijas en este juego): qué dan y con cuántas bajas
function Home.OpenStreaks()
	local body = openOverlay("RACHAS DE PUNTOS", 300)
	for i, spec in { { "📡", "RADAR", "3 bajas seguidas: ves a todos los enemigos en el minimapa unos segundos" }, { "✈", "ATAQUE AÉREO", "5 bajas seguidas: marca un punto del mapa y llega un bombardeo" } } do
		local row = C.panel({ Size = UDim2.new(1, 0, 0, 88), Position = UDim2.fromOffset(0, (i - 1) * 98), ZIndex = 42, Parent = body }, { Accent = Colors.Red })
		C.text({ Text = spec[1], TextSize = 34, AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(64, 88), ZIndex = 43, Parent = row })
		C.text({ Text = spec[2], Role = "TitleItalic", TextSize = 22, Position = UDim2.fromOffset(70, 10), Size = UDim2.new(1, -80, 0, 26), ZIndex = 43, Parent = row })
		C.text({ Text = spec[3], Role = "BodyBold", TextSize = 13, Color = Colors.TextDim, Wrap = true, Position = UDim2.fromOffset(70, 40), Size = UDim2.new(1, -80, 0, 40), ZIndex = 43, Parent = row })
	end
end

---------------------------------------------------------------------------
-- Datos
---------------------------------------------------------------------------

local shownPromo, shownPreviewKey
local waitingCharacter = false
local watchCharacter

local function nextWeapon(data)
	local best
	for _, name in Weapons.Primaries do
		local def = Weapons.Get(name)
		if def and not def.Hidden and (def.UnlockLevel or 1) > (data.Level or 1) and (def.UnlockLevel or 1) < 900 then
			if not best or def.UnlockLevel < Weapons.Get(best).UnlockLevel then
				best = name
			end
		end
	end
	return best
end

-- En el teléfono (pantalla baja) hay menos alto: fuera lo secundario de la derecha
local function phoneTrim()
	if not isPhone() then
		return
	end
	refs.Promo.Visible = false
	if refs.Daily.Visible then
		refs.Event.Visible = false
	end
end

function Home.Refresh()
	local data = ClientState.Data
	if not screen or not data then
		return
	end
	refs.Level.Text = "NIVEL " .. tostring(data.Level or 1)
	refs.XP:Set((data.XP or 0) / math.max(1, data.XPPerLevel or 1000))
	refs.Coins.Text = tostring(data.Coins or 0)
	refs.Daily.Visible = data.DailyAvailable == true
	refs.ChipStarter.Visible = data.StarterPackAvailable == true
	refs.ChipWheel.Visible = MonetizationConfig.Rules.Wheel and data.WheelFree == true
	refs.ChipBoost.Visible = (ReplicatedStorage:GetAttribute("XPBoost") or 1) > 1
	refs.ChipFirstWin.Visible = GameConfig.FirstWinOfDay ~= nil and data.FirstWinAvailable == true
	refs.Chips.Visible = refs.ChipStarter.Visible or refs.ChipWheel.Visible or refs.ChipBoost.Visible or refs.ChipFirstWin.Visible
	refs.NewsDot.Visible = (data.NewsSeen or 0) < ((GameConfig.ActiveNews and GameConfig.ActiveNews().Version) or 0)
	refs.FriendsDot.Visible = (player:GetAttribute("FriendsHere") or 0) > 0
	-- Puntos rojos solo por algo real: novedades sin ver en la tienda, recompensas del pase sin reclamar
	C.dot(refs.Menu.Shop, StoreData.HasNews())
	C.dot(refs.Menu.Pass, data.Pass ~= nil and (data.Pass.Claimable or 0) > 0)
	-- Tu tarjeta de jugador de fondo en el perfil
	local card = data.EquippedCard or "Default"
	if card ~= refs.ProfileCardId then
		refs.ProfileCardId = card
		if refs.ProfileCard then
			refs.ProfileCard:Destroy()
		end
		refs.ProfileCard = ItemArt.Card(refs.CardSlot, card, { Name = "CardBackground", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0.15 })
		local emblem = refs.ProfileCard:FindFirstChild("Emblem")
		if emblem then
			emblem.TextTransparency = 0.55
		end
	end
	-- Misiones
	local list = data.Challenges and data.Challenges.List or {}
	local done = 0
	for i = 1, 3 do
		refs.Missions[i](list[i])
		if list[i] and list[i].Done then
			done += 1
		end
	end
	local right = refs.MissionsHeader:FindFirstChild("Right")
	if right then
		right.Text = done .. "/" .. math.max(#list, 3)
	end
	-- Evento o mapa destacado
	local event = GameConfig.CurrentEvent and GameConfig.CurrentEvent()
	local featured = ReplicatedStorage:GetAttribute("FeaturedMap")
	if event then
		refs.EventTag.Text = "EVENTO ACTIVO"
		refs.EventName.Text = C.upper((event.Icon or "") .. " " .. tostring(event.Name))
		local left = (event.EndsAt or 0) - os.time()
		refs.EventSub.Text = left > 0 and string.format("Termina en %dd %dh · premios en Retos", left // 86400, (left % 86400) // 3600) or "Premios en Retos"
		refs.Event.Visible = true
	elseif featured and GameConfig.FeaturedMap then
		refs.EventTag.Text = "MAPA DESTACADO DE HOY"
		refs.EventName.Text = C.upper(tostring(featured))
		refs.EventSub.Text = "+" .. math.floor((GameConfig.FeaturedMap.XPBonus - 1) * 100 + 0.5) .. "% XP jugando en él"
		refs.Event.Visible = true
	else
		refs.Event.Visible = false
	end
	-- Arma destacada
	local promo = nextWeapon(data)
	if promo ~= shownPromo then
		shownPromo = promo
		refs.PromoIcon:ClearAllChildren()
		if promo then
			local def = Weapons.Get(promo)
			refs.PromoName.Text = C.upper(def.DisplayName)
			refs.PromoSub.Text = C.upper(def.Category or "") .. " · SE DESBLOQUEA AL NIVEL " .. tostring(def.UnlockLevel)
			pcall(WeaponIcon.Create, promo, nil, { Size = UDim2.fromScale(1, 1), ZIndex = 6, Parent = refs.PromoIcon }, "angled", 1.6)
		end
		refs.Promo.Visible = promo ~= nil
	end
	-- Rango
	local points = data.RankPoints or 0
	local tier = Ranks.Get(points)
	local fraction, nextTier = Ranks.Progress(points)
	refs.RankEmblem.Image = tier.Image or ""
	refs.RankTitle.Text = string.format('<font color="#%s">%s</font>  ·  %d RP', tier.Color:ToHex(), C.upper(tier.Name), points)
	refs.RankBar:Set(fraction)
	refs.RankBar.Fill.BackgroundColor3 = tier.Color
	refs.RankNext.Text = nextTier and string.format("Faltan %d RP para %s", nextTier.Min - points, nextTier.Name) or "¡Rango máximo!"
	phoneTrim()
	-- Personaje: se rehace si cambia el arma o el traje
	local key = tostring(data.Primary) .. "/" .. tostring(data.EquippedOutfit) .. "/" .. tostring(data.EquippedSkin) .. "/" .. tostring(data.EquippedCharm)
	if preview and key ~= shownPreviewKey and flow.State == "Home" then
		-- (si el personaje aún no ha aparecido no se da por hecho: se reintenta en cuanto exista)
		if Home.RefreshPreview() then
			shownPreviewKey = key
		elseif not waitingCharacter then
			waitingCharacter = true
			task.spawn(function()
				local deadline = os.clock() + 20
				while os.clock() < deadline do
					local character = player.Character
					if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChildOfClass("Humanoid") then
						break
					end
					task.wait(0.25)
				end
				task.wait(0.3) -- (que le dé tiempo a ponerse el traje)
				waitingCharacter = false
				if flow.State == "Home" then
					Home.Refresh()
				end
			end)
		end
	end
end

-- El servidor viste al personaje por partes y lo vuelve a vestir al asignarle equipo: si la copia del
-- lobby se hizo a medias (sin cinturón, guantes o rodilleras), se rehace cuando el traje deja de cambiar
local watched, watchConnections, watchToken = nil, {}, 0
function watchCharacter(character)
	if character == watched then
		return
	end
	for _, connection in watchConnections do
		connection:Disconnect()
	end
	watchConnections = {}
	watched = character
	if not character then
		return
	end
	local function changed(instance)
		if not (instance:IsA("BasePart") or instance:IsA("Folder")) then
			return
		end
		watchToken += 1
		local token = watchToken
		task.delay(0.6, function()
			if token == watchToken and watched == character and character.Parent and flow.State == "Home" then
				shownPreviewKey = nil
				Home.Refresh()
			end
		end)
	end
	table.insert(watchConnections, character.DescendantAdded:Connect(changed))
	table.insert(watchConnections, character.DescendantRemoving:Connect(changed))
end

function Home.RefreshPreview()
	if not preview then
		return false
	end
	local model = preview:SetCharacter("me", player)
	local data = ClientState.Data
	if model and data then
		-- (el arma de la clase activa, con su skin, aunque en el mundo lleve otra en la mano)
		preview:SetWeapon("me", data.Primary, Menu.SkinFor and Menu.SkinFor(data, data.Primary) or nil, data.EquippedCharm)
	end
	preview:SetAnimation("me", "MenuIdle")
	if model then
		-- (de tres cuartos: de frente el arma apunta a la cámara y no se ve; se puede girar arrastrando)
		preview:Turn("me", math.rad(-38))
		watchCharacter(player.Character)
	end
	return model ~= nil
end

local function applyLayout()
	local phone = isPhone()
	-- (pantallas más estrechas que 16:9, como tabletas 4:3: sin la tarjeta de modo y accesos más cortos)
	local width = root and root:GetAttribute("VirtualWidth") or 1280
	local narrow = phone or width < 1150
	for _, button in refs.Menu do
		button.Visible = not (phone and button:GetAttribute("DesktopOnly"))
		button.Size = UDim2.fromOffset(phone and 240 or 300, phone and 38 or 46)
	end
	refs.Play.Size = UDim2.fromOffset(phone and 240 or 300, phone and 58 or 72)
	refs.Left.Position = UDim2.fromOffset(24, phone and 92 or 110)
	-- (abajo: modo, rango y accesos; en el teléfono no caben y todo está en el menú)
	refs.Bottom.Visible = not phone
	refs.Right.Size = UDim2.fromOffset(phone and 290 or 350, 520)
	refs.Right.Position = UDim2.new(1, -24, 0, phone and 76 or 84)
	refs.LogoTitle.TextSize = phone and 40 or (narrow and 44 or 54)
	refs.LogoTitle.Size = UDim2.new(1, 0, 0, phone and 44 or 58)
	refs.LogoTag.Position = UDim2.fromOffset(4, phone and 44 or 58)
	refs.Profile.Size = UDim2.fromOffset(narrow and 190 or 260, 52)
	refs.ModeCard.Visible = not narrow
	refs.RankCard.Position = narrow and UDim2.fromOffset(0, 0) or UDim2.fromOffset(282, 0)
	for _, button in refs.Quick:GetChildren() do
		if button:IsA("GuiButton") then
			button.Size = UDim2.fromOffset(narrow and 112 or 140, 50)
		end
	end
	if phone then
		phoneTrim()
	else
		shownPromo = nil -- (vuelve a mostrar el arma destacada si se quitó en pantalla baja)
		Home.Refresh()
	end
end

---------------------------------------------------------------------------
-- Pantalla
---------------------------------------------------------------------------

function Home.Build(flowController, rootFrame)
	flow, root = flowController, rootFrame
	-- (Frame y no CanvasGroup: Roblox no dibuja los ViewportFrame dentro de un CanvasGroup)
	screen = C.new("Frame", { Name = "Home", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })
	-- Personaje en el centro
	preview = Preview.new(screen, { Name = "HeroPreview", Anchor = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(0, 560, 1, -10), Camera = "Hero" })
	-- Arrastrar sobre el personaje lo gira
	local dragging, lastX = false, 0
	preview.Viewport.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging, lastX = true, input.Position.X
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			preview:Turn("me", (input.Position.X - lastX) * 0.012)
			lastX = input.Position.X
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	buildLogo(screen)
	buildTopBar(screen)
	refs.Left = buildLeft(screen)
	refs.Right = buildRight(screen)
	refs.Bottom = buildBottom(screen)
	applyLayout()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(applyLayout)
	end
	ClientState.DataChanged.Event:Connect(Home.Refresh)
	player:GetAttributeChangedSignal("FriendsHere"):Connect(Home.Refresh)
	ReplicatedStorage:GetAttributeChangedSignal("FeaturedMap"):Connect(Home.Refresh)
	ReplicatedStorage:GetAttributeChangedSignal("XPBoost"):Connect(Home.Refresh)
	-- Enter / botón A: JUGAR
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or flow.State ~= "Home" or Menu.IsOpen() or ClientState.WheelOpen or ClientState.NewsOpen or overlay then
			return
		end
		if input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.ButtonA then
			flow.Play()
		end
	end)
	Home.Screen = screen
	Home.Refs = refs
end

function Home.Show(_, previous)
	pcall(function()
		Remotes.SetReady:FireServer(false)
	end)
	flow.SetCamera("Orbit")
	flow.SetBackdrop(0.35)
	Transition.Blur(12, 0.3)
	screen.Visible = true
	Transition.Pop(preview.Viewport, 0.94, previous == "Boot" and 0.45 or 0.25)
	-- Entrada: columnas que deslizan desde los lados (rápido)
	Transition.SlideIn(refs.Left, Vector2.new(-60, 0), 0.35)
	Transition.SlideIn(refs.Right, Vector2.new(60, 0), 0.35, 0.05)
	shownPreviewKey = nil
	Home.Refresh()
	preview:SetActive(true)
end

function Home.Hide()
	preview:SetActive(false)
	if overlay then
		overlay:Destroy()
		overlay = nil
	end
	screen.Visible = false
end

return Home
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="185">
                <Properties>
                  <string name="Name">Loadout</string>
                  <string name="Source"><![CDATA[-- ELECCIÓN RÁPIDA DE CLASE (antes de desplegar): las 5 clases con su arma principal (en 3D, con tu
-- skin), secundaria, letal y ventaja. La que usaste la última vez ya viene marcada: si no tocas
-- nada, entras con ella. Elegir otra la equipa al momento (el servidor cambia las armas durante el
-- despliegue). Una barra marca el tiempo que queda hasta la cuenta atrás.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Weapons = require(Shared.Weapons)

local Modules = script.Parent.Parent.Parent
local ClientState = require(Modules.ClientState)
local WeaponIcon = require(Modules.WeaponIcon)
local Menu = require(Modules.Menu)

local Flow = script.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Transition = require(Flow.Transition)
local UISound = require(Flow.UISound)

local Colors = Theme.Colors

local Loadout = {}

local flow, screen, row, timerBar, timerLabel, deployButton
local cards = {}
local shownKeys = {}
local selected
local token = 0
local endsAt, connection
local lateMode = false

local function perkInfo(id)
	for _, perk in GameConfig.Perks do
		if perk.Id == id then
			return perk
		end
	end
	return { Icon = "—", Name = "Sin ventaja" }
end

local function buildCard(i)
	local card = C.button({ Name = "Class" .. i, Text = "", Style = "Menu", Size = UDim2.new(0.2, -10, 1, 0), Order = i, Parent = row, Sound = "Equip", OnClick = function()
		Loadout.Select(i)
	end })
	local z = 5
	local head = C.text({ Name = "Head", Text = "CLASE " .. i, Role = "Title", TextSize = 16, Color = Colors.TextDim, Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 0, 20), ZIndex = z, Parent = card })
	local name = C.text({ Name = "ClassName", Text = "", Role = "TitleItalic", TextSize = 26, Position = UDim2.fromOffset(12, 26), Size = UDim2.new(1, -24, 0, 30), ZIndex = z, Parent = card })
	local icon = C.new("Frame", { Name = "WeaponIcon", BackgroundTransparency = 1, Position = UDim2.fromOffset(6, 58), Size = UDim2.new(1, -12, 0, 92), ZIndex = z, Parent = card })
	local primary = C.text({ Name = "Primary", Text = "", Role = "Title", TextSize = 18, Position = UDim2.fromOffset(12, 152), Size = UDim2.new(1, -24, 0, 22), Scaled = true, ZIndex = z, Parent = card })
	local secondary = C.text({ Name = "Secondary", Text = "", Role = "BodyBold", TextSize = 13, Scaled = true, Color = Colors.TextDim, Position = UDim2.fromOffset(12, 176), Size = UDim2.new(1, -24, 0, 18), ZIndex = z, Parent = card })
	local extras = C.text({ Name = "Extras", Text = "", Role = "BodyBold", TextSize = 13, Scaled = true, Color = Colors.TextDim, Position = UDim2.fromOffset(12, 196), Size = UDim2.new(1, -24, 0, 18), ZIndex = z, Parent = card })
	local check = C.new("Frame", { Name = "Check", BackgroundColor3 = Colors.Yellow, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 8), Size = UDim2.fromOffset(24, 24), ZIndex = z + 1, Parent = card }, { C.corner(3) })
	C.text({ Text = "✔", Role = "Title", TextSize = 16, Color = Color3.fromRGB(16, 14, 8), AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = z + 2, Parent = check })
	cards[i] = { Frame = card, Head = head, Name = name, Icon = icon, Primary = primary, Secondary = secondary, Extras = extras, Check = check }
end

local function render()
	local data = ClientState.Data
	if not data or not data.Classes then
		return
	end
	selected = selected or data.ActiveClass or 1
	for i, card in cards do
		local class = data.Classes[i] or GameConfig.DefaultClasses[i]
		local def = Weapons.Get(class.Primary)
		local locked = def and not ((def.UnlockLevel or 1) <= (data.Level or 1) or (data.OwnedWeapons and data.OwnedWeapons[class.Primary]))
		card.Name.Text = tostring(class.Name or ("CLASE " .. i))
		card.Primary.Text = def and (C.upper(def.DisplayName) .. (locked and ("  🔒 NV " .. tostring(def.UnlockLevel)) or "")) or ""
		local secondary = Weapons.Get(class.Secondary)
		local perk = perkInfo(class.Perk)
		-- (en el teléfono, textos cortos: la tarjeta mide ~150 de ancho y el texto largo se montaba
		-- sobre la línea de abajo; la granada la llevan todas las clases)
		local phone = C.Breakpoint() == "PHONE"
		local secondaryName = secondary and secondary.DisplayName or "—"
		card.Secondary.Text = phone and ("+ " .. secondaryName) or ("Secundaria: " .. secondaryName)
		card.Extras.Text = phone and (tostring(perk.Icon) .. " " .. tostring(perk.Name)) or ("💣 Granada  ·  " .. tostring(perk.Icon) .. " " .. tostring(perk.Name))
		local key = tostring(class.Primary) .. "/" .. tostring(Menu.SkinFor and Menu.SkinFor(data, class.Primary))
		if shownKeys[i] ~= key then
			shownKeys[i] = key
			card.Icon:ClearAllChildren()
			pcall(WeaponIcon.Create, class.Primary, Menu.SkinFor and Menu.SkinFor(data, class.Primary) or nil, { Size = UDim2.fromScale(1, 1), ZIndex = 6, Parent = card.Icon }, "angled", 2.2)
		end
		C.setSelected(card.Frame, i == selected)
		card.Check.Visible = i == selected
		card.Head.TextColor3 = i == selected and Color3.fromRGB(60, 46, 6) or Colors.TextDim
		card.Secondary.TextColor3 = i == selected and Color3.fromRGB(60, 46, 6) or Colors.TextDim
		card.Extras.TextColor3 = card.Secondary.TextColor3
	end
end

function Loadout.Select(i)
	if selected == i then
		return
	end
	selected = i
	pcall(function()
		Remotes.SelectClass:FireServer(i)
	end)
	-- El arma de la clase elegida da un saltito
	local card = cards[i]
	if card then
		Transition.Pulse(card.Icon, 1.15, 0.25)
	end
	render()
end

local function step()
	if flow.State ~= "Loadout" then
		return
	end
	local remaining, total
	if lateMode then
		remaining = endsAt - os.clock()
		total = flow.Times.LateLoadout
	else
		local countdownIn = flow.CountdownIn()
		remaining = countdownIn or 0
		total = math.max(1, (GameConfig.Deploy.LineupTime or 7) - flow.Times.TeamIntro)
	end
	timerBar:Set(math.clamp(remaining / total, 0, 1), false)
	timerLabel.Text = string.format("%d", math.max(0, math.ceil(remaining)))
	if remaining <= 0 then
		flow.Advance("Loadout")
	end
end

function Loadout.Build(flowController, root)
	flow = flowController
	screen = C.new("Frame", { Name = "Loadout", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })
	C.text({ Text = "ELIGE TU CLASE", Role = "TitleItalic", TextSize = 52, Position = UDim2.fromOffset(40, 40), Size = UDim2.fromOffset(700, 60), Stroke = 2, Parent = screen })
	C.text({ Text = "La última que usaste ya está marcada · si no eliges, entras con ella", Role = "BodyBold", TextSize = 15, Color = Colors.TextDim, Position = UDim2.fromOffset(44, 100), Size = UDim2.fromOffset(700, 20), Parent = screen })
	timerLabel = C.text({ Text = "", Role = "Number", TextSize = 56, Color = Colors.YellowText, AlignX = Enum.TextXAlignment.Right, Anchor = Vector2.new(1, 0), Position = UDim2.new(1, -40, 0, 36), Size = UDim2.fromOffset(120, 64), Parent = screen })
	timerBar = C.progress({ Anchor = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 130), Size = UDim2.new(1, -80, 0, 4), Parent = screen })
	row = C.new("Frame", { Name = "Classes", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.52, 0), Size = UDim2.new(1, -80, 0, 226), Parent = screen }, {
		C.list(10, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center),
	})
	for i = 1, GameConfig.ClassCount or 5 do
		buildCard(i)
	end
	deployButton = C.button({ Name = "Deploy", Text = "DESPLEGAR", Icon = "▶", Style = "Primary", TextSize = 30, Anchor = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -32), Size = UDim2.fromOffset(320, 64), Parent = screen, OnClick = function()
		if lateMode then
			flow.Advance("Loadout")
		else
			-- (en el despliegue de todos, la cuenta atrás la marca el servidor: aquí solo confirmas)
			local label = deployButton:FindFirstChild("Label", true)
			if label then
				label.Text = "¡LISTO!"
			end
		end
	end })
	ClientState.DataChanged.Event:Connect(function()
		if screen.Visible then
			local data = ClientState.Data
			if data and data.ActiveClass then
				selected = data.ActiveClass
			end
			render()
		end
	end)
end

function Loadout.Show(ctx)
	token += 1
	lateMode = ctx.Late == true and ReplicatedStorage:GetAttribute("Deploy") == nil
	endsAt = os.clock() + flow.Times.LateLoadout
	flow.SetBackdrop(0.72, 0.2)
	Transition.Blur(14, 0.2)
	local data = ClientState.Data
	selected = data and data.ActiveClass or 1
	screen.Visible = true
	local label = deployButton:FindFirstChild("Label", true)
	if label then
		label.Text = "DESPLEGAR"
	end
	render()
	for i, card in cards do
		-- (están en una lista horizontal: entran creciendo, una tras otra)
		Transition.Pop(card.Frame, 0.85, 0.22, (i - 1) * 0.04)
	end
	if connection then
		connection:Disconnect()
	end
	connection = RunService.RenderStepped:Connect(step)
end

function Loadout.Hide()
	token += 1
	if connection then
		connection:Disconnect()
		connection = nil
	end
	screen.Visible = false
end

local _ = UISound
local __ = Players
return Loadout
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="186">
                <Properties>
                  <string name="Name">MapIntro</string>
                  <string name="Source"><![CDATA[-- PRESENTACIÓN DEL MAPA: nombre del mapa muy grande, modo en una placa amarilla, 5 VS 5, versión de
-- luz (atardecer, noche) y la descripción, con la cámara pasando por encima del mapa real. Mientras
-- el servidor construye el mapa nuevo el fondo queda oscuro con la tarjeta; en cuanto existe, se ve
-- el mapa detrás. Dura lo que tarda la preparación real (con un mínimo para que se lea).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Flow = script.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Transition = require(Flow.Transition)
local UISound = require(Flow.UISound)

local Colors = Theme.Colors

local MapIntro = {}

local flow, screen, block, nameLabel, modePlate, modeLabel, infoLabel, descLabel, statusLabel
local shownAt = 0
local token = 0

local VARIANT_ICONS = { Atardecer = "🌇", Noche = "🌙", ["Día"] = "☀", ["Mediodía"] = "☀", Niebla = "🌫", Tormenta = "⛈" }

local function refresh()
	local loading = ReplicatedStorage:GetAttribute("LoadingMap")
	local name = loading or ReplicatedStorage:GetAttribute("MapName") or ""
	nameLabel.Text = C.upper(name)
	local mode = ReplicatedStorage:GetAttribute("ModeName") or ""
	modeLabel.Text = C.upper(mode)
	modePlate.Visible = not loading and mode ~= ""
	local map = workspace:FindFirstChild("Map")
	local variant = map and map:GetAttribute("Variant")
	infoLabel.Text = "5 VS 5" .. (variant and not loading and ("   ·   " .. (VARIANT_ICONS[variant] or "") .. " " .. C.upper(variant)) or "")
	descLabel.Text = loading and "" or tostring(ReplicatedStorage:GetAttribute("MapDescription") or "")
	statusLabel.Text = loading and "CONSTRUYENDO EL MAPA…" or "PREPARANDO PARTIDA…"
	-- Sin mapa (se está construyendo): fondo oscuro; con mapa: se ve la pasada de cámara
	flow.SetBackdrop(loading and 0.85 or 0.2, 0.4)
end

function MapIntro.ReadyToLeave()
	return os.clock() - shownAt >= flow.Times.MapIntroMin and ReplicatedStorage:GetAttribute("LoadingMap") == nil
end

function MapIntro.Build(flowController, root)
	flow = flowController
	screen = C.new("Frame", { Name = "MapIntro", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })
	-- Bloque abajo a la izquierda (como un rótulo de cine)
	block = C.new("Frame", { Name = "Block", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 48, 1, -60), Size = UDim2.fromOffset(820, 260), Parent = screen })
	C.new("Frame", { BackgroundColor3 = Colors.Yellow, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(120, 6), Parent = block })
	modePlate = C.new("Frame", { Name = "ModePlate", BackgroundColor3 = Colors.Yellow, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 18), Size = UDim2.fromOffset(330, 36), Parent = block }, { C.corner(3) })
	modeLabel = C.text({ Text = "", Role = "TitleItalic", TextSize = 24, Color = Color3.fromRGB(16, 14, 8), Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0), Scaled = true, Parent = modePlate })
	nameLabel = C.text({ Text = "", Role = "TitleItalic", TextSize = 104, Color = Colors.White, Position = UDim2.fromOffset(-4, 56), Size = UDim2.new(1, 0, 0, 110), Scaled = true, Stroke = 3, Parent = block })
	infoLabel = C.text({ Text = "", Role = "Title", TextSize = 24, Color = Colors.YellowText, Position = UDim2.fromOffset(2, 166), Size = UDim2.new(1, 0, 0, 28), Stroke = 1, Parent = block })
	descLabel = C.text({ Text = "", Role = "BodyBold", TextSize = 16, Color = Colors.Text, Position = UDim2.fromOffset(2, 198), Size = UDim2.new(0.8, 0, 0, 22), Stroke = 1, Parent = block })
	statusLabel = C.text({ Text = "", Role = "Title", TextSize = 16, Color = Colors.TextDim, AlignX = Enum.TextXAlignment.Right, Anchor = Vector2.new(1, 1), Position = UDim2.new(1, -48, 1, -28), Size = UDim2.fromOffset(400, 22), Parent = screen })
	for _, attr in { "LoadingMap", "MapName", "ModeName", "MapDescription" } do
		ReplicatedStorage:GetAttributeChangedSignal(attr):Connect(function()
			if screen.Visible then
				refresh()
			end
		end)
	end
end

function MapIntro.Show(ctx)
	token += 1
	local my = token
	shownAt = os.clock()
	flow.SetCamera("Flyover")
	Transition.Blur(0, 0.3)
	screen.Visible = true
	refresh()
	UISound.Play("Whoosh")
	Transition.SlideIn(block, Vector2.new(-80, 0), 0.4)
	Transition.Pop(nameLabel, 1.08, 0.5)
	-- Salida: quien entra con la partida empezada, a su ritmo; si no, cuando el servidor empieza el
	-- despliegue (y ya pasó el mínimo para leer el nombre)
	task.spawn(function()
		local lateSince = nil
		while token == my and flow.State == "MapIntro" do
			local deploying = ReplicatedStorage:GetAttribute("Deploy") ~= nil
			local playing = ReplicatedStorage:GetAttribute("State") == "Playing"
			-- (si el despliegue acabó mientras esta pantalla cumplía su tiempo mínimo, ya no va a volver:
			-- sin esto el jugador se quedaba aquí toda la partida. Se espera 1 s por si el servidor ha
			-- puesto «Playing» un instante antes de empezar el despliegue)
			if playing and not deploying then
				lateSince = lateSince or os.clock()
			else
				lateSince = nil
			end
			local late = (ctx and ctx.Late) or (lateSince ~= nil and os.clock() - lateSince >= 1)
			if MapIntro.ReadyToLeave() and (deploying or (late and playing)) then
				flow.Advance("MapIntro")
				break
			end
			task.wait(0.1)
		end
	end)
end

function MapIntro.Hide()
	token += 1
	screen.Visible = false
end

return MapIntro
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="187">
                <Properties>
                  <string name="Name">MatchFound</string>
                  <string name="Source"><![CDATA[-- PARTIDA ENCONTRADA: el momento de satisfacción (~1,4 s). Destello, barrido amarillo, golpe de
-- sonido y el panel que entra de golpe con el modo y el mapa. Sigue solo: no hay que pulsar nada.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Flow = script.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Transition = require(Flow.Transition)
local UISound = require(Flow.UISound)

local Colors = Theme.Colors

-- "5 VS 5" solo en los modos por equipos (no en Todos contra todos ni en Escalada de armas)
local ModeSettings = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig")).ModeSettings
local function versus(modeName)
	for _, mode in ModeSettings do
		if mode.Name == modeName and mode.Teams == false then
			return ""
		end
	end
	return "  ·  5 VS 5"
end

local MatchFound = {}

local flow, screen, band, title, sub
local token = 0

function MatchFound.Build(flowController, root)
	flow = flowController
	screen = C.new("Frame", { Name = "MatchFound", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })
	band = C.new("Frame", {
		Name = "Band",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.new(1.2, 0, 0, 150),
		Rotation = -3,
		BackgroundColor3 = Colors.Bg,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		Parent = screen,
	}, { C.stroke(Colors.Yellow, 2, 0.2) })
	-- Franjas amarillas arriba y abajo de la banda
	for _, y in { 0, 1 } do
		C.new("Frame", { AnchorPoint = Vector2.new(0, y), Position = UDim2.fromScale(0, y), Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = Colors.Yellow, BorderSizePixel = 0, Parent = band })
	end
	title = C.text({ Text = "PARTIDA ENCONTRADA", Role = "TitleItalic", TextSize = 76, Color = Colors.White, AlignX = Enum.TextXAlignment.Center, Anchor = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, -16), Size = UDim2.new(0.8, 0, 0, 84), Scaled = true, Stroke = 3, Parent = band })
	sub = C.text({ Text = "", Role = "Title", TextSize = 26, Color = Colors.YellowText, AlignX = Enum.TextXAlignment.Center, Anchor = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 44), Size = UDim2.new(0.8, 0, 0, 30), Parent = band })
end

function MatchFound.Show(ctx)
	token += 1
	local my = token
	flow.SetBackdrop(0.55, 0.15)
	screen.Visible = true
	local mapName = ReplicatedStorage:GetAttribute("LoadingMap") or ReplicatedStorage:GetAttribute("MapName") or ""
	local modeName = ReplicatedStorage:GetAttribute("ModeName") or ""
	if ReplicatedStorage:GetAttribute("LoadingMap") then
		-- (el modo aún no está decidido del todo: el del voto ganador llega con el mapa)
		modeName = ""
	end
	sub.Text = C.upper(modeName ~= "" and (modeName .. "  ·  " .. mapName) or mapName) .. (modeName ~= "" and versus(modeName) or "")
	UISound.MatchFound()
	Transition.Flash(Colors.White, 0.55, 0.35)
	Transition.Wipe(Colors.Yellow, 0.4)
	Transition.Pop(band, 1.25, 0.2)
	Transition.Pop(title, 0.7, 0.25, 0.05)
	task.delay(flow.Times.MatchFound, function()
		if token == my and flow.State == "MatchFound" then
			flow.Advance("MatchFound")
		end
	end)
	local _ = ctx
end

function MatchFound.Hide()
	token += 1
	screen.Visible = false
end

return MatchFound
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="188">
                <Properties>
                  <string name="Name">Matchmaking</string>
                  <string name="Source"><![CDATA[-- MATCHMAKING: "BUSCANDO PARTIDA" con el modo, 5 VS 5, el ping, el tiempo buscando y un escáner
-- (líneas que barren y un pulso, nada de rueda girando). Es la espera real del servidor: si hay una
-- partida en marcha, entras enseguida; si está en el descanso entre partidas, votas aquí el mapa de
-- la siguiente (las tres opciones del servidor) y se ve cuánto falta. CANCELAR vuelve al lobby.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local Flow = script.Parent.Parent

-- "5 VS 5" solo en los modos por equipos (no en Todos contra todos ni en Escalada de armas)
local ModeSettings = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig")).ModeSettings
local function versus(modeName)
	for _, mode in ModeSettings do
		if mode.Name == modeName and mode.Teams == false then
			return ""
		end
	end
	return "  ·  5 VS 5"
end
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Transition = require(Flow.Transition)
local UISound = require(Flow.UISound)

local player = Players.LocalPlayer
local Colors = Theme.Colors

local Matchmaking = {}

local cancelButton
local flow, screen, panel, timerLabel, modeLabel, statusLabel, pingLabel, scanBar, pulse, votesRow
local voteCards = {}
local myVote
local startedAt = 0
local connection

local function voteOptions()
	local list = {}
	for i = 1, 3 do
		local map = ReplicatedStorage:GetAttribute("Vote" .. i .. "_Map")
		if map then
			list[i] = { Map = map, Mode = ReplicatedStorage:GetAttribute("Vote" .. i .. "_Mode") or "", Count = ReplicatedStorage:GetAttribute("Vote" .. i .. "_Count") or 0 }
		end
	end
	return list
end

local function refreshVotes()
	local options = voteOptions()
	local any = options[1] ~= nil and ReplicatedStorage:GetAttribute("State") == "Intermission"
	votesRow.Visible = any
	local best, bestCount = nil, -1
	for i = 1, 3 do
		local card = voteCards[i]
		local option = options[i]
		card.Frame.Visible = option ~= nil
		if option then
			card.Map.Text = C.upper(option.Map)
			card.Mode.Text = C.upper(option.Mode)
			card.Count.Text = tostring(option.Count) .. (option.Count == 1 and " VOTO" or " VOTOS")
			C.setSelected(card.Frame, myVote == i)
			if option.Count > bestCount then
				best, bestCount = option, option.Count
			end
		end
	end
	-- Modo: el más votado de la siguiente partida, o el de la que está en marcha
	if any and best then
		modeLabel.Text = C.upper(best.Mode) .. versus(best.Mode)
	else
		local modeName = ReplicatedStorage:GetAttribute("ModeName") or "Duelo por equipos"
		modeLabel.Text = C.upper(modeName) .. versus(modeName)
	end
end

local function step()
	if flow.State ~= "Matchmaking" then
		return
	end
	local elapsed = os.clock() - startedAt
	timerLabel.Text = string.format("%02d:%02d", elapsed // 60, elapsed % 60)
	-- Escáner: una línea que barre el panel y un pulso que crece y se desvanece
	local t = (elapsed % 1.6) / 1.6
	scanBar.Position = UDim2.new(t, 0, 0, 0)
	local p = (elapsed % 1.2) / 1.2
	pulse.Size = UDim2.fromOffset(40 + p * 120, 40 + p * 120)
	pulse.BackgroundTransparency = 0.55 + p * 0.45
	local ok, ping = pcall(function()
		return player:GetNetworkPing()
	end)
	pingLabel.Text = ok and ping and string.format("PING %d ms", math.floor(ping * 1000 + 0.5)) or ""
	local state = ReplicatedStorage:GetAttribute("State")
	local loading = ReplicatedStorage:GetAttribute("LoadingMap")
	if loading then
		statusLabel.Text = "Partida encontrada · preparando " .. C.upper(loading)
		-- (si pulsaste JUGAR con el mapa ya construyéndose, el atributo no cambia: no se esperaba a que
		-- acabara la carga para seguir)
		if elapsed >= flow.Times.SearchMin then
			flow.SetState("MatchFound")
		end
	elseif state == "Intermission" then
		local left = ReplicatedStorage:GetAttribute("TimeLeft") or 0
		statusLabel.Text = string.format("Siguiente partida en %d s · elige el mapa", left)
	elseif state == "Ended" then
		statusLabel.Text = "Terminando la partida anterior…"
	else
		statusLabel.Text = "Partida en curso · uniéndote"
		-- Con partida en marcha (sin despliegue): entra en cuanto se ha visto que busca
		if elapsed >= flow.Times.SearchMin then
			flow.SetState("MatchFound", { Late = ReplicatedStorage:GetAttribute("Deploy") == nil })
		end
	end
end

function Matchmaking.Build(flowController, root)
	flow = flowController
	screen = C.new("Frame", { Name = "Matchmaking", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })
	panel = C.panel({ Name = "Search", Anchor = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.42, -8), Size = UDim2.fromOffset(560, 230), Clip = true, Parent = screen }, { Alpha = 0.08, StrokeColor = Colors.Yellow, StrokeAlpha = 0.55 })
	scanBar = C.new("Frame", { Name = "Scan", BackgroundColor3 = Colors.Yellow, BackgroundTransparency = 0.75, BorderSizePixel = 0, Size = UDim2.new(0, 3, 1, 0), Parent = panel })
	for i = 1, 5 do
		-- Líneas de fondo del escáner (rejilla tenue)
		C.new("Frame", { BackgroundColor3 = Colors.White, BackgroundTransparency = 0.94, BorderSizePixel = 0, Position = UDim2.new(0, 0, i / 6, 0), Size = UDim2.new(1, 0, 0, 1), Parent = panel })
	end
	pulse = C.new("Frame", { Name = "Pulse", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 70, 0.5, 0), Size = UDim2.fromOffset(60, 60), BackgroundColor3 = Colors.Yellow, BackgroundTransparency = 0.6, BorderSizePixel = 0, Parent = panel }, { C.corner(999) })
	C.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 70, 0.5, 0), Size = UDim2.fromOffset(18, 18), BackgroundColor3 = Colors.Yellow, BorderSizePixel = 0, Parent = panel }, { C.corner(999) })
	C.text({ Text = "BUSCANDO PARTIDA", Role = "TitleItalic", TextSize = 40, Position = UDim2.fromOffset(140, 26), Size = UDim2.new(1, -160, 0, 46), Parent = panel })
	modeLabel = C.text({ Text = "", Role = "Title", TextSize = 22, Color = Colors.YellowText, Position = UDim2.fromOffset(142, 76), Size = UDim2.new(1, -160, 0, 26), Parent = panel })
	statusLabel = C.text({ Text = "", Role = "BodyBold", TextSize = 15, Color = Colors.TextDim, Position = UDim2.fromOffset(142, 108), Size = UDim2.new(1, -160, 0, 22), Parent = panel })
	timerLabel = C.text({ Text = "00:00", Role = "Number", TextSize = 46, Position = UDim2.fromOffset(142, 140), Size = UDim2.fromOffset(160, 54), Parent = panel })
	pingLabel = C.text({ Text = "", Role = "Number", TextSize = 16, Color = Colors.TextDim, AlignX = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -20, 0, 160), Size = UDim2.fromOffset(160, 24), Parent = panel })
	-- Votación del mapa de la siguiente partida
	-- (título y tarjetas en un contenedor: la lista solo ordena las tarjetas)
	votesRow = C.new("Frame", { Name = "Votes", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.42, 112), Size = UDim2.fromOffset(780, 140), Parent = screen })
	C.text({ Name = "VotesTitle", Text = "ELIGE EL MAPA DE LA SIGUIENTE PARTIDA", Role = "Title", TextSize = 16, Color = Colors.TextDim, AlignX = Enum.TextXAlignment.Center, Anchor = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromOffset(600, 20), Parent = votesRow })
	local cardsRow = C.new("Frame", { Name = "Cards", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, 0, 0, 104), Parent = votesRow }, {
		C.list(10, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center),
	})
	for i = 1, 3 do
		local card = C.button({ Name = "Vote" .. i, Text = "", Style = "Menu", Size = UDim2.fromOffset(250, 104), Order = i, Parent = cardsRow, Sound = "Equip", OnClick = function()
			myVote = i
			pcall(function()
				Remotes.VoteMap:FireServer(i)
			end)
			refreshVotes()
		end })
		local map = C.text({ Name = "Map", Text = "", Role = "TitleItalic", TextSize = 24, Scaled = true, Position = UDim2.fromOffset(14, 10), Size = UDim2.new(1, -28, 0, 30), ZIndex = 5, Parent = card })
		local mode = C.text({ Name = "Mode", Text = "", Role = "Title", TextSize = 15, Color = Colors.TextDim, Position = UDim2.fromOffset(14, 44), Size = UDim2.new(1, -28, 0, 20), ZIndex = 5, Parent = card })
		local count = C.text({ Name = "Count", Text = "", Role = "Number", TextSize = 15, Color = Colors.YellowText, Position = UDim2.fromOffset(14, 72), Size = UDim2.new(1, -28, 0, 20), ZIndex = 5, Parent = card })
		voteCards[i] = { Frame = card, Map = map, Mode = mode, Count = count }
	end
	cancelButton = C.button({ Name = "Cancel", Text = "CANCELAR", Icon = "✕", Style = "Ghost", TextSize = 20, Anchor = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -24), Size = UDim2.fromOffset(220, 52), Parent = screen, Sound = "Back", OnClick = function()
		flow.CancelSearch()
	end })
	ReplicatedStorage.AttributeChanged:Connect(function(name)
		if screen.Visible and (string.sub(name, 1, 4) == "Vote" or name == "State" or name == "ModeName") then
			refreshVotes()
		end
	end)
end

-- Teléfono (pantalla baja): panel más arriba para que quepan los votos y CANCELAR debajo
local function applyLayout()
	local phone = C.Breakpoint() == "PHONE"
	-- (el panel mide 230: acaba en su centro + 115. En escritorio, el título de la votación pisaba el
	-- borde amarillo; ahora queda 5 por debajo en los dos tamaños)
	panel.Position = UDim2.new(0.5, 0, phone and 0.28 or 0.42, phone and 0 or -8)
	votesRow.Position = UDim2.new(0.5, 0, phone and 0.28 or 0.42, phone and 120 or 112)
	cancelButton.Size = UDim2.fromOffset(220, phone and 44 or 52)
	cancelButton.Position = UDim2.new(0.5, 0, 1, phone and -16 or -24)
end

function Matchmaking.Show()
	applyLayout()
	flow.SetCamera("Orbit")
	flow.SetBackdrop(0.6)
	Transition.Blur(16, 0.25)
	startedAt = os.clock()
	myVote = nil
	screen.Visible = true
	Transition.Pop(panel, 0.9, 0.22)
	Transition.SlideIn(votesRow, Vector2.new(0, 30), 0.3, 0.05)
	refreshVotes()
	if connection then
		connection:Disconnect()
	end
	connection = RunService.RenderStepped:Connect(step)
	step()
end

function Matchmaking.Hide()
	if connection then
		connection:Disconnect()
		connection = nil
	end
	screen.Visible = false
end

local _ = UISound
return Matchmaking
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="189">
                <Properties>
                  <string name="Name">Operator</string>
                  <string name="Source"><![CDATA[-- OPERADOR: tu personaje en grande con el traje que estás mirando (en 3D, se gira arrastrando),
-- roles arriba (ASALTO, RECON, PESADO, FRANCOTIRADOR, ESPECIAL), su ficha a la izquierda (rareza,
-- rol, estilo y la clase que le va), las habilidades de operador a la derecha y abajo la tira para
-- elegir. Los trajes son SOLO estética: no cambian vida, daño ni velocidad (se dice en la ficha).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Outfits = require(Shared.Outfits)
local Shop = require(Shared.Shop)
local Skins = require(Shared.Skins)
local Weapons = require(Shared.Weapons)

local Modules = script.Parent.Parent.Parent
local ClientState = require(Modules.ClientState)
local Menu = require(Modules.Menu)

local Flow = script.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Transition = require(Flow.Transition)
local UISound = require(Flow.UISound)
local Preview = require(Flow.Preview)

local player = Players.LocalPlayer
local Colors = Theme.Colors
local DARK = Color3.fromRGB(16, 14, 8)

local Operator = {}

-- Roles a partir de la etiqueta "Class" de cada traje
local ROLES = {
	{ Id = "ALL", Text = "TODOS" },
	{ Id = "ASSAULT", Text = "ASALTO", Classes = { ["Clase asalto"] = true }, Style = "Primera línea: entra en los puntos y abre camino al equipo.", Class = "ASALTO" },
	{ Id = "RECON", Text = "RECON", Classes = { ["Clase reconocimiento"] = true, ["Clase infiltración"] = true }, Style = "Información y movilidad: encuentra al enemigo antes de que te encuentre.", Class = "CQB" },
	{ Id = "HEAVY", Text = "PESADO", Classes = { ["Clase pesada"] = true }, Style = "Aguanta posiciones y castiga con fuego sostenido.", Class = "PESADO" },
	{ Id = "SNIPER", Text = "FRANCOTIRADOR", Classes = { ["Clase francotirador"] = true }, Style = "Controla las líneas largas desde lejos y cubre a tu equipo.", Class = "TIRADOR" },
	{ Id = "SPECIAL", Text = "ESPECIAL", Style = "Ediciones de evento y de colección.", Special = true },
}

local flow, screen, preview, tabsRow, strip, infoPanel, abilityPanel, actionButton, actionLabel
local rarityTag, rarityLabel, nameLabel, roleLabel, styleLabel, classButton, classLabel
local tabs = {}
local abilityRows, abilityDescs = {}, {}
local titleLabel
local role = "ALL"
local selected = "Default"
local shownKey

local function roleOf(id)
	local outfit = Outfits.Get(id)
	for _, r in ROLES do
		if r.Classes and r.Classes[outfit.Class] then
			return r
		end
	end
	return ROLES[#ROLES]
end

local function idsFor(roleId)
	local ids = {}
	for id in Outfits.List do
		if roleId == "ALL" or (id ~= "Default" and roleOf(id).Id == roleId) then
			table.insert(ids, id)
		end
	end
	local order = { "Común", "Raro", "Épico", "Legendario", "Mítico" }
	table.sort(ids, function(a, b)
		if (a == "Default") ~= (b == "Default") then
			return a == "Default"
		end
		local ra = table.find(order, Outfits.List[a].Rarity) or 0
		local rb = table.find(order, Outfits.List[b].Rarity) or 0
		if ra ~= rb then
			return ra < rb
		end
		return Outfits.List[a].Name < Outfits.List[b].Name
	end)
	return ids
end

local function rarityColor(rarity)
	return Skins.RarityColors[rarity] or Colors.TextDim
end

-- Índice de la clase que va con el rol (por nombre; si la renombraste, la que más se parece)
local function classFor(r)
	local data = ClientState.Data
	if not r or not r.Class then
		return nil
	end
	local list = data and data.Classes or GameConfig.DefaultClasses
	for i, class in list do
		if class.Name == r.Class then
			return i
		end
	end
	for i, class in GameConfig.DefaultClasses do
		if class.Name == r.Class then
			return i
		end
	end
	return nil
end

---------------------------------------------------------------------------
-- Pintar
---------------------------------------------------------------------------

local function renderPreview()
	local data = ClientState.Data
	local key = selected .. "/" .. tostring(data and data.Primary)
	if key == shownKey then
		return
	end
	shownKey = key
	local model = preview:SetCharacter("me", player)
	if model then
		pcall(Outfits.Remove, model)
		if selected ~= "Default" then
			pcall(Outfits.Apply, model, selected)
		end
		if data then
			preview:SetWeapon("me", data.Primary, Menu.SkinFor and Menu.SkinFor(data, data.Primary) or nil, data.EquippedCharm)
		end
		preview:SetAnimation("me", "OperatorIdle")
	end
end

local function renderStrip()
	local data = ClientState.Data
	for _, child in strip:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	for i, id in idsFor(role) do
		local outfit = Outfits.Get(id)
		local owned = id == "Default" or (data and data.Outfits and data.Outfits[id] == true)
		local equipped = data and data.EquippedOutfit == id or (id == "Default" and not (data and data.EquippedOutfit))
		local card = C.button({ Name = "O_" .. id, Text = "", Style = "Menu", Size = UDim2.fromOffset(150, 74), Order = i, Parent = strip, OnClick = function()
			Operator.Select(id)
		end })
		C.new("Frame", { Name = "Rarity", BackgroundColor3 = rarityColor(outfit.Rarity), BorderSizePixel = 0, Position = UDim2.new(0, 0, 1, -4), Size = UDim2.new(1, 0, 0, 4), ZIndex = 5, Parent = card })
		local isSelected = id == selected
		C.text({ Name = "OutfitName", Text = C.upper(outfit.Name), Role = "TitleItalic", TextSize = 17, Color = isSelected and DARK or Colors.White, Scaled = true, Position = UDim2.fromOffset(10, 8), Size = UDim2.new(1, -20, 0, 22), ZIndex = 5, Parent = card })
		C.text({ Name = "Role", Text = C.upper(id == "Default" and "TU AVATAR" or roleOf(id).Text), Role = "Title", TextSize = 12, Color = isSelected and Color3.fromRGB(60, 46, 6) or Colors.TextDim, Position = UDim2.fromOffset(10, 30), Size = UDim2.new(1, -20, 0, 16), ZIndex = 5, Parent = card })
		local state = equipped and "✔ EQUIPADO" or (owned and "TUYO" or (outfit.Event and "EVENTO" or "🔒"))
		C.text({ Name = "State", Text = state, Role = "Title", TextSize = 12, Color = equipped and Colors.Green or (isSelected and Color3.fromRGB(60, 46, 6) or Colors.TextFaint), Position = UDim2.fromOffset(10, 48), Size = UDim2.new(1, -20, 0, 16), ZIndex = 5, Parent = card })
		C.setSelected(card, isSelected)
	end
end

local function renderInfo()
	local data = ClientState.Data
	local outfit = Outfits.Get(selected)
	local r = if selected == "Default" then nil else roleOf(selected)
	rarityTag.BackgroundColor3 = rarityColor(outfit.Rarity)
	rarityLabel.Text = C.upper(outfit.Rarity or "")
	nameLabel.Text = C.upper(selected == "Default" and (player.DisplayName or "Tu avatar") or outfit.Name)
	roleLabel.Text = selected == "Default" and "SIN TRAJE · TU AVATAR DE ROBLOX" or (C.upper(r.Text) .. "  ·  " .. C.upper(outfit.Class or ""))
	styleLabel.Text = (r and r.Style or "Juega con tu avatar tal cual.") .. "\nSolo estética: no cambia vida, daño ni velocidad."
	-- Clase que le va
	local classIndex = classFor(r)
	classButton.Visible = classIndex ~= nil
	if classIndex then
		local list = data and data.Classes or GameConfig.DefaultClasses
		local class = list[classIndex]
		local weapon = class and Weapons.Get(class.Primary)
		classLabel.Text = string.format("USAR CLASE %s  ·  %s", tostring(class and class.Name or classIndex), weapon and C.upper(weapon.DisplayName) or "")
		local active = data and data.ActiveClass == classIndex
		classButton.BackgroundTransparency = active and 0.6 or 0.25
		if active then
			classLabel.Text = "✔ CLASE " .. tostring(class and class.Name or classIndex) .. " EN USO"
		end
	end
	-- Acción
	local owned = selected == "Default" or (data and data.Outfits and data.Outfits[selected] == true)
	local equipped = data and data.EquippedOutfit == selected
	local price, onSale = Shop.GetPrice("Outfit", selected)
	local yellow = false
	if equipped then
		actionLabel.Text = "EQUIPADO"
		actionLabel.TextColor3 = Colors.Green
	elseif owned then
		actionLabel.Text = "EQUIPAR"
		yellow = true
	elseif price then
		actionLabel.Text = string.format("%sCOMPRAR  💰 %d", onSale and "🔥 " or "", price)
		yellow = data ~= nil and (data.Coins or 0) >= price
		actionLabel.TextColor3 = yellow and DARK or Colors.TextDim
	else
		actionLabel.Text = C.upper(outfit.Event or "PASE DE BATALLA")
		actionLabel.TextColor3 = Colors.TextDim
	end
	actionButton.BackgroundColor3 = yellow and Colors.Yellow or Colors.PanelLight
	if yellow then
		actionLabel.TextColor3 = DARK
	end
	local gradient = actionButton:FindFirstChildOfClass("UIGradient")
	if gradient then
		gradient.Enabled = yellow
	end
end

function Operator.Render()
	if not screen then
		return
	end
	for id, button in tabs do
		C.setSelected(button, id == role)
	end
	renderStrip()
	renderInfo()
	renderPreview()
end

---------------------------------------------------------------------------
-- Acciones
---------------------------------------------------------------------------

function Operator.Select(id)
	if selected == id then
		return
	end
	selected = id
	Operator.Render()
	Transition.Pop(preview.Viewport, 0.96, 0.2)
end

function Operator.SelectRole(id)
	if role == id then
		return
	end
	role = id
	local ids = idsFor(id)
	if not table.find(ids, selected) then
		selected = ids[1] or "Default"
	end
	Operator.Render()
end

local busy = false
local function act()
	local data = ClientState.Data
	if busy or not data then
		return
	end
	local owned = selected == "Default" or (data.Outfits and data.Outfits[selected] == true)
	if data.EquippedOutfit == selected then
		return
	end
	if owned then
		UISound.Play("Equip")
		pcall(function()
			Remotes.EquipOutfit:FireServer(selected)
		end)
		return
	end
	local price = Shop.GetPrice("Outfit", selected)
	if not price then
		UISound.Play("Error")
		return
	end
	busy = true
	local ok, result, message = pcall(function()
		return Remotes.BuyItem:InvokeServer("Outfit", selected)
	end)
	busy = false
	if ok and result then
		UISound.Play("Reward")
		Transition.Flash(Colors.Yellow, 0.25, 0.3)
	else
		UISound.Play("Error")
		actionLabel.Text = C.upper(tostring(ok and (message or "No se pudo comprar") or "Error de conexión"))
	end
end

---------------------------------------------------------------------------
-- Pantalla
---------------------------------------------------------------------------

function Operator.Build(flowController, root)
	flow = flowController
	screen = C.new("Frame", { Name = "Operator", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })
	-- Personaje (detrás de todo)
	preview = Preview.new(screen, { Name = "OperatorPreview", Anchor = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -100), Size = UDim2.new(0, 500, 1, -190), Camera = "Hero" })
	local dragging, lastX = false, 0
	preview.Viewport.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging, lastX = true, input.Position.X
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and screen.Visible and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			preview:Turn("me", (input.Position.X - lastX) * 0.012)
			lastX = input.Position.X
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	-- Cabecera y roles
	C.button({ Name = "Back", Text = "VOLVER", Icon = "◀", Style = "Ghost", TextSize = 16, Position = UDim2.fromOffset(24, 22), Size = UDim2.fromOffset(130, 40), Parent = screen, Sound = "Back", OnClick = function()
		flow.SetState("Home")
	end })
	titleLabel = C.text({ Text = "OPERADOR", Role = "TitleItalic", TextSize = 46, Position = UDim2.fromOffset(170, 14), Size = UDim2.fromOffset(420, 54), Stroke = 2, Parent = screen })
	tabsRow = C.new("Frame", { Name = "Roles", BackgroundTransparency = 1, Position = UDim2.fromOffset(24, 76), Size = UDim2.new(1, -48, 0, 40), Parent = screen }, {
		C.list(6, Enum.FillDirection.Horizontal),
	})
	for i, r in ROLES do
		tabs[r.Id] = C.button({ Name = "Role_" .. r.Id, Text = r.Text, Style = "Menu", TextSize = 15, Size = UDim2.fromOffset(r.Id == "SNIPER" and 160 or 116, 40), Order = i, Parent = tabsRow, OnClick = function()
			Operator.SelectRole(r.Id)
		end })
	end
	-- Ficha (izquierda)
	infoPanel = C.new("Frame", { Name = "Info", BackgroundTransparency = 1, Position = UDim2.fromOffset(24, 136), Size = UDim2.fromOffset(380, 330), Parent = screen })
	rarityTag = C.new("Frame", { BorderSizePixel = 0, Size = UDim2.fromOffset(120, 24), Parent = infoPanel }, { C.corner(3) })
	rarityLabel = C.text({ Text = "", Role = "Title", TextSize = 14, Color = DARK, AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = rarityTag })
	nameLabel = C.text({ Text = "", Role = "TitleItalic", TextSize = 56, Scaled = true, Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 62), Stroke = 2, Parent = infoPanel })
	roleLabel = C.text({ Text = "", Role = "Title", TextSize = 16, Color = Colors.YellowText, Position = UDim2.fromOffset(2, 94), Size = UDim2.new(1, 0, 0, 20), Parent = infoPanel })
	styleLabel = C.text({ Text = "", Role = "Body", TextSize = 15, Color = Colors.Text, Wrap = true, AlignY = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(2, 124), Size = UDim2.new(1, 0, 0, 64), Parent = infoPanel })
	classButton = C.button({ Name = "UseClass", Text = "", Style = "Ghost", TextSize = 14, Position = UDim2.fromOffset(0, 198), Size = UDim2.new(1, 0, 0, 44), Parent = infoPanel, Sound = "Equip", OnClick = function()
		local index = classFor(roleOf(selected))
		if index then
			pcall(function()
				Remotes.SelectClass:FireServer(index)
			end)
		end
	end })
	classLabel = classButton:FindFirstChild("Label", true)
	-- Habilidades (derecha): las de todos los operadores, con sus teclas y tiempos reales
	abilityPanel = C.panel({ Name = "Abilities", Anchor = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 136), Size = UDim2.fromOffset(330, 236), Parent = screen }, {})
	local inner = C.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = abilityPanel }, { C.padding(12, 14, 12, 14), C.list(8) })
	C.header(inner, "HABILIDADES", "TODOS", 0)
	local abilities = GameConfig.Abilities or {}
	for i, spec in {
		{ "⚡", "IMPULSO", "E", abilities.Dash and abilities.Dash.Cooldown, "Acelerón corto en la dirección en que te mueves" },
		{ "⤒", "SUPERSALTO", "Z", abilities.Jump and abilities.Jump.Cooldown, "Salto alto hacia delante para cambiar de altura" },
		{ "✚", "POCIÓN", "X", abilities.Potion and abilities.Potion.Cooldown, "Recupera " .. tostring(abilities.Potion and abilities.Potion.Heal or 50) .. " de vida en unos segundos" },
	} do
		local row = C.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 52), LayoutOrder = i, Parent = inner })
		table.insert(abilityRows, row)
		-- (cuadrado del alto de la fila: en el teléfono las filas son más bajas)
		local key = C.new("Frame", { BackgroundColor3 = Colors.PanelLight, BorderSizePixel = 0, Size = UDim2.new(0, 44, 1, -6), Parent = row }, {
			C.corner(4),
			C.stroke(Colors.Yellow, 1, 0.5),
			C.new("UIAspectRatioConstraint", { AspectRatio = 1 }),
		})
		C.text({ Text = spec[1], Role = "Title", TextSize = 22, Color = Colors.YellowText, AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = key })
		C.text({ Text = spec[2] .. "  ·  " .. spec[3], Role = "Title", TextSize = 16, Position = UDim2.fromOffset(54, 2), Size = UDim2.new(1, -110, 0, 20), Parent = row })
		C.text({ Text = spec[4] and (tostring(spec[4]) .. " s") or "", Role = "Number", TextSize = 14, Color = Colors.TextDim, AlignX = Enum.TextXAlignment.Right, Anchor = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 2), Size = UDim2.fromOffset(50, 20), Parent = row })
		table.insert(abilityDescs, C.text({ Text = spec[5], Role = "Body", TextSize = 12, Color = Colors.TextDim, Wrap = true, Position = UDim2.fromOffset(54, 22), Size = UDim2.new(1, -54, 0, 28), Parent = row }))
	end
	actionButton = C.button({ Name = "Action", Text = "", Style = "Primary", TextSize = 20, Anchor = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 384), Size = UDim2.fromOffset(330, 54), Parent = screen, Sound = "Click", OnClick = act })
	actionLabel = actionButton:FindFirstChild("Label", true)
	-- Tira de selección (abajo; se desplaza si hay muchos)
	local scroller = C.new("ScrollingFrame", {
		Name = "Strip",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 24, 1, -16),
		Size = UDim2.new(1, -48, 0, 86),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Colors.Yellow,
		Parent = screen,
	})
	strip = C.new("Frame", { BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 0, 78), Parent = scroller }, {
		C.list(8, Enum.FillDirection.Horizontal),
	})
	ClientState.DataChanged.Event:Connect(function()
		if screen.Visible then
			shownKey = nil
			Operator.Render()
		end
	end)
	Operator.Screen = screen
end

local function applyLayout()
	local width = flow.Root and flow.Root:GetAttribute("VirtualWidth") or 1280
	local phone = C.Breakpoint() == "PHONE"
	local narrow = phone or width < 1100
	local top = phone and 108 or 136
	titleLabel.TextSize = phone and 34 or 46
	tabsRow.Position = UDim2.fromOffset(24, phone and 58 or 76)
	for id, tab in tabs do
		tab.Size = UDim2.fromOffset(id == "SNIPER" and (phone and 140 or 160) or (phone and 100 or 116), phone and 34 or 40)
	end
	infoPanel.Position = UDim2.fromOffset(24, top)
	infoPanel.Size = UDim2.fromOffset(narrow and 300 or 380, 330)
	-- (teléfono: habilidades sin descripción, en filas bajas, para que quepa el botón encima de la tira)
	for _, row in abilityRows do
		row.Size = UDim2.new(1, 0, 0, phone and 34 or 52)
	end
	for _, desc in abilityDescs do
		desc.Visible = not phone
	end
	abilityPanel.Position = UDim2.new(1, -24, 0, top)
	abilityPanel.Size = UDim2.fromOffset(narrow and 280 or 330, phone and 160 or 236)
	actionButton.Position = UDim2.new(1, -24, 0, top + (phone and 168 or 248))
	actionButton.Size = UDim2.fromOffset(narrow and 280 or 330, phone and 44 or 54)
	preview.Viewport.Size = UDim2.new(0, narrow and 380 or 500, 1, -190)
end

function Operator.Show()
	local data = ClientState.Data
	selected = data and data.EquippedOutfit or "Default"
	role = "ALL"
	shownKey = nil
	applyLayout()
	flow.SetCamera("Orbit")
	flow.SetBackdrop(0.55, 0.25)
	Transition.Blur(14, 0.25)
	screen.Visible = true
	Operator.Render()
	preview:SetActive(true)
	Transition.Pop(preview.Viewport, 0.94, 0.3)
	Transition.SlideIn(infoPanel, Vector2.new(-50, 0), 0.3)
	Transition.SlideIn(abilityPanel, Vector2.new(50, 0), 0.3, 0.04)
end

function Operator.Hide()
	preview:SetActive(false)
	screen.Visible = false
end

return Operator
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="190">
                <Properties>
                  <string name="Name">Pass</string>
                  <string name="Source"><![CDATA[-- PASE DE BATALLA: la temporada con su reloj real, tu nivel y tu XP, la pista horizontal con la vía
-- GRATIS y la PREMIUM (se desplaza; empieza en tu nivel), la recompensa elegida en grande con
-- RECLAMAR o PREVISUALIZAR, RECLAMAR TODO y las misiones de temporada. Comprar el premium o un nivel
-- solo se ofrece aquí, en un botón, sin ventanas. Lo reclamado entra deslizándose por la derecha.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Icons = require(Shared.Icons)
local Catalog = require(Shared.Economy.CosmeticCatalog)
local Products = require(Shared.Economy.Products)
local BattlePassConfig = require(Shared.Economy.BattlePassConfig)

local Modules = script.Parent.Parent.Parent
local ClientState = require(Modules.ClientState)

local Flow = script.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Transition = require(Flow.Transition)
local UISound = require(Flow.UISound)
local StoreFolder = Flow.Store
local StoreData = require(StoreFolder.StoreData)
local ItemArt = require(StoreFolder.ItemArt)
local Inspect = require(StoreFolder.Inspect)
local Reveal = require(StoreFolder.Reveal)

local Colors = Theme.Colors
local DARK = Color3.fromRGB(16, 14, 8)
local GOLD = Color3.fromRGB(255, 200, 60)

local Pass = {}

local flow, rootFrame, screen, titleLabel, seasonLabel, timerLabel, tierLabel, xpBar, xpLabel
local claimAllButton, premiumButton, skipButton, track, trackScroller, detail, missionsPanel, missionsList, missionsToggle
local slideLayer
local cells = {} -- [tier .. track] = { Frame, Tier, Track }
local selected = { Tier = 1, Track = "Free" }
local claiming = false

local function isPhone()
	return C.Breakpoint() == "PHONE"
end

local function cellSize()
	return isPhone() and 72 or 104
end

local function view()
	local data = ClientState.Data
	return data and data.Pass or nil
end

local function season()
	local v = view()
	return v and BattlePassConfig.Get(v.Season) or BattlePassConfig.Current(math.floor(StoreData.Now()))
end

-- Ficha de una recompensa: item del catálogo o monedas
local function rewardInfo(reward)
	if not reward then
		return nil
	end
	if reward.Type == "Coins" then
		return { Coins = reward.Amount, Name = reward.Amount .. " MONEDAS", Rarity = reward.Amount >= 500 and "Épico" or "Raro", Icon = Icons.Coin }
	elseif reward.Type == "Crate" then
		return { Name = (reward.Amount or 1) .. " CAJA", Rarity = "Raro", Icon = Icons.Crate }
	end
	return Catalog.Item(reward.Type, reward.Id)
end

-- "Claimed" | "Claimable" | "Locked" | "NeedPremium" | "Empty"
local function cellState(tier, trackName)
	local s = season()
	local v = view()
	local reward = s and s.Tiers[tier] and s.Tiers[tier][trackName]
	if not reward then
		return "Empty"
	end
	if not v then
		return "Locked"
	end
	if v[trackName] and v[trackName][tostring(tier)] then
		return "Claimed"
	end
	if trackName == "Premium" and not v.HasPremium then
		return "NeedPremium"
	end
	if tier > (v.Tier or 1) then
		return "Locked"
	end
	return "Claimable"
end

---------------------------------------------------------------------------
-- Recompensas que entran por la derecha
---------------------------------------------------------------------------

local function slideIn(granted)
	for i, reward in granted do
		task.delay((i - 1) * 0.12, function()
			if not slideLayer.Parent then
				return
			end
			local info = reward.Type == "Coins" and { Name = "+" .. reward.Amount .. " MONEDAS", Icon = Icons.Coin, Rarity = "Raro" } or Catalog.Item(reward.Type, reward.Id) or { Name = tostring(reward.Id), Rarity = "Común" }
			local row = C.panel({ Name = "Slide", Size = UDim2.fromOffset(300, 56), Parent = slideLayer }, { Alpha = 0.05, Accent = ItemArt.RarityColor(info.Rarity), StrokeColor = ItemArt.RarityColor(info.Rarity), StrokeAlpha = 0.4 })
			C.text({ Text = info.Icon or "★", TextSize = 26, AlignX = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(8, 0), Size = UDim2.fromOffset(40, 56), Parent = row })
			C.text({ Text = C.upper(info.Name or ""), Role = "TitleItalic", TextSize = 18, Scaled = true, Position = UDim2.fromOffset(52, 6), Size = UDim2.new(1, -60, 0, 24), Parent = row })
			C.text({ Text = reward.Duplicate and ("YA LO TENÍAS: +" .. (reward.Coins or 0) .. " 💰") or ("NIVEL " .. tostring(reward.Tier or "") .. " · " .. (reward.Track == "Premium" and "PREMIUM" or "GRATIS")), Role = "Title", TextSize = 12, Color = Colors.TextDim, Position = UDim2.fromOffset(52, 30), Size = UDim2.new(1, -60, 0, 18), Parent = row })
			Transition.SlideIn(row, Vector2.new(320, 0), 0.25)
			UISound.Play("Claim", 1 + i * 0.05)
			task.delay(2.6, function()
				if row.Parent then
					Transition.FadeOut(row, 0.25, true)
					task.delay(0.3, function()
						row:Destroy()
					end)
				end
			end)
		end)
	end
end

local function claim(tier, trackName)
	if claiming then
		return
	end
	claiming = true
	local ok, success, result = pcall(function()
		return Remotes.ClaimPass:InvokeServer(tier, trackName)
	end)
	claiming = false
	if ok and success and type(result) == "table" then
		Transition.Flash(Colors.Yellow, 0.18, 0.3)
		slideIn(result)
	else
		UISound.Play("Error")
	end
end

---------------------------------------------------------------------------
-- Pintar
---------------------------------------------------------------------------

local function renderDetail()
	for _, child in detail:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local s = season()
	local entry = s and s.Tiers[selected.Tier]
	local reward = entry and entry[selected.Track]
	local info = rewardInfo(reward)
	local phone = isPhone()
	if not info then
		C.text({ Text = "Nada en este nivel", Role = "Body", TextSize = 14, Color = Colors.TextDim, Position = UDim2.fromOffset(14, 14), Size = UDim2.new(1, -28, 0, 20), Parent = detail })
		return
	end
	-- (en el teléfono, una tira baja: imagen, nombre y botones a la derecha)
	local thumbSize = phone and 50 or 120
	local pad = phone and 7 or 12
	if info.Kind then
		ItemArt.Thumb(detail, info, { Position = UDim2.fromOffset(pad, pad), Size = UDim2.fromOffset(thumbSize, thumbSize) })
	else
		local art = ItemArt.Backdrop(detail, info.Rarity, { Position = UDim2.fromOffset(pad, pad), Size = UDim2.fromOffset(thumbSize, thumbSize) })
		C.text({ Text = info.Icon, TextSize = 50, AlignX = Enum.TextXAlignment.Center, Scaled = true, Position = UDim2.fromScale(0.15, 0.12), Size = UDim2.fromScale(0.7, 0.7), Parent = art })
	end
	local x = thumbSize + pad * 2
	local textRight = phone and 220 or 12
	C.text({ Text = (selected.Track == "Premium" and "PREMIUM" or "GRATIS") .. "  ·  NIVEL " .. selected.Tier, Role = "Title", TextSize = phone and 11 or 13, Color = selected.Track == "Premium" and GOLD or Colors.TextDim, Position = UDim2.fromOffset(x, pad), Size = UDim2.new(1, -x - textRight, 0, phone and 14 or 18), Parent = detail })
	C.text({ Text = C.upper(info.Name or ""), Role = "TitleItalic", TextSize = phone and 18 or 28, Scaled = true, Position = UDim2.fromOffset(x, phone and 20 or 30), Size = UDim2.new(1, -x - textRight, 0, phone and 22 or 34), Parent = detail })
	C.text({ Text = C.upper(info.Rarity or "") .. (info.Label and ("  ·  " .. info.Label) or ""), Role = "Title", TextSize = phone and 11 or 13, Color = ItemArt.RarityColor(info.Rarity), Scaled = phone, Position = UDim2.fromOffset(x, phone and 42 or 66), Size = UDim2.new(1, -x - textRight, 0, phone and 14 or 18), Parent = detail })
	local state = cellState(selected.Tier, selected.Track)
	local text = ({ Claimable = "RECLAMAR", Claimed = "✓ RECLAMADO", Locked = "LLEGA AL NIVEL " .. selected.Tier, NeedPremium = "ES DEL PASE PREMIUM", Empty = "" })[state]
	local actionPosition = phone and UDim2.new(1, -(pad + 44 + 6 + 160), 0, 12) or UDim2.fromOffset(x, 92)
	local action = C.button({ Name = "Claim", Text = text, Style = state == "Claimable" and "Primary" or "Ghost", TextSize = phone and 13 or 17, Position = actionPosition, Size = UDim2.fromOffset(phone and 160 or 190, phone and 40 or 44), Parent = detail, Sound = "Click", OnClick = function()
		if cellState(selected.Tier, selected.Track) == "Claimable" then
			claim(selected.Tier, selected.Track)
		end
	end })
	local _ = action
	if info.Kind then
		C.button({ Name = "Preview", Text = "", Icon = Icons.Eye, Style = "Ghost", TextSize = 18, Position = phone and UDim2.new(1, -(pad + 44), 0, 12) or UDim2.fromOffset(x + 198, 92), Size = UDim2.fromOffset(phone and 44 or 48, phone and 40 or 44), Parent = detail, OnClick = function()
			Inspect.Open(rootFrame, info, {
				OnBuy = function() end,
				OnEquip = function(item)
					StoreData.Equip(item.Kind, item.Id)
					UISound.Play("Equip")
				end,
			})
		end })
	end
end

local function cellArt(holder, info)
	if info.Kind then
		ItemArt.Thumb(holder, info, { Size = UDim2.fromScale(1, 1) })
	else
		local art = ItemArt.Backdrop(holder, info.Rarity, { Size = UDim2.fromScale(1, 1) })
		C.text({ Text = info.Icon, TextSize = 34, AlignX = Enum.TextXAlignment.Center, Scaled = true, Position = UDim2.fromScale(0.2, 0.1), Size = UDim2.fromScale(0.6, 0.5), Parent = art })
		C.text({ Text = info.Coins and tostring(info.Coins) or info.Name, Role = "Number", TextSize = 18, Color = Colors.White, AlignX = Enum.TextXAlignment.Center, Scaled = true, Position = UDim2.fromScale(0.05, 0.64), Size = UDim2.fromScale(0.9, 0.28), Parent = art })
	end
end

local function renderTrack()
	for _, child in track:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	table.clear(cells)
	local s = season()
	if not s then
		return
	end
	local v = view()
	local cell = cellSize()
	for tier = 1, BattlePassConfig.Tiers do
		local column = C.new("Frame", { Name = "Tier_" .. tier, BackgroundTransparency = 1, Size = UDim2.fromOffset(cell + 8, cell * 2 + 44), LayoutOrder = tier, Parent = track })
		local reached = v and tier <= (v.Tier or 1)
		local number = C.new("Frame", { Name = "Number", BackgroundColor3 = reached and Colors.Yellow or Colors.PanelLight, BorderSizePixel = 0, Position = UDim2.fromOffset(4, 0), Size = UDim2.new(1, -8, 0, 24), Parent = column }, { C.corner(3) })
		C.text({ Text = tostring(tier), Role = "Number", TextSize = 16, Color = reached and DARK or Colors.TextDim, AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = number })
		for row, trackName in { "Free", "Premium" } do
			local reward = s.Tiers[tier] and s.Tiers[tier][trackName]
			local info = rewardInfo(reward)
			local holder = C.new("TextButton", { Name = trackName, Text = "", AutoButtonColor = false, BackgroundColor3 = Colors.Panel, BackgroundTransparency = 0.3, BorderSizePixel = 0, Position = UDim2.fromOffset(4, 30 + (row - 1) * (cell + 8)), Size = UDim2.fromOffset(cell, cell), Parent = column }, {
				C.corner(4),
				C.stroke(trackName == "Premium" and GOLD or Colors.Line, trackName == "Premium" and 1.5 or 1, trackName == "Premium" and 0.4 or 0.85),
			})
			if info then
				cellArt(holder, info)
			end
			local state = cellState(tier, trackName)
			if state == "Claimed" then
				local shade = C.new("Frame", { Name = "Shade", BackgroundColor3 = Colors.Black, BackgroundTransparency = 0.45, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 3, Parent = holder }, { C.corner(4) })
				C.text({ Text = "✓", Role = "Title", TextSize = 30, Color = Colors.Green, AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = shade })
			elseif state == "Locked" or state == "NeedPremium" then
				local shade = C.new("Frame", { Name = "Shade", BackgroundColor3 = Colors.Black, BackgroundTransparency = state == "Locked" and 0.5 or 0.35, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 3, Parent = holder }, { C.corner(4) })
				C.text({ Text = "🔒", TextSize = 16, AlignX = Enum.TextXAlignment.Right, AlignY = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(-4, 4), Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = shade })
			elseif state == "Claimable" then
				local stroke = holder:FindFirstChildOfClass("UIStroke")
				if stroke then
					stroke.Color = Colors.Yellow
					stroke.Thickness = 2.5
					stroke.Transparency = 0
				end
				local tag = C.new("Frame", { Name = "ClaimTag", BackgroundColor3 = Colors.Yellow, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 4), Size = UDim2.new(1, -10, 0, 16), ZIndex = 4, Parent = holder }, { C.corner(3) })
				C.text({ Text = "RECLAMAR", Role = "Title", TextSize = 13, Color = DARK, AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = tag })
			end
			if selected.Tier == tier and selected.Track == trackName then
				C.new("UIStroke", { Name = "Selected", Color = Colors.White, Thickness = 3, Transparency = 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = holder })
			end
			C.feel(holder, { Silent = true })
			holder.Activated:Connect(function()
				UISound.Play("Click")
				selected = { Tier = tier, Track = trackName }
				Pass.Render(true)
				if cellState(tier, trackName) == "Claimable" then
					claim(tier, trackName)
				end
			end)
			cells[tier .. trackName] = { Frame = holder, Tier = tier, Track = trackName }
		end
	end
end

local function renderMissions()
	for _, child in missionsList:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local v = view()
	for i, mission in v and v.Missions or {} do
		local row = C.new("Frame", { Name = "Mission_" .. mission.Id, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 38), LayoutOrder = i, Parent = missionsList })
		C.text({ Text = (mission.Done and "✓ " or "") .. mission.Text, Role = "BodyBold", TextSize = 13, Color = mission.Done and Colors.Green or Colors.Text, Size = UDim2.new(1, -90, 0, 18), Parent = row })
		C.text({ Text = "+" .. mission.XP .. " XP", Role = "Number", TextSize = 13, Color = Colors.YellowText, AlignX = Enum.TextXAlignment.Right, Anchor = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(86, 18), Parent = row })
		local bar = C.progress({ Size = UDim2.new(1, -60, 0, 6), Position = UDim2.fromOffset(0, 24), Color = mission.Done and Colors.Green or Colors.Yellow, Value = mission.Progress / math.max(1, mission.Goal), Parent = row })
		local _ = bar
		C.text({ Text = mission.Progress .. "/" .. mission.Goal, Role = "Number", TextSize = 12, Color = Colors.TextDim, AlignX = Enum.TextXAlignment.Right, Anchor = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 19), Size = UDim2.fromOffset(56, 16), Parent = row })
	end
	local note = C.text({ Name = "Note", Text = string.format("Las misiones diarias (+%d) y semanales (+%d) también dan XP del pase.", BattlePassConfig.DailyMissionXP, BattlePassConfig.WeeklyMissionXP), Role = "Body", TextSize = 12, Color = Colors.TextDim, Wrap = true, Size = UDim2.new(1, 0, 0, 30), Order = 99, Parent = missionsList })
	local _ = note
end

local function renderHeader()
	local v = view()
	local s = season()
	seasonLabel.Text = s and (s.Name .. "  ·  " .. s.Title) or "ENTRE TEMPORADAS"
	local tier = v and v.Tier or 1
	tierLabel.Text = "NIVEL " .. tier
	local maxed = tier >= BattlePassConfig.Tiers
	local into = v and (v.XP - BattlePassConfig.XPFor(tier)) or 0
	xpBar:Set(maxed and 1 or into / BattlePassConfig.XPPerTier)
	xpLabel.Text = maxed and "¡PASE COMPLETADO!" or string.format("%d / %d XP", into, BattlePassConfig.XPPerTier)
	local claimable = v and v.Claimable or 0
	local claimLabel = claimAllButton:FindFirstChild("Label", true)
	claimLabel.Text = claimable > 0 and ("RECLAMAR TODO (" .. claimable .. ")") or "NADA POR RECLAMAR"
	claimAllButton.BackgroundColor3 = claimable > 0 and Colors.Yellow or Colors.PanelLight
	claimLabel.TextColor3 = claimable > 0 and DARK or Colors.TextDim
	local gradient = claimAllButton:FindFirstChildOfClass("UIGradient")
	if gradient then
		gradient.Enabled = claimable > 0
	end
	-- Premium: un botón (o la marca de que ya lo tienes)
	local premiumLabel = premiumButton:FindFirstChild("Label", true)
	if v and v.HasPremium then
		premiumLabel.Text = "✓ PREMIUM"
		premiumButton.BackgroundColor3 = Colors.PanelLight
		premiumLabel.TextColor3 = GOLD
	else
		local entry = s and s.Premium
		local pending = StoreData.Pending and s and StoreData.Pending.Key == "Pass:" .. s.Id
		premiumLabel.Text = pending and "PROCESANDO…" or (entry and Products.Enabled(entry) and ("PREMIUM · R$ " .. tostring(StoreData.Robux(entry))) or "PREMIUM · PRÓXIMAMENTE")
		premiumButton.BackgroundColor3 = GOLD
		premiumLabel.TextColor3 = DARK
	end
	-- Un nivel con Robux (pequeño, solo aquí)
	skipButton.Visible = not maxed and s ~= nil and (v and v.Active ~= false)
	local skipLabel = skipButton:FindFirstChild("Label", true)
	skipLabel.Text = Products.Enabled(Products.TierSkip) and ("+1 NIVEL · R$ " .. tostring(StoreData.Robux(Products.TierSkip))) or "+1 NIVEL · PRÓXIMAMENTE"
end

function Pass.UpdateTimer()
	local s = season()
	if not s then
		timerLabel.Text = ""
		return
	end
	local left = s.EndsAt - StoreData.Now()
	timerLabel.Text = left > 0 and ("TERMINA EN " .. StoreData.FormatTime(left)) or "TEMPORADA TERMINADA"
end

-- keepScroll: no mover la pista (al tocar una casilla)
function Pass.Render(keepScroll)
	if not screen then
		return
	end
	renderHeader()
	renderTrack()
	renderDetail()
	renderMissions()
	Pass.UpdateTimer()
	if not keepScroll then
		-- (la pista empieza en tu nivel)
		local v = view()
		local tier = v and v.Tier or 1
		local cell = cellSize()
		task.defer(function()
			trackScroller.CanvasPosition = Vector2.new(math.max(0, (tier - 2) * (cell + 8 + 6)), 0)
		end)
	end
end

---------------------------------------------------------------------------
-- Pantalla
---------------------------------------------------------------------------

local progressRow

local function applyLayout()
	local phone = isPhone()
	local cell = cellSize()
	titleLabel.TextSize = phone and 32 or 46
	titleLabel.Position = UDim2.fromOffset(phone and 166 or 170, phone and 6 or 10)
	seasonLabel.Position = UDim2.fromOffset(phone and 168 or 172, phone and 44 or 60)
	seasonLabel.TextSize = phone and 13 or 16
	timerLabel.Position = UDim2.fromOffset(phone and 168 or 172, phone and 60 or 80)
	-- Premium y +1 nivel arriba a la derecha (en el teléfono, en una fila)
	premiumButton.Position = UDim2.new(1, phone and -16 or -24, 0, phone and 10 or 18)
	premiumButton.Size = UDim2.fromOffset(phone and 210 or 280, phone and 38 or 48)
	skipButton.Position = phone and UDim2.new(1, -234, 0, 10) or UDim2.new(1, -24, 0, 72)
	skipButton.Size = UDim2.fromOffset(phone and 150 or 200, phone and 38 or 34)
	-- Progreso
	progressRow.Position = UDim2.fromOffset(phone and 16 or 24, phone and 80 or 108)
	progressRow.Size = UDim2.new(1, phone and -32 or -48, 0, phone and 34 or 44)
	tierLabel.TextSize = phone and 22 or 30
	tierLabel.Size = UDim2.fromOffset(phone and 96 or 150, phone and 34 or 40)
	claimAllButton.Size = UDim2.fromOffset(phone and 170 or 280, phone and 32 or 42)
	missionsToggle.Visible = phone
	missionsToggle.Parent = phone and progressRow or screen
	missionsToggle.AnchorPoint = Vector2.new(1, 0.5)
	missionsToggle.Position = UDim2.new(1, -178, 0.5, 0)
	missionsToggle.Size = UDim2.fromOffset(112, 32)
	local barRight = phone and (170 + 120 + 70) or 300
	xpBar.Frame.Position = UDim2.new(0, phone and 100 or 156, 0.5, 0)
	xpBar.Frame.Size = UDim2.new(1, -((phone and 100 or 156) + barRight + 10), 0, phone and 8 or 10)
	xpLabel.Position = UDim2.new(1, -(barRight - (phone and 64 or 0)), 0.5, 0)
	xpLabel.Size = UDim2.fromOffset(phone and 64 or 150, 18)
	xpLabel.TextSize = phone and 11 or 14
	-- Pista
	local trackTop = phone and 120 or 160
	local left = phone and 76 or 110
	trackScroller.Position = UDim2.fromOffset(left, trackTop)
	trackScroller.Size = UDim2.new(1, -(left + (phone and 16 or 24)), 0, cell * 2 + 46)
	local free, premium = screen:FindFirstChild("FreeLabel"), screen:FindFirstChild("PremiumLabel")
	free.Position = UDim2.fromOffset(phone and 12 or 24, trackTop + 30)
	free.Size = UDim2.fromOffset(phone and 58 or 80, cell)
	premium.Position = UDim2.fromOffset(phone and 12 or 24, trackTop + 30 + cell + 8)
	premium.Size = UDim2.fromOffset(phone and 58 or 80, cell)
	-- Recompensa elegida y misiones
	local below = trackTop + cell * 2 + (phone and 50 or 66)
	detail.Position = UDim2.fromOffset(phone and 16 or 24, below)
	detail.Size = UDim2.new(phone and 1 or 0.5, phone and -32 or -36, 0, phone and 64 or 146)
	missionsPanel.Visible = not phone
	missionsPanel.Position = phone and UDim2.fromOffset(16, 56) or UDim2.new(0.5, 12, 0, below)
	missionsPanel.Size = phone and UDim2.new(1, -32, 1, -66) or UDim2.new(0.5, -36, 1, -(below + 18))
	slideLayer.Position = UDim2.new(1, phone and -16 or -24, 0, trackTop)
end

-- Al entrar: la primera recompensa por reclamar, o la de tu nivel
local function defaultSelection()
	local v = view()
	local tier = v and v.Tier or 1
	for t = 1, tier do
		for _, trackName in { "Free", "Premium" } do
			if cellState(t, trackName) == "Claimable" then
				return { Tier = t, Track = trackName }
			end
		end
	end
	for t = tier, BattlePassConfig.Tiers do
		if cellState(t, "Free") ~= "Empty" then
			return { Tier = t, Track = "Free" }
		elseif cellState(t, "Premium") ~= "Empty" then
			return { Tier = t, Track = "Premium" }
		end
	end
	return { Tier = tier, Track = "Free" }
end

function Pass.Build(flowController, root)
	flow = flowController
	rootFrame = root
	StoreData.Init()
	Reveal.Init()
	Reveal.OnOpenPass = function()
		if flow.Lobby[flow.State] then
			flow.SetState("Pass")
		end
	end
	screen = C.new("Frame", { Name = "Pass", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })
	C.button({ Name = "Back", Text = "VOLVER", Icon = "◀", Style = "Ghost", TextSize = 16, Position = UDim2.fromOffset(24, 22), Size = UDim2.fromOffset(130, 40), Parent = screen, Sound = "Back", OnClick = function()
		flow.SetState("Home")
	end })
	titleLabel = C.text({ Text = "PASE DE BATALLA", Role = "TitleItalic", TextSize = 46, Position = UDim2.fromOffset(170, 10), Size = UDim2.fromOffset(460, 54), Stroke = 2, Parent = screen })
	seasonLabel = C.text({ Text = "", Role = "Title", TextSize = 16, Color = Colors.YellowText, Position = UDim2.fromOffset(172, 60), Size = UDim2.fromOffset(420, 20), Parent = screen })
	timerLabel = C.text({ Name = "Timer", Text = "", Role = "Number", TextSize = 14, Color = Colors.TextDim, Position = UDim2.fromOffset(172, 80), Size = UDim2.fromOffset(300, 18), Parent = screen })
	-- Derecha arriba: premium y +1 nivel
	premiumButton = C.button({ Name = "Premium", Text = "PREMIUM", Icon = Icons.Medal, Style = "Primary", TextSize = 18, Anchor = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 18), Size = UDim2.fromOffset(280, 48), Parent = screen, Sound = "Click", OnClick = function()
		local v = view()
		local s = season()
		if s and not (v and v.HasPremium) then
			local ok, reason = StoreData.PromptRobux({ Type = "PassPremium", Season = s.Id })
			if not ok then
				UISound.Play("Error")
				local label = premiumButton:FindFirstChild("Label", true)
				label.Text = reason
			end
		end
	end })
	skipButton = C.button({ Name = "TierSkip", Text = "+1 NIVEL", Style = "Ghost", TextSize = 14, Anchor = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 72), Size = UDim2.fromOffset(200, 34), Parent = screen, OnClick = function()
		local ok = StoreData.PromptRobux({ Type = "TierSkip" })
		if not ok then
			UISound.Play("Error")
		end
	end })
	-- Progreso
	local progress = C.new("Frame", { Name = "Progress", BackgroundTransparency = 1, Position = UDim2.fromOffset(24, 108), Size = UDim2.new(1, -48, 0, 44), Parent = screen })
	progressRow = progress
	tierLabel = C.text({ Name = "Tier", Text = "NIVEL 1", Role = "TitleItalic", TextSize = 30, Color = Colors.White, Size = UDim2.fromOffset(150, 40), Parent = progress })
	xpBar = C.progress({ Size = UDim2.new(1, -470, 0, 10), Position = UDim2.new(0, 156, 0.5, 0), Anchor = Vector2.new(0, 0.5), Parent = progress })
	xpLabel = C.text({ Name = "XP", Text = "", Role = "Number", TextSize = 14, Color = Colors.TextDim, AlignX = Enum.TextXAlignment.Right, Anchor = Vector2.new(1, 0.5), Position = UDim2.new(1, -300, 0.5, 0), Size = UDim2.fromOffset(150, 18), Parent = progress })
	claimAllButton = C.button({ Name = "ClaimAll", Text = "RECLAMAR TODO", Style = "Primary", TextSize = 17, Anchor = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(280, 42), Parent = progress, Sound = "Click", OnClick = function()
		local v = view()
		if v and (v.Claimable or 0) > 0 then
			claim("All")
		end
	end })
	-- Pista
	C.text({ Name = "FreeLabel", Text = "GRATIS", Role = "TitleItalic", TextSize = 18, Color = Colors.White, AlignX = Enum.TextXAlignment.Center, Scaled = true, Parent = screen })
	C.text({ Name = "PremiumLabel", Text = "PREMIUM", Role = "TitleItalic", TextSize = 18, Color = GOLD, AlignX = Enum.TextXAlignment.Center, Scaled = true, Parent = screen })
	trackScroller = C.new("ScrollingFrame", { Name = "Track", BackgroundTransparency = 1, BorderSizePixel = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollingDirection = Enum.ScrollingDirection.X, ScrollBarThickness = 4, ScrollBarImageColor3 = Colors.Yellow, Parent = screen })
	track = C.new("Frame", { Name = "Columns", BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromScale(0, 1), Parent = trackScroller }, {
		C.list(6, Enum.FillDirection.Horizontal),
	})
	-- Recompensa elegida
	detail = C.panel({ Name = "Detail", Parent = screen }, { Alpha = 0.12 })
	-- Misiones de temporada
	missionsPanel = C.panel({ Name = "Missions", ZIndex = 5, Parent = screen }, { Alpha = 0.06 })
	local missionsInner = C.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = missionsPanel }, { C.padding(10, 14, 10, 14) })
	C.header(missionsInner, "MISIONES DE TEMPORADA", nil, 0)
	missionsList = C.new("ScrollingFrame", { Name = "List", BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 1, -30), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 3, Parent = missionsInner }, { C.list(6) })
	missionsToggle = C.button({ Name = "MissionsToggle", Text = "MISIONES", Icon = Icons.Crosshair, Style = "Ghost", TextSize = 14, Anchor = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -10), Size = UDim2.fromOffset(150, 40), ZIndex = 6, Parent = screen, OnClick = function()
		missionsPanel.Visible = not missionsPanel.Visible
		missionsPanel.ZIndex = 9
		local label = missionsToggle:FindFirstChild("Label", true)
		label.Text = missionsPanel.Visible and "CERRAR" or "MISIONES"
	end })
	slideLayer = C.new("Frame", { Name = "Slides", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 160), Size = UDim2.fromOffset(300, 400), ZIndex = 8, Parent = screen }, {
		C.list(6),
	})
	ClientState.DataChanged.Event:Connect(function()
		if screen.Visible then
			Pass.Render(true)
		end
	end)
	StoreData.Changed.Event:Connect(function()
		if screen.Visible then
			renderHeader()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if screen.Visible then
				Pass.UpdateTimer()
			end
		end
	end)
	Pass.Screen = screen
end

function Pass.Show()
	local v = view()
	selected = defaultSelection()
	applyLayout()
	flow.SetCamera("Orbit")
	flow.SetBackdrop(0.62, 0.25)
	Transition.Blur(16, 0.25)
	screen.Visible = true
	Pass.Render(false)
	StoreData.Track("battlepass_open", { tier = v and v.Tier or 1 })
	Transition.SlideIn(trackScroller, Vector2.new(60, 0), 0.3)
end

function Pass.Hide()
	Inspect.Close()
	screen.Visible = false
end

return Pass
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="191">
                <Properties>
                  <string name="Name">Results</string>
                  <string name="Source"><![CDATA[-- PANTALLA FINAL (ResultsController): sustituye al cuadro de fin de partida del HUD. Se abre con el
-- RoundEnd del servidor (MatchResult real, ver MatchResults) a quien jugó la partida:
--   0,0 s  fundido corto (el HUD se va, nada de la partida se queda flotando)
--   0,3 s  la cámara enseña a tu equipo en una escena 3D dentro del mapa (avatares reales con su arma)
--   0,8 s  VICTORIA / DERROTA + motivo, con su golpe de sonido
--   1,3 s  marcador contando
--   1,7 s  tarjetas de tus compañeros
--   2,2 s  MVP: foco, corona, destello dorado y sus cifras
--   2,8 s  recompensas (XP, monedas, cajas, rango) → barra de nivel → desafíos → desbloqueo
--   3,0 s  JUGAR DE NUEVO (amarillo), VOLVER AL LOBBY, VER MARCADOR
-- Las recompensas llegan aparte (MatchSummary) y solo se pintan las que el servidor ha dado.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Catalog = require(Shared.Economy.CosmeticCatalog)
local MonetizationConfig = require(Shared.Economy.MonetizationConfig)

local Modules = script.Parent.Parent.Parent
local ClientState = require(Modules.ClientState)

local Flow = script.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Transition = require(Flow.Transition)
local UISound = require(Flow.UISound)

local ResultsFolder = Flow.Results
local Data = require(ResultsFolder.Data)
local Stage = require(ResultsFolder.Stage)
local Camera = require(ResultsFolder.Camera)
local Anim = require(ResultsFolder.Anim)
local Components = ResultsFolder.Components
local ResultHeader = require(Components.ResultHeader)
local ScoreDisplay = require(Components.ScoreDisplay)
local PlayerResultCard = require(Components.PlayerResultCard)
local MVPCard = require(Components.MVPCard)
local RewardsPanel = require(Components.RewardsPanel)
local OfferCard = require(Components.OfferCard)
local XPProgress = require(Components.XPProgress)
local UnlockCard = require(Components.UnlockCard)
local ChallengeProgress = require(Components.ChallengeProgress)
local ScoreboardPanel = require(Components.ScoreboardPanel)
local ResultActions = require(Components.ResultActions)

local player = Players.LocalPlayer
local Colors = Theme.Colors

local Results = {}
Results.ReadyForSummary = false -- (las recompensas ya pueden entrar: pasado su momento en la secuencia)

local flow, screen, header, score, cardsRow, bottomRow, rewards, xp, unlock, challenges, scoreboard, actions, offer
local view, summary, stage
local mvpCard
local pendingSummary
local stepConnection
local autoAdvance = true
local nextAt -- (os.clock) cuándo pasa sola a buscar la siguiente partida
local summaryShown = false
local phone = false

-- Orden de las tarjetas de izquierda a derecha (como la formación: 4 · 2 · MVP · 3 · 5)
local CARD_ORDER = { 4, 2, 1, 3, 5 }

---------------------------------------------------------------------------
-- Personajes reales del mundo: ocultos en local mientras se ve la escena
---------------------------------------------------------------------------

local hiddenParts = {}
local function hideWorldCharacters(hidden)
	if not hidden then
		for part in hiddenParts do
			if part.Parent then
				part.LocalTransparencyModifier = 0
			end
		end
		table.clear(hiddenParts)
		return
	end
	local function hideModel(model)
		for _, d in model:GetDescendants() do
			if (d:IsA("BasePart") or d:IsA("Decal")) and not hiddenParts[d] then
				hiddenParts[d] = true
				d.LocalTransparencyModifier = 1
			end
		end
	end
	for _, other in Players:GetPlayers() do
		if other.Character then
			hideModel(other.Character)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		hideModel(bots)
	end
end

---------------------------------------------------------------------------
-- Composición
---------------------------------------------------------------------------

local function applyLayout()
	phone = C.Breakpoint() == "PHONE"
	local width = flow.Root and flow.Root:GetAttribute("VirtualWidth") or 1280
	local margin = phone and 16 or 32
	header.Layout(phone)
	header.Frame.Position = UDim2.fromOffset(margin, phone and 10 or 22)
	score.Layout(phone)
	score.Frame.AnchorPoint = Vector2.new(1, 0)
	score.Frame.Position = UDim2.new(1, -margin, 0, phone and 12 or 30)
	rewards.Layout(phone)
	rewards.Frame.AnchorPoint = Vector2.new(1, 0)
	rewards.Frame.Position = UDim2.new(1, -margin, 0, phone and 104 or 160)
	offer.Layout(phone)
	offer.Frame.AnchorPoint = Vector2.new(1, 0)
	offer.Frame.Position = UDim2.new(1, -margin, 0, phone and 202 or 284)
	actions.Layout(phone)
	actions.Frame.AnchorPoint = Vector2.new(0.5, 1)
	actions.Frame.Position = UDim2.new(0.5, 0, 1, phone and -10 or -14)
	actions.Frame.Size = UDim2.new(1, -margin * 2, 0, phone and 56 or 64)
	-- Paneles de abajo (nivel, desafíos, desbloqueo): en el teléfono solo el nivel, a la izquierda
	local panelWidth = math.min(380, math.floor((width - margin * 2 - 24) / 3))
	xp.Layout(phone)
	for _, panel in { xp, challenges, unlock } do
		panel.Frame.Size = UDim2.fromOffset(phone and 300 or panelWidth, phone and 78 or 96)
	end
	bottomRow.Position = UDim2.new(0.5, 0, 1, phone and -76 or -90)
	bottomRow.Size = UDim2.new(1, -margin * 2, 0, phone and 78 or 96)
	-- Tarjetas: todas en escritorio y tableta; en el teléfono solo la del MVP
	cardsRow.Position = UDim2.new(0.5, 0, 1, phone and -76 or -198)
	cardsRow.Size = UDim2.new(1, -margin * 2, 0, 112)
	for _, card in cardsRow:GetChildren() do
		if card:IsA("GuiObject") and card.Name == "PlayerCard" then
			card.Visible = not phone
			card.Size = UDim2.fromOffset(width < 1150 and 150 or 176, 80)
		end
	end
	if phone then
		-- (el nivel a la izquierda de la tarjeta del MVP; desafíos y desbloqueo, solo en pantallas grandes)
		challenges.Frame.Visible = false
		unlock.Frame.Visible = false
	end
	scoreboard.Layout(phone)
end

local function clearCards()
	for _, child in cardsRow:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	mvpCard = nil
end

local function buildCards()
	clearCards()
	local lineup = view.Lineup
	for order, index in CARD_ORDER do
		local entry = lineup[index]
		if entry then
			if index == 1 then
				mvpCard = MVPCard.new(cardsRow, { Entry = entry, IsMVP = view.FeaturedIsMVP, Me = entry.Id == view.Me.Id, Order = order })
				mvpCard.Frame.Visible = false
			else
				local card = PlayerResultCard.new(cardsRow, { Rank = index, Entry = entry, Me = entry.Id == view.Me.Id, Order = order })
				card.Frame.Visible = false
			end
		end
	end
end

---------------------------------------------------------------------------
-- Secuencia
---------------------------------------------------------------------------

-- Recompensas, nivel, desafíos y desbloqueo (cuando ya ha llegado el resumen)
local function playSummary(token)
	if summaryShown or not summary then
		return
	end
	summaryShown = true
	rewards.Set(Data.Rewards(summary), summary)
	xp.Set(Data.LevelSteps(summary))
	challenges.Set(summary.Challenges)
	unlock.Set(summary.Unlocks)
	-- (cada panel aparece con su animación: antes se veía entero, encogía y volvía a crecer)
	local showXp = xp.Frame.Visible
	local showChallenges = challenges.Frame.Visible and not phone
	local showUnlock = unlock.Frame.Visible and not phone
	xp.Frame.Visible, challenges.Frame.Visible, unlock.Frame.Visible = false, false, false
	if rewards.Frame.Visible then
		Transition.SlideIn(rewards.Frame, Vector2.new(60, 0), 0.3)
		rewards.Play(token)
	end
	task.delay(0.35, function()
		if not Anim.Alive(token) then
			return
		end
		if showXp then
			xp.Frame.Visible = true
			Transition.Pop(xp.Frame, 0.9, 0.22)
			xp.Play(token)
		end
		task.wait(0.25)
		if not Anim.Alive(token) then
			return
		end
		if showChallenges then
			challenges.Frame.Visible = true
			Transition.Pop(challenges.Frame, 0.9, 0.22)
			challenges.Play(token)
		end
		task.wait(0.3)
		if Anim.Alive(token) and showUnlock then
			unlock.Frame.Visible = true
			unlock.Play(token)
		end
		-- Oferta pequeña (de vez en cuando, por lo que hiciste en la partida; se quita con ✕)
		task.wait(1)
		if Anim.Alive(token) and flow.State == "Results" then
			local data = ClientState.Data
			offer.Show(Data.PostMatchOffer(summary, MonetizationConfig.PostMatchOffer, Catalog.StoreItems({ "Skin" }), function(kind, id)
				return data ~= nil and Catalog.Owns(data, kind, id)
			end))
		end
	end)
end

local function at(token, time, fn)
	task.delay(time, function()
		if Anim.Alive(token) and flow.State == "Results" then
			fn()
		end
	end)
end

function Results.Open(result)
	local built = Data.Build(result)
	if not built then
		return false
	end
	view = built
	-- (el resumen llega justo después del resultado; uno guardado de hace rato es de otra partida)
	summary = (pendingSummary and os.clock() - pendingSummary.At < 6) and pendingSummary.Data or nil
	pendingSummary = nil
	flow.SetState("Results", { View = built })
	return true
end

function Results.Build(flowController, root)
	flow = flowController
	screen = C.new("Frame", { Name = "Results", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })
	-- Degradados arriba y abajo: el texto se lee sobre cualquier mapa sin tapar a los personajes
	for _, spec in { { 0, 0.32, 0 }, { 1, 0.42, 180 } } do
		C.new("Frame", { Name = "Shade", BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, AnchorPoint = Vector2.new(0, spec[1]), Position = UDim2.fromScale(0, spec[1]), Size = UDim2.fromScale(1, spec[2]), Parent = screen }, {
			C.new("UIGradient", { Rotation = 90 + spec[3], Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) }) }),
		})
	end
	header = ResultHeader.new(screen)
	score = ScoreDisplay.new(screen)
	rewards = RewardsPanel.new(screen)
	offer = OfferCard.new(screen, {
		OnView = function(current)
			-- (mirándola no se pasa sola a la siguiente partida)
			autoAdvance = false
			actions.SetCountdown(nil)
			local ok, Store = pcall(require, script.Parent.Store)
			if ok and Store.Preview and current then
				Store.Preview(current.Item, { Weapon = current.Weapon })
			end
		end,
	})
	cardsRow = C.new("Frame", { Name = "Cards", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 1), Size = UDim2.new(1, -64, 0, 112), Parent = screen }, {
		C.new("UIListLayout", {
			Padding = UDim.new(0, 8),
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	bottomRow = C.new("Frame", { Name = "Bottom", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 1), Parent = screen }, {
		C.new("UIListLayout", {
			Padding = UDim.new(0, 12),
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Left,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	xp = XPProgress.new(bottomRow)
	xp.Frame.LayoutOrder = 1
	challenges = ChallengeProgress.new(bottomRow)
	challenges.Frame.LayoutOrder = 2
	unlock = UnlockCard.new(bottomRow)
	unlock.Frame.LayoutOrder = 3
	actions = ResultActions.new(screen, {
		OnScoreboard = function()
			scoreboard.Open()
		end,
		OnLobby = function()
			flow.ReturnToLobby()
		end,
		OnPlay = function()
			flow.Requeue()
		end,
		OnCancelAuto = function()
			autoAdvance = false
			actions.SetCountdown(nil)
		end,
	})
	-- El marcador completo va encima de todo lo demás
	scoreboard = ScoreboardPanel.new(screen)
	scoreboard.Frame.ZIndex = 50
	-- Esc / B: cierra el marcador
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or flow.State ~= "Results" then
			return
		end
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			scoreboard.Close()
		elseif input.KeyCode == Enum.KeyCode.Tab or input.KeyCode == Enum.KeyCode.ButtonY then
			scoreboard.Open()
		elseif input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.ButtonA then
			flow.Requeue()
		end
	end)
	-- Datos del servidor: el resultado abre la pantalla; el resumen personal llega justo después
	ClientState.ResultsScreen = true
	Remotes.RoundEnd.OnClientEvent:Connect(function(info)
		if type(info) ~= "table" or type(info.Result) ~= "table" then
			return
		end
		-- (solo a quien estaba jugando: en el lobby o en plena presentación no se interrumpe)
		if flow.State == "Gameplay" or flow.State == "Deploy" then
			Results.Open(info.Result)
		end
	end)
	Remotes.MatchSummary.OnClientEvent:Connect(function(data)
		if type(data) ~= "table" then
			return
		end
		if flow.State == "Results" and not summaryShown then
			summary = data
			if Results.ReadyForSummary then
				playSummary(Anim.Token)
			end
		else
			pendingSummary = { Data = data, At = os.clock() }
		end
	end)
	Results.Screen = screen
end

-- Fundido de entrada: si se sale antes de que se abra (0,25 s), Hide lo quita (si no, se quedaba
-- la pantalla en negro)
local fadeFrame = nil

function Results.Show(ctx)
	view = ctx.View or view
	if not view then
		-- (sin datos: a la partida como siempre, con su cámara y avisando al servidor; fuera de este
		-- SetState para que los cambios de pantalla salgan en orden)
		task.defer(flow.EnterGameplay)
		return
	end
	Anim.Token += 1
	local token = Anim.Token
	summaryShown = false
	Results.ReadyForSummary = false
	autoAdvance = true
	ClientState.ResultsActive = true
	-- Siguiente partida: la pantalla final dura EndScreenTime; luego el descanso con la votación
	local endedAt = flow.EndedAt or os.clock()
	local screenLeft = math.max(0, (GameConfig.EndScreenTime or 8) - (os.clock() - endedAt))
	nextAt = os.clock() + screenLeft
	-- 0,0: fundido corto (el HUD ya se ha ido al cambiar de estado)
	flow.SetBackdrop(0, 0.01)
	Transition.Blur(0, 0.15)
	if fadeFrame then
		fadeFrame:Destroy()
	end
	local fade = Instance.new("Frame")
	fadeFrame = fade
	fade.Name = "ResultsFade"
	fade.BackgroundColor3 = Colors.Bg
	fade.BackgroundTransparency = 1
	fade.BorderSizePixel = 0
	fade.Size = UDim2.fromScale(1, 1)
	fade.ZIndex = 60
	fade.Parent = flow.Guis.FX and flow.Guis.FX:FindFirstChild("Layer") or screen
	Transition.Tween(fade, 0.22, { BackgroundTransparency = 0 })
	-- Componentes con los datos (ocultos hasta su momento)
	screen.Visible = true
	header.Set(view)
	header.Frame.Visible = false
	score.Set(view)
	score.Frame.Visible = false
	rewards.Frame.Visible = false
	xp.Frame.Visible = false
	challenges.Frame.Visible = false
	unlock.Frame.Visible = false
	actions.Frame.Visible = false
	actions.SetCountdown(screenLeft + (GameConfig.IntermissionTime or 20))
	scoreboard.Set(view)
	scoreboard.Close()
	buildCards()
	applyLayout()
	-- 0,25: escena 3D montada a oscuras, cámara puesta, y se abre
	at(token, 0.25, function()
		hideWorldCharacters(true)
		stage = Stage.new()
		stage:SetMap(view.Map)
		stage:SetResult(view)
		stage:SetPlayers(view.Lineup)
		stage:SetMVP(view.Featured and view.Featured.Id)
		stage:SetScore(view.MyScore, view.EnemyScore)
		local ok, err = pcall(stage.Build, stage)
		if not ok then
			warn("[Results] escena: " .. tostring(err))
		end
		local targets = stage:CameraTargets()
		if targets then
			Camera.Start(targets, workspace.CurrentCamera)
			flow.SetCamera("Scripted", Camera.Step)
		end
		Transition.Tween(fade, 0.4, { BackgroundTransparency = 1 })
		task.delay(0.45, function()
			fade:Destroy()
			if fadeFrame == fade then
				fadeFrame = nil
			end
		end)
	end)
	-- Respiración de los personajes, cuenta atrás y personajes del mundo ocultos (solo mientras se ve)
	if stepConnection then
		stepConnection:Disconnect()
	end
	local lastSweep = 0
	stepConnection = RunService.RenderStepped:Connect(function()
		if flow.State ~= "Results" then
			return
		end
		if stage then
			stage:Step(os.clock())
		end
		if os.clock() - lastSweep > 0.5 then
			lastSweep = os.clock()
			hideWorldCharacters(true)
			if autoAdvance and actions.Frame.Visible then
				local left = nextAt - os.clock()
				actions.SetCountdown(math.max(0, left) + (left > 0 and (GameConfig.IntermissionTime or 20) or 0))
			end
		end
	end)
	-- 0,8: VICTORIA / DERROTA
	at(token, 0.8, function()
		header.Play()
		if view.Outcome == "Victory" then
			UISound.Play("Victory")
			task.delay(0.08, function()
				UISound.Play("VictorySting")
			end)
			Transition.Flash(Color3.fromRGB(200, 225, 255), 0.25, 0.35)
		elseif view.Outcome == "Defeat" then
			UISound.Play("Defeat")
		else
			UISound.Play("Whoosh")
		end
	end)
	-- 1,3: marcador
	at(token, 1.3, function()
		score.Frame.Visible = true
		score.Play(token)
	end)
	-- 1,7: compañeros
	at(token, 1.7, function()
		local i = 0
		for _, card in cardsRow:GetChildren() do
			if card:IsA("GuiObject") and card.Name == "PlayerCard" and not phone then
				i += 1
				-- (están en una lista: entran con un salto, una tras otra)
				task.delay(i * 0.06, function()
					if Anim.Alive(token) then
						card.Visible = true
						Transition.Pop(card, 0.8, 0.22)
					end
				end)
			end
		end
	end)
	-- 2,2: MVP
	at(token, 2.2, function()
		if mvpCard then
			mvpCard.Frame.Visible = true
			mvpCard.Highlight(token)
		end
		if stage then
			stage:HighlightMVP()
		end
		Camera.SetPreset("MVP")
	end)
	-- 2,8: recompensas (si el resumen ya llegó; si no, en cuanto llegue)
	at(token, 2.8, function()
		Results.ReadyForSummary = true
		playSummary(token)
	end)
	-- 3,0: acciones
	at(token, 3.0, function()
		actions.Show()
	end)
	-- 6,0: la cámara pasa a una deriva lenta
	at(token, 6.0, function()
		Camera.SetPreset("Drift")
	end)
end

function Results.Hide()
	Anim.Token += 1
	ClientState.ResultsActive = false
	Results.ReadyForSummary = false
	if stepConnection then
		stepConnection:Disconnect()
		stepConnection = nil
	end
	Camera.Stop()
	if fadeFrame then
		fadeFrame:Destroy()
		fadeFrame = nil
	end
	if stage then
		stage:Destroy()
		stage = nil
	end
	hideWorldCharacters(false)
	clearCards()
	scoreboard.Close()
	offer.Show(nil)
	pcall(function()
		require(Flow.Store.Inspect).Close()
	end)
	screen.Visible = false
	view = nil
	summary = nil
end

-- (para las pruebas)
Results.Data = Data
function Results.AutoAdvance()
	return autoAdvance
end

local _ = player
return Results
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="192">
                <Properties>
                  <string name="Name">Squad</string>
                  <string name="Source"><![CDATA[-- ESCUADRA (party): tu personaje delante y los compañeros reales de tu equipo alrededor (hasta 5),
-- cada uno con su nombre, nivel, estado (listo, en el menú, en partida) y el líder (el primero que
-- llegó al servidor). Los amigos que estén en el servidor van en tu equipo (lo hace el servidor) y
-- salen primero. Cuando entra alguien su hueco pasa de vacío a ocupado con una animación corta; si
-- se va, se desvanece. Los huecos libres se rellenan con bots al empezar la partida.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Icons = require(Shared.Icons)

local Flow = script.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Transition = require(Flow.Transition)
local UISound = require(Flow.UISound)
local Preview = require(Flow.Preview)

local player = Players.LocalPlayer
local Colors = Theme.Colors

local Squad = {}

local flow, screen, preview, cardsRow, toast, title
local cards = {} -- [hueco] = api de la tarjeta
local filling = false -- (al abrir la pantalla se rellena sin avisar de "se ha unido")
local shown = {} -- [hueco] = jugador que se ve
local SLOT_ORDER = { "s4", "s2", "me", "s3", "s5" } -- (de izquierda a derecha en pantalla)

-- Compañeros: tu equipo (o, sin equipos, tus amigos y los demás), tú primero, luego amigos
local function members()
	local list = {}
	for _, other in Players:GetPlayers() do
		if other ~= player and (player.Team == nil or other.Team == player.Team) then
			table.insert(list, other)
		end
	end
	table.sort(list, function(a, b)
		local fa, fb = player:IsFriendsWith(a.UserId), player:IsFriendsWith(b.UserId)
		if fa ~= fb then
			return fa
		end
		return (a:GetAttribute("JoinOrder") or 0) < (b:GetAttribute("JoinOrder") or 0)
	end)
	local squad = { player }
	for i = 1, math.min(#list, 4) do
		table.insert(squad, list[i])
	end
	return squad
end

local function statusOf(member)
	if member:GetAttribute("Ready") then
		return "Ready"
	elseif member:GetAttribute("InMenu") then
		return "NotReady"
	end
	return "InMatch"
end

local function leaderOf(squad)
	local best, order = nil, math.huge
	for _, member in squad do
		local o = member:GetAttribute("JoinOrder") or math.huge
		if o < order then
			best, order = member, o
		end
	end
	return best
end

local function levelOf(member)
	local stats = member:FindFirstChild("leaderstats")
	local level = stats and stats:FindFirstChild("Nivel")
	return level and level.Value or nil
end

local function showToast(text)
	toast.Text = text
	toast.Visible = true
	toast.TextTransparency = 0
	Transition.Pop(toast, 0.85, 0.15)
	task.delay(1.1, function()
		Transition.Tween(toast, 0.25, { TextTransparency = 1 })
	end)
end

function Squad.Refresh()
	if not screen or not screen.Visible then
		return
	end
	local squad = members()
	local leader = leaderOf(squad)
	local bySlot = { me = squad[1], s2 = squad[2], s3 = squad[3], s4 = squad[4], s5 = squad[5] }
	for _, slot in SLOT_ORDER do
		local member = bySlot[slot]
		local card = cards[slot]
		if member ~= shown[slot] then
			local previous = shown[slot]
			shown[slot] = member
			if member then
				preview:SetCharacter(slot, member)
				preview:SetAnimation(slot, "SquadIdle")
				if previous == nil and member ~= player and not filling then
					-- Entra alguien: su tarjeta aparece y se avisa
					UISound.Play("Join")
					Transition.Pop(card.Frame, 0.8, 0.2)
					showToast("👤 " .. C.upper(member.DisplayName) .. " SE HA UNIDO")
				end
			else
				preview:SetCharacter(slot, nil)
			end
		end
		if member then
			card:Update({
				Name = member.DisplayName,
				Level = levelOf(member),
				Status = statusOf(member),
				Leader = member == leader and #squad > 1,
				Me = member == player,
				Card = member:GetAttribute("Card"),
			})
			card.Frame.BackgroundTransparency = Theme.PanelAlpha
		else
			card:Update({ Name = "HUECO LIBRE", Status = "Bot", Level = nil })
			card.Frame.BackgroundTransparency = 0.6
		end
	end
	local ready = 0
	for _, member in squad do
		if member:GetAttribute("Ready") then
			ready += 1
		end
	end
	title.Text = string.format("ESCUADRA  ·  %d/5", #squad)
	Squad.ReadyCount = ready
end

function Squad.Build(flowController, root)
	flow = flowController
	screen = C.new("Frame", { Name = "Squad", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })
	preview = Preview.new(screen, { Name = "SquadPreview", Anchor = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -90), Size = UDim2.new(1, -40, 1, -150), Camera = "Squad" })
	title = C.text({ Text = "ESCUADRA", Role = "TitleItalic", TextSize = 44, Position = UDim2.fromOffset(28, 18), Size = UDim2.fromOffset(600, 50), Stroke = 2, Parent = screen })
	C.text({ Text = "Tu equipo en este servidor · los amigos juegan contigo · los huecos libres se llenan con bots", Role = "BodyBold", TextSize = 14, Color = Colors.TextDim, Position = UDim2.fromOffset(30, 68), Size = UDim2.new(1, -60, 0, 20), Parent = screen })
	cardsRow = C.new("Frame", {
		Name = "Cards",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -96),
		Size = UDim2.fromOffset(5 * 178, 62),
		Parent = screen,
	}, { C.list(8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center) })
	for i, slot in SLOT_ORDER do
		cards[slot] = C.playerCard({ Size = UDim2.fromOffset(170, 62), Order = i, Parent = cardsRow }, { Name = "", Status = "Bot" })
	end
	toast = C.text({ Name = "Toast", Text = "", Role = "TitleItalic", TextSize = 22, Color = Colors.YellowText, AlignX = Enum.TextXAlignment.Center, Anchor = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 96), Size = UDim2.fromOffset(600, 30), Stroke = 2, Parent = screen })
	toast.Visible = false
	-- Botones: JUGAR, invitar y volver
	local actions = C.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(760, 64),
		Parent = screen,
	}, { C.list(12, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center) })
	C.button({ Text = "VOLVER", Icon = "‹", Style = "Ghost", TextSize = 20, Size = UDim2.fromOffset(170, 56), Order = 1, Parent = actions, Sound = "Back", OnClick = function()
		flow.SetState("Home")
	end })
	C.button({ Text = "JUGAR", Icon = "▶", Sub = "PARTIDA 5 VS 5", Style = "Primary", TextSize = 30, Size = UDim2.fromOffset(300, 64), Order = 2, Parent = actions, OnClick = function()
		flow.Play()
	end })
	C.button({ Text = "INVITAR", Icon = Icons.Mail, Style = "Ghost", TextSize = 20, Size = UDim2.fromOffset(170, 56), Order = 3, Parent = actions, OnClick = function()
		local Home = flow.Screens.Home
		if Home and Home.OpenClan then
			flow.SetState("Home")
			Home.OpenClan()
		end
	end })
	-- Cambios en la escuadra: entra o sale alguien, cambia de equipo o de estado
	local function watch(other)
		for _, attr in { "Ready", "InMenu", "JoinOrder" } do
			other:GetAttributeChangedSignal(attr):Connect(Squad.Refresh)
		end
		other:GetPropertyChangedSignal("Team"):Connect(Squad.Refresh)
		other.CharacterAdded:Connect(function()
			task.wait(1)
			if shown.me == other or table.find({ shown.s2, shown.s3, shown.s4, shown.s5 }, other) then
				-- (personaje nuevo: se vuelve a copiar)
				for slot, member in shown do
					if member == other then
						shown[slot] = nil
					end
				end
				Squad.Refresh()
			end
		end)
	end
	for _, other in Players:GetPlayers() do
		watch(other)
	end
	Players.PlayerAdded:Connect(function(other)
		watch(other)
		task.wait(0.5)
		Squad.Refresh()
	end)
	Players.PlayerRemoving:Connect(function()
		task.defer(Squad.Refresh)
	end)
	local _ = GameConfig
end

function Squad.Show()
	flow.SetCamera("Orbit")
	flow.SetBackdrop(0.55)
	Transition.Blur(14, 0.25)
	screen.Visible = true
	table.clear(shown)
	preview:Clear()
	preview:SetActive(true)
	filling = true
	Squad.Refresh()
	filling = false
	Transition.SlideIn(cardsRow, Vector2.new(0, 40), 0.3)
	Transition.Pop(preview.Viewport, 0.95, 0.25)
end

function Squad.Hide()
	preview:SetActive(false)
	-- (las copias de los personajes no se guardan ocultas: se rehacen al volver)
	preview:Clear()
	table.clear(shown)
	screen.Visible = false
end

return Squad
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="193">
                <Properties>
                  <string name="Name">Store</string>
                  <string name="Source"><![CDATA[-- TIENDA: DESTACADO (evento, pack de la semana, pack de inicio y tienda diaria con su reloj real),
-- ARMAS, OPERADORES, CHARMS, EFECTOS, POSES, PACKS, PASE y MONEDAS. Cada objeto con su imagen
-- grande, rareza, precio a la vista, PREVISUALIZAR (3D) y COMPRAR. Lo que ya tienes sale como TUYO /
-- EQUIPADO, nunca como nuevo. Sin ventanas que salten, sin relojes falsos, sin azar.
-- Robux: ventana nativa de Roblox. Monedas: confirmación propia. Lo entrega siempre el servidor.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Icons = require(Shared.Icons)
local Shop = require(Shared.Shop)
local Catalog = require(Shared.Economy.CosmeticCatalog)
local Products = require(Shared.Economy.Products)
local StoreRotation = require(Shared.Economy.StoreRotation)
local MonetizationConfig = require(Shared.Economy.MonetizationConfig)

local Modules = script.Parent.Parent.Parent
local ClientState = require(Modules.ClientState)

local Flow = script.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Transition = require(Flow.Transition)
local UISound = require(Flow.UISound)
local StoreFolder = Flow.Store
local StoreData = require(StoreFolder.StoreData)
local ItemArt = require(StoreFolder.ItemArt)
local ItemCard = require(StoreFolder.ItemCard)
local Inspect = require(StoreFolder.Inspect)
local Confirm = require(StoreFolder.Confirm)
local Reveal = require(StoreFolder.Reveal)

local player = Players.LocalPlayer
local Colors = Theme.Colors
local DARK = Color3.fromRGB(16, 14, 8)

local Store = {}

local flow, rootFrame, screen, content, tabsRow, coinsLabel, toastLabel, bonusLine, titleLabel
local tabs = {}
local cards = {} -- ItemCard de la pestaña actual (se refrescan sin rehacer)
local refreshers = {} -- otras tarjetas (packs, monedas) que se refrescan
local timers = {} -- { Label, EndsAt, Prefix, Rebuild }
local tab = "FEATURED"
local shownOnce: { [string]: boolean } = {} -- analítica: una vez por visita

local function isPhone()
	return C.Breakpoint() == "PHONE"
end

local function toast(text, color)
	toastLabel.Text = text
	toastLabel.TextColor3 = color or Colors.White
	toastLabel.Visible = true
	local stamp = os.clock()
	toastLabel:SetAttribute("Stamp", stamp)
	task.delay(2.2, function()
		if toastLabel:GetAttribute("Stamp") == stamp then
			toastLabel.Visible = false
		end
	end)
end
Store.Toast = toast

---------------------------------------------------------------------------
-- Acciones
---------------------------------------------------------------------------

local function buyRobux(what)
	local ok, reason = StoreData.PromptRobux(what)
	if not ok then
		UISound.Play("Error")
		toast(reason or "No disponible", Colors.TextDim)
	end
end

local function onBuy(item)
	if item.Robux then
		buyRobux({ Type = "Item", Item = item })
		return
	end
	Confirm.Open(rootFrame, item, function()
		local ok, message = StoreData.BuyWithCoins(item)
		if not ok then
			UISound.Play("Error")
			toast(C.upper(tostring(message or "No se pudo comprar")), Colors.Red)
		end
	end, function()
		Store.SelectTab("COINS")
	end)
end

local function onEquip(item)
	StoreData.Equip(item.Kind, item.Id)
	UISound.Play("Equip")
	toast("✓ " .. C.upper(item.Name) .. " EQUIPADO", Colors.Green)
end

local function onPreview(item)
	Inspect.Open(rootFrame, item, { OnBuy = onBuy, OnEquip = onEquip })
end

local callbacks = { OnBuy = onBuy, OnEquip = onEquip, OnPreview = onPreview }

-- Para otras pantallas (la oferta de la pantalla final): previsualizar con COMPRAR y EQUIPAR
function Store.Preview(item, opts)
	Inspect.Open(rootFrame, item, { OnBuy = onBuy, OnEquip = onEquip }, opts)
end
Store.Buy = onBuy
Store.Equip = onEquip

---------------------------------------------------------------------------
-- Piezas de la página
---------------------------------------------------------------------------

local order = 0
local function nextOrder()
	order += 1
	return order
end

local function section(text, timerEndsAt, timerPrefix)
	local row = C.new("Frame", { Name = "Section", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = nextOrder(), Parent = content })
	C.text({ Text = text, Role = "TitleItalic", TextSize = 24, Color = Colors.YellowText, Scaled = true, Size = UDim2.new(0.6, 0, 1, 0), Parent = row })
	if timerEndsAt then
		local label = C.text({ Name = "Timer", Text = "", Role = "Number", TextSize = 16, Color = Colors.TextDim, AlignX = Enum.TextXAlignment.Right, Position = UDim2.fromScale(0.4, 0), Size = UDim2.new(0.6, 0, 1, 0), Parent = row })
		table.insert(timers, { Label = label, EndsAt = timerEndsAt, Prefix = timerPrefix or "CAMBIA EN " })
	end
	return row
end

-- Cuadrícula con su alto calculado (filas que caben en el ancho de la pantalla)
local function grid(cell)
	local size = cell or (isPhone() and ItemCard.Size.PHONE or ItemCard.Size.DESKTOP)
	local frame = C.new("Frame", { Name = "Grid", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, size.Y), LayoutOrder = nextOrder(), Parent = content }, {
		C.new("UIGridLayout", { CellSize = UDim2.fromOffset(size.X, size.Y), CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	frame:SetAttribute("CellX", size.X)
	frame:SetAttribute("CellY", size.Y)
	return frame
end

local function fitGrid(frame, count)
	local width = (flow.Root and tonumber(flow.Root:GetAttribute("VirtualWidth")) or 1280) - 48 - 10
	local cellX, cellY = frame:GetAttribute("CellX") or 200, frame:GetAttribute("CellY") or 200
	local perRow = math.max(1, math.floor((width + 12) / (cellX + 12)))
	local rows = math.max(1, math.ceil(count / perRow))
	frame.Size = UDim2.new(1, 0, 0, rows * cellY + (rows - 1) * 12)
end

local function addCards(parent, items)
	fitGrid(parent, #items)
	local keys = {}
	for i, item in items do
		local card = ItemCard.new(parent, item, callbacks, { Phone = isPhone(), Order = i })
		table.insert(cards, card)
		table.insert(keys, item.Key)
	end
	-- (se han visto: la próxima vez ya no son NUEVO)
	StoreData.MarkSeen(keys)
end

-- Tarjeta ancha de un pack (o del pack de inicio): lo que trae, lo que ya tienes, el precio y lo
-- que vale por separado (solo si la cuenta es real)
local function bundleCard(bundle, opts)
	opts = opts or {}
	local phone = isPhone()
	local data = ClientState.Data
	local starter = opts.Starter == true
	local colors = bundle.Colors or { Colors.Yellow, Colors.RedDark }
	local card = C.panel({ Name = "Bundle_" .. tostring(bundle.Id or "Starter"), Size = UDim2.new(1, 0, 0, phone and 196 or 214), Order = nextOrder(), Parent = content }, { Alpha = 0.05, StrokeColor = colors[1], StrokeAlpha = 0.35 })
	C.new("Frame", { Name = "Band", BackgroundColor3 = colors[1], BorderSizePixel = 0, Size = UDim2.new(0, phone and 150 or 210, 1, 0), Parent = card }, {
		C.corner(4),
		C.new("UIGradient", { Rotation = 35, Color = ColorSequence.new(colors[1], colors[2] or colors[1]) }),
	})
	C.text({ Text = bundle.Icon or Icons.Crate, TextSize = 54, AlignX = Enum.TextXAlignment.Center, Scaled = true, Position = UDim2.fromOffset(10, 14), Size = UDim2.fromOffset(phone and 130 or 190, phone and 60 or 76), Parent = card })
	C.text({ Text = C.upper(bundle.Name or "PACK DE INICIO"), Role = "TitleItalic", TextSize = 22, Color = Colors.White, Stroke = 1, Wrap = true, Scaled = true, AlignX = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(10, phone and 80 or 96), Size = UDim2.fromOffset(phone and 130 or 190, phone and 50 or 56), Parent = card })
	if opts.Tag then
		C.text({ Text = opts.Tag, Role = "Title", TextSize = 13, Color = Colors.White, AlignX = Enum.TextXAlignment.Center, Position = UDim2.new(0, 10, 1, -30), Size = UDim2.fromOffset(phone and 130 or 190, 18), Parent = card })
	end
	-- Lo que trae
	local left = phone and 162 or 226
	local list = Products.BundleItems(bundle)
	local row = C.new("ScrollingFrame", { Name = "Items", BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(left, 12), Size = UDim2.new(1, -(left + (phone and 168 or 250)), 0, phone and 112 or 128), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollingDirection = Enum.ScrollingDirection.X, ScrollBarThickness = 3, Parent = card }, {
		C.list(8, Enum.FillDirection.Horizontal),
	})
	local cell = phone and 96 or 112
	local isVIP = StoreData.IsVIP()
	for i, entry in list do
		local item = Catalog.Item(entry.Kind, entry.Id)
		if item then
			local holder = C.new("Frame", { Name = "B_" .. item.Key, BackgroundTransparency = 1, Size = UDim2.fromOffset(cell, cell), LayoutOrder = i, Parent = row })
			ItemArt.Thumb(holder, item, { Size = UDim2.fromScale(1, 1) })
			local owned = data and Catalog.Owns(data, item.Kind, item.Id, isVIP)
			if owned then
				local shade = C.new("Frame", { Name = "Owned", BackgroundColor3 = Colors.Black, BackgroundTransparency = 0.45, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 3, Parent = holder }, { C.corner(4) })
				C.text({ Text = "✓ TUYO", Role = "Title", TextSize = 15, Color = Colors.Green, AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = shade })
			end
			local click = C.new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = holder })
			click.Activated:Connect(function()
				onPreview(item)
			end)
		end
	end
	if (bundle.Coins or 0) > 0 then
		local holder = C.new("Frame", { Name = "B_Coins", BackgroundTransparency = 1, Size = UDim2.fromOffset(cell, cell), LayoutOrder = 99, Parent = row })
		local art = ItemArt.Backdrop(holder, "Legendario", { Size = UDim2.fromScale(1, 1) })
		C.text({ Text = "💰", TextSize = 40, AlignX = Enum.TextXAlignment.Center, Scaled = true, Position = UDim2.fromScale(0.2, 0.08), Size = UDim2.fromScale(0.6, 0.55), Parent = art })
		C.text({ Text = tostring(bundle.Coins), Role = "Number", TextSize = 20, Color = Colors.White, AlignX = Enum.TextXAlignment.Center, Position = UDim2.fromScale(0, 0.66), Size = UDim2.fromScale(1, 0.26), Parent = art })
	end
	-- Lo que ya tienes y lo que vale por separado (cuentas reales)
	local status = data and Catalog.BundleStatus(data, bundle, isVIP) or { Owned = 0, Total = #list, Compensation = 0, Missing = list }
	local value = Catalog.BundleValue(bundle)
	local lines = {}
	if value.Complete and value.Robux > 0 and value.Coins == (bundle.Coins or 0) and value.Robux > (bundle.Robux or 0) then
		local saving = math.floor((1 - bundle.Robux / value.Robux) * 100 + 0.5)
		table.insert(lines, string.format("Por separado: <s>R$ %d</s>  ·  <font color=\"#6EE06E\">-%d%%</font>", value.Robux, saving))
	elseif value.Complete and value.Coins > 0 and value.Robux == 0 then
		table.insert(lines, string.format("Lo que trae vale 💰 %d en la tienda", value.Coins))
	end
	if status.Owned > 0 and status.Owned < status.Total then
		table.insert(lines, string.format("Ya tienes %d de %d: te devolvemos 💰 %d", status.Owned, status.Total, status.Compensation))
	end
	C.text({ Name = "Value", Text = table.concat(lines, "\n"), Rich = true, Role = "Body", TextSize = 13, Color = Colors.TextDim, Wrap = true, AlignY = Enum.TextYAlignment.Top, Position = UDim2.new(0, left, 1, phone and -64 or -70), Size = UDim2.new(1, -(left + (phone and 168 or 250)), 0, 56), Parent = card })
	-- Precio y botones
	local right = C.new("Frame", { Name = "Buy", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), Size = UDim2.new(0, phone and 150 or 230, 1, -24), Parent = card })
	local robux = StoreData.Robux({ ProductId = bundle.ProductId, Robux = bundle.Robux })
	C.text({ Name = "Price", Text = "R$ " .. tostring(robux), Role = "Number", TextSize = phone and 26 or 34, Color = Colors.Green, AlignX = Enum.TextXAlignment.Right, Size = UDim2.new(1, 0, 0, phone and 32 or 42), Parent = right })
	local timerLabel
	if opts.EndsAt then
		timerLabel = C.text({ Name = "Timer", Text = "", Role = "Number", TextSize = 13, Color = Colors.TextDim, AlignX = Enum.TextXAlignment.Right, Scaled = true, Position = UDim2.fromOffset(0, phone and 32 or 44), Size = UDim2.new(1, 0, 0, 18), Parent = right })
		table.insert(timers, { Label = timerLabel, EndsAt = opts.EndsAt, Prefix = opts.TimerPrefix or "CAMBIA EN " })
	end
	local action = C.button({ Name = "Action", Text = "COMPRAR", Style = "Primary", TextSize = phone and 17 or 20, Anchor = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, phone and 44 or 52), Parent = right, Sound = "Click", OnClick = function()
		if status.Owned >= status.Total and status.Total > 0 then
			return
		end
		StoreData.Track(starter and "starter_pack_view" or "bundle_view", { bundle = tostring(bundle.Id or "Starter") })
		buyRobux(starter and { Type = "Starter" } or { Type = "Bundle", Bundle = bundle })
	end })
	local label = action:FindFirstChild("Label", true)
	local function refresh()
		local enabled = Products.Enabled(bundle)
		local text, yellow = "COMPRAR", true
		local data2 = ClientState.Data
		local fresh = data2 and Catalog.BundleStatus(data2, bundle, StoreData.IsVIP()) or status
		local owned = (not starter and data2 and type(data2.Bundles) == "table" and data2.Bundles[bundle.Id]) or (starter and data2 and data2.StarterPack)
		if owned or (fresh.Total > 0 and fresh.Owned >= fresh.Total and (bundle.Coins or 0) == 0) then
			text, yellow = "✓ EN TU COLECCIÓN", false
		elseif not enabled then
			text, yellow = "PRÓXIMAMENTE", false
		elseif StoreData.Pending and (StoreData.Pending.Key == "Bundle:" .. tostring(bundle.Id) or (starter and StoreData.Pending.Key == "Starter")) then
			text, yellow = "PROCESANDO…", false
		end
		label.Text = text
		action.BackgroundColor3 = yellow and Colors.Yellow or Colors.PanelLight
		label.TextColor3 = yellow and DARK or (text:find("COLECCIÓN") and Colors.Green or Colors.TextDim)
		local gradient = action:FindFirstChildOfClass("UIGradient")
		if gradient then
			gradient.Enabled = yellow
		end
	end
	refresh()
	table.insert(refreshers, refresh)
	return card
end

-- Tarjeta pequeña de un producto de Robux (monedas, potenciadores)
local function productCard(parent, spec, order2)
	local phone = isPhone()
	local card = C.panel({ Name = "Product_" .. spec.Name, Size = UDim2.fromOffset(phone and 168 or 200, phone and 176 or 196), Order = order2, Parent = parent }, { Alpha = 0.06, StrokeColor = spec.Color or Colors.Yellow, StrokeAlpha = 0.5 })
	C.text({ Text = spec.Icon, TextSize = 40, AlignX = Enum.TextXAlignment.Center, Scaled = true, Position = UDim2.fromOffset(10, 10), Size = UDim2.new(1, -20, 0, 50), Parent = card })
	C.text({ Text = spec.Title, Role = "TitleItalic", TextSize = 24, Color = Colors.White, AlignX = Enum.TextXAlignment.Center, Scaled = true, Position = UDim2.fromOffset(8, 62), Size = UDim2.new(1, -16, 0, 28), Parent = card })
	C.text({ Text = spec.Sub or "", Role = "Body", TextSize = 12, Color = Colors.TextDim, AlignX = Enum.TextXAlignment.Center, Wrap = true, Position = UDim2.fromOffset(8, 92), Size = UDim2.new(1, -16, 0, 32), Parent = card })
	local action = C.button({ Name = "Action", Text = spec.Button, Style = spec.Enabled and "Primary" or "Ghost", TextSize = 18, Anchor = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.new(1, -16, 0, phone and 40 or 44), Parent = card, Sound = "Click", OnClick = function()
		if spec.Enabled and spec.OnClick then
			spec.OnClick()
		end
	end })
	return card, action
end

---------------------------------------------------------------------------
-- Pestañas
---------------------------------------------------------------------------

local function renderFeatured()
	local now = StoreData.Now()
	local event = StoreRotation.ActiveEvent(now)
	if event then
		section("⚠ " .. event.Name, event.EndsAt, "TERMINA EN ")
		local bundle = StoreRotation.BundleById(event.Bundle)
		if bundle then
			bundleCard(bundle, { Tag = "EVENTO", EndsAt = event.EndsAt, TimerPrefix = "TERMINA EN " })
		end
		local items = {}
		for _, key in event.Items do
			local kind, id = Catalog.ParseKey(key)
			local item = kind and Catalog.Item(kind, id, StoreData.Day())
			if item then
				table.insert(items, item)
			end
		end
		addCards(grid(), items)
	end
	local featured = StoreRotation.FeaturedBundle(now)
	if featured and not (event and featured.Id == event.Bundle) then
		section("★ PACK DE LA SEMANA", StoreRotation.WeekEndsAt(now))
		bundleCard(featured, { Tag = "DESTACADO" })
	end
	if StoreData.StarterVisible() then
		section("🎁 PACK DE INICIO · SOLO PARA NUEVOS")
		bundleCard(Shop.StarterPack, { Starter = true, Tag = "UNA SOLA VEZ" })
		if not shownOnce.Starter then
			shownOnce.Starter = true
			StoreData.Track("starter_pack_view", { level = ClientState.Data and ClientState.Data.Level or 1 })
			StoreData.MarkSeen({ "Starter" })
		end
	end
	section("TIENDA DIARIA", StoreRotation.DayEndsAt(now), "NUEVA EN ")
	addCards(grid(), StoreData.Daily())
end

local function renderBundles()
	local now = StoreData.Now()
	section("PACKS")
	for _, bundle in Shop.Bundles do
		local inDates = (bundle.StartsAt == nil or now >= bundle.StartsAt) and (bundle.EndsAt == nil or now < bundle.EndsAt)
		if inDates then
			bundleCard(bundle, { EndsAt = bundle.EndsAt, TimerPrefix = "A LA VENTA " })
		end
	end
	if not shownOnce.Bundles then
		shownOnce.Bundles = true
		StoreData.Track("bundle_view", { tab = "BUNDLES" })
	end
end

local function renderCoins()
	local data = ClientState.Data
	section("MONEDAS")
	local productCell = isPhone() and Vector2.new(168, 176) or Vector2.new(200, 196)
	local packs = grid(productCell)
	fitGrid(packs, #Shop.CoinPacks)
	for i, pack in Shop.CoinPacks do
		productCard(packs, {
			Name = pack.Name,
			Icon = Icons.Coin,
			Title = tostring(pack.Coins),
			Sub = C.upper(pack.Name) .. (pack.Tag and ("  ·  " .. pack.Tag .. " monedas por Robux") or ""),
			Button = Products.Enabled(pack) and ("R$ " .. tostring(StoreData.Robux(pack))) or "PRÓXIMAMENTE",
			Enabled = Products.Enabled(pack),
			OnClick = function()
				buyRobux({ Type = "Coins", Def = pack })
			end,
		}, i)
	end
	section("POTENCIADORES")
	local boosts = grid(productCell)
	fitGrid(boosts, #Shop.Boosters)
	for i, booster in Shop.Boosters do
		local left = data and tonumber(data[booster.Field]) or 0
		productCard(boosts, {
			Name = booster.Id,
			Icon = booster.Icon,
			Title = booster.Name,
			Sub = booster.Minutes .. " min jugando (solo XP o monedas)" .. (left > 0 and ("  ·  te quedan " .. math.ceil(left / 60) .. " min") or ""),
			Button = Products.Enabled(booster) and ("R$ " .. tostring(StoreData.Robux(booster))) or "PRÓXIMAMENTE",
			Enabled = Products.Enabled(booster),
			Color = Colors.Blue,
			OnClick = function()
				buyRobux({ Type = "Booster", Def = booster })
			end,
		}, i)
	end
	section("VIP")
	local vipRow = grid(productCell)
	fitGrid(vipRow, 2)
	local vip = data and data.VIP
	productCard(vipRow, {
		Name = "VIP",
		Icon = Icons.Crown,
		Title = "VIP",
		Sub = "x2 XP y monedas · nombre dorado · grafiti exclusivo · +" .. (MonetizationConfig.Rules.VIPDailyCoins or 0) .. " 💰 al día",
		Button = vip and "✓ YA ERES VIP" or (Shop.VIPPassId ~= 0 and ("R$ " .. tostring(StoreData.Robux({ ProductId = Shop.VIPPassId, Robux = Shop.VIPRobux }, Enum.InfoType.GamePass))) or "PRÓXIMAMENTE"),
		Enabled = not vip and Shop.VIPPassId ~= 0,
		OnClick = function()
			buyRobux({ Type = "VIP" })
		end,
	}, 1)
	local premium = GameConfig.RobloxPremium
	if premium then
		local isPremium = player:GetAttribute("RobloxPremium") == true
		productCard(vipRow, {
			Name = "RobloxPremium",
			Icon = utf8.char(0xE001),
			Title = "PREMIUM",
			Sub = "+" .. math.floor((premium.Multiplier - 1) * 100 + 0.5) .. "% monedas y XP con Roblox Premium",
			Button = isPremium and "✓ ACTIVO" or "HAZTE PREMIUM",
			Enabled = not isPremium,
			OnClick = function()
				pcall(function()
					game:GetService("MarketplaceService"):PromptPremiumPurchase(player)
				end)
			end,
		}, 2)
	end
end

local function renderCategory(category)
	section(category.Text)
	addCards(grid(), Catalog.StoreItems(category.Kinds, StoreData.Day()))
end

local function render()
	for _, child in content:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	table.clear(cards)
	table.clear(refreshers)
	table.clear(timers)
	order = 0
	content.CanvasPosition = Vector2.zero
	if tab == "FEATURED" then
		renderFeatured()
	elseif tab == "BUNDLES" then
		renderBundles()
	elseif tab == "COINS" then
		renderCoins()
	else
		for _, category in Catalog.Categories do
			if category.Id == tab and category.Kinds then
				renderCategory(category)
			end
		end
	end
	Store.UpdateTimers()
end

-- Relojes: cuentan hasta la hora de cambio de verdad; al llegar, la tienda se rehace (cambio real)
function Store.UpdateTimers()
	local now = StoreData.Now()
	local expired = false
	for _, timer in timers do
		local left = timer.EndsAt - now
		if left <= 0 then
			expired = true
		end
		timer.Label.Text = timer.Prefix .. StoreData.FormatTime(left)
	end
	if expired and screen.Visible then
		render()
	end
end

local function refreshTabs()
	local data = ClientState.Data
	for id, button in tabs do
		C.setSelected(button, id == tab)
		local dot = false
		for _, category in Catalog.Categories do
			if category.Id == id and category.Kinds and data then
				for _, item in Catalog.StoreItems(category.Kinds) do
					if Catalog.IsNew(data, item.Kind, item.Id) and not Catalog.Owns(data, item.Kind, item.Id, StoreData.IsVIP()) then
						dot = true
						break
					end
				end
			end
		end
		if id == "PASS" then
			dot = data ~= nil and data.Pass ~= nil and (data.Pass.Claimable or 0) > 0
		end
		C.dot(button, dot)
	end
end

function Store.SelectTab(id)
	if id == "PASS" then
		flow.SetState("Pass")
		return
	end
	tab = id
	refreshTabs()
	render()
	StoreData.Track("store_open", { tab = id })
	Transition.SlideIn(content, Vector2.new(0, 16), 0.18)
end

function Store.Refresh()
	local data = ClientState.Data
	coinsLabel.Text = data and tostring(data.Coins or 0) or "—"
	bonusLine.Visible = data ~= nil and not data.FirstPurchase and MonetizationConfig.FirstPurchaseBonus ~= nil
	for _, card in cards do
		card.Refresh()
	end
	for _, refresh in refreshers do
		refresh()
	end
	refreshTabs()
end

---------------------------------------------------------------------------
-- Pantalla
---------------------------------------------------------------------------

local function applyLayout()
	local phone = isPhone()
	titleLabel.TextSize = phone and 34 or 46
	tabsRow.Position = UDim2.fromOffset(24, phone and 58 or 76)
	tabsRow.Size = UDim2.new(1, -48, 0, phone and 38 or 42)
	for _, button in tabs do
		button.Size = UDim2.fromOffset(phone and 104 or 128, phone and 38 or 42)
	end
	local top = phone and 104 or 128
	content.Position = UDim2.fromOffset(24, top)
	content.Size = UDim2.new(1, -48, 1, -(top + (phone and 30 or 40)))
end

function Store.Build(flowController, root)
	flow = flowController
	rootFrame = root
	StoreData.Init()
	Reveal.Init()
	screen = C.new("Frame", { Name = "Store", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })
	C.button({ Name = "Back", Text = "VOLVER", Icon = "◀", Style = "Ghost", TextSize = 16, Position = UDim2.fromOffset(24, 22), Size = UDim2.fromOffset(130, 40), Parent = screen, Sound = "Back", OnClick = function()
		flow.SetState("Home")
	end })
	titleLabel = C.text({ Text = "TIENDA", Role = "TitleItalic", TextSize = 46, Position = UDim2.fromOffset(170, 14), Size = UDim2.fromOffset(300, 54), Stroke = 2, Parent = screen })
	-- Monedas (con + que lleva a MONEDAS); los Robux los enseña Roblox en su ventana
	local currencyRow = C.new("Frame", { Name = "Currency", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 22), Size = UDim2.fromOffset(160, 40), Parent = screen })
	local _, amount = C.currency(currencyRow, Icons.Coin, 1, function()
		Store.SelectTab("COINS")
	end)
	coinsLabel = amount
	-- Pestañas
	tabsRow = C.new("ScrollingFrame", { Name = "Tabs", BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(24, 76), Size = UDim2.new(1, -48, 0, 42), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollingDirection = Enum.ScrollingDirection.X, ScrollBarThickness = 0, Parent = screen }, {
		C.list(6, Enum.FillDirection.Horizontal),
	})
	for i, category in Catalog.Categories do
		tabs[category.Id] = C.button({ Name = "Tab_" .. category.Id, Text = category.Text, Style = "Menu", TextSize = 15, Size = UDim2.fromOffset(128, 42), Order = i, Parent = tabsRow, OnClick = function()
			Store.SelectTab(category.Id)
		end })
	end
	-- Contenido
	content = C.new("ScrollingFrame", {
		Name = "Content",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(24, 128),
		Size = UDim2.new(1, -48, 1, -168),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = Colors.Yellow,
		Parent = screen,
	}, { C.list(10), C.padding(4, 6, 12, 2) })
	-- Una línea (sin ventana) con el bonus de la primera compra
	bonusLine = C.text({ Name = "FirstPurchase", Text = "🎁 " .. (MonetizationConfig.FirstPurchaseBonus and MonetizationConfig.FirstPurchaseBonus.Text or ""), Role = "Body", TextSize = 13, Color = Colors.TextDim, Anchor = Vector2.new(0, 1), Position = UDim2.new(0, 24, 1, -8), Size = UDim2.new(1, -48, 0, 20), Parent = screen })
	toastLabel = C.text({ Name = "Toast", Text = "", Role = "TitleItalic", TextSize = 20, AlignX = Enum.TextXAlignment.Center, Stroke = 2, Anchor = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -34), Size = UDim2.new(1, -40, 0, 28), Visible = false, ZIndex = 10, Parent = screen })
	ClientState.DataChanged.Event:Connect(function()
		if screen.Visible then
			Store.Refresh()
		end
	end)
	StoreData.Changed.Event:Connect(function(state)
		if screen.Visible then
			Store.Refresh()
			if state == "Cancelled" then
				toast("COMPRA CANCELADA", Colors.TextDim)
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if screen.Visible then
				Store.UpdateTimers()
			end
		end
	end)
	-- Lo que antes abría la tienda o el pase del menú (botones de otros sitios): en el lobby, aquí
	pcall(function()
		local Menu = require(Modules.Menu)
		Menu.Redirect = function(tabName)
			if (tabName == "Tienda" or tabName == "Pase") and flow.Lobby[flow.State] then
				flow.SetState(tabName == "Tienda" and "Store" or "Pass")
				return true
			end
			return false
		end
	end)
	Store.Screen = screen
end

-- ctx.Tab: pestaña con la que abrir (p. ej. "COINS" desde el + de las monedas, "FEATURED" desde EVENTOS)
function Store.Show(ctx)
	ctx = ctx or {}
	table.clear(shownOnce)
	tab = ctx.Tab or "FEATURED"
	applyLayout()
	flow.SetCamera("Orbit")
	flow.SetBackdrop(0.62, 0.25)
	Transition.Blur(16, 0.25)
	screen.Visible = true
	Store.Refresh()
	render()
	StoreData.Track("store_open", { tab = tab })
	Transition.SlideIn(content, Vector2.new(0, 24), 0.3)
end

function Store.Hide()
	Inspect.Close()
	Confirm.Close()
	screen.Visible = false
end

return Store
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="194">
                <Properties>
                  <string name="Name">TeamIntro</string>
                  <string name="Source"><![CDATA[-- PRESENTACIÓN DE EQUIPOS: tu equipo a la izquierda y el rival a la derecha, cinco personajes reales
-- de cada lado (copias 3D de los jugadores y de los bots, con su traje y su arma), sus nombres y
-- niveles debajo y VS en medio. Los personajes entran uno a uno (también cuida los móviles: nada de
-- diez modelos de golpe) y los bots, que el servidor crea justo al empezar, aparecen en cuanto
-- llegan. Dura ~3 s; luego, la elección rápida de clase.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Flow = script.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Transition = require(Flow.Transition)
local UISound = require(Flow.UISound)
local Preview = require(Flow.Preview)

local player = Players.LocalPlayer
local Colors = Theme.Colors

local TeamIntro = {}

local flow, screen, vs, sides, ffaList
local token = 0

-- Miembros de un equipo: jugadores (sin los que siguen en el menú) y bots, tú primero
local function roster(teamName)
	local list = {}
	for _, other in Players:GetPlayers() do
		local inGame = not other:GetAttribute("InMenu") or other:GetAttribute("Ready") or other == player
		if other.Team and other.Team.Name == teamName and inGame then
			local stats = other:FindFirstChild("leaderstats")
			local level = stats and stats:FindFirstChild("Nivel")
			table.insert(list, { Name = other.DisplayName, Level = level and level.Value or nil, Source = other, Me = other == player, Card = other:GetAttribute("Card") })
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			if model:GetAttribute("Team") == teamName then
				local humanoid = model:FindFirstChildOfClass("Humanoid")
				table.insert(list, { Name = humanoid and humanoid.DisplayName or model.Name, Bot = true, Source = model, Role = model:GetAttribute("Role") })
			end
		end
	end
	table.sort(list, function(a, b)
		if (a.Me == true) ~= (b.Me == true) then
			return a.Me == true
		end
		if (a.Bot == true) ~= (b.Bot == true) then
			return not a.Bot
		end
		return a.Name < b.Name
	end)
	return list
end

local function buildSide(parent, anchorX, posX)
	local side = C.new("Frame", { Name = "Side", BackgroundTransparency = 1, AnchorPoint = Vector2.new(anchorX, 0), Position = UDim2.new(posX, 0, 0, 0), Size = UDim2.new(0.48, 0, 1, 0), Parent = parent })
	local header = C.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 70), Parent = side })
	local tag = C.text({ Name = "Tag", Text = "", Role = "Title", TextSize = 16, Color = Colors.TextDim, AlignX = anchorX == 0 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right, Position = UDim2.fromOffset(24, 0), Size = UDim2.new(1, -48, 0, 20), Parent = header })
	local name = C.text({ Name = "TeamName", Text = "", Role = "TitleItalic", TextSize = 46, AlignX = tag.TextXAlignment, Position = UDim2.fromOffset(24, 18), Size = UDim2.new(1, -48, 0, 50), Stroke = 2, Parent = header })
	local bar = C.new("Frame", { Name = "Bar", BorderSizePixel = 0, AnchorPoint = Vector2.new(anchorX, 0), Position = UDim2.new(anchorX, anchorX == 0 and 24 or -24, 0, 70), Size = UDim2.fromOffset(160, 5), Parent = header })
	local preview = Preview.new(side, { Name = "Lineup", Position = UDim2.fromOffset(0, 96), Size = UDim2.new(1, 0, 1, -200), Camera = "Lineup" })
	local cards = C.new("Frame", { Name = "Cards", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -24), Size = UDim2.new(1, -20, 0, 58), Parent = side }, {
		C.list(6, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center),
	})
	return { Frame = side, Tag = tag, Name = name, Bar = bar, Preview = preview, Cards = cards, Shown = {}, CardApis = {}, CardColor = nil }
end

local function fill(side, team, isMine, my)
	local color = team and team.TeamColor.Color or Colors.White
	side.Tag.Text = isMine and "TU EQUIPO" or "RIVALES"
	side.Name.Text = team and ("EQUIPO " .. C.upper(team.Name)) or ""
	side.Bar.BackgroundColor3 = color
	local list = team and roster(team.Name) or {}
	-- Tarjetas (siempre 5: los huecos que faltan quedan "esperando"). Se crean una vez por
	-- presentación y después solo se actualizan: antes se destruían y se volvían a crear las diez cada
	-- 0,6 s (parpadeo y objetos nuevos sin necesidad)
	if side.CardColor ~= color or #side.CardApis == 0 then
		for _, child in side.Cards:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		table.clear(side.CardApis)
		side.CardColor = color
		for i = 1, 5 do
			side.CardApis[i] = C.playerCard({ Size = UDim2.new(0.2, -6, 1, 0), Order = i, Parent = side.Cards }, {
				Name = "…",
				Status = "Loading",
				TeamColor = color,
			})
		end
	end
	for i = 1, 5 do
		local entry = list[i]
		side.CardApis[i]:Update({
			Name = entry and entry.Name or "…",
			Level = entry and entry.Level or nil,
			Status = entry and (entry.Bot and "Bot" or "Ready") or "Loading",
			Me = entry and entry.Me,
			Card = entry and entry.Card,
		})
	end
	-- Personajes: uno a uno (y los que ya estaban no se vuelven a copiar)
	for i = 1, 5 do
		if token ~= my then
			return
		end
		local entry = list[i]
		local slot = "line" .. i
		local source = entry and entry.Source or nil
		if side.Shown[slot] ~= source then
			side.Shown[slot] = source
			side.Preview:SetCharacter(slot, source)
			side.Preview:SetAnimation(slot, "SquadIdle")
			if source then
				task.wait(0.06)
			end
		end
	end
end

function TeamIntro.Build(flowController, root)
	flow = flowController
	screen = C.new("Frame", { Name = "TeamIntro", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = root })
	sides = {
		Mine = buildSide(screen, 0, 0),
		Enemy = buildSide(screen, 1, 1),
	}
	vs = C.text({ Name = "VS", Text = "VS", Role = "TitleItalic", TextSize = 96, Color = Colors.Yellow, AlignX = Enum.TextXAlignment.Center, Anchor = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromOffset(200, 110), Stroke = 3, Parent = screen })
	ffaList = C.text({ Name = "FFA", Text = "", Role = "Title", TextSize = 22, Wrap = true, AlignX = Enum.TextXAlignment.Center, Anchor = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.55), Size = UDim2.new(0.7, 0, 0, 200), Parent = screen })
end

function TeamIntro.Show(ctx)
	token += 1
	local my = token
	flow.SetCamera("Orbit")
	flow.SetBackdrop(0.7, 0.25)
	Transition.Blur(12, 0.25)
	screen.Visible = true
	UISound.Play("Whoosh")
	local teamMode = ReplicatedStorage:GetAttribute("TeamMode") == true
	for _, side in sides do
		side.Frame.Visible = teamMode
		side.Preview:Clear()
		table.clear(side.Shown)
		side.Preview:SetActive(teamMode)
		side.CardColor = nil -- (tarjetas nuevas en cada presentación: el equipo puede ser otro)
	end
	vs.Visible = teamMode
	ffaList.Visible = not teamMode
	if teamMode then
		local mine = player.Team
		local enemy
		for _, team in game:GetService("Teams"):GetChildren() do
			if team ~= mine and (team.Name == ReplicatedStorage:GetAttribute("TeamA") or team.Name == ReplicatedStorage:GetAttribute("TeamB")) then
				enemy = team
			end
		end
		-- Tu equipo entra primero; el rival, un instante después; VS en medio
		Transition.SlideIn(sides.Mine.Frame, Vector2.new(-120, 0), 0.35)
		Transition.SlideIn(sides.Enemy.Frame, Vector2.new(120, 0), 0.35, 0.35)
		-- (el VS no se ve hasta su golpe: antes se veía al doble de tamaño durante el retraso)
		vs.Visible = false
		task.delay(0.55, function()
			if token == my then
				vs.Visible = true
				Transition.Pop(vs, 2, 0.3)
				UISound.Play("Countdown", 0.6)
			end
		end)
		task.spawn(function()
			-- (se rellena varias veces: los bots llegan un segundo después de empezar)
			while token == my and flow.State == "TeamIntro" do
				fill(sides.Mine, mine, true, my)
				fill(sides.Enemy, enemy, false, my)
				task.wait(0.6)
			end
		end)
	else
		local names = {}
		for _, other in Players:GetPlayers() do
			table.insert(names, other.DisplayName)
		end
		ffaList.Text = "TODOS CONTRA TODOS\n" .. table.concat(names, "  ·  ")
	end
	-- Siguiente: la elección de clase (o la cuenta atrás si el servidor ya está en ella)
	task.spawn(function()
		local started = os.clock()
		while token == my and flow.State == "TeamIntro" do
			local countdownIn = flow.CountdownIn()
			if os.clock() - started >= flow.Times.TeamIntro then
				flow.Advance("TeamIntro")
				break
			end
			if countdownIn and countdownIn <= 0 then
				flow.SetState("Deploy")
				break
			end
			task.wait(0.1)
		end
	end)
	local _ = ctx
end

function TeamIntro.Hide()
	token += 1
	for _, side in sides do
		side.Preview:SetActive(false)
		-- (diez personajes copiados: fuera en cuanto empieza la partida)
		side.Preview:Clear()
		table.clear(side.Shown)
	end
	screen.Visible = false
end

return TeamIntro
]]></string>
                </Properties>
              </Item>
            </Item>
            <Item class="Folder" referent="195">
              <Properties>
                <string name="Name">Store</string>
              </Properties>
              <Item class="ModuleScript" referent="196">
                <Properties>
                  <string name="Name">Confirm</string>
                  <string name="Source"><![CDATA[-- Confirmar una compra con monedas: qué compras, cuánto cuesta y cuánto te queda. CANCELAR a la
-- izquierda y CONFIRMAR a la derecha (nunca en el mismo sitio que el botón que la abrió, así un
-- doble toque no compra sin querer). Si no te llega, lo dice y no deja confirmar.
-- (Las compras con Robux usan la ventana de confirmación de Roblox, no esta.)
local UserInputService = game:GetService("UserInputService")

local Flow = script.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Icons = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Icons"))
local IconText = require(script.Parent.Parent.Parent.IconText)
local Transition = require(Flow.Transition)
local UISound = require(Flow.UISound)
local ClientState = require(Flow.Parent.ClientState)
local ItemArt = require(script.Parent.ItemArt)

local Colors = Theme.Colors

local Confirm = {}

local modal, connection

function Confirm.Close()
	ClientState.ConfirmOpen = false
	if connection then
		connection:Disconnect()
		connection = nil
	end
	if modal then
		modal:Destroy()
		modal = nil
	end
end

function Confirm.IsOpen()
	return modal ~= nil
end

-- onConfirm(): la compra de verdad; onCoins(): ir a MONEDAS (si no le llega)
function Confirm.Open(root, item, onConfirm, onCoins)
	Confirm.Close()
	local data = ClientState.Data
	local coins = data and data.Coins or 0
	local price = item.Coins or 0
	local enough = coins >= price
	ClientState.ConfirmOpen = true
	modal = C.new("TextButton", { Name = "Confirm", Text = "", AutoButtonColor = false, BackgroundColor3 = Colors.Black, BackgroundTransparency = 0.35, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 30, Parent = root })
	local box = C.panel({ Name = "Box", Anchor = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(460, 300), Parent = modal }, { Alpha = 0.02, StrokeColor = Colors.Yellow, StrokeAlpha = 0.5 })
	C.text({ Text = "CONFIRMAR COMPRA", Role = "TitleItalic", TextSize = 26, Color = Colors.YellowText, AlignX = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 12), Size = UDim2.new(1, 0, 0, 32), Parent = box })
	ItemArt.Thumb(box, item, { Position = UDim2.fromOffset(20, 56), Size = UDim2.fromOffset(150, 130) })
	C.text({ Text = C.upper(item.Name), Role = "TitleItalic", TextSize = 24, Scaled = true, Position = UDim2.fromOffset(184, 60), Size = UDim2.new(1, -200, 0, 30), Parent = box })
	C.text({ Text = C.upper(item.Rarity) .. "  ·  " .. (item.Label or ""), Role = "Title", TextSize = 13, Color = ItemArt.RarityColor(item.Rarity), Scaled = true, Position = UDim2.fromOffset(184, 92), Size = UDim2.new(1, -200, 0, 16), Parent = box })
	IconText.Bind(C.text({ Name = "Price", Text = "💰 " .. price, Role = "Number", TextSize = 30, Color = Colors.YellowText, Position = UDim2.fromOffset(184, 114), Size = UDim2.new(1, -200, 0, 36), Parent = box }), "💰", Icons.Coin)
	C.text({
		Name = "Balance",
		Text = enough and string.format("Tienes %d 💰 · te quedarán %d 💰", coins, coins - price) or string.format("Te faltan %d 💰", price - coins),
		Role = "Body",
		TextSize = 13,
		Color = enough and Colors.TextDim or Colors.Red,
		Wrap = true,
		Position = UDim2.fromOffset(184, 152),
		Size = UDim2.new(1, -200, 0, 34),
		Parent = box,
	})
	C.button({ Name = "Cancel", Text = "CANCELAR", Style = "Ghost", TextSize = 18, Position = UDim2.new(0, 20, 1, -70), Size = UDim2.new(0.5, -26, 0, 52), Parent = box, Sound = "Back", OnClick = Confirm.Close })
	if enough then
		C.button({ Name = "Accept", Text = "CONFIRMAR", Icon = Icons.Coin, Style = "Primary", TextSize = 20, Anchor = Vector2.new(1, 0), Position = UDim2.new(1, -20, 1, -70), Size = UDim2.new(0.5, -26, 0, 52), Parent = box, Sound = "Click", OnClick = function()
			Confirm.Close()
			onConfirm()
		end })
	else
		C.button({ Name = "GetCoins", Text = "CONSEGUIR MONEDAS", Style = "Ghost", TextSize = 16, Anchor = Vector2.new(1, 0), Position = UDim2.new(1, -20, 1, -70), Size = UDim2.new(0.5, -26, 0, 52), Parent = box, OnClick = function()
			Confirm.Close()
			if onCoins then
				onCoins()
			end
		end })
	end
	modal.Activated:Connect(function()
		UISound.Play("Back")
		Confirm.Close()
	end)
	connection = UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and (input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB) then
			Confirm.Close()
		end
	end)
	Transition.Pop(box, 0.9, 0.18)
	return modal
end

return Confirm
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="197">
                <Properties>
                  <string name="Name">Inspect</string>
                  <string name="Source"><![CDATA[-- PREVISUALIZAR: el objeto en grande antes de comprarlo. Armas: el modelo de verdad con la skin,
-- se gira arrastrando, zoom con la rueda, pellizcando o con + / −, y se puede ver en cualquiera de
-- tus armas. Trajes y poses: tu personaje completo. Intros de MVP: se repiten en bucle. Efectos de
-- baja: botón PROBAR que lo lanza delante de ti. Tarjetas, grafitis y títulos: en grande.
-- Siempre se dice que es solo estética.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weapons = require(Shared.Weapons)
local WeaponModels = require(Shared.WeaponModels)
local Outfits = require(Shared.Outfits)
local Titles = require(Shared.Titles)
local Catalog = require(Shared.Economy.CosmeticCatalog)

local Flow = script.Parent.Parent
local Modules = Flow.Parent
local ClientState = require(Modules.ClientState)
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local IconText = require(script.Parent.Parent.Parent.IconText)
local Icons = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Icons"))
local Transition = require(Flow.Transition)
local UISound = require(Flow.UISound)
local Preview = require(Flow.Preview)
local PoseRig = require(Flow.Results.PoseRig)
local ItemArt = require(script.Parent.ItemArt)
local ItemCard = require(script.Parent.ItemCard)
local StoreData = require(script.Parent.StoreData)

local Colors = Theme.Colors
local DARK = Color3.fromRGB(16, 14, 8)
local player = Players.LocalPlayer

local Inspect = {}

local overlay, current, connections = nil, nil, {}
local orbit -- { Camera, Center, Yaw, Pitch, Dist, Min, Max }

local function disconnectAll()
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
end

local function updateCamera()
	if not orbit then
		return
	end
	local offset = CFrame.Angles(0, orbit.Yaw, 0) * CFrame.Angles(orbit.Pitch, 0, 0) * Vector3.new(0, 0, -orbit.Dist)
	orbit.Camera.CFrame = CFrame.lookAt(orbit.Center + offset, orbit.Center)
end

function Inspect.Zoom(factor)
	if orbit then
		orbit.Dist = math.clamp(orbit.Dist * factor, orbit.Min, orbit.Max)
		updateCamera()
	end
end

function Inspect.Turn(dx, dy)
	if orbit then
		orbit.Yaw += dx
		orbit.Pitch = math.clamp(orbit.Pitch + (dy or 0), -0.9, 0.9)
		updateCamera()
	end
end

-- Cámara que gira alrededor del modelo
local function setupOrbit(camera, model, distanceScale)
	local ok, cf, size = pcall(model.GetBoundingBox, model)
	local center = ok and cf.Position or Vector3.new(0, 3, 0)
	local extent = ok and math.max(size.X, size.Y, size.Z) or 5
	local dist = extent * (distanceScale or 1.9)
	orbit = { Camera = camera, Center = center, Yaw = math.rad(-35), Pitch = math.rad(-8), Dist = dist, Min = dist * 0.45, Max = dist * 1.6 }
	camera.FieldOfView = 34
	updateCamera()
end

-- Tu personaje (o un maniquí si aún no hay personaje) con un traje
local function characterIn(preview, outfitId)
	local model = preview:SetCharacter("me", player)
	if not model then
		model = ItemArt.Mannequin(outfitId)
		model.Parent = preview.World
		return model, false
	end
	pcall(Outfits.Remove, model)
	if outfitId and outfitId ~= "Default" then
		pcall(Outfits.Apply, model, outfitId)
	end
	return model, true
end

local function primaryWeapon()
	local data = ClientState.Data
	return data and data.Primary or "ARX27"
end

---------------------------------------------------------------------------
-- Escena según el tipo
---------------------------------------------------------------------------

local weaponIndex = 1
local function ownedPrimaries()
	local list = {}
	local data = ClientState.Data
	for _, name in Weapons.Primaries do
		if Weapons.IsUnlocked(name, data) and not Weapons.Get(name).Hidden then
			table.insert(list, name)
		end
	end
	if #list == 0 then
		list = { "ARX27" }
	end
	return list
end

local function buildScene(area, item, refs, opts)
	local kind = item.Kind
	local data = ClientState.Data
	if kind == "Skin" or kind == "Charm" then
		local vp, camera = ItemArt.Viewport(area, { Name = "InspectViewport" })
		local list = ownedPrimaries()
		local function show(name)
			for _, child in vp:GetChildren() do
				if child:IsA("Model") then
					child:Destroy()
				end
			end
			local skin = kind == "Skin" and item.Id or (data and data.EquippedSkin) or nil
			local charm = kind == "Charm" and item.Id or (data and data.EquippedCharm ~= "Default" and data.EquippedCharm) or nil
			local ok, model = pcall(WeaponModels.Build, name, skin, false, charm, 1)
			if ok and model then
				model.Parent = vp
				setupOrbit(camera, model, kind == "Charm" and 1.1 or 1.55)
				if kind == "Charm" then
					orbit.Yaw = math.rad(-70)
					updateCamera()
				end
			end
			refs.WeaponName.Text = C.upper(Weapons.Get(name).DisplayName or name)
		end
		-- (se empieza en el arma pedida, p. ej. la de la oferta de después de la partida)
		local wanted = opts and opts.Weapon
		if wanted and Weapons.List[wanted] and not table.find(list, wanted) then
			table.insert(list, 1, wanted)
		end
		weaponIndex = math.max(1, table.find(list, wanted or primaryWeapon()) or 1)
		refs.ShowWeapon = function(step)
			weaponIndex = (weaponIndex - 1 + step) % #list + 1
			show(list[weaponIndex])
			Transition.Pop(vp, 0.94, 0.18)
		end
		refs.WeaponRow.Visible = #list > 1
		show(list[weaponIndex])
		-- Vuelta de inspección al abrir (la animación de inspección de la skin)
		task.spawn(function()
			local start = os.clock()
			local from = orbit and orbit.Yaw or 0
			while orbit and overlay and overlay.Visible and os.clock() - start < 0.8 do
				local a = (os.clock() - start) / 0.8
				orbit.Yaw = from + (1 - (1 - a) ^ 3) * math.pi * 2
				updateCamera()
				task.wait()
			end
		end)
		return vp
	elseif kind == "Outfit" or kind == "Pose" or kind == "MVPIntro" then
		local preview = Preview.new(area, { Name = "InspectViewport", Camera = "Hero" })
		refs.Preview = preview
		local outfit = kind == "Outfit" and item.Id or (data and data.EquippedOutfit) or "Default"
		local model, real = characterIn(preview, outfit)
		if real and data then
			preview:SetWeapon("me", data.Primary, data.EquippedSkin)
		end
		if kind == "Pose" then
			PoseRig.Apply(model, item.Id)
		end
		setupOrbit(preview.Camera, model, 1.25)
		orbit.Yaw = 0
		updateCamera()
		if kind == "MVPIntro" then
			task.spawn(function()
				while overlay and overlay.Visible and current == item and model.Parent do
					PoseRig.PlayIntro(preview.World, model, item.Id)
					task.wait(2.4)
				end
			end)
		end
		return preview.Viewport
	elseif kind == "Card" then
		return ItemArt.Card(area, item.Id, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(440, 130) }, player.DisplayName, "NV. " .. tostring(data and data.Level or 1) .. "  ·  " .. C.upper(Titles.Get(data and data.EquippedTitle or "Novato").Name))
	elseif kind == "Spray" then
		return ItemArt.Spray(area, item.Id, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(240, 300) })
	end
	return ItemArt.Thumb(area, item, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(300, 260) })
end

-- Efecto de baja delante de la cámara (la tienda se aparta 2 s para verlo)
local previewing = false
local function tryKillEffect(effectId)
	if previewing then
		return
	end
	previewing = true
	local camera = workspace.CurrentCamera
	local position = camera.CFrame.Position + camera.CFrame.LookVector * 16
	local gui = overlay and overlay:FindFirstAncestorWhichIsA("ScreenGui")
	local blur = Lighting:FindFirstChild("FlowBlur")
	local blurSize = blur and blur.Size
	if gui then
		gui.Enabled = false
	end
	if blur then
		blur.Size = 0
	end
	pcall(function()
		require(Modules.Effects).KillEffect(effectId, position, Colors.Yellow)
	end)
	task.delay(2.2, function()
		previewing = false
		if gui and ClientState.InMainMenu then
			gui.Enabled = true
		end
		if blur and blur.Parent and ClientState.InMainMenu then
			blur.Size = blurSize
		end
	end)
end

---------------------------------------------------------------------------
-- Ventana
---------------------------------------------------------------------------

-- callbacks = { OnBuy(item), OnEquip(item) }; opts = { Weapon = arma con la que enseñar la skin }
function Inspect.Open(root, item, callbacks, opts)
	Inspect.Close()
	current = item
	StoreData.Track("item_preview", { item = item.Key })
	StoreData.MarkSeen({ item.Key })
	local phone = C.Breakpoint() == "PHONE"
	overlay = C.new("Frame", { Name = "Inspect", BackgroundColor3 = Colors.Bg, BackgroundTransparency = 0.08, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 20, Active = true, Parent = root })
	local refs: { [string]: any } = {}
	local area = C.new("Frame", { Name = "Stage", BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 64), Size = UDim2.new(phone and 0.56 or 0.6, -20, 1, -84), ZIndex = 21, Parent = overlay })
	-- Panel derecho
	local info = C.panel({ Name = "Info", Anchor = Vector2.new(1, 0), Position = UDim2.new(1, -20, 0, 64), Size = UDim2.new(phone and 0.44 or 0.4, -30, 1, -84), Parent = overlay }, { Alpha = 0.1, StrokeColor = ItemArt.RarityColor(item.Rarity), StrokeAlpha = 0.5 })
	local inner = C.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = info }, { C.padding(phone and 10 or 16), C.list(phone and 4 or 8) })
	local rarityTag = C.new("Frame", { BackgroundColor3 = ItemArt.RarityColor(item.Rarity), BorderSizePixel = 0, Size = UDim2.fromOffset(140, 24), LayoutOrder = 1, Parent = inner }, { C.corner(3) })
	C.text({ Text = C.upper(item.Rarity), Role = "Title", TextSize = 14, Color = DARK, AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = rarityTag })
	C.text({ Name = "ItemName", Text = C.upper(item.Name), Role = "TitleItalic", TextSize = phone and 30 or 42, Scaled = true, Size = UDim2.new(1, 0, 0, phone and 34 or 48), Order = 2, Parent = inner })
	C.text({ Text = (item.Label or "") .. (item.Collection and ("  ·  COLECCIÓN " .. item.Collection) or ""), Role = "Title", TextSize = 14, Color = Colors.YellowText, Size = UDim2.new(1, 0, 0, 18), Order = 3, Parent = inner })
	if item.Description and not phone then
		C.text({ Text = item.Description, Role = "Body", TextSize = 14, Color = Colors.Text, Wrap = true, AlignY = Enum.TextYAlignment.Top, Size = UDim2.new(1, 0, 0, 40), Order = 4, Parent = inner })
	end
	C.text({ Text = "Solo estética: no cambia daño, retroceso, velocidad ni estadísticas.", Role = "Body", TextSize = phone and 11 or 13, Color = Colors.TextDim, Wrap = true, Size = UDim2.new(1, 0, 0, phone and 28 or 32), Order = 5, Parent = inner })
	-- Cambiar de arma (skins y colgantes)
	refs.WeaponRow = C.new("Frame", { Name = "WeaponRow", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 36), Visible = false, LayoutOrder = 6, Parent = inner })
	C.button({ Name = "PrevWeapon", Text = "◀", Style = "Ghost", TextSize = 16, Size = UDim2.fromOffset(40, 36), Parent = refs.WeaponRow, OnClick = function()
		if refs.ShowWeapon then
			refs.ShowWeapon(-1)
		end
	end })
	refs.WeaponName = C.text({ Name = "WeaponName", Text = "", Role = "Title", TextSize = 16, AlignX = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(44, 0), Size = UDim2.new(1, -88, 1, 0), Parent = refs.WeaponRow })
	C.button({ Name = "NextWeapon", Text = "▶", Style = "Ghost", TextSize = 16, Anchor = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(40, 36), Parent = refs.WeaponRow, OnClick = function()
		if refs.ShowWeapon then
			refs.ShowWeapon(1)
		end
	end })
	-- Probar efecto de baja
	if item.Kind == "KillEffect" then
		C.button({ Name = "TryEffect", Text = "PROBAR EFECTO", Icon = "💥", Style = "Ghost", TextSize = 16, Size = UDim2.new(1, 0, 0, 44), Order = 7, Parent = inner, OnClick = function()
			tryKillEffect(item.Id)
		end })
	end
	-- Precio y acción
	local price = C.text({ Name = "Price", Text = ItemCard.PriceText(item), Role = "Number", TextSize = 26, Color = item.Robux and Colors.Green or Colors.YellowText, Size = UDim2.new(1, 0, 0, 32), Order = 8, Parent = inner })
	IconText.Bind(price, "💰", Icons.Coin)
	local action = C.button({ Name = "Action", Text = "COMPRAR", Style = "Primary", TextSize = 22, Size = UDim2.new(1, 0, 0, phone and 46 or 54), Order = 9, Parent = inner, Sound = "Click", OnClick = function()
		local state = StoreData.State(item)
		if state == "Buy" then
			callbacks.OnBuy(item)
		elseif state == "Owned" then
			callbacks.OnEquip(item)
		end
	end })
	local actionLabel = action:FindFirstChild("Label", true)
	local function refresh()
		local state = StoreData.State(item)
		local yellow = state == "Buy" or (state == "Owned" and Catalog.Equippable(item.Kind, item.Id))
		local text = ({ Buy = "COMPRAR", Owned = "EQUIPAR", Equipped = "EQUIPADO ✓", Soon = "PRÓXIMAMENTE", Pass = "SE CONSIGUE EN EL PASE", Event = "SE CONSIGUE EN EL EVENTO", Locked = "NO DISPONIBLE" })[state]
		if StoreData.Pending and StoreData.Pending.Key == item.Key then
			text, yellow = "PROCESANDO…", false
		end
		actionLabel.Text = text
		action.BackgroundColor3 = yellow and Colors.Yellow or Colors.PanelLight
		actionLabel.TextColor3 = yellow and DARK or (state == "Equipped" and Colors.Green or Colors.TextDim)
		local gradient = action:FindFirstChildOfClass("UIGradient")
		if gradient then
			gradient.Enabled = yellow
		end
		price.Visible = state == "Buy" or state == "Soon"
	end
	refresh()
	table.insert(connections, ClientState.DataChanged.Event:Connect(refresh))
	table.insert(connections, StoreData.Changed.Event:Connect(refresh))
	-- Cabecera: título y cerrar
	C.text({ Text = "PREVISUALIZAR", Role = "TitleItalic", TextSize = phone and 26 or 34, Position = UDim2.fromOffset(20, 12), Size = UDim2.fromOffset(400, 40), Parent = overlay })
	C.button({ Name = "Close", Text = "CERRAR", Icon = "✕", Style = "Ghost", TextSize = 15, Anchor = Vector2.new(1, 0), Position = UDim2.new(1, -20, 0, 12), Size = UDim2.fromOffset(130, 40), Parent = overlay, Sound = "Back", OnClick = Inspect.Close })
	-- Escena
	local scene = buildScene(area, item, refs, opts)
	if scene and scene:IsA("ViewportFrame") and orbit then
		C.text({ Name = "Hint", Text = phone and "Arrastra para girar · pellizca para acercar" or "Arrastra para girar · rueda para acercar", Role = "Body", TextSize = 13, Color = Colors.TextDim, AlignX = Enum.TextXAlignment.Center, Anchor = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -4), Size = UDim2.new(1, 0, 0, 18), Parent = area })
		local zoomIn = C.button({ Name = "ZoomIn", Text = "+", Style = "Ghost", TextSize = 22, Anchor = Vector2.new(1, 1), Position = UDim2.new(1, -4, 1, -76), Size = UDim2.fromOffset(44, 44), Parent = area, OnClick = function()
			Inspect.Zoom(0.85)
		end })
		local zoomOut = C.button({ Name = "ZoomOut", Text = "−", Style = "Ghost", TextSize = 22, Anchor = Vector2.new(1, 1), Position = UDim2.new(1, -4, 1, -26), Size = UDim2.fromOffset(44, 44), Parent = area, OnClick = function()
			Inspect.Zoom(1 / 0.85)
		end })
		local _ = zoomIn and zoomOut
		-- Girar arrastrando, zoom con rueda o pellizco
		local dragging, last = false, nil
		table.insert(connections, scene.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging, last = true, input.Position
			end
		end))
		table.insert(connections, UserInputService.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseWheel and overlay then
				Inspect.Zoom(input.Position.Z > 0 and 0.9 or 1 / 0.9)
			elseif dragging and last and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - last
				last = input.Position
				Inspect.Turn(delta.X * 0.012, -delta.Y * 0.006)
			end
		end))
		table.insert(connections, UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end))
		pcall(function()
			table.insert(connections, UserInputService.TouchPinch:Connect(function(_, scale, _, state)
				if overlay and state == Enum.UserInputState.Change and type(scale) == "number" and scale > 0 then
					Inspect.Zoom(math.clamp(1 / scale, 0.97, 1.03))
				end
			end))
		end)
	end
	table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and (input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB) then
			UISound.Play("Back")
			Inspect.Close()
		end
	end))
	refs.Scene = scene
	Transition.Pop(area, 0.9, 0.25)
	Transition.SlideIn(info, Vector2.new(40, 0), 0.25)
	ClientState.StoreModal = true
	return overlay
end

function Inspect.IsOpen()
	return overlay ~= nil
end

function Inspect.Close()
	disconnectAll()
	orbit = nil
	current = nil
	if overlay then
		overlay:Destroy()
		overlay = nil
	end
	ClientState.StoreModal = false
end

return Inspect
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="198">
                <Properties>
                  <string name="Name">ItemArt</string>
                  <string name="Source"><![CDATA[-- Imágenes de los cosméticos para la tienda, el pase y la escena de compra: el arma de verdad con su
-- skin (WeaponIcon), un maniquí con el traje, el colgante en 3D, la tarjeta de jugador dibujada, el
-- grafiti y, para lo que no tiene modelo (efectos, poses, intros, títulos), su icono sobre el color
-- de su rareza. Nada de imágenes subidas: todo se dibuja con piezas.
--   ItemArt.Thumb(parent, item, props)        -- miniatura de cualquier objeto (item = Catalog.Item)
--   ItemArt.Card(parent, cardId, props, name) -- tarjeta de jugador (con tu nombre si se pasa)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Outfits = require(Shared.Outfits)
local Charms = require(Shared.Charms)
local Sprays = require(Shared.Sprays)
local Titles = require(Shared.Titles)
local PlayerCards = require(Shared.PlayerCards)
local Catalog = require(Shared.Economy.CosmeticCatalog)

local Flow = script.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local WeaponIcon = require(Flow.Parent.WeaponIcon)

local Colors = Theme.Colors
local player = Players.LocalPlayer

local ItemArt = {}

function ItemArt.RarityColor(rarity)
	return Catalog.RarityColors[rarity] or Colors.TextDim
end

local function apply(inst, props)
	for key, value in props or {} do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

-- Fondo de una miniatura: degradado oscuro con el color de la rareza abajo
function ItemArt.Backdrop(parent, rarity, props)
	local color = ItemArt.RarityColor(rarity)
	local frame = C.new("Frame", { Name = "Art", BackgroundColor3 = color, BorderSizePixel = 0, ClipsDescendants = true }, {
		C.corner(4),
		C.new("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(Color3.fromRGB(22, 24, 30), color),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.35) }),
		}),
	})
	apply(frame, props)
	frame.Parent = parent
	return frame
end

-- Maniquí sencillo con un traje (miniaturas: no copia tu personaje para cada tarjeta)
function ItemArt.Mannequin(outfitId)
	local model = Instance.new("Model")
	model.Name = "Mannequin"
	local skin = Color3.fromRGB(230, 190, 150)
	local legs = Color3.fromRGB(55, 58, 66)
	local torso = Color3.fromRGB(70, 74, 86)
	for _, spec in {
		{ "Head", Vector3.new(1.2, 1.2, 1.2), 0, 5.2, skin },
		{ "UpperTorso", Vector3.new(2, 1.6, 1), 0, 3.8, torso },
		{ "LowerTorso", Vector3.new(2, 0.4, 1), 0, 2.8, torso },
		{ "LeftUpperArm", Vector3.new(1, 1.2, 1), -1.5, 4.0, skin },
		{ "RightUpperArm", Vector3.new(1, 1.2, 1), 1.5, 4.0, skin },
		{ "LeftLowerArm", Vector3.new(1, 1.1, 1), -1.5, 2.85, skin },
		{ "RightLowerArm", Vector3.new(1, 1.1, 1), 1.5, 2.85, skin },
		{ "LeftHand", Vector3.new(1, 0.3, 1), -1.5, 2.15, skin },
		{ "RightHand", Vector3.new(1, 0.3, 1), 1.5, 2.15, skin },
		{ "LeftUpperLeg", Vector3.new(1, 1.2, 1), -0.5, 2.0, legs },
		{ "RightUpperLeg", Vector3.new(1, 1.2, 1), 0.5, 2.0, legs },
		{ "LeftLowerLeg", Vector3.new(1, 1.1, 1), -0.5, 0.85, legs },
		{ "RightLowerLeg", Vector3.new(1, 1.1, 1), 0.5, 0.85, legs },
		{ "LeftFoot", Vector3.new(1, 0.3, 1), -0.5, 0.15, legs },
		{ "RightFoot", Vector3.new(1, 0.3, 1), 0.5, 0.15, legs },
	} do
		local p = Instance.new("Part")
		p.Name = spec[1]
		p.Size = spec[2]
		p.CFrame = CFrame.new(spec[3], spec[4], 0)
		p.Color = spec[5]
		p.Anchored = true
		p.Parent = model
	end
	if outfitId and outfitId ~= "Default" then
		pcall(Outfits.Apply, model, outfitId)
	end
	return model
end

local function viewport(parent, props)
	local vp = C.new("ViewportFrame", {
		Name = "Viewport",
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(150, 152, 168),
		LightColor = Color3.fromRGB(255, 240, 220),
		LightDirection = Vector3.new(-0.8, -1.2, 0.9),
		Size = UDim2.fromScale(1, 1),
	})
	apply(vp, props)
	vp.Parent = parent
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	camera.Parent = vp
	vp.CurrentCamera = camera
	return vp, camera
end
ItemArt.Viewport = viewport

function ItemArt.Operator(parent, outfitId, props)
	local vp, camera = viewport(parent, props)
	local model = ItemArt.Mannequin(outfitId)
	model.Parent = vp
	camera.CFrame = CFrame.lookAt(Vector3.new(4.5, 4.4, -11), Vector3.new(0, 3, 0))
	return vp
end

function ItemArt.Charm(parent, charmId, props)
	local vp, camera = viewport(parent, props)
	local model = Instance.new("Model")
	for _, piece in Charms.Build(charmId, CFrame.new(0, 0, 0)) do
		piece.Anchored = true
		piece.Parent = model
	end
	model.Parent = vp
	camera.FieldOfView = 24
	camera.CFrame = CFrame.lookAt(Vector3.new(0.35, -0.1, -1.1), Vector3.new(0, -0.18, 0))
	return vp
end

function ItemArt.Weapon(parent, weaponName, skinId, props)
	local size = props and props.Size
	local aspect = 2
	if typeof(size) == "UDim2" and size.Y.Offset > 0 and size.X.Offset > 0 then
		aspect = size.X.Offset / size.Y.Offset
	end
	local ok, icon = pcall(WeaponIcon.Create, weaponName or "ARX27", skinId, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, "angled", aspect)
	if ok and icon then
		apply(icon, props)
		icon.Parent = parent
		return icon
	end
	return nil
end

-- Tarjeta de jugador: fondo en degradado, borde, emblema y (opcional) tu nombre y nivel
function ItemArt.Card(parent, cardId, props, name, sub)
	local def = PlayerCards.Get(cardId)
	local frame = C.new("Frame", { Name = "PlayerCardArt", BackgroundColor3 = def.Top, BorderSizePixel = 0, ClipsDescendants = true }, {
		C.corner(4),
		C.stroke(def.Border, 2, 0.05),
		C.new("UIGradient", { Rotation = 90, Color = ColorSequence.new(def.Top, def.Bottom) }),
	})
	apply(frame, props)
	frame.Parent = parent
	-- Franjas diagonales muy suaves (textura)
	for i = 0, 3 do
		C.new("Frame", { Name = "Stripe", BackgroundColor3 = def.Border, BackgroundTransparency = 0.88, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.55 + i * 0.12, 0.5), Size = UDim2.new(0, 10, 2, 0), Rotation = 25, Parent = frame })
	end
	C.text({ Name = "Emblem", Text = def.Emblem or "", Role = "Title", TextSize = 34, Color = def.Border, AlignX = Enum.TextXAlignment.Right, Anchor = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0.4, 0, 0.8, 0), Scaled = true, Parent = frame })
	if name then
		C.text({ Name = "CardName", Text = C.upper(name), Role = "TitleItalic", TextSize = 22, Color = Colors.White, Scaled = true, Stroke = 1, Position = UDim2.new(0, 10, 0.12, 0), Size = UDim2.new(0.72, -10, 0.46, 0), Parent = frame })
		C.text({ Name = "CardSub", Text = sub or "", Role = "Title", TextSize = 13, Color = def.Border, Scaled = true, Position = UDim2.new(0, 10, 0.6, 0), Size = UDim2.new(0.72, -10, 0.3, 0), Parent = frame })
	end
	return frame
end

function ItemArt.Spray(parent, sprayId, props)
	local def = Sprays.List[sprayId] or Sprays.List.Default
	local frame = C.new("Frame", { Name = "SprayArt", BackgroundColor3 = def.Bg or Colors.Panel, BorderSizePixel = 0 }, { C.corner(6) })
	apply(frame, props)
	frame.Parent = parent
	C.text({ Text = def.Icon or "🎨", TextSize = 48, AlignX = Enum.TextXAlignment.Center, Scaled = true, Size = UDim2.fromScale(1, def.Caption and 0.68 or 0.9), Position = UDim2.fromScale(0, 0.05), Parent = frame })
	if def.Caption then
		C.text({ Text = def.Caption, Role = "TitleItalic", TextSize = 22, Color = def.Color or Colors.White, AlignX = Enum.TextXAlignment.Center, Scaled = true, Stroke = 1, Position = UDim2.fromScale(0.05, 0.7), Size = UDim2.fromScale(0.9, 0.26), Parent = frame })
	end
	return frame
end

-- Icono grande sobre la rareza (efectos, poses, intros, títulos)
function ItemArt.Icon(parent, item, props)
	local frame = ItemArt.Backdrop(parent, item.Rarity, props)
	C.text({ Name = "Glyph", Text = item.Icon or "★", TextSize = 64, AlignX = Enum.TextXAlignment.Center, Scaled = true, Position = UDim2.fromScale(0.2, 0.1), Size = UDim2.fromScale(0.6, 0.62), Parent = frame })
	C.text({ Name = "KindLabel", Text = item.Label or "", Role = "Title", TextSize = 13, Color = Colors.White, AlignX = Enum.TextXAlignment.Center, Scaled = true, Position = UDim2.fromScale(0.05, 0.76), Size = UDim2.fromScale(0.9, 0.16), Parent = frame })
	return frame
end

-- Miniatura de cualquier objeto
function ItemArt.Thumb(parent, item, props)
	local holder = ItemArt.Backdrop(parent, item.Rarity, props)
	local fill = { Size = UDim2.fromScale(1, 1), Position = UDim2.new(), Parent = holder }
	local kind = item.Kind
	if kind == "Skin" then
		local data = require(Flow.Parent.ClientState).Data
		ItemArt.Weapon(holder, data and data.Primary or "ARX27", item.Id, { Size = UDim2.fromScale(0.94, 0.9), Position = UDim2.fromScale(0.03, 0.05), Parent = holder })
	elseif kind == "Outfit" then
		ItemArt.Operator(holder, item.Id, fill)
	elseif kind == "Charm" then
		ItemArt.Charm(holder, item.Id, fill)
	elseif kind == "Card" then
		ItemArt.Card(holder, item.Id, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.86, 0.5) }, player and player.DisplayName or "", "NV. 1")
	elseif kind == "Spray" then
		ItemArt.Spray(holder, item.Id, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.62, 0.86) })
	elseif kind == "Title" then
		local title = Titles.Get(item.Id)
		C.text({ Text = C.upper(title.Name), Role = "TitleItalic", TextSize = 26, Color = title.Color or Colors.White, AlignX = Enum.TextXAlignment.Center, Scaled = true, Stroke = 1, Position = UDim2.fromScale(0.06, 0.3), Size = UDim2.fromScale(0.88, 0.4), Parent = holder })
	else
		holder:Destroy()
		return ItemArt.Icon(parent, item, props)
	end
	return holder
end

return ItemArt
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="199">
                <Properties>
                  <string name="Name">ItemCard</string>
                  <string name="Source"><![CDATA[-- Tarjeta de un objeto en la tienda: imagen grande, NUEVO, rareza, nombre, precio a la vista
-- (monedas o Robux, sin letra pequeña) y dos botones: PREVISUALIZAR y COMPRAR. Si ya es tuyo dice
-- TUYO / EQUIPADO y el botón es EQUIPAR (nunca se ofrece otra vez algo que ya tienes).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Catalog = require(ReplicatedStorage:WaitForChild("Shared").Economy.CosmeticCatalog)

local Flow = script.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local Icons = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Icons"))
local IconText = require(script.Parent.Parent.Parent.IconText)
local ItemArt = require(script.Parent.ItemArt)
local StoreData = require(script.Parent.StoreData)

local Colors = Theme.Colors
local DARK = Color3.fromRGB(16, 14, 8)

local ItemCard = {}

ItemCard.Size = { DESKTOP = Vector2.new(214, 286), PHONE = Vector2.new(168, 232) }

function ItemCard.PriceText(item)
	if item.Robux then
		local entry = StoreData.Robux({ ProductId = item.ProductId, Robux = item.Robux })
		return "R$ " .. tostring(entry)
	elseif item.Coins then
		return "💰 " .. tostring(item.Coins)
	end
	return ""
end

-- callbacks = { OnPreview(item), OnBuy(item), OnEquip(item) }
function ItemCard.new(parent, item, callbacks, opts)
	opts = opts or {}
	local phone = opts.Phone == true
	local size = phone and ItemCard.Size.PHONE or ItemCard.Size.DESKTOP
	local card = C.panel({ Name = "Item_" .. item.Key, Size = UDim2.fromOffset(size.X, size.Y), Order = opts.Order, Parent = parent }, {
		Alpha = 0.08,
		StrokeColor = ItemArt.RarityColor(item.Rarity),
		StrokeAlpha = 0.55,
	})
	local thumbHeight = math.floor(size.Y * 0.52)
	local thumb = ItemArt.Thumb(card, item, { Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 0, thumbHeight) })
	-- (tocar la imagen también previsualiza)
	local look = C.new("TextButton", { Name = "PreviewArea", Text = "", BackgroundTransparency = 1, Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 0, thumbHeight), ZIndex = 4, Parent = card })
	look.Activated:Connect(function()
		callbacks.OnPreview(item)
	end)
	local _ = thumb
	-- Etiquetas
	local tags = C.new("Frame", { Name = "Tags", BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 10), Size = UDim2.new(1, -20, 0, 20), ZIndex = 5, Parent = card }, {
		C.list(4, Enum.FillDirection.Horizontal),
	})
	local function tag(text, color, textColor, order)
		-- (ancho según el texto: letras de título, ~7 px cada una)
		local width = 12 + (utf8.len(text) or #text) * 7
		local t = C.new("Frame", { Name = "Tag", BackgroundColor3 = color, BorderSizePixel = 0, Size = UDim2.fromOffset(width, 20), LayoutOrder = order, ZIndex = 5, Parent = tags }, { C.corner(3) })
		C.text({ Text = text, Role = "Title", TextSize = 12, Color = textColor or Colors.White, AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 6, Parent = t })
		return t
	end
	if StoreData.IsNew(item) then
		tag("NUEVO", Colors.Red, Colors.White, 1)
	end
	if item.OnSale and item.BaseCoins and item.Coins and item.Coins < item.BaseCoins then
		-- (descuento real: precio de siempre tachado al lado)
		tag("-" .. math.floor((1 - item.Coins / item.BaseCoins) * 100 + 0.5) .. "% HOY", Colors.Yellow, DARK, 2)
	end
	if item.Collection then
		tag(item.Collection, Color3.fromRGB(30, 33, 40), Colors.YellowText, 3)
	end
	-- Rareza (barra y texto) y nombre
	local y = thumbHeight + 10
	C.new("Frame", { Name = "RarityBar", BackgroundColor3 = ItemArt.RarityColor(item.Rarity), BorderSizePixel = 0, Position = UDim2.fromOffset(6, y - 3), Size = UDim2.new(1, -12, 0, 3), ZIndex = 3, Parent = card })
	C.text({ Name = "Rarity", Text = C.upper(item.Rarity) .. "  ·  " .. (item.Label or ""), Role = "Title", TextSize = 12, Color = ItemArt.RarityColor(item.Rarity), Scaled = true, Position = UDim2.fromOffset(10, y + 2), Size = UDim2.new(1, -20, 0, 16), Parent = card })
	C.text({ Name = "ItemName", Text = C.upper(item.Name), Role = "TitleItalic", TextSize = phone and 18 or 21, Color = Colors.White, Scaled = true, Position = UDim2.fromOffset(10, y + 18), Size = UDim2.new(1, -20, 0, phone and 22 or 26), Parent = card })
	-- Precio (siempre visible) con el de siempre tachado si hay descuento
	local priceRow = C.new("Frame", { Name = "PriceRow", BackgroundTransparency = 1, Position = UDim2.fromOffset(10, y + (phone and 42 or 46)), Size = UDim2.new(1, -20, 0, 20), Parent = card })
	local price = C.text({ Name = "Price", Text = ItemCard.PriceText(item), Role = "Number", TextSize = 18, Color = item.Robux and Colors.Green or Colors.YellowText, Size = UDim2.new(0.6, 0, 1, 0), Parent = priceRow })
	IconText.Bind(price, "💰", Icons.Coin)
	if item.OnSale and item.BaseCoins and item.Coins and item.Coins < item.BaseCoins then
		C.text({ Name = "OldPrice", Text = "<s>" .. item.BaseCoins .. "</s>", Rich = true, Role = "Number", TextSize = 14, Color = Colors.TextFaint, AlignX = Enum.TextXAlignment.Right, Position = UDim2.fromScale(0.6, 0), Size = UDim2.new(0.4, 0, 1, 0), Parent = priceRow })
	end
	-- Botones
	local buttonY = size.Y - (phone and 46 or 50)
	local preview = C.button({ Name = "Preview", Text = "", Icon = Icons.Eye, Style = "Ghost", TextSize = 18, Position = UDim2.fromOffset(8, buttonY), Size = UDim2.fromOffset(phone and 44 or 50, phone and 38 or 42), Parent = card, OnClick = function()
		callbacks.OnPreview(item)
	end })
	local action = C.button({ Name = "Action", Text = "COMPRAR", Style = "Primary", TextSize = phone and 15 or 17, Position = UDim2.fromOffset((phone and 44 or 50) + 14, buttonY), Size = UDim2.new(1, -((phone and 44 or 50) + 22), 0, phone and 38 or 42), Parent = card, Sound = "Click", OnClick = function()
		local state = StoreData.State(item)
		if state == "Buy" then
			callbacks.OnBuy(item)
		elseif state == "Owned" then
			callbacks.OnEquip(item)
		end
	end })
	local actionLabel = action:FindFirstChild("Label", true)
	local api = { Frame = card, Item = item, Action = action, Preview = preview }
	function api.Refresh()
		local state = StoreData.State(item)
		price.Text = (state == "Owned" or state == "Equipped") and "" or ItemCard.PriceText(item)
		local yellow = state == "Buy" or state == "Owned"
		local text = ({
			Buy = "COMPRAR",
			Owned = "EQUIPAR",
			Equipped = "EQUIPADO ✓",
			Soon = "PRÓXIMAMENTE",
			Pass = "PASE DE BATALLA",
			Event = "EVENTO",
			Locked = "NO DISPONIBLE",
		})[state]
		if state == "Owned" and not Catalog.Equippable(item.Kind, item.Id) then
			text, yellow = "TUYO", false
		end
		if StoreData.Pending and StoreData.Pending.Key == item.Key then
			text, yellow = "PROCESANDO…", false
		end
		actionLabel.Text = text
		action.BackgroundColor3 = yellow and Colors.Yellow or Colors.PanelLight
		action.BackgroundTransparency = yellow and 0 or 0.25
		actionLabel.TextColor3 = yellow and DARK or (state == "Equipped" and Colors.Green or Colors.TextDim)
		local gradient = action:FindFirstChildOfClass("UIGradient")
		if gradient then
			gradient.Enabled = yellow
		end
	end
	api.Refresh()
	return api
end

return ItemCard
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="200">
                <Properties>
                  <string name="Name">Reveal</string>
                  <string name="Source"><![CDATA[-- Escena de compra (1-2 s), solo cuando el SERVIDOR confirma la entrega (PurchaseGranted):
--   COMPRA COMPLETADA → aparece el objeto → brillo → nombre → rareza → EQUIPAR AHORA
-- Al pulsar EQUIPAR AHORA el botón pasa a EQUIPADO ✓ con un pulso y su sonido. Legendario o más:
-- desenfoque, el objeto entra girando y sale el sello LEGENDARIO (sin pasar de 2 s). Packs: los
-- objetos entran uno tras otro y EQUIPAR TODO. Va en su propia capa: se ve también en partida.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Icons = require(Shared.Icons)
local Catalog = require(Shared.Economy.CosmeticCatalog)
local WeaponModels = require(Shared.WeaponModels)

local Flow = script.Parent.Parent
local Theme = require(Flow.Theme)
local C = require(Flow.Components)
local UISound = require(Flow.UISound)
local ClientState = require(Flow.Parent.ClientState)
local ItemArt = require(script.Parent.ItemArt)
local StoreData = require(script.Parent.StoreData)

local Colors = Theme.Colors
local DARK = Color3.fromRGB(16, 14, 8)
local player = Players.LocalPlayer

local Reveal = {}
Reveal.OnOpenPass = nil :: (() -> ())? -- (lo pone la pantalla del pase: botón VER PASE)

local gui, root, current
local queue = {}

local function tween(inst, time, props, style, direction)
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function pop(frame, delay, from)
	local scale = frame:FindFirstChild("RevealScale") or C.new("UIScale", { Name = "RevealScale", Parent = frame })
	scale.Scale = from or 0.5
	frame.Visible = false
	task.delay(delay or 0, function()
		if frame.Parent then
			frame.Visible = true
			tween(scale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end)
end

-- Lo que trae el aviso del servidor, como fichas del catálogo
local function itemsOf(payload)
	local list = {}
	for _, entry in payload.Items or {} do
		local item = Catalog.Item(entry.Kind, entry.Id)
		if item then
			table.insert(list, item)
		end
	end
	return list
end

local function best(items)
	local top
	for _, item in items do
		if not top or Catalog.RarityRank(item.Rarity) > Catalog.RarityRank(top.Rarity) then
			top = item
		end
	end
	return top
end

local function close()
	if current then
		current:Destroy()
		current = nil
	end
	local blur = Lighting:FindFirstChild("RevealBlur")
	if blur then
		-- (se renombra: si hay otra compra en cola, el siguiente revelado crea su propio desenfoque en
		-- vez de reutilizar este, que se destruye al acabar de desvanecerse)
		blur.Name = "RevealBlurOut"
		tween(blur, 0.2, { Size = 0 }).Completed:Once(function()
			blur:Destroy()
		end)
	end
	ClientState.RevealOpen = false
	if #queue > 0 then
		Reveal.Show(table.remove(queue, 1))
	end
end
Reveal.Close = close

-- Cierra el revelado y lo que quedara en cola (al entrar en partida: si no, el desenfoque y el panel
-- se quedaban puestos encima del juego si comprabas en Resultados justo antes de la siguiente)
function Reveal.CloseAll()
	table.clear(queue)
	if current then
		close()
	end
end

-- Arma girando (escena de legendario)
local function spinningWeapon(parent, skinId)
	local vp, camera = ItemArt.Viewport(parent, { Name = "Spin" })
	local data = ClientState.Data
	local ok, model = pcall(WeaponModels.Build, data and data.Primary or "ARX27", skinId, false, nil, 1)
	if not ok or not model then
		vp:Destroy()
		return nil
	end
	model.Parent = vp
	local cf, size = model:GetBoundingBox()
	local dist = math.max(size.X, size.Y, size.Z) * 1.5
	local start = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		if not vp.Parent then
			connection:Disconnect()
			return
		end
		local t = os.clock() - start
		-- entra deprisa y se queda girando despacio
		local yaw = t < 0.6 and (1 - (1 - t / 0.6) ^ 3) * math.pi * 2 or math.pi * 2 + (t - 0.6) * 0.6
		local offset = CFrame.Angles(0, yaw - 0.6, 0) * Vector3.new(0, dist * 0.18, -dist)
		camera.CFrame = CFrame.lookAt(cf.Position + offset, cf.Position)
	end)
	return vp
end

function Reveal.Show(payload)
	if type(payload) ~= "table" then
		return
	end
	if current then
		table.insert(queue, payload)
		return
	end
	if not root then
		Reveal.Init()
	end
	ClientState.RevealOpen = true
	local items = itemsOf(payload)
	local bonus = payload.Bonus and Catalog.Item(payload.Bonus.Kind, payload.Bonus.Id)
	-- (el bonus va aparte, no entre lo comprado)
	if bonus then
		for i, item in items do
			if item.Key == bonus.Key then
				table.remove(items, i)
				break
			end
		end
	end
	local top = best(items)
	local legendary = (top and Catalog.IsPremiumRarity(top.Rarity)) or payload.Premium == true
	local phone = C.Breakpoint() == "PHONE"

	local frame = C.new("Frame", { Name = "Reveal", BackgroundColor3 = Colors.Bg, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Active = true, Parent = root })
	current = frame
	tween(frame, 0.15, { BackgroundTransparency = legendary and 0.2 or 0.3 })
	if legendary then
		local blur = Lighting:FindFirstChild("RevealBlur") or C.new("BlurEffect", { Name = "RevealBlur", Size = 0, Parent = Lighting })
		tween(blur, 0.25, { Size = 20 })
	end
	-- Destello de compra
	local flash = C.new("Frame", { Name = "Flash", BackgroundColor3 = legendary and (top and ItemArt.RarityColor(top.Rarity) or Colors.Yellow) or Colors.Yellow, BackgroundTransparency = 0.55, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 9, Parent = frame })
	tween(flash, 0.35, { BackgroundTransparency = 1 })
	UISound.Play(legendary and "Victory" or "Purchase")

	-- Título
	local title = C.text({ Name = "Title", Text = payload.Type == "CoinItem" and "¡COMPRADO!" or "COMPRA COMPLETADA", Role = "TitleItalic", TextSize = phone and 30 or 40, Color = Colors.YellowText, AlignX = Enum.TextXAlignment.Center, Stroke = 2, Anchor = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, phone and 18 or 40), Size = UDim2.new(1, -40, 0, phone and 36 or 48), Parent = frame })
	pop(title, 0, 0.8)
	if payload.Title then
		local sub = C.text({ Name = "Sub", Text = C.upper(payload.Title), Role = "Title", TextSize = 18, Color = Colors.White, AlignX = Enum.TextXAlignment.Center, Anchor = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, phone and 54 or 88), Size = UDim2.new(1, -40, 0, 22), Parent = frame })
		pop(sub, 0.1, 0.9)
	end

	-- Objeto(s)
	local center = C.new("Frame", { Name = "Center", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, phone and 0.4 or 0.46), Size = UDim2.fromOffset(phone and 300 or 420, phone and 140 or 250), Parent = frame })
	-- Brillo detrás (color de la rareza), girando despacio
	local glowColor = top and ItemArt.RarityColor(top.Rarity) or Colors.Yellow
	local glow = C.new("Frame", { Name = "Glow", BackgroundColor3 = glowColor, BackgroundTransparency = 1, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.1, 1.1), Rotation = 45, Parent = center }, {
		C.corner(400),
		C.new("UIAspectRatioConstraint", { AspectRatio = 1 }),
		C.new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.35), NumberSequenceKeypoint.new(1, 1) }) }),
	})
	task.delay(0.2, function()
		if glow.Parent then
			tween(glow, 0.3, { BackgroundTransparency = 0.6 })
			tween(glow, 6, { Rotation = 405 }, Enum.EasingStyle.Linear)
		end
	end)
	local single = #items == 1 and items[1] or nil
	local nameText, rarityText
	if single then
		local art
		if legendary and single.Kind == "Skin" then
			art = spinningWeapon(center, single.Id)
		end
		art = art or ItemArt.Thumb(center, single, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.82, 0.92) })
		if legendary then
			-- entra desde la derecha
			art.Position = UDim2.fromScale(1.4, 0.5)
			art.AnchorPoint = Vector2.new(0.5, 0.5)
			task.delay(0.15, function()
				if art.Parent then
					tween(art, 0.45, { Position = UDim2.fromScale(0.5, 0.5) }, Enum.EasingStyle.Quint)
				end
			end)
		else
			pop(art, 0.2, 0.55)
		end
		nameText = C.upper(single.Name)
		rarityText = C.upper(single.Rarity)
	elseif #items > 1 then
		local row = C.new("Frame", { Name = "Items", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.4, 0.7), Parent = center }, {
			C.list(8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center),
		})
		local cell = phone and 74 or 104
		for i, item in items do
			if i > 6 then
				break
			end
			local thumb = ItemArt.Thumb(row, item, { Size = UDim2.fromOffset(cell, cell), LayoutOrder = i })
			pop(thumb, 0.15 + i * 0.1, 0.4)
		end
		nameText = payload.Title and C.upper(payload.Title) or (#items .. " OBJETOS")
		rarityText = top and C.upper(top.Rarity) or ""
	elseif payload.Pass then
		local badge = C.text({ Text = "🎖️", TextSize = 120, AlignX = Enum.TextXAlignment.Center, Scaled = true, Size = UDim2.fromScale(1, 1), Parent = center })
		pop(badge, 0.2, 0.5)
		nameText = payload.Title or "PASE"
		rarityText = ""
	elseif (payload.Coins or 0) > 0 then
		local coin = C.text({ Text = "💰", TextSize = 120, AlignX = Enum.TextXAlignment.Center, Scaled = true, Size = UDim2.fromScale(1, 0.8), Parent = center })
		pop(coin, 0.2, 0.5)
		nameText = "+" .. tostring(payload.Coins or 0) .. " MONEDAS"
		rarityText = ""
	else
		-- (potenciadores y otros productos sin objeto: su icono y su nombre)
		local glyph = C.text({ Text = payload.Icon or "⚡", TextSize = 120, AlignX = Enum.TextXAlignment.Center, Scaled = true, Size = UDim2.fromScale(1, 0.8), Parent = center })
		pop(glyph, 0.2, 0.5)
		nameText = payload.Title and C.upper(payload.Title) or "COMPRA COMPLETADA"
		rarityText = ""
	end
	local nameLabel = C.text({ Name = "ItemName", Text = nameText or "", Role = "TitleItalic", TextSize = phone and 30 or 44, Color = Colors.White, AlignX = Enum.TextXAlignment.Center, Stroke = 2, Scaled = true, Anchor = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, phone and 0.6 or 0.68, 0), Size = UDim2.new(0.8, 0, 0, phone and 32 or 50), Parent = frame })
	pop(nameLabel, 0.5, 0.85)
	if rarityText ~= "" then
		local stamp = C.new("Frame", { Name = "RarityStamp", BackgroundColor3 = glowColor, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, phone and 0.6 or 0.68, phone and 34 or 56), Size = UDim2.fromOffset(legendary and (phone and 180 or 220) or 150, legendary and (phone and 28 or 34) or 26), Rotation = legendary and -3 or 0, Parent = frame }, { C.corner(3) })
		C.text({ Text = rarityText, Role = "TitleItalic", TextSize = legendary and 24 or 16, Color = DARK, AlignX = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = stamp })
		pop(stamp, 0.7, legendary and 1.8 or 0.6)
		if legendary then
			task.delay(0.7, function()
				UISound.Play("LevelUp", 1.2)
			end)
		end
	end
	-- Extras: monedas devueltas y bonus de primera compra
	local extras = {}
	if (payload.Compensation or 0) > 0 then
		table.insert(extras, "+" .. payload.Compensation .. " 💰 por lo que ya tenías")
	elseif #items > 0 and (payload.Coins or 0) > 0 and payload.Title ~= nil then
		table.insert(extras, "+" .. payload.Coins .. " 💰")
	end
	if bonus then
		table.insert(extras, "🎁 Bonus de primera compra: tarjeta " .. C.upper(bonus.Name))
	end
	if #extras > 0 then
		local extra = C.text({ Name = "Extras", Text = table.concat(extras, "   ·   "), Role = "BodyBold", TextSize = 15, Color = Colors.YellowText, AlignX = Enum.TextXAlignment.Center, Anchor = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, phone and 0.6 or 0.68, phone and 66 or 96), Size = UDim2.new(1, -40, 0, 20), Parent = frame })
		pop(extra, 0.8, 0.9)
	end

	-- Botones: EQUIPAR AHORA (o EQUIPAR TODO) y CONTINUAR
	local buttons = C.new("Frame", { Name = "Buttons", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, phone and -14 or -36), Size = UDim2.fromOffset(phone and 460 or 560, phone and 48 or 56), Parent = frame }, {
		C.list(12, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center),
	})
	local equippable = {}
	for _, item in items do
		if Catalog.Equippable(item.Kind, item.Id) and item.Kind ~= "Title" then
			table.insert(equippable, item)
		end
	end
	local data = ClientState.Data
	local allEquipped = #equippable > 0
	for _, item in equippable do
		allEquipped = allEquipped and data ~= nil and Catalog.IsEquipped(data, item.Kind, item.Id)
	end
	if payload.Equipped then
		allEquipped = true
	end
	local function equippedLook(button)
		local label = button:FindFirstChild("Label", true)
		if label then
			label.Text = "EQUIPADO ✓"
			label.TextColor3 = Colors.White
		end
		button.BackgroundColor3 = Colors.Green
		local gradient = button:FindFirstChildOfClass("UIGradient")
		if gradient then
			gradient.Enabled = false
		end
	end
	if #equippable > 0 then
		local equip
		equip = C.button({ Name = "Equip", Text = #equippable > 1 and "EQUIPAR TODO" or "EQUIPAR AHORA", Style = "Primary", TextSize = phone and 18 or 22, Size = UDim2.fromOffset(phone and 220 or 270, phone and 48 or 56), Order = 1, Parent = buttons, Sound = "Equip", OnClick = function()
			if equip:GetAttribute("Done") then
				return
			end
			equip:SetAttribute("Done", true)
			for _, item in equippable do
				StoreData.Equip(item.Kind, item.Id)
			end
			equippedLook(equip)
			local scale = equip:FindFirstChild("FeelScale")
			if scale then
				scale.Scale = 1.15
				tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		end })
		if allEquipped then
			equip:SetAttribute("Done", true)
			equippedLook(equip)
		end
		pop(equip, 0.9, 0.7)
	end
	if payload.Pass and Reveal.OnOpenPass then
		local see = C.button({ Name = "SeePass", Text = "VER PASE", Icon = Icons.Medal, Style = "Primary", TextSize = phone and 18 or 22, Size = UDim2.fromOffset(phone and 200 or 240, phone and 48 or 56), Order = 1, Parent = buttons, OnClick = function()
			close()
			if Reveal.OnOpenPass then
				Reveal.OnOpenPass()
			end
		end })
		pop(see, 0.9, 0.7)
	end
	local continue = C.button({ Name = "Continue", Text = "CONTINUAR", Style = "Ghost", TextSize = phone and 16 or 18, Size = UDim2.fromOffset(phone and 170 or 210, phone and 48 or 56), Order = 2, Parent = buttons, Sound = "Back", OnClick = close })
	pop(continue, 0.95, 0.7)
	return frame
end

function Reveal.Init()
	if gui then
		return
	end
	gui = C.new("ScreenGui", { Name = "PurchaseReveal", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 45, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = player:WaitForChild("PlayerGui") })
	root = C.root(gui, "RevealRoot")
	Remotes.PurchaseGranted.OnClientEvent:Connect(function(payload)
		Reveal.Show(payload)
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if current and not processed and (input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB) then
			close()
		end
	end)
end

return Reveal
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="201">
                <Properties>
                  <string name="Name">StoreData</string>
                  <string name="Source"><![CDATA[-- Datos de la tienda en el cliente: estado de cada objeto (tuyo, equipado, NUEVO), precios reales de
-- Robux (MarketplaceService:GetProductInfo cuando el producto existe), relojes que cuentan hasta la
-- hora real de cambio, analítica y el arranque de las compras:
--   · Robux: la ventana de compra NATIVA de Roblox (PromptProductPurchase). Nada más: el servidor
--     entrega cuando Roblox le manda el recibo y avisa con PurchaseGranted.
--   · Monedas: ventana de confirmación propia (dos pasos: no se compra por un toque sin querer).
-- El cliente nunca da nada: solo pide y enseña lo que el servidor confirma.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Shop = require(Shared.Shop)
local Catalog = require(Shared.Economy.CosmeticCatalog)
local Products = require(Shared.Economy.Products)
local StoreRotation = require(Shared.Economy.StoreRotation)
local BattlePassConfig = require(Shared.Economy.BattlePassConfig)

local ClientState = require(script.Parent.Parent.Parent.ClientState)

local player = Players.LocalPlayer

local StoreData = {}
StoreData.Changed = Instance.new("BindableEvent") -- (compra pendiente que empieza o acaba)

-- Hora del servidor (los relojes de la tienda no dependen del reloj del dispositivo)
function StoreData.Now()
	local ok, now = pcall(function()
		return workspace:GetServerTimeNow()
	end)
	return ok and type(now) == "number" and now > 1e9 and now or os.time()
end

function StoreData.Day()
	return Shop.DayNumber(math.floor(StoreData.Now()))
end

-- "5 H 12 MIN", "2 D 4 H", "12 MIN 03 S"
function StoreData.FormatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	local days = seconds // 86400
	local hours = (seconds % 86400) // 3600
	local minutes = (seconds % 3600) // 60
	if days > 0 then
		return string.format("%d D %d H", days, hours)
	elseif hours > 0 then
		return string.format("%d H %02d MIN", hours, minutes)
	end
	return string.format("%d MIN %02d S", minutes, seconds % 60)
end

function StoreData.IsVIP()
	local data = ClientState.Data
	return data ~= nil and data.VIP == true
end

---------------------------------------------------------------------------
-- Precios de Robux reales
---------------------------------------------------------------------------

local realPrices = {} -- [ProductId] = Robux (lo que dice Roblox)
local asked = {}

local function askPrice(productId, infoType)
	if type(productId) ~= "number" or productId == 0 or asked[productId] then
		return
	end
	asked[productId] = true
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(productId, infoType or Enum.InfoType.Product)
		end)
		if ok and type(info) == "table" and type(info.PriceInRobux) == "number" then
			realPrices[productId] = info.PriceInRobux
			StoreData.Changed:Fire()
		end
	end)
end

-- Precio en Robux de un producto ({ ProductId, Robux }): el real si ya se sabe, si no el de config
function StoreData.Robux(entry, infoType)
	if type(entry) ~= "table" then
		return nil
	end
	askPrice(entry.ProductId, infoType)
	return realPrices[entry.ProductId] or entry.Robux
end

---------------------------------------------------------------------------
-- Estado de un objeto
---------------------------------------------------------------------------

-- "Equipped" | "Owned" | "Buy" | "Soon" (Robux sin id aún) | "Pass" | "Event" | "Locked"
function StoreData.State(item)
	local data = ClientState.Data
	if data and Catalog.Owns(data, item.Kind, item.Id, StoreData.IsVIP()) then
		if Catalog.Equippable(item.Kind, item.Id) and Catalog.IsEquipped(data, item.Kind, item.Id) then
			return "Equipped"
		end
		return "Owned"
	end
	if item.Robux then
		return Products.Enabled(Products.Item(item.Kind, item.Id)) and "Buy" or "Soon"
	end
	if item.Coins then
		return "Buy"
	end
	if item.Source == "Pass" then
		return "Pass"
	end
	if item.Source == "Event" then
		return "Event"
	end
	return "Locked"
end

function StoreData.IsNew(item)
	return Catalog.IsNew(ClientState.Data, item.Kind, item.Id)
end

-- Quita NUEVO de lo que ya se ha visto (se manda al servidor en grupo)
local seenQueue, seenScheduled = {}, false
function StoreData.MarkSeen(keys)
	local data = ClientState.Data
	for _, key in keys do
		if key == "Starter" or (Catalog.IsNewItem(key) and not (data and data.SeenItems and data.SeenItems[key])) then
			seenQueue[key] = true
		end
	end
	if seenScheduled or next(seenQueue) == nil then
		return
	end
	seenScheduled = true
	task.delay(1.5, function()
		seenScheduled = false
		local list = {}
		for key in seenQueue do
			table.insert(list, key)
		end
		table.clear(seenQueue)
		if #list > 0 then
			pcall(function()
				Remotes.MarkSeen:FireServer(list)
			end)
		end
	end)
end

-- Novedades sin ver o tienda diaria nueva (punto rojo de TIENDA: solo cosas nuevas de verdad)
function StoreData.HasNews()
	local data = ClientState.Data
	if not data then
		return false
	end
	for _, item in Catalog.StoreItems() do
		if Catalog.IsNew(data, item.Kind, item.Id) and not Catalog.Owns(data, item.Kind, item.Id, StoreData.IsVIP()) then
			return true
		end
	end
	return false
end

-- Pack de inicio para este jugador (nuevo, sin comprarlo)
function StoreData.StarterVisible()
	local data = ClientState.Data
	return data ~= nil and data.StarterPackEligible == true
end

---------------------------------------------------------------------------
-- Analítica (solo los eventos permitidos; el servidor limita)
---------------------------------------------------------------------------

function StoreData.Track(name, fields)
	pcall(function()
		Remotes.Track:FireServer(name, fields)
	end)
end

---------------------------------------------------------------------------
-- Compras
---------------------------------------------------------------------------

StoreData.Pending = nil -- { ProductId, Key } mientras está abierta la ventana de Roblox

-- Producto con Robux de lo que se quiere comprar: { ProductId, Robux, Key, GamePass }
function StoreData.ProductFor(what)
	if what.Type == "Item" then
		local entry = Products.Item(what.Item.Kind, what.Item.Id)
		return entry and { ProductId = entry.ProductId, Robux = entry.Robux, Key = what.Item.Key }
	elseif what.Type == "Bundle" then
		return { ProductId = what.Bundle.ProductId, Robux = what.Bundle.Robux, Key = "Bundle:" .. what.Bundle.Id }
	elseif what.Type == "Starter" then
		return { ProductId = Shop.StarterPack.ProductId, Robux = Shop.StarterPack.Robux, Key = "Starter" }
	elseif what.Type == "Coins" or what.Type == "Booster" then
		return { ProductId = what.Def.ProductId, Robux = what.Def.Robux, Key = what.Type .. ":" .. tostring(what.Def.Name or what.Def.Id) }
	elseif what.Type == "PassPremium" then
		local season = BattlePassConfig.Get(what.Season)
		return season and { ProductId = season.Premium.ProductId, Robux = season.Premium.Robux, Key = "Pass:" .. season.Id }
	elseif what.Type == "TierSkip" then
		return { ProductId = Products.TierSkip.ProductId, Robux = Products.TierSkip.Robux, Key = "TierSkip" }
	elseif what.Type == "VIP" then
		return { ProductId = Shop.VIPPassId, Robux = Shop.VIPRobux, Key = "VIP", GamePass = true }
	end
	return nil
end

-- Abre la ventana de compra de Roblox. Devuelve false, motivo si no se puede.
function StoreData.PromptRobux(what)
	local product = StoreData.ProductFor(what)
	if not product or not Products.Enabled(product) then
		return false, "PRÓXIMAMENTE"
	end
	if StoreData.Pending then
		return false, "COMPRA EN CURSO"
	end
	local pending = { ProductId = product.ProductId, Key = product.Key, Started = os.clock() }
	StoreData.Pending = pending
	StoreData.Changed:Fire()
	-- (si Roblox no avisara de que se cerró la ventana, el botón no se queda bloqueado)
	task.delay(90, function()
		if StoreData.Pending == pending then
			StoreData.Pending = nil
			StoreData.Changed:Fire()
		end
	end)
	StoreData.Track("purchase_prompt", { key = product.Key, robux = product.Robux })
	local ok = pcall(function()
		if product.GamePass then
			MarketplaceService:PromptGamePassPurchase(player, product.ProductId)
		else
			MarketplaceService:PromptProductPurchase(player, product.ProductId)
		end
	end)
	if not ok then
		StoreData.Pending = nil
		StoreData.Changed:Fire()
		return false, "NO SE PUDO ABRIR LA COMPRA"
	end
	return true
end

-- Compra con monedas (después de confirmar). Devuelve ok, mensaje.
local buying = false
function StoreData.BuyWithCoins(item)
	if buying then
		return false, "Espera un momento"
	end
	buying = true
	StoreData.Track("purchase_prompt", { key = item.Key, coins = item.Coins })
	local ok, result, message = pcall(function()
		return Remotes.BuyItem:InvokeServer(item.Kind, item.Id)
	end)
	buying = false
	if not ok then
		return false, "Error de conexión"
	end
	if not result then
		StoreData.Track("purchase_cancel", { key = item.Key, reason = "server" })
	end
	return result == true, message
end

function StoreData.Equip(kind, id)
	pcall(function()
		Remotes.EquipCosmetic:FireServer(kind, id)
	end)
end

-- Lo de hoy en la tienda (todos ven lo mismo)
function StoreData.Daily()
	local list = {}
	for _, entry in StoreRotation.Daily(StoreData.Day()) do
		local item = Catalog.Item(entry.Kind, entry.Id, StoreData.Day())
		if item then
			table.insert(list, item)
		end
	end
	return list
end

local initialized = false
function StoreData.Init()
	if initialized then
		return
	end
	initialized = true
	-- La ventana de Roblox se cerró: si no compró, se dice (y se apunta); si compró, se espera a
	-- que el servidor lo entregue (PurchaseGranted)
	MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, purchased)
		local pending = StoreData.Pending
		if userId ~= player.UserId or not pending or pending.ProductId ~= productId then
			return
		end
		if not purchased then
			StoreData.Track("purchase_cancel", { key = pending.Key })
		end
		StoreData.Pending = nil
		StoreData.Changed:Fire(purchased and "Waiting" or "Cancelled")
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(who, passId, purchased)
		local pending = StoreData.Pending
		if who ~= player or not pending or pending.ProductId ~= passId then
			return
		end
		if not purchased then
			StoreData.Track("purchase_cancel", { key = pending.Key })
		end
		StoreData.Pending = nil
		StoreData.Changed:Fire(purchased and "Waiting" or "Cancelled")
	end)
end

return StoreData
]]></string>
                </Properties>
              </Item>
            </Item>
            <Item class="ModuleScript" referent="202">
              <Properties>
                <string name="Name">Theme</string>
                <string name="Source"><![CDATA[-- Identidad visual del flujo de entrada (lobby → partida): negro grafito, amarillo intenso (jugar,
-- acciones importantes, premios, selección), rojo (combate, eventos, alertas), blanco y un poco de
-- azul. Dos familias de letra: Oswald en negrita (títulos, botones y números) y Gotham (textos).
local Theme = {}

local RGB = Color3.fromRGB

Theme.Colors = {
	Bg = RGB(10, 11, 14),
	Panel = RGB(18, 20, 25),
	PanelLight = RGB(30, 33, 40),
	PanelHover = RGB(40, 44, 54),
	Line = RGB(255, 255, 255),
	Yellow = RGB(255, 198, 26),
	YellowDark = RGB(214, 150, 0),
	YellowText = RGB(255, 214, 72),
	Red = RGB(226, 38, 44),
	RedDark = RGB(140, 18, 24),
	Blue = RGB(54, 140, 255),
	Green = RGB(70, 214, 120),
	White = RGB(255, 255, 255),
	Text = RGB(238, 240, 244),
	TextDim = RGB(160, 166, 178),
	TextFaint = RGB(110, 116, 128),
	Black = RGB(0, 0, 0),
}

-- Transparencias de los paneles (oscuros y semitransparentes, con borde fino)
Theme.PanelAlpha = 0.18
Theme.LineAlpha = 0.86

-- Letras
local function font(path, weight, style)
	local ok, f = pcall(function()
		return Font.new(path, weight, style or Enum.FontStyle.Normal)
	end)
	return ok and f or nil
end
Theme.Fonts = {
	Title = font("rbxasset://fonts/families/Oswald.json", Enum.FontWeight.Bold),
	TitleItalic = font("rbxasset://fonts/families/Oswald.json", Enum.FontWeight.Bold, Enum.FontStyle.Italic),
	Number = font("rbxasset://fonts/families/Oswald.json", Enum.FontWeight.SemiBold),
	Body = font("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium),
	BodyBold = font("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold),
}
-- (respaldo si Font.new no existe: enumeraciones de siempre)
Theme.FontEnums = {
	Title = Enum.Font.Oswald,
	TitleItalic = Enum.Font.Oswald,
	Number = Enum.Font.Oswald,
	Body = Enum.Font.Gotham,
	BodyBold = Enum.Font.GothamBold,
}

-- Tamaños (en píxeles virtuales: la raíz se escala según la pantalla, ver Components.root)
Theme.Size = {
	Hero = 72,
	Title = 40,
	Subtitle = 24,
	Body = 16,
	Small = 13,
	Stat = 20,
}

-- Duraciones de las animaciones (rápidas: nada debe sentirse lento)
Theme.Time = {
	Hover = 0.1,
	Press = 0.08,
	Release = 0.16,
	Fast = 0.18,
	Normal = 0.3,
	Screen = 0.45,
	Stat = 0.25,
}

return Theme
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="203">
              <Properties>
                <string name="Name">Transition</string>
                <string name="Source"><![CDATA[-- UITransitionController: todas las transiciones del flujo pasan por aquí (fundido, deslizar,
-- escala, destello y desenfoque), con duraciones cortas y coherentes. Las pantallas no aparecen
-- de golpe ni se quedan esperando a que acabe una animación larga.
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local Transition = {}

local fxLayer -- Frame a pantalla completa por encima de todo (destellos)
local blur

local function tween(inst, time, props, style, direction)
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end
Transition.Tween = tween

-- Capa de efectos (la pone el FlowController: un ScreenGui con DisplayOrder alto)
function Transition.SetLayer(frame)
	fxLayer = frame
end

-- Fundido de un CanvasGroup (o de cualquier objeto con GroupTransparency)
function Transition.FadeIn(group, time)
	group.Visible = true
	group.GroupTransparency = 1
	return tween(group, time or Theme.Time.Normal, { GroupTransparency = 0 })
end

function Transition.FadeOut(group, time, hideAfter)
	local t = tween(group, time or Theme.Time.Fast, { GroupTransparency = 1 })
	if hideAfter ~= false then
		t.Completed:Once(function(state)
			if state == Enum.PlaybackState.Completed and group.GroupTransparency > 0.99 then
				group.Visible = false
			end
		end)
	end
	return t
end

-- Entra deslizando desde un desplazamiento (en píxeles virtuales) hasta su sitio
function Transition.SlideIn(frame, offset, time, delayTime)
	-- Mientras desliza, su sitio es el guardado (repetir a media animación no lo desplaza); si
	-- está quieto, su sitio es donde está ahora (por si la pantalla cambió de tamaño)
	local target = frame:GetAttribute("RestPosition")
	if not frame:GetAttribute("Sliding") or typeof(target) ~= "UDim2" then
		target = frame.Position
		frame:SetAttribute("RestPosition", target)
	end
	local slide = (frame:GetAttribute("SlideToken") or 0) + 1
	frame:SetAttribute("SlideToken", slide)
	frame:SetAttribute("Sliding", true)
	frame.Position = target + UDim2.fromOffset(offset.X, offset.Y)
	local duration = time or Theme.Time.Normal
	local function go()
		tween(frame, duration, { Position = target }, Enum.EasingStyle.Quint)
	end
	if delayTime and delayTime > 0 then
		task.delay(delayTime, go)
	else
		go()
	end
	task.delay((delayTime or 0) + duration + 0.05, function()
		if frame:GetAttribute("SlideToken") == slide then
			frame:SetAttribute("Sliding", nil)
		end
	end)
	return target
end

-- Aparece creciendo un poco (UIScale propia "PopScale")
function Transition.Pop(frame, from, time, delayTime)
	local scale = frame:FindFirstChild("PopScale") or Instance.new("UIScale")
	scale.Name = "PopScale"
	scale.Parent = frame
	scale.Scale = from or 0.9
	local function go()
		tween(scale, time or Theme.Time.Fast, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	if delayTime and delayTime > 0 then
		task.delay(delayTime, go)
	else
		go()
	end
	return scale
end

-- Latido corto (cuenta atrás, número que cambia)
function Transition.Pulse(frame, amount, time)
	local scale = frame:FindFirstChild("PopScale") or Instance.new("UIScale")
	scale.Name = "PopScale"
	scale.Parent = frame
	scale.Scale = amount or 1.25
	return tween(scale, time or 0.25, { Scale = 1 }, Enum.EasingStyle.Quad)
end

-- Destello a pantalla completa (amarillo al pulsar JUGAR, blanco al encontrar partida)
function Transition.Flash(color, strength, time)
	if not fxLayer then
		return
	end
	local flash = Instance.new("Frame")
	flash.Name = "Flash"
	flash.Size = UDim2.fromScale(1, 1)
	flash.BorderSizePixel = 0
	flash.BackgroundColor3 = color or Theme.Colors.Yellow
	flash.BackgroundTransparency = 1 - (strength or 0.35)
	flash.ZIndex = 50
	flash.Parent = fxLayer
	local t = tween(flash, time or 0.35, { BackgroundTransparency = 1 })
	t.Completed:Once(function()
		flash:Destroy()
	end)
	return flash
end

-- Desenfoque del mundo detrás de los menús (nunca durante el combate)
function Transition.Blur(size, time)
	if not blur or not blur.Parent then
		-- (la pantalla de arranque deja el suyo con el mismo nombre: se reutiliza)
		blur = Lighting:FindFirstChild("FlowBlur")
	end
	if not blur or not blur.Parent then
		blur = Instance.new("BlurEffect")
		blur.Name = "FlowBlur"
		blur.Size = 0
		blur.Parent = Lighting
	end
	local t = tween(blur, time or Theme.Time.Fast, { Size = size })
	if size <= 0 then
		t.Completed:Once(function(state)
			if state == Enum.PlaybackState.Completed and blur and blur.Size <= 0.01 then
				blur:Destroy()
				blur = nil
			end
		end)
	end
	return t
end

-- Barra que cruza la pantalla (cambio de pantalla grande: partida encontrada, equipos)
function Transition.Wipe(color, time)
	if not fxLayer then
		return
	end
	local bar = Instance.new("Frame")
	bar.Name = "Wipe"
	bar.AnchorPoint = Vector2.new(0, 0.5)
	bar.Position = UDim2.fromScale(-1.2, 0.5)
	bar.Size = UDim2.new(1.2, 0, 0.36, 0)
	bar.Rotation = -8
	bar.BorderSizePixel = 0
	bar.BackgroundColor3 = color or Theme.Colors.Yellow
	bar.ZIndex = 49
	bar.Parent = fxLayer
	local t = tween(bar, time or 0.45, { Position = UDim2.fromScale(1.1, 0.5) }, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
	t.Completed:Once(function()
		bar:Destroy()
	end)
	return t
end

return Transition
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="204">
              <Properties>
                <string name="Name">UISound</string>
                <string name="Source"><![CDATA[-- UISoundController: todos los sonidos de la interfaz del flujo salen de aquí (ningún botón crea
-- su propio Sound). Un Sound por nombre en SoundService, reutilizado; el "pasar por encima" tiene
-- un mínimo entre reproducciones para no sonar a ametralladora al barrer una lista.
local SoundService = game:GetService("SoundService")

local UISound = {}

-- Sonidos de Roblox: los de interfaz son el set oficial de Roblox (RBLX UI / Roblox GUI / Roblox_UI,
-- creador Roblox, dominio público; comprobados con la API de Roblox en la Fase 11). Los volúmenes
-- compensan que unos están grabados más altos que otros. El tono y el volumen los adaptan.
local DEFS = {
	Hover = { Id = "rbxassetid://10066942189", Volume = 0.3, Pitch = 1 }, -- RBLX UI Hover 03
	Click = { Id = "rbxassetid://15675059323", Volume = 0.32, Pitch = 1 }, -- Roblox_UI_Bright_Click
	Back = { Id = "rbxassetid://10066914500", Volume = 0.75, Pitch = 1 }, -- RBLX UI Back
	Play = { Id = "rbxassetid://10128760939", Volume = 0.85, Pitch = 1 }, -- RBLX UI Select 01
	Whoosh = { Id = "rbxassetid://15675012262", Volume = 0.28, Pitch = 1 }, -- Roblox_UI_Whoosh_04
	MatchFound = { Id = "rbxassetid://3149249837", Volume = 0.55, Pitch = 1.15 },
	MatchFoundPing = { Id = "rbxassetid://17208361335", Volume = 0.4, Pitch = 1 }, -- Roblox GUI - Notification High
	Reward = { Id = "rbxassetid://17208361335", Volume = 0.32, Pitch = 1.08 },
	Error = { Id = "rbxassetid://15675075163", Volume = 0.3, Pitch = 1 }, -- Roblox_UI_Delete
	Equip = { Id = "rbxassetid://17208323435", Volume = 0.38, Pitch = 1 }, -- Roblox GUI - Equip
	Countdown = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.45, Pitch = 1 },
	Go = { Id = "rbxassetid://3149249837", Volume = 0.5, Pitch = 1.45 },
	Join = { Id = "rbxassetid://10066968815", Volume = 0.6, Pitch = 1 }, -- RBLX UI Select 02
	Tick = { Id = "rbxassetid://15675032796", Volume = 0.18, Pitch = 1.1 }, -- Roblox_UI_Small_Click
	-- Pantalla final
	Victory = { Id = "rbxassetid://3149249837", Volume = 0.6, Pitch = 0.85 }, -- impacto grave
	VictorySting = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.5, Pitch = 1.05 },
	Defeat = { Id = "rbxassetid://3149249837", Volume = 0.32, Pitch = 0.62 }, -- impacto suave
	MVP = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.55, Pitch = 1.5 },
	RewardPop = { Id = "rbxassetid://15675032796", Volume = 0.32, Pitch = 1.2 },
	LevelUp = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.6, Pitch = 0.75 },
	Unlock = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.4, Pitch = 1.6 },
	-- Tienda
	Purchase = { Id = "rbxassetid://10066947742", Volume = 0.55, Pitch = 1 }, -- RBLX UI Purchase
	Claim = { Id = "rbxassetid://17208361335", Volume = 0.35, Pitch = 1.15 },
}
UISound.Defs = DEFS

-- Audio propio de la interfaz (Fase 4). TODO: AÑADIR AUDIO PROPIO (grabado o con licencia; nunca
-- sacado de otros juegos). Pon aquí "rbxassetid://<id>" para sustituir el sonido genérico de ese
-- nombre; vacío = el de arriba. Con sonido propio no se cambia el tono (se grabó así).
UISound.Custom = {
	Hover = "",
	Click = "",
	Back = "",
	Play = "",
	MatchFound = "",
	Countdown = "",
	Go = "",
	Reward = "",
	Equip = "",
	Purchase = "",
	Error = "",
	Victory = "",
	Defeat = "",
	LevelUp = "",
}
local function customId(name)
	local id = UISound.Custom[name]
	return type(id) == "string" and id ~= "" and id or nil
end

local sounds = {}
local lastPlayed = {}
local MIN_GAP = { Hover = 0.06, Tick = 0.04 }

local function get(name)
	local sound = sounds[name]
	if sound and sound.Parent then
		return sound
	end
	local def = DEFS[name]
	if not def then
		return nil
	end
	sound = Instance.new("Sound")
	sound.Name = "UI_" .. name
	sound.SoundId = customId(name) or def.Id
	sound.Volume = def.Volume
	sound.PlaybackSpeed = def.Pitch
	sound.Parent = SoundService
	sounds[name] = sound
	return sound
end

-- pitch: multiplicador opcional (la cuenta atrás sube de tono en cada número)
function UISound.Play(name, pitch, volume)
	local def = DEFS[name]
	if not def then
		return
	end
	local now = os.clock()
	local gap = MIN_GAP[name]
	if gap and lastPlayed[name] and now - lastPlayed[name] < gap then
		return
	end
	lastPlayed[name] = now
	local sound = get(name)
	if not sound then
		return
	end
	sound.PlaybackSpeed = customId(name) and (pitch or 1) or def.Pitch * (pitch or 1)
	sound.Volume = def.Volume * (volume or 1)
	sound.TimePosition = 0
	sound:Play()
	return sound
end

-- Sonido compuesto (golpe + campanilla): partida encontrada
function UISound.MatchFound()
	UISound.Play("MatchFound")
	UISound.Play("MatchFoundPing")
end

-- Los ids que conviene precargar en el arranque
function UISound.Assets()
	local list = {}
	for _, name in { "Click", "Hover", "Play", "MatchFound", "MatchFoundPing", "Countdown", "Go" } do
		local sound = get(name)
		if sound then
			table.insert(list, sound)
		end
	end
	return list
end

return UISound
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="205">
            <Properties>
              <string name="Name">Footprints</string>
              <string name="Source"><![CDATA[-- Huellas en superficies blandas (nieve, arena, barro, tierra): solo en el cliente, para los
-- personajes cercanos (jugadores y bots). Se desvanecen solas y hay un máximo para no gastar memoria. En calidad Baja
-- no se crean.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local ClientState = require(script.Parent.ClientState)

local Footprints = {}

-- Color de la huella según el material que pisa (algo más oscuro que la superficie)
local SOFT = {
	[Enum.Material.Snow] = Color3.fromRGB(184, 194, 214),
	[Enum.Material.Sand] = Color3.fromRGB(140, 120, 88),
	[Enum.Material.Mud] = Color3.fromRGB(58, 44, 30),
	[Enum.Material.Ground] = Color3.fromRGB(80, 66, 46),
}
local STEP_DISTANCE = 2.6 -- studs entre pisadas
local MAX_PRINTS = 70
local LIFETIME = 9
local MAX_DISTANCE = 90 -- solo personajes cerca de la cámara
local CHECK_INTERVAL = 0.08

local folder
local prints = {}
local tracked = {} -- [character] = { Last = Vector3, Left = boolean }

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function removePrint(part)
	local index = table.find(prints, part)
	if index then
		table.remove(prints, index)
	end
	part:Destroy()
end

local function addPrint(cf, color)
	if #prints >= MAX_PRINTS then
		removePrint(prints[1])
	end
	local part = Instance.new("Part")
	part.Name = "Footprint"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.SmoothPlastic
	part.Color = color
	part.Size = Vector3.new(0.65, 0.04, 1.1)
	part.Transparency = 0.35
	part.CFrame = cf
	part.Parent = folder
	table.insert(prints, part)
	-- Se mantiene un rato y luego se borra poco a poco (como la nieve que cae encima)
	local fade = TweenInfo.new(LIFETIME * 0.6, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, LIFETIME * 0.4)
	TweenService:Create(part, fade, { Transparency = 1 }):Play()
	task.delay(LIFETIME, function()
		if part.Parent then
			removePrint(part)
		end
	end)
end

local function step(character, humanoid, root, state)
	local flat = Vector3.new(1, 0, 1)
	local moved = (root.Position - state.Last) * flat
	if moved.Magnitude < STEP_DISTANCE then
		return
	end
	state.Last = root.Position
	-- El material sale del rayo hacia el suelo (FloorMaterial solo se calcula para tu personaje);
	-- si no hay suelo cerca (saltando) no hay huella
	rayParams.FilterDescendantsInstances = { folder, character }
	local result = workspace:Raycast(root.Position, Vector3.new(0, -(humanoid.HipHeight + root.Size.Y / 2 + 1), 0), rayParams)
	local color = result and SOFT[result.Material]
	if not color then
		return
	end
	local normal = result.Normal
	local forward = moved.Unit
	forward = (forward - normal * forward:Dot(normal))
	if forward.Magnitude < 0.01 then
		return
	end
	forward = forward.Unit
	local right = forward:Cross(normal)
	state.Left = not state.Left
	local position = result.Position + normal * 0.02 + right * (state.Left and -0.45 or 0.45)
	addPrint(CFrame.fromMatrix(position, right, normal, -forward), color)
end

function Footprints.Init()
	folder = Instance.new("Folder")
	folder.Name = "Footprints"
	folder.Parent = workspace

	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < CHECK_INTERVAL then
			return
		end
		elapsed = 0
		if ClientState.EffectiveQuality == "Baja" then
			return
		end
		local camera = workspace.CurrentCamera
		local seen = {}
		local characters = {}
		for _, player in Players:GetPlayers() do
			if player.Character then
				table.insert(characters, player.Character)
			end
		end
		-- (los bots también dejan huellas)
		local bots = workspace:FindFirstChild("Bots")
		if bots then
			for _, model in bots:GetChildren() do
				table.insert(characters, model)
			end
		end
		for _, character in characters do
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if humanoid and root and humanoid.Health > 0 and camera and (root.Position - camera.CFrame.Position).Magnitude < MAX_DISTANCE then
				seen[character] = true
				local state = tracked[character]
				if not state then
					state = { Last = root.Position, Left = false }
					tracked[character] = state
				end
				step(character, humanoid, root, state)
			end
		end
		for character in tracked do
			if not seen[character] then
				tracked[character] = nil
			end
		end
	end)
end

return Footprints
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="206">
            <Properties>
              <string name="Name">Graffiti</string>
              <string name="Source"><![CDATA[-- Grafitis (tecla J, o el botón 🎨 en móvil): pinta tu grafiti equipado en la pared o el suelo que
-- tienes delante. El servidor (Graffiti) comprueba el punto y lo pinta para todos.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Sprays = require(Shared.Sprays)
local Sounds = require(Shared.Sounds)

local TouchLayout = require(script.Parent.TouchLayout)
local ClientState = require(script.Parent.ClientState)

local player = Players.LocalPlayer

local Graffiti = {}

local lastSpray = -math.huge
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function spray()
	if ClientState.IsBlocked() then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	if os.clock() - lastSpray < Sprays.Cooldown then
		return
	end
	local camera = workspace.CurrentCamera
	local ignore = { character }
	for _, other in Players:GetPlayers() do
		if other.Character then
			table.insert(ignore, other.Character)
		end
	end
	rayParams.FilterDescendantsInstances = ignore
	local origin = camera.CFrame.Position
	local hit = workspace:Raycast(origin, camera.CFrame.LookVector * (Sprays.Range + 4), rayParams)
	local head = character:FindFirstChild("Head")
	-- (el servidor solo pinta en cosas fijas: si no, ni sonido ni recarga)
	if not hit or not head or (hit.Position - head.Position).Magnitude > Sprays.Range or not hit.Instance.Anchored then
		return
	end
	lastSpray = os.clock()
	Remotes.Spray:FireServer(hit.Position)
	Sounds.Play("Slide", nil, 1.6, 0.5) -- "pssst" del bote
end

function Graffiti.Init()
	TouchLayout.BindAction("Spray", function(_, state)
		if state == Enum.UserInputState.Begin then
			spray()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.J, Enum.KeyCode.ButtonR1) -- (R1 en el mando)
	TouchLayout.Set("Spray", UDim2.new(1, -200, 1, -340))
end

return Graffiti
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="207">
            <Properties>
              <string name="Name">GrenadeController</string>
              <string name="Source"><![CDATA[-- Granada en el cliente: tecla G (L1 en mando, botón en móvil), indicador de recarga y explosiones.
-- Como en los shooters realistas, se puede "cocinar": un toque la lanza enseguida; manteniendo la
-- tecla se le quita la anilla y la mecha corre (pitidos cada vez más rápidos y cuenta atrás) y al
-- soltar sale con menos tiempo para que el enemigo no pueda escapar. Si se acaba, sale sola.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weapons = require(Shared.Weapons)
local Icons = require(Shared.Icons)
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)

local TouchLayout = require(script.Parent.TouchLayout)
local ClientState = require(script.Parent.ClientState)
local Effects = require(script.Parent.Effects)
local UI = require(script.Parent.UI)
local IconText = require(script.Parent.IconText)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local GrenadeController = {}

local DEF = Weapons.Grenade

local widget, label, fill
local touchOnly = false
local cookStart = nil -- os.clock() al quitar la anilla (cocinando)
local nextBeep = 0
local AUTO_THROW = 0.25 -- (si queda tan poca mecha, sale sola)

local function readyAt()
	return player:GetAttribute("GrenadeReadyAt") or 0
end

local function canThrow()
	if ClientState.IsBlocked() or ClientState.Frozen() or ReplicatedStorage:GetAttribute("Mode") == "GUN" then
		return false
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0 and workspace:GetServerTimeNow() >= readyAt()
end

local function throw(cook)
	if not canThrow() then
		return
	end
	-- Un poco hacia arriba para que la parábola llegue más lejos
	local direction = (camera.CFrame.LookVector + Vector3.new(0, 0.12, 0)).Unit
	Remotes.ThrowGrenade:FireServer(direction, cook or 0)
	Sounds.Play("Swing", nil, 0.8, 1)
end

-- Quitar la anilla (empieza a cocinarse)
local function startCook()
	if cookStart or not canThrow() then
		return
	end
	cookStart = os.clock()
	nextBeep = cookStart + 0.5
	Remotes.GrenadePin:FireServer()
	Sounds.Play("Click", nil, 1.7, 0.7)
end

-- Soltar: sale con el tiempo que lleva cocinándose
local function release()
	if not cookStart then
		return
	end
	local cook = math.clamp(os.clock() - cookStart, 0, DEF.Fuse - AUTO_THROW)
	cookStart = nil
	throw(cook)
end

-- Segundos de mecha que le quedan a la granada que se está cocinando (nil si no hay)
function GrenadeController.CookLeft()
	return cookStart and math.max(0, DEF.Fuse - (os.clock() - cookStart)) or nil
end

local lastKey
local lastGunGame = nil
local function updateWidget()
	local gunGame = ReplicatedStorage:GetAttribute("Mode") == "GUN"
	local active = not ClientState.InMainMenu and not gunGame
	-- (con pantalla táctil el cartel no sale: está el botón 💣, que tampoco sale en la Escalada)
	widget.Visible = active and not touchOnly
	-- (el botón táctil lo enseña TouchLayout con sus reglas: menús, editor de HUD, muerte. Aquí solo
	-- se esconde en la Escalada de armas, y solo al cambiar. Antes se escribía su Visible en cada
	-- fotograma y, con el editor de HUD abierto, la granada desaparecía y no se podía colocar)
	if touchOnly and gunGame ~= lastGunGame then
		lastGunGame = gunGame
		TouchLayout.SetHidden("Grenade", gunGame)
	end
	if not active then
		cookStart = nil
		return
	end
	-- Cocinando: pitidos cada vez más rápidos y, si se acaba la mecha, sale sola
	if cookStart then
		if not canThrow() then
			cookStart = nil -- (muerto, bloqueado...)
		else
			local fuseLeft = DEF.Fuse - (os.clock() - cookStart)
			if fuseLeft <= AUTO_THROW then
				release()
			else
				if os.clock() >= nextBeep then
					Sounds.Play("Click", nil, 2.2, 0.5)
					nextBeep = os.clock() + math.clamp(fuseLeft * 0.25, 0.12, 0.5)
				end
				local key = -1000 - math.floor(fuseLeft * 10)
				if key ~= lastKey then
					lastKey = key
					label.Text = string.format("💣 %.1f", fuseLeft)
					label.TextColor3 = Color3.fromRGB(255, 220, 120)
					fill.Size = UDim2.fromScale(fuseLeft / DEF.Fuse, 1)
					fill.BackgroundColor3 = Color3.fromRGB(230, 40, 30)
					if touchOnly then
						pcall(function()
							TouchLayout.SetBadge("Grenade", string.format("%.1f", fuseLeft))
						end)
					end
				end
				return
			end
		end
	end
	local left = readyAt() - workspace:GetServerTimeNow()
	-- (solo se escribe cuando cambia el segundo o la barra en pasos de 1/40)
	local key = left <= 0 and -1 or math.ceil(left) * 100 + math.floor((1 - left / DEF.Cooldown) * 40)
	if key == lastKey then
		return
	end
	lastKey = key
	-- (en pantallas táctiles, en el propio botón: velo que baja con los segundos que faltan)
	if touchOnly then
		pcall(function()
			TouchLayout.SetBadge("Grenade", nil)
			TouchLayout.SetCooldown("Grenade", left > 0 and left / DEF.Cooldown or 0, tostring(math.ceil(math.max(left, 0))))
		end)
	end
	if left <= 0 then
		label.Text = "💣 G"
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		fill.Size = UDim2.fromScale(1, 1)
		fill.BackgroundColor3 = Color3.fromRGB(255, 90, 40)
	else
		label.Text = "💣 " .. math.ceil(left)
		label.TextColor3 = Color3.fromRGB(190, 190, 200)
		fill.Size = UDim2.fromScale(1 - left / DEF.Cooldown, 1)
		fill.BackgroundColor3 = Color3.fromRGB(90, 90, 110)
	end
end

function GrenadeController.Init()
	local gui = UI.new("ScreenGui", {
		Name = "Grenade",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 2,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- (con pantalla táctil no se ve: quedaba encima de los botones; ahí está el botón 💣)
	touchOnly = InputMode.TouchUI()
	widget = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -150),
		Size = UDim2.fromOffset(84, 34),
		Visible = not touchOnly,
		BackgroundColor3 = Color3.fromRGB(20, 22, 34),
		BackgroundTransparency = 0.25,
		Parent = gui,
	}, { UI.corner(10), UI.stroke(Color3.fromRGB(255, 120, 60), 2, 0.3) })
	fill = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 0.55,
		Parent = widget,
	}, { UI.corner(10) })
	label = UI.label({ Size = UDim2.fromScale(1, 1), Text = "💣 G", TextSize = 20, ZIndex = 2, Parent = widget })
	IconText.Bind(label, "💣", Icons.Grenade, 1.3)

	TouchLayout.BindAction("Grenade", function(_, state)
		if state == Enum.UserInputState.Begin then
			startCook()
		elseif state == Enum.UserInputState.End then
			release()
		elseif state == Enum.UserInputState.Cancel then
			-- (otra cosa se quedó la tecla, p. ej. se abrió un menú: no se lanza, se vuelve a poner la anilla)
			cookStart = nil
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.G, Enum.KeyCode.ButtonL1)
	TouchLayout.Set("Grenade", UDim2.new(1, -200, 1, -270))

	Remotes.ExplosionFX.OnClientEvent:Connect(function(position, radius)
		if typeof(position) == "Vector3" then
			-- Sonido en el punto de la explosión (se oye más fuerte cuanto más cerca). Antes del efecto: si
			-- te aturde, el estampido se oye entero y luego todo se apaga
			local spot = Instance.new("Attachment")
			spot.WorldPosition = position
			spot.Parent = workspace.Terrain
			local bang = Sounds.Play("ShotHeavy", spot, 0.45, 1.6)
			if bang then
				bang.SoundGroup = nil
			end
			Debris:AddItem(spot, 5)
			Effects.Explosion(position, type(radius) == "number" and radius or 14)
		end
	end)

	RunService.Heartbeat:Connect(updateWidget)
	GrenadeController.Tick = updateWidget -- (pruebas: un fotograma)
end

return GrenadeController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="208">
            <Properties>
              <string name="Name">GrenadeWarning</string>
              <string name="Source"><![CDATA[-- Aviso de granada cercana (como en los shooters): cuando una granada enemiga cae cerca, sale un
-- icono de granada (dibujado, Fase 17: sin emoji) alrededor de la mira, en la dirección en la que está, más rojo cuanto más cerca.
-- No avisa de las tuyas ni de las de tu equipo (no te hacen daño).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weapons = require(Shared.Weapons)

local UI = require(script.Parent.UI)
local TouchIcons = require(script.Parent.TouchIcons)
local ClientState = require(script.Parent.ClientState)

local GrenadeWarning = {}

local MAX_ICONS = 3
local RING = 110 -- píxeles desde el centro de la pantalla

local player = Players.LocalPlayer
local gui
local icons = {}

local function warnRadius()
	local def = Weapons.Grenade
	return ((def and def.Explosive and def.Explosive.Radius) or 16) + 4
end

local function isThreat(grenade)
	if grenade:GetAttribute("Thrower") == player.Name then
		return false
	end
	if ReplicatedStorage:GetAttribute("TeamMode") == false then
		return true
	end
	local team = grenade:GetAttribute("Team")
	return team == nil or team == "" or player.Team == nil or team ~= player.Team.Name
end

local function makeIcon()
	local icon = UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(44, 44),
		Text = "",
		TextSize = 26,
		BackgroundColor3 = Color3.fromRGB(200, 30, 30),
		BackgroundTransparency = 0.25,
		Visible = false,
		Parent = gui,
	}, { UI.corner(22), UI.stroke(Color3.fromRGB(255, 230, 200), 2, 0.1) })
	-- (la granada dibujada con las mismas piezas que el botón de granada)
	local glyph = Instance.new("Frame")
	glyph.Name = "Glyph"
	glyph.AnchorPoint = Vector2.new(0.5, 0.5)
	glyph.Position = UDim2.fromScale(0.5, 0.5)
	glyph.Size = UDim2.fromScale(0.58, 0.58)
	glyph.BackgroundTransparency = 1
	glyph.Parent = icon
	TouchIcons.Draw("Grenade", glyph, 26)
	TouchIcons.Tint(glyph, Color3.new(1, 1, 1))
	return icon
end

local function update()
	local folder = workspace:FindFirstChild("Grenades")
	local camera = workspace.CurrentCamera
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local used = 0
	if folder and camera and root and humanoid and humanoid.Health > 0 and not ClientState.InMainMenu then
		local radius = warnRadius()
		local viewport = camera.ViewportSize
		local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
		for _, grenade in folder:GetChildren() do
			if used >= MAX_ICONS then
				break
			end
			if grenade:IsA("BasePart") and isThreat(grenade) then
				local distance = (grenade.Position - root.Position).Magnitude
				if distance < radius then
					used += 1
					local icon = icons[used]
					-- Dirección de la granada vista desde la cámara (en el plano: delante = arriba)
					local relative = camera.CFrame:PointToObjectSpace(grenade.Position)
					local flat = Vector2.new(relative.X, relative.Z)
					local angle = flat.Magnitude > 0.01 and math.atan2(flat.X, -flat.Y) or 0
					local position = center + Vector2.new(math.sin(angle), -math.cos(angle)) * RING
					icon.Position = UDim2.fromOffset(position.X, position.Y)
					local danger = 1 - distance / radius
					icon.BackgroundTransparency = 0.6 - 0.45 * danger
					icon.Size = UDim2.fromOffset(38 + 14 * danger, 38 + 14 * danger)
					icon.Visible = true
				end
			end
		end
	end
	for i = used + 1, MAX_ICONS do
		icons[i].Visible = false
	end
end

function GrenadeWarning.Init()
	gui = UI.new("ScreenGui", {
		Name = "GrenadeWarning",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 3,
		Parent = player:WaitForChild("PlayerGui"),
	})
	for i = 1, MAX_ICONS do
		icons[i] = makeIcon()
	end
	RunService.Heartbeat:Connect(update)
end

GrenadeWarning.Update = update
return GrenadeWarning
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="209">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[-- Interfaz en partida: marcador, mira, munición, vida, racha, killfeed, avisos y pantallas de ronda.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weapons = require(Shared.Weapons)
local Icons = require(Shared.Icons)
local GameConfig = require(Shared.GameConfig)
local Skins = require(Shared.Skins)
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)
local Ranks = require(Shared.Ranks)
local MobileHUD = require(Shared.MobileHUD)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local WeaponController = require(script.Parent.WeaponController)
local WeaponIcon = require(script.Parent.WeaponIcon)
local Settings = require(script.Parent.Settings)
local RewardFX = require(script.Parent.RewardFX)
local ScopeSway = require(script.Parent.ScopeSway)
local TouchLayout = require(script.Parent.TouchLayout)
local HUDZones = require(script.Parent.HUDZones)

local player = Players.LocalPlayer

local HUD = {}

local gui
local refs = {}
-- Teléfono (táctil y pantalla baja, ver UI.IsPhone): disposición propia para que nada pise los
-- botones táctiles, el joystick ni la mira (en tablet y ordenador, como siempre). Se decide en Init.
local phone = false
-- Pantalla táctil sin teclado (teléfono o tablet, Fase 12): la munición va en la tarjeta del arma de
-- los controles táctiles, la vida abajo en el centro sin pisarlos y el registro de bajas, compacto,
-- bajo los botones de arriba a la derecha (todo se recoloca con TouchLayout.OnRelayout)
local touchHUD = false
local killFeedMax = 3
local killBaseScale = 1
local killScaleNow = 0.6 -- (táctil: la escala del aviso de baja que cabe en su zona)
local thumbnails = {}

-- Colores de la vida en táctil (Fase 17: paleta del HUD móvil)
local TOUCH_HEALTH = {
	Ok = Color3.fromRGB(236, 240, 246),
	Low = Color3.fromRGB(255, 205, 60),
	Critical = Color3.fromRGB(255, 92, 72),
}

local function tween(inst, time, props, style)
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad), props)
	t:Play()
	return t
end

local function disableCoreGui()
	for _ = 1, 20 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
		end)
		if ok then
			return
		end
		task.wait(0.5)
	end
end

---------------------------------------------------------------------------
-- Construcción
---------------------------------------------------------------------------

local function buildTopBar()
	local top = UI.new("Frame", {
		Name = "TopBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(330, 44),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local function scoreBox(x, name)
		local box = UI.new("Frame", {
			Name = name,
			Position = UDim2.fromOffset(x, 0),
			Size = UDim2.fromOffset(90, 44),
			BackgroundColor3 = Color3.fromRGB(80, 80, 80),
			Parent = top,
		}, { UI.corner(10), UI.stroke(Color3.new(0, 0, 0), 3, 0), UI.gloss() })
		return UI.label({
			Size = UDim2.fromScale(1, 1),
			Text = "0",
			TextSize = 30,
			Parent = box,
		})
	end
	refs.ScoreA = scoreBox(0, "TeamA")
	refs.ScoreB = scoreBox(240, "TeamB")
	refs.ScoreABox = refs.ScoreA.Parent
	refs.ScoreBBox = refs.ScoreB.Parent

	-- Estado de las banderas (solo en Captura la bandera), a los lados del marcador
	refs.FlagA = UI.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromOffset(-8, 0),
		Size = UDim2.fromOffset(150, 44),
		Text = "",
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = top,
	})
	refs.FlagB = UI.label({
		Position = UDim2.fromOffset(338, 0),
		Size = UDim2.fromOffset(150, 44),
		Text = "",
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = top,
	})

	local timerBox = UI.new("Frame", {
		Position = UDim2.fromOffset(95, 0),
		Size = UDim2.fromOffset(140, 44),
		BackgroundColor3 = Color3.fromRGB(35, 45, 95),
		Parent = top,
	}, { UI.corner(10), UI.stroke(Color3.new(0, 0, 0), 3, 0), UI.gloss(Color3.fromRGB(120, 120, 150)) })
	refs.Timer = UI.label({ Size = UDim2.fromScale(1, 1), Text = "00:00", TextSize = 30, Parent = timerBox })

	refs.Mode = UI.label({
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 0, 20),
		Text = "",
		TextSize = 16,
		Parent = top,
	})

	refs.PlayerRow = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.fromOffset(500, 54),
		BackgroundTransparency = 1,
		-- (táctil: sin la fila de fotos; el marcador completo está en su botón)
		Visible = not touchHUD,
		Parent = top,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	-- Táctil (Fase 15): marcador pequeño y horizontal, [ 43 ]  04:21  [ 38 ]: tu equipo a la izquierda
	-- en azul, el rival a la derecha en rojo (updateScoreboard), sin cajas gruesas ni brillo. La línea
	-- del modo solo sale cuando dice algo que cambia (calentamiento, en pie, infección...)
	if touchHUD then
		local pillW, timerW, h, gap = 46, 70, 28, 5
		top.Size = UDim2.fromOffset(pillW * 2 + timerW + gap * 2, h)
		top.Position = UDim2.new(0.5, 0, 0, 8)
		local function restyle(box, x, w, color, alpha)
			box.Position = UDim2.fromOffset(x, 0)
			box.Size = UDim2.fromOffset(w, h)
			box.BackgroundColor3 = color or box.BackgroundColor3
			box.BackgroundTransparency = alpha
			for _, child in box:GetChildren() do
				if child:IsA("UIGradient") then
					child:Destroy()
				elseif child:IsA("UIStroke") then
					child.Color = Color3.new(1, 1, 1)
					child.Thickness = 1
					child.Transparency = 0.75
				elseif child:IsA("UICorner") then
					child.CornerRadius = UDim.new(0, 7)
				end
			end
		end
		restyle(refs.ScoreABox, 0, pillW, nil, 0.12)
		restyle(timerBox, pillW + gap, timerW, Color3.fromRGB(14, 16, 22), 0.4)
		restyle(refs.ScoreBBox, pillW + gap + timerW + gap, pillW, nil, 0.12)
		refs.ScoreA.TextSize, refs.ScoreB.TextSize, refs.Timer.TextSize = 19, 19, 16
		for _, label in { refs.ScoreA, refs.ScoreB, refs.Timer } do
			label.TextStrokeTransparency = 0.7
		end
		refs.Mode.TextSize = 12
		refs.Mode.Size = UDim2.new(1, 240, 0, 16)
		refs.Mode.Position = UDim2.fromOffset(-120, h + 3)
		refs.Mode.TextStrokeTransparency = 0.5
		refs.FlagA.Size = UDim2.fromOffset(140, h)
		refs.FlagA.Position = UDim2.fromOffset(-8, 0)
		refs.FlagA.TextSize = 13
		refs.FlagB.Size = UDim2.fromOffset(140, h)
		refs.FlagB.Position = UDim2.fromOffset(pillW * 2 + timerW + gap * 2 + 8, 0)
		refs.FlagB.TextSize = 13
	end
end

local function buildCrosshair()
	local holder = UI.new("Frame", {
		Name = "Crosshair",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	refs.Crosshair = holder
	refs.CrossLines = {}
	for i, dir in { Vector2.new(0, -1), Vector2.new(0, 1), Vector2.new(-1, 0), Vector2.new(1, 0) } do
		local vertical = dir.X == 0
		refs.CrossLines[i] = {
			Dir = dir,
			Frame = UI.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = vertical and UDim2.fromOffset(2, 9) or UDim2.fromOffset(9, 2),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				Parent = holder,
			}, { UI.stroke(Color3.new(0, 0, 0), 1, 0.4) }),
		}
	end
	refs.CrossDot = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(3, 3),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = holder,
	}, { UI.corner(2) })

	-- Hitmarker (4 líneas diagonales)
	refs.Hitmarker = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(34, 34),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	refs.HitScale = UI.new("UIScale", { Parent = refs.Hitmarker })
	refs.HitLines = {}
	for i, pos in { Vector2.new(-1, -1), Vector2.new(1, -1), Vector2.new(-1, 1), Vector2.new(1, 1) } do
		refs.HitLines[i] = UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, pos.X * 10, 0.5, pos.Y * 10),
			Size = UDim2.fromOffset(10, 3),
			Rotation = pos.X * pos.Y * 45,
			BorderSizePixel = 0,
			BackgroundColor3 = Color3.new(1, 1, 1),
			Parent = refs.Hitmarker,
		})
	end

	-- Mira telescópica (círculo con borde negro enorme)
	refs.Scope = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.8, 0.8),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 0,
		Parent = gui,
	}, {
		UI.new("UIAspectRatioConstraint", { AspectRatio = 1 }),
		UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
		UI.new("UIStroke", { Thickness = 3000, Color = Color3.new(0, 0, 0) }),
		-- Bandas negras a los lados (por si el borde no cubre toda la pantalla)
		UI.new("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.new(0, 4000, 3, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
		}),
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.new(0, 4000, 3, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
		}),
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, 0, 0, 2),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
		}),
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 2, 1, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
		}),
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(5, 5),
			BackgroundColor3 = Color3.fromRGB(255, 40, 40),
			BorderSizePixel = 0,
		}, { UI.corner(3) }),
	})
	-- Aguantar la respiración (con teclado o mando; en el móvil la mira apenas se mueve)
	refs.ScopeHint = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 0.97),
		Size = UDim2.new(0.8, 0, 0, 22),
		Text = "",
		TextSize = 16,
		TextColor3 = Color3.fromRGB(230, 230, 230),
		TextStrokeTransparency = 0.4,
		ZIndex = 2,
		Parent = refs.Scope,
	})
end

local function buildWeaponPanel()
	-- Munición (abajo a la derecha)
	-- (en el teléfono, compacta y en el centro, encima de las habilidades: a la derecha están los
	-- botones táctiles)
	local align = phone and Enum.TextXAlignment.Center or Enum.TextXAlignment.Right
	local panel = UI.new("Frame", {
		AnchorPoint = phone and Vector2.new(0.5, 1) or Vector2.new(1, 1),
		Position = phone and UDim2.new(0.5, 0, 1, -122) or UDim2.new(1, -24, 1, -20),
		Size = phone and UDim2.fromOffset(160, 46) or UDim2.fromOffset(260, 104),
		BackgroundTransparency = 1,
		-- (táctil: la munición va en la tarjeta del arma, junto a recargar; el centro queda libre)
		Visible = not touchHUD,
		Parent = gui,
	})
	refs.WeaponName = UI.label({
		Size = UDim2.new(1, 0, 0, phone and 14 or 24),
		Text = "",
		TextSize = phone and 13 or 20,
		TextXAlignment = align,
		Parent = panel,
	})
	refs.Ammo = UI.label({
		Position = UDim2.fromOffset(0, phone and 13 or 24),
		Size = UDim2.new(1, 0, 0, phone and 26 or 50),
		Text = "",
		TextSize = phone and 24 or 46,
		RichText = true,
		TextXAlignment = align,
		Parent = panel,
	})
	-- Barra del cargador
	local ammoBar = UI.new("Frame", {
		AnchorPoint = phone and Vector2.new(0.5, 0) or Vector2.new(1, 0),
		Position = phone and UDim2.new(0.5, 0, 0, 41) or UDim2.new(1, 0, 0, 76),
		Size = UDim2.fromOffset(phone and 110 or 170, phone and 4 or 6),
		BackgroundColor3 = Color3.fromRGB(20, 20, 25),
		BackgroundTransparency = 0.3,
		Parent = panel,
	}, { UI.corner(3) })
	refs.AmmoFill = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(255, 210, 80),
		Parent = ammoBar,
	}, { UI.corner(3) })
	refs.AmmoBar = ammoBar
	refs.ReloadHint = UI.label({
		Position = phone and UDim2.fromOffset(0, -14) or UDim2.fromOffset(0, 85),
		Size = UDim2.new(1, 0, 0, phone and 14 or 18),
		Text = "",
		TextSize = phone and 13 or 16,
		TextColor3 = Color3.fromRGB(255, 210, 80),
		TextXAlignment = align,
		Parent = panel,
	})

	-- Táctil (Fase 15): munición compacta junto a recargar, SEPARADA de los botones: el arma en
	-- pequeño y «30 | 120» (el cargador grande, la reserva pequeña). Blanco normal, naranja con pocas
	-- balas, rojo vacío. La coloca layoutTouchHUD.
	if touchHUD then
		local block = UI.new("Frame", {
			Name = "TouchAmmo",
			AnchorPoint = Vector2.new(1, 0.5),
			Size = UDim2.fromOffset(120, 40),
			BackgroundTransparency = 1,
			Parent = gui,
		})
		refs.TouchAmmo = block
		refs.TouchWeapon = UI.label({
			Name = "Weapon",
			Size = UDim2.new(1, 0, 0, 15),
			Text = "",
			TextSize = 12,
			Font = Enum.Font.GothamBold,
			TextColor3 = Color3.fromRGB(200, 204, 214),
			TextStrokeTransparency = 0.6,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = block,
		})
		refs.TouchAmmoText = UI.label({
			Name = "Ammo",
			Position = UDim2.fromOffset(0, 14),
			Size = UDim2.new(1, 0, 0, 26),
			Text = "",
			TextSize = 22,
			Font = Enum.Font.GothamBlack,
			RichText = true,
			TextStrokeTransparency = 0.55,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = block,
		})
	end

	-- Ranuras de armas (derecha) con icono 3D del arma
	-- (en el teléfono no se ven: ahí están los botones táctiles; se cambia de arma con ⇄)
	local slots = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -20, 0.6, 0),
		Size = UDim2.fromOffset(230, 196),
		BackgroundTransparency = 1,
		Visible = not phone and not touchHUD,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			Padding = UDim.new(0, 6),
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	refs.Slots = {}
	for slot = 1, 3 do
		local row = UI.new("Frame", {
			LayoutOrder = slot,
			Size = UDim2.fromOffset(230, 60),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.7,
			Parent = slots,
		}, { UI.corner(10) })
		local stroke = UI.stroke(Color3.fromRGB(255, 200, 60), 2, 1)
		stroke.Parent = row
		local icon = UI.new("Frame", {
			Position = UDim2.fromOffset(6, 2),
			Size = UDim2.fromOffset(170, 44),
			BackgroundTransparency = 1,
			Parent = row,
		})
		local name = UI.label({
			Position = UDim2.fromOffset(10, 42),
			Size = UDim2.fromOffset(170, 16),
			Text = "",
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		local key = UI.new("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.fromOffset(30, 30),
			BackgroundColor3 = Color3.fromRGB(20, 20, 25),
			Parent = row,
		}, { UI.corner(6), UI.stroke(Color3.new(0, 0, 0), 2, 0) })
		UI.label({ Size = UDim2.fromScale(1, 1), Text = tostring(slot), TextSize = 18, Parent = key })
		refs.Slots[slot] = { Name = name, Key = key, Row = row, Stroke = stroke, Icon = icon, IconKey = nil }
	end

	-- Controles (estilo de la captura)
	if not InputMode.TouchUI() then
		-- (compacta para no pisar las ranuras de armas; solo para jugadores nuevos, ver updateData)
		local hints = UI.new("Frame", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -20, 0.42, 0), -- (debajo del registro de bajas)
			Size = UDim2.fromOffset(220, 247),
			BackgroundTransparency = 1,
			Parent = gui,
		}, {
			UI.new("UIListLayout", {
				Padding = UDim.new(0, 1),
				HorizontalAlignment = Enum.HorizontalAlignment.Right,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		for i, pair in {
			{ "Menú y tienda", "B" },
			{ "Granada (mantén: cocinar)", "G" },
			{ "Linterna (de noche)", "L" },
			{ "Ataque aéreo (racha 5)", "T" },
			{ "Agacharse / deslizar", "C" },
			{ "Cuchillo rápido", "F" },
			{ "Recargar", "R" },
			{ "Inspeccionar", "V" },
			{ "Habilidades", "E Z X" },
			{ "Emotes", "N" },
			{ "Grafiti", "J" },
			{ "Marcador", "Tab" },
			{ "Regalo", "H" },
		} do
			local row = UI.new("Frame", {
				LayoutOrder = i,
				Size = UDim2.fromOffset(220, 18),
				BackgroundTransparency = 1,
				Parent = hints,
			})
			UI.label({
				Size = UDim2.new(1, -56, 1, 0),
				Text = pair[1],
				TextSize = 15,
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = row,
			})
			local key = UI.new("Frame", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(46, 17),
				BackgroundColor3 = Color3.fromRGB(20, 20, 25),
				Parent = row,
			}, { UI.corner(5) })
			UI.label({ Size = UDim2.fromScale(1, 1), Text = pair[2], TextSize = 14, Parent = key })
		end
		refs.KeyHints = hints
	end
end

local function buildPlayerPanel()
	-- Vida (abajo a la izquierda)
	-- (en el teléfono, abajo en el centro, bajo las habilidades: a la izquierda está el joystick)
	local health = UI.new("Frame", {
		Name = "Health",
		AnchorPoint = phone and Vector2.new(0.5, 1) or Vector2.new(0, 1),
		Position = phone and UDim2.new(0.5, 10, 1, -14) or UDim2.new(0, 56, 1, -24),
		Size = phone and UDim2.fromOffset(190, 18) or UDim2.fromOffset(250, 26),
		BackgroundColor3 = Color3.fromRGB(20, 20, 25),
		Parent = gui,
	}, { UI.corner(13), UI.stroke(Color3.new(0, 0, 0), 3, 0) })
	refs.Health = health
	refs.HealthChip = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.25,
		Parent = health,
	}, { UI.corner(13) })
	refs.HealthFill = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(70, 220, 90),
		Parent = health,
	}, { UI.corner(13), UI.gloss() })
	refs.HealthText = UI.label({ Size = UDim2.fromScale(1, 1), Text = "100", TextSize = phone and 14 or 18, Parent = health })
	UI.new("ImageLabel", {
		Name = "HealthIcon",
		BackgroundTransparency = 1,
		Image = Icons.Heart,
		ScaleType = Enum.ScaleType.Fit,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(0, -6, 0.5, 0),
		Size = UDim2.fromOffset(phone and 22 or 30, phone and 22 or 30),
		Parent = health,
	})

	-- Táctil (Fase 15): vida compacta, «100» y una barra muy fina al lado, sin caja; la coloca
	-- layoutTouchHUD (abajo, a la izquierda del centro, nunca encima de la mira)
	if touchHUD then
		health.BackgroundTransparency = 1
		health.Size = UDim2.fromOffset(132, 22)
		for _, child in health:GetChildren() do
			if child:IsA("UIStroke") or child:IsA("UICorner") or (child:IsA("TextLabel") and child ~= refs.HealthText) then
				child:Destroy()
			end
		end
		-- (cruz pequeña dibujada: dos barras, sin emoji)
		local cross = UI.new("Frame", { Name = "Cross", Size = UDim2.fromOffset(12, 12), Position = UDim2.new(0, 0, 0.5, -6), BackgroundTransparency = 1, Parent = health })
		UI.new("Frame", { Size = UDim2.fromOffset(12, 4), Position = UDim2.fromOffset(0, 4), BackgroundColor3 = Color3.fromRGB(200, 205, 214), BorderSizePixel = 0, Parent = cross }, { UI.corner(2) })
		UI.new("Frame", { Size = UDim2.fromOffset(4, 12), Position = UDim2.fromOffset(4, 0), BackgroundColor3 = Color3.fromRGB(200, 205, 214), BorderSizePixel = 0, Parent = cross }, { UI.corner(2) })
		refs.HealthText.Parent = health
		refs.HealthText.AnchorPoint = Vector2.new(0, 0.5)
		refs.HealthText.Position = UDim2.new(0, 17, 0.5, 0)
		refs.HealthText.Size = UDim2.fromOffset(34, 20)
		refs.HealthText.TextSize = 16
		refs.HealthText.Font = Enum.Font.GothamBlack
		refs.HealthText.TextXAlignment = Enum.TextXAlignment.Left
		refs.HealthText.TextStrokeTransparency = 0.55
		local bar = UI.new("Frame", {
			Name = "Bar",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 54, 0.5, 1),
			Size = UDim2.new(1, -54, 0, 4),
			BackgroundColor3 = Color3.fromRGB(14, 16, 22),
			BackgroundTransparency = 0.45,
			BorderSizePixel = 0,
			Parent = health,
		}, { UI.corner(2) })
		refs.HealthChip.Parent = bar
		-- (el daño recibido se ve en rojo detrás de la barra blanca)
		refs.HealthChip.BackgroundColor3 = TOUCH_HEALTH.Critical
		refs.HealthChip.BackgroundTransparency = 0.35
		refs.HealthFill.Parent = bar
		for _, piece in { refs.HealthChip, refs.HealthFill } do
			for _, child in piece:GetChildren() do
				if child:IsA("UIGradient") then
					child:Destroy()
				elseif child:IsA("UICorner") then
					child.CornerRadius = UDim.new(0, 2)
				end
			end
		end
	end

	-- Racha (barra vertical a la izquierda, como en la captura)
	local streakBar = UI.new("Frame", {
		Name = "StreakBar",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 40, 0.55, 0),
		Size = UDim2.fromOffset(10, 240),
		BackgroundColor3 = Color3.fromRGB(30, 30, 35),
		Parent = gui,
	}, { UI.corner(5), UI.stroke(Color3.new(0, 0, 0), 2, 0.3) })
	refs.StreakFill = UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0),
		BackgroundColor3 = Color3.fromRGB(255, 180, 30),
		Parent = streakBar,
	}, { UI.corner(5) })
	-- Móvil (pantalla baja): sin la barra vertical (pisaría la tienda, el regalo y el contador del
	-- evento) y el texto de la racha encima de la barra de vida
	local touchOnly = InputMode.TouchUI()
	streakBar.Visible = not touchOnly
	refs.StreakText = UI.label({
		AnchorPoint = phone and Vector2.new(0.5, 1) or Vector2.new(0, touchOnly and 1 or 0),
		-- (teléfono: entre las habilidades y la vida, centrado)
		Position = phone and UDim2.new(0.5, 0, 1, -34) or (touchOnly and UDim2.new(0, 56, 1, -54) or UDim2.new(0, 14, 0.55, 126)),
		Size = UDim2.fromOffset(200, phone and 16 or 22),
		Text = "Racha x0",
		TextSize = phone and 14 or 18,
		TextXAlignment = phone and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(255, 210, 80),
		Parent = gui,
	})
	refs.StreakScale = UI.new("UIScale", { Parent = refs.StreakText })

	-- Nivel / XP (abajo al centro)
	-- (teléfono: una línea fina abajo del todo, sin el texto del nivel, que ya sale en el menú)
	local level = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = phone and UDim2.new(0.5, 0, 1, -3) or UDim2.new(0.5, 0, 1, -10),
		Size = phone and UDim2.fromOffset(230, 5) or UDim2.fromOffset(320, 10),
		BackgroundColor3 = Color3.fromRGB(20, 20, 25),
		Parent = gui,
	}, { UI.corner(5) })
	refs.XPFill = UI.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.fromRGB(80, 170, 255),
		Parent = level,
	}, { UI.corner(5) })
	refs.XPScale = UI.new("UIScale", { Parent = level })
	refs.Level = level
	refs.LevelText = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, -2),
		Size = UDim2.fromOffset(520, 18),
		Text = "Nivel 1",
		TextSize = 15,
		Visible = not phone,
		Parent = level,
	})
end

local function buildFeedsAndOverlays()
	refs.KillFeed = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		-- (teléfono: más pequeño y a la izquierda del botón del marcador)
		Position = phone and UDim2.new(1, -80, 0, 54) or UDim2.new(1, -16, 0, 60),
		Size = UDim2.fromOffset(380, 220),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			Padding = UDim.new(0, 4),
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	if touchHUD then
		-- (táctil: filas más bajas con texto de 14 px, sin encoger: se lee en el teléfono)
		refs.KillFeed:FindFirstChildOfClass("UIListLayout").Padding = UDim.new(0, 2)
	elseif phone then
		UI.new("UIScale", { Scale = 0.6, Parent = refs.KillFeed })
	end

	-- (teléfono: a la izquierda de la mira, por debajo; en el centro están la munición y las habilidades)
	refs.Popups = UI.new("Frame", {
		AnchorPoint = phone and Vector2.new(1, 0) or Vector2.new(0.5, 0),
		Position = phone and UDim2.new(0.5, -90, 0.5, 24) or UDim2.new(0.5, 0, 0.58, 0),
		Size = UDim2.fromOffset(phone and 260 or 400, 140),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			Padding = UDim.new(0, 2),
			HorizontalAlignment = phone and Enum.HorizontalAlignment.Right or Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	-- (ancho relativo y texto que se encoge: los avisos largos caben en el móvil)
	refs.BigText = UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, phone and 0.2 or 0.3),
		Size = UDim2.new(0.92, 0, 0, phone and 48 or 70),
		Text = "",
		TextSize = 54,
		TextScaled = true,
		TextStrokeTransparency = 0,
		Visible = false,
		ZIndex = 11, -- (por encima del panel de fin de ronda)
		Parent = gui,
	})
	refs.BigFit = UI.new("UITextSizeConstraint", { MaxTextSize = 54, Parent = refs.BigText })
	-- Línea pequeña debajo del aviso grande (resultado de cada ronda: marcador y mejor de la ronda)
	refs.BigSub = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, phone and 0.2 or 0.3, phone and 26 or 40),
		Size = UDim2.new(0.8, 0, 0, phone and 22 or 28),
		Text = "",
		TextSize = phone and 17 or 22,
		RichText = true,
		TextStrokeTransparency = 0.3,
		Visible = false,
		ZIndex = 11,
		Parent = gui,
	})

	refs.Banner = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 135),
		Size = UDim2.fromOffset(600, 30),
		Text = "",
		TextSize = 24,
		TextColor3 = Color3.fromRGB(255, 200, 60),
		Visible = false,
		Parent = gui,
	})

	-- (teléfono: arriba, encima del aviso de baja; abajo estaba sobre la mira y la munición)
	refs.CarrierBanner = UI.label({
		AnchorPoint = phone and Vector2.new(0.5, 0) or Vector2.new(0.5, 1),
		Position = phone and UDim2.new(0.5, 0, 0, 82) or UDim2.new(0.5, 0, 1, -158),
		Size = phone and UDim2.new(0.55, 0, 0, 22) or UDim2.fromOffset(700, 34),
		TextScaled = phone,
		Text = UI.HudText("🚩 ¡TIENES LA BANDERA! Llévala a tu base"),
		TextSize = 28,
		TextColor3 = Color3.fromRGB(255, 220, 70),
		TextStrokeTransparency = 0,
		Visible = false,
		Parent = gui,
	})

	-- (teléfono: a la izquierda, bajo los avisos de XP; en el centro de abajo está la munición)
	refs.Toast = UI.label({
		AnchorPoint = phone and Vector2.new(1, 0) or Vector2.new(0.5, 1),
		Position = phone and UDim2.new(0.5, -90, 0.5, 70) or UDim2.new(0.5, 0, 1, -122),
		Size = phone and UDim2.fromOffset(300, 20) or UDim2.fromOffset(600, 30),
		Text = "",
		TextSize = 22,
		TextScaled = phone,
		TextXAlignment = phone and Enum.TextXAlignment.Right or Enum.TextXAlignment.Center,
		Visible = false,
		Parent = gui,
	})
	if phone then
		UI.new("UITextSizeConstraint", { MaxTextSize = 16, Parent = refs.Toast })
	end

	-- Viñeta roja de daño
	refs.Damage = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -120, 1, -120),
		BackgroundTransparency = 1,
		ZIndex = 0,
		Parent = gui,
	}, { UI.new("UICorner", { CornerRadius = UDim.new(0, 60) }) })
	refs.DamageStroke = UI.new("UIStroke", {
		Thickness = 90,
		Color = Color3.fromRGB(200, 0, 0),
		Transparency = 1,
		Parent = refs.Damage,
	})

	-- Quién te eliminó (arriba); los botones y la cámara de espectador están en DeathScreen
	refs.DeathScreen = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	refs.DeathText = UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.17),
		Size = UDim2.fromOffset(800, 60),
		Text = "",
		TextSize = 40,
		TextColor3 = Color3.fromRGB(255, 80, 80),
		RichText = true,
		Parent = refs.DeathScreen,
	})
	refs.RespawnText = UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.53),
		Size = UDim2.fromOffset(600, 30),
		Text = "",
		Visible = false,
		TextSize = 22,
		Parent = refs.DeathScreen,
	})
	refs.DeathIcon = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.27),
		Size = UDim2.fromOffset(220, 86),
		BackgroundTransparency = 1,
		Parent = refs.DeathScreen,
	})

	-- Aviso de baja propia ("ELIMINADO", doble baja...)
	refs.KillBanner = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		-- (en el teléfono, por encima de la mira: abajo están los botones de habilidades)
		Position = UDim2.fromScale(0.5, phone and 0.33 or 0.7),
		Size = UDim2.fromOffset(440, 64),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	refs.KillScale = UI.new("UIScale", { Scale = killBaseScale, Parent = refs.KillBanner })
	-- Placa detrás del texto: oscura y que se desvanece hacia la derecha, con una franja del color de la
	-- baja a la izquierda (rojo; dorado a la cabeza o en bajas seguidas)
	refs.KillPlate = UI.new("Frame", {
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.fromOffset(400, 56),
		BackgroundColor3 = Color3.fromRGB(10, 12, 18),
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		ZIndex = 0,
		Parent = refs.KillBanner,
	}, {
		UI.corner(6),
		UI.new("UIGradient", {
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.65, 0.25), NumberSequenceKeypoint.new(1, 1) }),
		}),
	})
	refs.KillAccent = UI.new("Frame", {
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.fromOffset(4, 56),
		BackgroundColor3 = Color3.fromRGB(255, 70, 70),
		BorderSizePixel = 0,
		Parent = refs.KillBanner,
	}, { UI.corner(2) })
	refs.KillIcon = UI.label({
		Size = UDim2.fromOffset(64, 64),
		Text = "💀",
		TextSize = 46,
		Parent = refs.KillBanner,
	})
	refs.KillTitle = UI.label({
		Position = UDim2.fromOffset(touchHUD and 18 or 70, 2),
		Size = UDim2.fromOffset(370, 34),
		Text = "",
		TextSize = 32,
		TextStrokeTransparency = 0,
		TextColor3 = Color3.fromRGB(255, 70, 70),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = refs.KillBanner,
	})
	refs.KillSub = UI.label({
		Position = UDim2.fromOffset(touchHUD and 18 or 70, 36),
		Size = UDim2.fromOffset(370, 24),
		Text = "",
		TextSize = 20,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextColor3 = Color3.fromRGB(255, 225, 100),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = refs.KillBanner,
	})

	-- Medallas de la baja (Primera sangre, Venganza...): en fila bajo el aviso de baja (en móvil,
	-- encima: debajo están los botones de habilidades)
	local medalsAbove = InputMode.TouchUI() and not phone
	refs.Medals = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, medalsAbove and 1 or 0),
		-- (teléfono: justo debajo del aviso de baja, que está por encima de la mira)
		Position = phone and UDim2.new(0.5, 0, 0.33, 24) or UDim2.new(0.5, 0, 0.7, medalsAbove and -38 or 38),
		Size = UDim2.fromOffset(640, 34),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	if phone then
		UI.new("UIScale", { Scale = 0.75, Parent = refs.Medals })
	end

	-- Fin de ronda
	refs.RoundEnd = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(560, 220),
		BackgroundColor3 = Color3.fromRGB(20, 22, 35),
		BackgroundTransparency = 0.15,
		ZIndex = 10, -- (por encima de la vida y la racha: en el móvil el panel llega hasta abajo)
		Visible = false,
		Parent = gui,
	}, { UI.corner(16), UI.stroke(Color3.new(1, 1, 1), 3, 0.6) })
	refs.RoundTitle = UI.label({
		Position = UDim2.fromOffset(0, 20),
		Size = UDim2.new(1, 0, 0, 56),
		Text = "",
		TextSize = 44,
		Parent = refs.RoundEnd,
	})
	refs.RoundScore = UI.label({
		Position = UDim2.fromOffset(0, 86),
		Size = UDim2.new(1, 0, 0, 50),
		Text = "",
		TextSize = 40,
		RichText = true,
		Parent = refs.RoundEnd,
	})
	refs.RoundMVP = UI.label({
		Position = UDim2.fromOffset(0, 140),
		Size = UDim2.new(1, 0, 0, 34),
		Text = "",
		TextSize = 24,
		TextColor3 = Color3.fromRGB(255, 210, 80),
		Parent = refs.RoundEnd,
	})
	-- Podio: los 3 mejores de la partida (bots incluidos), con bajas/muertes
	refs.RoundTop = UI.label({
		Position = UDim2.fromOffset(10, 174),
		Size = UDim2.new(1, -20, 0, 22),
		Text = "",
		TextScaled = true, -- (con nombres largos se encoge en vez de salirse)
		RichText = true,
		TextColor3 = Color3.fromRGB(225, 228, 240),
		Parent = refs.RoundEnd,
	}, { UI.new("UITextSizeConstraint", { MaxTextSize = 17 }) })

	-- En pantallas bajas (móvil en horizontal) el panel se encoge para caber entero
	local roundScale = UI.new("UIScale", { Parent = refs.RoundEnd })
	local function fitRoundEnd()
		local viewport = workspace.CurrentCamera.ViewportSize
		roundScale.Scale = math.clamp(math.min((viewport.Y - 40) / refs.RoundEnd.Size.Y.Offset, (viewport.X - 20) / 560), 0.45, 1)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitRoundEnd)
	refs.RoundEnd:GetPropertyChangedSignal("Size"):Connect(fitRoundEnd)
	fitRoundEnd()

	-- Resumen de tu partida (llega con MatchSummary): estadísticas, barra de nivel y monedas
	refs.Summary = UI.new("Frame", {
		Position = UDim2.fromOffset(20, 200),
		Size = UDim2.new(1, -40, 0, 170),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = refs.RoundEnd,
	})
	refs.SummaryStats = UI.label({
		Size = UDim2.new(1, 0, 0, 30),
		Text = "",
		TextSize = 22,
		TextScaled = true, -- (con racha de victorias la línea es larga: se encoge para caber)
		RichText = true,
		Parent = refs.Summary,
	}, { UI.new("UITextSizeConstraint", { MaxTextSize = 22 }) })
	refs.SummaryLevel = UI.label({
		Position = UDim2.fromOffset(0, 44),
		Size = UDim2.new(0.5, 0, 0, 28),
		Text = "",
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = refs.Summary,
	})
	refs.SummaryXP = UI.label({
		Position = UDim2.new(0.5, 0, 0, 44),
		Size = UDim2.new(0.5, 0, 0, 28),
		Text = "",
		TextSize = 24,
		TextColor3 = Color3.fromRGB(120, 220, 255),
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = refs.Summary,
	})
	local bar = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 78),
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundColor3 = Color3.fromRGB(40, 44, 70),
		Parent = refs.Summary,
	}, { UI.corner(10), UI.stroke(Color3.new(1, 1, 1), 2, 0.5) })
	refs.SummaryFill = UI.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.fromRGB(80, 200, 255),
		Parent = bar,
	}, { UI.corner(10) })
	refs.SummaryLevelUp = UI.label({
		Position = UDim2.fromOffset(0, 102),
		Size = UDim2.new(1, 0, 0, 30),
		Text = "⬆ ¡SUBES DE NIVEL!",
		TextSize = 26,
		TextScaled = true, -- (el aviso de "te faltan X XP" es largo: se encoge en vez de salirse)
		TextColor3 = Color3.fromRGB(255, 220, 70),
		Visible = false,
		Parent = refs.Summary,
	}, { UI.new("UITextSizeConstraint", { MaxTextSize = 26 }) })
	refs.SummaryCoins = UI.label({
		Position = UDim2.fromOffset(0, 134),
		Size = UDim2.new(0.45, 0, 0, 32),
		Text = "",
		TextSize = 28,
		TextColor3 = Color3.fromRGB(255, 210, 60),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = refs.Summary,
	})
	-- Rango competitivo: icono, nombre y puntos ganados o perdidos
	refs.SummaryRank = UI.label({
		Position = UDim2.new(0.45, 0, 0, 134),
		Size = UDim2.new(0.55, 0, 0, 32),
		Text = "",
		TextSize = 24,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = refs.Summary,
	})
end

---------------------------------------------------------------------------
-- Mensajes
---------------------------------------------------------------------------

-- Orden creciente para los avisos y el registro de bajas (no se reinicia nunca a mitad de partida)
local orderCounter = 0
local function nextOrder()
	orderCounter += 1
	return orderCounter
end

-- Medalla: una placa que aparece con rebote y se va sola (máximo 3 a la vez)
local function showMedal(text)
	local list = {}
	for _, child in refs.Medals:GetChildren() do
		if child:IsA("TextLabel") then
			table.insert(list, child)
		end
	end
	-- (táctil, Fase 16: como mucho 2 a la vez; la más vieja deja sitio a la nueva)
	local maxMedals = touchHUD and 2 or 3
	table.sort(list, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #list >= maxMedals do
		local oldest = table.remove(list, 1)
		if oldest then
			oldest:Destroy()
		end
	end
	local badge = UI.label({
		LayoutOrder = nextOrder(),
		Size = UDim2.fromOffset(0, 34),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "  " .. tostring(text) .. "  ",
		TextSize = 22,
		TextColor3 = Color3.fromRGB(255, 225, 110),
		BackgroundColor3 = Color3.fromRGB(25, 22, 12),
		BackgroundTransparency = 0.2,
		Parent = refs.Medals,
	}, { UI.corner(8), UI.stroke(Color3.fromRGB(255, 200, 60), 2, 0.1) })
	-- (táctil: entra con un pulso pequeño, sin rebote; dura menos)
	local scale = UI.new("UIScale", { Scale = touchHUD and 1.12 or 1.6, Parent = badge })
	if touchHUD then
		tween(scale, 0.12, { Scale = 1 })
	else
		tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	-- Un brillo cruza la medalla y suena un "cling" (más alto cuantas más medallas juntas)
	badge.ClipsDescendants = true
	local shine = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Parent = badge,
	})
	local gradient = UI.new("UIGradient", {
		Rotation = 20,
		Offset = Vector2.new(-1, 0),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.45, 1),
			NumberSequenceKeypoint.new(0.5, 0),
			NumberSequenceKeypoint.new(0.55, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = shine,
	})
	task.delay(0.15, function()
		tween(gradient, 0.45, { Offset = Vector2.new(1, 0) })
	end)
	Debris:AddItem(shine, 0.7)
	Sounds.Play("Kill", nil, 1.6 + 0.15 * #list, 0.35)
	task.delay(touchHUD and 2 or 2.6, function()
		if badge.Parent then
			tween(badge, 0.3, { TextTransparency = 1, BackgroundTransparency = 1 })
			task.wait(0.3)
			badge:Destroy()
		end
	end)
end

local function popup(text, color)
	-- En el teléfono, más pequeños y solo 2 a la vez (debajo están los botones de habilidades)
	if phone then
		local list = {}
		for _, child in refs.Popups:GetChildren() do
			if child:IsA("TextLabel") then
				table.insert(list, child)
			end
		end
		table.sort(list, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		for i = 1, #list - 1 do
			list[i]:Destroy()
		end
	end
	local label = UI.label({
		Size = UDim2.fromOffset(touchHUD and 220 or (phone and 260 or 400), phone and 20 or 26),
		Text = UI.HudText(text),
		-- (táctil, Fase 15: a la izquierda, bajo el minimapa; ver layoutTouchHUD)
		TextXAlignment = touchHUD and Enum.TextXAlignment.Left or (phone and Enum.TextXAlignment.Right or Enum.TextXAlignment.Center),
		TextSize = 22,
		TextScaled = true, -- (los avisos largos se encogen en vez de salirse)
		TextColor3 = color or Color3.fromRGB(255, 230, 120),
		LayoutOrder = nextOrder(),
		Parent = refs.Popups,
	}, { UI.new("UITextSizeConstraint", { MaxTextSize = phone and 17 or 22 }) })
	-- (entra con un pequeño rebote; en táctil, un pulso corto sin rebote: hay mucho más en pantalla)
	local scale = UI.new("UIScale", { Scale = touchHUD and 1.12 or 1.4, Parent = label })
	tween(scale, touchHUD and 0.12 or 0.2, { Scale = 1 }, touchHUD and Enum.EasingStyle.Quad or Enum.EasingStyle.Back)
	task.delay(1.4, function()
		tween(label, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	Debris:AddItem(label, 2)
end

local bigToken
-- Celebración: a pantalla completa en plena partida; con el resumen de fin de partida en pantalla,
-- solo confeti, fanfarria y destello (el texto ya sale en el panel y así no lo tapa, sobre todo en
-- el móvil)
local function celebrate(title, subtitle, color, big, priority)
	-- (la pantalla final de la partida ya enseña nivel, rango y desbloqueos: aquí nada encima)
	if ClientState.ResultsActive then
		return true
	end
	if refs.RoundEnd and refs.RoundEnd.Visible then
		RewardFX.Confetti(big and 45 or 30)
		RewardFX.Fanfare(big)
		RewardFX.EdgeFlash(color or Color3.fromRGB(255, 210, 60), 0.5)
		return true
	end
	return RewardFX.Celebrate(UI.HudText(title), subtitle and UI.HudText(subtitle), color, big, priority)
end

local function bigMessage(text, color)
	local label = refs.BigText
	label.Text = UI.HudText(text)
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextTransparency = 0
	label.TextStrokeTransparency = 0
	-- (entra grande y se asienta: se anima el tamaño máximo del texto, que se encoge si no cabe; en
	-- táctil, más pequeño y sin rebote, en su sitio de la zona de arriba, ver HUDZones)
	local maxSize = touchHUD and 26 or (phone and 38 or 54)
	label.Visible = true
	if touchHUD then
		refs.BigFit.MaxTextSize = maxSize
	else
		refs.BigFit.MaxTextSize = math.floor(maxSize * 1.3)
		tween(refs.BigFit, 0.25, { MaxTextSize = maxSize }, Enum.EasingStyle.Back)
	end
	local token = {}
	bigToken = token
	task.delay(2.5, function()
		if bigToken == token then
			tween(label, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
	end)
end

-- Resultado de una ronda (Eliminación, Buscar y destruir): RONDA GANADA / PERDIDA, el marcador y
-- quién fue el mejor de la ronda. Corto: a los 3 s ya se prepara la siguiente
local function roundResult(info)
	if type(info) ~= "table" then
		return
	end
	local mine = player.Team and player.Team.Name
	local won = info.Winner ~= nil and info.Winner == mine
	if info.Winner == nil then
		bigMessage("RONDA EMPATADA", Color3.new(1, 1, 1))
	elseif mine then
		bigMessage(won and "RONDA GANADA" or "RONDA PERDIDA", won and Color3.fromRGB(255, 210, 60) or Color3.fromRGB(255, 80, 70))
	else
		bigMessage("RONDA PARA " .. string.upper(tostring(info.Winner)))
	end
	if won then
		RewardFX.EdgeFlash(Color3.fromRGB(255, 210, 60), 0.45)
		Sounds.Play("Kill", nil, 1.25, 0.8)
	elseif info.Winner ~= nil and mine then
		Sounds.Play("Boom", nil, 0.85, 0.25)
	end
	local teamA = ReplicatedStorage:GetAttribute("TeamA") or "Rojo"
	local teamB = ReplicatedStorage:GetAttribute("TeamB") or "Azul"
	local colorA = refs.ScoreABox.BackgroundColor3
	local colorB = refs.ScoreBBox.BackgroundColor3
	local line = string.format('<font color="%s">%s %d</font>  –  <font color="%s">%d %s</font>',
		UI.hex(colorA), teamA, tonumber(info.ScoreA) or 0, UI.hex(colorB), tonumber(info.ScoreB) or 0, teamB)
	-- (el ACE de la ronda no se pierde: el aviso grande lo pisa el resultado, aquí se queda escrito)
	if type(info.Ace) == "string" then
		line = string.format('<font color="#FFC832">⭐ ACE de %s</font>   ·   ', info.Ace) .. line
	end
	if type(info.MVP) == "string" and (tonumber(info.MVPKills) or 0) > 0 then
		line ..= string.format('   ·   ⭐ %s <font color="#C8C8D2">(%d)</font>', info.MVP, tonumber(info.MVPKills) or 0)
	end
	refs.BigSub.Text = UI.HudText(line)
	refs.BigSub.TextTransparency = 0
	refs.BigSub.TextStrokeTransparency = 0.3
	refs.BigSub.Visible = true
	local token = {}
	refs.BigSubToken = token
	task.delay(2.8, function()
		if refs.BigSubToken == token then
			tween(refs.BigSub, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
	end)
end

-- Escribe un texto solo si cambia (el HUD se repinta cada fotograma y cada escritura recoloca la
-- interfaz, aunque sea el mismo texto)
local function setText(label, text)
	if label.Text ~= text then
		label.Text = text
	end
end

local function timedLabel(label, text, duration)
	label.Text = UI.HudText(text)
	label.Visible = true
	local token = {}
	label:SetAttribute("Token", tostring(token))
	task.delay(duration, function()
		if label:GetAttribute("Token") == tostring(token) then
			label.Visible = false
		end
	end)
end

-- Texto corto de un premio del pase
local function describeReward(reward)
	if not reward then
		return nil
	elseif reward.Type == "Coins" then
		return "💰 +" .. tostring(reward.Amount)
	elseif reward.Type == "Skin" then
		return "🎨 Skin " .. Skins.Get(reward.Id).Name
	elseif reward.Type == "Crate" then
		return "🎁 Caja"
	elseif reward.Type == "Outfit" then
		return "👕 Traje nuevo"
	elseif reward.Type == "KillEffect" then
		return "💥 Efecto de eliminación"
	end
	return reward.Type
end

local function onNotify(kind, text)
	if kind == "XP" then
		popup(text)
		RewardFX.AddScore(RewardFX.ParseXP(text))
	elseif kind == "Medal" then
		showMedal(text)
	elseif kind == "Big" then
		bigMessage(text)
	elseif kind == "Round" then
		roundResult(text)
	elseif kind == "Unlock" and type(text) == "string" then
		-- Algo nuevo: un arma tiene su propia presentación (rayos, confeti); lo demás, aviso dorado
		local weaponName = string.match(text, "^¡Arma desbloqueada: (.+)!$")
		if weaponName then
			-- (con la pantalla final delante, celebrate solo echa confeti: el nombre va en el aviso)
			local endScreen = refs.RoundEnd and refs.RoundEnd.Visible
			if not celebrate("🔓 ¡ARMA NUEVA!", weaponName .. " · ya puedes equiparla en Armas (B)", Color3.fromRGB(255, 200, 60), true) or endScreen then
				bigMessage("🔓 " .. text, Color3.fromRGB(255, 200, 60))
			end
		else
			bigMessage("🔓 " .. text, Color3.fromRGB(255, 200, 60))
			RewardFX.EdgeFlash(Color3.fromRGB(255, 200, 60), 0.4)
			Sounds.Play("Kill", nil, 1.2, 0.7)
		end
	elseif kind == "Ace" then
		-- ACE: alguien eliminó solo a todo el equipo rival en esta ronda
		if text == player.Name then
			if not celebrate("⭐ ¡ACE!", "Eliminaste tú solo a todo el equipo rival", Color3.fromRGB(255, 200, 50), true, true) then
				bigMessage("⭐ ¡ACE!", Color3.fromRGB(255, 200, 50))
			end
			RewardFX.EdgeFlash(Color3.fromRGB(255, 200, 50), 0.6)
		else
			bigMessage("⭐ ACE · " .. tostring(text), Color3.fromRGB(255, 200, 50))
		end
	elseif kind == "Challenge" then
		bigMessage("✅ " .. text, Color3.fromRGB(90, 255, 140))
		RewardFX.EdgeFlash(Color3.fromRGB(90, 255, 140), 0.5)
		Sounds.Play("Kill")
	elseif kind == "Mastery" then
		bigMessage("🏆 " .. text, Color3.fromRGB(255, 200, 50))
		RewardFX.EdgeFlash(Color3.fromRGB(255, 200, 50), 0.5)
		Sounds.Play("Kill")
	elseif kind == "LevelUp" then
		-- Subir de nivel: celebración a pantalla completa (rayos, confeti y fanfarria)
		if not celebrate("⬆ ¡NIVEL " .. tostring(text) .. "!", "¡Sigue así!", Color3.fromRGB(255, 210, 60), type(text) == "number" and text % 10 == 0, true) then
			bigMessage("⬆ ¡NIVEL " .. tostring(text) .. "!", Color3.fromRGB(255, 210, 60))
			Sounds.Play("Kill")
		end
		-- Qué da este nivel del pase (y qué daría el premium, si no lo tiene)
		local tier = type(text) == "number" and GameConfig.BattlePass[text]
		if tier then
			local describe = describeReward
			local data = ClientState.Data
			local free, premium = describe(tier.Free), describe(tier.Premium)
			local line = free and ("Recompensa: " .. free) or ""
			if premium and (GameConfig.PremiumPassId ~= 0 or (data and data.Premium)) then
				if data and data.Premium then
					line ..= (line ~= "" and "   ·   " or "") .. "👑 " .. premium
				else
					line ..= (line ~= "" and "   ·   " or "") .. "👑 Con el pase premium: " .. premium
				end
			end
			if line ~= "" then
				-- En el aviso inferior (el banner superior lo usan las rachas y banderas)
				task.delay(0.6, function()
					timedLabel(refs.Toast, line, 4)
				end)
			end
		end
	elseif kind == "LootDrop" then
		-- Tu baja ha soltado botín: el rayo de luz marca dónde está
		local color = Skins.RarityColors[text] or Color3.new(1, 1, 1)
		popup("📦 ¡Botín " .. tostring(text) .. "! Pasa por encima para cogerlo", color)
		Sounds.Play("Kill", nil, 1.9, 0.4)
	elseif kind == "Loot" and type(text) == "table" then
		local color = typeof(text.Color) == "Color3" and text.Color or Color3.new(1, 1, 1)
		local reward = "+" .. tostring(text.Coins or 0) .. " 💰" .. ((text.XP or 0) > 0 and ("  +" .. text.XP .. " XP") or "")
		popup("📦 Botín " .. tostring(text.Rarity) .. "  " .. reward, color)
		if text.Rarity == "Legendario" then
			if not RewardFX.Celebrate("📦 ¡BOTÍN LEGENDARIO!", reward, color, true) then
				RewardFX.EdgeFlash(color, 0.6)
			end
		elseif text.Rarity == "Épico" then
			RewardFX.EdgeFlash(color, 0.55)
			RewardFX.Fanfare(false)
		else
			RewardFX.EdgeFlash(color, 0.3)
			Sounds.Play("Kill", nil, 1.5, 0.5)
		end
	elseif kind == "Flag" then
		timedLabel(refs.Banner, "🚩 " .. text, 3)
		Sounds.Play("Flag")
	elseif kind == "Streak" then
		timedLabel(refs.Banner, "🔥 " .. text, 3)
	elseif kind == "Pumpkin" then
		-- Calabaza recogida (modo Calabazas): confirmada suena a baja, recuperada más suave
		Sounds.Play(text == true and "Kill" or "Flag", nil, text == true and 1.2 or 1.5)
	elseif kind == "Assist" then
		popup("🤝 ASISTENCIA  " .. tostring(text), Color3.fromRGB(120, 220, 255))
	elseif kind == "Bounty" then
		timedLabel(refs.Banner, "💰 " .. text, 3.5)
	elseif kind == "Wanted" then
		-- Te has convertido en el buscado: todos ven tu cartel
		bigMessage("💰 ¡TE BUSCAN! " .. tostring(text) .. " 💰 por tu cabeza", Color3.fromRGB(255, 120, 80))
		Sounds.Play("Flag")
	elseif kind == "BountyClaimed" then
		bigMessage("💰 ¡RECOMPENSA COBRADA! +" .. tostring(text) .. " 💰", Color3.fromRGB(255, 210, 60))
		Sounds.Play("Kill")
	elseif type(text) == "string" or type(text) == "number" then
		-- (un aviso de un tipo nuevo con datos en tabla no se escribe tal cual)
		timedLabel(refs.Toast, tostring(text), 3)
		Sounds.Play("Click")
	end
end

local multiCount, lastKillTime, killToken = 0, 0, nil
local MULTI_NAMES = { [2] = "¡DOBLE BAJA!", [3] = "¡TRIPLE BAJA!", [4] = "¡CUÁDRUPLE!" }
-- Color del aviso según cuántas bajas seguidas: naranja, rosa, morado y dorado
local MULTI_COLORS = {
	[2] = Color3.fromRGB(255, 180, 30),
	[3] = Color3.fromRGB(255, 80, 160),
	[4] = Color3.fromRGB(180, 90, 255),
}

local function showKillBanner(victim, headshot)
	local now = os.clock()
	multiCount = (now - lastKillTime < 4) and multiCount + 1 or 1
	lastKillTime = now
	local multi = MULTI_NAMES[multiCount] or (multiCount >= 5 and "¡IMPARABLE!" or nil)
	refs.KillTitle.Text = multi or "ELIMINADO"
	refs.KillTitle.TextColor3 = MULTI_COLORS[multiCount] or (multi and Color3.fromRGB(255, 215, 60)) or Color3.fromRGB(255, 70, 70)
	refs.KillSub.Text = tostring(victim) .. (headshot and "  ·  DISPARO A LA CABEZA" or "")
	refs.KillIcon.Text = headshot and "🎯" or "💀"
	-- (táctil, Fase 15: sin emoji; la franja de color ya dice el tipo de baja)
	refs.KillIcon.Visible = not touchHUD
	refs.KillAccent.BackgroundColor3 = (headshot or multi) and Color3.fromRGB(255, 205, 60) or Color3.fromRGB(255, 70, 70)
	-- (la placa entra desde la izquierda, rápida, y mide lo que el texto: en el teléfono no pisa el
	-- registro de bajas)
	local function boundsX(label)
		local bounds = label.TextBounds
		return typeof(bounds) == "Vector2" and bounds.X or 0
	end
	-- (TextBounds viene en píxeles de pantalla, ya escalados por la UIScale del aviso: se pasa a las
	-- unidades del aviso)
	local currentScale = math.max(refs.KillScale.Scale, 0.1)
	local textWidth = math.max(boundsX(refs.KillTitle), boundsX(refs.KillSub)) / currentScale
	local plateWidth = textWidth > 0 and math.clamp(textWidth + 92, 180, phone and 300 or 400) or (phone and 250 or 400)
	-- (y el texto no pasa de la placa: si no cabe, se corta con «…»)
	refs.KillTitle.Size = UDim2.fromOffset(plateWidth - 70, 34)
	refs.KillSub.Size = UDim2.fromOffset(plateWidth - 70, 24)
	refs.KillPlate.Size = UDim2.fromOffset(math.min(120, plateWidth), 56)
	tween(refs.KillPlate, 0.18, { Size = UDim2.fromOffset(plateWidth, 56) })
	refs.KillBanner.Visible = true
	-- (cuantas más bajas seguidas, más grande entra y más se sacude)
	if touchHUD then
		-- (táctil, Fase 16: un pequeño pulso sin rebote; crecer al 150 % tapaba los botones y lo de
		-- alrededor)
		refs.KillScale.Scale = killScaleNow * 1.12
		tween(refs.KillScale, 0.12, { Scale = killScaleNow })
	else
		refs.KillScale.Scale = killBaseScale * (1.5 + 0.25 * math.min(multiCount - 1, 4))
		tween(refs.KillScale, 0.3, { Scale = killBaseScale }, Enum.EasingStyle.Back)
	end
	if multi then
		refs.KillBanner.Rotation = multiCount % 2 == 0 and -6 or 6
		tween(refs.KillBanner, 0.35, { Rotation = 0 }, Enum.EasingStyle.Elastic)
	end
	RewardFX.KillPulse(headshot, multiCount)
	local token = {}
	killToken = token
	task.delay(2.2, function()
		if killToken == token then
			refs.KillBanner.Visible = false
		end
	end)
end

local function onKillFeed(info)
	if type(info) ~= "table" then
		return
	end
	if info.Killer == player.Name and info.Victim ~= player.Name then
		showKillBanner(info.Victim, info.Headshot)
	end
	local killer = info.Killer
	local text
	local weapon = info.Weapon ~= "" and (" [" .. info.Weapon .. "] ") or " ✖ "
	if info.Headshot then
		weapon ..= touchHUD and '<font color="#FFD23C">HS</font> ' or "🎯 "
	end
	local victimName = info.Victim or "?"
	local victim = string.format('<font color="%s">%s</font>', UI.hex(UI.teamTint(info.VictimColor, true)), victimName)
	if killer then
		text = string.format('<font color="%s">%s</font>%s%s', UI.hex(UI.teamTint(info.KillerColor, true)), killer, weapon, victim)
	else
		text = victim .. " se eliminó"
	end
	-- (táctil, Fase 15: filas compactas de ancho fijo con el texto a 13 px sin encoger; los nombres
	-- largos se cortan con «…» para que nunca se alargue hacia la zona de la cámara)
	local rowW, rowH, textSize = 380, 26, 17
	if touchHUD then
		rowW, rowH, textSize = 230, 20, 13
		local function short(name)
			name = tostring(name or "?")
			if (utf8.len(name) or #name) > 12 then
				local cut = utf8.offset(name, 12)
				return string.sub(name, 1, (cut or 12) - 1) .. "…"
			end
			return name
		end
		killer = killer and short(killer)
		victimName = short(victimName)
		victim = string.format('<font color="%s">%s</font>', UI.hex(UI.teamTint(info.VictimColor, true)), victimName)
		if killer then
			text = string.format('<font color="%s">%s</font>%s%s', UI.hex(UI.teamTint(info.KillerColor, true)), killer, weapon, victim)
		else
			text = victim .. " se eliminó"
		end
	end
	local entry = UI.new("Frame", {
		Size = UDim2.fromOffset(rowW, rowH),
		BackgroundColor3 = touchHUD and Color3.fromRGB(14, 16, 22) or Color3.new(0, 0, 0),
		BackgroundTransparency = touchHUD and 0.5 or 0.55,
		LayoutOrder = nextOrder(),
		Parent = refs.KillFeed,
	}, { UI.corner(touchHUD and 5 or 6) })
	if info.Killer == player.Name or info.Victim == player.Name then
		UI.stroke(Color3.fromRGB(255, 210, 80), touchHUD and 1 or 2, touchHUD and 0.3 or 0.2).Parent = entry
	end
	-- Como en los shooters: "Asesino [silueta del arma] Víctima" (si el arma tiene modelo; si no, texto)
	local weaponDef = killer and type(info.WeaponId) == "string" and Weapons.Get(info.WeaponId)
	local iconHolder
	-- (en calidad Baja, texto: cada silueta es una vista 3D y en móviles modestos se nota)
	if weaponDef and (weaponDef.Type == "Gun" or weaponDef.Type == "Melee") and ClientState.EffectiveQuality ~= "Baja" then
		local iconW, iconH = touchHUD and 48 or 62, touchHUD and 17 or 22
		iconHolder = UI.new("Frame", { Size = UDim2.fromOffset(iconW, iconH), BackgroundTransparency = 1, LayoutOrder = 2 })
		local ok = pcall(WeaponIcon.Create, info.WeaponId, "Default", { Size = UDim2.fromScale(1, 1), Parent = iconHolder }, "side", iconW / iconH)
		if not ok then
			iconHolder:Destroy()
			iconHolder = nil
		end
	end
	if iconHolder then
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = entry,
		})
		UI.new("UIPadding", { PaddingRight = UDim.new(0, 6), Parent = entry })
		local function name(order, value, color)
			UI.label({
				LayoutOrder = order,
				Size = UDim2.new(0, 0, 1, 0),
				AutomaticSize = Enum.AutomaticSize.X,
				Text = string.format('<font color="%s">%s</font>', UI.hex(color), tostring(value)),
				RichText = true,
				TextSize = textSize,
				Parent = entry,
			})
		end
		name(1, killer, UI.teamTint(info.KillerColor, true))
		iconHolder.Parent = entry
		if info.Headshot then
			UI.label({ LayoutOrder = 3, Size = UDim2.fromOffset(touchHUD and 20 or 18, rowH), Text = touchHUD and "HS" or "🎯", TextSize = touchHUD and 12 or textSize - 2, Font = touchHUD and Enum.Font.GothamBold or nil, TextColor3 = touchHUD and Color3.fromRGB(255, 210, 60) or nil, Parent = entry })
		end
		name(4, victimName, UI.teamTint(info.VictimColor, true))
	else
		UI.label({
			Size = UDim2.new(1, -12, 1, 0),
			Position = UDim2.fromOffset(6, 0),
			Text = text,
			RichText = true,
			TextSize = textSize,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = entry,
		})
	end
	local entries = {}
	for _, child in refs.KillFeed:GetChildren() do
		if child:IsA("Frame") then
			table.insert(entries, child)
		end
	end
	local maxEntries = touchHUD and (killFeedMax) or (phone and 3 or 6)
	if #entries > maxEntries then
		table.sort(entries, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		for i = 1, #entries - maxEntries do
			entries[i]:Destroy()
		end
	end
	-- (táctil: se va antes, para no tapar la esquina)
	Debris:AddItem(entry, touchHUD and 5 or 7)
end

local hitToken
local checkClutch
local hitFlash, hitFlashTween, hitFlashToken -- destello del enemigo al impactar
local hitFlashOutline -- contorno de enemigo apagado durante el destello
local dmgCombo -- número de daño que se va sumando sobre el enemigo al que das
local function onHitConfirm(damage, headshot, killed, serverPosition)
	local color = Color3.new(1, 1, 1)
	if killed then
		color = Color3.fromRGB(255, 40, 40)
	elseif headshot then
		color = Color3.fromRGB(255, 210, 40)
	end
	for _, line in refs.HitLines do
		line.BackgroundColor3 = color
		-- (normal: corta y blanca; cabeza: más larga y dorada; baja: gruesa y roja)
		line.Size = killed and UDim2.fromOffset(14, 4) or (headshot and UDim2.fromOffset(13, 3) or UDim2.fromOffset(10, 3))
	end
	refs.Hitmarker.Visible = true
	-- (cada impacto "golpea": la X entra grande y se encoge; más en bajas)
	refs.HitScale.Scale = killed and 1.8 or (headshot and 1.45 or 1.25)
	tween(refs.HitScale, 0.12, { Scale = 1 })
	-- (en la baja, la X entra girando)
	refs.Hitmarker.Rotation = killed and -90 or 0
	if killed then
		tween(refs.Hitmarker, 0.25, { Rotation = 0 }, Enum.EasingStyle.Back)
	end
	local token = {}
	hitToken = token
	task.delay(killed and 0.35 or 0.15, function()
		if hitToken == token then
			refs.Hitmarker.Visible = false
		end
	end)
	Sounds.Play(killed and "Kill" or (headshot and "Headshot" or "Hit"))
	-- (a la cabeza, además un «tin» agudo y corto: se reconoce sin mirar)
	if headshot and not killed then
		Sounds.Play("Kill", nil, 1.9, 0.28)
	end

	-- El enemigo al que das destella un instante (blanco; rojo en la baja). Un solo Highlight que se
	-- reutiliza, y sin verse a través de las paredes
	-- (solo si el último disparo propio fue hace muy poco: una granada no hace destellar a otro)
	-- (con la posición del impacto que manda el servidor se comprueba que es ese enemigo; sin ella,
	-- solo si el disparo fue hace muy poco)
	local target = ClientState.LastHitModel
	if target and target.Parent then
		if typeof(serverPosition) == "Vector3" then
			local ok, pivot = pcall(target.GetPivot, target)
			if not ok or (pivot.Position - serverPosition).Magnitude > 8 or os.clock() - ClientState.LastHitTime > 1.5 then
				target = nil
			end
		elseif os.clock() - ClientState.LastHitTime > 0.35 then
			target = nil
		end
	end
	if target and target.Parent then
		if not hitFlash or not hitFlash.Parent then
			hitFlash = Instance.new("Highlight")
			hitFlash.Name = "HitFlash"
			hitFlash.DepthMode = Enum.HighlightDepthMode.Occluded
			hitFlash.OutlineTransparency = 1
			hitFlash.Parent = workspace.CurrentCamera
		end
		-- (un modelo solo muestra un resaltado: el contorno de enemigo se apaga mientras destella,
		-- y el del radar manda: con radar no se destella)
		local outline = target:FindFirstChild("EnemyOutline")
		local radar = target:FindFirstChild("RadarHighlight")
		if outline and outline:IsA("Highlight") and not radar then
			outline.Enabled = false
		end
		if hitFlashOutline and hitFlashOutline ~= outline and hitFlashOutline.Parent and not hitFlashOutline.Parent:FindFirstChild("RadarHighlight") then
			hitFlashOutline.Enabled = true
		end
		hitFlashOutline = outline
		hitFlash.Adornee = not radar and target or nil
		hitFlash.FillColor = killed and Color3.fromRGB(255, 60, 60) or Color3.new(1, 1, 1)
		hitFlash.FillTransparency = killed and 0.25 or 0.45
		hitFlash.Enabled = not radar
		if hitFlashTween then
			hitFlashTween:Cancel()
		end
		local duration = killed and 0.35 or 0.12
		hitFlashTween = tween(hitFlash, duration, { FillTransparency = 1 })
		-- (y se suelta al acabar: si no, taparía otros resaltados del enemigo, como el del radar)
		local flashToken = {}
		hitFlashToken = flashToken
		task.delay(duration + 0.05, function()
			if hitFlashToken == flashToken and hitFlash then
				hitFlash.Enabled = false
				hitFlash.Adornee = nil
				-- (vuelve el contorno, si no hay radar)
				local outline = hitFlashOutline
				if outline and outline.Parent and not outline.Parent:FindFirstChild("RadarHighlight") then
					outline.Enabled = true
				end
				hitFlashOutline = nil
			end
		end)
	end

	-- Número de daño en el mundo, encima de donde le diste (si lo sabemos), con un rebote
	-- El servidor dice dónde fue el daño; si no, el último impacto del propio cliente
	local hitPosition = typeof(serverPosition) == "Vector3" and serverPosition
		or (os.clock() - ClientState.LastHitTime < 0.6 and ClientState.LastHitPosition)
	if type(damage) == "number" and hitPosition then
		-- Como en los shooters de móvil: mientras sigues dando al mismo enemigo, el número se va
		-- sumando (37 → 74 → 111) y crece, en vez de salir un número suelto por bala
		local now = os.clock()
		local combo = dmgCombo
		if not (combo and combo.board.Parent and now - combo.time < 0.8 and (hitPosition - combo.pos).Magnitude < 10) then
			local anchor = Instance.new("Attachment")
			anchor.Parent = workspace.Terrain
			local board = Instance.new("BillboardGui")
			board.Size = UDim2.fromOffset(140, 56)
			board.AlwaysOnTop = true
			board.LightInfluence = 0
			board.Adornee = anchor
			board.Parent = gui.Parent -- (un BillboardGui dentro de un ScreenGui no se dibuja)
			local label = UI.label({ Size = UDim2.fromScale(1, 1), Text = "", Parent = board })
			combo = {
				anchor = anchor,
				board = board,
				label = label,
				scale = UI.new("UIScale", { Parent = label }),
				offset = Vector3.new(math.random(-10, 10) / 10, 1.2, math.random(-10, 10) / 10),
				total = 0,
			}
			dmgCombo = combo
		end
		combo.total += damage
		combo.time = now
		combo.pos = hitPosition
		combo.anchor.WorldPosition = hitPosition + combo.offset
		for _, running in combo.fades or {} do
			running:Cancel()
		end
		combo.fades = nil
		local label = combo.label
		label.Text = ((killed and not touchHUD) and "💀 " or "") .. tostring(combo.total) .. (headshot and "!" or "")
		label.TextSize = (killed and 34 or (headshot and 32 or 26)) + math.min(math.floor(combo.total / 40), 10)
		label.TextColor3 = color
		label.TextTransparency = 0
		label.TextStrokeTransparency = 0.4
		combo.board.StudsOffsetWorldSpace = Vector3.zero
		combo.scale.Scale = 1.6
		tween(combo.scale, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
		local token = {}
		combo.token = token
		if killed then
			dmgCombo = nil -- (el siguiente enemigo empieza de cero)
		end
		task.delay(killed and 0.6 or 0.45, function()
			if combo.token ~= token then
				return
			end
			combo.fades = {
				tween(label, 0.5, { TextTransparency = 1, TextStrokeTransparency = 1 }),
				tween(combo.board, 0.5, { StudsOffsetWorldSpace = Vector3.new(0, 2, 0) }),
			}
			task.wait(0.55)
			if combo.token == token then
				combo.board:Destroy()
				combo.anchor:Destroy()
				if dmgCombo == combo then
					dmgCombo = nil
				end
			end
		end)
		-- Baja: estallido de chispas doradas donde cayó (solo lo ves tú)
		if killed and ClientState.EffectiveQuality ~= "Baja" then
			local burst = Instance.new("Attachment")
			burst.WorldPosition = hitPosition
			burst.Parent = workspace.Terrain
			local sparks = Instance.new("ParticleEmitter")
			sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			sparks.Color = ColorSequence.new(headshot and Color3.fromRGB(255, 220, 80) or Color3.fromRGB(255, 120, 70), Color3.fromRGB(255, 255, 220))
			sparks.LightEmission = 1
			sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
			sparks.Lifetime = NumberRange.new(0.3, 0.55)
			sparks.Speed = NumberRange.new(14, 26)
			sparks.SpreadAngle = Vector2.new(180, 180)
			sparks.Drag = 4
			sparks.Rate = 0
			sparks.Parent = burst
			sparks:Emit(headshot and 28 or 18)
			Debris:AddItem(burst, 1)
		end
	elseif type(damage) == "number" then
		local label = UI.label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.random(30, 60), 0.5, math.random(-40, -20)),
			Size = UDim2.fromOffset(80, 30),
			Text = tostring(damage),
			TextSize = headshot and 28 or 22,
			TextColor3 = color,
			Parent = gui,
		})
		tween(label, 0.6, {
			Position = label.Position + UDim2.fromOffset(0, -30),
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		})
		Debris:AddItem(label, 0.7)
	end
end

local summaryToken = 0

-- Anima el resumen: estadísticas, la barra de nivel se llena (y se vacía al subir de nivel) y las
-- monedas cuentan hacia arriba
local function onMatchSummary(summary)
	if type(summary) ~= "table" or type(summary.XP) ~= "number" then
		return
	end
	-- (con la pantalla final del flujo, el resumen va allí: este cuadro no sale)
	if ClientState.ResultsScreen then
		return
	end
	summaryToken += 1
	local token = summaryToken
	refs.RoundEnd.Size = UDim2.fromOffset(560, 390)
	refs.Summary.Visible = true
	refs.SummaryLevelUp.Visible = false
	local stats = string.format("🎯 %d bajas   🤝 %d asist.   💀 %d muertes   🔥 racha %d", summary.Kills or 0, summary.Assists or 0, summary.Deaths or 0, summary.BestStreak or 0)
	if (summary.Captures or 0) > 0 then
		stats ..= "   🚩 " .. summary.Captures
	end
	if (summary.WinStreak or 0) >= 2 then
		stats ..= "   🏆 x" .. summary.WinStreak
	end
	refs.SummaryStats.Text = stats
	refs.SummaryStats.TextColor3 = Color3.new(1, 1, 1)
	local perLevel = math.max(1, summary.XPPerLevel or 1)
	local level = summary.StartLevel or summary.Level or 1
	refs.SummaryLevel.Text = "NIVEL " .. level
	refs.SummaryFill.Size = UDim2.fromScale(math.clamp((summary.StartXP or 0) / perLevel, 0, 1), 1)
	refs.SummaryXP.Text = "+0 XP"
	refs.SummaryCoins.Text = "+0 💰"
	local levelsUp = math.max(0, (summary.Level or level) - level)
	local startRank = summary.StartRank or summary.RankPoints or 0
	local endRank = summary.RankPoints or startRank
	local rankDelta = endRank - startRank
	local function rankText(points, delta)
		local tier = Ranks.Get(points)
		local deltaText = ""
		if delta > 0 then
			deltaText = '  <font color="#6EE06E">+' .. delta .. " RP</font>"
		elseif delta < 0 then
			deltaText = '  <font color="#FF6E6E">' .. delta .. " RP</font>"
		end
		return string.format('%s <font color="%s"><b>%s</b></font>%s', tier.Icon, UI.hex(tier.Color), UI.upper(tier.Name), deltaText)
	end
	refs.SummaryRank.Text = rankText(startRank, 0)
	task.spawn(function()
		task.wait(0.4)
		-- Barra de XP: un tramo por cada nivel subido
		local levels = math.max(0, (summary.Level or level) - level)
		for i = 0, levels do
			if token ~= summaryToken then
				return
			end
			local target = i < levels and 1 or math.clamp((summary.LevelXP or 0) / perLevel, 0, 1)
			tween(refs.SummaryFill, 0.7, { Size = UDim2.fromScale(target, 1) })
			task.wait(0.75)
			if i < levels then
				level += 1
				refs.SummaryLevel.Text = "NIVEL " .. level
				refs.SummaryLevelUp.Text = "⬆ ¡SUBES DE NIVEL!"
				refs.SummaryLevelUp.TextColor3 = Color3.fromRGB(255, 220, 70)
				refs.SummaryLevelUp.Visible = true
				Sounds.Play("Flag")
				refs.SummaryFill.Size = UDim2.fromScale(0, 1)
			end
		end
		-- Sin subir de nivel: cuánto falta y qué premio espera (ganas de jugar "solo una más")
		if levels == 0 and token == summaryToken and not refs.SummaryLevelUp.Visible then
			local missing = perLevel - (summary.LevelXP or 0)
			local nextTier = GameConfig.BattlePass[level + 1]
			local owned = ClientState.Data and ClientState.Data.Premium == true
			local premiumShown = GameConfig.PremiumPassId ~= 0 or owned
			local prize = nextTier and (describeReward(nextTier.Free) or (premiumShown and nextTier.Premium and "👑 " .. describeReward(nextTier.Premium)) or nil)
			if missing > 0 then
				refs.SummaryLevelUp.Text = "Solo te faltan " .. missing .. " XP para el nivel " .. (level + 1) .. (prize and ("  ·  " .. prize) or "")
				refs.SummaryLevelUp.TextColor3 = Color3.fromRGB(150, 220, 255)
				refs.SummaryLevelUp.Visible = true
			end
		end
	end)
	task.spawn(function()
		-- Contadores de XP y monedas (con monedas volando hasta el contador)
		if (summary.Coins or 0) > 0 then
			RewardFX.FlyCoins(refs.SummaryCoins, math.ceil((summary.Coins or 0) / 15))
		end
		local steps = 24
		for i = 1, steps do
			if token ~= summaryToken then
				return
			end
			local t = i / steps
			refs.SummaryXP.Text = "+" .. math.floor(summary.XP * t) .. " XP"
			refs.SummaryCoins.Text = "+" .. math.floor((summary.Coins or 0) * t) .. " 💰"
			-- (tic-tic mientras cuenta, cada vez más agudo)
			if i % 3 == 0 then
				Sounds.Play("Click", nil, 1 + t * 0.6, 0.4)
			end
			task.wait(0.05)
		end
		Sounds.Play("Kill")
		-- ¡Récord personal de bajas!
		if type(summary.NewRecord) == "number" and token == summaryToken then
			local before = (summary.PrevRecord or 0) > 0 and ("  (antes " .. summary.PrevRecord .. ")") or ""
			-- (el récord también queda escrito en el panel, encima de las estadísticas)
			refs.SummaryStats.Text = "🏆 ¡NUEVO RÉCORD! " .. summary.NewRecord .. " bajas" .. before
			refs.SummaryStats.TextColor3 = Color3.fromRGB(255, 210, 60)
			celebrate("🏆 ¡NUEVO RÉCORD!", summary.NewRecord .. " bajas en una partida" .. before, Color3.fromRGB(255, 200, 40), true)
		end
		if rankDelta ~= 0 and token == summaryToken then
			refs.SummaryRank.Text = rankText(endRank, rankDelta)
			-- ¡Subes de rango!
			if Ranks.Index(endRank) > Ranks.Index(startRank) then
				-- (después de la animación de subir de nivel, que usa el mismo cartel)
				task.wait(math.max(0.3, 0.4 + 0.75 * (levelsUp + 1) - 1.2))
				if token ~= summaryToken then
					return
				end
				local tier = Ranks.Get(endRank)
				refs.SummaryLevelUp.Text = tier.Icon .. " ¡ASCIENDES A " .. UI.upper(tier.Name) .. "!"
				refs.SummaryLevelUp.TextColor3 = tier.Color
				refs.SummaryLevelUp.Visible = true
				Sounds.Play("Flag")
				celebrate(tier.Icon .. " ¡" .. UI.upper(tier.Name) .. "!", "Has subido de rango", tier.Color, true, true)
			end
		end
	end)
end

-- "🥇 Nombre 25/8   🥈 ...": tú en amarillo
local function podiumText(top)
	if type(top) ~= "table" then
		return ""
	end
	local medals = { "🥇", "🥈", "🥉" }
	local parts = {}
	for i, entry in top do
		if type(entry) == "table" and medals[i] then
			local name = tostring(entry.Name or "?")
			local me = not entry.Bot and name == player.DisplayName
			local text = string.format("%s %s %d/%d", medals[i], name, tonumber(entry.Kills) or 0, tonumber(entry.Deaths) or 0)
			if me then
				text = '<font color="#FFE150">' .. text .. "</font>"
			end
			table.insert(parts, text)
		end
	end
	return table.concat(parts, "    ")
end

-- El título del resultado entra de golpe; si ganas, confeti y fanfarria; si pierdes, un golpe grave
local function resultFX(won)
	local scale = refs.RoundTitle:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = refs.RoundTitle })
	scale.Scale = won and 2 or 1.4
	tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	if won then
		RewardFX.Confetti(50)
		RewardFX.Fanfare(true)
		RewardFX.EdgeFlash(Color3.fromRGB(255, 210, 60), 0.5)
	else
		Sounds.Play("Boom", nil, 0.9, 0.3)
	end
end

-- (con token: si llega otro final antes de 7 s, el aviso viejo no esconde el nuevo antes de tiempo)
local roundEndToken = 0
local function hideRoundEndLater()
	roundEndToken += 1
	local token = roundEndToken
	task.delay(7, function()
		if roundEndToken == token then
			refs.RoundEnd.Visible = false
		end
	end)
end

local function onRoundEnd(info)
	if type(info) ~= "table" then
		return
	end
	if ClientState.ResultsScreen then
		return
	end
	refs.RoundTop.Text = podiumText(info.Top)
	summaryToken += 1
	refs.RoundEnd.Size = UDim2.fromOffset(560, 220)
	refs.Summary.Visible = false
	local teamA = ReplicatedStorage:GetAttribute("TeamA") or "Rojo"
	local teamB = ReplicatedStorage:GetAttribute("TeamB") or "Azul"
	if info.TeamMode == false then
		local won = info.Winner == player.Name
		refs.RoundTitle.Text = won and "¡VICTORIA!" or (info.Winner and (info.Winner .. " GANA") or "FIN")
		refs.RoundTitle.TextColor3 = won and Color3.fromRGB(255, 210, 60) or Color3.fromRGB(255, 120, 80)
		resultFX(won)
		refs.RoundScore.Text = "👑 " .. tostring(info.Winner or "-") .. " · " .. tostring(info.LeaderScore or 0)
		refs.RoundMVP.Text = info.MVP and ("⭐ MVP: " .. info.MVP .. " (" .. info.MVPKills .. " bajas)") or ""
		refs.RoundEnd.Visible = true
		hideRoundEndLater()
		return
	elseif info.Winner then
		local won = player.Team and player.Team.Name == info.Winner
		refs.RoundTitle.Text = won and (info.Comeback and "¡REMONTADA!" or "¡VICTORIA!") or "DERROTA"
		refs.RoundTitle.TextColor3 = won and Color3.fromRGB(255, 210, 60) or Color3.fromRGB(255, 80, 80)
		resultFX(won)
	else
		refs.RoundTitle.Text = "EMPATE"
		refs.RoundTitle.TextColor3 = Color3.new(1, 1, 1)
	end
	local colorA = refs.ScoreABox.BackgroundColor3
	local colorB = refs.ScoreBBox.BackgroundColor3
	refs.RoundScore.Text = string.format(
		'<font color="%s">%s %d</font>  -  <font color="%s">%d %s</font>',
		UI.hex(colorA),
		teamA,
		info.ScoreA or 0,
		UI.hex(colorB),
		info.ScoreB or 0,
		teamB
	)
	local mvpText = ""
	if info.MVP then
		local captures = info.MVPCaptures or 0
		mvpText = "⭐ MVP: " .. info.MVP .. " (" .. info.MVPKills .. " bajas"
		if captures > 0 then
			mvpText ..= ", " .. captures .. (captures == 1 and " captura" or " capturas")
		end
		mvpText ..= ")"
	end
	refs.RoundMVP.Text = mvpText
	-- ¡Eres el MVP! (la línea del MVP salta y brilla; no ocupa turno de celebración: esas quedan
	-- para subir de nivel, de rango o batir tu récord)
	if info.MVP == player.Name then
		refs.RoundMVP.Text = "⭐ ¡ERES EL MVP! (" .. tostring(info.MVPKills or 0) .. " bajas)"
		local mvpScale = refs.RoundMVP:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = refs.RoundMVP })
		mvpScale.Scale = 1.5
		task.delay(0.8, function()
			tween(mvpScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
			Sounds.Play("Kill", nil, 1.5, 0.5)
		end)
	end
	refs.RoundEnd.Visible = true
	hideRoundEndLater()
end

---------------------------------------------------------------------------
-- Actualización
---------------------------------------------------------------------------

local function getThumbnail(userId)
	if thumbnails[userId] ~= nil then
		return thumbnails[userId]
	end
	thumbnails[userId] = ""
	task.spawn(function()
		local ok, image = pcall(function()
			return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
		end)
		thumbnails[userId] = ok and image or ""
	end)
	return ""
end

local lastRowSignature = ""

local function updatePlayerRow()
	local list = Players:GetPlayers()
	local function kills(p)
		local stats = p:FindFirstChild("leaderstats")
		local value = stats and stats:FindFirstChild("Bajas")
		return value and value.Value or 0
	end
	table.sort(list, function(a, b)
		return kills(a) > kills(b)
	end)
	-- Solo se reconstruye si algo ha cambiado (orden, bajas, equipos o fotos ya cargadas)
	local parts = {}
	for rank = 1, math.min(10, #list) do
		local p = list[rank]
		table.insert(parts, p.UserId .. ":" .. kills(p) .. ":" .. tostring(p.Team) .. ":" .. tostring(getThumbnail(p.UserId) ~= ""))
	end
	local signature = table.concat(parts, "|")
	if signature == lastRowSignature then
		return
	end
	lastRowSignature = signature
	for _, child in refs.PlayerRow:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	for rank = 1, math.min(10, #list) do
		local p = list[rank]
		local teamColor = p.Team and p.TeamColor.Color or Color3.new(1, 1, 1)
		local card = UI.new("Frame", {
			LayoutOrder = rank,
			Size = UDim2.fromOffset(40, 54),
			BackgroundTransparency = 1,
			Parent = refs.PlayerRow,
		})
		UI.new("ImageLabel", {
			Size = UDim2.fromOffset(40, 40),
			BackgroundColor3 = Color3.fromRGB(40, 40, 45),
			Image = getThumbnail(p.UserId),
			Parent = card,
		}, { UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0) }), UI.stroke(teamColor, 3, 0) })
		UI.label({
			Position = UDim2.fromOffset(-6, -6),
			Size = UDim2.fromOffset(24, 14),
			Text = "#" .. rank,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		UI.label({
			Position = UDim2.fromOffset(0, 38),
			Size = UDim2.fromOffset(40, 16),
			Text = tostring(kills(p)),
			TextSize = 15,
			TextColor3 = p == player and Color3.fromRGB(255, 210, 60) or Color3.new(1, 1, 1),
			Parent = card,
		})
	end
end

-- Últimos valores escritos en el HUD (para no reescribir textos iguales cada fotograma)
local hudCache: { [string]: any } = {}

local function updateScoreboard()
	local teamA = ReplicatedStorage:GetAttribute("TeamA")
	local teamB = ReplicatedStorage:GetAttribute("TeamB")
	if teamA then
		refs.ScoreA.Text = tostring(ReplicatedStorage:GetAttribute("Score_" .. teamA) or 0)
		local team = game:GetService("Teams"):FindFirstChild(teamA)
		if team then
			refs.ScoreABox.BackgroundColor3 = UI.teamTint(team.TeamColor.Color)
		end
	end
	if teamB then
		refs.ScoreB.Text = tostring(ReplicatedStorage:GetAttribute("Score_" .. teamB) or 0)
		local team = game:GetService("Teams"):FindFirstChild(teamB)
		if team then
			refs.ScoreBBox.BackgroundColor3 = UI.teamTint(team.TeamColor.Color)
		end
	end
	local state = ReplicatedStorage:GetAttribute("State")
	local timeLeft = ReplicatedStorage:GetAttribute("TimeLeft") or 0
	local modeName = ReplicatedStorage:GetAttribute("ModeName") or "Duelo por equipos"
	local mapName = ReplicatedStorage:GetAttribute("MapName") or ""
	local teamMode = ReplicatedStorage:GetAttribute("TeamMode") ~= false
	refs.Timer.Text = UI.formatTime(timeLeft)
	-- (táctil: la línea fija «mapa · modo · primero a N» no se enseña en combate; solo lo que cambia)
	local modeStatic = false
	if state == "Intermission" then
		refs.Mode.Text = "Calentamiento · " .. mapName .. " · vota el siguiente mapa (" .. timeLeft .. ")"
	elseif state == "Ended" then
		refs.Mode.Text = "Fin de la ronda"
	else
		refs.Mode.Text = mapName .. " · " .. modeName .. " · Primero a " .. tostring(ReplicatedStorage:GetAttribute("ScoreToWin") or "?")
		modeStatic = true
		-- Eliminación: cuántos quedan en pie de cada equipo
		local aliveA, aliveB = ReplicatedStorage:GetAttribute("AliveA"), ReplicatedStorage:GetAttribute("AliveB")
		if aliveA and aliveB and teamA and teamB then
			refs.Mode.Text = modeName .. " · En pie: " .. teamA .. " " .. aliveA .. " – " .. aliveB .. " " .. teamB
			modeStatic = false
			checkClutch(aliveA, aliveB, teamA)
		end
	end

	refs.Mode.Visible = not (touchHUD and modeStatic)

	-- Modos sin equipos: tu puntuación contra la del líder
	if not teamMode then
		refs.ScoreA.Text = tostring(player:GetAttribute("Score") or 0)
		refs.ScoreB.Text = tostring(ReplicatedStorage:GetAttribute("LeaderScore") or 0)
		refs.ScoreABox.BackgroundColor3 = Color3.fromRGB(60, 170, 90)
		refs.ScoreBBox.BackgroundColor3 = Color3.fromRGB(230, 160, 30)
		refs.FlagA.Text, refs.FlagA.TextColor3 = "TÚ", Color3.fromRGB(150, 255, 150)
		local leader = ReplicatedStorage:GetAttribute("LeaderName") or ""
		refs.FlagB.Text = leader ~= "" and (UI.HudText("👑 ") .. leader) or "LÍDER"
		refs.FlagB.TextColor3 = Color3.fromRGB(255, 210, 80)
		return
	end

	-- Banderas
	local function flagStatus(teamName)
		local flagState = teamName and ReplicatedStorage:GetAttribute("FlagState_" .. teamName)
		if flagState == "Home" then
			return UI.HudText("🚩 En base"), Color3.fromRGB(150, 255, 150)
		elseif flagState == "Carried" then
			local carrier = ReplicatedStorage:GetAttribute("FlagCarrier_" .. teamName) or ""
			return UI.HudText("⚠ ") .. carrier, Color3.fromRGB(255, 90, 90)
		elseif flagState == "Dropped" then
			return UI.HudText("⬇ Caída"), Color3.fromRGB(255, 210, 80)
		end
		return "", Color3.new(1, 1, 1)
	end
	refs.FlagA.Text, refs.FlagA.TextColor3 = flagStatus(teamA)
	refs.FlagB.Text, refs.FlagB.TextColor3 = flagStatus(teamB)

	-- Zona de control
	local zoneOwner = ReplicatedStorage:GetAttribute("ZoneOwner")
	if zoneOwner ~= nil then
		if zoneOwner == "" then
			refs.FlagA.Text, refs.FlagA.TextColor3 = "◆ Zona libre", Color3.new(1, 1, 1)
		elseif zoneOwner == "Contested" then
			refs.FlagA.Text, refs.FlagA.TextColor3 = "◆ ¡DISPUTADA!", Color3.fromRGB(255, 200, 40)
		else
			local team = game:GetService("Teams"):FindFirstChild(zoneOwner)
			refs.FlagA.Text = "◆ Zona: " .. zoneOwner
			refs.FlagA.TextColor3 = team and team.TeamColor.Color or Color3.new(1, 1, 1)
		end
		refs.FlagB.Text = "Se mueve en " .. tostring(ReplicatedStorage:GetAttribute("ZoneMoveIn") or 0) .. "s"
		refs.FlagB.TextColor3 = Color3.fromRGB(200, 210, 230)
	end

	-- Infección: supervivientes contra zombis (en vez de los puntos)
	local infection = ReplicatedStorage:GetAttribute("Infection")
	if infection and state == "Playing" then
		local survivors = ReplicatedStorage:GetAttribute("AliveA") or 0
		local zombies = ReplicatedStorage:GetAttribute("AliveB") or 0
		refs.ScoreA.Text = tostring(survivors)
		refs.ScoreB.Text = tostring(zombies)
		refs.ScoreBBox.BackgroundColor3 = Color3.fromRGB(90, 160, 60)
		refs.FlagA.Text, refs.FlagA.TextColor3 = UI.HudText("🧑 Supervivientes"), Color3.fromRGB(200, 230, 255)
		refs.FlagB.Text, refs.FlagB.TextColor3 = UI.HudText("🧟 Zombis"), Color3.fromRGB(150, 255, 120)
		local zombie = player.Team and player.Team.Name == teamB and infection == "On"
		refs.Mode.Visible = true
		if infection == "Prep" then
			refs.Mode.Text = modeName .. " · ¡Escóndete! La infección va a empezar"
		elseif zombie then
			refs.Mode.Text = modeName .. UI.HudText(" · 🧟 Eres un zombi: ¡atrapa a los supervivientes!")
		else
			refs.Mode.Text = modeName .. " · ¡Sobrevive hasta que acabe el tiempo!"
		end
	end

	-- Táctil (Fase 15): tu equipo siempre a la izquierda y en azul, el rival a la derecha en rojo
	-- (los números, sus avisos de bandera o zona y los colores)
	if touchHUD and teamA and teamB and player.Team and not (infection and state == "Playing") then
		if player.Team.Name == teamB then
			refs.ScoreA.Text, refs.ScoreB.Text = refs.ScoreB.Text, refs.ScoreA.Text
			if zoneOwner == nil then
				refs.FlagA.Text, refs.FlagB.Text = refs.FlagB.Text, refs.FlagA.Text
				refs.FlagA.TextColor3, refs.FlagB.TextColor3 = refs.FlagB.TextColor3, refs.FlagA.TextColor3
			end
		end
		if player.Team.Name == teamA or player.Team.Name == teamB then
			refs.ScoreABox.BackgroundColor3 = Color3.fromRGB(46, 120, 230)
			refs.ScoreBBox.BackgroundColor3 = Color3.fromRGB(214, 58, 58)
		end
	end

	-- La bandera que llevamos a la espalda no nos tapa la vista
	-- (solo se repasa cuando cambia qué banderas llevamos: este aviso llega con cada atributo)
	local flagsFolder = workspace:FindFirstChild("Flags")
	local carrying = ""
	if flagsFolder then
		for _, model in flagsFolder:GetChildren() do
			local teamName = string.gsub(model.Name, "^Flag_", "")
			if ReplicatedStorage:GetAttribute("FlagCarrier_" .. teamName) == player.Name then
				carrying ..= teamName
			end
		end
		carrying ..= "#" .. #flagsFolder:GetChildren()
	end
	if flagsFolder and carrying ~= hudCache.Carrying then
		hudCache.Carrying = carrying
		for _, model in flagsFolder:GetChildren() do
			local teamName = string.gsub(model.Name, "^Flag_", "")
			local mine = ReplicatedStorage:GetAttribute("FlagCarrier_" .. teamName) == player.Name
			for _, part in model:GetDescendants() do
				if part:IsA("BasePart") then
					part.LocalTransparencyModifier = mine and 1 or 0
				elseif part:IsA("BillboardGui") then
					part.Enabled = not mine
				end
			end
		end
	end
end

local lastXP = { Level = nil, XP = nil }
local readyAchievements = nil -- logros listos para reclamar en la última actualización (nil = aún no)

-- Al completar un logro en plena partida: aviso grande (se reclama en el Perfil)
local function checkAchievements(data)
	local ready = {}
	for _, achievement in GameConfig.Achievements do
		if not (data.Achievements or {})[achievement.Id] and (tonumber(data[achievement.Stat]) or 0) >= achievement.Goal then
			ready[achievement.Id] = achievement
		end
	end
	-- (fuera de la partida se espera: no se pisa con el fin de partida ni se gasta en el menú)
	if readyAchievements and (ReplicatedStorage:GetAttribute("State") ~= "Playing" or ClientState.InMainMenu) then
		return
	end
	if readyAchievements then
		for id, achievement in ready do
			if not readyAchievements[id] then
				bigMessage("🏅 ¡LOGRO! " .. achievement.Icon .. " " .. achievement.Text, Color3.fromRGB(120, 255, 160))
				timedLabel(refs.Toast, "Recógelo en el menú → Perfil: +" .. tostring(achievement.Coins) .. " 💰", 4)
				RewardFX.EdgeFlash(Color3.fromRGB(120, 255, 160), 0.5)
				RewardFX.Fanfare(false)
				break -- (uno por actualización: si saltan varios a la vez, el resto sale en el Perfil)
			end
		end
	end
	readyAchievements = ready
end
local XP_BLUE = Color3.fromRGB(80, 170, 255)

local function updateData(data)
	if not data then
		return
	end
	local per = data.XPPerLevel or 1000
	-- Con el próximo premio del pase a la vista: siempre hay algo "a punto" de caer
	local nextTier = GameConfig.BattlePass[(data.Level or 1) + 1]
	-- (el premio premium solo si el pase se puede comprar o ya lo tiene)
	local premiumShown = GameConfig.PremiumPassId ~= 0 or data.Premium == true
	local nextText = nextTier and (describeReward(nextTier.Free) or (premiumShown and nextTier.Premium and "👑 " .. describeReward(nextTier.Premium)) or nil)
	refs.LevelText.Text = "Nivel " .. data.Level .. "  ·  " .. data.XP .. "/" .. per .. " XP" .. (nextText and ("  ·  Próximo: " .. nextText) or "")
	tween(refs.XPFill, 0.3, { Size = UDim2.fromScale(math.clamp(data.XP / per, 0, 1), 1) })
	-- Al ganar XP la barra destella y da un saltito
	if lastXP.Level == data.Level and lastXP.XP and data.XP > lastXP.XP then
		refs.XPFill.BackgroundColor3 = Color3.new(1, 1, 1)
		tween(refs.XPFill, 0.4, { BackgroundColor3 = XP_BLUE })
		refs.XPScale.Scale = 1.08
		tween(refs.XPScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	lastXP.Level, lastXP.XP = data.Level, data.XP
	checkAchievements(data)
	-- La chuleta de teclas solo para los que empiezan (luego estorba al killfeed y a las armas)
	if refs.KeyHints then
		refs.KeyHints.Visible = (data.Level or 1) < 5
	end
end

local lastHealth = 100
local lastDamageTime = 0
local lowHealthCC: ColorCorrectionEffect? = nil
local chipRatio = 1
local renderCrosshair

-- "Clutch" (Eliminación y Buscar y destruir): si eres el último de tu equipo en pie, aviso de
-- «1 CONTRA N»; si acabas con todos, celebración
local clutch = nil -- { Enemies = N } mientras dura
checkClutch = function(aliveA, aliveB, teamA)
	local mode = ReplicatedStorage:GetAttribute("Mode")
	-- (solo quien juega de verdad esta ronda: no desde la pantalla de inicio)
	if (mode ~= "ELIM" and mode ~= "SND") or ReplicatedStorage:GetAttribute("Infection") == "On" or not player.Team
		or ClientState.InMainMenu or player:GetAttribute("InMenu") or not player:GetAttribute("ElimIn") then
		clutch = nil
		return
	end
	local mine, theirs = aliveA, aliveB
	if player.Team.Name ~= teamA then
		mine, theirs = aliveB, aliveA
	end
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local alive = humanoid ~= nil and humanoid.Health > 0
	if not clutch then
		if alive and mine == 1 and theirs >= 2 then
			clutch = { Enemies = theirs }
			bigMessage("⚔ 1 CONTRA " .. theirs, Color3.fromRGB(255, 90, 70))
			RewardFX.EdgeFlash(Color3.fromRGB(255, 60, 40), 0.5)
			Sounds.Play("Boom", nil, 1.1, 0.3)
		end
	elseif theirs == 0 and alive and ReplicatedStorage:GetAttribute("Bomb_State") ~= "Planted" then
		-- (con la bomba plantada aún hay que desactivarla: entonces no es victoria todavía)
		celebrate("🔥 ¡CLUTCH!", "Ganaste la ronda tú solo contra " .. clutch.Enemies, Color3.fromRGB(255, 140, 40), true)
		clutch = nil
	elseif not alive or mine > 1 then
		clutch = nil -- (caíste, o empezó otra ronda con el equipo entero)
	end
end

local function render(dt)
	-- (en la pantalla de inicio y durante la killcam final no se dibuja el HUD)
	gui.Enabled = not ClientState.InMainMenu and not ClientState.KillcamFinal
	if not gui.Enabled then
		-- (el mundo no se queda sin color si se volvió al menú con poca vida)
		if lowHealthCC and lowHealthCC.Saturation ~= 0 then
			lowHealthCC.Saturation, lowHealthCC.Contrast = 0, 0
			lowHealthCC.TintColor = Color3.new(1, 1, 1)
			hudCache.HealthRatio = nil
		end
		return
	end
	-- Durante la killcam, su propio rótulo dice quién te eliminó y con qué (no se pisan)
	local showDeath = not ClientState.KillcamActive
	if refs.DeathText.Visible ~= showDeath then
		refs.DeathText.Visible = showDeath
		refs.DeathIcon.Visible = showDeath
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	-- Vida
	if humanoid then
		local health = math.max(0, humanoid.Health)
		local ratio = health / math.max(humanoid.MaxHealth, 1)
		local shown = math.ceil(health)
		local healthChanged = ratio ~= hudCache.HealthRatio or shown ~= hudCache.HealthShown or not (lowHealthCC and lowHealthCC.Parent)
		hudCache.HealthRatio, hudCache.HealthShown = ratio, shown
		if healthChanged then
			refs.HealthFill.Size = UDim2.fromScale(ratio, 1)
			if touchHUD then
				-- (táctil, Fase 17: la paleta del HUD; blanca, amarilla con poca vida y roja al borde)
				local tone = ratio > 0.35 and TOUCH_HEALTH.Ok or ratio > 0.2 and TOUCH_HEALTH.Low or TOUCH_HEALTH.Critical
				refs.HealthFill.BackgroundColor3 = tone
				refs.HealthText.TextColor3 = ratio > 0.35 and Color3.new(1, 1, 1) or tone
			else
				refs.HealthFill.BackgroundColor3 = Color3.fromRGB(230, 60, 60):Lerp(Color3.fromRGB(70, 220, 90), ratio)
			end
			refs.HealthText.Text = tostring(shown)
		end
		-- La parte blanca baja despacio y deja ver el daño recibido
		local newChip = ratio > chipRatio and ratio or math.max(ratio, chipRatio - dt * 0.5)
		if newChip ~= chipRatio or healthChanged then
			chipRatio = newChip
			refs.HealthChip.Size = UDim2.fromScale(chipRatio, 1)
		end
		if health < lastHealth - 0.5 then
			lastDamageTime = os.clock()
			refs.DamageStroke.Transparency = 0.35
			tween(refs.DamageStroke, 0.6, { Transparency = 1 })
		elseif ratio < 0.35 and ratio > 0 and os.clock() - lastDamageTime > 0.6 then
			-- Vida baja: la viñeta roja late
			refs.DamageStroke.Transparency = 0.7 + 0.15 * math.sin(os.clock() * 5)
		end
		lastHealth = health
		-- Vida baja: el mundo pierde color poco a poco (corrección de color solo en este cliente)
		local lowCC = lowHealthCC
		if healthChanged then
			if not lowCC or not lowCC.Parent then
				lowCC = Instance.new("ColorCorrectionEffect")
				lowCC.Name = "LowHealthCC"
				lowCC.Parent = game:GetService("Lighting")
				lowHealthCC = lowCC
			end
			local danger = (health > 0 and ratio < 0.4) and (1 - ratio / 0.4) or 0
			lowCC.Saturation = -0.7 * danger
			lowCC.TintColor = Color3.new(1, 1, 1):Lerp(Color3.fromRGB(255, 200, 200), danger)
			lowCC.Contrast = 0.1 * danger
		end
	end

	-- Racha (los textos solo se reescriben cuando cambia el valor: cada escritura recoloca la interfaz)
	local streak = player:GetAttribute("Streak") or 0
	local rewards = ReplicatedStorage:GetAttribute("Mode") ~= "GUN" and not (player.Character and player.Character:GetAttribute("Zombie"))
	if streak ~= hudCache.Streak or rewards ~= hudCache.StreakRewards then
		-- Cada baja de la racha: el texto da un salto y se va "calentando" (blanco → naranja → rojo);
		-- con 10, 15, 20... bajas sin morir, aviso grande
		if type(hudCache.Streak) == "number" and streak > hudCache.Streak then
			refs.StreakScale.Scale = 1.35
			tween(refs.StreakScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
			-- (también si una granada la hace saltar de 9 a 11)
			local milestone = math.floor(streak / 5) * 5
			if milestone >= 10 and milestone > hudCache.Streak then
				bigMessage("🔥 ¡RACHA DE " .. milestone .. "!", Color3.fromRGB(255, 120, 40))
				RewardFX.EdgeFlash(Color3.fromRGB(255, 120, 40), 0.55)
				RewardFX.Fanfare(false)
			end
		end
		local heat = math.clamp(streak / 10, 0, 1)
		refs.StreakText.TextColor3 = Color3.fromRGB(255, 210, 80):Lerp(Color3.fromRGB(255, 70, 40), heat)
		hudCache.Streak, hudCache.StreakRewards = streak, rewards
		-- Cuánto falta para la siguiente recompensa (Radar con 3, Ataque aéreo con 5)
		local nextText = ""
		-- (táctil: con palabras, sin emoji)
		if rewards and streak < 3 then
			nextText = (touchHUD and "  ·  radar en " or "  ·  📡 en ") .. (3 - streak)
		elseif rewards and streak < 5 then
			nextText = (touchHUD and "  ·  ataque aéreo en " or "  ·  ✈ en ") .. (5 - streak)
		end
		refs.StreakText.Text = "Racha x" .. streak .. nextText
		-- (sin racha no se enseña: menos cosas en pantalla mientras se lucha)
		refs.StreakText.Visible = streak > 0
		refs.StreakFill.Parent.Visible = streak > 0 and not touchHUD
		refs.StreakFill.Size = UDim2.fromScale(1, math.clamp(streak / 10, 0, 1))
	end

	-- Arma
	local def = ClientState.CurrentDef
	local tool = ClientState.CurrentTool
	if def and tool then
		setText(refs.WeaponName, def.DisplayName)
		if def.Type == "Gun" then
			local reserve = tool:GetAttribute("Reserve") or 0
			local low = ClientState.Ammo <= math.ceil(def.MagSize * 0.25)
			if ClientState.Ammo ~= hudCache.Ammo or reserve ~= hudCache.Reserve or low ~= hudCache.Low then
				hudCache.Ammo, hudCache.Reserve, hudCache.Low = ClientState.Ammo, reserve, low
				refs.Ammo.Text = string.format(
					'<font color="%s">%d</font><font size="%d" color="#C8C8C8"> | %d</font>',
					low and "#FF5050" or "#FFFFFF",
					ClientState.Ammo,
					phone and 15 or 28, -- (la reserva, más pequeña; en el teléfono todo es más pequeño)
					reserve
				)
			end
			refs.AmmoBar.Visible = true
			-- (la barra solo se toca cuando cambia: antes se redimensionaba en cada fotograma)
			local fill = math.clamp(ClientState.Reloading and ClientState.ReloadProgress or ClientState.Ammo / def.MagSize, 0, 1)
			fill = math.floor(fill * 200 + 0.5) / 200
			local fillState = ClientState.Reloading and "R" or (low and "L" or "N")
			if fill ~= hudCache.AmmoFill or fillState ~= hudCache.AmmoFillState then
				hudCache.AmmoFill, hudCache.AmmoFillState = fill, fillState
				refs.AmmoFill.Size = UDim2.fromScale(fill, 1)
				refs.AmmoFill.BackgroundColor3 = fillState == "R" and Color3.fromRGB(120, 200, 255)
					or (fillState == "L" and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(255, 210, 80))
			end
			local percent = ClientState.Reloading and math.floor(ClientState.ReloadProgress * 100) or -1
			if ClientState.Reloading then
				if percent ~= hudCache.ReloadPercent then
					setText(refs.ReloadHint, "RECARGANDO " .. percent .. "%")
				end
			elseif ClientState.Ammo == 0 and reserve == 0 then
				setText(refs.ReloadHint, "SIN MUNICIÓN")
			elseif ClientState.Ammo <= math.ceil(def.MagSize * 0.25) then
				setText(refs.ReloadHint, not InputMode.TouchUI() and "[R] Recargar" or "Recargar")
			else
				setText(refs.ReloadHint, "")
			end
			hudCache.ReloadPercent = percent
		else
			hudCache.Ammo = nil
			setText(refs.Ammo, "∞")
			setText(refs.ReloadHint, "")
			refs.AmmoBar.Visible = false
		end
	else
		hudCache.Ammo = nil
		setText(refs.WeaponName, "")
		setText(refs.Ammo, "")
		setText(refs.ReloadHint, "")
		refs.AmmoBar.Visible = false
	end

	-- Táctil (Fase 15): munición compacta junto a recargar («ARX-27» pequeño y «30 | 120») y, en la
	-- tarjeta de cambiar arma, el arma a la que se cambia. Solo se reescribe cuando cambia algo (se
	-- mira en bruto cada fotograma, sin crear textos)
	if touchHUD then
		local isGun = def ~= nil and tool ~= nil and def.Type == "Gun"
		local reserve = isGun and (tool:GetAttribute("Reserve") or 0) or -1
		if def ~= hudCache.CardDef or ClientState.Ammo ~= hudCache.CardAmmo or reserve ~= hudCache.CardReserve or ClientState.Reloading ~= hudCache.CardReloading then
			hudCache.CardDef, hudCache.CardAmmo, hudCache.CardReserve = def, ClientState.Ammo, reserve
			hudCache.CardReloading = ClientState.Reloading
			local name, ammo, nameColor = "", "", Color3.fromRGB(200, 204, 214)
			if def and tool then
				name = string.upper(def.DisplayName)
				ammo = "∞"
				if isGun then
					-- (blanco normal, naranja con pocas balas, rojo vacío; recargando, el nombre lo dice)
					local color = "#FFFFFF"
					if ClientState.Ammo <= 0 then
						color = "#FF5C48"
					elseif ClientState.Ammo <= math.ceil(def.MagSize * 0.25) then
						color = "#FFB040"
					end
					ammo = string.format('<font color="%s">%d</font><font size="14" color="#AEB4C2">  |  %d</font>', color, ClientState.Ammo, reserve)
					if ClientState.Reloading then
						name, nameColor = "RECARGANDO…", Color3.fromRGB(255, 205, 60)
					elseif ClientState.Ammo == 0 and reserve == 0 then
						name, nameColor = "SIN MUNICIÓN", Color3.fromRGB(255, 92, 72)
					end
				end
			end
			setText(refs.TouchWeapon, name)
			refs.TouchWeapon.TextColor3 = nameColor
			setText(refs.TouchAmmoText, ammo)
		end
		-- (CardNext empieza en false: con una sola arma desde el principio también se esconde)
		if hudCache.CardNext == nil or (hudCache.NextWeapon or false) ~= hudCache.CardNext then
			hudCache.CardNext = hudCache.NextWeapon or false
			TouchLayout.SetCard("SwapWeapon", { Title = hudCache.NextWeapon or "" })
			-- (con una sola arma no hay a qué cambiar: la tarjeta no se ve)
			TouchLayout.SetHidden("SwapWeapon", hudCache.NextWeapon == nil)
		end
	end

	-- Ranuras: se revisan al cambiar de arma y, si no, unas 4 veces por segundo
	local now = os.clock()
	if tool == hudCache.SlotTool and now - (hudCache.SlotsAt or 0) < 0.25 then
		renderCrosshair(def)
		return
	end
	hudCache.SlotTool, hudCache.SlotsAt = tool, now
	local tools = WeaponController.GetTools()
	-- (qué arma llevas de cuántas, para la tarjeta táctil: «1/2»)
	local count, current = 0, 0
	for slot = 1, 3 do
		local slotTool = tools[slot]
		if slotTool and slotTool:GetAttribute("Weapon") then
			count += 1
			if slotTool == tool then
				current = count
			end
		end
	end
	hudCache.SlotText = count > 1 and current > 0 and (current .. "/" .. count) or ""
	-- (el arma a la que lleva el botón de cambiar: la siguiente que haya después de la actual)
	local nextName = nil
	if count > 1 then
		local currentSlot = 0
		for slot = 1, 3 do
			if tools[slot] == tool then
				currentSlot = slot
			end
		end
		for step = 1, 3 do
			local slotTool = tools[(currentSlot + step - 1) % 3 + 1]
			local slotDef = slotTool and slotTool ~= tool and Weapons.Get(slotTool:GetAttribute("Weapon") or "")
			if slotDef then
				nextName = string.upper(slotDef.DisplayName)
				break
			end
		end
	end
	hudCache.NextWeapon = nextName
	for slot, row in refs.Slots do
		local slotTool = tools[slot]
		local weaponName = slotTool and slotTool:GetAttribute("Weapon")
		local slotDef = weaponName and Weapons.Get(weaponName)
		row.Row.Visible = slotDef ~= nil
		row.Name.Text = slotDef and slotDef.DisplayName or ""
		local active = slotTool ~= nil and slotTool == tool
		row.Name.TextColor3 = active and Color3.fromRGB(255, 210, 60) or Color3.fromRGB(220, 220, 220)
		row.Key.BackgroundColor3 = active and Color3.fromRGB(255, 170, 30) or Color3.fromRGB(20, 20, 25)
		row.Stroke.Transparency = active and 0 or 1
		row.Row.BackgroundTransparency = active and 0.45 or 0.7
		-- Icono 3D (solo se reconstruye si cambia el arma o la skin)
		local skinId = slotTool and slotTool:GetAttribute("Skin")
		local iconKey = slotDef and (weaponName .. "|" .. tostring(skinId)) or nil
		if iconKey ~= row.IconKey then
			row.IconKey = iconKey
			row.Icon:ClearAllChildren()
			if iconKey then
				WeaponIcon.Create(weaponName, skinId, { Size = UDim2.fromScale(1, 1), Parent = row.Icon }, "side", 170 / 44)
			end
		end
	end

	renderCrosshair(def)
end

-- Mira (color y tamaño elegidos en Ajustes)
function renderCrosshair(def)
	local settings = Settings.Get()
	local colorIndex = math.clamp(math.floor(settings.CrossColor or 1), 1, #GameConfig.CrosshairColors)
	local size = settings.CrossSize or 1
	if colorIndex ~= hudCache.CrossColor or size ~= hudCache.CrossSize then
		hudCache.CrossColor, hudCache.CrossSize = colorIndex, size
		local color = GameConfig.CrosshairColors[colorIndex]
		for _, line in refs.CrossLines do
			local vertical = line.Dir.X == 0
			line.Frame.BackgroundColor3 = color
			line.Frame.Size = vertical and UDim2.fromOffset(2, math.floor(9 * size + 0.5)) or UDim2.fromOffset(math.floor(9 * size + 0.5), 2)
		end
		refs.CrossDot.BackgroundColor3 = color
	end
	local aim = ClientState.AimAlpha
	local isGun = def and def.Type == "Gun"
	local gap = (6 + ClientState.Spread * 6) * size
	local linesVisible = isGun and aim < 0.5
	-- (las cuatro rayas solo se mueven si cambia la apertura: quieto y sin disparar, no se tocan)
	if gap ~= hudCache.CrossGap or linesVisible ~= hudCache.CrossLinesVisible then
		hudCache.CrossGap, hudCache.CrossLinesVisible = gap, linesVisible
		for _, line in refs.CrossLines do
			line.Frame.Position = UDim2.fromOffset(line.Dir.X * (gap + 4 * size), line.Dir.Y * (gap + 4 * size))
			line.Frame.Visible = linesVisible
		end
	end
	refs.CrossDot.Visible = aim < 0.5
	refs.Crosshair.Visible = not ClientState.IsBlocked()
	refs.Scope.Visible = def ~= nil and def.Scope == true and aim > 0.85
	if refs.Scope.Visible then
		local hint = ""
		if not InputMode.TouchUI() then
			hint = ScopeSway.Holding and "Aguantando la respiración…"
				or ScopeSway.OutOfBreath() and "Sin aire…"
				or "MAYÚS · aguantar la respiración"
		end
		if refs.ScopeHint.Text ~= hint then
			refs.ScopeHint.Text = hint
		end
	end
end

---------------------------------------------------------------------------
-- Táctil (Fase 12): lo que no son botones se coloca según dónde han quedado los botones (cambian con
-- la pantalla, el botón de saltar de Roblox y el editor de HUD), sin pisarlos ni tapar el centro
---------------------------------------------------------------------------

-- Rectángulos de los controles visibles, ya en coordenadas de esta interfaz (la de los botones usa
-- otra zona segura: CoreUISafeInsets; esta, la del dispositivo)
local function controlRects(offset: Vector2)
	local layout = TouchLayout.GetLayout()
	local rects = {}
	for id in TouchLayout.Entries() do
		local info = layout[id]
		if info and TouchLayout.InPlay(id) then
			table.insert(rects, { Id = id, Center = info.Center + offset, Size = info.Hit, Draw = info.Size })
		end
	end
	return rects
end

local function hits(rects, center: Vector2, dims: Vector2, margin: number): boolean
	for _, r in rects do
		if math.abs(center.X - r.Center.X) < (dims.X + r.Size.X) / 2 + margin and math.abs(center.Y - r.Center.Y) < (dims.Y + r.Size.Y) / 2 + margin then
			return true
		end
	end
	return false
end

-- Táctil (Fase 15): lo que no son botones se coloca alrededor de ellos en cinco zonas: arriba a la
-- izquierda minimapa y objetivo (Minimap/DominationHUD), arriba en el centro el marcador, arriba a la
-- derecha el registro de bajas bajo la tira de poco uso, abajo a la izquierda del centro la vida y,
-- junto a recargar, la munición. El centro (mira) no lleva nada.
local function layoutTouchHUD(_, _size: Vector2)
	if not touchHUD or not refs.Health then
		return
	end
	local camera = workspace.CurrentCamera
	local size = gui.AbsoluteSize
	if typeof(size) ~= "Vector2" or size.X < 100 then
		size = camera and camera.ViewportSize or _size
	end
	if typeof(size) ~= "Vector2" or size.X < 100 then
		return
	end
	local hudOrigin = typeof(gui.AbsolutePosition) == "Vector2" and gui.AbsolutePosition or Vector2.zero
	local offset = TouchLayout.Origin() - hudOrigin
	local rects = controlRects(offset)
	local layout = TouchLayout.GetLayout()
	local clear = MobileHUD.CenterClear(size)
	local function rectOf(id)
		local info = layout[id]
		return info and (info.Center + offset), info and info.Size
	end

	-- Munición: a la izquierda de recargar, alineada a la derecha y separada de los botones
	local reloadCenter, reloadSize = rectOf("Reload")
	if not reloadCenter then
		reloadCenter, reloadSize = rectOf("Fire")
	end
	local ammoDims = Vector2.new(124, 40)
	if reloadCenter and reloadSize then
		local right = reloadCenter.X - reloadSize.X / 2 - 10
		local center = Vector2.new(right - ammoDims.X / 2, reloadCenter.Y - 4)
		refs.TouchAmmo.AnchorPoint = Vector2.new(1, 0.5)
		refs.TouchAmmo.Position = UDim2.fromOffset(math.floor(right), math.floor(center.Y))
		table.insert(rects, { Id = "Ammo", Center = center, Size = ammoDims })
	end
	refs.TouchAmmo.Size = UDim2.fromOffset(ammoDims.X, ammoDims.Y)

	-- Vida: abajo, a la izquierda del centro (lo más cerca posible de su sitio sin tocar nada)
	local dims = Vector2.new(132, 22)
	local streakH = 18
	local want = Vector2.new(size.X / 2 - clear - dims.X / 2 + 10, size.Y - 14 - dims.Y / 2)
	local best, bestScore
	local y = want.Y
	while y > size.Y / 2 + clear + dims.Y / 2 do
		for step = 0, math.floor(size.X * 0.3 / 8) do
			for _, sign in { -1, 1 } do
				local center = Vector2.new(want.X + sign * step * 8, y)
				local score = step * 8 + (want.Y - y) * 0.8
				if (not bestScore or score < bestScore) and center.X - dims.X / 2 > 8 and not hits(rects, center + Vector2.new(0, -streakH / 2), dims + Vector2.new(0, streakH), 6) then
					best, bestScore = center, score
				end
			end
		end
		y -= 6
	end
	best = best or want
	refs.Health.AnchorPoint = Vector2.new(0.5, 0.5)
	refs.Health.Size = UDim2.fromOffset(dims.X, dims.Y)
	refs.Health.Position = UDim2.fromOffset(math.floor(best.X), math.floor(best.Y))
	refs.Level.Visible = false
	refs.StreakText.AnchorPoint = Vector2.new(0, 1)
	refs.StreakText.TextXAlignment = Enum.TextXAlignment.Left
	refs.StreakText.TextSize = 13
	refs.StreakText.Position = UDim2.fromOffset(math.floor(best.X - dims.X / 2), math.floor(best.Y - dims.Y / 2 - 2))

	-- Registro de bajas: bajo la tira de poco uso, alineado con ella; 3 filas como mucho, 20 px
	local kfW, rowH = 230, 20
	local kfTop, kfRight = 44, size.X - 12
	for _, r in rects do
		local control = MobileHUD.ById[r.Id]
		if control and control.Role == "Utility" and r.Center.Y < size.Y * 0.3 then
			kfTop = math.max(kfTop, r.Center.Y + r.Draw.Y / 2 + 8)
			kfRight = math.min(size.X - 8, math.max(kfRight, r.Center.X + r.Draw.X / 2))
		end
	end
	local limit = size.Y
	for _, r in rects do
		local top = r.Center.Y - r.Size.Y / 2
		if top > kfTop and r.Center.X + r.Size.X / 2 > kfRight - kfW then
			limit = math.min(limit, top - 6)
		end
	end
	killFeedMax = math.clamp(math.floor((limit - kfTop + 2) / (rowH + 2)), 2, 3)
	refs.KillFeed.AnchorPoint = Vector2.new(1, 0)
	refs.KillFeed.Position = UDim2.fromOffset(math.floor(kfRight), math.floor(kfTop))
	refs.KillFeed.Size = UDim2.fromOffset(kfW, killFeedMax * (rowH + 2))

	-- Zonas del resto (Fase 16, HUDZones): lo que aparece y desaparece durante la partida se apila en
	-- su zona sin tocar ningún botón, la munición, la vida ni el registro de bajas
	local mapLeft = ClientState.MinimapLeft or 14
	local mapSize = ClientState.MinimapSize or 96
	local mapTop = UI.TopbarBottom()
	local mapBottom = ClientState.MinimapBottom or (mapTop + mapSize)
	local obstacles = {}
	for _, r in rects do
		table.insert(obstacles, { Min = r.Center - r.Size / 2, Max = r.Center + r.Size / 2 })
	end
	table.insert(obstacles, { Min = Vector2.new(kfRight - kfW, kfTop), Max = Vector2.new(kfRight, kfTop + killFeedMax * (rowH + 2)) })
	table.insert(obstacles, { Min = Vector2.new(mapLeft, mapTop), Max = Vector2.new(mapLeft + mapSize, mapBottom) })
	table.insert(obstacles, { Min = best - dims / 2 - Vector2.new(0, streakH), Max = best + dims / 2 })
	-- (lo más alto de los controles de la izquierda: hasta ahí llega la columna bajo el minimapa)
	local leftTop = size.Y
	for _, r in rects do
		if r.Center.X < size.X / 2 and r.Center.Y > size.Y * 0.35 then
			leftTop = math.min(leftTop, r.Center.Y - r.Size.Y / 2)
		end
	end
	local scoreBottom = 8 + 28 + ((refs.Mode.Visible and refs.Mode.Text ~= "") and 20 or 6)
	local feedLeft = mapLeft + mapSize + 8
	local feedRight = kfRight - kfW - 8
	if feedRight - feedLeft < 200 then
		-- (pantalla estrecha: el registro de bajas va a la derecha, por debajo de la tira; el centro
		-- puede usar todo el ancho entre el minimapa y el borde por encima de él)
		feedRight = size.X - 8
	end
	local feedWidth = feedRight - feedLeft
	-- Aviso de baja y medallas: lo que quepa en el hueco (en teléfonos estrechos, más pequeños)
	local bannerScale = math.min(killBaseScale, (feedWidth - 4) / 410)
	if refs.KillScale.Scale ~= bannerScale and not refs.KillBanner.Visible then
		refs.KillScale.Scale = bannerScale
	end
	killScaleNow = bannerScale
	refs.Medals.Size = UDim2.fromOffset(math.floor(feedWidth / 0.75), 34)
	refs.Popups.Size = UDim2.fromOffset(math.min(260, feedWidth), 60)
	local popupList = refs.Popups:FindFirstChildOfClass("UIListLayout")
	if popupList then
		popupList.HorizontalAlignment = Enum.HorizontalAlignment.Center
	end
	-- Puntos de la baja («+300», RewardFX): a la derecha de la mira, justo fuera del centro libre, a
	-- la altura que no pise ni un botón ni el registro de bajas (en teléfonos pequeños el registro baja
	-- mucho y antes el número caía encima). En coordenadas de pantalla (RewardFX no usa zona segura)
	-- (si a la derecha no cabe, como en los teléfonos pequeños, a la izquierda de la mira; el
	-- número se alinea hacia la mira en los dos casos)
	local scoreDims = Vector2.new(96, 28)
	local scoreSpot, scoreLeft = nil, false
	for _, side in { 1, -1 } do
		for _, k in { -0.7, -0.45, -0.2, 0.05, 0.3 } do
			local c = Vector2.new(size.X / 2 + side * (clear + 8 + scoreDims.X / 2), size.Y / 2 + clear * k)
			local free = true
			for _, r in obstacles do
				if MobileHUD.RectsCut(c - scoreDims / 2, c + scoreDims / 2, r.Min, r.Max, 2) then
					free = false
					break
				end
			end
			if free then
				scoreSpot = Vector2.new(side == 1 and c.X - scoreDims.X / 2 or c.X + scoreDims.X / 2, c.Y) + hudOrigin
				scoreLeft = side == -1
				break
			end
		end
		if scoreSpot then
			break
		end
	end
	ClientState.ScoreSpot = scoreSpot
	ClientState.ScoreSpotLeft = scoreLeft
	HUDZones.SetZones({
		TOP_LEFT = { Min = Vector2.new(mapLeft, mapBottom + 6), Max = Vector2.new(math.min(size.X / 2 - clear - 8, mapLeft + 230), leftTop - 6) },
		TOP_FEED = { Min = Vector2.new(feedLeft, scoreBottom), Max = Vector2.new(feedRight, size.Y / 2 - clear - 4), CenterX = size.X / 2 },
		BOTTOM_NOTICE = { Min = Vector2.new(8, size.Y / 2 + clear + 6), Max = Vector2.new(size.X - 8, size.Y - 4), CenterX = size.X / 2, Span = true },
	}, obstacles, size / 2, clear)
end

function HUD.Init()
	task.spawn(disableCoreGui)
	UI.WaitViewport()
	phone = UI.IsPhone()
	touchHUD = InputMode.TouchUI()
	killBaseScale = phone and (touchHUD and 0.6 or 0.7) or 1

	gui = UI.new("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- Zona segura (Fase 11): con IgnoreGuiInset la información ya va dentro de la zona segura del
	-- dispositivo (DeviceSafeInsets, fuera de la muesca). Sin recortar a esa zona, lo que se sale a
	-- propósito (el borde negro de la mira telescópica) tapa también la franja de la muesca.
	pcall(function()
		gui.ClipToDeviceSafeArea = false
	end)
	buildTopBar()
	buildCrosshair()
	buildWeaponPanel()
	buildPlayerPanel()
	buildFeedsAndOverlays()
	if touchHUD then
		-- Zonas (Fase 16): lo que aparece durante la partida se apila en su sitio (ver HUDZones)
		local function hasLabels(frame)
			return function()
				return frame:FindFirstChildWhichIsA("TextLabel") ~= nil
			end
		end
		refs.CarrierBanner.Size = UDim2.fromOffset(280, 20)
		refs.Banner.Size = UDim2.fromOffset(300, 20)
		refs.Banner.TextSize = 16
		refs.Banner.TextScaled = true
		-- (el aviso grande, «¡RACHA DE 5!», «1 CONTRA 3», «RONDA GANADA», va el primero de la zona de
		-- arriba y más pequeño: antes ocupaba casi todo el ancho y tapaba el aviso de baja, las medallas
		-- y el registro de bajas. Solo ocupa sitio mientras se lee)
		refs.BigText.Size = UDim2.fromOffset(360, 32)
		refs.BigSub.Size = UDim2.fromOffset(360, 20)
		refs.BigSub.TextSize = 15
		local function shown(label)
			return function()
				return label.TextTransparency < 0.99
			end
		end
		HUDZones.Register("BigText", refs.BigText, "TOP_FEED", -2, { Fit = true, Active = shown(refs.BigText) })
		HUDZones.Register("BigSub", refs.BigSub, "TOP_FEED", -1, { Fit = true, Active = shown(refs.BigSub) })
		HUDZones.Register("CarrierBanner", refs.CarrierBanner, "TOP_FEED", 0, { Fit = true })
		HUDZones.Register("FlagBanner", refs.Banner, "TOP_FEED", 1, { Fit = true })
		HUDZones.Register("KillBanner", refs.KillBanner, "TOP_FEED", 2, {
			-- (reserva su tamaño de reposo: el pulso al aparecer no empuja lo de abajo)
			Size = function()
				return Vector2.new(420, 64) * killScaleNow
			end,
		})
		HUDZones.Register("Medals", refs.Medals, "TOP_FEED", 3, { Active = hasLabels(refs.Medals) })
		HUDZones.Register("Popups", refs.Popups, "TOP_FEED", 4, { Active = hasLabels(refs.Popups) })
		HUDZones.Register("Toast", refs.Toast, "BOTTOM_NOTICE", 1, { Fit = true })
		HUDZones.Start()
		TouchLayout.OnRelayout = layoutTouchHUD
		task.defer(TouchLayout.Relayout)
		-- (el ataque aéreo solo se ve con cargas: con él, el registro de bajas puede tener una fila menos)
		local hadAirstrike = false
		player:GetAttributeChangedSignal("Airstrikes"):Connect(function()
			local has = (player:GetAttribute("Airstrikes") or 0) > 0
			if has ~= hadAirstrike then
				hadAirstrike = has
				TouchLayout.Relayout()
			end
		end)
		-- (y con los ajustes de controles: correr con botón, disparo izquierdo, disposición propia)
		ClientState.SettingsChanged.Event:Connect(function(key)
			if key == nil or key == "HudLayout" or key == "AutoSprint" or key == "LeftFire" or key == "Controls" then
				task.defer(TouchLayout.Relayout)
			end
		end)
	end

	Remotes.Notify.OnClientEvent:Connect(onNotify)
	Remotes.KillFeed.OnClientEvent:Connect(onKillFeed)
	Remotes.HitConfirm.OnClientEvent:Connect(onHitConfirm)
	Remotes.RoundEnd.OnClientEvent:Connect(onRoundEnd)
	Remotes.MatchSummary.OnClientEvent:Connect(onMatchSummary)
	Remotes.Died.OnClientEvent:Connect(function(killerName, weaponName, killerHealth)
		local weapon = weaponName and Weapons.Get(weaponName)
		if killerName then
			-- Rango y título de quien te eliminó (si es un jugador)
			local killer = Players:FindFirstChild(killerName)
			local extra = ""
			if killer and killer:IsA("Player") then
				local rank = Ranks.Tiers[killer:GetAttribute("Rank") or 0]
				local title = killer:GetAttribute("Title")
				local titleColor = killer:GetAttribute("TitleColor")
				if type(title) == "string" and title ~= "" then
					extra ..= string.format(' <font color="#%s">«%s»</font>', typeof(titleColor) == "Color3" and titleColor:ToHex() or "C8C8D2", title)
				end
				if rank then
					extra = " " .. rank.Icon .. extra
				end
			end
			refs.DeathText.Text = "ELIMINADO POR <b>"
				.. killerName
				.. "</b>"
				.. extra
				.. (weapon and (" · " .. weapon.DisplayName) or "")
				.. (type(killerHealth) == "number" and killerHealth > 0 and killerName ~= player.Name and string.format('  <font color="#7CFF8A">❤ %d</font>', killerHealth) or "")
		else
			refs.DeathText.Text = "HAS MUERTO"
		end
		refs.DeathIcon:ClearAllChildren()
		if weapon and weapon.Parts then
			WeaponIcon.Create(weaponName, "Default", { Size = UDim2.fromScale(1, 1), Parent = refs.DeathIcon }, "angled", 280 / 110)
		elseif weapon then
			-- Armas sin modelo (granada): un emoji grande
			local icon = Instance.new("TextLabel")
			icon.Size = UDim2.fromScale(1, 1)
			icon.BackgroundTransparency = 1
			icon.Text = "💣"
			icon.TextScaled = true
			icon.Parent = refs.DeathIcon
		end
		refs.DeathScreen.Visible = true
	end)
	player.CharacterAdded:Connect(function()
		refs.DeathScreen.Visible = false
		lastHealth = 100
		refs.DamageStroke.Transparency = 1
	end)

	ClientState.DataChanged.Event:Connect(updateData)
	updateData(ClientState.Data)

	ReplicatedStorage.AttributeChanged:Connect(updateScoreboard)
	player:GetAttributeChangedSignal("Score"):Connect(updateScoreboard)
	updateScoreboard()

	local function updateCarrier()
		refs.CarrierBanner.Visible = player:GetAttribute("CarryingFlag") == true
	end
	player:GetAttributeChangedSignal("CarryingFlag"):Connect(updateCarrier)
	updateCarrier()

	task.spawn(function()
		while true do
			if not ClientState.InMainMenu then
				updatePlayerRow()
			end
			task.wait(1)
		end
	end)

	RunService.RenderStepped:Connect(render)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="210">
            <Properties>
              <string name="Name">HUDEditor</string>
              <string name="Source"><![CDATA[-- Editor de los controles táctiles (Fase 12): Ajustes → Controles táctiles → PERSONALIZAR HUD.
-- Se ven todos los controles (también los que el ajuste tiene apagados) sobre el juego oscurecido; se
-- toca uno para elegirlo y se arrastra para moverlo; TAMAÑO y OPACIDAD con dos barras. GUARDAR lo
-- guarda en los ajustes del jugador (Settings.HudLayout: los guarda el servidor con el resto del
-- perfil, después de validarlos con shared/MobileHUD), CANCELAR lo deja como estaba y RESTABLECER
-- vuelve a la disposición por defecto (la de la Fase 15, la de la versión MobileHUD.LayoutVersion).
-- Mientras está abierto no se juega (ClientState.HUDEditorOpen).
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MobileHUD = require(Shared.MobileHUD)

local ClientState = require(script.Parent.ClientState)
local Settings = require(script.Parent.Settings)
local TouchLayout = require(script.Parent.TouchLayout)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local HUDEditor = {}

local YELLOW = Color3.fromRGB(255, 205, 60)
local PANEL = Color3.fromRGB(14, 16, 22)

local gui, dim
local working: { [string]: any } = {}
local selected = "Fire"
local connections: { RBXScriptConnection } = {}
local onClosed: (() -> ())? = nil
local previousRelayout = nil
local overlay: { [string]: { Label: TextLabel, Ring: Frame } } = {}
local refreshPanel: () -> () = function() end
local panelSide: ((boolean) -> ())? = nil -- (pasa el panel arriba o abajo)
local panelAtTop = true
local panelFrame: Frame? = nil
local panelCenterX = 0

local function copy(layout)
	local out = {}
	for id, item in MobileHUD.Validate(layout) do
		out[id] = table.clone(item)
	end
	return out
end

local function apply()
	TouchLayout.SetEditing(true, working)
end

-- Nombre y marco de cada control encima de él (se recolocan con cada cambio)
local function drawOverlay(layout)
	if not gui then
		return
	end
	local s = Settings.Get()
	for id, info in layout do
		if TouchLayout.Entries()[id] then
			local item = overlay[id]
			if not item then
				local ring = UI.new("Frame", {
					Name = "Sel_" .. id,
					AnchorPoint = Vector2.new(0.5, 0.5),
					BackgroundTransparency = 1,
					Parent = gui,
				}, { UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
				local stroke = UI.new("UIStroke", { Color = YELLOW, Thickness = 3, Parent = ring })
				local _ = stroke
				-- (solo en el editor: el texto se encoge para que los nombres no se pisen)
				local label = UI.label({
					Name = "Name_" .. id,
					AnchorPoint = Vector2.new(0.5, 0),
					Size = UDim2.fromOffset(60, 14),
					TextSize = 12,
					TextScaled = true,
					TextStrokeTransparency = 0.2,
					Parent = gui,
				}, { UI.new("UITextSizeConstraint", { MaxTextSize = 12, MinTextSize = 8 }) })
				item = { Label = label, Ring = ring }
				overlay[id] = item
			end
			local control = MobileHUD.ById[id]
			local off = (id == "LeftFire" and (s.LeftFire or 0) ~= 1) or (id == "Sprint" and (s.AutoSprint or 1) == 1)
			item.Label.Text = (control and control.Name or id) .. (off and " (apagado)" or "")
			item.Label.TextColor3 = id == selected and YELLOW or Color3.new(1, 1, 1)
			item.Label.Position = UDim2.fromOffset(math.floor(info.Center.X), math.floor(info.Center.Y + info.Size.Y / 2 + 2))
			item.Label.Size = UDim2.fromOffset(math.floor(math.max(info.Size.X + 8, 52)), 14)
			item.Ring.Position = UDim2.fromOffset(math.floor(info.Center.X), math.floor(info.Center.Y))
			item.Ring.Size = UDim2.fromOffset(math.floor(info.Size.X + 8), math.floor(info.Size.Y + 8))
			item.Ring.Visible = id == selected
			local corner = item.Ring:FindFirstChildOfClass("UICorner")
			if corner then
				corner.CornerRadius = (control and control.Shape ~= "Round") and UDim.new(0, 12) or UDim.new(0.5, 0)
			end
		end
	end
end

-- El control que hay bajo un punto (el más pequeño si se tocan: es el que se quería)
local function pick(point: Vector2): string?
	local layout = TouchLayout.GetLayout()
	local best, bestArea
	for id, info in layout do
		if TouchLayout.Entries()[id] then
			local d = point - info.Center
			local half = info.Hit / 2
			if math.abs(d.X) <= half.X and math.abs(d.Y) <= half.Y then
				local area = info.Size.X * info.Size.Y
				if not bestArea or area < bestArea then
					best, bestArea = id, area
				end
			end
		end
	end
	return best
end

local function areaOf(): (Vector2, Vector2)
	local size, origin = gui.AbsoluteSize, gui.AbsolutePosition
	if typeof(size) ~= "Vector2" or size.X < 50 then
		local camera = workspace.CurrentCamera
		size = camera and camera.ViewportSize or Vector2.new(844, 390)
		origin = Vector2.zero
	end
	if typeof(origin) ~= "Vector2" then
		origin = Vector2.zero
	end
	return size, origin
end

-- Mueve el control elegido a `center` (píxeles de la zona segura): se guarda como fracción de la
-- pantalla, así vale también si se gira o cambia de tamaño
function HUDEditor.MoveSelected(center: Vector2)
	local size = areaOf()
	local item = working[selected] or {}
	item.X = math.clamp(center.X / size.X, 0, 1)
	item.Y = math.clamp(center.Y / size.Y, 0, 1)
	working[selected] = item
	apply()
end

-- Rectángulo del panel arriba o abajo (zona segura) y si tapa el control `id`
local function panelCovers(top: boolean, id: string): boolean
	local frame = panelFrame
	local info = TouchLayout.GetLayout()[id]
	if not frame or not gui or not info then
		return false
	end
	local size = gui.AbsoluteSize
	if typeof(size) ~= "Vector2" or size.X < 50 then
		local camera = workspace.CurrentCamera
		size = camera and camera.ViewportSize or Vector2.new(844, 390)
	end
	local w, h = frame.Size.X.Offset, frame.Size.Y.Offset
	local x0 = panelCenterX - w / 2
	local y0 = top and 6 or size.Y - 6 - h
	local half = info.Hit / 2
	return info.Center.X + half.X > x0 and info.Center.X - half.X < x0 + w and info.Center.Y + half.Y > y0 and info.Center.Y - half.Y < y0 + h
end
HUDEditor.PanelCovers = panelCovers

function HUDEditor.PanelAtTop(): boolean
	return panelAtTop
end

function HUDEditor.Select(id: string)
	if MobileHUD.ById[id] then
		selected = id
		-- (si el elegido queda debajo del panel, el panel se va al otro lado: se puede ver y arrastrar)
		if panelSide and panelCovers(panelAtTop, id) and not panelCovers(not panelAtTop, id) then
			panelSide(not panelAtTop)
		end
		refreshPanel()
		drawOverlay(TouchLayout.GetLayout())
	end
end

-- Tamaño u opacidad del elegido (S, O): se recortan a MobileHUD.Limits
function HUDEditor.SetValue(key: string, value: number)
	local limits = MobileHUD.Limits[key]
	if not limits then
		return
	end
	local item = working[selected] or {}
	item[key] = math.clamp(value, limits[1], limits[2])
	working[selected] = item
	apply()
	refreshPanel()
end

function HUDEditor.Reset()
	working = {}
	apply()
	refreshPanel()
end

function HUDEditor.Working()
	return working
end

local function slider(parent, position: UDim2, width: number, title: string, key: string)
	local holder = UI.new("Frame", {
		Position = position,
		Size = UDim2.fromOffset(width, 34),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local text = UI.label({
		Size = UDim2.new(1, 0, 0, 14),
		Text = title,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = holder,
	})
	local track = UI.new("TextButton", {
		Position = UDim2.fromOffset(0, 16),
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = holder,
	})
	UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(1, 0, 0, 4),
		BackgroundColor3 = Color3.fromRGB(70, 74, 88),
		BorderSizePixel = 0,
		Parent = track,
	}, { UI.corner(2) })
	local knob = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = YELLOW,
		BorderSizePixel = 0,
		Parent = track,
	}, { UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	local limits = MobileHUD.Limits[key]
	local function show()
		local value = (working[selected] and working[selected][key]) or 1
		local f = (value - limits[1]) / (limits[2] - limits[1])
		knob.Position = UDim2.fromScale(math.clamp(f, 0, 1), 0.5)
		text.Text = string.format("%s  %d%%", title, math.floor(value * 100 + 0.5))
	end
	local dragging
	local function at(x: number)
		local left, w = track.AbsolutePosition.X, track.AbsoluteSize.X
		if typeof(left) ~= "number" or typeof(w) ~= "number" or w <= 0 then
			return
		end
		local f = math.clamp((x - left) / w, 0, 1)
		local value = limits[1] + f * (limits[2] - limits[1])
		HUDEditor.SetValue(key, math.floor(value * 20 + 0.5) / 20)
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = input
			at(input.Position.X)
		end
	end)
	table.insert(connections, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input == dragging or (dragging.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)) then
			at(input.Position.X)
		end
	end))
	table.insert(connections, UserInputService.InputEnded:Connect(function(input)
		if input == dragging then
			dragging = nil
		end
	end))
	return show
end

local function close(save: boolean, silent: boolean?)
	if not gui then
		return
	end
	if save then
		Settings.Set("HudLayout", working)
	end
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	TouchLayout.OnRelayout = previousRelayout
	previousRelayout = nil
	gui:Destroy()
	gui = nil
	panelFrame = nil
	panelSide = nil
	panelAtTop = true
	if dim then
		dim:Destroy()
		dim = nil
	end
	table.clear(overlay)
	ClientState.HUDEditorOpen = false
	TouchLayout.SetEditing(false)
	ClientState.UpdateMouse()
	local callback = onClosed
	onClosed = nil
	if callback and not silent then
		task.defer(callback)
	end
end

-- Revisión de la disposición que se está editando (Fase 16, MobileHUD.CheckLayout): solo bloquea
-- dos controles de combate uno encima del otro; avisa si se tocan o si algo entra en el centro
function HUDEditor.Check()
	local size = areaOf()
	local s = Settings.Get()
	local ids = {}
	for _, control in MobileHUD.Controls do
		local off = (control.Id == "LeftFire" and (s.LeftFire or 0) ~= 1) or (control.Id == "Sprint" and (s.AutoSprint or 1) == 1)
		if not off and TouchLayout.Entries()[control.Id] then
			table.insert(ids, control.Id)
		end
	end
	return MobileHUD.CheckLayout(size, TouchLayout.GetLayout(), ids)
end

local function describe(pair): string
	local a, b = MobileHUD.ById[pair[1]], MobileHUD.ById[pair[2]]
	if pair[2] == "Center" then
		return (a and a.Name or pair[1]) .. " está en el centro (tapa la mira)"
	end
	return (a and a.Name or pair[1]) .. " y " .. (b and b.Name or pair[2])
end

-- Texto del estado (debajo de los botones del panel)
local status: TextLabel? = nil
local saveButton: TextButton? = nil
local function showStatus()
	if not status then
		return
	end
	local check = HUDEditor.Check()
	local label = status :: TextLabel
	if #check.Blocking > 0 then
		label.Text = "No se puede guardar: " .. describe(check.Blocking[1]) .. " están uno encima del otro"
		label.TextColor3 = Color3.fromRGB(255, 110, 100)
	elseif #check.Warnings > 0 then
		local pair = check.Warnings[1]
		label.Text = "Aviso: " .. describe(pair) .. (pair[2] == "Center" and "" or " se tocan")
		label.TextColor3 = YELLOW
	else
		label.Text = "Sin choques"
		label.TextColor3 = Color3.fromRGB(150, 220, 160)
	end
	if saveButton then
		saveButton.AutoButtonColor = #check.Blocking == 0
		saveButton.BackgroundTransparency = #check.Blocking > 0 and 0.6 or 0
	end
	return check
end

function HUDEditor.Save(): boolean
	-- (dos controles de combate uno encima del otro: no se guarda, se dice por qué)
	local check = HUDEditor.Check()
	if #check.Blocking > 0 then
		showStatus()
		return false
	end
	close(true)
	return true
end

function HUDEditor.Cancel()
	close(false)
end

function HUDEditor.IsOpen(): boolean
	return gui ~= nil
end

local function build()
	local playerGui = player:WaitForChild("PlayerGui")
	-- Fondo oscuro por debajo de los botones (los botones se ven encima) y el editor por encima
	dim = UI.new("ScreenGui", { Name = "HUDEditorDim", IgnoreGuiInset = true, ResetOnSpawn = false, DisplayOrder = 2, Parent = playerGui })
	UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, BorderSizePixel = 0, Parent = dim })
	-- (la misma zona segura que los botones, CoreUISafeInsets: así lo que se arrastra cae justo donde
	-- queda el botón)
	gui = UI.new("ScreenGui", { Name = "HUDEditor", IgnoreGuiInset = false, ResetOnSpawn = false, DisplayOrder = 20, Parent = playerGui })
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	end)
	-- (toda la pantalla recoge los toques: ni la cámara ni los controles reciben nada)
	local catcher = UI.new("TextButton", {
		Name = "Catcher",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = gui,
	})
	local dragInput, dragOffset
	catcher.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		local _, origin = areaOf()
		local point = Vector2.new(input.Position.X, input.Position.Y) - origin
		local id = pick(point)
		if id then
			HUDEditor.Select(id)
			local info = TouchLayout.GetLayout()[id]
			dragInput, dragOffset = input, info.Center - point
		end
	end)
	table.insert(connections, UserInputService.InputChanged:Connect(function(input)
		if not dragInput then
			return
		end
		if input == dragInput or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement) then
			local _, origin = areaOf()
			HUDEditor.MoveSelected(Vector2.new(input.Position.X, input.Position.Y) - origin + dragOffset)
		end
	end))
	table.insert(connections, UserInputService.InputEnded:Connect(function(input)
		if input == dragInput then
			dragInput = nil
		end
	end))

	-- Panel arriba en el centro (ahí no hay controles), sin tapar los de arriba a la derecha
	local size = areaOf()
	local utilityLeft = size.X
	for id, info in TouchLayout.GetLayout() do
		local control = MobileHUD.ById[id]
		if control and control.Anchor == "TopRight" and not (working[id] and working[id].X) then
			utilityLeft = math.min(utilityLeft, info.Center.X - info.Size.X / 2)
		end
	end
	local width = math.clamp(2 * (utilityLeft - 8 - size.X / 2), 260, 440)
	panelCenterX = size.X / 2
	-- (si arriba a la izquierda hay controles a la altura del panel, como el disparo izquierdo, el
	-- panel se mete en el hueco entre ellos y la tira de arriba a la derecha, si cabe)
	local leftLimit = 0
	for id, info in TouchLayout.GetLayout() do
		if TouchLayout.Entries()[id] and info.Center.X < size.X / 2 and info.Center.Y - info.Hit.Y / 2 < 6 + 130 then
			leftLimit = math.max(leftLimit, info.Center.X + info.Hit.X / 2)
		end
	end
	if leftLimit > size.X / 2 - width / 2 then
		local gap = (utilityLeft - 8) - (leftLimit + 8)
		if gap >= 260 then
			width = math.min(width, gap)
			panelCenterX = leftLimit + 8 + width / 2
		end
	end
	local panel = UI.new("Frame", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0, panelCenterX, 0, 6),
		Size = UDim2.fromOffset(width, 130),
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.08,
		Active = true,
		ZIndex = 10, -- (por encima de los nombres de los controles)
		Parent = gui,
	}, { UI.corner(12), UI.stroke(Color3.fromRGB(90, 96, 112), 1, 0.2) })
	panelFrame = panel
	-- (el panel se puede pasar abajo para llegar a lo que tapa)
	local flip = UI.button({
		Name = "Flip",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 5),
		Size = UDim2.fromOffset(64, 22),
		Text = "ABAJO",
		TextSize = 12,
		BackgroundColor3 = Color3.fromRGB(52, 56, 68),
		Parent = panel,
	})
	local function setSide(top: boolean)
		panelAtTop = top
		panel.AnchorPoint = Vector2.new(0.5, top and 0 or 1)
		panel.Position = top and UDim2.new(0, panelCenterX, 0, 6) or UDim2.new(0, panelCenterX, 1, -6)
		flip.Text = top and "ABAJO" or "ARRIBA"
	end
	panelSide = setSide
	flip.Activated:Connect(function()
		setSide(not panelAtTop)
	end)
	-- (empieza en el lado donde tapa menos controles: con el disparo izquierdo puesto, arriba tapaba
	-- ese botón y no se podía coger)
	local function covered(top)
		local count = 0
		for id in TouchLayout.GetLayout() do
			if TouchLayout.Entries()[id] and panelCovers(top, id) then
				count += 1
			end
		end
		return count
	end
	setSide(covered(true) <= covered(false))
	local title = UI.label({
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -96, 0, 18),
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = panel,
	})
	local half = (width - 36) / 2
	local showSize = slider(panel, UDim2.fromOffset(12, 30), half, "TAMAÑO", "S")
	local showOpacity = slider(panel, UDim2.fromOffset(24 + half, 30), half, "OPACIDAD", "O")
	local function action(order, text, color, textColor, callback)
		local w = (width - 24 - 16) / 3
		local button = UI.button({
			Name = text,
			Position = UDim2.fromOffset(12 + (order - 1) * (w + 8), 72),
			Size = UDim2.fromOffset(w, 32),
			Text = text,
			TextSize = 14,
			TextScaled = true,
			TextColor3 = textColor,
			BackgroundColor3 = color,
			Parent = panel,
		}, { UI.new("UITextSizeConstraint", { MaxTextSize = 14, MinTextSize = 10 }), UI.new("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }) })
		button.Activated:Connect(callback)
		return button
	end
	action(1, "RESTABLECER", Color3.fromRGB(52, 56, 68), Color3.new(1, 1, 1), HUDEditor.Reset)
	action(2, "CANCELAR", Color3.fromRGB(52, 56, 68), Color3.new(1, 1, 1), HUDEditor.Cancel)
	saveButton = action(3, "GUARDAR", YELLOW, Color3.fromRGB(20, 20, 24), HUDEditor.Save)
	status = UI.label({
		Name = "Status",
		Position = UDim2.fromOffset(12, 108),
		Size = UDim2.new(1, -24, 0, 16),
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = "",
		Parent = panel,
	})
	refreshPanel = function()
		local control = MobileHUD.ById[selected]
		title.Text = (control and control.Name or selected) .. "  ·  arrastra para mover"
		showSize()
		showOpacity()
		showStatus()
	end
	refreshPanel()
end

-- Abre el editor. `closed`: se llama al cerrarlo (por ejemplo, para volver a Ajustes).
function HUDEditor.Open(closed: (() -> ())?): boolean
	if gui or not UserInputService.TouchEnabled then
		return false
	end
	onClosed = closed
	working = copy(Settings.Get().HudLayout)
	selected = "Fire"
	ClientState.HUDEditorOpen = true
	ClientState.UpdateMouse()
	previousRelayout = TouchLayout.OnRelayout
	TouchLayout.OnRelayout = function(layout, size)
		if previousRelayout then
			previousRelayout(layout, size)
		end
		drawOverlay(layout)
		showStatus()
	end
	build()
	apply()
	-- Si cambia el contexto (vuelta al lobby, fin de partida, muerte) se cancela solo: el editor no
	-- puede quedarse abierto debajo de otra pantalla dejando el juego bloqueado
	local openedInMenu = ClientState.InMainMenu
	local openedDead = ClientState.Dead
	local openedResults = ClientState.ResultsActive
	local acc = 0
	table.insert(connections, game:GetService("RunService").Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.25 then
			return
		end
		acc = 0
		if ClientState.InMainMenu ~= openedInMenu or (ClientState.ResultsActive and not openedResults) or (ClientState.Dead and not openedDead) then
			close(false, true)
		end
	end))
	return true
end

return HUDEditor
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="211">
            <Properties>
              <string name="Name">HUDZones</string>
              <string name="Source"><![CDATA[-- Zonas reservadas del HUD táctil (Fase 16). No es otro HUD: reparte el sitio entre los elementos
-- que ya existen (aviso de baja, medallas, objetivo de cada modo, radar, avisos...), que antes tenían
-- cada uno su posición fija y en una partida 5v5 se montaban unos encima de otros y de los botones.
--
-- Zonas (en coordenadas de la zona segura del dispositivo, las de las ScreenGui del HUD):
--   TOP_LEFT     bajo el minimapa: objetivo (A/B/C, bomba), radar, nombre de la zona;
--   TOP_FEED     arriba en el centro, bajo el marcador y por encima del centro libre: bandera que
--                llevas, avisos de bandera, aviso de baja, medallas, avisos de XP;
--   BOTTOM_NOTICE bajo el centro libre, entre los botones: progreso de plantar/desactivar, avisos de
--                texto, consejos y estamina (cada línea usa el hueco libre entre los botones).
-- (TOP_CENTER = marcador, TOP_RIGHT = tira de poco uso + registro de bajas, CENTER = mira, BOTTOM_LEFT
-- y BOTTOM_RIGHT = pulgares, RIGHT_CAMERA_ZONE = cámara: los colocan HUD, TouchLayout y MobileHUD.)
--
-- Cada zona apila sus elementos visibles por orden (el más importante primero). Lo que no cabe se
-- aparta de la pantalla (no se monta encima de nada) hasta que vuelva a caber. Nada se coloca encima
-- de la caja táctil de un botón: si choca, baja. Solo se usa en pantallas táctiles; en ordenador cada
-- elemento sigue donde estaba.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local MobileHUD = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MobileHUD"))
local InputMode = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("InputMode"))

local HUDZones = {}

local GAP = 4
local OFFSCREEN = UDim2.fromOffset(-4000, -4000)

type Rect = { Min: Vector2, Max: Vector2 }
type Item = {
	Id: string,
	Object: GuiObject,
	Zone: string,
	Order: number,
	Active: (() -> boolean)?,
	Gui: ScreenGui?,
	Fit: boolean?,
	Anchor: Vector2?,
	SizeFn: (() -> Vector2)?,
}

local zones: { [string]: { Min: Vector2, Max: Vector2, Span: boolean?, CenterX: number? } } = {}
local avoid: { Rect } = {}
local center: Vector2 = Vector2.zero
local clear = 0
local items: { Item } = {}
local byId: { [string]: Item } = {}
HUDZones.Placed = {} :: { [string]: Rect } -- dónde quedó cada elemento visible (para validar y depurar)
HUDZones.Overflow = {} :: { [string]: boolean } -- los que no cupieron (apartados)

function HUDZones.Enabled(): boolean
	return InputMode.TouchUI()
end

-- En plena pelea (partida en juego y vivo): lo que no hace falta para luchar (regalos, evento,
-- potenciadores) se guarda en táctil
function HUDZones.Fighting(): boolean
	local ok, ClientState = pcall(require, script.Parent.ClientState)
	if not ok then
		return false
	end
	local player = Players.LocalPlayer
	local character = player and player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return ReplicatedStorage:GetAttribute("State") == "Playing" and not ClientState.InMainMenu and not ClientState.Dead
		and humanoid ~= nil and humanoid.Health > 0
end

-- Un elemento pasa a ser de una zona (su posición la decide HUDZones; su módulo sigue decidiendo si
-- se ve y qué pone). opts: Active (función: si ocupa sitio), Gui (su ScreenGui: si está apagada no
-- ocupa), Fit (se le ajusta el ancho al hueco), Anchor (punto de anclaje; por defecto arriba en el
-- centro, o arriba a la izquierda en TOP_LEFT), Size (función: el tamaño que reserva, si no es el de
-- su Size; p. ej. el aviso de baja reserva su tamaño de reposo aunque dé un pulso al aparecer)
function HUDZones.Register(id: string, object: GuiObject, zone: string, order: number, opts: { [string]: any }?)
	local o = opts or {}
	local item: Item = { Id = id, Object = object, Zone = zone, Order = order, Active = o.Active, Gui = o.Gui, Fit = o.Fit, Anchor = o.Anchor, SizeFn = o.Size }
	if byId[id] then
		local i = table.find(items, byId[id])
		if i then
			table.remove(items, i)
		end
	end
	byId[id] = item
	table.insert(items, item)
	table.sort(items, function(a, b)
		return a.Order < b.Order
	end)
	HUDZones.Layout()
end

function HUDZones.Managed(object: Instance): boolean
	for _, item in items do
		if item.Object == object then
			return HUDZones.Enabled()
		end
	end
	return false
end

-- Zonas y obstáculos (cajas táctiles de los botones, munición, vida, registro de bajas...), los
-- calcula HUD al recolocar
function HUDZones.SetZones(newZones, obstacles: { Rect }, middle: Vector2, radius: number)
	zones = newZones
	avoid = obstacles
	center = middle
	clear = radius
	HUDZones.Layout()
end

function HUDZones.Zones()
	return zones, avoid, center, clear
end

local function isActive(item: Item): boolean
	local object = item.Object
	if not object.Parent or not object.Visible then
		return false
	end
	if item.Gui and not item.Gui.Enabled then
		return false
	end
	if item.Active and not item.Active() then
		return false
	end
	return true
end

-- Tamaño en pantalla (Size en píxeles × su UIScale; con ancho relativo, el ancho de la zona)
local function sizeOf(item: Item, zoneWidth: number): Vector2
	if item.SizeFn then
		return item.SizeFn()
	end
	local object = item.Object
	local size = object.Size
	local width = size.X.Offset + size.X.Scale * zoneWidth
	local height = size.Y.Offset
	local scale = object:FindFirstChildOfClass("UIScale")
	local factor = scale and scale.Scale or 1
	return Vector2.new(width, height) * factor
end

local function hitsAvoid(min: Vector2, max: Vector2): Rect?
	for _, r in avoid do
		if MobileHUD.RectsCut(min, max, r.Min, r.Max, 0) then
			return r
		end
	end
	return nil
end

local function setPosition(object: GuiObject, anchor: Vector2, position: UDim2)
	if object.AnchorPoint ~= anchor then
		object.AnchorPoint = anchor
	end
	if object.Position ~= position then
		object.Position = position
	end
end

-- Recoloca todo (barato: unos pocos elementos; solo escribe si algo cambia)
function HUDZones.Layout()
	if not HUDZones.Enabled() then
		return
	end
	local placed, overflow = {}, {}
	local cursor: { [string]: number } = {}
	for _, item in items do
		local zone = zones[item.Zone]
		if not zone or not isActive(item) then
			continue
		end
		local dims = sizeOf(item, zone.Max.X - zone.Min.X)
		local left = item.Zone == "TOP_LEFT"
		local anchor = item.Anchor or (left and Vector2.new(0, 0) or Vector2.new(0.5, 0))
		local y = cursor[item.Zone] or zone.Min.Y
		local spot: Rect? = nil
		for _ = 1, 12 do
			if y + dims.Y > zone.Max.Y + 0.5 then
				break
			end
			local x0, x1 = zone.Min.X, zone.Max.X
			if zone.Span then
				-- (los avisos de una línea usan el hueco libre entre los botones a su altura; si es muy
				-- estrecho, la línea siguiente)
				local a, b = MobileHUD.FreeSpan(avoid, y, y + dims.Y, zone.Min.X, zone.Max.X)
				if not a or not b or b - a < math.min(dims.X, 120) then
					y += dims.Y + GAP
					continue
				end
				x0, x1 = a, b
			end
			local w = math.min(dims.X, x1 - x0)
			local minX
			if left then
				minX = x0
			else
				minX = math.clamp(zone.CenterX or center.X, x0 + w / 2, x1 - w / 2) - w / 2
			end
			local min = Vector2.new(minX, y)
			local max = min + Vector2.new(w, dims.Y)
			local obstacle = hitsAvoid(min, max)
			if obstacle then
				-- (si toca un botón, la munición o la vida, baja hasta pasarlo)
				y = math.max(y + 1, obstacle.Max.Y + GAP)
				continue
			end
			spot = { Min = min, Max = max }
			break
		end
		if not spot then
			overflow[item.Id] = true
			setPosition(item.Object, anchor, OFFSCREEN)
			continue
		end
		local w = spot.Max.X - spot.Min.X
		local scale = item.Object:FindFirstChildOfClass("UIScale")
		local factor = scale and scale.Scale or 1
		if item.Fit and item.Object.Size.X.Scale == 0 and math.abs(item.Object.Size.X.Offset * factor - w) > 0.5 then
			item.Object.Size = UDim2.fromOffset(math.floor(w / factor), item.Object.Size.Y.Offset)
		end
		local px = spot.Min.X + w * anchor.X
		local py = spot.Min.Y + (spot.Max.Y - spot.Min.Y) * anchor.Y
		setPosition(item.Object, anchor, UDim2.fromOffset(math.floor(px + 0.5), math.floor(py + 0.5)))
		placed[item.Id] = spot
		cursor[item.Zone] = spot.Max.Y + GAP
	end
	HUDZones.Placed = placed
	HUDZones.Overflow = overflow
end

-- Problemas de la colocación actual (pruebas y depuración): elementos que se pisan entre sí, que
-- tocan la caja táctil de un botón o que entran en el centro libre
function HUDZones.Validate(): { { string } }
	local issues = {}
	local ids = {}
	for id in HUDZones.Placed do
		table.insert(ids, id)
	end
	table.sort(ids)
	for i = 1, #ids do
		local a = HUDZones.Placed[ids[i]]
		for j = i + 1, #ids do
			local b = HUDZones.Placed[ids[j]]
			if MobileHUD.RectsCut(a.Min, a.Max, b.Min, b.Max, 0) then
				table.insert(issues, { ids[i], ids[j] })
			end
		end
		if hitsAvoid(a.Min, a.Max) then
			table.insert(issues, { ids[i], "control" })
		end
		-- (el centro libre: el punto del rectángulo más cercano a la mira)
		local nearest = Vector2.new(math.clamp(center.X, a.Min.X, a.Max.X), math.clamp(center.Y, a.Min.Y, a.Max.Y))
		if clear > 0 and (nearest - center).Magnitude < clear - 0.5 then
			table.insert(issues, { ids[i], "centro" })
		end
	end
	return issues
end

-- Recolocación periódica (10 veces por segundo, solo en táctil): los elementos aparecen y
-- desaparecen solos durante la partida
local started = false
function HUDZones.Start()
	if started then
		return
	end
	started = true
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 0.1 then
			acc = 0
			HUDZones.Layout()
		end
	end)
end

return HUDZones
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="212">
            <Properties>
              <string name="Name">Hints</string>
              <string name="Source"><![CDATA[-- Consejos de contexto para jugadores nuevos (Fase 6): una línea discreta en partida cuando hacen algo
-- que un consejo arregla. Solo hasta el nivel Hints.MaxLevel, cada consejo como mucho una vez por
-- sesión y con Hints.Gap segundos entre uno y otro. No guarda nada (sin cambios en los datos) y no
-- bloquea: no quita el ratón ni para el juego.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local HUDZones = require(script.Parent.HUDZones)

local player = Players.LocalPlayer

local Hints = {}

Hints.MaxLevel = 5 -- a partir de aquí ya no salen
Hints.Gap = 60 -- segundos mínimos entre dos consejos
Hints.Duration = 5 -- segundos en pantalla
Hints.HipShots = 8 -- disparos a la cadera seguidos sin acertar que sacan el consejo de apuntar
Hints.HipWindow = 4 -- (en estos segundos)
Hints.LowHealth = 0.35 -- fracción de vida que saca el consejo de cubrirse
Hints.QAForceNew = false -- (modo QA: como si fuera nivel 1; solo lo cambia QAPanel)

-- Textos: { PC, táctil }
Hints.Text = {
	Aim = { "Mantén el clic derecho para apuntar: de lejos aciertas mucho más", "Toca APUNTAR (la mira): de lejos aciertas mucho más" },
	Reload = { "Pulsa R para recargar antes de vaciar el cargador", "Toca RECARGAR antes de vaciar el cargador" },
	Cover = { "Ponte a cubierto: si no te dan, la vida se recupera sola", "Ponte a cubierto: si no te dan, la vida se recupera sola" },
}

local seen = {}
local lastAt = -math.huge
local label = nil
local hipShots = {}

local function touchOnly()
	return InputMode.TouchUI()
end

-- ¿Se puede enseñar un consejo ahora? (jugador nuevo, en partida, vivo y sin nada encima)
function Hints.Eligible()
	local data = ClientState.Data
	-- (Hints.QAForceNew: el modo QA de Studio simula un jugador nuevo sin tocar sus datos)
	if not data or ((tonumber(data.Level) or 1) > Hints.MaxLevel and not Hints.QAForceNew) then
		return false
	end
	if ClientState.IsBlocked() or ClientState.ResultsActive or ClientState.KillcamActive then
		return false
	end
	return true
end

local function ensureLabel()
	if label and label.Parent then
		return label
	end
	local gui = UI.new("ScreenGui", {
		Name = "Hints",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 2,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local phone = touchOnly()
	-- (escritorio: encima del aviso corto del HUD; teléfono: centrado, por debajo de la mira)
	label = UI.label({
		Name = "Hint",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = phone and UDim2.new(0.5, 0, 0.5, 64) or UDim2.new(0.5, 0, 1, -162),
		Size = phone and UDim2.fromOffset(320, 24) or UDim2.fromOffset(560, 30),
		BackgroundColor3 = Color3.fromRGB(14, 15, 18),
		BackgroundTransparency = 0.35,
		Text = "",
		TextSize = phone and 14 or 18,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextWrapped = true,
		Visible = false,
		Parent = gui,
	}, { UI.corner(6) })
	if phone then
		HUDZones.Register("Hint", label, "BOTTOM_NOTICE", 2, { Fit = true })
	end
	return label
end

-- Enseña el consejo `id` si toca (devuelve true si salió)
function Hints.Show(id)
	local texts = Hints.Text[id]
	if not texts or seen[id] or not Hints.Eligible() then
		return false
	end
	local now = os.clock()
	if now - lastAt < Hints.Gap then
		return false
	end
	seen[id] = true
	lastAt = now
	local hint = ensureLabel()
	hint.Text = touchOnly() and texts[2] or ("💡 " .. texts[1])
	hint.Visible = true
	local token = {}
	hint:SetAttribute("Token", tostring(token))
	task.delay(Hints.Duration, function()
		if hint:GetAttribute("Token") == tostring(token) then
			hint.Visible = false
		end
	end)
	return true
end

-- Disparo propio: muchos a la cadera seguidos sin acertar → apuntar
function Hints.OnShot()
	local def = ClientState.CurrentDef
	if not def or def.Type ~= "Gun" or def.Scope or (def.Pellets or 1) > 1 or (ClientState.AimAlpha or 0) > 0.3 then
		hipShots = {}
		return
	end
	local now = os.clock()
	table.insert(hipShots, now)
	while hipShots[1] and now - hipShots[1] > Hints.HipWindow do
		table.remove(hipShots, 1)
	end
	if #hipShots >= Hints.HipShots and now - (ClientState.LastHitTime or 0) > Hints.HipWindow then
		hipShots = {}
		Hints.Show("Aim")
	end
end

-- Recarga con el cargador vacío → recargar antes
function Hints.OnWeaponEvent(name, _weapon, info)
	if name == "ReloadStart" and type(info) == "table" and info.Empty then
		Hints.Show("Reload")
	end
end

-- Poca vida → cubrirse (solo si la vida se recupera de verdad)
function Hints.CheckHealth(humanoid)
	if not humanoid or humanoid.Health <= 0 or humanoid.MaxHealth <= 0 then
		return
	end
	local regen = GameConfig.HealthRegen
	if regen and regen.Enabled and humanoid.Health / humanoid.MaxHealth < Hints.LowHealth then
		Hints.Show("Cover")
	end
end

-- Cuatro veces por segundo: si algo tapa la partida (muerte, menú, killcam, resultados), el consejo
-- se quita en el acto; y se mira si queda poca vida
function Hints.Tick()
	if label and label.Visible and not Hints.Eligible() then
		label.Visible = false
	end
	-- (el de cubrirse ya salió: no hace falta mirar la vida)
	if not seen.Cover then
		local character = player.Character
		Hints.CheckHealth(character and character:FindFirstChildOfClass("Humanoid"))
	end
end

-- (pruebas: empezar de cero)
function Hints.Reset()
	seen = {}
	lastAt = -math.huge
	hipShots = {}
end

function Hints.Init()
	ClientState.ShotFired.Event:Connect(Hints.OnShot)
	ClientState.WeaponEvent.Event:Connect(Hints.OnWeaponEvent)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.25 then
			return
		end
		acc = 0
		Hints.Tick()
	end)
end

return Hints
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="213">
            <Properties>
              <string name="Name">IconText</string>
              <string name="Source"><![CDATA[-- Icono propio delante de un texto. Roblox no admite imágenes dentro de una línea de texto, así que
-- los rótulos que empezaban por un emoji ("💰 1500", "💣 G") se enlazan aquí: mientras el texto
-- empiece por ese emoji, se quita del texto y se dibuja la imagen en su sitio, pegada al texto
-- (alineado a la izquierda o centrado). Si el texto deja de empezar por el emoji, la imagen se esconde.
--   IconText.Bind(label, "💰", Icons.Coin)
local IconText = {}

local GAP = 4

function IconText.Bind(label, emoji, image, scale)
	if not (label and label:IsA("TextLabel")) or type(image) ~= "string" or image == "" then
		return
	end
	local icon = Instance.new("ImageLabel")
	icon.Name = "IconText"
	icon.BackgroundTransparency = 1
	icon.Image = image
	icon.ScaleType = Enum.ScaleType.Fit
	icon.AnchorPoint = Vector2.new(0, 0.5)
	icon.ZIndex = label.ZIndex
	icon.Visible = false
	icon.Parent = label
	local padding = Instance.new("UIPadding")
	padding.Name = "IconTextPadding"
	padding.Parent = label

	local busy = false
	local function place()
		local side = math.floor(label.TextSize * (scale or 1.15) + 0.5)
		local pad = side + GAP
		if not icon.Visible then
			padding.PaddingLeft = UDim.new(0, 0)
			return
		end
		padding.PaddingLeft = UDim.new(0, pad)
		icon.Size = UDim2.fromOffset(side, side)
		-- (los hijos se colocan dentro del relleno: la X se mide desde donde empieza el texto útil)
		-- (antes de dibujarse por primera vez el rótulo aún no tiene medidas)
		local size, bounds = label.AbsoluteSize, label.TextBounds
		local width = size and size.X or 0
		local textWidth = bounds and bounds.X or 0
		local inner = math.max(0, width - pad)
		local start = 0
		if label.TextXAlignment == Enum.TextXAlignment.Center then
			start = math.max(0, (inner - textWidth) / 2)
		elseif label.TextXAlignment == Enum.TextXAlignment.Right then
			start = math.max(0, inner - textWidth)
		end
		icon.Position = UDim2.new(0, start - pad, 0.5, 0)
	end

	local function refresh()
		if busy then
			return
		end
		local text = label.Text
		local prefix = emoji .. " "
		if string.sub(text, 1, #prefix) == prefix then
			busy = true
			label.Text = string.sub(text, #prefix + 1)
			busy = false
			icon.Visible = true
		elseif string.sub(text, 1, #emoji) == emoji then
			busy = true
			label.Text = string.sub(text, #emoji + 1)
			busy = false
			icon.Visible = true
		else
			-- (un texto nuevo sin el emoji: fuera la imagen)
			icon.Visible = false
		end
		place()
	end

	label:GetPropertyChangedSignal("Text"):Connect(function()
		if not busy then
			refresh()
		end
	end)
	label:GetPropertyChangedSignal("TextBounds"):Connect(place)
	label:GetPropertyChangedSignal("AbsoluteSize"):Connect(place)
	refresh()
	return icon
end

return IconText
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="214">
            <Properties>
              <string name="Name">InfectionFX</string>
              <string name="Source"><![CDATA[-- Ambiente del modo Infección: la pantalla se vuelve más apagada para los supervivientes y verdosa
-- para los zombis, y suena un golpe grave cuando llegan los zombis. Fuera de la Infección, nada.
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Sounds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Sounds"))

local player = Players.LocalPlayer

local InfectionFX = {}

local LOOKS = {
	None = { TintColor = Color3.new(1, 1, 1), Saturation = 0, Contrast = 0 },
	Prep = { TintColor = Color3.fromRGB(235, 235, 245), Saturation = -0.1, Contrast = 0.05 },
	Survivor = { TintColor = Color3.fromRGB(225, 235, 230), Saturation = -0.25, Contrast = 0.1 },
	Zombie = { TintColor = Color3.fromRGB(190, 255, 170), Saturation = -0.1, Contrast = 0.15 },
}

-- Cambios de ambiente que llevan el golpe grave (llegan los zombis o te conviertes)
local SOUND_ON = { ["Prep>Survivor"] = true, ["Prep>Zombie"] = true, ["Survivor>Zombie"] = true }

function InfectionFX.Init()
	local effect = Instance.new("ColorCorrectionEffect")
	effect.Name = "InfectionTint"
	effect.Enabled = false
	effect.Parent = Lighting
	local current: string = "None"
	local function update()
		local infection = ReplicatedStorage:GetAttribute("Infection")
		local look: string = "None"
		if infection and ReplicatedStorage:GetAttribute("State") == "Playing" then
			if infection == "Prep" then
				look = "Prep"
			elseif player.Team and player.Team.Name == ReplicatedStorage:GetAttribute("TeamB") then
				look = "Zombie"
			else
				look = "Survivor"
			end
		end
		if look == current then
			return
		end
		if SOUND_ON[current .. ">" .. look] then
			Sounds.Play("Infected")
		end
		current = look
		effect.Enabled = true
		local tween = TweenService:Create(effect, TweenInfo.new(1.2), LOOKS[look])
		tween:Play()
		if look == "None" then
			tween.Completed:Once(function()
				if current == "None" then
					effect.Enabled = false
				end
			end)
		end
	end
	ReplicatedStorage:GetAttributeChangedSignal("Infection"):Connect(update)
	ReplicatedStorage:GetAttributeChangedSignal("State"):Connect(update)
	player:GetPropertyChangedSignal("Team"):Connect(update)
	update()
end

return InfectionFX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="215">
            <Properties>
              <string name="Name">JumpPads</string>
              <string name="Source"><![CDATA[-- Plataformas de salto del mapa (piezas con el atributo JumpPad = velocidad vertical, ver
-- Kit.jumpPad): al pisar una sales disparado hacia arriba y puedes dirigirte en el aire.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Sounds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Sounds"))

local ClientState = require(script.Parent.ClientState)

local player = Players.LocalPlayer

local JumpPads = {}

local COOLDOWN = 0.6
local lastLaunch = 0
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude
local filteredCharacter = nil -- el filtro se cambia solo cuando cambia el personaje

function JumpPads.Init()
	RunService.Heartbeat:Connect(function()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not humanoid or not root or humanoid.Health <= 0 or ClientState.Frozen() then
			return
		end
		if os.clock() - lastLaunch < COOLDOWN then
			return
		end
		if filteredCharacter ~= character then
			filteredCharacter = character
			params.FilterDescendantsInstances = { character }
		end
		local hit = workspace:Raycast(root.Position, Vector3.new(0, -4, 0), params)
		local power = hit and hit.Instance:GetAttribute("JumpPad")
		if type(power) ~= "number" then
			return
		end
		lastLaunch = os.clock()
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(v.X, power, v.Z)
		-- Otra vez en el siguiente paso de física: el salto del Humanoid podría pisar la velocidad
		task.defer(function()
			local dt = RunService.Heartbeat:Wait()
			local now = root.AssemblyLinearVelocity
			-- (lo esperado tras un paso es power - gravedad·dt; solo se corrige si quedó muy por debajo)
			if root.Parent and humanoid.Health > 0 and now.Y < power - workspace.Gravity * dt - 8 then
				root.AssemblyLinearVelocity = Vector3.new(now.X, power, now.Z)
			end
		end)
		ClientState.FovKick = 8
		Sounds.Play("Swing")
	end)
end

return JumpPads
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="216">
            <Properties>
              <string name="Name">Killcam</string>
              <string name="Source"><![CDATA[-- Killcam (como en los shooters): repetición desde los ojos de quien hizo una baja, mirando hacia su
-- víctima, un poco a cámara lenta, sin color y con bandas de cine. Para eso se guardan, varias veces
-- por segundo, las posiciones de las cabezas de todos (jugadores y bots) durante los últimos segundos.
--   * Al morir: la pide DeathScreen (luego sigue la pantalla de muerte de siempre).
--   * Killcam final: si una baja cierra la partida o una ronda, el servidor avisa (Remotes.FinalKillcam)
--     y todos ven esa baja ("KILLCAM FINAL"), también quien la hizo.
-- Clic o toque: saltarla. Solo en este cliente: mueve la cámara, no cambia nada del juego.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weapons = require(Shared.Weapons)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local Killcam = {}

Killcam.HistoryTime = 6 -- segundos de posiciones guardados
Killcam.SampleTime = 0.05 -- cada cuánto se guardan
Killcam.SlowMotion = 1.25 -- (1,25 = un 25 % más lenta)
Killcam.Length = 2.4 -- segundos de repetición (si hay tantos guardados)
Killcam.Enabled = true

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local history = {} -- [Model] = { { tiempo, posición } }
local orphans = {} -- [nombre] = { Track, Removed }: modelos que ya no están (un bot caído y quitado)
local lastKills = {} -- ["asesino|víctima"] = os.clock() de la baja (de la lista de bajas)
local current = nil -- la repetición en curso
local sampleClock = 0
local gui: any = nil
local refs: { [string]: any } = {}
local losParams = RaycastParams.new()
losParams.FilterType = Enum.RaycastFilterType.Exclude
losParams.IgnoreWater = true -- (una baja a través del agua también se ve)

local function headPosition(model)
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head.Position
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position + Vector3.new(0, 1.5, 0)
	end
	return nil
end

local function characters()
	local models = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(models, p.Character)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			if model:IsA("Model") then
				table.insert(models, model)
			end
		end
	end
	return models
end

function Killcam.Record()
	local now = os.clock()
	for _, model in characters() do
		local position = headPosition(model)
		if position then
			local list = history[model]
			if not list then
				list = {}
				history[model] = list
			end
			table.insert(list, { now, position })
			-- (lo viejo se quita de golpe cuando sobra más de un segundo, no muestra a muestra: quitar
			-- la primera de ~120 en cada muestra desplazaba la lista entera 20 veces por segundo)
			if now - list[1][1] > Killcam.HistoryTime + 1 then
				local keep = 1
				while keep < #list and now - list[keep][1] > Killcam.HistoryTime do
					keep += 1
				end
				local count = #list - keep + 1
				table.move(list, keep, #list, 1)
				for i = #list, count + 1, -1 do
					list[i] = nil
				end
			end
		end
	end
	for model, list in history do
		if not model.Parent then
			-- (se guarda un rato por su nombre: la killcam final puede necesitar a un bot ya quitado)
			orphans[model.Name] = { Track = list, Removed = now }
			history[model] = nil
		end
	end
	for name, entry in orphans do
		if now - entry.Removed > Killcam.HistoryTime then
			orphans[name] = nil
		end
	end
	for key, at in lastKills do
		if now - at > Killcam.HistoryTime then
			lastKills[key] = nil
		end
	end
end

-- Posición en el instante t (interpolando entre muestras)
function Killcam.SampleAt(list, t)
	if not list or #list == 0 then
		return nil
	end
	if t <= list[1][1] then
		return list[1][2]
	end
	for i = 2, #list do
		local b = list[i]
		if b[1] >= t then
			local a = list[i - 1]
			local k = (t - a[1]) / math.max(1e-3, b[1] - a[1])
			return a[2]:Lerp(b[2], math.clamp(k, 0, 1))
		end
	end
	return list[#list][2]
end

-- Historia de un personaje (por modelo o, si ya no está, por nombre). Con at: de las dos (el modelo de
-- ahora y el que ya no está, p. ej. si reapareció justo después), la que cubre mejor lo que pasó
-- antes de at
function Killcam.Track(model, name, at)
	local live = model and history[model] or nil
	local old = name and orphans[name] and orphans[name].Track or nil
	if not at or not live or not old or #old == 0 then
		return live or old
	end
	if #live == 0 then
		return old
	end
	-- (el que ya no está solo sirve si seguía ahí en el momento de la baja)
	if old[#old][1] >= at - 0.3 and old[1][1] < live[1][1] then
		return old
	end
	return live
end

-- ¿Se veían? (del ojo de quien hizo la baja a la víctima; las personas, los efectos, las barandillas
-- invisibles y los cristales no tapan)
function Killcam.ClearLine(from, to)
	local ignore = { camera }
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	for _, name in { "Bots", "ClientFX" } do
		local folder = workspace:FindFirstChild(name)
		if folder then
			table.insert(ignore, folder)
		end
	end
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	for _ = 1, 4 do
		losParams.FilterDescendantsInstances = ignore
		local hit = workspace:Raycast(from, to - from, losParams)
		if not hit then
			return true
		end
		if hit.Instance.Transparency < 0.3 then
			return false
		end
		table.insert(ignore, hit.Instance)
	end
	return true
end

-- Durante la repetición: la víctima se ve (aunque sea tu propio cuerpo, que la primera persona deja
-- invisible) y quien hizo la baja no (la cámara está en su cabeza: se vería por dentro). Las piezas
-- se buscan una vez al empezar, no en cada fotograma
local function lookParts(model)
	local list = {}
	if model then
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") or d:IsA("Decal") then
				table.insert(list, d)
			end
		end
	end
	return list
end

local function setLook(list, modifier)
	for _, part in list do
		if part.Parent then
			part.LocalTransparencyModifier = modifier
		end
	end
end

-- (cómo estaba cada pieza al empezar: al terminar se deja igual; la primera persona no lo arregla
-- sola, porque solo lo vuelve a escribir cuando cambia)
local function saveLook(saved, list)
	for _, part in list do
		if saved[part] == nil then
			local modifier = part.LocalTransparencyModifier
			saved[part] = type(modifier) == "number" and modifier or 0
		end
	end
end

local function restoreLook(saved)
	for part, modifier in saved do
		if part.Parent then
			part.LocalTransparencyModifier = modifier
		end
	end
end

-- (las partículas de la skin del arma de quien hizo la baja se verían en la lente: se apagan un rato)
local function muteEmitters(model)
	local muted = {}
	if model then
		for _, d in model:GetDescendants() do
			if (d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")) and d.Enabled then
				d.Enabled = false
				table.insert(muted, d)
			end
		end
	end
	return muted
end

function Killcam.Active()
	return current ~= nil
end

-- Termina la repetición. runOnEnd: avisar a quien la pidió (p. ej. para pasar a observar)
function Killcam.Stop(runOnEnd)
	local k = current
	if not k then
		return
	end
	current = nil
	ClientState.KillcamActive = false
	ClientState.KillcamFinal = false
	pcall(function()
		RunService:UnbindFromRenderStep("Killcam")
	end)
	if k.Effect then
		k.Effect:Destroy()
	end
	restoreLook(k.Saved)
	for _, emitter in k.Muted do
		if emitter.Parent then
			emitter.Enabled = true
		end
	end
	if refs.Frame then
		refs.Frame.Visible = false
	end
	camera.FieldOfView = k.Fov
	-- (en la final sigues vivo: la cámara vuelve a donde mirabas)
	if k.Final and k.CameraBefore then
		camera.CFrame = k.CameraBefore
	end
	camera.CameraType = Enum.CameraType.Custom
	if runOnEnd and k.OnEnd then
		task.spawn(k.OnEnd)
	end
end

local function step()
	local k = current
	if not k then
		return
	end
	local elapsed = os.clock() - k.Start
	if elapsed >= k.Span * Killcam.SlowMotion then
		Killcam.Stop(true)
		return
	end
	local t = k.From + elapsed / Killcam.SlowMotion
	local eye = Killcam.SampleAt(k.KillerTrack, t)
	local victim = Killcam.SampleAt(k.VictimTrack, t)
	if not eye or not victim then
		Killcam.Stop(true)
		return
	end
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = 60
	-- (si los dos puntos casi coinciden, se mantiene hacia donde se miraba)
	if (victim - eye).Magnitude > 0.5 then
		k.Look = CFrame.lookAt(eye + Vector3.new(0, 0.15, 0), victim - Vector3.new(0, 0.4, 0))
	end
	camera.CFrame = k.Look or CFrame.new(eye + Vector3.new(0, 0.15, 0))
	setLook(k.KillerParts, 1)
	setLook(k.VictimParts, 0)
	setLook(k.OwnParts, 0)
end

-- Empieza una repetición; devuelve false si no hay con qué (poca historia, o sin línea de visión).
-- opts: Killer, Victim (modelos; pueden faltar si ya no están: entonces KillerName/VictimName),
--       At (os.clock() de la baja), Title, Name (texto de debajo), CheckSight, Final, OnEnd()
function Killcam.Play(opts)
	if not Killcam.Enabled then
		return false
	end
	local at = opts.At or os.clock()
	local killerTrack = Killcam.Track(opts.Killer, opts.KillerName, at)
	local victimTrack = Killcam.Track(opts.Victim, opts.VictimName, at)
	if not killerTrack or not victimTrack or #killerTrack < 6 or #victimTrack < 6 then
		return false
	end
	local available = at - killerTrack[1][1]
	if available < 0.6 then
		return false
	end
	if opts.CheckSight then
		local eye, target = Killcam.SampleAt(killerTrack, at), Killcam.SampleAt(victimTrack, at)
		if not eye or not target or not Killcam.ClearLine(eye, target) then
			return false
		end
	end
	-- (nunca dos a la vez; si la nueva sustituye a otra, lo que tocaba al acabar aquella, p. ej. pasar
	-- a observar, se hace al acabar esta)
	local previousOnEnd = current and current.OnEnd
	Killcam.Stop(false)
	local onEnd = opts.OnEnd
	if previousOnEnd then
		local own = onEnd
		onEnd = function()
			if own then
				own()
			end
			previousOnEnd()
		end
	end
	local span = math.min(Killcam.Length, available)
	local effect = Instance.new("ColorCorrectionEffect")
	effect.Name = "KillcamColor"
	effect.Saturation = -0.45
	effect.Contrast = 0.12
	effect.TintColor = Color3.fromRGB(235, 240, 255)
	effect.Parent = camera
	current = {
		Start = os.clock(),
		From = at - span,
		Span = span,
		KillerTrack = table.clone(killerTrack),
		VictimTrack = table.clone(victimTrack),
		Killer = opts.Killer,
		Victim = opts.Victim,
		KillerParts = lookParts(opts.Killer),
		VictimParts = lookParts(opts.Victim),
		-- (tú, si no eres ninguno de los dos: en primera persona estás escondido y desde fuera se te ve)
		OwnParts = (player.Character ~= opts.Killer and player.Character ~= opts.Victim) and lookParts(player.Character) or {},
		Saved = {},
		Muted = muteEmitters(opts.Killer),
		Fov = camera.FieldOfView,
		CameraBefore = camera.CFrame,
		Effect = effect,
		Final = opts.Final == true,
		OnEnd = onEnd,
		Look = nil :: CFrame?,
	}
	saveLook(current.Saved, current.KillerParts)
	saveLook(current.Saved, current.VictimParts)
	saveLook(current.Saved, current.OwnParts)
	ClientState.KillcamActive = true
	ClientState.KillcamFinal = opts.Final == true
	if refs.Frame then
		refs.Title.Text = opts.Title or "▶ KILLCAM"
		refs.Name.Text = opts.Name or ""
		refs.Frame.Visible = true
	end
	-- (al final de todo lo demás: nada mueve la cámara mientras dura)
	RunService:BindToRenderStep("Killcam", Enum.RenderPriority.Last.Value, step)
	return true
end

-- "Nombre · Arma" para el rótulo
function Killcam.Caption(who, weaponName)
	local name = who
	if typeof(who) == "Instance" then
		name = who:IsA("Player") and who.DisplayName or who.Name
	end
	local weapon = type(weaponName) == "string" and Weapons.List[weaponName]
	local weaponText = weapon and weapon.DisplayName or weaponName
	return tostring(name or "") .. ((weaponText and weaponText ~= "") and ("  ·  " .. tostring(weaponText)) or "")
end

local function modelNamed(name)
	if type(name) ~= "string" then
		return nil
	end
	local p = Players:FindFirstChild(name)
	if p and p:IsA("Player") then
		return p.Character, p
	end
	local bots = workspace:FindFirstChild("Bots")
	return bots and bots:FindFirstChild(name) or nil, nil
end

-- Killcam final (la manda el servidor): la última baja de la partida o de la ronda
function Killcam.PlayFinal(info)
	if type(info) ~= "table" or ClientState.InMainMenu then
		return false
	end
	local killer, killerPlayer = modelNamed(info.Killer)
	local victim = modelNamed(info.Victim)
	local at = lastKills[tostring(info.Killer) .. "|" .. tostring(info.Victim)] or (os.clock() - 0.3)
	return Killcam.Play({
		Killer = killer,
		Victim = victim,
		KillerName = info.Killer,
		VictimName = info.Victim,
		At = at,
		Title = "▶ KILLCAM FINAL",
		Name = Killcam.Caption(killerPlayer or info.Killer, info.Weapon),
		Final = true,
	})
end

local function buildOverlay()
	gui = UI.new("ScreenGui", {
		Name = "Killcam",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 40,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- Bandas negras de cine arriba y abajo, «KILLCAM» y quién hizo la baja con qué
	refs.Frame = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = gui })
	UI.new("Frame", {
		Size = UDim2.new(1, 0, 0.09, 0),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Parent = refs.Frame,
	})
	UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0.09, 0),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Parent = refs.Frame,
	})
	refs.Title = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.09, 6),
		Size = UDim2.new(0.6, 0, 0, 34),
		Text = "▶ KILLCAM",
		TextScaled = true,
		TextColor3 = Color3.fromRGB(255, 70, 60),
		TextStrokeTransparency = 0.2,
		Parent = refs.Frame,
	}, { UI.new("UITextSizeConstraint", { MaxTextSize = 30 }) })
	refs.Name = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.09, 40),
		Size = UDim2.new(0.6, 0, 0, 24),
		Text = "",
		TextScaled = true,
		Parent = refs.Frame,
	}, { UI.new("UITextSizeConstraint", { MaxTextSize = 20 }) })
end

function Killcam.Init()
	buildOverlay()
	-- Historia de posiciones (cada SampleTime s)
	RunService.Heartbeat:Connect(function(dt)
		sampleClock += dt
		if sampleClock >= Killcam.SampleTime then
			sampleClock = 0
			local ok, err = pcall(Killcam.Record)
			if not ok then
				warn("[Killcam]", err)
			end
		end
	end)
	-- Cuándo pasó cada baja en este cliente (la final se repite justo hasta ese momento)
	Remotes.KillFeed.OnClientEvent:Connect(function(info)
		if type(info) == "table" and info.Killer and info.Victim then
			lastKills[tostring(info.Killer) .. "|" .. tostring(info.Victim)] = os.clock()
		end
	end)
	Remotes.FinalKillcam.OnClientEvent:Connect(function(info)
		local ok, err = pcall(Killcam.PlayFinal, info)
		if not ok then
			warn("[Killcam] final:", err)
		end
	end)
	-- La final también se puede saltar (clic o toque); la de la muerte la salta DeathScreen
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not current or not current.Final then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			Killcam.Stop(true)
		end
	end)
end

return Killcam
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="217">
            <Properties>
              <string name="Name">KillstreakController</string>
              <string name="Source"><![CDATA[-- Recompensas por racha en el cliente:
--  * Radar: resalta en rojo a los enemigos a través de las paredes mientras dure (RadarUntil)
--  * Ataque aéreo: tecla T (cruceta derecha en mando) lanza el ataque al punto al que apuntas
--  * Marcas rojas en el suelo antes de que caigan las bombas
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)

local TouchLayout = require(script.Parent.TouchLayout)
local HUDZones = require(script.Parent.HUDZones)
local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local KillstreakController = {}

local strikeWidget, strikeLabel, radarLabel

local function radarActive()
	return workspace:GetServerTimeNow() < (player:GetAttribute("RadarUntil") or 0)
end

local function isEnemy(other)
	if other == player then
		return false
	end
	if ReplicatedStorage:GetAttribute("TeamMode") ~= false and player.Team ~= nil and other.Team == player.Team then
		return false
	end
	return true
end

-- Pone o quita el contorno rojo del radar en los enemigos.
-- Roblox dibuja como mucho 31 Highlights: con el radar activo se apagan los de los compañeros.
local function updateRadar()
	local active = radarActive()
	for _, other in Players:GetPlayers() do
		local teamHighlight = other.Character and other.Character:FindFirstChild("TeamHighlight")
		if teamHighlight and teamHighlight:IsA("Highlight") then
			teamHighlight.Enabled = not active
		end
	end
	-- Jugadores y bots (los bots llevan el nombre de su equipo en el atributo Team)
	local marks = {}
	for _, other in Players:GetPlayers() do
		if other.Character then
			table.insert(marks, { other.Character, isEnemy(other) })
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			local teamName = model:GetAttribute("Team")
			local sameTeam = ReplicatedStorage:GetAttribute("TeamMode") ~= false and player.Team ~= nil and teamName == player.Team.Name
			local teamHighlight = model:FindFirstChild("TeamHighlight")
			if teamHighlight and teamHighlight:IsA("Highlight") then
				teamHighlight.Enabled = not active
			end
			table.insert(marks, { model, not sameTeam })
		end
	end
	for _, mark in marks do
		local character, enemy = mark[1], mark[2]
		local highlight = character:FindFirstChild("RadarHighlight")
		-- (un modelo solo muestra un resaltado: con el del radar, el contorno normal se apaga)
		local outline = character:FindFirstChild("EnemyOutline")
		if outline and outline:IsA("Highlight") then
			outline.Enabled = not (active and enemy)
		end
		if active and enemy then
			if not highlight then
				highlight = Instance.new("Highlight")
				highlight.Name = "RadarHighlight"
				highlight.FillColor = Color3.fromRGB(255, 40, 40)
				highlight.FillTransparency = 0.55
				highlight.OutlineColor = Color3.fromRGB(255, 120, 120)
				highlight.OutlineTransparency = 0
				highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				highlight.Parent = character
			end
		elseif highlight then
			highlight:Destroy()
		end
	end
	local left = (player:GetAttribute("RadarUntil") or 0) - workspace:GetServerTimeNow()
	local visible = active and not ClientState.InMainMenu
	if radarLabel.Visible ~= visible then
		radarLabel.Visible = visible
	end
	-- (solo se escribe si cambia el segundo: esto va cuatro veces por segundo)
	local text = UI.HudText("📡 RADAR " .. math.max(0, math.ceil(left)) .. "s")
	if radarLabel.Text ~= text then
		radarLabel.Text = text
	end
end

local function updateWidget()
	local charges = player:GetAttribute("Airstrikes") or 0
	-- (con pantalla táctil, el botón ✈ de Roblox ya lo dice; el cartel quedaba encima de los botones)
	strikeWidget.Visible = charges > 0 and not ClientState.InMainMenu
		and not InputMode.TouchUI()
	strikeLabel.Text = "✈ T" .. (charges > 1 and (" ×" .. charges) or "")
	-- (en el botón táctil, cuántos hay si son varios)
	TouchLayout.SetBadge("Airstrike", charges > 1 and ("x" .. charges) or nil)
end

-- Punto al que apunta la cámara (o lejos al frente si apunta al cielo)
local function aimPoint()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = { camera }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	local fx = workspace:FindFirstChild("ClientFX")
	if fx then
		table.insert(ignore, fx)
	end
	params.FilterDescendantsInstances = ignore
	local origin = camera.CFrame.Position
	local direction = camera.CFrame.LookVector * 500
	local result = workspace:Raycast(origin, direction, params)
	return result and result.Position or origin + camera.CFrame.LookVector * 150
end

local function callAirstrike()
	if ClientState.IsBlocked() or (player:GetAttribute("Airstrikes") or 0) <= 0 then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	Remotes.CallAirstrike:FireServer(aimPoint())
	Sounds.Play("Flag", nil, 1.3, 1)
end

-- Columna roja y anillo donde va a caer cada bomba
local function markPoints(points, delay)
	local folder = workspace:FindFirstChild("ClientFX") or workspace
	for _, point in points do
		if typeof(point) == "Vector3" then
			local beam = Instance.new("Part")
			beam.Anchored = true
			beam.CanCollide = false
			beam.CanQuery = false
			beam.CanTouch = false
			beam.CastShadow = false
			beam.Material = Enum.Material.Neon
			beam.Color = Color3.fromRGB(255, 40, 40)
			beam.Transparency = 0.5
			beam.Size = Vector3.new(0.8, 70, 0.8)
			beam.CFrame = CFrame.new(point + Vector3.new(0, 35, 0))
			beam.Parent = folder
			local ring = Instance.new("Part")
			ring.Anchored = true
			ring.CanCollide = false
			ring.CanQuery = false
			ring.CanTouch = false
			ring.CastShadow = false
			ring.Material = Enum.Material.Neon
			ring.Color = Color3.fromRGB(255, 60, 40)
			ring.Shape = Enum.PartType.Cylinder
			ring.Transparency = 0.3
			ring.Size = Vector3.new(0.2, 2, 2)
			ring.CFrame = CFrame.new(point) * CFrame.Angles(0, 0, math.pi / 2)
			ring.Parent = folder
			TweenService:Create(ring, TweenInfo.new(delay, Enum.EasingStyle.Linear), { Size = Vector3.new(0.2, 22, 22), Transparency = 0.8 }):Play()
			TweenService:Create(beam, TweenInfo.new(delay, Enum.EasingStyle.Linear), { Size = Vector3.new(2.2, 70, 2.2) }):Play()
			Debris:AddItem(beam, delay + 0.2)
			Debris:AddItem(ring, delay + 0.2)
		end
	end
	Sounds.Play("Flag", nil, 0.6, 1.2)
end

function KillstreakController.Init()
	local gui = UI.new("ScreenGui", {
		Name = "Killstreaks",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 2,
		Parent = player:WaitForChild("PlayerGui"),
	})
	strikeWidget = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -116, 1, -150),
		Size = UDim2.fromOffset(84, 34),
		BackgroundColor3 = Color3.fromRGB(150, 30, 30),
		Visible = false,
		Parent = gui,
	}, { UI.corner(10), UI.stroke(Color3.fromRGB(255, 200, 60), 2, 0), UI.gloss() })
	strikeLabel = UI.label({ Size = UDim2.fromScale(1, 1), Text = "✈ T", TextSize = 20, Parent = strikeWidget })
	radarLabel = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 92),
		Size = UDim2.fromOffset(220, 28),
		Text = "",
		TextSize = 22,
		TextColor3 = Color3.fromRGB(255, 110, 110),
		Visible = false,
		Parent = gui,
	})

	if InputMode.TouchUI() then
		radarLabel.Size = UDim2.fromOffset(200, 18)
		radarLabel.TextSize = 15
		HUDZones.Register("Radar", radarLabel, "TOP_LEFT", 2, { Gui = gui, Fit = true })
	end

	TouchLayout.BindAction("Airstrike", function(_, state)
		if state == Enum.UserInputState.Begin then
			callAirstrike()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.T, Enum.KeyCode.DPadRight)
	TouchLayout.Set("Airstrike", UDim2.new(1, -280, 1, -310))
	player:GetAttributeChangedSignal("Airstrikes"):Connect(ClientState.UpdateMouse)
	ClientState.UpdateMouse()

	Remotes.AirstrikeMark.OnClientEvent:Connect(function(points, delay)
		if type(points) == "table" then
			markPoints(points, type(delay) == "number" and delay or 1.5)
		end
	end)

	task.spawn(function()
		while true do
			updateRadar()
			updateWidget()
			task.wait(0.25)
		end
	end)
end

return KillstreakController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="218">
            <Properties>
              <string name="Name">MainMenu</string>
              <string name="Source"><![CDATA[-- Pantalla de inicio: ahora es el flujo completo de menús (ver Flow/FlowController). Este módulo
-- solo lo arranca con todas sus pantallas y mantiene la entrada de siempre para el resto del juego
-- (MainMenu.Show desde la pantalla de muerte). La ScreenGui sigue llamándose "MainMenu".
local Flow = script.Parent:WaitForChild("Flow")
local FlowController = require(Flow.FlowController)

local MainMenu = {}

local SCREENS = {
	"Home",
	"Squad",
	"Armory",
	"Store",
	"Pass",
	"Operator",
	"Matchmaking",
	"MatchFound",
	"MapIntro",
	"TeamIntro",
	"Loadout",
	"Deploy",
	"Results",
}

-- "Volver al menú" (por ejemplo desde la pantalla de muerte)
function MainMenu.Show()
	FlowController.ReturnToLobby()
end

function MainMenu.Init()
	local screens = {}
	local folder = Flow:WaitForChild("Screens")
	for _, name in SCREENS do
		local module = folder:FindFirstChild(name)
		if module then
			local ok, result = pcall(require, module)
			if ok then
				screens[name] = result
			else
				warn("[MainMenu] " .. name .. ": " .. tostring(result))
			end
		end
	end
	FlowController.Init(screens)
	FlowController.SetState("Home")
end

MainMenu.Flow = FlowController
return MainMenu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="219">
            <Properties>
              <string name="Name">Menu</string>
              <string name="Source"><![CDATA[-- Menú principal del jugador (tecla B): perfil, pase de batalla, retos, armas, skins, trajes, efectos y tienda.
local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local MarketplaceService = game:GetService("MarketplaceService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Skins = require(Shared.Skins)
local Weapons = require(Shared.Weapons)
local Outfits = require(Shared.Outfits)
local Shop = require(Shared.Shop)
local Mastery = require(Shared.Mastery)
local KillEffects = require(Shared.KillEffects)
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)
local Ranks = require(Shared.Ranks)
local Charms = require(Shared.Charms)
local Sprays = require(Shared.Sprays)
local Titles = require(Shared.Titles)
local MonetizationConfig = require(Shared.Economy.MonetizationConfig)
local BattlePassConfig = require(Shared.Economy.BattlePassConfig)
local Catalog = require(Shared.Economy.CosmeticCatalog)
local Products = require(Shared.Economy.Products)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local WeaponIcon = require(script.Parent.WeaponIcon)
local Effects = require(script.Parent.Effects)
local Settings = require(script.Parent.Settings)
local RewardFX = require(script.Parent.RewardFX)
local TouchLayout = require(script.Parent.TouchLayout)
local HUDEditor = require(script.Parent.HUDEditor)

local player = Players.LocalPlayer

local Menu = {}

local gui, panel, content, headerInfo, toast
local tabButtons = {}
local currentTab = "Pase"
local busy = false
local refresh -- reconstruye la pestaña actual (definida más abajo)
local scrollToCoins = false -- al abrir la Tienda, bajar hasta los packs de monedas
local coinsSection -- título de la sección de monedas de la Tienda (para bajar hasta él)
local panelScale -- UIScale del panel (las posiciones en pantalla vienen escaladas)

local GOLD = Color3.fromRGB(255, 190, 40)
local PANEL_BG = Color3.fromRGB(22, 24, 38)
local CARD_BG = Color3.fromRGB(38, 42, 64)
local GREEN = Color3.fromRGB(60, 170, 90)
local BLUE = Color3.fromRGB(40, 120, 255)
local GREY = Color3.fromRGB(70, 70, 82)

local TABS = { "Perfil", "Pase", "Retos", "Armas", "Skins", "Trajes", "Efectos", "Tienda", "Ajustes" }

local function rarityColor(rarity)
	return Skins.RarityColors[rarity] or Color3.new(1, 1, 1)
end

local function showToast(text, color)
	if not toast then
		return
	end
	toast.Text = text
	toast.TextColor3 = color or Color3.new(1, 1, 1)
	toast.Visible = true
	local token = {}
	toast:SetAttribute("T", tostring(token))
	task.delay(2.5, function()
		if toast:GetAttribute("T") == tostring(token) then
			toast.Visible = false
		end
	end)
end

local function coinsText(n)
	return "💰 " .. tostring(n)
end

-- Skin con la que se ve un arma (camuflaje de maestría elegido o skin general)
local function skinFor(data, weaponName)
	local camo = data.WeaponCamos and data.WeaponCamos[weaponName]
	if camo and Mastery.HasCamo(data.WeaponKills and data.WeaponKills[weaponName] or 0, camo) then
		return camo
	end
	return data.EquippedSkin
end
Menu.SkinFor = skinFor

-- Barra de progreso sencilla
local function progressBar(parent, position, size, fraction, color)
	local bar = UI.new("Frame", {
		Position = position,
		Size = size,
		BackgroundColor3 = Color3.fromRGB(20, 22, 34),
		Parent = parent,
	}, { UI.corner(6) })
	UI.new("Frame", {
		Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1),
		BackgroundColor3 = color,
		Parent = bar,
	}, { UI.corner(6), UI.gloss() })
	return bar
end

local function scroller(layout)
	return UI.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		Parent = content,
	}, { layout })
end

local function buy(kind, id)
	if busy then
		return
	end
	busy = true
	Sounds.Play("Click")
	local ok, result, message = pcall(function()
		return Remotes.BuyItem:InvokeServer(kind, id)
	end)
	busy = false
	if ok and result then
		Sounds.Play("Kill")
		showToast(message or "¡Comprado!", GOLD)
	else
		showToast(ok and (message or "No se pudo comprar") or "Error de conexión", Color3.fromRGB(255, 90, 90))
		-- Le faltan monedas: se le lleva a los packs de monedas de la Tienda (si ya se pueden comprar)
		local canBuyCoins = false
		for _, pack in Shop.CoinPacks do
			canBuyCoins = canBuyCoins or pack.ProductId ~= 0
		end
		if ok and canBuyCoins and type(message) == "string" and string.find(message, "^Te faltan") then
			local fromTab = currentTab
			task.delay(1.2, function()
				if ClientState.MenuOpen and currentTab == fromTab and currentTab ~= "Tienda" then
					currentTab = "Tienda"
					scrollToCoins = true
					refresh()
				end
			end)
		end
	end
end

-- Maniquí R15 sencillo para previsualizar trajes
local function mannequin(outfitId)
	local model = Instance.new("Model")
	local skin = Color3.fromRGB(255, 204, 153)
	local legs = Color3.fromRGB(60, 60, 70)
	local torso = Color3.fromRGB(90, 120, 200)
	local parts = {
		{ "Head", Vector3.new(1.2, 1.2, 1.2), 0, 5.2, skin },
		{ "UpperTorso", Vector3.new(2, 1.6, 1), 0, 3.8, torso },
		{ "LowerTorso", Vector3.new(2, 0.4, 1), 0, 2.8, torso },
		{ "LeftUpperArm", Vector3.new(1, 1.2, 1), -1.5, 4.0, skin },
		{ "RightUpperArm", Vector3.new(1, 1.2, 1), 1.5, 4.0, skin },
		{ "LeftLowerArm", Vector3.new(1, 1.1, 1), -1.5, 2.85, skin },
		{ "RightLowerArm", Vector3.new(1, 1.1, 1), 1.5, 2.85, skin },
		{ "LeftHand", Vector3.new(1, 0.3, 1), -1.5, 2.15, skin },
		{ "RightHand", Vector3.new(1, 0.3, 1), 1.5, 2.15, skin },
		{ "LeftUpperLeg", Vector3.new(1, 1.2, 1), -0.5, 2.0, legs },
		{ "RightUpperLeg", Vector3.new(1, 1.2, 1), 0.5, 2.0, legs },
		{ "LeftLowerLeg", Vector3.new(1, 1.1, 1), -0.5, 0.85, legs },
		{ "RightLowerLeg", Vector3.new(1, 1.1, 1), 0.5, 0.85, legs },
		{ "LeftFoot", Vector3.new(1, 0.3, 1), -0.5, 0.15, legs },
		{ "RightFoot", Vector3.new(1, 0.3, 1), 0.5, 0.15, legs },
	}
	for _, spec in parts do
		local p = Instance.new("Part")
		p.Name = spec[1]
		p.Size = spec[2]
		p.CFrame = CFrame.new(spec[3], spec[4], 0)
		p.Color = spec[5]
		p.Anchored = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
	end
	local face = Instance.new("Part")
	face.Size = Vector3.new(0.6, 0.12, 0.05)
	face.CFrame = CFrame.new(0, 5.35, -0.62)
	face.Color = Color3.fromRGB(25, 25, 25)
	face.Anchored = true
	face.Parent = model
	Outfits.Apply(model, outfitId)
	return model
end

local function outfitViewport(outfitId, props)
	local viewport = UI.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(170, 170, 185),
		LightColor = Color3.new(1, 1, 1),
		LightDirection = Vector3.new(-1, -1.5, 1),
	})
	for k, v in props do
		viewport[k] = v
	end
	local model = mannequin(outfitId)
	model.Parent = viewport
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	camera.CFrame = CFrame.lookAt(Vector3.new(5, 4.6, -12), Vector3.new(0, 3, 0))
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	return viewport
end

---------------------------------------------------------------------------
-- Pestaña: Pase de batalla
---------------------------------------------------------------------------

local function rewardCard(reward, unlocked, premium, parent, order)
	local card = UI.new("Frame", {
		LayoutOrder = order,
		Size = UDim2.fromOffset(120, 116),
		BackgroundColor3 = CARD_BG,
		Parent = parent,
	}, { UI.corner(10), UI.stroke(premium and GOLD or Color3.fromRGB(90, 100, 140), 2, 0) })

	if not reward then
		UI.label({ Size = UDim2.fromScale(1, 1), Text = "—", TextSize = 30, TextTransparency = 0.5, Parent = card })
	elseif reward.Type == "Skin" then
		local skin = Skins.Get(reward.Id)
		WeaponIcon.Create(
			ClientState.Data and ClientState.Data.Primary or "ARX27",
			reward.Id,
			{ Position = UDim2.fromOffset(4, 4), Size = UDim2.fromOffset(112, 52), Parent = card },
			"angled",
			112 / 52
		)
		UI.label({ Position = UDim2.fromOffset(0, 58), Size = UDim2.new(1, 0, 0, 22), Text = skin.Name, TextSize = 17, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 80),
			Size = UDim2.new(1, 0, 0, 18),
			Text = skin.Rarity,
			TextSize = 14,
			TextColor3 = rarityColor(skin.Rarity),
			Parent = card,
		})
	elseif reward.Type == "Outfit" then
		local outfit = Outfits.Get(reward.Id)
		outfitViewport(reward.Id, { Position = UDim2.fromOffset(20, 2), Size = UDim2.fromOffset(80, 70), Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 74), Size = UDim2.new(1, 0, 0, 20), Text = outfit.Name, TextSize = 15, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 94),
			Size = UDim2.new(1, 0, 0, 16),
			Text = outfit.Rarity,
			TextSize = 13,
			TextColor3 = rarityColor(outfit.Rarity),
			Parent = card,
		})
	elseif reward.Type == "KillEffect" then
		local effect = KillEffects.Get(reward.Id)
		UI.label({ Position = UDim2.fromOffset(0, 14), Size = UDim2.new(1, 0, 0, 44), Text = effect.Icon, TextSize = 38, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 62), Size = UDim2.new(1, 0, 0, 22), Text = effect.Name, TextSize = 16, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 84),
			Size = UDim2.new(1, 0, 0, 16),
			Text = "Efecto · " .. effect.Rarity,
			TextSize = 13,
			TextColor3 = rarityColor(effect.Rarity),
			Parent = card,
		})
	elseif reward.Type == "Crate" then
		UI.label({ Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 40), Text = "🎁", TextSize = 36, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 66), Size = UDim2.new(1, 0, 0, 24), Text = "Caja", TextSize = 18, Parent = card })
	else
		UI.label({ Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 40), Text = "💰", TextSize = 34, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 62),
			Size = UDim2.new(1, 0, 0, 24),
			Text = tostring(reward.Amount),
			TextSize = 20,
			TextColor3 = GOLD,
			Parent = card,
		})
	end

	if reward then
		UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -4, 0, 2),
			Size = UDim2.fromOffset(24, 24),
			Text = unlocked and "✔" or "🔒",
			TextSize = 18,
			TextColor3 = unlocked and Color3.fromRGB(90, 230, 110) or Color3.new(1, 1, 1),
			ZIndex = 3,
			Parent = card,
		})
		if not unlocked then
			UI.new("Frame", {
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Color3.new(0, 0, 0),
				BackgroundTransparency = 0.5,
				ZIndex = 2,
				Parent = card,
			}, { UI.corner(10) })
		end
	end
	return card
end

-- Pase de batalla (vista corta para la partida; el pase completo está en el lobby: PASE DE BATALLA)
local function buildPassPage(data)
	local page = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = content })
	local pass = data.Pass
	local season = pass and BattlePassConfig.Get(pass.Season)
	if not pass or not season then
		UI.label({ Size = UDim2.new(1, 0, 0, 40), Text = "Entre temporadas: el pase nuevo llega pronto", TextSize = 22, Parent = page })
		return
	end
	local into = pass.XP - BattlePassConfig.XPFor(pass.Tier)
	UI.label({
		Size = UDim2.new(1, -260, 0, 26),
		Text = season.Name .. " · " .. season.Title .. "  ·  Nivel " .. pass.Tier .. "  ·  " .. into .. " / " .. BattlePassConfig.XPPerTier .. " XP" .. (pass.HasPremium and "  ·  👑 PREMIUM" or ""),
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = page,
	})
	local bar = UI.new("Frame", { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, -260, 0, 12), BackgroundColor3 = Color3.fromRGB(10, 10, 15), Parent = page }, { UI.corner(6) })
	UI.new("Frame", { Size = UDim2.fromScale(math.clamp(into / BattlePassConfig.XPPerTier, 0, 1), 1), BackgroundColor3 = Color3.fromRGB(80, 170, 255), Parent = bar }, { UI.corner(6), UI.gloss() })
	local claimAll = UI.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(240, 44),
		Text = (pass.Claimable or 0) > 0 and ("Reclamar todo (" .. pass.Claimable .. ")") or "Nada por reclamar",
		BackgroundColor3 = (pass.Claimable or 0) > 0 and GREEN or GREY,
		Parent = page,
	}, { UI.gloss() })
	claimAll.Activated:Connect(function()
		if (pass.Claimable or 0) <= 0 or busy then
			return
		end
		busy = true
		local ok, success, result = pcall(function()
			return Remotes.ClaimPass:InvokeServer("All")
		end)
		busy = false
		if ok and success and type(result) == "table" then
			Sounds.Play("Kill")
			showToast("¡" .. #result .. " recompensas reclamadas!", GOLD)
		end
	end)
	UI.label({ Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 0, 20), Text = "Lo que viene (el pase completo, con vista previa, está en el lobby):", TextSize = 15, Font = UI.FontBody, TextXAlignment = Enum.TextXAlignment.Left, Parent = page })
	for row, track in { "Free", "Premium" } do
		local rowFrame = UI.new("Frame", { Position = UDim2.fromOffset(0, 76 + (row - 1) * 126), Size = UDim2.new(1, 0, 0, 120), BackgroundTransparency = 1, Parent = page }, {
			UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		})
		local first = math.max(1, math.min(pass.Tier - 1, BattlePassConfig.Tiers - 6))
		for tier = first, math.min(BattlePassConfig.Tiers, first + 6) do
			local reward = season.Tiers[tier] and season.Tiers[tier][track]
			local claimed = pass[track] and pass[track][tostring(tier)]
			local unlocked = tier <= pass.Tier and (track == "Free" or pass.HasPremium)
			local legacy = reward
			if reward and not (reward.Type == "Coins" or reward.Type == "Skin" or reward.Type == "Outfit" or reward.Type == "KillEffect" or reward.Type == "Crate") then
				legacy = { Type = "Coins", Amount = 0, Label = reward.Id }
			end
			local card = rewardCard(legacy, unlocked, track == "Premium", rowFrame, tier)
			if legacy and legacy.Label then
				for _, child in card:GetChildren() do
					if child:IsA("TextLabel") and child.Text == "0" then
						child.Text = tostring(legacy.Label)
						child.TextSize = 15
					end
				end
			end
			UI.label({ Position = UDim2.fromOffset(6, 2), Size = UDim2.fromOffset(70, 16), Text = "NIVEL " .. tier, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4, Parent = card })
			if claimed then
				UI.label({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 4, 1, -2), Size = UDim2.new(1, -8, 0, 16), Text = "RECLAMADO", TextSize = 12, TextColor3 = Color3.fromRGB(90, 230, 110), ZIndex = 4, Parent = card })
			end
		end
	end
end

local function nextAchievements(data)
	local list, seen = {}, {}
	for _, achievement in GameConfig.Achievements do
		if not seen[achievement.Stat] and not (data.Achievements or {})[achievement.Id] then
			seen[achievement.Stat] = true
			table.insert(list, achievement)
		end
	end
	return list
end

-- ¿Cuántos logros se pueden reclamar ya? (aviso en la pestaña Perfil)
local function claimableAchievements(data)
	local count = 0
	for _, achievement in GameConfig.Achievements do
		if not (data.Achievements or {})[achievement.Id] and (tonumber(data[achievement.Stat]) or 0) >= achievement.Goal then
			count += 1
		end
	end
	return count
end

-- Perfil: rango, nivel, estadísticas de siempre, arma favorita y colección
local function buildProfilePage(data)
	local scroll = scroller(UI.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }))
	-- Rango y nivel
	local points = data.RankPoints or 0
	local tier = Ranks.Get(points)
	local fraction, nextTier = Ranks.Progress(points)
	local top = UI.new("Frame", { LayoutOrder = 1, Size = UDim2.new(1, -12, 0, 120), BackgroundColor3 = CARD_BG, Parent = scroll }, {
		UI.corner(12),
		UI.stroke(tier.Color, 2, 0.2),
	})
	UI.label({ Position = UDim2.fromOffset(12, 10), Size = UDim2.fromOffset(100, 100), Text = tier.Icon, TextSize = 72, Parent = top })
	UI.label({
		Position = UDim2.fromOffset(120, 12),
		Size = UDim2.new(1, -140, 0, 34),
		Text = UI.upper(tier.Name) .. "   ·   " .. points .. " RP",
		TextSize = 30,
		TextColor3 = tier.Color,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = top,
	})
	progressBar(top, UDim2.fromOffset(120, 54), UDim2.new(1, -140, 0, 16), fraction, tier.Color)
	-- Temporada de rango (al acabar: premio por el mejor rango y los RP a la mitad)
	if data.RankSeasonName and data.RankSeasonEndsAt then
		local daysLeft = math.max(0, math.ceil((data.RankSeasonEndsAt - os.time()) / 86400))
		UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -16, 0, 16),
			Size = UDim2.fromOffset(300, 24),
			Text = "🏁 " .. data.RankSeasonName .. " · quedan " .. daysLeft .. " días",
			TextSize = 17,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = Color3.fromRGB(200, 205, 225),
			Parent = top,
		})
	end
	local nextText = "¡Rango máximo!"
	if nextTier then
		nextText = string.format("Faltan %d RP para %s %s", nextTier.Min - points, nextTier.Icon, nextTier.Name)
	end
	UI.label({
		Position = UDim2.fromOffset(120, 78),
		Size = UDim2.new(1, -140, 0, 26),
		Text = nextText .. "     ·     Nivel " .. data.Level .. (data.VIP and "  👑 VIP" or ""),
		TextSize = 18,
		TextColor3 = Color3.fromRGB(200, 205, 225),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = top,
	})

	-- Estadísticas
	local kills, deaths = data.TotalKills or 0, data.TotalDeaths or 0
	local matches, wins = data.Matches or 0, data.Wins or 0
	local stats = {
		{ "🎯", "Bajas", tostring(kills) },
		{ "💀", "Muertes", tostring(deaths) },
		{ "⚖", "K/D", string.format("%.2f", kills / math.max(1, deaths)) },
		{ "🏆", "Victorias", tostring(wins) },
		{ "🎮", "Partidas", tostring(matches) },
		{ "📈", "% victorias", matches > 0 and (math.floor(wins / matches * 100 + 0.5) .. "%") or "-" },
		{ "🔥", "Mejor racha", tostring(data.BestStreak or 0) },
		{ "🧠", "A la cabeza", tostring(data.Headshots or 0) },
		{ "🤝", "Asistencias", tostring(data.Assists or 0) },
		(function()
			-- (del evento en marcha; fuera de temporada, genérico)
			local event = GameConfig.CurrentEvent()
			local items = event and event.Items or "evento"
			return { event and event.ItemIcon or "🎉", string.upper(string.sub(items, 1, 1)) .. string.sub(items, 2), tostring(data.EventCandy or 0) }
		end)(),
	}
	local grid = UI.new("Frame", { LayoutOrder = 2, Size = UDim2.new(1, -12, 0, 170), BackgroundTransparency = 1, Parent = scroll }, {
		UI.new("UIGridLayout", { CellSize = UDim2.new(0.2, -10, 0, 80), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i, stat in stats do
		local cell = UI.new("Frame", { LayoutOrder = i, BackgroundColor3 = CARD_BG, Parent = grid }, { UI.corner(10) })
		UI.label({ Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 36), Text = stat[1] .. " " .. stat[3], TextSize = 28, Parent = cell })
		UI.label({ Position = UDim2.fromOffset(0, 48), Size = UDim2.new(1, 0, 0, 22), Text = stat[2], TextSize = 16, TextColor3 = Color3.fromRGB(170, 180, 215), Parent = cell })
	end

	-- Arma favorita (la de más bajas) y colección
	local favorite, favoriteKills = nil, 0
	for name, count in data.WeaponKills or {} do
		local def = Weapons.Get(name)
		if def and not def.Hidden and type(count) == "number" and count > favoriteKills then
			favorite, favoriteKills = name, count
		end
	end
	local bottom = UI.new("Frame", { LayoutOrder = 3, Size = UDim2.new(1, -12, 0, 130), BackgroundTransparency = 1, Parent = scroll })
	local favCard = UI.new("Frame", { Size = UDim2.new(0.5, -5, 1, 0), BackgroundColor3 = CARD_BG, Parent = bottom }, { UI.corner(12) })
	UI.label({ Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 24), Text = "⭐ ARMA FAVORITA", TextSize = 18, TextColor3 = GOLD, TextXAlignment = Enum.TextXAlignment.Left, Parent = favCard })
	if favorite then
		WeaponIcon.Create(favorite, skinFor(data, favorite), { Position = UDim2.fromOffset(10, 34), Size = UDim2.new(0.55, 0, 0, 86), Parent = favCard }, "angled", 2.2)
		UI.label({
			Position = UDim2.new(0.58, 0, 0, 44),
			Size = UDim2.new(0.42, -12, 0, 60),
			Text = Weapons.Get(favorite).DisplayName .. "\n" .. favoriteKills .. " bajas",
			TextSize = 20,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = favCard,
		})
	else
		UI.label({ Position = UDim2.fromOffset(14, 50), Size = UDim2.new(1, -28, 0, 40), Text = "¡Haz alguna baja para descubrirla!", TextSize = 18, Parent = favCard })
	end
	local function count(owned, list, skip)
		local have, total = 0, 0
		for id, item in list do
			if id ~= "Default" and not (skip and skip(item)) then
				total += 1
				if owned and owned[id] then
					have += 1
				end
			end
		end
		return have, total
	end
	local skinsHave, skinsTotal = count(data.Skins, Skins.List, function(skin)
		return skin.Mastery == true
	end)
	local outfitsHave, outfitsTotal = count(data.Outfits, Outfits.List)
	local effectsHave, effectsTotal = count(data.KillEffects, KillEffects.List)
	local collection = UI.new("Frame", { Position = UDim2.new(0.5, 5, 0, 0), Size = UDim2.new(0.5, -5, 1, 0), BackgroundColor3 = CARD_BG, Parent = bottom }, { UI.corner(12) })
	UI.label({ Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 24), Text = "🎒 COLECCIÓN", TextSize = 18, TextColor3 = GOLD, TextXAlignment = Enum.TextXAlignment.Left, Parent = collection })
	for i, row in { { "🎨 Skins", skinsHave, skinsTotal }, { "🦺 Trajes", outfitsHave, outfitsTotal }, { "💥 Efectos", effectsHave, effectsTotal } } do
		local y = 36 + (i - 1) * 30
		UI.label({ Position = UDim2.fromOffset(14, y), Size = UDim2.fromOffset(110, 22), Text = row[1], TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, Parent = collection })
		progressBar(collection, UDim2.fromOffset(124, y + 5), UDim2.new(1, -210, 0, 12), row[2] / math.max(1, row[3]), BLUE)
		UI.label({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, y), Size = UDim2.fromOffset(70, 22), Text = row[2] .. "/" .. row[3], TextSize = 16, TextXAlignment = Enum.TextXAlignment.Right, Parent = collection })
	end

	-- Logros (el siguiente de cada tipo)
	local claimedCount = 0
	for _ in data.Achievements or {} do
		claimedCount += 1
	end
	UI.label({
		LayoutOrder = 4,
		Size = UDim2.new(1, -12, 0, 30),
		Text = "🏅 LOGROS  ·  " .. claimedCount .. "/" .. #GameConfig.Achievements,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = GOLD,
		Parent = scroll,
	})
	local pending = nextAchievements(data)
	if #pending == 0 then
		UI.label({ LayoutOrder = 5, Size = UDim2.new(1, -12, 0, 40), Text = "¡Los tienes todos! 👑", TextSize = 20, Parent = scroll })
	end
	for i, achievement in pending do
		local value = tonumber(data[achievement.Stat]) or 0
		local ready = value >= achievement.Goal
		local card = UI.new("Frame", {
			LayoutOrder = 4 + i,
			Size = UDim2.new(1, -12, 0, 58),
			BackgroundColor3 = ready and Color3.fromRGB(40, 80, 50) or CARD_BG,
			Parent = scroll,
		}, { UI.corner(10), UI.stroke(ready and GREEN or Color3.fromRGB(90, 100, 140), 2, 0.2) })
		UI.label({ Position = UDim2.fromOffset(10, 0), Size = UDim2.fromOffset(40, 58), Text = achievement.Icon, TextSize = 28, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(54, 6),
			Size = UDim2.new(1, -250, 0, 24),
			Text = achievement.Text,
			TextSize = 18,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		progressBar(card, UDim2.fromOffset(54, 36), UDim2.new(1, -330, 0, 10), math.min(value, achievement.Goal) / achievement.Goal, ready and GREEN or BLUE)
		UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -196, 0, 30),
			Size = UDim2.fromOffset(70, 22),
			Text = math.min(value, achievement.Goal) .. "/" .. achievement.Goal,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = card,
		})
		local button = UI.button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(170, 38),
			Text = ready and ("🎁 Reclamar " .. coinsText(achievement.Coins)) or coinsText(achievement.Coins),
			TextSize = 16,
			BackgroundColor3 = ready and GREEN or GREY,
			AutoButtonColor = ready,
			Parent = card,
		}, { UI.gloss() })
		if ready then
			button.Activated:Connect(function()
				if busy then
					return
				end
				busy = true
				local ok, success, result = pcall(function()
					return Remotes.ClaimAchievement:InvokeServer(achievement.Id)
				end)
				busy = false
				if ok and success then
					Sounds.Play("Kill")
					showToast("🏅 ¡Logro conseguido! +" .. tostring(result) .. " 💰", GREEN)
					RewardFX.FlyCoins(headerInfo, 8)
					RewardFX.EdgeFlash(GREEN, 0.4)
				else
					showToast(ok and tostring(result) or "No se pudo reclamar", Color3.fromRGB(255, 90, 90))
				end
			end)
		end
	end

	-- Títulos: salen junto a tu nombre en el marcador y el chat
	local equippedTitle = data.EquippedTitle or "Novato"
	if not Titles.Owns(data, equippedTitle, data.VIP == true) then
		equippedTitle = "Novato"
	end
	UI.label({
		LayoutOrder = 40,
		Size = UDim2.new(1, -12, 0, 30),
		Text = "🏷 TÍTULO  ·  " .. Titles.Get(equippedTitle).Name .. "  (sale junto a tu nombre en el marcador y el chat)",
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = GOLD,
		Parent = scroll,
	})
	local grid = UI.new("Frame", {
		LayoutOrder = 41,
		Size = UDim2.new(1, -12, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = scroll,
	}, {
		UI.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(196, 62),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for i, id in Titles.Sorted() do
		local title = Titles.List[id]
		local owned = Titles.Owns(data, id, data.VIP == true)
		local equipped = id == equippedTitle
		local chip = UI.button({
			LayoutOrder = i,
			Text = "",
			BackgroundColor3 = equipped and Color3.fromRGB(60, 55, 25) or CARD_BG,
			AutoButtonColor = not equipped,
			Parent = grid,
		}, { UI.corner(10), UI.stroke(equipped and GOLD or (owned and title.Color or Color3.fromRGB(70, 75, 100)), 2, owned and 0.1 or 0.5) })
		UI.label({
			Position = UDim2.fromOffset(6, 6),
			Size = UDim2.new(1, -12, 0, 26),
			Text = (owned and "" or "🔒 ") .. title.Name,
			TextSize = 19,
			TextColor3 = owned and title.Color or Color3.fromRGB(140, 145, 165),
			TextScaled = true,
			Parent = chip,
		})
		local status
		if equipped then
			status = "✔ Elegido"
		elseif owned then
			status = "Elegir"
		elseif title.Price then
			status = coinsText(Shop.GetPrice("Title", id) or title.Price)
		else
			status = Titles.Requirement(id)
		end
		UI.label({
			Position = UDim2.fromOffset(6, 34),
			Size = UDim2.new(1, -12, 0, 20),
			Text = status,
			TextSize = 15,
			TextColor3 = equipped and GREEN or (title.Price and not owned and GOLD or Color3.fromRGB(190, 195, 220)),
			Parent = chip,
		})
		chip.Activated:Connect(function()
			if equipped then
				return
			end
			if owned then
				Sounds.Play("Click")
				Remotes.EquipTitle:FireServer(id)
			elseif title.Price then
				buy("Title", id)
			else
				showToast("🔒 Para conseguirlo: " .. Titles.Requirement(id), Color3.fromRGB(255, 200, 90))
			end
		end)
	end
end

local function buildChallengesPage(data)
	local info = data.Challenges
	local scroll = scroller(UI.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }))
	local secondsLeft = 86400 - os.time() % 86400
	UI.label({
		LayoutOrder = 0,
		Size = UDim2.new(1, -12, 0, 30),
		Text = string.format("RETOS DE HOY  ·  nuevos en %dh %02dm", secondsLeft // 3600, (secondsLeft % 3600) // 60),
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = GOLD,
		Parent = scroll,
	})
	if not info then
		return
	end
	for i, challenge in info.List do
		local card = UI.new("Frame", {
			LayoutOrder = i,
			Size = UDim2.new(1, -12, 0, 96),
			BackgroundColor3 = challenge.Done and Color3.fromRGB(34, 70, 50) or CARD_BG,
			Parent = scroll,
		}, { UI.corner(12), UI.stroke(challenge.Done and GREEN or Color3.fromRGB(90, 100, 140), 2, 0) })
		UI.label({
			Position = UDim2.fromOffset(16, 10),
			Size = UDim2.new(1, -260, 0, 28),
			Text = (challenge.Done and "✅ " or "🎯 ") .. challenge.Text,
			TextSize = 22,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		progressBar(card, UDim2.fromOffset(16, 50), UDim2.new(1, -300, 0, 14), challenge.Progress / challenge.Goal, challenge.Done and GREEN or BLUE)
		UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -270, 0, 66),
			Size = UDim2.fromOffset(140, 20),
			Text = challenge.Progress .. " / " .. challenge.Goal,
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = card,
		})
		UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -16, 0, 12),
			Size = UDim2.fromOffset(230, 26),
			Text = coinsText(challenge.Coins) .. "   +" .. challenge.XP .. " XP",
			TextSize = 20,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = GOLD,
			Parent = card,
		})
		if not challenge.Done and info.RerollsLeft > 0 then
			local reroll = UI.button({
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -16, 1, -10),
				Size = UDim2.fromOffset(150, 32),
				Text = "🔄 Cambiar reto",
				TextSize = 16,
				BackgroundColor3 = Color3.fromRGB(110, 80, 200),
				Parent = card,
			}, { UI.gloss() })
			reroll.Activated:Connect(function()
				if busy then
					return
				end
				busy = true
				Sounds.Play("Click")
				local ok, result = pcall(function()
					return Remotes.RerollChallenge:InvokeServer(i)
				end)
				busy = false
				if not (ok and result) then
					showToast("No se pudo cambiar el reto", Color3.fromRGB(255, 90, 90))
				end
			end)
		end
	end
	local done = 0
	for _, challenge in info.List do
		if challenge.Done then
			done += 1
		end
	end
	local bonus = UI.new("Frame", {
		LayoutOrder = 10,
		Size = UDim2.new(1, -12, 0, 70),
		BackgroundColor3 = info.Bonus and Color3.fromRGB(70, 60, 20) or Color3.fromRGB(50, 40, 70),
		Parent = scroll,
	}, { UI.corner(12), UI.stroke(GOLD, 2, info.Bonus and 0 or 0.5) })
	UI.label({
		Position = UDim2.fromOffset(16, 0),
		Size = UDim2.new(1, -32, 1, 0),
		Text = info.Bonus and "🎁 ¡Premio de hoy conseguido! Tienes una caja gratis en la Tienda"
			or ("🎁 Completa los " .. #info.List .. " retos (" .. done .. "/" .. #info.List .. ") y gana " .. info.BonusCrates .. " caja gratis"),
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = GOLD,
		Parent = bonus,
	})
	-- Retos semanales: más largos y con más premio (sin cambio de reto)
	local weekly = info.Weekly
	if weekly and #weekly.List > 0 then
		local left = math.max(0, (weekly.EndsAt or 0) - os.time())
		UI.label({
			LayoutOrder = 11,
			Size = UDim2.new(1, -12, 0, 34),
			Text = "📅 RETOS DE LA SEMANA  ·  nuevos en " .. (left >= 86400 and string.format("%dd %dh", left // 86400, (left % 86400) // 3600)
				or string.format("%dh %02dm", left // 3600, (left % 3600) // 60)),
			TextSize = 22,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.fromRGB(120, 200, 255),
			Parent = scroll,
		})
		local weeklyDone = 0
		for i, challenge in weekly.List do
			if challenge.Done then
				weeklyDone += 1
			end
			local card = UI.new("Frame", {
				LayoutOrder = 11 + i,
				Size = UDim2.new(1, -12, 0, 76),
				BackgroundColor3 = challenge.Done and Color3.fromRGB(34, 70, 50) or Color3.fromRGB(28, 40, 66),
				Parent = scroll,
			}, { UI.corner(12), UI.stroke(challenge.Done and GREEN or Color3.fromRGB(80, 150, 230), 2, 0) })
			UI.label({
				Position = UDim2.fromOffset(16, 8),
				Size = UDim2.new(1, -260, 0, 28),
				Text = (challenge.Done and "✅ " or "📅 ") .. challenge.Text,
				TextSize = 21,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = card,
			})
			progressBar(card, UDim2.fromOffset(16, 46), UDim2.new(1, -300, 0, 14), challenge.Progress / challenge.Goal, challenge.Done and GREEN or Color3.fromRGB(80, 150, 230))
			UI.label({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -270, 0, 42),
				Size = UDim2.fromOffset(140, 20),
				Text = challenge.Progress .. " / " .. challenge.Goal,
				TextSize = 16,
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = card,
			})
			UI.label({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -16, 0, 10),
				Size = UDim2.fromOffset(230, 26),
				Text = coinsText(challenge.Coins) .. "   +" .. challenge.XP .. " XP",
				TextSize = 20,
				TextXAlignment = Enum.TextXAlignment.Right,
				TextColor3 = GOLD,
				Parent = card,
			})
		end
		local weeklyBonus = UI.new("Frame", {
			LayoutOrder = 20,
			Size = UDim2.new(1, -12, 0, 56),
			BackgroundColor3 = weekly.Bonus and Color3.fromRGB(70, 60, 20) or Color3.fromRGB(30, 45, 80),
			Parent = scroll,
		}, { UI.corner(12), UI.stroke(Color3.fromRGB(120, 200, 255), 2, weekly.Bonus and 0 or 0.5) })
		UI.label({
			Position = UDim2.fromOffset(16, 0),
			Size = UDim2.new(1, -32, 1, 0),
			Text = weekly.Bonus and "🎁 ¡Premio de la semana conseguido! Tus cajas están en la Tienda"
				or ("🎁 Completa los " .. #weekly.List .. " retos semanales (" .. weeklyDone .. "/" .. #weekly.List .. ") y gana " .. weekly.BonusCrates .. " cajas gratis"),
			TextSize = 19,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.fromRGB(150, 215, 255),
			Parent = weeklyBonus,
		})
	end
	-- Evento de temporada: premios por caramelos (GameConfig.Event) con su vista previa
	local event = GameConfig.CurrentEvent()
	if event and ReplicatedStorage:GetAttribute("EventName") then
		local icon, itemIcon, items = event.Icon or "🎉", event.ItemIcon or "⭐", event.Items or "objetos"
		local candy = data.EventCandy or 0
		local card = UI.new("Frame", {
			LayoutOrder = 30,
			Size = UDim2.new(1, -12, 0, 214),
			BackgroundColor3 = Color3.fromRGB(50, 26, 66),
			Parent = scroll,
		}, { UI.corner(12), UI.stroke(Color3.fromRGB(255, 140, 30), 2, 0.1) })
		UI.label({
			Position = UDim2.fromOffset(16, 8),
			Size = UDim2.new(1, -32, 0, 28),
			Text = icon .. " EVENTO DE " .. UI.upper(event.Name) .. "  ·  " .. itemIcon .. " " .. math.min(candy, event.Goal) .. " / " .. event.Goal .. " " .. items,
			TextSize = 22,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.fromRGB(255, 170, 60),
			Parent = card,
		})
		UI.label({
			Position = UDim2.fromOffset(16, 34),
			Size = UDim2.new(1, -32, 0, 20),
			Text = "Recoge los " .. items .. " que aparecen por el mapa durante las partidas",
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.fromRGB(210, 195, 230),
			Font = UI.FontBody,
			TextStrokeTransparency = 1,
			Parent = card,
		})
		progressBar(card, UDim2.fromOffset(16, 60), UDim2.new(1, -32, 0, 12), candy / event.Goal, Color3.fromRGB(255, 140, 30))
		-- Premios: los de por el camino y la skin final
		local prizes = {}
		for _, milestone in event.Milestones or {} do
			if milestone.Count < event.Goal then
				table.insert(prizes, milestone)
			end
		end
		table.insert(prizes, { Count = event.Goal, Skin = event.RewardSkin })
		local width = 1 / #prizes
		for i, prize in prizes do
			local got = candy >= prize.Count
			if prize.Weapon then
				got = (data.OwnedWeapons or {})[prize.Weapon] == true -- (se da al recoger el siguiente caramelo)
			end
			local cell = UI.new("Frame", {
				Position = UDim2.new(width * (i - 1), i == 1 and 16 or 6, 0, 82),
				Size = UDim2.new(width, i == 1 and -22 or -12, 0, 122),
				BackgroundColor3 = got and Color3.fromRGB(40, 80, 50) or CARD_BG,
				Parent = card,
			}, { UI.corner(10), UI.stroke(got and GREEN or Color3.fromRGB(110, 90, 140), 2, 0.2) })
			local preview = { Position = UDim2.fromOffset(4, 2), Size = UDim2.new(1, -8, 0, 78), Parent = cell }
			local title
			if prize.Outfit and Outfits.List[prize.Outfit] then
				outfitViewport(prize.Outfit, preview)
				title = "Traje " .. Outfits.List[prize.Outfit].Name
			elseif prize.Weapon and Weapons.Get(prize.Weapon) then
				WeaponIcon.Create(prize.Weapon, "Default", preview, "angled", 2.2)
				title = Weapons.Get(prize.Weapon).DisplayName
			elseif prize.Skin and Skins.List[prize.Skin] then
				WeaponIcon.Create(data.Primary or "ARX27", prize.Skin, preview, "angled", 2.2)
				title = "Skin " .. Skins.List[prize.Skin].Name
			else
				UI.label({ Position = UDim2.fromOffset(0, 14), Size = UDim2.new(1, 0, 0, 50), Text = "💰", TextSize = 44, Parent = cell })
				title = coinsText(prize.Coins or 0)
			end
			UI.label({
				Position = UDim2.new(0, 4, 1, -42),
				Size = UDim2.new(1, -8, 0, 20),
				Text = title,
				TextSize = 15,
				TextScaled = true,
				Parent = cell,
			})
			UI.label({
				Position = UDim2.new(0, 4, 1, -22),
				Size = UDim2.new(1, -8, 0, 18),
				Text = got and "✅ Conseguido" or (itemIcon .. " " .. prize.Count),
				TextSize = 15,
				TextColor3 = got and Color3.fromRGB(150, 255, 150) or Color3.fromRGB(255, 190, 90),
				Parent = cell,
			})
		end
	end
	UI.label({
		LayoutOrder = 31,
		Size = UDim2.new(1, -12, 0, 40),
		Text = "Consejo: cada arma tiene MAESTRÍA. Consigue bajas con ella para ganar camuflajes Carbono, Oro, Diamante y Materia oscura (pestaña Armas).",
		TextSize = 15,
		TextWrapped = true,
		TextColor3 = Color3.fromRGB(190, 195, 220),
		Font = UI.FontBody,
		TextStrokeTransparency = 1,
		Parent = scroll,
	})
end

---------------------------------------------------------------------------
-- Pestaña: Armas
---------------------------------------------------------------------------

-- Estadísticas de un arma en barras de 0 a 1, comparadas con la mejor del juego en cada cosa:
-- { { nombre, fracción, color } }. nil si no se comparan así (lanzacohetes, arcos explosivos...)
local STAT_RED, STAT_YELLOW, STAT_BLUE = Color3.fromRGB(255, 90, 70), Color3.fromRGB(255, 200, 60), Color3.fromRGB(80, 180, 255)
local statMax = nil
local function statRows(def)
	if def.Explosive then
		return nil
	end
	if not statMax then
		statMax = { Damage = 1, Rate = 1, Recoil = 1, Melee = 1, MeleeRate = 1, Range = 1 }
		for _, other in Weapons.List do
			if other.Type == "Gun" and not other.Explosive then
				statMax.Damage = math.max(statMax.Damage, (other.Damage or 0) * (other.Pellets or 1))
				statMax.Rate = math.max(statMax.Rate, other.FireRate or 0)
				statMax.Recoil = math.max(statMax.Recoil, other.Recoil or 0)
			elseif other.Type == "Melee" then
				statMax.Melee = math.max(statMax.Melee, other.Damage or 0)
				statMax.MeleeRate = math.max(statMax.MeleeRate, 1 / math.max(other.Cooldown or 1, 0.05))
				statMax.Range = math.max(statMax.Range, other.Range or 0)
			end
		end
	end
	if def.Type == "Melee" then
		return {
			{ "DAÑO", (def.Damage or 0) / statMax.Melee, STAT_RED },
			{ "VELOCIDAD", (1 / math.max(def.Cooldown or 1, 0.05)) / statMax.MeleeRate, STAT_YELLOW },
			{ "ALCANCE", (def.Range or 0) / statMax.Range, STAT_BLUE },
		}
	elseif def.Type == "Gun" then
		return {
			{ "DAÑO", (def.Damage or 0) * (def.Pellets or 1) / statMax.Damage, STAT_RED },
			{ "CADENCIA", (def.FireRate or 0) / statMax.Rate, STAT_YELLOW },
			-- (control: lo contrario del retroceso; ningún arma se queda a cero)
			{ "CONTROL", 1 - 0.85 * (def.Recoil or 0) / statMax.Recoil, STAT_BLUE },
		}
	end
	return nil
end

local function buildWeaponsPage(data)
	local scroll = scroller(UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(205, 282),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}))
	local order = 0
	local function weaponCard(weaponName, slotField)
		order += 1
		local def = Weapons.Get(weaponName)
		local unlocked = Weapons.IsUnlocked(weaponName, data)
		local selected = data[slotField] == weaponName
		local card = UI.new("Frame", {
			LayoutOrder = order,
			BackgroundColor3 = CARD_BG,
			Parent = scroll,
		}, { UI.corner(12), UI.stroke(selected and GOLD or Color3.fromRGB(90, 100, 140), 2, 0) })
		UI.label({ Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 24), Text = def.DisplayName, TextSize = 21, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 28),
			Size = UDim2.new(1, 0, 0, 16),
			Text = def.Category .. (slotField == "Secondary" and " · secundaria" or ""),
			TextSize = 14,
			TextColor3 = Color3.fromRGB(170, 180, 215),
			Parent = card,
		})
		WeaponIcon.Create(weaponName, skinFor(data, weaponName), { Position = UDim2.fromOffset(8, 46), Size = UDim2.fromOffset(189, 78), Parent = card }, "angled", 189 / 78)
		local stats
		if def.Type == "Melee" then
			stats = string.format("Daño %d · alcance %s · %.1f golpes/s", def.Damage, tostring(def.Range), 1 / def.Cooldown)
		elseif def.Explosive then
			stats = "Explosivo · radio " .. def.Explosive.Radius
		else
			local damage = def.Pellets > 1 and (def.Damage .. "x" .. def.Pellets) or tostring(def.Damage)
			stats = string.format("Daño %s · %d/s · %d balas", damage, math.floor(def.FireRate + 0.5), def.MagSize)
		end
		-- Barras de estadísticas (comparables entre armas); las explosivas, en texto
		local rows = statRows(def)
		if rows then
			for i, row in rows do
				local y = 128 + (i - 1) * 12
				UI.label({
					Position = UDim2.fromOffset(10, y),
					Size = UDim2.fromOffset(62, 10),
					Text = row[1],
					TextSize = 11,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextColor3 = Color3.fromRGB(190, 195, 220),
					Parent = card,
				})
				progressBar(card, UDim2.fromOffset(74, y + 1), UDim2.new(1, -84, 0, 8), row[2], row[3])
			end
		else
			UI.label({ Position = UDim2.fromOffset(0, 128), Size = UDim2.new(1, 0, 0, 18), Text = stats, TextSize = 14, Parent = card })
		end
		UI.label({
			Position = UDim2.fromOffset(8, 164),
			Size = UDim2.new(1, -16, 0, 16),
			Text = def.Description or "",
			TextSize = 12,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextColor3 = Color3.fromRGB(190, 195, 220),
			Font = UI.FontBody,
			TextStrokeTransparency = 1,
			Parent = card,
		})
		-- Maestría: bajas con esta arma y camuflajes ganados
		local kills = data.WeaponKills and data.WeaponKills[weaponName] or 0
		local level = Mastery.Level(kills)
		local nextTier = Mastery.Next(kills)
		local current = Mastery.Tiers[level]
		UI.label({
			Position = UDim2.fromOffset(8, 182),
			Size = UDim2.new(1, -16, 0, 16),
			Text = (current and ("🏆 " .. current.Name) or "🏆 Maestría")
				.. (nextTier and ("  ·  " .. kills .. "/" .. nextTier.Kills .. " bajas") or "  ·  ¡COMPLETA!"),
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = current and Skins.RarityColors[Skins.Get(current.Camo).Rarity] or Color3.fromRGB(200, 205, 225),
			Parent = card,
		})
		local previous = current and current.Kills or 0
		local fraction = nextTier and (kills - previous) / (nextTier.Kills - previous) or 1
		progressBar(card, UDim2.fromOffset(8, 200), UDim2.new(1, -16, 0, 8), fraction, GOLD)
		if level > 0 then
			local options = { "Default" }
			for i = 1, level do
				table.insert(options, Mastery.Tiers[i].Camo)
			end
			local selected = data.WeaponCamos and data.WeaponCamos[weaponName] or "Default"
			local index = table.find(options, selected) or 1
			local camoButton = UI.button({
				Position = UDim2.fromOffset(10, 212),
				Size = UDim2.new(1, -20, 0, 22),
				Text = "🎨 Camuflaje: " .. (selected == "Default" and "Skin general" or Skins.Get(selected).Name) .. "  ▸",
				TextSize = 13,
				BackgroundColor3 = Color3.fromRGB(70, 60, 120),
				Parent = card,
			})
			camoButton.Activated:Connect(function()
				Sounds.Play("Click")
				Remotes.SetCamo:FireServer(weaponName, options[index % #options + 1])
			end)
		end
		local button = UI.button({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.new(1, -20, 0, 36),
			TextSize = 17,
			Parent = card,
		}, { UI.gloss() })
		if selected then
			button.Text = "Equipada"
			button.BackgroundColor3 = GREEN
			button.AutoButtonColor = false
		elseif unlocked then
			button.Text = "Equipar"
			button.BackgroundColor3 = BLUE
			button.Activated:Connect(function()
				Sounds.Play("Click")
				if slotField == "Primary" then
					Remotes.SetPrimary:FireServer(weaponName)
				elseif slotField == "Melee" then
					Remotes.SetMelee:FireServer(weaponName)
				else
					Remotes.SetSecondary:FireServer(weaponName)
				end
			end)
		elseif def.Price and MonetizationConfig.Rules.WeaponsForCoins then
			button.Text = "🔒 Nv " .. def.UnlockLevel .. "  ·  " .. coinsText(def.Price)
			button.BackgroundColor3 = data.Coins >= def.Price and Color3.fromRGB(230, 140, 20) or GREY
			button.Activated:Connect(function()
				buy("Weapon", weaponName)
			end)
		else
			button.Text = def.EventText or ("🔒 Nivel " .. def.UnlockLevel)
			button.BackgroundColor3 = GREY
			button.AutoButtonColor = false
		end
	end
	for _, name in Weapons.Primaries do
		weaponCard(name, "Primary")
	end
	for _, name in Weapons.Secondaries do
		weaponCard(name, "Secondary")
	end
	for _, name in Weapons.Melees do
		weaponCard(name, "Melee")
	end
end

---------------------------------------------------------------------------
-- Pestañas: Skins y Trajes
---------------------------------------------------------------------------

local RARITY_ORDER = { "Común", "Raro", "Épico", "Legendario", "Mítico" }

-- kind (opcional): lo nuevo (Shop.NewItems) va delante, justo después del de por defecto
local function sortedIds(list, kind)
	local ids = {}
	for id in list do
		table.insert(ids, id)
	end
	table.sort(ids, function(a, b)
		if (a == "Default") ~= (b == "Default") then
			return a == "Default"
		end
		local na, nb = kind ~= nil and Shop.IsNew(kind, a), kind ~= nil and Shop.IsNew(kind, b)
		if na ~= nb then
			return na
		end
		local ra = table.find(RARITY_ORDER, list[a].Rarity) or 0
		local rb = table.find(RARITY_ORDER, list[b].Rarity) or 0
		if ra == rb then
			return list[a].Name < list[b].Name
		end
		return ra < rb
	end)
	return ids
end

local function priceButton(card, kind, id, owned, equipped, onEquip, lockedText)
	local price, onSale = Shop.GetPrice(kind, id)
	local button = UI.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.new(1, -20, 0, 32),
		TextSize = 16,
		Parent = card,
	}, { UI.gloss() })
	if equipped then
		button.Text = "Equipado"
		button.BackgroundColor3 = GREEN
		button.AutoButtonColor = false
	elseif owned then
		button.Text = "Equipar"
		button.BackgroundColor3 = BLUE
		button.Activated:Connect(onEquip)
	elseif price then
		button.Text = (onSale and "🔥 " or "") .. coinsText(price)
		button.BackgroundColor3 = onSale and Color3.fromRGB(230, 60, 90) or Color3.fromRGB(230, 140, 20)
		button.Activated:Connect(function()
			buy(kind, id)
		end)
	else
		button.Text = lockedText or "🔒 Pase de batalla"
		button.BackgroundColor3 = GREY
		button.AutoButtonColor = false
	end
	if onSale and not owned then
		UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -6, 0, 4),
			Size = UDim2.fromOffset(60, 20),
			Text = "-" .. math.floor(Shop.OfferDiscount * 100) .. "%",
			TextSize = 16,
			TextColor3 = Color3.fromRGB(255, 90, 120),
			ZIndex = 3,
			Parent = card,
		})
	end
	-- Recién llegado a la tienda (Shop.NewItems)
	if not owned and Shop.IsNew(kind, id) then
		UI.new("Frame", {
			Position = UDim2.fromOffset(6, 6),
			Size = UDim2.fromOffset(62, 20),
			BackgroundColor3 = Color3.fromRGB(255, 60, 110),
			ZIndex = 3,
			Parent = card,
		}, {
			UI.corner(6),
			UI.label({ Size = UDim2.fromScale(1, 1), Text = "¡NUEVO!", TextSize = 13, ZIndex = 4 }),
		})
	end
end

local function buildSkinsPage(data)
	local scroll = scroller(UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(165, 160),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}))
	local visible = {}
	for id, skin in Skins.List do
		if not skin.Mastery then
			visible[id] = skin
		end
	end
	for i, id in sortedIds(visible, "Skin") do
		local skin = Skins.List[id]
		local owned = data.Skins[id] == true
		local equipped = data.EquippedSkin == id
		local card = UI.new("Frame", { LayoutOrder = i, BackgroundColor3 = CARD_BG, Parent = scroll }, {
			UI.corner(10),
			UI.stroke(equipped and GOLD or rarityColor(skin.Rarity), 2, equipped and 0 or 0.4),
		})
		WeaponIcon.Create(data.Primary or "ARX27", id, { Position = UDim2.fromOffset(6, 4), Size = UDim2.fromOffset(153, 58), Parent = card }, "angled", 153 / 58)
		UI.label({
			Position = UDim2.fromOffset(0, 62),
			Size = UDim2.new(1, 0, 0, 22),
			Text = id == "Default" and "De fábrica" or skin.Name,
			TextSize = 19,
			Parent = card,
		})
		UI.label({
			Position = UDim2.fromOffset(0, 84),
			Size = UDim2.new(1, 0, 0, 16),
			Text = skin.Rarity,
			TextSize = 14,
			TextColor3 = rarityColor(skin.Rarity),
			Parent = card,
		})
		priceButton(card, "Skin", id, owned, equipped, function()
			Sounds.Play("Click")
			Remotes.EquipSkin:FireServer(id)
		end, skin.Event and (skin.EventText or "Evento") or nil)
	end

	-- Colgantes para el arma (en la misma rejilla, después de las skins)
	local header = UI.new("Frame", { LayoutOrder = 999, BackgroundColor3 = Color3.fromRGB(60, 50, 90), Parent = scroll }, { UI.corner(10) })
	UI.label({
		Size = UDim2.fromScale(1, 1),
		Text = "🔑 COLGANTES\nCuelgan de tu arma y se balancean\n(se ven al reaparecer)",
		TextSize = 16,
		TextWrapped = true,
		TextColor3 = GOLD,
		Parent = header,
	})
	local charmsOwned = data.Charms or { Default = true }
	for i, id in sortedIds(Charms.List, "Charm") do
		local charm = Charms.List[id]
		local equipped = (data.EquippedCharm or "Default") == id
		local card = UI.new("Frame", { LayoutOrder = 1000 + i, BackgroundColor3 = CARD_BG, Parent = scroll }, {
			UI.corner(10),
			UI.stroke(equipped and GOLD or rarityColor(charm.Rarity), 2, equipped and 0 or 0.4),
		})
		UI.label({ Position = UDim2.fromOffset(0, 4), Size = UDim2.new(1, 0, 0, 56), Text = charm.Icon, TextSize = 44, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 62), Size = UDim2.new(1, 0, 0, 22), Text = charm.Name, TextSize = 18, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 84),
			Size = UDim2.new(1, 0, 0, 16),
			Text = charm.Rarity,
			TextSize = 14,
			TextColor3 = rarityColor(charm.Rarity),
			Parent = card,
		})
		priceButton(card, "Charm", id, charmsOwned[id] == true, equipped, function()
			Sounds.Play("Click")
			Remotes.EquipCharm:FireServer(id)
		end)
	end
end

---------------------------------------------------------------------------
-- Pestaña: Ajustes (calidad gráfica, campo de visión, sensibilidad)
---------------------------------------------------------------------------

local QUALITY_INFO = {
	Auto = "Se elige sola: Rendimiento en móviles, Equilibrada en PC",
	Baja = "Máximo rendimiento (móviles modestos): sin sombras ni partículas del mapa. Lo del combate se ve igual",
	Media = "Recomendada: sombras, brillo y algo de ambiente",
	Alta = "Todo como está diseñado: rayos de sol, focos con sombra y todo el ambiente",
	Ultra = "Además horizonte suavizado y más partículas",
}
-- Nombre de cada calidad en pantalla (los valores guardados siguen siendo Baja/Media/Alta/Ultra)
local QUALITY_NAMES = { Auto = "Auto", Baja = "Rendimiento", Media = "Equilibrada", Alta = "Alta", Ultra = "Ultra" }

local function buildSettingsPage()
	local scroll = scroller(UI.new("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }))
	local current = Settings.Get()

	local function section(order, title, height)
		local frame = UI.new("Frame", {
			LayoutOrder = order,
			Size = UDim2.new(1, -12, 0, height),
			BackgroundColor3 = CARD_BG,
			Parent = scroll,
		}, { UI.corner(12) })
		UI.label({
			Position = UDim2.fromOffset(16, 8),
			Size = UDim2.new(1, -32, 0, 28),
			Text = title,
			TextSize = 22,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = frame,
		})
		return frame
	end

	-- Calidad gráfica
	local quality = section(1, "🎨 Calidad gráfica", 116)
	for i, level in GameConfig.QualityLevels do
		local selected = current.Quality == level
		local button = UI.button({
			Position = UDim2.fromOffset(16 + (i - 1) * 118, 42),
			Size = UDim2.fromOffset(110, 36),
			Text = QUALITY_NAMES[level] or level,
			TextSize = 16,
			BackgroundColor3 = selected and BLUE or GREY,
			Parent = quality,
		}, { UI.gloss() })
		button.Activated:Connect(function()
			Sounds.Play("Click")
			Settings.Set("Quality", level)
			refresh()
		end)
	end
	UI.label({
		Position = UDim2.fromOffset(16, 84),
		Size = UDim2.new(1, -32, 0, 22),
		Text = QUALITY_INFO[current.Quality] or "",
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(190, 195, 220),
		Font = UI.FontBody,
		TextStrokeTransparency = 1,
		Parent = quality,
	})

	-- Deslizadores sencillos con botones − y +
	local function stepper(order, title, key, step, format)
		local frame = section(order, title, 92)
		local valueLabel = UI.label({
			Position = UDim2.fromOffset(80, 44),
			Size = UDim2.fromOffset(120, 36),
			Text = string.format(format, current[key]),
			TextSize = 24,
			TextColor3 = GOLD,
			Parent = frame,
		})
		for _, info in { { "−", -step, 16 }, { "+", step, 206 } } do
			local button = UI.button({
				Position = UDim2.fromOffset(info[3], 44),
				Size = UDim2.fromOffset(56, 36),
				Text = info[1],
				TextSize = 26,
				BackgroundColor3 = BLUE,
				Parent = frame,
			}, { UI.gloss() })
			button.Activated:Connect(function()
				Sounds.Play("Click")
				Settings.Set(key, current[key] + info[2])
				valueLabel.Text = string.format(format, current[key])
			end)
		end
		return frame
	end
	stepper(2, "🔭 Campo de visión (FOV)", "FOV", 5, "%d°")
	stepper(3, "🖱 Sensibilidad", "Sensitivity", 0.1, "%.1f")
	stepper(4, "🎯 Sensibilidad al apuntar", "AimSensitivity", 0.05, "%.2f")

	-- Mira: color (muestras) y tamaño
	local cross = section(5, "➕ Mira", 92)
	for i, color in GameConfig.CrosshairColors do
		local selected = math.floor(current.CrossColor or 1) == i
		local swatch = UI.button({
			Position = UDim2.fromOffset(16 + (i - 1) * 46, 44),
			Size = UDim2.fromOffset(38, 36),
			Text = selected and "✔" or "",
			TextSize = 20,
			TextColor3 = Color3.new(0, 0, 0),
			BackgroundColor3 = color,
			Parent = cross,
		}, { UI.stroke(selected and GOLD or Color3.new(0, 0, 0), selected and 3 or 1, 0) })
		swatch.Activated:Connect(function()
			Sounds.Play("Click")
			Settings.Set("CrossColor", i)
			refresh()
		end)
	end
	local sizeLabel = UI.label({
		Position = UDim2.fromOffset(360, 44),
		Size = UDim2.fromOffset(110, 36),
		Text = "Tamaño " .. string.format("%.1f", current.CrossSize or 1),
		TextSize = 20,
		TextColor3 = GOLD,
		Parent = cross,
	})
	for _, info in { { "−", -0.2, 300 }, { "+", 0.2, 476 } } do
		local button = UI.button({
			Position = UDim2.fromOffset(info[3], 44),
			Size = UDim2.fromOffset(52, 36),
			Text = info[1],
			TextSize = 26,
			BackgroundColor3 = BLUE,
			Parent = cross,
		}, { UI.gloss() })
		button.Activated:Connect(function()
			Sounds.Play("Click")
			Settings.Set("CrossSize", (current.CrossSize or 1) + info[2])
			sizeLabel.Text = "Tamaño " .. string.format("%.1f", current.CrossSize or 1)
		end)
	end
	-- Disparo automático (como el modo sencillo de los shooters de móvil)
	local auto = section(6, "🔫 Disparo automático (con la mira sobre un enemigo)", 92)
	local autoMode = math.floor(current.AutoFire or 2)
	for i, info in { { 2, "Solo en móvil" }, { 1, "Siempre" }, { 0, "No" } } do
		local selected = autoMode == info[1]
		local button = UI.button({
			Position = UDim2.fromOffset(16 + (i - 1) * 150, 44),
			Size = UDim2.fromOffset(140, 36),
			Text = (selected and "✔ " or "") .. info[2],
			TextSize = 18,
			BackgroundColor3 = selected and Color3.fromRGB(60, 170, 90) or BLUE,
			Parent = auto,
		}, { UI.gloss() })
		button.Activated:Connect(function()
			Sounds.Play("Click")
			Settings.Set("AutoFire", info[1])
			refresh()
		end)
	end
	-- Asistencia de apuntado (solo con dedo o mando)
	local assist = section(7, "🎯 Asistencia de apuntado (con dedo o mando)", 92)
	local assistMode = math.floor((current.AimAssist == nil and 2 or current.AimAssist) + 0.5)
	for i, info in { { 2, "Normal" }, { 1, "Suave" }, { 0, "No" } } do
		local selected = assistMode == info[1]
		local button = UI.button({
			Position = UDim2.fromOffset(16 + (i - 1) * 150, 44),
			Size = UDim2.fromOffset(140, 36),
			Text = (selected and "✔ " or "") .. info[2],
			TextSize = 18,
			BackgroundColor3 = selected and Color3.fromRGB(60, 170, 90) or BLUE,
			Parent = assist,
		}, { UI.gloss() })
		button.Activated:Connect(function()
			Sounds.Play("Click")
			Settings.Set("AimAssist", info[1])
			refresh()
		end)
	end
	-- Uniforme militar en los mapas realistas (si no llevas un traje)
	local uniform = section(8, "🎖 Sin traje: uniforme militar o tu avatar (al reaparecer)", 92)
	local uniformMode = math.floor((current.Uniform == nil and 1 or current.Uniform) + 0.5)
	for i, info in { { 1, "Uniforme" }, { 0, "Mi avatar" } } do
		local selected = uniformMode == info[1]
		local button = UI.button({
			Position = UDim2.fromOffset(16 + (i - 1) * 150, 44),
			Size = UDim2.fromOffset(140, 36),
			Text = (selected and "✔ " or "") .. info[2],
			TextSize = 18,
			BackgroundColor3 = selected and Color3.fromRGB(60, 170, 90) or BLUE,
			Parent = uniform,
		}, { UI.gloss() })
		button.Activated:Connect(function()
			Sounds.Play("Click")
			Settings.Set("Uniform", info[1])
			refresh()
		end)
	end
	-- Efectos de pantalla (accesibilidad: hay a quien el desenfoque y los temblores le marean)
	local screenFx = section(9, "👁 Efectos de pantalla (desenfoque, destellos, temblor)", 150)
	local fxMode = math.floor((current.ScreenFX == nil and 1 or current.ScreenFX) + 0.5)
	for i, info in { { 1, "Normales" }, { 0, "Reducidos" } } do
		local selected = fxMode == info[1]
		local button = UI.button({
			Position = UDim2.fromOffset(16 + (i - 1) * 150, 44),
			Size = UDim2.fromOffset(140, 36),
			Text = (selected and "✔ " or "") .. info[2],
			TextSize = 18,
			BackgroundColor3 = selected and Color3.fromRGB(60, 170, 90) or BLUE,
			Parent = screenFx,
		}, { UI.gloss() })
		button.Activated:Connect(function()
			Sounds.Play("Click")
			Settings.Set("ScreenFX", info[1])
			refresh()
		end)
	end
	-- Color del contorno de los enemigos (accesibilidad: daltonismo)
	UI.label({
		Position = UDim2.fromOffset(16, 88),
		Size = UDim2.new(1, -32, 0, 20),
		Text = "Contorno de los enemigos",
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(190, 195, 220),
		Parent = screenFx,
	})
	local enemyNow = math.floor(current.EnemyColor or 1)
	for i, entry in GameConfig.EnemyColors do
		local selected = enemyNow == i
		local button = UI.button({
			Position = UDim2.fromOffset(16 + (i - 1) * 150, 108),
			Size = UDim2.fromOffset(140, 34),
			Text = (selected and "✔ " or "") .. entry.Name,
			TextSize = 17,
			BackgroundColor3 = selected and entry.Color:Lerp(Color3.new(0, 0, 0), 0.35) or BLUE,
			Parent = screenFx,
		}, { UI.gloss(), UI.stroke(entry.Color, 2, 0) })
		button.Activated:Connect(function()
			Sounds.Play("Click")
			Settings.Set("EnemyColor", i)
			ClientState.SettingsChanged:Fire("EnemyColor")
			refresh()
		end)
	end
	-- Ventaja (una, gratis)
	local perkSection = section(10, "🎖️ Ventaja", 130)
	local perkNow = math.floor(current.Perk or 0)
	local perkInfo = UI.label({
		Position = UDim2.fromOffset(16, 86),
		Size = UDim2.new(1, -32, 0, 38),
		Text = "Sin ventaja",
		TextSize = 15,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(190, 195, 220),
		Font = UI.FontBody,
		TextStrokeTransparency = 1,
		Parent = perkSection,
	})
	local perkOptions = { { Id = 0, Name = "Ninguna", Icon = "—", Text = "Sin ventaja" } }
	for _, perk in GameConfig.Perks do
		table.insert(perkOptions, perk)
	end
	for i, perk in perkOptions do
		local selected = perkNow == perk.Id
		if selected then
			perkInfo.Text = perk.Text .. (perk.Id ~= 0 and "  ·  (si estás en partida, desde que reaparezcas)" or "")
		end
		local button = UI.button({
			Position = UDim2.fromOffset(16 + (i - 1) * 132, 44),
			Size = UDim2.fromOffset(124, 36),
			Text = perk.Icon .. " " .. perk.Name,
			TextSize = 16,
			BackgroundColor3 = selected and Color3.fromRGB(60, 170, 90) or BLUE,
			Parent = perkSection,
		}, { UI.gloss() })
		button.Activated:Connect(function()
			Sounds.Play("Click")
			Settings.Set("Perk", perk.Id)
			refresh()
		end)
	end
	-- Controles táctiles (Fase 12; solo con pantalla táctil): correr, disparo izquierdo, disparar
	-- arrastrando y el editor de HUD
	if game:GetService("UserInputService").TouchEnabled then
		local touch = section(11, "🎮 Controles táctiles", 232)
		local function row(y, label, key, options, default)
			UI.label({
				Position = UDim2.fromOffset(16, y),
				Size = UDim2.fromOffset(128, 36),
				Text = label,
				TextSize = 15,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = touch,
			})
			local now = current[key]
			if now == nil then
				now = default
			end
			for i, info in options do
				local selected = math.floor(now + 0.5) == info[1]
				local button = UI.button({
					Position = UDim2.fromOffset(148 + (i - 1) * 183, y),
					Size = UDim2.fromOffset(175, 36),
					Text = (selected and "✔ " or "") .. info[2],
					TextSize = 15,
					BackgroundColor3 = selected and Color3.fromRGB(60, 170, 90) or BLUE,
					Parent = touch,
				}, { UI.gloss() })
				button.Activated:Connect(function()
					Sounds.Play("Click")
					Settings.Set(key, info[1])
					refresh()
				end)
			end
		end
		row(42, "Correr", "AutoSprint", { { 1, "Auto (joystick a fondo)" }, { 0, "Con botón" } }, 1)
		row(84, "Disparar", "FireDrag", { { 1, "Arrastrar para apuntar" }, { 0, "Solo tocar" } }, 1)
		row(126, "Disparo izquierdo", "LeftFire", { { 0, "No" }, { 1, "Sí (otro botón)" } }, 0)
		local customize = UI.button({
			Position = UDim2.fromOffset(16, 176),
			Size = UDim2.fromOffset(250, 42),
			Text = "PERSONALIZAR HUD",
			TextSize = 18,
			TextColor3 = Color3.fromRGB(20, 20, 24),
			BackgroundColor3 = Color3.fromRGB(255, 205, 60),
			Parent = touch,
		})
		customize.Activated:Connect(function()
			Sounds.Play("Click")
			Menu.Close()
			HUDEditor.Open(function()
				Menu.Open("Ajustes")
			end)
		end)
		UI.label({
			Position = UDim2.fromOffset(280, 176),
			Size = UDim2.new(1, -296, 0, 42),
			Text = "Mueve los botones, cambia su tamaño y su opacidad.",
			TextSize = 14,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.fromRGB(190, 195, 220),
			Font = UI.FontBody,
			TextStrokeTransparency = 1,
			Parent = touch,
		})
	end
	UI.label({
		LayoutOrder = 12,
		Size = UDim2.new(1, -12, 0, 40),
		Text = "Los ajustes se guardan con tu progreso. La calidad de Roblox (Menú de Roblox → Ajustes → Calidad de gráficos) también influye.",
		TextSize = 14,
		TextWrapped = true,
		TextColor3 = Color3.fromRGB(190, 195, 220),
		Font = UI.FontBody,
		TextStrokeTransparency = 1,
		Parent = scroll,
	})
end

-- Muestra un efecto de eliminación delante de la cámara (oculta el menú, y la pantalla de inicio
-- con su desenfoque si está abierta, durante un momento)
local previewing = false
local function previewKillEffect(effectId)
	if previewing then
		return
	end
	previewing = true
	local camera = workspace.CurrentCamera
	local position = camera.CFrame.Position + camera.CFrame.LookVector * 16
	panel.Visible = false
	local mainGui = player.PlayerGui:FindFirstChild("MainMenu")
	local mainWasEnabled = mainGui and mainGui.Enabled
	local blur = game:GetService("Lighting"):FindFirstChild("FlowBlur")
	local blurSize = blur and blur.Size
	if mainGui then
		mainGui.Enabled = false
	end
	if blur then
		blur.Size = 0
	end
	Effects.KillEffect(effectId, position, Color3.fromRGB(255, 200, 60))
	task.delay(2.2, function()
		previewing = false
		if mainGui and mainWasEnabled and ClientState.InMainMenu then
			mainGui.Enabled = true
		end
		if blur and blur.Parent and ClientState.InMainMenu then
			blur.Size = blurSize
		end
		if ClientState.MenuOpen then
			panel.Visible = true
		end
	end)
end

local function buildKillEffectsPage(data)
	local scroll = scroller(UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(200, 230),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}))
	local owned = data.KillEffects or { Default = true }
	for i, id in sortedIds(KillEffects.List, "KillEffect") do
		local effect = KillEffects.List[id]
		local equipped = (data.EquippedKillEffect or "Default") == id
		local card = UI.new("Frame", { LayoutOrder = i, BackgroundColor3 = CARD_BG, Parent = scroll }, {
			UI.corner(12),
			UI.stroke(equipped and GOLD or rarityColor(effect.Rarity), 2, equipped and 0 or 0.4),
		})
		UI.label({ Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 62), Text = effect.Icon, TextSize = 54, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 70), Size = UDim2.new(1, 0, 0, 24), Text = effect.Name, TextSize = 20, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 94),
			Size = UDim2.new(1, 0, 0, 16),
			Text = effect.Rarity,
			TextSize = 14,
			TextColor3 = rarityColor(effect.Rarity),
			Parent = card,
		})
		UI.label({
			Position = UDim2.fromOffset(8, 112),
			Size = UDim2.new(1, -16, 0, 34),
			Text = effect.Description or "",
			TextSize = 13,
			TextWrapped = true,
			TextColor3 = Color3.fromRGB(190, 195, 220),
			Font = UI.FontBody,
			TextStrokeTransparency = 1,
			Parent = card,
		})
		local preview = UI.button({
			Position = UDim2.fromOffset(10, 150),
			Size = UDim2.new(1, -20, 0, 26),
			Text = "👁 Ver efecto",
			TextSize = 15,
			BackgroundColor3 = Color3.fromRGB(70, 60, 120),
			Parent = card,
		})
		preview.Activated:Connect(function()
			Sounds.Play("Click")
			previewKillEffect(id)
		end)
		priceButton(card, "KillEffect", id, owned[id] == true, equipped, function()
			Sounds.Play("Click")
			Remotes.EquipKillEffect:FireServer(id)
		end)
	end

	-- Grafitis (tecla J), en la misma rejilla, después de los efectos
	local header = UI.new("Frame", { LayoutOrder = 999, BackgroundColor3 = Color3.fromRGB(60, 50, 90), Parent = scroll }, { UI.corner(12) })
	UI.label({
		Size = UDim2.fromScale(1, 1),
		Text = "🎨 GRAFITIS\n\nPulsa J (o 🎨 en el móvil) para pintar el tuyo en la pared que tienes delante",
		TextSize = 17,
		TextWrapped = true,
		TextColor3 = GOLD,
		Parent = header,
	}, { UI.new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }) })
	local spraysOwned = data.Sprays or { Default = true }
	for i, id in sortedIds(Sprays.List, "Spray") do
		local sprayDef = Sprays.List[id]
		local equipped = (data.EquippedSpray or "Default") == id
		local card = UI.new("Frame", { LayoutOrder = 1000 + i, BackgroundColor3 = CARD_BG, Parent = scroll }, {
			UI.corner(12),
			UI.stroke(equipped and GOLD or rarityColor(sprayDef.Rarity), 2, equipped and 0 or 0.4),
		})
		local preview = UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 10),
			Size = UDim2.fromOffset(110, 110),
			BackgroundTransparency = 1,
			Parent = card,
		})
		Sprays.Draw(id, preview)
		UI.label({ Position = UDim2.fromOffset(0, 126), Size = UDim2.new(1, 0, 0, 24), Text = sprayDef.Name, TextSize = 20, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 150),
			Size = UDim2.new(1, 0, 0, 16),
			Text = sprayDef.Rarity,
			TextSize = 14,
			TextColor3 = rarityColor(sprayDef.Rarity),
			Parent = card,
		})
		priceButton(card, "Spray", id, Sprays.Owns(spraysOwned, id, data.VIP == true), equipped, function()
			Sounds.Play("Click")
			Remotes.EquipSpray:FireServer(id)
		end, sprayDef.VIPOnly and "👑 Solo VIP" or nil)
	end
end

local function buildOutfitsPage(data)
	local scroll = scroller(UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(200, 250),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}))
	for i, id in sortedIds(Outfits.List, "Outfit") do
		local outfit = Outfits.List[id]
		local owned = data.Outfits[id] == true
		local equipped = data.EquippedOutfit == id
		local card = UI.new("Frame", { LayoutOrder = i, BackgroundColor3 = CARD_BG, Parent = scroll }, {
			UI.corner(12),
			UI.stroke(equipped and GOLD or rarityColor(outfit.Rarity), 2, equipped and 0 or 0.4),
		})
		if id ~= "Default" then
			outfitViewport(id, { Position = UDim2.fromOffset(10, 4), Size = UDim2.fromOffset(180, 140), Parent = card })
		else
			UI.label({ Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 60), Text = "🙂", TextSize = 54, Parent = card })
		end
		UI.label({ Position = UDim2.fromOffset(0, 146), Size = UDim2.new(1, 0, 0, 24), Text = outfit.Name, TextSize = 20, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 170),
			Size = UDim2.new(1, 0, 0, 18),
			Text = outfit.Class .. " · " .. outfit.Rarity,
			TextSize = 14,
			TextColor3 = rarityColor(outfit.Rarity),
			Parent = card,
		})
		priceButton(card, "Outfit", id, owned, equipped, function()
			Sounds.Play("Click")
			Remotes.EquipOutfit:FireServer(id)
		end, outfit.Event)
	end
end

---------------------------------------------------------------------------
-- Pestaña: Tienda (diaria, ofertas, cajas, Robux, VIP)
---------------------------------------------------------------------------

local function itemName(kind, id)
	if kind == "Outfit" then
		return Outfits.Get(id).Name, Outfits.Get(id).Rarity
	elseif kind == "KillEffect" then
		return KillEffects.Get(id).Name, KillEffects.Get(id).Rarity
	end
	return Skins.Get(id).Name, Skins.Get(id).Rarity
end

-- Animación de apertura de caja: una tira de premios que gira y se para en el tuyo
local crateOverlay = nil -- animación de caja en curso (el menú no se puede cerrar hasta acabar)

local function crateAnimation(result)
	local overlay = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.25,
		Active = true, -- los clics no atraviesan (no se compra otra caja sin querer)
		ZIndex = 20,
		Parent = gui,
	})
	crateOverlay = overlay
	UI.new("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true, Parent = overlay })
	local window = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(760, 170),
		BackgroundColor3 = Color3.fromRGB(15, 16, 26),
		ClipsDescendants = true,
		ZIndex = 21,
		Parent = overlay,
	}, { UI.corner(12), UI.stroke(GOLD, 3, 0) })
	local reel = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 15),
		Size = UDim2.fromOffset(40 * 150, 140),
		BackgroundTransparency = 1,
		ZIndex = 22,
		Parent = window,
	}, {
		UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	-- Rellenamos con objetos aleatorios y el premio en la posición 32
	local pool = {}
	for id, skin in Skins.List do
		if id ~= "Default" and not skin.Mastery and not skin.Event then
			table.insert(pool, { "Skin", id })
		end
	end
	for id, outfit in Outfits.List do
		if id ~= "Default" and not outfit.Event then
			table.insert(pool, { "Outfit", id })
		end
	end
	local PRIZE_INDEX = 32
	local prizeCard
	for i = 1, 38 do
		local kind, id
		if i == PRIZE_INDEX then
			kind, id = result.Kind, result.Id
		else
			local pick = pool[math.random(1, #pool)]
			kind, id = pick[1], pick[2]
		end
		local name, rarity = itemName(kind, id)
		local card = UI.new("Frame", {
			LayoutOrder = i,
			Size = UDim2.fromOffset(140, 140),
			BackgroundColor3 = rarityColor(rarity):Lerp(Color3.new(0, 0, 0), 0.55),
			ZIndex = 23,
			Parent = reel,
		}, { UI.corner(10), UI.stroke(rarityColor(rarity), 3, 0) })
		if i == PRIZE_INDEX then
			prizeCard = card
		end
		UI.label({
			Position = UDim2.fromOffset(0, 30),
			Size = UDim2.new(1, 0, 0, 50),
			Text = kind == "Outfit" and "🧥" or "🔫",
			TextSize = 40,
			ZIndex = 24,
			Parent = card,
		})
		UI.label({ Position = UDim2.fromOffset(4, 90), Size = UDim2.new(1, -8, 0, 22), Text = name, TextScaled = true, ZIndex = 24, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 112),
			Size = UDim2.new(1, 0, 0, 18),
			Text = rarity,
			TextSize = 14,
			TextColor3 = rarityColor(rarity),
			ZIndex = 24,
			Parent = card,
		})
	end
	-- Marcador central
	UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.new(0, 4, 1, 0),
		BackgroundColor3 = GOLD,
		BorderSizePixel = 0,
		ZIndex = 30,
		Parent = window,
	})
	local cardStep = 150
	local target = -((PRIZE_INDEX - 1) * cardStep + 70 - 380) + math.random(-50, 50)
	local spin = TweenService:Create(reel, TweenInfo.new(4.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = UDim2.fromOffset(target, 15) })
	spin:Play()
	-- "tic" mientras gira: cada vez más agudo según se acerca al premio (más tensión)
	task.spawn(function()
		local last = 0
		while spin.PlaybackState == Enum.PlaybackState.Playing do
			local index = math.floor(-reel.Position.X.Offset / cardStep)
			if index ~= last then
				last = index
				Sounds.Play("Click", nil, 0.8 + 0.7 * math.clamp(index / PRIZE_INDEX, 0, 1))
			end
			task.wait()
		end
	end)
	spin.Completed:Wait()
	local name, rarity = itemName(result.Kind, result.Id)
	Sounds.Play("Kill")
	-- La carta del premio salta y brilla con el color de su rareza
	if prizeCard then
		local pop = UI.new("UIScale", { Scale = 1, Parent = prizeCard })
		TweenService:Create(pop, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 1, true), { Scale = 1.12 }):Play()
		local stroke = prizeCard:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Thickness = 6
		end
	end
	local glow = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(760, 170),
		BackgroundColor3 = rarityColor(rarity),
		BackgroundTransparency = 0.3,
		ZIndex = 20,
		Parent = overlay,
	}, { UI.corner(16) })
	TweenService:Create(glow, TweenInfo.new(0.6, Enum.EasingStyle.Quad), { Size = UDim2.fromOffset(980, 330), BackgroundTransparency = 1 }):Play()
	-- Épico o mejor (y nuevo): ¡celebración! Si no, un destello del color de la rareza
	local rare = rarity == "Épico" or rarity == "Legendario" or rarity == "Mítico"
	if rare and not result.Duplicate then
		RewardFX.Celebrate("¡" .. UI.upper(rarity) .. "!", name, rarityColor(rarity), rarity ~= "Épico")
	else
		RewardFX.EdgeFlash(rarityColor(rarity), 0.45)
	end
	local title = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.45, 100),
		Size = UDim2.fromOffset(700, 50),
		Text = result.Duplicate and ("Repetido: " .. name .. "  ·  +" .. result.Refund .. " monedas") or ("¡" .. name .. "! (" .. rarity .. ")"),
		TextSize = 34,
		TextColor3 = rarityColor(rarity),
		TextStrokeTransparency = 0,
		ZIndex = 25,
		Parent = overlay,
	})
	local scale = UI.new("UIScale", { Scale = 1.6, Parent = title })
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	local close = UI.button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.45, 160),
		Size = UDim2.fromOffset(220, 46),
		Text = "¡Genial!",
		BackgroundColor3 = GREEN,
		ZIndex = 25,
		Parent = overlay,
	}, { UI.gloss() })
	close.Activated:Connect(function()
		overlay:Destroy()
		crateOverlay = nil
		busy = false
	end)
end

local function openCrate(crateId, useFree)
	if busy then
		return
	end
	busy = true
	local ok, success, result = pcall(function()
		return Remotes.OpenCrate:InvokeServer(crateId, useFree)
	end)
	if ok and success and type(result) == "table" then
		-- busy sigue activo hasta cerrar la animación (no se puede abrir otra mientras gira)
		crateAnimation(result)
	else
		busy = false
		showToast(ok and tostring(result) or "Error de conexión", Color3.fromRGB(255, 90, 90))
	end
end

local function sectionTitle(parent, text, order)
	return UI.label({
		LayoutOrder = order,
		Size = UDim2.new(1, -10, 0, 30),
		Text = text,
		TextSize = 24,
		TextColor3 = GOLD,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = parent,
	})
end

-- Fila de tarjetas: si no caben (pantallas estrechas) pasan a la línea siguiente
local function row(parent, order, height)
	return UI.new("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, -10, 0, height),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Wraps = true,
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
end

local function buildShopPage(data)
	local scroll = scroller(UI.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }))

	-- Pack de inicio (solo jugadores nuevos, una vez)
	local starter = Shop.StarterPack
	if data.StarterPackAvailable then
		local card = UI.new("Frame", {
			LayoutOrder = 0,
			Size = UDim2.new(1, -10, 0, 130),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			Parent = scroll,
		}, {
			UI.corner(14),
			UI.stroke(GOLD, 3, 0),
			UI.new("UIGradient", {
				Color = ColorSequence.new(Color3.fromRGB(255, 90, 40), Color3.fromRGB(150, 40, 200)),
				Rotation = 0,
			}),
		})
		UI.label({
			Position = UDim2.fromOffset(18, 8),
			Size = UDim2.new(1, -280, 0, 36),
			Text = "🔥 PACK DE INICIO  ·  solo una vez",
			TextSize = 28,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		UI.label({
			Position = UDim2.fromOffset(18, 48),
			Size = UDim2.new(1, -280, 0, 72),
			Text = (function()
				local names = {}
				for _, entry in Products.BundleItems(starter) do
					local item = Catalog.Item(entry.Kind, entry.Id)
					if item then
						table.insert(names, item.Name)
					end
				end
				return "💰 " .. starter.Coins .. " monedas  ·  " .. table.concat(names, " · ") .. "\nSolo estética y monedas. Una sola compra."
			end)(),
			TextSize = 18,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = card,
		})
		local buyStarter = UI.button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -18, 0.5, 0),
			Size = UDim2.fromOffset(230, 60),
			Text = starter.ProductId ~= 0 and ("R$ " .. starter.Robux .. "  ¡COMPRAR!") or "Próximamente",
			TextSize = 24,
			BackgroundColor3 = starter.ProductId ~= 0 and GREEN or GREY,
			Parent = card,
		}, { UI.gloss() })
		buyStarter.Activated:Connect(function()
			if not buyStarter.Active then
				return
			end
			if starter.ProductId ~= 0 then
				Sounds.Play("Click")
				-- Un solo intento hasta que llegue la respuesta del servidor (la página se rehace)
				buyStarter.Active = false
				buyStarter.AutoButtonColor = false
				buyStarter.Text = "Procesando..."
				MarketplaceService:PromptProductPurchase(player, starter.ProductId)
			else
				showToast("Próximamente")
			end
		end)
	end

	-- Packs de temporada (compra única, solo en sus fechas; el servidor dice cuáles se ofrecen)
	for bundleIndex, bundle in ipairs(Shop.Bundles) do
	if table.find(data.BundlesAvailable or {}, bundle.Id) and os.time() < (bundle.EndsAt or math.huge) then
		local daysLeft = bundle.EndsAt and math.max(0, math.ceil((bundle.EndsAt - os.time()) / 86400)) or 99
		local card = UI.new("Frame", {
			LayoutOrder = -10 + bundleIndex,
			Size = UDim2.new(1, -10, 0, 130),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			Parent = scroll,
		}, {
			UI.corner(14),
			UI.stroke(Color3.fromRGB(255, 150, 30), 3, 0),
			UI.new("UIGradient", {
				Color = ColorSequence.new(bundle.Colors[1], bundle.Colors[2]),
				Rotation = 0,
			}),
		})
		UI.label({
			Position = UDim2.fromOffset(18, 8),
			Size = UDim2.new(1, -280, 0, 36),
			Text = bundle.Icon .. " " .. bundle.Name .. (bundle.EndsAt and ("  ·  a la venta " .. daysLeft .. (daysLeft == 1 and " día más" or " días más")) or ""),
			TextSize = 26,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		UI.label({
			Position = UDim2.fromOffset(18, 48),
			Size = UDim2.new(1, -280, 0, 72),
			Text = (function()
				-- Lo que trae (nombres) y lo que vale por separado (solo precios reales)
				local names = {}
				for _, entry in Products.BundleItems(bundle) do
					local item = Catalog.Item(entry.Kind, entry.Id)
					if item then
						table.insert(names, item.Name)
					end
				end
				local value = Catalog.BundleValue(bundle)
				local valueText = ""
				if value.Complete and value.Robux > bundle.Robux and value.Coins == (bundle.Coins or 0) then
					valueText = "\nPor separado: R$ " .. value.Robux
				elseif value.Complete and value.Robux == 0 and value.Coins > 0 then
					valueText = "\nLo que trae vale " .. value.Coins .. " monedas en la tienda"
				end
				return ((bundle.Coins or 0) > 0 and ("💰 " .. bundle.Coins .. " monedas  ·  ") or "") .. table.concat(names, " · ") .. valueText
			end)(),
			TextSize = 18,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = card,
		})
		local buyBundle = UI.button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -18, 0.5, 0),
			Size = UDim2.fromOffset(230, 60),
			Text = "R$ " .. bundle.Robux .. "  ¡COMPRAR!",
			TextSize = 24,
			BackgroundColor3 = GREEN,
			Parent = card,
		}, { UI.gloss() })
		buyBundle.Activated:Connect(function()
			if not buyBundle.Active then
				return
			end
			Sounds.Play("Click")
			buyBundle.Active = false
			buyBundle.AutoButtonColor = false
			buyBundle.Text = "Procesando..."
			MarketplaceService:PromptProductPurchase(player, bundle.ProductId)
			-- (si la compra no llega a entregarse, el botón vuelve a funcionar)
			task.delay(20, function()
				if buyBundle.Parent and buyBundle.Text == "Procesando..." then
					buyBundle.Active = true
					buyBundle.AutoButtonColor = true
					buyBundle.Text = "R$ " .. bundle.Robux .. "  ¡COMPRAR!"
				end
			end)
		end)
	end
	end

	-- Recompensa diaria
	local daily = UI.new("Frame", {
		LayoutOrder = 1,
		Size = UDim2.new(1, -10, 0, 118),
		BackgroundColor3 = Color3.fromRGB(40, 60, 40),
		Parent = scroll,
	}, { UI.corner(12), UI.stroke(Color3.fromRGB(90, 230, 110), 2, 0) })
	local streak = data.DailyStreak or 0
	-- (el servidor dice qué día toca: si se saltó uno, la racha vuelve a empezar)
	local nextDay = data.DailyAvailable and (data.DailyNext or ((streak % #Shop.DailyRewards) + 1)) or streak
	UI.label({
		Position = UDim2.fromOffset(16, 0),
		Size = UDim2.new(1, -260, 0, 56),
		Text = "🎁 Recompensa diaria · Día " .. tostring(nextDay) .. "/" .. #Shop.DailyRewards .. "  (día 7: caja gratis)"
			.. ((GameConfig.CurrentEvent() and (GameConfig.EventDailyBonus or 0) > 0) and ("  + " .. GameConfig.EventDailyBonus .. " " .. (GameConfig.CurrentEvent().ItemIcon or GameConfig.CurrentEvent().Icon)) or ""),
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = daily,
	})
	local claim = UI.button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(220, 46),
		Text = data.DailyAvailable and "¡Reclamar!" or "Vuelve mañana",
		BackgroundColor3 = data.DailyAvailable and GREEN or GREY,
		Parent = daily,
	}, { UI.gloss() })
	claim.Activated:Connect(function()
		Menu.ClaimDaily()
	end)
	-- Tira de los 7 días: los recogidos con ✓, el de hoy destacado (da ganas de no romper la racha)
	local strip = UI.new("Frame", {
		Position = UDim2.fromOffset(16, 58),
		Size = UDim2.new(1, -260, 0, 50),
		BackgroundTransparency = 1,
		Parent = daily,
	}, {
		UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for day, coins in Shop.DailyRewards do
		local claimed = (data.DailyAvailable and day < nextDay) or (not data.DailyAvailable and day <= streak)
		local today = data.DailyAvailable and day == nextDay
		local cell = UI.new("Frame", {
			LayoutOrder = day,
			Size = UDim2.new(1 / #Shop.DailyRewards, -6, 1, 0), -- (se reparten el ancho: caben en el móvil)
			BackgroundColor3 = claimed and Color3.fromRGB(40, 110, 60) or (today and Color3.fromRGB(110, 90, 20) or Color3.fromRGB(30, 40, 30)),
			Parent = strip,
		}, { UI.corner(8), UI.stroke(today and GOLD or Color3.fromRGB(80, 120, 80), today and 3 or 1, 0) })
		-- (texto que llena la celda: en el móvil el menú se encoge y a tamaño fijo no se leía)
		UI.label({
			Size = UDim2.new(1, -6, 0.45, 0),
			Position = UDim2.new(0, 3, 0, 2),
			Text = claimed and "✓" or ("Día " .. day),
			TextScaled = true,
			Parent = cell,
		}, { UI.new("UITextSizeConstraint", { MaxTextSize = 20 }) })
		UI.label({
			Size = UDim2.new(1, -6, 0.48, 0),
			Position = UDim2.new(0, 3, 0.5, 0),
			Text = (day == Shop.DailyCrateDay and "🎁" or "💰") .. coins,
			TextScaled = true,
			TextColor3 = GOLD,
			Parent = cell,
		}, { UI.new("UITextSizeConstraint", { MaxTextSize = 20 }) })
		if today then
			-- (el de hoy late)
			local pulse = UI.new("UIScale", { Parent = cell })
			local beat = TweenService:Create(pulse, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.08 })
			beat:Play()
			cell.Destroying:Connect(function()
				beat:Cancel() -- (el latido es infinito: se para al rehacer la página)
			end)
		end
	end

	-- Ofertas del día
	sectionTitle(scroll, "🔥 Ofertas de hoy (-" .. math.floor(Shop.OfferDiscount * 100) .. "%)", 2)
	local offers = row(scroll, 3, 190)
	for i, offer in Shop.GetDailyOffers(data.Day) do
		local name, rarity = itemName(offer.Kind, offer.Id)
		local owned
		if offer.Kind == "Skin" then
			owned = data.Skins[offer.Id] == true
		elseif offer.Kind == "KillEffect" then
			owned = data.KillEffects ~= nil and data.KillEffects[offer.Id] == true
		else
			owned = data.Outfits[offer.Id] == true
		end
		local card = UI.new("Frame", { LayoutOrder = i, Size = UDim2.fromOffset(200, 190), BackgroundColor3 = CARD_BG, Parent = offers }, {
			UI.corner(12),
			UI.stroke(rarityColor(rarity), 2, 0),
		})
		if offer.Kind == "Skin" then
			WeaponIcon.Create(data.Primary or "ARX27", offer.Id, { Position = UDim2.fromOffset(8, 6), Size = UDim2.fromOffset(184, 80), Parent = card }, "angled", 184 / 80)
		elseif offer.Kind == "KillEffect" then
			local icon = UI.button({
				Position = UDim2.fromOffset(50, 6),
				Size = UDim2.fromOffset(100, 80),
				Text = KillEffects.Get(offer.Id).Icon,
				TextSize = 56,
				BackgroundTransparency = 1,
				Parent = card,
			})
			icon.Activated:Connect(function()
				previewKillEffect(offer.Id)
			end)
		else
			outfitViewport(offer.Id, { Position = UDim2.fromOffset(50, 2), Size = UDim2.fromOffset(100, 90), Parent = card })
		end
		UI.label({ Position = UDim2.fromOffset(0, 92), Size = UDim2.new(1, 0, 0, 24), Text = name, TextSize = 19, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 116),
			Size = UDim2.new(1, 0, 0, 18),
			Text = (offer.Kind == "Outfit" and "Traje · " or offer.Kind == "KillEffect" and "Efecto · " or "Skin · ") .. rarity,
			TextSize = 14,
			TextColor3 = rarityColor(rarity),
			Parent = card,
		})
		priceButton(card, offer.Kind, offer.Id, owned, false, function()
			Sounds.Play("Click")
			if offer.Kind == "Skin" then
				Remotes.EquipSkin:FireServer(offer.Id)
			elseif offer.Kind == "KillEffect" then
				Remotes.EquipKillEffect:FireServer(offer.Id)
			else
				Remotes.EquipOutfit:FireServer(offer.Id)
			end
		end)
	end

	-- Cajas
	sectionTitle(scroll, "🎁 Cajas", 4)
	local crates = row(scroll, 5, 150)
	for crateId, crate in Shop.Crates do
		local card = UI.new("Frame", { Size = UDim2.fromOffset(480, 150), BackgroundColor3 = Color3.fromRGB(50, 30, 80), Parent = crates }, {
			UI.corner(12),
			UI.stroke(Color3.fromRGB(190, 80, 255), 2, 0),
			UI.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(140, 100, 255)), Rotation = 30 }),
		})
		UI.label({
			Position = UDim2.fromOffset(16, 8),
			Size = UDim2.fromOffset(300, 30),
			Text = "🎁 " .. crate.Name,
			TextSize = 26,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		local oddsText = {}
		for _, entry in crate.Odds do
			table.insert(oddsText, entry.Rarity .. " " .. entry.Weight .. "%")
		end
		UI.label({
			Position = UDim2.fromOffset(16, 40),
			Size = UDim2.fromOffset(450, 36),
			Text = "Probabilidades: "
				.. table.concat(oddsText, " · ")
				.. "\nSkins y trajes. Si repites, recuperas el "
				.. math.floor(crate.DuplicateRefund * 100)
				.. "%.",
			TextSize = 14,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = UI.FontBody,
			TextStrokeTransparency = 1,
			Parent = card,
		})
		local buyCrate = UI.button({
			Position = UDim2.fromOffset(16, 90),
			Size = UDim2.fromOffset(210, 46),
			Text = data.CratesRestricted and "No disponible" or ("Abrir · " .. coinsText(crate.Price)),
			BackgroundColor3 = data.CratesRestricted and GREY or Color3.fromRGB(230, 140, 20),
			Parent = card,
		}, { UI.gloss() })
		buyCrate.Activated:Connect(function()
			if not data.CratesRestricted and MonetizationConfig.Rules.CoinCrates then
				openCrate(crateId, false)
			end
		end)
		-- (con monedas ya no: las cajas solo se ganan jugando)
		buyCrate.Visible = MonetizationConfig.Rules.CoinCrates
		local free = UI.button({
			Position = UDim2.fromOffset(240, 90),
			Size = UDim2.fromOffset(220, 46),
			Text = "Gratis (" .. tostring(data.FreeCrates or 0) .. ")",
			BackgroundColor3 = (data.FreeCrates or 0) > 0 and GREEN or GREY,
			Parent = card,
		}, { UI.gloss() })
		free.Activated:Connect(function()
			if (data.FreeCrates or 0) > 0 then
				openCrate(crateId, true)
			end
		end)
	end

	-- Monedas con Robux
	coinsSection = sectionTitle(scroll, "💰 Monedas", 6)
	local packs = row(scroll, 7, 170)
	for i, pack in Shop.CoinPacks do
		local card = UI.new("Frame", { LayoutOrder = i, Size = UDim2.fromOffset(200, 170), BackgroundColor3 = Color3.fromRGB(60, 50, 20), Parent = packs }, {
			UI.corner(12),
			UI.stroke(GOLD, 2, 0),
			UI.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 160, 60)), Rotation = 90 }),
		})
		UI.label({ Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 44), Text = string.rep("💰", math.min(i + 1, 4)), TextSize = 30, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 56), Size = UDim2.new(1, 0, 0, 30), Text = tostring(pack.Coins), TextSize = 30, TextColor3 = GOLD, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 86), Size = UDim2.new(1, 0, 0, 20), Text = pack.Name, TextSize = 16, Parent = card })
		if pack.Tag then
			UI.label({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -6, 0, 4),
				Size = UDim2.fromOffset(120, 18),
				Text = pack.Tag,
				TextSize = 13,
				TextColor3 = Color3.fromRGB(120, 255, 140),
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = card,
			})
		end
		local buyPack = UI.button({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.new(1, -20, 0, 40),
			Text = pack.ProductId ~= 0 and ("R$ " .. pack.Robux) or "Próximamente",
			BackgroundColor3 = pack.ProductId ~= 0 and GREEN or GREY,
			Parent = card,
		}, { UI.gloss() })
		buyPack.Activated:Connect(function()
			if pack.ProductId ~= 0 then
				MarketplaceService:PromptProductPurchase(player, pack.ProductId)
			end
		end)
	end

	-- Revivir instantáneo con Robux: ya no se vende (ventaja en combate; MonetizationConfig.Rules)
	if MonetizationConfig.Rules.SellRevives then
	-- Revivir instantáneo con Robux (vuelves a la acción justo donde caíste)
		local PINK_REVIVE = Color3.fromRGB(255, 70, 200)
		sectionTitle(scroll, "💖 Revivir instantáneo", 8)
		local revives = row(scroll, 9, 150)
		for i, pack in Shop.RevivePacks do
			local card = UI.new("Frame", { LayoutOrder = i, Size = UDim2.fromOffset(200, 150), BackgroundColor3 = Color3.fromRGB(70, 20, 60), Parent = revives }, {
				UI.corner(12),
				UI.stroke(PINK_REVIVE, 2, 0),
				UI.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 80, 170)), Rotation = 90 }),
			})
			UI.label({ Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 40), Text = string.rep("💖", i + 1), TextSize = 28, Parent = card })
			UI.label({ Position = UDim2.fromOffset(0, 48), Size = UDim2.new(1, 0, 0, 30), Text = "x" .. pack.Revives, TextSize = 30, TextColor3 = Color3.fromRGB(255, 200, 240), Parent = card })
			if pack.Tag then
				UI.label({ Position = UDim2.fromOffset(0, 78), Size = UDim2.new(1, 0, 0, 18), Text = pack.Tag, TextSize = 13, TextColor3 = Color3.fromRGB(120, 255, 140), Parent = card })
			end
			local buyRevive = UI.button({
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, 0, 1, -8),
				Size = UDim2.new(1, -20, 0, 40),
				Text = pack.ProductId ~= 0 and ("R$ " .. pack.Robux) or "Próximamente",
				BackgroundColor3 = pack.ProductId ~= 0 and GREEN or GREY,
				Parent = card,
			}, { UI.gloss() })
			buyRevive.Activated:Connect(function()
				if pack.ProductId ~= 0 then
					MarketplaceService:PromptProductPurchase(player, pack.ProductId)
				end
			end)
		end
	
	end

	-- VIP
	local vip = UI.new("Frame", {
		LayoutOrder = 10,
		Size = UDim2.new(1, -10, 0, 90),
		BackgroundColor3 = Color3.fromRGB(70, 50, 10),
		Parent = scroll,
	}, {
		UI.corner(12),
		UI.stroke(GOLD, 3, 0),
		UI.new("UIGradient", { Color = ColorSequence.new(GOLD, Color3.fromRGB(120, 60, 200)), Rotation = 0 }),
	})
	UI.label({
		Position = UDim2.fromOffset(16, 6),
		Size = UDim2.new(1, -280, 0, 34),
		Text = "👑 VIP",
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = vip,
	})
	UI.label({
		Position = UDim2.fromOffset(16, 42),
		Size = UDim2.new(1, -280, 0, 40),
		Text = "x2 XP · x2 monedas · +" .. (MonetizationConfig.Rules.VIPDailyCoins or 0) .. " 💰 cada día · grafiti 👑 exclusivo",
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = vip,
	})
	local vipText = "Próximamente"
	if data.VIP then
		vipText = "✔ Ya eres VIP"
	elseif Shop.VIPPassId ~= 0 then
		vipText = "Hazte VIP · R$ " .. Shop.VIPRobux
	end
	local vipButton = UI.button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(240, 52),
		Text = vipText,
		BackgroundColor3 = data.VIP and GREEN or (Shop.VIPPassId ~= 0 and GOLD or GREY),
		TextColor3 = Color3.fromRGB(30, 20, 0),
		Parent = vip,
	}, { UI.gloss() })
	vipButton.Activated:Connect(function()
		if not data.VIP and Shop.VIPPassId ~= 0 then
			MarketplaceService:PromptGamePassPurchase(player, Shop.VIPPassId)
		end
	end)

	-- Potenciadores con Robux (su tiempo solo corre jugando)
	sectionTitle(scroll, "⚡ Potenciadores (el tiempo solo corre mientras juegas)", 12)
	local boosters = row(scroll, 13, 150)
	local BOOST_BLUE = Color3.fromRGB(70, 170, 255)
	for i, booster in Shop.Boosters do
		local left = tonumber(data[booster.Field]) or 0
		local card = UI.new("Frame", { LayoutOrder = i, Size = UDim2.fromOffset(220, 150), BackgroundColor3 = Color3.fromRGB(20, 40, 70), Parent = boosters }, {
			UI.corner(12),
			UI.stroke(left > 0 and GREEN or BOOST_BLUE, 2, 0),
			UI.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(90, 150, 230)), Rotation = 90 }),
		})
		UI.label({ Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 36), Text = booster.Icon .. " x" .. booster.Multiplier, TextSize = 28, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 0, 22), Text = booster.Name .. " · " .. booster.Minutes .. " min", TextSize = 17, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 68),
			Size = UDim2.new(1, 0, 0, 18),
			Text = left > 0 and ("✔ Activo: quedan " .. math.ceil(left / 60) .. " min") or "Se acumula si compras más",
			TextSize = 13,
			Font = UI.FontBody,
			TextColor3 = left > 0 and Color3.fromRGB(120, 255, 140) or Color3.fromRGB(190, 200, 230),
			Parent = card,
		})
		local buyBoost = UI.button({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.new(1, -20, 0, 40),
			Text = booster.ProductId ~= 0 and ("R$ " .. booster.Robux) or "Próximamente",
			BackgroundColor3 = booster.ProductId ~= 0 and GREEN or GREY,
			Parent = card,
		}, { UI.gloss() })
		buyBoost.Activated:Connect(function()
			if booster.ProductId ~= 0 then
				MarketplaceService:PromptProductPurchase(player, booster.ProductId)
			end
		end)
	end

	-- Roblox Premium (bonus pequeño; la suscripción la cobra Roblox)
	local premiumConfig = GameConfig.RobloxPremium
	if premiumConfig then
		local isPremium = player:GetAttribute("RobloxPremium") == true
		local premiumCard = UI.new("Frame", {
			LayoutOrder = 11,
			Size = UDim2.new(1, -10, 0, 70),
			BackgroundColor3 = Color3.fromRGB(30, 34, 56),
			Parent = scroll,
		}, { UI.corner(12), UI.stroke(Color3.fromRGB(150, 160, 200), 2, 0) })
		UI.label({
			Position = UDim2.fromOffset(16, 4),
			Size = UDim2.new(1, -280, 0, 32),
			Text = utf8.char(0xE001) .. " Roblox Premium", -- (icono oficial de Premium)
			TextSize = 24,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = premiumCard,
		})
		UI.label({
			Position = UDim2.fromOffset(16, 36),
			Size = UDim2.new(1, -280, 0, 26),
			Text = "+" .. math.floor((premiumConfig.Multiplier - 1) * 100 + 0.5) .. "% monedas y XP en cada partida (también con VIP)",
			TextSize = 16,
			Font = UI.FontBody,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = premiumCard,
		})
		local premiumButton = UI.button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -16, 0.5, 0),
			Size = UDim2.fromOffset(240, 44),
			Text = isPremium and "✔ Bonus activo" or "Hazte Premium",
			BackgroundColor3 = isPremium and GREEN or Color3.fromRGB(150, 160, 200),
			TextColor3 = Color3.fromRGB(20, 20, 30),
			Parent = premiumCard,
		}, { UI.gloss() })
		premiumButton.Activated:Connect(function()
			if not isPremium then
				pcall(function()
					MarketplaceService:PromptPremiumPurchase(player)
				end)
			end
		end)
	end
end

---------------------------------------------------------------------------

local lastBuiltTab = nil

function refresh()
	if not content then
		return
	end
	-- Si se reconstruye la misma pestaña, se mantiene la posición del scroll
	local keepScroll = nil
	if lastBuiltTab == currentTab then
		local old = content:FindFirstChildOfClass("ScrollingFrame")
		keepScroll = old and old.CanvasPosition
	end
	lastBuiltTab = currentTab
	for _, child in content:GetChildren() do
		child:Destroy()
	end
	local data = ClientState.Data
	if headerInfo then
		headerInfo.Text = data and ("Nivel " .. data.Level .. "   " .. coinsText(data.Coins) .. (data.VIP and "   👑" or "")) or "Cargando..."
	end
	for name, button in tabButtons do
		button.BackgroundColor3 = name == currentTab and BLUE or CARD_BG
	end
	-- Aviso en Perfil si hay logros por reclamar
	if tabButtons.Perfil and data then
		local claimable = claimableAchievements(data)
		tabButtons.Perfil.Text = claimable > 0 and ("Perfil 🔴" .. claimable) or "Perfil"
	end
	-- Y en Tienda si hay algo gratis esperando (premio diario o cajas gratis): da ganas de entrar
	if tabButtons.Tienda and data then
		local free = (data.DailyAvailable and 1 or 0) + (data.FreeCrates or 0)
		tabButtons.Tienda.Text = free > 0 and ("🛒 Tienda 🔴" .. free) or "🛒 Tienda"
	end
	if not data then
		scrollToCoins = false
		UI.label({ Size = UDim2.fromScale(1, 1), Text = "Cargando datos...", TextSize = 24, Parent = content })
		return
	end
	if currentTab == "Perfil" then
		buildProfilePage(data)
	elseif currentTab == "Pase" then
		buildPassPage(data)
	elseif currentTab == "Retos" then
		buildChallengesPage(data)
	elseif currentTab == "Armas" then
		buildWeaponsPage(data)
	elseif currentTab == "Skins" then
		buildSkinsPage(data)
	elseif currentTab == "Trajes" then
		buildOutfitsPage(data)
	elseif currentTab == "Efectos" then
		buildKillEffectsPage(data)
	elseif currentTab == "Ajustes" then
		buildSettingsPage()
	else
		buildShopPage(data)
	end
	if keepScroll then
		local scroll = content:FindFirstChildOfClass("ScrollingFrame")
		if scroll then
			task.defer(function()
				scroll.CanvasPosition = keepScroll
			end)
		end
	elseif scrollToCoins and currentTab == "Tienda" then
		scrollToCoins = false
		local scroll = content:FindFirstChildOfClass("ScrollingFrame")
		local title = coinsSection
		if scroll and title then
			task.delay(0.05, function() -- (cuando la lista ya ha colocado las tarjetas)
				if title.Parent then
					local scale = panelScale and panelScale.Scale or 1
					local y = (title.AbsolutePosition.Y - scroll.AbsolutePosition.Y) / math.max(scale, 0.1) + scroll.CanvasPosition.Y - 8
					scroll.CanvasPosition = Vector2.new(0, math.max(0, y))
				end
			end)
		end
	end
end

local menuModal -- botón Modal a nivel de pantalla: libera el ratón aunque el panel esté oculto

local function setOpen(open)
	if not open and crateOverlay then
		return -- no se cierra a mitad de abrir una caja
	end
	ClientState.MenuOpen = open
	if not open then
		ClientState.MenuClosedAt = os.clock()
	end
	panel.Visible = open
	if menuModal then
		menuModal.Visible = open
	end
	ClientState.UpdateMouse()
	if open then
		refresh()
	end
end

function Menu.Toggle()
	-- Durante la vista previa de un efecto el panel está oculto pero el menú sigue abierto
	setOpen(not ClientState.MenuOpen)
end

-- Abre el menú directamente en una pestaña
-- (la tienda y el pase del lobby se abren en sus pantallas del flujo: lo pone Flow/Screens/Store)
Menu.Redirect = nil :: ((string?) -> boolean)?

function Menu.Open(tab)
	if Menu.Redirect and Menu.Redirect(tab) then
		return
	end
	if tab then
		currentTab = tab
	end
	setOpen(true)
end

function Menu.Close()
	if ClientState.MenuOpen then
		setOpen(false)
	end
end

function Menu.IsOpen()
	return panel ~= nil and ClientState.MenuOpen
end

-- Recoge la recompensa diaria (también se usa desde la pantalla de inicio)
function Menu.ClaimDaily()
	if busy then
		return false
	end
	busy = true
	local ok, success, result = pcall(function()
		return Remotes.ClaimDaily:InvokeServer()
	end)
	busy = false
	if ok and success and type(result) == "table" then
		Sounds.Play("Kill")
		showToast("Día " .. result.Streak .. ": +" .. result.Coins .. " monedas" .. (result.Crate and " y una caja gratis 🎁" or ""), GOLD)
		RewardFX.Celebrate("🎁 ¡DÍA " .. tostring(result.Streak) .. "!", "+" .. tostring(result.Coins) .. " 💰" .. (result.Crate and "  y una caja gratis" or "") .. "  ·  ¡Vuelve mañana!", GOLD, result.Crate == true)
		return true
	end
	showToast("Ya la has recogido hoy. ¡Vuelve mañana!")
	return false
end

function Menu.Init()
	gui = UI.new("ScreenGui", {
		Name = "Menu",
		ResetOnSpawn = false,
		DisplayOrder = 5,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})

	-- Botón superior (útil en móvil)
	-- (en el teléfono, pequeño: debajo del minimapa y sin tapar nada)
	UI.WaitViewport()
	local phone = UI.IsPhone()
	local open = UI.button({
		Position = UDim2.fromOffset(16, 58),
		Size = phone and UDim2.fromOffset(96, 28) or UDim2.fromOffset(210, 38),
		Text = phone and "⭐ TIENDA" or "⭐ PASE · TIENDA",
		BackgroundColor3 = Color3.fromRGB(255, 120, 30),
		TextSize = phone and 14 or 18,
		Parent = gui,
	}, { UI.stroke(Color3.new(0, 0, 0), 2, 0.3), UI.gloss() })
	open.Activated:Connect(Menu.Toggle)
	TouchLayout.BindButton("Menu", function(_, state)
		if state == Enum.UserInputState.Begin then
			Menu.Toggle()
		end
	end)
	-- En la pantalla de inicio no hace falta (ya tiene su botón TIENDA) y taparía el título
	task.spawn(function()
		while open.Parent do
			-- Debajo del minimapa durante la partida
			local playing = game:GetService("ReplicatedStorage"):GetAttribute("State") == "Playing"
			-- (en PC, mientras luchas no se ve: HUD limpio; está la tecla B. En el móvil sí, que no hay teclas)
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local fighting = playing and humanoid ~= nil and humanoid.Health > 0 and not ClientState.Dead
			-- (cualquier pantalla solo táctil, también tablets: sin teclas no hay otra forma de abrirlo)
			-- (pantallas táctiles, Fase 12: durante la partida no se ve; el menú se abre con el engranaje
			-- de arriba a la derecha, con los demás botones táctiles)
			local UIS = game:GetService("UserInputService")
			local touchUI = UIS.TouchEnabled
			open.Visible = not ClientState.InMainMenu and (if touchUI then not playing else not fighting)
			open.Position = UDim2.fromOffset(phone and 14 or 16, (playing and ClientState.MinimapBottom) and ClientState.MinimapBottom + (phone and 6 or 8) or 58)
			task.wait(0.25)
		end
	end)

	panel = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.new(0.92, 0, 0.84, 0),
		BackgroundColor3 = PANEL_BG,
		Active = true, -- los clics y toques no atraviesan el panel
		Visible = false,
		Parent = gui,
	}, {
		UI.corner(16),
		UI.stroke(Color3.fromRGB(255, 140, 40), 3, 0),
		UI.padding(16),
		UI.new("UISizeConstraint", { MaxSize = Vector2.new(1100, 640) }),
		UI.new("UIGradient", {
			Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 120, 200)),
			Rotation = 120,
		}),
	})

	-- Botón "Modal": libera el ratón en primera persona mientras el menú está abierto
	menuModal = UI.new("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true, Visible = false, Parent = gui })

	-- En pantallas pequeñas (móviles) todo el panel se escala para que quepa entero
	panelScale = UI.new("UIScale", { Parent = panel })
	local function rescalePanel()
		local viewport = workspace.CurrentCamera.ViewportSize
		local s = math.clamp(math.min(viewport.X / 1150, viewport.Y / 700), 0.5, 1)
		panelScale.Scale = s
		panel.Size = UDim2.fromScale(math.min(0.92 / s, 1 / s), math.min(0.84 / s, 0.95 / s))
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescalePanel)
	rescalePanel()

	UI.label({
		Size = UDim2.fromOffset(400, 36),
		Text = "⚡ " .. GameConfig.GameTitle,
		TextSize = 32,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(255, 170, 50),
		Parent = panel,
	})
	headerInfo = UI.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -50, 0, 0),
		Size = UDim2.fromOffset(360, 36),
		Text = "",
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = panel,
	})
	local close = UI.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(36, 36),
		Text = "✕",
		BackgroundColor3 = Color3.fromRGB(220, 60, 60),
		Parent = panel,
	})
	close.Activated:Connect(function()
		setOpen(false)
	end)

	-- Barra de pestañas con desplazamiento horizontal (en pantallas estrechas no caben todas)
	local tabs = UI.new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 0, 42),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 3,
		Parent = panel,
	}, {
		UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i, name in TABS do
		local button = UI.button({
			LayoutOrder = i,
			Size = UDim2.fromOffset(name == "Ajustes" and 52 or 112, 38),
			Text = name == "Tienda" and "🛒 Tienda" or name == "Retos" and "🎯 Retos" or name == "Efectos" and "💥 Efectos" or name == "Ajustes" and "⚙" or name,
			BackgroundColor3 = CARD_BG,
			Parent = tabs,
		})
		button.Activated:Connect(function()
			currentTab = name
			Sounds.Play("Click")
			refresh()
		end)
		tabButtons[name] = button
	end

	content = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 96),
		Size = UDim2.new(1, 0, 1, -96),
		BackgroundTransparency = 1,
		Parent = panel,
	})

	toast = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -20),
		Size = UDim2.fromOffset(700, 36),
		Text = "",
		TextSize = 24,
		TextStrokeTransparency = 0,
		Visible = false,
		ZIndex = 40,
		Parent = gui,
	})

	ContextActionService:BindAction("Menu", function(_, state)
		-- Muerto, la B es "Revivir instantáneo" (pantalla de muerte); solo sirve para cerrar la tienda
		-- (con la ruleta, las novedades o la tarjeta de controles abiertas no se abre la tienda detrás)
		local covered = ClientState.WheelOpen or ClientState.NewsOpen or ClientState.TutorialOpen
		if state == Enum.UserInputState.Begin and (not ClientState.Dead or ClientState.MenuOpen) and not (covered and not ClientState.MenuOpen) then
			Menu.Toggle()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.B, Enum.KeyCode.ButtonSelect)

	-- Si se cancela la compra del pack de inicio, el botón vuelve a estar disponible
	MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, purchased)
		local single = productId == Shop.StarterPack.ProductId
		for _, bundle in Shop.Bundles do
			single = single or productId == bundle.ProductId
		end
		if userId == player.UserId and single and not purchased and ClientState.MenuOpen then
			refresh()
		end
	end)

	-- Una baja puede mandar varias actualizaciones seguidas: se agrupan en una sola reconstrucción
	local refreshQueued = false
	ClientState.DataChanged.Event:Connect(function()
		if not panel.Visible or refreshQueued then
			return
		end
		refreshQueued = true
		task.delay(0.4, function()
			refreshQueued = false
			if panel.Visible then
				refresh()
			end
		end)
	end)
end

return Menu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="220">
            <Properties>
              <string name="Name">Minimap</string>
              <string name="Source"><![CDATA[-- Minimapa (arriba a la izquierda, como en los shooters de móvil): el mapa visto desde arriba con
-- los edificios y muros, tú en el centro (la flecha mira hacia donde miras), tus compañeros en azul,
-- los enemigos que disparan sin silenciador como puntos rojos durante unos segundos y, con el
-- Radar de la racha, todos los enemigos. También la zona de control y las banderas.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Teams = game:GetService("Teams")
local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Weapons = require(Shared.Weapons)
local GameConfig = require(Shared.GameConfig)

local UI = require(script.Parent.UI)
local ClientState = require(script.Parent.ClientState)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Minimap = {}

local RANGE = 170 -- studs que caben a lo ancho
local RED_DOT_TIME = 2.5 -- segundos que se ve el punto rojo de un disparo
local MAX_SHAPES = 900

local gui, frame, world, me
local border, enemyRadarLabel
local lastEnemyRadar, nextRadarCheck = false, 0
local size, scale = 160, 160 / RANGE
local shapesFolder
local builtFor = nil
local shots = {} -- [modelo] = { Position, Time }
local dots = {} -- círculos reutilizables
local usedDots = 0

-- ¿Está en el equipo contrario? (en todos contra todos, todos lo están)
local function isEnemy(model)
	if not ReplicatedStorage:GetAttribute("TeamMode") then
		return model ~= player.Character
	end
	local owner = Players:GetPlayerFromCharacter(model)
	local team = owner and owner.Team and owner.Team.Name or model:GetAttribute("Team")
	return team ~= nil and team ~= "" and player.Team ~= nil and team ~= player.Team.Name
end

local function isTeammate(model)
	if not ReplicatedStorage:GetAttribute("TeamMode") or model == player.Character then
		return false
	end
	local owner = Players:GetPlayerFromCharacter(model)
	local team = owner and owner.Team and owner.Team.Name or model:GetAttribute("Team")
	return player.Team ~= nil and team == player.Team.Name
end

---------------------------------------------------------------------------
-- Plano del mapa (se rehace al cambiar de mapa)
---------------------------------------------------------------------------

local function rebuild()
	local map = workspace:FindFirstChild("Map")
	builtFor = map
	if shapesFolder then
		shapesFolder:Destroy()
	end
	shapesFolder = UI.new("Folder", { Name = "Shapes", Parent = world })
	if not map then
		return
	end
	local boundary = map:FindFirstChild("Boundary")
	local count = 0
	for _, part in map:GetDescendants() do
		if count >= MAX_SHAPES then
			break
		end
		if part:IsA("BasePart") and part.CanCollide and part.Transparency < 0.9 and not (boundary and part:IsDescendantOf(boundary)) then
			local cf = part.CFrame
			local s = part.Size
			-- Solo lo que es "de pie" (muros, edificios, coberturas): no suelos ni piezas inclinadas
			if cf.UpVector.Y > 0.95 and s.Y >= 2.5 and s.X * s.Z >= 6 and cf.Position.Y + s.Y / 2 > 2.5 and part.Shape ~= Enum.PartType.Ball then
				count += 1
				local right = cf.RightVector
				local tall = s.Y >= 6
				UI.new("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromOffset(cf.Position.X * scale, cf.Position.Z * scale),
					Size = UDim2.fromOffset(math.max(1, s.X * scale), math.max(1, s.Z * scale)),
					Rotation = math.deg(math.atan2(right.Z, right.X)),
					BackgroundColor3 = tall and Color3.fromRGB(205, 205, 210) or Color3.fromRGB(150, 150, 158),
					BackgroundTransparency = tall and 0.25 or 0.4,
					BorderSizePixel = 0,
					Parent = shapesFolder,
				})
			end
		end
	end
end

---------------------------------------------------------------------------
-- Puntos
---------------------------------------------------------------------------

local function dot(position, color, radius, square)
	usedDots += 1
	local d = dots[usedDots]
	if not d then
		d = UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			BorderSizePixel = 0,
			ZIndex = 3,
			Parent = frame,
		}, { UI.new("UICorner", { CornerRadius = UDim.new(1, 0) }), UI.stroke(Color3.new(0, 0, 0), 1, 0.3) })
		dots[usedDots] = d
	end
	local corner = d:FindFirstChildOfClass("UICorner")
	if corner then
		corner.CornerRadius = square and UDim.new(0, 2) or UDim.new(1, 0)
	end
	d.Visible = true
	d.BackgroundTransparency = 0
	local letter = d:FindFirstChild("Letter")
	if letter then
		letter.Text = ""
	end
	d.BackgroundColor3 = color
	d.Size = UDim2.fromOffset(radius * 2, radius * 2)
	d.Position = UDim2.new(0.5, position.X, 0.5, position.Y)
	return d
end

-- Posición en el minimapa (respecto al centro) de un punto del mundo; nil si se sale
local function toMap(worldPosition, center)
	local offset = Vector2.new(worldPosition.X - center.X, worldPosition.Z - center.Z) * scale
	local half = size / 2 - 4
	if math.abs(offset.X) > half or math.abs(offset.Y) > half then
		-- (los objetivos se quedan pegados al borde para saber hacia dónde están)
		return nil, Vector2.new(math.clamp(offset.X, -half, half), math.clamp(offset.Y, -half, half))
	end
	return offset
end

local function update()
	local visible = not ClientState.InMainMenu and ReplicatedStorage:GetAttribute("State") == "Playing"
	gui.Enabled = visible
	if not visible then
		return
	end
	local map = workspace:FindFirstChild("Map")
	if map ~= builtFor then
		rebuild()
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local center = root and root.Position or camera.CFrame.Position
	world.Position = UDim2.new(0.5, -center.X * scale, 0.5, -center.Z * scale)
	local look = camera.CFrame.LookVector
	me.Rotation = math.deg(math.atan2(look.X, -look.Z))

	usedDots = 0
	local now = os.clock()
	-- Compañeros (jugadores y bots)
	local radar = workspace:GetServerTimeNow() < (player:GetAttribute("RadarUntil") or 0)
	-- Radar enemigo: borde rojo y aviso mientras otro equipo lo tenga (se mira 3 veces por segundo)
	local enemyRadar = lastEnemyRadar
	if now >= nextRadarCheck then
		nextRadarCheck = now + 0.3
		enemyRadar = false
		if ReplicatedStorage:GetAttribute("TeamMode") ~= false and player.Team then
			local serverNow = workspace:GetServerTimeNow()
			for name, value in ReplicatedStorage:GetAttributes() do
				if string.sub(name, 1, 6) == "Radar_" and name ~= "Radar_" .. player.Team.Name and type(value) == "number" and value > serverNow then
					enemyRadar = true
					break
				end
			end
		end
	end
	if enemyRadar ~= lastEnemyRadar then
		lastEnemyRadar = enemyRadar
		if border then
			border.Color = enemyRadar and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(230, 230, 235)
			border.Transparency = enemyRadar and 0 or 0.35
		end
		enemyRadarLabel.Visible = enemyRadar
	end
	local models = {}
	for _, other in Players:GetPlayers() do
		if other ~= player and other.Character then
			table.insert(models, other.Character)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			table.insert(models, model)
		end
	end
	for _, model in models do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local part = model:FindFirstChild("HumanoidRootPart")
		if humanoid and humanoid.Health > 0 and part then
			if isTeammate(model) then
				local p = toMap(part.Position, center)
				if p then
					dot(p, Color3.fromRGB(70, 160, 255), 4)
				end
			elseif radar and isEnemy(model) then
				local p = toMap(part.Position, center)
				if p then
					dot(p, Color3.fromRGB(255, 50, 50), 4)
				end
			end
		end
	end
	-- Disparos enemigos recientes (puntos rojos donde dispararon)
	for model, shot in shots do
		if now - shot.Time > RED_DOT_TIME or not model.Parent then
			shots[model] = nil
		else
			local p = toMap(shot.Position, center)
			if p then
				local d = dot(p, Color3.fromRGB(255, 40, 40), 4.5)
				d.BackgroundTransparency = math.clamp((now - shot.Time) / RED_DOT_TIME, 0, 0.7)
			end
		end
	end
	-- Objetivos: zona de control y banderas (pegados al borde si están lejos)
	local zone = ReplicatedStorage:GetAttribute("ZonePosition")
	if typeof(zone) == "Vector3" then
		local p, edge = toMap(zone, center)
		dot(p or edge, Color3.fromRGB(255, 210, 40), 6, true)
	end
	-- Dominio: las tres banderas con su letra y el color de su dueño
	for _, letter in { "A", "B", "C" } do
		local position = ReplicatedStorage:GetAttribute("Dom_" .. letter .. "_Position")
		if typeof(position) == "Vector3" then
			local p, edge = toMap(position, center)
			local owner = Teams:FindFirstChild(ReplicatedStorage:GetAttribute("Dom_" .. letter .. "_Owner") or "")
			local d = dot(p or edge, owner and owner:IsA("Team") and owner.TeamColor.Color or Color3.fromRGB(230, 230, 235), 7, true)
			local label = d:FindFirstChild("Letter") or UI.label({
				Name = "Letter",
				Size = UDim2.fromScale(1, 1),
				TextSize = 11,
				TextStrokeTransparency = 1,
				TextColor3 = Color3.new(0, 0, 0),
				Parent = d,
			})
			label.Text = letter
		end
	end
	-- Buscar y destruir: los sitios de la bomba (en rojo el de la bomba plantada)
	for _, letter in { "A", "B" } do
		local position = ReplicatedStorage:GetAttribute("Bomb_" .. letter .. "_Position")
		if typeof(position) == "Vector3" then
			local p, edge = toMap(position, center)
			local planted = ReplicatedStorage:GetAttribute("Bomb_State") == "Planted" and ReplicatedStorage:GetAttribute("Bomb_Site") == letter
			local d = dot(p or edge, planted and Color3.fromRGB(255, 60, 50) or Color3.fromRGB(255, 190, 60), 7, true)
			local label = d:FindFirstChild("Letter") or UI.label({
				Name = "Letter",
				Size = UDim2.fromScale(1, 1),
				TextSize = 11,
				TextStrokeTransparency = 1,
				TextColor3 = Color3.new(0, 0, 0),
				Parent = d,
			})
			label.Text = letter
		end
	end
	-- La bomba en el suelo (solo la ven los atacantes, que son quienes la pueden recoger)
	local dropped = ReplicatedStorage:GetAttribute("Bomb_Dropped")
	if typeof(dropped) == "Vector3" and player.Team and player.Team.Name == ReplicatedStorage:GetAttribute("Bomb_Attackers") then
		local p, edge = toMap(dropped, center)
		local d = dot(p or edge, Color3.fromRGB(255, 120, 30), 6, true)
		local label = d:FindFirstChild("Letter") or UI.label({
			Name = "Letter",
			Size = UDim2.fromScale(1, 1),
			TextSize = 11,
			TextStrokeTransparency = 1,
			TextColor3 = Color3.new(0, 0, 0),
			Parent = d,
		})
		label.Text = "💣"
	end
	for _, team in GameConfig.Teams do
		local flag = ReplicatedStorage:GetAttribute("FlagPos_" .. team.Name)
		if typeof(flag) == "Vector3" then
			local p, edge = toMap(flag, center)
			dot(p or edge, team.Color.Color, 5, true)
		end
	end
	for i = usedDots + 1, #dots do
		dots[i].Visible = false
	end
end

Minimap.Update = update

-- Disparo de otro jugador o bot (los mismos avisos que dibujan sus trazadoras)
local function onShot(tool)
	if typeof(tool) ~= "Instance" or not tool.Parent then
		return
	end
	local model = tool.Parent
	local def = Weapons.Get(tool:GetAttribute("Weapon"))
	if def and def.Suppressed then
		return -- con silenciador no sale en el minimapa
	end
	local owner = Players:GetPlayerFromCharacter(model)
	if owner and owner:GetAttribute("Perk") == 3 then
		return -- (ventaja "Fantasma")
	end
	local part = model:FindFirstChild("HumanoidRootPart") or tool:FindFirstChild("Handle")
	if part and part:IsA("BasePart") and isEnemy(model) then
		shots[model] = { Position = part.Position, Time = os.clock() }
	end
end

function Minimap.Init()
	-- (se espera a saber el tamaño de la pantalla: al arrancar puede valer 0 y en el móvil salía
	-- el minimapa grande del ordenador)
	UI.WaitViewport()
	local viewport = camera.ViewportSize
	local phone = UI.IsPhone()
	size = phone and 96 or ((viewport.Y > 0 and viewport.Y < 500) and 112 or 160)
	-- (Fase 15: en teléfonos bajos, como 568×320, algo más pequeño para que quepan las habilidades)
	if phone and math.min(viewport.X, viewport.Y) < 350 then
		size = 84
	end
	-- (debajo de los botones de Roblox de arriba a la izquierda, que si no lo tapaban)
	-- (en pantallas táctiles; en el ordenador, arriba del todo como siempre)
	local touchOnly = InputMode.TouchUI()
	local top = touchOnly and UI.TopbarBottom() or 14
	scale = size / RANGE
	gui = UI.new("ScreenGui", {
		Name = "Minimap",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 2,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- (táctil en pantallas alargadas, Fase 15: algo separado del borde, como el resto del HUD)
	local aspect = math.max(viewport.X, viewport.Y) / math.max(1, math.min(viewport.X, viewport.Y))
	local left = (touchOnly and aspect >= 1.95) and 22 or 14
	frame = UI.new("Frame", {
		Position = UDim2.fromOffset(left, top),
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = Color3.fromRGB(22, 26, 30),
		BackgroundTransparency = 0.3,
		ClipsDescendants = true,
		Parent = gui,
	}, { UI.corner(8), UI.stroke(Color3.fromRGB(230, 230, 235), 2, 0.35) })
	border = frame:FindFirstChildOfClass("UIStroke")
	enemyRadarLabel = UI.label({
		Position = UDim2.new(0, 0, 1, -16),
		Size = UDim2.new(1, 0, 0, 16),
		Text = UI.HudText("📡 RADAR ENEMIGO"),
		TextSize = 11,
		TextColor3 = Color3.fromRGB(255, 120, 120),
		BackgroundColor3 = Color3.fromRGB(60, 0, 0),
		BackgroundTransparency = 0.35,
		ZIndex = 6,
		Visible = false,
		Parent = frame,
	})
	world = UI.new("Frame", {
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
		Parent = frame,
	})
	me = UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16),
		Text = "▲",
		TextSize = 15,
		TextColor3 = Color3.fromRGB(255, 230, 90),
		ZIndex = 5,
		Parent = frame,
	})
	-- (el botón de PASE · TIENDA y lo demás de la izquierda van debajo)
	ClientState.MinimapBottom = top + size
	ClientState.MinimapLeft = left
	ClientState.MinimapSize = size
	Remotes.ShotFX.OnClientEvent:Connect(onShot)
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 1 / 30 then
			return
		end
		accumulator = 0
		update()
	end)
end

return Minimap
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="221">
            <Properties>
              <string name="Name">Movement</string>
              <string name="Source"><![CDATA[-- Movimiento: correr (Shift), agacharse (C) y deslizarse (C corriendo), con sensación realista (GameConfig.Movement):
--   * aceleración: se arranca y se pasa a correr poco a poco, y se frena rápido
--   * solo se corre hacia delante, y correr gasta estamina (si se agota, hay que recuperarse)
--   * saltar también gasta un poco; cansado se salta menos
--   * aterrizar desde alto da un golpe de cámara y, si es muy alto, frena un momento
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Sounds = require(Shared.Sounds)

local TouchLayout = require(script.Parent.TouchLayout)
local HUDZones = require(script.Parent.HUDZones)
local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Movement = {}

local humanoid, rootPart
local sprintHeld = false
local MOVE = GameConfig.Movement or {}
local currentSpeed = GameConfig.WalkSpeed
local lastStaminaUse = 0
local fallSpeed = 0 -- la mayor velocidad de caída desde que se despegó del suelo
local slowUntil = 0 -- aterrizaje fuerte: frena hasta entonces
local baseJumpHeight, baseJumpPower
local baseHipHeight -- (agacharse baja la cadera: cámara y cuerpo más bajos, también para los demás)
local staminaBar, staminaFill
local lastSlide = -10
local stopSlide

local function tweenCameraOffset(offset, time)
	if humanoid then
		TweenService:Create(humanoid, TweenInfo.new(time, Enum.EasingStyle.Quad), { CameraOffset = offset }):Play()
	end
end

-- Polvo que levanta el deslizamiento, del color del suelo (nieve, tierra, hormigón...)
local SLIDE_DUST = {
	[Enum.Material.Snow] = Color3.fromRGB(240, 245, 255),
	[Enum.Material.Ice] = Color3.fromRGB(225, 240, 255),
	[Enum.Material.Glacier] = Color3.fromRGB(225, 240, 255),
	[Enum.Material.Grass] = Color3.fromRGB(140, 120, 85),
	[Enum.Material.LeafyGrass] = Color3.fromRGB(140, 120, 85),
	[Enum.Material.Ground] = Color3.fromRGB(150, 125, 90),
	[Enum.Material.Mud] = Color3.fromRGB(110, 85, 60),
	[Enum.Material.Sand] = Color3.fromRGB(205, 185, 140),
}

local function slideDust(floorMaterial)
	if not rootPart or not humanoid or ClientState.EffectiveQuality == "Baja" then
		return nil
	end
	local feet = Instance.new("Attachment")
	feet.Name = "SlideDust"
	feet.Position = Vector3.new(0, -(humanoid.HipHeight + rootPart.Size.Y / 2) + 0.3, 0)
	feet.Parent = rootPart
	local dust = Instance.new("ParticleEmitter")
	dust.Texture = "rbxasset://textures/particles/smoke_main.dds"
	dust.Color = ColorSequence.new(SLIDE_DUST[floorMaterial] or Color3.fromRGB(175, 172, 165))
	dust.LightInfluence = 1
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 2.4) })
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
	dust.Lifetime = NumberRange.new(0.5, 0.8)
	dust.Speed = NumberRange.new(2, 4)
	dust.SpreadAngle = Vector2.new(50, 50)
	dust.Acceleration = Vector3.new(0, 1, 0)
	dust.Rotation = NumberRange.new(0, 360)
	dust.RotSpeed = NumberRange.new(-40, 40)
	dust.Rate = 40
	dust.EmissionDirection = Enum.NormalId.Top
	dust.Parent = feet
	return feet
end

local wasFrozen = false

local function slide()
	if ClientState.Sliding or ClientState.Dashing or ClientState.IsBlocked() or ClientState.Frozen() or not humanoid or humanoid.Health <= 0 or not rootPart then
		return
	end
	if os.clock() - lastSlide < GameConfig.SlideCooldown or humanoid.FloorMaterial == Enum.Material.Air then
		return
	end
	local direction = humanoid.MoveDirection
	if direction.Magnitude < 0.1 then
		direction = camera.CFrame.LookVector
	end
	direction = Vector3.new(direction.X, 0, direction.Z)
	if direction.Magnitude < 0.01 then
		return
	end
	direction = direction.Unit

	lastSlide = os.clock()
	ClientState.Sliding = true
	Sounds.Play("Slide")
	local dust = slideDust(humanoid.FloorMaterial)

	local attachment = Instance.new("Attachment")
	attachment.Name = "SlideAttachment"
	attachment.Parent = rootPart
	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	-- Modo plano: solo empuja en X/Z, la gravedad sigue actuando
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	velocity.PrimaryTangentAxis = Vector3.xAxis
	velocity.SecondaryTangentAxis = Vector3.zAxis
	velocity.MaxForce = 80000
	velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z) * GameConfig.SlideSpeed
	velocity.Parent = rootPart

	tweenCameraOffset(Vector3.new(0, -1.8, 0), 0.12)

	local start = os.clock()
	local connection
	local stopped = false
	stopSlide = function()
		if stopped then
			return
		end
		stopped = true
		connection:Disconnect()
		velocity:Destroy()
		attachment:Destroy()
		if dust then
			-- Deja de emitir y se borra cuando se han disipado las últimas partículas
			local emitter = dust:FindFirstChildOfClass("ParticleEmitter")
			if emitter then
				emitter.Enabled = false
			end
			task.delay(1, function()
				dust:Destroy()
			end)
		end
		ClientState.Sliding = false
		tweenCameraOffset(Vector3.zero, 0.2)
	end
	connection = RunService.Heartbeat:Connect(function()
		local alpha = (os.clock() - start) / GameConfig.SlideDuration
		local state = humanoid:GetState()
		if alpha >= 1 or humanoid.Health <= 0 or humanoid.Jump or state == Enum.HumanoidStateType.Jumping then
			stopSlide()
			return
		end
		local speed = GameConfig.SlideSpeed + (GameConfig.WalkSpeed - GameConfig.SlideSpeed) * alpha * alpha
		velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z) * speed
	end)
end

-- Hielo: el Humanoid ignora la fricción del suelo, así que el patinaje se hace con una LinearVelocity
-- (dentro del paso de física, como el deslizamiento): la velocidad cambia despacio hacia donde quieres ir.
local iceVelocity = Vector3.zero
local iceMover: LinearVelocity? = nil

local function stopIce()
	if iceMover then
		local attachment = iceMover.Attachment0
		iceMover:Destroy()
		if attachment then
			attachment:Destroy()
		end
		iceMover = nil
	end
end

local function iceSlide(dt)
	local state = humanoid:GetState()
	local onIce = humanoid.FloorMaterial == Enum.Material.Ice
		and not ClientState.Sliding
		and not ClientState.Dashing
		and state ~= Enum.HumanoidStateType.Jumping
		and state ~= Enum.HumanoidStateType.Freefall
	if not onIce then
		stopIce()
		local velocity = rootPart.AssemblyLinearVelocity
		iceVelocity = Vector3.new(velocity.X, 0, velocity.Z)
		return
	end
	if not iceMover or iceMover.Parent ~= rootPart then
		stopIce()
		local attachment = Instance.new("Attachment")
		attachment.Name = "IceAttachment"
		attachment.Parent = rootPart
		local mover = Instance.new("LinearVelocity")
		mover.Name = "IceVelocity"
		mover.Attachment0 = attachment
		mover.RelativeTo = Enum.ActuatorRelativeTo.World
		mover.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
		mover.PrimaryTangentAxis = Vector3.xAxis
		mover.SecondaryTangentAxis = Vector3.zAxis
		mover.MaxForce = 30000
		mover.Parent = rootPart
		iceMover = mover
	end
	local wanted = humanoid.MoveDirection * humanoid.WalkSpeed
	iceVelocity = iceVelocity:Lerp(Vector3.new(wanted.X, 0, wanted.Z), math.min(1, dt * 1.5))
	if iceMover then
		iceMover.PlaneVelocity = Vector2.new(iceVelocity.X, iceVelocity.Z)
	end
end

-- Barra de estamina fina debajo de la mira; solo se ve mientras no está llena
local function buildStaminaBar()
	local gui = UI.new("ScreenGui", {
		Name = "Stamina",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		Parent = player:WaitForChild("PlayerGui"),
	})
	staminaBar = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 44),
		Size = UDim2.fromOffset(90, 5),
		BackgroundColor3 = Color3.fromRGB(20, 20, 26),
		BackgroundTransparency = 0.35,
		Visible = false,
		Parent = gui,
	}, { UI.corner(3) })
	staminaFill = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(235, 240, 250),
		Parent = staminaBar,
	}, { UI.corner(3) })
	-- (táctil, Fase 16: con los avisos de bajo la mira, fuera del centro libre)
	HUDZones.Register("Stamina", staminaBar, "BOTTOM_NOTICE", 3)
end

local function updateStaminaBar()
	if not staminaBar then
		return
	end
	local stamina = ClientState.Stamina
	staminaBar.Visible = stamina < 0.995 and not ClientState.InMainMenu and not ClientState.Dead
	staminaFill.Size = UDim2.fromScale(math.clamp(stamina, 0, 1), 1)
	staminaFill.BackgroundColor3 = ClientState.Exhausted and Color3.fromRGB(255, 90, 80) or Color3.fromRGB(235, 240, 250)
end

-- Estamina: correr la gasta; se recupera tras un momento sin correr ni saltar
local function updateStamina(dt)
	local now = os.clock()
	local stamina = ClientState.Stamina
	if ClientState.Sprinting then
		stamina -= dt / (MOVE.StaminaSeconds or 6)
		lastStaminaUse = now
		if stamina <= 0 then
			stamina = 0
			ClientState.Exhausted = true
		end
	elseif now - lastStaminaUse > (MOVE.RegenDelay or 0.8) then
		stamina = math.min(1, stamina + dt / (MOVE.RegenSeconds or 4))
	end
	if ClientState.Exhausted and stamina >= (MOVE.MinToSprint or 0.3) then
		ClientState.Exhausted = false
	end
	ClientState.Stamina = stamina
end

-- Correr solo en el móvil (Ajustes → Controles táctiles → Correr: Auto): con el joystick empujado
-- casi hasta el borde se corre, sin botón. El empuje se lee del ControlModule de Roblox
-- (PlayerModule:GetControls():GetMoveVector(), de 0 a 1); MoveDirection siempre mide 1.
local controls
local controlsRetryAt = 0
local function autoSprint(): boolean
	local settings = ClientState.Settings
	if (settings and settings.AutoSprint or 1) ~= 1 or UserInputService.TouchEnabled ~= true then
		return false
	end
	local okType, lastType = pcall(UserInputService.GetLastInputType, UserInputService)
	if not okType or lastType ~= Enum.UserInputType.Touch then
		return false
	end
	-- (el PlayerModule de Roblox puede no estar aún en el primer fotograma: se reintenta cada segundo)
	if not controls and os.clock() >= controlsRetryAt then
		controlsRetryAt = os.clock() + 1
		controls = false
		local module = player:FindFirstChild("PlayerScripts") and player.PlayerScripts:FindFirstChild("PlayerModule")
		if module then
			local ok, playerModule = pcall(require, module)
			if ok and type(playerModule) == "table" and playerModule.GetControls then
				controls = playerModule:GetControls() or false
			end
		end
	end
	if not controls then
		return false
	end
	local ok, vector = pcall(controls.GetMoveVector, controls)
	return ok and typeof(vector) == "Vector3" and vector.Magnitude >= (MOVE.AutoSprintPush or 0.9)
end

local function update(dt)
	if not humanoid or humanoid.Health <= 0 or not rootPart then
		ClientState.Sprinting = false
		updateStaminaBar()
		return
	end
	iceSlide(dt)
	local moveDirection = humanoid.MoveDirection
	local moving = moveDirection.Magnitude > 0.1
	local recentlyShot = os.clock() - ClientState.LastShotTime < 0.35
	-- Solo se corre hacia delante (no de lado ni hacia atrás)
	local look = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
	local flatMove = Vector3.new(moveDirection.X, 0, moveDirection.Z)
	local forward = moving and look.Magnitude > 0.01 and flatMove.Magnitude > 0.01 and flatMove.Unit:Dot(look.Unit) >= (MOVE.SprintAngle or 0.55)
	ClientState.Sprinting = (sprintHeld or autoSprint())
		and moving
		and forward
		and not ClientState.Exhausted
		and not ClientState.Aiming
		and not recentlyShot
		and not ClientState.Sliding
		and not ClientState.IsBlocked()
	-- Correr, deslizarse o estar en el aire te levanta
	if ClientState.Crouching and (ClientState.Sprinting or ClientState.Sliding or humanoid.FloorMaterial == Enum.Material.Air) then
		ClientState.Crouching = false
	end
	if baseHipHeight then
		local target = baseHipHeight - (ClientState.Crouching and (GameConfig.CrouchDrop or 1.3) or 0)
		if math.abs(humanoid.HipHeight - target) > 0.01 then
			humanoid.HipHeight += (target - humanoid.HipHeight) * math.min(1, dt * 12)
		end
	end
	updateStamina(dt)
	updateStaminaBar()

	-- Caída: se apunta la velocidad máxima hasta tocar suelo (el golpe lo da onLanded)
	if humanoid.FloorMaterial == Enum.Material.Air then
		fallSpeed = math.max(fallSpeed, -rootPart.AssemblyLinearVelocity.Y)
	end
	-- Cansado se salta menos
	local jumpScale = ClientState.Exhausted and (MOVE.TiredJump or 0.7) or 1
	if baseJumpHeight then
		humanoid.JumpHeight = baseJumpHeight * jumpScale
		humanoid.JumpPower = baseJumpPower * jumpScale
	end

	local speed = GameConfig.WalkSpeed
	if ClientState.Sprinting then
		speed = GameConfig.SprintSpeed
	elseif ClientState.Crouching then
		speed = GameConfig.CrouchSpeed or 10
	elseif ClientState.Aiming then
		speed = GameConfig.AimWalkSpeed
	end
	local weaponDef = ClientState.CurrentDef
	if weaponDef and weaponDef.WalkSpeedMultiplier then
		speed *= weaponDef.WalkSpeedMultiplier
	end
	-- Ventaja "Ligero"
	local perkId = player:GetAttribute("Perk")
	for _, perk in GameConfig.Perks or {} do
		if perk.Id == perkId and perk.SpeedMultiplier then
			speed *= perk.SpeedMultiplier
		end
	end
	if player:GetAttribute("CarryingFlag") then
		speed *= GameConfig.Flag.CarrierSpeedMultiplier
	end
	if os.clock() < slowUntil then
		speed *= 0.6 -- aterrizaje fuerte
	end
	-- Aceleración: se arranca con parte de la velocidad y se llega a la máxima poco a poco
	if not moving then
		currentSpeed = math.min(currentSpeed, speed * (MOVE.StartFactor or 0.55))
	elseif currentSpeed < speed then
		currentSpeed = math.min(speed, currentSpeed + (MOVE.Acceleration or 30) * dt)
	else
		currentSpeed = math.max(speed, currentSpeed - (MOVE.Deceleration or 70) * dt)
	end
	-- Cuenta atrás de Eliminación: quieto y sin saltar
	local frozen = ClientState.Frozen()
	if frozen then
		currentSpeed = 0
	end
	if frozen ~= wasFrozen then
		wasFrozen = frozen
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, not frozen)
	end
	humanoid.WalkSpeed = currentSpeed
end

-- Al tocar suelo tras una caída: golpe de cámara, sonido y, si fue muy alta, frena un momento
local function onLanded()
	local speed = fallSpeed
	fallSpeed = 0
	local hard = MOVE.HardLanding or 38
	if speed < hard then
		return
	end
	local k = math.clamp((speed - hard) / 40, 0, 1)
	ClientState.LandKick = math.max(ClientState.LandKick or 0, 0.35 + 0.65 * k)
	Sounds.Play("Land", nil, 1 - 0.15 * k, 0.5 + 0.5 * k)
	if speed >= (MOVE.HeavyLanding or 62) then
		slowUntil = os.clock() + 0.35
	end
end

local function onCharacter(newCharacter)
	if stopSlide then
		stopSlide()
		stopSlide = nil
	end
	ClientState.Sliding = false
	-- (al reaparecer no se sigue corriendo: el botón de correr en táctil es de pulsar y soltar, y antes
	-- quedaba encendido de la vida anterior)
	sprintHeld = false
	ClientState.SprintToggled = false
	iceMover = nil -- era del personaje anterior
	humanoid = newCharacter:WaitForChild("Humanoid")
	wasFrozen = false -- el humanoide nuevo empieza con el salto activado (después de cambiarlo)
	rootPart = newCharacter:WaitForChild("HumanoidRootPart")
	humanoid.CameraOffset = Vector3.zero
	baseJumpHeight, baseJumpPower = humanoid.JumpHeight, humanoid.JumpPower
	baseHipHeight = humanoid.HipHeight
	ClientState.Crouching = false
	currentSpeed = GameConfig.WalkSpeed * (MOVE.StartFactor or 0.55)
	fallSpeed = 0
	slowUntil = 0
	ClientState.Stamina = 1
	ClientState.Exhausted = false
	local character = newCharacter
	humanoid.StateChanged:Connect(function(_, new)
		if player.Character ~= character then
			return
		end
		if new == Enum.HumanoidStateType.Landed then
			onLanded()
		elseif new == Enum.HumanoidStateType.Jumping then
			-- Saltar gasta un poco de estamina
			ClientState.Stamina = math.max(0, ClientState.Stamina - (MOVE.JumpCost or 0.12))
			lastStaminaUse = os.clock()
		end
	end)
end

function Movement.Init()
	buildStaminaBar()
	TouchLayout.BindAction("Sprint", function(_, state, input)
		if input and input.UserInputType == Enum.UserInputType.Touch then
			if state == Enum.UserInputState.Begin and not ClientState.IsBlocked() then
				sprintHeld = not sprintHeld
				ClientState.SprintToggled = sprintHeld
			end
		elseif state == Enum.UserInputState.Begin then
			sprintHeld = true
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			sprintHeld = false
			ClientState.SprintToggled = false
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)

	-- C: corriendo te deslizas; si no, te agachas o te levantas (como en los shooters de móvil)
	TouchLayout.BindAction("Slide", function(_, state)
		if state == Enum.UserInputState.Begin then
			local running = ClientState.Sprinting or currentSpeed > GameConfig.WalkSpeed + 1
			if running then
				ClientState.Crouching = false
				slide()
			elseif not ClientState.Sliding and not ClientState.IsBlocked() and humanoid and humanoid.FloorMaterial ~= Enum.Material.Air then
				ClientState.Crouching = not ClientState.Crouching
			end
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.C, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonR3)

	-- Saltar (táctil, Fase 15): el botón es nuestro (va en el grupo de combate con su jerarquía; el de
	-- Roblox se esconde en TouchLayout) y hace EXACTAMENTE lo que hace el de Roblox: mientras el dedo
	-- está encima, Humanoid.Jump = true en cada fotograma, justo después del ControlModule de Roblox
	-- (que lo pone a false si nadie salta). Misma altura, mismo coste de estamina, mismo autosalto.
	local jumpHeld = false
	if TouchLayout.BindButton("Jump", function(_, state)
		if state == Enum.UserInputState.Begin then
			jumpHeld = not ClientState.IsBlocked()
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			jumpHeld = false
		end
		return Enum.ContextActionResult.Pass
	end) then
		RunService:BindToRenderStep("TouchJump", Enum.RenderPriority.Input.Value + 1, function()
			if jumpHeld and humanoid and humanoid.Health > 0 then
				humanoid.Jump = true
			end
		end)
	end
	Movement.TouchJumpHeld = function()
		return jumpHeld
	end
	Movement.SprintHeld = function()
		return sprintHeld
	end

	-- Si la ventana pierde el foco dejamos de correr
	UserInputService.WindowFocusReleased:Connect(function()
		sprintHeld = false
		ClientState.SprintToggled = false
	end)

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	RunService.Heartbeat:Connect(update)
end

return Movement
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="222">
            <Properties>
              <string name="Name">News</string>
              <string name="Source"><![CDATA[-- Novedades (GameConfig.News): en la pantalla de inicio, los jugadores que ya habían jugado ven una
-- vez lo nuevo de la actualización. Se cierra con el botón y el servidor lo apunta (NewsSeen).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Sounds = require(Shared.Sounds)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local News = {}

local shown = false

local function show()
	shown = true
	local news = GameConfig.ActiveNews()
	local height = 120 + #news.Items * 46
	local gui = UI.new("ScreenGui", {
		Name = "News",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 15,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- (Active: tapa los botones de la pantalla de inicio mientras se lee)
	UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5, Active = true, Parent = gui })
	local card = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(560, height),
		BackgroundColor3 = Color3.fromRGB(26, 20, 40),
		Parent = gui,
	}, { UI.corner(18), UI.stroke(Color3.fromRGB(255, 140, 30), 3, 0) })
	local scale = UI.new("UIScale", { Scale = 0.6, Parent = card })
	local viewport = workspace.CurrentCamera.ViewportSize
	local fit = math.clamp(math.min((viewport.X - 20) / 560, (viewport.Y - 20) / height), 0.45, 1)
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = fit }):Play()
	UI.label({ Position = UDim2.fromOffset(0, 14), Size = UDim2.new(1, 0, 0, 40), Text = news.Title, TextSize = 30, TextColor3 = Color3.fromRGB(255, 170, 50), Parent = card })
	for i, item in news.Items do
		local row = UI.new("Frame", {
			Position = UDim2.fromOffset(20, 62 + (i - 1) * 46),
			Size = UDim2.new(1, -40, 0, 40),
			BackgroundColor3 = Color3.fromRGB(50, 40, 74),
			BackgroundTransparency = 0.2,
			Parent = card,
		}, { UI.corner(10) })
		UI.label({ Size = UDim2.fromOffset(44, 40), Text = item[1], TextSize = 24, Parent = row })
		UI.label({
			Position = UDim2.fromOffset(48, 0),
			Size = UDim2.new(1, -56, 1, 0),
			Text = item[2],
			TextSize = 18,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			Parent = row,
		})
	end
	local button = UI.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(220, 44),
		Text = "¡A JUGAR!",
		TextSize = 24,
		BackgroundColor3 = Color3.fromRGB(255, 130, 30),
		Parent = card,
	}, { UI.gloss() })
	button.Modal = true
	ClientState.NewsOpen = true
	ClientState.UpdateMouse()
	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		Remotes.NewsSeen:FireServer()
		gui:Destroy()
		ClientState.NewsOpen = false
		ClientState.UpdateMouse()
	end
	button.Activated:Connect(function()
		Sounds.Play("Click")
		close()
	end)
	-- Si empieza la partida con la tarjeta abierta (por ejemplo con el mando), se cierra sola
	task.spawn(function()
		while not closed do
			if not ClientState.InMainMenu then
				close()
			end
			task.wait(0.3)
		end
	end)
end

function News.Init()
	task.spawn(function()
		while not shown do
			task.wait(1)
			local data = ClientState.Data
			local news = GameConfig.ActiveNews()
			if news and data and ClientState.InMainMenu and data.TutorialDone and (data.NewsSeen or 0) < news.Version then
				task.wait(1) -- que primero se vea la pantalla de inicio
				if ClientState.InMainMenu then
					show()
				end
			elseif data and news and (data.NewsSeen or 0) >= news.Version then
				return
			end
		end
	end)
end

return News
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="223">
            <Properties>
              <string name="Name">PlaytimeGifts</string>
              <string name="Source"><![CDATA[-- Botón de regalos por tiempo jugado (a la izquierda, debajo de los retos): cuenta atrás hasta el
-- siguiente regalo y, cuando está listo, brilla y se recoge con la tecla H (en partida el ratón está
-- bloqueado) o tocándolo en móvil. Lo valida el servidor (Gifts).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Sounds = require(Shared.Sounds)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local HUDZones = require(script.Parent.HUDZones)

local player = Players.LocalPlayer

local PlaytimeGifts = {}

local READY = Color3.fromRGB(255, 190, 40)
local WAITING = Color3.fromRGB(45, 50, 80)

local gui, button, icon, label, sub, scale
local claiming = false
local message, messageUntil = nil, 0 -- aviso breve si el servidor no deja recogerlo
local compact = false -- móvil: solo el icono y el tiempo (arriba a la izquierda)

local function rewardText(gift)
	local parts = {}
	if gift.Coins then
		table.insert(parts, gift.Coins .. " 💰")
	end
	if gift.XP then
		table.insert(parts, gift.XP .. " XP")
	end
	if gift.Revives then
		table.insert(parts, gift.Revives .. " 💖")
	end
	return table.concat(parts, " + ")
end

-- Siguiente regalo y segundos que faltan (nil si ya se recogieron todos)
local function nextGift()
	local start = player:GetAttribute("GiftStart")
	local index = (player:GetAttribute("GiftsClaimed") or 0) + 1
	local gift = GameConfig.PlaytimeGifts[index]
	if not start or not gift then
		return nil
	end
	return gift, math.max(0, start + gift.Minutes * 60 - workspace:GetServerTimeNow())
end

local function update()
	local gift, left = nextGift()
	gui.Enabled = gift ~= nil and not ClientState.InMainMenu and not ClientState.Dead
		-- (táctil, Fase 16: en plena pelea no; ocupaba el sitio del aviso de baja junto al minimapa)
		and not (compact and HUDZones.Fighting())
	if not gift then
		return
	end
	local ready = left <= 0
	button.BackgroundColor3 = ready and READY or WAITING
	if compact then
		label.Text = ready and "¡YA!" or UI.formatTime(left)
	else
		label.Text = ready and "¡RECOGER! (H)" or ("REGALO EN " .. UI.formatTime(left))
	end
	sub.Text = (message and os.clock() < messageUntil) and message or rewardText(gift)
	-- Late cuando está listo
	scale.Scale = ready and (1 + math.sin(os.clock() * 6) * 0.05) or 1
	icon.Rotation = ready and math.sin(os.clock() * 10) * 12 or 0
end

local function claim()
	local gift, left = nextGift()
	if claiming or not gift or left > 0 then
		return
	end
	claiming = true
	Sounds.Play("Click")
	local ok, result, reason = pcall(function()
		return Remotes.ClaimGift:InvokeServer()
	end)
	claiming = false
	if not (ok and result) then
		message, messageUntil = (ok and type(reason) == "string") and reason or "Inténtalo otra vez", os.clock() + 2
	end
	if ok and result then
		Sounds.Play("Flag")
		-- Pequeño salto del botón al recogerlo
		scale.Scale = 1.25
		TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
end

function PlaytimeGifts.Init()
	gui = UI.new("ScreenGui", {
		Name = "PlaytimeGifts",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- En móvil: botón pequeño arriba a la izquierda (abajo está el joystick y los retos ocupan el centro)
	compact = InputMode.TouchUI()
	UI.WaitViewport()
	-- (teléfono: a la derecha del minimapa, pequeño; tablet: debajo del botón de la tienda)
	local phone = UI.IsPhone()
	button = UI.button({
		AnchorPoint = Vector2.new(0, 0),
		-- (táctil: a la derecha del minimapa, que mide 96 en el teléfono y 160 en la tablet)
		Position = compact and UDim2.fromOffset(14 + (phone and 96 or 160) + 6, UI.TopbarBottom())
			or UDim2.new(0, 66, 0.38, 112),
		Size = phone and UDim2.fromOffset(44, 54) or (compact and UDim2.fromOffset(52, 64) or UDim2.fromOffset(230, 56)),
		Text = "",
		BackgroundColor3 = WAITING,
		BackgroundTransparency = 0.1,
		Parent = gui,
	}, { UI.stroke(Color3.new(1, 1, 1), 2, 0.3) })
	scale = UI.new("UIScale", { Parent = button })
	icon = UI.label({
		Position = UDim2.fromOffset(4, 0),
		Size = UDim2.fromOffset(50, 56),
		Text = "🎁",
		TextSize = 34,
		Parent = button,
	})
	label = UI.label({
		Position = UDim2.fromOffset(56, 6),
		Size = UDim2.new(1, -62, 0, 24),
		Text = "",
		TextSize = 19,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = button,
	})
	sub = UI.label({
		Position = UDim2.fromOffset(56, 30),
		Size = UDim2.new(1, -62, 0, 20),
		Text = "",
		TextSize = 15,
		TextColor3 = Color3.fromRGB(255, 235, 170),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = button,
	})
	if compact then
		-- Icono arriba y el tiempo debajo, sin la línea del premio
		local small = phone
		icon.Position, icon.Size, icon.TextSize = UDim2.fromOffset(0, 2), UDim2.new(1, 0, 0, small and 30 or 38), small and 24 or 30
		label.Position, label.Size = UDim2.fromOffset(0, small and 32 or 40), UDim2.new(1, 0, 0, small and 18 or 20)
		label.TextXAlignment = Enum.TextXAlignment.Center
		label.TextSize = small and 12 or 15
		sub.Visible = false
	end
	button.Activated:Connect(claim)
	ContextActionService:BindAction("ClaimGift", function(_, state)
		if state == Enum.UserInputState.Begin and gui.Enabled and not ClientState.IsBlocked() then
			claim()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.H)
	task.spawn(function()
		while true do
			update()
			-- Rápido solo cuando late (regalo listo y a la vista)
			local gift, left = nextGift()
			task.wait((gui.Enabled and gift and left <= 0) and 0.1 or 0.25)
		end
	end)
end

return PlaytimeGifts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="224">
            <Properties>
              <string name="Name">QAPanel</string>
              <string name="Source"><![CDATA[-- Modo QA (Fase 8): panel de pruebas para Roblox Studio. Solo se crea si Shared/QA dice que está activo
-- (GameConfig.QA.Enabled Y RunService:IsStudio()) y el servidor ha creado su RemoteEvent. Fuera de eso
-- Init no hace nada. Es una herramienta, no interfaz final: gris, sin animaciones.
--
-- F8, \ (barra invertida) o el botón «QA» (arriba a la izquierda) lo abren y cierran. Con el panel abierto el ratón queda
-- libre. Todo lo de depuración empieza apagado. Ver FASE_08_VALIDACION_STUDIO.md.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Weapons = require(Shared.Weapons)
local QA = require(Shared.QA)
local WeaponVisual = require(Shared.WeaponVisual)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local QAPanel = {}

-- Mapas: primero los tres «gold standard» (Fase 3), después el resto (los ids del servidor, MapBuilder)
QAPanel.GoldMaps = { "Construction", "Coastal", "MallRush" }
QAPanel.OtherMaps = { "Terminal", "RooftopDistrict", "MetroYard", "DesertBase", "Dockyard", "IndustrialYard" }

local remote = nil
local gui, panel, logLabel, statusLabel, perfLabel = nil, nil, nil, nil, nil
local logLines = {}
local selectedMap, selectedMode = "Construction", "TDM"
local mapButtons, modeButtons = {}, {}
local toggles = {} -- [nombre] = true/false
local weaponIndex = 1
local snapshots = 0
local debugFolder = nil
local shotParts = {}
local safeGuis = {}
local perfConnection = nil

local GREY = Color3.fromRGB(58, 60, 66)
local DARK = Color3.fromRGB(26, 27, 30)
local ON = Color3.fromRGB(46, 120, 70)
local PICK = Color3.fromRGB(150, 120, 30)

---------------------------------------------------------------------------
-- Registro (abajo del panel y en Output)
---------------------------------------------------------------------------

function QAPanel.Log(text)
	text = tostring(text)
	print("[QA] " .. text)
	table.insert(logLines, text)
	while #logLines > 9 do
		table.remove(logLines, 1)
	end
	if logLabel then
		logLabel.Text = table.concat(logLines, "\n")
	end
end

local function send(command, args)
	if remote then
		remote:FireServer(command, args or {})
	end
end
QAPanel.Send = send

---------------------------------------------------------------------------
-- Ayudas visuales (solo en este cliente: van dentro de la cámara, no se replican)
---------------------------------------------------------------------------

local function ensureDebugFolder()
	local camera = workspace.CurrentCamera
	if not debugFolder or not debugFolder.Parent then
		debugFolder = Instance.new("Folder")
		debugFolder.Name = "QADebug"
		debugFolder.Parent = camera
	end
	return debugFolder
end

local function label(part, text, color)
	local board = Instance.new("BillboardGui")
	board.Name = "QALabel"
	board.Adornee = part
	board.AlwaysOnTop = true
	board.Size = UDim2.fromOffset(150, 22)
	board.StudsOffset = Vector3.new(0, 3, 0)
	board.MaxDistance = 400
	local text_ = Instance.new("TextLabel")
	text_.Size = UDim2.fromScale(1, 1)
	text_.BackgroundTransparency = 0.35
	text_.BackgroundColor3 = DARK
	text_.TextColor3 = color
	text_.TextSize = 14
	text_.Font = Enum.Font.GothamBold
	text_.Text = text
	text_.Parent = board
	return board
end

local function box(part, color, transparency, onTop)
	local adorn = Instance.new("BoxHandleAdornment")
	adorn.Name = "QABox"
	adorn.Adornee = part
	adorn.Size = part.Size
	adorn.Color3 = color
	adorn.Transparency = transparency
	adorn.AlwaysOnTop = onTop
	adorn.ZIndex = 1
	return adorn
end

-- Qué se dibuja de cada categoría: lista de { pieza, texto, color, transparencia, encima }
local CATEGORIES = {
	Spawns = function(map)
		local list = {}
		for _, d in map:GetDescendants() do
			if d:IsA("SpawnLocation") then
				local team = d.TeamColor and d.TeamColor.Name or ""
				table.insert(list, { d, "SPAWN " .. team, d.TeamColor and d.TeamColor.Color or Color3.new(1, 1, 1), 0.4, true })
			elseif d:IsA("BasePart") and d.Name == "FFASpawn" then
				table.insert(list, { d, "SPAWN FFA", Color3.fromRGB(220, 220, 220), 0.4, true })
			end
		end
		return list
	end,
	Objectives = function(map)
		local list = {}
		for _, d in map:GetDescendants() do
			if d:IsA("BasePart") then
				if d.Name == "BombSite" then
					table.insert(list, { d, "SITIO " .. tostring(d:GetAttribute("Letter") or "?"), Color3.fromRGB(255, 150, 40), 0.5, true })
				elseif d.Name == "FlagBase" then
					table.insert(list, { d, "BANDERA " .. tostring(d:GetAttribute("Team") or "?"), Color3.fromRGB(255, 230, 80), 0.5, true })
				elseif d.Name == "HardpointZone" then
					table.insert(list, { d, "ZONA", Color3.fromRGB(120, 200, 255), 0.6, true })
				end
			end
		end
		return list
	end,
	Bounds = function(map)
		local list = {}
		local boundary = map:FindFirstChild("Boundary")
		if boundary then
			for _, d in boundary:GetDescendants() do
				if d:IsA("BasePart") then
					table.insert(list, { d, nil, Color3.fromRGB(255, 60, 60), 0.75, false })
				end
			end
		end
		return list
	end,
	BotSpots = function(map)
		local list = {}
		for _, d in map:GetDescendants() do
			if d:IsA("BasePart") and d.Name == "BotSpot" then
				table.insert(list, { d, "BOT", Color3.fromRGB(80, 220, 255), 0.2, true })
			end
		end
		return list
	end,
}
QAPanel.Categories = CATEGORIES

-- Rehace las ayudas visuales encendidas (al cambiar de mapa o de interruptor)
function QAPanel.RefreshDebug()
	local folder = ensureDebugFolder()
	for _, child in folder:GetChildren() do
		if child.Name ~= "QAShots" then
			child:Destroy()
		end
	end
	local map = workspace:FindFirstChild("Map")
	if not map then
		return 0
	end
	local count = 0
	for name, collect in CATEGORIES do
		if toggles[name] then
			local group = Instance.new("Folder")
			group.Name = "QA" .. name
			for _, entry in collect(map) do
				local adorn = box(entry[1], entry[3], entry[4], entry[5])
				adorn.Parent = group
				if entry[2] then
					label(entry[1], entry[2], entry[3]).Parent = group
				end
				count += 1
			end
			group.Parent = folder
		end
	end
	return count
end

-- Disparos: una línea por bala (verde si dio a alguien, blanca si no) durante 2 s
local function drawShot(origin, rays)
	local folder = ensureDebugFolder()
	local shots = folder:FindFirstChild("QAShots")
	if not shots then
		shots = Instance.new("Folder")
		shots.Name = "QAShots"
		shots.Parent = folder
	end
	for _, ray in rays do
		if type(ray) == "table" and typeof(ray.Position) == "Vector3" then
			local hitModel = if typeof(ray.Part) == "Instance" then ray.Part:FindFirstAncestorOfClass("Model") else nil
			local hitSomeone = hitModel ~= nil and hitModel:FindFirstChildOfClass("Humanoid") ~= nil
			local length = (ray.Position - origin).Magnitude
			if length > 0.05 then
				local line = Instance.new("Part")
				line.Name = "QAShot"
				line.Anchored = true
				line.CanCollide = false
				line.CanQuery = false -- (que no estorbe a los rayos del juego)
				line.CanTouch = false
				line.CastShadow = false
				line.Material = Enum.Material.Neon
				line.Color = hitSomeone and Color3.fromRGB(60, 255, 120) or Color3.fromRGB(240, 240, 240)
				line.Transparency = 0.3
				line.Size = Vector3.new(0.06, 0.06, length)
				line.CFrame = CFrame.lookAt(origin, ray.Position) * CFrame.new(0, 0, -length / 2)
				line.Parent = shots
				table.insert(shotParts, line)
				task.delay(2, function()
					line:Destroy()
				end)
			end
		end
	end
	-- (tope: en una ráfaga larga no se acumulan cientos)
	while #shotParts > 80 do
		local old = table.remove(shotParts, 1)
		if old then
			old:Destroy()
		end
	end
end
QAPanel.DrawShot = drawShot

-- Zona segura: el rectángulo útil del dispositivo (muesca, barra de inicio) en verde y el que deja
-- libre la barra de Roblox en amarillo. Lo que quede fuera del verde puede quedar tapado.
local function setSafeArea(on)
	for _, existing in safeGuis do
		existing:Destroy()
	end
	table.clear(safeGuis)
	if not on then
		return
	end
	for _, spec in { { "DeviceSafeInsets", Color3.fromRGB(60, 255, 120), "zona segura del dispositivo" }, { "CoreUISafeInsets", Color3.fromRGB(255, 220, 60), "libre de la barra de Roblox" } } do
		local screen = Instance.new("ScreenGui")
		screen.Name = "QASafeArea_" .. spec[1]
		screen.ResetOnSpawn = false
		screen.DisplayOrder = 60
		local ok = pcall(function()
			screen.ScreenInsets = Enum.ScreenInsets[spec[1]]
		end)
		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundTransparency = 1
		frame.Parent = screen
		local stroke = Instance.new("UIStroke")
		stroke.Color = spec[2]
		stroke.Thickness = 2
		stroke.Parent = frame
		local text = Instance.new("TextLabel")
		text.BackgroundTransparency = 1
		text.Position = spec[1] == "DeviceSafeInsets" and UDim2.new(0, 6, 1, -20) or UDim2.new(0, 6, 0, 2)
		text.Size = UDim2.fromOffset(260, 18)
		text.TextXAlignment = Enum.TextXAlignment.Left
		text.TextColor3 = spec[2]
		text.TextSize = 12
		text.Font = Enum.Font.GothamBold
		text.Text = ok and spec[3] or (spec[3] .. " (ScreenInsets no disponible)")
		text.Parent = frame
		screen.Parent = player:WaitForChild("PlayerGui")
		table.insert(safeGuis, screen)
	end
end

---------------------------------------------------------------------------
-- Rendimiento (solo lo que Roblox da de verdad)
---------------------------------------------------------------------------

local function memoryMb()
	local ok, value = pcall(function()
		return game:GetService("Stats"):GetTotalMemoryUsageMb()
	end)
	return ok and type(value) == "number" and value or nil
end

local function pingMs()
	local ok, value = pcall(function()
		return player:GetNetworkPing()
	end)
	return ok and type(value) == "number" and value * 1000 or nil
end

local function countBots()
	local folder = workspace:FindFirstChild("Bots")
	return folder and #folder:GetChildren() or 0
end

local function countMapParts()
	local map = workspace:FindFirstChild("Map")
	if not map then
		return 0
	end
	local parts = 0
	for _, d in map:GetDescendants() do
		if d:IsA("BasePart") then
			parts += 1
		end
	end
	return parts
end

local function countFx()
	local fx = workspace:FindFirstChild("ClientFX")
	return fx and #fx:GetDescendants() or 0
end

local function setPerf(on)
	if perfConnection then
		perfConnection:Disconnect()
		perfConnection = nil
	end
	perfLabel.Visible = on
	if not on then
		return
	end
	local frames, windowStart, mapParts, partsAt = 0, os.clock(), 0, -math.huge
	perfConnection = RunService.RenderStepped:Connect(function()
		frames += 1
		local now = os.clock()
		if now - windowStart < 0.5 then
			return
		end
		local fps = frames / (now - windowStart)
		frames, windowStart = 0, now
		-- (contar las piezas del mapa cuesta: cada 5 s)
		if now - partsAt > 5 then
			mapParts, partsAt = countMapParts(), now
		end
		local memory, ping = memoryMb(), pingMs()
		perfLabel.Text = table.concat({
			string.format("FPS ~%.0f", fps),
			"Memoria: " .. (memory and string.format("%.0f MB", memory) or "no disponible"),
			"Ping (GetNetworkPing): " .. (ping and string.format("%.0f ms", ping) or "no disponible"),
			"Mapa: " .. tostring(ReplicatedStorage:GetAttribute("MapName")) .. " · " .. tostring(ReplicatedStorage:GetAttribute("Mode")),
			"Estado: " .. tostring(ReplicatedStorage:GetAttribute("State")),
			"Calidad: " .. tostring(ClientState.EffectiveQuality),
			string.format("Jugadores %d · bots %d", #Players:GetPlayers(), countBots()),
			string.format("Piezas del mapa %d · efectos (ClientFX) %d", mapParts, countFx()),
			"Arma: " .. tostring(ClientState.CurrentDef and ClientState.CurrentDef.DisplayName or "-") .. " · " .. tostring(ClientState.WeaponAction),
		}, "\n")
	end)
end

---------------------------------------------------------------------------
-- Foto de contadores (prueba de 5 partidas): cliente aquí, servidor por el RemoteEvent
---------------------------------------------------------------------------

function QAPanel.Snapshot()
	snapshots += 1
	local pg = player:FindFirstChildOfClass("PlayerGui")
	local screens = {}
	for _, child in pg and pg:GetChildren() or {} do
		if child:IsA("ScreenGui") then
			table.insert(screens, child.Name)
		end
	end
	table.sort(screens)
	local maps = 0
	for _, child in workspace:GetChildren() do
		if child.Name == "Map" then
			maps += 1
		end
	end
	local memory = memoryMb()
	local data = {
		N = snapshots,
		Memory = memory,
		ScreenGuis = #screens,
		Maps = maps,
		Bots = countBots(),
		Fx = countFx(),
		Instances = #workspace:GetDescendants(),
	}
	QAPanel.Log(string.format(
		"Foto cliente #%d · memoria %s · ScreenGui %d · mapas %d · bots %d · ClientFX %d · instancias %d",
		data.N, memory and string.format("%.0f MB", memory) or "n/d", data.ScreenGuis, data.Maps, data.Bots, data.Fx, data.Instances
	))
	print("[QA] ScreenGui: " .. table.concat(screens, ", "))
	send("Snapshot")
	return data
end

---------------------------------------------------------------------------
-- Panel
---------------------------------------------------------------------------

local function button(parent, text, onClick)
	local b = UI.new("TextButton", {
		BackgroundColor3 = GREY,
		BorderSizePixel = 0,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true, -- (los nombres largos se encogen en vez de cortarse)
		Font = Enum.Font.Gotham,
		Text = text,
		AutoButtonColor = true,
		Parent = parent,
	})
	UI.new("UITextSizeConstraint", { MaxTextSize = 13, MinTextSize = 8, Parent = b })
	UI.new("UIPadding", { PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3), Parent = b })
	b.Activated:Connect(function()
		onClick(b)
	end)
	return b
end

local grids = {}
local CELL_H, GAP, PER_ROW = 26, 4, 3

local function section(parent, title, order)
	UI.new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(255, 210, 60),
		TextSize = 13,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = title,
		LayoutOrder = order,
		Parent = parent,
	})
	local grid = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, CELL_H),
		BackgroundTransparency = 1,
		LayoutOrder = order + 1,
		Parent = parent,
	})
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(104, CELL_H), CellPadding = UDim2.fromOffset(GAP, GAP), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	table.insert(grids, grid)
	return grid
end

-- Alto de cada rejilla según sus botones (sin depender de AutomaticSize) y del lienzo con scroll
local function fitGrids(scroll)
	local total = 0
	for _, grid in grids do
		local buttons = 0
		for _, child in grid:GetChildren() do
			if child:IsA("TextButton") then
				buttons += 1
			end
		end
		local rows = math.max(1, math.ceil(buttons / PER_ROW))
		local height = rows * CELL_H + (rows - 1) * GAP
		grid.Size = UDim2.new(1, 0, 0, height)
		total += height + 18 + 8 -- (rejilla + título + separación)
	end
	scroll.CanvasSize = UDim2.fromOffset(0, total)
end

local function paintSelection()
	for id, b in mapButtons do
		b.BackgroundColor3 = id == selectedMap and PICK or GREY
	end
	for mode, b in modeButtons do
		b.BackgroundColor3 = mode == selectedMode and PICK or GREY
	end
end

local function toggle(grid, name, text, apply)
	toggles[name] = false
	button(grid, text, function(b)
		toggles[name] = not toggles[name]
		b.BackgroundColor3 = toggles[name] and ON or GREY
		apply(toggles[name])
	end)
end

local function build()
	gui = UI.new("ScreenGui", {
		Name = "QAPanel",
		ResetOnSpawn = false,
		DisplayOrder = 50,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local open = UI.new("TextButton", {
		Name = "QAToggle",
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.fromOffset(44, 26),
		BackgroundColor3 = Color3.fromRGB(150, 40, 40),
		BorderSizePixel = 0,
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 14,
		Font = Enum.Font.GothamBold,
		Text = "QA",
		Parent = gui,
	})
	panel = UI.new("Frame", {
		Name = "Panel",
		Position = UDim2.fromOffset(8, 40),
		Size = UDim2.new(0, 352, 1, -52),
		BackgroundColor3 = DARK,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		Visible = false,
		Parent = gui,
	})
	-- (botón Modal invisible: con el panel abierto el ratón queda libre en primera persona)
	UI.new("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true, Parent = panel })
	statusLabel = UI.new("TextLabel", {
		Position = UDim2.fromOffset(8, 4),
		Size = UDim2.new(1, -16, 0, 40),
		BackgroundTransparency = 1,
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 12,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		Text = "MODO QA (solo Studio)",
		Parent = panel,
	})
	-- (pantallas bajas, como un móvil apaisado: registro más corto para que quepan los botones)
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize
	local height = if typeof(viewport) == "Vector2" and viewport.Y > 1 then viewport.Y else 720
	local compact = height < 500
	local logHeight = compact and 52 or 126
	local scroll = UI.new("ScrollingFrame", {
		Position = UDim2.fromOffset(8, 48),
		Size = UDim2.new(1, -16, 1, -(48 + logHeight + 12)),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		Parent = panel,
	})
	UI.new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
	logLabel = UI.new("TextLabel", {
		Position = UDim2.new(0, 8, 1, -(logHeight + 6)),
		Size = UDim2.new(1, -16, 0, logHeight),
		BackgroundColor3 = Color3.fromRGB(12, 12, 14),
		BorderSizePixel = 0,
		TextColor3 = Color3.fromRGB(200, 230, 200),
		TextSize = 11,
		Font = Enum.Font.Code,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		TextWrapped = true,
		Text = "",
		Parent = panel,
	})

	-- Partida
	local maps = section(scroll, "MAPA (★ = gold standard)", 1)
	for _, id in QAPanel.GoldMaps do
		mapButtons[id] = button(maps, "★ " .. id, function()
			selectedMap = id
			paintSelection()
		end)
	end
	for _, id in QAPanel.OtherMaps do
		mapButtons[id] = button(maps, id, function()
			selectedMap = id
			paintSelection()
		end)
	end
	local modes = section(scroll, "MODO", 3)
	for _, mode in GameConfig.Modes do
		modeButtons[mode] = button(modes, mode, function()
			selectedMode = mode
			paintSelection()
		end)
	end
	local match = section(scroll, "PARTIDA", 5)
	button(match, "Jugar ya", function()
		send("NextMatch", { Map = selectedMap, Mode = selectedMode, Now = true })
	end)
	button(match, "Al acabar", function()
		send("NextMatch", { Map = selectedMap, Mode = selectedMode, Now = false })
	end)
	button(match, "Empezar votado", function()
		send("StartNow")
	end)
	button(match, "Gana A", function()
		send("EndMatch", { Winner = 1 })
	end)
	button(match, "Gana B", function()
		send("EndMatch", { Winner = 2 })
	end)
	button(match, "Terminar", function()
		send("EndMatch", {})
	end)

	-- Jugador y armas
	local me = section(scroll, "JUGADOR", 7)
	button(me, "Reaparecer", function()
		send("Respawn")
	end)
	button(me, "ARX-27", function()
		send("Weapon", { Id = "ARX27" })
	end)
	local primaries = Weapons.Primaries or { "ARX27" }
	button(me, "Arma ▶", function(b)
		weaponIndex = weaponIndex % #primaries + 1
		local id = primaries[weaponIndex]
		local def = Weapons.Get(id)
		b.Text = (def and def.DisplayName or id) .. " ▶"
		send("Weapon", { Id = id })
	end)
	button(me, "Munición", function()
		send("Ammo")
	end)
	-- ARX-27 «gold standard» (Fase 9): el arma de referencia con su skin de muestra, SOLO en esta
	-- pantalla (no da la skin ni cambia nada guardado). Apagado: vuelve tu skin.
	toggle(me, "Gold", "ARX-27 Gold", function(on)
		ClientState.QASkinPreview = on and WeaponVisual.GoldSkin or nil
		send("Weapon", { Id = WeaponVisual.ReferenceWeapon })
		QAPanel.Log(on and ("ARX-27 con la skin de muestra " .. WeaponVisual.GoldSkin .. " (solo en tu pantalla)") or "ARX-27 con tu skin")
	end)

	-- Bots
	local bots = section(scroll, "BOTS (total jugadores + bots)", 9)
	button(bots, "+1 bot", function()
		send("Bots", { Delta = 1 })
	end)
	button(bots, "-1 bot", function()
		send("Bots", { Delta = -1 })
	end)
	button(bots, "5v5 (10)", function()
		send("Bots", { Set = 10 })
	end)
	button(bots, "Sin bots", function()
		send("Bots", { Set = 0 })
	end)

	-- Gráficos y rendimiento
	local gfx = section(scroll, "GRÁFICOS Y RENDIMIENTO", 11)
	button(gfx, "Calidad ▶", function(b)
		local okSettings, Settings = pcall(require, script.Parent.Settings)
		if not okSettings then
			QAPanel.Log("Settings no disponible")
			return
		end
		local levels = GameConfig.QualityLevels
		local currentLevel = Settings.Get().Quality
		local nextLevel = levels[(table.find(levels, currentLevel) or 0) % #levels + 1]
		Settings.Set("Quality", nextLevel)
		b.Text = "Calidad: " .. nextLevel
		QAPanel.Log("Calidad: " .. nextLevel .. " (aplicada: " .. tostring(ClientState.EffectiveQuality) .. ")")
	end)
	toggle(gfx, "Perf", "HUD rendimiento", setPerf)
	toggle(gfx, "Safe", "Zona segura", setSafeArea)

	-- Depuración visual
	local dbg = section(scroll, "DEPURACIÓN (apagado por defecto)", 13)
	toggle(dbg, "Spawns", "Spawns", function()
		QAPanel.RefreshDebug()
	end)
	toggle(dbg, "Objectives", "Objetivos A/B", function()
		QAPanel.RefreshDebug()
	end)
	toggle(dbg, "Bounds", "Límites", function()
		QAPanel.RefreshDebug()
	end)
	toggle(dbg, "BotSpots", "Puntos bots", function()
		QAPanel.RefreshDebug()
	end)
	toggle(dbg, "Routes", "Rutas bots", function(on)
		send("BotRoutes", { On = on })
	end)
	toggle(dbg, "Shots", "Disparos", function(on)
		ClientState.QAShotHook = on and drawShot or nil
	end)
	toggle(dbg, "Hits", "Telemetría", function(on)
		send("HitTelemetry", { On = on })
	end)

	-- Primeras partidas y prueba de 5 partidas
	local misc = section(scroll, "ONBOARDING Y PRUEBA DE 5 PARTIDAS", 15)
	toggle(misc, "NewPlayer", "Jugador nuevo", function(on)
		local okHints, Hints = pcall(require, script.Parent.Hints)
		if okHints then
			Hints.QAForceNew = on
			Hints.Reset()
		end
		QAPanel.Log(on and "Consejos como jugador de nivel 1 (sin tocar los datos)" or "Consejos: nivel real")
	end)
	button(misc, "Foto contadores", function()
		QAPanel.Snapshot()
	end)

	fitGrids(scroll)
	paintSelection()
	local function setOpen(visible)
		panel.Visible = visible
		open.BackgroundColor3 = visible and ON or Color3.fromRGB(150, 40, 40)
	end
	open.Activated:Connect(function()
		setOpen(not panel.Visible)
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and (input.KeyCode == Enum.KeyCode.F8 or input.KeyCode == Enum.KeyCode.BackSlash) then
			setOpen(not panel.Visible)
		end
	end)

	-- Rendimiento: etiqueta arriba a la derecha (apagada hasta que se pida)
	perfLabel = UI.new("TextLabel", {
		Name = "QAPerf",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 56),
		Size = UDim2.fromOffset(300, 146),
		BackgroundColor3 = DARK,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 12,
		Font = Enum.Font.Code,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = "",
		Visible = false,
		Parent = gui,
	})
end

local function updateStatus()
	if statusLabel then
		statusLabel.Text = string.format(
			"MODO QA (solo Studio) · %s · %s · %s\nSeleccionado: %s · %s",
			tostring(ReplicatedStorage:GetAttribute("State")),
			tostring(ReplicatedStorage:GetAttribute("MapName")),
			tostring(ReplicatedStorage:GetAttribute("Mode")),
			selectedMap,
			selectedMode
		)
	end
end

local function onServer(kind, payload)
	if kind == "Ack" or kind == "Error" then
		QAPanel.Log((kind == "Error" and "ERROR: " or "") .. tostring(payload))
	elseif kind == "Hit" and type(payload) == "table" then
		QAPanel.Log(string.format(
			"Impacto %s · %.1f st · holgura %.2f · cabeza: cliente %s / servidor %s · %s · ping %s",
			tostring(payload.Weapon),
			tonumber(payload.Distance) or 0,
			tonumber(payload.Slack) or 0,
			payload.ReportedHead and "sí" or "no",
			payload.Headshot and "sí" or "no",
			payload.Accepted and "aceptado" or "RECHAZADO",
			payload.PingMs and string.format("%.0f ms", payload.PingMs) or "n/d"
		))
	elseif kind == "Snapshot" and type(payload) == "table" then
		QAPanel.Log(string.format(
			"Foto servidor #%s · %s · %s · mapas %s · bots %s (modelos %s) · jugadores %s · instancias %s",
			tostring(payload.N), tostring(payload.Map), tostring(payload.Mode), tostring(payload.Maps),
			tostring(payload.BotAgents), tostring(payload.BotModels), tostring(payload.Players), tostring(payload.WorkspaceInstances)
		))
	end
end
QAPanel.OnServer = onServer

function QAPanel.Init()
	if not QA.IsActive() then
		return -- (producción: nada)
	end
	remote = ReplicatedStorage:WaitForChild(QA.RemoteName, 10)
	if not remote then
		warn("[QA] El servidor no ha creado el RemoteEvent del modo QA: panel desactivado")
		return
	end
	remote.OnClientEvent:Connect(onServer)
	build()
	QAPanel.Log("Modo QA activo. F8, \\ o el botón QA abren el panel.")
	-- Ayudas visuales: se rehacen con cada mapa nuevo
	ReplicatedStorage:GetAttributeChangedSignal("MapName"):Connect(function()
		task.wait(1)
		QAPanel.RefreshDebug()
	end)
	for _, attribute in { "State", "MapName", "Mode" } do
		ReplicatedStorage:GetAttributeChangedSignal(attribute):Connect(updateStatus)
	end
	updateStatus()
end

return QAPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="225">
            <Properties>
              <string name="Name">QuestTracker</string>
              <string name="Source"><![CDATA[-- Retos del día siempre a la vista (izquierda de la pantalla), con barra de progreso que se llena al
-- jugar y un aviso dorado al completarlos. Se oculta en la pantalla de inicio y al morir.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Sounds = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Sounds"))
local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local QuestTracker = {}
local phone = false

local gui, panel
local rows = {} -- [índice] = { Frame, Text, Fill, Count, Check, Done, Progress }

local GREEN = Color3.fromRGB(80, 230, 90)
-- Mientras se juega, el panel solo sale un rato (al aparecer y cuando avanza un reto): el HUD de combate
-- queda limpio. Con la partida parada (calentamiento, fin) se ve siempre
QuestTracker.ShowTime = 6
local shownUntil = 0
local GOLD = Color3.fromRGB(255, 205, 60)

local function makeRow(index)
	local frame = UI.new("Frame", {
		LayoutOrder = index,
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	local text = UI.label({
		Size = UDim2.new(1, -40, 0, 20),
		Text = "",
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})
	local count = UI.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(60, 20),
		Text = "",
		TextSize = 15,
		TextColor3 = Color3.fromRGB(210, 215, 230),
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = frame,
	})
	local bar = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 0, 12),
		BackgroundColor3 = Color3.fromRGB(30, 32, 44),
		BackgroundTransparency = 0.2,
		Parent = frame,
	}, { UI.corner(6), UI.stroke(Color3.new(0, 0, 0), 1.5, 0.4) })
	local fill = UI.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.fromRGB(70, 170, 255),
		Parent = bar,
	}, { UI.corner(6), UI.gloss() })
	local check = UI.label({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 4, 0, 30),
		Size = UDim2.fromOffset(22, 22),
		Text = "✔",
		TextSize = 20,
		TextColor3 = GREEN,
		Visible = false,
		Parent = frame,
	})
	return { Frame = frame, Text = text, Fill = fill, Count = count, Check = check, Done = nil, Progress = nil }
end

-- Destello dorado cuando se completa un reto
local function celebrate(row)
	Sounds.Play("Flag")
	local flash = UI.new("Frame", {
		Size = UDim2.new(1, 12, 1, 8),
		Position = UDim2.fromOffset(-6, -4),
		BackgroundColor3 = GOLD,
		BackgroundTransparency = 0.35,
		ZIndex = 0,
		Parent = row.Frame,
	}, { UI.corner(8) })
	TweenService:Create(flash, TweenInfo.new(1.2), { BackgroundTransparency = 1 }):Play()
	task.delay(1.3, function()
		flash:Destroy()
	end)
end

local function refresh(data)
	local challenges = data and data.Challenges
	local list = challenges and challenges.List or {}
	for i, entry in list do
		local row = rows[i] or makeRow(i)
		rows[i] = row
		row.Frame.Visible = true
		row.Text.Text = entry.Text or ""
		local goal = math.max(1, entry.Goal or 1)
		local progress = math.min(entry.Progress or 0, goal)
		row.Count.Text = entry.Done and "" or (progress .. "/" .. goal)
		row.Check.Visible = entry.Done == true
		row.Text.TextColor3 = entry.Done and GREEN or Color3.new(1, 1, 1)
		local ratio = entry.Done and 1 or progress / goal
		TweenService:Create(row.Fill, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { Size = UDim2.fromScale(ratio, 1) }):Play()
		row.Fill.BackgroundColor3 = entry.Done and GREEN or Color3.fromRGB(70, 170, 255)
		-- Solo celebra si lo hemos visto pasar de pendiente a hecho (no al cargar)
		if row.Done == false and entry.Done then
			shownUntil = os.clock() + QuestTracker.ShowTime
			celebrate(row)
		elseif row.Progress and progress > row.Progress and not entry.Done then
			shownUntil = os.clock() + QuestTracker.ShowTime
			-- Cada paso del reto se nota: el contador da un salto y la barra destella
			local scale = row.Count:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = row.Count })
			scale.Scale = 1.5
			TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
			row.Fill.BackgroundColor3 = Color3.new(1, 1, 1)
			TweenService:Create(row.Fill, TweenInfo.new(0.4), { BackgroundColor3 = Color3.fromRGB(70, 170, 255) }):Play()
		end
		row.Done = entry.Done == true
		row.Progress = progress
	end
	for i = #list + 1, #rows do
		rows[i].Frame.Visible = false
	end
	panel.Parent.Visible = #list > 0
end

function QuestTracker.Init()
	UI.WaitViewport()
	phone = UI.IsPhone()
	gui = UI.new("ScreenGui", {
		Name = "QuestTracker",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local holder = UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 66, 0.38, 0),
		Size = UDim2.fromOffset(250, 190),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	local scale = UI.new("UIScale", { Parent = holder })
	local function rescale()
		local size = camera.ViewportSize
		scale.Scale = math.clamp(math.min(size.X / 1280, size.Y / 720), 0.6, 1)
	end
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()
	UI.label({
		Size = UDim2.new(1, 0, 0, 24),
		Text = "🎯 RETOS DE HOY",
		TextSize = 18,
		TextColor3 = GOLD,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = holder,
	})
	panel = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 1, -28),
		BackgroundTransparency = 1,
		Parent = holder,
	}, { UI.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })

	ClientState.DataChanged.Event:Connect(refresh)
	refresh(ClientState.Data)
	player.CharacterAdded:Connect(function()
		shownUntil = os.clock() + QuestTracker.ShowTime
	end)
	local function update()
		local state = ReplicatedStorage:GetAttribute("State")
		local enabled = not ClientState.InMainMenu and not ClientState.Dead and not ClientState.MenuOpen
			and state ~= "Ended" -- (no encima del resumen de la partida)
			-- (con controles táctiles no cabe, ni en teléfono ni en tableta: a la izquierda van el joystick
			-- y las habilidades; los retos se ven en el menú y avisan al completarse. Se mira cada vez: el
			-- modo de control puede cambiar en la partida)
			and not phone and not InputMode.TouchUI()
			and (state ~= "Playing" or os.clock() < shownUntil)
		if gui.Enabled ~= enabled then
			gui.Enabled = enabled
		end
	end
	-- (su estado desde el principio, sin esperar al primer fotograma)
	update()
	RunService.Heartbeat:Connect(update)
end

return QuestTracker
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="226">
            <Properties>
              <string name="Name">RewardFX</string>
              <string name="Source"><![CDATA[-- Efectos de recompensa (la "chispa" de los shooters de móvil al hacer algo bien):
--   KillPulse:  al hacer una baja, los bordes de la pantalla destellan (rojo; dorado si es a la cabeza o
--               baja múltiple), el color del mundo se aviva un instante y suena un golpe grave con
--               un "ding" que sube de tono con cada baja seguida
--   AddScore:   contador de puntos de la jugada ("+250") que se acumula y cuenta hacia arriba mientras
--               sigues sumando, como en los shooters; se va solo a los 2,5 s sin sumar
--   Celebrate:  celebración a pantalla completa (rayos girando, confeti y fanfarria) para subir de
--               nivel, ascender de rango o sacar algo bueno en una caja
-- Todo en su propia pantalla, encima del HUD; en calidad Baja, menos confeti.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))

local Sounds = require(ReplicatedStorage.Shared.Sounds)
local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local RewardFX = {}

local KILL_RED = Color3.fromRGB(255, 50, 50)
local GOLD = Color3.fromRGB(255, 200, 40)
local CONFETTI = {
	Color3.fromRGB(255, 70, 90),
	Color3.fromRGB(255, 200, 40),
	Color3.fromRGB(80, 220, 255),
	Color3.fromRGB(120, 255, 120),
	Color3.fromRGB(200, 110, 255),
	Color3.new(1, 1, 1),
}

local gui
local edges = {}
local pulseCC
local scoreLabel, scoreScale
local scoreTotal, scoreShown, scoreToken = 0, 0, nil
local scoreFade -- el desvanecimiento en curso (se cancela si llegan más puntos)
local celebrating = false
local queue = {} -- celebraciones esperando turno (p. ej. récord y subir de rango a la vez)
local MAX_QUEUE = 2

local function tween(inst, time, props, style, direction)
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function lowQuality()
	return ClientState.EffectiveQuality == "Baja"
end

-- Teléfono (táctil y pantalla baja): todo un poco más pequeño y más arriba, para no tapar la mira
-- ni los botones
local function isPhone()
	return UI.IsPhone()
end
RewardFX.IsPhone = isPhone

-- Bordes de la pantalla: 4 franjas con degradado (opacas en el borde, transparentes hacia dentro)
local function buildEdges()
	local specs = {
		{ Vector2.new(0.5, 0), UDim2.fromScale(0.5, 0), UDim2.fromScale(1, 0.22), 90 },
		{ Vector2.new(0.5, 1), UDim2.fromScale(0.5, 1), UDim2.fromScale(1, 0.22), -90 },
		{ Vector2.new(0, 0.5), UDim2.fromScale(0, 0.5), UDim2.fromScale(0.16, 1), 0 },
		{ Vector2.new(1, 0.5), UDim2.fromScale(1, 0.5), UDim2.fromScale(0.16, 1), 180 },
	}
	for i, spec in specs do
		local frame = Instance.new("Frame")
		frame.Name = "Edge" .. i
		frame.AnchorPoint = spec[1]
		frame.Position = spec[2]
		frame.Size = spec[3]
		frame.BorderSizePixel = 0
		frame.BackgroundColor3 = KILL_RED
		frame.BackgroundTransparency = 1
		local gradient = Instance.new("UIGradient")
		gradient.Rotation = spec[4]
		gradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.6, 0.85),
			NumberSequenceKeypoint.new(1, 1),
		})
		gradient.Parent = frame
		frame.Parent = gui
		edges[i] = frame
	end
end

local function buildScore()
	scoreLabel = Instance.new("TextLabel")
	scoreLabel.Name = "ScoreTotal"
	-- (a la derecha y algo por debajo de la mira, como en los shooters: al crecer no la tapa)
	scoreLabel.AnchorPoint = Vector2.new(0, 0.5)
	-- (en el teléfono, a la derecha de la mira pero por encima: debajo salen los avisos)
	scoreLabel.Position = isPhone() and UDim2.new(0.5, 36, 0.5, -24) or UDim2.new(0.5, 36, 0.5, 30)
	-- (táctil, Fase 16: justo fuera del centro libre, a la derecha y por encima: la mira queda limpia)
	if InputMode.TouchUI() then
		local camera = workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize or Vector2.new(844, 390)
		local clear = math.min(viewport.X, viewport.Y) * 0.17
		scoreLabel.Position = UDim2.new(0.5, math.floor(clear + 8), 0.5, -math.floor(clear * 0.7))
	end
	scoreLabel.TextXAlignment = Enum.TextXAlignment.Left
	scoreLabel.Size = UDim2.fromOffset(220, 36)
	scoreLabel.BackgroundTransparency = 1
	scoreLabel.Font = Enum.Font.GothamBlack
	scoreLabel.TextSize = isPhone() and 26 or 32
	scoreLabel.TextColor3 = GOLD
	scoreLabel.TextStrokeTransparency = 0.2
	scoreLabel.Text = ""
	scoreLabel.Visible = false
	scoreLabel.Parent = gui
	scoreScale = Instance.new("UIScale")
	scoreScale.Parent = scoreLabel
end

function RewardFX.Init()
	-- (se espera a saber el tamaño de la pantalla: si no, una tablet podía quedarse con lo del teléfono)
	UI.WaitViewport()
	local player = Players.LocalPlayer
	gui = Instance.new("ScreenGui")
	gui.Name = "RewardFX"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 21 -- (encima de los menús y la ruleta: las celebraciones se ven siempre)
	-- (los destellos de los bordes llegan al borde real de la pantalla, también junto a la muesca; el
	-- contador va en el centro)
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.None
		gui.ClipToDeviceSafeArea = false
	end)
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")
	buildEdges()
	buildScore()
	-- El contador sube poco a poco hasta el total (se ve "contar" los puntos)
	RunService.RenderStepped:Connect(function(dt)
		if scoreShown < scoreTotal then
			scoreShown = math.min(scoreTotal, scoreShown + math.max(4, (scoreTotal - scoreShown) * dt * 9))
			scoreLabel.Text = "+" .. math.floor(scoreShown)
		end
	end)
end

-- Destello de los bordes
function RewardFX.EdgeFlash(color, strength)
	if not gui then
		return
	end
	strength = math.clamp(strength or 0.5, 0, 1)
	for _, edge in edges do
		edge.BackgroundColor3 = color
		edge.BackgroundTransparency = 1 - strength
		tween(edge, 0.45, { BackgroundTransparency = 1 })
	end
end

-- Al hacer una baja (multi = cuántas seguidas en pocos segundos)
function RewardFX.KillPulse(headshot, multi)
	multi = multi or 1
	local special = headshot or multi >= 2
	RewardFX.EdgeFlash(special and GOLD or KILL_RED, math.min(0.35 + 0.1 * multi, 0.7))
	-- El mundo se aviva un instante (más saturado y contrastado)
	if not pulseCC or not pulseCC.Parent then
		pulseCC = Instance.new("ColorCorrectionEffect")
		pulseCC.Name = "KillPulseCC"
		pulseCC.Parent = Lighting
	end
	pulseCC.Saturation = 0.35
	pulseCC.Contrast = 0.12
	pulseCC.Brightness = 0.04
	tween(pulseCC, 0.4, { Saturation = 0, Contrast = 0, Brightness = 0 })
	-- Golpe grave (el "ding" de la baja ya lo pone el marcador de impacto); en bajas seguidas, un
	-- acorde que sube de tono con cada una
	Sounds.Play("Boom", nil, 2.2, 0.18)
	if multi >= 2 then
		local step = 0.12 * math.min(multi - 2, 5)
		task.delay(0.08, function()
			Sounds.Play("Kill", nil, 1.26 + step, 0.5)
			task.wait(0.07)
			Sounds.Play("Kill", nil, 1.5 + step, 0.45)
		end)
	end
end

-- Suma puntos al contador de la jugada
function RewardFX.AddScore(amount)
	if not gui or type(amount) ~= "number" or amount <= 0 then
		return
	end
	if not scoreLabel.Visible then
		scoreTotal, scoreShown = 0, 0
		scoreLabel.Text = "+0"
	end
	if scoreFade then
		scoreFade:Cancel()
		scoreFade = nil
	end
	scoreTotal += amount
	-- (táctil, Fase 17: el hueco libre junto a la mira que calcula el HUD, ver layoutTouchHUD)
	local spot = ClientState.ScoreSpot
	if typeof(spot) == "Vector2" and InputMode.TouchUI() then
		local left = ClientState.ScoreSpotLeft == true
		scoreLabel.AnchorPoint = Vector2.new(left and 1 or 0, 0.5)
		scoreLabel.TextXAlignment = left and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left
		scoreLabel.Position = UDim2.fromOffset(math.floor(spot.X), math.floor(spot.Y))
	end
	scoreLabel.Visible = true
	scoreLabel.TextTransparency = 0
	scoreLabel.TextStrokeTransparency = 0.2
	-- (más grande y más naranja cuanto más llevas)
	scoreLabel.TextColor3 = GOLD:Lerp(Color3.fromRGB(255, 110, 40), math.clamp(scoreTotal / 1500, 0, 1))
	scoreScale.Scale = 1.35 + math.clamp(scoreTotal / 3000, 0, 0.4)
	tween(scoreScale, 0.25, { Scale = 1 + math.clamp(scoreTotal / 4000, 0, 0.3) }, Enum.EasingStyle.Back)
	local token = {}
	scoreToken = token
	task.delay(2.5, function()
		if scoreToken ~= token then
			return
		end
		scoreFade = tween(scoreLabel, 0.35, { TextTransparency = 1, TextStrokeTransparency = 1 })
		task.wait(0.35)
		if scoreToken == token then
			scoreLabel.Visible = false
		end
	end)
end

-- Saca la cantidad de un aviso de XP ("+120 XP  Baja" → 120)
function RewardFX.ParseXP(text)
	if type(text) ~= "string" then
		return nil
	end
	local amount = string.match(text, "^%+(%d+) XP")
	return amount and tonumber(amount) or nil
end

-- Confeti: trocitos de colores que salen disparados del centro y caen girando
local function confetti(parent, count)
	for _ = 1, count do
		local piece = Instance.new("Frame")
		piece.AnchorPoint = Vector2.new(0.5, 0.5)
		piece.Position = UDim2.fromScale(0.5 + (math.random() - 0.5) * 0.1, isPhone() and 0.25 or 0.35)
		piece.Size = UDim2.fromOffset(math.random(6, 12), math.random(10, 18))
		piece.BorderSizePixel = 0
		piece.BackgroundColor3 = CONFETTI[math.random(1, #CONFETTI)]
		piece.Rotation = math.random(0, 360)
		piece.ZIndex = 3
		piece.Parent = parent
		local angle = math.random() * math.pi * 2
		local spread = 0.15 + math.random() * 0.35
		local up = UDim2.fromScale(0.5 + math.cos(angle) * spread, 0.35 + math.sin(angle) * spread * 0.6 - 0.12)
		local fall = UDim2.fromScale(up.X.Scale + (math.random() - 0.5) * 0.15, 1.1)
		local burst = tween(piece, 0.45, { Position = up, Rotation = piece.Rotation + math.random(-180, 180) }, Enum.EasingStyle.Quad)
		burst.Completed:Once(function()
			if piece.Parent then
				tween(piece, 1.6 + math.random() * 0.8, {
					Position = fall,
					Rotation = piece.Rotation + math.random(-540, 540),
					BackgroundTransparency = 0.3,
				}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			end
		end)
	end
end

-- Fanfarria: tres notas que suben y un golpe grave
local function fanfare(big)
	Sounds.Play("Boom", nil, 1.6, big and 0.3 or 0.2)
	for i, pitch in { 1, 1.26, 1.5, big and 2 or nil } do
		task.delay((i - 1) * 0.11, function()
			Sounds.Play("Kill", nil, pitch, 0.6)
		end)
	end
end

-- Lluvia de confeti sola (p. ej. al ganar la partida, sin tapar el panel del resultado)
function RewardFX.Confetti(count)
	if not gui then
		return
	end
	local holder = Instance.new("Frame")
	holder.Name = "Confetti"
	holder.Size = UDim2.fromScale(1, 1)
	holder.BackgroundTransparency = 1
	holder.Parent = gui
	confetti(holder, math.floor((count or 40) * (lowQuality() and 0.45 or 1)))
	task.delay(3.5, function()
		holder:Destroy()
	end)
end

RewardFX.Fanfare = fanfare

-- Texto de golpe en el centro (p. ej. «¡A LUCHAR!» al empezar): entra enorme, se queda un momento y
-- se desvanece, con un golpe grave
function RewardFX.Punch(text, color)
	if not gui then
		return nil
	end
	local label = Instance.new("TextLabel")
	label.Name = "Punch"
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, isPhone() and 0.28 or 0.36)
	label.Size = UDim2.new(0.9, 0, 0, isPhone() and 56 or 90)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.Text = tostring(text)
	label.Parent = gui
	local fit = Instance.new("UITextSizeConstraint")
	fit.MaxTextSize = 80
	fit.Parent = label
	local scale = Instance.new("UIScale")
	scale.Scale = 2.5
	scale.Parent = label
	tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	Sounds.Play("Boom", nil, 1.3, 0.35)
	task.delay(0.9, function()
		tween(label, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
		tween(scale, 0.4, { Scale = 1.3 })
		task.wait(0.45)
		label:Destroy()
	end)
	return label
end

-- Monedas que salen del centro y vuelan hasta un contador (target: un GuiObject), con un "tin" al
-- llegar cada una y un saltito del contador al final
function RewardFX.FlyCoins(target, count, icon)
	if not gui or not target or typeof(target.AbsolutePosition) ~= "Vector2" then
		return
	end
	count = math.clamp(count or 8, 1, lowQuality() and 6 or 12)
	local goal = target.AbsolutePosition + target.AbsoluteSize / 2
	for i = 1, count do
		task.delay((i - 1) * 0.05, function()
			local coin = Instance.new("TextLabel")
			coin.AnchorPoint = Vector2.new(0.5, 0.5)
			coin.Position = UDim2.new(0.5, math.random(-90, 90), 0.5, math.random(-50, 50))
			coin.Size = UDim2.fromOffset(32, 32)
			coin.BackgroundTransparency = 1
			coin.Font = Enum.Font.GothamBold
			coin.TextSize = 28
			coin.Text = icon or "💰"
			coin.ZIndex = 4
			coin.Parent = gui
			tween(coin, 0.55, { Position = UDim2.fromOffset(goal.X, goal.Y) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.55, function()
				coin:Destroy()
				Sounds.Play("Click", nil, 1.3 + 0.06 * i, 0.5)
				if i == count then
					local scale = target:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
					scale.Parent = target
					scale.Scale = 1.3
					tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
				end
			end)
		end)
	end
end

-- Celebración a pantalla completa. title: texto grande; subtitle: debajo (opcional);
-- color: el de la celebración; big: más confeti y una nota más. Si ya hay una en pantalla, espera
-- su turno (devuelve true); si la cola está llena, nil
-- priority: pasa delante en la cola (y si está llena, echa a la última): subir de rango o de nivel no
-- se pierde nunca por otras celebraciones menores
function RewardFX.Celebrate(title, subtitle, color, big, priority)
	if not gui then
		return nil
	end
	if celebrating then
		local entry = { title, subtitle, color, big }
		if priority then
			if #queue >= MAX_QUEUE then
				table.remove(queue)
			end
			table.insert(queue, 1, entry)
			return true
		end
		if #queue >= MAX_QUEUE then
			return nil
		end
		table.insert(queue, entry)
		return true
	end
	celebrating = true
	color = color or GOLD
	local holder = Instance.new("Frame")
	holder.Name = "Celebration"
	holder.Size = UDim2.fromScale(1, 1)
	holder.BackgroundTransparency = 1
	holder.Parent = gui
	-- Rayos de luz girando detrás del título
	local rays = Instance.new("Frame")
	rays.AnchorPoint = Vector2.new(0.5, 0.5)
	local phone = isPhone()
	local titleY = phone and 0.22 or 0.33
	rays.Position = UDim2.fromScale(0.5, titleY)
	rays.Size = UDim2.fromOffset(10, 10)
	rays.BackgroundTransparency = 1
	rays.Parent = holder
	local rayCount = lowQuality() and 6 or 10
	for i = 1, rayCount do
		local ray = Instance.new("Frame")
		ray.AnchorPoint = Vector2.new(0.5, 0.5)
		ray.Position = UDim2.fromScale(0.5, 0.5)
		ray.Size = UDim2.fromOffset(46, 900)
		ray.Rotation = (i - 1) * (180 / rayCount)
		ray.BorderSizePixel = 0
		ray.BackgroundColor3 = color
		ray.BackgroundTransparency = 0.82
		local gradient = Instance.new("UIGradient")
		gradient.Rotation = 90
		gradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0),
			NumberSequenceKeypoint.new(1, 1),
		})
		gradient.Parent = ray
		ray.Parent = rays
	end
	local raysScale = Instance.new("UIScale")
	raysScale.Scale = 0.2
	raysScale.Parent = rays
	tween(raysScale, 0.5, { Scale = phone and 0.6 or 1 }, Enum.EasingStyle.Back)
	tween(rays, 3.2, { Rotation = 70 }, Enum.EasingStyle.Linear)
	-- Destello blanco de un instante
	local flash = Instance.new("Frame")
	flash.Size = UDim2.fromScale(1, 1)
	flash.BorderSizePixel = 0
	flash.BackgroundColor3 = Color3.new(1, 1, 1)
	flash.BackgroundTransparency = 0.55
	flash.Parent = holder
	tween(flash, 0.35, { BackgroundTransparency = 1 })
	RewardFX.EdgeFlash(color, 0.6)
	-- Título
	local label = Instance.new("TextLabel")
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, titleY)
	-- (ancho relativo y texto que se encoge: en un móvil en horizontal cabe entero)
	label.Size = UDim2.new(0.92, 0, 0, phone and 54 or 80)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextSize = 64
	label.TextScaled = true
	local fit = Instance.new("UITextSizeConstraint")
	fit.MaxTextSize = 64
	fit.Parent = label
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.Text = tostring(title)
	label.ZIndex = 2
	label.Parent = holder
	local scale = Instance.new("UIScale")
	scale.Scale = 2.4
	scale.Parent = label
	tween(scale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	local sub
	if subtitle then
		sub = Instance.new("TextLabel")
		sub.AnchorPoint = Vector2.new(0.5, 0)
		sub.Position = UDim2.new(0.5, 0, titleY, phone and 30 or 44)
		sub.Size = UDim2.new(0.9, 0, 0, phone and 24 or 34)
		sub.BackgroundTransparency = 1
		sub.Font = Enum.Font.GothamBold
		sub.TextSize = 26
		sub.TextScaled = true
		local subFit = Instance.new("UITextSizeConstraint")
		subFit.MaxTextSize = 26
		subFit.Parent = sub
		sub.TextColor3 = Color3.new(1, 1, 1)
		sub.TextStrokeTransparency = 0.2
		sub.TextTransparency = 1
		sub.Text = tostring(subtitle)
		sub.ZIndex = 2
		sub.Parent = holder
		task.delay(0.25, function()
			tween(sub, 0.3, { TextTransparency = 0 })
		end)
	end
	confetti(holder, math.floor((lowQuality() and 18 or (phone and 28 or 40)) * (big and 1.5 or 1)))
	fanfare(big)
	task.delay(2.6, function()
		tween(label, 0.5, { TextTransparency = 1, TextStrokeTransparency = 1 })
		if sub then
			tween(sub, 0.5, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
		for _, ray in rays:GetChildren() do
			if ray:IsA("Frame") then
				tween(ray, 0.5, { BackgroundTransparency = 1 })
			end
		end
		task.wait(0.9)
		holder:Destroy()
		celebrating = false
		local nextOne = table.remove(queue, 1)
		if nextOne then
			RewardFX.Celebrate(nextOne[1], nextOne[2], nextOne[3], nextOne[4])
		end
	end)
	return holder
end

return RewardFX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="227">
            <Properties>
              <string name="Name">RiflePose</string>
              <string name="Source"><![CDATA[-- Postura realista: los personajes (bots y los demás jugadores) sujetan el arma de fuego con las dos
-- manos, como soldados: la culata al hombro derecho, la mano derecha en la empuñadura y la izquierda en
-- el guardamanos; con pistola, los brazos estirados y las dos manos en la empuñadura. Usa IKControl (la
-- cinemática inversa de Roblox) solo en este cliente: no cambia nada del juego, solo cómo se ven. Con
-- el arma cuerpo a cuerpo, la granada o sin arma, la animación de siempre. Tu propio personaje no (en
-- primera persona no se ve). GameConfig.TwoHandedPose = false lo quita.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Weapons = require(ReplicatedStorage.Shared.Weapons)
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local RiflePose = {}

-- Medidas respecto al pecho (UpperTorso: X a la derecha, Y arriba, -Z hacia delante)
RiflePose.ButtAt = Vector3.new(0.15, 0.45, -0.2) -- dónde apoya la culata (en el pecho, hacia el hombro derecho)
RiflePose.PistolGrip = Vector3.new(0.1, 0.45, -1.5) -- empuñadura de la pistola, brazos estirados
local LEFT_SHOULDER = Vector3.new(-1, 0.56, 0)
-- Lo que llega el brazo (del hombro al agarre de la mano) en un R15 normal; cada personaje usa el suyo
-- (IKControl:GetChainLength)
RiflePose.Reach = 1.85
local POLE_RIGHT = Vector3.new(2.2, -1.6, 0.6) -- el codo derecho, abajo y hacia fuera
local POLE_LEFT = Vector3.new(-1.6, -1.8, -0.4) -- el codo izquierdo, abajo

local player = Players.LocalPlayer
local rigs = {} -- [Model] = { Right, Left, Grip, Hand, Connections }
local rearCache = {} -- [arma] = z de lo más trasero del arma (la culata), en el espacio del arma

-- Lo más trasero del arma (culata), a tamaño completo
local function rearOf(def, name)
	local cached = rearCache[name]
	if cached then
		return cached
	end
	local rear = 0
	for _, spec in def.Parts or {} do
		rear = math.max(rear, spec.CFrame.Position.Z + spec.Size.Z / 2)
	end
	rearCache[name] = rear
	return rear
end

-- Hacia dónde apunta arriba/abajo (atributo AimPitch del personaje, ver AimPitch): los brazos y el
-- arma giran alrededor del pecho
local PITCH_PIVOT = Vector3.new(0, 0.5, 0)
RiflePose.MaxPitch = 0.9 -- (unos 50°: más inclinado el arma se metería en la cabeza)
-- Retroceso al disparar (lo ven los demás): el arma va un poco hacia atrás y arriba un instante
local KICK = CFrame.new(0, 0.03, 0.14)
local KICK_UP = 0.07
local KICK_TIME = 0.06

-- Dónde van la mano derecha (con su giro: el arma mira hacia delante) y la izquierda, respecto al pecho.
-- Devuelve CFrame de la empuñadura y Vector3 de la mano izquierda, o nil si no es un arma de fuego
function RiflePose.Targets(weaponName, scale, pitch, reach)
	local def = weaponName and Weapons.Get(weaponName)
	if not def or def.Type ~= "Gun" or not def.RightHand then
		return nil
	end
	scale = scale or 1
	local right = def.RightHand * scale
	local left = (def.LeftHand or def.RightHand) * scale
	local handle -- dónde queda el origen del arma
	if def.Slot == 2 then
		handle = RiflePose.PistolGrip - right
	else
		-- La culata en el hombro: el arma se coloca para que su parte trasera quede ahí
		local rear = rearOf(def, weaponName) * scale
		handle = RiflePose.ButtAt - Vector3.new(0, 0, rear)
	end
	local grip = CFrame.new(handle + right)
	local hand = handle + left
	-- Si el guardamanos queda demasiado lejos para el brazo izquierdo, la mano se agarra más atrás (en el
	-- brocal del cargador, como hacen muchos tiradores)
	reach = reach or RiflePose.Reach
	local offset = hand - LEFT_SHOULDER
	if offset.Magnitude > reach then
		local side = offset.X * offset.X + offset.Y * offset.Y
		if side < reach * reach then
			hand = Vector3.new(hand.X, hand.Y, LEFT_SHOULDER.Z - math.sqrt(reach * reach - side))
		end
	end
	-- Apuntando arriba o abajo: todo gira alrededor del pecho
	pitch = math.clamp(tonumber(pitch) or 0, -RiflePose.MaxPitch, RiflePose.MaxPitch)
	if math.abs(pitch) > 0.01 then
		local turn = CFrame.new(PITCH_PIVOT) * CFrame.Angles(pitch, 0, 0) * CFrame.new(-PITCH_PIVOT)
		grip = turn * grip
		hand = turn * hand
	end
	return grip, hand
end

local function attachment(parent, name, position)
	local a = parent:FindFirstChild(name)
	if not (a and a:IsA("Attachment")) then
		a = Instance.new("Attachment")
		a.Name = name
		a.Parent = parent
	end
	if typeof(position) == "CFrame" then
		a.CFrame = position
	else
		a.Position = position
	end
	return a
end

local function heldGun(model)
	for _, child in model:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute("Weapon") then
			return child
		end
	end
	return nil
end

local function update(model)
	local rig = rigs[model]
	if not rig then
		return
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local tool = heldGun(model)
	local grip, hand
	if tool and humanoid and humanoid.Health > 0 then
		grip, hand = RiflePose.Targets(tool:GetAttribute("Weapon"), tool:GetAttribute("WorldScale") or 1, model:GetAttribute("AimPitch"), rig.Reach)
	end
	if grip and hand then
		-- (justo después de disparar, el golpe del retroceso)
		if os.clock() < (rig.KickUntil or 0) then
			grip = KICK * grip * CFrame.Angles(KICK_UP, 0, 0)
			hand += KICK.Position + Vector3.new(0, KICK_UP * 0.5, 0)
		end
		rig.Grip.CFrame = grip
		rig.Hand.Position = hand
		rig.Right.Enabled = true
		rig.Left.Enabled = true
		-- La cabeza mira hacia donde apunta (un poco: el resto lo hacen los brazos)
		if rig.Head and rig.Look then
			local pitch = math.clamp(tonumber(model:GetAttribute("AimPitch")) or 0, -RiflePose.MaxPitch, RiflePose.MaxPitch)
			rig.Look.Position = Vector3.new(0, 1.4, 0) + Vector3.new(0, math.sin(pitch), -math.cos(pitch)) * 10
			rig.Head.Enabled = true
		end
	else
		rig.Right.Enabled = false
		rig.Left.Enabled = false
		if rig.Head then
			rig.Head.Enabled = false
		end
	end
end

-- Alguien dispara: su arma da el golpe del retroceso (y vuelve)
function RiflePose.Kick(model)
	local rig = rigs[model]
	if not rig then
		return false
	end
	rig.KickUntil = os.clock() + KICK_TIME
	update(model)
	task.delay(KICK_TIME + 0.01, function()
		if rigs[model] == rig then
			update(model)
		end
	end)
	return true
end

local function release(model)
	local rig = rigs[model]
	if not rig then
		return
	end
	rigs[model] = nil
	for _, connection in rig.Connections do
		connection:Disconnect()
	end
	for _, instance in { rig.Right, rig.Left, rig.Head, rig.Grip, rig.Hand, rig.Look, rig.PoleRight, rig.PoleLeft } do
		if instance then
			instance:Destroy()
		end
	end
end

function RiflePose.Setup(model)
	if GameConfig.TwoHandedPose == false or rigs[model] or (player and model == player.Character) then
		return
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local torso = model:FindFirstChild("UpperTorso")
	local rightArm, leftArm = model:FindFirstChild("RightUpperArm"), model:FindFirstChild("LeftUpperArm")
	local rightHand, leftHand = model:FindFirstChild("RightHand"), model:FindFirstChild("LeftHand")
	-- (solo personajes R15 con sus manos)
	if not (humanoid and torso and rightArm and leftArm and rightHand and leftHand) then
		return
	end
	local rightGrip = rightHand:FindFirstChild("RightGripAttachment")
	if not rightGrip then
		return
	end
	local leftGrip = leftHand:FindFirstChild("LeftGripAttachment") or leftHand
	local grip = attachment(torso, "PoseGrip", CFrame.new())
	local hand = attachment(torso, "PoseLeftHand", Vector3.zero)
	local poleRight = attachment(torso, "PoseElbowR", POLE_RIGHT)
	local poleLeft = attachment(torso, "PoseElbowL", POLE_LEFT)

	local right = Instance.new("IKControl")
	right.Name = "PoseRightArm"
	right.Type = Enum.IKControlType.Transform
	right.ChainRoot = rightArm
	right.EndEffector = rightGrip
	right.Target = grip
	right.Pole = poleRight
	right.SmoothTime = 0.05
	right.Weight = 1
	right.Enabled = false
	right.Parent = humanoid

	local left = Instance.new("IKControl")
	left.Name = "PoseLeftArm"
	left.Type = Enum.IKControlType.Position
	left.ChainRoot = leftArm
	left.EndEffector = leftGrip
	left.Target = hand
	left.Pole = poleLeft
	left.SmoothTime = 0.05
	left.Weight = 1
	left.Enabled = false
	left.Parent = humanoid

	-- La cabeza (solo el cuello) mira un poco hacia donde apunta
	local head = model:FindFirstChild("Head")
	local headIK, look = nil, nil
	if head and head:IsA("BasePart") then
		look = attachment(torso, "PoseLook", Vector3.new(0, 1.4, -10))
		headIK = Instance.new("IKControl")
		headIK.Name = "PoseHead"
		headIK.Type = Enum.IKControlType.LookAt
		headIK.ChainRoot = torso
		headIK.EndEffector = head
		headIK.Target = look
		headIK.SmoothTime = 0.1
		headIK.Weight = 0.6
		headIK.Enabled = false
		headIK.Parent = humanoid
	end

	-- (lo que llega de verdad el brazo izquierdo de este personaje; si no se puede medir, lo normal)
	local okLength, chain = pcall(function()
		return left:GetChainLength()
	end)
	local reach = (okLength and type(chain) == "number" and chain > 1 and chain < 4) and chain * 0.97 or RiflePose.Reach
	local rig = {
		Reach = reach,
		Right = right,
		Left = left,
		Head = headIK,
		Look = look,
		Grip = grip,
		Hand = hand,
		PoleRight = poleRight,
		PoleLeft = poleLeft,
		Connections = {},
	}
	rigs[model] = rig
	table.insert(rig.Connections, model.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			update(model)
		end
	end))
	table.insert(rig.Connections, model.ChildRemoved:Connect(function(child)
		if child:IsA("Tool") then
			update(model)
		end
	end))
	-- (apunta arriba o abajo: el arma se inclina)
	table.insert(rig.Connections, model:GetAttributeChangedSignal("AimPitch"):Connect(function()
		update(model)
	end))
	-- Al morir, el cuerpo cae suelto (Ragdoll): nada de sujetar el arma
	table.insert(rig.Connections, humanoid.Died:Connect(function()
		release(model)
	end))
	table.insert(rig.Connections, model.AncestryChanged:Connect(function()
		if not model.Parent then
			release(model)
		end
	end))
	update(model)
end

-- (para las pruebas)
function RiflePose.Rig(model)
	return rigs[model]
end

local function watchPlayer(other)
	if other == player then
		return
	end
	other.CharacterAdded:Connect(function(character)
		-- (las piezas del personaje llegan un poco después)
		character:WaitForChild("UpperTorso", 10)
		character:WaitForChild("RightHand", 10)
		character:WaitForChild("LeftHand", 10)
		RiflePose.Setup(character)
	end)
	if other.Character then
		task.spawn(RiflePose.Setup, other.Character)
	end
end

function RiflePose.Init()
	if GameConfig.TwoHandedPose == false then
		return
	end
	-- Los disparos de los demás (jugadores y bots): golpe de retroceso en su arma
	Remotes.ShotFX.OnClientEvent:Connect(function(tool)
		if typeof(tool) == "Instance" and tool.Parent then
			RiflePose.Kick(tool.Parent)
		end
	end)
	for _, other in Players:GetPlayers() do
		watchPlayer(other)
	end
	Players.PlayerAdded:Connect(watchPlayer)
	local function watchBots(folder)
		for _, model in folder:GetChildren() do
			if model:IsA("Model") then
				task.spawn(RiflePose.Setup, model)
			end
		end
		folder.ChildAdded:Connect(function(model)
			if model:IsA("Model") then
				task.wait(0.2) -- (el bot se monta entero antes de entrar en la carpeta, pero por si acaso)
				RiflePose.Setup(model)
			end
		end)
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		watchBots(bots)
	end
	workspace.ChildAdded:Connect(function(child)
		if child.Name == "Bots" and child:IsA("Folder") then
			watchBots(child)
		end
	end)
end

return RiflePose
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="228">
            <Properties>
              <string name="Name">ScopeGlint</string>
              <string name="Source"><![CDATA[-- Destello de la mira (como en los shooters): un bot tirador enemigo que está quieto y mira hacia
-- ti brilla a lo lejos, así puedes saber desde dónde te apunta. Solo en el cliente; las paredes lo
-- tapan (no es un contorno a través de los muros).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local ScopeGlint = {}

local MIN_DISTANCE = 35 -- de cerca no hace falta
local MAX_DISTANCE = 450
local FACING = 0.93 -- coseno del ángulo: tiene que mirar casi hacia la cámara
local CHECK_INTERVAL = 0.1

local player = Players.LocalPlayer
local glints = {} -- [modelo del bot] = BillboardGui

local function isEnemy(model)
	if ReplicatedStorage:GetAttribute("TeamMode") == false then
		return true
	end
	local team = model:GetAttribute("Team")
	return team == nil or player.Team == nil or team ~= player.Team.Name
end

local function makeGlint(head)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ScopeGlint"
	billboard.Size = UDim2.fromOffset(30, 30)
	billboard.StudsOffset = Vector3.new(0.4, 0.1, 0)
	billboard.LightInfluence = 0
	billboard.AlwaysOnTop = false
	billboard.MaxDistance = MAX_DISTANCE
	billboard.Adornee = head
	-- Un punto blanco con un aro y dos rayos en cruz
	local core = Instance.new("Frame")
	core.Name = "Core"
	core.AnchorPoint = Vector2.new(0.5, 0.5)
	core.Position = UDim2.fromScale(0.5, 0.5)
	core.Size = UDim2.fromScale(0.42, 0.42)
	core.BackgroundColor3 = Color3.fromRGB(255, 255, 235)
	core.BorderSizePixel = 0
	core.Parent = billboard
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = core
	for _, size in { UDim2.fromScale(1, 0.08), UDim2.fromScale(0.08, 1) } do
		local ray = Instance.new("Frame")
		ray.AnchorPoint = Vector2.new(0.5, 0.5)
		ray.Position = UDim2.fromScale(0.5, 0.5)
		ray.Size = size
		ray.BackgroundColor3 = Color3.fromRGB(255, 250, 210)
		ray.BackgroundTransparency = 0.25
		ray.BorderSizePixel = 0
		ray.Parent = billboard
	end
	billboard.Parent = head
	return billboard
end

local function update()
	local folder = workspace:FindFirstChild("Bots")
	local camera = workspace.CurrentCamera
	local seen = {}
	if folder and camera then
		local cameraPosition = camera.CFrame.Position
		for _, model in folder:GetChildren() do
			if model:GetAttribute("Role") ~= "Tirador" or not isEnemy(model) then
				continue
			end
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart")
			local head = model:FindFirstChild("Head")
			if not (humanoid and root and head and root:IsA("BasePart") and head:IsA("BasePart")) or humanoid.Health <= 0 then
				continue
			end
			local offset = cameraPosition - head.Position
			local distance = offset.Magnitude
			local velocity = root.AssemblyLinearVelocity
			local still = Vector3.new(velocity.X, 0, velocity.Z).Magnitude < 4
			if distance > MIN_DISTANCE and distance < MAX_DISTANCE and still then
				local look = root.CFrame.LookVector
				local flatLook = Vector3.new(look.X, 0, look.Z)
				local flatOffset = Vector3.new(offset.X, 0, offset.Z)
				if flatLook.Magnitude > 0.01 and flatOffset.Magnitude > 0.01 and flatLook.Unit:Dot(flatOffset.Unit) > FACING then
					seen[model] = true
					local glint = glints[model]
					if not glint or glint.Parent ~= head then
						if glint then
							glint:Destroy()
						end
						glint = makeGlint(head)
						glints[model] = glint
					end
					-- (parpadea un poco, como el reflejo del sol en la lente)
					local pulse = 0.5 + 0.5 * math.sin(os.clock() * 9)
					local core = glint:FindFirstChild("Core")
					if core and core:IsA("Frame") then
						core.BackgroundTransparency = 0.05 + 0.3 * pulse
					end
					glint.Size = UDim2.fromOffset(26 + 10 * pulse, 26 + 10 * pulse)
				end
			end
		end
	end
	for model, glint in glints do
		if not seen[model] then
			glint:Destroy()
			glints[model] = nil
		end
	end
end

function ScopeGlint.Init()
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < CHECK_INTERVAL then
			return
		end
		elapsed = 0
		update()
	end)
end

ScopeGlint.Update = update
return ScopeGlint
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="229">
            <Properties>
              <string name="Name">ScopeSway</string>
              <string name="Source"><![CDATA[-- Visor de francotirador realista: con el visor puesto la mira nunca está del todo quieta (el pulso y
-- la respiración la mueven en un "ocho" lento y pequeño). Con Mayús (o el stick izquierdo pulsado en el
-- mando) aguantas la respiración unos 3,5 s y la mira se queda casi quieta; al acabarse el aire se
-- mueve más un momento hasta recuperarlo. Agachado se mueve menos; en el móvil, la mitad (allí no hay
-- tecla para aguantar). WeaponController aplica a la cámara lo que devuelve Update cada fotograma.
local UserInputService = game:GetService("UserInputService")
local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))

local ClientState = require(script.Parent.ClientState)

local ScopeSway = {}

ScopeSway.Amplitude = math.rad(0.22) -- cuánto se mueve la mira con el visor (sin aguantar)
ScopeSway.HoldTime = 3.5 -- segundos que se aguanta la respiración
ScopeSway.RecoverTime = 2.5 -- segundos para recuperar todo el aire
ScopeSway.ExhaleTime = 1.2 -- al quedarte sin aire, este rato se mueve el doble
ScopeSway.Holding = false -- aguantando la respiración ahora mismo (el HUD lo dice en el visor)
ScopeSway.Breath = 1 -- aire que queda (0..1)

local exhaleUntil = 0
local amp = 0
local lastPitch, lastYaw = 0, 0

local function holdPressed()
	local ok, down = pcall(function()
		if UserInputService:GetFocusedTextBox() then
			return false
		end
		return UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
			or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
			or UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonL3)
	end)
	return ok and down == true
end

local function touchOnly()
	return InputMode.TouchUI()
end

-- Cuánto se mueve ahora mismo (radianes; 0 sin visor)
function ScopeSway.Amount()
	return amp
end

-- ¿Sin aire (recuperándolo tras aguantar demasiado)?
function ScopeSway.OutOfBreath()
	return os.clock() < exhaleUntil
end

-- Devuelve el giro (cabeceo, guiñada) que hay que sumar a la cámara en ESTE fotograma: la diferencia
-- con el balanceo del anterior (así no se acumula y al quitar el visor vuelve solo a su sitio)
function ScopeSway.Update(dt, scoped)
	local now = os.clock()
	local holding = false
	if scoped and now >= exhaleUntil and ScopeSway.Breath > 0 and holdPressed() then
		holding = true
		ScopeSway.Breath = math.max(0, ScopeSway.Breath - dt / ScopeSway.HoldTime)
		if ScopeSway.Breath <= 0 then
			exhaleUntil = now + ScopeSway.ExhaleTime
		end
	else
		ScopeSway.Breath = math.min(1, ScopeSway.Breath + dt / ScopeSway.RecoverTime)
	end
	ScopeSway.Holding = holding
	local target = 0
	if scoped then
		target = ScopeSway.Amplitude
		if holding then
			target *= 0.08
		elseif now < exhaleUntil then
			target *= 2
		end
		if ClientState.Crouching then
			target *= 0.6
		end
		if touchOnly() then
			target *= 0.5
		end
	end
	amp += (target - amp) * math.min(1, dt * 4)
	local pitch = (math.sin(now * 0.9) * 0.6 + math.sin(now * 2.3) * 0.15) * amp
	local yaw = (math.sin(now * 0.55) + math.sin(now * 1.7) * 0.2) * amp
	local dPitch, dYaw = pitch - lastPitch, yaw - lastYaw
	lastPitch, lastYaw = pitch, yaw
	return dPitch, dYaw
end

-- Al morir o reaparecer: todo a cero (la cámara nueva no arrastra el balanceo de antes)
function ScopeSway.Reset()
	amp, lastPitch, lastYaw = 0, 0, 0
	exhaleUntil = 0
	ScopeSway.Breath = 1
	ScopeSway.Holding = false
end

return ScopeSway
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="230">
            <Properties>
              <string name="Name">Scoreboard</string>
              <string name="Source"><![CDATA[-- Marcador de la partida (mantén Tab; en móvil, botón 📋): los dos equipos en columnas (o una sola
-- lista en los modos sin equipos) con bajas, muertes y puntos. Incluye a los bots (ReplicatedStorage.
-- BotStats, que rellena el servidor) y resalta tu fila. Sustituye a la lista de jugadores de Roblox.
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Ranks = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Ranks"))
local PlayerCards = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("PlayerCards"))
local ClientState = require(script.Parent.ClientState)
local TouchLayout = require(script.Parent.TouchLayout)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local Scoreboard = {}

local gui, panel, title, columns
local visible = false
local ROW_HEIGHT = 30
-- Columnas de números (bajas, asistencias, muertes y la del modo): ancho de cada una y dónde empiezan
local COL_W = 64
local COLS_X = 4 * COL_W + 12
local MAX_ROWS = 10

-- Una fila por jugador o bot: { Name, Team, Kills, Deaths, Score, Captures, IsBot, IsMe }
local function collect()
	local rows = {}
	for _, p in Players:GetPlayers() do
		local stats = p:FindFirstChild("leaderstats")
		local kills = stats and stats:FindFirstChild("Bajas")
		local deaths = stats and stats:FindFirstChild("Muertes")
		local rank = Ranks.Tiers[p:GetAttribute("Rank") or 0]
		-- Título elegido (Titles), pequeño y de su color detrás del nombre
		local title = p:GetAttribute("Title")
		local titleColor = p:GetAttribute("TitleColor")
		local titleText = ""
		if type(title) == "string" and title ~= "" then
			local hex = typeof(titleColor) == "Color3" and titleColor:ToHex() or "C8C8D2"
			titleText = string.format('  <font size="14" color="#%s">%s</font>', hex, title)
		end
		table.insert(rows, {
			Name = (rank and (rank.Icon .. " ") or "") .. p.DisplayName .. titleText,
			Team = p.Team,
			Kills = kills and kills.Value or 0,
			Deaths = deaths and deaths.Value or 0,
			Assists = p:GetAttribute("MatchAssists") or 0,
			Score = p:GetAttribute("Score") or 0,
			Captures = p:GetAttribute("Captures") or 0,
			InMenu = p:GetAttribute("InMenu") == true,
			IsMe = p == player,
			Card = p:GetAttribute("Card"), -- tarjeta de jugador (franja de su color a la izquierda)
		})
	end
	local bots = ReplicatedStorage:FindFirstChild("BotStats")
	if bots then
		for _, entry in bots:GetChildren() do
			local teamName = entry:GetAttribute("Team")
			local team = teamName and teamName ~= "" and Teams:FindFirstChild(teamName) or nil
			table.insert(rows, {
				Name = "🤖 " .. entry.Name,
				Team = team,
				Kills = entry:GetAttribute("Kills") or 0,
				Deaths = entry:GetAttribute("Deaths") or 0,
				Assists = "–", -- (los bots no llevan la cuenta de asistencias)
				Score = entry:GetAttribute("Score") or 0,
				Captures = 0,
				IsBot = true,
			})
		end
	end
	return rows
end

local function header(parent, text, color)
	local bar = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = color,
		Parent = parent,
	}, { UI.corner(8) })
	UI.label({
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -24, 1, 0),
		Text = text,
		TextSize = 22,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = bar,
	})
	return bar
end

local function columnTitles(parent, y, third)
	local frame = UI.new("Frame", {
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	for i, text in { "JUGADOR", "BAJAS", "ASIST.", "MUERTES", third } do
		UI.label({
			Position = i == 1 and UDim2.fromOffset(12, 0) or UDim2.new(1, -COLS_X + (i - 2) * COL_W, 0, 0),
			Size = i == 1 and UDim2.new(1, -(COLS_X + 12), 0, 22) or UDim2.fromOffset(COL_W, 22),
			Text = text,
			TextSize = 14,
			TextColor3 = Color3.fromRGB(200, 200, 220),
			TextXAlignment = i == 1 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center,
			Parent = frame,
		})
	end
end

local function rowFrame(parent, y, row, thirdValue, color)
	local frame = UI.new("Frame", {
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.new(1, 0, 0, ROW_HEIGHT - 2),
		BackgroundColor3 = row.IsMe and Color3.fromRGB(255, 205, 60) or color,
		BackgroundTransparency = row.IsMe and 0.25 or 0.65,
		Parent = parent,
	}, { UI.corner(6) })
	local card = row.Card and PlayerCards.List[row.Card]
	if card then
		UI.new("Frame", {
			Name = "CardStripe",
			Position = UDim2.fromOffset(0, 2),
			Size = UDim2.new(0, 6, 1, -4),
			BackgroundColor3 = card.Border,
			BorderSizePixel = 0,
			Parent = frame,
		}, { UI.corner(3), UI.new("UIGradient", { Rotation = 90, Color = ColorSequence.new(card.Top, card.Border) }) })
	end
	UI.label({
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -(COLS_X + 12), 1, 0),
		Text = row.Name .. (row.InMenu and "  💤" or ""),
		RichText = true,
		TextSize = 18,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = row.IsBot and Color3.fromRGB(215, 215, 230) or Color3.new(1, 1, 1),
		Parent = frame,
	})
	for i, value in { row.Kills, row.Assists or 0, row.Deaths, thirdValue } do
		UI.label({
			Position = UDim2.new(1, -COLS_X + (i - 1) * COL_W, 0, 0),
			Size = UDim2.fromOffset(COL_W, ROW_HEIGHT - 2),
			Text = tostring(value),
			TextSize = 19,
			Parent = frame,
		})
	end
end

-- Columna de un equipo (o de todos en los modos sin equipos)
local function buildColumn(x, width, headerText, headerColor, rows, thirdTitle, thirdOf)
	local column = UI.new("Frame", {
		Position = UDim2.fromOffset(x, 56),
		Size = UDim2.fromOffset(width, 60 + MAX_ROWS * ROW_HEIGHT),
		BackgroundTransparency = 1,
		Parent = columns,
	})
	header(column, headerText, headerColor)
	columnTitles(column, 38, thirdTitle)
	-- Si no caben todos, tu fila siempre sale (en el último hueco)
	local shown = table.move(rows, 1, math.min(#rows, MAX_ROWS), 1, {})
	for i = MAX_ROWS + 1, #rows do
		if rows[i].IsMe then
			shown[MAX_ROWS] = rows[i]
		end
	end
	for i, row in shown do
		rowFrame(column, 60 + (i - 1) * ROW_HEIGHT, row, thirdOf(row), headerColor:Lerp(Color3.new(0, 0, 0), 0.4))
	end
	return column
end

local lastSignature = ""

local function refresh()
	if not visible then
		return
	end
	local mode = ReplicatedStorage:GetAttribute("Mode")
	local teamMode = ReplicatedStorage:GetAttribute("TeamMode") ~= false
	local mapName = ReplicatedStorage:GetAttribute("MapName") or ""
	local modeName = ReplicatedStorage:GetAttribute("ModeName") or ""
	title.Text = UI.upper(modeName) .. "  ·  " .. mapName .. "  ·  " .. UI.formatTime(ReplicatedStorage:GetAttribute("TimeLeft") or 0)
	local rows = collect()
	-- Solo se reconstruye si ha cambiado algo (si no, cada medio segundo se crearían ~150 objetos)
	local parts = { tostring(mode), tostring(ReplicatedStorage:GetAttribute("TeamMode")), tostring(ReplicatedStorage:GetAttribute("LeaderName")) }
	for _, row in rows do
		table.insert(parts, string.format("%s/%s/%d/%s/%d/%d/%d/%s", row.Name, tostring(row.Team), row.Kills, tostring(row.Assists or 0), row.Deaths, row.Score, row.Captures, tostring(row.InMenu)))
	end
	for _, teamName in { ReplicatedStorage:GetAttribute("TeamA"), ReplicatedStorage:GetAttribute("TeamB") } do
		table.insert(parts, tostring(teamName and ReplicatedStorage:GetAttribute("Score_" .. teamName)))
	end
	local signature = table.concat(parts, "|")
	if signature == lastSignature and #columns:GetChildren() > 0 then
		return
	end
	lastSignature = signature
	columns:ClearAllChildren()
	local thirdTitle, thirdOf = "PUNTOS", function(row)
		return row.Score
	end
	if mode == "CTF" then
		thirdTitle, thirdOf = "CAPTURAS", function(row)
			return row.Captures
		end
	elseif teamMode then
		thirdTitle, thirdOf = "K/D", function(row)
			return string.format("%.1f", row.Kills / math.max(1, row.Deaths))
		end
	end
	local function byKills(a, b)
		if a.Kills ~= b.Kills then
			return a.Kills > b.Kills
		end
		return a.Deaths < b.Deaths
	end
	if teamMode then
		local nameA = ReplicatedStorage:GetAttribute("TeamA")
		local nameB = ReplicatedStorage:GetAttribute("TeamB")
		for i, teamName in { nameA, nameB } do
			local team = teamName and Teams:FindFirstChild(teamName)
			local list = {}
			for _, row in rows do
				if team and row.Team == team then
					table.insert(list, row)
				end
			end
			table.sort(list, byKills)
			local color = team and team:IsA("Team") and team.TeamColor.Color or Color3.fromRGB(80, 80, 100)
			local score = teamName and (ReplicatedStorage:GetAttribute("Score_" .. teamName) or 0) or 0
			local text = string.format("<b>%s</b>   %d", UI.upper(teamName or "?"), score)
			buildColumn((i - 1) * 472, 440, text, color, list, thirdTitle, thirdOf)
		end
		panel.Size = UDim2.fromOffset(940, 56 + 60 + MAX_ROWS * ROW_HEIGHT + 16)
	else
		table.sort(rows, function(a, b)
			if a.Score ~= b.Score then
				return a.Score > b.Score
			end
			return byKills(a, b)
		end)
		local leader = ReplicatedStorage:GetAttribute("LeaderName")
		buildColumn(0, 572, "<b>TODOS CONTRA TODOS</b>" .. ((leader and leader ~= "") and ("   👑 " .. leader) or ""), Color3.fromRGB(200, 120, 40), rows, thirdTitle, thirdOf)
		panel.Size = UDim2.fromOffset(600, 56 + 60 + MAX_ROWS * ROW_HEIGHT + 16)
	end
end

local function setVisible(on)
	on = on and not ClientState.InMainMenu
	if on == visible then
		return
	end
	visible = on
	gui.Enabled = on
	refresh()
end

function Scoreboard.Init()
	-- La lista de jugadores de Roblox no enseña a los bots ni los equipos así: se usa esta
	task.spawn(function()
		for _ = 1, 20 do
			if pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.PlayerList, false) then
				return
			end
			task.wait(0.5)
		end
	end)
	gui = UI.new("ScreenGui", {
		Name = "Scoreboard",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 4,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	panel = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.48),
		Size = UDim2.fromOffset(940, 420),
		BackgroundColor3 = Color3.fromRGB(18, 20, 34),
		BackgroundTransparency = 0.12,
		Parent = gui,
	}, { UI.corner(16), UI.stroke(Color3.new(1, 1, 1), 3, 0.6), UI.padding(14) })
	local scale = UI.new("UIScale", { Parent = panel })
	local function fit()
		local viewport = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.clamp(math.min((viewport.X - 30) / panel.Size.X.Offset, (viewport.Y - 30) / panel.Size.Y.Offset), 0.4, 1)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	panel:GetPropertyChangedSignal("Size"):Connect(fit)
	title = UI.label({
		Size = UDim2.new(1, 0, 0, 40),
		Text = "",
		TextSize = 26,
		Parent = panel,
	})
	columns = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = panel })
	fit()

	-- Tab: se ve mientras se mantiene pulsado. En móvil el botón 📋 lo abre y lo cierra.
	TouchLayout.BindAction("Scoreboard", function(_, state, input)
		if input and input.UserInputType == Enum.UserInputType.Touch then
			if state == Enum.UserInputState.Begin then
				setVisible(not visible)
			end
		elseif state == Enum.UserInputState.Begin then
			setVisible(true)
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			setVisible(false)
		end
		return Enum.ContextActionResult.Pass
	end, UserInputService.TouchEnabled, Enum.KeyCode.Tab)
	-- Si la ventana pierde el foco con Tab pulsado, no llega el "soltar": se cierra igualmente
	UserInputService.WindowFocusReleased:Connect(function()
		if not UserInputService.TouchEnabled then
			setVisible(false)
		end
	end)
	TouchLayout.Set("Scoreboard", UDim2.new(1, -60, 0, 70))

	task.spawn(function()
		while true do
			task.wait(0.5)
			if visible and ClientState.InMainMenu then
				setVisible(false)
			end
			refresh()
		end
	end)
end

return Scoreboard
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="231">
            <Properties>
              <string name="Name">Settings</string>
              <string name="Source"><![CDATA[-- Ajustes del jugador en el cliente: calidad gráfica, campo de visión y sensibilidad.
-- Los cambios de Lighting hechos en el cliente solo afectan a este jugador.
--
-- Calidad:
--   Auto  : Baja en móviles (solo táctil) y Media en PC
--   Baja  : sin sombras, sin bloom, sin rayos de sol, sin nubes ni partículas del mapa (móviles)
--   Media : sombras y bloom, sin rayos de sol ni conos de luz, menos partículas del mapa
--   Alta  : todo como lo diseñó el mapa
--   Ultra : además, un desenfoque muy suave del horizonte (más allá de 250 studs) y más partículas
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local MobileHUD = require(Shared.MobileHUD)

local ClientState = require(script.Parent.ClientState)

local Settings = {}

local PARTICLE_FACTOR = { Baja = 0, Media = 0.4, Alta = 1, Ultra = 1.3 }

local current = table.clone(GameConfig.DefaultSettings)
ClientState.Settings = current

-- Calidad que se aplica de verdad ("Auto" según el dispositivo)
local function effectiveQuality()
	local q = current.Quality
	if q == "Auto" or not PARTICLE_FACTOR[q] then
		local touchOnly = InputMode.TouchUI()
		return touchOnly and "Baja" or "Media"
	end
	return q
end

-- Partículas ambientales del mapa (nieve, hojas, chispas, humo): se escalan según la calidad
local function scaleEmitter(emitter)
	if not emitter:IsA("ParticleEmitter") then
		return
	end
	local map = workspace:FindFirstChild("Map")
	if not map or not emitter:IsDescendantOf(map) then
		return
	end
	local base = emitter:GetAttribute("BaseRate")
	if base == nil then
		base = emitter.Rate
		emitter:SetAttribute("BaseRate", base)
	end
	local factor = PARTICLE_FACTOR[effectiveQuality()] or 1
	emitter.Rate = base * factor
	emitter.Enabled = factor > 0
end

-- Focos con sombras reales: solo en calidad Alta y Ultra
local function applyLightShadow(inst)
	if inst:IsA("Light") and inst:GetAttribute("QualityShadow") then
		local q = effectiveQuality()
		inst.Shadows = q == "Alta" or q == "Ultra"
	end
end

-- Detalles caros que se ocultan en calidades bajas (solo en este cliente)
local HIDE_BELOW = {
	LightCone = "Alta",
	ContactShadow = "Media",
	Puddle = "Media",
	-- (detalles pequeños de los mapas realistas: en móviles modestos no se notan y ahorran dibujo)
	FloorPaper = "Media",
	Paper = "Media",
	PosterBand = "Media",
	Wire = "Media",
	ACGrille = "Media",
	Crack = "Media",
	ChairLeg = "Media",
	CamoSpot = "Media",
	SnowPoleBand = "Media",
	SignalLamp = "Media",
	AntennaBar = "Media",
	RubblePile = "Media",
	-- (mapas 5v5 nuevos, TacKit: juntas, nervios de chapa, peldaños vistos, flejes, rodadas...;
	-- la forma y la cobertura no cambian, solo el detalle)
	Step = "Media",
	StepNosing = "Media",
	Joint = "Media",
	WallRib = "Media",
	BlockJoint = "Media",
	Strap = "Media",
	Rubble = "Media",
	TireMark = "Media",
	OilStain = "Media",
	HazardStripe = "Media",
	SteelFlange = "Media",
	Rebar = "Media",
	ScaffoldGuard = "Media",
	HoistRing = "Media",
	Plinth = "Media",
	JambStripe = "Media",
	SackRow = "Media",
	EdgeSlab = "Media",
	CityCornice = "Media",
	CityRoofBox = "Media",
	SkylightBar = "Media",
	-- (Fase 3: detalles de suelo y techo de los mapas gold standard)
	FloorInlay = "Media",
	FountainFloorInner = "Media",
	RoofSignLeg = "Media",
	ClockHand = "Media",
	-- (Fase 14: acabados finos de los mapas: banderines, abrazaderas de encofrado, bordes de zona)
	Bunting = "Media",
	FormworkClamp = "Media",
	ZoneEdge = "Media",
	BannerStripe = "Media",
	FacadeFin = "Media",
	FasciaGlow = "Media",
}
local RANK = { Baja = 1, Media = 2, Alta = 3, Ultra = 4 }
local function applyDetail(inst)
	local minimum = HIDE_BELOW[inst.Name]
	if minimum and inst:IsA("BasePart") then
		inst.LocalTransparencyModifier = (RANK[effectiveQuality()] or 2) < RANK[minimum] and 1 or 0
	end
end

-- Fuegos del mapa (bidones o coches ardiendo): en calidad Baja, sin llamas (la luz se queda)
local function applyFire(inst)
	if inst:IsA("Fire") then
		local map = workspace:FindFirstChild("Map")
		if map and inst:IsDescendantOf(map) then
			inst.Enabled = effectiveQuality() ~= "Baja"
		end
	end
end

local function applyQuality()
	local q = effectiveQuality()
	ClientState.EffectiveQuality = q
	local low = q == "Baja"
	Lighting.GlobalShadows = not low
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
	if bloom then
		bloom.Enabled = not low
	end
	local rays = Lighting:FindFirstChildOfClass("SunRaysEffect")
	if rays then
		rays.Enabled = q == "Alta" or q == "Ultra"
	end
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds then
		clouds.Enabled = not low
	end
	-- Desenfoque lejano solo en Ultra (creado en el cliente)
	local dof = Lighting:FindFirstChild("QualityDOF")
	if q == "Ultra" then
		if not dof then
			dof = Instance.new("DepthOfFieldEffect")
			dof.Name = "QualityDOF"
			-- (muy suave y solo muy lejos: un enemigo a distancia de combate nunca sale borroso)
			dof.FarIntensity = 0.06
			dof.FocusDistance = 200
			dof.InFocusRadius = 50 -- (el máximo que admite)
			dof.NearIntensity = 0
			dof.Parent = Lighting
		end
		dof.Enabled = true
	elseif dof then
		dof.Enabled = false
	end
	local map = workspace:FindFirstChild("Map")
	if map then
		for _, d in map:GetDescendants() do
			scaleEmitter(d)
			applyLightShadow(d)
			applyDetail(d)
			applyFire(d)
		end
	end
end

function Settings.Get()
	return current
end

-- Cambia un ajuste, lo aplica al momento y lo guarda en el servidor (agrupando cambios seguidos)
local saveQueued = false
function Settings.Set(key, value)
	if key == "Quality" then
		if not table.find(GameConfig.QualityLevels, value) then
			return
		end
	elseif key == "HudLayout" then
		-- (disposición de los controles táctiles: la misma limpieza que hace el servidor)
		value = MobileHUD.Validate(value)
	else
		local limits = GameConfig.SettingsLimits[key]
		if not limits or type(value) ~= "number" then
			return
		end
		value = math.clamp(math.floor(value * 100 + 0.5) / 100, limits[1], limits[2])
	end
	current[key] = value
	if key == "Quality" then
		applyQuality()
	end
	ClientState.SettingsChanged:Fire(key)
	if not saveQueued then
		saveQueued = true
		task.delay(1.5, function()
			saveQueued = false
			Remotes.SaveSettings:FireServer(current)
		end)
	end
end

-- Huella de los ajustes de los controles táctiles (para avisar solo si cambian de verdad)
local function controlsKey(): string
	local parts = { tostring(current.AutoSprint), tostring(current.LeftFire), tostring(current.FireDrag) }
	local layout = current.HudLayout
	if type(layout) == "table" then
		local ids = {}
		for id in layout do
			table.insert(ids, id)
		end
		table.sort(ids)
		for _, id in ids do
			local item = layout[id]
			table.insert(parts, string.format("%s:%s:%s:%s:%s", id, tostring(item.X), tostring(item.Y), tostring(item.S), tostring(item.O)))
		end
	end
	return table.concat(parts, "|")
end

function Settings.Init()
	-- Ajustes guardados del jugador
	local function fromData(data)
		if type(data) ~= "table" or type(data.Settings) ~= "table" or saveQueued then
			return
		end
		local changedQuality = data.Settings.Quality ~= current.Quality
		local oldEnemyColor = current.EnemyColor
		local oldControls = controlsKey()
		for key, value in data.Settings do
			if GameConfig.DefaultSettings[key] ~= nil and type(value) == type(GameConfig.DefaultSettings[key]) then
				current[key] = key == "HudLayout" and MobileHUD.Validate(value) or value
			end
		end
		-- (controles táctiles: se vuelven a colocar con lo guardado, solo si ha cambiado algo)
		if controlsKey() ~= oldControls then
			ClientState.SettingsChanged:Fire("Controls")
		end
		if changedQuality then
			applyQuality()
		end
		-- (el color de enemigos guardado se aplica también a los que ya están en pantalla)
		if current.EnemyColor ~= oldEnemyColor then
			ClientState.SettingsChanged:Fire("EnemyColor")
		end
	end
	ClientState.DataChanged.Event:Connect(fromData)
	fromData(ClientState.Data)

	-- Al cambiar de mapa el servidor rehace la iluminación: volvemos a aplicar la calidad
	ReplicatedStorage:GetAttributeChangedSignal("MapName"):Connect(function()
		task.delay(1, applyQuality)
	end)
	workspace.DescendantAdded:Connect(function(inst)
		if inst:IsA("ParticleEmitter") then
			task.defer(scaleEmitter, inst)
		elseif inst:IsA("Light") then
			task.defer(applyLightShadow, inst)
		elseif inst:IsA("Fire") then
			task.defer(applyFire, inst)
		elseif HIDE_BELOW[inst.Name] then
			task.defer(applyDetail, inst)
		end
	end)
	applyQuality()
end

return Settings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="232">
            <Properties>
              <string name="Name">SkinFX</string>
              <string name="Source"><![CDATA[-- Anima las skins arcoíris: las piezas con la etiqueta "RainbowSkin" (ver WeaponModels) van cambiando
-- de color. Cada pieza tiene su fase (RainbowPhase) para que el color recorra el arma como una ola.
-- Funciona igual en tu arma (viewmodel) y en las de los demás. ~30 veces por segundo.
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local SkinFX = {}

local TAG = "RainbowSkin"
local SPEED = 0.22 -- vueltas al arcoíris por segundo
local parts = {} -- [part] = { Phase, Sat, Val, Viewport }

local function add(part)
	if part:IsA("BasePart") then
		parts[part] = {
			Phase = part:GetAttribute("RainbowPhase") or 0,
			Sat = part:GetAttribute("RainbowSat") or 1,
			Val = part:GetAttribute("RainbowVal") or 1,
			Viewport = part:FindFirstAncestorWhichIsA("ViewportFrame"), -- icono de la interfaz
		}
	end
end

-- ¿Se ve el icono? (el panel del menú cerrado sigue existiendo: no hace falta animar lo que no se ve)
local function guiVisible(gui)
	local node = gui
	while node do
		if node:IsA("GuiObject") and not node.Visible then
			return false
		elseif node:IsA("LayerCollector") then
			return node.Enabled
		end
		node = node.Parent
	end
	return false
end

local function remove(part)
	parts[part] = nil
end

function SkinFX.Init()
	for _, part in CollectionService:GetTagged(TAG) do
		add(part)
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(add)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(remove)
	local accumulator = 0
	RunService.RenderStepped:Connect(function(dt)
		accumulator += dt
		if accumulator < 1 / 30 then
			return
		end
		accumulator = 0
		local t = os.clock() * SPEED
		local shown = {} -- visibilidad de cada icono, calculada una vez por paso
		for part, info in parts do
			if not part.Parent then
				parts[part] = nil
				continue
			end
			local visible
			if info.Viewport then
				visible = shown[info.Viewport]
				if visible == nil then
					visible = guiVisible(info.Viewport)
					shown[info.Viewport] = visible
				end
			else
				-- Arma oculta (la tuya en la mano la sustituye el viewmodel)
				visible = part.LocalTransparencyModifier < 1 and part.Transparency < 1
			end
			if visible then
				part.Color = Color3.fromHSV((t + info.Phase) % 1, info.Sat, info.Val)
			end
		end
	end)
end

return SkinFX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="233">
            <Properties>
              <string name="Name">TouchIcons</string>
              <string name="Source"><![CDATA[-- Iconos de los controles táctiles dibujados con formas (Fase 12; unificados en la Fase 15): un solo
-- estilo para todos, sin emojis (cada móvil los dibuja distinto) y sin imágenes subidas. Coordenadas
-- de 0 a 1 dentro del hueco del icono; `px` es su tamaño en píxeles.
--
-- Fase 15: todos los trazos tienen EL MISMO GROSOR (LINE, fracción del hueco; los anillos, LINE × px)
-- y las piezas macizas se reservan para la silueta principal (bala, cargador, granada, cuchillo...),
-- así ningún icono se ve grueso junto a otro finísimo.
local TouchIcons = {}

local WHITE = Color3.new(1, 1, 1)
local LINE = 0.09 -- grosor de trazo común (fracción del hueco del icono)

local function piece(parent, cx, cy, w, h, rotation, round: any, color: Color3?)
	local frame = Instance.new("Frame")
	frame.Name = "IconPiece"
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(cx, cy)
	frame.Size = UDim2.fromScale(w, h)
	frame.Rotation = rotation or 0
	frame.BorderSizePixel = 0
	frame.BackgroundTransparency = 0
	frame.BackgroundColor3 = color or WHITE
	if round then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = if type(round) == "number" then UDim.new(0, round) else UDim.new(0.5, 0)
		corner.Parent = frame
	end
	frame.Parent = parent
	return frame
end

-- Anillo con el grosor común
local function ring(parent, cx, cy, d, px)
	local frame = piece(parent, cx, cy, d, d, 0, true)
	frame.BackgroundTransparency = 1
	local stroke = Instance.new("UIStroke")
	stroke.Color = WHITE
	stroke.Thickness = math.max(1.5, px * LINE)
	stroke.Parent = frame
	return frame
end

-- Trazo recto de (x1, y1) a (x2, y2) con el grosor común (en coordenadas del hueco)
local function line(parent, x1, y1, x2, y2)
	local dx, dy = x2 - x1, y2 - y1
	local length = math.sqrt(dx * dx + dy * dy)
	local frame = piece(parent, (x1 + x2) / 2, (y1 + y2) / 2, length + LINE, LINE, math.deg(math.atan2(dy, dx)), true)
	return frame
end

-- Chevrón (V) con la punta en (cx, cy) hacia `dir` ("Up", "Down", "Right", "Left"), brazos de `s`
local function chevron(parent, cx, cy, s, dir)
	local h = s * 0.5
	if dir == "Up" then
		line(parent, cx - h, cy + h * 0.8, cx, cy)
		line(parent, cx + h, cy + h * 0.8, cx, cy)
	elseif dir == "Down" then
		line(parent, cx - h, cy - h * 0.8, cx, cy)
		line(parent, cx + h, cy - h * 0.8, cx, cy)
	elseif dir == "Left" then
		line(parent, cx + h * 0.8, cy - h, cx, cy)
		line(parent, cx + h * 0.8, cy + h, cx, cy)
	else
		line(parent, cx - h * 0.8, cy - h, cx, cy)
		line(parent, cx - h * 0.8, cy + h, cx, cy)
	end
end

local DRAW = {}

DRAW.Fire = function(p)
	-- Bala: punta redonda, cuerpo y culote (la silueta principal, maciza)
	piece(p, 0.5, 0.34, 0.26, 0.26, 0, true)
	piece(p, 0.5, 0.56, 0.26, 0.4, 0, 2)
	piece(p, 0.5, 0.82, 0.34, LINE, 0, true)
end

DRAW.Aim = function(p, px)
	-- Mira: anillo, punto y cuatro marcas
	ring(p, 0.5, 0.5, 0.56, px)
	piece(p, 0.5, 0.5, 0.12, 0.12, 0, true)
	line(p, 0.5, 0.04, 0.5, 0.18)
	line(p, 0.5, 0.82, 0.5, 0.96)
	line(p, 0.04, 0.5, 0.18, 0.5)
	line(p, 0.82, 0.5, 0.96, 0.5)
end

DRAW.Jump = function(p)
	-- Saltar: chevrón hacia arriba sobre el suelo (pareja de agacharse)
	chevron(p, 0.5, 0.28, 0.62, "Up")
	line(p, 0.24, 0.78, 0.76, 0.78)
end

DRAW.Crouch = function(p)
	-- Agacharse: chevrón hacia abajo sobre el suelo
	chevron(p, 0.5, 0.56, 0.62, "Down")
	line(p, 0.24, 0.8, 0.76, 0.8)
end

DRAW.Reload = function(p)
	-- Cargador con dos balas asomando
	piece(p, 0.5, 0.6, 0.3, 0.5, 10, 3)
	piece(p, 0.43, 0.25, 0.11, 0.15, 10, true)
	piece(p, 0.57, 0.27, 0.11, 0.15, 10, true)
end

DRAW.Grenade = function(p, px)
	-- Cuerpo redondo, palanca y anilla
	piece(p, 0.5, 0.62, 0.46, 0.48, 0, true)
	line(p, 0.46, 0.34, 0.78, 0.24)
	ring(p, 0.3, 0.28, 0.18, px)
end

DRAW.Airstrike = function(p, px)
	-- Diana con una flecha que cae
	ring(p, 0.5, 0.66, 0.44, px)
	piece(p, 0.5, 0.66, 0.1, 0.1, 0, true)
	line(p, 0.5, 0.06, 0.5, 0.36)
	chevron(p, 0.5, 0.4, 0.34, "Down")
end

DRAW.Melee = function(p)
	-- Cuchillo en diagonal
	piece(p, 0.57, 0.41, 0.15, 0.52, 45, 3)
	piece(p, 0.3, 0.68, 0.15, 0.26, 45, 2)
	line(p, 0.27, 0.51, 0.49, 0.73)
end

DRAW.Dash = function(p)
	-- Líneas de velocidad y chevrón
	line(p, 0.12, 0.34, 0.34, 0.34)
	line(p, 0.06, 0.5, 0.36, 0.5)
	line(p, 0.12, 0.66, 0.34, 0.66)
	chevron(p, 0.78, 0.5, 0.56, "Right")
end

DRAW.SuperJump = function(p)
	-- Doble chevrón hacia arriba
	chevron(p, 0.5, 0.22, 0.6, "Up")
	chevron(p, 0.5, 0.5, 0.6, "Up")
end

DRAW.Potion = function(p)
	-- Frasco: cuerpo redondo, cuello y tapón
	piece(p, 0.5, 0.64, 0.46, 0.44, 0, true)
	piece(p, 0.5, 0.36, 0.16, 0.2, 0, 2)
	line(p, 0.38, 0.22, 0.62, 0.22)
end

DRAW.Sprint = function(p)
	-- Doble chevrón hacia delante
	chevron(p, 0.56, 0.5, 0.56, "Right")
	chevron(p, 0.82, 0.5, 0.56, "Right")
end

DRAW.Scoreboard = function(p)
	-- Lista: tres filas
	for _, y in { 0.28, 0.5, 0.72 } do
		piece(p, 0.2, y, 0.12, 0.12, 0, true)
		line(p, 0.36, y, 0.84, y)
	end
end

DRAW.Emotes = function(p, px)
	-- Cara: anillo, ojos y boca
	ring(p, 0.5, 0.5, 0.7, px)
	piece(p, 0.38, 0.42, 0.1, 0.1, 0, true)
	piece(p, 0.62, 0.42, 0.1, 0.1, 0, true)
	line(p, 0.38, 0.64, 0.62, 0.64)
end

DRAW.Spray = function(p)
	-- Bote: cuerpo, boquilla y gotas
	piece(p, 0.42, 0.6, 0.28, 0.46, 0, 3)
	piece(p, 0.42, 0.3, 0.14, 0.1, 0, 2)
	piece(p, 0.68, 0.26, 0.08, 0.08, 0, true)
	piece(p, 0.78, 0.36, 0.08, 0.08, 0, true)
	piece(p, 0.78, 0.16, 0.08, 0.08, 0, true)
end

DRAW.Menu = function(p)
	-- Engranaje: dientes, rueda y hueco (el hueco no se tiñe: va del color del fondo)
	for _, rotation in { 0, 45, 90, 135 } do
		piece(p, 0.5, 0.5, 0.86, 0.16, rotation, 2)
	end
	piece(p, 0.5, 0.5, 0.62, 0.62, 0, true)
	local hole = piece(p, 0.5, 0.5, 0.26, 0.26, 0, true, Color3.fromRGB(14, 16, 22))
	hole.Name = "IconHole"
end

DRAW.Swap = function(p)
	-- Cambiar: dos flechas opuestas
	line(p, 0.14, 0.34, 0.8, 0.34)
	chevron(p, 0.86, 0.34, 0.36, "Right")
	line(p, 0.2, 0.66, 0.86, 0.66)
	chevron(p, 0.14, 0.66, 0.36, "Left")
end

-- Dibuja el icono `kind` en `parent` (que ocupa el hueco del icono). Devuelve true si existe.
function TouchIcons.Draw(kind: string, parent: Instance, px: number?): boolean
	local draw = DRAW[kind]
	if not draw then
		return false
	end
	draw(parent, px or 40)
	return true
end

-- Cambia el color de todo el icono (estado: apuntando, recarga necesaria...)
function TouchIcons.Tint(parent: Instance, color: Color3)
	for _, child in parent:GetDescendants() do
		if child:IsA("Frame") and child.Name == "IconPiece" then
			if child.BackgroundTransparency < 1 then
				child.BackgroundColor3 = color
			end
			local stroke = child:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = color
			end
		end
	end
end

TouchIcons.Kinds = DRAW
TouchIcons.Line = LINE
return TouchIcons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="234">
            <Properties>
              <string name="Name">TouchLayout</string>
              <string name="Source"><![CDATA[-- Controles táctiles del juego (Fase 12: rehechos para el móvil). Roblox (ContextActionService) solo
-- crea 7 botones y los mete en un recuadro abajo a la derecha, así que en pantallas táctiles los
-- botones son nuestros. Las teclas y el mando siguen con ContextActionService.
--
-- Uso (como ContextActionService): TouchLayout.BindAction(nombre, función, conBotón, teclas...). La
-- función recibe (nombre, estado, input). Además: SetBadge (número pequeño: granadas, cargas),
-- SetCooldown (habilidades), SetCard (tarjeta del arma), SetActive (apuntando) y SetHidden.
--
-- Disposición: shared/MobileHUD (Fase 15: clase de pantalla por su forma, escala lógica y GRUPO DE
-- COMBATE del pulgar derecho metido hacia dentro en pantallas alargadas; jerarquía: DISPARAR >
-- APUNTAR > salto y agacharse > recargar > el resto; centro y zona de cámara libres). El jugador puede
-- moverlos, cambiar su tamaño y su opacidad (Ajustes → Controles → Personalizar HUD: HUDEditor), y se
-- guarda en sus ajustes (Settings.HudLayout, validado en el servidor).
--
-- Zona segura (Fase 15): los botones van en una ScreenGui con ScreenInsets = CoreUISafeInsets (la
-- zona que da el motor sin la muesca/cámara frontal NI los botones de Roblox de arriba); nada se
-- calcula con medidas inventadas de muesca. El salto es nuestro (va en el grupo) y el de Roblox se
-- esconde.
--
-- Toques: cada botón sigue a SU dedo (InputObject) hasta que lo suelta, aunque salga del botón. El de
-- DISPARAR, por defecto, deja además girar la cámara con el mismo dedo (Settings.FireDrag): no se
-- "come" el toque, así que se puede disparar y apuntar a la vez como en los shooters de móvil.
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MobileHUD = require(Shared.MobileHUD)
local InputMode = require(Shared.InputMode)
local GameConfig = require(Shared.GameConfig)
local TouchIcons = require(script.Parent.TouchIcons)

local TouchLayout = {}
-- Disposición que se está editando (HUDEditor) y aviso cuando cambia la disposición (HUD)
TouchLayout.EditingLayout = nil :: { [string]: any }?
TouchLayout.OnRelayout = nil :: ((layout: { [string]: any }, size: Vector2) -> ())?

local player = Players.LocalPlayer
local buttons: { [string]: any } = {} -- [acción] = entrada (ver createButton)
local registered = {} -- [acción] = posición pedida por el código (solo se guarda: manda MobileHUD)
local gui
local layout: { [string]: any } = {} -- disposición resuelta (MobileHUD.Resolve)
local breakpoint = "PHONE"
local hiddenBy = {} -- [acción] = true si su módulo la esconde (sin cargas, ajuste...)
local blockedNow = false
local onlyEmotesNow = false
local fireTouches = {} -- [InputObject] = acción (disparo arrastrando)
local editing = false

local COLORS = {
	Face = Color3.fromRGB(14, 16, 22), -- grafito
	Stroke = Color3.fromRGB(235, 238, 245),
	Active = Color3.fromRGB(255, 205, 60), -- amarillo de la marca: solo para estados
	Warn = Color3.fromRGB(255, 176, 64),
	Empty = Color3.fromRGB(255, 92, 72),
	Ally = Color3.fromRGB(70, 150, 255),
}
-- Estilo (Fase 15). Opacidad del fondo grafito según la importancia (20-40 %), borde muy fino y
-- claro, icono casi opaco. DISPARAR: centro más transparente y borde más visible (no tapa al
-- enemigo y se distingue de todo lo demás). Al pulsar, el fondo sube un poco.
local FILL = { Fire = 0.2, Primary = 0.36, Action = 0.32, Utility = 0.22 }
local FILL_PRESSED = 0.16
local STROKE = { Fire = { 2.5, 0.8 }, Default = { 1.5, 0.45 }, Accent = { 2, 0.95 } } -- grosor, opacidad
local ICON_OPACITY = 0.94
local PRESS_SCALE, PRESS_TIME = 0.95, 0.08

-- (botones táctiles cuando se juega con los dedos: shared/InputMode, el mismo criterio que el HUD)
local function touchDevice()
	return InputMode.TouchUI()
end

local function settings()
	local ok, ClientState = pcall(require, script.Parent.ClientState)
	return ok and ClientState.Settings or GameConfig.DefaultSettings, ok and ClientState or nil
end

local function ensureGui()
	if gui and gui.Parent then
		return gui
	end
	gui = Instance.new("ScreenGui")
	gui.Name = "TouchButtons"
	gui.ResetOnSpawn = false
	-- (botones interactivos: zona segura del motor SIN la interfaz de Roblox de arriba ni la muesca o
	-- la cámara frontal, Enum.ScreenInsets.CoreUISafeInsets. IgnoreGuiInset = false es lo mismo en
	-- motores que no tengan ScreenInsets)
	gui.IgnoreGuiInset = false
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	end)
	gui.DisplayOrder = 3
	gui.Parent = player:WaitForChild("PlayerGui")
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		TouchLayout.Relayout()
	end)
	return gui
end

-- Tamaño de la zona donde van los botones (la zona segura), su esquina en pantalla y el tamaño de la
-- pantalla entera (ViewportSize: la forma de la pantalla decide la clase y la escala)
local function areaSize(): (Vector2, Vector2, Vector2)
	local g = ensureGui()
	local camera = workspace.CurrentCamera
	local screen = camera and camera.ViewportSize
	if typeof(screen) ~= "Vector2" or screen.X < 50 or screen.Y < 50 then
		screen = Vector2.new(844, 390)
	end
	local size, origin = g.AbsoluteSize, g.AbsolutePosition
	if typeof(size) ~= "Vector2" or size.X < 50 or size.Y < 50 then
		size = screen
		origin = Vector2.zero
	end
	if typeof(origin) ~= "Vector2" then
		origin = Vector2.zero
	end
	return size, origin, screen
end

-- El botón de saltar de Roblox (PlayerModule/TouchJump) se esconde mientras exista el nuestro: el
-- salto va en el grupo de combate con su tamaño y su estilo. Roblox lo vuelve a enseñar a veces
-- (al reaparecer, al cambiar el humanoide): se vigila su Visible.
local robloxJumpWatched = nil
local function hideRobloxJump()
	if not buttons.Jump then
		return
	end
	local pg = player:FindFirstChildOfClass("PlayerGui")
	local touchGui = pg and pg:FindFirstChild("TouchGui")
	local frame = touchGui and touchGui:FindFirstChild("TouchControlFrame")
	local jump = frame and frame:FindFirstChild("JumpButton")
	if not (jump and jump:IsA("GuiObject")) then
		return
	end
	if jump.Visible then
		jump.Visible = false
	end
	if robloxJumpWatched ~= jump then
		robloxJumpWatched = jump
		jump:GetPropertyChangedSignal("Visible"):Connect(function()
			if jump.Visible and buttons.Jump then
				jump.Visible = false
			end
		end)
	end
end

---------------------------------------------------------------------------
-- Aspecto
---------------------------------------------------------------------------

local function tween(object, time, goal)
	local ok, t = pcall(function()
		return TweenService:Create(object, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
	end)
	if ok and t then
		t:Play()
	end
end

-- Pinta un control según su estado (opacidad de su papel/ajuste, apuntando, pulsado, aviso)
local function paint(entry)
	local info = layout[entry.Id]
	local opacity = info and info.Opacity or 1
	local _, ClientState = settings()
	local control = MobileHUD.ById[entry.Id]
	if not editing and control and control.Fade and ClientState and ClientState.Aiming then
		opacity *= MobileHUD.AimFade
	end
	local role = entry.Id == "Fire" and "Fire" or (control and control.Role) or "Action"
	local fill = (FILL[role] or FILL.Action) + (entry.Pressed and FILL_PRESSED or 0)
	local accent = entry.Active and COLORS.Active or (entry.Emphasis == 2 and COLORS.Empty) or (entry.Emphasis == 1 and COLORS.Warn) or nil
	local stroke = accent and STROKE.Accent or (entry.Id == "Fire" and STROKE.Fire) or STROKE.Default
	local strokeAlpha = stroke[2]
	if entry.InStrip and not editing then
		-- (en su tira: el fondo es el de la tira; el botón solo se aclara al pulsarlo y solo lleva
		-- borde si tiene un estado que enseñar)
		fill = entry.Pressed and FILL_PRESSED or 0
		strokeAlpha = accent and strokeAlpha or 0
	end
	entry.Face.BackgroundTransparency = math.clamp(1 - fill * opacity, 0, 1)
	entry.Stroke.Color = accent or COLORS.Stroke
	entry.Stroke.Thickness = stroke[1]
	entry.Stroke.Transparency = math.clamp(1 - strokeAlpha * math.max(opacity, 0.4), 0, 1)
	if entry.Ring then
		-- (DISPARAR: anillo interior fino, como una retícula)
		entry.Ring.Color = accent or COLORS.Stroke
		entry.Ring.Transparency = math.clamp(1 - 0.35 * opacity, 0, 1)
	end
	local iconAlpha = math.clamp(1 - ICON_OPACITY * math.max(opacity, 0.35), 0, 1)
	for _, piece in entry.Icon:GetDescendants() do
		if piece:IsA("Frame") then
			if piece.BackgroundTransparency < 1 then
				piece.BackgroundTransparency = iconAlpha
			end
			local pieceStroke = piece:FindFirstChildOfClass("UIStroke")
			if pieceStroke then
				pieceStroke.Transparency = iconAlpha
			end
		elseif piece:IsA("TextLabel") then
			piece.TextTransparency = iconAlpha
		end
	end
	TouchIcons.Tint(entry.Icon, accent or Color3.new(1, 1, 1))
	-- (al pulsar baja un poco; la recarga necesaria se ve algo más grande, sin parpadear ni rebotar)
	local scale = (entry.Pressed and PRESS_SCALE or 1) * (entry.Emphasis == 2 and 1.06 or 1)
	if entry.Scale.Scale ~= scale then
		tween(entry.Scale, PRESS_TIME, { Scale = scale })
	end
end

local fitCard -- (más abajo)

-- Coloca un control (posición y tamaño en píxeles de la zona segura)
local function place(entry)
	local info = layout[entry.Id]
	if not info then
		return
	end
	local hit = info.Hit
	entry.Button.Position = UDim2.fromOffset(math.floor(info.Center.X - hit.X / 2 + 0.5), math.floor(info.Center.Y - hit.Y / 2 + 0.5))
	entry.Button.Size = UDim2.fromOffset(math.floor(hit.X + 0.5), math.floor(hit.Y + 0.5))
	entry.Face.Size = UDim2.fromOffset(math.floor(info.Size.X + 0.5), math.floor(info.Size.Y + 0.5))
	local control = MobileHUD.ById[entry.Id]
	-- (esquinas según la forma: círculo, tarjeta cuadrada o tarjeta del arma)
	local shape = control and control.Shape or "Round"
	local radius = shape == "Round" and UDim.new(0.5, 0) or UDim.new(0, math.floor(math.min(info.Size.X, info.Size.Y) * (shape == "Card" and 0.3 or 0.28) + 0.5))
	entry.Corner.CornerRadius = radius
	entry.CoverCorner.CornerRadius = radius
	local iconPx = math.min(info.Size.X, info.Size.Y)
	if not entry.CardTexts and entry.IconPx ~= math.floor(iconPx) then
		entry.IconPx = math.floor(iconPx)
		-- (los trazos de los iconos dependen del tamaño: se vuelven a dibujar)
		for _, child in entry.Icon:GetChildren() do
			child:Destroy()
		end
		if control and control.Icon ~= "Card" then
			-- (mismo tamaño de icono respecto a su botón en todos: 52 %; DISPARAR algo menos, 44 %)
			local fraction = entry.Id == "Fire" and 0.44 or 0.52
			entry.Icon.Size = UDim2.fromScale(fraction, fraction)
			TouchIcons.Draw(control.Icon, entry.Icon, iconPx * fraction)
		end
	end
	if entry.CardTexts then
		fitCard(entry)
	end
	paint(entry)
end

-- Ancho en píxeles de un texto de una línea (TextService; si no responde, una estimación)
local function textWidth(text: string, size: number, font: Enum.Font): number
	local ok, bounds = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(4000, 200))
	end)
	if ok and typeof(bounds) == "Vector2" then
		return bounds.X
	end
	return (utf8.len(text) or #text) * size * 0.62
end

-- Tarjeta del arma (Fase 15: muestra el ARMA A LA QUE SE CAMBIA, pequeña; la munición va aparte,
-- junto a recargar): icono de cambiar y el nombre en UNA línea; se encoge desde 13 px (× el tamaño de
-- la tarjeta) hasta 12 px y, si aun así no cabe, lo corta TextTruncate («…»)
local MIN_CARD_TEXT = 12
fitCard = function(entry)
	local info = layout[entry.Id]
	if not entry.CardTexts or not info then
		return
	end
	local scale = info.Size.Y / 32
	local swapSize = math.floor(info.Size.Y * 0.5 + 0.5)
	entry.CardIcon.Size = UDim2.fromOffset(swapSize, swapSize)
	entry.CardIcon.Position = UDim2.new(0, 10, 0.5, 0)
	if entry.CardIconPx ~= swapSize then
		entry.CardIconPx = swapSize
		for _, child in entry.CardIcon:GetChildren() do
			child:Destroy()
		end
		TouchIcons.Draw("Swap", entry.CardIcon, swapSize)
	end
	local title = entry.CardTexts.Title
	local left = 10 + swapSize + 8
	local width = info.Size.X - left - 10
	title.Position = UDim2.fromOffset(left, 0)
	title.Size = UDim2.new(0, math.max(10, width), 1, 0)
	local size = math.max(MIN_CARD_TEXT, math.floor(13 * scale + 0.5))
	while size > MIN_CARD_TEXT and title.Text ~= "" and textWidth(title.Text, size, title.Font) > width do
		size -= 1
	end
	if title.TextSize ~= size then
		title.TextSize = size
	end
end

-- Botón de un control: zona táctil (algo mayor que el dibujo) con su cara, icono, globo y recarga
local function createButton(actionName, handler)
	local control = MobileHUD.ById[actionName]
	local isCard = control and control.Shape == "Card"
	-- (DISPARAR con «arrastrar para apuntar»: la zona no se come el toque y la cámara también lo usa)
	local passThrough = actionName == "Fire" and (settings().FireDrag or 1) == 1
	local button
	if passThrough then
		button = Instance.new("Frame")
		button.Active = false
	else
		button = Instance.new("TextButton")
		button.AutoButtonColor = false
		button.Text = ""
	end
	button.Name = actionName
	button.BackgroundTransparency = 1
	button.BorderSizePixel = 0
	local face = Instance.new("Frame")
	face.Name = "Face"
	face.AnchorPoint = Vector2.new(0.5, 0.5)
	face.Position = UDim2.fromScale(0.5, 0.5)
	face.BackgroundColor3 = COLORS.Face
	face.BorderSizePixel = 0
	face.Active = false
	face.Parent = button
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = face
	local stroke = Instance.new("UIStroke")
	stroke.Color = COLORS.Stroke
	stroke.Thickness = 1.5
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = face
	local scale = Instance.new("UIScale")
	scale.Parent = face
	-- (DISPARAR: anillo interior fino; el centro queda casi transparente)
	local ring
	if actionName == "Fire" or actionName == "LeftFire" then
		local inner = Instance.new("Frame")
		inner.Name = "InnerRing"
		inner.AnchorPoint = Vector2.new(0.5, 0.5)
		inner.Position = UDim2.fromScale(0.5, 0.5)
		inner.Size = UDim2.fromScale(0.78, 0.78)
		inner.BackgroundTransparency = 1
		inner.Parent = face
		local innerCorner = Instance.new("UICorner")
		innerCorner.CornerRadius = UDim.new(0.5, 0)
		innerCorner.Parent = inner
		ring = Instance.new("UIStroke")
		ring.Color = COLORS.Stroke
		ring.Thickness = 1
		ring.Parent = inner
	end
	local icon = Instance.new("Frame")
	icon.Name = "Icon"
	icon.AnchorPoint = Vector2.new(0.5, 0.5)
	icon.Position = UDim2.fromScale(0.5, 0.5)
	icon.Size = UDim2.fromScale(isCard and 1 or 0.52, isCard and 1 or 0.52)
	icon.BackgroundTransparency = 1
	icon.Parent = face
	-- Globo (cantidad: granadas, cargas) arriba a la derecha
	local badge = Instance.new("TextLabel")
	badge.Name = "Badge"
	badge.AnchorPoint = Vector2.new(0.5, 0.5)
	badge.Position = UDim2.fromScale(0.86, 0.14)
	badge.Size = UDim2.fromOffset(26, 18)
	badge.BackgroundColor3 = COLORS.Face
	badge.BackgroundTransparency = 0.15
	badge.TextColor3 = Color3.new(1, 1, 1)
	badge.Font = Enum.Font.GothamBold
	badge.TextSize = 12
	badge.Text = ""
	badge.Visible = false
	badge.ZIndex = 4
	badge.Parent = face
	local badgeCorner = Instance.new("UICorner")
	badgeCorner.CornerRadius = UDim.new(0.5, 0)
	badgeCorner.Parent = badge
	-- Recarga de una habilidad: velo que baja y segundos
	local cover = Instance.new("Frame")
	cover.Name = "Cooldown"
	cover.AnchorPoint = Vector2.new(0, 1)
	cover.Position = UDim2.fromScale(0, 1)
	cover.Size = UDim2.fromScale(1, 0)
	cover.BackgroundColor3 = Color3.new(0, 0, 0)
	cover.BackgroundTransparency = 0.4
	cover.BorderSizePixel = 0
	cover.ZIndex = 2
	cover.Visible = false
	cover.Parent = face
	local coverCorner = Instance.new("UICorner")
	coverCorner.CornerRadius = UDim.new(0.5, 0)
	coverCorner.Parent = cover
	local timer = Instance.new("TextLabel")
	timer.Name = "CooldownText"
	timer.BackgroundTransparency = 1
	timer.Size = UDim2.fromScale(1, 1)
	timer.Font = Enum.Font.GothamBold
	timer.TextColor3 = Color3.new(1, 1, 1)
	timer.TextSize = 14
	timer.Text = ""
	timer.ZIndex = 3
	timer.Parent = face

	local entry = {
		Id = actionName,
		Button = button,
		Face = face,
		Corner = corner,
		CoverCorner = coverCorner,
		Stroke = stroke,
		Ring = ring,
		Scale = scale,
		Icon = icon,
		Badge = badge,
		Cover = cover,
		Timer = timer,
		Handler = handler,
		Pressed = false,
		Active = false,
		Emphasis = 0,
		PassThrough = passThrough,
		Owner = nil :: InputObject?, -- el dedo que lo tiene pulsado
		OwnerConnection = nil :: RBXScriptConnection?,
		CardTexts = nil :: { [string]: TextLabel }?,
		CardIcon = nil :: Frame?,
		InStrip = false,
	}
	-- Tarjeta del arma (cambiar arma): icono de cambiar y el arma a la que se cambia, en una línea
	if isCard then
		local swap = Instance.new("Frame")
		swap.Name = "SwapIcon"
		swap.AnchorPoint = Vector2.new(0, 0.5)
		swap.BackgroundTransparency = 1
		swap.Parent = icon
		entry.CardIcon = swap
		local label = Instance.new("TextLabel")
		label.Name = "Weapon"
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBold
		label.TextColor3 = Color3.fromRGB(225, 228, 236)
		label.TextScaled = false
		label.TextWrapped = false
		label.TextSize = 13
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextYAlignment = Enum.TextYAlignment.Center
		label.TextTruncate = Enum.TextTruncate.AtEnd
		label.ClipsDescendants = true
		label.Text = ""
		label.Parent = icon
		entry.CardTexts = { Title = label }
	end

	-- Un botón es de un solo dedo a la vez (entry.Owner): un segundo dedo encima no hace nada y, si el
	-- botón se suelta por otra causa (menú, muerte), el dedo viejo ya no puede soltar una pulsación nueva
	local function press(input)
		if entry.Owner then
			return
		end
		entry.Owner = input
		entry.Pressed = true
		paint(entry)
		task.spawn(entry.Handler, actionName, Enum.UserInputState.Begin, input)
		local connection
		connection = input:GetPropertyChangedSignal("UserInputState"):Connect(function()
			local state = input.UserInputState
			if state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
				connection:Disconnect()
				if entry.Owner ~= input then
					return
				end
				entry.Owner = nil
				entry.OwnerConnection = nil
				entry.Pressed = false
				paint(entry)
				task.spawn(entry.Handler, actionName, state, input)
			end
		end)
		entry.OwnerConnection = connection
	end
	entry.Press = press
	if not passThrough then
		-- (cada toque es su dedo: se sigue hasta que lo suelta aunque salga del botón)
		button.InputBegan:Connect(function(input)
			if editing then
				return
			end
			if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
				return
			end
			press(input)
		end)
	end
	button.Parent = ensureGui()
	buttons[actionName] = entry
	place(entry)
	-- (que respete enseguida si hay un menú abierto o la pantalla de inicio)
	task.defer(TouchLayout.RefreshVisibility)
	return button
end

---------------------------------------------------------------------------
-- Disposición
---------------------------------------------------------------------------

local drawDebug -- (depuración, más abajo)
local wanted: (string, boolean?) -> boolean -- (visibilidad, más abajo)
TouchLayout.LastCollisions = {} :: { any }
local areaOrigin = Vector2.zero
local stripBacks: { [string]: Frame } = {}

-- Tiras (Fase 17): los controles de poco uso (menú, marcador, emotes, grafiti) y las habilidades
-- (impulso, supersalto, poción) van como UNA pieza: un solo fondo grafito detrás y, encima, solo los
-- iconos (sin un círculo con borde por botón). Si el jugador los separó en el editor, cada uno vuelve
-- a llevar su propio fondo. Pulsado, apuntando, en recarga o con aviso se sigue viendo en cada botón.
local STRIPS = {
	-- (Gap: hueco máximo entre dos vecinos para ir juntos, en fracción de su tamaño: la escala de la
	-- pantalla no lo cambia)
	Utility = { Gap = 0.55, Pad = 4, Round = true },
	Abilities = { Ids = { AbilityDash = true, AbilityJump = true, AbilityPotion = true }, Gap = 0.55, Pad = 3, Round = false },
}

local function stripOf(id: string): string?
	local control = MobileHUD.ById[id]
	if control and control.Role == "Utility" then
		return "Utility"
	end
	if STRIPS.Abilities.Ids[id] then
		return "Abilities"
	end
	return nil
end

local function placeStrip()
	for name, def in STRIPS do
		local ids = {}
		for id, entry in buttons do
			if stripOf(id) == name and entry.Button.Visible and layout[id] then
				table.insert(ids, id)
			end
		end
		table.sort(ids, function(a, b)
			return layout[a].Center.X < layout[b].Center.X
		end)
		-- (la tira es la fila seguida más larga: si el jugador saca uno, los demás siguen juntos)
		local run, best = {}, {}
		for i, id in ids do
			local prev = ids[i - 1]
			if prev then
				local a, b = layout[prev], layout[id]
				local gap = (b.Center.X - a.Center.X) - (a.Size.X + b.Size.X) / 2
				if math.abs(a.Center.Y - b.Center.Y) > 2 or gap > def.Gap * math.min(a.Size.X, b.Size.X) then
					run = {}
				end
			end
			table.insert(run, id)
			if #run > #best then
				best = table.clone(run)
			end
		end
		local together = #best >= 2 and not editing
		ids = best
		-- (los botones de la tira se pintan sin fondo propio; los que no, con el suyo)
		for id, entry in buttons do
			if stripOf(id) == name then
				local inStrip = together and table.find(ids, id) ~= nil
				if entry.InStrip ~= inStrip then
					entry.InStrip = inStrip
					paint(entry)
				end
			end
		end
		local back = stripBacks[name]
		if not together then
			if back then
				back.Visible = false
			end
			continue
		end
		if not back then
			local frame = Instance.new("Frame")
			frame.Name = name .. "Strip"
			frame.BackgroundColor3 = COLORS.Face
			frame.BorderSizePixel = 0
			frame.Active = false
			frame.ZIndex = 0
			local frameCorner = Instance.new("UICorner")
			frameCorner.Parent = frame
			local frameStroke = Instance.new("UIStroke")
			frameStroke.Color = COLORS.Stroke
			frameStroke.Thickness = 1
			frameStroke.Transparency = 0.8
			frameStroke.Parent = frame
			frame.Parent = gui
			stripBacks[name] = frame
			back = frame
		end
		local first, last = layout[ids[1]], layout[ids[#ids]]
		local pad = def.Pad
		local x0 = first.Center.X - first.Size.X / 2 - pad
		local x1 = last.Center.X + last.Size.X / 2 + pad
		local h = first.Size.Y + pad * 2
		local strip = back :: Frame
		strip.Position = UDim2.fromOffset(math.floor(x0), math.floor(first.Center.Y - h / 2))
		strip.Size = UDim2.fromOffset(math.floor(x1 - x0), math.floor(h))
		local corner = strip:FindFirstChildOfClass("UICorner")
		if corner then
			corner.CornerRadius = def.Round and UDim.new(0.5, 0) or UDim.new(0, math.floor(h * 0.28 + 0.5))
		end
		local _, ClientState = settings()
		strip.BackgroundTransparency = (ClientState and ClientState.Aiming) and 0.86 or 0.7
		local stroke = strip:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Transparency = (ClientState and ClientState.Aiming) and 0.92 or 0.8
		end
		strip.Visible = true
	end
end

-- Vuelve a colocar todo (pantalla girada, cambio de zona segura, disposición del jugador cambiada)
function TouchLayout.Relayout()
	if not gui then
		return
	end
	local size, origin, screen = areaSize()
	areaOrigin = origin
	breakpoint = MobileHUD.Classify(size, touchDevice(), screen)
	local s = settings()
	layout = MobileHUD.Resolve(size, {
		Breakpoint = breakpoint ~= "DESKTOP" and breakpoint or nil,
		Screen = screen,
		Custom = editing and TouchLayout.EditingLayout or s.HudLayout,
	})
	for _, entry in buttons do
		place(entry)
	end
	placeStrip()
	hideRobloxJump()
	-- Detector de solapes (Fase 16): en cada recolocación (giro, resolución, disposición propia,
	-- restablecer, reaparecer...) se revisan las cajas de los controles que se ven en partida
	local visible = {}
	for name in buttons do
		if layout[name] and wanted(name, true) then
			table.insert(visible, name)
		end
	end
	TouchLayout.LastCollisions = MobileHUD.Collisions(layout, visible, editing and 0 or MobileHUD.MinTouchGap)
	if #TouchLayout.LastCollisions > 0 and GameConfig.MobileHUDDebug and RunService:IsStudio() then
		local text = {}
		for _, c in TouchLayout.LastCollisions do
			table.insert(text, c[1] .. "/" .. c[2] .. " (" .. c.Kind .. ")")
		end
		warn("[MobileHUD] controles que se pisan: " .. table.concat(text, ", "))
	end
	if TouchLayout.OnRelayout then
		TouchLayout.OnRelayout(layout, size)
	end
	if GameConfig.MobileHUDDebug then
		task.defer(drawDebug)
	end
end

-- Botón de saltar (el nuestro, Fase 15) en la última disposición: centro y diámetro
function TouchLayout.JumpRect(): (Vector2?, number?)
	local info = layout.Jump
	if info and buttons.Jump then
		return info.Center, info.Size.X
	end
	return nil, nil
end

-- Esquina de la zona de botones en la pantalla (para pasar a las coordenadas de otra ScreenGui)
function TouchLayout.Origin(): Vector2
	return areaOrigin
end

-- Disposición resuelta (para el HUD, el editor y las pruebas)
function TouchLayout.GetLayout()
	return layout, breakpoint
end

-- Rectángulo de un control en la zona de botones: centro y tamaño (nil si no hay)
function TouchLayout.Rect(actionName: string): (Vector2?, Vector2?)
	local info = layout[actionName]
	if not info then
		return nil, nil
	end
	return info.Center, info.Size
end

---------------------------------------------------------------------------
-- Visibilidad
---------------------------------------------------------------------------

wanted = function(name: string, ignoreBlocked: boolean?): boolean
	if editing then
		return true
	end
	if hiddenBy[name] then
		return false
	end
	if blockedNow and not ignoreBlocked then
		return name == "Emotes" and onlyEmotesNow
	end
	local s = settings()
	if name == "Sprint" then
		return (s.AutoSprint or 1) == 0
	elseif name == "LeftFire" then
		return (s.LeftFire or 0) == 1
	elseif name == "Airstrike" then
		return (player:GetAttribute("Airstrikes") or 0) > 0
	end
	return true
end

-- Suelta un botón sin esperar al dedo (se esconde, se destruye o se cambia de tipo)
local function release(entry)
	if entry.OwnerConnection then
		entry.OwnerConnection:Disconnect()
	end
	entry.Owner = nil
	entry.OwnerConnection = nil
	entry.Pressed = false
	paint(entry)
end

-- Enseña u oculta los controles según los menús abiertos, las cargas y los ajustes
function TouchLayout.RefreshVisibility()
	local _, ClientState = settings()
	if ClientState then
		blockedNow = ClientState.IsBlocked()
		onlyEmotesNow = ClientState.EmoteMenuOpen
			and not (ClientState.MenuOpen or ClientState.VoteOpen or ClientState.InMainMenu or ClientState.Dead or ClientState.TutorialOpen or ClientState.WheelOpen or ClientState.NewsOpen)
	end
	for name, entry in buttons do
		entry.Button.Visible = wanted(name)
		if not entry.Button.Visible and entry.Pressed then
			-- (si se esconde con el dedo encima, se suelta: no se queda disparando; ese dedo deja de ser
			-- del botón)
			release(entry)
			task.spawn(entry.Handler, name, Enum.UserInputState.Cancel, nil)
		end
	end
	placeStrip()
end

-- Si un control se ve en partida (sus ajustes, cargas y módulo; sin contar los menús abiertos, que
-- lo esconden un momento). Para colocar lo demás alrededor de los botones.
function TouchLayout.InPlay(actionName: string): boolean
	return buttons[actionName] ~= nil and wanted(actionName, true)
end

-- Suelta todos los controles pulsados (al morir, al reaparecer, al acabar la partida): ningún botón
-- se queda «pulsado», disparando o apuntando, y los dedos viejos ya no pueden soltar nada nuevo
function TouchLayout.ReleaseAll()
	for name, entry in buttons do
		if entry.Pressed or entry.Owner then
			release(entry)
			task.spawn(entry.Handler, name, Enum.UserInputState.Cancel, nil)
		end
	end
	table.clear(fireTouches)
end

function TouchLayout.SetHidden(actionName: string, hidden: boolean)
	local changed = (hiddenBy[actionName] == true) ~= (hidden == true)
	hiddenBy[actionName] = hidden or nil
	TouchLayout.RefreshVisibility()
	if changed and TouchLayout.OnRelayout and gui then
		-- (lo que se coloca alrededor de los botones se recoloca: un hueco más o menos)
		TouchLayout.OnRelayout(layout, (areaSize()))
	end
end

---------------------------------------------------------------------------
-- Estados
---------------------------------------------------------------------------

function TouchLayout.SetBadge(actionName: string, text: string?)
	local entry = buttons[actionName]
	if entry then
		entry.Badge.Text = text or ""
		entry.Badge.Visible = text ~= nil and text ~= ""
		if entry.Badge.Visible then
			entry.Badge.Size = UDim2.fromOffset(math.max(22, 9 * #entry.Badge.Text + 8), 18)
		end
	end
end

-- (compatibilidad: antes era el texto del botón; ahora un número va al globo y lo demás se ignora)
function TouchLayout.SetTitle(actionName: string, title: any)
	local text = tostring(title or "")
	local number = string.match(text, "%d+%.?%d*")
	TouchLayout.SetBadge(actionName, number)
end

function TouchLayout.SetActive(actionName: string, active: boolean)
	local entry = buttons[actionName]
	if entry and entry.Active ~= active then
		entry.Active = active
		paint(entry)
	end
end

-- 0 nada, 1 aviso (pocas balas), 2 necesario (cargador vacío)
function TouchLayout.SetEmphasis(actionName: string, level: number)
	local entry = buttons[actionName]
	if entry and entry.Emphasis ~= level then
		entry.Emphasis = level
		paint(entry)
	end
end

-- Recarga de una habilidad: fracción que falta (0 = lista) y texto (segundos)
function TouchLayout.SetCooldown(actionName: string, fraction: number, text: string?)
	local entry = buttons[actionName]
	if entry then
		local f = math.clamp(fraction or 0, 0, 1)
		entry.Cover.Visible = f > 0
		entry.Cover.Size = UDim2.fromScale(1, f)
		entry.Timer.Text = f > 0 and (text or "") or ""
	end
end

-- Tarjeta del arma: { Title = el arma a la que se cambia } (Fase 15: la munición va aparte)
function TouchLayout.SetCard(actionName: string, info: { [string]: any })
	local entry = buttons[actionName]
	if entry and entry.CardTexts then
		local changed = false
		for key, label in entry.CardTexts do
			local value = info[key]
			if type(value) == "string" and label.Text ~= value then
				label.Text = value
				changed = true
			end
		end
		if changed then
			fitCard(entry)
		end
	end
end

-- Pinta otra vez todos (al apuntar o dejar de hacerlo: los de poco uso se apagan un poco)
function TouchLayout.Repaint()
	for _, entry in buttons do
		paint(entry)
	end
end

---------------------------------------------------------------------------
-- Disparo arrastrando (el dedo dispara y gira la cámara a la vez)
---------------------------------------------------------------------------

local function insideFire(position: Vector3): string?
	local _, origin = areaSize()
	for _, name in { "Fire" } do
		local entry = buttons[name]
		local info = layout[name]
		if entry and entry.PassThrough and info and entry.Button.Visible and (not gui or gui.Enabled) then
			local p = Vector2.new(position.X, position.Y) - origin
			local d = p - info.Center
			local radius = math.max(info.Hit.X, info.Hit.Y) / 2
			if d.Magnitude <= radius then
				return name
			end
		end
	end
	return nil
end
TouchLayout.HitFire = insideFire

local function watchFireDrag()
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or editing or input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local name = insideFire(input.Position)
		if name then
			fireTouches[input] = name
			buttons[name].Press(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		fireTouches[input] = nil
	end)
end

---------------------------------------------------------------------------
-- Depuración (GameConfig.MobileHUDDebug = true Y Studio; nunca en un servidor publicado): SAFE RECT,
-- CENTER DEAD ZONE, CAMERA SWIPE ZONE, LEFT/RIGHT THUMB ZONE y BUTTON HITBOXES, con la clase de
-- pantalla, su proporción, la escala y los insets
---------------------------------------------------------------------------

local debugGui, debugZoneGui
drawDebug = function()
	if not (GameConfig.MobileHUDDebug and RunService:IsStudio()) then
		return
	end
	if debugGui then
		debugGui:Destroy()
	end
	if debugZoneGui then
		debugZoneGui:Destroy()
	end
	debugGui = Instance.new("ScreenGui")
	debugGui.Name = "MobileHUDDebug"
	-- (las mismas coordenadas que los botones: su misma zona segura)
	debugGui.IgnoreGuiInset = false
	pcall(function()
		debugGui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	end)
	debugGui.DisplayOrder = 90
	debugGui.ResetOnSpawn = false
	debugGui.Parent = gui.Parent
	local size, origin, screen = areaSize()
	local function box(position, s, color, label, fill)
		local frame = Instance.new("Frame")
		frame.BackgroundColor3 = color
		frame.BackgroundTransparency = fill and 0.85 or 1
		frame.Position = UDim2.fromOffset(position.X, position.Y)
		frame.Size = UDim2.fromOffset(s.X, s.Y)
		frame.Active = false
		frame.Parent = debugGui
		local stroke = Instance.new("UIStroke")
		stroke.Color = color
		stroke.Thickness = 1
		stroke.Parent = frame
		if label then
			local text = Instance.new("TextLabel")
			text.BackgroundTransparency = 1
			text.Size = UDim2.new(1, 0, 0, 14)
			text.TextColor3 = color
			text.TextSize = 11
			text.Font = Enum.Font.GothamBold
			text.TextXAlignment = Enum.TextXAlignment.Left
			text.Text = label
			text.Parent = frame
		end
	end
	-- SAFE RECT: la zona segura (CoreUISafeInsets) respecto a la pantalla entera
	box(Vector2.zero, size, Color3.fromRGB(60, 255, 120), string.format(" SAFE RECT %dx%d · pantalla %dx%d (%.2f:1) · %s · escala %.2f · inset %d,%d", size.X, size.Y, screen.X, screen.Y, math.max(screen.X, screen.Y) / math.max(1, math.min(screen.X, screen.Y)), breakpoint, MobileHUD.Scale(breakpoint, screen), origin.X, origin.Y))
	-- Zonas (las de los controles visibles)
	-- (los controles de la partida, aunque un menú los esconda en este momento)
	local visible = {}
	for name in buttons do
		if layout[name] and wanted(name, true) then
			table.insert(visible, name)
		end
	end
	local zones = MobileHUD.Zones(size, layout, visible)
	local clear = zones.Center.Radius
	box(zones.Center.Center - Vector2.new(clear, clear), Vector2.new(clear * 2, clear * 2), Color3.fromRGB(255, 80, 80), " CENTER DEAD ZONE", true)
	box(zones.Swipe.Min, zones.Swipe.Max - zones.Swipe.Min, Color3.fromRGB(80, 160, 255), " CAMERA SWIPE ZONE", true)
	if zones.LeftThumb then
		box(zones.LeftThumb.Min, zones.LeftThumb.Max - zones.LeftThumb.Min, Color3.fromRGB(190, 120, 255), " LEFT THUMB ZONE")
	end
	if zones.RightThumb then
		box(zones.RightThumb.Min, zones.RightThumb.Max - zones.RightThumb.Min, Color3.fromRGB(255, 150, 60), " RIGHT THUMB ZONE")
	end
	-- VISUAL RECT (blanco) y TOUCH RECT (amarillo) de cada control; en ROJO los que chocan
	local bad = {}
	for _, c in MobileHUD.Collisions(layout, visible, MobileHUD.MinTouchGap) do
		bad[c[1]], bad[c[2]] = true, true
	end
	for _, name in visible do
		local info = layout[name]
		local red = bad[name]
		box(info.Center - info.Size / 2, info.Size, red and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(240, 240, 240), nil, red)
		box(info.Center - info.Hit / 2, info.Hit, red and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(255, 220, 60), string.format(" %s %d %d%%", name, info.Size.X, info.Opacity * 100))
	end
	-- Elementos de las zonas del HUD (otra pantalla: la zona segura del dispositivo); en ROJO si pisan
	-- algo
	local okZones, HUDZones = pcall(require, script.Parent.HUDZones)
	if okZones then
		local zoneGui = Instance.new("ScreenGui")
		zoneGui.Name = "Zones"
		zoneGui.IgnoreGuiInset = true
		zoneGui.DisplayOrder = 91
		zoneGui.ResetOnSpawn = false
		zoneGui.Parent = gui.Parent
		debugZoneGui = zoneGui
		local wrong = {}
		for _, issue in HUDZones.Validate() do
			wrong[issue[1]] = true
		end
		local saved = debugGui
		debugGui = zoneGui
		for id, rect in HUDZones.Placed do
			box(rect.Min, rect.Max - rect.Min, wrong[id] and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(60, 230, 230), " " .. id, wrong[id])
		end
		debugGui = saved
	end
end

---------------------------------------------------------------------------
-- API
---------------------------------------------------------------------------

-- Estados que cambian solos: apuntando (los secundarios bajan un poco), recarga necesaria o en curso,
-- la zona segura y el botón de saltar de Roblox (aparece un poco después: se esconde). Solo se toca
-- algo si cambia.
local lastAim, lastArea = nil, nil
local lastDebugDraw = 0
function TouchLayout.Tick()
	local _, ClientState = settings()
	if not ClientState or not gui then
		return
	end
	if ClientState.IsBlocked() ~= blockedNow then
		TouchLayout.RefreshVisibility()
	end
	if GameConfig.MobileHUDDebug and os.clock() - lastDebugDraw > 1 then
		lastDebugDraw = os.clock()
		task.defer(drawDebug)
	end
	local aiming = ClientState.Aiming == true
	if aiming ~= lastAim then
		lastAim = aiming
		TouchLayout.SetActive("Aim", aiming)
		TouchLayout.Repaint()
		placeStrip()
	end
	local def = ClientState.CurrentDef
	local level = 0
	if def and def.Type == "Gun" and def.MagSize then
		local ammo = ClientState.Ammo or 0
		if ClientState.Reloading then
			level = 0
		elseif ammo <= 0 then
			level = 2
		elseif ammo <= math.ceil(def.MagSize * 0.25) then
			level = 1
		end
	end
	TouchLayout.SetEmphasis("Reload", level)
	TouchLayout.SetActive("Reload", ClientState.Reloading == true)
	-- (los que son de pulsar y soltar enseñan si están puestos: agachado, correr con botón)
	TouchLayout.SetActive("Slide", ClientState.Crouching == true)
	TouchLayout.SetActive("Sprint", ClientState.SprintToggled == true)
	-- (la zona segura puede cambiar sin cambiar el tamaño de la pantalla: barra de Roblox, giro)
	local size, origin = areaSize()
	local key = size + origin * 10000
	if lastArea == nil or (key - lastArea).Magnitude > 1 then
		lastArea = key
		TouchLayout.Relayout()
	end
	hideRobloxJump()
end

local watching = false
local function watch()
	if watching then
		return
	end
	watching = true
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(TouchLayout.Relayout)
	end
	watchFireDrag()
	-- Al morir y al reaparecer, todo suelto (Fase 16)
	local function onCharacter(character)
		TouchLayout.ReleaseAll()
		local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
		if humanoid and humanoid:IsA("Humanoid") then
			humanoid.Died:Connect(TouchLayout.ReleaseAll)
		end
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	-- Ajustes de controles: disposición, correr solo, disparo izquierdo y disparar arrastrando
	local _, ClientState = settings()
	if ClientState then
		local CONTROL_KEYS = { Controls = true, HudLayout = true, AutoSprint = true, LeftFire = true, FireDrag = true }
		ClientState.SettingsChanged.Event:Connect(function(key)
			if key ~= nil and not CONTROL_KEYS[key] then
				return
			end
			if (key == "FireDrag" or key == "Controls") and buttons.Fire and buttons.Fire.PassThrough ~= ((settings().FireDrag or 1) == 1) then
				-- (el botón cambia de tipo: con arrastre no se come el toque)
				local handler = buttons.Fire.Handler
				buttons.Fire.Button:Destroy()
				buttons.Fire = nil
				createButton("Fire", handler)
			end
			TouchLayout.Relayout()
			TouchLayout.RefreshVisibility()
		end)
	end
	-- Estados que cambian solos (TouchLayout.Tick): diez veces por segundo
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 0.1 then
			acc = 0
			TouchLayout.Tick()
		end
	end)
	task.defer(drawDebug)
end

-- Como ContextActionService:BindAction; si conBotón y la pantalla es táctil, el botón es nuestro
function TouchLayout.BindAction(actionName, handler, withButton, ...)
	ContextActionService:BindAction(actionName, handler, false, ...)
	if withButton and touchDevice() then
		if buttons[actionName] then
			buttons[actionName].Button:Destroy()
		end
		-- Disparo con la mano izquierda (opcional, para jugar con tres o cuatro dedos): mismo disparo.
		-- Los dos botones comparten el gatillo: empieza con el primer dedo y se suelta con el último
		-- (soltar uno no corta el disparo del otro)
		if actionName == "Fire" then
			local held = {}
			local touchHandler = function(name, state, input)
				if state == Enum.UserInputState.Begin then
					local first = next(held) == nil
					held[name] = true
					if first then
						return handler(name, state, input)
					end
				else
					held[name] = nil
					if next(held) == nil then
						return handler(name, state, input)
					end
				end
				return nil
			end
			createButton(actionName, touchHandler)
			if buttons.LeftFire then
				buttons.LeftFire.Button:Destroy()
			end
			createButton("LeftFire", touchHandler)
		else
			createButton(actionName, handler)
		end
		watch()
		TouchLayout.Relayout()
	end
end

-- Solo el botón (sin teclas): las habilidades y otros que llevan sus teclas por su cuenta
function TouchLayout.BindButton(actionName, handler)
	if not touchDevice() then
		return nil
	end
	if buttons[actionName] then
		buttons[actionName].Button:Destroy()
	end
	local button = createButton(actionName, handler)
	watch()
	TouchLayout.Relayout()
	return button
end

function TouchLayout.UnbindAction(actionName)
	ContextActionService:UnbindAction(actionName)
	local entry = buttons[actionName]
	if entry then
		entry.Button:Destroy()
		buttons[actionName] = nil
	end
end

-- El botón de una acción (nil si no hay: sin pantalla táctil o sin enlazar)
function TouchLayout.GetButton(actionName)
	local entry = buttons[actionName]
	return entry and entry.Button or nil
end

-- (compatibilidad: la posición la decide MobileHUD; se guarda por si alguien la consulta)
function TouchLayout.Set(actionName, position)
	registered[actionName] = position
	watch()
end

-- Modo editor: se ven todos los controles y no disparan nada; la disposición que se ve es la que se
-- está editando (TouchLayout.EditingLayout)
function TouchLayout.SetEditing(on: boolean, editingLayout)
	editing = on
	TouchLayout.EditingLayout = editingLayout
	TouchLayout.RefreshVisibility()
	TouchLayout.Relayout()
end

function TouchLayout.IsEditing()
	return editing
end

-- Todos los controles creados (para el editor)
function TouchLayout.Entries()
	return buttons
end

return TouchLayout
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="235">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[-- Tarjeta de controles para jugadores nuevos: la primera vez que entran en partida ven los controles
-- básicos (adaptados a PC o a móvil). Se cierra con el botón o a los 20 s y no vuelve a salir
-- (el servidor guarda TutorialDone).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Sounds = require(Shared.Sounds)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local Tutorial = {}

local PC_TIPS = {
	{ "🖱", "Clic izquierdo dispara · clic derecho apunta" },
	{ "⌨", "WASD te mueve · Shift corre · C te agacha (corriendo, te desliza)" },
	{ "⚡", "E impulso · Z supersalto · X poción" },
	{ "🔪", "1 2 3 o rueda: cambiar arma · R recargar · F golpe · G granada" },
	{ "🛒", "B abre la tienda, el pase y los retos" },
	{ "📋", "Tab marcador · H regalo 🎁 · J grafiti 🎨" },
}
local TOUCH_TIPS = {
	{ "🕹", "Joystick a la izquierda para moverte" },
	{ "🔫", "Disparar: el botón grande de la derecha · Apuntar a su izquierda" },
	{ "⚡", "Encima del joystick: impulso, supersalto, poción y granada" },
	{ "⬆", "Saltar y agacharte junto a Disparar · Recargar debajo de Apuntar" },
	{ "🔄", "Abajo, la tarjeta del arma: tócala para cambiar de arma" },
	{ "⚙", "Arriba a la derecha: menú y tienda, marcador, emotes y grafiti" },
}

local shown = false

local function show()
	if shown then
		return
	end
	shown = true
	-- Mientras se lee: ratón libre y visible, sin disparar
	ClientState.TutorialOpen = true
	ClientState.UpdateMouse()
	local touch = InputMode.TouchUI()
	local gui = UI.new("ScreenGui", {
		Name = "Tutorial",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 7, -- (por encima de la tienda)
		Parent = player:WaitForChild("PlayerGui"),
	})
	local card = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(520, 400),
		BackgroundColor3 = Color3.fromRGB(20, 22, 36),
		BackgroundTransparency = 0.08,
		Parent = gui,
	}, { UI.corner(18), UI.stroke(Color3.fromRGB(255, 205, 60), 3, 0) })
	local scale = UI.new("UIScale", { Scale = 0.6, Parent = card })
	local viewport = workspace.CurrentCamera.ViewportSize
	local fit = math.clamp(math.min((viewport.X - 20) / 520, (viewport.Y - 20) / 400), 0.45, 1)
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = fit }):Play()
	UI.label({
		Position = UDim2.fromOffset(0, 14),
		Size = UDim2.new(1, 0, 0, 40),
		Text = "¡BIENVENIDO A LA PELEA!",
		TextSize = 32,
		TextColor3 = Color3.fromRGB(255, 210, 60),
		Parent = card,
	})
	for i, tip in touch and TOUCH_TIPS or PC_TIPS do
		local row = UI.new("Frame", {
			Position = UDim2.fromOffset(24, 60 + (i - 1) * 46),
			Size = UDim2.new(1, -48, 0, 40),
			BackgroundColor3 = Color3.fromRGB(40, 44, 70),
			BackgroundTransparency = 0.2,
			Parent = card,
		}, { UI.corner(10) })
		UI.label({ Size = UDim2.fromOffset(44, 40), Text = tip[1], TextSize = 24, Parent = row })
		UI.label({
			Position = UDim2.fromOffset(48, 0),
			Size = UDim2.new(1, -56, 1, 0),
			Text = tip[2],
			TextSize = 18,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			Parent = row,
		})
	end
	local button = UI.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(220, 46),
		Text = "¡A JUGAR!",
		TextSize = 24,
		BackgroundColor3 = Color3.fromRGB(70, 200, 90),
		Parent = card,
	}, { UI.gloss() })
	-- El botón Modal libera el ratón mientras se lee (en primera persona está bloqueado)
	button.Modal = true
	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		ClientState.TutorialOpen = false
		ClientState.UpdateMouse()
		Sounds.Play("Click")
		Remotes.TutorialDone:FireServer()
		TweenService:Create(scale, TweenInfo.new(0.2), { Scale = 0 }):Play()
		task.delay(0.25, function()
			gui:Destroy()
		end)
	end
	button.Activated:Connect(close)
	task.delay(20, close)
	-- Se quita si mueres o vuelves a la pantalla de inicio
	task.spawn(function()
		while not closed do
			if ClientState.Dead or ClientState.InMainMenu then
				close()
			end
			task.wait(0.2)
		end
	end)
end

function Tutorial.Init()
	task.spawn(function()
		-- Cuando sale de la pantalla de inicio por primera vez y sus datos dicen que es nuevo
		while not shown do
			task.wait(0.5)
			local data = ClientState.Data
			if data and data.TutorialDone == false and not ClientState.InMainMenu and not ClientState.Dead then
				task.wait(1.5) -- que primero vea el mapa
				if not ClientState.InMainMenu and not ClientState.Dead then
					show()
				end
			elseif data and data.TutorialDone then
				return
			end
		end
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="236">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[-- Pequeña utilidad para crear interfaces desde código.
local UI = {}

-- Letra de la interfaz: Oswald en negrita (condensada y sobria, como la de los shooters militares).
-- Enum.Font solo da el peso normal: cualquier texto con UI.Font pasa a la versión en negrita.
UI.Font = Enum.Font.Oswald
UI.FontBody = Enum.Font.GothamBold
local okBold, OSWALD_BOLD = pcall(function()
	return Font.new("rbxasset://fonts/families/Oswald.json", Enum.FontWeight.Bold)
end)
UI.FontFace = okBold and OSWALD_BOLD or nil

function UI.new(className, props, children)
	local inst = Instance.new(className)
	local parent
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			inst[key] = value
		end
	end
	if UI.FontFace and (className == "TextLabel" or className == "TextButton" or className == "TextBox") and inst.Font == UI.Font then
		inst.FontFace = UI.FontFace
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.corner(radius)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

function UI.stroke(color, thickness, transparency)
	return UI.new("UIStroke", {
		Color = color or Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

-- Degradado brillante (de claro arriba a más oscuro abajo) sobre el color de fondo
function UI.gloss(bottom)
	return UI.new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), bottom or Color3.fromRGB(185, 185, 195)),
		Rotation = 90,
	})
end

function UI.padding(px)
	return UI.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
	})
end

-- Texto con borde negro (se lee sobre cualquier fondo)
function UI.label(props, children)
	local defaults = {
		BackgroundTransparency = 1,
		Font = UI.Font,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0.4,
		TextSize = 18,
	}
	for key, value in props or {} do
		defaults[key] = value
	end
	return UI.new("TextLabel", defaults, children)
end

function UI.button(props, children)
	local defaults = {
		Font = UI.Font,
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 18,
		AutoButtonColor = true,
		BackgroundColor3 = Color3.fromRGB(40, 120, 255),
	}
	for key, value in props or {} do
		defaults[key] = value
	end
	local button = UI.new("TextButton", defaults, children)
	UI.corner(8).Parent = button
	UI.pressFeel(button)
	return button
end

-- Respuesta al tocar un botón: crece un poco al pasar el ratón, se hunde al pulsar y vuelve al soltar
-- (rápido y pequeño: se nota sin distraer)
local PRESS_INFO = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local RELEASE_INFO = TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
function UI.pressFeel(button)
	local TweenService = game:GetService("TweenService")
	local scale = Instance.new("UIScale")
	scale.Name = "PressScale"
	scale.Parent = button
	-- (Roblox usa una sola UIScale por objeto: si el botón trae su propia animación de escala, p. ej.
	-- un latido, esa manda y esta se quita)
	local yielded = false
	local watch
	watch = button.ChildAdded:Connect(function(child)
		if child:IsA("UIScale") and child ~= scale then
			yielded = true
			watch:Disconnect()
			scale:Destroy()
		end
	end)
	local hovering, pressed = false, false
	local function go(info)
		if yielded then
			return
		end
		local target = pressed and 0.94 or (hovering and 1.04 or 1)
		TweenService:Create(scale, info, { Scale = target }):Play()
	end
	button.MouseEnter:Connect(function()
		local UserInputService = game:GetService("UserInputService")
		if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
			return -- (en el móvil MouseLeave casi nunca llega: se quedaría grande)
		end
		hovering = true
		go(RELEASE_INFO)
	end)
	button.MouseLeave:Connect(function()
		hovering, pressed = false, false
		go(RELEASE_INFO)
	end)
	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			pressed = true
			go(PRESS_INFO)
			-- (si el dedo se suelta fuera del botón, p. ej. al deslizar una lista, InputEnded no llega:
			-- se vigila el propio toque)
			local changed
			local function check()
				if input.UserInputState == Enum.UserInputState.End or input.UserInputState == Enum.UserInputState.Cancel then
					if changed then
						changed:Disconnect()
					end
					if pressed then
						pressed = false
						if input.UserInputType == Enum.UserInputType.Touch then
							hovering = false
						end
						go(RELEASE_INFO)
					end
					return true
				end
				return false
			end
			changed = input:GetPropertyChangedSignal("UserInputState"):Connect(check)
			-- (un toque muy rápido puede llegar ya terminado: entonces no se queda escuchando)
			check()
		end
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			pressed = false
			-- (en el móvil no hay "pasar por encima": al soltar vuelve a su tamaño)
			if input.UserInputType == Enum.UserInputType.Touch then
				hovering = false
			end
			go(RELEASE_INFO)
		end
	end)
	return scale
end

function UI.formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d", seconds // 60, seconds % 60)
end

-- Espera a que la cámara sepa el tamaño de la pantalla (al arrancar puede valer 0 un instante y el
-- móvil se confundía con un ordenador: minimapa y paneles salían a tamaño de escritorio)
local viewportWaited = false
function UI.WaitViewport(timeout)
	-- (solo la primera vez se espera: si la pantalla no llega a saberse, los demás no esperan otra vez)
	if viewportWaited then
		return
	end
	local deadline = os.clock() + (timeout or 2)
	while os.clock() < deadline do
		local camera = workspace.CurrentCamera
		local size = camera and camera.ViewportSize
		if typeof(size) == "Vector2" and size.Y > 2 then
			viewportWaited = true
			return
		end
		task.wait(0.05)
	end
	viewportWaited = true
end

-- ¿Teléfono? (táctil, sin teclado y pantalla baja; las tablets usan la disposición normal)
function UI.IsPhone()
	local camera = workspace.CurrentCamera
	local size = camera and camera.ViewportSize
	return require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode")).TouchUI() and typeof(size) == "Vector2" and size.Y > 2 and size.Y < 500
end

-- Dónde acaba la barra de botones de Roblox (menú, chat...) arriba a la izquierda: lo nuestro de esa
-- esquina va debajo para no quedar tapado
local topbarBottom = nil
function UI.TopbarBottom()
	-- (se guarda el primer valor bueno: así el minimapa, el regalo y el evento quedan alineados)
	if topbarBottom then
		return topbarBottom
	end
	local ok, inset = pcall(function()
		return game:GetService("GuiService").TopbarInset
	end)
	if ok and typeof(inset) == "Rect" and inset.Height > 0 then
		topbarBottom = math.floor(inset.Max.Y) + 6
		return topbarBottom
	end
	return 60
end

-- Mayúsculas que respetan las tildes (string.upper solo cambia las letras sin acento: «Mítico» saldría
-- «MíTICO»)
local ACCENTS = { ["á"] = "Á", ["é"] = "É", ["í"] = "Í", ["ó"] = "Ó", ["ú"] = "Ú", ["ñ"] = "Ñ", ["ü"] = "Ü" }
function UI.upper(text)
	local upper = string.upper(tostring(text))
	return (string.gsub(upper, "\195[\161\169\173\179\186\177\188]", ACCENTS))
end

-- Color de equipo para la interfaz: los colores puros de Roblox (rojo 255,0,0 y azul 0,0,255) se ven
-- baratos y el azul apenas se lee sobre fondo oscuro. Se suavizan (el azul tira a celeste) y, para
-- textos, se aclaran
function UI.teamTint(color, forText)
	if typeof(color) ~= "Color3" then
		return color
	end
	local h, sat, v = color:ToHSV()
	if h > 0.58 and h < 0.72 then
		h = 0.6 -- (azul puro → azul más claro y legible)
	end
	if forText then
		return Color3.fromHSV(h, math.min(sat, 0.62), math.max(v, 0.95))
	end
	return Color3.fromHSV(h, math.min(sat, 0.8), math.min(math.max(v, 0.55), 0.9))
end

function UI.hex(color)
	return "#" .. color:ToHex()
end

-- Textos del HUD de partida sin emojis (Fase 17): en táctil, los avisos, banners y etiquetas de la
-- partida se escriben solo con letras (el estilo del HUD es grafito, blanco y amarillo; un emoji a
-- color se ve de prototipo y cambia de aspecto según el teléfono). Quita los pictogramas y los
-- espacios que dejan; las letras, números, tildes, «·», «×» y flechas simples se quedan.
local function isPictogram(code: number): boolean
	return (code >= 0x1F000 and code <= 0x1FAFF) -- emojis
		or (code >= 0x2600 and code <= 0x27BF) -- símbolos varios y dingbats (☀ ✈ ✔ ✚ ❤ ...)
		or (code >= 0x2B00 and code <= 0x2BFF) -- ⬆ ⬇ ⭐
		or (code >= 0x2300 and code <= 0x23FF) -- ⏰ ⌛
		or code == 0xFE0F or code == 0x200D -- variantes y unión de emojis
end

function UI.StripEmoji(text: string): string
	if type(text) ~= "string" or not utf8.len(text) then
		return text
	end
	local out = {}
	for _, code in utf8.codes(text) do
		if not isPictogram(code) then
			table.insert(out, utf8.char(code))
		end
	end
	local clean = table.concat(out)
	clean = string.gsub(clean, "^%s+", "")
	clean = string.gsub(clean, "  +", function(spaces)
		-- (los huecos largos a propósito, «   ·   », se respetan; solo se quita el que deja el emoji)
		return #spaces >= 3 and spaces or " "
	end)
	clean = string.gsub(clean, "%s+$", "")
	return clean
end

-- El texto tal cual en ordenador y mando; sin emojis en el HUD táctil
local inputMode = nil
local stripped: { [string]: string } = {}
function UI.HudText(text: string): string
	if inputMode == nil then
		local ok, module = pcall(function()
			return require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))
		end)
		inputMode = ok and module or false
	end
	if not (inputMode and inputMode.TouchUI()) or type(text) ~= "string" then
		return text
	end
	-- (los avisos que se repiten cada fotograma, como la cuenta atrás de la bomba, no se recorren cada vez)
	local clean = stripped[text]
	if not clean then
		clean = UI.StripEmoji(text)
		if #text < 200 then
			local count = 0
			for _ in stripped do
				count += 1
				if count > 400 then
					table.clear(stripped)
					break
				end
			end
			stripped[text] = clean
		end
	end
	return clean
end

return UI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="237">
            <Properties>
              <string name="Name">VoteUI</string>
              <string name="Source"><![CDATA[-- Votación de mapa + modo durante el descanso. Pulsa V (o el botón) para liberar el ratón y votar.
local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local VoteUI = {}

local gui, panel, hint, modal
local cards = {}
local myVote = nil
local open = false

local MODE_ICONS = {
	["Duelo por equipos"] = "⚔",
	["Captura la bandera"] = "🚩",
	["Dominio"] = "🏴",
	["Buscar y destruir"] = "💣",
	["Zona de control"] = "◆",
	["Todos contra todos"] = "💀",
	["Escalada de armas"] = "🔫",
	["Eliminación"] = "☠",
	["Infección"] = "🧟",
	["Calabazas"] = "🎃",
	["Baja confirmada"] = "🏷️",
}
-- Una línea para quien no conoce el modo
local MODE_HINTS = {
	["Duelo por equipos"] = "Gana el equipo con más bajas",
	["Captura la bandera"] = "Roba la bandera enemiga",
	["Dominio"] = "Captura y defiende A, B y C",
	["Buscar y destruir"] = "Planta o desactiva la bomba",
	["Zona de control"] = "Quédate dentro de la zona",
	["Todos contra todos"] = "Cada uno por su cuenta",
	["Escalada de armas"] = "Cada baja te da otra arma",
	["Eliminación"] = "Una sola vida por ronda",
	["Infección"] = "Sobrevive a los zombis",
	["Calabazas"] = "Recoge las calabazas enemigas",
	["Baja confirmada"] = "Recoge las placas de los caídos",
}

local function setOpen(value)
	open = value
	modal.Visible = value
	ClientState.VoteOpen = value
	ClientState.UpdateMouse()
end

local function refresh()
	local voting = ReplicatedStorage:GetAttribute("State") == "Intermission" and ReplicatedStorage:GetAttribute("Vote1_Map") ~= nil
	-- No tapa el menú ni la pantalla de inicio (sus tarjetas se comerían los clics)
	panel.Visible = voting and not ClientState.MenuOpen and not ClientState.InMainMenu
	ClientState.VotePanelVisible = panel.Visible
	hint.Visible = voting and not open and not ClientState.InMainMenu
	if not voting then
		myVote = nil
		if open then
			setOpen(false)
		end
		return
	end
	for i, card in cards do
		local map = ReplicatedStorage:GetAttribute("Vote" .. i .. "_Map") or "?"
		local mode = ReplicatedStorage:GetAttribute("Vote" .. i .. "_Mode") or "?"
		local count = ReplicatedStorage:GetAttribute("Vote" .. i .. "_Count") or 0
		card.Map.Text = map
		card.Mode.Text = (MODE_ICONS[mode] or "") .. " " .. mode
		-- (el mapa destacado del día da más XP)
		local featured = ReplicatedStorage:GetAttribute("FeaturedMap")
		if featured and string.find(map, featured, 1, true) then
			card.Map.Text = "⭐ " .. map
			card.Hint.Text = "⭐ Mapa del día: más XP"
		else
			card.Hint.Text = MODE_HINTS[mode] or ""
		end
		card.Count.Text = tostring(count) .. (count == 1 and " voto" or " votos")
		card.Stroke.Color = myVote == i and Color3.fromRGB(255, 200, 40) or Color3.fromRGB(90, 100, 140)
		card.Stroke.Thickness = myVote == i and 4 or 2
	end
	local timeLeft = ReplicatedStorage:GetAttribute("TimeLeft") or 0
	panel.Title.Text = "VOTA EL SIGUIENTE MAPA · " .. timeLeft .. "s"
end

function VoteUI.Init()
	gui = UI.new("ScreenGui", {
		Name = "Vote",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 6,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	panel = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -40),
		Size = UDim2.fromOffset(660, 150),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	UI.label({
		Name = "Title",
		Size = UDim2.new(1, 0, 0, 28),
		Text = "VOTA EL SIGUIENTE MAPA",
		TextSize = 24,
		TextColor3 = Color3.fromRGB(255, 210, 60),
		Parent = panel,
	})
	local row = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, 0, 0, 110),
		BackgroundTransparency = 1,
		Parent = panel,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 12),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for i = 1, 3 do
		local card = UI.button({
			LayoutOrder = i,
			Size = UDim2.fromOffset(205, 110),
			Text = "",
			BackgroundColor3 = Color3.fromRGB(28, 32, 52),
			Parent = row,
		}, { UI.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 150, 200)), Rotation = 90 }) })
		local stroke = UI.stroke(Color3.fromRGB(90, 100, 140), 2, 0)
		stroke.Parent = card
		-- Los nombres largos con icono se encogen para caber en la tarjeta
		local mapLabel = UI.label({ Position = UDim2.fromOffset(6, 8), Size = UDim2.new(1, -12, 0, 30), Text = "", TextScaled = true, Parent = card }, {
			UI.new("UITextSizeConstraint", { MaxTextSize = 24, MinTextSize = 12 }),
		})
		local modeLabel = UI.label({ Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 24), Text = "", TextSize = 18, TextColor3 = Color3.fromRGB(150, 220, 255), Parent = card })
		local hintLabel = UI.label({
			Position = UDim2.fromOffset(6, 63),
			Size = UDim2.new(1, -12, 0, 16),
			Text = "",
			TextSize = 13,
			TextColor3 = Color3.fromRGB(190, 195, 220),
			Font = UI.FontBody,
			TextStrokeTransparency = 1,
			Parent = card,
		})
		local countLabel = UI.label({ Position = UDim2.fromOffset(0, 82), Size = UDim2.new(1, 0, 0, 22), Text = "", TextSize = 18, TextColor3 = Color3.fromRGB(255, 210, 60), Parent = card })
		card.Activated:Connect(function()
			myVote = i
			Sounds.Play("Click")
			Remotes.VoteMap:FireServer(i)
			refresh()
		end)
		cards[i] = { Map = mapLabel, Mode = modeLabel, Hint = hintLabel, Count = countLabel, Stroke = stroke }
	end
	hint = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -196),
		Size = UDim2.fromOffset(400, 26),
		Text = "Pulsa [V] para votar con el ratón",
		TextSize = 20,
		Visible = false,
		Parent = gui,
	})
	-- Botón Modal: libera el ratón mientras se vota
	modal = UI.new("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true, Visible = false, Parent = gui })

	ContextActionService:BindAction("Vote", function(_, state)
		if state == Enum.UserInputState.Begin and panel.Visible and not ClientState.InMainMenu then
			setOpen(not open)
			refresh()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.V, Enum.KeyCode.DPadUp)

	ReplicatedStorage.AttributeChanged:Connect(refresh)
	refresh()
end

return VoteUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="238">
            <Properties>
              <string name="Name">WeaponController</string>
              <string name="Source"><![CDATA[-- Control de armas en primera persona: viewmodel, disparo, recarga, apuntado, cuchillo y cambio de arma.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weapons = require(Shared.Weapons)
local WeaponModels = require(Shared.WeaponModels)
local Sounds = require(Shared.Sounds)
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local WeaponFeel = require(Shared.WeaponFeel)
local WeaponVisual = require(Shared.WeaponVisual)

local TouchLayout = require(script.Parent.TouchLayout)
local AimAssist = require(script.Parent.AimAssist)
local ScopeSway = require(script.Parent.ScopeSway)
local CombatFX = require(script.Parent.CombatFX)
local UI = require(script.Parent.UI)
local ClientState = require(script.Parent.ClientState)
local Effects = require(script.Parent.Effects)
local Outfits = require(Shared.Outfits)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local WeaponController = {}

-- Teléfono (UI.IsPhone): el arma de cadera se aparta un poco (se decide al arrancar)
local PHONE_HIP = CFrame.new(0.1, -0.12, -0.18) -- (más abajo, a la derecha y más lejos: se ve más pequeña)
local phoneScreen = false

-- Hombros, codos y largo de los brazos del viewmodel: WeaponVisual.Arms (espacio de cámara)
local ARMS = WeaponVisual.Arms

local character, humanoid, rootPart
local equippedTool, def
-- Sensación del arma equipada (WeaponFeel: perfil de su tipo + sus ajustes). Retroceso de juego:
-- WeaponFeel.Gameplay (igual para todas; es equilibrio)
local feel = WeaponFeel.Get(nil)
-- Presentación del arma equipada (WeaponVisual: poses, marcas de recarga, reposo, colgante...)
local visual = WeaponVisual.Get(nil)
local GAMEPLAY = WeaponFeel.Gameplay
local EQUIP_READY = 0.25 -- segundos tras sacar el arma hasta poder disparar (igual para todas)
local viewmodel
local attrConnection

local triggerHeld = false
local aimHeld = false
local lastShot = 0
local localAmmo = 0
local reloadStart = nil
local equipTime = 0
local meleeTime = -10
local inspectTime = -10 -- "Inspeccionar" (V): gira el arma para lucir la skin
-- (la inspección dura visual.Inspect.Duration: 2,6 s en el fusil)
local meleeWithKnife = false

local recoilKick, recoilRot = 0, 0
local camKick, camYaw = 0, 0
-- Retroceso realista: muelles para el golpe del arma (empuja, se pasa un poco y vuelve) y la
-- "deuda" de retroceso: lo que subió la mira en la ráfaga; al dejar de disparar vuelve una parte
local kickVel, rotVel = 0, 0
local recoilSide, sideVel = 0, 0
local sprayCount = 0 -- disparos seguidos de la ráfaga actual
-- Calor del cañón: cada disparo lo calienta (las escopetas y los francotiradores mucho más) y se enfría
-- solo; al dejar de disparar con el cañón caliente sale humo (Effects.BarrelSmoke)
local barrelHeat = 0
local HEAT_SMOKE = 7 -- calor mínimo para que humee
local debtPitch, debtYaw = 0, 0
-- Retroceso de cámara (visual): un muelle que sube la cámara y vuelve del todo. Se aplica como
-- diferencia respecto a lo ya aplicado (la cámara de Roblox conserva el giro), así que no deja la mira
-- desplazada, y al disparar se descuenta: las balas van donde apunta la mira, no donde mira el golpe.
local punchPitch, punchYaw, punchRoll = 0, 0, 0
local punchVelPitch, punchVelYaw, punchVelRoll = 0, 0, 0
local appliedPunchPitch, appliedPunchYaw = 0, 0
local aimToggled = false -- (móvil: apuntar es un interruptor; al cambiar de arma se suelta)
local swayX, swayY = 0, 0
local bobTime = 0
local aimAlpha, sprintAlpha = 0, 0
local viewmodelHidden = false
local pulseParts = {} -- piezas de neón que laten (skins míticas)
local pulseSkin = nil
local strafeRoll = 0
local shakeRoll = 0
-- Golpe al recibir daño: un alabeo corto de la cámara (no mueve la mira) y un tirón del arma
local flinchRoll, flinchHealth = 0, nil
local headBobTime = 0 -- balanceo de la cámara al andar (GameConfig.Movement.CameraBob)
local headBobAmount = 0
-- Animación del arma: inercia con muelle, arma contra la pared, saltos y golpes alternos
local swayVelX, swayVelY = 0, 0
local pendingShot, pendingBurst = nil, false -- disparo que espera a que el arma salga del sprint
local wallAlpha = 0
local airOffset = 0
local meleeSide = 1
local meleeDuration = 0.35
local reloadWasEmpty = false
local reloadDuration = 2 -- lo que dura la recarga en curso (táctica: más corta; Weapons.ReloadDuration)
local wallCheckTime = 0

local collectMovingParts -- (más abajo)
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function lerp(a, b, t)
	return a + (b - a) * t
end

-- Suavizado que da lo mismo a 30, 60 o 240 fps (Fase 9). `rate` es el de siempre (el que se usaba con
-- lerp(..., dt × rate)) y a 60 fps da exactamente lo mismo que antes; a otros fps, ya no cambia.
-- (Solo para lo visual: aimAlpha y sprintAlpha deciden cuándo se puede disparar y no se tocan.)
local function damp(current: number, target: number, rate: number, dt: number): number
	local perFrame = math.min(rate / 60, 0.999)
	return current + (target - current) * (1 - (1 - perFrame) ^ (dt * 60))
end
-- Lo mismo para algo que se apaga solo (multiplicar por esto cada fotograma)
local function decay(rate: number, dt: number): number
	return (1 - math.min(rate / 60, 0.999)) ^ (dt * 60)
end

-- Olvida el golpe visual de cámara pendiente (al morir o reaparecer: la cámara ya es otra)
local function resetPunch()
	punchPitch, punchYaw, punchRoll = 0, 0, 0
	punchVelPitch, punchVelYaw, punchVelRoll = 0, 0, 0
	appliedPunchPitch, appliedPunchYaw = 0, 0
end

local function weaponEvent(name, info)
	local weaponName = equippedTool and equippedTool:GetAttribute("Weapon")
	ClientState.WeaponEvent:Fire(name, weaponName, info)
end

-- Corta la inspección en curso al disparar, apuntar, recargar, correr o dar un cuchillazo (con su
-- evento InspectCancel; cambiar de arma ya la quita con Unequip)
local function cancelInspect()
	if inspectTime > 0 and os.clock() - inspectTime < visual.Inspect.Duration then
		weaponEvent("InspectCancel")
	end
	inspectTime = -10
end

local function updateRayFilter()
	local ignore = { camera }
	if character then
		table.insert(ignore, character)
	end
	local fx = workspace:FindFirstChild("ClientFX")
	if fx then
		table.insert(ignore, fx)
	end
	-- Muros y techo invisibles del borde del mapa: las balas los atraviesan
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	rayParams.FilterDescendantsInstances = ignore
end

---------------------------------------------------------------------------
-- Viewmodel
---------------------------------------------------------------------------

local function skinTone()
	local hand = character and (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm"))
	return hand and hand.Color or Color3.fromRGB(255, 204, 153)
end

-- Colores de los brazos: piel, manga, guante y puño (traje de operador, uniforme en los mapas
-- realistas o garras de zombi)
local function armColors(weaponDef)
	local sleeveColor = player.Team and player.TeamColor.Color or Color3.fromRGB(60, 60, 70)
	-- Con traje de operador, los brazos llevan sus colores
	local outfitColors = Outfits.ArmColors(ClientState.Data and ClientState.Data.EquippedOutfit)
	if outfitColors then
		sleeveColor = outfitColors.Sleeve
	end
	-- Mapas realistas sin traje: uniforme de manga larga (verde oliva con un toque del color del
	-- equipo) hasta la muñeca y guantes tácticos, como en los shooters militares
	local map = workspace:FindFirstChild("Map")
	local uniform = not outfitColors and map ~= nil and map:GetAttribute("Realistic") == true
	if uniform then
		sleeveColor = Color3.fromRGB(92, 96, 72):Lerp(player.Team and player.TeamColor.Color or Color3.fromRGB(92, 96, 72), 0.12)
		outfitColors = { Sleeve = sleeveColor, Glove = Color3.fromRGB(38, 38, 36), Cuff = sleeveColor:Lerp(Color3.new(0, 0, 0), 0.3) }
	end
	-- Zombi (garras): brazos verdes y manga rota oscura
	local zombieSkin = weaponDef.ZombieArms
	if zombieSkin then
		sleeveColor = Color3.fromRGB(60, 45, 55)
		outfitColors = { Sleeve = sleeveColor, Glove = zombieSkin, Cuff = sleeveColor }
	end
	return {
		Skin = zombieSkin or skinTone(),
		Sleeve = sleeveColor,
		Glove = outfitColors and outfitColors.Glove or Color3.fromRGB(25, 25, 28),
		Cuff = outfitColors and outfitColors.Cuff or Color3.fromRGB(245, 245, 250),
		CuffNeon = outfitColors ~= nil and not zombieSkin and not uniform,
		LongSleeve = uniform, -- (el uniforme cubre también el antebrazo)
	}
end

-- Brazos procedurales: brazo (manga) y antebrazo con codo, que se recolocan cada fotograma con
-- cinemática inversa (WeaponVisual.SolveArm): el hombro queda fijo respecto a la cámara y la mano
-- sigue al arma, así que en la recarga, la inspección o el sprint el codo se dobla de verdad.
local arms = {} -- [lado] = { Upper, Forearm, Glove, Cuff, UpperLength, LowerLength, Shoulder, Pole, Hand }

local function armPart(model, name, size, color, material, side)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material
	part:SetAttribute("ArmPiece", true)
	part:SetAttribute("Side", side)
	part.Parent = model
	return part
end

local function buildArm(model, weaponDef, side, hand: Vector3, colors)
	local shoulderCam = side == "Right" and ARMS.RightShoulder or ARMS.LeftShoulder
	-- Largo: lo que hay del hombro a la mano en la pose de cadera, algo más (codo un poco doblado)
	local reach = ((visual.ViewOffset or weaponDef.ViewOffset) * hand - shoulderCam).Magnitude * ARMS.Reach
	local upper = reach * ARMS.UpperRatio
	local lower = reach - upper
	local rig = {
		Hand = hand,
		Shoulder = shoulderCam,
		Pole = side == "Right" and ARMS.RightPole or ARMS.LeftPole,
		UpperLength = upper,
		LowerLength = lower,
		Long = colors.LongSleeve,
	}
	rig.Upper = armPart(model, "UpperArm", Vector3.new(0.46, 0.46, upper), colors.Sleeve, Enum.Material.Fabric, side)
	rig.Forearm = armPart(model, "Forearm", Vector3.new(0.4, 0.4, lower), colors.LongSleeve and colors.Sleeve or colors.Skin,
		colors.LongSleeve and Enum.Material.Fabric or Enum.Material.SmoothPlastic, side)
	rig.Glove = armPart(model, "Glove", Vector3.new(0.48, 0.48, 0.55), colors.Glove, Enum.Material.Fabric, side)
	-- Puño: al final de la manga (en el codo con manga corta; en la muñeca con uniforme)
	rig.Cuff = armPart(model, "Cuff", Vector3.new(0.5, 0.5, 0.12), colors.Cuff,
		colors.CuffNeon and Enum.Material.Neon or Enum.Material.Fabric, side)
	arms[side] = rig
end

-- Coloca un brazo: hombro (mundo), mano (mundo) y polo del codo (mundo)
local function placeArm(rig, shoulder: Vector3, hand: Vector3, pole: Vector3)
	local elbow = WeaponVisual.SolveArm(shoulder, hand, rig.UpperLength, rig.LowerLength, pole)
	rig.Upper.CFrame = CFrame.lookAt((shoulder + elbow) / 2, elbow)
	-- (si la mano no se alcanza, el antebrazo se estira lo que falte: nunca se separa del arma)
	local lower = (hand - elbow).Magnitude
	if math.abs(lower - rig.Forearm.Size.Z) > 0.01 then
		rig.Forearm.Size = Vector3.new(0.4, 0.4, math.max(0.05, lower))
	end
	if lower > 1e-4 then
		rig.Forearm.CFrame = CFrame.lookAt((elbow + hand) / 2, hand)
		local along = (hand - elbow) / lower
		rig.Glove.CFrame = CFrame.lookAt(hand - along * 0.15, hand)
		local cuffAt = rig.Long and hand - along * 0.36 or elbow + along * 0.02
		rig.Cuff.CFrame = CFrame.lookAt(cuffAt, cuffAt + along)
	end
end

-- Oculta en nuestra pantalla el Tool real (los demás jugadores sí lo ven)
local function hideToolLocally(tool)
	for _, inst in tool:GetDescendants() do
		if inst:IsA("BasePart") then
			inst.LocalTransparencyModifier = 1
		elseif inst:IsA("ParticleEmitter") then
			inst.Enabled = false
		elseif inst:IsA("SurfaceGui") or inst:IsA("BillboardGui") then
			inst.Enabled = false -- los rótulos del arma se verían flotando
		end
	end
end

local charmParts = {} -- { Part, Offset } del colgante del arma en primera persona
local charmRing = nil
local charmSwing, charmVelocity, lastCameraLook = 0, 0, nil

-- El colgante se balancea como un péndulo: lo empujan el giro de la cámara, el paso al correr y las
-- acciones (kickCharm) y vuelve solo con un muelle exacto (igual a 30, 60 o 240 fps). Nada de física
-- de verdad: es una pieza que gira sobre su anilla.
local CHARM_STIFFNESS, CHARM_DAMPING = 60, 4

local function resetCharm()
	charmSwing, charmVelocity, lastCameraLook = 0, 0, nil
end

local function swingCharm(dt, sprint, stridePhase)
	if not charmRing or not charmRing.Parent then
		return
	end
	dt = math.clamp(dt, 1 / 240, 0.1)
	local look = camera.CFrame.LookVector
	local turnRate = 0
	if lastCameraLook then
		turnRate = lastCameraLook:Cross(look).Y / dt -- giro horizontal (radianes por segundo)
	end
	lastCameraLook = look
	charmVelocity += (turnRate * 3 + math.cos(stridePhase or 0) * (sprint or 0) * visual.Charm.Sprint * 6) * dt
	charmSwing, charmVelocity = WeaponFeel.StepSpring(charmSwing, charmVelocity, CHARM_STIFFNESS, CHARM_DAMPING, dt)
	-- (hacia dentro casi no puede: chocaría con el arma; en el tope se para)
	if charmSwing < -0.8 or charmSwing > 0.12 then
		charmSwing = math.clamp(charmSwing, -0.8, 0.12)
		charmVelocity = 0
	end
	local pivot = charmRing.CFrame * CFrame.Angles(0, 0, charmSwing)
	for _, entry in charmParts do
		entry.Part.CFrame = pivot * entry.Offset
	end
end

-- Estado de la presentación (WeaponVisual): reposo, gesto de reposo, salto, sprint y acción actual
local lastActivity = 0 -- último momento en que se hizo algo (disparar, apuntar, moverse...)
local idleVariantStart, lastIdleVariant = nil, -math.huge
local jumpY, jumpVel = 0, 0
local wasGrounded = true
local sprintShown = false -- (para los eventos SprintEnter / SprintExit)

local function resetPresentation()
	lastActivity = os.clock()
	idleVariantStart = nil
	jumpY, jumpVel = 0, 0
	sprintShown = false
end

-- Empujón al colgante (con un lado al azar): disparo, recarga, caída, inspección...
local function kickCharm(amount: number)
	if charmRing then
		charmVelocity += (math.random() < 0.5 and -1 or 1) * amount * (0.6 + math.random() * 0.4)
	end
end

-- Piezas que se mueven por separado en primera persona: cargador, corredera, bomba, cerrojo y
-- palanca de carga (WeaponVisual.PieceGroup: por el atributo "Piece" o por el nombre). Se guarda
-- dónde está cada una respecto al Handle para moverla desde ahí. Los brazos van aparte (IK).
local moving = { Mag = {}, Slide = {}, Pump = {}, Bolt = {}, Charge = {} }
local movingDirty = {}
local magCenter, boltCenter, chargeCenter = nil, nil, nil

local function centerOf(list)
	if #list == 0 then
		return nil
	end
	local sum = Vector3.zero
	for _, entry in list do
		sum += entry.Offset.Position
	end
	return sum / #list
end

collectMovingParts = function(model, weaponDef)
	for key, list in moving do
		table.clear(list)
		movingDirty[key] = false
	end
	local handle = model.PrimaryPart
	if not handle or weaponDef.Type ~= "Gun" then
		-- (las armas cuerpo a cuerpo solo mueven los brazos con el arma entera)
		return
	end
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") and part ~= handle then
			local group = WeaponVisual.PieceGroup(part.Name, part:GetAttribute("Piece"))
			if group then
				table.insert(moving[group], { Part = part, Offset = handle.CFrame:ToObjectSpace(part.CFrame) })
			end
		end
	end
	magCenter = centerOf(moving.Mag)
	boltCenter = centerOf(moving.Bolt)
	chargeCenter = centerOf(moving.Charge)
end

-- Coloca un grupo desplazado (offset en el espacio del arma). Sin offset, solo si hace falta
-- devolverlo a su sitio (el arma entera ya se movió con PivotTo).
local function placeGroup(key, handleCF, offset, fade)
	local list = moving[key]
	if #list == 0 then
		return
	end
	if not offset and not movingDirty[key] then
		return
	end
	movingDirty[key] = offset ~= nil
	local cf = offset or CFrame.identity
	for _, entry in list do
		entry.Part.CFrame = handleCF * cf * entry.Offset
		if key == "Mag" then
			entry.Part.LocalTransparencyModifier = offset and fade or 0
		end
	end
end

-- Guardar el arma: el modelo viejo baja de lado unos instantes (Unequip) mientras sube el nuevo; el
-- cambio de arma no espera. Al morir, al cambiar de personaje o con el arma oculta, se quita al momento.
local retiring = nil -- { Model, Start, Time, From (respecto a la cámara), Pose }

local function clearRetiring()
	if retiring then
		retiring.Model:Destroy()
		retiring = nil
	end
end

-- mode: nil = al momento (y también la que estaba bajando), "Animated" = baja de lado, "Replace" = se
-- cambia por otra del mismo arma (skin) sin tocar la que baja
local function destroyViewmodel(mode: string?)
	if mode ~= "Replace" then
		clearRetiring()
	end
	if viewmodel then
		if mode == "Animated" and not viewmodelHidden and viewmodel.Parent then
			retiring = {
				Model = viewmodel,
				Start = os.clock(),
				Time = visual.Unequip.Time,
				From = camera.CFrame:ToObjectSpace(viewmodel:GetPivot()),
				Pose = visual.Unequip,
			}
		else
			viewmodel:Destroy()
		end
		viewmodel = nil
	end
	table.clear(arms)
	table.clear(charmParts)
	charmRing = nil
	table.clear(pulseParts)
	pulseSkin = nil
	viewmodelHidden = false
end
function WeaponController.IsRetiring()
	return retiring ~= nil
end

-- Un fotograma de la salida del arma vieja
local function stepRetiring()
	if not retiring then
		return
	end
	local t = (os.clock() - retiring.Start) / retiring.Time
	if t >= 1 or not retiring.Model.Parent or ClientState.InMainMenu or ClientState.Emoting or ClientState.KillcamActive then
		clearRetiring()
		return
	end
	local k = t * t -- (acelera al bajar)
	retiring.Model:PivotTo(camera.CFrame * retiring.From * WeaponVisual.PoseCFrame(retiring.Pose, k))
end

-- Skin con la que se dibuja el arma en primera persona (el modo QA de Studio puede enseñar otra solo
-- en esta pantalla, sin dársela a nadie: ClientState.QASkinPreview)
local function viewSkin(tool)
	return ClientState.QASkinPreview or tool:GetAttribute("Skin")
end

-- Puntos del arma en primera persona: centro de la mira y agarre de las manos. Si el modelo trae
-- Attachments con esos nombres (un modelo externo), mandan ellos; si no, los de Weapons.
local points = { AimPoint = nil :: Vector3?, LeftHand = nil :: Vector3?, RightHand = nil :: Vector3? }
local POINT_NAMES = { "AimPoint", "LeftHand", "RightHand" } -- (una tabla con valores nil no tiene claves)

local function readPoints(model, weaponDef)
	local handle = model.PrimaryPart
	for _, key in POINT_NAMES do
		local attachment = handle and handle:FindFirstChild(key)
		points[key] = (attachment and attachment:IsA("Attachment") and model:GetAttribute("External")) and attachment.Position
			or weaponDef[key]
	end
end

local function createViewmodel(tool)
	destroyViewmodel("Replace")
	local weaponName = tool:GetAttribute("Weapon")
	local weaponDef = Weapons.Get(weaponName)
	local model = WeaponModels.Build(weaponName, viewSkin(tool), nil, tool:GetAttribute("Charm"))
	readPoints(model, weaponDef)
	-- Colgante: se guarda dónde está cada pieza respecto a la anilla para balancearlas (renderStep)
	table.clear(charmParts)
	local ring = model:FindFirstChild("CharmRing")
	if ring then
		for _, part in model:GetChildren() do
			if part:IsA("BasePart") and part ~= ring and string.sub(part.Name, 1, 5) == "Charm" then
				table.insert(charmParts, { Part = part, Offset = ring.CFrame:ToObjectSpace(part.CFrame) })
			end
		end
	end
	charmRing = ring
	resetCharm()
	local colors = armColors(weaponDef)
	if points.RightHand then
		buildArm(model, weaponDef, "Right", points.RightHand, colors)
	end
	if points.LeftHand then
		buildArm(model, weaponDef, "Left", points.LeftHand, colors)
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.CastShadow = false
		end
	end
	model.Name = "Viewmodel"
	collectMovingParts(model, weaponDef)
	-- Brillo suave del neón del arma sobre las manos (se nota mucho en mapas oscuros)
	local glowPalette = WeaponModels.GetPalette(weaponName, viewSkin(tool))
	-- Solo si el neón brilla de verdad (las armas clásicas sin skin no llevan neón)
	local neonAccent = (glowPalette.AccentMaterial or Enum.Material.Neon) == Enum.Material.Neon
	if model.PrimaryPart and neonAccent then
		local glow = Instance.new("PointLight")
		glow.Name = "NeonGlow"
		glow.Color = glowPalette.Accent
		glow.Range = 4.5
		glow.Brightness = 0.7
		glow.Shadows = false
		glow.Parent = model.PrimaryPart
	end
	model.Parent = camera
	viewmodel = model

	-- Skins con "Pulse": los detalles de neón laten
	table.clear(pulseParts)
	pulseSkin = WeaponModels.GetPalette(weaponName, viewSkin(tool))
	if pulseSkin.Pulse then
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") and part:GetAttribute("Role") == "Accent" then
				table.insert(pulseParts, part)
			end
		end
	end
end

local function setViewmodelHidden(hidden)
	if not viewmodel or viewmodelHidden == hidden then
		return
	end
	viewmodelHidden = hidden
	resetCharm()
	for _, part in viewmodel:GetDescendants() do
		if part:IsA("BasePart") then
			part.LocalTransparencyModifier = hidden and 1 or 0
		elseif part:IsA("ParticleEmitter") then
			-- (el humo del cañón no se vuelve a encender al mostrar el arma: lo enciende el calor)
			part.Enabled = not hidden and part.Name ~= "BarrelSmoke"
		elseif part:IsA("SurfaceGui") or part:IsA("PointLight") then
			part.Enabled = not hidden
		end
	end
end

---------------------------------------------------------------------------
-- Equipar
---------------------------------------------------------------------------

-- animated = el arma baja de lado (cambio de arma); sin él, desaparece al momento (muerte, personaje nuevo)
local function onUnequipped(animated: boolean?)
	if attrConnection then
		attrConnection:Disconnect()
		attrConnection = nil
	end
	if reloadStart and equippedTool then
		weaponEvent("ReloadCancel")
	end
	if equippedTool then
		weaponEvent("Unequip", { Animated = animated == true })
		if animated and def and def.Type == "Gun" then
			-- (hueco de audio propio; sin él, en silencio como antes)
			Sounds.PlayWeapon(equippedTool:GetAttribute("Weapon"), "Unequip", nil)
		end
	end
	destroyViewmodel(animated and "Animated" or nil)
	inspectTime = -10
	equippedTool, def = nil, nil
	barrelHeat = 0
	triggerHeld = false
	reloadStart = nil
	ClientState.CurrentTool = nil
	ClientState.CurrentDef = nil
	ClientState.Reloading = false
	ClientState.WeaponChanged:Fire()
end

local function onEquipped(tool)
	if equippedTool then
		onUnequipped(true)
	end
	local weaponDef = Weapons.Get(tool:GetAttribute("Weapon"))
	if not weaponDef then
		return
	end
	equippedTool, def = tool, weaponDef
	feel = WeaponFeel.Get(tostring(tool:GetAttribute("Weapon")), weaponDef)
	visual = WeaponVisual.Get(tostring(tool:GetAttribute("Weapon")), weaponDef)
	equipTime = os.clock()
	resetPresentation()
	if aimToggled then
		aimHeld, aimToggled = false, false
	end
	sprayCount, debtPitch, debtYaw = 0, 0, 0 -- (el retroceso de otra arma no se recupera con esta)
	swayX, swayY, swayVelX, swayVelY = 0, 0, 0, 0
	pendingShot, pendingBurst = nil, false
	wallAlpha, airOffset = 0, 0
	updateRayFilter()
	inspectTime = -10
	reloadStart = nil
	localAmmo = tool:GetAttribute("Ammo") or 0
	if weaponDef.Type == "Melee" then
		Sounds.Play("Unsheath")
	else
		Sounds.PlayWeapon(tool:GetAttribute("Weapon"), "Equip", "Equip", nil, weaponDef.Pellets > 1 and 0.85 or 1, 1)
	end

	hideToolLocally(tool)
	createViewmodel(tool)

	attrConnection = tool.AttributeChanged:Connect(function(attribute)
		if attribute == "Ammo" then
			local serverAmmo = tool:GetAttribute("Ammo") or 0
			-- Subida = recarga; bajada = confirmación de disparos que ya predijimos
			if serverAmmo > localAmmo then
				localAmmo = serverAmmo
			else
				localAmmo = math.min(localAmmo, serverAmmo)
			end
		elseif attribute == "Skin" then
			createViewmodel(tool)
			hideToolLocally(tool)
		elseif attribute == "Reloading" and not tool:GetAttribute("Reloading") then
			reloadStart = nil
		end
	end)

	ClientState.CurrentTool = tool
	ClientState.CurrentDef = weaponDef
	ClientState.WeaponChanged:Fire()
	weaponEvent("Equip")
end

local function getTools()
	local list = {}
	local containers = { player:FindFirstChildOfClass("Backpack"), character }
	for _, container in containers do
		if container then
			for _, tool in container:GetChildren() do
				if tool:IsA("Tool") and tool:GetAttribute("Slot") then
					list[tool:GetAttribute("Slot")] = tool
				end
			end
		end
	end
	return list
end
WeaponController.GetTools = getTools

local function equipSlot(slot)
	if not humanoid or humanoid.Health <= 0 or ClientState.IsBlocked() then
		return
	end
	local tool = getTools()[slot]
	if tool and tool ~= equippedTool then
		humanoid:EquipTool(tool)
	end
end

local function cycleSlot(direction)
	local current = equippedTool and equippedTool:GetAttribute("Slot") or 1
	local tools = getTools()
	for i = 1, 3 do
		local slot = (current - 1 + direction * i) % 3 + 1
		if tools[slot] then
			equipSlot(slot)
			return
		end
	end
end

---------------------------------------------------------------------------
-- Disparo
---------------------------------------------------------------------------

local function randomInCone(direction, degrees)
	if degrees <= 0 then
		return direction
	end
	local angle = math.rad(degrees) * math.sqrt(math.random())
	local spin = math.random() * math.pi * 2
	return (CFrame.lookAt(Vector3.zero, direction) * CFrame.Angles(0, 0, spin) * CFrame.Angles(angle, 0, 0)).LookVector
end

local function currentSpread()
	if not def or def.Type ~= "Gun" then
		return 0
	end
	local spread = lerp(def.Spread, def.AimSpread, aimAlpha)
	local speed = 0
	if rootPart then
		local velocity = rootPart.AssemblyLinearVelocity
		speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	end
	-- Cuanto más rápido te mueves, menos preciso (apuntando se nota menos)
	spread *= 1 + math.clamp(speed / 18, 0, 1.5) * (0.6 - aimAlpha * 0.35)
	if humanoid and humanoid.FloorMaterial == Enum.Material.Air then
		spread *= 2
	elseif ClientState.Crouching then
		spread *= 0.75 -- agachado se apunta mejor
	end
	-- Primer disparo quieto y tras una pausa: casi exacto
	if speed < 2 and os.clock() - lastShot > math.max(0.35, 2.5 / def.FireRate) then
		spread *= 0.45
	end
	return spread + ClientState.Bloom * (1 - aimAlpha * 0.7)
end

local function requestReload()
	if not equippedTool or not def or def.Type ~= "Gun" or reloadStart then
		return
	end
	local reserve = equippedTool:GetAttribute("Reserve") or 0
	if localAmmo >= def.MagSize or reserve <= 0 then
		return
	end
	reloadStart = os.clock()
	cancelInspect()
	Remotes.Reload:FireServer(equippedTool)
	-- Secuencia de la recarga: sacar el cargador, meter el nuevo y (si estaba vacía) montar el arma.
	-- Si la recarga se corta (cambias de arma, cuchillo...) deja de sonar.
	local wasEmpty = localAmmo <= 0
	local token, reloadTime = reloadStart, Weapons.ReloadDuration(def, wasEmpty)
	reloadWasEmpty = wasEmpty
	reloadDuration = reloadTime
	local shotgun = def.Pellets > 1 and #moving.Mag == 0 -- (la escopeta de tambor recarga con cargador)
	local weaponName = equippedTool:GetAttribute("Weapon")
	-- (la munición la pone el servidor al acabar: aquí solo se presenta la recarga)
	Sounds.PlayWeapon(weaponName, "Reload", nil)
	weaponEvent("ReloadStart", { Empty = wasEmpty, Duration = reloadTime })
	-- Marcas de la recarga (WeaponVisual): en cada una, su evento, su sonido y un meneo del colgante,
	-- todo a la vez. Si la recarga se corta (cambias de arma, cuchillo...), lo que falte no suena.
	local shells = 0
	for _, marker in WeaponVisual.ReloadMarkers(visual, wasEmpty or shotgun, shotgun) do
		local name = marker.Name
		if name == "ShellIn" then
			shells += 1
		end
		local shellIndex = shells
		task.delay(reloadTime * marker.At, function()
			if reloadStart ~= token then
				return
			end
			weaponEvent(name, name == "ShellIn" and { Index = shellIndex } or nil)
			if name == "MagOut" or name == "MagIn" then
				Sounds.PlayWeapon(weaponName, name, name, nil, 1, 1)
				kickCharm(visual.Charm.Reload)
			elseif name == "ShellIn" then
				-- (cartucho: el hueco MagIn, más agudo y más flojo)
				Sounds.PlayWeapon(weaponName, "MagIn", "MagIn", nil, 1.25 + shellIndex * 0.03, 0.55, 1 + shellIndex * 0.025)
				kickCharm(visual.Charm.Reload * 0.4)
			elseif name == "Bolt" then
				Sounds.PlayWeapon(weaponName, "Bolt", "Bolt", nil, shotgun and 0.75 or 1, 1)
				kickCharm(visual.Charm.Reload * 0.7)
			end
		end)
	end
end

local function fire()
	local now = os.clock()
	if not equippedTool or not def or def.Type ~= "Gun" or ClientState.IsBlocked() or ClientState.Frozen() then
		return
	end
	if now - lastShot < 1 / def.FireRate or reloadStart or now - equipTime < EQUIP_READY then
		return
	end
	if localAmmo <= 0 then
		lastShot = now
		kickVel += 0.5 -- el gatillo en vacío: un tirón seco
		Sounds.PlayWeapon(equippedTool:GetAttribute("Weapon"), "Empty", "Empty")
		requestReload()
		return
	end
	-- Salida del sprint: el arma tiene que subir antes de disparar (~0,1 s). El disparo no se pierde:
	-- queda pendiente y sale en cuanto el arma está arriba
	if sprintAlpha > 0.35 then
		ClientState.LastShotTime = now -- (deja de correr)
		ClientState.Sprinting = false
		pendingShot = pendingShot or now
		return
	end

	if now - lastShot > math.max(0.3, 2.2 / def.FireRate) then
		sprayCount = 0 -- ráfaga nueva
	end
	sprayCount += 1
	local spread = currentSpread() -- (antes de apuntar este disparo: el primero va más preciso)
	lastShot = now
	localAmmo -= 1
	ClientState.LastShotTime = now
	cancelInspect()
	ClientState.Sprinting = false

	updateRayFilter()
	local origin = camera.CFrame.Position
	-- (sin el golpe visual de cámara: la bala va adonde apunta la mira)
	local look = (camera.CFrame * CFrame.Angles(-appliedPunchPitch, -appliedPunchYaw, 0)).LookVector
	local muzzle = viewmodel and viewmodel.PrimaryPart and viewmodel.PrimaryPart:FindFirstChild("Muzzle")
	local muzzlePos = muzzle and muzzle.WorldPosition or origin
	local tracerColor = WeaponModels.GetPalette(equippedTool:GetAttribute("Weapon"), equippedTool:GetAttribute("Skin")).Accent

	local rays = {}
	if def.Explosive then
		-- Cohete: viaja hasta el impacto y explota
		local direction = randomInCone(look, spread)
		local result = workspace:Raycast(origin, direction * def.Range, rayParams)
		local hitPosition = result and result.Position or origin + direction * def.Range
		table.insert(rays, { Part = result and result.Instance or nil, Position = hitPosition })
		Effects.Rocket(muzzlePos, hitPosition, def.ProjectileSpeed or 200, tracerColor, def.Explosive.Radius, def.ProjectileStyle)
	end
	for pellet = 1, def.Explosive and 0 or def.Pellets do
		local direction = randomInCone(look, spread)
		local result = workspace:Raycast(origin, direction * def.Range, rayParams)
		local hitPosition = result and result.Position or origin + direction * def.Range
		table.insert(rays, { Part = result and result.Instance or nil, Position = hitPosition })
		-- (escopetas: basta con dibujar unos pocos perdigones; el daño cuenta todos)
		if pellet <= 3 then
			Effects.Tracer(muzzlePos, hitPosition, tracerColor)
		end
		if result then
			if pellet <= 4 then
				Effects.Impact(result.Position, result.Normal, result.Instance, result.Material, def.ImpactStyle)
			end
			local model = result.Instance:FindFirstAncestorOfClass("Model")
			if model and model:FindFirstChildOfClass("Humanoid") then
				ClientState.LastHitPosition = result.Position
				ClientState.LastHitTime = os.clock()
				ClientState.LastHitModel = model
			end
		end
	end
	-- (modo QA de Studio: dibujar el disparo; nil fuera del modo QA)
	if ClientState.QAShotHook then
		pcall(ClientState.QAShotHook, origin, rays)
	end
	Remotes.Fire:FireServer(equippedTool, origin, rays)

	-- Todo a la vez en el mismo fotograma: fogonazo + luz, sonido, casquillo y retroceso (abajo)
	Effects.MuzzleFlash(muzzle, nil, false, feel.Flash)
	if not def.Explosive and feel.Heat.PerShot > 0 then
		barrelHeat = math.min(30, barrelHeat + feel.Heat.PerShot)
		Effects.StopBarrelSmoke(muzzle)
	end
	local eject = viewmodel and viewmodel.PrimaryPart and viewmodel.PrimaryPart:FindFirstChild("Eject")
	if not def.Explosive and feel.Shells.Enabled then
		-- (el casquillo sale con la velocidad del jugador: corriendo no se queda atrás ni te da en la cara)
		Effects.ShellCasing(eject, camera.CFrame, feel.Shells.Color, rootPart and rootPart.AssemblyLinearVelocity or nil)
	end
	kickCharm(visual.Charm.Fire)
	lastActivity = now
	local weaponName = equippedTool:GetAttribute("Weapon") or ""
	Sounds.PlayShot(weaponName, def)
	shakeRoll += (math.random() - 0.5) * math.rad(def.Recoil) * 0.6
	-- Mecánica del arma: cerrojo de los francotiradores y corredera de las escopetas
	if not def.Explosive and def.FireRate <= 1.6 and localAmmo > 0 then
		local shotDef = def
		task.delay(0.28, function()
			if def == shotDef then
				Sounds.PlayWeapon(weaponName, "Bolt", "Bolt", nil, shotDef.Pellets > 1 and 0.7 or 1.05, 0.8)
			end
		end)
	end
	-- Quedan pocas balas: un "tic" más agudo cuanto menos quede (avisa sin mirar el HUD)
	if def.MagSize >= 4 and localAmmo > 0 and localAmmo <= math.ceil(def.MagSize * 0.25) then
		Sounds.Play("LowAmmo", nil, 1 + (1 - localAmmo / (def.MagSize * 0.25)) * 0.3, 1)
	end

	-- 1) Retroceso de JUEGO (precisión real; igual que antes de la Fase 2). La mira sube más en los
	-- primeros disparos de la ráfaga y luego se estabiliza; el lado sigue un patrón propio de cada arma
	-- (se puede aprender a controlar) con algo de azar.
	local recoil = math.rad(def.Recoil)
	local ads = 1 - aimAlpha * GAMEPLAY.AimReduction
	local climb = recoil * (GAMEPLAY.ClimbBase + GAMEPLAY.ClimbGrowth * math.min(sprayCount, GAMEPLAY.ClimbShots) / GAMEPLAY.ClimbShots) * ads
	local seed = #weaponName * 1.7
	local drift = math.sin(sprayCount * 0.55 + seed) * GAMEPLAY.Drift + (math.random() - 0.5) * GAMEPLAY.DriftNoise
	local yaw = recoil * drift * (sprayCount > GAMEPLAY.DriftDelay and 1 or 0.4) * ads
	camKick += climb
	camYaw += yaw
	debtPitch += climb
	debtYaw += yaw
	ClientState.Bloom = math.min(ClientState.Bloom + def.Recoil * GAMEPLAY.BloomPerRecoil, GAMEPLAY.BloomMax)

	-- 2) Retroceso del ARMA en la mano (muelles): hacia atrás, hacia arriba y un poco de lado
	local view = feel.View
	local hip = 1 - aimAlpha * (1 - view.AimScale)
	kickVel += (1.6 + def.Recoil * 0.55) * hip * view.Back
	rotVel += recoil * 10 * hip * view.Rise
	sideVel += (math.random() - 0.5) * recoil * 9 * view.Side

	-- 3) Retroceso de CÁMARA (visual, se recupera del todo): golpe hacia arriba, un poco de lado y alabeo
	local cam = feel.Camera
	local camScale = (1 - aimAlpha * (1 - cam.AimScale)) * (ClientState.ReducedFX() and 0.3 or 1)
	local impulse = cam.Impulse * camScale -- (pico = los grados del perfil)
	punchVelPitch += math.rad(cam.Punch) * impulse
	punchVelYaw += (math.random() - 0.5) * 2 * math.rad(cam.PunchSide) * impulse
	punchVelRoll += (math.random() < 0.5 and -1 or 1) * math.rad(cam.PunchRoll) * impulse
	-- Las armas potentes (perfil con temblor) sacuden la cámara y abren un poco el campo de visión
	if cam.Shake > 0 then
		ClientState.Shake = math.max(ClientState.Shake or 0, def.Recoil * cam.Shake)
	end
	if cam.FovKick > 0 then
		ClientState.FovKick = (ClientState.FovKick or 0) + def.Recoil * cam.FovKick
	end
	ClientState.ShotFired:Fire()
	weaponEvent("Fire", { ADS = aimAlpha > 0.5 })

	if localAmmo <= 0 then
		task.delay(0.2, requestReload)
	end
end

-- Ráfaga (Vortex AR-9, Phantom Sidewind): varios disparos seguidos con una pausa entre ráfagas
local bursting = false
local lastBurstEnd = 0
local function startBurst()
	if bursting or not def or not def.Burst then
		return
	end
	if sprintAlpha > 0.35 then -- (salida del sprint: la ráfaga sale cuando el arma esté arriba)
		ClientState.LastShotTime = os.clock()
		ClientState.Sprinting = false
		pendingShot, pendingBurst = pendingShot or os.clock(), true
		return
	end
	if os.clock() - lastBurstEnd < (def.BurstCooldown or 0.3) then
		return
	end
	bursting = true
	local burstDef = def
	task.spawn(function()
		for i = 1, burstDef.Burst do
			if def ~= burstDef or localAmmo <= 0 or reloadStart then
				break
			end
			fire()
			if i < burstDef.Burst then
				task.wait(1 / burstDef.FireRate + 0.01)
			end
		end
		lastBurstEnd = os.clock()
		bursting = false
	end)
end

local function melee()
	-- El arma cuerpo a cuerpo que lleves (cuchillo, martillo o katana) está en la ranura 3
	local meleeTool = getTools()[3]
	local knife = meleeTool and Weapons.Get(meleeTool:GetAttribute("Weapon"))
	if not knife or knife.Type ~= "Melee" then
		return
	end
	local now = os.clock()
	if now - meleeTime < knife.Cooldown or ClientState.IsBlocked() or ClientState.Frozen() or not humanoid or humanoid.Health <= 0 then
		return
	end
	meleeTime = now
	cancelInspect()
	meleeWithKnife = def ~= nil and def.Type == "Melee"
	meleeSide = -meleeSide -- golpes alternos: uno de derecha a izquierda y el siguiente al revés
	meleeDuration = meleeWithKnife and math.clamp(knife.Cooldown * 0.75, 0.32, 0.6) or 0.38
	if reloadStart then
		weaponEvent("ReloadCancel")
	end
	reloadStart = nil
	lastActivity = now
	-- (hueco de audio propio del arma que golpea; si no tiene, el «fium» de siempre)
	local swingWeapon = meleeWithKnife and meleeTool:GetAttribute("Weapon") or (equippedTool and equippedTool:GetAttribute("Weapon"))
	if Sounds.WeaponSoundName(swingWeapon, "Melee", nil) then
		Sounds.PlayWeapon(swingWeapon, "Melee", nil)
	else
		Sounds.Play("MeleeSwing")
	end
	weaponEvent("Melee", { Knife = meleeWithKnife })
	-- Momento del golpe en la animación (el impacto real ya se decidió al pulsar)
	local token = meleeTime
	task.delay(meleeDuration * visual.Melee.HitAt, function()
		if meleeTime == token and equippedTool then
			weaponEvent("MeleeHit")
			kickCharm(visual.Charm.Fire * 2)
		end
	end)

	updateRayFilter()
	local origin = camera.CFrame.Position
	local direction = camera.CFrame.LookVector * knife.Range
	local result = workspace:Spherecast(origin, 1.2, direction, rayParams) or workspace:Raycast(origin, direction, rayParams)
	if result and result.Instance then
		Remotes.Melee:FireServer(result.Instance)
	end
end

---------------------------------------------------------------------------
-- Animación procedural del viewmodel (cada frame)
---------------------------------------------------------------------------

-- ¿Hay un enemigo vivo justo en el centro de la mira (al alcance del arma)?
local function enemyInSights()
	local hit = workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * math.min(def.Range or 300, 400), rayParams)
	local model = hit and hit.Instance:FindFirstAncestorOfClass("Model")
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or model == character then
		return false
	end
	-- (con la protección de aparición no se le puede herir: no vaciar el cargador en el escudo)
	if model:FindFirstChildOfClass("ForceField") then
		return false
	end
	if not ReplicatedStorage:GetAttribute("TeamMode") then
		return true
	end
	local owner = Players:GetPlayerFromCharacter(model)
	local team = owner and owner.Team and owner.Team.Name or model:GetAttribute("Team")
	return team ~= nil and team ~= "" and player.Team ~= nil and team ~= player.Team.Name
end

local function renderStep(dt)
	if not character or not humanoid then
		return
	end

	-- Disparo automático
	if triggerHeld and def and def.Type == "Gun" and def.Automatic then
		fire()
	end
	-- Disparo automático (modo sencillo de los shooters de móvil): con la mira sobre un enemigo,
	-- el arma dispara sola. Ajustes: 2 = solo en pantallas táctiles (por defecto), 1 = siempre, 0 = no
	local autoMode = math.floor(((ClientState.Settings or GameConfig.DefaultSettings).AutoFire or 2) + 0.5)
	-- (el rayo solo cuando el arma ya puede disparar: no cada fotograma de la cadencia)
	local touchOnly = InputMode.TouchUI()
	if autoMode ~= 0 and (autoMode == 1 or touchOnly) and def and def.Type == "Gun"
		and not reloadStart and not bursting and os.clock() - lastShot >= 1 / def.FireRate
		and not ClientState.IsBlocked() and not ClientState.InMainMenu and enemyInSights() then
		if def.Burst then
			startBurst()
		else
			fire()
		end
	end
	-- Disparo pendiente de la salida del sprint (si se tarda demasiado, se descarta)
	if pendingShot then
		if os.clock() - pendingShot > 0.5 or not def or def.Type ~= "Gun" then
			pendingShot, pendingBurst = nil, false
		elseif sprintAlpha <= 0.35 then
			local burst = pendingBurst
			pendingShot, pendingBurst = nil, false
			if burst then
				startBurst()
			elseif not (triggerHeld and def.Automatic) then -- (el automático ya dispara solo)
				fire()
			end
		end
	end

	local firing = os.clock() - lastShot < 0.15
	ClientState.Bloom = math.max(0, ClientState.Bloom - dt * (firing and 5 or 14))
	ClientState.Spread = currentSpread()

	-- Recarga: tiempo límite por si el servidor la rechazó
	if reloadStart and def and os.clock() - reloadStart > reloadDuration + 1 then
		reloadStart = nil
	end
	ClientState.Reloading = reloadStart ~= nil
	ClientState.ReloadProgress = (reloadStart and def) and math.clamp((os.clock() - reloadStart) / reloadDuration, 0, 1)
		or 0
	ClientState.Ammo = localAmmo

	-- Apuntar
	local canAim = def ~= nil and def.Type == "Gun" and aimHeld and not reloadStart and not ClientState.IsBlocked()
	ClientState.Aiming = canAim
	if canAim then
		cancelInspect()
	end
	-- (cada tipo de arma apunta a su ritmo: subfusiles y pistolas antes, ametralladora más despacio)
	aimAlpha = lerp(aimAlpha, canAim and 1 or 0, math.min(1, dt * feel.Aim.Speed))
	if aimAlpha < 0.001 then
		aimAlpha = 0
	end
	ClientState.AimAlpha = aimAlpha
	sprintAlpha = lerp(sprintAlpha, (ClientState.Sprinting and not reloadStart) and 1 or 0, math.min(1, dt * feel.Sprint.Speed))
	-- Correr cancela la inspección
	if sprintAlpha > 0.5 then
		cancelInspect()
	end

	-- Muerto (o en la killcam) la cámara ya no es tuya: nada de retroceso, balanceo ni temblores
	if not ClientState.Dead and humanoid.Health > 0 then
		-- Retroceso de cámara
		local applyPitch = camKick * math.min(1, dt * GAMEPLAY.ApplySpeed)
		local applyYaw = camYaw * math.min(1, dt * GAMEPLAY.ApplySpeed)
		camKick -= applyPitch
		camYaw -= applyYaw
		if applyPitch ~= 0 or applyYaw ~= 0 then
			camera.CFrame = camera.CFrame * CFrame.Angles(applyPitch, applyYaw, 0)
		end
		-- Recuperación: al dejar de disparar, la mira baja sola parte de lo que subió. Si mientras
		-- disparabas ya tirabas del ratón hacia abajo, eso cuenta y no baja de más.
		local mouseDown = UserInputService:GetMouseDelta().Y
		if mouseDown > 0 and debtPitch > 0 then
			debtPitch = math.max(0, debtPitch - mouseDown * 0.0025)
		end
		if os.clock() - lastShot > 0.12 and math.abs(camKick) < 0.002 and (debtPitch > 0.0005 or math.abs(debtYaw) > 0.0005) then
			local r = math.min(1, dt * GAMEPLAY.RecoverSpeed)
			local backPitch, backYaw = debtPitch * r, debtYaw * r
			debtPitch -= backPitch
			debtYaw -= backYaw
			camera.CFrame = camera.CFrame * CFrame.Angles(-backPitch * GAMEPLAY.Recover, -backYaw * GAMEPLAY.Recover, 0)
		end
		-- Golpe visual de cámara (muelle). Solo se aplica lo que cambió desde el fotograma anterior: al
		-- volver el muelle a 0 la cámara queda exactamente donde estaba
		do
			local cam = feel.Camera
			local step = WeaponFeel.StepSpring
			punchPitch, punchVelPitch = step(punchPitch, punchVelPitch, cam.Stiffness, cam.Damping, dt)
			punchYaw, punchVelYaw = step(punchYaw, punchVelYaw, cam.Stiffness, cam.Damping, dt)
			punchRoll, punchVelRoll = step(punchRoll, punchVelRoll, cam.Stiffness, cam.Damping, dt)
			if math.abs(punchPitch) + math.abs(punchYaw) + math.abs(punchVelPitch) + math.abs(punchVelYaw) < 1e-5 then
				punchPitch, punchYaw, punchVelPitch, punchVelYaw = 0, 0, 0, 0
			end
			local deltaPitch, deltaYaw = punchPitch - appliedPunchPitch, punchYaw - appliedPunchYaw
			if deltaPitch ~= 0 or deltaYaw ~= 0 then
				camera.CFrame = camera.CFrame * CFrame.Angles(deltaPitch, deltaYaw, 0)
				appliedPunchPitch, appliedPunchYaw = punchPitch, punchYaw
			end
		end
		-- Asistencia de apuntado (dedo o mando): la mira se va hacia el enemigo cercano. Lo que ya
		-- corrigió hacia abajo (o al lado contrario del retroceso) no se recupera otra vez al soltar
		local _, assistPitch, assistYaw = AimAssist.Update(dt)
		if assistPitch < 0 and debtPitch > 0 then
			debtPitch = math.max(0, debtPitch + assistPitch)
		end
		if assistYaw * debtYaw < 0 then
			debtYaw = math.sign(debtYaw) * math.max(0, math.abs(debtYaw) - math.abs(assistYaw))
		end
		-- Visor de francotirador: el pulso mueve un poco la mira (Mayús: aguantar la respiración)
		local swayPitch, swayYaw = ScopeSway.Update(dt, def ~= nil and def.Scope == true and aimAlpha > 0.85)
		if swayPitch ~= 0 or swayYaw ~= 0 then
			camera.CFrame = camera.CFrame * CFrame.Angles(swayPitch, swayYaw, 0)
		end
		-- Tras una ráfaga larga (o varios tiros seguidos de escopeta/francotirador), sale humo del cañón
		if barrelHeat > 0 and os.clock() - lastShot > 0.3 then
			if barrelHeat >= HEAT_SMOKE and viewmodel and viewmodel.PrimaryPart and not viewmodelHidden then
				Effects.BarrelSmoke(viewmodel.PrimaryPart:FindFirstChild("Muzzle"), math.min(1, barrelHeat / 24))
				barrelHeat = 0
			else
				-- (se enfría poco a poco: así los tiros lentos del francotirador también calientan)
				barrelHeat = math.max(0, barrelHeat - dt * 1.5)
			end
		end

		-- Inclinación de cámara al moverse de lado y pequeña sacudida al disparar.
		-- El módulo de cámara recalcula el giro cada frame, así que esto no se acumula.
		if rootPart then
			local velocity = rootPart.AssemblyLinearVelocity
			local side = velocity:Dot(camera.CFrame.RightVector)
			strafeRoll = damp(strafeRoll, math.clamp(-side / 26, -1, 1) * math.rad(1.6), 8, dt)
		end
		shakeRoll = damp(shakeRoll, 0, 18, dt)
		-- Daño recibido: alabeo hacia un lado según cuánto (como mucho ~1,5°) y un tirón del arma
		if humanoid then
			local health = humanoid.Health
			if flinchHealth and health < flinchHealth - 1 and health > 0 then
				local hurt = math.min(flinchHealth - health, 40)
				flinchRoll += (math.random() < 0.5 and -1 or 1) * math.rad(hurt * 0.035)
				sideVel += (math.random() - 0.5) * hurt * 0.08
			end
			flinchHealth = health
		end
		flinchRoll = damp(flinchRoll, 0, 12, dt)
		-- (competitivo: apuntando tiembla mucho menos, y con «Efectos de pantalla: Reducidos» casi nada)
		local calm = (ClientState.ReducedFX() and 0.3 or 1) * (1 - 0.6 * aimAlpha)
		-- (el alabeo no se acumula: la cámara de Roblox lo recalcula cada fotograma)
		camera.CFrame = camera.CFrame * CFrame.Angles(0, 0, (strafeRoll + shakeRoll + flinchRoll) * calm + punchRoll)
		-- Temblor por explosiones cercanas (se apaga solo en ~0,6 s)
		local shake = ClientState.Shake or 0
		if shake > 0.01 then
			local t = os.clock() * 40
			local amount = shake * calm
			camera.CFrame = camera.CFrame
				* CFrame.Angles(math.noise(t, 1) * amount * 0.05, math.noise(t, 2) * amount * 0.05, math.noise(t, 3) * amount * 0.03)
			ClientState.Shake = math.max(0, shake - dt * 1.6)
		end
		-- Balanceo de cabeza al andar y correr, y golpe al aterrizar desde alto. Solo se mueve la
		-- posición y el alabeo (no hacia dónde se mira), así que no desvía la puntería ni se acumula.
		local moveConfig = GameConfig.Movement
		if rootPart and humanoid and moveConfig then
			local v = rootPart.AssemblyLinearVelocity
			local flatSpeed = Vector3.new(v.X, 0, v.Z).Magnitude
			local onGround = humanoid.FloorMaterial ~= Enum.Material.Air and not ClientState.Sliding
			if onGround then
				headBobTime += dt * math.min(flatSpeed, 32) * 0.42
			end
			headBobAmount = damp(headBobAmount, onGround and math.clamp(flatSpeed / 18, 0, 1.6) or 0, 8, dt)
			local amount = headBobAmount * (moveConfig.CameraBob or 1) * (1 - aimAlpha * 0.85)
			if amount > 0.001 and not ClientState.InMainMenu then
				local y = -math.abs(math.sin(headBobTime)) * 0.08 * amount
				local roll = math.sin(headBobTime) * math.rad(0.4) * amount
				camera.CFrame = camera.CFrame * CFrame.new(0, y, 0) * CFrame.Angles(0, 0, roll)
			end
		end
		local land = ClientState.LandKick or 0
		if land > 0.01 then
			camera.CFrame = camera.CFrame * CFrame.new(0, -0.55 * land, 0) * CFrame.Angles(0, 0, math.rad(1.2) * land)
			ClientState.LandKick = land * decay(7, dt)
		else
			ClientState.LandKick = 0
		end
	end

	-- Latido de las skins míticas
	if #pulseParts > 0 and pulseSkin then
		local t = (math.sin(os.clock() * 3) + 1) / 2
		local color = pulseSkin.Accent:Lerp(pulseSkin.Accent2 or Color3.new(1, 1, 1), t)
		for _, part in pulseParts do
			part.Color = color
		end
		local glow = viewmodel and viewmodel.PrimaryPart and viewmodel.PrimaryPart:FindFirstChild("NeonGlow")
		if glow and glow:IsA("PointLight") then
			glow.Color = color
		end
	end

	-- Campo de visión (el del menú Ajustes) y sensibilidad: al apuntar baja en proporción al zoom
	local settings = ClientState.Settings or GameConfig.DefaultSettings
	local baseFov = settings.FOV or GameConfig.FieldOfView
	local targetFov = baseFov
	local aimScale = 1
	if def and def.AimFOV then
		targetFov = lerp(baseFov, math.min(def.AimFOV, baseFov), aimAlpha)
		aimScale = lerp(1, (settings.AimSensitivity or 0.8) * math.min(1, def.AimFOV / baseFov) ^ 0.5, aimAlpha)
	end
	local kick = ClientState.FovKick or 0
	if kick > 0.01 then
		ClientState.FovKick = kick * decay(5, dt)
	else
		ClientState.FovKick = 0
	end
	camera.FieldOfView = targetFov + sprintAlpha * feel.Sprint.Fov + kick
	UserInputService.MouseDeltaSensitivity = (settings.Sensitivity or 1) * aimScale

	-- La salida del arma anterior (Unequip) sigue aunque ya no haya arma
	stepRetiring()
	if not viewmodel or not def then
		ClientState.WeaponAction = "None"
		return
	end

	local now = os.clock()
	local function smooth(x)
		x = math.clamp(x, 0, 1)
		return x * x * (3 - 2 * x)
	end
	local function window(x, a, b) -- 0 -> 1 entre a y b
		return smooth((x - a) / (b - a))
	end
	local function pulse(x, center, width) -- 0 -> 1 -> 0 alrededor de center
		return smooth(1 - math.abs(x - center) / width)
	end
	local rad = math.rad

	---------------------------------------------------------------------
	-- 1) CUERPO: balanceo al andar, respiración, salto y caída
	---------------------------------------------------------------------
	-- Balanceo al caminar (al correr, más amplio y con giro: el "ocho" de los shooters)
	local speed, verticalSpeed = 0, 0
	if rootPart then
		local velocity = rootPart.AssemblyLinearVelocity
		speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
		verticalSpeed = velocity.Y
	end
	local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
	if grounded and not ClientState.Sliding then
		bobTime += dt * math.min(speed, 30) * 0.45
	end
	local bobAmount = math.clamp(speed / 18, 0, 1.5) * (1 - aimAlpha * (1 - feel.Aim.Bob))
	if not grounded or ClientState.Sliding then
		bobAmount = 0
	end
	local s = sprintAlpha
	-- (las armas pesadas se balancean menos: llevan más peso que inercia)
	local bobScale = lerp(feel.Bob.Walk, feel.Bob.Sprint, s)
	local bob = CFrame.new(
		math.cos(bobTime) * (0.05 + 0.05 * s) * bobAmount * bobScale,
		-math.abs(math.sin(bobTime)) * (0.06 + 0.04 * s) * bobAmount * bobScale,
		0
	) * CFrame.Angles(0, 0, math.cos(bobTime) * rad(3.5) * s * bobAmount * bobScale)

	-- Respiración: el arma nunca está del todo quieta (apuntando, casi nada; la mira no se mueve de
	-- forma apreciable)
	local breathScale = (1 - aimAlpha * 0.8) * (1 - math.min(1, bobAmount)) * visual.Idle.Breath
	local breath = CFrame.new(math.sin(now * 0.8) * 0.01 * breathScale, math.sin(now * 1.6) * 0.014 * breathScale, 0)
		* CFrame.Angles(math.sin(now * 1.6 + 0.6) * rad(0.5) * breathScale, 0, 0)

	-- Salto y caída: al despegar, el arma se queda un instante atrás (muelle); en el aire se queda
	-- detrás según la velocidad; al aterrizar se hunde (más cuanto más alta la caída: LandKick)
	if wasGrounded and not grounded and verticalSpeed > 4 then
		jumpVel -= visual.Jump.Kick
		lastActivity = now
	elseif grounded and not wasGrounded then
		kickCharm(visual.Charm.Land * math.max(0.3, ClientState.LandKick or 0))
		lastActivity = now
	end
	wasGrounded = grounded
	jumpY, jumpVel = WeaponFeel.StepSpring(jumpY, jumpVel, visual.Jump.Stiffness, visual.Jump.Damping, dt)
	airOffset = damp(airOffset, grounded and 0 or math.clamp(-verticalSpeed * 0.005, -0.12, 0.12), 10, dt)
	local land = ClientState.LandKick or 0
	local airCF = CFrame.new(0, airOffset - 0.2 * land + jumpY * 0.08, 0)
		* CFrame.Angles(airOffset * 0.8 - rad(7) * land + jumpY * rad(4), 0, 0)

	-- Inercia al mover el ratón: muelle exacto (se retrasa, se pasa un poco y vuelve; igual a cualquier
	-- fps). Las armas pesadas (las que te hacen ir más lento) van más perezosas.
	local delta = UserInputService:GetMouseDelta()
	local weight = math.clamp(def.WalkSpeedMultiplier or 1, 0.8, 1.15)
	local stiffness, damping = 160 * weight * weight, 16 * weight
	local swayGain = 0.004 * feel.Sway.Amount
	local targetX = math.clamp(-delta.X * swayGain, -0.12, 0.12)
	local targetY = math.clamp(-delta.Y * swayGain, -0.12, 0.12)
	local offX, offY
	offX, swayVelX = WeaponFeel.StepSpring(swayX - targetX, swayVelX, stiffness, damping, dt)
	offY, swayVelY = WeaponFeel.StepSpring(swayY - targetY, swayVelY, stiffness, damping, dt)
	swayX, swayY = targetX + offX, targetY + offY
	local swayScale = 1 - aimAlpha * (1 - feel.Aim.Sway) -- (apuntando casi no se mueve: no estorba al apuntar)
	local sway = CFrame.Angles(swayY * swayScale, swayX * swayScale, swayX * 0.6 * swayScale)

	-- Moverse de lado: el arma se inclina
	local strafeTilt = CFrame.Angles(0, 0, strafeRoll * 2.5 * (1 - aimAlpha * 0.8))

	---------------------------------------------------------------------
	-- 2) RETROCESO DEL ARMA (muelles exactos; se aplica el último, encima de todo)
	---------------------------------------------------------------------
	local view = feel.View
	recoilKick, kickVel = WeaponFeel.StepSpring(recoilKick, kickVel, view.Stiffness, view.Damping, dt)
	recoilRot, rotVel = WeaponFeel.StepSpring(recoilRot, rotVel, view.RotStiffness, view.RotDamping, dt)
	recoilSide, sideVel = WeaponFeel.StepSpring(recoilSide, sideVel, view.SideStiffness, view.SideDamping, dt)
	local recoilCF = CFrame.new(recoilSide * 0.4, 0, recoilKick) * CFrame.Angles(recoilRot, recoilSide * 0.6, recoilSide * 1.5)

	---------------------------------------------------------------------
	-- 3) POSE BASE: cadera -> mira (ADS)
	---------------------------------------------------------------------
	-- (en el teléfono, el arma de cadera algo más abajo, a la derecha y lejos: en una pantalla
	-- pequeña tapaba media pantalla y los botones táctiles)
	-- (un modelo nuevo puede traer su propia pose: WeaponVisual.Weapons[arma].ViewOffset / AimDistance)
	local hip = visual.ViewOffset or def.ViewOffset
	local hipOffset = phoneScreen and PHONE_HIP * hip or hip
	local base = hipOffset
	if points.AimPoint then
		-- (el AimPoint del arma queda en el centro exacto de la pantalla)
		local a = points.AimPoint
		local aimCF = CFrame.new(-a.X, -a.Y, -(visual.AimDistance or def.AimDistance) - a.Z)
		base = hipOffset:Lerp(aimCF, aimAlpha)
	end

	---------------------------------------------------------------------
	-- 4) LOCOMOCIÓN: sprint y pared
	---------------------------------------------------------------------
	local sprintCF = WeaponVisual.PoseCFrame(visual.Sprint, s)
	local sprinting = s > 0.5
	if sprinting ~= sprintShown then
		sprintShown = sprinting
		weaponEvent(sprinting and "SprintEnter" or "SprintExit")
	end

	-- Pegado a una pared: el arma se recoge y apunta hacia arriba en vez de atravesarla
	if now - wallCheckTime > 1 then
		wallCheckTime = now
		updateRayFilter()
	end
	local wallTarget = 0
	if def.Type == "Gun" and not ClientState.InMainMenu then
		local hit = workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * 3.4, rayParams)
		local part = hit and hit.Instance
		local solid = part and part:IsA("BasePart") and part.CanCollide and part.Transparency < 0.9
		if solid and not (part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")) then
			wallTarget = math.clamp(1 - (hit.Distance - 1.1) / 2.3, 0, 1) * (1 - aimAlpha * 0.6)
		end
	end
	wallAlpha = damp(wallAlpha, wallTarget, 10, dt)
	local w = wallAlpha
	local wallCF = CFrame.new(-0.1 * w, -0.1 * w, 0.55 * w) * CFrame.Angles(rad(32) * w, rad(-12) * w, rad(-14) * w)

	---------------------------------------------------------------------
	-- 5) ACCIONES: recarga, sacar, cuchillo, inspección y gesto de reposo
	---------------------------------------------------------------------
	-- Recarga (al ritmo de las marcas de WeaponVisual y de la duración REAL de la recarga). Con
	-- cargador: lo sueltas, la mano trae otro, lo encaja (golpe) y, si estaba vacía, monta el arma
	-- (palanca de carga si el modelo la tiene). Escopetas: cartucho a cartucho y bombeo al final.
	local reloadCF = CFrame.new()
	local magOffset, magFade = nil, 0
	local leftHandOffset, rightHandOffset = nil, nil -- desplazamiento de cada mano (espacio del arma)
	local slideBack, pumpBack, boltBack, chargeBack = 0, 0, 0, 0
	local p = reloadStart and ClientState.ReloadProgress or -1
	local shotgun = (def.Pellets or 1) > 1 and #moving.Mag == 0
	if p >= 0 then
		local timeline = reloadWasEmpty and visual.Reload.Empty or visual.Reload.Tactical
		local mOut, mIn = timeline.MagOut or 0.12, timeline.MagIn or 0.55
		local mBolt = visual.Reload.Empty.Bolt or 0.85
		local tilt = window(p, 0, 0.12) * (1 - window(p, 0.86, 1))
		local seat = pulse(p, mIn + 0.02, 0.05)
		local function aroundMag(rotation) -- (gira sobre su propio centro)
			return CFrame.new(magCenter) * rotation * CFrame.new(-magCenter)
		end
		if magCenter and not shotgun then
			-- Cargador fuera (cae acelerando y desaparece) y el nuevo sube desde abajo
			if p < mOut + 0.18 then
				local out = window(p, mOut - 0.02, mOut + 0.14)
				magOffset = CFrame.new(0, -1.8 * out * out, 0.12 * out) * aroundMag(CFrame.Angles(rad(-15) * out, 0, 0))
				magFade = out
			else
				local into = window(p, mIn - 0.21, mIn)
				magOffset = CFrame.new(0, -0.9 * (1 - into), 0.15 * (1 - into)) * aroundMag(CFrame.Angles(rad(-10) * (1 - into), 0, 0))
				magFade = 1 - window(p, mOut + 0.18, mOut + 0.26)
			end
			-- La mano izquierda baja a por el cargador nuevo, lo sube hasta su sitio y vuelve
			local hand = points.LeftHand or magCenter
			local grab = window(p, mOut + 0.02, mOut + 0.16) * (1 - window(p, mIn + 0.03, mIn + 0.17))
			local bottom = magCenter + Vector3.new(0, -0.35, 0.05) - hand
			local follow = p < mOut + 0.18 and Vector3.new(0, -0.9 * window(p, mOut + 0.04, mOut + 0.18), 0.15 * window(p, mOut + 0.04, mOut + 0.18))
				or magOffset.Position
			local handMove = (bottom + follow) * grab
			-- Vacía, con palanca de carga (fusil): la mano sube a la palanca, tira de ella y vuelve
			if reloadWasEmpty and chargeCenter then
				local reach = window(p, mBolt - 0.1, mBolt - 0.03) * (1 - window(p, mBolt + 0.06, mBolt + 0.13))
				chargeBack = pulse(p, mBolt + 0.01, 0.045)
				local toCharge = chargeCenter + Vector3.new(-0.08, 0.05, 0.05) - hand
				handMove += (toCharge + Vector3.new(0, 0, visual.Reload.ChargePull * chargeBack)) * reach
			end
			leftHandOffset = CFrame.new(handMove)
			local tiltPose = visual.Reload.Tilt
			local o = tiltPose.Offset * tilt + Vector3.new(0, 0.05 * seat, 0)
			local ang = tiltPose.Angles * tilt + Vector3.new(4 * seat, 0, 0)
			reloadCF = CFrame.new(o) * CFrame.Angles(rad(ang.X), rad(ang.Y), rad(ang.Z))
		elseif shotgun then
			-- Cartuchos: la mano va de la cartuchera a la ventana de carga una vez por cartucho
			local shells = visual.Reload.Shells
			local active = window(p, shells[1] - 0.12, shells[1] - 0.04) * (1 - window(p, shells[#shells] + 0.04, shells[#shells] + 0.1))
			local push = 0
			for _, at in shells do
				push = math.max(push, pulse(p, at, 0.07))
			end
			local port = Vector3.new(0, -0.32, -0.15) - (points.LeftHand or Vector3.new(0, -0.3, -1))
			if active > 0.001 then
				leftHandOffset = CFrame.new((port + Vector3.new(0.1, -0.55, 0.25) * (1 - push)) * active)
			end
			reloadCF = CFrame.new(-0.05 * tilt, -0.08 * tilt + 0.03 * push * active, 0)
				* CFrame.Angles(rad(12) * tilt, rad(-8) * tilt, rad(-32) * tilt)
			pumpBack = pulse(p, visual.Reload.ShellPump + 0.06, 0.06)
		else
			-- Lanzacohetes, ballesta, revólver...: la mano baja, trae la munición y la mete
			local fetch = pulse(p, 0.38, 0.22)
			leftHandOffset = CFrame.new(0.1 * fetch, -0.8 * fetch, 0.2 * fetch)
			reloadCF = CFrame.new(0, -0.3 * tilt + 0.04 * seat, 0) * CFrame.Angles(rad(-18) * tilt, 0, rad(30) * tilt)
		end
		-- Montar el arma (si estaba vacía): tirón seco hacia atrás
		if reloadWasEmpty and not shotgun then
			local charge = pulse(p, mBolt + 0.03, 0.05)
			reloadCF *= CFrame.new(0, 0, 0.06 * charge) * CFrame.Angles(rad(-3) * charge, 0, rad(-6) * charge)
			slideBack = p < mBolt + 0.01 and 1 or 0
		end
	elseif def.Type == "Gun" then
		local t = now - lastShot
		-- Corredera de las pistolas: atrás y adelante en cada disparo; abierta si te quedas sin balas
		slideBack = localAmmo <= 0 and 1 or (t < 0.03 and t / 0.03 or math.max(0, 1 - (t - 0.03) / 0.07))
		local manual = def.FireRate <= 1.6 and not def.Explosive and localAmmo > 0
		if manual and t < 0.7 then
			local cycle = (t - 0.14) / 0.36
			if cycle > 0 and cycle < 1 then
				local motion = math.sin(cycle * math.pi)
				if def.Pellets > 1 then
					-- Bombeo de la escopeta (con la mano izquierda en el guardamanos)
					pumpBack = motion
					reloadCF = CFrame.Angles(rad(-3) * motion, 0, rad(-4) * motion)
				elseif boltCenter then
					-- Cerrojo: la mano derecha va a la manilla, la abre, tira y la cierra
					boltBack = motion
					local reach = smooth(math.min(cycle / 0.2, (1 - cycle) / 0.2))
					rightHandOffset = CFrame.new((boltCenter - (points.RightHand or boltCenter) + Vector3.new(0.05, 0, 0.1)) * reach + Vector3.new(0, 0, 0.3 * motion))
					reloadCF = CFrame.new(0, -0.04 * reach, 0) * CFrame.Angles(0, 0, rad(-14) * reach)
				end
			end
		end
	end

	-- Sacar arma: sube desde abajo girando y se asienta con un pequeño rebote (no cambia cuándo se
	-- puede disparar: eso es EQUIP_READY)
	local e = math.clamp((now - equipTime) / feel.Equip.Time, 0, 1)
	local c1, c3 = 1.70158, 2.70158
	local raise = 1 + c3 * (e - 1) ^ 3 + c1 * (e - 1) ^ 2 -- (sale un poco de más y vuelve)
	local equipCF = WeaponVisual.PoseCFrame(visual.Equip, 1 - raise)

	-- Cuerpo a cuerpo: golpe rápido (el impacto es al instante) y vuelta más lenta, alternando lado
	local meleeCF = CFrame.new()
	local m = (now - meleeTime) / meleeDuration
	if m < 1 then
		local k = m < 0.3 and 1 - (1 - m / 0.3) ^ 3 or 1 - smooth((m - 0.3) / 0.7)
		local side = meleeSide
		if meleeWithKnife then
			meleeCF = CFrame.new(-0.6 * k * side, 0.15 * k, -0.6 * k)
				* CFrame.Angles(rad(-20) * k, rad(70) * k * side, rad(-35) * k * side)
		else
			-- Culatazo con el arma de fuego
			meleeCF = CFrame.new(-0.3 * k, 0.05 * k, -0.55 * k) * CFrame.Angles(rad(10) * k, rad(30) * k, rad(25) * k)
		end
	end

	-- Inspeccionar: claves de WeaponVisual (costado con skin y colgante, de cerca, el otro costado y remate)
	local inspectCF = CFrame.new()
	local it = (now - inspectTime) / visual.Inspect.Duration
	if it < 1 then
		local pos, ang = WeaponVisual.InspectPose(visual, it)
		inspectCF = CFrame.new(pos) * CFrame.Angles(rad(ang.X), rad(ang.Y), rad(ang.Z))
	end

	-- Acción que manda ahora (WeaponVisual.ActionPriority) y gesto de reposo: tras un rato sin hacer
	-- nada, la mano izquierda suelta el guardamanos y lo vuelve a agarrar. Cualquier acción (moverse,
	-- mirar, apuntar, disparar...) lo corta al momento.
	local busy = speed > 1.5 or delta.Magnitude > 3 or aimAlpha > 0.05 or s > 0.05 or reloadStart ~= nil
		or it < 1 or m < 1 or triggerHeld or now - lastShot < 0.3 or not grounded
	local action = WeaponVisual.ResolveAction({
		Melee = m < 1,
		Reload = reloadStart ~= nil,
		Equip = e < 1,
		Inspect = it < 1,
		Sprint = s > 0.5,
		IdleVariant = idleVariantStart ~= nil,
	})
	local idle = visual.Idle
	if busy then
		lastActivity = now
		idleVariantStart = nil
	elseif not idleVariantStart and action == "Idle" and def.Type == "Gun"
		and now - lastActivity > idle.VariantAfter and now - lastIdleVariant > idle.VariantCooldown then
		idleVariantStart, lastIdleVariant = now, now
		weaponEvent("IdleVariant")
		kickCharm(visual.Charm.Idle)
	end
	local idleCF = CFrame.new()
	local vt = idleVariantStart and (now - idleVariantStart) / idle.VariantDuration or 1
	if vt >= 1 then
		idleVariantStart = nil
	else
		local envelope = smooth(math.min(vt / 0.25, (1 - vt) / 0.3))
		local grip = pulse(vt, 0.5, 0.3)
		idleCF = CFrame.new(0, -0.03 * envelope, 0) * CFrame.Angles(rad(2) * envelope, 0, rad(idle.VariantRoll) * envelope)
		if not leftHandOffset then
			leftHandOffset = CFrame.new(idle.VariantHand * grip)
		end
	end
	ClientState.WeaponAction = (action == "Idle" and aimAlpha > 0.5) and "ADS" or action

	---------------------------------------------------------------------
	-- Colocar todo
	---------------------------------------------------------------------
	-- Mira telescópica: ocultar el arma
	-- (y también en la pantalla de inicio, donde la cámara está lejos)
	local hide = (def.Scope == true and aimAlpha > 0.85) or ClientState.InMainMenu or ClientState.Emoting or ClientState.KillcamActive
	setViewmodelHidden(hide)
	if hide then
		clearRetiring()
	else -- oculta no hace falta moverla cada fotograma
		viewmodel:PivotTo(
			camera.CFrame * bob * breath * sway * airCF * strafeTilt * base * sprintCF * wallCF * reloadCF * equipCF * meleeCF * inspectCF * idleCF * recoilCF
		)
		-- Piezas móviles (después de colocar el arma entera)
		local handle = viewmodel.PrimaryPart
		if handle then
			local handleCF = handle.CFrame
			placeGroup("Mag", handleCF, magOffset, magFade)
			placeGroup("Slide", handleCF, slideBack > 0.001 and CFrame.new(0, 0, 0.16 * slideBack) or nil)
			local pumpCF = pumpBack > 0.001 and CFrame.new(0, 0, 0.36 * pumpBack) or nil
			placeGroup("Pump", handleCF, pumpCF)
			placeGroup("Bolt", handleCF, boltBack > 0.001 and CFrame.new(0, 0.04 * boltBack, 0.3 * boltBack) or nil)
			placeGroup("Charge", handleCF, chargeBack > 0.001 and CFrame.new(0, 0, visual.Reload.ChargePull * chargeBack) or nil)
			-- La mano izquierda acompaña a la bomba de la escopeta
			if pumpCF and not leftHandOffset then
				leftHandOffset = pumpCF
			end
			-- Brazos: hombros pegados al cuerpo (cámara con su balanceo) y manos en el arma (IK)
			local body = camera.CFrame * bob * breath * airCF
			for side, rig in arms do
				local offset = side == "Left" and leftHandOffset or rightHandOffset
				local hand = (offset and handleCF * offset or handleCF) * rig.Hand
				placeArm(rig, body * rig.Shoulder, hand, body:VectorToWorldSpace(rig.Pole))
			end
		end
		swingCharm(dt, s, bobTime)
	end
end

---------------------------------------------------------------------------
-- Entrada
---------------------------------------------------------------------------

local function bindActions()
	TouchLayout.BindAction("Fire", function(_, state)
		if ClientState.IsBlocked() then
			triggerHeld = false
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin then
			triggerHeld = true
			if def and def.Type == "Melee" then
				melee()
			elseif def and def.Burst then
				startBurst()
			else
				fire()
			end
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			triggerHeld = false
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)
	TouchLayout.Set("Fire", UDim2.new(1, -110, 1, -160))

	TouchLayout.BindAction("Aim", function(_, state, input)
		if ClientState.IsBlocked() then
			aimHeld = false
			return Enum.ContextActionResult.Pass
		end
		if input and input.UserInputType == Enum.UserInputType.Touch then
			if state == Enum.UserInputState.Begin then
				aimHeld = not aimHeld -- en móvil es un interruptor
				aimToggled = aimHeld
			end
		elseif state == Enum.UserInputState.Begin then
			aimHeld, aimToggled = true, false
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			aimHeld = false
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL2)
	TouchLayout.Set("Aim", UDim2.new(1, -190, 1, -110))

	TouchLayout.BindAction("Reload", function(_, state)
		if state == Enum.UserInputState.Begin and not ClientState.IsBlocked() then
			requestReload()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.R, Enum.KeyCode.ButtonX)
	TouchLayout.Set("Reload", UDim2.new(1, -200, 1, -190))

	TouchLayout.BindAction("Melee", function(_, state)
		if state == Enum.UserInputState.Begin and not ClientState.IsBlocked() then
			melee()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.F, Enum.KeyCode.ButtonB)
	TouchLayout.Set("Melee", UDim2.new(1, -120, 1, -240))

	ContextActionService:BindAction("Slots", function(_, state, input)
		if state ~= Enum.UserInputState.Begin then
			return Enum.ContextActionResult.Pass
		end
		if input.KeyCode == Enum.KeyCode.One then
			equipSlot(1)
		elseif input.KeyCode == Enum.KeyCode.Two then
			equipSlot(2)
		elseif input.KeyCode == Enum.KeyCode.Three then
			equipSlot(3)
		elseif input.KeyCode == Enum.KeyCode.ButtonY then
			cycleSlot(1)
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.ButtonY)

	-- Cambiar de arma: tecla Q (siguiente) y botón táctil en móvil (no hay barra de inventario)
	ContextActionService:BindAction("Inspect", function(_, state)
		if state == Enum.UserInputState.Begin and not ClientState.IsBlocked() and not ClientState.VotePanelVisible and def and not reloadStart and not ClientState.Aiming then
			if os.clock() - inspectTime > visual.Inspect.Duration then
				inspectTime = os.clock()
				lastActivity = inspectTime
				weaponEvent("Inspect")
				Sounds.PlayWeapon(equippedTool and equippedTool:GetAttribute("Weapon"), "Inspect", nil)
				-- Momento de enseñar el colgante de cerca
				local token = inspectTime
				task.delay(visual.Inspect.Duration * visual.Inspect.Moment, function()
					if inspectTime == token and equippedTool then
						weaponEvent("InspectMoment")
						kickCharm(visual.Charm.Inspect)
					end
				end)
			end
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.V, Enum.KeyCode.DPadUp)

	TouchLayout.BindAction("SwapWeapon", function(_, state)
		if state == Enum.UserInputState.Begin and not ClientState.IsBlocked() then
			cycleSlot(1)
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.Q)
	TouchLayout.Set("SwapWeapon", UDim2.new(1, -280, 1, -100))

	UserInputService.InputChanged:Connect(function(input, processed)
		if processed or ClientState.IsBlocked() then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			cycleSlot(input.Position.Z > 0 and -1 or 1)
		end
	end)
end

---------------------------------------------------------------------------
-- Personaje
---------------------------------------------------------------------------

local characterConnections = {}

local function onCharacter(newCharacter)
	-- Las conexiones del personaje anterior se cortan (si no, el personaje viejo queda en memoria)
	for _, connection in characterConnections do
		connection:Disconnect()
	end
	table.clear(characterConnections)
	onUnequipped()
	character = newCharacter
	humanoid = newCharacter:WaitForChild("Humanoid")
	rootPart = newCharacter:WaitForChild("HumanoidRootPart")
	aimHeld, aimToggled = false, false
	aimAlpha, sprintAlpha = 0, 0
	resetPunch()
	camKick, camYaw = 0, 0
	debtPitch, debtYaw = 0, 0
	recoilKick, recoilRot, recoilSide = 0, 0, 0
	kickVel, rotVel, sideVel = 0, 0, 0
	flinchRoll, flinchHealth = 0, nil
	sprayCount = 0
	-- (un temblor o un golpe de aterrizaje pendientes de antes de morir no siguen en la vida nueva)
	ClientState.Shake = 0
	ClientState.LandKick = 0
	updateRayFilter()

	table.insert(characterConnections, newCharacter.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and child:GetAttribute("Weapon") then
			onEquipped(child)
		end
	end))
	table.insert(characterConnections, newCharacter.ChildRemoved:Connect(function(child)
		if child == equippedTool then
			onUnequipped(true)
		end
	end))
	local existing = newCharacter:FindFirstChildOfClass("Tool")
	if existing and existing:GetAttribute("Weapon") then
		onEquipped(existing)
	end

	table.insert(characterConnections, humanoid.Died:Connect(function()
		onUnequipped()
		triggerHeld = false
		-- (lo pendiente de retroceso y temblores no se aplica a la cámara de la muerte)
		camKick, camYaw = 0, 0
		debtPitch, debtYaw = 0, 0
		resetPunch()
		ClientState.Shake = 0
		ClientState.LandKick = 0
		ClientState.FovKick = 0
		ScopeSway.Reset()
	end))
end

-- Efectos de los disparos de otros jugadores (y bots). Para no dar tirones en móviles: de lejos o
-- con calidad Baja solo la trazadora, y como mucho un sonido por arma cada 0,1 s.
local FAR_SHOT = 120
local lastRemoteSound = setmetatable({}, { __mode = "k" }) -- [tool] = os.clock()
local lastWhiz = 0

local function isTeammateTool(tool)
	local owner = tool.Parent and Players:GetPlayerFromCharacter(tool.Parent)
	if owner == player then
		return true
	end
	-- (los bots guardan el nombre de su equipo en el atributo "Team" del modelo)
	local team = tool.Parent and tool.Parent:GetAttribute("Team")
	if owner then
		team = owner.Team and owner.Team.Name
	end
	return team ~= nil and team ~= "" and player.Team ~= nil and team == player.Team.Name
end

local function onShotFX(tool, endpoints)
	if typeof(tool) ~= "Instance" or not tool.Parent or type(endpoints) ~= "table" then
		return
	end
	local handle = tool:FindFirstChild("Handle")
	local muzzle = handle and handle:FindFirstChild("Muzzle")
	if not muzzle then
		return
	end
	local color = WeaponModels.GetPalette(tool:GetAttribute("Weapon"), tool:GetAttribute("Skin")).Accent
	local weaponDef = Weapons.Get(tool:GetAttribute("Weapon"))
	local cheap = ClientState.EffectiveQuality == "Baja" or (muzzle.WorldPosition - camera.CFrame.Position).Magnitude > FAR_SHOT
	for index, position in endpoints do
		if typeof(position) == "Vector3" and index <= 3 then
			if weaponDef and weaponDef.Explosive then
				Effects.Rocket(muzzle.WorldPosition, position, weaponDef.ProjectileSpeed or 200, color, weaponDef.Explosive.Radius, weaponDef.ProjectileStyle)
			else
				Effects.Tracer(muzzle.WorldPosition, position, color)
				-- Paintball: también se ven las manchas de los disparos de los demás (si no es caro)
				if weaponDef and weaponDef.ImpactStyle and not cheap then
					local direction = position - muzzle.WorldPosition
					if direction.Magnitude > 1 then
						local hit = workspace:Raycast(position - direction.Unit * 1.5, direction.Unit * 3, rayParams)
						if hit then
							Effects.Impact(hit.Position, hit.Normal, hit.Instance, hit.Material, weaponDef.ImpactStyle)
						end
					end
				end
			end
		end
	end
	if not cheap then
		Effects.MuzzleFlash(muzzle, nil, true, WeaponFeel.Get(tostring(tool:GetAttribute("Weapon")), weaponDef).Flash)
	end
	local now = os.clock()
	if now - (lastRemoteSound[tool] or 0) >= 0.1 then
		lastRemoteSound[tool] = now
		Sounds.PlayShot(tool:GetAttribute("Weapon"), weaponDef, handle, camera.CFrame.Position)
	end
	-- Bala que te pasa rozando: "fiuu" (solo si no te ha dado de lleno y no es de tu equipo)
	if weaponDef and not weaponDef.Explosive and now - lastWhiz > 0.15 and not isTeammateTool(tool) then
		local listener = camera.CFrame.Position
		local from = muzzle.WorldPosition
		for _, position in endpoints do
			if typeof(position) == "Vector3" then
				local segment = position - from
				local length = segment.Magnitude
				if length > 1 then
					local along = math.clamp((listener - from):Dot(segment / length), 0, length)
					local closest = from + segment / length * along
					local gap = (listener - closest).Magnitude
					-- (lejos del final: si acaba justo en ti, es que te ha dado)
					if gap < 7 and gap > 1.5 and length - along > 4 then
						lastWhiz = now
						local sound = Sounds.Play("Whiz", nil, 0.9 + math.random() * 0.25, 1.2 - gap / 7)
						if sound then
							sound.TimePosition = 0.05
						end
						-- (supresión: un instante de desenfoque, más cuanto más cerca pasa)
						CombatFX.Suppress(1 - gap / 7)
						break
					end
				end
			end
		end
	end
end

function WeaponController.Init()
	UserInputService.MouseIconEnabled = false
	-- (teléfono o no: se mira cuando se sabe el tamaño de pantalla y al girarla)
	task.spawn(function()
		UI.WaitViewport()
		phoneScreen = UI.IsPhone()
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			phoneScreen = UI.IsPhone()
		end)
	end)
	bindActions()
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	Remotes.ShotFX.OnClientEvent:Connect(onShotFX)
	RunService:BindToRenderStep("WeaponViewmodel", Enum.RenderPriority.Camera.Value + 1, renderStep)
end

return WeaponController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="239">
            <Properties>
              <string name="Name">WeaponIcon</string>
              <string name="Source"><![CDATA[-- Iconos 3D de armas: dibuja el modelo real (con su skin) dentro de un ViewportFrame.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local WeaponModels = require(Shared.WeaponModels)

local WeaponIcon = {}

local FOV = 20

-- view: "side" (de perfil, cañón a la derecha) o "angled" (tres cuartos)
-- aspect: ancho / alto del ViewportFrame
function WeaponIcon.Create(weaponName, skinId, props, view, aspect)
	local viewport = Instance.new("ViewportFrame")
	viewport.BackgroundTransparency = 1
	-- (luz de estudio: ambiente algo frío y más bajo, y luz principal cálida desde arriba y delante,
	-- para que se lean los volúmenes y brillen el metal y los ribetes)
	viewport.Ambient = Color3.fromRGB(150, 156, 178)
	viewport.LightColor = Color3.fromRGB(255, 244, 226)
	viewport.LightDirection = Vector3.new(-0.8, -1.6, -0.9)
	for key, value in props or {} do
		viewport[key] = value
	end

	local model = WeaponModels.Build(weaponName, skinId, false)
	model.Parent = viewport

	local camera = Instance.new("Camera")
	camera.FieldOfView = FOV
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	local boxCFrame, size = model:GetBoundingBox()
	local center = boxCFrame.Position
	aspect = aspect or 2.5
	local tanHalf = math.tan(math.rad(FOV / 2))

	local direction
	if view == "angled" then
		direction = Vector3.new(1, 0.35, 0.45).Unit
	else
		direction = Vector3.new(1, 0.05, 0).Unit
	end
	-- Distancia para que quepa: el largo del arma (Z) en horizontal y el alto (Y) en vertical
	local fitVertical = (size.Y / 2) / tanHalf
	local fitHorizontal = (size.Z / 2) / (tanHalf * aspect)
	local margin = view == "angled" and 1.35 or 1.12
	local distance = math.max(fitVertical, fitHorizontal) * margin + size.X / 2
	camera.CFrame = CFrame.lookAt(center + direction * distance, center)
	return viewport
end

return WeaponIcon
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="240">
            <Properties>
              <string name="Name">Wheel</string>
              <string name="Source"><![CDATA[-- Ruleta diaria (Shop.Wheel): un giro gratis al día y giros extra con Robux. La ruleta gira y se para
-- en el premio que decide el servidor. Las probabilidades se ven debajo de la ruleta.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local MarketplaceService = game:GetService("MarketplaceService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Shop = require(Shared.Shop)
local Sounds = require(Shared.Sounds)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local RewardFX = require(script.Parent.RewardFX)

local player = Players.LocalPlayer

local Wheel = {}

local SIZE = 340
local gui, panel, rotor, spinButton, buyButton, status, closeButton
local spinning = false
local currentRotation = 0

local function prizes()
	return Shop.Wheel.Prizes
end

-- Texto del botón según los giros disponibles
local function refresh()
	if not gui then
		return
	end
	local data = ClientState.Data
	local free = data and data.WheelFree == true
	local bought = data and data.WheelSpins or 0
	if spinning then
		spinButton.Text = "..."
	elseif free then
		spinButton.Text = "🎁 ¡GIRO GRATIS!"
	elseif bought > 0 then
		spinButton.Text = "🎡 GIRAR (" .. bought .. ")"
	else
		spinButton.Text = "Vuelve mañana"
	end
	spinButton.BackgroundColor3 = (free or bought > 0) and Color3.fromRGB(60, 200, 90) or Color3.fromRGB(70, 70, 82)
	local canBuy = Shop.Wheel.SpinProductId ~= 0 and not (data and data.CratesRestricted)
	buyButton.Visible = canBuy
end

local function build()
	gui = UI.new("ScreenGui", {
		Name = "Wheel",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 20,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local shade = UI.new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Text = "",
		AutoButtonColor = false,
		Modal = true,
		Parent = gui,
	})
	_ = shade
	panel = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(440, 600),
		BackgroundColor3 = Color3.fromRGB(22, 24, 38),
		Parent = gui,
	}, { UI.corner(18), UI.stroke(Color3.fromRGB(255, 200, 60), 3, 0) })
	local scale = UI.new("UIScale", { Parent = panel })
	local function fit()
		local viewport = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.clamp(math.min((viewport.X - 20) / 440, (viewport.Y - 20) / 600), 0.45, 1)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	fit()
	UI.label({ Position = UDim2.fromOffset(0, 12), Size = UDim2.new(1, 0, 0, 36), Text = "🎡 RULETA DIARIA", TextSize = 30, TextColor3 = Color3.fromRGB(255, 210, 60), Parent = panel })
	closeButton = UI.button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.fromOffset(36, 36), Text = "✕", TextSize = 22, BackgroundColor3 = Color3.fromRGB(200, 60, 70), Parent = panel })
	closeButton.Activated:Connect(function()
		if not spinning then
			Wheel.Close()
		end
	end)

	-- Ruleta: un círculo (CanvasGroup redondo que recorta) con una porción por premio
	local wheelFrame = UI.new("CanvasGroup", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 66),
		Size = UDim2.fromOffset(SIZE, SIZE),
		BackgroundColor3 = Color3.fromRGB(40, 44, 70),
		Parent = panel,
	}, { UI.corner(SIZE / 2) })
	rotor = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = wheelFrame })
	local list = prizes()
	local step = 360 / #list
	-- Cada porción es un abanico de barras finas que salen del centro (parece una cuña)
	local BARS = 10
	local radius = SIZE / 2 + 2
	for i, prize in list do
		local angle = (i - 1) * step
		for k = 1, BARS do
			local sub = angle - step / 2 + (k - 0.5) * step / BARS
			local rad = math.rad(sub)
			UI.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, math.sin(rad) * radius / 2, 0.5, -math.cos(rad) * radius / 2),
				Size = UDim2.fromOffset(math.ceil(2 * radius * math.sin(math.rad(step / BARS / 2))) + 2, radius),
				Rotation = sub,
				BackgroundColor3 = prize.Color,
				BorderSizePixel = 0,
				Parent = rotor,
			})
		end
		-- Separador blanco entre porciones
		local edge = math.rad(angle - step / 2)
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.sin(edge) * radius / 2, 0.5, -math.cos(edge) * radius / 2),
			Size = UDim2.fromOffset(3, radius),
			Rotation = angle - step / 2,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = rotor,
		})
		-- Premio escrito a lo largo del radio
		local rad = math.rad(angle)
		UI.label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.sin(rad) * radius * 0.62, 0.5, -math.cos(rad) * radius * 0.62),
			Size = UDim2.fromOffset(84, 26),
			Rotation = angle, -- (el ganador queda arriba y se lee derecho)
			Text = Shop.WheelPrizeText(prize),
			TextSize = 20,
			TextScaled = true,
			TextColor3 = Color3.new(1, 1, 1),
			ZIndex = 4,
			Parent = rotor,
		})
	end
	-- Centro y puntero
	UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(56, 56),
		BackgroundColor3 = Color3.fromRGB(255, 210, 60),
		ZIndex = 6,
		Parent = wheelFrame,
	}, { UI.corner(28), UI.stroke(Color3.new(1, 1, 1), 3, 0) })
	UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 44),
		Size = UDim2.fromOffset(40, 40),
		Text = "▼",
		TextSize = 40,
		TextColor3 = Color3.fromRGB(255, 70, 90),
		ZIndex = 8,
		Parent = panel,
	})

	-- Probabilidades
	local total = 0
	for _, prize in list do
		total += prize.Weight
	end
	local odds = {}
	for _, prize in list do
		table.insert(odds, Shop.WheelPrizeText(prize) .. " " .. string.format("%g", math.floor(prize.Weight / total * 1000 + 0.5) / 10) .. "%")
	end
	UI.label({
		Position = UDim2.fromOffset(16, 416),
		Size = UDim2.new(1, -32, 0, 40),
		Text = "Probabilidades: " .. table.concat(odds, " · "),
		TextSize = 13,
		TextWrapped = true,
		TextColor3 = Color3.fromRGB(180, 185, 210),
		Font = UI.FontBody,
		TextStrokeTransparency = 1,
		Parent = panel,
	})
	status = UI.label({ Position = UDim2.fromOffset(0, 460), Size = UDim2.new(1, 0, 0, 30), Text = "", TextSize = 22, TextColor3 = Color3.fromRGB(255, 220, 90), Parent = panel })

	spinButton = UI.button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 496),
		Size = UDim2.fromOffset(260, 46),
		Text = "",
		TextSize = 24,
		Parent = panel,
	}, { UI.gloss() })
	buyButton = UI.button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 548),
		Size = UDim2.fromOffset(260, 36),
		Text = "+" .. Shop.Wheel.SpinsPerPurchase .. " giros · " .. Shop.Wheel.SpinRobux .. " R$",
		TextSize = 18,
		BackgroundColor3 = Color3.fromRGB(40, 170, 90),
		Parent = panel,
	}, { UI.gloss() })
	buyButton.Activated:Connect(function()
		Sounds.Play("Click")
		pcall(MarketplaceService.PromptProductPurchase, MarketplaceService, player, Shop.Wheel.SpinProductId)
	end)
	spinButton.Activated:Connect(Wheel.Spin)
	ClientState.DataChanged.Event:Connect(refresh)
end

function Wheel.Spin()
	if spinning then
		return
	end
	local data = ClientState.Data
	if not data or not (data.WheelFree or (data.WheelSpins or 0) > 0) then
		status.Text = "Vuelve mañana para otro giro gratis"
		return
	end
	spinning = true
	status.Text = ""
	refresh()
	Sounds.Play("Click")
	local ok, success, index = pcall(function()
		return Remotes.SpinWheel:InvokeServer()
	end)
	if not (ok and success and type(index) == "number") then
		spinning = false
		status.Text = (ok and type(index) == "string") and index or "No se pudo girar"
		refresh()
		return
	end
	-- Para con el premio arriba (bajo el puntero), tras unas vueltas
	local step = 360 / #prizes()
	local target = -((index - 1) * step) + (math.random() - 0.5) * step * 0.6
	local base = currentRotation - currentRotation % 360
	local final = base + 360 * 5 + target
	currentRotation = final
	local tween = TweenService:Create(rotor, TweenInfo.new(4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Rotation = final })
	tween:Play()
	-- Clic de la ruleta al pasar las porciones
	task.spawn(function()
		local last = math.floor(rotor.Rotation / step)
		while tween.PlaybackState == Enum.PlaybackState.Playing do
			local now = math.floor(rotor.Rotation / step)
			if now ~= last then
				last = now
				Sounds.Play("Click", nil, 1.4, 0.6)
			end
			task.wait()
		end
	end)
	tween.Completed:Wait()
	local prize = prizes()[index]
	Sounds.Play(prize.Jackpot and "Flag" or "Kill")
	status.Text = (prize.Jackpot and "💥 ¡PREMIO GORDO! " or "¡Has ganado ") .. Shop.WheelPrizeText(prize) .. (prize.Jackpot and "" or "!")
	-- Los premios difíciles (caja, 600 monedas, el gordo) se celebran a lo grande
	if prize.Jackpot or (prize.Weight or 100) <= 8 then
		RewardFX.Celebrate(prize.Jackpot and "💥 ¡PREMIO GORDO!" or "🎉 ¡GRAN PREMIO!", Shop.WheelPrizeText(prize), prize.Color, prize.Jackpot == true)
	else
		RewardFX.EdgeFlash(prize.Color, 0.4)
	end
	spinning = false
	refresh()
end

function Wheel.Open()
	if not gui then
		build()
	end
	gui.Enabled = true
	ClientState.WheelOpen = true
	ClientState.UpdateMouse()
	status.Text = ""
	refresh()
end

function Wheel.Close()
	if gui then
		gui.Enabled = false
	end
	ClientState.WheelOpen = false
	ClientState.UpdateMouse()
end

function Wheel.Init()
	-- (se construye la primera vez que se abre)
end

return Wheel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="241">
            <Properties>
              <string name="Name">WorldFX</string>
              <string name="Source"><![CDATA[-- Efectos del mundo en el cliente:
--  * Piezas del mapa con atributo Spin (grados/seg) giran y con Bob (studs) flotan
--  * Con Orbit (grados/seg) giran alrededor de OrbitCenter sobre el eje OrbitAxis (la noria);
--    con OrbitUpright solo se mueven sin girar (las cabinas siguen derechas), colgando de OrbitAnchor
--  * Contorno de color en los compañeros de equipo (visible a través de paredes)
--  * Oculta el nombre de los enemigos
--  * Explosión de partículas cuando alguien es eliminado
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Teams = game:GetService("Teams")

local Effects = require(script.Parent.Effects)
local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local Remotes = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Remotes"))
local GameConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("GameConfig"))

local player = Players.LocalPlayer

local WorldFX = {}

local animated = {} -- [part] = { Base = CFrame, Spin = number, Bob = number, Phase = number }

local function track(inst)
	-- (los efectos sueltos de ClientFX nunca se animan aquí: se descartan lo antes posible)
	if not inst:IsA("BasePart") or (inst.Parent and inst.Parent.Name == "ClientFX") then
		return
	end
	local spin = inst:GetAttribute("Spin")
	local bob = inst:GetAttribute("Bob")
	local blink = inst:GetAttribute("Blink")
	local sweep = inst:GetAttribute("Sweep")
	local orbit = inst:GetAttribute("Orbit")
	if spin or bob or blink or sweep or orbit then
		local center, axis = inst:GetAttribute("OrbitCenter"), inst:GetAttribute("OrbitAxis")
		animated[inst] = {
			Base = inst.CFrame,
			Spin = spin or 0,
			Bob = bob or 0,
			Blink = blink,
			Sweep = sweep,
			Orbit = (orbit and typeof(center) == "Vector3" and typeof(axis) == "Vector3" and axis.Magnitude > 0) and orbit or nil,
			OrbitCenter = center,
			OrbitAxis = typeof(axis) == "Vector3" and axis.Magnitude > 0 and axis.Unit or nil,
			OrbitUpright = inst:GetAttribute("OrbitUpright") == true,
			OrbitAnchor = typeof(inst:GetAttribute("OrbitAnchor")) == "Vector3" and inst:GetAttribute("OrbitAnchor") or nil,
			BaseTransparency = inst.Transparency,
			Phase = math.random() * 10,
		}
	end
end

local frame = 0
local function animate()
	local t = os.clock()
	-- Lo que gira despacio (la noria) se mueve 1 de cada 2 fotogramas (1 de cada 4 en calidad Baja)
	frame += 1
	local orbitNow = frame % (ClientState.EffectiveQuality == "Baja" and 4 or 2) == 0
	for part, info in animated do
		if not part.Parent then
			animated[part] = nil
			continue
		end
		if info.Blink then
			-- Baliza que parpadea
			local on = math.sin((t + info.Phase) * math.pi * 2 / info.Blink) > 0
			if on ~= info.On then -- (solo se escribe al cambiar, no en cada fotograma)
				info.On = on
				part.Transparency = on and info.BaseTransparency or 0.95
			end
		end
		if info.Orbit then
			if not orbitNow then
				continue
			end
			local turn = CFrame.fromAxisAngle(info.OrbitAxis, math.rad(info.Orbit * t))
			-- (con ancla, la pieza sigue a su punto de enganche sin girar su propio desplazamiento)
			local anchor = info.OrbitAnchor or info.Base.Position
			local position = info.OrbitCenter + turn * (anchor - info.OrbitCenter) + (info.Base.Position - anchor)
			local rotation = info.Base - info.Base.Position
			part.CFrame = CFrame.new(position) * (info.OrbitUpright and rotation or (turn * rotation))
		elseif info.Sweep then
			-- Haz de luz que barre a un lado y a otro desde su base
			local pivot = (info.Base * CFrame.new(0, -part.Size.Y / 2, 0)).Position
			local angle = math.rad(info.Sweep) * math.sin(t * 0.4 + info.Phase)
			part.CFrame = CFrame.new(pivot) * CFrame.Angles(0, angle, 0) * (CFrame.new(pivot):Inverse() * info.Base)
		elseif info.Spin ~= 0 or info.Bob ~= 0 then
			local position = info.Base.Position + Vector3.new(0, math.sin(t * 1.5 + info.Phase) * info.Bob, 0)
			local rotation = info.Base - info.Base.Position
			-- Giro alrededor del eje Y del mundo que pasa por la pieza
			part.CFrame = CFrame.new(position) * CFrame.Angles(0, math.rad(info.Spin * t), 0) * rotation
		end
	end
end

---------------------------------------------------------------------------
-- Jugadores
---------------------------------------------------------------------------

-- Color del contorno de enemigos: el que elija el jugador en Ajustes (rojo por defecto)
local function enemyColor()
	local settings = ClientState.Settings or GameConfig.DefaultSettings
	local entry = GameConfig.EnemyColors[math.floor(settings.EnemyColor or 1)]
	return entry and entry.Color or Color3.fromRGB(255, 64, 52)
end

local function teamColorOf(other)
	return other and other.Team and other.TeamColor.Color or Color3.fromRGB(255, 200, 60)
end

-- Compañeros: contorno del color del equipo y nombre visible. Enemigos: sin nombre.
local function applyStyle(character, isTeammate, isSelf, color)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local highlight = character:FindFirstChild("TeamHighlight")
	if isTeammate and not isSelf then
		if not highlight then
			highlight = Instance.new("Highlight")
			highlight.Name = "TeamHighlight"
			highlight.FillTransparency = 1
			highlight.OutlineTransparency = 0.2
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.Parent = character
		end
		highlight.OutlineColor = UI.teamTint(color, true) -- (el azul puro casi no se ve: más claro)
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	else
		if highlight then
			highlight:Destroy()
		end
		if not isSelf then
			-- Sin nombre sobre los enemigos: hay que encontrarlos
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
	end
	-- Enemigos: un contorno rojo fino que solo se ve donde ya los ves (no atraviesa paredes). Así se
	-- distinguen al momento del fondo, también en mapas oscuros o con ropa del color de las paredes
	local outline = character:FindFirstChild("EnemyOutline")
	local enemy = not isTeammate and not isSelf and GameConfig.EnemyOutline ~= false and humanoid.Health > 0
	if enemy then
		if not outline then
			outline = Instance.new("Highlight")
			outline.Name = "EnemyOutline"
			outline.FillTransparency = 1
			outline.OutlineTransparency = 0.45
			outline.OutlineColor = enemyColor()
			outline.DepthMode = Enum.HighlightDepthMode.Occluded
			outline.Parent = character
			-- (al caer se quita: un cuerpo ya no es una amenaza)
			humanoid.Died:Connect(function()
				if outline.Parent then
					outline:Destroy()
				end
			end)
		end
	elseif outline then
		outline:Destroy()
	end
	if enemy and outline then
		outline.OutlineColor = enemyColor()
	end
end

local function styleCharacter(other, character)
	applyStyle(character, player.Team ~= nil and other.Team == player.Team, other == player, teamColorOf(other))
end

-- Bots (carpeta workspace.Bots): el servidor les pone el atributo Team
local function styleBot(model)
	local teamName = model:GetAttribute("Team")
	local team = teamName and teamName ~= "" and Teams:FindFirstChild(teamName)
	local isTeammate = player.Team ~= nil and team == player.Team
	applyStyle(model, isTeammate, false, team and team:IsA("Team") and team.TeamColor.Color or Color3.fromRGB(255, 200, 60))
end

local function onCharacter(other, character)
	character:WaitForChild("Humanoid", 10)
	styleCharacter(other, character)
end

local function onPlayer(other)
	other.CharacterAdded:Connect(function(character)
		onCharacter(other, character)
	end)
	if other.Character then
		task.spawn(onCharacter, other, other.Character)
	end
	other:GetPropertyChangedSignal("Team"):Connect(function()
		if other.Character then
			styleCharacter(other, other.Character)
		end
	end)
end

local function restyleAll()
	for _, other in Players:GetPlayers() do
		if other.Character then
			styleCharacter(other, other.Character)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			styleBot(model)
		end
	end
end

-- (al cambiar el color de los enemigos en Ajustes)
function WorldFX.Restyle()
	restyleAll()
end

function WorldFX.Init()
	-- Animaciones del mapa
	for _, inst in workspace:GetDescendants() do
		track(inst)
	end
	workspace.DescendantAdded:Connect(track)
	RunService.RenderStepped:Connect(animate)

	-- Jugadores
	for _, other in Players:GetPlayers() do
		onPlayer(other)
	end
	Players.PlayerAdded:Connect(onPlayer)
	player:GetPropertyChangedSignal("Team"):Connect(restyleAll)
	ClientState.SettingsChanged.Event:Connect(function(key)
		-- (solo el color de los enemigos cambia su contorno)
		if key == nil or key == "EnemyColor" then
			restyleAll()
		end
	end)
	task.spawn(function()
		local bots = workspace:WaitForChild("Bots", 30)
		if not bots then
			return
		end
		local function watchBot(model)
			model:WaitForChild("Humanoid", 10)
			styleBot(model)
			-- (en la Infección un bot cambia de bando al ser infectado)
			model:GetAttributeChangedSignal("Team"):Connect(function()
				styleBot(model)
			end)
		end
		bots.ChildAdded:Connect(watchBot)
		for _, model in bots:GetChildren() do
			task.spawn(watchBot, model)
		end
	end)

	-- Efecto de eliminación (lo decide el servidor: el que tenga equipado quien hizo la baja)
	Remotes.KillFX.OnClientEvent:Connect(function(position, effectId, color)
		if typeof(position) == "Vector3" and type(effectId) == "string" then
			Effects.KillEffect(effectId, position, typeof(color) == "Color3" and color or nil)
		end
	end)
end

return WorldFX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="242">
            <Properties>
              <string name="Name">ZoneName</string>
              <string name="Source"><![CDATA[-- Dónde estás (como en los shooters por equipos): debajo del minimapa, el nombre de la zona del mapa
-- («HOTEL CENTRAL», «AVENIDA», «BASE AZUL»). Las zonas con nombre las pone cada mapa (Kit.callout, y
-- los edificios con cartel); en el resto del mapa se dice la parte: «NORTE · LADO AZUL», «CENTRO».
-- Así un jugador puede decir «estoy en las obras» y todos saben dónde es. Solo en este cliente.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local HUDZones = require(script.Parent.HUDZones)

local ZoneName = {}

ZoneName.Interval = 0.25

local player = Players.LocalPlayer
local gui, label, scale
local clock = 0
local shown = nil
local mapInfo = nil -- { Map, Boxes = { { CFrame, Half, Volume, Name } }, Length, Width, Bases = { { Name, X } } }

-- Lo que se sabe del mapa (se calcula una vez por mapa)
local function readMap(map)
	local info = { Map = map, Boxes = {}, Bases = {}, ReadAt = os.clock() }
	local folder = map:FindFirstChild("Callouts")
	if folder then
		for _, box in folder:GetChildren() do
			local name = box:GetAttribute("Callout")
			if box:IsA("BasePart") and type(name) == "string" then
				table.insert(info.Boxes, {
					CFrame = box.CFrame,
					Half = box.Size / 2,
					Volume = box.Size.X * box.Size.Y * box.Size.Z,
					Name = name,
					Site = box:GetAttribute("Site") == true,
				})
			end
		end
	end
	-- Tamaño del mapa: por los muros invisibles del borde
	local boundary = map:FindFirstChild("Boundary")
	if boundary then
		local maxX, maxZ = 0, 0
		for _, wall in boundary:GetChildren() do
			if wall:IsA("BasePart") and wall.Size.Y > 4 then
				maxX = math.max(maxX, math.abs(wall.Position.X) - wall.Size.X / 2)
				maxZ = math.max(maxZ, math.abs(wall.Position.Z) - wall.Size.Z / 2)
			end
		end
		info.Length, info.Width = maxX * 2, maxZ * 2
		-- (mapas con solo techo invisible: su tamaño es el del techo)
		if maxX <= 0 or maxZ <= 0 then
			for _, roof in boundary:GetChildren() do
				if roof:IsA("BasePart") and roof.Size.X * roof.Size.Z > (info.Length or 0) * (info.Width or 0) then
					info.Length, info.Width = roof.Size.X, roof.Size.Z
				end
			end
		end
	end
	-- Lado de cada equipo: por dónde está su zona de salida
	for _, d in map:GetDescendants() do
		if d:IsA("BasePart") and string.sub(d.Name, -10) == "SpawnFloor" then
			table.insert(info.Bases, { Name = string.upper(string.sub(d.Name, 1, -11)), X = d.Position.X })
		end
	end
	return info
end

-- Nombre de la zona en este punto del mapa (nil si no se sabe)
function ZoneName.At(position, info)
	local best = nil
	-- (los sitios de bomba solo cuentan en Buscar y destruir)
	local snd = game:GetService("ReplicatedStorage"):GetAttribute("Mode") == "SND"
	for _, box in info.Boxes do
		if box.Site and not snd then
			continue
		end
		local p = box.CFrame:PointToObjectSpace(position)
		if math.abs(p.X) <= box.Half.X and math.abs(p.Y) <= box.Half.Y and math.abs(p.Z) <= box.Half.Z then
			if not best or box.Volume < best.Volume then
				best = box
			end
		end
	end
	if best then
		return best.Name
	end
	-- Sin zona con nombre: la parte del mapa (norte/centro/sur y de qué lado)
	local length, width = info.Length, info.Width
	if not length or not width or length < 40 or width < 40 then
		return nil
	end
	local band = position.Z > width / 6 and "NORTE" or (position.Z < -width / 6 and "SUR" or "CENTRO")
	if math.abs(position.X) < length / 6 or #info.Bases < 2 then
		return band
	end
	local closest, gap = nil, math.huge
	for _, base in info.Bases do
		local d = math.abs(base.X - position.X)
		if d < gap then
			closest, gap = base, d
		end
	end
	return closest and (band .. " · LADO " .. closest.Name) or band
end

local function setText(name)
	if name == shown then
		return
	end
	shown = name
	label.Text = name and UI.HudText("📍 " .. name) or ""
	if name then
		-- (al cambiar de zona, el nombre entra con un pequeño salto)
		scale.Scale = 1.15
		TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
end

function ZoneName.Update(dt)
	clock += dt or 0
	if clock < ZoneName.Interval then
		return
	end
	clock = 0
	local map = workspace:FindFirstChild("Map")
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local visible = map ~= nil and root ~= nil and not ClientState.InMainMenu and not ClientState.Dead
		and not ClientState.KillcamActive
	gui.Enabled = visible
	if not visible or not map or not root then
		return
	end
	-- (el mapa llega al cliente en varios fotogramas: mientras se carga no se lee, y una lectura que
	-- salió incompleta, o la primera, se repite al rato)
	if game:GetService("ReplicatedStorage"):GetAttribute("LoadingMap") then
		mapInfo = nil
		setText(nil)
		return
	end
	-- (como mucho dos relecturas por mapa: muchos mapas no tienen zonas con nombre y no hay que
	-- recorrer el mapa entero cada poco)
	local stale = mapInfo ~= nil and mapInfo.Map == map and (mapInfo.Rereads or 0) < 2 and os.clock() - mapInfo.ReadAt > 3
		and (#mapInfo.Boxes == 0 or not mapInfo.Length or #mapInfo.Bases < 2 or (mapInfo.Rereads or 0) == 0)
	if not mapInfo or mapInfo.Map ~= map or stale then
		local rereads = (stale and mapInfo) and (mapInfo.Rereads or 0) + 1 or 0
		mapInfo = readMap(map)
		mapInfo.Rereads = rereads
	end
	setText(ZoneName.At(root.Position, mapInfo))
	-- Debajo del minimapa (y del botón de la tienda cuando se ve)
	local top = ClientState.MinimapBottom or 200
	local phone = UI.IsPhone()
	-- (en el móvil el botón de la tienda va siempre bajo el minimapa; en PC solo se ve fuera de combate
	-- y entonces va arriba, no debajo)
	local touchOnly = InputMode.TouchUI()
	local below = phone and 40 or (touchOnly and 50 or 6)
	if not HUDZones.Managed(label) then
		label.Position = UDim2.fromOffset(phone and (ClientState.MinimapLeft or 14) or 16, top + below)
	end
end

function ZoneName.Init()
	gui = UI.new("ScreenGui", {
		Name = "ZoneName",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	label = UI.label({
		Position = UDim2.fromOffset(16, 200),
		Size = UDim2.fromOffset(230, 22),
		Text = "",
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(235, 240, 250),
		TextStrokeTransparency = 0.35,
		Parent = gui,
	})
	scale = UI.new("UIScale", { Parent = label })
	if InputMode.TouchUI() then
		label.Size = UDim2.fromOffset(200, 18)
		label.TextSize = 13
		HUDZones.Register("ZoneName", label, "TOP_LEFT", 3, { Gui = gui })
	end
	RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(ZoneName.Update, dt)
		if not ok then
			warn("[ZoneName]", err)
		end
	end)
end

return ZoneName
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Teams" referent="243">
    <Properties>
      <string name="Name">Teams</string>
    </Properties>
  </Item>
