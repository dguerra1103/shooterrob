		Recoil = 0.9,
		AimFOV = 58,
		ViewOffset = CFrame.new(0.8, -0.85, -2.0),
		AimDistance = 1.0,
		RightHand = V(0, -0.48, 0.44),
		LeftHand = V(0, -0.3, -1.0),
		AimPoint = V(0, 0.66, 0.35),
		Muzzle = V(0, 0.06, -2.28),
	},

	NovaDrift = {
		DisplayName = "Nova Drift",
		Category = "Subfusil",
		Description = "El subfusil más ágil: corre más y dispara sin parar.",
		Slot = 1,
		Type = "Gun",
		Palette = Palettes.Drift,
		Parts = Designs.NovaDrift(),
		UnlockLevel = 5,
		Price = 800,
		Damage = 15,
		MinDamage = 9,
		FalloffStart = 40,
		FalloffEnd = 140,
		HeadshotMultiplier = 1.4,
		FireRate = 16,
		Automatic = true,
		MagSize = 36,
		ReserveAmmo = 180,
		ReloadTime = 1.5,
		Range = 380,
		Spread = 2.4,
		AimSpread = 0.7,
		Pellets = 1,
		Recoil = 0.45,
		AimFOV = 66,
