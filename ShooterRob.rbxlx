-- Paleta activa (la elige el mapa al empezar: Materials.use("Construction"))
Materials.Active = Materials.Construction

function Materials.use(name)
	Materials.Active = Materials[name] or Materials.Common
	return Materials.Active
end

-- Look por nombre (de la paleta activa o de las comunes) o un look ya hecho
function Materials.get(look)
	if type(look) == "string" then
		return Materials.Active[look] or Materials.Common[look] or error("[TacKit] look desconocido: " .. look)
	end
	return look
end

-- Un look nuevo con otro color (el mismo material)
function Materials.tint(look, color)
	look = Materials.get(look)
	return { color, look[2] }
end

return Materials
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="126">
            <Properties>
              <string name="Name">Military</string>
              <string name="Source"><![CDATA[-- Piezas militares (Desert Base): barreras HESCO, muros de sacos terreros y de hormigón (T-wall),
-- camión de carga con lona, todoterreno, torre de vigilancia, torre de agua, depósito de
-- combustible, mástil de radio, red de camuflaje, barrera de control y barracón prefabricado.
-- cf = centro de la base; la "cara" mira a -Z.
local Kit = require(script.Parent.Parent.MapKit)
local Materials = require(script.Parent.Materials)
local G = require(script.Parent.Geometry)

local Military = {}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad
local get = Materials.get
local M = Enum.Material

local TIRE = { RGB(32, 32, 34), M.SmoothPlastic }
local DARK_GLASS = { RGB(40, 46, 52), M.Glass }

local function wheel(cf, d, w)
	return Kit.cylinder("Wheel", w or 1, d or 2.6, cf * CFrame.Angles(0, 0, rad(90)), TIRE[1], TIRE[2], nil, true)
end

-- Fila de bastiones HESCO a lo largo de X local (count módulos de 3,6; altura h): un bloque que
-- choca y las costuras de malla por encima (cobertura alta o media según h)
function Military.hesco(cf, count, h)
	h = h or 4
	local w = 3.6
	local length = w * count
	local body = G.box("Hesco", V(length, h, w), cf * CFrame.new(0, h / 2, 0), "Hesco")
	for i = 0, count do
		local x = -length / 2 + i * w
		for _, s in { -1, 1 } do
			G.deco("HescoMesh", V(0.15, h + 0.05, 0.15), cf * CFrame.new(x, h / 2, s * (w / 2 + 0.03)), "SteelDark").CastShadow = false
		end
	end
	for _, s in { -1, 1 } do
		G.deco("HescoWire", V(length, 0.12, 0.12), cf * CFrame.new(0, h - 0.4, s * (w / 2 + 0.03)), "SteelDark").CastShadow = false
	end
	G.deco("HescoSand", V(length - 0.3, 0.2, w - 0.3), cf * CFrame.new(0, h + 0.05, 0), "SandDark").CastShadow = false
	return body
end

-- Muro de sacos terreros de a a b (h de alto; cobertura baja a 2,6, media a 4)
function Military.sandbags(a, b, h)
	h = h or 2.6
	local mid = (a + b) / 2
	local length = (b - a).Magnitude
	local cf = CFrame.lookAt(mid, b)
	local body = G.box("Sandbags", V(2.2, h, length), cf * CFrame.new(0, h / 2, 0), "Sandbag")
	local rows = math.floor(h / 0.65)
	for i = 1, rows - 1 do
		G.deco("SandbagRow", V(2.3, 0.1, length + 0.05), cf * CFrame.new(0, i * h / rows, 0), "SandDark").CastShadow = false
	end
	return body
end

-- Muro de hormigón en T (paneles de 4 studs) de a a b
function Military.tWall(a, b, h)
	h = h or 9
	local mid = (a + b) / 2
	local length = (b - a).Magnitude
	local cf = CFrame.lookAt(mid, b)
	local body = G.box("TWall", V(1.2, h, length), cf * CFrame.new(0, h / 2, 0), "Concrete")
	G.deco("TWallFoot", V(3.6, 1.2, length), cf * CFrame.new(0, 0.6, 0), "Concrete")
	local n = math.floor(length / 4)
	for i = 1, n - 1 do
		G.deco("TWallJoint", V(1.3, h - 0.2, 0.12), cf * CFrame.new(0, h / 2, -length / 2 + i * length / n), "ConcreteDark").CastShadow = false
	end
	G.deco("TWallStripe", V(1.3, 0.8, length), cf * CFrame.new(0, h - 1.4, 0), "SandDark").CastShadow = false
	return body
end

-- Camión de carga militar (cabina y caja con lona): cobertura alta. Devuelve las piezas que chocan
function Military.truck(cf, look)
	look = look or "MilGreen"
	local solids = {}
	table.insert(solids, G.box("TruckCab", V(7, 6.4, 6), cf * CFrame.new(0, 4.2, -7.5), look))
	G.deco("TruckWindscreen", V(6, 2, 0.15), cf * CFrame.new(0, 5.8, -10.55), DARK_GLASS).CastShadow = false
	G.deco("TruckBumper", V(7.4, 1, 0.6), cf * CFrame.new(0, 1.8, -10.6), "SteelDark")
	table.insert(solids, G.box("TruckBed", V(7.2, 2, 14), cf * CFrame.new(0, 2.6, 3), "SteelDark"))
	table.insert(solids, G.box("TruckCanvas", V(7, 5.4, 13.4), cf * CFrame.new(0, 6.3, 3), "Canvas"))
	for _, z in { -1.5, 3, 7.5 } do
		G.deco("CanvasRib", V(7.15, 0.3, 0.3), cf * CFrame.new(0, 9.05, z), "MilGreenDark")
	end
	for _, s in { -1, 1 } do
		for _, z in { -7.5, 2, 6.5 } do
			wheel(cf * CFrame.new(s * 3.2, 1.4, z), 2.8, 1.1)
		end
	end
	return solids
end

-- Todoterreno militar (cobertura baja-media)
function Military.jeep(cf, look)
	look = look or "MilGreen"
	local body = G.box("Jeep", V(6, 3, 11), cf * CFrame.new(0, 2.3, 0), look)
	G.deco("JeepCabin", V(5.6, 2, 4.6), cf * CFrame.new(0, 4.8, 0.8), "Canvas")
	G.deco("JeepWindscreen", V(5.4, 1.6, 0.15), cf * CFrame.new(0, 4.6, -1.6), DARK_GLASS).CastShadow = false
	G.deco("JeepSpare", V(0.8, 2.4, 2.4), cf * CFrame.new(0, 2.6, 5.7), TIRE)
	for _, s in { -1, 1 } do
		for _, z in { -3.6, 3.6 } do
			wheel(cf * CFrame.new(s * 3, 1.3, z), 2.6, 1.1)
		end
	end
	return body
end

-- Torre de vigilancia: patas, plataforma a h con sacos terreros (hueco en open = "Front" | "Back"
-- | "Left" | "Right", donde llega la escalera) y tejado sobre postes. Devuelve la plataforma
function Military.watchtower(cf, h, open)
	h = h or 12
	local size = 7
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			G.box("TowerLeg", V(0.8, h, 0.8), cf * CFrame.new(x * (size / 2 - 0.4), h / 2, z * (size / 2 - 0.4)), "WoodDark")
			G.deco("TowerPost", V(0.4, 6.4, 0.4), cf * CFrame.new(x * (size / 2 - 0.2), h + 3.2, z * (size / 2 - 0.2)), "WoodDark")
		end
	end
	for _, s in { -1, 1 } do
		G.deco("TowerBrace", V(0.3, h * 1.1, 0.3), cf * CFrame.new(s * (size / 2 - 0.4), h / 2, 0) * CFrame.Angles(rad(38), 0, 0), "WoodDark")
	end
	local deck = G.box("TowerDeck", V(size, 1.4, size), cf * CFrame.new(0, h - 0.7, 0), "Wood")
	local half = size / 2 - 0.4
	local sides = {
		Front = { V(-half, h, -half), V(half, h, -half) },
		Back = { V(-half, h, half), V(half, h, half) },
		Left = { V(-half, h, -half), V(-half, h, half) },
		Right = { V(half, h, -half), V(half, h, half) },
	}
	local walls = {}
	for name, seg in sides do
		if name ~= open then
			local a, b = cf * seg[1], cf * seg[2]
			table.insert(walls, Military.sandbags(a, b, 1.8))
		end
	end
	local roof = G.box("TowerRoof", V(size + 1.4, 0.5, size + 1.4), cf * CFrame.new(0, h + 6.6, 0), "Canvas")
	G.deco("TowerLamp", V(1, 0.8, 1.4), cf * CFrame.new(0, h + 6, -half), "SteelDark")
	return deck, roof, walls
end

-- Torre de agua: cuatro patas (chocan) y depósito arriba (h = altura de la base del depósito)
function Military.waterTower(cf, h, d)
	h = h or 12
	d = d or 9
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			G.box("WaterTowerLeg", V(1, h, 1), cf * CFrame.new(x * d * 0.32, h / 2, z * d * 0.32), "SteelDark")
		end
	end
	for _, y in { h * 0.35, h * 0.7 } do
		G.deco("WaterTowerRing", V(d * 0.66, 0.3, 0.3), cf * CFrame.new(0, y, d * 0.32), "SteelDark")
		G.deco("WaterTowerRing", V(d * 0.66, 0.3, 0.3), cf * CFrame.new(0, y, -d * 0.32), "SteelDark")
	end
	local tank = Kit.cylinder("WaterTank", 8, d, cf * CFrame.new(0, h + 4, 0), get("Tank")[1], get("Tank")[2])
	Kit.cylinder("WaterTankRoof", 1.2, d * 0.8, cf * CFrame.new(0, h + 8.6, 0), get("SteelDark")[1], get("SteelDark")[2], nil, true)
	G.deco("WaterTankBand", V(d + 0.1, 1, 0.2), cf * CFrame.new(0, h + 5, -d / 2), "Red").CastShadow = false
	return tank
end

-- Depósito de combustible vertical (d de diámetro, h de alto): cobertura alta y ancha
function Military.fuelTank(cf, d, h)
	d = d or 12
	h = h or 10
	local tank = Kit.cylinder("FuelTank", h, d, cf * CFrame.new(0, h / 2, 0), get("Tank")[1], get("Tank")[2])
	Kit.cylinder("FuelTankTop", 0.6, d * 0.9, cf * CFrame.new(0, h + 0.3, 0), get("Concrete")[1], get("Concrete")[2], nil, true)
	for _, y in { h * 0.3, h * 0.7 } do
		Kit.cylinder("FuelTankBand", 0.4, d + 0.12, cf * CFrame.new(0, y, 0), get("SteelDark")[1], get("SteelDark")[2], nil, true)
	end
	G.deco("FuelTankLadder", V(0.8, h, 0.3), cf * CFrame.new(0, h / 2, -d / 2 - 0.2), "SteelDark")
	G.deco("FuelTankSign", V(3, 1.4, 0.2), cf * CFrame.new(2.4, h * 0.5, -d / 2 + 0.3) * CFrame.Angles(0, rad(-22), 0), "Red").CastShadow = false
	return tank
end

-- Mástil de radio (decorado salvo la base): hito visible desde todo el mapa
function Military.radioMast(cf, h)
	h = h or 26
	local base = G.box("MastBase", V(2.4, 1.6, 2.4), cf * CFrame.new(0, 0.8, 0), "SteelDark")
	G.deco("Mast", V(0.6, h, 0.6), cf * CFrame.new(0, h / 2, 0), "Steel")
	for y = 4, h - 2, 4 do
		G.deco("MastRung", V(1.6, 0.15, 0.15), cf * CFrame.new(0, y, 0), "Steel").CastShadow = false
	end
	for _, y in { h * 0.55, h * 0.8 } do
		G.deco("MastDish", V(1.6, 1.6, 0.4), cf * CFrame.new(0.6, y, -0.6) * CFrame.Angles(0, rad(30), 0), "Concrete")
	end
	local tip = G.deco("MastLight", V(0.6, 0.6, 0.6), cf * CFrame.new(0, h + 0.3, 0), { RGB(255, 60, 40), M.Neon })
	tip.CastShadow = false
	return base
end

-- Red de camuflaje sobre postes (decorado: no choca)
function Military.campNet(cf, w, d, h)
	h = h or 7
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			G.deco("NetPole", V(0.3, h, 0.3), cf * CFrame.new(x * w / 2, h / 2, z * d / 2), "WoodDark")
		end
	end
	local net = G.deco("CamoNet", V(w + 1, 0.2, d + 1), cf * CFrame.new(0, h, 0), "MilGreen")
	net.Transparency = 0.15
	for i, x in { -0.3, 0.15, 0.35 } do
		G.deco("CamoPatch", V(w * 0.3, 0.25, d * 0.4), cf * CFrame.new(x * w, h + 0.05, (i - 2) * d * 0.25), i == 2 and "Canvas" or "MilGreenDark").CastShadow = false
	end
	return net
end

-- Barrera de control (dos postes y brazo a rayas, decorado) de ancho w a lo largo de X local
function Military.barrierGate(cf, w)
	w = w or 10
	local post = G.box("GatePost", V(1, 3.4, 1), cf * CFrame.new(-w / 2, 1.7, 0), "Concrete")
	G.deco("GatePost", V(1, 3.4, 1), cf * CFrame.new(w / 2, 1.7, 0), "Concrete")
	for i = 0, 4 do
		G.deco("GateArm", V(w / 5, 0.4, 0.4), cf * CFrame.new(-w / 2 + (i + 0.5) * w / 5, 3.2, 0), i % 2 == 0 and "Red" or "Paint").CastShadow = false
	end
	return post
end

-- Barracón prefabricado (cf = centro de la base, largo a lo largo de X): cascarón con puertas en
-- los extremos (se cruza por dentro) y una lateral, techo plano con clip, toldo y aire acondicionado
function Military.barrack(T, cf, length, depth, opts)
	opts = opts or {}
	length, depth = length or 30, depth or 12
	local h = 8
	local door, window = G.door, G.window
	G.shell(cf, length, depth, h, opts.Look or "Building", {
		Front = opts.Front or { window(-length / 4, 3.5, 4, 2.5), window(length / 4, 3.5, 4, 2.5) },
		Back = opts.Back or { door(-length / 4, 4, 7), window(length / 4, 3.5, 4, 2.5) },
		Left = { door(0, 4, 7) },
		Right = { door(0, 4, 7) },
	}, { Frame = "MilGreenDark" })
	T.cap(G.box("BarrackRoof", V(length + 1, 0.6, depth + 1), cf * CFrame.new(0, h + 0.3, 0), "Roof"))
	G.deco("BarrackFloor", V(length - 1, 0.1, depth - 1), cf * CFrame.new(0, 0.05, 0), "Wood").CastShadow = false
	G.deco("BarrackAC", V(3, 2, 2), cf * CFrame.new(length / 4, h + 1.6, 0), "Concrete")
	if opts.Awning ~= false then
		Kit.awning(cf * CFrame.new(-length / 4, 7.2, depth / 2 + 0.2) * CFrame.Angles(0, math.pi, 0), 8, 3, get("Canvas")[1])
	end
end

-- Helicóptero de transporte posado (cobertura alta y hito). El morro mira a -Z. Devuelve las
-- piezas que chocan
function Military.helicopter(cf, look)
	look = look or "MilGreen"
	local solids = {}
	table.insert(solids, G.box("HeliBody", V(7, 7, 18), cf * CFrame.new(0, 4.6, 0), look))
	G.deco("HeliNose", V(6, 4.6, 3), cf * CFrame.new(0, 4.4, -10.4) * CFrame.Angles(rad(-12), 0, 0), look)
	G.deco("HeliCockpit", V(5.6, 2.4, 0.2), cf * CFrame.new(0, 6.4, -11.4) * CFrame.Angles(rad(-30), 0, 0), DARK_GLASS).CastShadow = false
	table.insert(solids, G.box("HeliTail", V(2, 2.2, 14), cf * CFrame.new(0, 6.6, 15.8), look))
	G.deco("HeliFin", V(0.5, 5, 3), cf * CFrame.new(0, 9, 22.2), look)
	G.deco("HeliTailRotor", V(0.2, 4.4, 0.6), cf * CFrame.new(0.5, 9.6, 22.4), "SteelDark")
	G.deco("HeliMast", V(1, 1.4, 1), cf * CFrame.new(0, 8.8, 0), "SteelDark")
	for _, a in { 20, 110 } do
		G.deco("HeliBlade", V(1.1, 0.2, 34), cf * CFrame.new(0, 9.6, 0) * CFrame.Angles(0, rad(a), 0), "SteelDark")
	end
	for _, s in { -1, 1 } do
		G.deco("HeliSkid", V(0.5, 0.5, 16), cf * CFrame.new(s * 3.6, 0.25, -1), "SteelDark")
		G.deco("HeliWindow", V(0.15, 1.6, 9), cf * CFrame.new(s * 3.52, 5.8, -1), DARK_GLASS).CastShadow = false
		G.deco("HeliDoor", V(0.2, 4.6, 4), cf * CFrame.new(s * 3.55, 3.8, 3), "MilGreenDark")
	end
	return solids
end

return Military
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="127">
            <Properties>
              <string name="Name">Port</string>
              <string name="Source"><![CDATA[-- Piezas de puerto (Dockyard): grúa pórtico de muelle (STS), carretilla pórtico (straddle carrier),
-- buque portacontenedores (decorado), bita de amarre, defensa de muelle, camión con remolque y
-- contenedor, puerta enrollable y torre de focos. cf = centro de la base; la "cara" mira a -Z.
local Kit = require(script.Parent.Parent.MapKit)
local Materials = require(script.Parent.Materials)
local G = require(script.Parent.Geometry)

local Port = {}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad
local get = Materials.get
local M = Enum.Material

local TIRE = { RGB(32, 32, 34), M.SmoothPlastic }
local DARK_GLASS = { RGB(40, 48, 58), M.Glass }

-- Grúa pórtico de muelle: cuatro patas (chocan: pilares de cobertura) separadas span en X y gauge
-- en Z, pórtico, cabina de maquinaria y pluma que sale sobre el agua (hacia -Z). Hito del mapa
function Port.stsCrane(cf, opts)
	opts = opts or {}
	local span, gauge = opts.Span or 18, opts.Gauge or 22
	local h = opts.Height or 26
	local look = opts.Look or "CraneRed"
	local legs = {}
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			table.insert(legs, G.box("CraneLeg", V(1.8, h, 1.8), cf * CFrame.new(x * span / 2, h / 2, z * gauge / 2), look))
		end
		G.deco("CraneSill", V(1.4, 1.4, gauge + 1.8), cf * CFrame.new(x * span / 2, 13, 0), look)
		G.deco("CraneBogie", V(2.6, 1.2, 4), cf * CFrame.new(x * span / 2, 0.6, -gauge / 2), "SteelDark")
		G.deco("CraneBogie", V(2.6, 1.2, 4), cf * CFrame.new(x * span / 2, 0.6, gauge / 2), "SteelDark")
	end
	for _, z in { -1, 1 } do
		G.deco("CranePortal", V(span + 1.8, 2, 1.8), cf * CFrame.new(0, h - 1, z * gauge / 2), look)
	end
	-- Pluma y contrapluma (decorado, muy por encima del juego)
	local boomLength = opts.Boom or 60
	G.deco("CraneBoom", V(span + 1.8, 2.4, boomLength + gauge), cf * CFrame.new(0, h + 1.2, -boomLength / 2 + 4), look)
	G.deco("CraneMachinery", V(span - 2, 5, 9), cf * CFrame.new(0, h + 4.9, gauge / 2 - 2), "Paint")
	G.deco("CraneApex", V(1.2, 14, 1.2), cf * CFrame.new(-span / 2 + 1, h + 9.4, 0), look)
	G.deco("CraneApex", V(1.2, 14, 1.2), cf * CFrame.new(span / 2 - 1, h + 9.4, 0), look)
	for _, s in { -1, 1 } do
		local a = cf * CFrame.new(s * (span / 2 - 1), h + 16, 0)
		local b = cf * CFrame.new(s * (span / 2 - 1), h + 2.4, -boomLength + 4)
		local mid = (a.Position + b.Position) / 2
		G.deco("CraneStay", V(0.3, 0.3, (a.Position - b.Position).Magnitude), CFrame.lookAt(mid, b.Position), "SteelDark").CastShadow = false
	end
	G.deco("CraneCab", V(4, 3, 4), cf * CFrame.new(0, h - 2.6, -gauge / 2 - 6), DARK_GLASS)
	G.deco("CraneSpreader", V(8, 1, 20), cf * CFrame.new(0, h - 8, -gauge / 2 - 14), "YellowPaint")
	G.deco("CraneCable", V(0.2, 6, 0.2), cf * CFrame.new(0, h - 4.5, -gauge / 2 - 14), "SteelDark")
	return legs
end

-- Carretilla pórtico (straddle carrier): cuatro patas y cabina alta (choca la base de las patas)
function Port.straddleCarrier(cf, look)
	look = look or "YellowPaint"
	local solids = {}
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			table.insert(solids, G.box("CarrierLeg", V(1.2, 13, 1.2), cf * CFrame.new(x * 5, 6.5, z * 6), look))
		end
		G.deco("CarrierBeam", V(1.4, 1.6, 13.4), cf * CFrame.new(x * 5, 12.4, 0), look)
		for _, z in { -6, 6 } do
			Kit.cylinder("Wheel", 1, 2.4, cf * CFrame.new(x * 5, 1.2, z) * CFrame.Angles(0, 0, rad(90)), TIRE[1], TIRE[2], nil, true)
		end
	end
	G.deco("CarrierTop", V(11.4, 1.4, 4), cf * CFrame.new(0, 13.4, 0), look)
	G.deco("CarrierCab", V(3, 3, 3), cf * CFrame.new(-4.4, 15.6, -5), DARK_GLASS)
	return solids
end

-- Buque portacontenedores (decorado, fuera del área de juego): casco, superestructura y
-- contenedores en cubierta. cf = centro del casco a la altura del agua; eslora a lo largo de X
function Port.ship(cf, length, colors)
	length = length or 180
	local beam = 30
	G.deco("Hull", V(length, 16, beam), cf * CFrame.new(0, 2, 0), "Hull").CastShadow = false
	G.deco("HullBottom", V(length - 4, 4, beam - 0.4), cf * CFrame.new(0, -7, 0), "Red").CastShadow = false
	G.deco("Bow", V(20, 16, beam * 0.7), cf * CFrame.new(-length / 2 - 6, 2, 0) * CFrame.Angles(0, rad(45), 0), "Hull").CastShadow = false
	G.deco("Deck", V(length, 0.4, beam - 1), cf * CFrame.new(0, 10.2, 0), "SteelDark")
	G.deco("Bridge", V(16, 18, beam - 4), cf * CFrame.new(length / 2 - 14, 19, 0), "Paint").CastShadow = false
	G.deco("BridgeWindows", V(16.2, 2, beam - 3.6), cf * CFrame.new(length / 2 - 14, 25, 0), DARK_GLASS).CastShadow = false
	G.deco("Funnel", V(6, 10, 6), cf * CFrame.new(length / 2 - 8, 33, 0), "Red")
	G.deco("ShipName", V(30, 2.4, 0.2), cf * CFrame.new(-length / 4, 6, beam / 2 + 0.1), "Paint").CastShadow = false
	colors = colors or { "ContainerRed", "ContainerBlue", "ContainerYellow", "ContainerGray" }
	local rows = math.floor((length - 50) / 21)
	for i = 0, rows - 1 do
		local x = -length / 2 + 16 + i * 21
		local layers = 2 + (i % 3)
		for layer = 0, layers - 1 do
			for _, z in { -10, 0, 10 } do
				local c = colors[((i + layer + math.floor(z / 10)) % #colors) + 1]
				G.deco("DeckContainer", V(20, 8.5, 8.2), cf * CFrame.new(x, 10.4 + 4.25 + layer * 8.6, z), c).CastShadow = layer == 0
			end
		end
	end
end

-- Bita de amarre (choca: muy baja) con la amarra hacia el barco
function Port.mooringBollard(cf)
	local post = Kit.cylinder("Bollard", 1.6, 1.4, cf * CFrame.new(0, 0.8, 0), get("SteelDark")[1], get("SteelDark")[2])
	Kit.cylinder("BollardCap", 0.4, 2, cf * CFrame.new(0, 1.7, 0), get("SteelDark")[1], get("SteelDark")[2], nil, true)
	return post
end

-- Defensa de muelle (neumático en el canto; decorado)
function Port.fender(cf)
	Kit.cylinder("Fender", 1.2, 3, cf * CFrame.Angles(rad(90), 0, 0), TIRE[1], TIRE[2], nil, true)
end

-- Camión con remolque y contenedor (cobertura alta). Mira a -Z. Devuelve las piezas que chocan
function Port.containerTruck(cf, look)
	local solids = {}
	table.insert(solids, G.box("TruckCab", V(7, 7, 7), cf * CFrame.new(0, 4.5, -13), "Paint"))
	G.deco("TruckWindscreen", V(6, 2.2, 0.15), cf * CFrame.new(0, 6.2, -16.6), DARK_GLASS).CastShadow = false
	G.deco("TruckChassis", V(6, 1.2, 22), cf * CFrame.new(0, 1.8, 2), "SteelDark")
	table.insert(solids, (Kit.container(cf * CFrame.new(0, 2.4, 2) * CFrame.Angles(0, math.pi / 2, 0), get(look or "ContainerBlue")[1])))
	for _, s in { -1, 1 } do
		for _, z in { -13, 7, 10 } do
			Kit.cylinder("Wheel", 1, 2.8, cf * CFrame.new(s * 3, 1.4, z) * CFrame.Angles(0, 0, rad(90)), TIRE[1], TIRE[2], nil, true)
		end
	end
	return solids
end

-- Puerta enrollable (decorado, sobre la pared) de w x h
function Port.rollerDoor(cf, w, h)
	local door = G.deco("RollerDoor", V(w, h, 0.2), cf * CFrame.new(0, h / 2, 0), "Steel")
	for y = 1, h - 1, 1 do
		G.deco("RollerSlat", V(w, 0.08, 0.25), cf * CFrame.new(0, y, 0), "SteelDark").CastShadow = false
	end
	return door
end

return Port
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="128">
            <Properties>
              <string name="Name">Props</string>
              <string name="Source"><![CDATA[-- Props reutilizables de los mapas 5v5. Cada prop está pensado para dar escala, cobertura o
-- identidad de zona con pocas piezas (una caja = 1 pieza que choca + 2-3 detalles que no).
-- cf = centro de la base, mirando a -Z (la "cara" del prop).
local Kit = require(script.Parent.Parent.MapKit)
local Materials = require(script.Parent.Materials)
local G = require(script.Parent.Geometry)

local P = {}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad
local get = Materials.get
local M = Enum.Material

---------------------------------------------------------------------------
-- Cobertura
---------------------------------------------------------------------------

-- Contenedor de 20 x 8,5 x 8 (cobertura alta). look = color del contenedor
function P.container(cf, look, label)
	look = get(look or "ContainerRed")
	return Kit.container(cf, look[1], label)
end

-- Caja de madera (size de lado)
function P.crate(cf, size)
	return Kit.crate(cf, size or 4)
end

-- Montón de cajas: "L" (2 abajo + 1 arriba, cobertura media con asomada por arriba) o "Wall"
-- (3 en fila, cobertura baja) o "Tower" (2 apiladas, cobertura alta)
function P.crateStack(cf, kind)
	kind = kind or "L"
	local crates = {}
	local function add(c)
		table.insert(crates, c)
	end
	if kind == "Wall" then
		for i = -1, 1 do
			add(P.crate(cf * CFrame.new(i * 4.1, 0, 0) * CFrame.Angles(0, rad(i * 4), 0), 4))
		end
	elseif kind == "Tower" then
		add(P.crate(cf, 4.5))
		add(P.crate(cf * CFrame.new(0.2, 4.5, 0.1) * CFrame.Angles(0, rad(12), 0), 4))
	else
		add(P.crate(cf * CFrame.new(-2.2, 0, 0), 4.2))
		add(P.crate(cf * CFrame.new(2.2, 0, 0.3) * CFrame.Angles(0, rad(-6), 0), 4))
		add(P.crate(cf * CFrame.new(-1.6, 4.2, 0.2) * CFrame.Angles(0, rad(10), 0), 3.4))
	end
	return crates
end

-- Palé de madera (decorado, a ras de suelo)
function P.pallet(cf, sx, sz)
	sx, sz = sx or 4.4, sz or 4.4
	G.deco("Pallet", V(sx, 0.5, sz), cf * CFrame.new(0, 0.25, 0), { RGB(170, 132, 86), M.WoodPlanks })
end

-- Palé con bloques de hormigón apilados (cobertura: layers 2 = baja, 3 = media)
function P.blockPallet(cf, layers)
	layers = layers or 3
	P.pallet(cf)
	local h = layers * 1.25
	local body = G.box("BlockStack", V(4.2, h, 4.2), cf * CFrame.new(0, 0.5 + h / 2, 0), "Block")
	Kit.contactShadow(cf, 4.4, 4.4)
	-- Juntas entre hiladas y fleje
	for l = 1, layers - 1 do
		G.deco("BlockJoint", V(4.26, 0.1, 4.26), cf * CFrame.new(0, 0.5 + l * 1.25, 0), "ConcreteDark")
	end
	G.deco("Strap", V(0.15, h + 0.1, 4.3), cf * CFrame.new(0.9, 0.5 + h / 2, 0), { RGB(40, 60, 120), M.SmoothPlastic })
	return body
end

-- Barrera de hormigón tipo "new jersey" (cobertura baja, 3 de alto)
function P.jersey(cf, length, look)
	length = length or 8
	look = look or "Concrete"
	local base = G.box("Jersey", V(2.4, 1.2, length), cf * CFrame.new(0, 0.6, 0), look)
	G.box("JerseyTop", V(1.2, 1.9, length), cf * CFrame.new(0, 2.15, 0), look)
	G.deco("JerseyStripe", V(1.26, 0.5, length * 0.98), cf * CFrame.new(0, 2.6, 0), "YellowPaint")
	Kit.contactShadow(cf, 2.6, length)
	return base
end

-- Bidón metálico y barril de plástico
function P.barrel(cf, look)
	look = get(look or { RGB(50, 90, 160), M.Metal })
	Kit.barrel(cf, look[1])
end

function P.cone(cf)
	Kit.cone(cf)
end

-- Fila de conos
function P.cones(a, b, count)
	for i = 0, count - 1 do
		P.cone(CFrame.new(a:Lerp(b, count > 1 and i / (count - 1) or 0.5)))
	end
end

---------------------------------------------------------------------------
-- Obra
---------------------------------------------------------------------------

-- Caseta de obra (oficina prefabricada) de 20 x 9 x 8: cobertura alta y escala. Ventanas a -Z.
function P.portacabin(cf, look, opts)
	opts = opts or {}
	look = get(look or { RGB(232, 228, 216), M.SmoothPlastic })
	local body = G.box("Portacabin", V(20, 8.6, 8), cf * CFrame.new(0, 4.6, 0), look)
	Kit.contactShadow(cf, 20.4, 8.4)
	G.deco("CabinBase", V(20.4, 0.4, 8.4), cf * CFrame.new(0, 0.2, 0), "SteelDark")
	G.deco("CabinRoof", V(20.4, 0.4, 8.4), cf * CFrame.new(0, 9.1, 0), "SteelDark")
	for _, x in { -10, 10 } do
		G.deco("CabinCorner", V(0.5, 9, 8.5), cf * CFrame.new(x, 4.6, 0), "SteelDark")
	end
	for _, x in { -6, 1, 6.5 } do
		local w = G.deco("CabinWindow", V(3.2, 2.4, 0.2), cf * CFrame.new(x, 5.2, -4.05), { RGB(40, 52, 64), M.Glass })
		w.Transparency = 0.15
		G.deco("CabinFrame", V(3.5, 0.25, 0.3), cf * CFrame.new(x, 6.5, -4.05), "SteelDark")
	end
	G.deco("CabinDoor", V(2.6, 6.4, 0.2), cf * CFrame.new(-2.2, 3.8, -4.05), "SteelDark")
	if opts.Stripe then
		G.deco("CabinStripe", V(20.1, 0.6, 8.1), cf * CFrame.new(0, 7.6, 0), opts.Stripe)
	end
	if opts.Sign then
		local board = G.deco("CabinSign", V(7, 1.4, 0.2), cf * CFrame.new(5, 8, -4.12), { RGB(30, 40, 60), M.SmoothPlastic })
		Kit.sign(board, Enum.NormalId.Front, opts.Sign, RGB(250, 250, 250)).LightInfluence = 1
	end
	return body
end

-- Foco de obra en trípode (de noche, luz cálida hacia delante: -Z)
function P.workLight(cf, color)
	color = color or RGB(255, 222, 170)
	for i = 0, 2 do
		local a = rad(i * 120)
		local foot = cf * V(math.cos(a) * 1.2, 0, math.sin(a) * 1.2)
		G.beam(foot, cf * V(0, 5, 0), 0.15, 0.15, "SteelDark", true)
	end
	G.deco("WorkLightPole", V(0.2, 2, 0.2), cf * CFrame.new(0, 6, 0), "SteelDark")
	G.deco("WorkLightHead", V(2.4, 1.4, 0.7), cf * CFrame.new(0, 7.2, -0.2) * CFrame.Angles(rad(-20), 0, 0), "Yellow")
	local lens = G.deco("WorkLightLens", V(2.1, 1.1, 0.1), cf * CFrame.new(0, 7.15, -0.6) * CFrame.Angles(rad(-20), 0, 0), { color, M.Neon })
	local light = Kit.light(lens, "SpotLight", color, 30, 1.6, Enum.NormalId.Front)
	light.Angle = 70
end

-- Torre de focos (poste alto con 4 focos): ilumina un patio
function P.floodTower(cf, h, color)
	h = h or 18
	color = color or RGB(255, 236, 200)
	G.column(cf, h, 0.7, "SteelDark", "FloodPole")
	G.deco("FloodBar", V(5, 0.4, 0.4), cf * CFrame.new(0, h, 0), "SteelDark")
	for _, x in { -1.8, -0.6, 0.6, 1.8 } do
		local lamp = G.deco("FloodLamp", V(1, 1, 0.5), cf * CFrame.new(x, h + 0.7, -0.2) * CFrame.Angles(rad(-35), 0, 0), { color, M.Neon })
		if x == -0.6 then
			Kit.light(lamp, "SpotLight", color, 44, 1.8, Enum.NormalId.Front).Angle = 80
		end
	end
end

-- Hormigonera (cobertura baja-media)
function P.cementMixer(cf)
	local base = G.box("MixerFrame", V(3, 1.4, 4.4), cf * CFrame.new(0, 0.9, 0), "SteelDark")
	for _, x in { -1.6, 1.6 } do
		Kit.cylinder("MixerWheel", 0.5, 1.4, cf * CFrame.new(x, 0.7, 1.2) * CFrame.Angles(0, 0, rad(90)), RGB(30, 30, 32), M.SmoothPlastic, nil, true)
	end
	local drum = Kit.cylinder("MixerDrum", 3.4, 2.8, cf * CFrame.new(0, 3.1, -0.3) * CFrame.Angles(rad(-35), 0, 0), RGB(232, 120, 30), M.Metal)
	drum.CanCollide = true
	Kit.cylinder("MixerMouth", 0.6, 1.8, cf * CFrame.new(0, 4.5, -1.5) * CFrame.Angles(rad(-35), 0, 0), RGB(60, 60, 64), M.Metal, nil, true)
	Kit.contactShadow(cf, 3.4, 4.8)
	return base
end

-- Haz de ferralla (barras corrugadas) en el suelo: cobertura muy baja
function P.rebarBundle(cf, length)
	length = length or 10
	for i = 0, 5 do
		local x = (i % 3 - 1) * 0.35
		local y = 0.25 + math.floor(i / 3) * 0.32
		G.deco("Rebar", V(0.22, 0.22, length), cf * CFrame.new(x, y, (i % 2) * 0.3), { RGB(120, 66, 42), M.CorrodedMetal })
	end
	for _, z in { -length * 0.3, length * 0.3 } do
		G.deco("RebarTie", V(1.2, 0.8, 0.12), cf * CFrame.new(0, 0.4, z), "SteelDark")
	end
	local collider = G.box("RebarBlock", V(1.3, 0.8, length), cf * CFrame.new(0, 0.4, 0), "SteelDark")
	collider.Transparency = 1
end

-- Tubos de hormigón grandes apilados (cobertura media: 2 abajo + 1 arriba)
function P.pipeStack(cf, length)
	length = length or 8
	local look = get("ConcreteDark")
	for _, spec in { { -1.6, 1.5 }, { 1.6, 1.5 }, { 0, 4.1 } } do
		local pipe = Kit.pipe("ConcretePipe", length, 3, cf * CFrame.new(spec[1], spec[2], 0) * CFrame.Angles(0, rad(90), 0), look[1], look[2])
		pipe.CanCollide = true
	end
	Kit.contactShadow(cf, 6.4, length)
end

-- Vigas de acero apiladas sobre durmientes (cobertura baja)
function P.beamStack(cf, length, look)
	length = length or 14
	look = look or "RedSteel"
	for _, z in { -length * 0.35, length * 0.35 } do
		G.deco("Sleeper", V(4.6, 0.5, 0.8), cf * CFrame.new(0, 0.25, z), "WoodDark")
	end
	for row = 0, 1 do
		for i = 0, 2 - row do
			local x = (i - (2 - row) / 2) * 1.4
			local y = 0.5 + row * 1.2
			G.ibeam(cf * V(x, y + 0.6, -length / 2), cf * V(x, y + 0.6, length / 2), 1.2, look, true)
		end
	end
	G.box("BeamStackBlock", V(4.2, 2.9, length), cf * CFrame.new(0, 1.45, 0), look).Transparency = 1
end

-- Grúa torre (hito del mapa): mástil de celosía, cabina, pluma con carro y una carga colgando
-- (un palé de bloques), contrapluma con contrapesos y balizas. Todo decorado. cf = base del
-- mástil; la pluma apunta a -Z. opts: Jib (largo), Counter, Load (true), Look
function P.towerCrane(cf, height, opts)
	opts = opts or {}
	local look = get(opts.Look or "Yellow")
	local jib, counter = opts.Jib or 54, opts.Counter or 18
	local w = 3.2
	-- Mástil: 4 montantes y diagonales por tramo en las 4 caras
	for _, c in { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } } do
		G.deco("CraneChord", V(0.45, height, 0.45), cf * CFrame.new(c[1] * w / 2, height / 2, c[2] * w / 2), look)
	end
	local segment = 6
	local faces = {
		{ V(-1, 0, -1), V(1, 0, -1) },
		{ V(1, 0, -1), V(1, 0, 1) },
		{ V(1, 0, 1), V(-1, 0, 1) },
		{ V(-1, 0, 1), V(-1, 0, -1) },
	}
	for s = 0, math.floor(height / segment) - 1 do
		local y0, y1 = s * segment, (s + 1) * segment
		for f, face in faces do
			local a, b = face[1] * w / 2, face[2] * w / 2
			local flip = (s + f) % 2 == 0
			G.beam(cf * (V(a.X, y0, a.Z)), cf * (flip and V(b.X, y1, b.Z) or V(b.X, y0, b.Z)), 0.22, 0.22, look, true)
			if not flip then
				G.beam(cf * V(a.X, y0, a.Z), cf * V(b.X, y1, b.Z), 0.22, 0.22, look, true)
			end
		end
	end
	-- Corona giratoria, cabina y cúspide
	local top = cf * CFrame.new(0, height, 0)
	G.deco("CraneSlew", V(w + 1, 1.4, w + 1), top * CFrame.new(0, 0.7, 0), "SteelDark")
	local cab = G.deco("CraneCab", V(2.8, 3, 3), top * CFrame.new(w / 2 + 1.2, 1.6, -1), { RGB(236, 236, 230), M.SmoothPlastic })
	cab.CastShadow = false
	local cabGlass = G.deco("CraneCabGlass", V(2.6, 1.6, 0.1), top * CFrame.new(w / 2 + 1.2, 2.1, -2.55), { RGB(60, 80, 96), M.Glass })
	cabGlass.Transparency = 0.2
	for _, c in { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } } do
		G.beam(top * V(c[1] * w / 2, 1.4, c[2] * w / 2), top * V(0, 9, 0), 0.3, 0.3, look, true)
	end
	-- Pluma (celosía triangular: cordón arriba, dos abajo, diagonales) hacia -Z
	local y = 2.2
	for _, x in { -1.1, 1.1 } do
		G.deco("JibChord", V(0.35, 0.35, jib), top * CFrame.new(x, y, -jib / 2), look)
	end
	G.deco("JibTopChord", V(0.35, 0.35, jib), top * CFrame.new(0, y + 2.2, -jib / 2 + 1), look)
	for i = 0, math.floor(jib / 4) - 1 do
		local z0, z1 = -i * 4, -(i + 1) * 4
		for _, x in { -1.1, 1.1 } do
			G.beam(top * V(x, y, z0), top * V(0, y + 2.2, z1), 0.18, 0.18, look, true)
		end
	end
	-- Tirantes desde la cúspide a la pluma y a la contrapluma
	G.beam(top * V(0, 9, 0), top * V(0, y + 2.2, -jib * 0.55), 0.15, 0.15, "SteelDark", true)
	G.beam(top * V(0, 9, 0), top * V(0, y + 1, counter - 1), 0.15, 0.15, "SteelDark", true)
	-- Contrapluma y contrapesos
	G.deco("CounterJib", V(2.6, 0.6, counter), top * CFrame.new(0, y, counter / 2), look)
	for i = 0, 2 do
		G.deco("Counterweight", V(2.8, 3, 1.6), top * CFrame.new(0, y - 1.6, counter - 2 - i * 1.7), "ConcreteDark")
	end
	-- Carro, cable y carga (palé de bloques)
	local trolleyZ = -jib * 0.62
	G.deco("Trolley", V(2.6, 0.6, 1.6), top * CFrame.new(0, y - 0.5, trolleyZ), "SteelDark")
	local drop = opts.Drop or height * 0.55
	G.deco("CraneCable", V(0.12, drop, 0.12), top * CFrame.new(0, y - 0.8 - drop / 2, trolleyZ), "Black")
	G.deco("CraneHook", V(0.8, 1, 0.8), top * CFrame.new(0, y - 1.3 - drop, trolleyZ), "Yellow")
	if opts.Load ~= false then
		local load = top * CFrame.new(0, y - 1.8 - drop - 4, trolleyZ) * CFrame.Angles(0, rad(20), 0)
		G.deco("LoadBlocks", V(4.2, 3.4, 4.2), load * CFrame.new(0, 1.7, 0), "Block")
		G.deco("LoadPallet", V(4.4, 0.5, 4.4), load * CFrame.new(0, -0.25, 0), { RGB(170, 132, 86), M.WoodPlanks })
		for _, s in { -1, 1 } do
			G.beam(load * V(s * 2, 3.4, 0), top * V(0, y - 1.8 - drop, trolleyZ), 0.1, 0.1, "Black", true)
		end
	end
	-- Balizas rojas (parpadean en el cliente)
	for _, p in { V(0, 9.4, 0), V(0, y + 2.6, -jib + 1), V(0, y + 0.6, counter) } do
		local beacon = Kit.ball("CraneBeacon", 0.7, top * CFrame.new(p), RGB(255, 40, 30), M.Neon, true)
		beacon:SetAttribute("Blink", 1)
	end
	-- Cartel de la constructora en la pluma
	local board = G.deco("CraneBoard", V(0.3, 1.6, 9), top * CFrame.new(1.35, y + 1.2, -6), look)
	Kit.sign(board, Enum.NormalId.Right, opts.Brand or "ROBUILD", RGB(30, 30, 34), RGB(30, 30, 34)).LightInfluence = 1
end

---------------------------------------------------------------------------
-- Señalización
---------------------------------------------------------------------------

-- Lona con la letra del sitio (A roja, B azul) colgada de una fachada: la cara visible es -Z
function P.letterBanner(cf, letter, look, w, h)
	w, h = w or 10, h or 14
	look = get(look)
	local cloth = G.deco("SiteBanner", V(w, h, 0.25), cf, { look[1], M.Fabric })
	cloth.CastShadow = false
	G.deco("BannerBar", V(w + 0.6, 0.5, 0.5), cf * CFrame.new(0, h / 2 + 0.1, 0), "SteelDark")
	G.deco("BannerBar", V(w + 0.6, 0.4, 0.4), cf * CFrame.new(0, -h / 2 - 0.1, 0), "SteelDark")
	local gui = Kit.sign(cloth, Enum.NormalId.Front, letter, RGB(250, 248, 240), look[1]:Lerp(Color3.new(0, 0, 0), 0.4))
	gui.LightInfluence = 0.6
	gui.PixelsPerStud = 12
	local label = gui:FindFirstChildOfClass("TextLabel")
	if label then
		label.Size = UDim2.fromScale(0.8, 0.62)
		label.Position = UDim2.fromScale(0.1, 0.19)
	end
	-- (franja clara arriba, como las lonas de la referencia)
	G.deco("BannerTrim", V(w, 0.5, 0.3), cf * CFrame.new(0, h / 2 - 0.9, 0), { RGB(240, 236, 228), M.Fabric })
	return cloth
end

-- Cartel rectangular con texto (cara -Z). bg/fg = colores
function P.sign(cf, text, w, h, bg, fg, opts)
	opts = opts or {}
	local board = G.deco("SignBoard", V(w, h, 0.25), cf, { bg or RGB(30, 34, 40), M.SmoothPlastic })
	board.CastShadow = false
	local gui = Kit.sign(board, Enum.NormalId.Front, text, fg or RGB(250, 250, 250), opts.Stroke or (bg or RGB(30, 34, 40)))
	gui.LightInfluence = opts.Glow and 0 or 1
	gui.PixelsPerStud = opts.PPS or 20
	if opts.Back then
		local back = Kit.sign(board, Enum.NormalId.Back, text, fg or RGB(250, 250, 250), opts.Stroke or (bg or RGB(30, 34, 40)))
		back.LightInfluence = gui.LightInfluence
		back.PixelsPerStud = gui.PixelsPerStud
	end
	return board
end

-- Flecha de ruta pintada en pared ("A →"): ayuda a orientarse sin flechas gigantes
function P.routeSign(cf, text, look)
	return P.sign(cf, text, 5, 1.6, get(look or "Red")[1], RGB(255, 255, 255), { PPS = 30 })
end

---------------------------------------------------------------------------
-- Ciudad y fondo
---------------------------------------------------------------------------

-- Edificio de fondo (sin interior, sin colisión): bloque con bandas de ventanas. opts.Lit = las
-- ventanas brillan (de noche), opts.Roof = trastos en la azotea, opts.Material
function P.cityBlock(cf, w, d, h, color, opts)
	opts = opts or {}
	local body = G.deco("CityBlock", V(w, h, d), cf * CFrame.new(0, h / 2, 0), { color, opts.Material or M.Concrete })
	body.CastShadow = false -- (lejos: su sombra solo oscurecería el mapa al atardecer)
	local floorH = opts.FloorH or 6
	local windowColor = opts.Lit and RGB(150, 112, 72) or (opts.WindowColor or color:Lerp(RGB(40, 50, 62), 0.7))
	local material = opts.Lit and M.Neon or M.SmoothPlastic
	local floors = math.floor((h - 3) / floorH)
	for f = 1, floors do
		local y = f * floorH
		-- (de noche no todas las plantas están encendidas)
		local lit = opts.Lit and ((f * 7 + math.floor(w)) % 3 ~= 0)
		local band = G.deco("CityWindows", V(w + 0.15, floorH * 0.32, d + 0.15), cf * CFrame.new(0, y - floorH * 0.4, 0), {
			lit and windowColor or (opts.WindowColor or color:Lerp(RGB(40, 50, 62), 0.7)),
			lit and material or M.SmoothPlastic,
		})
		band.CastShadow = false
	end
	G.deco("CityCornice", V(w + 0.6, 0.8, d + 0.6), cf * CFrame.new(0, h + 0.2, 0), { color:Lerp(Color3.new(0, 0, 0), 0.25), M.Concrete }).CastShadow = false
	if opts.Roof then
		G.deco("CityRoofBox", V(w * 0.3, 2.5, d * 0.3), cf * CFrame.new(w * 0.18, h + 1.25, -d * 0.12), "SteelDark").CastShadow = false
	end
end

-- Hilera de edificios de fondo en arco alrededor del mapa (horizonte). center, radius, from/to en
-- grados, step = separación angular. palette = lista de colores
function P.skylineRing(center, radius, fromDeg, toDeg, step, palette, opts)
	opts = opts or {}
	local i = 0
	for a = fromDeg, toDeg, step do
		i += 1
		local r = radius + ((i * 37) % 5) * 9
		local p = center + V(math.cos(rad(a)) * r, 0, math.sin(rad(a)) * r)
		local w = 16 + (i * 13) % 14
		local d = 14 + (i * 7) % 12
		local h = (opts.MinH or 30) + (i * 23) % (opts.VarH or 60)
		if i % (opts.TowerEvery or 6) == 0 then
			h = h + (opts.TowerExtra or 60)
		end
		local cf = CFrame.lookAt(p, V(center.X, 0, center.Z))
		P.cityBlock(cf, w, d, h, palette[(i % #palette) + 1], { Lit = opts.Lit, Roof = i % 2 == 0, FloorH = opts.FloorH })
	end
end


---------------------------------------------------------------------------
-- Más obra y edificios de borde
---------------------------------------------------------------------------

-- Contenedor de escombros (rojo, abierto por arriba con escombro dentro): cobertura baja-media
function P.skip(cf, look)
	look = get(look or "ContainerRed")
	local body = G.box("Skip", V(5.6, 3.4, 10), cf * CFrame.new(0, 1.9, 0), look)
	G.deco("SkipRim", V(6, 0.4, 10.4), cf * CFrame.new(0, 3.65, 0), { look[1]:Lerp(Color3.new(0, 0, 0), 0.3), M.Metal })
	for _, s in { -1, 1 } do
		G.deco("SkipSlope", V(5.6, 0.3, 2.4), cf * CFrame.new(0, 1.2, s * 5.6) * CFrame.Angles(s * rad(40), 0, 0), look)
	end
	for i, p in { V(-1.2, 3.8, -2), V(1, 3.9, 1.5), V(0, 3.7, 3.2) } do
		G.deco("Rubble", V(1.6 + i * 0.3, 0.8, 1.4), cf * CFrame.new(p) * CFrame.Angles(i * 0.4, i, 0.2), i % 2 == 0 and "ConcreteDark" or "Plywood")
	end
	Kit.contactShadow(cf, 6, 11)
	return body
end

-- Palé de sacos de cemento (cobertura baja)
function P.sackPallet(cf)
	P.pallet(cf)
	local body = G.box("Sacks", V(4, 1.8, 4), cf * CFrame.new(0, 1.4, 0), { RGB(214, 204, 186), M.Fabric })
	for l = 0, 2 do
		G.deco("SackRow", V(4.1, 0.08, 4.1), cf * CFrame.new(0, 0.55 + l * 0.6, 0), { RGB(176, 166, 150), M.Fabric })
	end
	G.deco("SackLabel", V(1.6, 0.6, 0.05), cf * CFrame.new(0, 1.4, -2.03), { RGB(200, 60, 40), M.SmoothPlastic })
	return body
end

-- Bobina de cable (cobertura baja, redonda)
function P.cableSpool(cf, d)
	d = d or 3.6
	for _, x in { -0.9, 0.9 } do
		Kit.pipe("SpoolSide", 0.3, d, cf * CFrame.new(x, d / 2, 0), RGB(150, 110, 70), M.WoodPlanks, false)
	end
	local core = Kit.pipe("SpoolCable", 1.6, d * 0.7, cf * CFrame.new(0, d / 2, 0), RGB(40, 40, 44), M.SmoothPlastic, false)
	return core
end

-- Depósito de agua de azotea sobre patas (decorado)
function P.waterTank(cf)
	for _, x in { -1.4, 1.4 } do
		for _, z in { -1.4, 1.4 } do
			G.deco("TankLeg", V(0.3, 3, 0.3), cf * CFrame.new(x, 1.5, z), "SteelDark")
		end
	end
	Kit.cylinder("WaterTank", 4, 4.2, cf * CFrame.new(0, 5, 0), RGB(150, 140, 128), M.Metal, nil, true)
	Kit.cylinder("TankLid", 0.4, 4.6, cf * CFrame.new(0, 7.2, 0), RGB(90, 86, 82), M.Metal, nil, true)
end

-- Aplique de pared con luz cálida (cara -Z)
function P.wallLamp(cf, color)
	color = color or RGB(255, 210, 150)
	G.deco("LampArm", V(0.3, 0.3, 0.8), cf * CFrame.new(0, 0, -0.4), "SteelDark")
	local bulb = G.deco("LampBulb", V(0.8, 0.5, 0.6), cf * CFrame.new(0, -0.2, -0.9), { color, M.Neon })
	Kit.light(bulb, "PointLight", color, 12, 0.8)
end

-- Chapa ondulada: nervios verticales sobre una cara de muro (decorado). a, b = extremos al pie
function P.ribs(a, b, h, look, spacing)
	spacing = spacing or 2.4
	local length = (b - a).Magnitude
	local count = math.floor(length / spacing)
	for i = 1, count - 1 do
		local p = a:Lerp(b, i / count)
		G.deco("Rib", V(0.35, h, 0.35), CFrame.lookAt(p, p + (b - a)) * CFrame.new(0, h / 2, 0), look).CastShadow = false
	end
end

-- Montacargas de obra (jaula amarilla adosada a una fachada, decorado). cf = centro de la base
function P.hoist(cf, h)
	local look = get("Yellow")
	for _, x in { -2, 2 } do
		for _, z in { -2, 2 } do
			G.box("HoistPost", V(0.5, h, 0.5), cf * CFrame.new(x, h / 2, z), look)
		end
	end
	for y = 4, h, 4 do
		G.deco("HoistRing", V(4.4, 0.3, 0.3), cf * CFrame.new(0, y, -2), look)
		G.deco("HoistRing", V(4.4, 0.3, 0.3), cf * CFrame.new(0, y, 2), look)
		G.deco("HoistRing", V(0.3, 0.3, 4.4), cf * CFrame.new(-2, y, 0), look)
		G.deco("HoistRing", V(0.3, 0.3, 4.4), cf * CFrame.new(2, y, 0), look)
	end
	local car = G.deco("HoistCar", V(3.6, 3.4, 3.6), cf * CFrame.new(0, h * 0.55, 0), { RGB(230, 226, 214), M.Metal })
	car.CastShadow = false
	G.deco("HoistMesh", V(3.7, 2.6, 3.7), cf * CFrame.new(0, h * 0.55 + 0.2, 0), { RGB(60, 60, 64), M.DiamondPlate }).Transparency = 0.5
end

-- Edificio de borde (macizo, se ve pero no se entra): plantas con ventanas en bandas, cornisa,
-- azotea con pretil y trastos. Cierra el mapa con la escala de una ciudad. Devuelve el cuerpo
-- (para taparlo con T.cap). opts: FloorH, Windows (color), Lit, Roof = false
function P.facadeBlock(cf, w, d, h, look, opts)
	opts = opts or {}
	look = get(look)
	local body = G.box("EdgeBuilding", V(w, h, d), cf * CFrame.new(0, h / 2, 0), look)
	local floorH = opts.FloorH or 5
	local windowLook = { opts.Windows or RGB(58, 70, 84), M.Glass }
	for f = 1, math.floor((h - 2) / floorH) do
		local y = (f - 1) * floorH + floorH * 0.55
		local band = G.deco("EdgeWindows", V(w + 0.2, floorH * 0.38, d + 0.2), cf * CFrame.new(0, y, 0), windowLook)
		band.CastShadow = false
		band.Reflectance = 0.12
		if opts.Lit then
			-- De noche, algunas ventanas encendidas (sueltas, no la banda entera)
			local seed = f * 7 + math.floor(w * 3 + d)
			for k, spec in { { -0.3, -1 }, { 0.15, -1 }, { 0.32, 1 }, { -0.1, 1 } } do
				if (seed + k) % 3 ~= 0 then
					local alongX = k <= 2
					local offset = alongX and V(spec[1] * w, y, spec[2] * (d / 2 + 0.15)) or V(spec[2] * (w / 2 + 0.15), y, spec[1] * d)
					local size = alongX and V(math.min(5, w * 0.16), floorH * 0.34, 0.12) or V(0.12, floorH * 0.34, math.min(5, d * 0.16))
					G.deco("LitWindow", size, cf * CFrame.new(offset), { RGB(226, 176, 112), M.Neon }).CastShadow = false
				end
			end
		end
		-- Losa entre plantas (línea más clara)
		G.deco("EdgeSlab", V(w + 0.3, 0.35, d + 0.3), cf * CFrame.new(0, f * floorH, 0), { look[1]:Lerp(Color3.new(1, 1, 1), 0.12), look[2] }).CastShadow = false
	end
	G.deco("EdgeCornice", V(w + 0.8, 0.7, d + 0.8), cf * CFrame.new(0, h + 0.35, 0), { look[1]:Lerp(Color3.new(0, 0, 0), 0.2), look[2] }).CastShadow = false
	if opts.Roof ~= false then
		local roofCf = cf * CFrame.new(0, h, 0)
		P.waterTank(roofCf * CFrame.new(w * 0.25, 0, d * 0.2))
		G.deco("RoofBox", V(4, 2.4, 3), roofCf * CFrame.new(-w * 0.22, 1.2, -d * 0.18), "SteelDark")
	end
	return body
end

---------------------------------------------------------------------------
-- Azoteas
---------------------------------------------------------------------------

-- Antena de celosía (decorado alto con base que choca) y balizas
function P.antennaTower(cf, h)
	h = h or 24
	local base = G.box("AntennaBase", V(4, 1.6, 4), cf * CFrame.new(0, 0.8, 0), "SteelDark")
	local w = 2.4
	for _, c in { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } } do
		G.beam(cf * V(c[1] * w / 2, 1.6, c[2] * w / 2), cf * V(c[1] * 0.4, h, c[2] * 0.4), 0.25, 0.25, "SteelDark", true)
	end
	for y = 4, h - 2, 4 do
		local k = 1 - (y / h) * 0.7
		G.deco("AntennaRing", V(w * k, 0.2, w * k), cf * CFrame.new(0, y, 0), "SteelDark")
	end
	for _, y in { h * 0.55, h * 0.8 } do
		G.deco("AntennaPanel", V(0.4, 2.4, 1.2), cf * CFrame.new(0.9, y, 0), { RGB(220, 222, 226), M.SmoothPlastic })
	end
	local beacon = Kit.ball("AntennaBeacon", 0.7, cf * CFrame.new(0, h + 0.5, 0), RGB(255, 40, 30), M.Neon, true)
	beacon:SetAttribute("Blink", 1)
	return base
end

-- Lucernario piramidal de cristal sobre un zócalo (cobertura baja)
function P.skylight(cf, w)
	w = w or 8
	local curb = G.box("SkylightCurb", V(w, 1.4, w), cf * CFrame.new(0, 0.7, 0), "SteelDark")
	local h = w * 0.35
	local slope = math.sqrt((w / 2) ^ 2 + h * h)
	for i = 0, 3 do
		local face = cf * CFrame.new(0, 1.4, 0) * CFrame.Angles(0, rad(i * 90), 0)
		local pane = G.deco("SkylightGlass", V(w * 0.7, 0.2, slope), face * CFrame.new(0, h / 2, -w / 4) * CFrame.Angles(math.atan2(h, w / 2), 0, 0), "Glass")
		pane.Transparency = 0.35
	end
	return curb
end

-- Placas solares en fila (cobertura muy baja)
function P.solarRow(cf, count)
	for i = 0, (count or 3) - 1 do
		local panel = cf * CFrame.new(i * 4.4, 0, 0)
		G.deco("SolarLeg", V(0.3, 1.6, 0.3), panel * CFrame.new(0, 0.8, 1), "SteelDark")
		G.box("SolarPanel", V(4, 0.25, 3), panel * CFrame.new(0, 1.4, 0) * CFrame.Angles(rad(25), 0, 0), { RGB(30, 50, 90), M.Glass })
	end
end

-- Antena parabólica
function P.dish(cf)
	G.deco("DishPost", V(0.4, 2.4, 0.4), cf * CFrame.new(0, 1.2, 0), "SteelDark")
	local d = Kit.cylinder("Dish", 0.4, 3, cf * CFrame.new(0, 2.8, -0.3) * CFrame.Angles(rad(-55), 0, 0), RGB(230, 232, 236), M.SmoothPlastic, nil, true)
	d.CastShadow = true
end

-- Valla publicitaria con pantalla (cara -Z) sobre patas: el cuerpo choca
function P.billboardScreen(cf, w, h, text, color)
	for _, x in { -w * 0.35, w * 0.35 } do
		G.box("BillboardLeg", V(0.6, 4, 0.6), cf * CFrame.new(x, 2, 0.4), "SteelDark")
	end
	local frame = G.box("BillboardFrame", V(w, h, 1), cf * CFrame.new(0, 4 + h / 2, 0.4), "SteelDark")
	local screen = G.deco("BillboardScreen", V(w - 0.8, h - 0.8, 0.2), cf * CFrame.new(0, 4 + h / 2, -0.15), { color or RGB(30, 80, 170), M.SmoothPlastic })
	screen.CastShadow = false
	local gui = Kit.sign(screen, Enum.NormalId.Front, text or "", RGB(230, 244, 255), color or RGB(30, 80, 170))
	gui.LightInfluence = 0.15
	return frame
end

---------------------------------------------------------------------------
-- Vegetación y mobiliario
---------------------------------------------------------------------------

function P.tree(cf)
	Kit.tree(cf)
end

function P.palm(cf, h)
	Kit.palm(cf, h)
end

-- Jardinera de hormigón con arbusto (cobertura baja)
function P.planter(cf, sx, sz)
	sx, sz = sx or 6, sz or 3
	local box = G.box("Planter", V(sx, 2, sz), cf * CFrame.new(0, 1, 0), "ConcreteDark")
	G.deco("PlanterSoil", V(sx - 0.6, 0.2, sz - 0.6), cf * CFrame.new(0, 2.02, 0), { RGB(80, 58, 40), M.Ground })
	for i = 0, math.floor(sx / 2.5) - 1 do
		Kit.ball("Shrub", 2.2, cf * CFrame.new(-sx / 2 + 1.4 + i * 2.5, 2.6, 0), RGB(70, 128, 60), M.Grass, true)
	end
	return box
end

-- Máquina de aire acondicionado de azotea (cobertura baja)
function P.hvac(cf, look)
	local box = G.box("HVAC", V(5, 3, 4), cf * CFrame.new(0, 1.5, 0), look or { RGB(196, 198, 200), M.Metal })
	Kit.cylinder("HVACFan", 0.3, 2.8, cf * CFrame.new(-0.9, 3.1, 0), RGB(60, 62, 66), M.Metal, nil, true)
	G.deco("HVACGrille", V(0.1, 2, 3), cf * CFrame.new(2.55, 1.5, 0), "SteelDark")
	return box
end

-- Farola (luz cálida hacia -Z)
function P.lampPost(cf, color)
	Kit.streetLamp(cf, color)
end

return P
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="129">
            <Properties>
              <string name="Name">Rail</string>
              <string name="Source"><![CDATA[-- Piezas de ferrocarril (Metro Yard): vía con balasto y traviesas, coche de metro (cobertura alta,
-- con cabina opcional), topera, pórtico de catenaria, torniquetes, máquina de billetes, máquina de
-- bebidas, banco, panel de salidas, tótem "M" y carro de mantenimiento. cf = centro de la base;
-- las piezas largas van a lo largo de Z local (la "cara" mira a -Z).
local Kit = require(script.Parent.Parent.MapKit)
local Materials = require(script.Parent.Materials)
local G = require(script.Parent.Geometry)

local Rail = {}

local V = Vector3.new
local RGB = Color3.fromRGB
local get = Materials.get
local M = Enum.Material

local DARK_GLASS = { RGB(34, 42, 54), M.Glass }
local BOGIE = { RGB(44, 46, 52), M.Metal }

-- Vía de a a b (a la altura del suelo de la zanja): balasto, traviesas cada 3 studs y dos carriles.
-- Todo decorado (no choca: se camina por encima sin tropezar)
function Rail.track(a, b, opts)
	opts = opts or {}
	local mid = (a + b) / 2
	local length = (b - a).Magnitude
	local cf = CFrame.lookAt(mid, b)
	G.deco("Ballast", V(5.2, 0.3, length), cf * CFrame.new(0, 0.15, 0), "Ballast").CastShadow = false
	local step = opts.Step or 3
	local count = math.floor(length / step)
	for i = 0, count - 1 do
		local z = -length / 2 + step * (i + 0.5)
		G.deco("Sleeper", V(4.4, 0.24, 0.7), cf * CFrame.new(0, 0.42, z), "Sleeper").CastShadow = false
	end
	for _, s in { -1, 1 } do
		G.deco("RailTrack", V(0.3, 0.4, length), cf * CFrame.new(s * 1.45, 0.7, 0), "Rail").CastShadow = false
	end
end

-- Coche de metro de length studs (a lo largo de Z local) sobre el carril (cf a la altura de la
-- vía). Caja que choca (cobertura alta), franja naranja, ventanas, puertas y aire acondicionado.
-- opts: Cab = "Front" | "Back" | "Both" (cabina con parabrisas y faros), Stripe, Label
function Rail.metroCar(cf, length, opts)
	opts = opts or {}
	length = length or 20
	local stripe = opts.Stripe and get(opts.Stripe) or get("Orange")
	local h = 7.6
	local body = G.box("TrainBody", V(6.4, h, length), cf * CFrame.new(0, 0.5 + h / 2, 0), "Train")
	G.deco("TrainRoof", V(5.6, 0.5, length - 1), cf * CFrame.new(0, 0.5 + h + 0.25, 0), "Steel")
	for _, s in { -1, 1 } do
		local side = cf * CFrame.new(s * 3.24, 0, 0)
		G.deco("TrainWindows", V(0.12, 2.2, length - 3), side * CFrame.new(0, 5.4, 0), DARK_GLASS).CastShadow = false
		G.deco("TrainStripe", V(0.12, 0.7, length), side * CFrame.new(0, 3.2, 0), stripe).CastShadow = false
		G.deco("TrainSkirt", V(0.12, 0.9, length - 2), side * CFrame.new(0, 1.0, 0), BOGIE).CastShadow = false
		for _, z in { -length / 4, length / 4 } do
			G.deco("TrainDoor", V(0.16, 5.8, 3.4), side * CFrame.new(0, 3.6, z), "Steel").CastShadow = false
			G.deco("TrainDoorGlass", V(0.2, 2.2, 2.6), side * CFrame.new(0, 5.2, z), DARK_GLASS).CastShadow = false
		end
	end
	for _, z in { -length / 2 + 4, length / 2 - 4 } do
		G.deco("TrainBogie", V(5.2, 0.9, 4.4), cf * CFrame.new(0, 0.45, z), BOGIE)
		G.deco("TrainAC", V(3.6, 0.7, 3), cf * CFrame.new(0, 0.5 + h + 0.6, z * 0.6), "SteelDark")
	end
	local cabs = opts.Cab
	for _, e in { { "Front", -1 }, { "Back", 1 } } do
		if cabs == e[1] or cabs == "Both" then
			local face = cf * CFrame.new(0, 0, e[2] * (length / 2 + 0.06))
			G.deco("Windscreen", V(5.2, 2.6, 0.12), face * CFrame.new(0, 5.4, 0), DARK_GLASS).CastShadow = false
			G.deco("CabStripe", V(6.4, 0.7, 0.12), face * CFrame.new(0, 3.2, 0), stripe).CastShadow = false
			for _, s in { -1, 1 } do
				local lamp = G.deco("HeadLight", V(0.8, 0.5, 0.14), face * CFrame.new(s * 2.2, 2.2, 0), { RGB(255, 246, 220), M.Neon })
				lamp.CastShadow = false
			end
			local label = G.deco("Destination", V(3.6, 0.7, 0.14), face * CFrame.new(0, 7.2, 0), { RGB(20, 22, 26), M.SmoothPlastic })
			local gui = Kit.sign(label, e[2] < 0 and Enum.NormalId.Front or Enum.NormalId.Back, opts.Label or "M2 · CENTRO", RGB(255, 170, 60), RGB(20, 22, 26))
			gui.LightInfluence = 0
		end
	end
	return body
end

-- Tren de varios coches seguidos a lo largo de Z local (cf = centro del tren). Devuelve los cuerpos
function Rail.train(cf, cars, carLength, opts)
	opts = opts or {}
	carLength = carLength or 20
	local gap = 0.8
	local total = cars * carLength + (cars - 1) * gap
	local bodies = {}
	for i = 1, cars do
		local z = -total / 2 + (i - 0.5) * carLength + (i - 1) * gap
		local cab = nil
		if cars == 1 then
			cab = "Both"
		elseif i == 1 then
			cab = "Front"
		elseif i == cars then
			cab = "Back"
		end
		table.insert(bodies, Rail.metroCar(cf * CFrame.new(0, 0, z), carLength, { Cab = cab, Stripe = opts.Stripe, Label = opts.Label }))
		if i < cars then
			G.deco("Gangway", V(4.6, 6.4, gap + 0.2), cf * CFrame.new(0, 0.5 + 3.8, z + carLength / 2 + gap / 2), BOGIE)
		end
	end
	return bodies
end

-- Topera al final de una vía (choca: cobertura baja). Mira a -Z (la vía llega por -Z)
function Rail.bufferStop(cf)
	local body = G.box("BufferStop", V(4.6, 2.6, 1.6), cf * CFrame.new(0, 1.3, 0), "SteelDark")
	G.deco("BufferFace", V(4.8, 0.8, 0.2), cf * CFrame.new(0, 1.9, -0.86), "Red").CastShadow = false
	for _, s in { -1, 1 } do
		G.deco("Buffer", V(0.9, 0.9, 0.8), cf * CFrame.new(s * 1.45, 1.4, -1.1), "Steel")
	end
	return body
end

-- Pórtico de catenaria sobre una zanja (span = ancho; decorado: postes y viga sin colisión)
function Rail.gantry(cf, span, h)
	h = h or 9
	for _, s in { -1, 1 } do
		G.deco("GantryPole", V(0.6, h, 0.6), cf * CFrame.new(s * span / 2, h / 2, 0), "SteelDark")
	end
	G.deco("GantryBeam", V(span + 0.6, 0.6, 0.6), cf * CFrame.new(0, h - 0.3, 0), "SteelDark")
	G.deco("Catenary", V(span, 0.08, 0.08), cf * CFrame.new(0, h - 1.4, 0), BOGIE).CastShadow = false
end

-- Línea de torniquetes a lo largo de X local (count unidades; huecos de paso de 3 studs)
function Rail.turnstiles(cf, count)
	local pitch = 4.2
	local parts = {}
	for i = 0, count do
		local x = (i - count / 2) * pitch
		table.insert(parts, G.box("Turnstile", V(1, 3.2, 2), cf * CFrame.new(x, 1.6, 0), "SteelDark"))
		G.deco("TurnstileTop", V(1.1, 0.12, 2.1), cf * CFrame.new(x, 3.26, 0), "Orange").CastShadow = false
		if i < count then
			G.deco("GatePaddle", V(2.8, 1.6, 0.1), cf * CFrame.new(x + pitch / 2, 1.9, 0), { RGB(190, 214, 230), M.Glass }).Transparency = 0.5
		end
	end
	return parts
end

-- Máquina de billetes (choca: cobertura media)
function Rail.ticketMachine(cf)
	local body = G.box("TicketMachine", V(2.6, 6, 1.8), cf * CFrame.new(0, 3, 0), "WallBlue")
	local screen = G.deco("TicketScreen", V(1.8, 1.4, 0.1), cf * CFrame.new(0, 4.3, -0.92), { RGB(120, 200, 255), M.Neon })
	screen.CastShadow = false
	G.deco("TicketSlot", V(1.6, 0.3, 0.1), cf * CFrame.new(0, 2.6, -0.92), "SteelDark")
	return body
end

-- Máquina de bebidas (choca)
function Rail.vending(cf, color)
	local body = G.box("Vending", V(3, 6.4, 2.2), cf * CFrame.new(0, 3.2, 0), { color or RGB(240, 128, 36), M.SmoothPlastic })
	G.deco("VendingGlass", V(1.8, 4, 0.1), cf * CFrame.new(-0.4, 3.8, -1.12), { RGB(200, 230, 255), M.Glass }).CastShadow = false
	return body
end

-- Banco del andén (choca: cobertura muy baja)
function Rail.bench(cf)
	local seat = G.box("Bench", V(5, 1.4, 1.6), cf * CFrame.new(0, 0.7, 0), "SteelDark")
	G.deco("BenchBack", V(5, 1.4, 0.3), cf * CFrame.new(0, 2, 0.65), "Orange").CastShadow = false
	return seat
end

-- Panel de salidas colgado (decorado; luce)
function Rail.departureBoard(cf, text)
	local board = G.deco("DepartureBoard", V(7, 1.6, 0.4), cf, { RGB(18, 20, 26), M.SmoothPlastic })
	board.CastShadow = false
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Kit.sign(board, face, text or "M2 CENTRO  2 min", RGB(255, 170, 60), RGB(18, 20, 26))
		gui.LightInfluence = 0
	end
	G.deco("BoardHanger", V(0.2, 2, 0.2), cf * CFrame.new(-2.5, 1.8, 0), "SteelDark")
	G.deco("BoardHanger", V(0.2, 2, 0.2), cf * CFrame.new(2.5, 1.8, 0), "SteelDark")
	return board
end

-- Tótem del metro: poste con la "M" azul en un cuadrado (hito para orientarse)
function Rail.metroTotem(cf, h)
	h = h or 9
	G.box("TotemPole", V(0.8, h, 0.8), cf * CFrame.new(0, h / 2, 0), "SteelDark")
	local sign = G.deco("TotemSign", V(3.2, 3.2, 0.5), cf * CFrame.new(0, h + 1.2, 0), "Blue")
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Kit.sign(sign, face, "M", RGB(255, 255, 255), RGB(40, 96, 196))
		gui.LightInfluence = 0.3
	end
	return sign
end

-- Carro de mantenimiento sobre la vía (choca: cobertura media)
function Rail.trolley(cf)
	local body = G.box("Trolley", V(5, 2.6, 7), cf * CFrame.new(0, 1.9, 0), "Orange")
	for _, z in { -2.4, 2.4 } do
		G.deco("TrolleyWheels", V(4.4, 0.6, 1.2), cf * CFrame.new(0, 0.3, z), BOGIE)
	end
	G.deco("TrolleyLoad", V(4.2, 1.2, 3), cf * CFrame.new(0, 3.8, -1.2), "SteelDark")
	return body
end

-- Armario de señales (choca: cobertura alta y estrecha)
function Rail.relayCabinet(cf, h)
	h = h or 6
	local body = G.box("RelayCabinet", V(3.2, h, 2.4), cf * CFrame.new(0, h / 2, 0), "ConcreteDark")
	G.deco("CabinetStripe", V(3.3, 0.5, 2.5), cf * CFrame.new(0, h - 0.6, 0), "Orange").CastShadow = false
	local lamp = G.deco("SignalLamp", V(0.6, 0.6, 0.2), cf * CFrame.new(0.8, h - 1.6, -1.25), { RGB(80, 255, 120), M.Neon })
	lamp.CastShadow = false
	return body
end

return Rail
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="130">
            <Properties>
              <string name="Name">Town</string>
              <string name="Source"><![CDATA[-- Piezas de pueblo (Costa y mapas urbanos): tejado de teja a dos aguas, casa encalada con
-- contraventanas y macetas, arcos, puestos con toldo a rayas, faroles, bolardos, barcas, fuente
-- y sombrillas. Mismas convenciones que Props: cf = centro de la base, la "cara" mira a -Z.
local Kit = require(script.Parent.Parent.MapKit)
local Materials = require(script.Parent.Materials)
local G = require(script.Parent.Geometry)

local Town = {}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad
local get = Materials.get
local M = Enum.Material

-- Cuña (WedgePart): la rampa baja hacia -Z y sube hacia +Z (alto en +Z), a lo ancho en X
local function wedge(name, size, cf, look, solid)
	look = get(look)
	local w = Instance.new("WedgePart")
	w.Name = name
	w.Anchored = true
	w.Size = size
	w.CFrame = cf
	w.Color = look[1]
	w.Material = look[2]
	w.TopSurface = Enum.SurfaceType.Smooth
	w.BottomSurface = Enum.SurfaceType.Smooth
	if not solid then
		w.CanCollide = false
		w.CanQuery = false
		w.CanTouch = false
	end
	w.CastShadow = size.X * size.Y * size.Z >= 20
	w.Parent = Kit.folder
	return w
end
Town.wedge = wedge

-- Tejado de teja a dos aguas sobre una caja de w (X) x d (Z): cumbrera a lo largo de X. cf = centro
-- de la cara de arriba del muro. pitch = altura de la cumbrera. Aleros que vuelan 0,8.
function Town.gableRoof(cf, w, d, pitch, look)
	look = look or "RoofTile"
	pitch = pitch or d * 0.32
	local eave = 0.8
	local half = d / 2 + eave
	local slope = math.sqrt(half * half + pitch * pitch)
	local angle = math.atan2(pitch, half)
	for _, s in { -1, 1 } do
		local plane = G.deco("RoofTiles", V(w + 2 * eave, 0.5, slope), cf * CFrame.new(0, pitch / 2 - 0.1, s * half / 2) * CFrame.Angles(s * angle, 0, 0), look)
		plane.CastShadow = true
	end
	-- Frontones (triángulos de pared en los extremos), del color de la pared de debajo
	return angle
end

-- Frontón triangular (cierra el hueco bajo el tejado en un extremo): dos cuñas
function Town.gable(cf, d, pitch, look)
	for _, s in { -1, 1 } do
		wedge("Gable", V(0.6, pitch, d / 2), cf * CFrame.new(0, pitch / 2, s * d / 4) * CFrame.Angles(0, s > 0 and math.pi or 0, 0), look)
	end
end

-- Hueco en arco: dos cuñas en las esquinas de arriba de un hueco (decorado; el hueco real es
-- rectangular). cf = centro de la parte de arriba del hueco, en el plano del muro; w = ancho
function Town.archCorners(cf, w, r, look, depth)
	r = r or math.min(1.6, w * 0.3)
	depth = depth or 1.1
	for _, s in { -1, 1 } do
		-- (la cuña rellena la esquina: alta junto a la jamba, baja hacia el centro)
		wedge("ArchCorner", V(depth, r, r), cf * CFrame.new(s * (w / 2 - r / 2), -r / 2, 0) * CFrame.Angles(0, s > 0 and -math.pi / 2 or math.pi / 2, 0) * CFrame.Angles(math.pi, 0, 0), look)
	end
end

-- Casa encalada maciza (no se entra): cuerpo, zócalo, cornisa, ventanas con contraventanas y
-- macetas en la cara -Z (y +Z si opts.Back), tejado de teja o azotea con pretil. Devuelve el cuerpo.
-- opts: Roof = "Tile" | "Flat", Floors, Shutter (color), Door (bool), Back (bool), Balcony (bool)
function Town.house(cf, w, d, h, look, opts)
	opts = opts or {}
	look = get(look)
	local body = G.box("House", V(w, h, d), cf * CFrame.new(0, h / 2, 0), look)
	local trim = { look[1]:Lerp(Color3.new(0, 0, 0), 0.16), M.Limestone }
	-- (zócalo: por defecto, el color de la casa más oscuro; opts.Plinth = color pintado, como el azul o
	-- el ocre de los pueblos encalados. Fase 14: más alto, se lee desde la calle)
	local plinthLook = opts.Plinth and { opts.Plinth, M.Plaster } or trim
	G.deco("HouseBase", V(w + 0.3, opts.Plinth and 1.6 or 1.2, d + 0.3), cf * CFrame.new(0, opts.Plinth and 0.8 or 0.6, 0), plinthLook).CastShadow = false
	local shutter = { opts.Shutter or RGB(70, 120, 92), M.WoodPlanks }
	local floors = opts.Floors or math.max(1, math.floor(h / 7))
	local faces = { -1 }
	if opts.Back then
		table.insert(faces, 1)
	end
	for _, side in faces do
		local zf = side * (d / 2 + 0.05)
		local turn = side > 0 and CFrame.Angles(0, math.pi, 0) or CFrame.new()
		local count = math.max(1, math.floor(w / 7))
		for f = 1, floors do
			local y = (f - 1) * (h / floors) + (h / floors) * 0.55
			for i = 1, count do
				local x = -w / 2 + (i - 0.5) * w / count
				local isDoor = f == 1 and opts.Door ~= false and i == math.ceil(count / 2)
				local at = cf * CFrame.new(x, isDoor and 3.5 or y, zf) * turn
				if isDoor then
					G.deco("Door", V(3, 6.4, 0.15), at * CFrame.new(0, -0.3, 0), { RGB(110, 70, 44), M.WoodPlanks })
					G.deco("DoorFrame", V(3.6, 0.5, 0.25), at * CFrame.new(0, 3.1, 0), trim)
				else
					G.deco("Window", V(1.8, 2.4, 0.12), at, { RGB(40, 44, 50), M.Glass })
					for _, s in { -1, 1 } do
						G.deco("Shutter", V(0.9, 2.5, 0.15), at * CFrame.new(s * 1.4, 0, -0.04), shutter)
					end
					if (i + f) % 2 == 0 then
						G.deco("FlowerBox", V(2.2, 0.5, 0.6), at * CFrame.new(0, -1.45, -0.25), { RGB(150, 84, 52), M.Plaster })
						Kit.ball("Geranium", 0.9, at * CFrame.new(-0.5, -1, -0.3), RGB(220, 50, 70), M.SmoothPlastic, true)
						Kit.ball("Geranium", 0.8, at * CFrame.new(0.5, -1, -0.3), RGB(80, 150, 70), M.Grass, true)
					end
				end
			end
		end
	end
	if opts.Roof == "Flat" then
		G.deco("Cornice", V(w + 0.6, 0.6, d + 0.6), cf * CFrame.new(0, h - 0.1, 0), trim).CastShadow = false
		G.deco("Parapet", V(w, 1.2, d), cf * CFrame.new(0, h + 0.6, 0), look).CastShadow = false
	else
		Town.gableRoof(cf * CFrame.new(0, h, 0), w, d, opts.Pitch or math.min(5, d * 0.3), opts.RoofLook)
		for _, s in { -1, 1 } do
			Town.gable(cf * CFrame.new(s * (w / 2 - 0.3), h, 0), d, opts.Pitch or math.min(5, d * 0.3), look)
		end
	end
	if opts.Balcony then
		local bal = cf * CFrame.new(0, h * 0.55 + 0.5, -d / 2 - 1.1)
		G.deco("Balcony", V(math.min(6, w * 0.5), 0.4, 2.2), bal, trim)
		G.deco("BalconyRail", V(math.min(6, w * 0.5), 0.15, 0.15), bal * CFrame.new(0, 2.2, -1), "Iron")
		for k = -2, 2 do
			G.deco("BalconyBar", V(0.12, 2.2, 0.12), bal * CFrame.new(k * math.min(6, w * 0.5) / 5, 1.1, -1), "Iron")
		end
	end
	return body
end

-- Puesto de mercado: mostrador (cobertura baja), postes y toldo a rayas
function Town.stall(cf, color, w)
	w = w or 6
	local counter = G.box("StallCounter", V(w, 3, 2.4), cf * CFrame.new(0, 1.5, 0), { RGB(150, 104, 62), M.WoodPlanks })
	G.deco("StallTop", V(w + 0.3, 0.3, 2.7), cf * CFrame.new(0, 3.1, 0), { RGB(120, 82, 50), M.Wood })
	for _, x in { -w / 2 + 0.2, w / 2 - 0.2 } do
		for _, z in { -1.1, 2.6 } do
			G.deco("StallPost", V(0.25, 6.6, 0.25), cf * CFrame.new(x, 3.3, z), { RGB(110, 76, 46), M.Wood })
		end
	end
	local stripes = math.floor(w / 1.2)
	for i = 0, stripes - 1 do
		G.deco("StallAwning", V(w / stripes, 0.2, 4.6), cf * CFrame.new(-w / 2 + (i + 0.5) * w / stripes, 6.5, 0.7) * CFrame.Angles(rad(-12), 0, 0), { i % 2 == 0 and color or RGB(245, 240, 230), M.Fabric })
	end
	-- Género sobre el mostrador
	for i = -1, 1 do
		Kit.ball("Fruit", 0.7, cf * CFrame.new(i * w * 0.25, 3.6, -0.3), i == 0 and RGB(240, 150, 40) or RGB(200, 50, 40), M.SmoothPlastic, true)
	end
	return counter
end

-- Farol de forja en la pared (cara -Z): luz cálida
function Town.lantern(cf)
	G.deco("LanternArm", V(0.2, 0.2, 1.2), cf * CFrame.new(0, 0.4, -0.6), "Iron")
	G.deco("LanternCage", V(0.9, 1.3, 0.9), cf * CFrame.new(0, -0.3, -1.2), "Iron")
	local glass = G.deco("LanternGlass", V(0.7, 1, 0.7), cf * CFrame.new(0, -0.3, -1.2), { RGB(255, 214, 140), M.Neon })
	Kit.light(glass, "PointLight", RGB(255, 200, 130), 14, 0.9)
end

-- Farola de pie (forja, dos brazos)
function Town.streetLight(cf)
	Kit.cylinder("LampPost", 10, 0.5, cf * CFrame.new(0, 5, 0), RGB(36, 36, 40), M.Metal)
	Kit.cylinder("LampFoot", 0.8, 1.2, cf * CFrame.new(0, 0.4, 0), RGB(36, 36, 40), M.Metal, nil, true)
	local top = cf * CFrame.new(0, 10, 0)
	G.deco("LampTop", V(1.2, 1.6, 1.2), top * CFrame.new(0, 0.4, 0), "Iron")
	local glass = G.deco("LampGlass", V(0.9, 1.2, 0.9), top * CFrame.new(0, 0.4, 0), { RGB(255, 214, 150), M.Neon })
	Kit.light(glass, "PointLight", RGB(255, 205, 140), 18, 1)
end

-- Bolardo de amarre con neumático colgado en el borde del muelle (decorado: la barandilla del
-- muelle ya impide caer)
function Town.bollard(cf)
	Kit.cylinder("Bollard", 1.4, 1.1, cf * CFrame.new(0, 0.7, 0), RGB(40, 42, 46), M.Metal)
	Kit.cylinder("BollardCap", 0.3, 1.5, cf * CFrame.new(0, 1.45, 0), RGB(40, 42, 46), M.Metal, nil, true)
end

function Town.tire(cf)
	local tire = Kit.pipe("Tire", 0.7, 2.6, cf * CFrame.Angles(0, rad(90), 0), RGB(28, 28, 30), M.Rubber, true)
	return tire
end

-- Barca de remos (decorado, flota en el agua)
function Town.rowboat(cf, color)
	color = color or RGB(236, 236, 230)
	G.deco("BoatHull", V(3.6, 1.6, 9), cf * CFrame.new(0, 0.3, 0), { color, M.WoodPlanks })
	G.deco("BoatGunwale", V(3.8, 0.3, 9.2), cf * CFrame.new(0, 1.1, 0), { RGB(160, 50, 40), M.Wood })
	wedge("BoatBow", V(3.6, 1.6, 2.4), cf * CFrame.new(0, 0.3, -5.7) * CFrame.Angles(0, math.pi, 0), { color, M.WoodPlanks })
	for _, z in { -1.6, 1.8 } do
		G.deco("BoatSeat", V(3.4, 0.25, 0.8), cf * CFrame.new(0, 0.8, z), { RGB(150, 110, 70), M.Wood })
	end
end

-- Fuente de plaza: pilón (cobertura baja), agua y columna con figura (cobertura alta en el centro).
-- accent (opcional): color de la franja de azulejo del pilón y del anillo del suelo (hito de la plaza)
function Town.fountain(cf, d, accent)
	d = d or 12
	local basin = Kit.cylinder("FountainBasin", 2.4, d, cf * CFrame.new(0, 1.2, 0), RGB(206, 196, 178), M.Limestone)
	if accent then
		Kit.cylinder("FountainTileBand", 0.8, d + 0.12, cf * CFrame.new(0, 1.4, 0), accent, M.CeramicTiles, nil, true)
		Kit.cylinder("FountainFloorRing", 0.06, d + 5, cf * CFrame.new(0, 0.03, 0), accent, M.CeramicTiles, nil, true).CastShadow = false
		Kit.cylinder("FountainFloorInner", 0.06, d + 3, cf * CFrame.new(0, 0.045, 0), RGB(220, 210, 190), M.Limestone, nil, true).CastShadow = false
	end
	Kit.cylinder("FountainRim", 0.4, d + 0.6, cf * CFrame.new(0, 2.5, 0), RGB(226, 216, 198), M.Limestone, nil, true)
	local water = Kit.cylinder("FountainWater", 0.2, d - 1.2, cf * CFrame.new(0, 2.1, 0), RGB(70, 150, 190), M.Glass, nil, true)
	water.Transparency = 0.25
	Kit.cylinder("FountainPedestal", 5, 3, cf * CFrame.new(0, 4.5, 0), RGB(210, 200, 182), M.Limestone)
	Kit.cylinder("FountainBowl", 0.8, 5.4, cf * CFrame.new(0, 7.2, 0), RGB(214, 204, 186), M.Limestone, nil, true)
	G.deco("FountainFigure", V(1.4, 3.4, 1.2), cf * CFrame.new(0, 9.3, 0), { RGB(196, 188, 170), M.Marble })
	Kit.ball("FountainHead", 1.1, cf * CFrame.new(0, 11.4, 0), RGB(196, 188, 170), M.Marble, true)
	local drops = Instance.new("ParticleEmitter")
	drops.Name = "FountainSpray"
	drops.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	drops.Color = ColorSequence.new(RGB(220, 240, 255))
	drops.Size = NumberSequence.new(0.25, 0.1)
	drops.Transparency = NumberSequence.new(0.3, 1)
	drops.Lifetime = NumberRange.new(0.6, 0.9)
	drops.Rate = 30
	drops.Speed = NumberRange.new(5, 7)
	drops.SpreadAngle = Vector2.new(25, 25)
	drops.Acceleration = V(0, -30, 0)
	drops.Parent = water
	return basin
end

-- Mesa de terraza con sombrilla (cobertura muy baja)
function Town.cafeTable(cf, color)
	Kit.cylinder("CafeTable", 0.2, 2.4, cf * CFrame.new(0, 2.6, 0), RGB(236, 232, 224), M.Metal, nil, true)
	G.box("CafeLeg", V(0.4, 2.6, 0.4), cf * CFrame.new(0, 1.3, 0), "Iron")
	G.deco("Parasol", V(0.2, 5, 0.2), cf * CFrame.new(0, 5, 0), "Iron")
	Kit.cylinder("ParasolTop", 0.3, 6, cf * CFrame.new(0, 7.4, 0), color or RGB(200, 60, 50), M.Fabric, nil, true)
	for _, a in { 0, 120, 240 } do
		local seat = cf * CFrame.Angles(0, rad(a), 0) * CFrame.new(0, 0, -2.2)
		G.deco("CafeChair", V(1.2, 0.25, 1.2), seat * CFrame.new(0, 1.6, 0), "Iron")
		G.deco("CafeChairBack", V(1.2, 1.4, 0.15), seat * CFrame.new(0, 2.3, -0.55), "Iron")
	end
end

return Town
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="131">
          <Properties>
            <string name="Name">Zombie</string>
            <string name="Source"><![CDATA[-- Aspecto y vida de los zombis del modo Infección (jugadores y bots): piel verde, ojos rojos
-- brillantes y más vida. Las garras y la velocidad vienen del arma (Weapons.Claws).
local Zombie = {}

Zombie.Skin = Color3.fromRGB(110, 165, 80)
local EYE = Color3.fromRGB(255, 40, 30)
local SKIN_PARTS = {
	"Head",
	"LeftHand",
	"RightHand",
	"LeftLowerArm",
	"RightLowerArm",
	"LeftUpperArm",
	"RightUpperArm",
	"Left Arm",
	"Right Arm",
}

local function eye(head, x)
	local part = Instance.new("Part")
	part.Name = "ZombieEye"
	part.Size = Vector3.new(0.2, 0.12, 0.05)
	part.Color = EYE
	part.Material = Enum.Material.Neon
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
	part.CFrame = head.CFrame * CFrame.new(x * head.Size.X, head.Size.Y * 0.12, -head.Size.Z * 0.5)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = part
	weld.Parent = part
	part.Parent = head
end

-- Pinta al personaje de zombi y le da la vida indicada
function Zombie.Apply(character, health)
	character:SetAttribute("Zombie", true)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and health then
		humanoid.MaxHealth = health
		humanoid.Health = health
	end
	local bodyColors = character:FindFirstChildOfClass("BodyColors")
	if bodyColors then
		bodyColors.HeadColor3 = Zombie.Skin
		bodyColors.LeftArmColor3 = Zombie.Skin
		bodyColors.RightArmColor3 = Zombie.Skin
	end
	for _, name in SKIN_PARTS do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			part.Color = Zombie.Skin
		end
	end
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") and not head:FindFirstChild("ZombieEye") then
		eye(head, -0.17)
		eye(head, 0.17)
	end
end

return Zombie
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="132">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <token name="CameraMode">1</token>
      <float name="CharacterWalkSpeed">18</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="133">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="134">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="135">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Punto de entrada del cliente.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local Modules = script.Parent:WaitForChild("Modules")
local ClientState = require(Modules.ClientState)
local WeaponController = require(Modules.WeaponController)
local Movement = require(Modules.Movement)
local HUD = require(Modules.HUD)
local Menu = require(Modules.Menu)
local MainMenu = require(Modules.MainMenu)
local WorldFX = require(Modules.WorldFX)
local VoteUI = require(Modules.VoteUI)
local GrenadeController = require(Modules.GrenadeController)
local KillstreakController = require(Modules.KillstreakController)
local Settings = require(Modules.Settings)
local Footprints = require(Modules.Footprints)
local DeathScreen = require(Modules.DeathScreen)
local QuestTracker = require(Modules.QuestTracker)
local Abilities = require(Modules.Abilities)
local Emotes = require(Modules.Emotes)
local Scoreboard = require(Modules.Scoreboard)
local PlaytimeGifts = require(Modules.PlaytimeGifts)
local SkinFX = require(Modules.SkinFX)
local JumpPads = require(Modules.JumpPads)
local Tutorial = require(Modules.Tutorial)
local Hints = require(Modules.Hints)
local QAPanel = require(Modules.QAPanel)
local EventHUD = require(Modules.EventHUD)
local ChatTags = require(Modules.ChatTags)
local InfectionFX = require(Modules.InfectionFX)
local News = require(Modules.News)
local Graffiti = require(Modules.Graffiti)
local DamageIndicator = require(Modules.DamageIndicator)
local BoostHUD = require(Modules.BoostHUD)
local Minimap = require(Modules.Minimap)
local DominationHUD = require(Modules.DominationHUD)
local BombHUD = require(Modules.BombHUD)
local BotFootsteps = require(Modules.BotFootsteps)
local ScopeGlint = require(Modules.ScopeGlint)
local GrenadeWarning = require(Modules.GrenadeWarning)
local Ambience = require(Modules.Ambience)
local EnemyName = require(Modules.EnemyName)
local RewardFX = require(Modules.RewardFX)
local AimFX = require(Modules.AimFX)
local CombatFX = require(Modules.CombatFX)
local RiflePose = require(Modules.RiflePose)
local Killcam = require(Modules.Killcam)
local AimPitch = require(Modules.AimPitch)
local EnemySounds = require(Modules.EnemySounds)
local Flashlights = require(Modules.Flashlights)
local Callouts = require(Modules.Callouts)
local ZoneName = require(Modules.ZoneName)
local BodyView = require(Modules.BodyView)
local Effects = require(Modules.Effects)

Remotes.DataUpdate.OnClientEvent:Connect(ClientState.SetData)
task.spawn(function()
	local ok, data = pcall(function()
		return Remotes.GetData:InvokeServer()
	end)
	if ok and data and not ClientState.Data then
		ClientState.SetData(data)
	end
end)

-- Arranca cada sistema por separado: si uno falla, se avisa en Output y los demás siguen
local function start(name, fn, ...)
	local ok, err = xpcall(fn, debug.traceback, ...)
	if not ok then
		warn("[Arranque] " .. name .. " falló: " .. tostring(err))
	end
end

start("Settings", Settings.Init)
start("RewardFX", RewardFX.Init)
start("HUD", HUD.Init)
start("Minimap", Minimap.Init)
start("DominationHUD", DominationHUD.Init)
start("BombHUD", BombHUD.Init)
start("BotFootsteps", BotFootsteps.Init)
start("ScopeGlint", ScopeGlint.Init)
start("GrenadeWarning", GrenadeWarning.Init)
start("Ambience", Ambience.Init)
start("EnemyName", EnemyName.Init)
start("AimFX", AimFX.Init)
start("RiflePose", RiflePose.Init)
start("Killcam", Killcam.Init)
start("AimPitch", AimPitch.Init)
start("EnemySounds", EnemySounds.Init)
start("Flashlights", Flashlights.Init)
start("Callouts", Callouts.Init)
start("ZoneName", ZoneName.Init)
start("BodyView", BodyView.Init)
start("CombatFX", function()
	CombatFX.Init()
	Effects.OnConcussion = CombatFX.Concussion
end)
start("Menu", Menu.Init)
start("Movement", Movement.Init)
start("WeaponController", WeaponController.Init)
start("WorldFX", WorldFX.Init)
start("Footprints", Footprints.Init)
start("DeathScreen", DeathScreen.Init)
start("QuestTracker", QuestTracker.Init)
start("Abilities", Abilities.Init)
start("Emotes", Emotes.Init)
start("Scoreboard", Scoreboard.Init)
start("PlaytimeGifts", PlaytimeGifts.Init)
start("SkinFX", SkinFX.Init)
start("JumpPads", JumpPads.Init)
start("Tutorial", Tutorial.Init)
start("Hints", Hints.Init)
start("QAPanel", QAPanel.Init) -- modo QA: solo en Studio con GameConfig.QA.Enabled (si no, no hace nada)
start("EventHUD", EventHUD.Init)
start("ChatTags", ChatTags.Init)
start("InfectionFX", InfectionFX.Init)
start("News", News.Init)
start("Graffiti", Graffiti.Init)
start("DamageIndicator", DamageIndicator.Init)
start("BoostHUD", BoostHUD.Init)
start("VoteUI", VoteUI.Init)
start("GrenadeController", GrenadeController.Init)
start("KillstreakController", KillstreakController.Init)
start("MainMenu", MainMenu.Init) -- la última: muestra la pantalla de inicio
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="136">
          <Properties>
            <string name="Name">Modules</string>
          </Properties>
          <Item class="ModuleScript" referent="137">
            <Properties>
              <string name="Name">Abilities</string>
              <string name="Source"><![CDATA[-- Habilidades con tiempo de recarga (iconos abajo en el centro, también se tocan en móvil):
--   E  Impulso    : acelerón corto hacia donde te mueves (o hacia donde miras)
--   Z  Supersalto : salto muy alto con un poco de impulso hacia delante
--   X  Poción     : cura con el tiempo (la valida el servidor)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local InputMode = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("InputMode"))

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Icons = require(Shared.Icons)
local Remotes = require(Shared.Remotes)
local Sounds = require(Shared.Sounds)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local TouchLayout = require(script.Parent.TouchLayout)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Abilities = {}

local CONFIG = GameConfig.Abilities
local readyAt = { Dash = 0, Jump = 0, Potion = 0 }
local slots = {} -- [nombre] = { Cover, Timer, Frame, WasReady }
local gui
-- En pantallas táctiles las habilidades son botones de TouchLayout (abajo a la izquierda, encima del
-- joystick, con el mismo estilo que los demás) y esta barra no se enseña (Fase 12)
local touchButtons = false

local function getCharacter()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then
		return character, humanoid, root
	end
	return nil
end

local function canUse(name)
	return not ClientState.IsBlocked() and not ClientState.Frozen() and os.clock() >= readyAt[name]
end

-- Estela blanca breve detrás del personaje
local function burst(root, color, count, speed)
	local attachment = Instance.new("Attachment")
	attachment.Parent = root
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	emitter.Color = ColorSequence.new(color)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 3) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(0.3, 0.5)
	emitter.Speed = NumberRange.new(speed * 0.5, speed)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Enabled = false
	emitter.Parent = attachment
	emitter:Emit(count)
	task.delay(1, function()
		attachment:Destroy()
	end)
end

local function dash()
	if not canUse("Dash") or ClientState.Sliding then
		return
	end
	local _, humanoid, root = getCharacter()
	if not humanoid or not root then
		return
	end
	local config = CONFIG.Dash
	local direction = humanoid.MoveDirection
	if direction.Magnitude < 0.1 then
		direction = camera.CFrame.LookVector
	end
	direction = Vector3.new(direction.X, 0, direction.Z)
	if direction.Magnitude < 0.01 then
		return
	end
	direction = direction.Unit
	readyAt.Dash = os.clock() + config.Cooldown

	local attachment = Instance.new("Attachment")
	attachment.Name = "DashAttachment"
	attachment.Parent = root
	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	velocity.PrimaryTangentAxis = Vector3.xAxis
	velocity.SecondaryTangentAxis = Vector3.zAxis
	velocity.MaxForce = 120000
	velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z) * config.Speed
	velocity.Parent = root
	ClientState.Dashing = true
	task.delay(config.Duration, function()
		ClientState.Dashing = false
		velocity:Destroy()
		attachment:Destroy()
	end)
	ClientState.FovKick = 10
	Sounds.Play("Slide")
	burst(root, Color3.fromRGB(235, 245, 255), 14, 12)
end

local function superJump()
	if not canUse("Jump") then
		return
	end
	local _, humanoid, root = getCharacter()
	if not humanoid or not root or humanoid.FloorMaterial == Enum.Material.Air then
		return
	end
	local config = CONFIG.Jump
	readyAt.Jump = os.clock() + config.Cooldown
	local forward = humanoid.MoveDirection
	if forward.Magnitude < 0.1 then
		forward = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
	end
	if forward.Magnitude > 0.01 then
		forward = forward.Unit
	end
	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	local v = root.AssemblyLinearVelocity
	local launch = Vector3.new(v.X + forward.X * config.Forward, config.Power, v.Z + forward.Z * config.Forward)
	root.AssemblyLinearVelocity = launch
	-- Otra vez en el siguiente paso de física: el salto del Humanoid podría pisar la velocidad
	task.defer(function()
		local dt = RunService.Heartbeat:Wait()
		-- (lo esperado tras un paso es Power - gravedad·dt; solo se corrige si quedó muy por debajo)
		if root.Parent and humanoid.Health > 0 and root.AssemblyLinearVelocity.Y < config.Power - workspace.Gravity * dt - 8 then
			root.AssemblyLinearVelocity = launch
		end
	end)
	ClientState.FovKick = 6
	Sounds.Play("Swing")
	burst(root, Color3.fromRGB(170, 220, 255), 18, 8)
end

local function potion()
	if not canUse("Potion") then
		return
	end
	local _, humanoid = getCharacter()
	if not humanoid or humanoid.Health >= humanoid.MaxHealth then
		return
	end
	readyAt.Potion = os.clock() + CONFIG.Potion.Cooldown
	Sounds.Play("Kill")
	task.spawn(function()
		local ok, used = pcall(function()
			return Remotes.UsePotion:InvokeServer()
		end)
		if not ok or not used then
			readyAt.Potion = os.clock() + 1 -- el servidor no la aceptó: se puede reintentar enseguida
		end
	end)
end

local ACTIONS = {
	{ Name = "Dash", Key = "E", Icon = Icons.Dash, Use = dash, Color = Color3.fromRGB(70, 160, 255) },
	{ Name = "Jump", Key = "Z", Icon = Icons.Jump, Use = superJump, Color = Color3.fromRGB(80, 200, 255) },
	{ Name = "Potion", Key = "X", Icon = Icons.Potion, Use = potion, Color = Color3.fromRGB(80, 220, 120) },
}

local function build()
	gui = UI.new("ScreenGui", {
		Name = "Abilities",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local touchOnly = InputMode.TouchUI()
	local SLOT = touchOnly and 78 or 58
	local bar = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -58), -- (por encima del nivel y la barra de XP)
		Size = UDim2.fromOffset(3 * SLOT + 2 * 12, SLOT + 14),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 12),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local scale = UI.new("UIScale", { Parent = bar })
	local function rescale()
		local size = camera.ViewportSize
		scale.Scale = math.clamp(math.min(size.X / 1280, size.Y / 720), 0.65, 1)
	end
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()

	for i, action in ACTIONS do
		-- (estilo de HUD de shooter: fondo oscuro translúcido con el color de la habilidad en el borde y
		-- una franja abajo; en el móvil, más grandes y de color lleno para tocarlas bien)
		local button = UI.button({
			LayoutOrder = i,
			Size = UDim2.fromOffset(SLOT, SLOT),
			Text = "",
			BackgroundColor3 = touchOnly and action.Color or Color3.fromRGB(16, 20, 28),
			BackgroundTransparency = touchOnly and 0 or 0.25,
			AutoButtonColor = true,
			Parent = bar,
		}, { UI.stroke(touchOnly and Color3.new(1, 1, 1) or action.Color, touchOnly and 3 or 2, 0), touchOnly and UI.gloss() or nil })
		if not touchOnly then
			UI.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, 3),
				Size = UDim2.new(1, -14, 0, 3),
				BackgroundColor3 = action.Color,
				BorderSizePixel = 0,
				Parent = button,
			}, { UI.corner(2) })
		end
		if Icons.IsImage(action.Icon) then
			UI.new("ImageLabel", {
				Name = "Icon",
				BackgroundTransparency = 1,
				Image = action.Icon,
				ScaleType = Enum.ScaleType.Fit,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(0.72, 0.72),
				Parent = button,
			})
		else
			UI.label({ Size = UDim2.fromScale(1, 1), Text = action.Icon, TextSize = touchOnly and 40 or 28, Parent = button })
		end
		local cover = UI.new("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.fromScale(1, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.35,
			ZIndex = 2,
			Parent = button,
		}, { UI.corner(8) })
		local timer = UI.label({ Size = UDim2.fromScale(1, 1), Text = "", TextSize = 30, ZIndex = 3, Parent = button })
		local badge = UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 1, 2),
			Size = UDim2.fromOffset(30, 26),
			BackgroundColor3 = Color3.fromRGB(20, 22, 34),
			ZIndex = 4,
			-- (en el móvil no hay teclas: solo se toca el botón)
			Visible = not touchOnly,
			Parent = button,
		}, { UI.corner(6), UI.stroke(Color3.new(1, 1, 1), 2, 0) })
		UI.label({ Size = UDim2.fromScale(1, 1), Text = action.Key, TextSize = 18, ZIndex = 5, Parent = badge })
		button.Activated:Connect(action.Use)
		slots[action.Name] = { Cover = cover, Timer = timer, Frame = button, WasReady = true }
	end
end

local touchLast = {} -- [nombre] = paso de la recarga ya pintado en el botón táctil

local function updateTouch()
	local now = os.clock()
	for _, action in ACTIONS do
		local left = readyAt[action.Name] - now
		local fraction = left <= 0 and 0 or math.clamp(left / CONFIG[action.Name].Cooldown, 0, 1)
		local key = math.ceil(fraction * 50) * 1000 + math.max(0, math.ceil(left))
		if key ~= touchLast[action.Name] then
			touchLast[action.Name] = key
			TouchLayout.SetCooldown("Ability" .. action.Name, fraction, tostring(math.ceil(left)))
		end
	end
end

local function update()
	if touchButtons then
		updateTouch()
		return
	end
	-- (tampoco con el resumen de fin de partida en pantalla: en el móvil lo tapaban)
	gui.Enabled = not ClientState.InMainMenu and not ClientState.Dead and not ClientState.MenuOpen and not ClientState.VotePanelVisible
		and ReplicatedStorage:GetAttribute("State") ~= "Ended"
	local now = os.clock()
	if not gui.Enabled then
		-- (oculto: solo se apunta si ya está lista, para que el salto no salga al volver a mostrarse)
		for _, action in ACTIONS do
			slots[action.Name].WasReady = readyAt[action.Name] - now <= 0
		end
		return
	end
	for _, action in ACTIONS do
		local slot = slots[action.Name]
		local left = readyAt[action.Name] - now
		local ready = left <= 0
		-- (solo se escribe cuando cambia: el contador va por segundos y la barra en pasos de 1/50)
		local fraction = ready and 0 or math.clamp(left / CONFIG[action.Name].Cooldown, 0, 1)
		local step = math.ceil(fraction * 50)
		if step ~= slot.LastStep then
			slot.LastStep = step
			slot.Cover.Size = UDim2.fromScale(1, step / 50)
		end
		local seconds = ready and 0 or math.ceil(left)
		if seconds ~= slot.LastSeconds then
			slot.LastSeconds = seconds
			slot.Timer.Text = ready and "" or tostring(seconds)
		end
		if ready and not slot.WasReady then
			-- Lista otra vez: pequeño salto del icono
			local s = slot.Frame:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = slot.Frame })
			s.Scale = 1.2
			TweenService:Create(s, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
		slot.WasReady = ready
	end
end

function Abilities.Init()
	build()
	local keys = {
		Dash = { Enum.KeyCode.E, Enum.KeyCode.DPadLeft },
		Jump = { Enum.KeyCode.Z, Enum.KeyCode.DPadDown },
		Potion = { Enum.KeyCode.X },
	}
	for _, action in ACTIONS do
		ContextActionService:BindAction("Ability" .. action.Name, function(_, state)
			if state == Enum.UserInputState.Begin then
				action.Use()
			end
			return Enum.ContextActionResult.Pass
		end, false, table.unpack(keys[action.Name]))
		if TouchLayout.BindButton("Ability" .. action.Name, function(_, state)
			if state == Enum.UserInputState.Begin then
				action.Use()
			end
		end) then
			touchButtons = true
		end
	end
	if touchButtons then
		gui.Enabled = false
	end
	-- Al reaparecer, las recargas se mantienen (no se reinician gratis)
	RunService.RenderStepped:Connect(update)
end

return Abilities
]]></string>
