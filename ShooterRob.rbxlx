-- Lanzacohetes tipo RPG: tubo, escudo térmico de madera, cohete y alza
function Classic.NovaLauncher(pt)
	local o = { Aim = pt.AimPoint, Right = pt.RightHand, Left = pt.LeftHand, Muzzle = pt.Muzzle }
	local y = o.Muzzle.Y
	local p = {
		B("Handle", 0, 0, 0, 0.2, 0.2, 0.2, "Body"),
		C("Tube", 0, y, 0.15, 2.4, 0.3, "Body"),
		C("Flare", 0, y, 1.45, 0.4, 0.42, "Body"),
		C("FlareLip", 0, y, 1.66, 0.04, 0.44, "Dark"),
		C("HeatShield", 0, y, -0.05, 0.9, 0.36, "Accent2"),
		C("HeatBandA", 0, y, -0.5, 0.05, 0.38, "Dark"),
		C("HeatBandB", 0, y, 0.4, 0.05, 0.38, "Dark"),
		-- Cohete asomando por delante
		C("RocketNeck", 0, y, -1.15, 0.3, 0.2, "Dark"),
		C("Warhead", 0, y, -1.55, 0.55, 0.46, "Panel"),
		C("WarheadCone", 0, y, -1.98, 0.34, 0.3, "Panel"),
		C("WarheadTip", 0, y, -2.25, 0.25, 0.14, "Dark"),
		C("RocketFins", 0, y, -1.0, 0.06, 0.34, "Dark"),
		B("TriggerHousing", 0, y - 0.2, o.Right.Z - 0.25, 0.1, 0.16, 0.42, "Dark"),
	}
	triggerGroup(p, y - 0.24, o.Right.Z - 0.3)
	pistolGrip(p, o.Right, "Body")
	-- Empuñadura delantera bajo el tubo
	bevelY(p, "Foregrip", 0, (y - 0.15 + o.Left.Y - 0.12) / 2, o.Left.Z, 0.16, (y - 0.15) - (o.Left.Y - 0.12), 0.18, "Body")
	-- Alza plegable y punto de mira
	for _, s in { -1, 1 } do
		table.insert(p, B("RearSightPost", s * 0.065, o.Aim.Y - 0.03, o.Aim.Z - 0.3, 0.045, 0.14, 0.06, "Dark"))
	end
	table.insert(p, B("RearSightBase", 0, (y + 0.15 + o.Aim.Y - 0.1) / 2, o.Aim.Z - 0.3, 0.18, o.Aim.Y - 0.1 - y - 0.15 + 0.02, 0.08, "Dark"))
	table.insert(p, B("FrontSightPost", 0, (y + 0.15 + o.Aim.Y - 0.06) / 2, -0.75, 0.05, o.Aim.Y - 0.06 - y - 0.15, 0.06, "Dark"))
	table.insert(p, B("FrontSightBead", 0, o.Aim.Y - 0.03, -0.75, 0.03, 0.06, 0.04, "Accent"))
	return p
end

-- Pistola de polímero
function Classic.Viper(pt)
	return pistol({ Aim = pt.AimPoint, Right = pt.RightHand, Muzzle = pt.Muzzle, SlideY = 0.05, SlideH = 0.24, SlideBack = 0.55 })
end

-- Pistola táctica con compensador y punto rojo
function Classic.PhantomSidewind(pt)
	return pistol({ Aim = pt.AimPoint, Right = pt.RightHand, Muzzle = pt.Muzzle, SlideY = 0.0, SlideH = 0.26, SlideBack = 0.6, Comp = true, Dot = true })
end

-- Revólver de cañón largo con cachas de madera
function Classic.HandCannon(pt)
	local o = { Aim = pt.AimPoint, Right = pt.RightHand, Muzzle = pt.Muzzle }
	local p = { B("Handle", 0, 0, 0, 0.18, 0.18, 0.18, "Body") }
	bevel(p, "Frame", 0, 0.04, 0.1, 0.24, 0.38, 0.62, "Body", 0.05)
	table.insert(p, C("Cylinder", 0, 0.02, -0.06, 0.4, 0.46, "Body"))
	for i = 0, 5 do
		local a = rad(i * 60)
		table.insert(p, C("CylinderFlute", math.sin(a) * 0.2, 0.02 + math.cos(a) * 0.2, -0.06, 0.3, 0.08, "Dark"))
	end
	bevel(p, "Barrel", 0, 0.08, -0.82, 0.18, 0.22, 1.1, "Body", 0.04)
	table.insert(p, B("TopRib", 0, 0.205, -0.82, 0.09, 0.05, 1.1, "Body"))
	table.insert(p, C("EjectorHousing", 0, -0.08, -0.62, 0.7, 0.1, "Body"))
	table.insert(p, C("Bore", 0, o.Muzzle.Y, o.Muzzle.Z + 0.02, 0.04, 0.12, "Dark"))
	table.insert(p, B("Hammer", 0, 0.17, 0.4, 0.07, 0.12, 0.1, "Metal", -25, 0, 0))
	triggerGroup(p, -0.15, o.Right.Z - 0.32)
	pistolGrip(p, o.Right, "Panel", V(0.22, 0.6, 0.3), 22)
	for _, s in { -1, 1 } do
		table.insert(p, B("RearSightPost", s * 0.055, o.Aim.Y - 0.02, 0.3, 0.04, 0.08, 0.05, "Dark"))
	end
	table.insert(p, B("FrontSightPost", 0, (0.23 + o.Aim.Y - 0.04) / 2, -1.3, 0.04, o.Aim.Y - 0.04 - 0.23, 0.08, "Dark"))
	table.insert(p, B("FrontSightBead", 0, o.Aim.Y - 0.02, -1.3, 0.03, 0.05, 0.06, "Accent"))
	return p
end

-- Marcadora de paintball: cuerpo de color, depósito de bolas arriba a la izquierda (deja libre la
-- línea de mira), cañón largo con bandas, botella de aire detrás y empuñadura delantera
function Classic.SplatX(pt)
	local o = { Aim = pt.AimPoint, Right = pt.RightHand, Left = pt.LeftHand, Muzzle = pt.Muzzle }
	local y = o.Muzzle.Y
	local p = { B("Handle", 0, 0, 0, 0.2, 0.2, 0.2, "Body") }
	bevel(p, "Body", 0, 0.05, 0.05, 0.26, 0.34, 0.9, "Body", 0.06)
	table.insert(p, B("BodyStripe", 0, 0.05, 0.05, 0.27, 0.06, 0.92, "Accent"))
	table.insert(p, C("Barrel", 0, y, (o.Muzzle.Z - 0.4) / 2, -o.Muzzle.Z - 0.4, 0.13, "Dark"))
	for i = 0, 2 do
		table.insert(p, C("BarrelBand", 0, y, -0.65 - i * 0.28, 0.06, 0.16, "Panel"))
	end
	table.insert(p, C("BarrelTip", 0, y, o.Muzzle.Z + 0.06, 0.12, 0.17, "Accent"))
	-- Depósito de bolas con cuello inclinado y bolas asomando
	-- (más a la izquierda y más bajo para no tapar media pantalla al apuntar)
	table.insert(p, B("FeedNeck", -0.24, 0.27, -0.1, 0.1, 0.3, 0.12, "Dark", 0, 0, 50))
	table.insert(p, Ball("Hopper", -0.46, 0.4, -0.1, 0.46, "Accent2"))
	table.insert(p, CY("HopperRing", -0.46, 0.4, -0.1, 0.08, 0.48, "Dark"))
	table.insert(p, CY("HopperLid", -0.46, 0.61, -0.1, 0.06, 0.28, "Dark"))
	-- Bolas de pintura asomando por arriba
	for i, off in { V(-0.07, 0, 0.06), V(0.07, 0.01, -0.03), V(-0.01, 0.03, -0.09) } do
		table.insert(p, Ball("PaintBall" .. i, -0.46 + off.X, 0.68 + off.Y, -0.1 + off.Z, 0.12, "Accent"))
	end
	-- Botella de aire detrás (hace de culata)
	table.insert(p, C("AirTank", 0, -0.02, 0.85, 0.66, 0.26, "Panel"))
	table.insert(p, C("AirTankCap", 0, -0.02, 1.2, 0.06, 0.2, "Metal"))
	table.insert(p, C("Regulator", 0, -0.02, 0.5, 0.12, 0.18, "Metal"))
	triggerGroup(p, -0.12, o.Right.Z - 0.3)
	pistolGrip(p, o.Right, "Rubber")
	-- Empuñadura delantera
	bevelY(p, "Foregrip", 0, (-0.12 + o.Left.Y - 0.1) / 2, o.Left.Z, 0.15, -0.12 - (o.Left.Y - 0.1), 0.17, "Rubber")
	table.insert(p, B("ForegripMount", 0, -0.08, o.Left.Z, 0.12, 0.1, 0.3, "Dark"))
	ironSights(p, o.Aim, 0.3, -1.25, y + 0.065)
	return p
end

-- Katana: mango largo con cinta, tsuba redonda y hoja larga con una leve curva (hacia -Z)
function Classic.Katana(_pt)
	local p = { B("Handle", 0, 0, 0.1, 0.16, 0.2, 0.9, "Rubber") }
	for i = 0, 4 do
		table.insert(p, B("Wrap" .. i, 0, 0, 0.42 - i * 0.16, 0.17, 0.21, 0.05, "Panel", 0, 0, 45))
	end
	table.insert(p, B("Pommel", 0, 0, 0.58, 0.18, 0.22, 0.06, "Dark"))
	table.insert(p, C("Tsuba", 0, 0, -0.38, 0.06, 0.46, "Dark"))
	table.insert(p, B("Habaki", 0, 0.01, -0.45, 0.08, 0.2, 0.1, "Metal"))
	-- Hoja de acero claro (Accent) y filo metálico
	table.insert(p, B("Blade", 0, 0.02, -1.3, 0.05, 0.2, 1.7, "Accent"))
	table.insert(p, B("BladeTip", 0, 0.07, -2.38, 0.05, 0.18, 0.5, "Accent", 8, 0, 0))
	table.insert(p, B("Point", 0, 0.12, -2.68, 0.05, 0.1, 0.18, "Accent", 30, 0, 0))
	table.insert(p, B("Edge", 0, -0.06, -1.3, 0.055, 0.04, 1.66, "Metal"))
	return p
end

-- Martillo de juguete (de los que pitan): mango de rayas y cabeza grande de colores
function Classic.ToyHammer(_pt)
	local p = { B("Handle", 0, 0, 0.0, 0.18, 0.18, 1.0, "Panel") }
	for i = 0, 2 do
		table.insert(p, C("HandleStripe" .. i, 0, 0, 0.3 - i * 0.3, 0.1, 0.2, "Accent2"))
	end
	table.insert(p, C("Grip", 0, 0, 0.45, 0.3, 0.22, "Rubber"))
	table.insert(p, CX("Head", 0, 0, -0.75, 1.0, 0.62, "Body"))
	for _, x in { -0.52, 0.52 } do
		table.insert(p, CX("HeadCap", x, 0, -0.75, 0.08, 0.66, "Accent"))
	end
	table.insert(p, CX("HeadBand", 0, 0, -0.75, 0.16, 0.64, "Accent2"))
	return p
end

-- Guadaña (Halloween): mango largo de madera oscura con anillas y una hoja curva que sale hacia
-- un lado en la punta y se curva hacia el mango, con el filo morado brillante por dentro
function Classic.Scythe(_pt)
	local p = {
		B("Handle", 0, 0, -0.35, 0.13, 0.13, 2.3, "Body"),
		B("Grip", 0, 0, 0.55, 0.16, 0.16, 0.5, "Rubber"),
		B("Pommel", 0, 0, 0.85, 0.2, 0.2, 0.12, "Dark"),
	}
	for i, z in { -0.2, -1.1 } do
		table.insert(p, B("ShaftRing" .. i, 0, 0, z, 0.17, 0.17, 0.08, "Accent2"))
	end
	table.insert(p, B("BladeMount", 0, 0, -1.55, 0.2, 0.22, 0.2, "Dark"))
	-- Hoja: tramos cada vez más girados (curva hacia +X y hacia atrás)
	local x, z, angle = 0.1, -1.55, 0
	for i = 1, 5 do
		local length = 0.42 - i * 0.03
		local rad = math.rad(angle)
		local cx, cz = x + math.cos(rad) * length / 2, z - math.sin(rad) * length / 2
		table.insert(p, B("Blade" .. i, cx, 0, cz, length, 0.05, 0.3 - i * 0.035, "Accent", 0, angle, 0))
		table.insert(p, B("BladeEdge" .. i, cx + math.sin(rad) * (0.15 - i * 0.017), 0, cz + math.cos(rad) * (0.15 - i * 0.017), length, 0.055, 0.04, "Accent2", 0, angle, 0))
		x, z = x + math.cos(rad) * length, z - math.sin(rad) * length
		angle -= 16
	end
	return p
end

-- Calabazooka (evento de Halloween): el lanzacohetes con una calabaza con cara como proyectil
function Classic.Calabazooka(pt)
	local p = {}
	for _, part in Classic.NovaLauncher(pt) do
		if part.Name ~= "Warhead" and part.Name ~= "WarheadCone" and part.Name ~= "WarheadTip" and part.Name ~= "RocketFins" then
			table.insert(p, part)
		end
	end
	local y = pt.Muzzle.Y
	table.insert(p, C("PumpkinNeck", 0, y, -1.5, 0.4, 0.16, "Dark"))
	table.insert(p, Ball("Pumpkin", 0, y, -1.95, 0.62, "Panel"))
	table.insert(p, C("PumpkinStem", 0, y + 0.34, -1.95, 0.06, 0.08, "Accent2"))
	table.insert(p, B("PumpkinStemTop", 0, y + 0.38, -1.95, 0.06, 0.14, 0.06, "Accent2"))
	for _, x in { -0.11, 0.11 } do
		table.insert(p, B("PumpkinEye", x, y + 0.08, -2.24, 0.1, 0.09, 0.04, "Accent", 0, 0, x > 0 and 20 or -20))
	end
	table.insert(p, B("PumpkinMouth", 0, y - 0.1, -2.24, 0.26, 0.06, 0.04, "Accent"))
	return p
end

-- Garras de zombi (modo Infección): mano verde con tres uñas de hueso largas y curvas
function Classic.Claws(_pt)
	local p = {
		B("Handle", 0, 0, 0.15, 0.34, 0.26, 0.5, "Body"),
		B("Wrist", 0, -0.02, 0.48, 0.3, 0.24, 0.2, "Dark"),
		B("Knuckles", 0, 0.06, -0.12, 0.4, 0.2, 0.16, "Body"),
	}
	for i, x in { -0.13, 0, 0.13 } do
		local spread = (i - 2) * 6
		table.insert(p, B("ClawBase" .. i, x, 0.06, -0.38, 0.07, 0.09, 0.4, "Accent", -6, spread, 0))
		table.insert(p, B("ClawTip" .. i, x * 1.25, 0.0, -0.72, 0.05, 0.07, 0.34, "Accent", -22, spread, 0))
		table.insert(p, B("Blood" .. i, x * 1.3, -0.04, -0.86, 0.055, 0.06, 0.1, "Accent2", -22, spread, 0))
	end
	return p
end

-- Puntos que cambian respecto al diseño original (el lanzacohetes se coge por el tubo, no por el cohete)
-- Ballesta: culata y cuerpo de madera, arco de metal con su cuerda, virote con punta roja y
-- estribo delante. Sin cargador (un virote cada vez).
function Classic.Crossbow(pt)
	local o = { Aim = pt.AimPoint, Right = pt.RightHand, Left = pt.LeftHand, Muzzle = pt.Muzzle }
	local y = o.Muzzle.Y
	local p = rifle({
		Aim = o.Aim, Right = o.Right, Left = o.Left, Muzzle = o.Muzzle,
		RecRear = 0.55, RecFront = -0.35, RecY = 0.0, RecH = 0.3, RecW = 0.24, RecRole = "Body", RailTop = false,
		HgFront = -1.45, HgH = 0.22, HgW = 0.22, HgY = -0.02, HgRole = "Body",
		BarrelD = 0.05, Stock = "Wood", StockRole = "Body", StockLen = 0.8,
		GripRole = "Body", Foregrip = false,
	})
	-- Arco: dos palas inclinadas hacia atrás desde la punta
	local prodZ = -1.3
	for _, s in { -1, 1 } do
		table.insert(p, B("BowLimb", s * 0.52, y + 0.02, prodZ + 0.13, 0.98, 0.08, 0.11, "Panel", 0, s * -14, 0))
		table.insert(p, B("BowTip", s * 0.99, y + 0.02, prodZ + 0.26, 0.06, 0.12, 0.08, "Dark"))
		-- Cuerda tensa hasta la nuez (detrás, sobre el cuerpo)
		local tip = V(s * 0.99, y + 0.02, prodZ + 0.26)
		local nut = V(s * 0.04, y + 0.04, -0.15)
		local mid = (tip + nut) / 2
		local len = (tip - nut).Magnitude
		local yaw = math.deg(math.atan2(tip.X - nut.X, tip.Z - nut.Z))
		table.insert(p, B("BowString", mid.X, mid.Y, mid.Z, 0.025, 0.025, len, "Dark", 0, yaw, 0))
	end
	table.insert(p, B("BowRiser", 0, y + 0.02, prodZ, 0.26, 0.14, 0.14, "Panel"))
	-- Virote cargado: varilla, punta roja y plumas
	table.insert(p, C("Bolt", 0, y + 0.1, -0.85, 1.3, 0.04, "Dark"))
	table.insert(p, B("BoltTip", 0, y + 0.1, -1.53, 0.07, 0.07, 0.12, "Accent", 45, 0, 0))
	for _, s in { -1, 1 } do
		table.insert(p, B("BoltFletch", s * 0.035, y + 0.11, -0.28, 0.01, 0.06, 0.16, "Accent"))
	end
	-- Estribo delante (para tensar)
	table.insert(p, B("StirrupL", -0.12, y - 0.12, prodZ - 0.12, 0.03, 0.2, 0.03, "Panel"))
	table.insert(p, B("StirrupR", 0.12, y - 0.12, prodZ - 0.12, 0.03, 0.2, 0.03, "Panel"))
	table.insert(p, B("StirrupBottom", 0, y - 0.22, prodZ - 0.12, 0.27, 0.03, 0.03, "Panel"))
	ironSights(p, o.Aim, 0.35, -1.0, y + 0.06)
	return p
end

Classic.Points = {
	NovaLauncher = { LeftHand = V(0, -0.4, -0.7) },
	Calabazooka = { LeftHand = V(0, -0.4, -0.7) },
}

return Classic
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">WeaponFeel</string>
          <string name="Source"><![CDATA[-- Sensación de las armas (gunplay): perfiles por tipo de arma con todo lo que se puede ajustar de cómo
-- se SIENTE disparar, sin tocar lo que decide el combate. Lo usan WeaponController (retroceso, ADS,
-- balanceo, sprint, sacar el arma) y Effects (fogonazo, casquillos, impactos según la calidad).
--
-- Tres retrocesos separados (Fase 2):
--   · De juego (Gameplay): dispersión, apertura de la mira y subida de la mira que hay que controlar.
--     Sale del `Recoil` de cada arma en Weapons.luau y es IGUAL para todos los perfiles: cambiarlo es
--     cambiar el equilibrio del juego.
--   · De cámara (Camera): un golpe visual que se recupera del todo y NO cambia dónde van las balas
--     (WeaponController lo descuenta al apuntar el disparo). Comunica la potencia del arma.
--   · Del arma en la mano (View): muelles del viewmodel. Hace que el arma se sienta física.
--
-- Los cosméticos (skins, camuflajes, colgantes) nunca pasan por aquí: WeaponFeel.Get solo recibe el
-- nombre del arma.
local WeaponFeel = {}

-- Arma de referencia (el "estándar de oro"): el fusil de asalto con el que se ajustó todo lo demás
WeaponFeel.ReferenceWeapon = "ARX27"

-- Retroceso de juego (igual para todas las armas; los valores son los de antes de la Fase 2)
WeaponFeel.Gameplay = {
	ClimbBase = 0.75, -- la mira sube Recoil × (ClimbBase + ClimbGrowth × min(disparos, ClimbShots) / ClimbShots)
	ClimbGrowth = 0.5,
	ClimbShots = 6,
	Drift = 0.45, -- desvío lateral con patrón propio de cada arma (se aprende a controlar)
	DriftNoise = 0.25, -- y algo de azar
	DriftDelay = 3, -- los primeros disparos de la ráfaga casi no se desvían de lado
	AimReduction = 0.35, -- apuntando, el retroceso de juego baja un 35 %
	ApplySpeed = 22, -- lo rápido que se aplica la subida a la cámara
	Recover = 0.65, -- parte de la subida que la mira recupera sola al soltar el gatillo
	RecoverSpeed = 7,
	BloomPerRecoil = 0.4, -- apertura de la mira por disparo (× Recoil)
	BloomMax = 6,
}

-- Perfil base (el del fusil de asalto). Los demás perfiles solo dicen lo que cambia.
local BASE = {
	Camera = {
		Punch = 0.3, -- grados que sube la cámara en cada disparo (se recupera del todo)
		PunchSide = 0.1, -- grados de giro lateral al azar
		PunchRoll = 0.35, -- grados de alabeo
		Stiffness = 320, -- muelle de la recuperación
		Damping = 30,
		AimScale = 0.55, -- apuntando, el golpe de cámara es menor
		Shake = 0, -- temblor por disparo (× Recoil); 0 = sin temblor
		FovKick = 0, -- empujón de campo de visión por disparo (× Recoil)
		Impulse = 0, -- (lo calcula WeaponFeel.Get a partir del muelle)
	},
	View = {
		Back = 1, -- multiplicadores del golpe del arma (que sale del Recoil del arma)
		Rise = 1,
		Side = 1,
		Stiffness = 260, -- muelles: hacia atrás, giro hacia arriba y lado
		Damping = 24,
		RotStiffness = 220,
		RotDamping = 20,
		SideStiffness = 180,
		SideDamping = 18,
		AimScale = 0.5, -- apuntando, el arma se mueve la mitad
	},
	Aim = {
		Speed = 14, -- rapidez al apuntar (más alto = más rápido; 14 ≈ 0,2 s)
		Sway = 0.25, -- inercia del ratón que queda al apuntar (0 = nada, 1 = como de cadera)
		Bob = 0.1, -- balanceo al andar que queda al apuntar
	},
	Sway = { Amount = 1 }, -- inercia del arma al mover el ratón
	Bob = { Walk = 1, Sprint = 1 }, -- balanceo al andar y al correr
	Sprint = {
		Fov = 6, -- grados más de campo de visión corriendo
		Speed = 10, -- rapidez al entrar y salir del sprint (salir rápido = disparar antes)
	},
	Equip = { Time = 0.4 }, -- lo que dura la animación de sacar el arma (no cambia cuándo se puede disparar)
	Flash = {
		Scale = 1, -- tamaño del fogonazo
		Duration = 0.04, -- segundos (0,03-0,08)
		Light = 1, -- intensidad del golpe de luz (0 = sin luz, p. ej. con supresor)
		Smoke = 1, -- humo del fogonazo
	},
	Shells = { Enabled = true, Color = nil :: Color3? }, -- casquillos (cosmético local)
	Heat = { PerShot = 1 }, -- calor del cañón por disparo (con calor sale humo al parar)
}

WeaponFeel.Profiles = {
	Rifle = {},
	Pistol = {
		Camera = { Punch = 0.45, PunchSide = 0.15, PunchRoll = 0.5, Stiffness = 380, Damping = 32 },
		View = { Rise = 1.15, Stiffness = 300, Damping = 26, RotStiffness = 260, RotDamping = 22 },
		Aim = { Speed = 17 },
		Sprint = { Speed = 13 },
		Equip = { Time = 0.32 },
		Flash = { Scale = 0.8, Duration = 0.035 },
		Sway = { Amount = 1.1 },
	},
	SMG = {
		Camera = { Punch = 0.18, PunchSide = 0.14, PunchRoll = 0.25 },
		View = { Back = 0.9, Rise = 0.8, Side = 1.3, Stiffness = 300, Damping = 24 },
		Aim = { Speed = 16 },
		Sprint = { Speed = 12 },
		Equip = { Time = 0.35 },
		Flash = { Scale = 0.75, Duration = 0.03 },
		Sway = { Amount = 1.1 },
		Bob = { Walk = 1.15, Sprint = 1.1 },
	},
	LMG = {
		Camera = { Punch = 0.25, PunchSide = 0.08, PunchRoll = 0.3, Stiffness = 260, Damping = 28 },
		View = { Back = 1.15, Rise = 0.8, Side = 0.7, Stiffness = 200, Damping = 22, RotStiffness = 180, RotDamping = 19 },
		Aim = { Speed = 11 },
		Sprint = { Speed = 7 },
		Equip = { Time = 0.5 },
		Flash = { Scale = 1.1, Duration = 0.045 },
		Sway = { Amount = 0.8 },
		Bob = { Walk = 0.8, Sprint = 0.85 },
	},
	Shotgun = {
		Camera = { Punch = 1.0, PunchSide = 0.25, PunchRoll = 1.2, Stiffness = 220, Damping = 24, Shake = 0.05, FovKick = 0.22 },
		View = { Back = 1.25, Rise = 1.1, Side = 0.8, Stiffness = 220, Damping = 20 },
		Equip = { Time = 0.42 },
		Flash = { Scale = 1.4, Duration = 0.06, Smoke = 1.5 },
		Shells = { Color = Color3.fromRGB(220, 50, 50) },
		Heat = { PerShot = 4 },
	},
	Marksman = {
		Camera = { Punch = 0.6, PunchSide = 0.12, PunchRoll = 0.6, Stiffness = 260, Damping = 26 },
		View = { Back = 1.1, Rise = 1.1, Side = 0.6, Stiffness = 240, Damping = 22 },
		Aim = { Speed = 13 },
		Equip = { Time = 0.42 },
		Flash = { Scale = 1.15, Duration = 0.05 },
	},
	Sniper = {
		Camera = { Punch = 1.2, PunchSide = 0.2, PunchRoll = 1.0, Stiffness = 200, Damping = 22, Shake = 0.05, FovKick = 0.22 },
		View = { Back = 1.2, Side = 0.5, Stiffness = 200, Damping = 20 },
		Aim = { Speed = 12 },
		Sprint = { Speed = 8 },
		Equip = { Time = 0.48 },
		Flash = { Scale = 1.5, Duration = 0.07, Smoke = 1.5 },
		Sway = { Amount = 0.9 },
		Heat = { PerShot = 4 },
	},
	Launcher = {
		Camera = { Punch = 1.0, PunchSide = 0.2, PunchRoll = 0.8, Stiffness = 200, Damping = 22, Shake = 0.05, FovKick = 0.22 },
		View = { Back = 1.2, Side = 0.5, Stiffness = 180, Damping = 20 },
		Aim = { Speed = 12 },
		Sprint = { Speed = 8 },
		Equip = { Time = 0.5 },
		Flash = { Scale = 1.6, Duration = 0.08, Light = 1.2 },
		Shells = { Enabled = false },
		Heat = { PerShot = 0 },
	},
	Melee = {
		Equip = { Time = 0.35 },
		Shells = { Enabled = false },
		Heat = { PerShot = 0 },
	},
}

-- Tipo de cada arma (las que no están aquí se deducen de su categoría)
WeaponFeel.ClassOf = {
	ARX27 = "Rifle",
	VortexBR = "Rifle",
	Specter9 = "SMG",
	NovaDrift = "SMG",
	SplatX = "SMG",
	TitanLMG = "LMG",
	HavocPump = "Shotgun",
	BreachHammer = "Shotgun",
	RaptorDMR = "Marksman",
	Crossbow = "Marksman",
	Signal7 = "Sniper",
	GhostlineXR = "Sniper",
	Viper = "Pistol",
	PhantomSidewind = "Pistol",
	HandCannon = "Pistol",
	NovaLauncher = "Launcher",
	Calabazooka = "Launcher",
}

-- Ajustes de un arma concreta encima de su perfil
WeaponFeel.Overrides = {
	-- Revólver: pistola pesada (como antes, sacude la cámara como las armas potentes)
	HandCannon = {
		Camera = { Punch = 0.8, PunchRoll = 0.8, Shake = 0.05, FovKick = 0.22 },
		View = { Back = 1.2, Rise = 1.3 },
		Flash = { Scale = 1.1, Duration = 0.05 },
	},
	-- Con supresor: fogonazo mínimo y sin golpe de luz
	GhostlineXR = { Flash = { Scale = 0.35, Duration = 0.03, Light = 0, Smoke = 0.5 } },
	-- Ballesta y paintball: ni casquillos ni humo de pólvora
	Crossbow = { Shells = { Enabled = false }, Heat = { PerShot = 0 }, Flash = { Scale = 0, Light = 0, Smoke = 0 } },
	SplatX = { Shells = { Enabled = false }, Heat = { PerShot = 0 }, Flash = { Scale = 0.4, Light = 0.3, Smoke = 0.3 } },
}

local CATEGORY_CLASS = {
	["Fusil de asalto"] = "Rifle",
	["Fusil de energía"] = "Rifle",
	Subfusil = "SMG",
	["Ametralladora pesada"] = "LMG",
	Escopeta = "Shotgun",
	["Escopeta pesada"] = "Shotgun",
	["Fusil de tirador"] = "Marksman",
	Francotirador = "Sniper",
	Pistola = "Pistol",
	["Pistola táctica"] = "Pistol",
	["Revólver"] = "Pistol",
	Lanzacohetes = "Launcher",
	["Cuerpo a cuerpo"] = "Melee",
}

-- Tipo de un arma: por nombre, si no por su categoría y, si no, fusil
function WeaponFeel.Class(weaponName: string?, def: any?): string
	local class = weaponName and WeaponFeel.ClassOf[weaponName]
	if class then
		return class
	end
	if def then
		if def.Type == "Melee" then
			return "Melee"
		end
		class = def.Category and CATEGORY_CLASS[def.Category]
		if class then
			return class
		end
		if def.Explosive then
			return "Launcher"
		elseif (def.Pellets or 1) > 1 then
			return "Shotgun"
		end
	end
	return "Rifle"
end

-- Copia `base` con los valores de `extra` encima (por secciones)
local function merge(base, extra)
	local out = {}
	for section, values in base do
		local copy = table.clone(values)
		local over = extra and extra[section]
		if over then
			for key, value in over do
				copy[key] = value
			end
		end
		out[section] = copy
	end
	return out
end

local cache = {}

-- Un paso de muelle amortiguado con la solución EXACTA (no por aproximación): el resultado es el
-- mismo a 30, 60 o 240 fps, así que el golpe se siente igual en cualquier dispositivo. Devuelve la
-- posición y la velocidad nuevas.
function WeaponFeel.StepSpring(x: number, v: number, stiffness: number, damping: number, dt: number): (number, number)
	local w0 = math.sqrt(stiffness)
	local zeta = math.min(damping / (2 * w0), 0.999) -- (los perfiles son subamortiguados)
	local wd = w0 * math.sqrt(1 - zeta * zeta)
	local decay = math.exp(-zeta * w0 * dt)
	local c, s = math.cos(wd * dt), math.sin(wd * dt)
	local newX = decay * (x * c + (v + zeta * w0 * x) / wd * s)
	local newV = decay * (v * c - (zeta * w0 * v + w0 * w0 * x) / wd * s)
	return newX, newV
end

-- Velocidad inicial del muelle para que el golpe llegue a 1 radián de pico (fórmula exacta del
-- máximo). Así `Punch` son de verdad los grados que sube la cámara.
local function punchImpulse(stiffness: number, damping: number): number
	local w0 = math.sqrt(stiffness)
	local zeta = math.min(damping / (2 * w0), 0.999)
	local wd = w0 * math.sqrt(1 - zeta * zeta)
	local peakTime = math.atan2(wd, zeta * w0) / wd
	local peakPerVelocity = math.exp(-zeta * w0 * peakTime) * math.sin(wd * peakTime) / wd
	return peakPerVelocity > 0 and 1 / peakPerVelocity or 0
end

-- Perfil completo de un arma (perfil base + su tipo + sus ajustes). No depende de la skin.
function WeaponFeel.Get(weaponName: string?, def: any?)
	local key = weaponName or ""
	local cached = cache[key]
	if cached then
		return cached
	end
	local class = WeaponFeel.Class(weaponName, def)
	local profile = merge(BASE, WeaponFeel.Profiles[class])
	local override = weaponName and WeaponFeel.Overrides[weaponName]
	if override then
		profile = merge(profile, override)
	end
	profile.Class = class
	profile.Camera.Impulse = punchImpulse(profile.Camera.Stiffness, profile.Camera.Damping)
	cache[key] = profile
	return profile
end

-- Para las pruebas (y si se cambian perfiles en caliente)
function WeaponFeel.ClearCache()
	table.clear(cache)
end

-- Presupuesto de efectos por calidad gráfica (Ajustes → Calidad; "Auto" ya resuelto). Nunca toca el
-- hitmarker, los avisos de baja ni los impactos sobre personas: eso es información de juego.
WeaponFeel.Quality = {
	Baja = {
		Shells = false, -- casquillos
		BulletMarks = 0, -- marcas de bala visibles a la vez (0 = sin marcas)
		ImpactParticles = 0.4, -- partículas de los impactos en el escenario (× las normales)
		FlashParticles = 0.5, -- partículas del fogonazo
		MuzzleSmoke = false, -- humo del fogonazo
		BarrelSmoke = false, -- humo del cañón caliente
		MuzzleLight = false, -- golpe de luz del fogonazo (Fase 9: una luz por disparo cuesta en móviles modestos)
	},
	Media = {
		Shells = true,
		BulletMarks = 30,
		ImpactParticles = 0.75,
		FlashParticles = 1,
		MuzzleSmoke = true,
		BarrelSmoke = true,
		MuzzleLight = true,
	},
	Alta = {
		Shells = true,
		BulletMarks = 50,
		ImpactParticles = 1,
		FlashParticles = 1,
		MuzzleSmoke = true,
		BarrelSmoke = true,
		MuzzleLight = true,
	},
}
WeaponFeel.Quality.Ultra = WeaponFeel.Quality.Alta

-- En móvil (pantalla táctil sin teclado), aunque la calidad sea alta, se recorta lo que más cuesta
WeaponFeel.MobileCap = {
	Shells = false,
	BulletMarks = 20,
	ImpactParticles = 0.6,
}

function WeaponFeel.Budget(quality: string?, mobile: boolean?)
	local budget = table.clone(WeaponFeel.Quality[quality or "Media"] or WeaponFeel.Quality.Media)
	if mobile then
		local cap = WeaponFeel.MobileCap
		budget.Shells = budget.Shells and cap.Shells
		budget.BulletMarks = math.min(budget.BulletMarks, cap.BulletMarks)
		budget.ImpactParticles = math.min(budget.ImpactParticles, cap.ImpactParticles)
	end
	return budget
end

return WeaponFeel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">WeaponModels</string>
          <string name="Source"><![CDATA[-- Construye los modelos de las armas a partir de las piezas de WeaponDesigns.
-- Lo usan el servidor (Tool que ven los demás) y el cliente (viewmodel e iconos 3D).
--
-- Colores: con la skin "Default" cada arma usa su propia paleta de fábrica (def.Palette);
-- con cualquier otra skin, todas las armas usan los colores de esa skin.
local Weapons = require(script.Parent.Weapons)
local Skins = require(script.Parent.Skins)
local Charms = require(script.Parent.Charms)
local WeaponVisual = require(script.Parent.WeaponVisual)

local WeaponModels = {}

-- Texturas de partículas que vienen incluidas con Roblox
local SPARKLE_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE_TEXTURE = "rbxasset://textures/particles/fire_main.dds"

local WHITE = Color3.new(1, 1, 1)

-- Paleta efectiva para un arma y una skin
function WeaponModels.GetPalette(weaponName, skinId)
	local def = Weapons.Get(weaponName)
	if (skinId == nil or skinId == "Default") and def and def.Palette then
		return def.Palette
	end
	return Skins.Get(skinId)
end

-- Camuflaje con imagen: solo si su MaterialVariant existe (si no, se usan los colores de respaldo)
local MaterialService = game:GetService("MaterialService")
local function camoVariant(pal)
	if not pal.Camo then
		return nil
	end
	local name = "Camo" .. pal.Camo
	return MaterialService:FindFirstChild(name) and name or nil
end

-- Skins arcoíris (pal.Rainbow = { Accent = true, ... }): las piezas de esos papeles llevan la etiqueta
-- "RainbowSkin" y el cliente (SkinFX) les va cambiando el color. Las etiquetas se replican.
local rainbowPhase = 0
local function setRainbow(part, role, pal)
	if pal.Rainbow and pal.Rainbow[role or "Body"] then
		rainbowPhase = (rainbowPhase + 0.09) % 1
		part:SetAttribute("RainbowPhase", rainbowPhase)
		part:SetAttribute("RainbowSat", pal.RainbowSat or 1)
		part:SetAttribute("RainbowVal", pal.RainbowVal or 1)
		part:AddTag("RainbowSkin")
	elseif part:HasTag("RainbowSkin") then
		part:RemoveTag("RainbowSkin")
	end
end

local function paint(part, role, pal)
	setRainbow(part, role, pal)
	part.Transparency = 0
	part.Reflectance = 0
	part.MaterialVariant = ""
	if role == "Accent" then
		part.Color = pal.Accent
		part.Material = pal.AccentMaterial or Enum.Material.Neon
	elseif role == "Accent2" then
		part.Color = pal.Accent2 or pal.Accent
		part.Material = pal.Accent2Material or Enum.Material.Neon
	elseif role == "Panel" then
		part.Color = pal.Panel or (pal.Accent2 or pal.Body:Lerp(WHITE, 0.6))
		part.Material = pal.PanelMaterial or Enum.Material.Plastic
	elseif role == "Dark" then
		part.Color = pal.Dark
		part.Material = Enum.Material.Metal
		part.Reflectance = pal.DarkSheen or 0
	elseif role == "Metal" then
		part.Color = Color3.fromRGB(200, 202, 210)
		part.Material = Enum.Material.Metal
		part.Reflectance = 0.15
	elseif role == "Rubber" then
		part.Color = pal.Rubber or Color3.fromRGB(28, 28, 32)
		part.Material = Enum.Material.Rubber -- empuñaduras y culatas de goma
	elseif role == "Gold" then
		part.Color = Color3.fromRGB(240, 180, 60)
		part.Material = Enum.Material.Foil
	elseif role == "Shell" then
		part.Color = Color3.fromRGB(200, 30, 35)
		part.Material = Enum.Material.SmoothPlastic
	elseif role == "Core" then
		part.Color = (pal.Accent2 or pal.Accent):Lerp(pal.Accent, 0.5)
		part.Material = Enum.Material.Neon
		part.Transparency = 0.15
	elseif role == "Reticle" then
		-- Punto rojo de las miras: siempre brilla
		part.Color = Color3.fromRGB(255, 40, 40)
		part.Material = Enum.Material.Neon
	elseif role == "Trim" then
		-- Ribete (Fase 9): con el acabado de fábrica es metal oscuro; con una skin, su color de acento
		-- (así una skin se nota en el arma clásica, que casi no tiene piezas de acento)
		if pal.TrimAccent then
			part.Color = pal.Accent
			part.Material = pal.AccentMaterial or Enum.Material.Neon
		else
			part.Color = pal.Dark
			part.Material = Enum.Material.Metal
		end
	elseif role == "Lens" then
		part.Color = pal.Lens or pal.Accent:Lerp(WHITE, 0.35)
		part.Material = Enum.Material.Glass
		part.Transparency = 0.45
		part.Reflectance = 0.3
	else
		part.Color = pal.Body
		-- Polímero con textura fina (el plástico liso parecía de juguete)
		part.Material = pal.BodyMaterial or Enum.Material.Plastic
		part.Reflectance = pal.Sheen or 0
	end
	-- Cuerpo y paneles con la imagen del camuflaje (el color blanco no la tiñe)
	if role == "Body" or role == "Panel" or role == nil then
		local variant = camoVariant(pal)
		if variant then
			part.Material = Enum.Material.Plastic
			part.MaterialVariant = variant
			part.Color = role == "Panel" and Color3.fromRGB(205, 205, 205) or WHITE
		end
	end
end

-- Partículas de la skin (destellos o llamas) alrededor del arma
local function applyEffects(container, pal)
	for _, inst in container:GetDescendants() do
		if inst:IsA("ParticleEmitter") and inst.Name == "SkinFX" then
			inst:Destroy()
		end
	end
	local handle = container:FindFirstChild("Handle")
	if not handle or not pal.Effect then
		return
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "SkinFX"
	emitter.LockedToPart = true
	emitter.LightEmission = 1
	emitter.SpreadAngle = Vector2.new(180, 180)
	if pal.Effect == "Flame" then
		emitter.Texture = FIRE_TEXTURE
		emitter.Color = ColorSequence.new(pal.Accent, pal.Accent2 or pal.Accent)
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0) })
		emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
		emitter.Lifetime = NumberRange.new(0.25, 0.45)
		emitter.Speed = NumberRange.new(0.3, 0.8)
		emitter.Acceleration = Vector3.new(0, 2.5, 0)
		emitter.Rate = 14
	else
		emitter.Texture = SPARKLE_TEXTURE
		emitter.Color = ColorSequence.new(pal.Accent, pal.Accent2 or WHITE)
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.3, 0.16),
			NumberSequenceKeypoint.new(1, 0),
		})
		emitter.Lifetime = NumberRange.new(0.4, 0.8)
		emitter.Speed = NumberRange.new(0.1, 0.4)
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.RotSpeed = NumberRange.new(-90, 90)
		emitter.Rate = 7
	end
	emitter.Parent = handle
end

-- Texto (nombre del arma) en los dos costados de una pieza
local function addLabel(part, text, pal)
	for _, face in { Enum.NormalId.Right, Enum.NormalId.Left } do
		local gui = Instance.new("SurfaceGui")
		gui.Name = "Label"
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 300
		gui.LightInfluence = 0.3
		gui.Parent = part
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.Text = text
		label.TextColor3 = Color3.fromRGB(240, 240, 245)
		label.TextStrokeTransparency = 0.6
		label.Parent = gui
	end
end

-- Pinta todas las piezas de un arma (Model o Tool) con la skin indicada.
function WeaponModels.ApplySkin(container, skinId, weaponName)
	weaponName = weaponName or container:GetAttribute("Weapon") or container.Name
	local pal = WeaponModels.GetPalette(weaponName, skinId)
	for _, part in container:GetDescendants() do
		if part:IsA("BasePart") then
			local role = part:GetAttribute("Role")
			if role then
				paint(part, role, pal)
			end
		end
	end
	applyEffects(container, pal)
end

-- Devuelve un Model con PrimaryPart = Handle. Las piezas van soldadas al Handle.
-- withEffects = false para no añadir partículas (por ejemplo en iconos).
-- Punto del que cuelga el colgante: borde inferior del lado izquierdo del cuerpo del arma (el que se
-- ve en primera persona), un poco delante de la empuñadura. Se calcula con las piezas del diseño
-- para que quede por fuera en todas las armas.
function WeaponModels.CharmPoint(def)
	local grip = def.RightHand or Vector3.new(0, -0.4, 0.2)
	local z = grip.Z - 0.28
	local minX, minY = math.huge, math.huge
	for _, spec in def.Parts or {} do
		local p = spec.CFrame.Position
		-- Piezas del cuerpo (por encima de la empuñadura) a la altura de ese punto
		if p.Y > grip.Y + 0.2 and math.abs(p.Z - z) < 0.45 then
			minX = math.min(minX, p.X - spec.Size.X / 2)
			minY = math.min(minY, p.Y - spec.Size.Y / 2)
		end
	end
	if minX == math.huge then
		return CFrame.new(-0.15, grip.Y + 0.4, z)
	end
	return CFrame.new(minX - 0.03, minY + 0.04, z)
end

-- Modelo 3D externo de un arma (WeaponVisual.Weapons[arma].Model = "Nombre" → plantilla en
-- ReplicatedStorage.WeaponViewModels). nil si no hay o no cumple los requisitos (entonces se usan las
-- piezas de siempre y se avisa en la Output).
local warned = {}
function WeaponModels.ExternalTemplate(weaponName)
	local entry = WeaponVisual.Weapons[weaponName]
	local name = entry and entry.Model
	if type(name) ~= "string" or name == "" then
		return nil
	end
	local folder = game:GetService("ReplicatedStorage"):FindFirstChild("WeaponViewModels")
	local template = folder and folder:FindFirstChild(name)
	local missing = WeaponVisual.ValidateModel(template)
	if #missing == 0 then
		return template
	end
	if not warned[name] then
		warned[name] = true
		warn("[WeaponModels] El modelo «" .. name .. "» de " .. tostring(weaponName) .. " no se usa (falta: " .. table.concat(missing, ", ") .. "): se usan las piezas de siempre")
	end
	return nil
end

local function buildFromTemplate(template, weaponName, def, pal, withEffects, charmId, scale)
	local model = template:Clone()
	model.Name = weaponName
	if scale ~= 1 then
		pcall(function()
			model:ScaleTo(scale)
		end)
	end
	local handle = model.PrimaryPart
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
			part.Massless = true
			part.CastShadow = false
			local role = part:GetAttribute("Role")
			if role then
				paint(part, role, pal)
			end
		end
	end
	-- Colgante: en su CharmPoint si el modelo lo trae; si no, donde lo pondría el arma de piezas
	if charmId and charmId ~= "Default" and def.Type == "Gun" and handle then
		local charmPoint = handle:FindFirstChild("CharmPoint")
		local point = charmPoint and charmPoint.CFrame
		if not point then
			local base = WeaponModels.CharmPoint(def)
			point = base - base.Position + base.Position * scale
		end
		for _, piece in Charms.Build(charmId, handle.CFrame * point) do
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = piece
			weld.Parent = piece
			piece.Parent = model
		end
	end
	model:SetAttribute("Weapon", weaponName)
	model:SetAttribute("Scale", scale)
	model:SetAttribute("External", true)
	if withEffects ~= false then
		applyEffects(model, pal)
	end
	return model
end

-- charmId (opcional): colgante (Charms) para las armas de fuego
-- scale (opcional): tamaño del modelo (1 = el de primera persona; el arma que lleva el personaje en el
-- mundo es más pequeña, a escala de una persona: GameConfig.WorldWeaponScale)
function WeaponModels.Build(weaponName, skinId, withEffects, charmId, scale)
	local def = Weapons.Get(weaponName)
	assert(def, "Arma desconocida: " .. tostring(weaponName))
	local pal = WeaponModels.GetPalette(weaponName, skinId)
	scale = scale or 1
	local template = WeaponModels.ExternalTemplate(weaponName)
	if template then
		return buildFromTemplate(template, weaponName, def, pal, withEffects, charmId, scale)
	end

	local model = Instance.new("Model")
	model.Name = weaponName

	local handle
	local created = {}
	for _, spec in def.Parts do
		local part = Instance.new("Part")
		part.Name = spec.Name
		part.Size = spec.Size * scale
		if spec.Shape == "Cylinder" then
			part.Shape = Enum.PartType.Cylinder
		elseif spec.Shape == "Ball" then
			part.Shape = Enum.PartType.Ball
		end
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.Massless = true
		part.CastShadow = false
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part:SetAttribute("Role", spec.Role)
		paint(part, spec.Role, pal)
		if spec.Text then
			addLabel(part, spec.Text, pal)
		end
		if spec.Name == "Handle" then
			handle = part
		end
		part.Parent = model
		table.insert(created, { Part = part, Spec = spec })
	end

	-- Coloca y suelda cada pieza al Handle (que está en el origen del diseño)
	for _, entry in created do
		local cf = entry.Spec.CFrame
		entry.Part.CFrame = scale == 1 and cf or (cf - cf.Position + cf.Position * scale)
		if entry.Part ~= handle then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = entry.Part
			weld.Parent = entry.Part
		end
	end
	local function attach(name, position)
		local a = Instance.new("Attachment")
		a.Name = name
		a.Position = position * scale
		a.Parent = handle
		return a
	end
	if def.Muzzle then
		attach("Muzzle", def.Muzzle)
	end
	if def.AimPoint then
		attach("AimPoint", def.AimPoint)
	end
	attach("Eject", def.Eject or Vector3.new(0.22, 0.08, 0))

	-- Colgante (cuelga del lateral; en el arma en primera persona se balancea, ver WeaponController)
	if charmId and charmId ~= "Default" and def.Type == "Gun" and handle then
		local point = WeaponModels.CharmPoint(def)
		for _, piece in Charms.Build(charmId, handle.CFrame * (point - point.Position + point.Position * scale)) do
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = piece
			weld.Parent = piece
			piece.Parent = model
		end
	end

	model:SetAttribute("Weapon", weaponName)
	model:SetAttribute("Scale", scale)
	model.PrimaryPart = handle
	if withEffects ~= false then
		applyEffects(model, pal)
	end
	return model
end

return WeaponModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">WeaponVisual</string>
          <string name="Source"><![CDATA[-- Presentación de las armas en primera persona (Fase 9): cómo SE VE y se anima cada arma.
--
-- Tres capas separadas:
--   · Juego (Weapons.luau): daño, cadencia, dispersión, cargador, tiempos de recarga. NO se toca aquí.
--   · Sensación (WeaponFeel.luau): retrocesos, rapidez de ADS y sprint, fogonazo, casquillos.
--   · Presentación (este módulo): poses (cadera, ADS, sprint, sacar, guardar, inspeccionar), marcas de
--     la recarga, reposo, saltos, colgante, piezas móviles del modelo, brazos y modelo 3D a usar.
--
-- Todo va por FAMILIAS (las mismas clases que WeaponFeel: Rifle, SMG, Pistol, Shotgun, Marksman,
-- Sniper, LMG, Launcher, Melee). El ARX-27 es la referencia («gold standard»): la familia Rifle son
-- sus valores. Cada arma puede ajustar lo suyo en WeaponVisual.Weapons.
--
-- Orden de las capas del viewmodel (WeaponController, de fuera a dentro):
--   Cámara → Cuerpo (balanceo, respiración, salto/caída) → Inercia del ratón → Pose base (cadera ↔ ADS)
--   → Locomoción (sprint, pared) → Acción (recarga, sacar/guardar, cuchillo, inspección, reposo)
--   → Retroceso del arma (siempre el último: así nunca lo tapa una animación).
local WeaponFeel = require(script.Parent.WeaponFeel)

local WeaponVisual = {}

local V = Vector3.new

WeaponVisual.ReferenceWeapon = "ARX27"
-- Skin de muestra del «gold standard» (solo para enseñarla en el modo QA de Studio; no da la skin a
-- nadie ni cambia nada de la tienda)
WeaponVisual.GoldSkin = "OperacionRoja"

-- Prioridad de las acciones del viewmodel: si hay varias a la vez, manda la primera. El disparo no
-- está aquí: interrumpe lo que el juego ya dejaba interrumpir (inspección, reposo) y se suma como
-- retroceso por encima de todo.
WeaponVisual.ActionPriority = { "Melee", "Reload", "Equip", "Inspect", "Sprint", "IdleVariant", "Idle" }

function WeaponVisual.ResolveAction(state: { [string]: any }): string
	for _, action in WeaponVisual.ActionPriority do
		if action == "Idle" or state[action] then
			return action
		end
	end
	return "Idle"
end

---------------------------------------------------------------------------
-- Brazos (procedurales: sin modelo ni animaciones externas)
---------------------------------------------------------------------------
-- Hombros fijos en el espacio de la cámara (fuera de la pantalla) y codos con cinemática inversa de
-- dos huesos: las manos siguen al arma (recarga, inspección, sprint...) y los codos se doblan solos.
WeaponVisual.Arms = {
	RightShoulder = V(1.1, -1.5, 0.4),
	LeftShoulder = V(-0.7, -1.5, 0.2),
	RightPole = V(1, -1.4, 0.1), -- hacia dónde se dobla el codo (abajo y hacia fuera)
	LeftPole = V(-1, -1.3, 0),
	Reach = 1.06, -- largo del brazo respecto a la distancia hombro-mano en la pose de cadera (>1 = codo algo doblado)
	UpperRatio = 0.5, -- parte del brazo que es el brazo (el resto, antebrazo)
}

-- Cinemática inversa de dos huesos. Devuelve la posición del codo y si la mano se alcanza.
-- (si no se alcanza, el codo queda en la recta hombro-mano y el antebrazo se estira lo que falte)
function WeaponVisual.SolveArm(shoulder: Vector3, hand: Vector3, upper: number, lower: number, pole: Vector3): (Vector3, boolean)
	local toHand = hand - shoulder
	local distance = toHand.Magnitude
	if distance < 1e-4 then
		return shoulder + pole.Unit * upper, false
	end
	local dir = toHand / distance
	if distance >= upper + lower then
		-- (brazo estirado del todo: el codo en la recta; el antebrazo se estira lo que falte)
		return shoulder + dir * upper, false
	end
	local reached = distance >= math.abs(upper - lower)
	local d = math.clamp(distance, math.abs(upper - lower) + 1e-3, upper + lower - 1e-3)
	local along = (upper * upper - lower * lower + d * d) / (2 * d)
	local height = math.sqrt(math.max(0, upper * upper - along * along))
	-- Dirección de doblado: el polo sin su parte a lo largo del brazo
	local bend = pole - dir * pole:Dot(dir)
	if bend.Magnitude < 1e-4 then
		bend = Vector3.yAxis:Cross(dir)
		if bend.Magnitude < 1e-4 then
			bend = Vector3.xAxis
		end
	end
	bend = bend.Unit
	return shoulder + dir * along + bend * height, reached
end

---------------------------------------------------------------------------
-- Piezas móviles del modelo
---------------------------------------------------------------------------
-- Una pieza se mueve sola si tiene el atributo "Piece" (modelos nuevos o importados) o si su nombre
-- empieza por uno de estos prefijos (los modelos de piezas de siempre).
WeaponVisual.PiecePrefixes = {
	Mag = { "Mag", "Drum", "AmmoBox", "BeltRound" }, -- cargador (sale y entra en la recarga)
	Slide = { "Slide" }, -- corredera de pistola
	Pump = { "Pump" }, -- bomba de escopeta
	Bolt = { "BoltHandle", "BoltKnob" }, -- cerrojo de francotirador
	Charge = { "ChargingHandle" }, -- palanca de carga de fusil (recarga vacía)
}
-- Nombres que empiezan igual pero NO se mueven
WeaponVisual.PieceExclude = { "MagTube", "BoltShroud", "BoltRelease", "Pumpkin" }

local function startsWith(name: string, prefix: string): boolean
	return string.sub(name, 1, #prefix) == prefix
end

function WeaponVisual.PieceGroup(name: string, pieceAttribute: string?): string?
	if type(pieceAttribute) == "string" and WeaponVisual.PiecePrefixes[pieceAttribute] then
		return pieceAttribute
	end
	for _, prefix in WeaponVisual.PieceExclude do
		if startsWith(name, prefix) then
			return nil
		end
	end
	for group, prefixes in WeaponVisual.PiecePrefixes do
		for _, prefix in prefixes do
			if startsWith(name, prefix) then
				return group
			end
		end
	end
	return nil
end

---------------------------------------------------------------------------
-- Familias
---------------------------------------------------------------------------
-- Poses: Offset (studs, espacio del arma) y Angles (grados: cabeceo, giro, alabeo).
local BASE = {
	-- Reposo: respiración (× la de siempre) y, tras un rato sin hacer nada, un pequeño gesto (la mano
	-- izquierda suelta y vuelve a agarrar el guardamanos). Nunca mientras haces otra cosa.
	Idle = {
		Breath = 1,
		VariantAfter = 9, -- segundos quieto sin tocar nada
		VariantDuration = 1.3,
		VariantCooldown = 16, -- como mucho uno cada tanto
		VariantRoll = 7, -- grados que se ladea el arma
		VariantHand = V(0.06, -0.14, 0.12), -- la mano izquierda se separa y vuelve
	},
	Sprint = { Offset = V(-0.25, -0.2, 0.1), Angles = V(-12, 35, 18) },
	Equip = { Offset = V(0.15, -0.9, 0.1), Angles = V(-50, 15, -25) },
	-- Guardar: el arma vieja baja de lado mientras sube la nueva (no retrasa el cambio)
	Unequip = { Time = 0.14, Offset = V(0.1, -0.85, 0.15), Angles = V(-40, 10, -20) },
	-- Inspección: claves { t (0-1), posición, ángulos } con transición suave entre ellas
	Inspect = {
		Duration = 2.6,
		Moment = 0.42, -- cuando se ve el colgante de cerca (evento InspectMoment y meneo del colgante)
		Keys = {
			{ 0, V(0, 0, 0), V(0, 0, 0) },
			{ 0.16, V(-0.35, 0.18, 0.25), V(12, 70, -25) }, -- costado izquierdo (skin y colgante)
			{ 0.42, V(-0.28, 0.2, 0.38), V(16, 55, -18) }, -- más cerca
			{ 0.72, V(-0.32, 0.16, 0.25), V(8, -45, 10) }, -- el otro costado
			{ 0.86, V(-0.08, 0.05, 0.08), V(-6, -8, 4) }, -- remate: sube un poco
			{ 1, V(0, 0, 0), V(0, 0, 0) },
		},
	},
	-- Recarga: inclinación del arma y marcas (fracción de la duración REAL de la recarga, la del juego).
	-- Tactical = con balas; Empty = vacía (con cerrojo/palanca). Ready = el arma vuelve a estar lista.
	Reload = {
		Tilt = { Offset = V(-0.08, -0.1, 0.05), Angles = V(8, -10, 28) },
		Tactical = { MagOut = 0.12, MagIn = 0.55, Ready = 0.95 },
		Empty = { MagOut = 0.12, MagIn = 0.55, Bolt = 0.85, Ready = 0.97 },
		ChargePull = 0.22, -- studs que retrocede la palanca de carga
		-- Armas que cargan cartucho a cartucho (escopeta de bomba): un ShellIn por cartucho y el
		-- bombeo final (Bolt), sea vacía o no
		Shells = { 0.2, 0.38, 0.56, 0.74 },
		ShellPump = 0.85,
		ShellReady = 0.97,
	},
	-- Salto y caída: el arma se queda atrás al despegar y se hunde al aterrizar (más cuanto más alto)
	Jump = { Kick = 0.9, Stiffness = 120, Damping = 14 },
	-- Colgante: empujones por acción (además del giro de la cámara)
	Charm = { Fire = 0.5, Reload = 1.4, Land = 1.6, Sprint = 0.35, Inspect = 2.2, Idle = 1 },
	-- Cuchillo: momento del golpe (fracción) para el evento MeleeHit
	Melee = { HitAt = 0.3 },
}

-- Lo que cambia cada familia (encima de BASE). El fusil (ARX-27) es BASE tal cual.
WeaponVisual.Families = {
	Rifle = {},
	SMG = {
		Sprint = { Offset = V(-0.2, -0.16, 0.08), Angles = V(-10, 30, 15) },
		Equip = { Offset = V(0.12, -0.7, 0.08), Angles = V(-40, 12, -20) },
		Unequip = { Time = 0.12 },
		Inspect = { Duration = 2.3 },
	},
	Pistol = {
		-- Pistola: corre con el arma recogida hacia arriba («high ready»), saca muy rápido
		Sprint = { Offset = V(0.05, 0.02, 0.2), Angles = V(28, 12, -8) },
		Equip = { Offset = V(0.1, -0.6, 0.05), Angles = V(-35, 8, -15) },
		Unequip = { Time = 0.1 },
		Idle = { VariantRoll = 10, VariantHand = V(0.04, -0.08, 0.06) },
		Inspect = {
			Duration = 2.1,
			Moment = 0.4,
			Keys = {
				{ 0, V(0, 0, 0), V(0, 0, 0) },
				{ 0.18, V(-0.2, 0.12, 0.2), V(10, 65, -30) },
				{ 0.4, V(-0.16, 0.16, 0.3), V(14, 50, -20) },
				{ 0.62, V(-0.2, 0.12, 0.2), V(6, -60, 25) },
				{ 0.82, V(-0.04, 0.04, 0.05), V(-8, -6, 6) },
				{ 1, V(0, 0, 0), V(0, 0, 0) },
			},
		},
		Reload = { Tilt = { Offset = V(-0.05, -0.06, 0.03), Angles = V(10, -8, 22) } },
	},
	Shotgun = {
		Sprint = { Offset = V(-0.28, -0.24, 0.12), Angles = V(-14, 38, 20) },
		Equip = { Offset = V(0.18, -1.0, 0.12), Angles = V(-55, 15, -28) },
		Unequip = { Time = 0.16 },
		Jump = { Kick = 1.1 },
	},
	Marksman = {
		Sprint = { Offset = V(-0.27, -0.22, 0.11), Angles = V(-13, 36, 19) },
		Unequip = { Time = 0.15 },
	},
	Sniper = {
		Sprint = { Offset = V(-0.3, -0.26, 0.12), Angles = V(-15, 32, 18) },
		Equip = { Offset = V(0.18, -1.0, 0.12), Angles = V(-55, 15, -28) },
		Unequip = { Time = 0.17 },
		Inspect = { Duration = 2.8 },
		Jump = { Kick = 1.1, Stiffness = 100 },
	},
	LMG = {
		-- Ametralladora: se lleva baja y pegada al cuerpo al correr (pesa)
		Sprint = { Offset = V(-0.15, -0.3, 0.14), Angles = V(-22, 22, 10) },
		Equip = { Offset = V(0.2, -1.1, 0.15), Angles = V(-55, 12, -22) },
		Unequip = { Time = 0.18 },
		Inspect = { Duration = 2.9 },
		Jump = { Kick = 1.25, Stiffness = 90, Damping = 12 },
		Reload = { Tilt = { Offset = V(-0.1, -0.14, 0.06), Angles = V(10, -12, 32) } },
	},
	Launcher = {
		Sprint = { Offset = V(-0.2, -0.28, 0.12), Angles = V(-18, 26, 12) },
		Unequip = { Time = 0.18 },
	},
	Melee = {
		Sprint = { Offset = V(-0.1, -0.15, 0.1), Angles = V(-15, 20, 15) },
		Unequip = { Time = 0.1 },
	},
}

---------------------------------------------------------------------------
-- Ajustes por arma (modelo, piezas, puntos)
---------------------------------------------------------------------------
-- Model = nil → el modelo de piezas de siempre (WeaponDesigns / WeaponDesignsClassic).
-- Model = "Nombre" → plantilla en ReplicatedStorage.WeaponViewModels[Nombre] (por ejemplo, un modelo
-- comprado). Ver WeaponVisual.ModelRequirements y FASE_09_ARX27_GOLD_STANDARD.md (sección M).
-- ViewOffset (CFrame) / AimDistance (studs): pose de cadera y distancia de la mira si el modelo nuevo
-- lo necesita (si no, las de Weapons). Además, cualquier sección de las familias (Sprint, Inspect...).
WeaponVisual.Weapons = {
	ARX27 = { Model = nil },
}

-- Lo que necesita un modelo externo para funcionar sin tocar el código
WeaponVisual.ModelRequirements = {
	PrimaryPart = "Handle", -- pieza raíz (todas las demás soldadas a ella)
	Attachments = { "Muzzle", "AimPoint", "Eject" }, -- en el Handle: boca del cañón, centro de la mira, ventana de expulsión
	Optional = { "LeftHand", "RightHand", "CharmPoint" }, -- en el Handle: dónde agarran las manos y de dónde cuelga el colgante
	-- Piezas: atributo "Role" (Body, Panel, Accent, Accent2, Dark, Metal, Rubber, Lens, Reticle, Trim)
	-- para las skins y atributo "Piece" (Mag, Slide, Pump, Bolt, Charge) para las que se mueven.
}

-- ¿Qué le falta a un modelo para usarlo? (lista vacía = listo)
function WeaponVisual.ValidateModel(model: any): { string }
	local missing = {}
	if not model then
		table.insert(missing, "modelo")
		return missing
	end
	local handle = model.PrimaryPart
	if not handle or handle.Name ~= WeaponVisual.ModelRequirements.PrimaryPart then
		table.insert(missing, "PrimaryPart = Handle")
		return missing
	end
	for _, name in WeaponVisual.ModelRequirements.Attachments do
		local attachment = handle:FindFirstChild(name)
		if not attachment or not attachment:IsA("Attachment") then
			table.insert(missing, "Attachment " .. name)
		end
	end
	local painted = false
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part:GetAttribute("Role") then
			painted = true
			break
		end
	end
	if not painted then
		table.insert(missing, "piezas con atributo Role (para las skins)")
	end
	return missing
end

---------------------------------------------------------------------------
-- Resolución
---------------------------------------------------------------------------

-- Copia profunda de `base` con `extra` encima (tablas por secciones; los Vector3 y listas se reemplazan)
local function merge(base, extra)
	local out = {}
	for key, value in base do
		out[key] = value
	end
	if extra then
		for key, value in extra do
			local current = out[key]
			if type(value) == "table" and type(current) == "table" and value[1] == nil and current[1] == nil then
				out[key] = merge(current, value)
			else
				out[key] = value
			end
		end
	end
	return out
end
WeaponVisual.Merge = merge

local cache = {}

-- Presentación completa de un arma (BASE + su familia + sus ajustes)
function WeaponVisual.Get(weaponName: string?, def: any?)
	local key = weaponName or ""
	local cached = cache[key]
	if cached then
		return cached
	end
	local family = WeaponFeel.Class(weaponName, def)
	local visual = merge(BASE, WeaponVisual.Families[family])
	local own = weaponName and WeaponVisual.Weapons[weaponName]
	if own then
		visual = merge(visual, own)
	end
	visual.Family = family
	cache[key] = visual
	return visual
end

function WeaponVisual.ClearCache()
	table.clear(cache)
end

-- Marcas de una recarga en orden: { { Name, At } } (At = fracción de la duración). shells = carga
-- cartucho a cartucho (ShellIn × n, Bolt = bombeo y Ready)
function WeaponVisual.ReloadMarkers(visual, empty: boolean, shells: boolean?): { { Name: string, At: number } }
	local list = {}
	if shells then
		for _, at in visual.Reload.Shells do
			table.insert(list, { Name = "ShellIn", At = at })
		end
		table.insert(list, { Name = "Bolt", At = visual.Reload.ShellPump })
		table.insert(list, { Name = "Ready", At = visual.Reload.ShellReady })
		return list
	end
	local timeline = empty and visual.Reload.Empty or visual.Reload.Tactical
	for name, at in timeline do
		table.insert(list, { Name = name, At = at })
	end
	table.sort(list, function(a, b)
		return a.At < b.At
	end)
	return list
end

-- Pose de la inspección en el instante t (0-1): posición y ángulos (grados) interpolados con suavidad
local function smooth(x)
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end
function WeaponVisual.InspectPose(visual, t: number): (Vector3, Vector3)
	local keys = visual.Inspect.Keys
	t = math.clamp(t, 0, 1)
	for i = 2, #keys do
		local a, b = keys[i - 1], keys[i]
		if t <= b[1] then
			local span = b[1] - a[1]
			local k = span > 0 and smooth((t - a[1]) / span) or 1
			return a[2]:Lerp(b[2], k), a[3]:Lerp(b[3], k)
		end
	end
	local last = keys[#keys]
	return last[2], last[3]
end

-- CFrame de una pose { Offset, Angles (grados) } multiplicada por un peso (0-1; puede pasarse un poco
-- o ser negativo: el rebote al sacar el arma)
function WeaponVisual.PoseCFrame(pose, weight: number): CFrame
	if weight == 0 then
		return CFrame.identity
	end
	local o, a = pose.Offset * weight, pose.Angles * weight
	return CFrame.new(o) * CFrame.Angles(math.rad(a.X), math.rad(a.Y), math.rad(a.Z))
end

return WeaponVisual
]]></string>
