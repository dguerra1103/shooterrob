      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Sounds</string>
          <string name="Source"><![CDATA[-- Sonidos del juego. Los "rbxasset://" vienen incluidos con Roblox y funcionan sin subir nada.
-- Para mejores sonidos busca en el Creator Store (Toolbox > Audio) y pega aquí "rbxassetid://<id>".
local Sounds = {
	Shot = { Id = "rbxasset://sounds/paintball.wav", Volume = 0.7, Pitch = 1.3 },
	ShotHeavy = { Id = "rbxasset://sounds/Rocket shot.wav", Volume = 0.6, Pitch = 1.6 },
	Empty = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.6, Pitch = 1 },
	Reload = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.8, Pitch = 0.7 },
	Swing = { Id = "rbxasset://sounds/swordslash.wav", Volume = 0.6, Pitch = 1.2 },
	Hit = { Id = "rbxasset://sounds/snap.wav", Volume = 0.9, Pitch = 1.4 },
	Headshot = { Id = "rbxasset://sounds/snap.wav", Volume = 1, Pitch = 2 },
	Kill = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.8, Pitch = 1 },
	Click = { Id = "rbxasset://sounds/button.wav", Volume = 0.5, Pitch = 1 },
	Flag = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 1, Pitch = 0.7 },
	Slide = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.4, Pitch = 0.6 },
	Infected = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 1, Pitch = 0.4 }, -- golpe grave: ¡zombis!
}

-- Reproduce un sonido. Si parent es nil, suena en 2D (para el jugador local).
-- pitch y volume (opcionales) multiplican los valores del sonido: así cada arma suena distinta.
function Sounds.Play(name, parent, pitch, volume)
	local info = Sounds[name]
	if type(info) ~= "table" then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = info.Id
	sound.Volume = info.Volume * (volume or 1)
	sound.PlaybackSpeed = info.Pitch * (pitch or 1) * (0.95 + math.random() * 0.1)
	sound.RollOffMaxDistance = 300
	sound.Parent = parent or workspace.CurrentCamera or workspace
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	task.delay(5, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
	return sound
end

-- Sonido de disparo de cada arma: { sonido, tono, volumen }
Sounds.WeaponShots = {
	ARX27 = { "Shot", 0.95, 1 },
	VortexBR = { "Shot", 1.15, 0.9 },
	Specter9 = { "Shot", 1.2, 0.8 },
	NovaDrift = { "Shot", 1.3, 0.75 },
	SplatX = { "Shot", 1.7, 0.6 }, -- "pop" agudo de aire comprimido
	Signal7 = { "ShotHeavy", 0.75, 1.1 },
	GhostlineXR = { "Shot", 0.55, 0.55 }, -- con supresor: grave y apagado
	RaptorDMR = { "ShotHeavy", 1.05, 0.9 },
	HavocPump = { "ShotHeavy", 0.85, 1.1 },
	BreachHammer = { "ShotHeavy", 0.7, 1.2 },
	TitanLMG = { "ShotHeavy", 1.2, 0.7 },
	NovaLauncher = { "ShotHeavy", 0.5, 1.3 },
	Viper = { "Shot", 1.1, 0.8 },
	HandCannon = { "ShotHeavy", 0.9, 1 },
	PhantomSidewind = { "Shot", 1.35, 0.8 },
}

-- Disparo de un arma (con su sonido propio si lo tiene)
function Sounds.PlayShot(weaponName, def, parent)
	local profile = weaponName and Sounds.WeaponShots[weaponName]
	if profile then
		return Sounds.Play(profile[1], parent, profile[2], profile[3])
	end
	local heavy = def ~= nil and (def.Pellets > 1 or def.Damage >= 80)
	return Sounds.Play(heavy and "ShotHeavy" or "Shot", parent)
end

return Sounds
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">WeaponDesigns</string>
          <string name="Source"><![CDATA[-- Diseño 3D (hecho con piezas) de cada arma, inspirado en el arte conceptual del juego.
-- Espacio del modelo: -Z = hacia delante (cañón), +Y = arriba, +X = derecha.
-- "Handle" es la pieza raíz y SIEMPRE va en el origen (0, 0, 0): manos, mira y cañón se miden desde ahí.
--
-- Roles de color (los pinta WeaponModels según la paleta del arma o la skin equipada):
--   Body    = cuerpo principal (normalmente negro mate)
--   Panel   = placas de armadura (blancas en el diseño base)
--   Accent  = neón principal
--   Accent2 = neón / color secundario
--   Dark    = metal oscuro (cañón, raíles, cargador)
--   Metal   = metal claro (gatillo, tornillos)
--   Rubber  = goma de las empuñaduras
--   Lens    = cristal de las miras (teñido con el neón)
--   Gold    = latón (cartuchos, detalles)
--   Shell   = rojo de los cartuchos de escopeta
--   Core    = núcleo de energía brillante (mezcla de Accent y Accent2)
local Designs = {}

local rad = math.rad

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

-- Caja (con giro opcional en grados)
local function B(name, x, y, z, sx, sy, sz, role, rx, ry, rz)
	local cf = CFrame.new(x, y, z)
	if rx or ry or rz then
		cf *= CFrame.Angles(rad(rx or 0), rad(ry or 0), rad(rz or 0))
	end
	return { Name = name, Size = V(sx, sy, sz), CFrame = cf, Role = role }
end

-- Cilindro a lo largo del eje Z
local function C(name, x, y, z, length, diameter, role)
	return { Name = name, Size = V(length, diameter, diameter), CFrame = CFrame.new(x, y, z) * CFrame.Angles(0, rad(90), 0), Role = role, Shape = "Cylinder" }
end

-- Cilindro a lo largo del eje X (tornillos, pasadores)
local function CX(name, x, y, z, length, diameter, role)
	return { Name = name, Size = V(length, diameter, diameter), CFrame = CFrame.new(x, y, z), Role = role, Shape = "Cylinder" }
end

-- Cilindro vertical
local function CY(name, x, y, z, length, diameter, role)
	return { Name = name, Size = V(length, diameter, diameter), CFrame = CFrame.new(x, y, z) * CFrame.Angles(0, 0, rad(90)), Role = role, Shape = "Cylinder" }
end

local function Ball(name, x, y, z, d, role)
	return { Name = name, Size = V(d, d, d), CFrame = CFrame.new(x, y, z), Role = role, Shape = "Ball" }
end

-- Rótulo con texto en los dos costados del arma
local function Label(name, x, y, z, sx, sy, sz, text, role)
	local part = B(name, x, y, z, sx, sy, sz, role or "Body")
	part.Text = text
	return part
end

-- Piezas en un grupo con su propia posición/giro (por ejemplo el cargador inclinado)
local function Group(base, list)
	local out = {}
	for _, p in list do
		p.CFrame = base * p.CFrame
		table.insert(out, p)
	end
	return out
end

local function add(list, items)
	for _, item in items do
		table.insert(list, item)
	end
end

-- Dientes de un raíl a lo largo de Z
local function railTeeth(list, prefix, x, y, z0, z1, step, width, role)
	local i = 0
	local z = z0
	while z >= z1 do
		i += 1
		table.insert(list, B(prefix .. i, x, y, z, width, 0.05, 0.07, role or "Dark"))
		z -= step
	end
end

