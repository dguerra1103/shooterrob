-- Pestaña: Armas
---------------------------------------------------------------------------

local function buildWeaponsPage(data)
	local scroll = scroller(UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(205, 282),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}))
	local order = 0
	local function weaponCard(weaponName, slotField)
		order += 1
		local def = Weapons.Get(weaponName)
		local unlocked = Weapons.IsUnlocked(weaponName, data)
		local selected = data[slotField] == weaponName
		local card = UI.new("Frame", {
			LayoutOrder = order,
			BackgroundColor3 = CARD_BG,
			Parent = scroll,
		}, { UI.corner(12), UI.stroke(selected and GOLD or Color3.fromRGB(90, 100, 140), 2, 0) })
		UI.label({ Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 24), Text = def.DisplayName, TextSize = 21, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 28),
			Size = UDim2.new(1, 0, 0, 16),
			Text = def.Category .. (slotField == "Secondary" and " · secundaria" or ""),
			TextSize = 14,
			TextColor3 = Color3.fromRGB(170, 180, 215),
			Parent = card,
		})
		WeaponIcon.Create(weaponName, skinFor(data, weaponName), { Position = UDim2.fromOffset(8, 46), Size = UDim2.fromOffset(189, 78), Parent = card }, "angled", 189 / 78)
		local stats
		if def.Type == "Melee" then
			stats = string.format("Daño %d · alcance %s · %.1f golpes/s", def.Damage, tostring(def.Range), 1 / def.Cooldown)
		elseif def.Explosive then
			stats = "Explosivo · radio " .. def.Explosive.Radius
		else
			local damage = def.Pellets > 1 and (def.Damage .. "x" .. def.Pellets) or tostring(def.Damage)
			stats = string.format("Daño %s · %d/s · %d balas", damage, math.floor(def.FireRate + 0.5), def.MagSize)
		end
		UI.label({ Position = UDim2.fromOffset(0, 128), Size = UDim2.new(1, 0, 0, 18), Text = stats, TextSize = 14, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(8, 148),
			Size = UDim2.new(1, -16, 0, 32),
			Text = def.Description or "",
			TextSize = 13,
			TextWrapped = true,
			TextColor3 = Color3.fromRGB(190, 195, 220),
			Font = UI.FontBody,
			TextStrokeTransparency = 1,
			Parent = card,
		})
		-- Maestría: bajas con esta arma y camuflajes ganados
		local kills = data.WeaponKills and data.WeaponKills[weaponName] or 0
		local level = Mastery.Level(kills)
		local nextTier = Mastery.Next(kills)
		local current = Mastery.Tiers[level]
		UI.label({
			Position = UDim2.fromOffset(8, 182),
			Size = UDim2.new(1, -16, 0, 16),
			Text = (current and ("🏆 " .. current.Name) or "🏆 Maestría")
				.. (nextTier and ("  ·  " .. kills .. "/" .. nextTier.Kills .. " bajas") or "  ·  ¡COMPLETA!"),
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = current and Skins.RarityColors[Skins.Get(current.Camo).Rarity] or Color3.fromRGB(200, 205, 225),
			Parent = card,
		})
		local previous = current and current.Kills or 0
		local fraction = nextTier and (kills - previous) / (nextTier.Kills - previous) or 1
		progressBar(card, UDim2.fromOffset(8, 200), UDim2.new(1, -16, 0, 8), fraction, GOLD)
		if level > 0 then
			local options = { "Default" }
			for i = 1, level do
				table.insert(options, Mastery.Tiers[i].Camo)
			end
			local selected = data.WeaponCamos and data.WeaponCamos[weaponName] or "Default"
			local index = table.find(options, selected) or 1
			local camoButton = UI.button({
				Position = UDim2.fromOffset(10, 212),
				Size = UDim2.new(1, -20, 0, 22),
				Text = "🎨 Camuflaje: " .. (selected == "Default" and "Skin general" or Skins.Get(selected).Name) .. "  ▸",
				TextSize = 13,
				BackgroundColor3 = Color3.fromRGB(70, 60, 120),
				Parent = card,
			})
			camoButton.Activated:Connect(function()
				Sounds.Play("Click")
				Remotes.SetCamo:FireServer(weaponName, options[index % #options + 1])
			end)
		end
		local button = UI.button({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.new(1, -20, 0, 36),
			TextSize = 17,
			Parent = card,
		}, { UI.gloss() })
		if selected then
			button.Text = "Equipada"
			button.BackgroundColor3 = GREEN
			button.AutoButtonColor = false
		elseif unlocked then
			button.Text = "Equipar"
			button.BackgroundColor3 = BLUE
			button.Activated:Connect(function()
				Sounds.Play("Click")
				if slotField == "Primary" then
					Remotes.SetPrimary:FireServer(weaponName)
				elseif slotField == "Melee" then
					Remotes.SetMelee:FireServer(weaponName)
				else
					Remotes.SetSecondary:FireServer(weaponName)
				end
			end)
		elseif def.Price then
			button.Text = "🔒 Nv " .. def.UnlockLevel .. "  ·  " .. coinsText(def.Price)
			button.BackgroundColor3 = data.Coins >= def.Price and Color3.fromRGB(230, 140, 20) or GREY
			button.Activated:Connect(function()
				buy("Weapon", weaponName)
			end)
		else
			button.Text = def.EventText or ("🔒 Nivel " .. def.UnlockLevel)
			button.BackgroundColor3 = GREY
			button.AutoButtonColor = false
		end
	end
	for _, name in Weapons.Primaries do
		weaponCard(name, "Primary")
	end
	for _, name in Weapons.Secondaries do
		weaponCard(name, "Secondary")
	end
	for _, name in Weapons.Melees do
		weaponCard(name, "Melee")
	end
end

---------------------------------------------------------------------------
-- Pestañas: Skins y Trajes
---------------------------------------------------------------------------

local RARITY_ORDER = { "Común", "Raro", "Épico", "Legendario", "Mítico" }

-- kind (opcional): lo nuevo (Shop.NewItems) va delante, justo después del de por defecto
local function sortedIds(list, kind)
	local ids = {}
	for id in list do
		table.insert(ids, id)
	end
	table.sort(ids, function(a, b)
		if (a == "Default") ~= (b == "Default") then
			return a == "Default"
		end
		local na, nb = kind ~= nil and Shop.IsNew(kind, a), kind ~= nil and Shop.IsNew(kind, b)
		if na ~= nb then
			return na
		end
		local ra = table.find(RARITY_ORDER, list[a].Rarity) or 0
		local rb = table.find(RARITY_ORDER, list[b].Rarity) or 0
		if ra == rb then
			return list[a].Name < list[b].Name
		end
		return ra < rb
	end)
	return ids
end

local function priceButton(card, kind, id, owned, equipped, onEquip, lockedText)
	local price, onSale = Shop.GetPrice(kind, id)
	local button = UI.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.new(1, -20, 0, 32),
		TextSize = 16,
		Parent = card,
	}, { UI.gloss() })
	if equipped then
		button.Text = "Equipado"
		button.BackgroundColor3 = GREEN
		button.AutoButtonColor = false
	elseif owned then
		button.Text = "Equipar"
		button.BackgroundColor3 = BLUE
		button.Activated:Connect(onEquip)
	elseif price then
		button.Text = (onSale and "🔥 " or "") .. coinsText(price)
		button.BackgroundColor3 = onSale and Color3.fromRGB(230, 60, 90) or Color3.fromRGB(230, 140, 20)
		button.Activated:Connect(function()
			buy(kind, id)
		end)
	else
		button.Text = lockedText or "🔒 Pase de batalla"
		button.BackgroundColor3 = GREY
		button.AutoButtonColor = false
	end
	if onSale and not owned then
		UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -6, 0, 4),
			Size = UDim2.fromOffset(60, 20),
			Text = "-" .. math.floor(Shop.OfferDiscount * 100) .. "%",
			TextSize = 16,
			TextColor3 = Color3.fromRGB(255, 90, 120),
			ZIndex = 3,
			Parent = card,
		})
	end
	-- Recién llegado a la tienda (Shop.NewItems)
	if not owned and Shop.IsNew(kind, id) then
		UI.new("Frame", {
			Position = UDim2.fromOffset(6, 6),
			Size = UDim2.fromOffset(62, 20),
			BackgroundColor3 = Color3.fromRGB(255, 60, 110),
			ZIndex = 3,
			Parent = card,
		}, {
			UI.corner(6),
			UI.label({ Size = UDim2.fromScale(1, 1), Text = "¡NUEVO!", TextSize = 13, ZIndex = 4 }),
		})
	end
end

local function buildSkinsPage(data)
	local scroll = scroller(UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(165, 160),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}))
	local visible = {}
	for id, skin in Skins.List do
		if not skin.Mastery then
			visible[id] = skin
		end
	end
	for i, id in sortedIds(visible, "Skin") do
		local skin = Skins.List[id]
		local owned = data.Skins[id] == true
		local equipped = data.EquippedSkin == id
		local card = UI.new("Frame", { LayoutOrder = i, BackgroundColor3 = CARD_BG, Parent = scroll }, {
			UI.corner(10),
			UI.stroke(equipped and GOLD or rarityColor(skin.Rarity), 2, equipped and 0 or 0.4),
		})
		WeaponIcon.Create(data.Primary or "ARX27", id, { Position = UDim2.fromOffset(6, 4), Size = UDim2.fromOffset(153, 58), Parent = card }, "angled", 153 / 58)
		UI.label({
			Position = UDim2.fromOffset(0, 62),
			Size = UDim2.new(1, 0, 0, 22),
			Text = id == "Default" and "De fábrica" or skin.Name,
			TextSize = 19,
			Parent = card,
		})
		UI.label({
			Position = UDim2.fromOffset(0, 84),
			Size = UDim2.new(1, 0, 0, 16),
			Text = skin.Rarity,
			TextSize = 14,
			TextColor3 = rarityColor(skin.Rarity),
			Parent = card,
		})
		priceButton(card, "Skin", id, owned, equipped, function()
			Sounds.Play("Click")
			Remotes.EquipSkin:FireServer(id)
		end, skin.Event and (skin.EventText or "Evento") or nil)
	end

	-- Colgantes para el arma (en la misma rejilla, después de las skins)
	local header = UI.new("Frame", { LayoutOrder = 999, BackgroundColor3 = Color3.fromRGB(60, 50, 90), Parent = scroll }, { UI.corner(10) })
	UI.label({
		Size = UDim2.fromScale(1, 1),
		Text = "🔑 COLGANTES\nCuelgan de tu arma y se balancean\n(se ven al reaparecer)",
		TextSize = 16,
		TextWrapped = true,
		TextColor3 = GOLD,
		Parent = header,
	})
	local charmsOwned = data.Charms or { Default = true }
	for i, id in sortedIds(Charms.List, "Charm") do
		local charm = Charms.List[id]
		local equipped = (data.EquippedCharm or "Default") == id
		local card = UI.new("Frame", { LayoutOrder = 1000 + i, BackgroundColor3 = CARD_BG, Parent = scroll }, {
			UI.corner(10),
			UI.stroke(equipped and GOLD or rarityColor(charm.Rarity), 2, equipped and 0 or 0.4),
		})
		UI.label({ Position = UDim2.fromOffset(0, 4), Size = UDim2.new(1, 0, 0, 56), Text = charm.Icon, TextSize = 44, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 62), Size = UDim2.new(1, 0, 0, 22), Text = charm.Name, TextSize = 18, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 84),
			Size = UDim2.new(1, 0, 0, 16),
			Text = charm.Rarity,
			TextSize = 14,
			TextColor3 = rarityColor(charm.Rarity),
			Parent = card,
		})
		priceButton(card, "Charm", id, charmsOwned[id] == true, equipped, function()
			Sounds.Play("Click")
			Remotes.EquipCharm:FireServer(id)
		end)
	end
end

---------------------------------------------------------------------------
-- Pestaña: Ajustes (calidad gráfica, campo de visión, sensibilidad)
---------------------------------------------------------------------------

local QUALITY_INFO = {
	Auto = "Se elige sola: Baja en móviles, Media en PC",
	Baja = "Máximo rendimiento (móviles): sin sombras ni efectos",
	Media = "Sombras y brillo, menos partículas",
	Alta = "Todo como está diseñado",
	Ultra = "Además desenfoque de distancia y más partículas",
}

local function buildSettingsPage()
	local scroll = scroller(UI.new("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }))
	local current = Settings.Get()

	local function section(order, title, height)
		local frame = UI.new("Frame", {
			LayoutOrder = order,
			Size = UDim2.new(1, -12, 0, height),
			BackgroundColor3 = CARD_BG,
			Parent = scroll,
		}, { UI.corner(12) })
		UI.label({
			Position = UDim2.fromOffset(16, 8),
			Size = UDim2.new(1, -32, 0, 28),
			Text = title,
			TextSize = 22,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = frame,
		})
		return frame
	end

	-- Calidad gráfica
	local quality = section(1, "🎨 Calidad gráfica", 116)
	for i, level in GameConfig.QualityLevels do
		local selected = current.Quality == level
		local button = UI.button({
			Position = UDim2.fromOffset(16 + (i - 1) * 118, 42),
			Size = UDim2.fromOffset(110, 36),
			Text = level,
			TextSize = 18,
			BackgroundColor3 = selected and BLUE or GREY,
			Parent = quality,
		}, { UI.gloss() })
		button.Activated:Connect(function()
			Sounds.Play("Click")
			Settings.Set("Quality", level)
			refresh()
		end)
	end
	UI.label({
		Position = UDim2.fromOffset(16, 84),
		Size = UDim2.new(1, -32, 0, 22),
		Text = QUALITY_INFO[current.Quality] or "",
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(190, 195, 220),
		Font = UI.FontBody,
		TextStrokeTransparency = 1,
		Parent = quality,
	})

	-- Deslizadores sencillos con botones − y +
	local function stepper(order, title, key, step, format)
		local frame = section(order, title, 92)
		local valueLabel = UI.label({
			Position = UDim2.fromOffset(80, 44),
			Size = UDim2.fromOffset(120, 36),
			Text = string.format(format, current[key]),
			TextSize = 24,
			TextColor3 = GOLD,
			Parent = frame,
		})
		for _, info in { { "−", -step, 16 }, { "+", step, 206 } } do
			local button = UI.button({
				Position = UDim2.fromOffset(info[3], 44),
				Size = UDim2.fromOffset(56, 36),
				Text = info[1],
				TextSize = 26,
				BackgroundColor3 = BLUE,
				Parent = frame,
			}, { UI.gloss() })
			button.Activated:Connect(function()
				Sounds.Play("Click")
				Settings.Set(key, current[key] + info[2])
				valueLabel.Text = string.format(format, current[key])
			end)
		end
		return frame
	end
	stepper(2, "🔭 Campo de visión (FOV)", "FOV", 5, "%d°")
	stepper(3, "🖱 Sensibilidad", "Sensitivity", 0.1, "%.1f")
	stepper(4, "🎯 Sensibilidad al apuntar", "AimSensitivity", 0.05, "%.2f")

	-- Mira: color (muestras) y tamaño
	local cross = section(5, "➕ Mira", 92)
	for i, color in GameConfig.CrosshairColors do
		local selected = math.floor(current.CrossColor or 1) == i
		local swatch = UI.button({
			Position = UDim2.fromOffset(16 + (i - 1) * 46, 44),
			Size = UDim2.fromOffset(38, 36),
			Text = selected and "✔" or "",
			TextSize = 20,
			TextColor3 = Color3.new(0, 0, 0),
			BackgroundColor3 = color,
			Parent = cross,
		}, { UI.stroke(selected and GOLD or Color3.new(0, 0, 0), selected and 3 or 1, 0) })
		swatch.Activated:Connect(function()
			Sounds.Play("Click")
			Settings.Set("CrossColor", i)
			refresh()
		end)
	end
	local sizeLabel = UI.label({
		Position = UDim2.fromOffset(360, 44),
		Size = UDim2.fromOffset(110, 36),
		Text = "Tamaño " .. string.format("%.1f", current.CrossSize or 1),
		TextSize = 20,
		TextColor3 = GOLD,
		Parent = cross,
	})
	for _, info in { { "−", -0.2, 300 }, { "+", 0.2, 476 } } do
		local button = UI.button({
			Position = UDim2.fromOffset(info[3], 44),
			Size = UDim2.fromOffset(52, 36),
			Text = info[1],
			TextSize = 26,
			BackgroundColor3 = BLUE,
			Parent = cross,
		}, { UI.gloss() })
		button.Activated:Connect(function()
			Sounds.Play("Click")
			Settings.Set("CrossSize", (current.CrossSize or 1) + info[2])
			sizeLabel.Text = "Tamaño " .. string.format("%.1f", current.CrossSize or 1)
		end)
	end
	-- Disparo automático (como el modo sencillo de los shooters de móvil)
	local auto = section(6, "🔫 Disparo automático (con la mira sobre un enemigo)", 92)
	local autoMode = math.floor(current.AutoFire or 2)
	for i, info in { { 2, "Solo en móvil" }, { 1, "Siempre" }, { 0, "No" } } do
		local selected = autoMode == info[1]
		local button = UI.button({
			Position = UDim2.fromOffset(16 + (i - 1) * 150, 44),
			Size = UDim2.fromOffset(140, 36),
			Text = (selected and "✔ " or "") .. info[2],
			TextSize = 18,
			BackgroundColor3 = selected and Color3.fromRGB(60, 170, 90) or BLUE,
			Parent = auto,
		}, { UI.gloss() })
		button.Activated:Connect(function()
			Sounds.Play("Click")
			Settings.Set("AutoFire", info[1])
			refresh()
		end)
	end
	-- Asistencia de apuntado (solo con dedo o mando)
	local assist = section(7, "🎯 Asistencia de apuntado (con dedo o mando)", 92)
	local assistMode = math.floor((current.AimAssist == nil and 2 or current.AimAssist) + 0.5)
	for i, info in { { 2, "Normal" }, { 1, "Suave" }, { 0, "No" } } do
		local selected = assistMode == info[1]
		local button = UI.button({
			Position = UDim2.fromOffset(16 + (i - 1) * 150, 44),
			Size = UDim2.fromOffset(140, 36),
			Text = (selected and "✔ " or "") .. info[2],
			TextSize = 18,
			BackgroundColor3 = selected and Color3.fromRGB(60, 170, 90) or BLUE,
			Parent = assist,
		}, { UI.gloss() })
		button.Activated:Connect(function()
			Sounds.Play("Click")
			Settings.Set("AimAssist", info[1])
			refresh()
		end)
	end
	-- Uniforme militar en los mapas realistas (si no llevas un traje)
	local uniform = section(8, "🪖 Sin traje: uniforme militar o tu avatar (al reaparecer)", 92)
	local uniformMode = math.floor((current.Uniform == nil and 1 or current.Uniform) + 0.5)
	for i, info in { { 1, "Uniforme" }, { 0, "Mi avatar" } } do
		local selected = uniformMode == info[1]
		local button = UI.button({
			Position = UDim2.fromOffset(16 + (i - 1) * 150, 44),
			Size = UDim2.fromOffset(140, 36),
			Text = (selected and "✔ " or "") .. info[2],
			TextSize = 18,
			BackgroundColor3 = selected and Color3.fromRGB(60, 170, 90) or BLUE,
			Parent = uniform,
		}, { UI.gloss() })
		button.Activated:Connect(function()
			Sounds.Play("Click")
			Settings.Set("Uniform", info[1])
			refresh()
		end)
	end
	-- Ventaja (una, gratis)
	local perkSection = section(9, "🎖️ Ventaja", 130)
	local perkNow = math.floor(current.Perk or 0)
	local perkInfo = UI.label({
		Position = UDim2.fromOffset(16, 86),
		Size = UDim2.new(1, -32, 0, 38),
		Text = "Sin ventaja",
		TextSize = 15,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(190, 195, 220),
		Font = UI.FontBody,
		TextStrokeTransparency = 1,
		Parent = perkSection,
	})
	local perkOptions = { { Id = 0, Name = "Ninguna", Icon = "—", Text = "Sin ventaja" } }
	for _, perk in GameConfig.Perks do
		table.insert(perkOptions, perk)
	end
	for i, perk in perkOptions do
		local selected = perkNow == perk.Id
		if selected then
			perkInfo.Text = perk.Text .. (perk.Id ~= 0 and "  ·  (si estás en partida, desde que reaparezcas)" or "")
		end
		local button = UI.button({
			Position = UDim2.fromOffset(16 + (i - 1) * 132, 44),
			Size = UDim2.fromOffset(124, 36),
			Text = perk.Icon .. " " .. perk.Name,
			TextSize = 16,
			BackgroundColor3 = selected and Color3.fromRGB(60, 170, 90) or BLUE,
			Parent = perkSection,
		}, { UI.gloss() })
		button.Activated:Connect(function()
			Sounds.Play("Click")
			Settings.Set("Perk", perk.Id)
			refresh()
		end)
	end
	UI.label({
		LayoutOrder = 8,
		Size = UDim2.new(1, -12, 0, 40),
		Text = "Los ajustes se guardan con tu progreso. La calidad de Roblox (Menú de Roblox → Ajustes → Calidad de gráficos) también influye.",
		TextSize = 14,
		TextWrapped = true,
		TextColor3 = Color3.fromRGB(190, 195, 220),
		Font = UI.FontBody,
		TextStrokeTransparency = 1,
		Parent = scroll,
	})
end

-- Muestra un efecto de eliminación delante de la cámara (oculta el menú, y la pantalla de inicio
-- con su desenfoque si está abierta, durante un momento)
local previewing = false
local function previewKillEffect(effectId)
	if previewing then
		return
	end
	previewing = true
	local camera = workspace.CurrentCamera
	local position = camera.CFrame.Position + camera.CFrame.LookVector * 16
	panel.Visible = false
	local mainGui = player.PlayerGui:FindFirstChild("MainMenu")
	local mainWasEnabled = mainGui and mainGui.Enabled
	local blur = game:GetService("Lighting"):FindFirstChild("MainMenuBlur")
	local blurSize = blur and blur.Size
	if mainGui then
		mainGui.Enabled = false
	end
	if blur then
		blur.Size = 0
	end
	Effects.KillEffect(effectId, position, Color3.fromRGB(255, 200, 60))
	task.delay(2.2, function()
		previewing = false
		if mainGui and mainWasEnabled and ClientState.InMainMenu then
			mainGui.Enabled = true
		end
		if blur and blur.Parent and ClientState.InMainMenu then
			blur.Size = blurSize
		end
		if ClientState.MenuOpen then
			panel.Visible = true
		end
	end)
end

local function buildKillEffectsPage(data)
	local scroll = scroller(UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(200, 230),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}))
	local owned = data.KillEffects or { Default = true }
	for i, id in sortedIds(KillEffects.List, "KillEffect") do
		local effect = KillEffects.List[id]
		local equipped = (data.EquippedKillEffect or "Default") == id
		local card = UI.new("Frame", { LayoutOrder = i, BackgroundColor3 = CARD_BG, Parent = scroll }, {
			UI.corner(12),
			UI.stroke(equipped and GOLD or rarityColor(effect.Rarity), 2, equipped and 0 or 0.4),
		})
		UI.label({ Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 62), Text = effect.Icon, TextSize = 54, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 70), Size = UDim2.new(1, 0, 0, 24), Text = effect.Name, TextSize = 20, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 94),
			Size = UDim2.new(1, 0, 0, 16),
			Text = effect.Rarity,
			TextSize = 14,
			TextColor3 = rarityColor(effect.Rarity),
			Parent = card,
		})
		UI.label({
			Position = UDim2.fromOffset(8, 112),
			Size = UDim2.new(1, -16, 0, 34),
			Text = effect.Description or "",
			TextSize = 13,
			TextWrapped = true,
			TextColor3 = Color3.fromRGB(190, 195, 220),
			Font = UI.FontBody,
			TextStrokeTransparency = 1,
			Parent = card,
		})
		local preview = UI.button({
			Position = UDim2.fromOffset(10, 150),
			Size = UDim2.new(1, -20, 0, 26),
			Text = "👁 Ver efecto",
			TextSize = 15,
			BackgroundColor3 = Color3.fromRGB(70, 60, 120),
			Parent = card,
		})
		preview.Activated:Connect(function()
			Sounds.Play("Click")
			previewKillEffect(id)
		end)
		priceButton(card, "KillEffect", id, owned[id] == true, equipped, function()
			Sounds.Play("Click")
			Remotes.EquipKillEffect:FireServer(id)
		end)
	end

	-- Grafitis (tecla J), en la misma rejilla, después de los efectos
	local header = UI.new("Frame", { LayoutOrder = 999, BackgroundColor3 = Color3.fromRGB(60, 50, 90), Parent = scroll }, { UI.corner(12) })
	UI.label({
		Size = UDim2.fromScale(1, 1),
		Text = "🎨 GRAFITIS\n\nPulsa J (o 🎨 en el móvil) para pintar el tuyo en la pared que tienes delante",
		TextSize = 17,
		TextWrapped = true,
		TextColor3 = GOLD,
		Parent = header,
	}, { UI.new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }) })
	local spraysOwned = data.Sprays or { Default = true }
	for i, id in sortedIds(Sprays.List, "Spray") do
		local sprayDef = Sprays.List[id]
		local equipped = (data.EquippedSpray or "Default") == id
		local card = UI.new("Frame", { LayoutOrder = 1000 + i, BackgroundColor3 = CARD_BG, Parent = scroll }, {
			UI.corner(12),
			UI.stroke(equipped and GOLD or rarityColor(sprayDef.Rarity), 2, equipped and 0 or 0.4),
		})
		local preview = UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 10),
			Size = UDim2.fromOffset(110, 110),
			BackgroundTransparency = 1,
			Parent = card,
		})
		Sprays.Draw(id, preview)
		UI.label({ Position = UDim2.fromOffset(0, 126), Size = UDim2.new(1, 0, 0, 24), Text = sprayDef.Name, TextSize = 20, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 150),
			Size = UDim2.new(1, 0, 0, 16),
			Text = sprayDef.Rarity,
			TextSize = 14,
			TextColor3 = rarityColor(sprayDef.Rarity),
			Parent = card,
		})
		priceButton(card, "Spray", id, Sprays.Owns(spraysOwned, id, data.VIP == true), equipped, function()
			Sounds.Play("Click")
			Remotes.EquipSpray:FireServer(id)
		end, sprayDef.VIPOnly and "👑 Solo VIP" or nil)
	end
end

local function buildOutfitsPage(data)
	local scroll = scroller(UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(200, 250),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}))
	for i, id in sortedIds(Outfits.List, "Outfit") do
		local outfit = Outfits.List[id]
		local owned = data.Outfits[id] == true
		local equipped = data.EquippedOutfit == id
		local card = UI.new("Frame", { LayoutOrder = i, BackgroundColor3 = CARD_BG, Parent = scroll }, {
			UI.corner(12),
			UI.stroke(equipped and GOLD or rarityColor(outfit.Rarity), 2, equipped and 0 or 0.4),
		})
		if id ~= "Default" then
			outfitViewport(id, { Position = UDim2.fromOffset(10, 4), Size = UDim2.fromOffset(180, 140), Parent = card })
		else
			UI.label({ Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 60), Text = "🙂", TextSize = 54, Parent = card })
		end
		UI.label({ Position = UDim2.fromOffset(0, 146), Size = UDim2.new(1, 0, 0, 24), Text = outfit.Name, TextSize = 20, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 170),
			Size = UDim2.new(1, 0, 0, 18),
			Text = outfit.Class .. " · " .. outfit.Rarity,
			TextSize = 14,
			TextColor3 = rarityColor(outfit.Rarity),
			Parent = card,
		})
		priceButton(card, "Outfit", id, owned, equipped, function()
			Sounds.Play("Click")
			Remotes.EquipOutfit:FireServer(id)
		end, outfit.Event)
	end
end

---------------------------------------------------------------------------
-- Pestaña: Tienda (diaria, ofertas, cajas, Robux, VIP)
---------------------------------------------------------------------------

local function itemName(kind, id)
	if kind == "Outfit" then
		return Outfits.Get(id).Name, Outfits.Get(id).Rarity
	elseif kind == "KillEffect" then
		return KillEffects.Get(id).Name, KillEffects.Get(id).Rarity
	end
	return Skins.Get(id).Name, Skins.Get(id).Rarity
end

-- Animación de apertura de caja: una tira de premios que gira y se para en el tuyo
local crateOverlay = nil -- animación de caja en curso (el menú no se puede cerrar hasta acabar)

local function crateAnimation(result)
	local overlay = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.25,
		Active = true, -- los clics no atraviesan (no se compra otra caja sin querer)
		ZIndex = 20,
		Parent = gui,
	})
	crateOverlay = overlay
	UI.new("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true, Parent = overlay })
	local window = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(760, 170),
		BackgroundColor3 = Color3.fromRGB(15, 16, 26),
		ClipsDescendants = true,
		ZIndex = 21,
		Parent = overlay,
	}, { UI.corner(12), UI.stroke(GOLD, 3, 0) })
	local reel = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 15),
		Size = UDim2.fromOffset(40 * 150, 140),
		BackgroundTransparency = 1,
		ZIndex = 22,
		Parent = window,
	}, {
		UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	-- Rellenamos con objetos aleatorios y el premio en la posición 32
	local pool = {}
	for id, skin in Skins.List do
		if id ~= "Default" and not skin.Mastery and not skin.Event then
			table.insert(pool, { "Skin", id })
		end
	end
	for id, outfit in Outfits.List do
		if id ~= "Default" and not outfit.Event then
			table.insert(pool, { "Outfit", id })
		end
	end
	local PRIZE_INDEX = 32
	local prizeCard
	for i = 1, 38 do
		local kind, id
		if i == PRIZE_INDEX then
			kind, id = result.Kind, result.Id
		else
			local pick = pool[math.random(1, #pool)]
			kind, id = pick[1], pick[2]
		end
		local name, rarity = itemName(kind, id)
		local card = UI.new("Frame", {
			LayoutOrder = i,
			Size = UDim2.fromOffset(140, 140),
			BackgroundColor3 = rarityColor(rarity):Lerp(Color3.new(0, 0, 0), 0.55),
			ZIndex = 23,
			Parent = reel,
		}, { UI.corner(10), UI.stroke(rarityColor(rarity), 3, 0) })
		if i == PRIZE_INDEX then
			prizeCard = card
		end
		UI.label({
			Position = UDim2.fromOffset(0, 30),
			Size = UDim2.new(1, 0, 0, 50),
			Text = kind == "Outfit" and "🧥" or "🔫",
			TextSize = 40,
			ZIndex = 24,
			Parent = card,
		})
		UI.label({ Position = UDim2.fromOffset(4, 90), Size = UDim2.new(1, -8, 0, 22), Text = name, TextScaled = true, ZIndex = 24, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 112),
			Size = UDim2.new(1, 0, 0, 18),
			Text = rarity,
			TextSize = 14,
			TextColor3 = rarityColor(rarity),
			ZIndex = 24,
			Parent = card,
		})
	end
	-- Marcador central
	UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.new(0, 4, 1, 0),
		BackgroundColor3 = GOLD,
		BorderSizePixel = 0,
		ZIndex = 30,
		Parent = window,
	})
	local cardStep = 150
	local target = -((PRIZE_INDEX - 1) * cardStep + 70 - 380) + math.random(-50, 50)
	local spin = TweenService:Create(reel, TweenInfo.new(4.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = UDim2.fromOffset(target, 15) })
	spin:Play()
	-- "tic" mientras gira: cada vez más agudo según se acerca al premio (más tensión)
	task.spawn(function()
		local last = 0
		while spin.PlaybackState == Enum.PlaybackState.Playing do
			local index = math.floor(-reel.Position.X.Offset / cardStep)
			if index ~= last then
				last = index
				Sounds.Play("Click", nil, 0.8 + 0.7 * math.clamp(index / PRIZE_INDEX, 0, 1))
			end
			task.wait()
		end
	end)
	spin.Completed:Wait()
	local name, rarity = itemName(result.Kind, result.Id)
	Sounds.Play("Kill")
	-- La carta del premio salta y brilla con el color de su rareza
	if prizeCard then
		local pop = UI.new("UIScale", { Scale = 1, Parent = prizeCard })
		TweenService:Create(pop, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 1, true), { Scale = 1.12 }):Play()
		local stroke = prizeCard:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Thickness = 6
		end
	end
	local glow = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(760, 170),
		BackgroundColor3 = rarityColor(rarity),
		BackgroundTransparency = 0.3,
		ZIndex = 20,
		Parent = overlay,
	}, { UI.corner(16) })
	TweenService:Create(glow, TweenInfo.new(0.6, Enum.EasingStyle.Quad), { Size = UDim2.fromOffset(980, 330), BackgroundTransparency = 1 }):Play()
	-- Épico o mejor (y nuevo): ¡celebración! Si no, un destello del color de la rareza
	local rare = rarity == "Épico" or rarity == "Legendario" or rarity == "Mítico"
	if rare and not result.Duplicate then
		RewardFX.Celebrate("¡" .. UI.upper(rarity) .. "!", name, rarityColor(rarity), rarity ~= "Épico")
	else
		RewardFX.EdgeFlash(rarityColor(rarity), 0.45)
	end
	local title = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.45, 100),
		Size = UDim2.fromOffset(700, 50),
		Text = result.Duplicate and ("Repetido: " .. name .. "  ·  +" .. result.Refund .. " monedas") or ("¡" .. name .. "! (" .. rarity .. ")"),
		TextSize = 34,
		TextColor3 = rarityColor(rarity),
		TextStrokeTransparency = 0,
		ZIndex = 25,
		Parent = overlay,
	})
	local scale = UI.new("UIScale", { Scale = 1.6, Parent = title })
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	local close = UI.button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.45, 160),
		Size = UDim2.fromOffset(220, 46),
		Text = "¡Genial!",
		BackgroundColor3 = GREEN,
		ZIndex = 25,
		Parent = overlay,
	}, { UI.gloss() })
	close.Activated:Connect(function()
		overlay:Destroy()
		crateOverlay = nil
		busy = false
	end)
end

local function openCrate(crateId, useFree)
	if busy then
		return
	end
	busy = true
	local ok, success, result = pcall(function()
		return Remotes.OpenCrate:InvokeServer(crateId, useFree)
	end)
	if ok and success and type(result) == "table" then
		-- busy sigue activo hasta cerrar la animación (no se puede abrir otra mientras gira)
		crateAnimation(result)
	else
		busy = false
		showToast(ok and tostring(result) or "Error de conexión", Color3.fromRGB(255, 90, 90))
	end
end

local function sectionTitle(parent, text, order)
	return UI.label({
		LayoutOrder = order,
		Size = UDim2.new(1, -10, 0, 30),
		Text = text,
		TextSize = 24,
		TextColor3 = GOLD,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = parent,
	})
end

-- Fila de tarjetas: si no caben (pantallas estrechas) pasan a la línea siguiente
local function row(parent, order, height)
	return UI.new("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, -10, 0, height),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Wraps = true,
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
end

local function buildShopPage(data)
	local scroll = scroller(UI.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }))

	-- Pack de inicio (solo jugadores nuevos, una vez)
	local starter = Shop.StarterPack
	if data.StarterPackAvailable then
		local card = UI.new("Frame", {
			LayoutOrder = 0,
			Size = UDim2.new(1, -10, 0, 130),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			Parent = scroll,
		}, {
			UI.corner(14),
			UI.stroke(GOLD, 3, 0),
			UI.new("UIGradient", {
				Color = ColorSequence.new(Color3.fromRGB(255, 90, 40), Color3.fromRGB(150, 40, 200)),
				Rotation = 0,
			}),
		})
		UI.label({
			Position = UDim2.fromOffset(18, 8),
			Size = UDim2.new(1, -280, 0, 36),
			Text = "🔥 PACK DE INICIO  ·  solo una vez",
			TextSize = 28,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		UI.label({
			Position = UDim2.fromOffset(18, 48),
			Size = UDim2.new(1, -280, 0, 72),
			Text = string.format(
				"🪙 %d monedas  ·  👕 Traje %s  ·  🎨 Skin %s  ·  %s Efecto %s\n¡Vale más de 4 veces su precio!",
				starter.Coins,
				Outfits.Get(starter.Outfit).Name,
				Skins.Get(starter.Skin).Name,
				KillEffects.Get(starter.KillEffect).Icon,
				KillEffects.Get(starter.KillEffect).Name
			),
			TextSize = 18,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = card,
		})
		local buyStarter = UI.button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -18, 0.5, 0),
			Size = UDim2.fromOffset(230, 60),
			Text = starter.ProductId ~= 0 and ("R$ " .. starter.Robux .. "  ¡COMPRAR!") or "Próximamente",
			TextSize = 24,
			BackgroundColor3 = starter.ProductId ~= 0 and GREEN or GREY,
			Parent = card,
		}, { UI.gloss() })
		buyStarter.Activated:Connect(function()
			if not buyStarter.Active then
				return
			end
			if starter.ProductId ~= 0 then
				Sounds.Play("Click")
				-- Un solo intento hasta que llegue la respuesta del servidor (la página se rehace)
				buyStarter.Active = false
				buyStarter.AutoButtonColor = false
				buyStarter.Text = "Procesando..."
				MarketplaceService:PromptProductPurchase(player, starter.ProductId)
			else
				showToast("Próximamente")
			end
		end)
	end

	-- Packs de temporada (compra única, solo en sus fechas; el servidor dice cuáles se ofrecen)
	for bundleIndex, bundle in ipairs(Shop.Bundles) do
	if table.find(data.BundlesAvailable or {}, bundle.Id) and os.time() < (bundle.EndsAt or math.huge) then
		local daysLeft = bundle.EndsAt and math.max(0, math.ceil((bundle.EndsAt - os.time()) / 86400)) or 99
		local card = UI.new("Frame", {
			LayoutOrder = -10 + bundleIndex,
			Size = UDim2.new(1, -10, 0, 130),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			Parent = scroll,
		}, {
			UI.corner(14),
			UI.stroke(Color3.fromRGB(255, 150, 30), 3, 0),
			UI.new("UIGradient", {
				Color = ColorSequence.new(bundle.Colors[1], bundle.Colors[2]),
				Rotation = 0,
			}),
		})
		UI.label({
			Position = UDim2.fromOffset(18, 8),
			Size = UDim2.new(1, -280, 0, 36),
			Text = bundle.Icon .. " " .. bundle.Name .. "  ·  " .. (not bundle.EndsAt and "¡NUEVO!" or (daysLeft <= 1 and "¡ÚLTIMO DÍA!" or ("quedan " .. daysLeft .. " días"))),
			TextSize = 26,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		UI.label({
			Position = UDim2.fromOffset(18, 48),
			Size = UDim2.new(1, -280, 0, 72),
			Text = (function()
				-- (los packs con trajes los nombran primero)
				local names = {}
				for _, outfitId in bundle.Outfits or {} do
					table.insert(names, Outfits.Get(outfitId).Name)
				end
				local last = table.remove(names)
				return last and ("👕 Trajes " .. (#names > 0 and (table.concat(names, ", ") .. " y ") or "") .. last .. "  ·  ") or ""
			end)() .. string.format(
				"🪙 %d monedas  ·  %s Efecto %s  ·  %s Colgante %s  ·  🎨 Grafiti %s\n¡Todo vale %d monedas! Solo se puede comprar una vez.",
				bundle.Coins,
				KillEffects.Get(bundle.KillEffect).Icon,
				KillEffects.Get(bundle.KillEffect).Name,
				Charms.Get(bundle.Charm).Icon,
				Charms.Get(bundle.Charm).Name,
				Sprays.Get(bundle.Spray).Name,
				bundle.Value
			),
			TextSize = 18,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = card,
		})
		local buyBundle = UI.button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -18, 0.5, 0),
			Size = UDim2.fromOffset(230, 60),
			Text = "R$ " .. bundle.Robux .. "  ¡COMPRAR!",
			TextSize = 24,
			BackgroundColor3 = GREEN,
			Parent = card,
		}, { UI.gloss() })
		buyBundle.Activated:Connect(function()
			if not buyBundle.Active then
				return
			end
			Sounds.Play("Click")
			buyBundle.Active = false
			buyBundle.AutoButtonColor = false
			buyBundle.Text = "Procesando..."
			MarketplaceService:PromptProductPurchase(player, bundle.ProductId)
			-- (si la compra no llega a entregarse, el botón vuelve a funcionar)
			task.delay(20, function()
				if buyBundle.Parent and buyBundle.Text == "Procesando..." then
					buyBundle.Active = true
					buyBundle.AutoButtonColor = true
					buyBundle.Text = "R$ " .. bundle.Robux .. "  ¡COMPRAR!"
				end
			end)
		end)
	end
	end

	-- Recompensa diaria
	local daily = UI.new("Frame", {
		LayoutOrder = 1,
		Size = UDim2.new(1, -10, 0, 118),
		BackgroundColor3 = Color3.fromRGB(40, 60, 40),
		Parent = scroll,
	}, { UI.corner(12), UI.stroke(Color3.fromRGB(90, 230, 110), 2, 0) })
	local streak = data.DailyStreak or 0
	-- (el servidor dice qué día toca: si se saltó uno, la racha vuelve a empezar)
	local nextDay = data.DailyAvailable and (data.DailyNext or ((streak % #Shop.DailyRewards) + 1)) or streak
	UI.label({
		Position = UDim2.fromOffset(16, 0),
		Size = UDim2.new(1, -260, 0, 56),
		Text = "🎁 Recompensa diaria · Día " .. tostring(nextDay) .. "/" .. #Shop.DailyRewards .. "  (día 7: caja gratis)"
			.. ((GameConfig.CurrentEvent() and (GameConfig.EventDailyBonus or 0) > 0) and ("  + " .. GameConfig.EventDailyBonus .. " " .. (GameConfig.CurrentEvent().ItemIcon or GameConfig.CurrentEvent().Icon)) or ""),
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = daily,
	})
	local claim = UI.button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(220, 46),
		Text = data.DailyAvailable and "¡Reclamar!" or "Vuelve mañana",
		BackgroundColor3 = data.DailyAvailable and GREEN or GREY,
		Parent = daily,
	}, { UI.gloss() })
	claim.Activated:Connect(function()
		Menu.ClaimDaily()
	end)
	-- Tira de los 7 días: los recogidos con ✓, el de hoy destacado (da ganas de no romper la racha)
	local strip = UI.new("Frame", {
		Position = UDim2.fromOffset(16, 58),
		Size = UDim2.new(1, -260, 0, 50),
		BackgroundTransparency = 1,
		Parent = daily,
	}, {
		UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for day, coins in Shop.DailyRewards do
		local claimed = (data.DailyAvailable and day < nextDay) or (not data.DailyAvailable and day <= streak)
		local today = data.DailyAvailable and day == nextDay
		local cell = UI.new("Frame", {
			LayoutOrder = day,
			Size = UDim2.new(1 / #Shop.DailyRewards, -6, 1, 0), -- (se reparten el ancho: caben en el móvil)
			BackgroundColor3 = claimed and Color3.fromRGB(40, 110, 60) or (today and Color3.fromRGB(110, 90, 20) or Color3.fromRGB(30, 40, 30)),
			Parent = strip,
		}, { UI.corner(8), UI.stroke(today and GOLD or Color3.fromRGB(80, 120, 80), today and 3 or 1, 0) })
		-- (texto que llena la celda: en el móvil el menú se encoge y a tamaño fijo no se leía)
		UI.label({
			Size = UDim2.new(1, -6, 0.45, 0),
			Position = UDim2.new(0, 3, 0, 2),
			Text = claimed and "✓" or ("Día " .. day),
			TextScaled = true,
			Parent = cell,
		}, { UI.new("UITextSizeConstraint", { MaxTextSize = 20 }) })
		UI.label({
			Size = UDim2.new(1, -6, 0.48, 0),
			Position = UDim2.new(0, 3, 0.5, 0),
			Text = (day == Shop.DailyCrateDay and "🎁" or "🪙") .. coins,
			TextScaled = true,
			TextColor3 = GOLD,
			Parent = cell,
		}, { UI.new("UITextSizeConstraint", { MaxTextSize = 20 }) })
		if today then
			-- (el de hoy late)
			local pulse = UI.new("UIScale", { Parent = cell })
			local beat = TweenService:Create(pulse, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.08 })
			beat:Play()
			cell.Destroying:Connect(function()
				beat:Cancel() -- (el latido es infinito: se para al rehacer la página)
			end)
		end
	end

	-- Ofertas del día
	sectionTitle(scroll, "🔥 Ofertas de hoy (-" .. math.floor(Shop.OfferDiscount * 100) .. "%)", 2)
	local offers = row(scroll, 3, 190)
	for i, offer in Shop.GetDailyOffers(data.Day) do
		local name, rarity = itemName(offer.Kind, offer.Id)
		local owned
		if offer.Kind == "Skin" then
			owned = data.Skins[offer.Id] == true
		elseif offer.Kind == "KillEffect" then
			owned = data.KillEffects ~= nil and data.KillEffects[offer.Id] == true
		else
			owned = data.Outfits[offer.Id] == true
		end
		local card = UI.new("Frame", { LayoutOrder = i, Size = UDim2.fromOffset(200, 190), BackgroundColor3 = CARD_BG, Parent = offers }, {
			UI.corner(12),
			UI.stroke(rarityColor(rarity), 2, 0),
		})
		if offer.Kind == "Skin" then
			WeaponIcon.Create(data.Primary or "ARX27", offer.Id, { Position = UDim2.fromOffset(8, 6), Size = UDim2.fromOffset(184, 80), Parent = card }, "angled", 184 / 80)
		elseif offer.Kind == "KillEffect" then
			local icon = UI.button({
				Position = UDim2.fromOffset(50, 6),
				Size = UDim2.fromOffset(100, 80),
				Text = KillEffects.Get(offer.Id).Icon,
				TextSize = 56,
				BackgroundTransparency = 1,
				Parent = card,
			})
			icon.Activated:Connect(function()
				previewKillEffect(offer.Id)
			end)
		else
			outfitViewport(offer.Id, { Position = UDim2.fromOffset(50, 2), Size = UDim2.fromOffset(100, 90), Parent = card })
		end
		UI.label({ Position = UDim2.fromOffset(0, 92), Size = UDim2.new(1, 0, 0, 24), Text = name, TextSize = 19, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 116),
			Size = UDim2.new(1, 0, 0, 18),
			Text = (offer.Kind == "Outfit" and "Traje · " or offer.Kind == "KillEffect" and "Efecto · " or "Skin · ") .. rarity,
			TextSize = 14,
			TextColor3 = rarityColor(rarity),
			Parent = card,
		})
		priceButton(card, offer.Kind, offer.Id, owned, false, function()
			Sounds.Play("Click")
			if offer.Kind == "Skin" then
				Remotes.EquipSkin:FireServer(offer.Id)
			elseif offer.Kind == "KillEffect" then
				Remotes.EquipKillEffect:FireServer(offer.Id)
			else
				Remotes.EquipOutfit:FireServer(offer.Id)
			end
		end)
	end

	-- Cajas
	sectionTitle(scroll, "🎁 Cajas", 4)
	local crates = row(scroll, 5, 150)
	for crateId, crate in Shop.Crates do
		local card = UI.new("Frame", { Size = UDim2.fromOffset(480, 150), BackgroundColor3 = Color3.fromRGB(50, 30, 80), Parent = crates }, {
			UI.corner(12),
			UI.stroke(Color3.fromRGB(190, 80, 255), 2, 0),
			UI.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(140, 100, 255)), Rotation = 30 }),
		})
		UI.label({
			Position = UDim2.fromOffset(16, 8),
			Size = UDim2.fromOffset(300, 30),
			Text = "🎁 " .. crate.Name,
			TextSize = 26,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		local oddsText = {}
		for _, entry in crate.Odds do
			table.insert(oddsText, entry.Rarity .. " " .. entry.Weight .. "%")
		end
		UI.label({
			Position = UDim2.fromOffset(16, 40),
			Size = UDim2.fromOffset(450, 36),
			Text = "Probabilidades: "
				.. table.concat(oddsText, " · ")
				.. "\nSkins y trajes. Si repites, recuperas el "
				.. math.floor(crate.DuplicateRefund * 100)
				.. "%.",
			TextSize = 14,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = UI.FontBody,
			TextStrokeTransparency = 1,
			Parent = card,
		})
		local buyCrate = UI.button({
			Position = UDim2.fromOffset(16, 90),
			Size = UDim2.fromOffset(210, 46),
			Text = data.CratesRestricted and "No disponible" or ("Abrir · " .. coinsText(crate.Price)),
			BackgroundColor3 = data.CratesRestricted and GREY or Color3.fromRGB(230, 140, 20),
			Parent = card,
		}, { UI.gloss() })
		buyCrate.Activated:Connect(function()
			if not data.CratesRestricted then
				openCrate(crateId, false)
			end
		end)
		local free = UI.button({
			Position = UDim2.fromOffset(240, 90),
			Size = UDim2.fromOffset(220, 46),
			Text = "Gratis (" .. tostring(data.FreeCrates or 0) .. ")",
			BackgroundColor3 = (data.FreeCrates or 0) > 0 and GREEN or GREY,
			Parent = card,
		}, { UI.gloss() })
		free.Activated:Connect(function()
			if (data.FreeCrates or 0) > 0 then
				openCrate(crateId, true)
			end
		end)
	end

	-- Monedas con Robux
	coinsSection = sectionTitle(scroll, "🪙 Monedas", 6)
	local packs = row(scroll, 7, 170)
	for i, pack in Shop.CoinPacks do
		local card = UI.new("Frame", { LayoutOrder = i, Size = UDim2.fromOffset(200, 170), BackgroundColor3 = Color3.fromRGB(60, 50, 20), Parent = packs }, {
			UI.corner(12),
			UI.stroke(GOLD, 2, 0),
			UI.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 160, 60)), Rotation = 90 }),
		})
		UI.label({ Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 44), Text = string.rep("🪙", math.min(i + 1, 4)), TextSize = 30, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 56), Size = UDim2.new(1, 0, 0, 30), Text = tostring(pack.Coins), TextSize = 30, TextColor3 = GOLD, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 86), Size = UDim2.new(1, 0, 0, 20), Text = pack.Name, TextSize = 16, Parent = card })
		if pack.Tag then
			UI.label({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -6, 0, 4),
				Size = UDim2.fromOffset(120, 18),
				Text = pack.Tag,
				TextSize = 13,
				TextColor3 = Color3.fromRGB(120, 255, 140),
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = card,
			})
		end
		local buyPack = UI.button({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.new(1, -20, 0, 40),
			Text = pack.ProductId ~= 0 and ("R$ " .. pack.Robux) or "Próximamente",
			BackgroundColor3 = pack.ProductId ~= 0 and GREEN or GREY,
			Parent = card,
		}, { UI.gloss() })
		buyPack.Activated:Connect(function()
			if pack.ProductId ~= 0 then
				MarketplaceService:PromptProductPurchase(player, pack.ProductId)
			end
		end)
	end

	-- Revivir instantáneo con Robux (vuelves a la acción justo donde caíste)
	local PINK_REVIVE = Color3.fromRGB(255, 70, 200)
	sectionTitle(scroll, "💖 Revivir instantáneo", 8)
	local revives = row(scroll, 9, 150)
	for i, pack in Shop.RevivePacks do
		local card = UI.new("Frame", { LayoutOrder = i, Size = UDim2.fromOffset(200, 150), BackgroundColor3 = Color3.fromRGB(70, 20, 60), Parent = revives }, {
			UI.corner(12),
			UI.stroke(PINK_REVIVE, 2, 0),
			UI.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 80, 170)), Rotation = 90 }),
		})
		UI.label({ Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 40), Text = string.rep("💖", i + 1), TextSize = 28, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 48), Size = UDim2.new(1, 0, 0, 30), Text = "x" .. pack.Revives, TextSize = 30, TextColor3 = Color3.fromRGB(255, 200, 240), Parent = card })
		if pack.Tag then
			UI.label({ Position = UDim2.fromOffset(0, 78), Size = UDim2.new(1, 0, 0, 18), Text = pack.Tag, TextSize = 13, TextColor3 = Color3.fromRGB(120, 255, 140), Parent = card })
		end
		local buyRevive = UI.button({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.new(1, -20, 0, 40),
			Text = pack.ProductId ~= 0 and ("R$ " .. pack.Robux) or "Próximamente",
			BackgroundColor3 = pack.ProductId ~= 0 and GREEN or GREY,
			Parent = card,
		}, { UI.gloss() })
		buyRevive.Activated:Connect(function()
			if pack.ProductId ~= 0 then
				MarketplaceService:PromptProductPurchase(player, pack.ProductId)
			end
		end)
	end

	-- VIP
	local vip = UI.new("Frame", {
		LayoutOrder = 10,
		Size = UDim2.new(1, -10, 0, 90),
		BackgroundColor3 = Color3.fromRGB(70, 50, 10),
		Parent = scroll,
	}, {
		UI.corner(12),
		UI.stroke(GOLD, 3, 0),
		UI.new("UIGradient", { Color = ColorSequence.new(GOLD, Color3.fromRGB(120, 60, 200)), Rotation = 0 }),
	})
	UI.label({
		Position = UDim2.fromOffset(16, 6),
		Size = UDim2.new(1, -280, 0, 34),
		Text = "👑 VIP",
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = vip,
	})
	UI.label({
		Position = UDim2.fromOffset(16, 42),
		Size = UDim2.new(1, -280, 0, 40),
		Text = "x2 XP · x2 monedas · caja gratis cada día · grafiti 👑 exclusivo",
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = vip,
	})
	local vipText = "Próximamente"
	if data.VIP then
		vipText = "✔ Ya eres VIP"
	elseif Shop.VIPPassId ~= 0 then
		vipText = "Hazte VIP · R$ " .. Shop.VIPRobux
	end
	local vipButton = UI.button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(240, 52),
		Text = vipText,
		BackgroundColor3 = data.VIP and GREEN or (Shop.VIPPassId ~= 0 and GOLD or GREY),
		TextColor3 = Color3.fromRGB(30, 20, 0),
		Parent = vip,
	}, { UI.gloss() })
	vipButton.Activated:Connect(function()
		if not data.VIP and Shop.VIPPassId ~= 0 then
			MarketplaceService:PromptGamePassPurchase(player, Shop.VIPPassId)
		end
	end)

	-- Potenciadores con Robux (su tiempo solo corre jugando)
	sectionTitle(scroll, "⚡ Potenciadores (el tiempo solo corre mientras juegas)", 12)
	local boosters = row(scroll, 13, 150)
	local BOOST_BLUE = Color3.fromRGB(70, 170, 255)
	for i, booster in Shop.Boosters do
		local left = tonumber(data[booster.Field]) or 0
		local card = UI.new("Frame", { LayoutOrder = i, Size = UDim2.fromOffset(220, 150), BackgroundColor3 = Color3.fromRGB(20, 40, 70), Parent = boosters }, {
			UI.corner(12),
			UI.stroke(left > 0 and GREEN or BOOST_BLUE, 2, 0),
			UI.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(90, 150, 230)), Rotation = 90 }),
		})
		UI.label({ Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 36), Text = booster.Icon .. " x" .. booster.Multiplier, TextSize = 28, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 0, 22), Text = booster.Name .. " · " .. booster.Minutes .. " min", TextSize = 17, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 68),
			Size = UDim2.new(1, 0, 0, 18),
			Text = left > 0 and ("✔ Activo: quedan " .. math.ceil(left / 60) .. " min") or "Se acumula si compras más",
			TextSize = 13,
			Font = UI.FontBody,
			TextColor3 = left > 0 and Color3.fromRGB(120, 255, 140) or Color3.fromRGB(190, 200, 230),
			Parent = card,
		})
		local buyBoost = UI.button({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.new(1, -20, 0, 40),
			Text = booster.ProductId ~= 0 and ("R$ " .. booster.Robux) or "Próximamente",
			BackgroundColor3 = booster.ProductId ~= 0 and GREEN or GREY,
			Parent = card,
		}, { UI.gloss() })
		buyBoost.Activated:Connect(function()
			if booster.ProductId ~= 0 then
				MarketplaceService:PromptProductPurchase(player, booster.ProductId)
			end
		end)
	end

	-- Roblox Premium (bonus pequeño; la suscripción la cobra Roblox)
	local premiumConfig = GameConfig.RobloxPremium
	if premiumConfig then
		local isPremium = player:GetAttribute("RobloxPremium") == true
		local premiumCard = UI.new("Frame", {
			LayoutOrder = 11,
			Size = UDim2.new(1, -10, 0, 70),
			BackgroundColor3 = Color3.fromRGB(30, 34, 56),
			Parent = scroll,
		}, { UI.corner(12), UI.stroke(Color3.fromRGB(150, 160, 200), 2, 0) })
		UI.label({
			Position = UDim2.fromOffset(16, 4),
			Size = UDim2.new(1, -280, 0, 32),
			Text = utf8.char(0xE001) .. " Roblox Premium", -- (icono oficial de Premium)
			TextSize = 24,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = premiumCard,
		})
		UI.label({
			Position = UDim2.fromOffset(16, 36),
			Size = UDim2.new(1, -280, 0, 26),
			Text = "+" .. math.floor((premiumConfig.Multiplier - 1) * 100 + 0.5) .. "% monedas y XP en cada partida (también con VIP)",
			TextSize = 16,
			Font = UI.FontBody,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = premiumCard,
		})
		local premiumButton = UI.button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -16, 0.5, 0),
			Size = UDim2.fromOffset(240, 44),
			Text = isPremium and "✔ Bonus activo" or "Hazte Premium",
			BackgroundColor3 = isPremium and GREEN or Color3.fromRGB(150, 160, 200),
			TextColor3 = Color3.fromRGB(20, 20, 30),
			Parent = premiumCard,
		}, { UI.gloss() })
		premiumButton.Activated:Connect(function()
			if not isPremium then
				pcall(function()
					MarketplaceService:PromptPremiumPurchase(player)
				end)
			end
		end)
	end
end

---------------------------------------------------------------------------

local lastBuiltTab = nil

function refresh()
	if not content then
		return
	end
	-- Si se reconstruye la misma pestaña, se mantiene la posición del scroll
	local keepScroll = nil
	if lastBuiltTab == currentTab then
		local old = content:FindFirstChildOfClass("ScrollingFrame")
		keepScroll = old and old.CanvasPosition
	end
	lastBuiltTab = currentTab
	for _, child in content:GetChildren() do
		child:Destroy()
	end
	local data = ClientState.Data
	if headerInfo then
		headerInfo.Text = data and ("Nivel " .. data.Level .. "   " .. coinsText(data.Coins) .. (data.VIP and "   👑" or "")) or "Cargando..."
	end
	for name, button in tabButtons do
		button.BackgroundColor3 = name == currentTab and BLUE or CARD_BG
	end
	-- Aviso en Perfil si hay logros por reclamar
	if tabButtons.Perfil and data then
		local claimable = claimableAchievements(data)
		tabButtons.Perfil.Text = claimable > 0 and ("Perfil 🔴" .. claimable) or "Perfil"
	end
	-- Y en Tienda si hay algo gratis esperando (premio diario o cajas gratis): da ganas de entrar
	if tabButtons.Tienda and data then
		local free = (data.DailyAvailable and 1 or 0) + (data.FreeCrates or 0)
		tabButtons.Tienda.Text = free > 0 and ("🛒 Tienda 🔴" .. free) or "🛒 Tienda"
	end
	if not data then
		scrollToCoins = false
		UI.label({ Size = UDim2.fromScale(1, 1), Text = "Cargando datos...", TextSize = 24, Parent = content })
		return
	end
	if currentTab == "Perfil" then
		buildProfilePage(data)
	elseif currentTab == "Pase" then
		buildPassPage(data)
	elseif currentTab == "Retos" then
		buildChallengesPage(data)
	elseif currentTab == "Armas" then
		buildWeaponsPage(data)
	elseif currentTab == "Skins" then
		buildSkinsPage(data)
	elseif currentTab == "Trajes" then
		buildOutfitsPage(data)
	elseif currentTab == "Efectos" then
		buildKillEffectsPage(data)
	elseif currentTab == "Ajustes" then
		buildSettingsPage()
	else
		buildShopPage(data)
	end
	if keepScroll then
		local scroll = content:FindFirstChildOfClass("ScrollingFrame")
		if scroll then
			task.defer(function()
				scroll.CanvasPosition = keepScroll
			end)
		end
	elseif scrollToCoins and currentTab == "Tienda" then
		scrollToCoins = false
		local scroll = content:FindFirstChildOfClass("ScrollingFrame")
		local title = coinsSection
		if scroll and title then
			task.delay(0.05, function() -- (cuando la lista ya ha colocado las tarjetas)
				if title.Parent then
					local scale = panelScale and panelScale.Scale or 1
					local y = (title.AbsolutePosition.Y - scroll.AbsolutePosition.Y) / math.max(scale, 0.1) + scroll.CanvasPosition.Y - 8
					scroll.CanvasPosition = Vector2.new(0, math.max(0, y))
				end
			end)
		end
	end
end

local menuModal -- botón Modal a nivel de pantalla: libera el ratón aunque el panel esté oculto

local function setOpen(open)
	if not open and crateOverlay then
		return -- no se cierra a mitad de abrir una caja
	end
	ClientState.MenuOpen = open
	if not open then
		ClientState.MenuClosedAt = os.clock()
	end
	panel.Visible = open
	if menuModal then
		menuModal.Visible = open
	end
	ClientState.UpdateMouse()
	if open then
		refresh()
	end
end

function Menu.Toggle()
	-- Durante la vista previa de un efecto el panel está oculto pero el menú sigue abierto
	setOpen(not ClientState.MenuOpen)
end

-- Abre el menú directamente en una pestaña
function Menu.Open(tab)
	if tab then
		currentTab = tab
	end
	setOpen(true)
end

function Menu.Close()
	if ClientState.MenuOpen then
		setOpen(false)
	end
end

function Menu.IsOpen()
	return panel ~= nil and ClientState.MenuOpen
end

-- Recoge la recompensa diaria (también se usa desde la pantalla de inicio)
function Menu.ClaimDaily()
	if busy then
		return false
	end
	busy = true
	local ok, success, result = pcall(function()
		return Remotes.ClaimDaily:InvokeServer()
	end)
	busy = false
	if ok and success and type(result) == "table" then
		Sounds.Play("Kill")
		showToast("Día " .. result.Streak .. ": +" .. result.Coins .. " monedas" .. (result.Crate and " y una caja gratis 🎁" or ""), GOLD)
		RewardFX.Celebrate("🎁 ¡DÍA " .. tostring(result.Streak) .. "!", "+" .. tostring(result.Coins) .. " 🪙" .. (result.Crate and "  y una caja gratis" or "") .. "  ·  ¡Vuelve mañana!", GOLD, result.Crate == true)
		return true
	end
	showToast("Ya la has recogido hoy. ¡Vuelve mañana!")
	return false
end

function Menu.Init()
	gui = UI.new("ScreenGui", {
		Name = "Menu",
		ResetOnSpawn = false,
		DisplayOrder = 5,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})

	-- Botón superior (útil en móvil)
	-- (en el teléfono, pequeño: debajo del minimapa y sin tapar nada)
	UI.WaitViewport()
	local phone = UI.IsPhone()
	local open = UI.button({
		Position = UDim2.fromOffset(16, 58),
		Size = phone and UDim2.fromOffset(96, 28) or UDim2.fromOffset(210, 38),
		Text = phone and "⭐ TIENDA" or "⭐ PASE · TIENDA",
		BackgroundColor3 = Color3.fromRGB(255, 120, 30),
		TextSize = phone and 14 or 18,
		Parent = gui,
	}, { UI.stroke(Color3.new(0, 0, 0), 2, 0.3), UI.gloss() })
	open.Activated:Connect(Menu.Toggle)
	-- En la pantalla de inicio no hace falta (ya tiene su botón TIENDA) y taparía el título
	task.spawn(function()
		while open.Parent do
			open.Visible = not ClientState.InMainMenu
			-- Debajo del minimapa durante la partida
			local playing = game:GetService("ReplicatedStorage"):GetAttribute("State") == "Playing"
			open.Position = UDim2.fromOffset(phone and 14 or 16, (playing and ClientState.MinimapBottom) and ClientState.MinimapBottom + (phone and 6 or 8) or 58)
			task.wait(0.25)
		end
	end)

	panel = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.new(0.92, 0, 0.84, 0),
		BackgroundColor3 = PANEL_BG,
		Active = true, -- los clics y toques no atraviesan el panel
		Visible = false,
		Parent = gui,
	}, {
		UI.corner(16),
		UI.stroke(Color3.fromRGB(255, 140, 40), 3, 0),
		UI.padding(16),
		UI.new("UISizeConstraint", { MaxSize = Vector2.new(1100, 640) }),
		UI.new("UIGradient", {
			Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 120, 200)),
			Rotation = 120,
		}),
	})

	-- Botón "Modal": libera el ratón en primera persona mientras el menú está abierto
	menuModal = UI.new("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true, Visible = false, Parent = gui })

	-- En pantallas pequeñas (móviles) todo el panel se escala para que quepa entero
	panelScale = UI.new("UIScale", { Parent = panel })
	local function rescalePanel()
		local viewport = workspace.CurrentCamera.ViewportSize
		local s = math.clamp(math.min(viewport.X / 1150, viewport.Y / 700), 0.5, 1)
		panelScale.Scale = s
		panel.Size = UDim2.fromScale(math.min(0.92 / s, 1 / s), math.min(0.84 / s, 0.95 / s))
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescalePanel)
	rescalePanel()

	UI.label({
		Size = UDim2.fromOffset(400, 36),
		Text = "⚡ " .. GameConfig.GameTitle,
		TextSize = 32,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(255, 170, 50),
		Parent = panel,
	})
	headerInfo = UI.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -50, 0, 0),
		Size = UDim2.fromOffset(360, 36),
		Text = "",
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = panel,
	})
	local close = UI.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(36, 36),
		Text = "✕",
		BackgroundColor3 = Color3.fromRGB(220, 60, 60),
		Parent = panel,
	})
	close.Activated:Connect(function()
		setOpen(false)
	end)

	-- Barra de pestañas con desplazamiento horizontal (en pantallas estrechas no caben todas)
	local tabs = UI.new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 0, 42),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 3,
		Parent = panel,
	}, {
		UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i, name in TABS do
		local button = UI.button({
			LayoutOrder = i,
			Size = UDim2.fromOffset(name == "Ajustes" and 52 or 112, 38),
			Text = name == "Tienda" and "🛒 Tienda" or name == "Retos" and "🎯 Retos" or name == "Efectos" and "💥 Efectos" or name == "Ajustes" and "⚙" or name,
			BackgroundColor3 = CARD_BG,
			Parent = tabs,
		})
		button.Activated:Connect(function()
			currentTab = name
			Sounds.Play("Click")
			refresh()
		end)
		tabButtons[name] = button
	end

	content = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 96),
		Size = UDim2.new(1, 0, 1, -96),
		BackgroundTransparency = 1,
		Parent = panel,
	})

	toast = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -20),
		Size = UDim2.fromOffset(700, 36),
		Text = "",
		TextSize = 24,
		TextStrokeTransparency = 0,
		Visible = false,
		ZIndex = 40,
		Parent = gui,
	})

	ContextActionService:BindAction("Menu", function(_, state)
		-- Muerto, la B es "Revivir instantáneo" (pantalla de muerte); solo sirve para cerrar la tienda
		-- (con la ruleta, las novedades o la tarjeta de controles abiertas no se abre la tienda detrás)
		local covered = ClientState.WheelOpen or ClientState.NewsOpen or ClientState.TutorialOpen
		if state == Enum.UserInputState.Begin and (not ClientState.Dead or ClientState.MenuOpen) and not (covered and not ClientState.MenuOpen) then
			Menu.Toggle()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.B, Enum.KeyCode.ButtonSelect)

	-- Si se cancela la compra del pack de inicio, el botón vuelve a estar disponible
	MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, purchased)
		local single = productId == Shop.StarterPack.ProductId
		for _, bundle in Shop.Bundles do
			single = single or productId == bundle.ProductId
		end
		if userId == player.UserId and single and not purchased and ClientState.MenuOpen then
			refresh()
		end
	end)

	-- Una baja puede mandar varias actualizaciones seguidas: se agrupan en una sola reconstrucción
	local refreshQueued = false
	ClientState.DataChanged.Event:Connect(function()
		if not panel.Visible or refreshQueued then
			return
		end
		refreshQueued = true
		task.delay(0.4, function()
			refreshQueued = false
			if panel.Visible then
				refresh()
			end
		end)
	end)
end

return Menu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="117">
            <Properties>
              <string name="Name">Minimap</string>
              <string name="Source"><![CDATA[-- Minimapa (arriba a la izquierda, como en los shooters de móvil): el mapa visto desde arriba con
-- los edificios y muros, tú en el centro (la flecha mira hacia donde miras), tus compañeros en azul,
-- los enemigos que disparan sin silenciador como puntos rojos durante unos segundos y, con el
-- Radar de la racha, todos los enemigos. También la zona de control y las banderas.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Teams = game:GetService("Teams")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Weapons = require(Shared.Weapons)
local GameConfig = require(Shared.GameConfig)

local UI = require(script.Parent.UI)
local ClientState = require(script.Parent.ClientState)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Minimap = {}

local RANGE = 170 -- studs que caben a lo ancho
local RED_DOT_TIME = 2.5 -- segundos que se ve el punto rojo de un disparo
local MAX_SHAPES = 900

local gui, frame, world, me
local border, enemyRadarLabel
local lastEnemyRadar, nextRadarCheck = false, 0
local size, scale = 160, 160 / RANGE
local shapesFolder
local builtFor = nil
local shots = {} -- [modelo] = { Position, Time }
local dots = {} -- círculos reutilizables
local usedDots = 0

-- ¿Está en el equipo contrario? (en todos contra todos, todos lo están)
local function isEnemy(model)
	if not ReplicatedStorage:GetAttribute("TeamMode") then
		return model ~= player.Character
	end
	local owner = Players:GetPlayerFromCharacter(model)
	local team = owner and owner.Team and owner.Team.Name or model:GetAttribute("Team")
	return team ~= nil and team ~= "" and player.Team ~= nil and team ~= player.Team.Name
end

local function isTeammate(model)
	if not ReplicatedStorage:GetAttribute("TeamMode") or model == player.Character then
		return false
	end
	local owner = Players:GetPlayerFromCharacter(model)
	local team = owner and owner.Team and owner.Team.Name or model:GetAttribute("Team")
	return player.Team ~= nil and team == player.Team.Name
end

---------------------------------------------------------------------------
-- Plano del mapa (se rehace al cambiar de mapa)
---------------------------------------------------------------------------

local function rebuild()
	local map = workspace:FindFirstChild("Map")
	builtFor = map
	if shapesFolder then
		shapesFolder:Destroy()
	end
	shapesFolder = UI.new("Folder", { Name = "Shapes", Parent = world })
	if not map then
		return
	end
	local boundary = map:FindFirstChild("Boundary")
	local count = 0
	for _, part in map:GetDescendants() do
		if count >= MAX_SHAPES then
			break
		end
		if part:IsA("BasePart") and part.CanCollide and part.Transparency < 0.9 and not (boundary and part:IsDescendantOf(boundary)) then
			local cf = part.CFrame
			local s = part.Size
			-- Solo lo que es "de pie" (muros, edificios, coberturas): no suelos ni piezas inclinadas
			if cf.UpVector.Y > 0.95 and s.Y >= 2.5 and s.X * s.Z >= 6 and cf.Position.Y + s.Y / 2 > 2.5 and part.Shape ~= Enum.PartType.Ball then
				count += 1
				local right = cf.RightVector
				local tall = s.Y >= 6
				UI.new("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromOffset(cf.Position.X * scale, cf.Position.Z * scale),
					Size = UDim2.fromOffset(math.max(1, s.X * scale), math.max(1, s.Z * scale)),
					Rotation = math.deg(math.atan2(right.Z, right.X)),
					BackgroundColor3 = tall and Color3.fromRGB(205, 205, 210) or Color3.fromRGB(150, 150, 158),
					BackgroundTransparency = tall and 0.25 or 0.4,
					BorderSizePixel = 0,
					Parent = shapesFolder,
				})
			end
		end
	end
end

---------------------------------------------------------------------------
-- Puntos
---------------------------------------------------------------------------

local function dot(position, color, radius, square)
	usedDots += 1
	local d = dots[usedDots]
	if not d then
		d = UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			BorderSizePixel = 0,
			ZIndex = 3,
			Parent = frame,
		}, { UI.new("UICorner", { CornerRadius = UDim.new(1, 0) }), UI.stroke(Color3.new(0, 0, 0), 1, 0.3) })
		dots[usedDots] = d
	end
	local corner = d:FindFirstChildOfClass("UICorner")
	if corner then
		corner.CornerRadius = square and UDim.new(0, 2) or UDim.new(1, 0)
	end
	d.Visible = true
	d.BackgroundTransparency = 0
	local letter = d:FindFirstChild("Letter")
	if letter then
		letter.Text = ""
	end
	d.BackgroundColor3 = color
	d.Size = UDim2.fromOffset(radius * 2, radius * 2)
	d.Position = UDim2.new(0.5, position.X, 0.5, position.Y)
	return d
end

-- Posición en el minimapa (respecto al centro) de un punto del mundo; nil si se sale
local function toMap(worldPosition, center)
	local offset = Vector2.new(worldPosition.X - center.X, worldPosition.Z - center.Z) * scale
	local half = size / 2 - 4
	if math.abs(offset.X) > half or math.abs(offset.Y) > half then
		-- (los objetivos se quedan pegados al borde para saber hacia dónde están)
		return nil, Vector2.new(math.clamp(offset.X, -half, half), math.clamp(offset.Y, -half, half))
	end
	return offset
end

local function update()
	local visible = not ClientState.InMainMenu and ReplicatedStorage:GetAttribute("State") == "Playing"
	gui.Enabled = visible
	if not visible then
		return
	end
	local map = workspace:FindFirstChild("Map")
	if map ~= builtFor then
		rebuild()
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local center = root and root.Position or camera.CFrame.Position
	world.Position = UDim2.new(0.5, -center.X * scale, 0.5, -center.Z * scale)
	local look = camera.CFrame.LookVector
	me.Rotation = math.deg(math.atan2(look.X, -look.Z))

	usedDots = 0
	local now = os.clock()
	-- Compañeros (jugadores y bots)
	local radar = workspace:GetServerTimeNow() < (player:GetAttribute("RadarUntil") or 0)
	-- Radar enemigo: borde rojo y aviso mientras otro equipo lo tenga (se mira 3 veces por segundo)
	local enemyRadar = lastEnemyRadar
	if now >= nextRadarCheck then
		nextRadarCheck = now + 0.3
		enemyRadar = false
		if ReplicatedStorage:GetAttribute("TeamMode") ~= false and player.Team then
			local serverNow = workspace:GetServerTimeNow()
			for name, value in ReplicatedStorage:GetAttributes() do
				if string.sub(name, 1, 6) == "Radar_" and name ~= "Radar_" .. player.Team.Name and type(value) == "number" and value > serverNow then
					enemyRadar = true
					break
				end
			end
		end
	end
	if enemyRadar ~= lastEnemyRadar then
		lastEnemyRadar = enemyRadar
		if border then
			border.Color = enemyRadar and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(230, 230, 235)
			border.Transparency = enemyRadar and 0 or 0.35
		end
		enemyRadarLabel.Visible = enemyRadar
	end
	local models = {}
	for _, other in Players:GetPlayers() do
		if other ~= player and other.Character then
			table.insert(models, other.Character)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			table.insert(models, model)
		end
	end
	for _, model in models do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local part = model:FindFirstChild("HumanoidRootPart")
		if humanoid and humanoid.Health > 0 and part then
			if isTeammate(model) then
				local p = toMap(part.Position, center)
				if p then
					dot(p, Color3.fromRGB(70, 160, 255), 4)
				end
			elseif radar and isEnemy(model) then
				local p = toMap(part.Position, center)
				if p then
					dot(p, Color3.fromRGB(255, 50, 50), 4)
				end
			end
		end
	end
	-- Disparos enemigos recientes (puntos rojos donde dispararon)
	for model, shot in shots do
		if now - shot.Time > RED_DOT_TIME or not model.Parent then
			shots[model] = nil
		else
			local p = toMap(shot.Position, center)
			if p then
				local d = dot(p, Color3.fromRGB(255, 40, 40), 4.5)
				d.BackgroundTransparency = math.clamp((now - shot.Time) / RED_DOT_TIME, 0, 0.7)
			end
		end
	end
	-- Objetivos: zona de control y banderas (pegados al borde si están lejos)
	local zone = ReplicatedStorage:GetAttribute("ZonePosition")
	if typeof(zone) == "Vector3" then
		local p, edge = toMap(zone, center)
		dot(p or edge, Color3.fromRGB(255, 210, 40), 6, true)
	end
	-- Dominio: las tres banderas con su letra y el color de su dueño
	for _, letter in { "A", "B", "C" } do
		local position = ReplicatedStorage:GetAttribute("Dom_" .. letter .. "_Position")
		if typeof(position) == "Vector3" then
			local p, edge = toMap(position, center)
			local owner = Teams:FindFirstChild(ReplicatedStorage:GetAttribute("Dom_" .. letter .. "_Owner") or "")
			local d = dot(p or edge, owner and owner:IsA("Team") and owner.TeamColor.Color or Color3.fromRGB(230, 230, 235), 7, true)
			local label = d:FindFirstChild("Letter") or UI.label({
				Name = "Letter",
				Size = UDim2.fromScale(1, 1),
				TextSize = 11,
				TextStrokeTransparency = 1,
				TextColor3 = Color3.new(0, 0, 0),
				Parent = d,
			})
			label.Text = letter
		end
	end
	-- Buscar y destruir: los sitios de la bomba (en rojo el de la bomba plantada)
	for _, letter in { "A", "B" } do
		local position = ReplicatedStorage:GetAttribute("Bomb_" .. letter .. "_Position")
		if typeof(position) == "Vector3" then
			local p, edge = toMap(position, center)
			local planted = ReplicatedStorage:GetAttribute("Bomb_State") == "Planted" and ReplicatedStorage:GetAttribute("Bomb_Site") == letter
			local d = dot(p or edge, planted and Color3.fromRGB(255, 60, 50) or Color3.fromRGB(255, 190, 60), 7, true)
			local label = d:FindFirstChild("Letter") or UI.label({
				Name = "Letter",
				Size = UDim2.fromScale(1, 1),
				TextSize = 11,
				TextStrokeTransparency = 1,
				TextColor3 = Color3.new(0, 0, 0),
				Parent = d,
			})
			label.Text = letter
		end
	end
	-- La bomba en el suelo (solo la ven los atacantes, que son quienes la pueden recoger)
	local dropped = ReplicatedStorage:GetAttribute("Bomb_Dropped")
	if typeof(dropped) == "Vector3" and player.Team and player.Team.Name == ReplicatedStorage:GetAttribute("Bomb_Attackers") then
		local p, edge = toMap(dropped, center)
		local d = dot(p or edge, Color3.fromRGB(255, 120, 30), 6, true)
		local label = d:FindFirstChild("Letter") or UI.label({
			Name = "Letter",
			Size = UDim2.fromScale(1, 1),
			TextSize = 11,
			TextStrokeTransparency = 1,
			TextColor3 = Color3.new(0, 0, 0),
			Parent = d,
		})
		label.Text = "💣"
	end
	for _, team in GameConfig.Teams do
		local flag = ReplicatedStorage:GetAttribute("FlagPos_" .. team.Name)
		if typeof(flag) == "Vector3" then
			local p, edge = toMap(flag, center)
			dot(p or edge, team.Color.Color, 5, true)
		end
	end
	for i = usedDots + 1, #dots do
		dots[i].Visible = false
	end
end

Minimap.Update = update

-- Disparo de otro jugador o bot (los mismos avisos que dibujan sus trazadoras)
local function onShot(tool)
	if typeof(tool) ~= "Instance" or not tool.Parent then
		return
	end
	local model = tool.Parent
	local def = Weapons.Get(tool:GetAttribute("Weapon"))
	if def and def.Suppressed then
		return -- con silenciador no sale en el minimapa
	end
	local owner = Players:GetPlayerFromCharacter(model)
	if owner and owner:GetAttribute("Perk") == 3 then
		return -- (ventaja "Fantasma")
	end
	local part = model:FindFirstChild("HumanoidRootPart") or tool:FindFirstChild("Handle")
	if part and part:IsA("BasePart") and isEnemy(model) then
		shots[model] = { Position = part.Position, Time = os.clock() }
	end
end

function Minimap.Init()
	-- (se espera a saber el tamaño de la pantalla: al arrancar puede valer 0 y en el móvil salía
	-- el minimapa grande del ordenador)
	UI.WaitViewport()
	local viewport = camera.ViewportSize
	local phone = UI.IsPhone()
	size = phone and 96 or ((viewport.Y > 0 and viewport.Y < 500) and 112 or 160)
	-- (debajo de los botones de Roblox de arriba a la izquierda, que si no lo tapaban)
	-- (en pantallas táctiles; en el ordenador, arriba del todo como siempre)
	local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local top = touchOnly and UI.TopbarBottom() or 14
	scale = size / RANGE
	gui = UI.new("ScreenGui", {
		Name = "Minimap",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 2,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	frame = UI.new("Frame", {
		Position = UDim2.fromOffset(14, top),
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = Color3.fromRGB(22, 26, 30),
		BackgroundTransparency = 0.3,
		ClipsDescendants = true,
		Parent = gui,
	}, { UI.corner(8), UI.stroke(Color3.fromRGB(230, 230, 235), 2, 0.35) })
	border = frame:FindFirstChildOfClass("UIStroke")
	enemyRadarLabel = UI.label({
		Position = UDim2.new(0, 0, 1, -16),
		Size = UDim2.new(1, 0, 0, 16),
		Text = "📡 RADAR ENEMIGO",
		TextSize = 11,
		TextColor3 = Color3.fromRGB(255, 120, 120),
		BackgroundColor3 = Color3.fromRGB(60, 0, 0),
		BackgroundTransparency = 0.35,
		ZIndex = 6,
		Visible = false,
		Parent = frame,
	})
	world = UI.new("Frame", {
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
		Parent = frame,
	})
	me = UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16),
		Text = "▲",
		TextSize = 15,
		TextColor3 = Color3.fromRGB(255, 230, 90),
		ZIndex = 5,
		Parent = frame,
	})
	-- (el botón de PASE · TIENDA y lo demás de la izquierda van debajo)
	ClientState.MinimapBottom = top + size
	Remotes.ShotFX.OnClientEvent:Connect(onShot)
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 1 / 30 then
			return
		end
		accumulator = 0
		update()
	end)
end

return Minimap
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="118">
            <Properties>
              <string name="Name">Movement</string>
              <string name="Source"><![CDATA[-- Movimiento: correr (Shift), agacharse (C) y deslizarse (C corriendo), con sensación realista (GameConfig.Movement):
--   * aceleración: se arranca y se pasa a correr poco a poco, y se frena rápido
--   * solo se corre hacia delante, y correr gasta estamina (si se agota, hay que recuperarse)
--   * saltar también gasta un poco; cansado se salta menos
--   * aterrizar desde alto da un golpe de cámara y, si es muy alto, frena un momento
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Sounds = require(Shared.Sounds)

local TouchLayout = require(script.Parent.TouchLayout)
local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Movement = {}

local humanoid, rootPart
local sprintHeld = false
local MOVE = GameConfig.Movement or {}
local currentSpeed = GameConfig.WalkSpeed
local lastStaminaUse = 0
local fallSpeed = 0 -- la mayor velocidad de caída desde que se despegó del suelo
local slowUntil = 0 -- aterrizaje fuerte: frena hasta entonces
local baseJumpHeight, baseJumpPower
local baseHipHeight -- (agacharse baja la cadera: cámara y cuerpo más bajos, también para los demás)
local staminaBar, staminaFill
local lastSlide = -10
local stopSlide

local function tweenCameraOffset(offset, time)
	if humanoid then
		TweenService:Create(humanoid, TweenInfo.new(time, Enum.EasingStyle.Quad), { CameraOffset = offset }):Play()
	end
end

-- Polvo que levanta el deslizamiento, del color del suelo (nieve, tierra, hormigón...)
local SLIDE_DUST = {
	[Enum.Material.Snow] = Color3.fromRGB(240, 245, 255),
	[Enum.Material.Ice] = Color3.fromRGB(225, 240, 255),
	[Enum.Material.Glacier] = Color3.fromRGB(225, 240, 255),
	[Enum.Material.Grass] = Color3.fromRGB(140, 120, 85),
	[Enum.Material.LeafyGrass] = Color3.fromRGB(140, 120, 85),
	[Enum.Material.Ground] = Color3.fromRGB(150, 125, 90),
	[Enum.Material.Mud] = Color3.fromRGB(110, 85, 60),
	[Enum.Material.Sand] = Color3.fromRGB(205, 185, 140),
}

local function slideDust(floorMaterial)
	if not rootPart or not humanoid or ClientState.EffectiveQuality == "Baja" then
		return nil
	end
	local feet = Instance.new("Attachment")
	feet.Name = "SlideDust"
	feet.Position = Vector3.new(0, -(humanoid.HipHeight + rootPart.Size.Y / 2) + 0.3, 0)
	feet.Parent = rootPart
	local dust = Instance.new("ParticleEmitter")
	dust.Texture = "rbxasset://textures/particles/smoke_main.dds"
	dust.Color = ColorSequence.new(SLIDE_DUST[floorMaterial] or Color3.fromRGB(175, 172, 165))
	dust.LightInfluence = 1
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 2.4) })
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
	dust.Lifetime = NumberRange.new(0.5, 0.8)
	dust.Speed = NumberRange.new(2, 4)
	dust.SpreadAngle = Vector2.new(50, 50)
	dust.Acceleration = Vector3.new(0, 1, 0)
	dust.Rotation = NumberRange.new(0, 360)
	dust.RotSpeed = NumberRange.new(-40, 40)
	dust.Rate = 40
	dust.EmissionDirection = Enum.NormalId.Top
	dust.Parent = feet
	return feet
end

local wasFrozen = false

local function slide()
	if ClientState.Sliding or ClientState.Dashing or ClientState.IsBlocked() or ClientState.Frozen() or not humanoid or humanoid.Health <= 0 or not rootPart then
		return
	end
	if os.clock() - lastSlide < GameConfig.SlideCooldown or humanoid.FloorMaterial == Enum.Material.Air then
		return
	end
	local direction = humanoid.MoveDirection
	if direction.Magnitude < 0.1 then
		direction = camera.CFrame.LookVector
	end
	direction = Vector3.new(direction.X, 0, direction.Z)
	if direction.Magnitude < 0.01 then
		return
	end
	direction = direction.Unit

	lastSlide = os.clock()
	ClientState.Sliding = true
	Sounds.Play("Slide")
	local dust = slideDust(humanoid.FloorMaterial)

	local attachment = Instance.new("Attachment")
	attachment.Name = "SlideAttachment"
	attachment.Parent = rootPart
	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	-- Modo plano: solo empuja en X/Z, la gravedad sigue actuando
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	velocity.PrimaryTangentAxis = Vector3.xAxis
	velocity.SecondaryTangentAxis = Vector3.zAxis
	velocity.MaxForce = 80000
	velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z) * GameConfig.SlideSpeed
	velocity.Parent = rootPart

	tweenCameraOffset(Vector3.new(0, -1.8, 0), 0.12)

	local start = os.clock()
	local connection
	local stopped = false
	stopSlide = function()
		if stopped then
			return
		end
		stopped = true
		connection:Disconnect()
		velocity:Destroy()
		attachment:Destroy()
		if dust then
			-- Deja de emitir y se borra cuando se han disipado las últimas partículas
			local emitter = dust:FindFirstChildOfClass("ParticleEmitter")
			if emitter then
				emitter.Enabled = false
			end
			task.delay(1, function()
				dust:Destroy()
			end)
		end
		ClientState.Sliding = false
		tweenCameraOffset(Vector3.zero, 0.2)
	end
	connection = RunService.Heartbeat:Connect(function()
		local alpha = (os.clock() - start) / GameConfig.SlideDuration
		local state = humanoid:GetState()
		if alpha >= 1 or humanoid.Health <= 0 or humanoid.Jump or state == Enum.HumanoidStateType.Jumping then
			stopSlide()
			return
		end
		local speed = GameConfig.SlideSpeed + (GameConfig.WalkSpeed - GameConfig.SlideSpeed) * alpha * alpha
		velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z) * speed
	end)
end

-- Hielo: el Humanoid ignora la fricción del suelo, así que el patinaje se hace con una LinearVelocity
-- (dentro del paso de física, como el deslizamiento): la velocidad cambia despacio hacia donde quieres ir.
local iceVelocity = Vector3.zero
local iceMover: LinearVelocity? = nil

local function stopIce()
	if iceMover then
		local attachment = iceMover.Attachment0
		iceMover:Destroy()
		if attachment then
			attachment:Destroy()
		end
		iceMover = nil
	end
end

local function iceSlide(dt)
	local state = humanoid:GetState()
	local onIce = humanoid.FloorMaterial == Enum.Material.Ice
		and not ClientState.Sliding
		and not ClientState.Dashing
		and state ~= Enum.HumanoidStateType.Jumping
		and state ~= Enum.HumanoidStateType.Freefall
	if not onIce then
		stopIce()
		local velocity = rootPart.AssemblyLinearVelocity
		iceVelocity = Vector3.new(velocity.X, 0, velocity.Z)
		return
	end
	if not iceMover or iceMover.Parent ~= rootPart then
		stopIce()
		local attachment = Instance.new("Attachment")
		attachment.Name = "IceAttachment"
		attachment.Parent = rootPart
		local mover = Instance.new("LinearVelocity")
		mover.Name = "IceVelocity"
		mover.Attachment0 = attachment
		mover.RelativeTo = Enum.ActuatorRelativeTo.World
		mover.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
		mover.PrimaryTangentAxis = Vector3.xAxis
		mover.SecondaryTangentAxis = Vector3.zAxis
		mover.MaxForce = 30000
		mover.Parent = rootPart
		iceMover = mover
	end
	local wanted = humanoid.MoveDirection * humanoid.WalkSpeed
	iceVelocity = iceVelocity:Lerp(Vector3.new(wanted.X, 0, wanted.Z), math.min(1, dt * 1.5))
	if iceMover then
		iceMover.PlaneVelocity = Vector2.new(iceVelocity.X, iceVelocity.Z)
	end
end

-- Barra de estamina fina debajo de la mira; solo se ve mientras no está llena
local function buildStaminaBar()
	local gui = UI.new("ScreenGui", {
		Name = "Stamina",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		Parent = player:WaitForChild("PlayerGui"),
	})
	staminaBar = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 44),
		Size = UDim2.fromOffset(90, 5),
		BackgroundColor3 = Color3.fromRGB(20, 20, 26),
		BackgroundTransparency = 0.35,
		Visible = false,
		Parent = gui,
	}, { UI.corner(3) })
	staminaFill = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(235, 240, 250),
		Parent = staminaBar,
	}, { UI.corner(3) })
end

local function updateStaminaBar()
	if not staminaBar then
		return
	end
	local stamina = ClientState.Stamina
	staminaBar.Visible = stamina < 0.995 and not ClientState.InMainMenu and not ClientState.Dead
	staminaFill.Size = UDim2.fromScale(math.clamp(stamina, 0, 1), 1)
	staminaFill.BackgroundColor3 = ClientState.Exhausted and Color3.fromRGB(255, 90, 80) or Color3.fromRGB(235, 240, 250)
end

-- Estamina: correr la gasta; se recupera tras un momento sin correr ni saltar
local function updateStamina(dt)
	local now = os.clock()
	local stamina = ClientState.Stamina
	if ClientState.Sprinting then
		stamina -= dt / (MOVE.StaminaSeconds or 6)
		lastStaminaUse = now
		if stamina <= 0 then
			stamina = 0
			ClientState.Exhausted = true
		end
	elseif now - lastStaminaUse > (MOVE.RegenDelay or 0.8) then
		stamina = math.min(1, stamina + dt / (MOVE.RegenSeconds or 4))
	end
	if ClientState.Exhausted and stamina >= (MOVE.MinToSprint or 0.3) then
		ClientState.Exhausted = false
	end
	ClientState.Stamina = stamina
end

local function update(dt)
	if not humanoid or humanoid.Health <= 0 or not rootPart then
		ClientState.Sprinting = false
		updateStaminaBar()
		return
	end
	iceSlide(dt)
	local moveDirection = humanoid.MoveDirection
	local moving = moveDirection.Magnitude > 0.1
	local recentlyShot = os.clock() - ClientState.LastShotTime < 0.35
	-- Solo se corre hacia delante (no de lado ni hacia atrás)
	local look = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
	local flatMove = Vector3.new(moveDirection.X, 0, moveDirection.Z)
	local forward = moving and look.Magnitude > 0.01 and flatMove.Magnitude > 0.01 and flatMove.Unit:Dot(look.Unit) >= (MOVE.SprintAngle or 0.55)
	ClientState.Sprinting = sprintHeld
		and moving
		and forward
		and not ClientState.Exhausted
		and not ClientState.Aiming
		and not recentlyShot
		and not ClientState.Sliding
		and not ClientState.IsBlocked()
	-- Correr, deslizarse o estar en el aire te levanta
	if ClientState.Crouching and (ClientState.Sprinting or ClientState.Sliding or humanoid.FloorMaterial == Enum.Material.Air) then
		ClientState.Crouching = false
	end
	if baseHipHeight then
		local target = baseHipHeight - (ClientState.Crouching and (GameConfig.CrouchDrop or 1.3) or 0)
		if math.abs(humanoid.HipHeight - target) > 0.01 then
			humanoid.HipHeight += (target - humanoid.HipHeight) * math.min(1, dt * 12)
		end
	end
	updateStamina(dt)
	updateStaminaBar()

	-- Caída: se apunta la velocidad máxima hasta tocar suelo (el golpe lo da onLanded)
	if humanoid.FloorMaterial == Enum.Material.Air then
		fallSpeed = math.max(fallSpeed, -rootPart.AssemblyLinearVelocity.Y)
	end
	-- Cansado se salta menos
	local jumpScale = ClientState.Exhausted and (MOVE.TiredJump or 0.7) or 1
	if baseJumpHeight then
		humanoid.JumpHeight = baseJumpHeight * jumpScale
		humanoid.JumpPower = baseJumpPower * jumpScale
	end

	local speed = GameConfig.WalkSpeed
	if ClientState.Sprinting then
		speed = GameConfig.SprintSpeed
	elseif ClientState.Crouching then
		speed = GameConfig.CrouchSpeed or 10
	elseif ClientState.Aiming then
		speed = GameConfig.AimWalkSpeed
	end
	local weaponDef = ClientState.CurrentDef
	if weaponDef and weaponDef.WalkSpeedMultiplier then
		speed *= weaponDef.WalkSpeedMultiplier
	end
	-- Ventaja "Ligero"
	local perkId = player:GetAttribute("Perk")
	for _, perk in GameConfig.Perks or {} do
		if perk.Id == perkId and perk.SpeedMultiplier then
			speed *= perk.SpeedMultiplier
		end
	end
	if player:GetAttribute("CarryingFlag") then
		speed *= GameConfig.Flag.CarrierSpeedMultiplier
	end
	if os.clock() < slowUntil then
		speed *= 0.6 -- aterrizaje fuerte
	end
	-- Aceleración: se arranca con parte de la velocidad y se llega a la máxima poco a poco
	if not moving then
		currentSpeed = math.min(currentSpeed, speed * (MOVE.StartFactor or 0.55))
	elseif currentSpeed < speed then
		currentSpeed = math.min(speed, currentSpeed + (MOVE.Acceleration or 30) * dt)
	else
		currentSpeed = math.max(speed, currentSpeed - (MOVE.Deceleration or 70) * dt)
	end
	-- Cuenta atrás de Eliminación: quieto y sin saltar
	local frozen = ClientState.Frozen()
	if frozen then
		currentSpeed = 0
	end
	if frozen ~= wasFrozen then
		wasFrozen = frozen
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, not frozen)
	end
	humanoid.WalkSpeed = currentSpeed
end

-- Al tocar suelo tras una caída: golpe de cámara, sonido y, si fue muy alta, frena un momento
local function onLanded()
	local speed = fallSpeed
	fallSpeed = 0
	local hard = MOVE.HardLanding or 38
	if speed < hard then
		return
	end
	local k = math.clamp((speed - hard) / 40, 0, 1)
	ClientState.LandKick = math.max(ClientState.LandKick or 0, 0.35 + 0.65 * k)
	Sounds.Play("Land", nil, 1 - 0.15 * k, 0.5 + 0.5 * k)
	if speed >= (MOVE.HeavyLanding or 62) then
		slowUntil = os.clock() + 0.35
	end
end

local function onCharacter(newCharacter)
	if stopSlide then
		stopSlide()
		stopSlide = nil
	end
	ClientState.Sliding = false
	iceMover = nil -- era del personaje anterior
	humanoid = newCharacter:WaitForChild("Humanoid")
	wasFrozen = false -- el humanoide nuevo empieza con el salto activado (después de cambiarlo)
	rootPart = newCharacter:WaitForChild("HumanoidRootPart")
	humanoid.CameraOffset = Vector3.zero
	baseJumpHeight, baseJumpPower = humanoid.JumpHeight, humanoid.JumpPower
	baseHipHeight = humanoid.HipHeight
	ClientState.Crouching = false
	currentSpeed = GameConfig.WalkSpeed * (MOVE.StartFactor or 0.55)
	fallSpeed = 0
	slowUntil = 0
	ClientState.Stamina = 1
	ClientState.Exhausted = false
	local character = newCharacter
	humanoid.StateChanged:Connect(function(_, new)
		if player.Character ~= character then
			return
		end
		if new == Enum.HumanoidStateType.Landed then
			onLanded()
		elseif new == Enum.HumanoidStateType.Jumping then
			-- Saltar gasta un poco de estamina
			ClientState.Stamina = math.max(0, ClientState.Stamina - (MOVE.JumpCost or 0.12))
			lastStaminaUse = os.clock()
		end
	end)
end

function Movement.Init()
	buildStaminaBar()
	TouchLayout.BindAction("Sprint", function(_, state, input)
		if input.UserInputType == Enum.UserInputType.Touch then
			if state == Enum.UserInputState.Begin and not ClientState.IsBlocked() then
				sprintHeld = not sprintHeld
			end
		elseif state == Enum.UserInputState.Begin then
			sprintHeld = true
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			sprintHeld = false
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
	TouchLayout.SetTitle("Sprint", "🏃")
	TouchLayout.Set("Sprint", UDim2.new(1, -260, 1, -160))

	-- C: corriendo te deslizas; si no, te agachas o te levantas (como en los shooters de móvil)
	TouchLayout.BindAction("Slide", function(_, state)
		if state == Enum.UserInputState.Begin then
			local running = ClientState.Sprinting or currentSpeed > GameConfig.WalkSpeed + 1
			if running then
				ClientState.Crouching = false
				slide()
			elseif not ClientState.Sliding and not ClientState.IsBlocked() and humanoid and humanoid.FloorMaterial ~= Enum.Material.Air then
				ClientState.Crouching = not ClientState.Crouching
			end
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.C, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonR3)
	TouchLayout.SetTitle("Slide", "⬇")
	TouchLayout.Set("Slide", UDim2.new(1, -270, 1, -240))

	-- Si la ventana pierde el foco dejamos de correr
	UserInputService.WindowFocusReleased:Connect(function()
		sprintHeld = false
	end)

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	RunService.Heartbeat:Connect(update)
end

return Movement
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="119">
            <Properties>
              <string name="Name">News</string>
              <string name="Source"><![CDATA[-- Novedades (GameConfig.News): en la pantalla de inicio, los jugadores que ya habían jugado ven una
-- vez lo nuevo de la actualización. Se cierra con el botón y el servidor lo apunta (NewsSeen).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Sounds = require(Shared.Sounds)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local News = {}

local shown = false

local function show()
	shown = true
	local news = GameConfig.ActiveNews()
	local height = 120 + #news.Items * 46
	local gui = UI.new("ScreenGui", {
		Name = "News",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 15,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- (Active: tapa los botones de la pantalla de inicio mientras se lee)
	UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5, Active = true, Parent = gui })
	local card = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(560, height),
		BackgroundColor3 = Color3.fromRGB(26, 20, 40),
		Parent = gui,
	}, { UI.corner(18), UI.stroke(Color3.fromRGB(255, 140, 30), 3, 0) })
	local scale = UI.new("UIScale", { Scale = 0.6, Parent = card })
	local viewport = workspace.CurrentCamera.ViewportSize
	local fit = math.clamp(math.min((viewport.X - 20) / 560, (viewport.Y - 20) / height), 0.45, 1)
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = fit }):Play()
	UI.label({ Position = UDim2.fromOffset(0, 14), Size = UDim2.new(1, 0, 0, 40), Text = news.Title, TextSize = 30, TextColor3 = Color3.fromRGB(255, 170, 50), Parent = card })
	for i, item in news.Items do
		local row = UI.new("Frame", {
			Position = UDim2.fromOffset(20, 62 + (i - 1) * 46),
			Size = UDim2.new(1, -40, 0, 40),
			BackgroundColor3 = Color3.fromRGB(50, 40, 74),
			BackgroundTransparency = 0.2,
			Parent = card,
		}, { UI.corner(10) })
		UI.label({ Size = UDim2.fromOffset(44, 40), Text = item[1], TextSize = 24, Parent = row })
		UI.label({
			Position = UDim2.fromOffset(48, 0),
			Size = UDim2.new(1, -56, 1, 0),
			Text = item[2],
			TextSize = 18,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			Parent = row,
		})
	end
	local button = UI.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(220, 44),
		Text = "¡A JUGAR!",
		TextSize = 24,
		BackgroundColor3 = Color3.fromRGB(255, 130, 30),
		Parent = card,
	}, { UI.gloss() })
	button.Modal = true
	ClientState.NewsOpen = true
	ClientState.UpdateMouse()
	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		Remotes.NewsSeen:FireServer()
		gui:Destroy()
		ClientState.NewsOpen = false
		ClientState.UpdateMouse()
	end
	button.Activated:Connect(function()
		Sounds.Play("Click")
		close()
	end)
	-- Si empieza la partida con la tarjeta abierta (por ejemplo con el mando), se cierra sola
	task.spawn(function()
		while not closed do
			if not ClientState.InMainMenu then
				close()
			end
			task.wait(0.3)
		end
	end)
end

function News.Init()
	task.spawn(function()
		while not shown do
			task.wait(1)
			local data = ClientState.Data
			local news = GameConfig.ActiveNews()
			if news and data and ClientState.InMainMenu and data.TutorialDone and (data.NewsSeen or 0) < news.Version then
				task.wait(1) -- que primero se vea la pantalla de inicio
				if ClientState.InMainMenu then
					show()
				end
			elseif data and news and (data.NewsSeen or 0) >= news.Version then
				return
			end
		end
	end)
end

return News
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="120">
            <Properties>
              <string name="Name">PlaytimeGifts</string>
              <string name="Source"><![CDATA[-- Botón de regalos por tiempo jugado (a la izquierda, debajo de los retos): cuenta atrás hasta el
-- siguiente regalo y, cuando está listo, brilla y se recoge con la tecla H (en partida el ratón está
-- bloqueado) o tocándolo en móvil. Lo valida el servidor (Gifts).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Sounds = require(Shared.Sounds)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local PlaytimeGifts = {}

local READY = Color3.fromRGB(255, 190, 40)
local WAITING = Color3.fromRGB(45, 50, 80)

local gui, button, icon, label, sub, scale
local claiming = false
local message, messageUntil = nil, 0 -- aviso breve si el servidor no deja recogerlo
local compact = false -- móvil: solo el icono y el tiempo (arriba a la izquierda)

local function rewardText(gift)
	local parts = {}
	if gift.Coins then
		table.insert(parts, gift.Coins .. " 🪙")
	end
	if gift.XP then
		table.insert(parts, gift.XP .. " XP")
	end
	if gift.Revives then
		table.insert(parts, gift.Revives .. " 💖")
	end
	return table.concat(parts, " + ")
end

-- Siguiente regalo y segundos que faltan (nil si ya se recogieron todos)
local function nextGift()
	local start = player:GetAttribute("GiftStart")
	local index = (player:GetAttribute("GiftsClaimed") or 0) + 1
	local gift = GameConfig.PlaytimeGifts[index]
	if not start or not gift then
		return nil
	end
	return gift, math.max(0, start + gift.Minutes * 60 - workspace:GetServerTimeNow())
end

local function update()
	local gift, left = nextGift()
	gui.Enabled = gift ~= nil and not ClientState.InMainMenu and not ClientState.Dead
	if not gift then
		return
	end
	local ready = left <= 0
	button.BackgroundColor3 = ready and READY or WAITING
	if compact then
		label.Text = ready and "¡YA!" or UI.formatTime(left)
	else
		label.Text = ready and "¡RECOGER! (H)" or ("REGALO EN " .. UI.formatTime(left))
	end
	sub.Text = (message and os.clock() < messageUntil) and message or rewardText(gift)
	-- Late cuando está listo
	scale.Scale = ready and (1 + math.sin(os.clock() * 6) * 0.05) or 1
	icon.Rotation = ready and math.sin(os.clock() * 10) * 12 or 0
end

local function claim()
	local gift, left = nextGift()
	if claiming or not gift or left > 0 then
		return
	end
	claiming = true
	Sounds.Play("Click")
	local ok, result, reason = pcall(function()
		return Remotes.ClaimGift:InvokeServer()
	end)
	claiming = false
	if not (ok and result) then
		message, messageUntil = (ok and type(reason) == "string") and reason or "Inténtalo otra vez", os.clock() + 2
	end
	if ok and result then
		Sounds.Play("Flag")
		-- Pequeño salto del botón al recogerlo
		scale.Scale = 1.25
		TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
end

function PlaytimeGifts.Init()
	gui = UI.new("ScreenGui", {
		Name = "PlaytimeGifts",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- En móvil: botón pequeño arriba a la izquierda (abajo está el joystick y los retos ocupan el centro)
	compact = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	UI.WaitViewport()
	-- (teléfono: a la derecha del minimapa, pequeño; tablet: debajo del botón de la tienda)
	local phone = UI.IsPhone()
	button = UI.button({
		AnchorPoint = Vector2.new(0, 0),
		-- (táctil: a la derecha del minimapa, que mide 96 en el teléfono y 160 en la tablet)
		Position = compact and UDim2.fromOffset(14 + (phone and 96 or 160) + 6, UI.TopbarBottom())
			or UDim2.new(0, 66, 0.38, 112),
		Size = phone and UDim2.fromOffset(44, 54) or (compact and UDim2.fromOffset(52, 64) or UDim2.fromOffset(230, 56)),
		Text = "",
		BackgroundColor3 = WAITING,
		BackgroundTransparency = 0.1,
		Parent = gui,
	}, { UI.stroke(Color3.new(1, 1, 1), 2, 0.3) })
	scale = UI.new("UIScale", { Parent = button })
	icon = UI.label({
		Position = UDim2.fromOffset(4, 0),
		Size = UDim2.fromOffset(50, 56),
		Text = "🎁",
		TextSize = 34,
		Parent = button,
	})
	label = UI.label({
		Position = UDim2.fromOffset(56, 6),
		Size = UDim2.new(1, -62, 0, 24),
		Text = "",
		TextSize = 19,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = button,
	})
	sub = UI.label({
		Position = UDim2.fromOffset(56, 30),
		Size = UDim2.new(1, -62, 0, 20),
		Text = "",
		TextSize = 15,
		TextColor3 = Color3.fromRGB(255, 235, 170),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = button,
	})
	if compact then
		-- Icono arriba y el tiempo debajo, sin la línea del premio
		local small = phone
		icon.Position, icon.Size, icon.TextSize = UDim2.fromOffset(0, 2), UDim2.new(1, 0, 0, small and 30 or 38), small and 24 or 30
		label.Position, label.Size = UDim2.fromOffset(0, small and 32 or 40), UDim2.new(1, 0, 0, small and 18 or 20)
		label.TextXAlignment = Enum.TextXAlignment.Center
		label.TextSize = small and 12 or 15
		sub.Visible = false
	end
	button.Activated:Connect(claim)
	ContextActionService:BindAction("ClaimGift", function(_, state)
		if state == Enum.UserInputState.Begin and gui.Enabled and not ClientState.IsBlocked() then
			claim()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.H)
	task.spawn(function()
		while true do
			update()
			-- Rápido solo cuando late (regalo listo y a la vista)
			local gift, left = nextGift()
			task.wait((gui.Enabled and gift and left <= 0) and 0.1 or 0.25)
		end
	end)
end

return PlaytimeGifts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="121">
            <Properties>
              <string name="Name">QuestTracker</string>
              <string name="Source"><![CDATA[-- Retos del día siempre a la vista (izquierda de la pantalla), con barra de progreso que se llena al
-- jugar y un aviso dorado al completarlos. Se oculta en la pantalla de inicio y al morir.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Sounds = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Sounds"))

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local QuestTracker = {}
local phone = false

local gui, panel
local rows = {} -- [índice] = { Frame, Text, Fill, Count, Check, Done, Progress }

local GREEN = Color3.fromRGB(80, 230, 90)
local GOLD = Color3.fromRGB(255, 205, 60)

local function makeRow(index)
	local frame = UI.new("Frame", {
		LayoutOrder = index,
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	local text = UI.label({
		Size = UDim2.new(1, -40, 0, 20),
		Text = "",
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})
	local count = UI.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(60, 20),
		Text = "",
		TextSize = 15,
		TextColor3 = Color3.fromRGB(210, 215, 230),
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = frame,
	})
	local bar = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 0, 12),
		BackgroundColor3 = Color3.fromRGB(30, 32, 44),
		BackgroundTransparency = 0.2,
		Parent = frame,
	}, { UI.corner(6), UI.stroke(Color3.new(0, 0, 0), 1.5, 0.4) })
	local fill = UI.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.fromRGB(70, 170, 255),
		Parent = bar,
	}, { UI.corner(6), UI.gloss() })
	local check = UI.label({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 4, 0, 30),
		Size = UDim2.fromOffset(22, 22),
		Text = "✔",
		TextSize = 20,
		TextColor3 = GREEN,
		Visible = false,
		Parent = frame,
	})
	return { Frame = frame, Text = text, Fill = fill, Count = count, Check = check, Done = nil, Progress = nil }
end

-- Destello dorado cuando se completa un reto
local function celebrate(row)
	Sounds.Play("Flag")
	local flash = UI.new("Frame", {
		Size = UDim2.new(1, 12, 1, 8),
		Position = UDim2.fromOffset(-6, -4),
		BackgroundColor3 = GOLD,
		BackgroundTransparency = 0.35,
		ZIndex = 0,
		Parent = row.Frame,
	}, { UI.corner(8) })
	TweenService:Create(flash, TweenInfo.new(1.2), { BackgroundTransparency = 1 }):Play()
	task.delay(1.3, function()
		flash:Destroy()
	end)
end

local function refresh(data)
	local challenges = data and data.Challenges
	local list = challenges and challenges.List or {}
	for i, entry in list do
		local row = rows[i] or makeRow(i)
		rows[i] = row
		row.Frame.Visible = true
		row.Text.Text = entry.Text or ""
		local goal = math.max(1, entry.Goal or 1)
		local progress = math.min(entry.Progress or 0, goal)
		row.Count.Text = entry.Done and "" or (progress .. "/" .. goal)
		row.Check.Visible = entry.Done == true
		row.Text.TextColor3 = entry.Done and GREEN or Color3.new(1, 1, 1)
		local ratio = entry.Done and 1 or progress / goal
		TweenService:Create(row.Fill, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { Size = UDim2.fromScale(ratio, 1) }):Play()
		row.Fill.BackgroundColor3 = entry.Done and GREEN or Color3.fromRGB(70, 170, 255)
		-- Solo celebra si lo hemos visto pasar de pendiente a hecho (no al cargar)
		if row.Done == false and entry.Done then
			celebrate(row)
		elseif row.Progress and progress > row.Progress and not entry.Done then
			-- Cada paso del reto se nota: el contador da un salto y la barra destella
			local scale = row.Count:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = row.Count })
			scale.Scale = 1.5
			TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
			row.Fill.BackgroundColor3 = Color3.new(1, 1, 1)
			TweenService:Create(row.Fill, TweenInfo.new(0.4), { BackgroundColor3 = Color3.fromRGB(70, 170, 255) }):Play()
		end
		row.Done = entry.Done == true
		row.Progress = progress
	end
	for i = #list + 1, #rows do
		rows[i].Frame.Visible = false
	end
	panel.Parent.Visible = #list > 0
end

function QuestTracker.Init()
	UI.WaitViewport()
	phone = UI.IsPhone()
	gui = UI.new("ScreenGui", {
		Name = "QuestTracker",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local holder = UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 66, 0.38, 0),
		Size = UDim2.fromOffset(250, 190),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	local scale = UI.new("UIScale", { Parent = holder })
	local function rescale()
		local size = camera.ViewportSize
		scale.Scale = math.clamp(math.min(size.X / 1280, size.Y / 720), 0.6, 1)
	end
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()
	UI.label({
		Size = UDim2.new(1, 0, 0, 24),
		Text = "🎯 RETOS DE HOY",
		TextSize = 18,
		TextColor3 = GOLD,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = holder,
	})
	panel = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 1, -28),
		BackgroundTransparency = 1,
		Parent = holder,
	}, { UI.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })

	ClientState.DataChanged.Event:Connect(refresh)
	refresh(ClientState.Data)
	RunService.Heartbeat:Connect(function()
		gui.Enabled = not ClientState.InMainMenu and not ClientState.Dead and not ClientState.MenuOpen
			and ReplicatedStorage:GetAttribute("State") ~= "Ended" -- (no encima del resumen de la partida)
			and not phone -- (en el teléfono no cabe: los retos se ven en el menú y avisan al completarse)
	end)
end

return QuestTracker
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="122">
            <Properties>
              <string name="Name">RewardFX</string>
              <string name="Source"><![CDATA[-- Efectos de recompensa (la "chispa" de los shooters de móvil al hacer algo bien):
--   KillPulse:  al hacer una baja, los bordes de la pantalla destellan (rojo; dorado si es a la cabeza o
--               baja múltiple), el color del mundo se aviva un instante y suena un golpe grave con
--               un "ding" que sube de tono con cada baja seguida
--   AddScore:   contador de puntos de la jugada ("+250") que se acumula y cuenta hacia arriba mientras
--               sigues sumando, como en los shooters; se va solo a los 2,5 s sin sumar
--   Celebrate:  celebración a pantalla completa (rayos girando, confeti y fanfarria) para subir de
--               nivel, ascender de rango o sacar algo bueno en una caja
-- Todo en su propia pantalla, encima del HUD; en calidad Baja, menos confeti.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local Sounds = require(ReplicatedStorage.Shared.Sounds)
local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local RewardFX = {}

local KILL_RED = Color3.fromRGB(255, 50, 50)
local GOLD = Color3.fromRGB(255, 200, 40)
local CONFETTI = {
	Color3.fromRGB(255, 70, 90),
	Color3.fromRGB(255, 200, 40),
	Color3.fromRGB(80, 220, 255),
	Color3.fromRGB(120, 255, 120),
	Color3.fromRGB(200, 110, 255),
	Color3.new(1, 1, 1),
}

local gui
local edges = {}
local pulseCC
local scoreLabel, scoreScale
local scoreTotal, scoreShown, scoreToken = 0, 0, nil
local scoreFade -- el desvanecimiento en curso (se cancela si llegan más puntos)
local celebrating = false
local queue = {} -- celebraciones esperando turno (p. ej. récord y subir de rango a la vez)
local MAX_QUEUE = 2

local function tween(inst, time, props, style, direction)
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function lowQuality()
	return ClientState.EffectiveQuality == "Baja"
end

-- Teléfono (táctil y pantalla baja): todo un poco más pequeño y más arriba, para no tapar la mira
-- ni los botones
local function isPhone()
	return UI.IsPhone()
end
RewardFX.IsPhone = isPhone

-- Bordes de la pantalla: 4 franjas con degradado (opacas en el borde, transparentes hacia dentro)
local function buildEdges()
	local specs = {
		{ Vector2.new(0.5, 0), UDim2.fromScale(0.5, 0), UDim2.fromScale(1, 0.22), 90 },
		{ Vector2.new(0.5, 1), UDim2.fromScale(0.5, 1), UDim2.fromScale(1, 0.22), -90 },
		{ Vector2.new(0, 0.5), UDim2.fromScale(0, 0.5), UDim2.fromScale(0.16, 1), 0 },
		{ Vector2.new(1, 0.5), UDim2.fromScale(1, 0.5), UDim2.fromScale(0.16, 1), 180 },
	}
	for i, spec in specs do
		local frame = Instance.new("Frame")
		frame.Name = "Edge" .. i
		frame.AnchorPoint = spec[1]
		frame.Position = spec[2]
		frame.Size = spec[3]
		frame.BorderSizePixel = 0
		frame.BackgroundColor3 = KILL_RED
		frame.BackgroundTransparency = 1
		local gradient = Instance.new("UIGradient")
		gradient.Rotation = spec[4]
		gradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.6, 0.85),
			NumberSequenceKeypoint.new(1, 1),
		})
		gradient.Parent = frame
		frame.Parent = gui
		edges[i] = frame
	end
end

local function buildScore()
	scoreLabel = Instance.new("TextLabel")
	scoreLabel.Name = "ScoreTotal"
	-- (a la derecha y algo por debajo de la mira, como en los shooters: al crecer no la tapa)
	scoreLabel.AnchorPoint = Vector2.new(0, 0.5)
	-- (en el teléfono, a la derecha de la mira pero por encima: debajo salen los avisos)
	scoreLabel.Position = isPhone() and UDim2.new(0.5, 36, 0.5, -24) or UDim2.new(0.5, 36, 0.5, 30)
	scoreLabel.TextXAlignment = Enum.TextXAlignment.Left
	scoreLabel.Size = UDim2.fromOffset(220, 36)
	scoreLabel.BackgroundTransparency = 1
	scoreLabel.Font = Enum.Font.GothamBlack
	scoreLabel.TextSize = isPhone() and 26 or 32
	scoreLabel.TextColor3 = GOLD
	scoreLabel.TextStrokeTransparency = 0.2
	scoreLabel.Text = ""
	scoreLabel.Visible = false
	scoreLabel.Parent = gui
	scoreScale = Instance.new("UIScale")
	scoreScale.Parent = scoreLabel
end

function RewardFX.Init()
	-- (se espera a saber el tamaño de la pantalla: si no, una tablet podía quedarse con lo del teléfono)
	UI.WaitViewport()
	local player = Players.LocalPlayer
	gui = Instance.new("ScreenGui")
	gui.Name = "RewardFX"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 21 -- (encima de los menús y la ruleta: las celebraciones se ven siempre)
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")
	buildEdges()
	buildScore()
	-- El contador sube poco a poco hasta el total (se ve "contar" los puntos)
	RunService.RenderStepped:Connect(function(dt)
		if scoreShown < scoreTotal then
			scoreShown = math.min(scoreTotal, scoreShown + math.max(4, (scoreTotal - scoreShown) * dt * 9))
			scoreLabel.Text = "+" .. math.floor(scoreShown)
		end
	end)
end

-- Destello de los bordes
function RewardFX.EdgeFlash(color, strength)
	if not gui then
		return
	end
	strength = math.clamp(strength or 0.5, 0, 1)
	for _, edge in edges do
		edge.BackgroundColor3 = color
		edge.BackgroundTransparency = 1 - strength
		tween(edge, 0.45, { BackgroundTransparency = 1 })
	end
end

-- Al hacer una baja (multi = cuántas seguidas en pocos segundos)
function RewardFX.KillPulse(headshot, multi)
	multi = multi or 1
	local special = headshot or multi >= 2
	RewardFX.EdgeFlash(special and GOLD or KILL_RED, math.min(0.35 + 0.1 * multi, 0.7))
	-- El mundo se aviva un instante (más saturado y contrastado)
	if not pulseCC or not pulseCC.Parent then
		pulseCC = Instance.new("ColorCorrectionEffect")
		pulseCC.Name = "KillPulseCC"
		pulseCC.Parent = Lighting
	end
	pulseCC.Saturation = 0.35
	pulseCC.Contrast = 0.12
	pulseCC.Brightness = 0.04
	tween(pulseCC, 0.4, { Saturation = 0, Contrast = 0, Brightness = 0 })
	-- Golpe grave (el "ding" de la baja ya lo pone el marcador de impacto); en bajas seguidas, un
	-- acorde que sube de tono con cada una
	Sounds.Play("Boom", nil, 2.2, 0.18)
	if multi >= 2 then
		local step = 0.12 * math.min(multi - 2, 5)
		task.delay(0.08, function()
			Sounds.Play("Kill", nil, 1.26 + step, 0.5)
			task.wait(0.07)
			Sounds.Play("Kill", nil, 1.5 + step, 0.45)
		end)
	end
end

-- Suma puntos al contador de la jugada
function RewardFX.AddScore(amount)
	if not gui or type(amount) ~= "number" or amount <= 0 then
		return
	end
	if not scoreLabel.Visible then
		scoreTotal, scoreShown = 0, 0
		scoreLabel.Text = "+0"
	end
	if scoreFade then
		scoreFade:Cancel()
		scoreFade = nil
	end
	scoreTotal += amount
	scoreLabel.Visible = true
	scoreLabel.TextTransparency = 0
	scoreLabel.TextStrokeTransparency = 0.2
	-- (más grande y más naranja cuanto más llevas)
	scoreLabel.TextColor3 = GOLD:Lerp(Color3.fromRGB(255, 110, 40), math.clamp(scoreTotal / 1500, 0, 1))
	scoreScale.Scale = 1.35 + math.clamp(scoreTotal / 3000, 0, 0.4)
	tween(scoreScale, 0.25, { Scale = 1 + math.clamp(scoreTotal / 4000, 0, 0.3) }, Enum.EasingStyle.Back)
	local token = {}
	scoreToken = token
	task.delay(2.5, function()
		if scoreToken ~= token then
			return
		end
		scoreFade = tween(scoreLabel, 0.35, { TextTransparency = 1, TextStrokeTransparency = 1 })
		task.wait(0.35)
		if scoreToken == token then
			scoreLabel.Visible = false
		end
	end)
end

-- Saca la cantidad de un aviso de XP ("+120 XP  Baja" → 120)
function RewardFX.ParseXP(text)
	if type(text) ~= "string" then
		return nil
	end
	local amount = string.match(text, "^%+(%d+) XP")
	return amount and tonumber(amount) or nil
end

-- Confeti: trocitos de colores que salen disparados del centro y caen girando
local function confetti(parent, count)
	for _ = 1, count do
		local piece = Instance.new("Frame")
		piece.AnchorPoint = Vector2.new(0.5, 0.5)
		piece.Position = UDim2.fromScale(0.5 + (math.random() - 0.5) * 0.1, isPhone() and 0.25 or 0.35)
		piece.Size = UDim2.fromOffset(math.random(6, 12), math.random(10, 18))
		piece.BorderSizePixel = 0
		piece.BackgroundColor3 = CONFETTI[math.random(1, #CONFETTI)]
		piece.Rotation = math.random(0, 360)
		piece.ZIndex = 3
		piece.Parent = parent
		local angle = math.random() * math.pi * 2
		local spread = 0.15 + math.random() * 0.35
		local up = UDim2.fromScale(0.5 + math.cos(angle) * spread, 0.35 + math.sin(angle) * spread * 0.6 - 0.12)
		local fall = UDim2.fromScale(up.X.Scale + (math.random() - 0.5) * 0.15, 1.1)
		local burst = tween(piece, 0.45, { Position = up, Rotation = piece.Rotation + math.random(-180, 180) }, Enum.EasingStyle.Quad)
		burst.Completed:Once(function()
			if piece.Parent then
				tween(piece, 1.6 + math.random() * 0.8, {
					Position = fall,
					Rotation = piece.Rotation + math.random(-540, 540),
					BackgroundTransparency = 0.3,
				}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			end
		end)
	end
end

-- Fanfarria: tres notas que suben y un golpe grave
local function fanfare(big)
	Sounds.Play("Boom", nil, 1.6, big and 0.3 or 0.2)
	for i, pitch in { 1, 1.26, 1.5, big and 2 or nil } do
		task.delay((i - 1) * 0.11, function()
			Sounds.Play("Kill", nil, pitch, 0.6)
		end)
	end
end

-- Lluvia de confeti sola (p. ej. al ganar la partida, sin tapar el panel del resultado)
function RewardFX.Confetti(count)
	if not gui then
		return
	end
	local holder = Instance.new("Frame")
	holder.Name = "Confetti"
	holder.Size = UDim2.fromScale(1, 1)
	holder.BackgroundTransparency = 1
	holder.Parent = gui
	confetti(holder, math.floor((count or 40) * (lowQuality() and 0.45 or 1)))
	task.delay(3.5, function()
		holder:Destroy()
	end)
end

RewardFX.Fanfare = fanfare

-- Texto de golpe en el centro (p. ej. «¡A LUCHAR!» al empezar): entra enorme, se queda un momento y
-- se desvanece, con un golpe grave
function RewardFX.Punch(text, color)
	if not gui then
		return nil
	end
	local label = Instance.new("TextLabel")
	label.Name = "Punch"
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, isPhone() and 0.28 or 0.36)
	label.Size = UDim2.new(0.9, 0, 0, isPhone() and 56 or 90)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.Text = tostring(text)
	label.Parent = gui
	local fit = Instance.new("UITextSizeConstraint")
	fit.MaxTextSize = 80
	fit.Parent = label
	local scale = Instance.new("UIScale")
	scale.Scale = 2.5
	scale.Parent = label
	tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	Sounds.Play("Boom", nil, 1.3, 0.35)
	task.delay(0.9, function()
		tween(label, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
		tween(scale, 0.4, { Scale = 1.3 })
		task.wait(0.45)
		label:Destroy()
	end)
	return label
end

-- Monedas que salen del centro y vuelan hasta un contador (target: un GuiObject), con un "tin" al
-- llegar cada una y un saltito del contador al final
function RewardFX.FlyCoins(target, count, icon)
	if not gui or not target or typeof(target.AbsolutePosition) ~= "Vector2" then
		return
	end
	count = math.clamp(count or 8, 1, lowQuality() and 6 or 12)
	local goal = target.AbsolutePosition + target.AbsoluteSize / 2
	for i = 1, count do
		task.delay((i - 1) * 0.05, function()
			local coin = Instance.new("TextLabel")
			coin.AnchorPoint = Vector2.new(0.5, 0.5)
			coin.Position = UDim2.new(0.5, math.random(-90, 90), 0.5, math.random(-50, 50))
			coin.Size = UDim2.fromOffset(32, 32)
			coin.BackgroundTransparency = 1
			coin.Font = Enum.Font.GothamBold
			coin.TextSize = 28
			coin.Text = icon or "🪙"
			coin.ZIndex = 4
			coin.Parent = gui
			tween(coin, 0.55, { Position = UDim2.fromOffset(goal.X, goal.Y) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.55, function()
				coin:Destroy()
				Sounds.Play("Click", nil, 1.3 + 0.06 * i, 0.5)
				if i == count then
					local scale = target:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
					scale.Parent = target
					scale.Scale = 1.3
					tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
				end
			end)
		end)
	end
end

-- Celebración a pantalla completa. title: texto grande; subtitle: debajo (opcional);
-- color: el de la celebración; big: más confeti y una nota más. Si ya hay una en pantalla, espera
-- su turno (devuelve true); si la cola está llena, nil
-- priority: pasa delante en la cola (y si está llena, echa a la última): subir de rango o de nivel no
-- se pierde nunca por otras celebraciones menores
function RewardFX.Celebrate(title, subtitle, color, big, priority)
	if not gui then
		return nil
	end
	if celebrating then
		local entry = { title, subtitle, color, big }
		if priority then
			if #queue >= MAX_QUEUE then
				table.remove(queue)
			end
			table.insert(queue, 1, entry)
			return true
		end
		if #queue >= MAX_QUEUE then
			return nil
		end
		table.insert(queue, entry)
		return true
	end
	celebrating = true
	color = color or GOLD
	local holder = Instance.new("Frame")
	holder.Name = "Celebration"
	holder.Size = UDim2.fromScale(1, 1)
	holder.BackgroundTransparency = 1
	holder.Parent = gui
	-- Rayos de luz girando detrás del título
	local rays = Instance.new("Frame")
	rays.AnchorPoint = Vector2.new(0.5, 0.5)
	local phone = isPhone()
	local titleY = phone and 0.22 or 0.33
	rays.Position = UDim2.fromScale(0.5, titleY)
	rays.Size = UDim2.fromOffset(10, 10)
	rays.BackgroundTransparency = 1
	rays.Parent = holder
	local rayCount = lowQuality() and 6 or 10
	for i = 1, rayCount do
		local ray = Instance.new("Frame")
		ray.AnchorPoint = Vector2.new(0.5, 0.5)
		ray.Position = UDim2.fromScale(0.5, 0.5)
		ray.Size = UDim2.fromOffset(46, 900)
		ray.Rotation = (i - 1) * (180 / rayCount)
		ray.BorderSizePixel = 0
		ray.BackgroundColor3 = color
		ray.BackgroundTransparency = 0.82
		local gradient = Instance.new("UIGradient")
		gradient.Rotation = 90
		gradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0),
			NumberSequenceKeypoint.new(1, 1),
		})
		gradient.Parent = ray
		ray.Parent = rays
	end
	local raysScale = Instance.new("UIScale")
	raysScale.Scale = 0.2
	raysScale.Parent = rays
	tween(raysScale, 0.5, { Scale = phone and 0.6 or 1 }, Enum.EasingStyle.Back)
	tween(rays, 3.2, { Rotation = 70 }, Enum.EasingStyle.Linear)
	-- Destello blanco de un instante
	local flash = Instance.new("Frame")
	flash.Size = UDim2.fromScale(1, 1)
	flash.BorderSizePixel = 0
	flash.BackgroundColor3 = Color3.new(1, 1, 1)
	flash.BackgroundTransparency = 0.55
	flash.Parent = holder
	tween(flash, 0.35, { BackgroundTransparency = 1 })
	RewardFX.EdgeFlash(color, 0.6)
	-- Título
	local label = Instance.new("TextLabel")
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, titleY)
	-- (ancho relativo y texto que se encoge: en un móvil en horizontal cabe entero)
	label.Size = UDim2.new(0.92, 0, 0, phone and 54 or 80)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextSize = 64
	label.TextScaled = true
	local fit = Instance.new("UITextSizeConstraint")
	fit.MaxTextSize = 64
	fit.Parent = label
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.Text = tostring(title)
	label.ZIndex = 2
	label.Parent = holder
	local scale = Instance.new("UIScale")
	scale.Scale = 2.4
	scale.Parent = label
	tween(scale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	local sub
	if subtitle then
		sub = Instance.new("TextLabel")
		sub.AnchorPoint = Vector2.new(0.5, 0)
		sub.Position = UDim2.new(0.5, 0, titleY, phone and 30 or 44)
		sub.Size = UDim2.new(0.9, 0, 0, phone and 24 or 34)
		sub.BackgroundTransparency = 1
		sub.Font = Enum.Font.GothamBold
		sub.TextSize = 26
		sub.TextScaled = true
		local subFit = Instance.new("UITextSizeConstraint")
		subFit.MaxTextSize = 26
		subFit.Parent = sub
		sub.TextColor3 = Color3.new(1, 1, 1)
		sub.TextStrokeTransparency = 0.2
		sub.TextTransparency = 1
		sub.Text = tostring(subtitle)
		sub.ZIndex = 2
		sub.Parent = holder
		task.delay(0.25, function()
			tween(sub, 0.3, { TextTransparency = 0 })
		end)
	end
	confetti(holder, math.floor((lowQuality() and 18 or (phone and 28 or 40)) * (big and 1.5 or 1)))
	fanfare(big)
	task.delay(2.6, function()
		tween(label, 0.5, { TextTransparency = 1, TextStrokeTransparency = 1 })
		if sub then
			tween(sub, 0.5, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
		for _, ray in rays:GetChildren() do
			if ray:IsA("Frame") then
				tween(ray, 0.5, { BackgroundTransparency = 1 })
			end
		end
		task.wait(0.9)
		holder:Destroy()
		celebrating = false
		local nextOne = table.remove(queue, 1)
		if nextOne then
			RewardFX.Celebrate(nextOne[1], nextOne[2], nextOne[3], nextOne[4])
		end
	end)
	return holder
end

return RewardFX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="123">
            <Properties>
              <string name="Name">RiflePose</string>
              <string name="Source"><![CDATA[-- Postura realista: los personajes (bots y los demás jugadores) sujetan el arma de fuego con las dos
-- manos, como soldados: la culata al hombro derecho, la mano derecha en la empuñadura y la izquierda en
-- el guardamanos; con pistola, los brazos estirados y las dos manos en la empuñadura. Usa IKControl (la
-- cinemática inversa de Roblox) solo en este cliente: no cambia nada del juego, solo cómo se ven. Con
-- el arma cuerpo a cuerpo, la granada o sin arma, la animación de siempre. Tu propio personaje no (en
-- primera persona no se ve). GameConfig.TwoHandedPose = false lo quita.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Weapons = require(ReplicatedStorage.Shared.Weapons)
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local RiflePose = {}

-- Medidas respecto al pecho (UpperTorso: X a la derecha, Y arriba, -Z hacia delante)
RiflePose.ButtAt = Vector3.new(0.3, 0.45, -0.3) -- dónde apoya la culata (hombro derecho)
RiflePose.PistolGrip = Vector3.new(0.05, 0.45, -1.8) -- empuñadura de la pistola, brazos estirados
local LEFT_SHOULDER = Vector3.new(-1, 0.56, 0)
local REACH = 2.3 -- lo que llega el brazo (del hombro al centro de la mano)
local POLE_RIGHT = Vector3.new(2.2, -1.6, 0.6) -- el codo derecho, abajo y hacia fuera
local POLE_LEFT = Vector3.new(-1.6, -1.8, -0.4) -- el codo izquierdo, abajo

local player = Players.LocalPlayer
local rigs = {} -- [Model] = { Right, Left, Grip, Hand, Connections }
local rearCache = {} -- [arma] = z de lo más trasero del arma (la culata), en el espacio del arma

-- Lo más trasero del arma (culata), a tamaño completo
local function rearOf(def, name)
	local cached = rearCache[name]
	if cached then
		return cached
	end
	local rear = 0
	for _, spec in def.Parts or {} do
		rear = math.max(rear, spec.CFrame.Position.Z + spec.Size.Z / 2)
	end
	rearCache[name] = rear
	return rear
end

-- Dónde van la mano derecha (con su giro: el arma mira hacia delante) y la izquierda, respecto al pecho.
-- Devuelve CFrame de la empuñadura y Vector3 de la mano izquierda, o nil si no es un arma de fuego
function RiflePose.Targets(weaponName, scale)
	local def = weaponName and Weapons.Get(weaponName)
	if not def or def.Type ~= "Gun" or not def.RightHand then
		return nil
	end
	scale = scale or 1
	local right = def.RightHand * scale
	local left = (def.LeftHand or def.RightHand) * scale
	local handle -- dónde queda el origen del arma
	if def.Slot == 2 then
		handle = RiflePose.PistolGrip - right
	else
		-- La culata en el hombro: el arma se coloca para que su parte trasera quede ahí
		local rear = rearOf(def, weaponName) * scale
		handle = RiflePose.ButtAt - Vector3.new(0, 0, rear)
	end
	local grip = CFrame.new(handle + right)
	local hand = handle + left
	-- Si el guardamanos queda demasiado lejos para el brazo izquierdo, la mano se agarra más atrás
	local offset = hand - LEFT_SHOULDER
	if offset.Magnitude > REACH then
		local side = offset.X * offset.X + offset.Y * offset.Y
		if side < REACH * REACH then
			hand = Vector3.new(hand.X, hand.Y, LEFT_SHOULDER.Z - math.sqrt(REACH * REACH - side))
		end
	end
	return grip, hand
end

local function attachment(parent, name, position)
	local a = parent:FindFirstChild(name)
	if not (a and a:IsA("Attachment")) then
		a = Instance.new("Attachment")
		a.Name = name
		a.Parent = parent
	end
	if typeof(position) == "CFrame" then
		a.CFrame = position
	else
		a.Position = position
	end
	return a
end

local function heldGun(model)
	for _, child in model:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute("Weapon") then
			return child
		end
	end
	return nil
end

local function update(model)
	local rig = rigs[model]
	if not rig then
		return
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local tool = heldGun(model)
	local grip, hand
	if tool and humanoid and humanoid.Health > 0 then
		grip, hand = RiflePose.Targets(tool:GetAttribute("Weapon"), tool:GetAttribute("WorldScale") or 1)
	end
	if grip and hand then
		rig.Grip.CFrame = grip
		rig.Hand.Position = hand
		rig.Right.Enabled = true
		rig.Left.Enabled = true
	else
		rig.Right.Enabled = false
		rig.Left.Enabled = false
	end
end

local function release(model)
	local rig = rigs[model]
	if not rig then
		return
	end
	rigs[model] = nil
	for _, connection in rig.Connections do
		connection:Disconnect()
	end
	for _, instance in { rig.Right, rig.Left, rig.Grip, rig.Hand, rig.PoleRight, rig.PoleLeft } do
		if instance then
			instance:Destroy()
		end
	end
end

function RiflePose.Setup(model)
	if GameConfig.TwoHandedPose == false or rigs[model] or (player and model == player.Character) then
		return
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local torso = model:FindFirstChild("UpperTorso")
	local rightArm, leftArm = model:FindFirstChild("RightUpperArm"), model:FindFirstChild("LeftUpperArm")
	local rightHand, leftHand = model:FindFirstChild("RightHand"), model:FindFirstChild("LeftHand")
	-- (solo personajes R15 con sus manos)
	if not (humanoid and torso and rightArm and leftArm and rightHand and leftHand) then
		return
	end
	local rightGrip = rightHand:FindFirstChild("RightGripAttachment")
	if not rightGrip then
		return
	end
	local leftGrip = leftHand:FindFirstChild("LeftGripAttachment") or leftHand
	local grip = attachment(torso, "PoseGrip", CFrame.new())
	local hand = attachment(torso, "PoseLeftHand", Vector3.zero)
	local poleRight = attachment(torso, "PoseElbowR", POLE_RIGHT)
	local poleLeft = attachment(torso, "PoseElbowL", POLE_LEFT)

	local right = Instance.new("IKControl")
	right.Name = "PoseRightArm"
	right.Type = Enum.IKControlType.Transform
	right.ChainRoot = rightArm
	right.EndEffector = rightGrip
	right.Target = grip
	right.Pole = poleRight
	right.SmoothTime = 0.08
	right.Weight = 1
	right.Enabled = false
	right.Parent = humanoid

	local left = Instance.new("IKControl")
	left.Name = "PoseLeftArm"
	left.Type = Enum.IKControlType.Position
	left.ChainRoot = leftArm
	left.EndEffector = leftGrip
	left.Target = hand
	left.Pole = poleLeft
	left.SmoothTime = 0.08
	left.Weight = 1
	left.Enabled = false
	left.Parent = humanoid

	local rig = {
		Right = right,
		Left = left,
		Grip = grip,
		Hand = hand,
		PoleRight = poleRight,
		PoleLeft = poleLeft,
		Connections = {},
	}
	rigs[model] = rig
	table.insert(rig.Connections, model.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			update(model)
		end
	end))
	table.insert(rig.Connections, model.ChildRemoved:Connect(function(child)
		if child:IsA("Tool") then
			update(model)
		end
	end))
	-- Al morir, el cuerpo cae suelto (Ragdoll): nada de sujetar el arma
	table.insert(rig.Connections, humanoid.Died:Connect(function()
		release(model)
	end))
	table.insert(rig.Connections, model.AncestryChanged:Connect(function()
		if not model.Parent then
			release(model)
		end
	end))
	update(model)
end

-- (para las pruebas)
function RiflePose.Rig(model)
	return rigs[model]
end

local function watchPlayer(other)
	if other == player then
		return
	end
	other.CharacterAdded:Connect(function(character)
		-- (las piezas del personaje llegan un poco después)
		character:WaitForChild("UpperTorso", 10)
		character:WaitForChild("RightHand", 10)
		character:WaitForChild("LeftHand", 10)
		RiflePose.Setup(character)
	end)
	if other.Character then
		task.spawn(RiflePose.Setup, other.Character)
	end
end

function RiflePose.Init()
	if GameConfig.TwoHandedPose == false then
		return
	end
	for _, other in Players:GetPlayers() do
		watchPlayer(other)
	end
	Players.PlayerAdded:Connect(watchPlayer)
	local function watchBots(folder)
		for _, model in folder:GetChildren() do
			if model:IsA("Model") then
				task.spawn(RiflePose.Setup, model)
			end
		end
		folder.ChildAdded:Connect(function(model)
			if model:IsA("Model") then
				task.wait(0.2) -- (el bot se monta entero antes de entrar en la carpeta, pero por si acaso)
				RiflePose.Setup(model)
			end
		end)
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		watchBots(bots)
	end
	workspace.ChildAdded:Connect(function(child)
		if child.Name == "Bots" and child:IsA("Folder") then
			watchBots(child)
		end
	end)
end

return RiflePose
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="124">
            <Properties>
              <string name="Name">ScopeGlint</string>
              <string name="Source"><![CDATA[-- Destello de la mira (como en los shooters): un bot tirador enemigo que está quieto y mira hacia
-- ti brilla a lo lejos, así puedes saber desde dónde te apunta. Solo en el cliente; las paredes lo
-- tapan (no es un contorno a través de los muros).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local ScopeGlint = {}

local MIN_DISTANCE = 35 -- de cerca no hace falta
local MAX_DISTANCE = 450
local FACING = 0.93 -- coseno del ángulo: tiene que mirar casi hacia la cámara
local CHECK_INTERVAL = 0.1

local player = Players.LocalPlayer
local glints = {} -- [modelo del bot] = BillboardGui

local function isEnemy(model)
	if ReplicatedStorage:GetAttribute("TeamMode") == false then
		return true
	end
	local team = model:GetAttribute("Team")
	return team == nil or player.Team == nil or team ~= player.Team.Name
end

local function makeGlint(head)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ScopeGlint"
	billboard.Size = UDim2.fromOffset(30, 30)
	billboard.StudsOffset = Vector3.new(0.4, 0.1, 0)
	billboard.LightInfluence = 0
	billboard.AlwaysOnTop = false
	billboard.MaxDistance = MAX_DISTANCE
	billboard.Adornee = head
	-- Un punto blanco con un aro y dos rayos en cruz
	local core = Instance.new("Frame")
	core.Name = "Core"
	core.AnchorPoint = Vector2.new(0.5, 0.5)
	core.Position = UDim2.fromScale(0.5, 0.5)
	core.Size = UDim2.fromScale(0.42, 0.42)
	core.BackgroundColor3 = Color3.fromRGB(255, 255, 235)
	core.BorderSizePixel = 0
	core.Parent = billboard
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = core
	for _, size in { UDim2.fromScale(1, 0.08), UDim2.fromScale(0.08, 1) } do
		local ray = Instance.new("Frame")
		ray.AnchorPoint = Vector2.new(0.5, 0.5)
		ray.Position = UDim2.fromScale(0.5, 0.5)
		ray.Size = size
		ray.BackgroundColor3 = Color3.fromRGB(255, 250, 210)
		ray.BackgroundTransparency = 0.25
		ray.BorderSizePixel = 0
		ray.Parent = billboard
	end
	billboard.Parent = head
	return billboard
end

local function update()
	local folder = workspace:FindFirstChild("Bots")
	local camera = workspace.CurrentCamera
	local seen = {}
	if folder and camera then
		local cameraPosition = camera.CFrame.Position
		for _, model in folder:GetChildren() do
			if model:GetAttribute("Role") ~= "Tirador" or not isEnemy(model) then
				continue
			end
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart")
			local head = model:FindFirstChild("Head")
			if not (humanoid and root and head and root:IsA("BasePart") and head:IsA("BasePart")) or humanoid.Health <= 0 then
				continue
			end
			local offset = cameraPosition - head.Position
			local distance = offset.Magnitude
			local velocity = root.AssemblyLinearVelocity
			local still = Vector3.new(velocity.X, 0, velocity.Z).Magnitude < 4
			if distance > MIN_DISTANCE and distance < MAX_DISTANCE and still then
				local look = root.CFrame.LookVector
				local flatLook = Vector3.new(look.X, 0, look.Z)
				local flatOffset = Vector3.new(offset.X, 0, offset.Z)
				if flatLook.Magnitude > 0.01 and flatOffset.Magnitude > 0.01 and flatLook.Unit:Dot(flatOffset.Unit) > FACING then
					seen[model] = true
					local glint = glints[model]
					if not glint or glint.Parent ~= head then
						if glint then
							glint:Destroy()
						end
						glint = makeGlint(head)
						glints[model] = glint
					end
					-- (parpadea un poco, como el reflejo del sol en la lente)
					local pulse = 0.5 + 0.5 * math.sin(os.clock() * 9)
					local core = glint:FindFirstChild("Core")
					if core and core:IsA("Frame") then
						core.BackgroundTransparency = 0.05 + 0.3 * pulse
					end
					glint.Size = UDim2.fromOffset(26 + 10 * pulse, 26 + 10 * pulse)
				end
			end
		end
	end
	for model, glint in glints do
		if not seen[model] then
			glint:Destroy()
			glints[model] = nil
		end
	end
end

function ScopeGlint.Init()
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < CHECK_INTERVAL then
			return
		end
		elapsed = 0
		update()
	end)
end

ScopeGlint.Update = update
return ScopeGlint
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="125">
            <Properties>
              <string name="Name">ScopeSway</string>
              <string name="Source"><![CDATA[-- Visor de francotirador realista: con el visor puesto la mira nunca está del todo quieta (el pulso y
-- la respiración la mueven en un "ocho" lento y pequeño). Con Mayús (o el stick izquierdo pulsado en el
-- mando) aguantas la respiración unos 3,5 s y la mira se queda casi quieta; al acabarse el aire se
-- mueve más un momento hasta recuperarlo. Agachado se mueve menos; en el móvil, la mitad (allí no hay
-- tecla para aguantar). WeaponController aplica a la cámara lo que devuelve Update cada fotograma.
local UserInputService = game:GetService("UserInputService")

local ClientState = require(script.Parent.ClientState)

local ScopeSway = {}

ScopeSway.Amplitude = math.rad(0.22) -- cuánto se mueve la mira con el visor (sin aguantar)
ScopeSway.HoldTime = 3.5 -- segundos que se aguanta la respiración
ScopeSway.RecoverTime = 2.5 -- segundos para recuperar todo el aire
ScopeSway.ExhaleTime = 1.2 -- al quedarte sin aire, este rato se mueve el doble
ScopeSway.Holding = false -- aguantando la respiración ahora mismo (el HUD lo dice en el visor)
ScopeSway.Breath = 1 -- aire que queda (0..1)

local exhaleUntil = 0
local amp = 0
local lastPitch, lastYaw = 0, 0

local function holdPressed()
	local ok, down = pcall(function()
		if UserInputService:GetFocusedTextBox() then
			return false
		end
		return UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
			or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
			or UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonL3)
	end)
	return ok and down == true
end

local function touchOnly()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

-- Cuánto se mueve ahora mismo (radianes; 0 sin visor)
function ScopeSway.Amount()
	return amp
end

-- ¿Sin aire (recuperándolo tras aguantar demasiado)?
function ScopeSway.OutOfBreath()
	return os.clock() < exhaleUntil
end

-- Devuelve el giro (cabeceo, guiñada) que hay que sumar a la cámara en ESTE fotograma: la diferencia
-- con el balanceo del anterior (así no se acumula y al quitar el visor vuelve solo a su sitio)
function ScopeSway.Update(dt, scoped)
	local now = os.clock()
	local holding = false
	if scoped and now >= exhaleUntil and ScopeSway.Breath > 0 and holdPressed() then
		holding = true
		ScopeSway.Breath = math.max(0, ScopeSway.Breath - dt / ScopeSway.HoldTime)
		if ScopeSway.Breath <= 0 then
			exhaleUntil = now + ScopeSway.ExhaleTime
		end
	else
		ScopeSway.Breath = math.min(1, ScopeSway.Breath + dt / ScopeSway.RecoverTime)
	end
	ScopeSway.Holding = holding
	local target = 0
	if scoped then
		target = ScopeSway.Amplitude
		if holding then
			target *= 0.08
		elseif now < exhaleUntil then
			target *= 2
		end
		if ClientState.Crouching then
			target *= 0.6
		end
		if touchOnly() then
			target *= 0.5
		end
	end
	amp += (target - amp) * math.min(1, dt * 4)
	local pitch = (math.sin(now * 0.9) * 0.6 + math.sin(now * 2.3) * 0.15) * amp
	local yaw = (math.sin(now * 0.55) + math.sin(now * 1.7) * 0.2) * amp
	local dPitch, dYaw = pitch - lastPitch, yaw - lastYaw
	lastPitch, lastYaw = pitch, yaw
	return dPitch, dYaw
end

-- Al morir o reaparecer: todo a cero (la cámara nueva no arrastra el balanceo de antes)
function ScopeSway.Reset()
	amp, lastPitch, lastYaw = 0, 0, 0
	exhaleUntil = 0
	ScopeSway.Breath = 1
	ScopeSway.Holding = false
end

return ScopeSway
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="126">
            <Properties>
              <string name="Name">Scoreboard</string>
              <string name="Source"><![CDATA[-- Marcador de la partida (mantén Tab; en móvil, botón 📋): los dos equipos en columnas (o una sola
-- lista en los modos sin equipos) con bajas, muertes y puntos. Incluye a los bots (ReplicatedStorage.
-- BotStats, que rellena el servidor) y resalta tu fila. Sustituye a la lista de jugadores de Roblox.
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Ranks = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Ranks"))
local ClientState = require(script.Parent.ClientState)
local TouchLayout = require(script.Parent.TouchLayout)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local Scoreboard = {}

local gui, panel, title, columns
local visible = false
local ROW_HEIGHT = 30
local MAX_ROWS = 10

-- Una fila por jugador o bot: { Name, Team, Kills, Deaths, Score, Captures, IsBot, IsMe }
local function collect()
	local rows = {}
	for _, p in Players:GetPlayers() do
		local stats = p:FindFirstChild("leaderstats")
		local kills = stats and stats:FindFirstChild("Bajas")
		local deaths = stats and stats:FindFirstChild("Muertes")
		local rank = Ranks.Tiers[p:GetAttribute("Rank") or 0]
		-- Título elegido (Titles), pequeño y de su color detrás del nombre
		local title = p:GetAttribute("Title")
		local titleColor = p:GetAttribute("TitleColor")
		local titleText = ""
		if type(title) == "string" and title ~= "" then
			local hex = typeof(titleColor) == "Color3" and titleColor:ToHex() or "C8C8D2"
			titleText = string.format('  <font size="14" color="#%s">%s</font>', hex, title)
		end
		table.insert(rows, {
			Name = (rank and (rank.Icon .. " ") or "") .. p.DisplayName .. titleText,
			Team = p.Team,
			Kills = kills and kills.Value or 0,
			Deaths = deaths and deaths.Value or 0,
			Score = p:GetAttribute("Score") or 0,
			Captures = p:GetAttribute("Captures") or 0,
			InMenu = p:GetAttribute("InMenu") == true,
			IsMe = p == player,
		})
	end
	local bots = ReplicatedStorage:FindFirstChild("BotStats")
	if bots then
		for _, entry in bots:GetChildren() do
			local teamName = entry:GetAttribute("Team")
			local team = teamName and teamName ~= "" and Teams:FindFirstChild(teamName) or nil
			table.insert(rows, {
				Name = "🤖 " .. entry.Name,
				Team = team,
				Kills = entry:GetAttribute("Kills") or 0,
				Deaths = entry:GetAttribute("Deaths") or 0,
				Score = entry:GetAttribute("Score") or 0,
				Captures = 0,
				IsBot = true,
			})
		end
	end
	return rows
end

local function header(parent, text, color)
	local bar = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = color,
		Parent = parent,
	}, { UI.corner(8) })
	UI.label({
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -24, 1, 0),
		Text = text,
		TextSize = 22,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = bar,
	})
	return bar
end

local function columnTitles(parent, y, third)
	local frame = UI.new("Frame", {
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	for i, text in { "JUGADOR", "BAJAS", "MUERTES", third } do
		UI.label({
			Position = i == 1 and UDim2.fromOffset(12, 0) or UDim2.new(1, -230 + (i - 2) * 76, 0, 0),
			Size = UDim2.fromOffset(i == 1 and 200 or 76, 22),
			Text = text,
			TextSize = 14,
			TextColor3 = Color3.fromRGB(200, 200, 220),
			TextXAlignment = i == 1 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center,
			Parent = frame,
		})
	end
end

local function rowFrame(parent, y, row, thirdValue, color)
	local frame = UI.new("Frame", {
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.new(1, 0, 0, ROW_HEIGHT - 2),
		BackgroundColor3 = row.IsMe and Color3.fromRGB(255, 205, 60) or color,
		BackgroundTransparency = row.IsMe and 0.25 or 0.65,
		Parent = parent,
	}, { UI.corner(6) })
	UI.label({
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -250, 1, 0),
		Text = row.Name .. (row.InMenu and "  💤" or ""),
		RichText = true,
		TextSize = 18,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = row.IsBot and Color3.fromRGB(215, 215, 230) or Color3.new(1, 1, 1),
		Parent = frame,
	})
	for i, value in { row.Kills, row.Deaths, thirdValue } do
		UI.label({
			Position = UDim2.new(1, -230 + (i - 1) * 76, 0, 0),
			Size = UDim2.fromOffset(76, ROW_HEIGHT - 2),
			Text = tostring(value),
			TextSize = 19,
			Parent = frame,
		})
	end
end

-- Columna de un equipo (o de todos en los modos sin equipos)
local function buildColumn(x, width, headerText, headerColor, rows, thirdTitle, thirdOf)
	local column = UI.new("Frame", {
		Position = UDim2.fromOffset(x, 56),
		Size = UDim2.fromOffset(width, 60 + MAX_ROWS * ROW_HEIGHT),
		BackgroundTransparency = 1,
		Parent = columns,
	})
	header(column, headerText, headerColor)
	columnTitles(column, 38, thirdTitle)
	-- Si no caben todos, tu fila siempre sale (en el último hueco)
	local shown = table.move(rows, 1, math.min(#rows, MAX_ROWS), 1, {})
	for i = MAX_ROWS + 1, #rows do
		if rows[i].IsMe then
			shown[MAX_ROWS] = rows[i]
		end
	end
	for i, row in shown do
		rowFrame(column, 60 + (i - 1) * ROW_HEIGHT, row, thirdOf(row), headerColor:Lerp(Color3.new(0, 0, 0), 0.4))
	end
	return column
end

local lastSignature = ""

local function refresh()
	if not visible then
		return
	end
	local mode = ReplicatedStorage:GetAttribute("Mode")
	local teamMode = ReplicatedStorage:GetAttribute("TeamMode") ~= false
	local mapName = ReplicatedStorage:GetAttribute("MapName") or ""
	local modeName = ReplicatedStorage:GetAttribute("ModeName") or ""
	title.Text = UI.upper(modeName) .. "  ·  " .. mapName .. "  ·  " .. UI.formatTime(ReplicatedStorage:GetAttribute("TimeLeft") or 0)
	local rows = collect()
	-- Solo se reconstruye si ha cambiado algo (si no, cada medio segundo se crearían ~150 objetos)
	local parts = { tostring(mode), tostring(ReplicatedStorage:GetAttribute("TeamMode")), tostring(ReplicatedStorage:GetAttribute("LeaderName")) }
	for _, row in rows do
		table.insert(parts, string.format("%s/%s/%d/%d/%d/%d/%s", row.Name, tostring(row.Team), row.Kills, row.Deaths, row.Score, row.Captures, tostring(row.InMenu)))
	end
	for _, teamName in { ReplicatedStorage:GetAttribute("TeamA"), ReplicatedStorage:GetAttribute("TeamB") } do
		table.insert(parts, tostring(teamName and ReplicatedStorage:GetAttribute("Score_" .. teamName)))
	end
	local signature = table.concat(parts, "|")
	if signature == lastSignature and #columns:GetChildren() > 0 then
		return
	end
	lastSignature = signature
	columns:ClearAllChildren()
	local thirdTitle, thirdOf = "PUNTOS", function(row)
		return row.Score
	end
	if mode == "CTF" then
		thirdTitle, thirdOf = "CAPTURAS", function(row)
			return row.Captures
		end
	elseif teamMode then
		thirdTitle, thirdOf = "K/D", function(row)
			return string.format("%.1f", row.Kills / math.max(1, row.Deaths))
		end
	end
	local function byKills(a, b)
		if a.Kills ~= b.Kills then
			return a.Kills > b.Kills
		end
		return a.Deaths < b.Deaths
	end
	if teamMode then
		local nameA = ReplicatedStorage:GetAttribute("TeamA")
		local nameB = ReplicatedStorage:GetAttribute("TeamB")
		for i, teamName in { nameA, nameB } do
			local team = teamName and Teams:FindFirstChild(teamName)
			local list = {}
			for _, row in rows do
				if team and row.Team == team then
					table.insert(list, row)
				end
			end
			table.sort(list, byKills)
			local color = team and team:IsA("Team") and team.TeamColor.Color or Color3.fromRGB(80, 80, 100)
			local score = teamName and (ReplicatedStorage:GetAttribute("Score_" .. teamName) or 0) or 0
			local text = string.format("<b>%s</b>   %d", UI.upper(teamName or "?"), score)
			buildColumn((i - 1) * 472, 440, text, color, list, thirdTitle, thirdOf)
		end
		panel.Size = UDim2.fromOffset(940, 56 + 60 + MAX_ROWS * ROW_HEIGHT + 16)
	else
		table.sort(rows, function(a, b)
			if a.Score ~= b.Score then
				return a.Score > b.Score
			end
			return byKills(a, b)
		end)
		local leader = ReplicatedStorage:GetAttribute("LeaderName")
		buildColumn(0, 572, "<b>TODOS CONTRA TODOS</b>" .. ((leader and leader ~= "") and ("   👑 " .. leader) or ""), Color3.fromRGB(200, 120, 40), rows, thirdTitle, thirdOf)
		panel.Size = UDim2.fromOffset(600, 56 + 60 + MAX_ROWS * ROW_HEIGHT + 16)
	end
end

local function setVisible(on)
	on = on and not ClientState.InMainMenu
	if on == visible then
		return
	end
	visible = on
	gui.Enabled = on
	refresh()
end

function Scoreboard.Init()
	-- La lista de jugadores de Roblox no enseña a los bots ni los equipos así: se usa esta
	task.spawn(function()
		for _ = 1, 20 do
			if pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.PlayerList, false) then
				return
			end
			task.wait(0.5)
		end
	end)
	gui = UI.new("ScreenGui", {
		Name = "Scoreboard",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 4,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	panel = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.48),
		Size = UDim2.fromOffset(940, 420),
		BackgroundColor3 = Color3.fromRGB(18, 20, 34),
		BackgroundTransparency = 0.12,
		Parent = gui,
	}, { UI.corner(16), UI.stroke(Color3.new(1, 1, 1), 3, 0.6), UI.padding(14) })
	local scale = UI.new("UIScale", { Parent = panel })
	local function fit()
		local viewport = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.clamp(math.min((viewport.X - 30) / panel.Size.X.Offset, (viewport.Y - 30) / panel.Size.Y.Offset), 0.4, 1)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	panel:GetPropertyChangedSignal("Size"):Connect(fit)
	title = UI.label({
		Size = UDim2.new(1, 0, 0, 40),
		Text = "",
		TextSize = 26,
		Parent = panel,
	})
	columns = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = panel })
	fit()

	-- Tab: se ve mientras se mantiene pulsado. En móvil el botón 📋 lo abre y lo cierra.
	TouchLayout.BindAction("Scoreboard", function(_, state, input)
		if input.UserInputType == Enum.UserInputType.Touch then
			if state == Enum.UserInputState.Begin then
				setVisible(not visible)
			end
		elseif state == Enum.UserInputState.Begin then
			setVisible(true)
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			setVisible(false)
		end
		return Enum.ContextActionResult.Pass
	end, UserInputService.TouchEnabled, Enum.KeyCode.Tab)
	-- Si la ventana pierde el foco con Tab pulsado, no llega el "soltar": se cierra igualmente
	UserInputService.WindowFocusReleased:Connect(function()
		if not UserInputService.TouchEnabled then
			setVisible(false)
		end
	end)
	TouchLayout.SetTitle("Scoreboard", "📋")
	TouchLayout.Set("Scoreboard", UDim2.new(1, -60, 0, 70))

	task.spawn(function()
		while true do
			task.wait(0.5)
			if visible and ClientState.InMainMenu then
				setVisible(false)
			end
			refresh()
		end
	end)
end

return Scoreboard
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="127">
            <Properties>
              <string name="Name">Settings</string>
              <string name="Source"><![CDATA[-- Ajustes del jugador en el cliente: calidad gráfica, campo de visión y sensibilidad.
-- Los cambios de Lighting hechos en el cliente solo afectan a este jugador.
--
-- Calidad:
--   Auto  : Baja en móviles (solo táctil) y Media en PC
--   Baja  : sin sombras, sin bloom, sin rayos de sol, sin nubes ni partículas del mapa (móviles)
--   Media : sombras y bloom, sin rayos de sol ni conos de luz, menos partículas del mapa
--   Alta  : todo como lo diseñó el mapa
--   Ultra : además, desenfoque de profundidad lejano y más partículas
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)

local Settings = {}

local PARTICLE_FACTOR = { Baja = 0, Media = 0.4, Alta = 1, Ultra = 1.3 }

local current = table.clone(GameConfig.DefaultSettings)
ClientState.Settings = current

-- Calidad que se aplica de verdad ("Auto" según el dispositivo)
local function effectiveQuality()
	local q = current.Quality
	if q == "Auto" or not PARTICLE_FACTOR[q] then
		local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
		return touchOnly and "Baja" or "Media"
	end
	return q
end

-- Partículas ambientales del mapa (nieve, hojas, chispas, humo): se escalan según la calidad
local function scaleEmitter(emitter)
	if not emitter:IsA("ParticleEmitter") then
		return
	end
	local map = workspace:FindFirstChild("Map")
	if not map or not emitter:IsDescendantOf(map) then
		return
	end
	local base = emitter:GetAttribute("BaseRate")
	if base == nil then
		base = emitter.Rate
		emitter:SetAttribute("BaseRate", base)
	end
	local factor = PARTICLE_FACTOR[effectiveQuality()] or 1
	emitter.Rate = base * factor
	emitter.Enabled = factor > 0
end

-- Focos con sombras reales: solo en calidad Alta y Ultra
local function applyLightShadow(inst)
	if inst:IsA("Light") and inst:GetAttribute("QualityShadow") then
		local q = effectiveQuality()
		inst.Shadows = q == "Alta" or q == "Ultra"
	end
end

-- Detalles caros que se ocultan en calidades bajas (solo en este cliente)
local HIDE_BELOW = {
	LightCone = "Alta",
	ContactShadow = "Media",
	Puddle = "Media",
	-- (detalles pequeños de los mapas realistas: en móviles modestos no se notan y ahorran dibujo)
	FloorPaper = "Media",
	Paper = "Media",
	PosterBand = "Media",
	Wire = "Media",
	ACGrille = "Media",
	Crack = "Media",
	ChairLeg = "Media",
	CamoSpot = "Media",
	SnowPoleBand = "Media",
	SignalLamp = "Media",
	AntennaBar = "Media",
	RubblePile = "Media",
}
local RANK = { Baja = 1, Media = 2, Alta = 3, Ultra = 4 }
local function applyDetail(inst)
	local minimum = HIDE_BELOW[inst.Name]
	if minimum and inst:IsA("BasePart") then
		inst.LocalTransparencyModifier = (RANK[effectiveQuality()] or 2) < RANK[minimum] and 1 or 0
	end
end

-- Fuegos del mapa (Encrucijada de noche): en calidad Baja, sin llamas (la luz se queda)
local function applyFire(inst)
	if inst:IsA("Fire") then
		local map = workspace:FindFirstChild("Map")
		if map and inst:IsDescendantOf(map) then
			inst.Enabled = effectiveQuality() ~= "Baja"
		end
	end
end

local function applyQuality()
	local q = effectiveQuality()
	ClientState.EffectiveQuality = q
	local low = q == "Baja"
	Lighting.GlobalShadows = not low
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
	if bloom then
		bloom.Enabled = not low
	end
	local rays = Lighting:FindFirstChildOfClass("SunRaysEffect")
	if rays then
		rays.Enabled = q == "Alta" or q == "Ultra"
	end
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds then
		clouds.Enabled = not low
	end
	-- Desenfoque lejano solo en Ultra (creado en el cliente)
	local dof = Lighting:FindFirstChild("QualityDOF")
	if q == "Ultra" then
		if not dof then
			dof = Instance.new("DepthOfFieldEffect")
			dof.Name = "QualityDOF"
			dof.FarIntensity = 0.12
			dof.FocusDistance = 70
			dof.InFocusRadius = 50 -- (el máximo que admite)
			dof.NearIntensity = 0
			dof.Parent = Lighting
		end
		dof.Enabled = true
	elseif dof then
		dof.Enabled = false
	end
	local map = workspace:FindFirstChild("Map")
	if map then
		for _, d in map:GetDescendants() do
			scaleEmitter(d)
			applyLightShadow(d)
			applyDetail(d)
			applyFire(d)
		end
	end
end

function Settings.Get()
	return current
end

-- Cambia un ajuste, lo aplica al momento y lo guarda en el servidor (agrupando cambios seguidos)
local saveQueued = false
function Settings.Set(key, value)
	if key == "Quality" then
		if not table.find(GameConfig.QualityLevels, value) then
			return
		end
	else
		local limits = GameConfig.SettingsLimits[key]
		if not limits or type(value) ~= "number" then
			return
		end
		value = math.clamp(math.floor(value * 100 + 0.5) / 100, limits[1], limits[2])
	end
	current[key] = value
	if key == "Quality" then
		applyQuality()
	end
	if not saveQueued then
		saveQueued = true
		task.delay(1.5, function()
			saveQueued = false
			Remotes.SaveSettings:FireServer(current)
		end)
	end
end

function Settings.Init()
	-- Ajustes guardados del jugador
	local function fromData(data)
		if type(data) ~= "table" or type(data.Settings) ~= "table" or saveQueued then
			return
		end
		local changedQuality = data.Settings.Quality ~= current.Quality
		for key, value in data.Settings do
			if GameConfig.DefaultSettings[key] ~= nil and type(value) == type(GameConfig.DefaultSettings[key]) then
				current[key] = value
			end
		end
		if changedQuality then
			applyQuality()
		end
	end
	ClientState.DataChanged.Event:Connect(fromData)
	fromData(ClientState.Data)

	-- Al cambiar de mapa el servidor rehace la iluminación: volvemos a aplicar la calidad
	ReplicatedStorage:GetAttributeChangedSignal("MapName"):Connect(function()
		task.delay(1, applyQuality)
	end)
	workspace.DescendantAdded:Connect(function(inst)
		if inst:IsA("ParticleEmitter") then
			task.defer(scaleEmitter, inst)
		elseif inst:IsA("Light") then
			task.defer(applyLightShadow, inst)
		elseif inst:IsA("Fire") then
			task.defer(applyFire, inst)
		elseif HIDE_BELOW[inst.Name] then
			task.defer(applyDetail, inst)
		end
	end)
	applyQuality()
end

return Settings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="128">
            <Properties>
              <string name="Name">SkinFX</string>
              <string name="Source"><![CDATA[-- Anima las skins arcoíris: las piezas con la etiqueta "RainbowSkin" (ver WeaponModels) van cambiando
-- de color. Cada pieza tiene su fase (RainbowPhase) para que el color recorra el arma como una ola.
-- Funciona igual en tu arma (viewmodel) y en las de los demás. ~30 veces por segundo.
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local SkinFX = {}

local TAG = "RainbowSkin"
local SPEED = 0.22 -- vueltas al arcoíris por segundo
local parts = {} -- [part] = { Phase, Sat, Val, Viewport }

local function add(part)
	if part:IsA("BasePart") then
		parts[part] = {
			Phase = part:GetAttribute("RainbowPhase") or 0,
			Sat = part:GetAttribute("RainbowSat") or 1,
			Val = part:GetAttribute("RainbowVal") or 1,
			Viewport = part:FindFirstAncestorWhichIsA("ViewportFrame"), -- icono de la interfaz
		}
	end
end

-- ¿Se ve el icono? (el panel del menú cerrado sigue existiendo: no hace falta animar lo que no se ve)
local function guiVisible(gui)
	local node = gui
	while node do
		if node:IsA("GuiObject") and not node.Visible then
			return false
		elseif node:IsA("LayerCollector") then
			return node.Enabled
		end
		node = node.Parent
	end
	return false
end

local function remove(part)
	parts[part] = nil
end

function SkinFX.Init()
	for _, part in CollectionService:GetTagged(TAG) do
		add(part)
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(add)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(remove)
	local accumulator = 0
	RunService.RenderStepped:Connect(function(dt)
		accumulator += dt
		if accumulator < 1 / 30 then
			return
		end
		accumulator = 0
		local t = os.clock() * SPEED
		local shown = {} -- visibilidad de cada icono, calculada una vez por paso
		for part, info in parts do
			if not part.Parent then
				parts[part] = nil
				continue
			end
			local visible
			if info.Viewport then
				visible = shown[info.Viewport]
				if visible == nil then
					visible = guiVisible(info.Viewport)
					shown[info.Viewport] = visible
				end
			else
				-- Arma oculta (la tuya en la mano la sustituye el viewmodel)
				visible = part.LocalTransparencyModifier < 1 and part.Transparency < 1
			end
			if visible then
				part.Color = Color3.fromHSV((t + info.Phase) % 1, info.Sat, info.Val)
			end
		end
	end)
end

return SkinFX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="129">
            <Properties>
              <string name="Name">TouchLayout</string>
              <string name="Source"><![CDATA[-- Botones táctiles del juego. Roblox (ContextActionService) solo crea 7 botones táctiles y los mete
-- en un recuadro del cuarto de abajo a la derecha: en el móvil faltaban la granada, el ataque
-- aéreo, los emotes, el grafiti y el marcador, y los demás salían desordenados. Así que en pantallas
-- táctiles los botones son nuestros: sin límite, con su icono, del tamaño que toca y colocados en la
-- pantalla exactamente donde se dice. Las teclas y el mando siguen con ContextActionService.
--
-- Uso (como ContextActionService): TouchLayout.BindAction(nombre, función, conBotón, teclas...),
-- TouchLayout.SetTitle(nombre, texto) y TouchLayout.Set(nombre, posición). La función recibe
-- (nombre, estado, input) igual que con ContextActionService.
--
-- Posiciones: las del código son las de siempre (pensadas alrededor del botón de saltar de Roblox).
-- En tablet ese botón es más grande y está más arriba y a la izquierda, así que el grupo de abajo a la
-- derecha se corre a la izquierda. En el teléfono hay una disposición propia (PHONE): un racimo
-- ordenado alrededor del botón de saltar, como en los shooters de móvil (disparar grande, apuntar y
-- agacharse a mano del pulgar), sin que ningún botón pise a otro, y los de menos uso (marcador,
-- emotes, grafiti) pequeños arriba a la derecha.
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local UI = require(script.Parent.UI)

local TouchLayout = {}

local TABLET_SHIFT_X = -130
local registered = {} -- [acción] = posición pedida por el código
local buttons = {} -- [acción] = { Button, Label, Handler }
local watching = false
local gui

-- Teléfono: { posición en pantalla (esquina de arriba a la izquierda), tamaño }. El salto de Roblox
-- ocupa (1,-95)..(1,-25) de ancho y (1,-90)..(1,-20) de alto.
local BIG, NORMAL, SMALL = 76, 52, 40
local PHONE = {
	Fire = { UDim2.new(1, -180, 1, -176), BIG }, -- (arriba a la izquierda del salto)
	Aim = { UDim2.new(1, -88, 1, -160), NORMAL }, -- (encima del salto)
	Slide = { UDim2.new(1, -168, 1, -84), NORMAL }, -- (a la izquierda del salto)
	Reload = { UDim2.new(1, -244, 1, -150), NORMAL },
	SwapWeapon = { UDim2.new(1, -240, 1, -84), NORMAL },
	Sprint = { UDim2.new(1, -312, 1, -112), NORMAL },
	Melee = { UDim2.new(1, -88, 1, -228), NORMAL },
	Grenade = { UDim2.new(1, -170, 1, -250), NORMAL },
	Airstrike = { UDim2.new(1, -246, 1, -222), NORMAL },
	Scoreboard = { UDim2.new(1, -152, 0, 8), SMALL },
	Emotes = { UDim2.new(1, -106, 0, 8), SMALL },
	Spray = { UDim2.new(1, -60, 0, 8), SMALL },
}
TouchLayout.Phone = PHONE
-- Tablet y pantallas medianas: arriba a la derecha también los de menos uso
local TOP_ROW = {
	Scoreboard = UDim2.new(1, -60, 0, 8),
	Emotes = UDim2.new(1, -112, 0, 8),
	Spray = UDim2.new(1, -164, 0, 8),
}

local function isLarge()
	local size = workspace.CurrentCamera.ViewportSize
	return math.min(size.X, size.Y) > 500
end

local function touchDevice()
	return UserInputService.TouchEnabled
end

local function ensureGui()
	if gui and gui.Parent then
		return gui
	end
	gui = Instance.new("ScreenGui")
	gui.Name = "TouchButtons"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 3
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return gui
end

local function apply(actionName, position)
	local entry = buttons[actionName]
	if not entry then
		return
	end
	local size = NORMAL
	local phoneSpot = UI.IsPhone() and PHONE[actionName]
	if phoneSpot then
		position, size = phoneSpot[1], phoneSpot[2]
	elseif TOP_ROW[actionName] then
		position, size = TOP_ROW[actionName], 46
	elseif isLarge() then
		size = actionName == "Fire" and 90 or 64
		if position.X.Scale == 1 and position.Y.Scale == 1 then
			position = UDim2.new(1, position.X.Offset + TABLET_SHIFT_X, 1, position.Y.Offset)
		end
	elseif actionName == "Fire" then
		size = 64
	end
	entry.Button.Position = position
	entry.Button.Size = UDim2.fromOffset(size, size)
end

-- Botón redondo y translúcido con su icono; mientras se pulsa, más claro
local function createButton(actionName, handler)
	local button = Instance.new("TextButton")
	button.Name = actionName
	button.AutoButtonColor = false
	button.Text = ""
	button.BackgroundColor3 = Color3.fromRGB(15, 18, 26)
	button.BackgroundTransparency = 0.45
	button.Size = UDim2.fromOffset(NORMAL, NORMAL)
	button.Position = UDim2.new(1, -120, 1, -160)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = button
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(1, 1, 1)
	stroke.Transparency = 0.35
	stroke.Thickness = 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = button
	local label = Instance.new("TextLabel")
	label.Name = "ActionTitle"
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.5)
	label.Size = UDim2.fromScale(0.62, 0.62)
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextScaled = true
	label.Text = ""
	label.Parent = button
	local fit = Instance.new("UITextSizeConstraint")
	fit.MaxTextSize = 34
	fit.Parent = label
	-- Pulsar y soltar llaman a la acción como lo haría ContextActionService (con el toque real)
	button.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		button.BackgroundTransparency = 0.15
		task.spawn(handler, actionName, Enum.UserInputState.Begin, input)
		local connection
		connection = input:GetPropertyChangedSignal("UserInputState"):Connect(function()
			local state = input.UserInputState
			if state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
				connection:Disconnect()
				button.BackgroundTransparency = 0.45
				task.spawn(handler, actionName, state, input)
			end
		end)
	end)
	button.Parent = ensureGui()
	buttons[actionName] = { Button = button, Label = label, Handler = handler }
	-- (que respete enseguida si hay un menú abierto o la pantalla de inicio)
	task.defer(function()
		local ok, ClientState = pcall(require, script.Parent.ClientState)
		if ok and ClientState.UpdateMouse then
			pcall(ClientState.UpdateMouse)
		end
	end)
	if registered[actionName] then
		apply(actionName, registered[actionName])
	end
	return button
end

local function watch()
	if watching then
		return
	end
	watching = true
	local function mode()
		return (UI.IsPhone() and "phone") or (isLarge() and "large") or "normal"
	end
	local was = mode()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		local now = mode()
		if now ~= was then
			was = now
			for name, position in registered do
				apply(name, position)
			end
		end
	end)
end

-- Como ContextActionService:BindAction; si conBotón y la pantalla es táctil, el botón es nuestro
function TouchLayout.BindAction(actionName, handler, withButton, ...)
	ContextActionService:BindAction(actionName, handler, false, ...)
	if withButton and touchDevice() then
		if buttons[actionName] then
			buttons[actionName].Button:Destroy()
		end
		createButton(actionName, handler)
		watch()
	end
end

function TouchLayout.UnbindAction(actionName)
	ContextActionService:UnbindAction(actionName)
	local entry = buttons[actionName]
	if entry then
		entry.Button:Destroy()
		buttons[actionName] = nil
	end
end

function TouchLayout.SetTitle(actionName, title)
	local entry = buttons[actionName]
	if entry then
		entry.Label.Text = tostring(title)
	end
end

-- El botón de una acción (nil si no hay: sin pantalla táctil o sin enlazar)
function TouchLayout.GetButton(actionName)
	local entry = buttons[actionName]
	return entry and entry.Button or nil
end

-- Coloca el botón (se ajusta en tablet y teléfono, y al girar la pantalla o cuando se sabe por
-- fin su tamaño: al arrancar puede valer 0)
function TouchLayout.Set(actionName, position)
	registered[actionName] = position
	apply(actionName, position)
	watch()
end

return TouchLayout
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="130">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[-- Tarjeta de controles para jugadores nuevos: la primera vez que entran en partida ven los controles
-- básicos (adaptados a PC o a móvil). Se cierra con el botón o a los 20 s y no vuelve a salir
-- (el servidor guarda TutorialDone).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Sounds = require(Shared.Sounds)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local Tutorial = {}

local PC_TIPS = {
	{ "🖱", "Clic izquierdo dispara · clic derecho apunta" },
	{ "⌨", "WASD te mueve · Shift corre · C te agacha (corriendo, te desliza)" },
	{ "⚡", "E impulso · Z supersalto · X poción" },
	{ "🔪", "F golpe rápido · G granada · R recargar" },
	{ "🛒", "B abre la tienda, el pase y los retos" },
	{ "📋", "Tab marcador · H regalo 🎁 · J grafiti 🎨" },
}
local TOUCH_TIPS = {
	{ "🕹", "Joystick a la izquierda para moverte" },
	{ "🔫", "Botón Disparar a la derecha · Apuntar al lado" },
	{ "⚡", "Iconos abajo: impulso, supersalto y poción" },
	{ "💣", "Botones de granada, deslizar y cambiar arma" },
	{ "🛒", "Botón de la tienda: pase, retos, armas y skins" },
	{ "🎁", "Toca el regalo de arriba cuando esté listo" },
}

local shown = false

local function show()
	if shown then
		return
	end
	shown = true
	-- Mientras se lee: ratón libre y visible, sin disparar
	ClientState.TutorialOpen = true
	ClientState.UpdateMouse()
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local gui = UI.new("ScreenGui", {
		Name = "Tutorial",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 7, -- (por encima de la tienda)
		Parent = player:WaitForChild("PlayerGui"),
	})
	local card = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(520, 400),
		BackgroundColor3 = Color3.fromRGB(20, 22, 36),
		BackgroundTransparency = 0.08,
		Parent = gui,
	}, { UI.corner(18), UI.stroke(Color3.fromRGB(255, 205, 60), 3, 0) })
	local scale = UI.new("UIScale", { Scale = 0.6, Parent = card })
	local viewport = workspace.CurrentCamera.ViewportSize
	local fit = math.clamp(math.min((viewport.X - 20) / 520, (viewport.Y - 20) / 400), 0.45, 1)
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = fit }):Play()
	UI.label({
		Position = UDim2.fromOffset(0, 14),
		Size = UDim2.new(1, 0, 0, 40),
		Text = "¡BIENVENIDO A LA PELEA!",
		TextSize = 32,
		TextColor3 = Color3.fromRGB(255, 210, 60),
		Parent = card,
	})
	for i, tip in touch and TOUCH_TIPS or PC_TIPS do
		local row = UI.new("Frame", {
			Position = UDim2.fromOffset(24, 60 + (i - 1) * 46),
			Size = UDim2.new(1, -48, 0, 40),
			BackgroundColor3 = Color3.fromRGB(40, 44, 70),
			BackgroundTransparency = 0.2,
			Parent = card,
		}, { UI.corner(10) })
		UI.label({ Size = UDim2.fromOffset(44, 40), Text = tip[1], TextSize = 24, Parent = row })
		UI.label({
			Position = UDim2.fromOffset(48, 0),
			Size = UDim2.new(1, -56, 1, 0),
			Text = tip[2],
			TextSize = 18,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			Parent = row,
		})
	end
	local button = UI.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(220, 46),
		Text = "¡A JUGAR!",
		TextSize = 24,
		BackgroundColor3 = Color3.fromRGB(70, 200, 90),
		Parent = card,
	}, { UI.gloss() })
	-- El botón Modal libera el ratón mientras se lee (en primera persona está bloqueado)
	button.Modal = true
	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		ClientState.TutorialOpen = false
		ClientState.UpdateMouse()
		Sounds.Play("Click")
		Remotes.TutorialDone:FireServer()
		TweenService:Create(scale, TweenInfo.new(0.2), { Scale = 0 }):Play()
		task.delay(0.25, function()
			gui:Destroy()
		end)
	end
	button.Activated:Connect(close)
	task.delay(20, close)
	-- Se quita si mueres o vuelves a la pantalla de inicio
	task.spawn(function()
		while not closed do
			if ClientState.Dead or ClientState.InMainMenu then
				close()
			end
			task.wait(0.2)
		end
	end)
end

function Tutorial.Init()
	task.spawn(function()
		-- Cuando sale de la pantalla de inicio por primera vez y sus datos dicen que es nuevo
		while not shown do
			task.wait(0.5)
			local data = ClientState.Data
			if data and data.TutorialDone == false and not ClientState.InMainMenu and not ClientState.Dead then
				task.wait(1.5) -- que primero vea el mapa
				if not ClientState.InMainMenu and not ClientState.Dead then
					show()
				end
			elseif data and data.TutorialDone then
				return
			end
		end
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="131">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[-- Pequeña utilidad para crear interfaces desde código.
local UI = {}

-- Letra de la interfaz: Oswald en negrita (condensada y sobria, como la de los shooters militares).
-- Enum.Font solo da el peso normal: cualquier texto con UI.Font pasa a la versión en negrita.
UI.Font = Enum.Font.Oswald
UI.FontBody = Enum.Font.GothamBold
local okBold, OSWALD_BOLD = pcall(function()
	return Font.new("rbxasset://fonts/families/Oswald.json", Enum.FontWeight.Bold)
end)
UI.FontFace = okBold and OSWALD_BOLD or nil

function UI.new(className, props, children)
	local inst = Instance.new(className)
	local parent
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			inst[key] = value
		end
	end
	if UI.FontFace and (className == "TextLabel" or className == "TextButton" or className == "TextBox") and inst.Font == UI.Font then
		inst.FontFace = UI.FontFace
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.corner(radius)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

function UI.stroke(color, thickness, transparency)
	return UI.new("UIStroke", {
		Color = color or Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

-- Degradado brillante (de claro arriba a más oscuro abajo) sobre el color de fondo
function UI.gloss(bottom)
	return UI.new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), bottom or Color3.fromRGB(185, 185, 195)),
		Rotation = 90,
	})
end

function UI.padding(px)
	return UI.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
	})
end

-- Texto con borde negro (se lee sobre cualquier fondo)
function UI.label(props, children)
	local defaults = {
		BackgroundTransparency = 1,
		Font = UI.Font,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0.4,
		TextSize = 18,
	}
	for key, value in props or {} do
		defaults[key] = value
	end
	return UI.new("TextLabel", defaults, children)
end

function UI.button(props, children)
	local defaults = {
		Font = UI.Font,
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 18,
		AutoButtonColor = true,
		BackgroundColor3 = Color3.fromRGB(40, 120, 255),
	}
	for key, value in props or {} do
		defaults[key] = value
	end
	local button = UI.new("TextButton", defaults, children)
	UI.corner(8).Parent = button
	return button
end

function UI.formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d", seconds // 60, seconds % 60)
end

-- Espera a que la cámara sepa el tamaño de la pantalla (al arrancar puede valer 0 un instante y el
-- móvil se confundía con un ordenador: minimapa y paneles salían a tamaño de escritorio)
local viewportWaited = false
function UI.WaitViewport(timeout)
	-- (solo la primera vez se espera: si la pantalla no llega a saberse, los demás no esperan otra vez)
	if viewportWaited then
		return
	end
	local deadline = os.clock() + (timeout or 2)
	while os.clock() < deadline do
		local camera = workspace.CurrentCamera
		local size = camera and camera.ViewportSize
		if typeof(size) == "Vector2" and size.Y > 2 then
			viewportWaited = true
			return
		end
		task.wait(0.05)
	end
	viewportWaited = true
end

-- ¿Teléfono? (táctil, sin teclado y pantalla baja; las tablets usan la disposición normal)
function UI.IsPhone()
	local UserInputService = game:GetService("UserInputService")
	local camera = workspace.CurrentCamera
	local size = camera and camera.ViewportSize
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled and typeof(size) == "Vector2" and size.Y > 2 and size.Y < 500
end

-- Dónde acaba la barra de botones de Roblox (menú, chat...) arriba a la izquierda: lo nuestro de esa
-- esquina va debajo para no quedar tapado
local topbarBottom = nil
function UI.TopbarBottom()
	-- (se guarda el primer valor bueno: así el minimapa, el regalo y el evento quedan alineados)
	if topbarBottom then
		return topbarBottom
	end
	local ok, inset = pcall(function()
		return game:GetService("GuiService").TopbarInset
	end)
	if ok and typeof(inset) == "Rect" and inset.Height > 0 then
		topbarBottom = math.floor(inset.Max.Y) + 6
		return topbarBottom
	end
	return 60
end

-- Mayúsculas que respetan las tildes (string.upper solo cambia las letras sin acento: «Mítico» saldría
-- «MíTICO»)
local ACCENTS = { ["á"] = "Á", ["é"] = "É", ["í"] = "Í", ["ó"] = "Ó", ["ú"] = "Ú", ["ñ"] = "Ñ", ["ü"] = "Ü" }
function UI.upper(text)
	local upper = string.upper(tostring(text))
	return (string.gsub(upper, "\195[\161\169\173\179\186\177\188]", ACCENTS))
end

function UI.hex(color)
	return "#" .. color:ToHex()
end

return UI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="132">
            <Properties>
              <string name="Name">VoteUI</string>
              <string name="Source"><![CDATA[-- Votación de mapa + modo durante el descanso. Pulsa V (o el botón) para liberar el ratón y votar.
local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer

local VoteUI = {}

local gui, panel, hint, modal
local cards = {}
local myVote = nil
local open = false

local MODE_ICONS = {
	["Duelo por equipos"] = "⚔",
	["Captura la bandera"] = "🚩",
	["Dominio"] = "🏴",
	["Buscar y destruir"] = "💣",
	["Zona de control"] = "◆",
	["Todos contra todos"] = "💀",
	["Escalada de armas"] = "🔫",
	["Eliminación"] = "☠",
	["Infección"] = "🧟",
	["Calabazas"] = "🎃",
	["Baja confirmada"] = "🏷️",
}
-- Una línea para quien no conoce el modo
local MODE_HINTS = {
	["Duelo por equipos"] = "Gana el equipo con más bajas",
	["Captura la bandera"] = "Roba la bandera enemiga",
	["Dominio"] = "Captura y defiende A, B y C",
	["Buscar y destruir"] = "Planta o desactiva la bomba",
	["Zona de control"] = "Quédate dentro de la zona",
	["Todos contra todos"] = "Cada uno por su cuenta",
	["Escalada de armas"] = "Cada baja te da otra arma",
	["Eliminación"] = "Una sola vida por ronda",
	["Infección"] = "Sobrevive a los zombis",
	["Calabazas"] = "Recoge las calabazas enemigas",
	["Baja confirmada"] = "Recoge las placas de los caídos",
}

local function setOpen(value)
	open = value
	modal.Visible = value
	ClientState.VoteOpen = value
	ClientState.UpdateMouse()
end

local function refresh()
	local voting = ReplicatedStorage:GetAttribute("State") == "Intermission" and ReplicatedStorage:GetAttribute("Vote1_Map") ~= nil
	-- No tapa el menú ni la pantalla de inicio (sus tarjetas se comerían los clics)
	panel.Visible = voting and not ClientState.MenuOpen and not ClientState.InMainMenu
	ClientState.VotePanelVisible = panel.Visible
	hint.Visible = voting and not open and not ClientState.InMainMenu
	if not voting then
		myVote = nil
		if open then
			setOpen(false)
		end
		return
	end
	for i, card in cards do
		local map = ReplicatedStorage:GetAttribute("Vote" .. i .. "_Map") or "?"
		local mode = ReplicatedStorage:GetAttribute("Vote" .. i .. "_Mode") or "?"
		local count = ReplicatedStorage:GetAttribute("Vote" .. i .. "_Count") or 0
		card.Map.Text = map
		card.Mode.Text = (MODE_ICONS[mode] or "") .. " " .. mode
		-- (el mapa destacado del día da más XP)
		local featured = ReplicatedStorage:GetAttribute("FeaturedMap")
		if featured and string.find(map, featured, 1, true) then
			card.Map.Text = "⭐ " .. map
			card.Hint.Text = "⭐ Mapa del día: más XP"
		else
			card.Hint.Text = MODE_HINTS[mode] or ""
		end
		card.Count.Text = tostring(count) .. (count == 1 and " voto" or " votos")
		card.Stroke.Color = myVote == i and Color3.fromRGB(255, 200, 40) or Color3.fromRGB(90, 100, 140)
		card.Stroke.Thickness = myVote == i and 4 or 2
	end
	local timeLeft = ReplicatedStorage:GetAttribute("TimeLeft") or 0
	panel.Title.Text = "VOTA EL SIGUIENTE MAPA · " .. timeLeft .. "s"
end

function VoteUI.Init()
	gui = UI.new("ScreenGui", {
		Name = "Vote",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 6,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	panel = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -40),
		Size = UDim2.fromOffset(660, 150),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	UI.label({
		Name = "Title",
		Size = UDim2.new(1, 0, 0, 28),
		Text = "VOTA EL SIGUIENTE MAPA",
		TextSize = 24,
		TextColor3 = Color3.fromRGB(255, 210, 60),
		Parent = panel,
	})
	local row = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, 0, 0, 110),
		BackgroundTransparency = 1,
		Parent = panel,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 12),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for i = 1, 3 do
		local card = UI.button({
			LayoutOrder = i,
			Size = UDim2.fromOffset(205, 110),
			Text = "",
			BackgroundColor3 = Color3.fromRGB(28, 32, 52),
			Parent = row,
		}, { UI.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 150, 200)), Rotation = 90 }) })
		local stroke = UI.stroke(Color3.fromRGB(90, 100, 140), 2, 0)
		stroke.Parent = card
		-- Los nombres largos con icono se encogen para caber en la tarjeta
		local mapLabel = UI.label({ Position = UDim2.fromOffset(6, 8), Size = UDim2.new(1, -12, 0, 30), Text = "", TextScaled = true, Parent = card }, {
			UI.new("UITextSizeConstraint", { MaxTextSize = 24, MinTextSize = 12 }),
		})
		local modeLabel = UI.label({ Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 24), Text = "", TextSize = 18, TextColor3 = Color3.fromRGB(150, 220, 255), Parent = card })
		local hintLabel = UI.label({
			Position = UDim2.fromOffset(6, 63),
			Size = UDim2.new(1, -12, 0, 16),
			Text = "",
			TextSize = 13,
			TextColor3 = Color3.fromRGB(190, 195, 220),
			Font = UI.FontBody,
			TextStrokeTransparency = 1,
			Parent = card,
		})
		local countLabel = UI.label({ Position = UDim2.fromOffset(0, 82), Size = UDim2.new(1, 0, 0, 22), Text = "", TextSize = 18, TextColor3 = Color3.fromRGB(255, 210, 60), Parent = card })
		card.Activated:Connect(function()
			myVote = i
			Sounds.Play("Click")
			Remotes.VoteMap:FireServer(i)
			refresh()
		end)
		cards[i] = { Map = mapLabel, Mode = modeLabel, Hint = hintLabel, Count = countLabel, Stroke = stroke }
	end
	hint = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -196),
		Size = UDim2.fromOffset(400, 26),
		Text = "Pulsa [V] para votar con el ratón",
		TextSize = 20,
		Visible = false,
		Parent = gui,
	})
	-- Botón Modal: libera el ratón mientras se vota
	modal = UI.new("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true, Visible = false, Parent = gui })

	ContextActionService:BindAction("Vote", function(_, state)
		if state == Enum.UserInputState.Begin and panel.Visible and not ClientState.InMainMenu then
			setOpen(not open)
			refresh()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.V, Enum.KeyCode.DPadUp)

	ReplicatedStorage.AttributeChanged:Connect(refresh)
	refresh()
end

return VoteUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="133">
            <Properties>
              <string name="Name">WeaponController</string>
              <string name="Source"><![CDATA[-- Control de armas en primera persona: viewmodel, disparo, recarga, apuntado, cuchillo y cambio de arma.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weapons = require(Shared.Weapons)
local WeaponModels = require(Shared.WeaponModels)
local Sounds = require(Shared.Sounds)
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)

local TouchLayout = require(script.Parent.TouchLayout)
local AimAssist = require(script.Parent.AimAssist)
local ScopeSway = require(script.Parent.ScopeSway)
local CombatFX = require(script.Parent.CombatFX)
local UI = require(script.Parent.UI)
local ClientState = require(script.Parent.ClientState)
local Effects = require(script.Parent.Effects)
local Outfits = require(Shared.Outfits)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local WeaponController = {}

-- Teléfono (UI.IsPhone): el arma de cadera se aparta un poco (se decide al arrancar)
local PHONE_HIP = CFrame.new(0.1, -0.12, -0.18) -- (más abajo, a la derecha y más lejos: se ve más pequeña)
local phoneScreen = false

-- Hombros del viewmodel (espacio de cámara, fuera de pantalla)
local RIGHT_SHOULDER = Vector3.new(1.1, -1.5, 0.4)
local LEFT_SHOULDER = Vector3.new(-0.7, -1.5, 0.2)

local character, humanoid, rootPart
local equippedTool, def
local viewmodel
local attrConnection

local triggerHeld = false
local aimHeld = false
local lastShot = 0
local localAmmo = 0
local reloadStart = nil
local equipTime = 0
local meleeTime = -10
local inspectTime = -10 -- "Inspeccionar" (V): gira el arma para lucir la skin
local INSPECT_TIME = 2.6
local meleeWithKnife = false

local recoilKick, recoilRot = 0, 0
local camKick, camYaw = 0, 0
-- Retroceso realista: muelles para el golpe del arma (empuja, se pasa un poco y vuelve) y la
-- "deuda" de retroceso: lo que subió la mira en la ráfaga; al dejar de disparar vuelve una parte
local kickVel, rotVel = 0, 0
local recoilSide, sideVel = 0, 0
local sprayCount = 0 -- disparos seguidos de la ráfaga actual
local smokeShots = 0 -- disparos de la ráfaga que calientan el cañón (humo al soltar; Effects.BarrelSmoke)
local debtPitch, debtYaw = 0, 0
local RECOVER = 0.65 -- parte del retroceso que la mira recupera sola al soltar
local swayX, swayY = 0, 0
local bobTime = 0
local aimAlpha, sprintAlpha = 0, 0
local viewmodelHidden = false
local pulseParts = {} -- piezas de neón que laten (skins míticas)
local pulseSkin = nil
local strafeRoll = 0
local shakeRoll = 0
local headBobTime = 0 -- balanceo de la cámara al andar (GameConfig.Movement.CameraBob)
local headBobAmount = 0
-- Animación del arma: inercia con muelle, arma contra la pared, saltos y golpes alternos
local swayVelX, swayVelY = 0, 0
local pendingShot, pendingBurst = nil, false -- disparo que espera a que el arma salga del sprint
local wallAlpha = 0
local airOffset = 0
local meleeSide = 1
local meleeDuration = 0.35
local reloadWasEmpty = false
local reloadDuration = 2 -- lo que dura la recarga en curso (táctica: más corta; Weapons.ReloadDuration)
local wallCheckTime = 0

local collectMovingParts -- (más abajo)
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function lerp(a, b, t)
	return a + (b - a) * t
end

local function updateRayFilter()
	local ignore = { camera }
	if character then
		table.insert(ignore, character)
	end
	local fx = workspace:FindFirstChild("ClientFX")
	if fx then
		table.insert(ignore, fx)
	end
	-- Muros y techo invisibles del borde del mapa: las balas los atraviesan
	local map = workspace:FindFirstChild("Map")
	local boundary = map and map:FindFirstChild("Boundary")
	if boundary then
		table.insert(ignore, boundary)
	end
	rayParams.FilterDescendantsInstances = ignore
end

---------------------------------------------------------------------------
-- Viewmodel
---------------------------------------------------------------------------

local function skinTone()
	local hand = character and (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm"))
	return hand and hand.Color or Color3.fromRGB(255, 204, 153)
end

local function addArm(model, handPos, shoulderCam, weaponDef, side)
	local shoulder = weaponDef.ViewOffset:PointToObjectSpace(shoulderCam)
	local length = (shoulder - handPos).Magnitude
	local sleeveColor = player.Team and player.TeamColor.Color or Color3.fromRGB(60, 60, 70)
	-- Con traje de operador, los brazos llevan sus colores
	local outfitColors = Outfits.ArmColors(ClientState.Data and ClientState.Data.EquippedOutfit)
	if outfitColors then
		sleeveColor = outfitColors.Sleeve
	end
	-- Mapas realistas sin traje: uniforme de manga larga (verde oliva con un toque del color del
	-- equipo) hasta la muñeca y guantes tácticos, como en los shooters militares
	local map = workspace:FindFirstChild("Map")
	local uniform = not outfitColors and map ~= nil and map:GetAttribute("Realistic") == true
	if uniform then
		sleeveColor = Color3.fromRGB(92, 96, 72):Lerp(player.Team and player.TeamColor.Color or Color3.fromRGB(92, 96, 72), 0.12)
		outfitColors = { Sleeve = sleeveColor, Glove = Color3.fromRGB(38, 38, 36), Cuff = sleeveColor:Lerp(Color3.new(0, 0, 0), 0.3) }
	end
	-- Zombi (garras): brazos verdes y manga rota oscura
	local zombieSkin = weaponDef.ZombieArms
	if zombieSkin then
		sleeveColor = Color3.fromRGB(60, 45, 55)
		outfitColors = { Sleeve = sleeveColor, Glove = zombieSkin, Cuff = sleeveColor }
	end

	local arm = Instance.new("Part")
	arm.Name = "Arm"
	arm.Size = Vector3.new(0.4, 0.4, length)
	arm.CFrame = CFrame.lookAt((handPos + shoulder) / 2, handPos)
	arm.Color = zombieSkin or skinTone()
	arm.Material = Enum.Material.SmoothPlastic
	arm:SetAttribute("Side", side)
	arm.Parent = model

	local sleeve = Instance.new("Part")
	sleeve.Name = "Sleeve"
	local sleeveLength = uniform and 0.86 or 0.55 -- (el uniforme cubre también el antebrazo)
	sleeve.Size = Vector3.new(0.46, 0.46, length * sleeveLength)
	sleeve.CFrame = CFrame.lookAt(shoulder:Lerp(handPos, sleeveLength / 2), handPos)
	sleeve.Color = sleeveColor
	sleeve.Material = Enum.Material.Fabric
	sleeve:SetAttribute("Side", side)
	sleeve.Parent = model

	local glove = Instance.new("Part")
	glove.Name = "Glove"
	glove.Size = Vector3.new(0.48, 0.48, 0.55)
	glove.CFrame = CFrame.lookAt(handPos + (shoulder - handPos).Unit * 0.15, handPos)
	glove.Color = outfitColors and outfitColors.Glove or Color3.fromRGB(25, 25, 28)
	glove.Material = Enum.Material.Fabric
	glove:SetAttribute("Side", side)
	glove.Parent = model

	-- Puño blanco de la manga
	local cuff = Instance.new("Part")
	cuff.Name = "Cuff"
	cuff.Size = Vector3.new(0.5, 0.5, 0.12)
	cuff.CFrame = CFrame.lookAt(shoulder:Lerp(handPos, uniform and 0.86 or 0.545), handPos)
	cuff.Color = outfitColors and outfitColors.Cuff or Color3.fromRGB(245, 245, 250)
	cuff.Material = (outfitColors and not zombieSkin and not uniform) and Enum.Material.Neon or Enum.Material.Fabric
	cuff:SetAttribute("Side", side)
	cuff.Parent = model
end

-- Oculta en nuestra pantalla el Tool real (los demás jugadores sí lo ven)
local function hideToolLocally(tool)
	for _, inst in tool:GetDescendants() do
		if inst:IsA("BasePart") then
			inst.LocalTransparencyModifier = 1
		elseif inst:IsA("ParticleEmitter") then
			inst.Enabled = false
		elseif inst:IsA("SurfaceGui") or inst:IsA("BillboardGui") then
			inst.Enabled = false -- los rótulos del arma se verían flotando
		end
	end
end

local charmParts = {} -- { Part, Offset } del colgante del arma en primera persona
local charmRing = nil
local charmSwing, charmVelocity, lastCameraLook = 0, 0, nil

-- El colgante se balancea como un péndulo: lo empuja el giro de la cámara y vuelve solo
-- (igual a cualquier número de fotogramas por segundo)
local function resetCharm()
	charmSwing, charmVelocity, lastCameraLook = 0, 0, nil
end

local function swingCharm(dt)
	if not charmRing or not charmRing.Parent then
		return
	end
	dt = math.clamp(dt, 1 / 240, 0.05)
	local look = camera.CFrame.LookVector
	local turnRate = 0
	if lastCameraLook then
		turnRate = lastCameraLook:Cross(look).Y / dt -- giro horizontal (radianes por segundo)
	end
	lastCameraLook = look
	charmVelocity += (-charmSwing * 60 - charmVelocity * 4 + turnRate * 3) * dt
	-- (hacia dentro casi no puede: chocaría con el arma)
	charmSwing = math.clamp(charmSwing + charmVelocity * dt, -0.8, 0.12)
	local pivot = charmRing.CFrame * CFrame.Angles(0, 0, charmSwing)
	for _, entry in charmParts do
		entry.Part.CFrame = pivot * entry.Offset
	end
end

-- Piezas que se mueven por separado en primera persona: cargador, corredera, bomba, cerrojo y
-- los dos brazos. Se guarda dónde está cada una respecto al Handle para moverla desde ahí.
local moving = { Mag = {}, Slide = {}, Pump = {}, Bolt = {}, Left = {}, Right = {} }
local movingDirty = {}
local magCenter, boltCenter = nil, nil

local function movingGroup(part)
	local side = part:GetAttribute("Side")
	if side then
		return side
	end
	local name = part.Name
	if name == "MagTube" or string.sub(name, 1, 10) == "BoltShroud" or string.sub(name, 1, 11) == "BoltRelease" then
		return nil
	end
	local function starts(prefix)
		return string.sub(name, 1, #prefix) == prefix
	end
	if starts("Mag") or starts("Drum") or starts("AmmoBox") or starts("BeltRound") then
		return "Mag"
	elseif starts("Slide") then
		return "Slide"
	elseif starts("Pump") and not starts("Pumpkin") then -- (la Calabazooka no tiene bomba)
		return "Pump"
	elseif starts("BoltHandle") or starts("BoltKnob") then
		return "Bolt"
	end
	return nil
end

local function centerOf(list)
	if #list == 0 then
		return nil
	end
	local sum = Vector3.zero
	for _, entry in list do
		sum += entry.Offset.Position
	end
	return sum / #list
end

collectMovingParts = function(model, weaponDef)
	for key, list in moving do
		table.clear(list)
		movingDirty[key] = false
	end
	local handle = model.PrimaryPart
	if not handle or weaponDef.Type ~= "Gun" then
		-- (las armas cuerpo a cuerpo solo mueven los brazos con el arma entera)
		return
	end
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") and part ~= handle then
			local group = movingGroup(part)
			if group then
				table.insert(moving[group], { Part = part, Offset = handle.CFrame:ToObjectSpace(part.CFrame) })
			end
		end
	end
	magCenter = centerOf(moving.Mag)
	boltCenter = centerOf(moving.Bolt)
end

-- Coloca un grupo desplazado (offset en el espacio del arma). Sin offset, solo si hace falta
-- devolverlo a su sitio (el arma entera ya se movió con PivotTo).
local function placeGroup(key, handleCF, offset, fade)
	local list = moving[key]
	if #list == 0 then
		return
	end
	if not offset and not movingDirty[key] then
		return
	end
	movingDirty[key] = offset ~= nil
	local cf = offset or CFrame.identity
	for _, entry in list do
		entry.Part.CFrame = handleCF * cf * entry.Offset
		if key == "Mag" then
			entry.Part.LocalTransparencyModifier = offset and fade or 0
		end
	end
end

local function destroyViewmodel()
	if viewmodel then
		viewmodel:Destroy()
		viewmodel = nil
	end
	viewmodelHidden = false
end

local function createViewmodel(tool)
	destroyViewmodel()
	local weaponName = tool:GetAttribute("Weapon")
	local weaponDef = Weapons.Get(weaponName)
	local model = WeaponModels.Build(weaponName, tool:GetAttribute("Skin"), nil, tool:GetAttribute("Charm"))
	-- Colgante: se guarda dónde está cada pieza respecto a la anilla para balancearlas (renderStep)
	table.clear(charmParts)
	local ring = model:FindFirstChild("CharmRing")
	if ring then
		for _, part in model:GetChildren() do
			if part:IsA("BasePart") and part ~= ring and string.sub(part.Name, 1, 5) == "Charm" then
				table.insert(charmParts, { Part = part, Offset = ring.CFrame:ToObjectSpace(part.CFrame) })
			end
		end
	end
	charmRing = ring
	resetCharm()
	if weaponDef.RightHand then
		addArm(model, weaponDef.RightHand, RIGHT_SHOULDER, weaponDef, "Right")
	end
	if weaponDef.LeftHand then
		addArm(model, weaponDef.LeftHand, LEFT_SHOULDER, weaponDef, "Left")
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.CastShadow = false
		end
	end
	model.Name = "Viewmodel"
	collectMovingParts(model, weaponDef)
	-- Brillo suave del neón del arma sobre las manos (se nota mucho en mapas oscuros)
	local glowPalette = WeaponModels.GetPalette(weaponName, tool:GetAttribute("Skin"))
	-- Solo si el neón brilla de verdad (las armas clásicas sin skin no llevan neón)
	local neonAccent = (glowPalette.AccentMaterial or Enum.Material.Neon) == Enum.Material.Neon
	if model.PrimaryPart and neonAccent then
		local glow = Instance.new("PointLight")
		glow.Name = "NeonGlow"
		glow.Color = glowPalette.Accent
		glow.Range = 4.5
		glow.Brightness = 0.7
		glow.Shadows = false
		glow.Parent = model.PrimaryPart
	end
	model.Parent = camera
	viewmodel = model

	-- Skins con "Pulse": los detalles de neón laten
	table.clear(pulseParts)
	pulseSkin = WeaponModels.GetPalette(weaponName, tool:GetAttribute("Skin"))
	if pulseSkin.Pulse then
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") and part:GetAttribute("Role") == "Accent" then
				table.insert(pulseParts, part)
			end
		end
	end
end

local function setViewmodelHidden(hidden)
	if not viewmodel or viewmodelHidden == hidden then
		return
	end
	viewmodelHidden = hidden
	resetCharm()
	for _, part in viewmodel:GetDescendants() do
		if part:IsA("BasePart") then
			part.LocalTransparencyModifier = hidden and 1 or 0
		elseif part:IsA("ParticleEmitter") then
			part.Enabled = not hidden
		elseif part:IsA("SurfaceGui") or part:IsA("PointLight") then
			part.Enabled = not hidden
		end
	end
end

---------------------------------------------------------------------------
-- Equipar
---------------------------------------------------------------------------

local function onUnequipped()
	if attrConnection then
		attrConnection:Disconnect()
		attrConnection = nil
	end
	destroyViewmodel()
	equippedTool, def = nil, nil
	smokeShots = 0
	triggerHeld = false
	reloadStart = nil
	ClientState.CurrentTool = nil
	ClientState.CurrentDef = nil
	ClientState.Reloading = false
	ClientState.WeaponChanged:Fire()
end

local function onEquipped(tool)
	if equippedTool then
		onUnequipped()
	end
	local weaponDef = Weapons.Get(tool:GetAttribute("Weapon"))
	if not weaponDef then
		return
	end
	equippedTool, def = tool, weaponDef
	equipTime = os.clock()
	sprayCount, debtPitch, debtYaw = 0, 0, 0 -- (el retroceso de otra arma no se recupera con esta)
	swayX, swayY, swayVelX, swayVelY = 0, 0, 0, 0
	pendingShot, pendingBurst = nil, false
	wallAlpha, airOffset = 0, 0
	updateRayFilter()
	inspectTime = -10
	reloadStart = nil
	localAmmo = tool:GetAttribute("Ammo") or 0
	if weaponDef.Type == "Melee" then
		Sounds.Play("Unsheath")
	else
		Sounds.PlayGun("Equip", nil, weaponDef.Pellets > 1 and 0.85 or 1, 1)
	end

	hideToolLocally(tool)
	createViewmodel(tool)

	attrConnection = tool.AttributeChanged:Connect(function(attribute)
		if attribute == "Ammo" then
			local serverAmmo = tool:GetAttribute("Ammo") or 0
			-- Subida = recarga; bajada = confirmación de disparos que ya predijimos
			if serverAmmo > localAmmo then
				localAmmo = serverAmmo
			else
				localAmmo = math.min(localAmmo, serverAmmo)
			end
		elseif attribute == "Skin" then
			createViewmodel(tool)
			hideToolLocally(tool)
		elseif attribute == "Reloading" and not tool:GetAttribute("Reloading") then
			reloadStart = nil
		end
	end)

	ClientState.CurrentTool = tool
	ClientState.CurrentDef = weaponDef
	ClientState.WeaponChanged:Fire()
end

local function getTools()
	local list = {}
	local containers = { player:FindFirstChildOfClass("Backpack"), character }
	for _, container in containers do
		if container then
			for _, tool in container:GetChildren() do
				if tool:IsA("Tool") and tool:GetAttribute("Slot") then
					list[tool:GetAttribute("Slot")] = tool
				end
			end
		end
	end
	return list
end
WeaponController.GetTools = getTools

local function equipSlot(slot)
	if not humanoid or humanoid.Health <= 0 or ClientState.IsBlocked() then
		return
	end
	local tool = getTools()[slot]
	if tool and tool ~= equippedTool then
		humanoid:EquipTool(tool)
	end
end

local function cycleSlot(direction)
	local current = equippedTool and equippedTool:GetAttribute("Slot") or 1
	local tools = getTools()
	for i = 1, 3 do
		local slot = (current - 1 + direction * i) % 3 + 1
		if tools[slot] then
			equipSlot(slot)
			return
		end
	end
end

---------------------------------------------------------------------------
-- Disparo
---------------------------------------------------------------------------

local function randomInCone(direction, degrees)
	if degrees <= 0 then
		return direction
	end
	local angle = math.rad(degrees) * math.sqrt(math.random())
	local spin = math.random() * math.pi * 2
	return (CFrame.lookAt(Vector3.zero, direction) * CFrame.Angles(0, 0, spin) * CFrame.Angles(angle, 0, 0)).LookVector
end

local function currentSpread()
	if not def or def.Type ~= "Gun" then
		return 0
	end
	local spread = lerp(def.Spread, def.AimSpread, aimAlpha)
	local speed = 0
	if rootPart then
		local velocity = rootPart.AssemblyLinearVelocity
		speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	end
	-- Cuanto más rápido te mueves, menos preciso (apuntando se nota menos)
	spread *= 1 + math.clamp(speed / 18, 0, 1.5) * (0.6 - aimAlpha * 0.35)
	if humanoid and humanoid.FloorMaterial == Enum.Material.Air then
		spread *= 2
	elseif ClientState.Crouching then
		spread *= 0.75 -- agachado se apunta mejor
	end
	-- Primer disparo quieto y tras una pausa: casi exacto
	if speed < 2 and os.clock() - lastShot > math.max(0.35, 2.5 / def.FireRate) then
		spread *= 0.45
	end
	return spread + ClientState.Bloom * (1 - aimAlpha * 0.7)
end

local function requestReload()
	if not equippedTool or not def or def.Type ~= "Gun" or reloadStart then
		return
	end
	local reserve = equippedTool:GetAttribute("Reserve") or 0
	if localAmmo >= def.MagSize or reserve <= 0 then
		return
	end
	reloadStart = os.clock()
	inspectTime = -10
	Remotes.Reload:FireServer(equippedTool)
	-- Secuencia de la recarga: sacar el cargador, meter el nuevo y (si estaba vacía) montar el arma.
	-- Si la recarga se corta (cambias de arma, cuchillo...) deja de sonar.
	local wasEmpty = localAmmo <= 0
	local token, reloadTime = reloadStart, Weapons.ReloadDuration(def, wasEmpty)
	reloadWasEmpty = wasEmpty
	reloadDuration = reloadTime
	local shotgun = def.Pellets > 1 and #moving.Mag == 0 -- (la escopeta de tambor recarga con cargador)
	local function step(at, name, pitch, volume)
		task.delay(reloadTime * at, function()
			if reloadStart == token then
				Sounds.PlayGun(name, nil, pitch, volume)
			end
		end)
	end
	if shotgun then
		-- Escopetas: cartucho a cartucho
		for index, at in { 0.2, 0.38, 0.56, 0.74 } do
			step(at, "MagIn", 1.25 + index * 0.03, 0.55)
		end
	else
		step(0.12, "MagOut", 1, 1)
		step(0.55, "MagIn", 1, 1)
	end
	if wasEmpty or shotgun then
		step(0.85, "Bolt", shotgun and 0.75 or 1, 1)
	end
end

local function fire()
	local now = os.clock()
	if not equippedTool or not def or def.Type ~= "Gun" or ClientState.IsBlocked() or ClientState.Frozen() then
		return
	end
	if now - lastShot < 1 / def.FireRate or reloadStart or now - equipTime < 0.25 then
		return
	end
	if localAmmo <= 0 then
		lastShot = now
		kickVel += 0.5 -- el gatillo en vacío: un tirón seco
		Sounds.Play("Empty")
		requestReload()
		return
	end
	-- Salida del sprint: el arma tiene que subir antes de disparar (~0,1 s). El disparo no se pierde:
	-- queda pendiente y sale en cuanto el arma está arriba
	if sprintAlpha > 0.35 then
		ClientState.LastShotTime = now -- (deja de correr)
		ClientState.Sprinting = false
		pendingShot = pendingShot or now
		return
	end

	if now - lastShot > math.max(0.3, 2.2 / def.FireRate) then
		sprayCount = 0 -- ráfaga nueva
	end
	sprayCount += 1
	local spread = currentSpread() -- (antes de apuntar este disparo: el primero va más preciso)
	lastShot = now
	localAmmo -= 1
	ClientState.LastShotTime = now
	inspectTime = -10
	ClientState.Sprinting = false

	updateRayFilter()
	local origin = camera.CFrame.Position
	local look = camera.CFrame.LookVector
	local muzzle = viewmodel and viewmodel.PrimaryPart and viewmodel.PrimaryPart:FindFirstChild("Muzzle")
	local muzzlePos = muzzle and muzzle.WorldPosition or origin
	local tracerColor = WeaponModels.GetPalette(equippedTool:GetAttribute("Weapon"), equippedTool:GetAttribute("Skin")).Accent

	local rays = {}
	if def.Explosive then
		-- Cohete: viaja hasta el impacto y explota
		local direction = randomInCone(look, spread)
		local result = workspace:Raycast(origin, direction * def.Range, rayParams)
		local hitPosition = result and result.Position or origin + direction * def.Range
		table.insert(rays, { Part = result and result.Instance or nil, Position = hitPosition })
		Effects.Rocket(muzzlePos, hitPosition, def.ProjectileSpeed or 200, tracerColor, def.Explosive.Radius, def.ProjectileStyle)
	end
	for pellet = 1, def.Explosive and 0 or def.Pellets do
		local direction = randomInCone(look, spread)
		local result = workspace:Raycast(origin, direction * def.Range, rayParams)
		local hitPosition = result and result.Position or origin + direction * def.Range
		table.insert(rays, { Part = result and result.Instance or nil, Position = hitPosition })
		-- (escopetas: basta con dibujar unos pocos perdigones; el daño cuenta todos)
		if pellet <= 3 then
			Effects.Tracer(muzzlePos, hitPosition, tracerColor)
		end
		if result then
			if pellet <= 4 then
				Effects.Impact(result.Position, result.Normal, result.Instance, result.Material, def.ImpactStyle)
			end
			local model = result.Instance:FindFirstAncestorOfClass("Model")
			if model and model:FindFirstChildOfClass("Humanoid") then
				ClientState.LastHitPosition = result.Position
				ClientState.LastHitTime = os.clock()
				ClientState.LastHitModel = model
			end
		end
	end
	Remotes.Fire:FireServer(equippedTool, origin, rays)

	Effects.MuzzleFlash(muzzle)
	if not def.Explosive then
		smokeShots += 1
		Effects.StopBarrelSmoke(muzzle)
	end
	local eject = viewmodel and viewmodel.PrimaryPart and viewmodel.PrimaryPart:FindFirstChild("Eject")
	if not def.Explosive then
		Effects.ShellCasing(eject, camera.CFrame, def.Pellets > 1 and Color3.fromRGB(220, 50, 50) or nil)
	end
	local weaponName = equippedTool:GetAttribute("Weapon") or ""
	Sounds.PlayShot(weaponName, def)
	shakeRoll += (math.random() - 0.5) * math.rad(def.Recoil) * 0.6
	-- Mecánica del arma: cerrojo de los francotiradores y corredera de las escopetas
	if not def.Explosive and def.FireRate <= 1.6 and localAmmo > 0 then
		local shotDef = def
		task.delay(0.28, function()
			if def == shotDef then
				Sounds.PlayGun("Bolt", nil, shotDef.Pellets > 1 and 0.7 or 1.05, 0.8)
			end
		end)
	end
	-- Quedan pocas balas: un "tic" más agudo cuanto menos quede (avisa sin mirar el HUD)
	if def.MagSize >= 4 and localAmmo > 0 and localAmmo <= math.ceil(def.MagSize * 0.25) then
		Sounds.Play("LowAmmo", nil, 1 + (1 - localAmmo / (def.MagSize * 0.25)) * 0.3, 1)
	end

	-- Retroceso. La mira sube más en los primeros disparos de la ráfaga y luego se estabiliza;
	-- el lado sigue un patrón propio de cada arma (se puede aprender a controlar) con algo de azar.
	local recoil = math.rad(def.Recoil)
	local ads = 1 - aimAlpha * 0.35
	local climb = recoil * (0.75 + 0.5 * math.min(sprayCount, 6) / 6) * ads
	local seed = #weaponName * 1.7
	local drift = math.sin(sprayCount * 0.55 + seed) * 0.45 + (math.random() - 0.5) * 0.25
	local yaw = recoil * drift * (sprayCount > 3 and 1 or 0.4) * ads
	camKick += climb
	camYaw += yaw
	debtPitch += climb
	debtYaw += yaw
	-- Golpe del arma en la mano (muelles): hacia atrás, hacia arriba y un poco de lado
	local hip = 1 - aimAlpha * 0.5
	kickVel += (1.6 + def.Recoil * 0.55) * hip
	rotVel += recoil * 10 * hip
	sideVel += (math.random() - 0.5) * recoil * 9
	-- Las armas potentes sacuden la cámara y abren un poco el campo de visión
	if def.Recoil >= 3 then
		ClientState.Shake = math.max(ClientState.Shake or 0, def.Recoil * 0.05)
		ClientState.FovKick = (ClientState.FovKick or 0) + def.Recoil * 0.22
	end
	ClientState.Bloom = math.min(ClientState.Bloom + def.Recoil * 0.4, 6)
	ClientState.ShotFired:Fire()

	if localAmmo <= 0 then
		task.delay(0.2, requestReload)
	end
end

-- Ráfaga (Vortex AR-9, Phantom Sidewind): varios disparos seguidos con una pausa entre ráfagas
local bursting = false
local lastBurstEnd = 0
local function startBurst()
	if bursting or not def or not def.Burst then
		return
	end
	if sprintAlpha > 0.35 then -- (salida del sprint: la ráfaga sale cuando el arma esté arriba)
		ClientState.LastShotTime = os.clock()
		ClientState.Sprinting = false
		pendingShot, pendingBurst = pendingShot or os.clock(), true
		return
	end
	if os.clock() - lastBurstEnd < (def.BurstCooldown or 0.3) then
		return
	end
	bursting = true
	local burstDef = def
	task.spawn(function()
		for i = 1, burstDef.Burst do
			if def ~= burstDef or localAmmo <= 0 or reloadStart then
				break
			end
			fire()
			if i < burstDef.Burst then
				task.wait(1 / burstDef.FireRate + 0.01)
			end
		end
		lastBurstEnd = os.clock()
		bursting = false
	end)
end

local function melee()
	-- El arma cuerpo a cuerpo que lleves (cuchillo, martillo o katana) está en la ranura 3
	local meleeTool = getTools()[3]
	local knife = meleeTool and Weapons.Get(meleeTool:GetAttribute("Weapon"))
	if not knife or knife.Type ~= "Melee" then
		return
	end
	local now = os.clock()
	if now - meleeTime < knife.Cooldown or ClientState.IsBlocked() or ClientState.Frozen() or not humanoid or humanoid.Health <= 0 then
		return
	end
	meleeTime = now
	meleeWithKnife = def ~= nil and def.Type == "Melee"
	meleeSide = -meleeSide -- golpes alternos: uno de derecha a izquierda y el siguiente al revés
	meleeDuration = meleeWithKnife and math.clamp(knife.Cooldown * 0.75, 0.32, 0.6) or 0.38
	reloadStart = nil
	Sounds.Play("Swing")

	updateRayFilter()
	local origin = camera.CFrame.Position
	local direction = camera.CFrame.LookVector * knife.Range
	local result = workspace:Spherecast(origin, 1.2, direction, rayParams) or workspace:Raycast(origin, direction, rayParams)
	if result and result.Instance then
		Remotes.Melee:FireServer(result.Instance)
	end
end

---------------------------------------------------------------------------
-- Animación procedural del viewmodel (cada frame)
---------------------------------------------------------------------------

-- ¿Hay un enemigo vivo justo en el centro de la mira (al alcance del arma)?
local function enemyInSights()
	local hit = workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * math.min(def.Range or 300, 400), rayParams)
	local model = hit and hit.Instance:FindFirstAncestorOfClass("Model")
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or model == character then
		return false
	end
	-- (con la protección de aparición no se le puede herir: no vaciar el cargador en el escudo)
	if model:FindFirstChildOfClass("ForceField") then
		return false
	end
	if not ReplicatedStorage:GetAttribute("TeamMode") then
		return true
	end
	local owner = Players:GetPlayerFromCharacter(model)
	local team = owner and owner.Team and owner.Team.Name or model:GetAttribute("Team")
	return team ~= nil and team ~= "" and player.Team ~= nil and team ~= player.Team.Name
end

local function renderStep(dt)
	if not character or not humanoid then
		return
	end

	-- Disparo automático
	if triggerHeld and def and def.Type == "Gun" and def.Automatic then
		fire()
	end
	-- Disparo automático (modo sencillo de los shooters de móvil): con la mira sobre un enemigo,
	-- el arma dispara sola. Ajustes: 2 = solo en pantallas táctiles (por defecto), 1 = siempre, 0 = no
	local autoMode = math.floor(((ClientState.Settings or GameConfig.DefaultSettings).AutoFire or 2) + 0.5)
	-- (el rayo solo cuando el arma ya puede disparar: no cada fotograma de la cadencia)
	local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	if autoMode ~= 0 and (autoMode == 1 or touchOnly) and def and def.Type == "Gun"
		and not reloadStart and not bursting and os.clock() - lastShot >= 1 / def.FireRate
		and not ClientState.IsBlocked() and not ClientState.InMainMenu and enemyInSights() then
		if def.Burst then
			startBurst()
		else
			fire()
		end
	end
	-- Disparo pendiente de la salida del sprint (si se tarda demasiado, se descarta)
	if pendingShot then
		if os.clock() - pendingShot > 0.5 or not def or def.Type ~= "Gun" then
			pendingShot, pendingBurst = nil, false
		elseif sprintAlpha <= 0.35 then
			local burst = pendingBurst
			pendingShot, pendingBurst = nil, false
			if burst then
				startBurst()
			elseif not (triggerHeld and def.Automatic) then -- (el automático ya dispara solo)
				fire()
			end
		end
	end

	local firing = os.clock() - lastShot < 0.15
	ClientState.Bloom = math.max(0, ClientState.Bloom - dt * (firing and 5 or 14))
	ClientState.Spread = currentSpread()

	-- Recarga: tiempo límite por si el servidor la rechazó
	if reloadStart and def and os.clock() - reloadStart > reloadDuration + 1 then
		reloadStart = nil
	end
	ClientState.Reloading = reloadStart ~= nil
	ClientState.ReloadProgress = (reloadStart and def) and math.clamp((os.clock() - reloadStart) / reloadDuration, 0, 1)
		or 0
	ClientState.Ammo = localAmmo

	-- Apuntar
	local canAim = def ~= nil and def.Type == "Gun" and aimHeld and not reloadStart and not ClientState.IsBlocked()
	ClientState.Aiming = canAim
	if canAim then
		inspectTime = -10
	end
	aimAlpha = lerp(aimAlpha, canAim and 1 or 0, math.min(1, dt * 14))
	if aimAlpha < 0.001 then
		aimAlpha = 0
	end
	ClientState.AimAlpha = aimAlpha
	sprintAlpha = lerp(sprintAlpha, (ClientState.Sprinting and not reloadStart) and 1 or 0, math.min(1, dt * 10))

	-- Muerto (o en la killcam) la cámara ya no es tuya: nada de retroceso, balanceo ni temblores
	if not ClientState.Dead and humanoid.Health > 0 then
		-- Retroceso de cámara
		local applyPitch = camKick * math.min(1, dt * 22)
		local applyYaw = camYaw * math.min(1, dt * 22)
		camKick -= applyPitch
		camYaw -= applyYaw
		if applyPitch ~= 0 or applyYaw ~= 0 then
			camera.CFrame = camera.CFrame * CFrame.Angles(applyPitch, applyYaw, 0)
		end
		-- Recuperación: al dejar de disparar, la mira baja sola parte de lo que subió. Si mientras
		-- disparabas ya tirabas del ratón hacia abajo, eso cuenta y no baja de más.
		local mouseDown = UserInputService:GetMouseDelta().Y
		if mouseDown > 0 and debtPitch > 0 then
			debtPitch = math.max(0, debtPitch - mouseDown * 0.0025)
		end
		if os.clock() - lastShot > 0.12 and math.abs(camKick) < 0.002 and (debtPitch > 0.0005 or math.abs(debtYaw) > 0.0005) then
			local r = math.min(1, dt * 7)
			local backPitch, backYaw = debtPitch * r, debtYaw * r
			debtPitch -= backPitch
			debtYaw -= backYaw
			camera.CFrame = camera.CFrame * CFrame.Angles(-backPitch * RECOVER, -backYaw * RECOVER, 0)
		end
		-- Asistencia de apuntado (dedo o mando): la mira se va hacia el enemigo cercano. Lo que ya
		-- corrigió hacia abajo (o al lado contrario del retroceso) no se recupera otra vez al soltar
		local _, assistPitch, assistYaw = AimAssist.Update(dt)
		if assistPitch < 0 and debtPitch > 0 then
			debtPitch = math.max(0, debtPitch + assistPitch)
		end
		if assistYaw * debtYaw < 0 then
			debtYaw = math.sign(debtYaw) * math.max(0, math.abs(debtYaw) - math.abs(assistYaw))
		end
		-- Visor de francotirador: el pulso mueve un poco la mira (Mayús: aguantar la respiración)
		local swayPitch, swayYaw = ScopeSway.Update(dt, def ~= nil and def.Scope == true and aimAlpha > 0.85)
		if swayPitch ~= 0 or swayYaw ~= 0 then
			camera.CFrame = camera.CFrame * CFrame.Angles(swayPitch, swayYaw, 0)
		end
		-- Tras una ráfaga larga (o varios tiros de escopeta/francotirador), sale humo del cañón
		if smokeShots > 0 and os.clock() - lastShot > 0.3 then
			local heavy = def ~= nil and (def.Pellets > 1 or def.Damage >= 60)
			local shots = heavy and smokeShots * 4 or smokeShots
			if shots >= 7 and viewmodel and viewmodel.PrimaryPart then
				Effects.BarrelSmoke(viewmodel.PrimaryPart:FindFirstChild("Muzzle"), math.min(1, shots / 24))
			end
			smokeShots = 0
		end

		-- Inclinación de cámara al moverse de lado y pequeña sacudida al disparar.
		-- El módulo de cámara recalcula el giro cada frame, así que esto no se acumula.
		if rootPart then
			local velocity = rootPart.AssemblyLinearVelocity
			local side = velocity:Dot(camera.CFrame.RightVector)
			strafeRoll = lerp(strafeRoll, math.clamp(-side / 26, -1, 1) * math.rad(1.6), math.min(1, dt * 8))
		end
		shakeRoll = lerp(shakeRoll, 0, math.min(1, dt * 18))
		camera.CFrame = camera.CFrame * CFrame.Angles(0, 0, strafeRoll + shakeRoll)
		-- Temblor por explosiones cercanas (se apaga solo en ~0,6 s)
		local shake = ClientState.Shake or 0
		if shake > 0.01 then
			local t = os.clock() * 40
			camera.CFrame = camera.CFrame
				* CFrame.Angles(math.noise(t, 1) * shake * 0.05, math.noise(t, 2) * shake * 0.05, math.noise(t, 3) * shake * 0.03)
			ClientState.Shake = math.max(0, shake - dt * 1.6)
		end
		-- Balanceo de cabeza al andar y correr, y golpe al aterrizar desde alto. Solo se mueve la
		-- posición y el alabeo (no hacia dónde se mira), así que no desvía la puntería ni se acumula.
		local moveConfig = GameConfig.Movement
		if rootPart and humanoid and moveConfig then
			local v = rootPart.AssemblyLinearVelocity
			local flatSpeed = Vector3.new(v.X, 0, v.Z).Magnitude
			local onGround = humanoid.FloorMaterial ~= Enum.Material.Air and not ClientState.Sliding
			if onGround then
				headBobTime += dt * math.min(flatSpeed, 32) * 0.42
			end
			headBobAmount = lerp(headBobAmount, onGround and math.clamp(flatSpeed / 18, 0, 1.6) or 0, math.min(1, dt * 8))
			local amount = headBobAmount * (moveConfig.CameraBob or 1) * (1 - aimAlpha * 0.85)
			if amount > 0.001 and not ClientState.InMainMenu then
				local y = -math.abs(math.sin(headBobTime)) * 0.08 * amount
				local roll = math.sin(headBobTime) * math.rad(0.4) * amount
				camera.CFrame = camera.CFrame * CFrame.new(0, y, 0) * CFrame.Angles(0, 0, roll)
			end
		end
		local land = ClientState.LandKick or 0
		if land > 0.01 then
			camera.CFrame = camera.CFrame * CFrame.new(0, -0.55 * land, 0) * CFrame.Angles(0, 0, math.rad(1.2) * land)
			ClientState.LandKick = land * math.max(0, 1 - dt * 7)
		else
			ClientState.LandKick = 0
		end
	end

	-- Latido de las skins míticas
	if #pulseParts > 0 and pulseSkin then
		local t = (math.sin(os.clock() * 3) + 1) / 2
		local color = pulseSkin.Accent:Lerp(pulseSkin.Accent2 or Color3.new(1, 1, 1), t)
		for _, part in pulseParts do
			part.Color = color
		end
		local glow = viewmodel and viewmodel.PrimaryPart and viewmodel.PrimaryPart:FindFirstChild("NeonGlow")
		if glow and glow:IsA("PointLight") then
			glow.Color = color
		end
	end

	-- Campo de visión (el del menú Ajustes) y sensibilidad: al apuntar baja en proporción al zoom
	local settings = ClientState.Settings or GameConfig.DefaultSettings
	local baseFov = settings.FOV or GameConfig.FieldOfView
	local targetFov = baseFov
	local aimScale = 1
	if def and def.AimFOV then
		targetFov = lerp(baseFov, math.min(def.AimFOV, baseFov), aimAlpha)
		aimScale = lerp(1, (settings.AimSensitivity or 0.8) * math.min(1, def.AimFOV / baseFov) ^ 0.5, aimAlpha)
	end
	local kick = ClientState.FovKick or 0
	if kick > 0.01 then
		ClientState.FovKick = kick * math.max(0, 1 - dt * 5)
	else
		ClientState.FovKick = 0
	end
	camera.FieldOfView = targetFov + sprintAlpha * 6 + kick
	UserInputService.MouseDeltaSensitivity = (settings.Sensitivity or 1) * aimScale

	if not viewmodel or not def then
		return
	end

	local now = os.clock()
	local function smooth(x)
		x = math.clamp(x, 0, 1)
		return x * x * (3 - 2 * x)
	end
	local function window(x, a, b) -- 0 -> 1 entre a y b
		return smooth((x - a) / (b - a))
	end
	local function pulse(x, center, width) -- 0 -> 1 -> 0 alrededor de center
		return smooth(1 - math.abs(x - center) / width)
	end

	-- Balanceo al caminar (al correr, más amplio y con giro: el "ocho" de los shooters)
	local speed, verticalSpeed = 0, 0
	if rootPart then
		local velocity = rootPart.AssemblyLinearVelocity
		speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
		verticalSpeed = velocity.Y
	end
	local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
	if grounded and not ClientState.Sliding then
		bobTime += dt * math.min(speed, 30) * 0.45
	end
	local bobAmount = math.clamp(speed / 18, 0, 1.5) * (1 - aimAlpha * 0.9)
	if not grounded or ClientState.Sliding then
		bobAmount = 0
	end
	local s = sprintAlpha
	local bob = CFrame.new(
		math.cos(bobTime) * (0.05 + 0.05 * s) * bobAmount,
		-math.abs(math.sin(bobTime)) * (0.06 + 0.04 * s) * bobAmount,
		0
	) * CFrame.Angles(0, 0, math.cos(bobTime) * math.rad(3.5) * s * bobAmount)

	-- Respiración: el arma nunca está del todo quieta (apuntando, casi nada)
	local breathScale = (1 - aimAlpha * 0.8) * (1 - math.min(1, bobAmount))
	local breath = CFrame.new(math.sin(now * 0.8) * 0.01 * breathScale, math.sin(now * 1.6) * 0.014 * breathScale, 0)
		* CFrame.Angles(math.sin(now * 1.6 + 0.6) * math.rad(0.5) * breathScale, 0, 0)

	-- Inercia al mover el ratón: muelle (se retrasa, se pasa un poco y vuelve). Las armas
	-- pesadas (las que te hacen ir más lento) van más perezosas.
	local delta = UserInputService:GetMouseDelta()
	local weight = math.clamp(def.WalkSpeedMultiplier or 1, 0.8, 1.15)
	local stiffness, damping = 160 * weight * weight, 16 * weight
	local sdt = math.min(dt, 1 / 30)
	local targetX = math.clamp(-delta.X * 0.004, -0.12, 0.12)
	local targetY = math.clamp(-delta.Y * 0.004, -0.12, 0.12)
	swayVelX += ((targetX - swayX) * stiffness - swayVelX * damping) * sdt
	swayVelY += ((targetY - swayY) * stiffness - swayVelY * damping) * sdt
	swayX += swayVelX * sdt
	swayY += swayVelY * sdt
	local swayScale = 1 - aimAlpha * 0.75
	local sway = CFrame.Angles(swayY * swayScale, swayX * swayScale, swayX * 0.6 * swayScale)

	-- Moverse: al ir de lado el arma se inclina; al saltar se queda atrás y al caer se hunde
	local strafeTilt = CFrame.Angles(0, 0, strafeRoll * 2.5 * (1 - aimAlpha * 0.8))
	airOffset = lerp(airOffset, grounded and 0 or math.clamp(-verticalSpeed * 0.005, -0.12, 0.12), math.min(1, dt * 10))
	local land = ClientState.LandKick or 0
	local airCF = CFrame.new(0, airOffset - 0.2 * land, 0) * CFrame.Angles(airOffset * 0.8 - math.rad(7) * land, 0, 0)

	-- Retroceso del arma
	-- (muelles amortiguados: el arma va hacia atrás, se pasa un poquito al volver y se asienta)
	kickVel += (-260 * recoilKick - 24 * kickVel) * sdt
	recoilKick += kickVel * sdt
	rotVel += (-220 * recoilRot - 20 * rotVel) * sdt
	recoilRot += rotVel * sdt
	sideVel += (-180 * recoilSide - 18 * sideVel) * sdt
	recoilSide += sideVel * sdt
	local recoilCF = CFrame.new(recoilSide * 0.4, 0, recoilKick) * CFrame.Angles(recoilRot, recoilSide * 0.6, recoilSide * 1.5)

	-- Cadera -> mira
	-- (en el teléfono, el arma de cadera algo más abajo, a la derecha y lejos: en una pantalla
	-- pequeña tapaba media pantalla y los botones táctiles)
	local hipOffset = phoneScreen and PHONE_HIP * def.ViewOffset or def.ViewOffset
	local base = hipOffset
	if def.AimPoint then
		local a = def.AimPoint
		local aimCF = CFrame.new(-a.X, -a.Y, -def.AimDistance - a.Z)
		base = hipOffset:Lerp(aimCF, aimAlpha)
	end

	-- Correr
	local sprintCF = CFrame.new(-0.25 * s, -0.2 * s, 0.1 * s) * CFrame.Angles(math.rad(-12) * s, math.rad(35) * s, math.rad(18) * s)

	-- Pegado a una pared: el arma se recoge y apunta hacia arriba en vez de atravesarla
	if now - wallCheckTime > 1 then
		wallCheckTime = now
		updateRayFilter()
	end
	local wallTarget = 0
	if def.Type == "Gun" and not ClientState.InMainMenu then
		local hit = workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * 3.4, rayParams)
		local part = hit and hit.Instance
		local solid = part and part:IsA("BasePart") and part.CanCollide and part.Transparency < 0.9
		if solid and not (part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")) then
			wallTarget = math.clamp(1 - (hit.Distance - 1.1) / 2.3, 0, 1) * (1 - aimAlpha * 0.6)
		end
	end
	wallAlpha = lerp(wallAlpha, wallTarget, math.min(1, dt * 10))
	local w = wallAlpha
	local wallCF = CFrame.new(-0.1 * w, -0.1 * w, 0.55 * w) * CFrame.Angles(math.rad(32) * w, math.rad(-12) * w, math.rad(-14) * w)

	-- Recarga. Con cargador: lo sueltas, la mano trae otro, lo encaja (golpe) y, si estaba
	-- vacía, se monta. Escopetas: cartucho a cartucho y bombeo al final. Va al ritmo de los sonidos.
	local reloadCF = CFrame.new()
	local magOffset, magFade, leftOffset, rightOffset = nil, 0, nil, nil
	local slideBack, pumpBack, boltBack = 0, 0, 0
	local p = reloadStart and ClientState.ReloadProgress or -1
	local shotgun = (def.Pellets or 1) > 1 and #moving.Mag == 0
	if p >= 0 then
		local tilt = window(p, 0, 0.12) * (1 - window(p, 0.86, 1))
		local seat = pulse(p, 0.57, 0.05)
		local function aroundMag(rotation) -- (gira sobre su propio centro)
			return CFrame.new(magCenter) * rotation * CFrame.new(-magCenter)
		end
		if magCenter and not shotgun then
			-- Cargador fuera (cae acelerando y desaparece) y el nuevo sube desde abajo
			if p < 0.3 then
				local out = window(p, 0.1, 0.26)
				magOffset = CFrame.new(0, -1.8 * out * out, 0.12 * out) * aroundMag(CFrame.Angles(math.rad(-15) * out, 0, 0))
				magFade = out
			else
				local into = window(p, 0.34, 0.55)
				magOffset = CFrame.new(0, -0.9 * (1 - into), 0.15 * (1 - into)) * aroundMag(CFrame.Angles(math.rad(-10) * (1 - into), 0, 0))
				magFade = 1 - window(p, 0.3, 0.38)
			end
			-- La mano izquierda baja a por el cargador nuevo, lo sube hasta su sitio y vuelve
			local hand = def.LeftHand or magCenter
			local grab = window(p, 0.14, 0.28) * (1 - window(p, 0.58, 0.72))
			local bottom = magCenter + Vector3.new(0, -0.35, 0.05) - hand
			local follow = p < 0.3 and Vector3.new(0, -0.9 * window(p, 0.16, 0.3), 0.15 * window(p, 0.16, 0.3))
				or magOffset.Position
			leftOffset = CFrame.new((bottom + follow) * grab)
			reloadCF = CFrame.new(-0.08 * tilt, -0.1 * tilt + 0.05 * seat, 0.05 * tilt)
				* CFrame.Angles(math.rad(8) * tilt + math.rad(4) * seat, math.rad(-10) * tilt, math.rad(28) * tilt)
		elseif shotgun then
			-- Cartuchos: la mano va de la cartuchera a la ventana de carga cuatro veces
			local active = window(p, 0.08, 0.16) * (1 - window(p, 0.78, 0.84))
			local push = 0
			for _, at in { 0.2, 0.38, 0.56, 0.74 } do
				push = math.max(push, pulse(p, at, 0.07))
			end
			local port = Vector3.new(0, -0.32, -0.15) - (def.LeftHand or Vector3.new(0, -0.3, -1))
			if active > 0.001 then
				leftOffset = CFrame.new((port + Vector3.new(0.1, -0.55, 0.25) * (1 - push)) * active)
			end
			reloadCF = CFrame.new(-0.05 * tilt, -0.08 * tilt + 0.03 * push * active, 0)
				* CFrame.Angles(math.rad(12) * tilt, math.rad(-8) * tilt, math.rad(-32) * tilt)
			pumpBack = pulse(p, 0.91, 0.06)
		else
			-- Lanzacohetes, ballesta, revólver...: la mano baja, trae la munición y la mete
			local fetch = pulse(p, 0.38, 0.22)
			leftOffset = CFrame.new(0.1 * fetch, -0.8 * fetch, 0.2 * fetch)
			reloadCF = CFrame.new(0, -0.3 * tilt + 0.04 * seat, 0) * CFrame.Angles(math.rad(-18) * tilt, 0, math.rad(30) * tilt)
		end
		-- Montar el arma (si estaba vacía): tirón seco hacia atrás
		if reloadWasEmpty and not shotgun then
			local charge = pulse(p, 0.88, 0.05)
			reloadCF *= CFrame.new(0, 0, 0.06 * charge) * CFrame.Angles(math.rad(-3) * charge, 0, math.rad(-6) * charge)
			slideBack = p < 0.86 and 1 or 0
		end
	elseif def.Type == "Gun" then
		local t = now - lastShot
		-- Corredera de las pistolas: atrás y adelante en cada disparo; abierta si te quedas sin balas
		slideBack = localAmmo <= 0 and 1 or (t < 0.03 and t / 0.03 or math.max(0, 1 - (t - 0.03) / 0.07))
		local manual = def.FireRate <= 1.6 and not def.Explosive and localAmmo > 0
		if manual and t < 0.7 then
			local cycle = (t - 0.14) / 0.36
			if cycle > 0 and cycle < 1 then
				local motion = math.sin(cycle * math.pi)
				if def.Pellets > 1 then
					-- Bombeo de la escopeta (con la mano izquierda en el guardamanos)
					pumpBack = motion
					reloadCF = CFrame.Angles(math.rad(-3) * motion, 0, math.rad(-4) * motion)
				elseif boltCenter then
					-- Cerrojo: la mano derecha va a la manilla, la abre, tira y la cierra
					boltBack = motion
					local reach = smooth(math.min(cycle / 0.2, (1 - cycle) / 0.2))
					rightOffset = CFrame.new((boltCenter - (def.RightHand or boltCenter) + Vector3.new(0.05, 0, 0.1)) * reach + Vector3.new(0, 0, 0.3 * motion))
					reloadCF = CFrame.new(0, -0.04 * reach, 0) * CFrame.Angles(0, 0, math.rad(-14) * reach)
				end
			end
		end
	end

	-- Sacar arma: sube desde abajo girando y se asienta con un pequeño rebote
	local e = math.clamp((now - equipTime) / 0.4, 0, 1)
	local c1, c3 = 1.70158, 2.70158
	local raise = 1 + c3 * (e - 1) ^ 3 + c1 * (e - 1) ^ 2 -- (sale un poco de más y vuelve)
	local down = 1 - raise
	local equipCF = CFrame.new(0.15 * down, -0.9 * down, 0.1 * down) * CFrame.Angles(math.rad(-50) * down, math.rad(15) * down, math.rad(-25) * down)

	-- Cuerpo a cuerpo: golpe rápido (el impacto es al instante) y vuelta más lenta, alternando lado
	local meleeCF = CFrame.new()
	local m = (now - meleeTime) / meleeDuration
	if m < 1 then
		local k = m < 0.3 and 1 - (1 - m / 0.3) ^ 3 or 1 - smooth((m - 0.3) / 0.7)
		local side = meleeSide
		if meleeWithKnife then
			meleeCF = CFrame.new(-0.6 * k * side, 0.15 * k, -0.6 * k)
				* CFrame.Angles(math.rad(-20) * k, math.rad(70) * k * side, math.rad(-35) * k * side)
		else
			-- Culatazo con el arma de fuego
			meleeCF = CFrame.new(-0.3 * k, 0.05 * k, -0.55 * k) * CFrame.Angles(math.rad(10) * k, math.rad(30) * k, math.rad(25) * k)
		end
	end

	-- Inspeccionar: sube el arma, la gira para ver un costado y luego el otro, y vuelve
	local inspectCF = CFrame.new()
	local it = (now - inspectTime) / INSPECT_TIME
	if it < 1 then
		local envelope = smooth(math.min(it / 0.18, (1 - it) / 0.18))
		local turn = smooth((it - 0.18) / 0.64)
		local yaw = math.rad(70 + (-45 - 70) * turn)
		local roll = math.rad(-25 + 35 * turn)
		inspectCF = CFrame.new(-0.35 * envelope, 0.18 * envelope, 0.25 * envelope)
			* CFrame.Angles(math.rad(12) * envelope, yaw * envelope, roll * envelope)
	end

	-- Mira telescópica: ocultar el arma
	-- (y también en la pantalla de inicio, donde la cámara está lejos)
	local hide = (def.Scope == true and aimAlpha > 0.85) or ClientState.InMainMenu or ClientState.Emoting
	setViewmodelHidden(hide)
	if not hide then -- oculta no hace falta moverla cada fotograma
		viewmodel:PivotTo(
			camera.CFrame * bob * breath * sway * airCF * strafeTilt * base * sprintCF * wallCF * reloadCF * equipCF * meleeCF * inspectCF * recoilCF
		)
		-- Piezas móviles (después de colocar el arma entera)
		local handle = viewmodel.PrimaryPart
		if handle then
			local handleCF = handle.CFrame
			placeGroup("Mag", handleCF, magOffset, magFade)
			placeGroup("Slide", handleCF, slideBack > 0.001 and CFrame.new(0, 0, 0.16 * slideBack) or nil)
			local pumpCF = pumpBack > 0.001 and CFrame.new(0, 0, 0.36 * pumpBack) or nil
			placeGroup("Pump", handleCF, pumpCF)
			placeGroup("Bolt", handleCF, boltBack > 0.001 and CFrame.new(0, 0.04 * boltBack, 0.3 * boltBack) or nil)
			-- La mano izquierda acompaña a la bomba de la escopeta
			if pumpCF and not leftOffset then
				leftOffset = pumpCF
			end
			placeGroup("Left", handleCF, leftOffset)
			placeGroup("Right", handleCF, rightOffset)
		end
		swingCharm(dt)
	end
end

---------------------------------------------------------------------------
-- Entrada
---------------------------------------------------------------------------

local function bindActions()
	TouchLayout.BindAction("Fire", function(_, state)
		if ClientState.IsBlocked() then
			triggerHeld = false
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin then
			triggerHeld = true
			if def and def.Type == "Melee" then
				melee()
			elseif def and def.Burst then
				startBurst()
			else
				fire()
			end
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			triggerHeld = false
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)
	TouchLayout.SetTitle("Fire", "🔫") -- (iconos: con palabras no cabían en el botón)
	TouchLayout.Set("Fire", UDim2.new(1, -110, 1, -160))

	TouchLayout.BindAction("Aim", function(_, state, input)
		if ClientState.IsBlocked() then
			aimHeld = false
			return Enum.ContextActionResult.Pass
		end
		if input.UserInputType == Enum.UserInputType.Touch then
			if state == Enum.UserInputState.Begin then
				aimHeld = not aimHeld -- en móvil es un interruptor
			end
		elseif state == Enum.UserInputState.Begin then
			aimHeld = true
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			aimHeld = false
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL2)
	TouchLayout.SetTitle("Aim", "🎯")
	TouchLayout.Set("Aim", UDim2.new(1, -190, 1, -110))

	TouchLayout.BindAction("Reload", function(_, state)
		if state == Enum.UserInputState.Begin and not ClientState.IsBlocked() then
			requestReload()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.R, Enum.KeyCode.ButtonX)
	TouchLayout.SetTitle("Reload", "🔄")
	TouchLayout.Set("Reload", UDim2.new(1, -200, 1, -190))

	TouchLayout.BindAction("Melee", function(_, state)
		if state == Enum.UserInputState.Begin and not ClientState.IsBlocked() then
			melee()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.F, Enum.KeyCode.ButtonB)
	TouchLayout.SetTitle("Melee", "🔪")
	TouchLayout.Set("Melee", UDim2.new(1, -120, 1, -240))

	ContextActionService:BindAction("Slots", function(_, state, input)
		if state ~= Enum.UserInputState.Begin then
			return Enum.ContextActionResult.Pass
		end
		if input.KeyCode == Enum.KeyCode.One then
			equipSlot(1)
		elseif input.KeyCode == Enum.KeyCode.Two then
			equipSlot(2)
		elseif input.KeyCode == Enum.KeyCode.Three then
			equipSlot(3)
		elseif input.KeyCode == Enum.KeyCode.ButtonY then
			cycleSlot(1)
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.ButtonY)

	-- Cambiar de arma: tecla Q (siguiente) y botón táctil en móvil (no hay barra de inventario)
	ContextActionService:BindAction("Inspect", function(_, state)
		if state == Enum.UserInputState.Begin and not ClientState.IsBlocked() and not ClientState.VotePanelVisible and def and not reloadStart and not ClientState.Aiming then
			if os.clock() - inspectTime > INSPECT_TIME then
				inspectTime = os.clock()
			end
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.V, Enum.KeyCode.DPadUp)

	TouchLayout.BindAction("SwapWeapon", function(_, state)
		if state == Enum.UserInputState.Begin and not ClientState.IsBlocked() then
			cycleSlot(1)
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.Q)
	TouchLayout.SetTitle("SwapWeapon", "⇄")
	TouchLayout.Set("SwapWeapon", UDim2.new(1, -280, 1, -100))

	UserInputService.InputChanged:Connect(function(input, processed)
		if processed or ClientState.IsBlocked() then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			cycleSlot(input.Position.Z > 0 and -1 or 1)
		end
	end)
end

---------------------------------------------------------------------------
-- Personaje
---------------------------------------------------------------------------

local characterConnections = {}

local function onCharacter(newCharacter)
	-- Las conexiones del personaje anterior se cortan (si no, el personaje viejo queda en memoria)
	for _, connection in characterConnections do
		connection:Disconnect()
	end
	table.clear(characterConnections)
	onUnequipped()
	character = newCharacter
	humanoid = newCharacter:WaitForChild("Humanoid")
	rootPart = newCharacter:WaitForChild("HumanoidRootPart")
	aimHeld = false
	camKick, camYaw = 0, 0
	debtPitch, debtYaw = 0, 0
	recoilKick, recoilRot, recoilSide = 0, 0, 0
	kickVel, rotVel, sideVel = 0, 0, 0
	sprayCount = 0
	updateRayFilter()

	table.insert(characterConnections, newCharacter.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and child:GetAttribute("Weapon") then
			onEquipped(child)
		end
	end))
	table.insert(characterConnections, newCharacter.ChildRemoved:Connect(function(child)
		if child == equippedTool then
			onUnequipped()
		end
	end))
	local existing = newCharacter:FindFirstChildOfClass("Tool")
	if existing and existing:GetAttribute("Weapon") then
		onEquipped(existing)
	end

	table.insert(characterConnections, humanoid.Died:Connect(function()
		onUnequipped()
		triggerHeld = false
		-- (lo pendiente de retroceso y temblores no se aplica a la cámara de la muerte)
		camKick, camYaw = 0, 0
		debtPitch, debtYaw = 0, 0
		ClientState.Shake = 0
		ClientState.LandKick = 0
		ScopeSway.Reset()
	end))
end

-- Efectos de los disparos de otros jugadores (y bots). Para no dar tirones en móviles: de lejos o
-- con calidad Baja solo la trazadora, y como mucho un sonido por arma cada 0,1 s.
local FAR_SHOT = 120
local lastRemoteSound = setmetatable({}, { __mode = "k" }) -- [tool] = os.clock()
local lastWhiz = 0

local function isTeammateTool(tool)
	local owner = tool.Parent and Players:GetPlayerFromCharacter(tool.Parent)
	if owner == player then
		return true
	end
	-- (los bots guardan el nombre de su equipo en el atributo "Team" del modelo)
	local team = tool.Parent and tool.Parent:GetAttribute("Team")
	if owner then
		team = owner.Team and owner.Team.Name
	end
	return team ~= nil and team ~= "" and player.Team ~= nil and team == player.Team.Name
end

local function onShotFX(tool, endpoints)
	if typeof(tool) ~= "Instance" or not tool.Parent or type(endpoints) ~= "table" then
		return
	end
	local handle = tool:FindFirstChild("Handle")
	local muzzle = handle and handle:FindFirstChild("Muzzle")
	if not muzzle then
		return
	end
	local color = WeaponModels.GetPalette(tool:GetAttribute("Weapon"), tool:GetAttribute("Skin")).Accent
	local weaponDef = Weapons.Get(tool:GetAttribute("Weapon"))
	local cheap = ClientState.EffectiveQuality == "Baja" or (muzzle.WorldPosition - camera.CFrame.Position).Magnitude > FAR_SHOT
	for index, position in endpoints do
		if typeof(position) == "Vector3" and index <= 3 then
			if weaponDef and weaponDef.Explosive then
				Effects.Rocket(muzzle.WorldPosition, position, weaponDef.ProjectileSpeed or 200, color, weaponDef.Explosive.Radius, weaponDef.ProjectileStyle)
			else
				Effects.Tracer(muzzle.WorldPosition, position, color)
				-- Paintball: también se ven las manchas de los disparos de los demás (si no es caro)
				if weaponDef and weaponDef.ImpactStyle and not cheap then
					local direction = position - muzzle.WorldPosition
					if direction.Magnitude > 1 then
						local hit = workspace:Raycast(position - direction.Unit * 1.5, direction.Unit * 3, rayParams)
						if hit then
							Effects.Impact(hit.Position, hit.Normal, hit.Instance, hit.Material, weaponDef.ImpactStyle)
						end
					end
				end
			end
		end
	end
	if not cheap then
		Effects.MuzzleFlash(muzzle, nil, true)
	end
	local now = os.clock()
	if now - (lastRemoteSound[tool] or 0) >= 0.1 then
		lastRemoteSound[tool] = now
		Sounds.PlayShot(tool:GetAttribute("Weapon"), weaponDef, handle, camera.CFrame.Position)
	end
	-- Bala que te pasa rozando: "fiuu" (solo si no te ha dado de lleno y no es de tu equipo)
	if weaponDef and not weaponDef.Explosive and now - lastWhiz > 0.15 and not isTeammateTool(tool) then
		local listener = camera.CFrame.Position
		local from = muzzle.WorldPosition
		for _, position in endpoints do
			if typeof(position) == "Vector3" then
				local segment = position - from
				local length = segment.Magnitude
				if length > 1 then
					local along = math.clamp((listener - from):Dot(segment / length), 0, length)
					local closest = from + segment / length * along
					local gap = (listener - closest).Magnitude
					-- (lejos del final: si acaba justo en ti, es que te ha dado)
					if gap < 7 and gap > 1.5 and length - along > 4 then
						lastWhiz = now
						local sound = Sounds.Play("Whiz", nil, 0.9 + math.random() * 0.25, 1.2 - gap / 7)
						if sound then
							sound.TimePosition = 0.05
						end
						-- (supresión: un instante de desenfoque, más cuanto más cerca pasa)
						CombatFX.Suppress(1 - gap / 7)
						break
					end
				end
			end
		end
	end
end

function WeaponController.Init()
	UserInputService.MouseIconEnabled = false
	-- (teléfono o no: se mira cuando se sabe el tamaño de pantalla y al girarla)
	task.spawn(function()
		UI.WaitViewport()
		phoneScreen = UI.IsPhone()
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			phoneScreen = UI.IsPhone()
		end)
	end)
	bindActions()
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	Remotes.ShotFX.OnClientEvent:Connect(onShotFX)
	RunService:BindToRenderStep("WeaponViewmodel", Enum.RenderPriority.Camera.Value + 1, renderStep)
end

return WeaponController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="134">
            <Properties>
              <string name="Name">WeaponIcon</string>
              <string name="Source"><![CDATA[-- Iconos 3D de armas: dibuja el modelo real (con su skin) dentro de un ViewportFrame.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local WeaponModels = require(Shared.WeaponModels)

local WeaponIcon = {}

local FOV = 20

-- view: "side" (de perfil, cañón a la derecha) o "angled" (tres cuartos)
-- aspect: ancho / alto del ViewportFrame
function WeaponIcon.Create(weaponName, skinId, props, view, aspect)
	local viewport = Instance.new("ViewportFrame")
	viewport.BackgroundTransparency = 1
	viewport.Ambient = Color3.fromRGB(170, 170, 185)
	viewport.LightColor = Color3.fromRGB(255, 255, 255)
	viewport.LightDirection = Vector3.new(-1, -1.5, -0.6)
	for key, value in props or {} do
		viewport[key] = value
	end

	local model = WeaponModels.Build(weaponName, skinId, false)
	model.Parent = viewport

	local camera = Instance.new("Camera")
	camera.FieldOfView = FOV
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	local boxCFrame, size = model:GetBoundingBox()
	local center = boxCFrame.Position
	aspect = aspect or 2.5
	local tanHalf = math.tan(math.rad(FOV / 2))

	local direction
	if view == "angled" then
		direction = Vector3.new(1, 0.35, 0.45).Unit
	else
		direction = Vector3.new(1, 0.05, 0).Unit
	end
	-- Distancia para que quepa: el largo del arma (Z) en horizontal y el alto (Y) en vertical
	local fitVertical = (size.Y / 2) / tanHalf
	local fitHorizontal = (size.Z / 2) / (tanHalf * aspect)
	local margin = view == "angled" and 1.35 or 1.12
	local distance = math.max(fitVertical, fitHorizontal) * margin + size.X / 2
	camera.CFrame = CFrame.lookAt(center + direction * distance, center)
	return viewport
end

return WeaponIcon
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="135">
            <Properties>
              <string name="Name">Wheel</string>
              <string name="Source"><![CDATA[-- Ruleta diaria (Shop.Wheel): un giro gratis al día y giros extra con Robux. La ruleta gira y se para
-- en el premio que decide el servidor. Las probabilidades se ven debajo de la ruleta.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local MarketplaceService = game:GetService("MarketplaceService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Shop = require(Shared.Shop)
local Sounds = require(Shared.Sounds)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local RewardFX = require(script.Parent.RewardFX)

local player = Players.LocalPlayer

local Wheel = {}

local SIZE = 340
local gui, panel, rotor, spinButton, buyButton, status, closeButton
local spinning = false
local currentRotation = 0

local function prizes()
	return Shop.Wheel.Prizes
end

-- Texto del botón según los giros disponibles
local function refresh()
	if not gui then
		return
	end
	local data = ClientState.Data
	local free = data and data.WheelFree == true
	local bought = data and data.WheelSpins or 0
	if spinning then
		spinButton.Text = "..."
	elseif free then
		spinButton.Text = "🎁 ¡GIRO GRATIS!"
	elseif bought > 0 then
		spinButton.Text = "🎡 GIRAR (" .. bought .. ")"
	else
		spinButton.Text = "Vuelve mañana"
	end
	spinButton.BackgroundColor3 = (free or bought > 0) and Color3.fromRGB(60, 200, 90) or Color3.fromRGB(70, 70, 82)
	local canBuy = Shop.Wheel.SpinProductId ~= 0 and not (data and data.CratesRestricted)
	buyButton.Visible = canBuy
end

local function build()
	gui = UI.new("ScreenGui", {
		Name = "Wheel",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 20,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local shade = UI.new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Text = "",
		AutoButtonColor = false,
		Modal = true,
		Parent = gui,
	})
	_ = shade
	panel = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(440, 600),
		BackgroundColor3 = Color3.fromRGB(22, 24, 38),
		Parent = gui,
	}, { UI.corner(18), UI.stroke(Color3.fromRGB(255, 200, 60), 3, 0) })
	local scale = UI.new("UIScale", { Parent = panel })
	local function fit()
		local viewport = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.clamp(math.min((viewport.X - 20) / 440, (viewport.Y - 20) / 600), 0.45, 1)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	fit()
	UI.label({ Position = UDim2.fromOffset(0, 12), Size = UDim2.new(1, 0, 0, 36), Text = "🎡 RULETA DIARIA", TextSize = 30, TextColor3 = Color3.fromRGB(255, 210, 60), Parent = panel })
	closeButton = UI.button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.fromOffset(36, 36), Text = "✕", TextSize = 22, BackgroundColor3 = Color3.fromRGB(200, 60, 70), Parent = panel })
	closeButton.Activated:Connect(function()
		if not spinning then
			Wheel.Close()
		end
	end)

	-- Ruleta: un círculo (CanvasGroup redondo que recorta) con una porción por premio
	local wheelFrame = UI.new("CanvasGroup", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 66),
		Size = UDim2.fromOffset(SIZE, SIZE),
		BackgroundColor3 = Color3.fromRGB(40, 44, 70),
		Parent = panel,
	}, { UI.corner(SIZE / 2) })
	rotor = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = wheelFrame })
	local list = prizes()
	local step = 360 / #list
	-- Cada porción es un abanico de barras finas que salen del centro (parece una cuña)
	local BARS = 10
	local radius = SIZE / 2 + 2
	for i, prize in list do
		local angle = (i - 1) * step
		for k = 1, BARS do
			local sub = angle - step / 2 + (k - 0.5) * step / BARS
			local rad = math.rad(sub)
			UI.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, math.sin(rad) * radius / 2, 0.5, -math.cos(rad) * radius / 2),
				Size = UDim2.fromOffset(math.ceil(2 * radius * math.sin(math.rad(step / BARS / 2))) + 2, radius),
				Rotation = sub,
				BackgroundColor3 = prize.Color,
				BorderSizePixel = 0,
				Parent = rotor,
			})
		end
		-- Separador blanco entre porciones
		local edge = math.rad(angle - step / 2)
		UI.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.sin(edge) * radius / 2, 0.5, -math.cos(edge) * radius / 2),
			Size = UDim2.fromOffset(3, radius),
			Rotation = angle - step / 2,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = rotor,
		})
		-- Premio escrito a lo largo del radio
		local rad = math.rad(angle)
		UI.label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.sin(rad) * radius * 0.62, 0.5, -math.cos(rad) * radius * 0.62),
			Size = UDim2.fromOffset(84, 26),
			Rotation = angle, -- (el ganador queda arriba y se lee derecho)
			Text = Shop.WheelPrizeText(prize),
			TextSize = 20,
			TextScaled = true,
			TextColor3 = Color3.new(1, 1, 1),
			ZIndex = 4,
			Parent = rotor,
		})
	end
	-- Centro y puntero
	UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(56, 56),
		BackgroundColor3 = Color3.fromRGB(255, 210, 60),
		ZIndex = 6,
		Parent = wheelFrame,
	}, { UI.corner(28), UI.stroke(Color3.new(1, 1, 1), 3, 0) })
	UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 44),
		Size = UDim2.fromOffset(40, 40),
		Text = "▼",
		TextSize = 40,
		TextColor3 = Color3.fromRGB(255, 70, 90),
		ZIndex = 8,
		Parent = panel,
	})

	-- Probabilidades
	local total = 0
	for _, prize in list do
		total += prize.Weight
	end
	local odds = {}
	for _, prize in list do
		table.insert(odds, Shop.WheelPrizeText(prize) .. " " .. string.format("%g", math.floor(prize.Weight / total * 1000 + 0.5) / 10) .. "%")
	end
	UI.label({
		Position = UDim2.fromOffset(16, 416),
		Size = UDim2.new(1, -32, 0, 40),
		Text = "Probabilidades: " .. table.concat(odds, " · "),
		TextSize = 13,
		TextWrapped = true,
		TextColor3 = Color3.fromRGB(180, 185, 210),
		Font = UI.FontBody,
		TextStrokeTransparency = 1,
		Parent = panel,
	})
	status = UI.label({ Position = UDim2.fromOffset(0, 460), Size = UDim2.new(1, 0, 0, 30), Text = "", TextSize = 22, TextColor3 = Color3.fromRGB(255, 220, 90), Parent = panel })

	spinButton = UI.button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 496),
		Size = UDim2.fromOffset(260, 46),
		Text = "",
		TextSize = 24,
		Parent = panel,
	}, { UI.gloss() })
	buyButton = UI.button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 548),
		Size = UDim2.fromOffset(260, 36),
		Text = "+" .. Shop.Wheel.SpinsPerPurchase .. " giros · " .. Shop.Wheel.SpinRobux .. " R$",
		TextSize = 18,
		BackgroundColor3 = Color3.fromRGB(40, 170, 90),
		Parent = panel,
	}, { UI.gloss() })
	buyButton.Activated:Connect(function()
		Sounds.Play("Click")
		pcall(MarketplaceService.PromptProductPurchase, MarketplaceService, player, Shop.Wheel.SpinProductId)
	end)
	spinButton.Activated:Connect(Wheel.Spin)
	ClientState.DataChanged.Event:Connect(refresh)
end

function Wheel.Spin()
	if spinning then
		return
	end
	local data = ClientState.Data
	if not data or not (data.WheelFree or (data.WheelSpins or 0) > 0) then
		status.Text = "Vuelve mañana para otro giro gratis"
		return
	end
	spinning = true
	status.Text = ""
	refresh()
	Sounds.Play("Click")
	local ok, success, index = pcall(function()
		return Remotes.SpinWheel:InvokeServer()
	end)
	if not (ok and success and type(index) == "number") then
		spinning = false
		status.Text = (ok and type(index) == "string") and index or "No se pudo girar"
		refresh()
		return
	end
	-- Para con el premio arriba (bajo el puntero), tras unas vueltas
	local step = 360 / #prizes()
	local target = -((index - 1) * step) + (math.random() - 0.5) * step * 0.6
	local base = currentRotation - currentRotation % 360
	local final = base + 360 * 5 + target
	currentRotation = final
	local tween = TweenService:Create(rotor, TweenInfo.new(4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Rotation = final })
	tween:Play()
	-- Clic de la ruleta al pasar las porciones
	task.spawn(function()
		local last = math.floor(rotor.Rotation / step)
		while tween.PlaybackState == Enum.PlaybackState.Playing do
			local now = math.floor(rotor.Rotation / step)
			if now ~= last then
				last = now
				Sounds.Play("Click", nil, 1.4, 0.6)
			end
			task.wait()
		end
	end)
	tween.Completed:Wait()
	local prize = prizes()[index]
	Sounds.Play(prize.Jackpot and "Flag" or "Kill")
	status.Text = (prize.Jackpot and "💥 ¡PREMIO GORDO! " or "¡Has ganado ") .. Shop.WheelPrizeText(prize) .. (prize.Jackpot and "" or "!")
	-- Los premios difíciles (caja, 600 monedas, el gordo) se celebran a lo grande
	if prize.Jackpot or (prize.Weight or 100) <= 8 then
		RewardFX.Celebrate(prize.Jackpot and "💥 ¡PREMIO GORDO!" or "🎉 ¡GRAN PREMIO!", Shop.WheelPrizeText(prize), prize.Color, prize.Jackpot == true)
	else
		RewardFX.EdgeFlash(prize.Color, 0.4)
	end
	spinning = false
	refresh()
end

function Wheel.Open()
	if not gui then
		build()
	end
	gui.Enabled = true
	ClientState.WheelOpen = true
	ClientState.UpdateMouse()
	status.Text = ""
	refresh()
end

function Wheel.Close()
	if gui then
		gui.Enabled = false
	end
	ClientState.WheelOpen = false
	ClientState.UpdateMouse()
end

function Wheel.Init()
	-- (se construye la primera vez que se abre)
end

return Wheel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="136">
            <Properties>
              <string name="Name">WorldFX</string>
              <string name="Source"><![CDATA[-- Efectos del mundo en el cliente:
--  * Piezas del mapa con atributo Spin (grados/seg) giran y con Bob (studs) flotan
--  * Con Orbit (grados/seg) giran alrededor de OrbitCenter sobre el eje OrbitAxis (la noria);
--    con OrbitUpright solo se mueven sin girar (las cabinas siguen derechas), colgando de OrbitAnchor
--  * Contorno de color en los compañeros de equipo (visible a través de paredes)
--  * Oculta el nombre de los enemigos
--  * Explosión de partículas cuando alguien es eliminado
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Teams = game:GetService("Teams")

local Effects = require(script.Parent.Effects)
local ClientState = require(script.Parent.ClientState)
local Remotes = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Remotes"))

local player = Players.LocalPlayer

local WorldFX = {}

local animated = {} -- [part] = { Base = CFrame, Spin = number, Bob = number, Phase = number }

local function track(inst)
	-- (los efectos sueltos de ClientFX nunca se animan aquí: se descartan lo antes posible)
	if not inst:IsA("BasePart") or (inst.Parent and inst.Parent.Name == "ClientFX") then
		return
	end
	local spin = inst:GetAttribute("Spin")
	local bob = inst:GetAttribute("Bob")
	local blink = inst:GetAttribute("Blink")
	local sweep = inst:GetAttribute("Sweep")
	local orbit = inst:GetAttribute("Orbit")
	if spin or bob or blink or sweep or orbit then
		local center, axis = inst:GetAttribute("OrbitCenter"), inst:GetAttribute("OrbitAxis")
		animated[inst] = {
			Base = inst.CFrame,
			Spin = spin or 0,
			Bob = bob or 0,
			Blink = blink,
			Sweep = sweep,
			Orbit = (orbit and typeof(center) == "Vector3" and typeof(axis) == "Vector3" and axis.Magnitude > 0) and orbit or nil,
			OrbitCenter = center,
			OrbitAxis = typeof(axis) == "Vector3" and axis.Magnitude > 0 and axis.Unit or nil,
			OrbitUpright = inst:GetAttribute("OrbitUpright") == true,
			OrbitAnchor = typeof(inst:GetAttribute("OrbitAnchor")) == "Vector3" and inst:GetAttribute("OrbitAnchor") or nil,
			BaseTransparency = inst.Transparency,
			Phase = math.random() * 10,
		}
	end
end

local frame = 0
local function animate()
	local t = os.clock()
	-- Lo que gira despacio (la noria) se mueve 1 de cada 2 fotogramas (1 de cada 4 en calidad Baja)
	frame += 1
	local orbitNow = frame % (ClientState.EffectiveQuality == "Baja" and 4 or 2) == 0
	for part, info in animated do
		if not part.Parent then
			animated[part] = nil
			continue
		end
		if info.Blink then
			-- Baliza que parpadea
			local on = math.sin((t + info.Phase) * math.pi * 2 / info.Blink) > 0
			part.Transparency = on and info.BaseTransparency or 0.95
		end
		if info.Orbit then
			if not orbitNow then
				continue
			end
			local turn = CFrame.fromAxisAngle(info.OrbitAxis, math.rad(info.Orbit * t))
			-- (con ancla, la pieza sigue a su punto de enganche sin girar su propio desplazamiento)
			local anchor = info.OrbitAnchor or info.Base.Position
			local position = info.OrbitCenter + turn * (anchor - info.OrbitCenter) + (info.Base.Position - anchor)
			local rotation = info.Base - info.Base.Position
			part.CFrame = CFrame.new(position) * (info.OrbitUpright and rotation or (turn * rotation))
		elseif info.Sweep then
			-- Haz de luz que barre a un lado y a otro desde su base
			local pivot = (info.Base * CFrame.new(0, -part.Size.Y / 2, 0)).Position
			local angle = math.rad(info.Sweep) * math.sin(t * 0.4 + info.Phase)
			part.CFrame = CFrame.new(pivot) * CFrame.Angles(0, angle, 0) * (CFrame.new(pivot):Inverse() * info.Base)
		elseif info.Spin ~= 0 or info.Bob ~= 0 then
			local position = info.Base.Position + Vector3.new(0, math.sin(t * 1.5 + info.Phase) * info.Bob, 0)
			local rotation = info.Base - info.Base.Position
			-- Giro alrededor del eje Y del mundo que pasa por la pieza
			part.CFrame = CFrame.new(position) * CFrame.Angles(0, math.rad(info.Spin * t), 0) * rotation
		end
	end
end

---------------------------------------------------------------------------
-- Jugadores
---------------------------------------------------------------------------

local function teamColorOf(other)
	return other and other.Team and other.TeamColor.Color or Color3.fromRGB(255, 200, 60)
end

-- Compañeros: contorno del color del equipo y nombre visible. Enemigos: sin nombre.
local function applyStyle(character, isTeammate, isSelf, color)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local highlight = character:FindFirstChild("TeamHighlight")
	if isTeammate and not isSelf then
		if not highlight then
			highlight = Instance.new("Highlight")
			highlight.Name = "TeamHighlight"
			highlight.FillTransparency = 1
			highlight.OutlineTransparency = 0.2
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.Parent = character
		end
		highlight.OutlineColor = color
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	else
		if highlight then
			highlight:Destroy()
		end
		if not isSelf then
			-- Sin nombre sobre los enemigos: hay que encontrarlos
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
	end
end

local function styleCharacter(other, character)
	applyStyle(character, player.Team ~= nil and other.Team == player.Team, other == player, teamColorOf(other))
end

-- Bots (carpeta workspace.Bots): el servidor les pone el atributo Team
local function styleBot(model)
	local teamName = model:GetAttribute("Team")
	local team = teamName and teamName ~= "" and Teams:FindFirstChild(teamName)
	local isTeammate = player.Team ~= nil and team == player.Team
	applyStyle(model, isTeammate, false, team and team:IsA("Team") and team.TeamColor.Color or Color3.fromRGB(255, 200, 60))
end

local function onCharacter(other, character)
	character:WaitForChild("Humanoid", 10)
	styleCharacter(other, character)
end

local function onPlayer(other)
	other.CharacterAdded:Connect(function(character)
		onCharacter(other, character)
	end)
	if other.Character then
		task.spawn(onCharacter, other, other.Character)
	end
	other:GetPropertyChangedSignal("Team"):Connect(function()
		if other.Character then
			styleCharacter(other, other.Character)
		end
	end)
end

local function restyleAll()
	for _, other in Players:GetPlayers() do
		if other.Character then
			styleCharacter(other, other.Character)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			styleBot(model)
		end
	end
end

function WorldFX.Init()
	-- Animaciones del mapa
	for _, inst in workspace:GetDescendants() do
		track(inst)
	end
	workspace.DescendantAdded:Connect(track)
	RunService.RenderStepped:Connect(animate)

	-- Jugadores
	for _, other in Players:GetPlayers() do
		onPlayer(other)
	end
	Players.PlayerAdded:Connect(onPlayer)
	player:GetPropertyChangedSignal("Team"):Connect(restyleAll)
	task.spawn(function()
		local bots = workspace:WaitForChild("Bots", 30)
		if not bots then
			return
		end
		bots.ChildAdded:Connect(function(model)
			model:WaitForChild("Humanoid", 10)
			styleBot(model)
		end)
		for _, model in bots:GetChildren() do
			task.spawn(styleBot, model)
		end
	end)

	-- Efecto de eliminación (lo decide el servidor: el que tenga equipado quien hizo la baja)
	Remotes.KillFX.OnClientEvent:Connect(function(position, effectId, color)
		if typeof(position) == "Vector3" and type(effectId) == "string" then
			Effects.KillEffect(effectId, position, typeof(color) == "Color3" and color or nil)
		end
	end)
end

return WorldFX
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
