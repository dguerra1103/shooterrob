			TextWrapped = true,
			TextColor3 = Color3.fromRGB(190, 195, 220),
			Font = UI.FontBody,
			TextStrokeTransparency = 1,
			Parent = card,
		})
		local preview = UI.button({
			Position = UDim2.fromOffset(10, 150),
			Size = UDim2.new(1, -20, 0, 26),
			Text = "👁 Ver efecto",
			TextSize = 15,
			BackgroundColor3 = Color3.fromRGB(70, 60, 120),
			Parent = card,
