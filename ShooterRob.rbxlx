      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">GameConfig</string>
          <string name="Source"><![CDATA[-- Configuración general del juego. Cambia aquí los valores para ajustar el balance.
local GameConfig = {}

-- Nombre que aparece en la pantalla de inicio y en los carteles del mapa
GameConfig.GameTitle = "SHOOTER NEW"

-- Equipos
GameConfig.Teams = {
	{ Name = "Rojo", Color = BrickColor.new("Really red") },
	{ Name = "Azul", Color = BrickColor.new("Really blue") },
}

-- Rondas
GameConfig.MinPlayers = 1 -- súbelo a 2+ cuando publiques el juego
GameConfig.IntermissionTime = 15

-- Modos de juego. Se juegan en este orden, uno por ronda.
-- Pon solo { "CTF" } o solo { "TDM" } si quieres un único modo.
GameConfig.Modes = { "CTF", "TDM" }
GameConfig.ModeSettings = {
	TDM = { Name = "Duelo por equipos", ScoreToWin = 40, RoundTime = 8 * 60 }, -- puntos = bajas
	CTF = { Name = "Captura la bandera", ScoreToWin = 3, RoundTime = 10 * 60 }, -- puntos = capturas
}

-- Captura la bandera
GameConfig.Flag = {
	PickupRadius = 5, -- distancia para coger/devolver la bandera
	CaptureRadius = 7, -- distancia a tu base para capturar
	AutoReturnTime = 20, -- segundos que tarda en volver sola si nadie la toca
	CarrierSpeedMultiplier = 0.9, -- el portador va un poco más lento
}
GameConfig.EndScreenTime = 8
GameConfig.RespawnTime = 3
GameConfig.SpawnProtection = 2 -- segundos de escudo al reaparecer
GameConfig.TrainingDummies = true -- muñecos de práctica en el mapa (ponlo en false al publicar)

-- Movimiento
GameConfig.WalkSpeed = 18
GameConfig.SprintSpeed = 26
GameConfig.AimWalkSpeed = 11
GameConfig.SlideSpeed = 58
GameConfig.SlideDuration = 0.75
GameConfig.SlideCooldown = 1.1
GameConfig.FieldOfView = 80

-- Progresión (pase de batalla)
GameConfig.XPPerLevel = 1000
GameConfig.XP = {
	Kill = 100,
	Headshot = 25,
	StreakBonus = 20, -- extra por cada baja de racha
	Win = 500,
	Loss = 150,
	Capture = 300, -- capturar la bandera
	FlagReturn = 75, -- devolver tu bandera caída
	CarrierKill = 75, -- eliminar al portador de tu bandera
}
GameConfig.Coins = {
	Kill = 5,
	Win = 50,
	Capture = 20,
}

-- ID del GamePass del pase premium. Créalo en el Creator Hub y pon el número aquí.
-- Con 0 el botón de compra queda desactivado.
GameConfig.PremiumPassId = 0

-- Recompensas por nivel. Free = pase gratis, Premium = pase de pago.
-- Tipos: { Type = "Skin", Id = "<id de Skins>" } o { Type = "Coins", Amount = n }
GameConfig.BattlePass = {
	{ Free = { Type = "Coins", Amount = 50 }, Premium = { Type = "Skin", Id = "Sakura" } },
	{ Free = { Type = "Skin", Id = "Toxico" }, Premium = { Type = "Coins", Amount = 150 } },
	{ Free = { Type = "Coins", Amount = 75 }, Premium = { Type = "Skin", Id = "Hielo" } },
	{ Free = nil, Premium = { Type = "Coins", Amount = 200 } },
	{ Free = { Type = "Skin", Id = "Selva" }, Premium = { Type = "Skin", Id = "Calabaza" } },
	{ Free = { Type = "Coins", Amount = 100 }, Premium = { Type = "Coins", Amount = 250 } },
	{ Free = nil, Premium = { Type = "Skin", Id = "Vacio" } },
	{ Free = { Type = "Coins", Amount = 125 }, Premium = { Type = "Coins", Amount = 300 } },
	{ Free = { Type = "Skin", Id = "Oceano" }, Premium = { Type = "Skin", Id = "Dorado" } },
	{ Free = { Type = "Coins", Amount = 150 }, Premium = { Type = "Coins", Amount = 400 } },
	{ Free = nil, Premium = { Type = "Skin", Id = "Galaxia" } },
	{ Free = { Type = "Coins", Amount = 200 }, Premium = { Type = "Coins", Amount = 500 } },
	{ Free = { Type = "Skin", Id = "Atardecer" }, Premium = { Type = "Skin", Id = "Dragon" } },
	{ Free = { Type = "Coins", Amount = 250 }, Premium = { Type = "Coins", Amount = 750 } },
	{ Free = { Type = "Coins", Amount = 500 }, Premium = { Type = "Skin", Id = "Magma" } },
}

return GameConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Outfits</string>
          <string name="Source"><![CDATA[-- Trajes de operador: armadura hecha con piezas que se sueldan al personaje R15.
-- Las piezas se escalan con el tamaño de cada parte del cuerpo, así funcionan con cualquier avatar.
local Outfits = {}

local RGB = Color3.fromRGB

Outfits.List = {
	Default = {
		Name = "Tu avatar",
		Rarity = "Común",
		Class = "Sin traje",
	},
	BlazeRunner = {
		Name = "Blaze Runner",
		Rarity = "Legendario",
		Class = "Clase asalto",
		Body = RGB(28, 26, 28),
		Cloth = RGB(200, 30, 30),
		Glow = RGB(255, 120, 20),
		Plate = RGB(70, 70, 76),
		Pieces = { Vest = true, Pouches = true, Backpack = true, Shoulders = true, Belt = true, Knees = true, Boots = true, Gloves = true, Headset = true, Mask = true, Scarf = true },
	},
	NeonRecon = {
		Name = "Neon Recon",
		Rarity = "Legendario",
		Class = "Clase francotirador",
		Body = RGB(22, 22, 28),
		Cloth = RGB(20, 20, 26),
		Glow = RGB(0, 200, 255),
		Plate = RGB(235, 238, 245),
		Pieces = { Vest = true, Pouches = true, Backpack = true, Belt = true, Knees = true, Boots = true, Gloves = true, Headset = true, Visor = true, Scarf = true },
	},
	VoltBruiser = {
		Name = "Volt Bruiser",
		Rarity = "Mítico",
		Class = "Clase pesada",
		Body = RGB(30, 30, 32),
		Cloth = RGB(40, 40, 44),
		Glow = RGB(255, 200, 30),
		Plate = RGB(225, 225, 230),
		Heavy = true,
		Pieces = { Vest = true, Pouches = true, Backpack = true, Shoulders = true, Belt = true, Knees = true, Boots = true, Gloves = true, Headset = true, Gauntlets = true },
	},
	FrostByte = {
		Name = "Frost Byte",
		Rarity = "Épico",
		Class = "Clase reconocimiento",
		Body = RGB(220, 235, 250),
		Cloth = RGB(150, 200, 240),
		Glow = RGB(120, 230, 255),
		Plate = RGB(255, 255, 255),
		Pieces = { Vest = true, Belt = true, Knees = true, Boots = true, Gloves = true, Visor = true, Scarf = true },
	},
	ToxicRogue = {
		Name = "Toxic Rogue",
		Rarity = "Épico",
		Class = "Clase infiltración",
		Body = RGB(30, 40, 30),
		Cloth = RGB(60, 90, 40),
		Glow = RGB(130, 255, 60),
		Plate = RGB(50, 60, 50),
		Pieces = { Vest = true, Pouches = true, Belt = true, Boots = true, Gloves = true, Mask = true, Headset = true },
	},
	GoldenAce = {
		Name = "Golden Ace",
		Rarity = "Mítico",
		Class = "Edición de lujo",
		Body = RGB(25, 22, 18),
		Cloth = RGB(30, 26, 22),
		Glow = RGB(255, 220, 120),
		Plate = RGB(240, 180, 50),
		PlateMaterial = Enum.Material.Foil,
		Pieces = { Vest = true, Pouches = true, Backpack = true, Shoulders = true, Belt = true, Knees = true, Boots = true, Gloves = true, Visor = true, Gauntlets = true },
	},
}

function Outfits.Get(id)
	return Outfits.List[id] or Outfits.List.Default
end

-- Colores de los brazos en primera persona (manga, guante y puño)
function Outfits.ArmColors(id)
	local o = Outfits.List[id]
	if not o or not o.Body then
		return nil
	end
	return { Sleeve = o.Cloth, Glove = o.Body, Cuff = o.Glow, Plate = o.Plate }
end

---------------------------------------------------------------------------
-- Construcción sobre el personaje
---------------------------------------------------------------------------

local function newPiece(folder, bodyPart, name, offsetScale, offsetAdd, sizeScale, sizeAdd, color, material, rotation)
	local s = bodyPart.Size
	local part = Instance.new("Part")
	part.Name = name
	part.Size = Vector3.new(s.X * sizeScale.X + sizeAdd.X, s.Y * sizeScale.Y + sizeAdd.Y, s.Z * sizeScale.Z + sizeAdd.Z)
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	local offset = Vector3.new(s.X * offsetScale.X + offsetAdd.X, s.Y * offsetScale.Y + offsetAdd.Y, s.Z * offsetScale.Z + offsetAdd.Z)
	part.CFrame = bodyPart.CFrame * CFrame.new(offset) * (rotation or CFrame.new())
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = bodyPart
	weld.Part1 = part
	weld.Parent = part
	part.Parent = folder
	return part
end

local V = Vector3.new
local Z = Vector3.zero

-- Quita el traje actual del personaje
function Outfits.Remove(character)
	local old = character:FindFirstChild("Outfit")
	if old then
		old:Destroy()
	end
end

-- Pone el traje `id` en el personaje (R15). Devuelve true si se aplicó.
function Outfits.Apply(character, id)
	Outfits.Remove(character)
	local o = Outfits.List[id]
	if not o or not o.Pieces then
		return false
	end
	local function get(name)
		return character:FindFirstChild(name)
	end
	local upper, lower, head = get("UpperTorso"), get("LowerTorso"), get("Head")
	if not upper or not lower or not head then
		return false -- solo R15
	end

	-- La ropa clásica taparía los colores del traje
	for _, child in character:GetChildren() do
		if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") then
			child:Destroy()
		end
	end
	local bodyColors = character:FindFirstChildOfClass("BodyColors")
	if bodyColors then
		bodyColors.TorsoColor3 = o.Cloth
		bodyColors.LeftLegColor3 = o.Body
		bodyColors.RightLegColor3 = o.Body
	end
	for _, name in { "UpperTorso", "LowerTorso" } do
		get(name).Color = o.Cloth
	end
	for _, name in { "LeftUpperLeg", "LeftLowerLeg", "RightUpperLeg", "RightLowerLeg" } do
		local p = get(name)
		if p then
			p.Color = o.Body
		end
	end

	local folder = Instance.new("Folder")
	folder.Name = "Outfit"
	folder:SetAttribute("Id", id)
	folder.Parent = character

	local P = o.Pieces
	local plateMat = o.PlateMaterial or Enum.Material.SmoothPlastic
	local glow = Enum.Material.Neon
	local heavy = o.Heavy and 1.15 or 1

	-- Chaleco (cubre el torso) con placa delantera
	if P.Vest then
		newPiece(folder, upper, "Vest", V(0, -0.02, 0), Z, V(1.06 * heavy, 0.86, 1.18 * heavy), Z, o.Body)
		newPiece(folder, upper, "ChestPlate", V(0, 0.12, -0.6 * heavy), Z, V(0.7, 0.4, 0.12), Z, o.Plate, plateMat)
		newPiece(folder, upper, "ChestGlow", V(0, 0.12, -0.67 * heavy), Z, V(0.4, 0.05, 0.05), Z, o.Glow, glow)
	end
	if P.Pouches then
		for i, x in { -0.3, 0, 0.3 } do
			newPiece(folder, upper, "Pouch" .. i, V(x, -0.25, -0.66 * heavy), Z, V(0.24, 0.32, 0.18), Z, o.Body:Lerp(Color3.new(0, 0, 0), 0.25))
			newPiece(folder, upper, "PouchGlow" .. i, V(x, -0.25, -0.76 * heavy), Z, V(0.04, 0.2, 0.02), Z, o.Glow, glow)
		end
	end
	if P.Backpack then
		newPiece(folder, upper, "Backpack", V(0, -0.05, 0.85 * heavy), Z, V(0.72, 0.78, 0.55), Z, o.Body)
		newPiece(folder, upper, "BackpackPlate", V(0, 0.05, 1.13 * heavy), Z, V(0.42, 0.38, 0.05), Z, o.Plate, plateMat)
		newPiece(folder, upper, "BackpackEmblem", V(0, 0.05, 1.17 * heavy), Z, V(0.14, 0.14, 0.03), Z, o.Glow, glow, CFrame.Angles(0, 0, math.rad(45)))
	end
	-- Cinturón
	if P.Belt then
		newPiece(folder, lower, "Belt", V(0, 0.32, 0), Z, V(1.08, 0.3, 1.12), Z, o.Body:Lerp(Color3.new(0, 0, 0), 0.3))
		newPiece(folder, lower, "Buckle", V(0, 0.32, -0.58), Z, V(0.22, 0.22, 0.06), Z, o.Glow, glow)
	end

	-- Brazos y piernas (izquierda y derecha)
	for _, side in { "Left", "Right" } do
		local upperArm, lowerArm, hand = get(side .. "UpperArm"), get(side .. "LowerArm"), get(side .. "Hand")
		local upperLeg, lowerLeg, foot = get(side .. "UpperLeg"), get(side .. "LowerLeg"), get(side .. "Foot")
		local sx = side == "Left" and -1 or 1
		if P.Shoulders and upperArm then
			newPiece(folder, upperArm, "Shoulder", V(0.05 * sx, 0.3, 0), Z, V(1.35 * heavy, 0.42, 1.3 * heavy), Z, o.Plate, plateMat)
			newPiece(folder, upperArm, "ShoulderGlow", V(0.05 * sx, 0.3, -0.66 * heavy), Z, V(0.8, 0.07, 0.03), Z, o.Glow, glow)
		end
		if P.Gauntlets and lowerArm then
			newPiece(folder, lowerArm, "Gauntlet", V(0, -0.05, 0), Z, V(1.3, 0.7, 1.3), Z, o.Plate, plateMat)
			newPiece(folder, lowerArm, "GauntletGlow", V(0, -0.05, -0.66), Z, V(0.5, 0.08, 0.03), Z, o.Glow, glow)
		end
		if P.Gloves and hand then
			newPiece(folder, hand, "Glove", Z, Z, V(1.15, 1.1, 1.15), Z, o.Body)
		end
		if P.Knees and lowerLeg then
			newPiece(folder, lowerLeg, "KneePad", V(0, 0.32, -0.55), Z, V(0.95, 0.32, 0.3), Z, o.Plate, plateMat)
			newPiece(folder, lowerLeg, "KneeGlow", V(0, 0.32, -0.72), Z, V(0.3, 0.1, 0.02), Z, o.Glow, glow)
		end
		if P.Boots and foot then
			newPiece(folder, foot, "Boot", V(0, 0.08, 0), Z, V(1.14, 1.15, 1.12), Z, o.Body)
			newPiece(folder, foot, "Sole", V(0, -0.42, 0), Z, V(1.17, 0.32, 1.15), Z, Color3.fromRGB(245, 245, 248))
			newPiece(folder, foot, "BootGlow", V(0, -0.2, 0), Z, V(1.18, 0.1, 1.16), Z, o.Glow, glow)
		end
		_ = upperLeg
	end

	-- Cabeza
	if P.Headset then
		for _, sx in { -1, 1 } do
			newPiece(folder, head, "EarCup", V(0.55 * sx, 0, 0), Z, V(0.18, 0.45, 0.45), Z, o.Body)
			newPiece(folder, head, "EarGlow", V(0.65 * sx, 0, 0), Z, V(0.03, 0.25, 0.25), Z, o.Glow, glow)
		end
		newPiece(folder, head, "Headband", V(0, 0.55, 0), Z, V(1.15, 0.1, 0.18), Z, o.Body)
		newPiece(folder, head, "Mic", V(-0.42, -0.25, -0.35), Z, V(0.06, 0.06, 0.45), Z, o.Body, nil, CFrame.Angles(0, math.rad(-30), 0))
	end
	if P.Visor then
		local visor = newPiece(folder, head, "Visor", V(0, 0.1, -0.52), Z, V(0.98, 0.24, 0.08), Z, o.Glow, glow)
		visor.Transparency = 0.15
		newPiece(folder, head, "VisorFrame", V(0, 0.1, -0.5), Z, V(1.04, 0.3, 0.06), Z, o.Body)
	end
	if P.Mask then
		newPiece(folder, head, "Mask", V(0, -0.22, -0.5), Z, V(0.92, 0.36, 0.1), Z, o.Body)
		for i, x in { -0.18, 0, 0.18 } do
			newPiece(folder, head, "MaskGlow" .. i, V(x, -0.2, -0.56), Z, V(0.08, 0.05, 0.02), Z, o.Glow, glow)
		end
	end
	if P.Scarf then
		local scarfColor = o.Cloth == o.Body and o.Glow or o.Cloth
		newPiece(folder, upper, "ScarfRing", V(0, 0.46, 0), Z, V(0.78, 0.2, 1.28), Z, scarfColor, Enum.Material.Fabric)
		newPiece(folder, upper, "ScarfTail", V(0.25, 0.25, 0.75), Z, V(0.18, 0.08, 1.1), Z, scarfColor, Enum.Material.Fabric, CFrame.Angles(math.rad(-25), math.rad(20), 0))
	end
	return true
end

return Outfits
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Crea (servidor) o espera (cliente) todos los RemoteEvents/RemoteFunctions del juego.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EVENTS = {
	"Fire", -- cliente -> servidor: disparo
	"Reload", -- cliente -> servidor: recargar
	"Melee", -- cliente -> servidor: cuchillazo
	"EquipSkin", -- cliente -> servidor: equipar skin
	"SetPrimary", -- cliente -> servidor: elegir arma principal
	"LeaveMenu", -- cliente -> servidor: ha salido de la pantalla de inicio
	"SetSecondary", -- cliente -> servidor: elegir arma secundaria
	"EquipOutfit", -- cliente -> servidor: equipar traje de operador
	"VoteMap", -- cliente -> servidor: voto de mapa/modo
	"ShotFX", -- servidor -> clientes: efectos de disparo de otros jugadores
	"HitConfirm", -- servidor -> cliente: confirmación de impacto (hitmarker)
	"KillFeed", -- servidor -> clientes: registro de bajas
	"Notify", -- servidor -> cliente(s): mensajes en pantalla
	"DataUpdate", -- servidor -> cliente: datos de progreso
	"Died", -- servidor -> cliente: quién te eliminó
	"RoundEnd", -- servidor -> clientes: resultado de la ronda
}
local FUNCTIONS = {
	"GetData",
	"BuyItem", -- comprar arma/skin/traje con monedas
	"ClaimDaily", -- recoger la recompensa diaria
	"OpenCrate", -- abrir una caja
}

local Remotes = {}

if RunService:IsServer() then
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in EVENTS do
		local remote = folder:FindFirstChild(name) or Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		Remotes[name] = remote
	end
	for _, name in FUNCTIONS do
		local remote = folder:FindFirstChild(name) or Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
		Remotes[name] = remote
	end
else
	local folder = ReplicatedStorage:WaitForChild("Remotes")
	for _, name in EVENTS do
		Remotes[name] = folder:WaitForChild(name)
	end
	for _, name in FUNCTIONS do
		Remotes[name] = folder:WaitForChild(name)
	end
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Shop</string>
          <string name="Source"><![CDATA[-- Catálogo de la tienda: precios en monedas, packs de Robux, VIP, recompensas diarias y cajas.
--
-- IMPORTANTE (Robux): crea los productos en el Creator Hub (Monetización) y pega sus IDs aquí.
--   Developer Products -> CoinPacks[i].ProductId
--   Game Pass VIP      -> VIPPassId
-- Con ID 0 el botón aparece desactivado ("Próximamente").
local Shop = {}

-- Packs de monedas (Developer Products, se pueden comprar varias veces)
Shop.CoinPacks = {
	{ Name = "Puñado", Coins = 500, Robux = 49, ProductId = 0 },
	{ Name = "Bolsa", Coins = 1200, Robux = 99, ProductId = 0, Tag = "+20%" },
	{ Name = "Cofre", Coins = 3000, Robux = 199, ProductId = 0, Tag = "MÁS VENDIDO" },
	{ Name = "Bóveda", Coins = 8000, Robux = 449, ProductId = 0, Tag = "MEJOR VALOR" },
}

-- Pase VIP (Game Pass): x2 XP y x2 monedas, nombre dorado y caja diaria extra
Shop.VIPPassId = 0
Shop.VIPRobux = 299
Shop.VIPMultiplier = 2

-- Precio en monedas de cada skin de arma
Shop.SkinPrices = {
	Toxico = 400,
	Selva = 300,
	Oceano = 600,
	Atardecer = 600,
	Sakura = 800,
	Hielo = 800,
	Calabaza = 1200,
	Vacio = 1500,
	Dorado = 2000,
	Galaxia = 2500,
	Dragon = 3000,
	Magma = 3000,
}

-- Precio en monedas de cada traje de operador (ver Outfits)
Shop.OutfitPrices = {
	BlazeRunner = 1500,
	NeonRecon = 1500,
	VoltBruiser = 2000,
	FrostByte = 1200,
	ToxicRogue = 1200,
	GoldenAce = 4000,
}

-- Recompensa diaria: un día por entrada (al 7.º día se vuelve a empezar)
Shop.DailyRewards = { 100, 150, 200, 250, 300, 400, 800 }
Shop.DailyCrateDay = 7 -- ese día también regala una caja

-- Cajas (solo con monedas). Las probabilidades se muestran en la tienda.
-- Si te toca algo repetido te devolvemos parte de las monedas.
Shop.Crates = {
	Neon = {
		Name = "Caja Neón",
		Price = 600,
		Odds = {
			{ Rarity = "Raro", Weight = 55 },
			{ Rarity = "Épico", Weight = 30 },
			{ Rarity = "Legendario", Weight = 12 },
			{ Rarity = "Mítico", Weight = 3 },
		},
		DuplicateRefund = 0.4,
	},
}

-- Ofertas del día: 3 objetos con descuento, iguales para todos y distintos cada día
Shop.OfferDiscount = 0.3

local function dayNumber(time)
	return math.floor((time or os.time()) / 86400)
end
Shop.DayNumber = dayNumber

function Shop.GetDailyOffers(day)
	day = day or dayNumber()
	local pool = {}
	for id in Shop.SkinPrices do
		table.insert(pool, { Kind = "Skin", Id = id })
	end
	for id in Shop.OutfitPrices do
		table.insert(pool, { Kind = "Outfit", Id = id })
	end
	table.sort(pool, function(a, b)
		return a.Kind .. a.Id < b.Kind .. b.Id
	end)
	local rng = Random.new(day * 7919)
	local offers = {}
	for _ = 1, math.min(3, #pool) do
		local item = table.remove(pool, rng:NextInteger(1, #pool))
		table.insert(offers, item)
	end
	return offers
end

-- Precio actual (con descuento si está en oferta hoy)
function Shop.GetPrice(kind, id, day)
	local base
	if kind == "Skin" then
		base = Shop.SkinPrices[id]
	elseif kind == "Outfit" then
		base = Shop.OutfitPrices[id]
	end
	if not base then
		return nil, false
	end
	for _, offer in Shop.GetDailyOffers(day) do
		if offer.Kind == kind and offer.Id == id then
			return math.floor(base * (1 - Shop.OfferDiscount) / 10 + 0.5) * 10, true
		end
	end
	return base, false
end

return Shop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Skins</string>
          <string name="Source"><![CDATA[-- Skins de armas. Cada skin pinta las piezas del arma según su "Role":
--   Body   = cuerpo principal
--   Accent = detalles brillantes (neón)
--   Dark   = cañón, cargador, mira
--   Accent2 = detalles secundarios (paneles, rayas)
-- Opcional:
--   Effect = "Sparkle" (destellos) o "Flame" (llamas) alrededor del arma
--   Pulse  = true: los detalles de neón laten entre Accent y Accent2
local Skins = {}

Skins.List = {
	Default = {
