---------------------------------------------------------------------------
-- Mensajes
---------------------------------------------------------------------------

local function popup(text, color)
	local label = UI.label({
		Size = UDim2.fromOffset(400, 26),
		Text = text,
		TextSize = 22,
		TextColor3 = color or Color3.fromRGB(255, 230, 120),
		LayoutOrder = math.floor(os.clock() * 100) % 100000,
		Parent = refs.Popups,
	})
	task.delay(1.4, function()
		tween(label, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	Debris:AddItem(label, 2)
end

local bigToken
local function bigMessage(text, color)
	local label = refs.BigText
	label.Text = text
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextTransparency = 0
	label.TextStrokeTransparency = 0
	label.Size = UDim2.fromOffset(800, 70)
	label.TextSize = 70
	label.Visible = true
	tween(label, 0.25, { TextSize = 54 }, Enum.EasingStyle.Back)
	local token = {}
	bigToken = token
	task.delay(2.5, function()
		if bigToken == token then
			tween(label, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
	end)
end

local function timedLabel(label, text, duration)
	label.Text = text
	label.Visible = true
	local token = {}
	label:SetAttribute("Token", tostring(token))
	task.delay(duration, function()
		if label:GetAttribute("Token") == tostring(token) then
			label.Visible = false
		end
	end)
end

local function onNotify(kind, text)
	if kind == "XP" then
		popup(text)
	elseif kind == "Big" then
		bigMessage(text)
	elseif kind == "LevelUp" then
		bigMessage("⬆ ¡NIVEL " .. tostring(text) .. "!", Color3.fromRGB(255, 210, 60))
		Sounds.Play("Kill")
	elseif kind == "Flag" then
		timedLabel(refs.Banner, "🚩 " .. text, 3)
		Sounds.Play("Flag")
	elseif kind == "Streak" then
		timedLabel(refs.Banner, "🔥 " .. text, 3)
	else
		timedLabel(refs.Toast, text, 3)
		Sounds.Play("Click")
	end
end

local multiCount, lastKillTime, killToken = 0, 0, nil
local MULTI_NAMES = { [2] = "¡DOBLE BAJA!", [3] = "¡TRIPLE BAJA!", [4] = "¡CUÁDRUPLE!" }

local function showKillBanner(victim, headshot)
	local now = os.clock()
	multiCount = (now - lastKillTime < 4) and multiCount + 1 or 1
	lastKillTime = now
	local multi = MULTI_NAMES[multiCount] or (multiCount >= 5 and "¡IMPARABLE!" or nil)
	refs.KillTitle.Text = multi or "ELIMINADO"
	refs.KillTitle.TextColor3 = multi and Color3.fromRGB(255, 180, 30) or Color3.fromRGB(255, 70, 70)
	refs.KillSub.Text = tostring(victim) .. (headshot and "  ·  DISPARO A LA CABEZA" or "")
	refs.KillIcon.Text = headshot and "🎯" or "💀"
	refs.KillBanner.Visible = true
	refs.KillScale.Scale = 1.5
	tween(refs.KillScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	local token = {}
	killToken = token
	task.delay(2.2, function()
		if killToken == token then
			refs.KillBanner.Visible = false
		end
	end)
end

local function onKillFeed(info)
	if type(info) ~= "table" then
		return
	end
	if info.Killer == player.Name and info.Victim ~= player.Name then
		showKillBanner(info.Victim, info.Headshot)
	end
	local killer = info.Killer
	local text
	local weapon = info.Weapon ~= "" and (" [" .. info.Weapon .. "] ") or " ✖ "
	if info.Headshot then
		weapon ..= "🎯 "
	end
	local victim = string.format('<font color="%s">%s</font>', UI.hex(info.VictimColor), info.Victim or "?")
	if killer then
		text = string.format('<font color="%s">%s</font>%s%s', UI.hex(info.KillerColor), killer, weapon, victim)
	else
		text = victim .. " se eliminó"
	end
	local entry = UI.new("Frame", {
		Size = UDim2.fromOffset(380, 26),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		LayoutOrder = math.floor(os.clock() * 100) % 1000000,
		Parent = refs.KillFeed,
	}, { UI.corner(6) })
	if killer == player.Name or info.Victim == player.Name then
		UI.stroke(Color3.fromRGB(255, 210, 80), 2, 0.2).Parent = entry
	end
	UI.label({
		Size = UDim2.new(1, -12, 1, 0),
		Position = UDim2.fromOffset(6, 0),
		Text = text,
		RichText = true,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = entry,
	})
	local entries = {}
	for _, child in refs.KillFeed:GetChildren() do
		if child:IsA("Frame") then
			table.insert(entries, child)
		end
	end
	if #entries > 6 then
		table.sort(entries, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		entries[1]:Destroy()
	end
	Debris:AddItem(entry, 7)
end

local hitToken
local function onHitConfirm(damage, headshot, killed)
	local color = Color3.new(1, 1, 1)
	if killed then
		color = Color3.fromRGB(255, 40, 40)
	elseif headshot then
		color = Color3.fromRGB(255, 210, 40)
	end
	for _, line in refs.HitLines do
		line.BackgroundColor3 = color
		line.Size = killed and UDim2.fromOffset(14, 4) or UDim2.fromOffset(10, 3)
	end
	refs.Hitmarker.Visible = true
	local token = {}
	hitToken = token
	task.delay(killed and 0.35 or 0.15, function()
		if hitToken == token then
			refs.Hitmarker.Visible = false
		end
	end)
	Sounds.Play(killed and "Kill" or (headshot and "Headshot" or "Hit"))

	-- Número de daño
	if type(damage) == "number" then
		local label = UI.label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.random(30, 60), 0.5, math.random(-40, -20)),
			Size = UDim2.fromOffset(80, 30),
			Text = tostring(damage),
			TextSize = headshot and 28 or 22,
			TextColor3 = color,
			Parent = gui,
		})
		tween(label, 0.6, {
			Position = label.Position + UDim2.fromOffset(0, -30),
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		})
		Debris:AddItem(label, 0.7)
	end
end

local function onRoundEnd(info)
	if type(info) ~= "table" then
		return
	end
	local teamA = ReplicatedStorage:GetAttribute("TeamA") or "Rojo"
	local teamB = ReplicatedStorage:GetAttribute("TeamB") or "Azul"
	if info.Winner then
		local won = player.Team and player.Team.Name == info.Winner
		refs.RoundTitle.Text = won and "¡VICTORIA!" or "DERROTA"
		refs.RoundTitle.TextColor3 = won and Color3.fromRGB(255, 210, 60) or Color3.fromRGB(255, 80, 80)
	else
		refs.RoundTitle.Text = "EMPATE"
		refs.RoundTitle.TextColor3 = Color3.new(1, 1, 1)
	end
	local colorA = refs.ScoreABox.BackgroundColor3
	local colorB = refs.ScoreBBox.BackgroundColor3
	refs.RoundScore.Text = string.format(
		'<font color="%s">%s %d</font>  -  <font color="%s">%d %s</font>',
		UI.hex(colorA),
		teamA,
		info.ScoreA or 0,
		UI.hex(colorB),
		info.ScoreB or 0,
		teamB
	)
	local mvpText = ""
	if info.MVP then
		local captures = info.MVPCaptures or 0
		mvpText = "⭐ MVP: " .. info.MVP .. " (" .. info.MVPKills .. " bajas"
		if captures > 0 then
			mvpText ..= ", " .. captures .. (captures == 1 and " captura" or " capturas")
		end
		mvpText ..= ")"
	end
	refs.RoundMVP.Text = mvpText
	refs.RoundEnd.Visible = true
	task.delay(7, function()
		refs.RoundEnd.Visible = false
	end)
end

---------------------------------------------------------------------------
-- Actualización
---------------------------------------------------------------------------

local function getThumbnail(userId)
	if thumbnails[userId] ~= nil then
		return thumbnails[userId]
	end
	thumbnails[userId] = ""
	task.spawn(function()
		local ok, image = pcall(function()
			return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
		end)
		thumbnails[userId] = ok and image or ""
	end)
	return ""
end

local function updatePlayerRow()
	local list = Players:GetPlayers()
	local function kills(p)
		local stats = p:FindFirstChild("leaderstats")
		local value = stats and stats:FindFirstChild("Bajas")
		return value and value.Value or 0
	end
	table.sort(list, function(a, b)
		return kills(a) > kills(b)
	end)
	for _, child in refs.PlayerRow:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	for rank = 1, math.min(10, #list) do
		local p = list[rank]
		local teamColor = p.Team and p.TeamColor.Color or Color3.new(1, 1, 1)
		local card = UI.new("Frame", {
			LayoutOrder = rank,
			Size = UDim2.fromOffset(40, 54),
			BackgroundTransparency = 1,
			Parent = refs.PlayerRow,
		})
		UI.new("ImageLabel", {
			Size = UDim2.fromOffset(40, 40),
			BackgroundColor3 = Color3.fromRGB(40, 40, 45),
			Image = getThumbnail(p.UserId),
			Parent = card,
		}, { UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0) }), UI.stroke(teamColor, 3, 0) })
		UI.label({
			Position = UDim2.fromOffset(-6, -6),
			Size = UDim2.fromOffset(24, 14),
			Text = "#" .. rank,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		UI.label({
			Position = UDim2.fromOffset(0, 38),
			Size = UDim2.fromOffset(40, 16),
			Text = tostring(kills(p)),
			TextSize = 15,
			TextColor3 = p == player and Color3.fromRGB(255, 210, 60) or Color3.new(1, 1, 1),
			Parent = card,
		})
	end
end

local function updateScoreboard()
	local teamA = ReplicatedStorage:GetAttribute("TeamA")
	local teamB = ReplicatedStorage:GetAttribute("TeamB")
	if teamA then
		refs.ScoreA.Text = tostring(ReplicatedStorage:GetAttribute("Score_" .. teamA) or 0)
		local team = game:GetService("Teams"):FindFirstChild(teamA)
		if team then
			refs.ScoreABox.BackgroundColor3 = team.TeamColor.Color
		end
	end
	if teamB then
		refs.ScoreB.Text = tostring(ReplicatedStorage:GetAttribute("Score_" .. teamB) or 0)
		local team = game:GetService("Teams"):FindFirstChild(teamB)
		if team then
			refs.ScoreBBox.BackgroundColor3 = team.TeamColor.Color
		end
	end
	local state = ReplicatedStorage:GetAttribute("State")
	local timeLeft = ReplicatedStorage:GetAttribute("TimeLeft") or 0
	local modeName = ReplicatedStorage:GetAttribute("ModeName") or "Duelo por equipos"
	refs.Timer.Text = UI.formatTime(timeLeft)
	if state == "Intermission" then
		refs.Mode.Text = "Siguiente: " .. modeName .. " · empieza en " .. timeLeft
	elseif state == "Ended" then
		refs.Mode.Text = "Fin de la ronda"
	else
		refs.Mode.Text = modeName .. " · Primero a " .. tostring(ReplicatedStorage:GetAttribute("ScoreToWin") or "?")
	end

	-- Banderas
	local function flagStatus(teamName)
		local flagState = teamName and ReplicatedStorage:GetAttribute("FlagState_" .. teamName)
		if flagState == "Home" then
			return "🚩 En base", Color3.fromRGB(150, 255, 150)
		elseif flagState == "Carried" then
			local carrier = ReplicatedStorage:GetAttribute("FlagCarrier_" .. teamName) or ""
			return "⚠ " .. carrier, Color3.fromRGB(255, 90, 90)
		elseif flagState == "Dropped" then
			return "⬇ Caída", Color3.fromRGB(255, 210, 80)
		end
		return "", Color3.new(1, 1, 1)
	end
	refs.FlagA.Text, refs.FlagA.TextColor3 = flagStatus(teamA)
	refs.FlagB.Text, refs.FlagB.TextColor3 = flagStatus(teamB)

	-- La bandera que llevamos a la espalda no nos tapa la vista
	local flagsFolder = workspace:FindFirstChild("Flags")
	if flagsFolder then
		for _, model in flagsFolder:GetChildren() do
			local teamName = string.gsub(model.Name, "^Flag_", "")
			local mine = ReplicatedStorage:GetAttribute("FlagCarrier_" .. teamName) == player.Name
			for _, part in model:GetDescendants() do
				if part:IsA("BasePart") then
					part.LocalTransparencyModifier = mine and 1 or 0
				elseif part:IsA("BillboardGui") then
					part.Enabled = not mine
				end
			end
		end
	end
end

local function updateData(data)
	if not data then
		return
	end
	local per = data.XPPerLevel or 1000
	refs.LevelText.Text = "Nivel " .. data.Level .. "  ·  " .. data.XP .. "/" .. per .. " XP"
	tween(refs.XPFill, 0.3, { Size = UDim2.fromScale(math.clamp(data.XP / per, 0, 1), 1) })
end

local lastHealth = 100
local lastDamageTime = 0
local chipRatio = 1
local function render(dt)
	gui.Enabled = not ClientState.InMainMenu
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	-- Vida
	if humanoid then
		local health = math.max(0, humanoid.Health)
		local ratio = health / math.max(humanoid.MaxHealth, 1)
		refs.HealthFill.Size = UDim2.fromScale(ratio, 1)
		refs.HealthFill.BackgroundColor3 = Color3.fromRGB(230, 60, 60):Lerp(Color3.fromRGB(70, 220, 90), ratio)
		refs.HealthText.Text = tostring(math.ceil(health))
		-- La parte blanca baja despacio y deja ver el daño recibido
		chipRatio = ratio > chipRatio and ratio or math.max(ratio, chipRatio - dt * 0.5)
		refs.HealthChip.Size = UDim2.fromScale(chipRatio, 1)
		if health < lastHealth - 0.5 then
			lastDamageTime = os.clock()
			refs.DamageStroke.Transparency = 0.35
			tween(refs.DamageStroke, 0.6, { Transparency = 1 })
		elseif ratio < 0.35 and ratio > 0 and os.clock() - lastDamageTime > 0.6 then
			-- Vida baja: la viñeta roja late
			refs.DamageStroke.Transparency = 0.7 + 0.15 * math.sin(os.clock() * 5)
		end
		lastHealth = health
	end

	-- Racha
	local streak = player:GetAttribute("Streak") or 0
	refs.StreakText.Text = "Racha x" .. streak
	refs.StreakFill.Size = UDim2.fromScale(1, math.clamp(streak / 10, 0, 1))

	-- Arma
	local def = ClientState.CurrentDef
	local tool = ClientState.CurrentTool
	if def and tool then
		refs.WeaponName.Text = def.DisplayName
		if def.Type == "Gun" then
			local reserve = tool:GetAttribute("Reserve") or 0
			local ammoColor = ClientState.Ammo <= math.ceil(def.MagSize * 0.25) and "#FF5050" or "#FFFFFF"
			refs.Ammo.Text = string.format(
				'<font color="%s">%d</font><font size="28" color="#C8C8C8"> | %d</font>',
				ammoColor,
				ClientState.Ammo,
				reserve
			)
			refs.AmmoBar.Visible = true
			local fill = ClientState.Reloading and ClientState.ReloadProgress or ClientState.Ammo / def.MagSize
			refs.AmmoFill.Size = UDim2.fromScale(math.clamp(fill, 0, 1), 1)
			refs.AmmoFill.BackgroundColor3 = ClientState.Reloading and Color3.fromRGB(120, 200, 255)
				or (ClientState.Ammo <= math.ceil(def.MagSize * 0.25) and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(255, 210, 80))
			if ClientState.Reloading then
				refs.ReloadHint.Text = "RECARGANDO " .. math.floor(ClientState.ReloadProgress * 100) .. "%"
			elseif ClientState.Ammo == 0 and reserve == 0 then
				refs.ReloadHint.Text = "SIN MUNICIÓN"
			elseif ClientState.Ammo <= math.ceil(def.MagSize * 0.25) then
				refs.ReloadHint.Text = "[R] Recargar"
			else
				refs.ReloadHint.Text = ""
			end
		else
			refs.Ammo.Text = "∞"
			refs.ReloadHint.Text = ""
			refs.AmmoBar.Visible = false
		end
	else
		refs.WeaponName.Text = ""
		refs.Ammo.Text = ""
		refs.ReloadHint.Text = ""
		refs.AmmoBar.Visible = false
	end

	-- Ranuras
	local tools = WeaponController.GetTools()
	for slot, row in refs.Slots do
		local slotTool = tools[slot]
		local weaponName = slotTool and slotTool:GetAttribute("Weapon")
		local slotDef = weaponName and Weapons.Get(weaponName)
		row.Row.Visible = slotDef ~= nil
		row.Name.Text = slotDef and slotDef.DisplayName or ""
		local active = slotTool ~= nil and slotTool == tool
		row.Name.TextColor3 = active and Color3.fromRGB(255, 210, 60) or Color3.fromRGB(220, 220, 220)
		row.Key.BackgroundColor3 = active and Color3.fromRGB(255, 170, 30) or Color3.fromRGB(20, 20, 25)
		row.Stroke.Transparency = active and 0 or 1
		row.Row.BackgroundTransparency = active and 0.45 or 0.7
		-- Icono 3D (solo se reconstruye si cambia el arma o la skin)
		local skinId = slotTool and slotTool:GetAttribute("Skin")
		local iconKey = slotDef and (weaponName .. "|" .. tostring(skinId)) or nil
		if iconKey ~= row.IconKey then
			row.IconKey = iconKey
			row.Icon:ClearAllChildren()
			if iconKey then
				WeaponIcon.Create(weaponName, skinId, { Size = UDim2.fromScale(1, 1), Parent = row.Icon }, "side", 170 / 44)
			end
		end
	end

	-- Mira
	local aim = ClientState.AimAlpha
	local isGun = def and def.Type == "Gun"
	local gap = 6 + ClientState.Spread * 6
	for _, line in refs.CrossLines do
		line.Frame.Position = UDim2.fromOffset(line.Dir.X * (gap + 4), line.Dir.Y * (gap + 4))
		line.Frame.Visible = isGun and aim < 0.5
	end
	refs.CrossDot.Visible = aim < 0.5
	refs.Crosshair.Visible = not ClientState.IsBlocked()
	refs.Scope.Visible = def ~= nil and def.Scope == true and aim > 0.85
end

---------------------------------------------------------------------------

function HUD.Init()
	task.spawn(disableCoreGui)

	gui = UI.new("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	buildTopBar()
	buildCrosshair()
	buildWeaponPanel()
	buildPlayerPanel()
	buildFeedsAndOverlays()

	Remotes.Notify.OnClientEvent:Connect(onNotify)
	Remotes.KillFeed.OnClientEvent:Connect(onKillFeed)
	Remotes.HitConfirm.OnClientEvent:Connect(onHitConfirm)
	Remotes.RoundEnd.OnClientEvent:Connect(onRoundEnd)
	Remotes.Died.OnClientEvent:Connect(function(killerName, weaponName)
		local weapon = weaponName and Weapons.Get(weaponName)
		if killerName then
			refs.DeathText.Text = "ELIMINADO POR <b>"
				.. killerName
				.. "</b>"
				.. (weapon and (" · " .. weapon.DisplayName) or "")
		else
			refs.DeathText.Text = "HAS MUERTO"
		end
		refs.DeathIcon:ClearAllChildren()
		if weapon then
			WeaponIcon.Create(weaponName, "Default", { Size = UDim2.fromScale(1, 1), Parent = refs.DeathIcon }, "angled", 280 / 110)
		end
		refs.DeathScreen.Visible = true
		-- Cuenta atrás para reaparecer
		task.spawn(function()
			for t = GameConfig.RespawnTime, 1, -1 do
				if not refs.DeathScreen.Visible then
					return
				end
				refs.RespawnText.Text = "Reapareciendo en " .. t .. "..."
				task.wait(1)
			end
			refs.RespawnText.Text = "Reapareciendo..."
		end)
	end)
	player.CharacterAdded:Connect(function()
		refs.DeathScreen.Visible = false
		lastHealth = 100
		refs.DamageStroke.Transparency = 1
	end)

	ClientState.DataChanged.Event:Connect(updateData)
	updateData(ClientState.Data)

	ReplicatedStorage.AttributeChanged:Connect(updateScoreboard)
	updateScoreboard()

	local function updateCarrier()
		refs.CarrierBanner.Visible = player:GetAttribute("CarryingFlag") == true
	end
	player:GetAttributeChangedSignal("CarryingFlag"):Connect(updateCarrier)
	updateCarrier()

	task.spawn(function()
		while true do
			updatePlayerRow()
			task.wait(1)
		end
	end)

	RunService.RenderStepped:Connect(render)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="32">
            <Properties>
              <string name="Name">MainMenu</string>
              <string name="Source"><![CDATA[-- Pantalla de inicio: título del juego, cámara girando alrededor del mapa y botones.
-- Mientras está abierta el personaje no se mueve y es invulnerable (escudo del servidor).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local Menu = require(script.Parent.Menu)
local WeaponIcon = require(script.Parent.WeaponIcon)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local MainMenu = {}

local gui, root, infoLabel, showcase, dailyButton
local blur
local orbitAngle = 0
local controls

local ORBIT_CENTER = Vector3.new(0, 8, 0)
local ORBIT_RADIUS = 150
local ORBIT_HEIGHT = 65

local function getControls()
	if controls then
		return controls
	end
	local ok, result = pcall(function()
		local playerModule = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
		return playerModule:GetControls()
	end)
	if ok then
		controls = result
	end
	return controls
end

local function orbit(dt)
	orbitAngle += dt * 0.06
	local position = ORBIT_CENTER + Vector3.new(math.cos(orbitAngle) * ORBIT_RADIUS, ORBIT_HEIGHT, math.sin(orbitAngle) * ORBIT_RADIUS)
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.lookAt(position, ORBIT_CENTER)
	camera.FieldOfView = 60
end

local function bigButton(text, color, order, parent)
	local button = UI.button({
		LayoutOrder = order,
		Size = UDim2.fromOffset(300, 58),
		Text = text,
		TextSize = 28,
		BackgroundColor3 = color,
		Parent = parent,
	}, { UI.stroke(Color3.new(0, 0, 0), 3, 0), UI.gloss() })
	button.TextStrokeTransparency = 0.5
	local scale = UI.new("UIScale", { Parent = button })
	button.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1.06 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1 }):Play()
	end)
	return button
end

local function refreshInfo()
	local data = ClientState.Data
	if dailyButton then
		dailyButton.Visible = data ~= nil and data.DailyAvailable == true
	end
	if infoLabel then
		infoLabel.Text = data and string.format("Nivel %d   ·   🪙 %d   ·   %d bajas", data.Level, data.Coins, data.TotalKills or 0)
			or "Cargando..."
	end
	-- Arma principal con la skin equipada, a la derecha
	if showcase then
		showcase:ClearAllChildren()
		if data then
			WeaponIcon.Create(data.Primary or "Rifle", data.EquippedSkin, { Size = UDim2.fromScale(1, 1), Parent = showcase }, "angled", 1.6)
		end
	end
end

local function play()
	if not ClientState.InMainMenu then
		return
	end
	Sounds.Play("Click")
	Remotes.LeaveMenu:FireServer()
	TweenService:Create(root, TweenInfo.new(0.35), { GroupTransparency = 1 }):Play()
	showcase.Visible = false
	if blur then
		TweenService:Create(blur, TweenInfo.new(0.35), { Size = 0 }):Play()
	end
	task.delay(0.35, function()
		RunService:UnbindFromRenderStep("MainMenuOrbit")
		ClientState.InMainMenu = false
		gui.Enabled = false
		if blur then
			blur:Destroy()
			blur = nil
		end
		camera.CameraType = Enum.CameraType.Custom
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			camera.CameraSubject = humanoid
		end
		local ctrl = getControls()
		if ctrl then
			ctrl:Enable()
		end
		if not Menu.IsOpen() then
			UserInputService.MouseIconEnabled = false
		end
	end)
end

function MainMenu.Init()
	gui = UI.new("ScreenGui", {
		Name = "MainMenu",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 4,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	root = UI.new("CanvasGroup", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	})

	-- Oscurecido a la izquierda para que se lea el texto
	UI.new("Frame", {
		Size = UDim2.fromScale(0.65, 1),
		BackgroundColor3 = Color3.fromRGB(10, 10, 25),
		BorderSizePixel = 0,
		Parent = root,
	}, {
		UI.new("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.15),
				NumberSequenceKeypoint.new(0.6, 0.5),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})

	-- Botón invisible "Modal": libera el ratón aunque la cámara sea en primera persona
	UI.new("TextButton", {
		Size = UDim2.fromOffset(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		Modal = true,
		Parent = root,
	})

	local left = UI.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 70, 0.5, 0),
		Size = UDim2.fromOffset(560, 520),
		BackgroundTransparency = 1,
		Parent = root,
	})

	-- Título con degradado y borde grueso
	local title = UI.label({
		Size = UDim2.new(1, 0, 0, 110),
		Text = GameConfig.GameTitle,
		TextSize = 96,
		TextScaled = true,
		TextStrokeTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = left,
	}, {
		UI.new("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 230, 60)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 140, 30)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 70, 170)),
			}),
			Rotation = 90,
		}),
		UI.new("UIStroke", { Thickness = 6, Color = Color3.fromRGB(30, 10, 40) }),
	})
	local titleScale = UI.new("UIScale", { Parent = title })

	UI.label({
		Position = UDim2.fromOffset(4, 112),
		Size = UDim2.new(1, 0, 0, 30),
		Text = "CAPTURA LA BANDERA  ·  DUELO POR EQUIPOS",
		TextSize = 24,
		TextColor3 = Color3.fromRGB(200, 230, 255),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = left,
	})

	local buttons = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 175),
		Size = UDim2.fromOffset(300, 380),
		BackgroundTransparency = 1,
		Parent = left,
	}, {
		UI.new("UIListLayout", { Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local playButton = bigButton("▶  JUGAR", Color3.fromRGB(60, 200, 90), 1, buttons)
	playButton.Size = UDim2.fromOffset(300, 70)
	playButton.TextSize = 36
	playButton.Activated:Connect(play)
	bigButton("⭐  PASE DE BATALLA", Color3.fromRGB(255, 130, 30), 2, buttons).Activated:Connect(function()
		Sounds.Play("Click")
		Menu.Open("Pase")
	end)
	bigButton("🔫  ARMAS Y TRAJES", Color3.fromRGB(50, 130, 255), 3, buttons).Activated:Connect(function()
		Sounds.Play("Click")
		Menu.Open("Armas")
	end)
	bigButton("🛒  TIENDA", Color3.fromRGB(190, 70, 255), 4, buttons).Activated:Connect(function()
		Sounds.Play("Click")
		Menu.Open("Tienda")
	end)

	-- Recompensa diaria (late mientras está disponible)
	dailyButton = bigButton("🎁  RECOMPENSA DIARIA", Color3.fromRGB(60, 200, 90), 5, buttons)
	dailyButton.Visible = false
	dailyButton.Activated:Connect(function()
		if Menu.ClaimDaily() then
			dailyButton.Visible = false
		end
	end)
	task.spawn(function()
		local scale = dailyButton:FindFirstChildOfClass("UIScale")
		while gui.Parent and ClientState.InMainMenu do
			if dailyButton.Visible and scale then
				TweenService:Create(scale, TweenInfo.new(0.5, Enum.EasingStyle.Sine), { Scale = 1.06 }):Play()
				task.wait(0.5)
				TweenService:Create(scale, TweenInfo.new(0.5, Enum.EasingStyle.Sine), { Scale = 1 }):Play()
			end
			task.wait(0.5)
		end
	end)

	infoLabel = UI.label({
		Position = UDim2.fromOffset(330, 175),
		Size = UDim2.new(1, 0, 0, 26),
		Text = "Cargando...",
		TextSize = 22,
		TextColor3 = Color3.fromRGB(255, 220, 120),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = left,
	})
	UI.label({
		Position = UDim2.fromOffset(4, 150),
		Size = UDim2.new(1, 0, 0, 22),
		Text = "Clic izq. disparar · Clic der. apuntar · Shift correr · C deslizar · B pase",
		TextSize = 16,
		TextColor3 = Color3.fromRGB(190, 195, 215),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = left,
	})

	-- Escaparate del arma a la derecha (fuera del CanvasGroup para que el 3D se dibuje siempre)
	showcase = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -60, 0.55, 0),
		Size = UDim2.fromOffset(480, 300),
		BackgroundTransparency = 1,
		Parent = gui,
	})

	-- Desenfoque del fondo
	blur = Instance.new("BlurEffect")
	blur.Name = "MainMenuBlur"
	blur.Size = 10
	blur.Parent = Lighting

	ClientState.InMainMenu = true
	UserInputService.MouseIconEnabled = true
	RunService:BindToRenderStep("MainMenuOrbit", Enum.RenderPriority.Camera.Value + 2, orbit)

	-- El título "respira"
	task.spawn(function()
		while ClientState.InMainMenu do
			TweenService:Create(titleScale, TweenInfo.new(1.2, Enum.EasingStyle.Sine), { Scale = 1.04 }):Play()
			task.wait(1.2)
			TweenService:Create(titleScale, TweenInfo.new(1.2, Enum.EasingStyle.Sine), { Scale = 1 }):Play()
			task.wait(1.2)
		end
	end)

	-- Bloquea el movimiento del personaje mientras tanto
	task.spawn(function()
		local ctrl = getControls()
		if ctrl and ClientState.InMainMenu then
			ctrl:Disable()
		end
	end)

	ClientState.DataChanged.Event:Connect(refreshInfo)
	refreshInfo()

	-- También se puede empezar con Enter / botón A del mando
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not ClientState.InMainMenu or Menu.IsOpen() then
			return
		end
		if input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.ButtonA then
			play()
		end
	end)
end

return MainMenu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="33">
            <Properties>
              <string name="Name">Menu</string>
              <string name="Source"><![CDATA[-- Menú principal del jugador (tecla B): pase de batalla, armas, skins, trajes y tienda.
local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local MarketplaceService = game:GetService("MarketplaceService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Skins = require(Shared.Skins)
local Weapons = require(Shared.Weapons)
local Outfits = require(Shared.Outfits)
local Shop = require(Shared.Shop)
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.UI)
local WeaponIcon = require(script.Parent.WeaponIcon)

local player = Players.LocalPlayer

local Menu = {}

local gui, panel, content, headerInfo, toast
local tabButtons = {}
local currentTab = "Pase"
local busy = false

local GOLD = Color3.fromRGB(255, 190, 40)
local PANEL_BG = Color3.fromRGB(22, 24, 38)
local CARD_BG = Color3.fromRGB(38, 42, 64)
local GREEN = Color3.fromRGB(60, 170, 90)
local BLUE = Color3.fromRGB(40, 120, 255)
local GREY = Color3.fromRGB(70, 70, 82)

local TABS = { "Pase", "Armas", "Skins", "Trajes", "Tienda" }

local function rarityColor(rarity)
	return Skins.RarityColors[rarity] or Color3.new(1, 1, 1)
end

local function showToast(text, color)
	if not toast then
		return
	end
	toast.Text = text
	toast.TextColor3 = color or Color3.new(1, 1, 1)
	toast.Visible = true
	local token = {}
	toast:SetAttribute("T", tostring(token))
	task.delay(2.5, function()
		if toast:GetAttribute("T") == tostring(token) then
			toast.Visible = false
		end
	end)
end

local function coinsText(n)
	return "🪙 " .. tostring(n)
end

local function scroller(layout)
	return UI.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		Parent = content,
	}, { layout })
end

local function buy(kind, id)
	if busy then
		return
	end
	busy = true
	Sounds.Play("Click")
	local ok, result, message = pcall(function()
		return Remotes.BuyItem:InvokeServer(kind, id)
	end)
	busy = false
	if ok and result then
		Sounds.Play("Kill")
		showToast(message or "¡Comprado!", GOLD)
	else
		showToast(ok and (message or "No se pudo comprar") or "Error de conexión", Color3.fromRGB(255, 90, 90))
	end
end

-- Maniquí R15 sencillo para previsualizar trajes
local function mannequin(outfitId)
	local model = Instance.new("Model")
	local skin = Color3.fromRGB(255, 204, 153)
	local legs = Color3.fromRGB(60, 60, 70)
	local torso = Color3.fromRGB(90, 120, 200)
	local parts = {
		{ "Head", Vector3.new(1.2, 1.2, 1.2), 0, 5.2, skin },
		{ "UpperTorso", Vector3.new(2, 1.6, 1), 0, 3.8, torso },
		{ "LowerTorso", Vector3.new(2, 0.4, 1), 0, 2.8, torso },
		{ "LeftUpperArm", Vector3.new(1, 1.2, 1), -1.5, 4.0, skin },
		{ "RightUpperArm", Vector3.new(1, 1.2, 1), 1.5, 4.0, skin },
		{ "LeftLowerArm", Vector3.new(1, 1.1, 1), -1.5, 2.85, skin },
		{ "RightLowerArm", Vector3.new(1, 1.1, 1), 1.5, 2.85, skin },
		{ "LeftHand", Vector3.new(1, 0.3, 1), -1.5, 2.15, skin },
		{ "RightHand", Vector3.new(1, 0.3, 1), 1.5, 2.15, skin },
		{ "LeftUpperLeg", Vector3.new(1, 1.2, 1), -0.5, 2.0, legs },
		{ "RightUpperLeg", Vector3.new(1, 1.2, 1), 0.5, 2.0, legs },
		{ "LeftLowerLeg", Vector3.new(1, 1.1, 1), -0.5, 0.85, legs },
		{ "RightLowerLeg", Vector3.new(1, 1.1, 1), 0.5, 0.85, legs },
		{ "LeftFoot", Vector3.new(1, 0.3, 1), -0.5, 0.15, legs },
		{ "RightFoot", Vector3.new(1, 0.3, 1), 0.5, 0.15, legs },
	}
	for _, spec in parts do
		local p = Instance.new("Part")
		p.Name = spec[1]
		p.Size = spec[2]
		p.CFrame = CFrame.new(spec[3], spec[4], 0)
		p.Color = spec[5]
		p.Anchored = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
	end
	local face = Instance.new("Part")
	face.Size = Vector3.new(0.6, 0.12, 0.05)
	face.CFrame = CFrame.new(0, 5.35, -0.62)
	face.Color = Color3.fromRGB(25, 25, 25)
	face.Anchored = true
	face.Parent = model
	Outfits.Apply(model, outfitId)
	return model
end

local function outfitViewport(outfitId, props)
	local viewport = UI.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(170, 170, 185),
		LightColor = Color3.new(1, 1, 1),
		LightDirection = Vector3.new(-1, -1.5, 1),
	})
	for k, v in props do
		viewport[k] = v
	end
	local model = mannequin(outfitId)
	model.Parent = viewport
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	camera.CFrame = CFrame.lookAt(Vector3.new(5, 4.6, -12), Vector3.new(0, 3, 0))
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	return viewport
end

---------------------------------------------------------------------------
-- Pestaña: Pase de batalla
---------------------------------------------------------------------------

local function rewardCard(reward, unlocked, premium, parent, order)
	local card = UI.new("Frame", {
		LayoutOrder = order,
		Size = UDim2.fromOffset(120, 116),
		BackgroundColor3 = CARD_BG,
		Parent = parent,
	}, { UI.corner(10), UI.stroke(premium and GOLD or Color3.fromRGB(90, 100, 140), 2, 0) })

	if not reward then
		UI.label({ Size = UDim2.fromScale(1, 1), Text = "—", TextSize = 30, TextTransparency = 0.5, Parent = card })
	elseif reward.Type == "Skin" then
		local skin = Skins.Get(reward.Id)
		WeaponIcon.Create(
			ClientState.Data and ClientState.Data.Primary or "ARX27",
			reward.Id,
			{ Position = UDim2.fromOffset(4, 4), Size = UDim2.fromOffset(112, 52), Parent = card },
			"angled",
			112 / 52
		)
		UI.label({ Position = UDim2.fromOffset(0, 58), Size = UDim2.new(1, 0, 0, 22), Text = skin.Name, TextSize = 17, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 80),
			Size = UDim2.new(1, 0, 0, 18),
			Text = skin.Rarity,
			TextSize = 14,
			TextColor3 = rarityColor(skin.Rarity),
			Parent = card,
		})
	elseif reward.Type == "Outfit" then
		local outfit = Outfits.Get(reward.Id)
		outfitViewport(reward.Id, { Position = UDim2.fromOffset(20, 2), Size = UDim2.fromOffset(80, 70), Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 74), Size = UDim2.new(1, 0, 0, 20), Text = outfit.Name, TextSize = 15, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 94),
			Size = UDim2.new(1, 0, 0, 16),
			Text = outfit.Rarity,
			TextSize = 13,
			TextColor3 = rarityColor(outfit.Rarity),
			Parent = card,
		})
	elseif reward.Type == "Crate" then
		UI.label({ Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 40), Text = "🎁", TextSize = 36, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 66), Size = UDim2.new(1, 0, 0, 24), Text = "Caja", TextSize = 18, Parent = card })
	else
		UI.label({ Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 40), Text = "🪙", TextSize = 34, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 62),
			Size = UDim2.new(1, 0, 0, 24),
			Text = tostring(reward.Amount),
			TextSize = 20,
			TextColor3 = GOLD,
			Parent = card,
		})
	end

	if reward then
		UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -4, 0, 2),
			Size = UDim2.fromOffset(24, 24),
			Text = unlocked and "✔" or "🔒",
			TextSize = 18,
			TextColor3 = unlocked and Color3.fromRGB(90, 230, 110) or Color3.new(1, 1, 1),
			ZIndex = 3,
			Parent = card,
		})
		if not unlocked then
			UI.new("Frame", {
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Color3.new(0, 0, 0),
				BackgroundTransparency = 0.5,
				ZIndex = 2,
				Parent = card,
			}, { UI.corner(10) })
		end
	end
	return card
end

local function buildPassPage(data)
	local page = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = content })
	local per = data.XPPerLevel or GameConfig.XPPerLevel
	UI.label({
		Size = UDim2.fromOffset(420, 26),
		Text = "Nivel " .. data.Level .. "  ·  " .. data.XP .. " / " .. per .. " XP",
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = page,
	})
	local bar = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.fromOffset(420, 12),
		BackgroundColor3 = Color3.fromRGB(10, 10, 15),
		Parent = page,
	}, { UI.corner(6) })
	UI.new("Frame", {
		Size = UDim2.fromScale(math.clamp(data.XP / per, 0, 1), 1),
		BackgroundColor3 = Color3.fromRGB(80, 170, 255),
		Parent = bar,
	}, { UI.corner(6), UI.gloss() })

	if data.Premium then
		UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 4),
			Size = UDim2.fromOffset(260, 34),
			Text = "👑 PREMIUM ACTIVO",
			TextSize = 22,
			TextColor3 = GOLD,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = page,
		})
	else
		local buyPass = UI.button({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 2),
			Size = UDim2.fromOffset(260, 40),
			Text = "👑 Obtener Premium",
			BackgroundColor3 = GOLD,
			TextColor3 = Color3.fromRGB(40, 25, 0),
			Parent = page,
		}, { UI.gloss() })
		buyPass.Activated:Connect(function()
			if GameConfig.PremiumPassId == 0 then
				showToast("Próximamente")
				return
			end
			MarketplaceService:PromptGamePassPurchase(player, GameConfig.PremiumPassId)
		end)
	end

	UI.label({ Position = UDim2.fromOffset(0, 98), Size = UDim2.fromOffset(70, 116), Text = "GRATIS", TextSize = 16, Parent = page })
	UI.label({
		Position = UDim2.fromOffset(0, 222),
		Size = UDim2.fromOffset(70, 116),
		Text = "PREMIUM",
		TextSize = 16,
		TextColor3 = GOLD,
		Parent = page,
	})

	local scroll = UI.new("ScrollingFrame", {
		Position = UDim2.fromOffset(74, 56),
		Size = UDim2.new(1, -74, 1, -56),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		Parent = page,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for tier, rewards in GameConfig.BattlePass do
		local reached = data.Level >= tier
		local column = UI.new("Frame", {
			LayoutOrder = tier,
			Size = UDim2.fromOffset(120, 280),
			BackgroundTransparency = 1,
			Parent = scroll,
		}, {
			UI.new("UIListLayout", {
				Padding = UDim.new(0, 8),
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		UI.label({
			LayoutOrder = 0,
			Size = UDim2.fromOffset(120, 26),
			Text = "NIVEL " .. tier,
			TextSize = 18,
			TextColor3 = reached and Color3.fromRGB(90, 230, 110) or Color3.fromRGB(180, 180, 190),
			Parent = column,
		})
		rewardCard(rewards.Free, reached, false, column, 1)
		rewardCard(rewards.Premium, reached and data.Premium, true, column, 2)
	end
end

---------------------------------------------------------------------------
-- Pestaña: Armas
---------------------------------------------------------------------------

local function buildWeaponsPage(data)
	local scroll = scroller(UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(205, 230),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}))
	local order = 0
	local function weaponCard(weaponName, slotField)
		order += 1
		local def = Weapons.Get(weaponName)
		local unlocked = Weapons.IsUnlocked(weaponName, data)
		local selected = data[slotField] == weaponName
		local card = UI.new("Frame", {
			LayoutOrder = order,
			BackgroundColor3 = CARD_BG,
			Parent = scroll,
		}, { UI.corner(12), UI.stroke(selected and GOLD or Color3.fromRGB(90, 100, 140), 2, 0) })
		UI.label({ Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 24), Text = def.DisplayName, TextSize = 21, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 28),
			Size = UDim2.new(1, 0, 0, 16),
			Text = def.Category .. (slotField == "Secondary" and " · secundaria" or ""),
			TextSize = 14,
			TextColor3 = Color3.fromRGB(170, 180, 215),
			Parent = card,
		})
		WeaponIcon.Create(weaponName, data.EquippedSkin, { Position = UDim2.fromOffset(8, 46), Size = UDim2.fromOffset(189, 78), Parent = card }, "angled", 189 / 78)
		local stats
		if def.Explosive then
			stats = "Explosivo · radio " .. def.Explosive.Radius
		else
			local damage = def.Pellets > 1 and (def.Damage .. "x" .. def.Pellets) or tostring(def.Damage)
			stats = string.format("Daño %s · %d/s · %d balas", damage, math.floor(def.FireRate + 0.5), def.MagSize)
		end
		UI.label({ Position = UDim2.fromOffset(0, 128), Size = UDim2.new(1, 0, 0, 18), Text = stats, TextSize = 14, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(8, 148),
			Size = UDim2.new(1, -16, 0, 32),
			Text = def.Description or "",
			TextSize = 13,
			TextWrapped = true,
			TextColor3 = Color3.fromRGB(190, 195, 220),
			Font = UI.FontBody,
			TextStrokeTransparency = 1,
			Parent = card,
		})
		local button = UI.button({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.new(1, -20, 0, 36),
			TextSize = 17,
			Parent = card,
		}, { UI.gloss() })
		if selected then
			button.Text = "Equipada"
			button.BackgroundColor3 = GREEN
			button.AutoButtonColor = false
		elseif unlocked then
			button.Text = "Equipar"
			button.BackgroundColor3 = BLUE
			button.Activated:Connect(function()
				Sounds.Play("Click")
				if slotField == "Primary" then
					Remotes.SetPrimary:FireServer(weaponName)
				else
					Remotes.SetSecondary:FireServer(weaponName)
				end
			end)
		elseif def.Price then
			button.Text = "🔒 Nv " .. def.UnlockLevel .. "  ·  " .. coinsText(def.Price)
			button.BackgroundColor3 = data.Coins >= def.Price and Color3.fromRGB(230, 140, 20) or GREY
			button.Activated:Connect(function()
				buy("Weapon", weaponName)
			end)
		else
			button.Text = "🔒 Nivel " .. def.UnlockLevel
			button.BackgroundColor3 = GREY
			button.AutoButtonColor = false
		end
	end
	for _, name in Weapons.Primaries do
		weaponCard(name, "Primary")
	end
	for _, name in Weapons.Secondaries do
		weaponCard(name, "Secondary")
	end
end

---------------------------------------------------------------------------
-- Pestañas: Skins y Trajes
---------------------------------------------------------------------------

local RARITY_ORDER = { "Común", "Raro", "Épico", "Legendario", "Mítico" }

local function sortedIds(list)
	local ids = {}
	for id in list do
		table.insert(ids, id)
	end
	table.sort(ids, function(a, b)
		local ra = table.find(RARITY_ORDER, list[a].Rarity) or 0
		local rb = table.find(RARITY_ORDER, list[b].Rarity) or 0
		if ra == rb then
			return list[a].Name < list[b].Name
		end
		return ra < rb
	end)
	return ids
end

local function priceButton(card, kind, id, owned, equipped, onEquip)
	local price, onSale = Shop.GetPrice(kind, id)
	local button = UI.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.new(1, -20, 0, 32),
		TextSize = 16,
		Parent = card,
	}, { UI.gloss() })
	if equipped then
		button.Text = "Equipado"
		button.BackgroundColor3 = GREEN
		button.AutoButtonColor = false
	elseif owned then
		button.Text = "Equipar"
		button.BackgroundColor3 = BLUE
		button.Activated:Connect(onEquip)
	elseif price then
		button.Text = (onSale and "🔥 " or "") .. coinsText(price)
		button.BackgroundColor3 = onSale and Color3.fromRGB(230, 60, 90) or Color3.fromRGB(230, 140, 20)
		button.Activated:Connect(function()
			buy(kind, id)
		end)
	else
		button.Text = "🔒 Pase de batalla"
		button.BackgroundColor3 = GREY
		button.AutoButtonColor = false
	end
	if onSale and not owned then
		UI.label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -6, 0, 4),
			Size = UDim2.fromOffset(60, 20),
			Text = "-" .. math.floor(Shop.OfferDiscount * 100) .. "%",
			TextSize = 16,
			TextColor3 = Color3.fromRGB(255, 90, 120),
			ZIndex = 3,
			Parent = card,
		})
	end
end

local function buildSkinsPage(data)
	local scroll = scroller(UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(165, 160),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}))
	for i, id in sortedIds(Skins.List) do
		local skin = Skins.List[id]
		local owned = data.Skins[id] == true
		local equipped = data.EquippedSkin == id
		local card = UI.new("Frame", { LayoutOrder = i, BackgroundColor3 = CARD_BG, Parent = scroll }, {
			UI.corner(10),
			UI.stroke(equipped and GOLD or rarityColor(skin.Rarity), 2, equipped and 0 or 0.4),
		})
		WeaponIcon.Create(data.Primary or "ARX27", id, { Position = UDim2.fromOffset(6, 4), Size = UDim2.fromOffset(153, 58), Parent = card }, "angled", 153 / 58)
		UI.label({
			Position = UDim2.fromOffset(0, 62),
			Size = UDim2.new(1, 0, 0, 22),
			Text = id == "Default" and "De fábrica" or skin.Name,
			TextSize = 19,
			Parent = card,
		})
		UI.label({
			Position = UDim2.fromOffset(0, 84),
			Size = UDim2.new(1, 0, 0, 16),
			Text = skin.Rarity,
			TextSize = 14,
			TextColor3 = rarityColor(skin.Rarity),
			Parent = card,
		})
		priceButton(card, "Skin", id, owned, equipped, function()
			Sounds.Play("Click")
			Remotes.EquipSkin:FireServer(id)
		end)
	end
end

local function buildOutfitsPage(data)
	local scroll = scroller(UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(200, 250),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}))
	for i, id in sortedIds(Outfits.List) do
		local outfit = Outfits.List[id]
		local owned = data.Outfits[id] == true
		local equipped = data.EquippedOutfit == id
		local card = UI.new("Frame", { LayoutOrder = i, BackgroundColor3 = CARD_BG, Parent = scroll }, {
			UI.corner(12),
			UI.stroke(equipped and GOLD or rarityColor(outfit.Rarity), 2, equipped and 0 or 0.4),
		})
		if id ~= "Default" then
			outfitViewport(id, { Position = UDim2.fromOffset(10, 4), Size = UDim2.fromOffset(180, 140), Parent = card })
		else
			UI.label({ Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 60), Text = "🙂", TextSize = 54, Parent = card })
		end
		UI.label({ Position = UDim2.fromOffset(0, 146), Size = UDim2.new(1, 0, 0, 24), Text = outfit.Name, TextSize = 20, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 170),
			Size = UDim2.new(1, 0, 0, 18),
			Text = outfit.Class .. " · " .. outfit.Rarity,
			TextSize = 14,
			TextColor3 = rarityColor(outfit.Rarity),
			Parent = card,
		})
		priceButton(card, "Outfit", id, owned, equipped, function()
			Sounds.Play("Click")
			Remotes.EquipOutfit:FireServer(id)
		end)
	end
end

---------------------------------------------------------------------------
-- Pestaña: Tienda (diaria, ofertas, cajas, Robux, VIP)
---------------------------------------------------------------------------

local function itemName(kind, id)
	if kind == "Outfit" then
		return Outfits.Get(id).Name, Outfits.Get(id).Rarity
	end
	return Skins.Get(id).Name, Skins.Get(id).Rarity
end

-- Animación de apertura de caja: una tira de premios que gira y se para en el tuyo
local function crateAnimation(result)
	local overlay = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.25,
		ZIndex = 20,
		Parent = gui,
	})
	UI.new("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true, Parent = overlay })
	local window = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(760, 170),
		BackgroundColor3 = Color3.fromRGB(15, 16, 26),
		ClipsDescendants = true,
		ZIndex = 21,
		Parent = overlay,
	}, { UI.corner(12), UI.stroke(GOLD, 3, 0) })
	local reel = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 15),
		Size = UDim2.fromOffset(40 * 150, 140),
		BackgroundTransparency = 1,
		ZIndex = 22,
		Parent = window,
	}, {
		UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	-- Rellenamos con objetos aleatorios y el premio en la posición 32
	local pool = {}
	for id in Skins.List do
		if id ~= "Default" then
			table.insert(pool, { "Skin", id })
		end
	end
	for id in Outfits.List do
		if id ~= "Default" then
			table.insert(pool, { "Outfit", id })
		end
	end
	local PRIZE_INDEX = 32
	for i = 1, 38 do
		local kind, id
		if i == PRIZE_INDEX then
			kind, id = result.Kind, result.Id
		else
			local pick = pool[math.random(1, #pool)]
			kind, id = pick[1], pick[2]
		end
		local name, rarity = itemName(kind, id)
		local card = UI.new("Frame", {
			LayoutOrder = i,
			Size = UDim2.fromOffset(140, 140),
			BackgroundColor3 = rarityColor(rarity):Lerp(Color3.new(0, 0, 0), 0.55),
			ZIndex = 23,
			Parent = reel,
		}, { UI.corner(10), UI.stroke(rarityColor(rarity), 3, 0) })
		UI.label({
			Position = UDim2.fromOffset(0, 30),
			Size = UDim2.new(1, 0, 0, 50),
			Text = kind == "Outfit" and "🧥" or "🔫",
			TextSize = 40,
			ZIndex = 24,
			Parent = card,
		})
		UI.label({ Position = UDim2.fromOffset(4, 90), Size = UDim2.new(1, -8, 0, 22), Text = name, TextScaled = true, ZIndex = 24, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 112),
			Size = UDim2.new(1, 0, 0, 18),
			Text = rarity,
			TextSize = 14,
			TextColor3 = rarityColor(rarity),
			ZIndex = 24,
			Parent = card,
		})
	end
	-- Marcador central
	UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.new(0, 4, 1, 0),
		BackgroundColor3 = GOLD,
		BorderSizePixel = 0,
		ZIndex = 30,
		Parent = window,
	})
	local cardStep = 150
	local target = -((PRIZE_INDEX - 1) * cardStep + 70 - 380) + math.random(-50, 50)
	local spin = TweenService:Create(reel, TweenInfo.new(4.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = UDim2.fromOffset(target, 15) })
	spin:Play()
	-- "tic" mientras gira
	task.spawn(function()
		local last = 0
		while spin.PlaybackState == Enum.PlaybackState.Playing do
			local index = math.floor(-reel.Position.X.Offset / cardStep)
			if index ~= last then
				last = index
				Sounds.Play("Click")
			end
			task.wait()
		end
	end)
	spin.Completed:Wait()
	local name, rarity = itemName(result.Kind, result.Id)
	Sounds.Play("Kill")
	local title = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.45, 100),
		Size = UDim2.fromOffset(700, 50),
		Text = result.Duplicate and ("Repetido: " .. name .. "  ·  +" .. result.Refund .. " monedas") or ("¡" .. name .. "! (" .. rarity .. ")"),
		TextSize = 34,
		TextColor3 = rarityColor(rarity),
		TextStrokeTransparency = 0,
		ZIndex = 25,
		Parent = overlay,
	})
	local scale = UI.new("UIScale", { Scale = 1.6, Parent = title })
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	local close = UI.button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.45, 160),
		Size = UDim2.fromOffset(220, 46),
		Text = "¡Genial!",
		BackgroundColor3 = GREEN,
		ZIndex = 25,
		Parent = overlay,
	}, { UI.gloss() })
	close.Activated:Connect(function()
		overlay:Destroy()
	end)
end

local function openCrate(crateId, useFree)
	if busy then
		return
	end
	busy = true
	local ok, success, result = pcall(function()
		return Remotes.OpenCrate:InvokeServer(crateId, useFree)
	end)
	busy = false
	if ok and success and type(result) == "table" then
		crateAnimation(result)
	else
		showToast(ok and tostring(result) or "Error de conexión", Color3.fromRGB(255, 90, 90))
	end
end

local function sectionTitle(parent, text, order)
	return UI.label({
		LayoutOrder = order,
		Size = UDim2.new(1, -10, 0, 30),
		Text = text,
		TextSize = 24,
		TextColor3 = GOLD,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = parent,
	})
end

local function row(parent, order, height)
	return UI.new("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, -10, 0, height),
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
end

local function buildShopPage(data)
	local scroll = scroller(UI.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }))

	-- Recompensa diaria
	local daily = UI.new("Frame", {
		LayoutOrder = 1,
		Size = UDim2.new(1, -10, 0, 70),
		BackgroundColor3 = Color3.fromRGB(40, 60, 40),
		Parent = scroll,
	}, { UI.corner(12), UI.stroke(Color3.fromRGB(90, 230, 110), 2, 0) })
	local streak = data.DailyStreak or 0
	local nextDay = data.DailyAvailable and ((streak % #Shop.DailyRewards) + 1) or streak
	UI.label({
		Position = UDim2.fromOffset(16, 0),
		Size = UDim2.new(1, -260, 1, 0),
		Text = "🎁 Recompensa diaria · Día " .. tostring(nextDay) .. "/" .. #Shop.DailyRewards .. "  (día 7: caja gratis)",
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = daily,
	})
	local claim = UI.button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(220, 46),
		Text = data.DailyAvailable and "¡Reclamar!" or "Vuelve mañana",
		BackgroundColor3 = data.DailyAvailable and GREEN or GREY,
		Parent = daily,
	}, { UI.gloss() })
	claim.Activated:Connect(function()
		Menu.ClaimDaily()
	end)

	-- Ofertas del día
	sectionTitle(scroll, "🔥 Ofertas de hoy (-" .. math.floor(Shop.OfferDiscount * 100) .. "%)", 2)
	local offers = row(scroll, 3, 190)
	for i, offer in Shop.GetDailyOffers(data.Day) do
		local name, rarity = itemName(offer.Kind, offer.Id)
		local owned
		if offer.Kind == "Skin" then
			owned = data.Skins[offer.Id] == true
		else
			owned = data.Outfits[offer.Id] == true
		end
		local card = UI.new("Frame", { LayoutOrder = i, Size = UDim2.fromOffset(200, 190), BackgroundColor3 = CARD_BG, Parent = offers }, {
			UI.corner(12),
			UI.stroke(rarityColor(rarity), 2, 0),
		})
		if offer.Kind == "Skin" then
			WeaponIcon.Create(data.Primary or "ARX27", offer.Id, { Position = UDim2.fromOffset(8, 6), Size = UDim2.fromOffset(184, 80), Parent = card }, "angled", 184 / 80)
		else
			outfitViewport(offer.Id, { Position = UDim2.fromOffset(50, 2), Size = UDim2.fromOffset(100, 90), Parent = card })
		end
		UI.label({ Position = UDim2.fromOffset(0, 92), Size = UDim2.new(1, 0, 0, 24), Text = name, TextSize = 19, Parent = card })
		UI.label({
			Position = UDim2.fromOffset(0, 116),
			Size = UDim2.new(1, 0, 0, 18),
			Text = (offer.Kind == "Outfit" and "Traje · " or "Skin · ") .. rarity,
			TextSize = 14,
			TextColor3 = rarityColor(rarity),
			Parent = card,
		})
		priceButton(card, offer.Kind, offer.Id, owned, false, function()
			Sounds.Play("Click")
			if offer.Kind == "Skin" then
				Remotes.EquipSkin:FireServer(offer.Id)
			else
				Remotes.EquipOutfit:FireServer(offer.Id)
			end
		end)
	end

	-- Cajas
	sectionTitle(scroll, "🎁 Cajas", 4)
	local crates = row(scroll, 5, 150)
	for crateId, crate in Shop.Crates do
		local card = UI.new("Frame", { Size = UDim2.fromOffset(480, 150), BackgroundColor3 = Color3.fromRGB(50, 30, 80), Parent = crates }, {
			UI.corner(12),
			UI.stroke(Color3.fromRGB(190, 80, 255), 2, 0),
			UI.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(140, 100, 255)), Rotation = 30 }),
		})
		UI.label({
			Position = UDim2.fromOffset(16, 8),
			Size = UDim2.fromOffset(300, 30),
			Text = "🎁 " .. crate.Name,
			TextSize = 26,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		local oddsText = {}
		for _, entry in crate.Odds do
			table.insert(oddsText, entry.Rarity .. " " .. entry.Weight .. "%")
		end
		UI.label({
			Position = UDim2.fromOffset(16, 40),
			Size = UDim2.fromOffset(450, 36),
			Text = "Probabilidades: "
				.. table.concat(oddsText, " · ")
				.. "\nSkins y trajes. Si repites, recuperas el "
				.. math.floor(crate.DuplicateRefund * 100)
				.. "%.",
			TextSize = 14,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = UI.FontBody,
			TextStrokeTransparency = 1,
			Parent = card,
		})
		local buyCrate = UI.button({
			Position = UDim2.fromOffset(16, 90),
			Size = UDim2.fromOffset(210, 46),
			Text = data.CratesRestricted and "No disponible" or ("Abrir · " .. coinsText(crate.Price)),
			BackgroundColor3 = data.CratesRestricted and GREY or Color3.fromRGB(230, 140, 20),
			Parent = card,
		}, { UI.gloss() })
		buyCrate.Activated:Connect(function()
			if not data.CratesRestricted then
				openCrate(crateId, false)
			end
		end)
		local free = UI.button({
			Position = UDim2.fromOffset(240, 90),
			Size = UDim2.fromOffset(220, 46),
			Text = "Gratis (" .. tostring(data.FreeCrates or 0) .. ")",
			BackgroundColor3 = (data.FreeCrates or 0) > 0 and GREEN or GREY,
			Parent = card,
		}, { UI.gloss() })
		free.Activated:Connect(function()
			if (data.FreeCrates or 0) > 0 then
				openCrate(crateId, true)
			end
		end)
	end

	-- Monedas con Robux
	sectionTitle(scroll, "🪙 Monedas", 6)
	local packs = row(scroll, 7, 170)
	for i, pack in Shop.CoinPacks do
		local card = UI.new("Frame", { LayoutOrder = i, Size = UDim2.fromOffset(200, 170), BackgroundColor3 = Color3.fromRGB(60, 50, 20), Parent = packs }, {
			UI.corner(12),
			UI.stroke(GOLD, 2, 0),
			UI.new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 160, 60)), Rotation = 90 }),
		})
		UI.label({ Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 44), Text = string.rep("🪙", math.min(i + 1, 4)), TextSize = 30, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 56), Size = UDim2.new(1, 0, 0, 30), Text = tostring(pack.Coins), TextSize = 30, TextColor3 = GOLD, Parent = card })
		UI.label({ Position = UDim2.fromOffset(0, 86), Size = UDim2.new(1, 0, 0, 20), Text = pack.Name, TextSize = 16, Parent = card })
		if pack.Tag then
			UI.label({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -6, 0, 4),
				Size = UDim2.fromOffset(120, 18),
				Text = pack.Tag,
				TextSize = 13,
				TextColor3 = Color3.fromRGB(120, 255, 140),
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = card,
			})
		end
		local buyPack = UI.button({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.new(1, -20, 0, 40),
			Text = pack.ProductId ~= 0 and ("R$ " .. pack.Robux) or "Próximamente",
			BackgroundColor3 = pack.ProductId ~= 0 and GREEN or GREY,
			Parent = card,
		}, { UI.gloss() })
		buyPack.Activated:Connect(function()
			if pack.ProductId ~= 0 then
				MarketplaceService:PromptProductPurchase(player, pack.ProductId)
			end
		end)
	end

	-- VIP
	local vip = UI.new("Frame", {
		LayoutOrder = 8,
		Size = UDim2.new(1, -10, 0, 90),
		BackgroundColor3 = Color3.fromRGB(70, 50, 10),
		Parent = scroll,
	}, {
		UI.corner(12),
		UI.stroke(GOLD, 3, 0),
		UI.new("UIGradient", { Color = ColorSequence.new(GOLD, Color3.fromRGB(120, 60, 200)), Rotation = 0 }),
	})
	UI.label({
		Position = UDim2.fromOffset(16, 6),
		Size = UDim2.new(1, -280, 0, 34),
		Text = "👑 VIP",
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = vip,
	})
	UI.label({
		Position = UDim2.fromOffset(16, 42),
		Size = UDim2.new(1, -280, 0, 40),
		Text = "x2 XP · x2 monedas · caja gratis cada día",
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = vip,
	})
	local vipText = "Próximamente"
	if data.VIP then
		vipText = "✔ Ya eres VIP"
	elseif Shop.VIPPassId ~= 0 then
		vipText = "Hazte VIP · R$ " .. Shop.VIPRobux
	end
	local vipButton = UI.button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(240, 52),
		Text = vipText,
		BackgroundColor3 = data.VIP and GREEN or (Shop.VIPPassId ~= 0 and GOLD or GREY),
		TextColor3 = Color3.fromRGB(30, 20, 0),
		Parent = vip,
	}, { UI.gloss() })
	vipButton.Activated:Connect(function()
		if not data.VIP and Shop.VIPPassId ~= 0 then
			MarketplaceService:PromptGamePassPurchase(player, Shop.VIPPassId)
		end
	end)
end

---------------------------------------------------------------------------

local function refresh()
	if not content then
		return
	end
	for _, child in content:GetChildren() do
		child:Destroy()
	end
	local data = ClientState.Data
	if headerInfo then
		headerInfo.Text = data and ("Nivel " .. data.Level .. "   " .. coinsText(data.Coins) .. (data.VIP and "   👑" or "")) or "Cargando..."
	end
	for name, button in tabButtons do
		button.BackgroundColor3 = name == currentTab and BLUE or CARD_BG
	end
	if not data then
		UI.label({ Size = UDim2.fromScale(1, 1), Text = "Cargando datos...", TextSize = 24, Parent = content })
		return
	end
	if currentTab == "Pase" then
		buildPassPage(data)
	elseif currentTab == "Armas" then
		buildWeaponsPage(data)
	elseif currentTab == "Skins" then
		buildSkinsPage(data)
	elseif currentTab == "Trajes" then
		buildOutfitsPage(data)
	else
		buildShopPage(data)
	end
end

local function setOpen(open)
	ClientState.MenuOpen = open
	panel.Visible = open
	-- En la pantalla de inicio el ratón siempre se ve
	UserInputService.MouseIconEnabled = open or ClientState.InMainMenu
	if open then
		refresh()
	end
end

function Menu.Toggle()
	setOpen(not panel.Visible)
end

-- Abre el menú directamente en una pestaña
function Menu.Open(tab)
	if tab then
		currentTab = tab
	end
	setOpen(true)
end

function Menu.IsOpen()
	return panel ~= nil and panel.Visible
end

-- Recoge la recompensa diaria (también se usa desde la pantalla de inicio)
function Menu.ClaimDaily()
	if busy then
		return false
	end
	busy = true
	local ok, success, result = pcall(function()
		return Remotes.ClaimDaily:InvokeServer()
	end)
	busy = false
	if ok and success and type(result) == "table" then
		Sounds.Play("Kill")
		showToast("Día " .. result.Streak .. ": +" .. result.Coins .. " monedas" .. (result.Crate and " y una caja gratis 🎁" or ""), GOLD)
		return true
	end
	showToast("Ya la has recogido hoy. ¡Vuelve mañana!")
	return false
end

function Menu.Init()
	gui = UI.new("ScreenGui", {
		Name = "Menu",
		ResetOnSpawn = false,
		DisplayOrder = 5,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})

	-- Botón superior (útil en móvil)
	local open = UI.button({
		Position = UDim2.fromOffset(16, 58),
		Size = UDim2.fromOffset(210, 38),
		Text = "⭐ PASE · TIENDA",
		BackgroundColor3 = Color3.fromRGB(255, 120, 30),
		TextSize = 18,
		Parent = gui,
	}, { UI.stroke(Color3.new(0, 0, 0), 2, 0.3), UI.gloss() })
	open.Activated:Connect(Menu.Toggle)

	panel = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.new(0.92, 0, 0.84, 0),
		BackgroundColor3 = PANEL_BG,
		Visible = false,
		Parent = gui,
	}, {
		UI.corner(16),
		UI.stroke(Color3.fromRGB(255, 140, 40), 3, 0),
		UI.padding(16),
		UI.new("UISizeConstraint", { MaxSize = Vector2.new(1100, 640) }),
		UI.new("UIGradient", {
			Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 120, 200)),
			Rotation = 120,
		}),
	})

	-- Botón "Modal": libera el ratón en primera persona mientras el menú está abierto
	UI.new("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true, Parent = panel })

	UI.label({
		Size = UDim2.fromOffset(400, 36),
		Text = "⚡ " .. GameConfig.GameTitle,
		TextSize = 32,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(255, 170, 50),
		Parent = panel,
	})
	headerInfo = UI.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -50, 0, 0),
		Size = UDim2.fromOffset(360, 36),
		Text = "",
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = panel,
	})
	local close = UI.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(36, 36),
		Text = "✕",
		BackgroundColor3 = Color3.fromRGB(220, 60, 60),
		Parent = panel,
	})
	close.Activated:Connect(function()
		setOpen(false)
	end)

	local tabs = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundTransparency = 1,
		Parent = panel,
	}, {
		UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i, name in TABS do
		local button = UI.button({
			LayoutOrder = i,
			Size = UDim2.fromOffset(130, 38),
			Text = name == "Tienda" and "🛒 Tienda" or name,
			BackgroundColor3 = CARD_BG,
			Parent = tabs,
		})
		button.Activated:Connect(function()
			currentTab = name
			Sounds.Play("Click")
			refresh()
		end)
		tabButtons[name] = button
	end

	content = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 96),
		Size = UDim2.new(1, 0, 1, -96),
		BackgroundTransparency = 1,
		Parent = panel,
	})

	toast = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -20),
		Size = UDim2.fromOffset(700, 36),
		Text = "",
		TextSize = 24,
		TextStrokeTransparency = 0,
		Visible = false,
		ZIndex = 40,
		Parent = gui,
	})

	ContextActionService:BindAction("Menu", function(_, state)
		if state == Enum.UserInputState.Begin then
			Menu.Toggle()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.B, Enum.KeyCode.ButtonSelect)

	ClientState.DataChanged.Event:Connect(function()
		if panel.Visible then
			refresh()
		end
	end)
end

return Menu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">Movement</string>
              <string name="Source"><![CDATA[-- Movimiento: correr (Shift) y deslizarse (C).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Sounds = require(Shared.Sounds)

local ClientState = require(script.Parent.ClientState)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Movement = {}

local humanoid, rootPart
local sprintHeld = false
local lastSlide = -10
local stopSlide

local function tweenCameraOffset(offset, time)
	if humanoid then
		TweenService:Create(humanoid, TweenInfo.new(time, Enum.EasingStyle.Quad), { CameraOffset = offset }):Play()
	end
end

local function slide()
	if ClientState.Sliding or ClientState.IsBlocked() or not humanoid or humanoid.Health <= 0 or not rootPart then
		return
	end
	if os.clock() - lastSlide < GameConfig.SlideCooldown or humanoid.FloorMaterial == Enum.Material.Air then
		return
	end
	local direction = humanoid.MoveDirection
	if direction.Magnitude < 0.1 then
		direction = camera.CFrame.LookVector
	end
	direction = Vector3.new(direction.X, 0, direction.Z)
	if direction.Magnitude < 0.01 then
		return
	end
	direction = direction.Unit

	lastSlide = os.clock()
	ClientState.Sliding = true
	Sounds.Play("Slide")

	local attachment = Instance.new("Attachment")
	attachment.Name = "SlideAttachment"
	attachment.Parent = rootPart
	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	-- Modo plano: solo empuja en X/Z, la gravedad sigue actuando
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	velocity.PrimaryTangentAxis = Vector3.xAxis
	velocity.SecondaryTangentAxis = Vector3.zAxis
	velocity.MaxForce = 80000
	velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z) * GameConfig.SlideSpeed
	velocity.Parent = rootPart

	tweenCameraOffset(Vector3.new(0, -1.8, 0), 0.12)

	local start = os.clock()
	local connection
	local stopped = false
	stopSlide = function()
		if stopped then
			return
		end
		stopped = true
		connection:Disconnect()
		velocity:Destroy()
		attachment:Destroy()
		ClientState.Sliding = false
		tweenCameraOffset(Vector3.zero, 0.2)
	end
	connection = RunService.Heartbeat:Connect(function()
		local alpha = (os.clock() - start) / GameConfig.SlideDuration
		local state = humanoid:GetState()
		if alpha >= 1 or humanoid.Health <= 0 or humanoid.Jump or state == Enum.HumanoidStateType.Jumping then
			stopSlide()
			return
		end
		local speed = GameConfig.SlideSpeed + (GameConfig.WalkSpeed - GameConfig.SlideSpeed) * alpha * alpha
		velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z) * speed
	end)
end

local function update()
	if not humanoid or humanoid.Health <= 0 then
		ClientState.Sprinting = false
		return
	end
	local moving = humanoid.MoveDirection.Magnitude > 0.1
	local recentlyShot = os.clock() - ClientState.LastShotTime < 0.35
	ClientState.Sprinting = sprintHeld
		and moving
		and not ClientState.Aiming
		and not recentlyShot
		and not ClientState.Sliding
		and not ClientState.IsBlocked()

	local speed = GameConfig.WalkSpeed
	if ClientState.Sprinting then
		speed = GameConfig.SprintSpeed
	elseif ClientState.Aiming then
		speed = GameConfig.AimWalkSpeed
	end
	local weaponDef = ClientState.CurrentDef
	if weaponDef and weaponDef.WalkSpeedMultiplier then
		speed *= weaponDef.WalkSpeedMultiplier
	end
	if player:GetAttribute("CarryingFlag") then
		speed *= GameConfig.Flag.CarrierSpeedMultiplier
	end
	humanoid.WalkSpeed = speed
end

local function onCharacter(newCharacter)
	if stopSlide then
		stopSlide()
		stopSlide = nil
	end
	ClientState.Sliding = false
	humanoid = newCharacter:WaitForChild("Humanoid")
	rootPart = newCharacter:WaitForChild("HumanoidRootPart")
	humanoid.CameraOffset = Vector3.zero
end

function Movement.Init()
	ContextActionService:BindAction("Sprint", function(_, state, input)
		if input.UserInputType == Enum.UserInputType.Touch then
			if state == Enum.UserInputState.Begin then
				sprintHeld = not sprintHeld
			end
		elseif state == Enum.UserInputState.Begin then
			sprintHeld = true
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			sprintHeld = false
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
	ContextActionService:SetTitle("Sprint", "Correr")
	ContextActionService:SetPosition("Sprint", UDim2.new(1, -260, 1, -160))

	ContextActionService:BindAction("Slide", function(_, state)
		if state == Enum.UserInputState.Begin then
			slide()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.C, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonR3)
	ContextActionService:SetTitle("Slide", "Deslizar")
	ContextActionService:SetPosition("Slide", UDim2.new(1, -270, 1, -240))

	-- Si la ventana pierde el foco dejamos de correr
	UserInputService.WindowFocusReleased:Connect(function()
		sprintHeld = false
	end)

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	RunService.Heartbeat:Connect(update)
end

return Movement
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[-- Pequeña utilidad para crear interfaces desde código.
local UI = {}

UI.Font = Enum.Font.FredokaOne
UI.FontBody = Enum.Font.GothamBold

function UI.new(className, props, children)
	local inst = Instance.new(className)
	local parent
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			inst[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.corner(radius)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

function UI.stroke(color, thickness, transparency)
	return UI.new("UIStroke", {
		Color = color or Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

-- Degradado brillante (de claro arriba a más oscuro abajo) sobre el color de fondo
function UI.gloss(bottom)
	return UI.new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), bottom or Color3.fromRGB(185, 185, 195)),
		Rotation = 90,
	})
end

function UI.padding(px)
	return UI.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
	})
end

-- Texto con borde negro estilo "cartoon"
function UI.label(props, children)
	local defaults = {
		BackgroundTransparency = 1,
		Font = UI.Font,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0.4,
		TextSize = 18,
	}
	for key, value in props or {} do
		defaults[key] = value
	end
	return UI.new("TextLabel", defaults, children)
end

function UI.button(props, children)
	local defaults = {
		Font = UI.Font,
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 18,
		AutoButtonColor = true,
		BackgroundColor3 = Color3.fromRGB(40, 120, 255),
	}
	for key, value in props or {} do
		defaults[key] = value
	end
	local button = UI.new("TextButton", defaults, children)
	UI.corner(8).Parent = button
	return button
end

function UI.formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d", seconds // 60, seconds % 60)
end

function UI.hex(color)
	return "#" .. color:ToHex()
end

return UI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">WeaponController</string>
              <string name="Source"><![CDATA[-- Control de armas en primera persona: viewmodel, disparo, recarga, apuntado, cuchillo y cambio de arma.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weapons = require(Shared.Weapons)
local WeaponModels = require(Shared.WeaponModels)
local Sounds = require(Shared.Sounds)
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)

local ClientState = require(script.Parent.ClientState)
local Effects = require(script.Parent.Effects)
local Outfits = require(Shared.Outfits)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local WeaponController = {}

-- Hombros del viewmodel (espacio de cámara, fuera de pantalla)
local RIGHT_SHOULDER = Vector3.new(1.1, -1.5, 0.4)
local LEFT_SHOULDER = Vector3.new(-0.7, -1.5, 0.2)

local character, humanoid, rootPart
local equippedTool, def
local viewmodel
local attrConnection

local triggerHeld = false
local aimHeld = false
local lastShot = 0
local localAmmo = 0
local reloadStart = nil
local equipTime = 0
local meleeTime = -10
local meleeWithKnife = false

local recoilKick, recoilRot = 0, 0
local camKick, camYaw = 0, 0
local swayX, swayY = 0, 0
local bobTime = 0
local aimAlpha, sprintAlpha = 0, 0
local viewmodelHidden = false
local pulseParts = {} -- piezas de neón que laten (skins míticas)
local pulseSkin = nil
local strafeRoll = 0
local shakeRoll = 0

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function lerp(a, b, t)
	return a + (b - a) * t
end

local function updateRayFilter()
	local ignore = { camera }
	if character then
		table.insert(ignore, character)
	end
	local fx = workspace:FindFirstChild("ClientFX")
	if fx then
		table.insert(ignore, fx)
	end
	rayParams.FilterDescendantsInstances = ignore
end

---------------------------------------------------------------------------
-- Viewmodel
---------------------------------------------------------------------------

local function skinTone()
	local hand = character and (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm"))
	return hand and hand.Color or Color3.fromRGB(255, 204, 153)
end

local function addArm(model, handPos, shoulderCam, weaponDef)
	local shoulder = weaponDef.ViewOffset:PointToObjectSpace(shoulderCam)
	local length = (shoulder - handPos).Magnitude
	local sleeveColor = player.Team and player.TeamColor.Color or Color3.fromRGB(60, 60, 70)
	-- Con traje de operador, los brazos llevan sus colores
	local outfitColors = Outfits.ArmColors(ClientState.Data and ClientState.Data.EquippedOutfit)
	if outfitColors then
		sleeveColor = outfitColors.Sleeve
	end

	local arm = Instance.new("Part")
	arm.Name = "Arm"
	arm.Size = Vector3.new(0.4, 0.4, length)
	arm.CFrame = CFrame.lookAt((handPos + shoulder) / 2, handPos)
	arm.Color = skinTone()
	arm.Material = Enum.Material.SmoothPlastic
	arm.Parent = model

	local sleeve = Instance.new("Part")
	sleeve.Name = "Sleeve"
	sleeve.Size = Vector3.new(0.46, 0.46, length * 0.55)
	sleeve.CFrame = CFrame.lookAt(shoulder:Lerp(handPos, 0.27), handPos)
	sleeve.Color = sleeveColor
	sleeve.Material = Enum.Material.Fabric
	sleeve.Parent = model

	local glove = Instance.new("Part")
	glove.Name = "Glove"
	glove.Size = Vector3.new(0.48, 0.48, 0.55)
	glove.CFrame = CFrame.lookAt(handPos + (shoulder - handPos).Unit * 0.15, handPos)
	glove.Color = outfitColors and outfitColors.Glove or Color3.fromRGB(25, 25, 28)
	glove.Material = Enum.Material.Fabric
	glove.Parent = model

	-- Puño blanco de la manga
	local cuff = Instance.new("Part")
	cuff.Name = "Cuff"
	cuff.Size = Vector3.new(0.5, 0.5, 0.12)
	cuff.CFrame = CFrame.lookAt(shoulder:Lerp(handPos, 0.545), handPos)
	cuff.Color = outfitColors and outfitColors.Cuff or Color3.fromRGB(245, 245, 250)
	cuff.Material = outfitColors and Enum.Material.Neon or Enum.Material.Fabric
	cuff.Parent = model
end

-- Oculta en nuestra pantalla el Tool real (los demás jugadores sí lo ven)
local function hideToolLocally(tool)
	for _, inst in tool:GetDescendants() do
		if inst:IsA("BasePart") then
			inst.LocalTransparencyModifier = 1
		elseif inst:IsA("ParticleEmitter") then
			inst.Enabled = false
		end
	end
end

local function destroyViewmodel()
	if viewmodel then
		viewmodel:Destroy()
		viewmodel = nil
	end
	viewmodelHidden = false
end

local function createViewmodel(tool)
	destroyViewmodel()
	local weaponName = tool:GetAttribute("Weapon")
	local weaponDef = Weapons.Get(weaponName)
	local model = WeaponModels.Build(weaponName, tool:GetAttribute("Skin"))
	if weaponDef.RightHand then
		addArm(model, weaponDef.RightHand, RIGHT_SHOULDER, weaponDef)
	end
	if weaponDef.LeftHand then
		addArm(model, weaponDef.LeftHand, LEFT_SHOULDER, weaponDef)
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.CastShadow = false
		end
	end
	model.Name = "Viewmodel"
	model.Parent = camera
	viewmodel = model

	-- Skins con "Pulse": los detalles de neón laten
	table.clear(pulseParts)
	pulseSkin = WeaponModels.GetPalette(weaponName, tool:GetAttribute("Skin"))
	if pulseSkin.Pulse then
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") and part:GetAttribute("Role") == "Accent" then
				table.insert(pulseParts, part)
			end
		end
	end
end

local function setViewmodelHidden(hidden)
	if not viewmodel or viewmodelHidden == hidden then
		return
	end
	viewmodelHidden = hidden
	for _, part in viewmodel:GetDescendants() do
		if part:IsA("BasePart") then
			part.LocalTransparencyModifier = hidden and 1 or 0
		elseif part:IsA("ParticleEmitter") then
			part.Enabled = not hidden
		end
	end
end

---------------------------------------------------------------------------
-- Equipar
---------------------------------------------------------------------------

local function onUnequipped()
	if attrConnection then
		attrConnection:Disconnect()
		attrConnection = nil
	end
	destroyViewmodel()
	equippedTool, def = nil, nil
	triggerHeld = false
	reloadStart = nil
	ClientState.CurrentTool = nil
	ClientState.CurrentDef = nil
	ClientState.Reloading = false
	ClientState.WeaponChanged:Fire()
end

local function onEquipped(tool)
	if equippedTool then
		onUnequipped()
	end
	local weaponDef = Weapons.Get(tool:GetAttribute("Weapon"))
	if not weaponDef then
		return
	end
	equippedTool, def = tool, weaponDef
	equipTime = os.clock()
	reloadStart = nil
	localAmmo = tool:GetAttribute("Ammo") or 0

	hideToolLocally(tool)
	createViewmodel(tool)

	attrConnection = tool.AttributeChanged:Connect(function(attribute)
		if attribute == "Ammo" then
			local serverAmmo = tool:GetAttribute("Ammo") or 0
			-- Subida = recarga; bajada = confirmación de disparos que ya predijimos
			if serverAmmo > localAmmo then
				localAmmo = serverAmmo
			else
				localAmmo = math.min(localAmmo, serverAmmo)
			end
		elseif attribute == "Skin" then
			createViewmodel(tool)
			hideToolLocally(tool)
		elseif attribute == "Reloading" and not tool:GetAttribute("Reloading") then
			reloadStart = nil
		end
	end)

	ClientState.CurrentTool = tool
	ClientState.CurrentDef = weaponDef
	ClientState.WeaponChanged:Fire()
end

local function getTools()
	local list = {}
	local containers = { player:FindFirstChildOfClass("Backpack"), character }
	for _, container in containers do
		if container then
			for _, tool in container:GetChildren() do
				if tool:IsA("Tool") and tool:GetAttribute("Slot") then
					list[tool:GetAttribute("Slot")] = tool
				end
			end
		end
	end
	return list
end
WeaponController.GetTools = getTools

local function equipSlot(slot)
	if not humanoid or humanoid.Health <= 0 or ClientState.IsBlocked() then
		return
	end
	local tool = getTools()[slot]
	if tool and tool ~= equippedTool then
		humanoid:EquipTool(tool)
	end
end

local function cycleSlot(direction)
	local current = equippedTool and equippedTool:GetAttribute("Slot") or 1
	local tools = getTools()
	for i = 1, 3 do
		local slot = (current - 1 + direction * i) % 3 + 1
		if tools[slot] then
			equipSlot(slot)
			return
		end
	end
end

---------------------------------------------------------------------------
-- Disparo
---------------------------------------------------------------------------

local function randomInCone(direction, degrees)
	if degrees <= 0 then
		return direction
	end
	local angle = math.rad(degrees) * math.sqrt(math.random())
	local spin = math.random() * math.pi * 2
	return (CFrame.lookAt(Vector3.zero, direction) * CFrame.Angles(0, 0, spin) * CFrame.Angles(angle, 0, 0)).LookVector
end

local function currentSpread()
	if not def or def.Type ~= "Gun" then
		return 0
	end
	local spread = lerp(def.Spread, def.AimSpread, aimAlpha)
	if rootPart then
		local velocity = rootPart.AssemblyLinearVelocity
		if Vector3.new(velocity.X, 0, velocity.Z).Magnitude > 2 then
			spread *= 1.5
		end
	end
	if humanoid and humanoid.FloorMaterial == Enum.Material.Air then
		spread *= 2
	end
	return spread + ClientState.Bloom * (1 - aimAlpha * 0.7)
end

local function requestReload()
	if not equippedTool or not def or def.Type ~= "Gun" or reloadStart then
		return
	end
	local reserve = equippedTool:GetAttribute("Reserve") or 0
	if localAmmo >= def.MagSize or reserve <= 0 then
		return
	end
	reloadStart = os.clock()
	Remotes.Reload:FireServer(equippedTool)
	Sounds.Play("Reload")
end

local function fire()
	local now = os.clock()
	if not equippedTool or not def or def.Type ~= "Gun" or ClientState.IsBlocked() then
		return
	end
	if now - lastShot < 1 / def.FireRate or reloadStart or now - equipTime < 0.25 then
		return
	end
	if localAmmo <= 0 then
		lastShot = now
		Sounds.Play("Empty")
		requestReload()
		return
	end

	lastShot = now
	localAmmo -= 1
	ClientState.LastShotTime = now
	ClientState.Sprinting = false

	updateRayFilter()
	local origin = camera.CFrame.Position
	local look = camera.CFrame.LookVector
	local muzzle = viewmodel and viewmodel.PrimaryPart and viewmodel.PrimaryPart:FindFirstChild("Muzzle")
	local muzzlePos = muzzle and muzzle.WorldPosition or origin
	local tracerColor = WeaponModels.GetPalette(equippedTool:GetAttribute("Weapon"), equippedTool:GetAttribute("Skin")).Accent
	local spread = currentSpread()

	local rays = {}
	if def.Explosive then
		-- Cohete: viaja hasta el impacto y explota
		local direction = randomInCone(look, spread)
		local result = workspace:Raycast(origin, direction * def.Range, rayParams)
		local hitPosition = result and result.Position or origin + direction * def.Range
		table.insert(rays, { Part = result and result.Instance or nil, Position = hitPosition })
		Effects.Rocket(muzzlePos, hitPosition, def.ProjectileSpeed or 200, tracerColor, def.Explosive.Radius)
	end
	for _ = 1, def.Explosive and 0 or def.Pellets do
		local direction = randomInCone(look, spread)
		local result = workspace:Raycast(origin, direction * def.Range, rayParams)
		local hitPosition = result and result.Position or origin + direction * def.Range
		table.insert(rays, { Part = result and result.Instance or nil, Position = hitPosition })
		Effects.Tracer(muzzlePos, hitPosition, tracerColor)
		if result then
			Effects.Impact(result.Position, result.Normal, result.Instance)
		end
	end
	Remotes.Fire:FireServer(equippedTool, origin, rays)

	Effects.MuzzleFlash(muzzle)
	local eject = viewmodel and viewmodel.PrimaryPart and viewmodel.PrimaryPart:FindFirstChild("Eject")
	if not def.Explosive then
		Effects.ShellCasing(eject, camera.CFrame, def.Pellets > 1 and Color3.fromRGB(220, 50, 50) or nil)
	end
	Sounds.Play((def.Pellets > 1 or def.Damage >= 80) and "ShotHeavy" or "Shot")
	shakeRoll += (math.random() - 0.5) * math.rad(def.Recoil) * 0.6

	-- Retroceso
	local recoil = math.rad(def.Recoil)
	recoilKick += 0.08 + def.Recoil * 0.03
	recoilRot += recoil * 0.6
	camKick += recoil * (1 - aimAlpha * 0.35)
	camYaw += (math.random() - 0.5) * recoil * 0.5
	ClientState.Bloom = math.min(ClientState.Bloom + def.Recoil * 0.4, 6)
	ClientState.ShotFired:Fire()

	if localAmmo <= 0 then
		task.delay(0.2, requestReload)
	end
end

-- Ráfaga (Vortex BR): varios disparos seguidos con una pausa entre ráfagas
local bursting = false
local lastBurstEnd = 0
local function startBurst()
	if bursting or not def or not def.Burst then
		return
	end
	if os.clock() - lastBurstEnd < (def.BurstCooldown or 0.3) then
		return
	end
	bursting = true
	local burstDef = def
	task.spawn(function()
		for i = 1, burstDef.Burst do
			if def ~= burstDef or localAmmo <= 0 or reloadStart then
				break
			end
			fire()
			if i < burstDef.Burst then
				task.wait(1 / burstDef.FireRate + 0.01)
			end
		end
		lastBurstEnd = os.clock()
		bursting = false
	end)
end

local function melee()
	local knife = Weapons.Get(Weapons.Melee)
	local now = os.clock()
	if now - meleeTime < knife.Cooldown or ClientState.IsBlocked() or not humanoid or humanoid.Health <= 0 then
		return
	end
	if not getTools()[knife.Slot] then
		return
	end
	meleeTime = now
	meleeWithKnife = def ~= nil and def.Type == "Melee"
	reloadStart = nil
	Sounds.Play("Swing")

	updateRayFilter()
	local origin = camera.CFrame.Position
	local direction = camera.CFrame.LookVector * knife.Range
	local result = workspace:Spherecast(origin, 1.2, direction, rayParams) or workspace:Raycast(origin, direction, rayParams)
	if result and result.Instance then
		Remotes.Melee:FireServer(result.Instance)
	end
end

---------------------------------------------------------------------------
-- Animación procedural del viewmodel (cada frame)
---------------------------------------------------------------------------

local function renderStep(dt)
	if not character or not humanoid then
		return
	end

	-- Disparo automático
	if triggerHeld and def and def.Type == "Gun" and def.Automatic then
		fire()
	end

	ClientState.Bloom = math.max(0, ClientState.Bloom - dt * 8)
	ClientState.Spread = currentSpread()

	-- Recarga: tiempo límite por si el servidor la rechazó
	if reloadStart and def and os.clock() - reloadStart > def.ReloadTime + 1 then
		reloadStart = nil
	end
	ClientState.Reloading = reloadStart ~= nil
	ClientState.ReloadProgress = (reloadStart and def) and math.clamp((os.clock() - reloadStart) / def.ReloadTime, 0, 1)
		or 0
	ClientState.Ammo = localAmmo

	-- Apuntar
	local canAim = def ~= nil and def.Type == "Gun" and aimHeld and not reloadStart and not ClientState.IsBlocked()
	ClientState.Aiming = canAim
	aimAlpha = lerp(aimAlpha, canAim and 1 or 0, math.min(1, dt * 14))
	if aimAlpha < 0.001 then
		aimAlpha = 0
	end
	ClientState.AimAlpha = aimAlpha
	sprintAlpha = lerp(sprintAlpha, (ClientState.Sprinting and not reloadStart) and 1 or 0, math.min(1, dt * 10))

	-- Retroceso de cámara
	local applyPitch = camKick * math.min(1, dt * 22)
	local applyYaw = camYaw * math.min(1, dt * 22)
	camKick -= applyPitch
	camYaw -= applyYaw
	if applyPitch ~= 0 or applyYaw ~= 0 then
		camera.CFrame = camera.CFrame * CFrame.Angles(applyPitch, applyYaw, 0)
	end

	-- Inclinación de cámara al moverse de lado y pequeña sacudida al disparar.
	-- El módulo de cámara recalcula el giro cada frame, así que esto no se acumula.
	if rootPart then
		local velocity = rootPart.AssemblyLinearVelocity
		local side = velocity:Dot(camera.CFrame.RightVector)
		strafeRoll = lerp(strafeRoll, math.clamp(-side / 26, -1, 1) * math.rad(1.6), math.min(1, dt * 8))
	end
	shakeRoll = lerp(shakeRoll, 0, math.min(1, dt * 18))
	camera.CFrame = camera.CFrame * CFrame.Angles(0, 0, strafeRoll + shakeRoll)

	-- Latido de las skins míticas
	if #pulseParts > 0 and pulseSkin then
		local t = (math.sin(os.clock() * 3) + 1) / 2
		local color = pulseSkin.Accent:Lerp(pulseSkin.Accent2 or Color3.new(1, 1, 1), t)
		for _, part in pulseParts do
			part.Color = color
		end
	end

	-- Campo de visión
	local targetFov = GameConfig.FieldOfView
	if def and def.AimFOV then
		targetFov = lerp(GameConfig.FieldOfView, def.AimFOV, aimAlpha)
	end
	camera.FieldOfView = targetFov + sprintAlpha * 6

	if not viewmodel or not def then
		return
	end

	local now = os.clock()

	-- Balanceo al caminar
	local speed = 0
	if rootPart then
		local velocity = rootPart.AssemblyLinearVelocity
		speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	end
	local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
	if grounded and not ClientState.Sliding then
		bobTime += dt * math.min(speed, 30) * 0.45
	end
	local bobAmount = math.clamp(speed / 18, 0, 1.5) * (1 - aimAlpha * 0.9)
	if not grounded or ClientState.Sliding then
		bobAmount = 0
	end
	local bob = CFrame.new(math.cos(bobTime) * 0.05 * bobAmount, -math.abs(math.sin(bobTime)) * 0.06 * bobAmount, 0)

	-- Inercia al mover el ratón
	local delta = UserInputService:GetMouseDelta()
	swayX = lerp(swayX, math.clamp(-delta.X * 0.004, -0.12, 0.12), math.min(1, dt * 10))
	swayY = lerp(swayY, math.clamp(-delta.Y * 0.004, -0.12, 0.12), math.min(1, dt * 10))
	local swayScale = 1 - aimAlpha * 0.75
	local sway = CFrame.Angles(swayY * swayScale, swayX * swayScale, swayX * 0.6 * swayScale)

	-- Retroceso del arma
	recoilKick = lerp(recoilKick, 0, math.min(1, dt * 16))
	recoilRot = lerp(recoilRot, 0, math.min(1, dt * 14))
	local recoilCF = CFrame.new(0, 0, recoilKick) * CFrame.Angles(recoilRot, 0, 0)

	-- Cadera -> mira
	local base = def.ViewOffset
	if def.AimPoint then
		local a = def.AimPoint
		local aimCF = CFrame.new(-a.X, -a.Y, -def.AimDistance - a.Z)
		base = def.ViewOffset:Lerp(aimCF, aimAlpha)
	end

	-- Correr
	local s = sprintAlpha
	local sprintCF = CFrame.new(-0.25 * s, -0.2 * s, 0.1 * s) * CFrame.Angles(math.rad(-12) * s, math.rad(35) * s, math.rad(18) * s)

	-- Recarga
	local reloadCF = CFrame.new()
	if reloadStart then
		local r = math.sin(ClientState.ReloadProgress * math.pi)
		reloadCF = CFrame.new(0, -0.35 * r, 0) * CFrame.Angles(math.rad(-20) * r, 0, math.rad(35) * r)
	end

	-- Sacar arma
	local e = 1 - math.clamp((now - equipTime) / 0.3, 0, 1)
	local equipCF = CFrame.new(0, -0.8 * e * e, 0) * CFrame.Angles(math.rad(-40) * e, 0, 0)

	-- Cuchillazo / golpe rápido
	local meleeCF = CFrame.new()
	local m = (now - meleeTime) / 0.35
	if m < 1 then
		local k = math.sin(m * math.pi)
		if meleeWithKnife then
			meleeCF = CFrame.new(-0.6 * k, 0.2 * k, -0.6 * k)
				* CFrame.Angles(math.rad(-20) * k, math.rad(70) * k, math.rad(-30) * k)
		else
			meleeCF = CFrame.new(-0.3 * k, 0, -0.5 * k) * CFrame.Angles(0, math.rad(30) * k, math.rad(20) * k)
		end
	end

	viewmodel:PivotTo(camera.CFrame * bob * sway * base * sprintCF * reloadCF * equipCF * meleeCF * recoilCF)

	-- Mira telescópica: ocultar el arma
	-- (y también en la pantalla de inicio, donde la cámara está lejos)
	setViewmodelHidden((def.Scope == true and aimAlpha > 0.85) or ClientState.InMainMenu)
end

---------------------------------------------------------------------------
-- Entrada
---------------------------------------------------------------------------

local function bindActions()
	ContextActionService:BindAction("Fire", function(_, state)
		if ClientState.IsBlocked() then
			triggerHeld = false
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin then
			triggerHeld = true
			if def and def.Type == "Melee" then
				melee()
			elseif def and def.Burst then
				startBurst()
			else
				fire()
			end
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			triggerHeld = false
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)
	ContextActionService:SetTitle("Fire", "Disparar")
	ContextActionService:SetPosition("Fire", UDim2.new(1, -110, 1, -160))

	ContextActionService:BindAction("Aim", function(_, state, input)
		if ClientState.IsBlocked() then
			aimHeld = false
			return Enum.ContextActionResult.Pass
		end
		if input.UserInputType == Enum.UserInputType.Touch then
			if state == Enum.UserInputState.Begin then
				aimHeld = not aimHeld -- en móvil es un interruptor
			end
		elseif state == Enum.UserInputState.Begin then
			aimHeld = true
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			aimHeld = false
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL2)
	ContextActionService:SetTitle("Aim", "Apuntar")
	ContextActionService:SetPosition("Aim", UDim2.new(1, -190, 1, -110))

	ContextActionService:BindAction("Reload", function(_, state)
		if state == Enum.UserInputState.Begin and not ClientState.IsBlocked() then
			requestReload()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.R, Enum.KeyCode.ButtonX)
	ContextActionService:SetTitle("Reload", "R")
	ContextActionService:SetPosition("Reload", UDim2.new(1, -200, 1, -190))

	ContextActionService:BindAction("Melee", function(_, state)
		if state == Enum.UserInputState.Begin and not ClientState.IsBlocked() then
			melee()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.F, Enum.KeyCode.ButtonB)
	ContextActionService:SetTitle("Melee", "F")
	ContextActionService:SetPosition("Melee", UDim2.new(1, -120, 1, -240))

	ContextActionService:BindAction("Slots", function(_, state, input)
		if state ~= Enum.UserInputState.Begin then
			return Enum.ContextActionResult.Pass
		end
		if input.KeyCode == Enum.KeyCode.One then
			equipSlot(1)
		elseif input.KeyCode == Enum.KeyCode.Two then
			equipSlot(2)
		elseif input.KeyCode == Enum.KeyCode.Three then
			equipSlot(3)
		elseif input.KeyCode == Enum.KeyCode.ButtonY then
			cycleSlot(1)
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.ButtonY)

	UserInputService.InputChanged:Connect(function(input, processed)
		if processed or ClientState.IsBlocked() then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			cycleSlot(input.Position.Z > 0 and -1 or 1)
		end
	end)
end

---------------------------------------------------------------------------
-- Personaje
---------------------------------------------------------------------------

local function onCharacter(newCharacter)
	onUnequipped()
	character = newCharacter
	humanoid = newCharacter:WaitForChild("Humanoid")
	rootPart = newCharacter:WaitForChild("HumanoidRootPart")
	aimHeld = false
	camKick, camYaw = 0, 0
	updateRayFilter()

	newCharacter.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and child:GetAttribute("Weapon") then
			onEquipped(child)
		end
	end)
	newCharacter.ChildRemoved:Connect(function(child)
		if child == equippedTool then
			onUnequipped()
		end
	end)
	local existing = newCharacter:FindFirstChildOfClass("Tool")
	if existing and existing:GetAttribute("Weapon") then
		onEquipped(existing)
	end

	humanoid.Died:Connect(function()
		onUnequipped()
		triggerHeld = false
	end)
end

-- Efectos de los disparos de otros jugadores
local function onShotFX(tool, endpoints)
	if typeof(tool) ~= "Instance" or not tool.Parent or type(endpoints) ~= "table" then
		return
	end
	local handle = tool:FindFirstChild("Handle")
	local muzzle = handle and handle:FindFirstChild("Muzzle")
	if not muzzle then
		return
	end
	local color = WeaponModels.GetPalette(tool:GetAttribute("Weapon"), tool:GetAttribute("Skin")).Accent
	local weaponDef = Weapons.Get(tool:GetAttribute("Weapon"))
	for _, position in endpoints do
		if typeof(position) == "Vector3" then
			if weaponDef and weaponDef.Explosive then
				Effects.Rocket(muzzle.WorldPosition, position, weaponDef.ProjectileSpeed or 200, color, weaponDef.Explosive.Radius)
			else
				Effects.Tracer(muzzle.WorldPosition, position, color)
			end
		end
	end
	Effects.MuzzleFlash(muzzle)
	local heavy = weaponDef and (weaponDef.Pellets > 1 or weaponDef.Damage >= 80)
	Sounds.Play(heavy and "ShotHeavy" or "Shot", handle)
end

function WeaponController.Init()
	UserInputService.MouseIconEnabled = false
	bindActions()
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	Remotes.ShotFX.OnClientEvent:Connect(onShotFX)
	RunService:BindToRenderStep("WeaponViewmodel", Enum.RenderPriority.Camera.Value + 1, renderStep)
end

return WeaponController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">WeaponIcon</string>
              <string name="Source"><![CDATA[-- Iconos 3D de armas: dibuja el modelo real (con su skin) dentro de un ViewportFrame.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local WeaponModels = require(Shared.WeaponModels)

local WeaponIcon = {}

local FOV = 20

-- view: "side" (de perfil, cañón a la derecha) o "angled" (tres cuartos)
-- aspect: ancho / alto del ViewportFrame
function WeaponIcon.Create(weaponName, skinId, props, view, aspect)
	local viewport = Instance.new("ViewportFrame")
	viewport.BackgroundTransparency = 1
	viewport.Ambient = Color3.fromRGB(170, 170, 185)
	viewport.LightColor = Color3.fromRGB(255, 255, 255)
	viewport.LightDirection = Vector3.new(-1, -1.5, -0.6)
	for key, value in props or {} do
		viewport[key] = value
	end

	local model = WeaponModels.Build(weaponName, skinId, false)
	model.Parent = viewport

	local camera = Instance.new("Camera")
	camera.FieldOfView = FOV
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	local boxCFrame, size = model:GetBoundingBox()
	local center = boxCFrame.Position
	aspect = aspect or 2.5
	local tanHalf = math.tan(math.rad(FOV / 2))

	local direction
	if view == "angled" then
		direction = Vector3.new(1, 0.35, 0.45).Unit
	else
		direction = Vector3.new(1, 0.05, 0).Unit
	end
	-- Distancia para que quepa: el largo del arma (Z) en horizontal y el alto (Y) en vertical
	local fitVertical = (size.Y / 2) / tanHalf
	local fitHorizontal = (size.Z / 2) / (tanHalf * aspect)
	local margin = view == "angled" and 1.35 or 1.12
	local distance = math.max(fitVertical, fitHorizontal) * margin + size.X / 2
	camera.CFrame = CFrame.lookAt(center + direction * distance, center)
	return viewport
end

return WeaponIcon
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">WorldFX</string>
              <string name="Source"><![CDATA[-- Efectos del mundo en el cliente:
--  * Piezas del mapa con atributo Spin (grados/seg) giran y con Bob (studs) flotan
--  * Contorno de color en los compañeros de equipo (visible a través de paredes)
--  * Oculta el nombre de los enemigos
--  * Explosión de partículas cuando alguien es eliminado
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Effects = require(script.Parent.Effects)

local player = Players.LocalPlayer

local WorldFX = {}

local animated = {} -- [part] = { Base = CFrame, Spin = number, Bob = number, Phase = number }

local function track(inst)
	if not inst:IsA("BasePart") then
		return
	end
	local spin = inst:GetAttribute("Spin")
	local bob = inst:GetAttribute("Bob")
	if spin or bob then
		animated[inst] = { Base = inst.CFrame, Spin = spin or 0, Bob = bob or 0, Phase = math.random() * 10 }
	end
end

local function animate()
	local t = os.clock()
	for part, info in animated do
		if not part.Parent then
			animated[part] = nil
			continue
		end
		local position = info.Base.Position + Vector3.new(0, math.sin(t * 1.5 + info.Phase) * info.Bob, 0)
		local rotation = info.Base - info.Base.Position
		-- Giro alrededor del eje Y del mundo que pasa por la pieza
		part.CFrame = CFrame.new(position) * CFrame.Angles(0, math.rad(info.Spin * t), 0) * rotation
	end
end

---------------------------------------------------------------------------
-- Jugadores
---------------------------------------------------------------------------

local function teamColorOf(other)
	return other and other.Team and other.TeamColor.Color or Color3.fromRGB(255, 200, 60)
end

local function styleCharacter(other, character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local isTeammate = player.Team ~= nil and other.Team == player.Team
	local highlight = character:FindFirstChild("TeamHighlight")
	if isTeammate and other ~= player then
		if not highlight then
			highlight = Instance.new("Highlight")
			highlight.Name = "TeamHighlight"
			highlight.FillTransparency = 1
			highlight.OutlineTransparency = 0.2
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.Parent = character
		end
		highlight.OutlineColor = teamColorOf(other)
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	else
		if highlight then
			highlight:Destroy()
		end
		if other ~= player then
			-- Sin nombre sobre los enemigos: hay que encontrarlos
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
	end
end

local function watchDeath(character, color)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end
	humanoid.Died:Connect(function()
		local root = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
		if root then
			Effects.DeathBurst(root.Position, typeof(color) == "function" and color() or color)
		end
	end)
end

local function onCharacter(other, character)
	task.spawn(watchDeath, character, function()
		return teamColorOf(other)
	end)
	character:WaitForChild("Humanoid", 10)
	styleCharacter(other, character)
end

local function onPlayer(other)
	other.CharacterAdded:Connect(function(character)
		onCharacter(other, character)
	end)
	if other.Character then
		task.spawn(onCharacter, other, other.Character)
	end
	other:GetPropertyChangedSignal("Team"):Connect(function()
		if other.Character then
			styleCharacter(other, other.Character)
		end
	end)
end

local function restyleAll()
	for _, other in Players:GetPlayers() do
		if other.Character then
			styleCharacter(other, other.Character)
		end
	end
end

function WorldFX.Init()
	-- Animaciones del mapa
	for _, inst in workspace:GetDescendants() do
		track(inst)
	end
	workspace.DescendantAdded:Connect(track)
	RunService.RenderStepped:Connect(animate)

	-- Jugadores
	for _, other in Players:GetPlayers() do
		onPlayer(other)
	end
	Players.PlayerAdded:Connect(onPlayer)
	player:GetPropertyChangedSignal("Team"):Connect(restyleAll)

	-- Muñecos de práctica
	local function watchDummies(folder)
		for _, dummy in folder:GetChildren() do
			task.spawn(watchDeath, dummy, Color3.fromRGB(255, 200, 60))
		end
		folder.ChildAdded:Connect(function(dummy)
			task.spawn(watchDeath, dummy, Color3.fromRGB(255, 200, 60))
		end)
	end
	local dummies = workspace:FindFirstChild("Dummies")
	if dummies then
		watchDummies(dummies)
	end
	workspace.ChildAdded:Connect(function(child)
		if child.Name == "Dummies" then
			watchDummies(child)
		end
	end)
end

return WorldFX
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
