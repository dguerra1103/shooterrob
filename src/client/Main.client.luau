local BoostHUD = require(Modules.BoostHUD)
local Minimap = require(Modules.Minimap)

Remotes.DataUpdate.OnClientEvent:Connect(ClientState.SetData)
task.spawn(function()
	local ok, data = pcall(function()
		return Remotes.GetData:InvokeServer()
	end)
	if ok and data and not ClientState.Data then
		ClientState.SetData(data)
	end
end)

-- Arranca cada sistema por separado: si uno falla, se avisa en Output y los demás siguen
local function start(name, fn, ...)
	local ok, err = xpcall(fn, debug.traceback, ...)
	if not ok then
		warn("[Arranque] " .. name .. " falló: " .. tostring(err))
	end
end

start("Settings", Settings.Init)
start("HUD", HUD.Init)
start("Minimap", Minimap.Init)
