-- Estadísticas y modelo (hecho con piezas) de cada arma.
-- Espacio del modelo: -Z = hacia delante (cañón), +Y = arriba. "Handle" es la pieza raíz.
local Weapons = {}

-- Roles de color: Body, Accent (neón), Accent2 (secundario), Dark, Metal (cromado), Lens (cristal)
local function P(name, size, cf, role, shape)
	return { Name = name, Size = size, CFrame = cf, Role = role, Shape = shape }
end

local rad = math.rad

-- Cilindro a lo largo del eje Z (cañones, tubos)
local function Cyl(name, length, diameter, position, role)
	return P(name, Vector3.new(length, diameter, diameter), CFrame.new(position) * CFrame.Angles(0, rad(90), 0), role, "Cylinder")
end

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

